# The Wine source tree is its own git repository (branches: base / altars).
# It is not a submodule on purpose: the patch series in patches/ is the
# portable artifact, the tree is just where it gets applied.
/wine-src/

# Build output and the installed Wine.
/dist/
/dist-cx/
/build/

# Generated from a real Windows installation by scripts/export-office-registry.py.
# ~120 MB of .reg, and it carries that machine's identity and licence state.
/office-registry/

*.log
scripts/__pycache__/
