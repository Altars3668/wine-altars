#!/usr/bin/python3 -I
"""manualduplex - CUPS pre-filter: print on both sides with a printer that cannot.

Installed as /usr/lib/cups/filter/manualduplex and named in the queue's PPD
(see mkppd.py):

    *cupsPreFilter: "application/vnd.cups-pdf 0 manualduplex"

cupsd then runs it between pdftopdf and the rasteriser, on the PDF of sheet
sides pdftopdf has made: page ranges, n-up, scaling, orientation and copies
are already applied, and for a two-sided job with more than one copy pdftopdf
has collated them and given each copy an even number of sides.

The queue stays the printer's only queue.  Its PPD has a Duplex option, so
Edge/Chromium, GTK, LibreOffice and Word under Wine offer "two-sided, long
edge / short edge".  A one-sided job passes through.  A two-sided job is
printed the way Wine's print processor prints manual duplex for a printer
without a duplexer (wineps.drv, printproc.c), as two jobs:

  1.  this job: the fronts, sides 1, 3, 5, ...         passed on from here
  2.  a new job on the same queue: all sides again,     queued from here
      page-set=even outputorder=reverse InputSlot=Manual,
      turned 180 degrees for binding on the long edge

What makes it work is the printer, not this program.  The second job asks for
media-source=manual (the ipp backend maps InputSlot=Manual through the PPD),
and the printer holds it at its own "load paper" prompt -- the green arrow --
until the stack is back in the tray and the button is pressed.  It is queued
at the highest priority, so the backs come straight after their fronts even
when other jobs are waiting.

The stack comes out face down and goes back in as it came out, moved and not
turned over or round.  So the sheet printed last is on top and is fed first:
the backs go in reverse order, and with an odd number of sides pdftopdf makes
the "even" half up with a blank one, which the reversal puts first, on the
sheet that has no back.  And the edge that left the printer first goes back
in last, so a back printed as it is lines up with its front for binding on
the short edge; binding on the long edge needs the backs turned 180 degrees,
which is done here on the PDF -- so it holds for landscape pages too.

The job's own sides/Duplex options still reach the backend.  The ipp backend
asks the printer with Validate-Job first, the printer answers that two-sided
is not supported, and the backend sends the fronts one-sided.  The Duplex
choices in the PPD carry no PostScript, so the raster says one-sided as well.

Needs qpdf and lp.  Runs as the unprivileged CUPS user.
"""
import os, re, shutil, signal, subprocess, sys, tempfile

MARK = "manualduplex-pass"          # tags the backs job this filter queues

# The paper and the print engine: these describe how the backs should be
# printed, so they go to the second job.  Everything else -- n-up, page
# ranges, scaling, orientation, mirroring, copies -- pdftopdf has applied to
# the sides this filter sees, and must not be applied twice.
FORWARD = {
    "PageSize", "PageRegion", "media", "MediaType", "media-type",
    "ColorModel", "print-color-mode", "output-mode",
    "cupsPrintQuality", "print-quality", "Resolution", "printer-resolution",
    "print-content-optimize", "OutputBin", "output-bin",
}


def log(level, msg):
    sys.stderr.write("%s: %s\n" % (level, msg))
    sys.stderr.flush()


def parse_options(s):
    """cupsParseOptions(), in Python: name=value pairs separated by spaces,
    values may be quoted or {collections}; a bare name is a boolean."""
    opts, i, n = {}, 0, len(s)
    while i < n:
        while i < n and s[i].isspace():
            i += 1
        start = i
        while i < n and not s[i].isspace() and s[i] != "=":
            i += 1
        name = s[start:i]
        if not name:
            break
        while i < n and s[i].isspace():
            i += 1
        if i >= n or s[i] != "=":
            if name.lower().startswith("no"):
                opts[name[2:]] = "false"
            else:
                opts[name] = "true"
            continue
        i += 1
        value = []
        while i < n and not s[i].isspace():
            c = s[i]
            if c in "'\"":
                i += 1
                while i < n and s[i] != c:
                    if s[i] == "\\" and i + 1 < n:
                        i += 1
                    value.append(s[i]); i += 1
                i += 1
            elif c == "{":
                depth = 0
                while i < n:
                    c = s[i]
                    if c == "{":
                        depth += 1
                    elif c == "}":
                        depth -= 1
                        if depth == 0:
                            value.append(c); i += 1
                            break
                    elif c == "\\" and i + 1 < n:
                        i += 1; c = s[i]
                    value.append(c); i += 1
            else:
                while i < n and not s[i].isspace():
                    if s[i] == "\\" and i + 1 < n:
                        i += 1
                    value.append(s[i]); i += 1
        opts[name] = "".join(value)
    return opts


def option_arg(name, value):
    """One -o argument that lp's own cupsParseOptions() reads back as is."""
    if value.startswith("{") or not re.search(r"[\s'\"\\]", value):
        return "%s=%s" % (name, value)
    return '%s="%s"' % (name, value.replace("\\", "\\\\").replace('"', '\\"'))


def duplex_mode(opts):
    """'long', 'short' or None.  The PPD option wins over the IPP attribute,
    the same precedence cupsd uses when it maps one to the other."""
    d = opts.get("Duplex")
    if d is not None:
        d = d.lower()
        if d in ("duplexnotumble", "longedge", "top"):
            return "long"
        if d in ("duplextumble", "shortedge", "bottom"):
            return "short"
        return None
    sides = opts.get("sides", "")
    if sides == "two-sided-long-edge":
        return "long"
    if sides == "two-sided-short-edge":
        return "short"
    return None


def qpdf(*args):
    r = subprocess.run(["qpdf"] + list(args), stdout=subprocess.PIPE,
                       stderr=subprocess.PIPE, text=True)
    # 3 means warnings only: the output was written and is usable
    if r.returncode not in (0, 3):
        raise RuntimeError("qpdf %s: %s" % (" ".join(args), r.stderr.strip()))
    return r.stdout


def queue_backs(printer, user, title, opts, path):
    """Queue the second pass on this printer, owned by the job's user."""
    o = {k: v for k, v in opts.items() if k in FORWARD}
    o.update({"InputSlot": "Manual", "page-set": "even", "outputorder": "reverse",
              "sides": "one-sided", MARK: "2"})
    cmd = ["lp", "-d", printer, "-U", user, "-t", "%s (2/2)" % title, "-n", "1", "-q", "100"]
    for name, value in o.items():
        cmd += ["-o", option_arg(name, value)]
    cmd.append(path)
    log("DEBUG", "manualduplex: %s" % " ".join(cmd))
    r = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True)
    if r.returncode != 0:
        raise RuntimeError("lp: %s" % (r.stderr or r.stdout).strip())
    m = re.search(r"request id is (\S+)", r.stdout)
    return m.group(1) if m else "?"


def send(path):
    with open(path, "rb") as f:
        shutil.copyfileobj(f, sys.stdout.buffer, 1 << 20)
    sys.stdout.buffer.flush()


def main(argv):
    if len(argv) not in (6, 7):
        log("ERROR", "usage: manualduplex job-id user title copies options [file]")
        return 1
    job_id, user, title, copies, options = argv[1:6]
    opts = parse_options(options)
    mode = duplex_mode(opts)
    printer = os.environ.get("PRINTER", "")

    work = tempfile.mkdtemp(prefix="manualduplex-%s-" % job_id,
                            dir=os.environ.get("TMPDIR") or None)
    # cupsd stops a cancelled job with SIGTERM: leave through the finally
    signal.signal(signal.SIGTERM, lambda *a: sys.exit(1))
    try:
        if len(argv) == 7:
            doc = argv[6]
        else:
            doc = os.path.join(work, "job.pdf")
            with open(doc, "wb") as f:
                shutil.copyfileobj(sys.stdin.buffer, f, 1 << 20)

        if not mode or MARK in opts:
            send(doc)
            return 0
        with open(doc, "rb") as f:
            if b"%PDF-" not in f.read(1024):
                log("WARNING", "manualduplex: the job is not a PDF, printing it one-sided")
                send(doc)
                return 0
        if not printer:
            log("WARNING", "manualduplex: PRINTER is not set, printing one-sided")
            send(doc)
            return 0
        try:
            sides = int(qpdf("--show-npages", doc).strip())
        except (RuntimeError, ValueError) as e:
            log("WARNING", "manualduplex: cannot count the sides (%s), printing one-sided" % e)
            send(doc)
            return 0
        if sides < 2:
            log("INFO", "Only one page: nothing to print on the back")
            send(doc)
            return 0

        try:
            fronts = os.path.join(work, "fronts.pdf")
            qpdf(doc, "--pages", ".", "1-z:odd", "--", fronts)
            backs = doc
            if mode == "long":
                backs = os.path.join(work, "backs.pdf")
                qpdf("--rotate=+180", doc, backs)
            jid = queue_backs(printer, user, title, opts, backs)
        except RuntimeError as e:
            # Better every page on one side than half the document.
            log("ERROR", "manualduplex: %s; printing all pages one-sided" % e)
            send(doc)
            return 0

        log("INFO", "%d sheet(s): printing the fronts; the backs follow as job %s through "
                    "the manual feeder. Put the printed stack back in the tray as it came out "
                    "and press the button when the printer asks" % ((sides + 1) // 2, jid))
        send(fronts)
        return 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


if __name__ == "__main__":
    sys.exit(main(sys.argv))
