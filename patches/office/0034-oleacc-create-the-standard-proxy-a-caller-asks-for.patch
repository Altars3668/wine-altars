+const struct win_class_data* find_class_data(HWND, const WCHAR*, const struct win_class_data*);
 
-HRESULT create_client_object(HWND, const IID*, void**);
-HRESULT create_window_object(HWND, const IID*, void**);
+HRESULT create_client_object(HWND, const WCHAR*, const IID*, void**);
+HRESULT create_window_object(HWND, const WCHAR*, const IID*, void**);
 HRESULT get_accpropservices_factory(REFIID, void**);
 
 int convert_child_id(VARIANT *v);
