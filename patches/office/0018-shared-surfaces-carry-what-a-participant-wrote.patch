--- a/dlls/d3d11/shared.c
+++ b/dlls/d3d11/shared.c
@@ -281,6 +281,26 @@
     return S_OK;
 }
 
+/* A participant that only reads a shared surface must not make the other side's
+ * copy look stale: if it did, the next acquire on that side would upload this
+ * one's copy over whatever it had drawn in the meantime and destroy it.  So the
+ * carry is driven by "was this texture written to", which is what this marks.
+ * Over-marking is harmless -- it costs one readback -- so binding as a render
+ * target counts, without waiting to see whether a draw followed. */
+void d3d_shared_resource_mark_dirty(ID3D11Resource *resource)
+{
+    struct d3d_texture2d *texture;
+    ID3D11Texture2D *tex2d;
+
+    if (!resource)
+        return;
+    if (FAILED(ID3D11Resource_QueryInterface(resource, &IID_ID3D11Texture2D, (void **)&tex2d)))
+        return;
+    if ((texture = unsafe_impl_from_ID3D11Texture2D(tex2d)) && texture->shared)
+        texture->shared_dirty = TRUE;
+    ID3D11Texture2D_Release(tex2d);
+}
+
 /* IDXGIKeyedMutex, one per participating texture, all over the same state. */
 
 static inline struct d3d_texture2d *impl_from_IDXGIKeyedMutex(IDXGIKeyedMutex *iface)
@@ -374,13 +394,18 @@
     }
     shared->acquired = TRUE;
     generation = shared->generation;
-    stale = shared->bits && texture->shared_generation != generation;
+    /* Not if this texture has been drawn into since: uploading over it would
+     * throw that away, and there is no way to merge the two. */
+    stale = shared->bits && texture->shared_generation != generation && !texture->shared_dirty;
     LeaveCriticalSection(&shared->cs);
 
     /* Outside the lock: this touches only our own device's context, and no
      * other participant can acquire the surface while we hold it. */
     if (stale && SUCCEEDED(hr = shared_surface_upload(shared, texture)))
+    {
         texture->shared_generation = generation;
+        texture->shared_dirty = FALSE;
+    }
 
     return hr;
 }
@@ -405,8 +430,17 @@
         WARN("Released without being acquired.\n");
         return E_FAIL;
     }
-    /* Nothing to carry anywhere while this surface has one participant. */
-    others = shared->textures.next != shared->textures.prev;
+    /* Carry whenever this participant actually wrote.  It is tempting to skip
+     * that while the surface has only one participant -- nobody to carry to
+     * yet -- and that is wrong: the second participant opens the surface after
+     * the first has already drawn into it, and with the content dropped it
+     * acquires an empty texture and composites from it.  Measured under Word:
+     * the glyph tiles for the Backstage rail are copied out of the shared
+     * atlas by the compositing device on a texture with generation 0, i.e.
+     * one that had never been given anything, while the renderer had drawn
+     * and released before the opener existed.  A participant that only read
+     * the surface is still skipped -- that is what shared_dirty is for. */
+    others = texture->shared_dirty;
     LeaveCriticalSection(&shared->cs);
 
     /* Whoever held it may have drawn, so its pixels are the ones that matter
@@ -419,7 +453,10 @@
     EnterCriticalSection(&shared->cs);
     {
         if (SUCCEEDED(hr) && others)
+        {
             texture->shared_generation = ++shared->generation;
+            texture->shared_dirty = FALSE;
+        }
         shared->acquired = FALSE;
         shared->key = key;
         WakeAllConditionVariable(&shared->cv);
