+static HRESULT load_account_metadata_file(const WCHAR *name,HSTRING *value)
+{
+    static const WCHAR dir[]=L"Z:\\tmp\\office-wam-tokens\\";
+    WCHAR path[MAX_PATH];
+
+    wcscpy(path,dir);
+    wcsncat(path,name,ARRAY_SIZE(path)-ARRAY_SIZE(dir));
+    return read_token_file(path,value);
+}
+
+static BOOL metadata_file_missing(HRESULT hr)
+{
+    return hr==HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND) ||
+           hr==HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND);
+}
+
+/* 优先使用同一次原生响应附带的账户 ID 与用户名，避免把历史注册表
+ * 状态当作当前 token 的主体。旧存储仍保留注册表回退供诊断使用；
+ * 这条兼容路径不构成已验证的账户绑定或真实交互登录实现。 */
+static HRESULT load_account_identity(HSTRING *id,HSTRING *user_name)
+{
+    static const WCHAR mapkey[]=L"Software\\Microsoft\\Office\\16.0\\Common\\Licensing\\"
+                                 "LicensingNext\\LicenseIdToEmailMapping";
+    WCHAR cid[256],mail[256];
+    DWORD size;
+    HRESULT hr;
+
+    *id=NULL;
+    *user_name=NULL;
+    hr=load_account_metadata_file(L"account-id",id);
+    if(FAILED(hr))
+    {
+        if(!metadata_file_missing(hr))return hr;
+        if(office_connected_cid(cid,sizeof(cid)))
+            hr=WindowsCreateString(cid,lstrlenW(cid),id);
+        else
+            hr=WindowsCreateString(NULL,0,id);
+        if(FAILED(hr))return hr;
+    }
+
+    hr=load_account_metadata_file(L"account-username",user_name);
+    if(FAILED(hr))
+    {
+        if(!metadata_file_missing(hr))goto failed;
+        size=sizeof(mail);
+        if(office_connected_cid(cid,sizeof(cid)) &&
+           !RegGetValueW(HKEY_CURRENT_USER,mapkey,cid,RRF_RT_REG_SZ,NULL,mail,&size))
+            hr=WindowsCreateString(mail,lstrlenW(mail),user_name);
+        else
+            hr=WindowsCreateString(NULL,0,user_name);
+        if(FAILED(hr))goto failed;
+    }
+
+    TRACE("loaded broker account metadata: id length %u, user name length %u.\n",
+          WindowsGetStringLen(*id),WindowsGetStringLen(*user_name));
+    return S_OK;
+
+failed:
+    WindowsDeleteString(*id);
+    *id=NULL;
+    return hr;
+}
