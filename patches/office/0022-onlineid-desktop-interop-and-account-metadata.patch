+/* Win32 desktop callers use IWebAuthenticationCoreManagerInterop so the
+ * credential window can be parented to their HWND. The result is the same
+ * IAsyncOperation<WebTokenRequestResult> as the UWP-shaped statics methods;
+ * riid only selects that parameterized interface from the operation object.
+ *
+ * This implementation still does not manufacture credentials. If an
+ * authorized token exists in the per-scope store it is returned, otherwise an
+ * interactive request completes as UserCancel. That is the observable result
+ * of an interaction which produced no credential, and unlike E_NOINTERFACE it
+ * does not tell the caller that the Windows Web Account Manager ABI is absent. */
+static HRESULT token_result_for_request_iid(void *request, INT no_token_status, REFIID riid, void **result)
+{
+    IUnknown *operation;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (FAILED(hr = token_result_for_request(request, no_token_status, (void **)&operation))) return hr;
+    hr = IUnknown_QueryInterface(operation, riid, result);
+    IUnknown_Release(operation);
+    return hr;
+}
+
+static HRESULT WINAPI interop_RequestTokenForWindowAsync(struct webauth_interop *iface, HWND window,
+        IInspectable *request, REFIID riid, void **result)
+{
+    TRACE("iface %p, window %p, request %p, riid %s, result %p.\n",
+          iface, window, request, debugstr_guid(riid), result);
+    return token_result_for_request_iid(request, WEB_TOKEN_USER_CANCEL, riid, result);
+}
+
+static HRESULT WINAPI interop_RequestTokenWithWebAccountForWindowAsync(struct webauth_interop *iface,
+        HWND window, IInspectable *request, IInspectable *account, REFIID riid, void **result)
+{
+    TRACE("iface %p, window %p, request %p, account %p, riid %s, result %p.\n",
+          iface, window, request, account, debugstr_guid(riid), result);
+    return token_result_for_request_iid(request, WEB_TOKEN_USER_CANCEL, riid, result);
+}
+
