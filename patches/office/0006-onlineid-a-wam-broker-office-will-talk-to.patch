+    if (!(provider = calloc(1, sizeof(*provider)))) return E_OUTOFMEMORY;
+    provider->iface.lpVtbl = &provider_vtbl;
+    provider->iface2.lpVtbl = &provider2_vtbl;
+    provider->iface3.lpVtbl = &provider3_vtbl;
+    provider->iface4.lpVtbl = &provider4_vtbl;
+    provider->ref = 1;
+    if (FAILED(WindowsDuplicateString(id, &provider->id)) ||
+        FAILED(WindowsDuplicateString(authority, &provider->authority)))
+    { provider_release(provider); return E_OUTOFMEMORY; }
