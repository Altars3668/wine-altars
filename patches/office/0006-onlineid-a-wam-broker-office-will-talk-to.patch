+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(webauth);
+
+/* These two statics interfaces are the ones Office asks for. They are declared
+ * locally for now so this diagnostic can tell us which method Office calls
+ * before a full Windows.Security.Authentication.Web.Core IDL is introduced. */
+static const GUID IID_IWebAuthenticationCoreManagerStatics =
+    {0x6aca7c92,0xa581,0x4479,{0x9c,0x10,0x75,0x2e,0xff,0x44,0xfd,0x34}};
+static const GUID IID_IWebAuthenticationCoreManagerStatics4 =
+    {0x54e633fe,0x96e0,0x41e8,{0x98,0x32,0x12,0x98,0x89,0x7c,0x2a,0xaf}};
+
+struct webauth_statics;
+struct webauth_statics4;
+
+struct webauth_statics_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)(struct webauth_statics *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(struct webauth_statics *);
+    ULONG (WINAPI *Release)(struct webauth_statics *);
+    HRESULT (WINAPI *GetIids)(struct webauth_statics *, ULONG *, IID **);
+    HRESULT (WINAPI *GetRuntimeClassName)(struct webauth_statics *, HSTRING *);
+    HRESULT (WINAPI *GetTrustLevel)(struct webauth_statics *, TrustLevel *);
+    HRESULT (WINAPI *GetTokenSilentlyAsync)(struct webauth_statics *, void *, void **);
+    HRESULT (WINAPI *GetTokenSilentlyWithWebAccountAsync)(struct webauth_statics *, void *, void *, void **);
+    HRESULT (WINAPI *RequestTokenAsync)(struct webauth_statics *, void *, void **);
+    HRESULT (WINAPI *RequestTokenWithWebAccountAsync)(struct webauth_statics *, void *, void *, void **);
+    HRESULT (WINAPI *FindAccountAsync)(struct webauth_statics *, void *, HSTRING, void **);
+    HRESULT (WINAPI *FindAccountProviderAsync)(struct webauth_statics *, HSTRING, void **);
+    HRESULT (WINAPI *FindAccountProviderWithAuthorityAsync)(struct webauth_statics *, HSTRING, HSTRING, void **);
+};
+struct webauth_statics { const struct webauth_statics_vtbl *lpVtbl; };
+
+struct webauth_statics4_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)(struct webauth_statics4 *, REFIID, void **);
+    ULONG (WINAPI *AddRef)(struct webauth_statics4 *);
+    ULONG (WINAPI *Release)(struct webauth_statics4 *);
+    HRESULT (WINAPI *GetIids)(struct webauth_statics4 *, ULONG *, IID **);
+    HRESULT (WINAPI *GetRuntimeClassName)(struct webauth_statics4 *, HSTRING *);
+    HRESULT (WINAPI *GetTrustLevel)(struct webauth_statics4 *, TrustLevel *);
+    HRESULT (WINAPI *FindAllAccountsAsync)(struct webauth_statics4 *, void *, void **);
+    HRESULT (WINAPI *FindAllAccountsWithClientIdAsync)(struct webauth_statics4 *, void *, HSTRING, void **);
+    HRESULT (WINAPI *FindSystemAccountProviderAsync)(struct webauth_statics4 *, HSTRING, void **);
+    HRESULT (WINAPI *FindSystemAccountProviderWithAuthorityAsync)(struct webauth_statics4 *, HSTRING, HSTRING, void **);
+    HRESULT (WINAPI *FindSystemAccountProviderWithAuthorityForUserAsync)(struct webauth_statics4 *, HSTRING, HSTRING, void *, void **);
+};
+struct webauth_statics4 { const struct webauth_statics4_vtbl *lpVtbl; };
+
+struct webauth_factory_impl
+{
+    IActivationFactory IActivationFactory_iface;
+    struct webauth_statics statics_iface;
+    struct webauth_statics4 statics4_iface;
+    LONG ref;
+};
+
+static struct webauth_factory_impl impl;
+
+static inline struct webauth_factory_impl *impl_from_factory(IActivationFactory *iface)
+{
+    return CONTAINING_RECORD(iface, struct webauth_factory_impl, IActivationFactory_iface);
+}
+
+static HRESULT WINAPI factory_QueryInterface(IActivationFactory *iface, REFIID iid, void **out)
+{
+    struct webauth_factory_impl *obj = impl_from_factory(iface);
+
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+    if (!out) return E_POINTER;
+    *out = NULL;
+
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IActivationFactory))
+        *out = &obj->IActivationFactory_iface;
+    else if (IsEqualGUID(iid, &IID_IWebAuthenticationCoreManagerStatics))
+        *out = &obj->statics_iface;
+    else if (IsEqualGUID(iid, &IID_IWebAuthenticationCoreManagerStatics4))
+        *out = &obj->statics4_iface;
+
+    if (!*out)
+    {
+        FIXME("interface %s not implemented.\n", debugstr_guid(iid));
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef((IInspectable *)*out);
+    return S_OK;
+}
+static ULONG WINAPI factory_AddRef(IActivationFactory *iface)
+{
+    return InterlockedIncrement(&impl_from_factory(iface)->ref);
+}
+static ULONG WINAPI factory_Release(IActivationFactory *iface)
+{
+    return InterlockedDecrement(&impl_from_factory(iface)->ref);
+}
+static HRESULT WINAPI factory_GetIids(IActivationFactory *iface, ULONG *count, IID **iids)
+{
+    return E_NOTIMPL;
+}
+static HRESULT WINAPI factory_GetRuntimeClassName(IActivationFactory *iface, HSTRING *name)
+{
+    static const WCHAR class_name[] = L"Windows.Security.Authentication.Web.Core.WebAuthenticationCoreManager";
+    return WindowsCreateString(class_name, ARRAY_SIZE(class_name) - 1, name);
+}
+static HRESULT WINAPI factory_GetTrustLevel(IActivationFactory *iface, TrustLevel *level)
+{
+    *level = BaseTrust;
+    return S_OK;
+}
+static HRESULT WINAPI factory_ActivateInstance(IActivationFactory *iface, IInspectable **instance)
+{
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+static const IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface, factory_AddRef, factory_Release,
+    factory_GetIids, factory_GetRuntimeClassName, factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+#define BASE_METHODS(type, prefix, member) \
+static HRESULT WINAPI prefix##_QueryInterface(type *iface, REFIID iid, void **out) \
+{ return factory_QueryInterface(&impl.IActivationFactory_iface, iid, out); } \
+static ULONG WINAPI prefix##_AddRef(type *iface) \
+{ return factory_AddRef(&impl.IActivationFactory_iface); } \
+static ULONG WINAPI prefix##_Release(type *iface) \
+{ return factory_Release(&impl.IActivationFactory_iface); } \
+static HRESULT WINAPI prefix##_GetIids(type *iface, ULONG *count, IID **iids) \
+{ return E_NOTIMPL; } \
+static HRESULT WINAPI prefix##_GetRuntimeClassName(type *iface, HSTRING *name) \
+{ return factory_GetRuntimeClassName(&impl.IActivationFactory_iface, name); } \
+static HRESULT WINAPI prefix##_GetTrustLevel(type *iface, TrustLevel *level) \
+{ return factory_GetTrustLevel(&impl.IActivationFactory_iface, level); }
+
+BASE_METHODS(struct webauth_statics, statics, statics_iface)
+
+/* Minimal WebAccountProvider and an already-completed IAsyncOperation around
+ * it. This is still instrumentation: the operation accepts the parameterized
+ * IID Office asks for and logs it, which tells us the next ABI boundary without
+ * guessing that IID. The vtable itself is the ABI shared by every
+ * IAsyncOperation<T>. */
+static const GUID IID_IWebAccountProvider =
+    {0x29dcc8c3,0x7ab9,0x4a7c,{0xa3,0x36,0xb9,0x42,0xf9,0xdb,0xf7,0xc7}};
+static const GUID IID_IWebAccountProvider2 =
+    {0x4a01eb05,0x4e42,0x41d4,{0xb5,0x18,0xe0,0x08,0xa5,0x16,0x36,0x14}};
+static const GUID IID_IWebAccountProvider3 =
+    {0xda1c518b,0x970d,0x4d49,{0x82,0x5c,0xf2,0x70,0x6f,0x8c,0xa7,0xfe}};
+static const GUID IID_IWebAccountProvider4 =
+    {0x718fd8db,0xe796,0x4210,{0xb7,0x4e,0x84,0xd2,0x98,0x94,0xb0,0x80}};
+
+struct provider_iface;
+struct provider_iface2;
+struct provider_iface3;
+struct provider_iface4;
+struct async_operation;
+struct async_info;
+struct completed_handler;
+
+#define INSPECTABLE_VTBL(type) \
+    HRESULT (WINAPI *QueryInterface)(type *, REFIID, void **); \
+    ULONG (WINAPI *AddRef)(type *); \
+    ULONG (WINAPI *Release)(type *); \
+    HRESULT (WINAPI *GetIids)(type *, ULONG *, IID **); \
+    HRESULT (WINAPI *GetRuntimeClassName)(type *, HSTRING *); \
+    HRESULT (WINAPI *GetTrustLevel)(type *, TrustLevel *)
+
+struct provider_vtbl
+{
+    INSPECTABLE_VTBL(struct provider_iface);
+    HRESULT (WINAPI *get_Id)(struct provider_iface *, HSTRING *);
+    HRESULT (WINAPI *get_DisplayName)(struct provider_iface *, HSTRING *);
+    HRESULT (WINAPI *get_IconUri)(struct provider_iface *, void **);
+};
+struct provider2_vtbl
+{
+    INSPECTABLE_VTBL(struct provider_iface2);
+    HRESULT (WINAPI *get_DisplayPurpose)(struct provider_iface2 *, HSTRING *);
+    HRESULT (WINAPI *get_Authority)(struct provider_iface2 *, HSTRING *);
+};
+struct provider3_vtbl
+{
+    INSPECTABLE_VTBL(struct provider_iface3);
+    HRESULT (WINAPI *get_User)(struct provider_iface3 *, void **);
+};
+struct provider4_vtbl
+{
+    INSPECTABLE_VTBL(struct provider_iface4);
+    HRESULT (WINAPI *get_IsSystemProvider)(struct provider_iface4 *, boolean *);
+};
+struct provider_iface { const struct provider_vtbl *lpVtbl; };
+struct provider_iface2 { const struct provider2_vtbl *lpVtbl; };
+struct provider_iface3 { const struct provider3_vtbl *lpVtbl; };
+struct provider_iface4 { const struct provider4_vtbl *lpVtbl; };
+
+struct provider
+{
+    struct provider_iface iface;
+    struct provider_iface2 iface2;
+    struct provider_iface3 iface3;
+    struct provider_iface4 iface4;
+    LONG ref;
+    HSTRING id;
+    HSTRING authority;
+};
+
+struct async_operation_vtbl
+{
+    INSPECTABLE_VTBL(struct async_operation);
+    HRESULT (WINAPI *put_Completed)(struct async_operation *, struct completed_handler *);
+    HRESULT (WINAPI *get_Completed)(struct async_operation *, struct completed_handler **);
+    HRESULT (WINAPI *GetResults)(struct async_operation *, void **);
+};
+struct async_info_vtbl
+{
+    INSPECTABLE_VTBL(struct async_info);
+    HRESULT (WINAPI *get_Id)(struct async_info *, UINT *);
+    HRESULT (WINAPI *get_Status)(struct async_info *, AsyncStatus *);
+    HRESULT (WINAPI *get_ErrorCode)(struct async_info *, HRESULT *);
+    HRESULT (WINAPI *Cancel)(struct async_info *);
+    HRESULT (WINAPI *Close)(struct async_info *);
+};
+struct completed_handler_vtbl
+{
+    INSPECTABLE_VTBL(struct completed_handler);
+    HRESULT (WINAPI *Invoke)(struct completed_handler *, struct async_operation *, AsyncStatus);
+};
+struct async_operation { const struct async_operation_vtbl *lpVtbl; };
+struct async_info { const struct async_info_vtbl *lpVtbl; };
+struct completed_handler { const struct completed_handler_vtbl *lpVtbl; };
+
+struct provider_operation
+{
+    struct async_operation operation_iface;
+    struct async_info info_iface;
+    LONG ref;
+    IUnknown *payload;
+    struct completed_handler *handler;
+    /* IAsyncAction and IAsyncOperation<T> share every slot but the last:
+     * GetResults takes no argument for an action. Handing an action back
+     * through the operation vtable would make GetResults write a result
+     * through whatever happened to be in the second argument register. */
+    BOOL is_action;
+};
+
+static const struct provider_vtbl provider_vtbl;
+static const struct provider2_vtbl provider2_vtbl;
+static const struct provider3_vtbl provider3_vtbl;
+static const struct provider4_vtbl provider4_vtbl;
+static const struct async_operation_vtbl async_operation_vtbl;
+static const struct async_info_vtbl async_info_vtbl;
+
+static struct provider *provider_from_iface(struct provider_iface *iface)
+{ return CONTAINING_RECORD(iface, struct provider, iface); }
+static struct provider *provider_from_iface2(struct provider_iface2 *iface)
+{ return CONTAINING_RECORD(iface, struct provider, iface2); }
+static struct provider *provider_from_iface3(struct provider_iface3 *iface)
+{ return CONTAINING_RECORD(iface, struct provider, iface3); }
+static struct provider *provider_from_iface4(struct provider_iface4 *iface)
+{ return CONTAINING_RECORD(iface, struct provider, iface4); }
+
+static HRESULT provider_query(struct provider *obj, REFIID iid, void **out)
+{
+    TRACE("provider %p QI %s.\n", obj, debugstr_guid(iid));
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IInspectable) ||
+        IsEqualGUID(iid, &IID_IAgileObject) || IsEqualGUID(iid, &IID_IWebAccountProvider))
+        *out = &obj->iface;
+    else if (IsEqualGUID(iid, &IID_IWebAccountProvider2)) *out = &obj->iface2;
+    else if (IsEqualGUID(iid, &IID_IWebAccountProvider3)) *out = &obj->iface3;
+    else if (IsEqualGUID(iid, &IID_IWebAccountProvider4)) *out = &obj->iface4;
+    if (!*out) { FIXME("provider interface %s not implemented.\n", debugstr_guid(iid)); return E_NOINTERFACE; }
+    InterlockedIncrement(&obj->ref);
+    return S_OK;
+}
+static ULONG provider_addref(struct provider *obj) { return InterlockedIncrement(&obj->ref); }
+static ULONG provider_release(struct provider *obj)
+{
+    ULONG ref = InterlockedDecrement(&obj->ref);
+    if (!ref) { WindowsDeleteString(obj->id); WindowsDeleteString(obj->authority); free(obj); }
+    return ref;
+}
+#define PROVIDER_BASE(type, prefix, from) \
+static HRESULT WINAPI prefix##_QueryInterface(type *iface, REFIID iid, void **out) { return provider_query(from(iface), iid, out); } \
+static ULONG WINAPI prefix##_AddRef(type *iface) { return provider_addref(from(iface)); } \
+static ULONG WINAPI prefix##_Release(type *iface) { return provider_release(from(iface)); } \
+static HRESULT WINAPI prefix##_GetIids(type *iface, ULONG *count, IID **iids) { return E_NOTIMPL; } \
+static HRESULT WINAPI prefix##_GetRuntimeClassName(type *iface, HSTRING *name) \
+{ static const WCHAR n[] = L"Windows.Security.Credentials.WebAccountProvider"; return WindowsCreateString(n, ARRAY_SIZE(n)-1, name); } \
+static HRESULT WINAPI prefix##_GetTrustLevel(type *iface, TrustLevel *level) { *level = BaseTrust; return S_OK; }
+
+PROVIDER_BASE(struct provider_iface, provider, provider_from_iface)
+PROVIDER_BASE(struct provider_iface2, provider2, provider_from_iface2)
+PROVIDER_BASE(struct provider_iface3, provider3, provider_from_iface3)
+PROVIDER_BASE(struct provider_iface4, provider4, provider_from_iface4)
+
+static HRESULT WINAPI provider_get_Id(struct provider_iface *iface, HSTRING *value)
+{ return WindowsDuplicateString(provider_from_iface(iface)->id, value); }
+static HRESULT WINAPI provider_get_DisplayName(struct provider_iface *iface, HSTRING *value)
+{
+    static const WCHAR name[] = L"Microsoft account";
+    return WindowsCreateString(name, ARRAY_SIZE(name)-1, value);
+}
+static HRESULT WINAPI provider_get_IconUri(struct provider_iface *iface, void **value)
+{ if (!value) return E_POINTER; *value = NULL; return S_OK; }
+static HRESULT WINAPI provider2_get_DisplayPurpose(struct provider_iface2 *iface, HSTRING *value)
+{
+    static const WCHAR purpose[] = L"Sign in to Microsoft 365";
+    return WindowsCreateString(purpose, ARRAY_SIZE(purpose)-1, value);
+}
+static HRESULT WINAPI provider2_get_Authority(struct provider_iface2 *iface, HSTRING *value)
+{ return WindowsDuplicateString(provider_from_iface2(iface)->authority, value); }
+static HRESULT WINAPI provider3_get_User(struct provider_iface3 *iface, void **value)
