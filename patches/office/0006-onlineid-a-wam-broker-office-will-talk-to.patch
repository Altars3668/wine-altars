+       !IsEqualGUID(iid,&IID_IAgileObject)&&!IsEqualGUID(iid,&IID_IKeyValuePair_HSTRING_HSTRING))
+    { FIXME("key/value pair %p QI %s not implemented.\n",iface,debugstr_guid(iid));*out=NULL;return E_NOINTERFACE; }
