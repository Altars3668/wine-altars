+static HRESULT load_authorized_token(HSTRING scope,HSTRING *token)
+{
+    static const WCHAR dir[]=L"Z:\\tmp\\office-wam-tokens";
+    static const WCHAR legacy[]=L"Z:\\tmp\\office-wam-token.txt";
+    WCHAR path[MAX_PATH],name[512];
+    DWORD attr;
+
+    *token=NULL;
+    attr=GetFileAttributesW(dir);
+    if(attr==INVALID_FILE_ATTRIBUTES||!(attr&FILE_ATTRIBUTE_DIRECTORY))
+    {
+        TRACE("no per-scope token store; falling back to the single-token file.\n");
+        return read_token_file(legacy,token);
