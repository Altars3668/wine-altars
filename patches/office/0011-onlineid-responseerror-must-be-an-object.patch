+/* Windows.Security.Authentication.Web.Core.WebProviderError.
+ *
+ * A WebTokenRequestResult must answer ResponseError with an *object*, never
+ * with a null pointer, and that is not a style preference. C++/WinRT's
+ * generated property getter is
+ *
+ *     WebProviderError ResponseError() const
+ *     {
+ *         void* value{};
+ *         check_hresult(...->get_ResponseError(&value));
+ *         return WebProviderError{ value, take_ownership_from_abi };
+ *     }
+ *
+ * -- it checks the HRESULT and then wraps whatever pointer came back without
+ * ever testing it, so "S_OK, and here is NULL" is a promise the caller takes
+ * literally. Its next line is a virtual call on that pointer.
+ *
+ * Measured, in Excel, answering the Safe Mode prompt: an unhandled page fault
+ * reading address 0 at mso30win32client.dll +0x5775f4, which disassembles to
+ *
+ *     5775cc  mov  rcx,[rcx]          ; the interface out of the wrapper
+ *     5775f4  mov  rax,[rcx]          ; <-- rcx is 0: read of the vtable
+ *     577607  mov  rax,[rax+0x30]     ; slot 6
+ *     57760b  call [rip+...]
+ *
+ * and whose own error-reporting context, two pointers it stages on the stack
+ * three instructions earlier, names itself:
+ * "...\winrt\Windows.Security.Authentication.Web.Core.h" and
+ * "auto __cdecl winrt::impl::consume_Windows_Security_Authentication_Web_Core_
+ * IWebProviderError<...>". Slot 6 is get_ErrorCode.
+ *
+ * The IID was read out of the name/IID table C++/WinRT leaves in
+ * WebView2Host.dll, using a rule verified against IWebTokenRequestResult's
+ * already-known IID before it was trusted for this one.
+ *
+ * What the object *says* is deliberately minimal: this broker never contacted
+ * an identity provider, so there is no provider error code to report, and
+ * inventing one would be the "wrong error code" mistake this project has
+ * already paid for elsewhere. ErrorCode is 0 and ErrorMessage says plainly
+ * where the answer came from. If Office turns out to act on a specific code
+ * here, that is a measurement to take and not a value to guess at now. */
+static const GUID IID_IWebProviderError =
+    {0xdb191bb1,0x50c5,0x4809,{0x8d,0xca,0x09,0xc9,0x94,0x10,0x24,0x5c}};
+struct provider_error_iface;
+struct provider_error_vtbl
+{
+    INSPECTABLE_VTBL(struct provider_error_iface);
+    HRESULT (WINAPI *get_ErrorCode)(struct provider_error_iface *, UINT32 *);
+    HRESULT (WINAPI *get_ErrorMessage)(struct provider_error_iface *, HSTRING *);
+    HRESULT (WINAPI *get_Properties)(struct provider_error_iface *, void **);
+};
+struct provider_error_iface { const struct provider_error_vtbl *lpVtbl; };
+struct provider_error { struct provider_error_iface iface; LONG ref; UINT32 code; IMap_HSTRING_HSTRING *properties; };
+static struct provider_error *provider_error_from_iface(struct provider_error_iface *iface)
+{ return CONTAINING_RECORD(iface,struct provider_error,iface); }
+static HRESULT WINAPI provider_error_QueryInterface(struct provider_error_iface *iface,REFIID iid,void **out)
+{
+    struct provider_error *obj=provider_error_from_iface(iface);TRACE("provider error %p QI %s.\n",obj,debugstr_guid(iid));
+    if(!out)return E_POINTER;if(!IsEqualGUID(iid,&IID_IUnknown)&&!IsEqualGUID(iid,&IID_IInspectable)&&
+       !IsEqualGUID(iid,&IID_IAgileObject)&&!IsEqualGUID(iid,&IID_IWebProviderError)){*out=NULL;return E_NOINTERFACE;}
+    *out=iface;InterlockedIncrement(&obj->ref);return S_OK;
+}
+static ULONG WINAPI provider_error_AddRef(struct provider_error_iface *iface)
+{return InterlockedIncrement(&provider_error_from_iface(iface)->ref);}
+static ULONG WINAPI provider_error_Release(struct provider_error_iface *iface)
+{struct provider_error *obj=provider_error_from_iface(iface);ULONG ref=InterlockedDecrement(&obj->ref);
+ if(!ref){if(obj->properties)IMap_HSTRING_HSTRING_Release(obj->properties);free(obj);}return ref;}
+static HRESULT WINAPI provider_error_GetIids(struct provider_error_iface *iface,ULONG *c,IID **i){return E_NOTIMPL;}
+static HRESULT WINAPI provider_error_GetRuntimeClassName(struct provider_error_iface *iface,HSTRING *name)
+{static const WCHAR n[]=L"Windows.Security.Authentication.Web.Core.WebProviderError";return WindowsCreateString(n,ARRAY_SIZE(n)-1,name);}
+static HRESULT WINAPI provider_error_GetTrustLevel(struct provider_error_iface *iface,TrustLevel *level){*level=BaseTrust;return S_OK;}
+static HRESULT WINAPI provider_error_get_ErrorCode(struct provider_error_iface *iface,UINT32 *code)
+{struct provider_error *obj=provider_error_from_iface(iface);TRACE("provider error %p code %u.\n",obj,obj->code);if(!code)return E_POINTER;*code=obj->code;return S_OK;}
+static HRESULT WINAPI provider_error_get_ErrorMessage(struct provider_error_iface *iface,HSTRING *message)
+{
+    static const WCHAR m[]=L"No identity provider was contacted: this broker answers from the tokens present in the profile.";
+    TRACE("provider error %p message %p.\n",provider_error_from_iface(iface),message);
+    if(!message)return E_POINTER;
+    return WindowsCreateString(m,ARRAY_SIZE(m)-1,message);
+}
+/* The third property, and the reason this whole object exists twice over.
+ *
+ * Implementing IWebProviderError with only ErrorCode and ErrorMessage fixed
+ * the null-pointer fault it was written for and immediately produced another
+ * one, at mso30win32client.dll's CFG dispatch thunk with a garbage target.
+ * A stack scan at the fault (see the kernelbase diagnostic) gave the caller,
+ * whose staged error context names itself:
+ *
+ *     consume_..._IWebProviderError<...>::Properties(void) const
+ *
+ * and whose call site reads `mov rax,[rax+0x40]` -- vtable slot 8, one past
+ * the end of an eight-entry vtable. So the second fault was not the "next
+ * gap" it looked like; it was this object being one method short, and the
+ * indirect call landing on whatever .rdata followed the table.
+ *
+ * The lesson is narrow and worth stating: a WinRT interface implemented with
+ * *most* of its methods is not partially working, it is a live jump into
+ * unrelated data the moment the caller reaches the missing one. Count the
+ * methods against the metadata, not against what the caller has been seen to
+ * use so far. */
+static HRESULT WINAPI provider_error_get_Properties(struct provider_error_iface *iface,void **p)
+{
+    struct provider_error *obj=provider_error_from_iface(iface);HRESULT hr;
+    TRACE("provider error %p get Properties %p.\n",obj,p);
+    if(!p)return E_POINTER;
+    if(!obj->properties&&FAILED(hr=webauth_string_map_create(&obj->properties))){*p=NULL;return hr;}
+    *p=obj->properties;IMap_HSTRING_HSTRING_AddRef(obj->properties);return S_OK;
+}
+static const struct provider_error_vtbl provider_error_vtbl=
+{
+    provider_error_QueryInterface,provider_error_AddRef,provider_error_Release,
+    provider_error_GetIids,provider_error_GetRuntimeClassName,provider_error_GetTrustLevel,
+    provider_error_get_ErrorCode,provider_error_get_ErrorMessage,provider_error_get_Properties,
+};
+static HRESULT create_provider_error(UINT32 code,struct provider_error **out)
+{
+    struct provider_error *e;
+    if(!(e=calloc(1,sizeof(*e))))return E_OUTOFMEMORY;
+    e->iface.lpVtbl=&provider_error_vtbl;e->ref=1;e->code=code;*out=e;return S_OK;
+}
