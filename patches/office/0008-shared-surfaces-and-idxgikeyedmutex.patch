index 0000000..a417ef2
--- /dev/null
+++ b/dlls/d3d11/shared.c
@@ -0,0 +1,410 @@
+/*
+ * Surfaces shared between D3D devices.
+ *
+ * A texture created with D3D11_RESOURCE_MISC_SHARED* is handed to a second
+ * device by handle, and the two devices hand it back and forth through an
+ * IDXGIKeyedMutex.  Office's UI compositor is built on exactly this: it renders
+ * its text and icons on one device and composites them on another.
+ *
+ * Wine cannot give two wined3d devices one piece of storage -- a wined3d
+ * texture's GL object belongs to the context that created it, and handing the
+ * same texture to a second device makes every call succeed while the pixels
+ * quietly do not cross (tools/d3dshare in the wine-altars tree measures this).
+ * So each participant gets a texture of its own and the content is moved
+ * between them at the point the keyed mutex already defines: whoever acquires
+ * the surface gets the pixels of whoever released it last.
+ *
+ * That costs a round trip through system memory per handoff.  It is the honest
+ * price of not having shared storage, and it is paid only by surfaces an
+ * application actually shares.
+ */
+
+#include "d3d11_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d11);
+
+struct d3d_shared_surface
+{
+    LONG refcount;
+
+    CRITICAL_SECTION cs;
+    CONDITION_VARIABLE cv;
+    UINT64 key;
+    BOOL acquired;
+
+    struct d3d_texture2d *content;  /* whose pixels are current, NULL if nobody has written */
+    struct list textures;
+};
+
+static struct d3d_shared_surface *shared_surface_create(void)
+{
+    struct d3d_shared_surface *shared;
+
+    if (!(shared = calloc(1, sizeof(*shared))))
+        return NULL;
+
+    shared->refcount = 1;
+    InitializeCriticalSection(&shared->cs);
+    InitializeConditionVariable(&shared->cv);
+    list_init(&shared->textures);
+
+    return shared;
+}
+
+static void shared_surface_decref(struct d3d_shared_surface *shared)
+{
+    if (InterlockedDecrement(&shared->refcount))
+        return;
+    DeleteCriticalSection(&shared->cs);
+    free(shared);
+}
+
+/* The texture's own device's immediate context.  Released by the caller. */
+static ID3D11DeviceContext *texture_context(struct d3d_texture2d *texture)
+{
+    ID3D11DeviceContext *context = NULL;
+    ID3D11Device5_GetImmediateContext(texture->device, &context);
+    return context;
+}
+
+static HRESULT texture_get_staging(struct d3d_texture2d *texture, UINT cpu_access,
+        ID3D11Texture2D **staging)
+{
+    ID3D11Texture2D **cache = cpu_access == D3D11_CPU_ACCESS_READ
+            ? &texture->staging_read : &texture->staging_write;
+    D3D11_TEXTURE2D_DESC desc;
+    HRESULT hr;
+
+    if (*cache)
+    {
+        *staging = *cache;
+        return S_OK;
+    }
+
+    desc = texture->desc;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = cpu_access;
+    desc.MiscFlags = 0;
+
+    if (FAILED(hr = ID3D11Device5_CreateTexture2D(texture->device, &desc, NULL, cache)))
+    {
+        WARN("Failed to create a staging texture, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    *staging = *cache;
+    return S_OK;
+}
+
+/* Move src's pixels to dst.  The two live on different devices, so this goes
+ * out through a staging texture on one and in through a staging texture on the
+ * other; there is no shorter path without shared storage. */
+static HRESULT shared_surface_transfer(struct d3d_texture2d *src, struct d3d_texture2d *dst)
+{
+    ID3D11DeviceContext *src_context = NULL, *dst_context = NULL;
+    ID3D11Texture2D *src_staging, *dst_staging;
+    D3D11_MAPPED_SUBRESOURCE src_map, dst_map;
+    unsigned int y, row, rows;
+    HRESULT hr;
+
+    if (src->desc.Width != dst->desc.Width || src->desc.Height != dst->desc.Height
+            || src->desc.Format != dst->desc.Format)
+    {
+        WARN("Shared textures do not match: %ux%u fmt %#x vs %ux%u fmt %#x.\n",
+                src->desc.Width, src->desc.Height, src->desc.Format,
+                dst->desc.Width, dst->desc.Height, dst->desc.Format);
+        return E_INVALIDARG;
+    }
+
+    if (FAILED(hr = texture_get_staging(src, D3D11_CPU_ACCESS_READ, &src_staging)))
+        return hr;
+    if (FAILED(hr = texture_get_staging(dst, D3D11_CPU_ACCESS_WRITE, &dst_staging)))
+        return hr;
+
+    if (!(src_context = texture_context(src)) || !(dst_context = texture_context(dst)))
+    {
+        hr = E_FAIL;
+        goto done;
+    }
+
+    ID3D11DeviceContext_CopyResource(src_context, (ID3D11Resource *)src_staging,
+            (ID3D11Resource *)&src->ID3D11Texture2D_iface);
+    if (FAILED(hr = ID3D11DeviceContext_Map(src_context, (ID3D11Resource *)src_staging,
+            0, D3D11_MAP_READ, 0, &src_map)))
+    {
+        WARN("Failed to map the source staging texture, hr %#lx.\n", hr);
+        goto done;
+    }
+
+    if (FAILED(hr = ID3D11DeviceContext_Map(dst_context, (ID3D11Resource *)dst_staging,
+            0, D3D11_MAP_WRITE, 0, &dst_map)))
+    {
+        WARN("Failed to map the destination staging texture, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Unmap(src_context, (ID3D11Resource *)src_staging, 0);
+        goto done;
+    }
+
+    row = min(src_map.RowPitch, dst_map.RowPitch);
+    rows = src->desc.Height;
+    for (y = 0; y < rows; ++y)
+        memcpy((char *)dst_map.pData + (size_t)y * dst_map.RowPitch,
+                (const char *)src_map.pData + (size_t)y * src_map.RowPitch, row);
+
+    ID3D11DeviceContext_Unmap(dst_context, (ID3D11Resource *)dst_staging, 0);
+    ID3D11DeviceContext_Unmap(src_context, (ID3D11Resource *)src_staging, 0);
+
+    ID3D11DeviceContext_CopyResource(dst_context, (ID3D11Resource *)&dst->ID3D11Texture2D_iface,
+            (ID3D11Resource *)dst_staging);
+
+    TRACE("Moved %ux%u from texture %p to texture %p.\n", src->desc.Width, rows, src, dst);
+    hr = S_OK;
+
+done:
+    if (dst_context) ID3D11DeviceContext_Release(dst_context);
+    if (src_context) ID3D11DeviceContext_Release(src_context);
+    return hr;
+}
+
+/* IDXGIKeyedMutex, one per participating texture, all over the same state. */
+
+static inline struct d3d_texture2d *impl_from_IDXGIKeyedMutex(IDXGIKeyedMutex *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3d_texture2d, IDXGIKeyedMutex_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_QueryInterface(IDXGIKeyedMutex *iface,
+        REFIID riid, void **out)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_QueryInterface(&texture->ID3D11Texture2D_iface, riid, out);
+}
+
+static ULONG STDMETHODCALLTYPE d3d_keyed_mutex_AddRef(IDXGIKeyedMutex *iface)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_AddRef(&texture->ID3D11Texture2D_iface);
+}
+
+static ULONG STDMETHODCALLTYPE d3d_keyed_mutex_Release(IDXGIKeyedMutex *iface)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_Release(&texture->ID3D11Texture2D_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_SetPrivateData(IDXGIKeyedMutex *iface,
+        REFGUID guid, UINT size, const void *data)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_SetPrivateData(&texture->ID3D11Texture2D_iface, guid, size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_SetPrivateDataInterface(IDXGIKeyedMutex *iface,
+        REFGUID guid, const IUnknown *object)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_SetPrivateDataInterface(&texture->ID3D11Texture2D_iface, guid, object);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_GetPrivateData(IDXGIKeyedMutex *iface,
+        REFGUID guid, UINT *size, void *data)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_GetPrivateData(&texture->ID3D11Texture2D_iface, guid, size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_GetParent(IDXGIKeyedMutex *iface,
+        REFIID riid, void **parent)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Device5_QueryInterface(texture->device, riid, parent);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_GetDevice(IDXGIKeyedMutex *iface,
+        REFIID riid, void **device)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Device5_QueryInterface(texture->device, riid, device);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_AcquireSync(IDXGIKeyedMutex *iface,
+        UINT64 key, DWORD timeout)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    struct d3d_shared_surface *shared = texture->shared;
+    DWORD start = GetTickCount(), remaining = timeout;
+    struct d3d_texture2d *content = NULL;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, key %s, timeout %lu.\n", iface, wine_dbgstr_longlong(key), timeout);
+
+    if (!shared)
+        return E_FAIL;
+
+    EnterCriticalSection(&shared->cs);
+    while (shared->acquired || shared->key != key)
+    {
+        if (timeout != INFINITE)
+        {
+            DWORD elapsed = GetTickCount() - start;
+            remaining = elapsed >= timeout ? 0 : timeout - elapsed;
+        }
+        if (!SleepConditionVariableCS(&shared->cv, &shared->cs, remaining))
+        {
+            LeaveCriticalSection(&shared->cs);
+            return WAIT_TIMEOUT;
+        }
+    }
+    shared->acquired = TRUE;
+    if (shared->content && shared->content != texture)
+        content = shared->content;
+    LeaveCriticalSection(&shared->cs);
+
+    /* Outside the lock: the transfer touches two device contexts and the other
+     * participant cannot acquire while we hold it. */
+    if (content)
+        hr = shared_surface_transfer(content, texture);
+
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_ReleaseSync(IDXGIKeyedMutex *iface, UINT64 key)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    struct d3d_shared_surface *shared = texture->shared;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, key %s.\n", iface, wine_dbgstr_longlong(key));
+
+    if (!shared)
+        return E_FAIL;
+
+    EnterCriticalSection(&shared->cs);
+    if (!shared->acquired)
+    {
+        WARN("Released without being acquired.\n");
+        hr = E_FAIL;
+    }
+    else
+    {
+        /* Whoever held it may have drawn, so its pixels are now the ones that
+         * matter.  The copy happens when somebody else acquires. */
+        shared->content = texture;
+        shared->acquired = FALSE;
+        shared->key = key;
+        WakeAllConditionVariable(&shared->cv);
+    }
+    LeaveCriticalSection(&shared->cs);
+
+    return hr;
+}
+
+static const struct IDXGIKeyedMutexVtbl d3d_keyed_mutex_vtbl =
+{
+    d3d_keyed_mutex_QueryInterface,
+    d3d_keyed_mutex_AddRef,
+    d3d_keyed_mutex_Release,
+    d3d_keyed_mutex_SetPrivateData,
+    d3d_keyed_mutex_SetPrivateDataInterface,
+    d3d_keyed_mutex_GetPrivateData,
+    d3d_keyed_mutex_GetParent,
+    d3d_keyed_mutex_GetDevice,
+    d3d_keyed_mutex_AcquireSync,
+    d3d_keyed_mutex_ReleaseSync,
+};
+
+static BOOL texture_is_shared(const struct d3d_texture2d *texture)
+{
+    return !!(texture->desc.MiscFlags & (D3D11_RESOURCE_MISC_SHARED
+            | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX | D3D11_RESOURCE_MISC_SHARED_NTHANDLE));
+}
+
+/* Give this texture shared state, creating it if this is the first participant. */
+static struct d3d_shared_surface *texture_get_shared(struct d3d_texture2d *texture)
+{
+    struct d3d_shared_surface *shared;
+
+    if (texture->shared)
+        return texture->shared;
+
+    if (!(shared = shared_surface_create()))
+        return NULL;
+
+    texture->shared = shared;
+    texture->IDXGIKeyedMutex_iface.lpVtbl = &d3d_keyed_mutex_vtbl;
+    list_add_tail(&shared->textures, &texture->shared_entry);
+
+    /* The texture the surface was created from *is* the surface, so its pixels
+     * are the surface's pixels until somebody else writes.  Without this a
+     * newly opened texture starts uninitialised and whoever composites it first
+     * gets a black rectangle. */
+    shared->content = texture;
+
+    TRACE("Created shared state %p for texture %p.\n", shared, texture);
+
+    return shared;
+}
+
+HRESULT d3d_shared_surface_attach(struct d3d_texture2d *owner, struct d3d_texture2d *texture)
+{
+    struct d3d_shared_surface *shared;
+
+    if (!(shared = texture_get_shared(owner)))
+        return E_OUTOFMEMORY;
+
+    InterlockedIncrement(&shared->refcount);
+    texture->shared = shared;
+    texture->IDXGIKeyedMutex_iface.lpVtbl = &d3d_keyed_mutex_vtbl;
+
+    EnterCriticalSection(&shared->cs);
+    list_add_tail(&shared->textures, &texture->shared_entry);
+    LeaveCriticalSection(&shared->cs);
+
+    TRACE("Attached texture %p to shared state %p (owner %p).\n", texture, shared, owner);
+
+    return S_OK;
+}
+
+HRESULT d3d_texture2d_get_keyed_mutex(struct d3d_texture2d *texture, void **out)
+{
+    if (!texture_is_shared(texture))
+        return E_NOINTERFACE;
+
+    if (!texture_get_shared(texture))
+        return E_OUTOFMEMORY;
+
+    ID3D11Texture2D_AddRef(&texture->ID3D11Texture2D_iface);
+    *out = &texture->IDXGIKeyedMutex_iface;
+
+    return S_OK;
+}
+
+void d3d_texture2d_cleanup_shared(struct d3d_texture2d *texture)
+{
+    struct d3d_shared_surface *shared = texture->shared;
+
+    if (texture->staging_read)
+    {
+        ID3D11Texture2D_Release(texture->staging_read);
+        texture->staging_read = NULL;
+    }
+    if (texture->staging_write)
+    {
+        ID3D11Texture2D_Release(texture->staging_write);
+        texture->staging_write = NULL;
+    }
+
+    if (!shared)
+        return;
+
+    EnterCriticalSection(&shared->cs);
+    list_remove(&texture->shared_entry);
+    if (shared->content == texture)
+        shared->content = NULL;
+    LeaveCriticalSection(&shared->cs);
+
+    texture->shared = NULL;
+    shared_surface_decref(shared);
+}
