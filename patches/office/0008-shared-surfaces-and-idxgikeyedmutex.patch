+/* Shared resources.
+ *
+ * A resource created with D3D11_RESOURCE_MISC_SHARED* is handed to another
+ * device by handle.  Wine cannot yet share the storage across two
+ * wined3d_devices, but the handle has to exist and resolve back to the
+ * originating resource before any of that can be built on top, and returning
+ * a failure from GetSharedHandle is what stops applications one step earlier
+ * than they need to be stopped.  This is the registry, and nothing more: what
+ * the opening device does with the resource is its own business. */
+
+static struct list wined3d_shared_resources = LIST_INIT(wined3d_shared_resources);
+
+struct wined3d_shared_resource
+{
+    struct list entry;
+    HANDLE handle;
+    struct wined3d_resource *resource;
+};
+
+HRESULT CDECL wined3d_resource_get_shared_handle(struct wined3d_resource *resource, HANDLE *handle)
+{
+    struct wined3d_shared_resource *shared;
+
+    TRACE("resource %p, handle %p.\n", resource, handle);
+
+    if (!handle)
+        return E_INVALIDARG;
+
+    wined3d_mutex_lock();
+
+    LIST_FOR_EACH_ENTRY(shared, &wined3d_shared_resources, struct wined3d_shared_resource, entry)
+    {
+        if (shared->resource == resource)
+        {
+            *handle = shared->handle;
+            wined3d_mutex_unlock();
+            TRACE("Returning existing handle %p.\n", *handle);
+            return WINED3D_OK;
+        }
+    }
+
+    if (!(shared = malloc(sizeof(*shared))))
+    {
+        wined3d_mutex_unlock();
+        return E_OUTOFMEMORY;
+    }
+
+    /* A real kernel handle, so the value is unique for as long as the resource
+     * lives and an application that duplicates or closes it does something
+     * sane. */
+    if (!(shared->handle = CreateEventW(NULL, TRUE, FALSE, NULL)))
+    {
+        free(shared);
+        wined3d_mutex_unlock();
+        return E_FAIL;
+    }
+    shared->resource = resource;
+    list_add_head(&wined3d_shared_resources, &shared->entry);
+
+    wined3d_mutex_unlock();
+
+    *handle = shared->handle;
+    TRACE("Created handle %p.\n", *handle);
+
+    return WINED3D_OK;
+}
+
+struct wined3d_resource * CDECL wined3d_resource_from_shared_handle(HANDLE handle)
+{
+    struct wined3d_shared_resource *shared;
+    struct wined3d_resource *resource = NULL;
+
+    TRACE("handle %p.\n", handle);
+
+    wined3d_mutex_lock();
+    LIST_FOR_EACH_ENTRY(shared, &wined3d_shared_resources, struct wined3d_shared_resource, entry)
+    {
+        if (shared->handle == handle)
+        {
+            resource = shared->resource;
+            break;
+        }
+    }
+    wined3d_mutex_unlock();
+
+    return resource;
+}
+
+static void wined3d_resource_release_shared_handle(struct wined3d_resource *resource)
+{
+    struct wined3d_shared_resource *shared, *next;
+
+    wined3d_mutex_lock();
+    LIST_FOR_EACH_ENTRY_SAFE(shared, next, &wined3d_shared_resources, struct wined3d_shared_resource, entry)
+    {
+        if (shared->resource != resource)
+            continue;
+        list_remove(&shared->entry);
+        CloseHandle(shared->handle);
+        free(shared);
+    }
+    wined3d_mutex_unlock();
+}
+
 void resource_cleanup(struct wined3d_resource *resource)
 {
     TRACE("Cleaning up resource %p.\n", resource);
 
+    wined3d_resource_release_shared_handle(resource);
+
     if (!(resource->access & WINED3D_RESOURCE_ACCESS_CPU) && resource->usage & WINED3DUSAGE_VIDMEM_ACCOUNTING)
     {
         TRACE("Decrementing device memory pool by %u.\n", resource->size);
