+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_AcquireSync(IDXGIKeyedMutex *iface,
+        UINT64 key, DWORD timeout)
+{
+    struct dxgi_resource *resource = impl_from_IDXGIKeyedMutex(iface);
+    DWORD start = GetTickCount(), remaining = timeout;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, key %s, timeout %lu.\n", iface, wine_dbgstr_longlong(key), timeout);
+
+    EnterCriticalSection(&resource->mutex_cs);
+    while (resource->mutex_acquired || resource->mutex_key != key)
+    {
+        if (timeout != INFINITE)
+        {
+            DWORD elapsed = GetTickCount() - start;
+            remaining = elapsed >= timeout ? 0 : timeout - elapsed;
+        }
+        if (!SleepConditionVariableCS(&resource->mutex_cv, &resource->mutex_cs, remaining))
+        {
+            hr = WAIT_TIMEOUT;
+            break;
+        }
+    }
+    if (SUCCEEDED(hr))
+        resource->mutex_acquired = TRUE;
+    LeaveCriticalSection(&resource->mutex_cs);
+
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE dxgi_keyed_mutex_ReleaseSync(IDXGIKeyedMutex *iface, UINT64 key)
+{
+    struct dxgi_resource *resource = impl_from_IDXGIKeyedMutex(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, key %s.\n", iface, wine_dbgstr_longlong(key));
+
+    EnterCriticalSection(&resource->mutex_cs);
+    if (!resource->mutex_acquired)
+    {
+        WARN("Released without being acquired.\n");
+        hr = E_FAIL;
+    }
+    else
+    {
+        resource->mutex_acquired = FALSE;
+        resource->mutex_key = key;
+        WakeAllConditionVariable(&resource->mutex_cv);
+    }
+    LeaveCriticalSection(&resource->mutex_cs);
+
+    return hr;
+}
