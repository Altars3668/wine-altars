Subject: [PATCH] slc/sppc：修正服务信息的五参数 ABI

接在 0027 后应用。微软公开 slpublic.h 明确规定 SLGetServiceInformation
只有五个参数，ActivePlugins 返回活动插件的 MULTI_SZ 完整 DLL 路径列表。
修正声明、导出参数和 SLC 转发；仍返回 SL_E_VALUE_NOT_FOUND，不以空成功
或虚构路径伪装为插件后端。

只完成 ABI 与转发入口，不实现插件注册/加载、句柄与属性的完整原生语义，
也不授予许可。隔离探针验证 SLC/SPPC 在无插件后端时返回同一失败，不再
因 SLC 的未实现导出而异常退出。当前真实 Office 的 F076 尚未解决。

依据：
https://raw.githubusercontent.com/microsoft/win32metadata/main/generation/WinSDK/RecompiledIdlHeaders/um/slpublic.h

---
diff --git a/dlls/slc/slc.spec b/dlls/slc/slc.spec
--- a/dlls/slc/slc.spec
+++ b/dlls/slc/slc.spec
@@ -24,7 +24,7 @@
 @ stub SLGetProductSkuInformation
 @ stub SLGetSAMLicense
 @ stub SLGetSLIDList
-@ stub SLGetServiceInformation
+@ stdcall SLGetServiceInformation(ptr wstr ptr ptr ptr) sppc.SLGetServiceInformation
 @ stdcall SLGetWindowsInformation(wstr ptr ptr ptr)
 @ stdcall SLGetWindowsInformationDWORD(wstr ptr)
 @ stub SLInstallLicense
diff --git a/dlls/sppc/sppc.c b/dlls/sppc/sppc.c
--- a/dlls/sppc/sppc.c
+++ b/dlls/sppc/sppc.c
@@ -356,9 +356,11 @@
     return SL_E_VALUE_NOT_FOUND;
 }

-HRESULT WINAPI SLGetServiceInformation(void *a0, void *a1, void *a2, void *a3, void *a4, void *a5)
-{
-    FIXME("(%p %p %p %p %p %p) stub\n", a0, a1, a2, a3, a4, a5);
+HRESULT WINAPI SLGetServiceInformation(HSLC handle, LPCWSTR name, SLDATATYPE *type,
+                                      UINT *size, BYTE **value)
+{
+    FIXME("(%p,%s,%p,%p,%p) stub\n", handle, debugstr_w(name), type, size, value);
+    /* ActivePlugins 需要真正活动的插件路径；修正 ABI 不意味着已有插件后端。 */
     return SL_E_VALUE_NOT_FOUND;
 }

diff --git a/dlls/sppc/sppc.spec b/dlls/sppc/sppc.spec
--- a/dlls/sppc/sppc.spec
+++ b/dlls/sppc/sppc.spec
@@ -45,7 +45,7 @@
 @ stdcall SLGetPolicyInformationDWORD(ptr wstr ptr)
 @ stdcall SLGetProductSkuInformation(ptr ptr wstr ptr ptr ptr)
 @ stdcall SLGetSLIDList(ptr long ptr long ptr ptr)
-@ stdcall SLGetServiceInformation(ptr ptr ptr ptr ptr ptr)
+@ stdcall SLGetServiceInformation(ptr wstr ptr ptr ptr)
 @ stdcall SLInstallLicense(ptr long ptr ptr)
 @ stdcall SLInstallProofOfPurchase(ptr ptr ptr ptr ptr ptr)
 @ stdcall SLInstallProofOfPurchaseEx(ptr ptr ptr ptr ptr ptr)
diff --git a/include/slpublic.h b/include/slpublic.h
--- a/include/slpublic.h
+++ b/include/slpublic.h
@@ -63,6 +63,7 @@
 } SL_LICENSING_STATUS;

 SLCAPI HRESULT WINAPI SLGetLicensingStatusInformation(HSLC, const SLID*, const SLID*, LPCWSTR, UINT*, SL_LICENSING_STATUS**);
+SLCAPI HRESULT WINAPI SLGetServiceInformation(HSLC, LPCWSTR, SLDATATYPE*, UINT*, LPBYTE*);
 SLCAPI HRESULT WINAPI SLGetWindowsInformation(LPCWSTR, SLDATATYPE*, UINT*, LPBYTE*);

 typedef HANDLE HSLP;
