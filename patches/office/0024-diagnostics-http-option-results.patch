Subject: [PATCH] diagnostics: HTTP option results without request contents

记录选项编号、返回码和模块 RVA；不读取缓冲区；保留 GetLastError。
此补丁只供诊断，不要求作为正式修复保留。
---
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -56,6 +56,7 @@
 #include "resource.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(wininet);
+#include "wine/http_option_trace.h"
 
 typedef struct
 {
@@ -3257,6 +3258,8 @@
 
     if(res != ERROR_SUCCESS)
         SetLastError(res);
+    trace_http_option_result("InternetQueryOptionW", hInternet, dwOption, 0,
+                             res == ERROR_SUCCESS, GetLastError());
     return res == ERROR_SUCCESS;
 }
 
@@ -3441,8 +3444,8 @@
  *    FALSE on failure
  *
  */
-BOOL WINAPI InternetSetOptionW(HINTERNET hInternet, DWORD dwOption,
-                           LPVOID lpBuffer, DWORD dwBufferLength)
+static BOOL internet_set_option_w(HINTERNET hInternet, DWORD dwOption,
+                                  LPVOID lpBuffer, DWORD dwBufferLength)
 {
     object_header_t *lpwhh;
     BOOL ret = TRUE;
@@ -3701,6 +3704,15 @@
 }
 
 
+BOOL WINAPI InternetSetOptionW(HINTERNET handle, DWORD option, void *buffer, DWORD size)
+{
+    BOOL ret = internet_set_option_w(handle, option, buffer, size);
+    DWORD error = GetLastError();
+
+    trace_http_option_result("InternetSetOptionW", handle, option, size, ret, error);
+    return ret;
+}
+
 /***********************************************************************
  *           InternetSetOptionA (WININET.@)
  *
--- a/dlls/winhttp/session.c
+++ b/dlls/winhttp/session.c
@@ -37,6 +37,7 @@
 #include "winhttp_private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(winhttp);
+#include "wine/http_option_trace.h"
 
 #define DEFAULT_RESOLVE_TIMEOUT             0
 #define DEFAULT_CONNECT_TIMEOUT             20000
@@ -1426,6 +1427,7 @@
 
     release_object( hdr );
     if (ret) SetLastError( ERROR_SUCCESS );
+    trace_http_option_result("WinHttpQueryOption", handle, option, 0, ret, GetLastError());
     return ret;
 }
 
@@ -1485,6 +1487,7 @@
 
     release_object( hdr );
     if (ret) SetLastError( ERROR_SUCCESS );
+    trace_http_option_result("WinHttpSetOption", handle, option, buflen, ret, GetLastError());
     return ret;
 }
 
--- /dev/null
+++ b/include/wine/http_option_trace.h
@@ -0,0 +1,46 @@
+/*
+ * HTTP 选项诊断：仅记录选项编号、长度、结果和代码位置，不读取缓冲区。
+ * Copyright 2026 AltarsCN. LGPL 2.1 or later.
+ */
+#ifndef __WINE_HTTP_OPTION_TRACE_H
+#define __WINE_HTTP_OPTION_TRACE_H
+
+#include <wchar.h>
+#include "wine/debug.h"
+
+WINE_DECLARE_DEBUG_CHANNEL(inetopt);
+
+static void trace_http_option_result(const char *api, HANDLE handle, DWORD option,
+                                     DWORD bytes, BOOL result, DWORD error)
+{
+    void *frames[10];
+    WCHAR path[MAX_PATH], *name;
+    HMODULE module;
+    USHORT count, i;
+
+    if (!TRACE_ON(inetopt)) return;
+    TRACE_(inetopt)("%s handle %p option %lu bytes %lu ok %d last_error %lu.\n",
+                    api, handle, option, bytes, result, error);
+    /* 12009 是当前要追踪的返回值，不打印请求或响应数据来解释它。 */
+    if (!result && error == 12009)
+    {
+        count = RtlCaptureStackBackTrace(1, ARRAY_SIZE(frames), frames, NULL);
+        for (i = 0; i < count; i++)
+        {
+            if (GetModuleHandleExW(GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS |
+                                  GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                                  (const WCHAR *)frames[i], &module) &&
+                GetModuleFileNameW(module, path, ARRAY_SIZE(path)))
+            {
+                path[ARRAY_SIZE(path) - 1] = 0;
+                name = wcsrchr(path, '\\');
+                TRACE_(inetopt)("  %s #%u %s +%#Ix.\n", api, i,
+                                debugstr_w(name ? name + 1 : path),
+                                (UINT_PTR)frames[i] - (UINT_PTR)module);
+            }
+        }
+    }
+    /* 日志涉及系统调用，必须保留被测 API 的 last-error。 */
+    SetLastError(error);
+}
+#endif
