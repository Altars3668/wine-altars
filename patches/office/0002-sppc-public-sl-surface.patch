--- a/dlls/sppc/sppc.c
+++ b/dlls/sppc/sppc.c
@@ -102,3 +102,323 @@ HRESULT WINAPI SLFreeApplicationPolicies(HSLP policy)
     return S_OK;
 }
 
+/*
+ * SLSetAuthenticationData - the client hands the protection platform a blob of
+ * authentication material. There is no platform here to hand it to, and no
+ * store to keep it in.
+ *
+ * Accepting it is the honest answer rather than a convenient one: the call has
+ * no observable result the caller can read back, so "stored" and "stored into
+ * a platform that keeps nothing" are indistinguishable from the outside, and a
+ * caller that gets a failure treats the licensing stack as broken. Leaving it
+ * as a spec stub is the one thing that is definitely wrong -- calling a Wine
+ * stub raises rather than returning, which aborts the process.
+ */
+HRESULT WINAPI SLSetAuthenticationData(HSLC handle, UINT cb_data, const BYTE *data,
+                                       UINT *cb_response, BYTE **response)
+{
+    FIXME("(%p,%u,%p,%p,%p) stub, accepting and discarding\n",
+          handle, cb_data, data, cb_response, response);
+
+    if (cb_response) *cb_response = 0;
+    if (response) *response = NULL;
+    return S_OK;
+}
+
+/*
+ * The rest of the Software Protection Platform surface Office reaches for.
+ *
+ * The split is deliberate and follows what a caller can tell apart. A *query*
+ * on a machine with no protection platform genuinely has no answer, so it says
+ * so (SL_E_VALUE_NOT_FOUND) and the caller falls back on its own defaults. An
+ * *action* has no observable result to read back, so completing it and keeping
+ * nothing is indistinguishable from the outside, and returning a failure only
+ * tells the caller its licensing stack is broken.
+ *
+ * Leaving any of them as a spec stub is the one option that is definitely
+ * wrong: calling a Wine stub raises rather than returning, which aborts the
+ * process outright. That is how Word died on SLConsumeRight.
+ */
+
+HRESULT WINAPI SLConsumeRight(HSLC handle, const SLID *app, const SLID *product,
+                              LPCWSTR right, void *reserved)
+{
+    FIXME("(%p,%s,%s,%s,%p) stub\n", handle, wine_dbgstr_guid(app),
+          wine_dbgstr_guid(product), debugstr_w(right), reserved);
+    return S_OK;
+}
+
