+HRESULT WINAPI SLFireEvent(HSLC handle, LPCWSTR event_id, const SLID *app)
+{
+    TRACE("(%p,%s,%s)\n", handle, debugstr_w(event_id), wine_dbgstr_guid(app));
+    return S_OK;
+}
+
+HRESULT WINAPI SLRegisterEvent(HSLC handle, LPCWSTR event_id, const SLID *app, HANDLE event)
+{
+    TRACE("(%p,%s,%s,%p)\n", handle, debugstr_w(event_id), wine_dbgstr_guid(app), event);
+    /* no platform to raise it, so the event simply never fires */
+    return S_OK;
+}
+
+HRESULT WINAPI SLUnregisterEvent(HSLC handle, LPCWSTR event_id, const SLID *app, HANDLE event)
+{
