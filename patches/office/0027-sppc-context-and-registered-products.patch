@@ -0,0 +1,226 @@
+/* SPPC 上下文与目录回归。目录 fixture 仅在 Wine 中创建，不授予任何权利。
+ * Copyright 2026 AltarsCN
+ * SPDX-License-Identifier: LGPL-2.1-or-later
+ */
+#include <stdarg.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windows.h"
+#include "winternl.h"
+#include "slpublic.h"
+#include "slerror.h"
+#include "wine/test.h"
+
+static HRESULT (WINAPI *p_open)(HSLC *);
+static HRESULT (WINAPI *p_close)(HSLC);
+static HRESULT (WINAPI *p_consume)(HSLC, const SLID *, const SLID *, LPCWSTR, void *);
+static HRESULT (WINAPI *p_query)(HSLC, const SLID *, const SLID *, LPCWSTR, UINT *, SL_LICENSING_STATUS **);
+
+static const GUID app = {0x6f209801,0x7177,0x4222,{0x81,0x11,0x10,0,0,0,0,1}};
+static const GUID sku1 = {0x6f209802,0x7177,0x4222,{0x81,0x11,0x10,0,0,0,0,1}};
+static const GUID sku2 = {0x6f209803,0x7177,0x4222,{0x81,0x11,0x10,0,0,0,0,1}};
+static const GUID unknown = {0x6f209804,0x7177,0x4222,{0x81,0x11,0x10,0,0,0,0,1}};
+static const WCHAR app_path[] = L"Software\\Wine\\SPPC\\Applications\\{6f209801-7177-4222-8111-100000000001}";
+
+static void expect_query_error(HSLC handle, const GUID *application, const GUID *sku,
+        const WCHAR *right, HRESULT expected)
+{
+    SL_LICENSING_STATUS *status = (void *)(UINT_PTR)0x1234;
+    UINT count = 0xfeedbeef;
+    HRESULT hr = p_query(handle, application, sku, right, &count, &status);
+
+    ok(hr == expected, "query returned %#lx, expected %#lx\n", hr, expected);
+    ok(count == 0xfeedbeef, "error modified count to %u\n", count);
+    ok(status == (void *)(UINT_PTR)0x1234, "error modified array to %p\n", status);
+}
+
+static void check_unlicensed(HSLC handle, const GUID *application, const GUID *sku, UINT expected)
+{
+    SL_LICENSING_STATUS *status = NULL;
+    GUID empty = {0};
+    UINT count = 0, index;
+    HRESULT hr = p_query(handle, application, sku, NULL, &count, &status);
+
+    ok(hr == S_OK, "query returned %#lx\n", hr);
+    if (FAILED(hr)) return;
+    ok(count == expected, "got %u records, expected %u\n", count, expected);
+    ok(!count || !!status, "nonempty result without array\n");
+    if (status && count <= 2)
+    {
+        for (index = 0; index < count; index++)
+        {
+            ok(!IsEqualGUID(&status[index].SkuId, &empty), "zero SKU\n");
+            ok(IsEqualGUID(&status[index].SkuId, &sku1) || IsEqualGUID(&status[index].SkuId, &sku2), "unexpected SKU\n");
+            if (sku) ok(IsEqualGUID(&status[index].SkuId, sku), "SKU filter ignored\n");
+            ok(status[index].eStatus == SL_LICENSING_STATUS_UNLICENSED, "unexpected status %u\n", status[index].eStatus);
+            ok(status[index].hrReason == SL_E_PKEY_NOT_INSTALLED, "unexpected reason %#lx\n", status[index].hrReason);
+            ok(!status[index].dwGraceTime && !status[index].dwTotalGraceDays && !status[index].qwValidityExpiration,
+                    "unimplemented rights acquired time fields\n");
+        }
+    }
+    LocalFree(status);
+}
+
+static void test_empty_context(void)
+{
+    HSLC first = NULL, second = NULL;
+    SL_LICENSING_STATUS *status = (void *)(UINT_PTR)0x1234;
+    UINT count = 0xfeedbeef;
+    HRESULT hr;
+
+    hr = p_open(NULL);
+    ok(hr == E_INVALIDARG, "SLOpen(NULL) returned %#lx\n", hr);
+    hr = p_open(&first);
+    ok(hr == S_OK && first, "SLOpen returned %#lx, %p\n", hr, first);
+    if (FAILED(hr) || !first) return;
+    hr = p_open(&second);
+    ok(hr == S_OK && second && first != second, "second context %#lx, %p, first %p\n", hr, second, first);
+    expect_query_error(first, NULL, NULL, NULL, SL_E_RIGHT_NOT_CONSUMED);
+    expect_query_error(first, &unknown, NULL, NULL, SL_E_PRODUCT_SKU_NOT_INSTALLED);
+    expect_query_error(first, NULL, &sku1, NULL, E_INVALIDARG);
+    expect_query_error(NULL, &app, NULL, NULL, E_INVALIDARG);
+    expect_query_error((HSLC)(UINT_PTR)0x1234, &app, NULL, NULL, RPC_NT_SS_CONTEXT_MISMATCH);
+    hr = p_query(first, &app, NULL, NULL, NULL, &status);
+    ok(hr == E_INVALIDARG && status == (void *)(UINT_PTR)0x1234, "null count modified output, %#lx\n", hr);
+    hr = p_query(first, &app, NULL, NULL, &count, NULL);
+    ok(hr == E_INVALIDARG && count == 0xfeedbeef, "null array modified output, %#lx\n", hr);
+    if (second) p_close(second);
+    hr = p_close(first);
+    ok(hr == S_OK, "close returned %#lx\n", hr);
+    expect_query_error(first, &app, NULL, NULL, RPC_NT_SS_CONTEXT_MISMATCH);
+}
+
+static BOOL create_catalog(void)
+{
+    static const WCHAR *names[] = {
+        L"Skus\\{6f209802-7177-4222-8111-100000000001}",
+        L"Skus\\{6f209803-7177-4222-8111-100000000001}"
+    };
+    static const WCHAR name[] = L"SPPC test metadata, not a license";
+    HKEY application, product;
+    DWORD disposition, version = 1;
+    unsigned int index;
+    LONG ret;
+
+    if (!GetProcAddress(GetModuleHandleA("ntdll.dll"), "wine_get_version"))
+    {
+        skip("Wine catalog fixtures are not registered on native Windows\n");
+        return FALSE;
+    }
+    ret = RegCreateKeyExW(HKEY_LOCAL_MACHINE, app_path, 0, NULL, 0,
+            KEY_ALL_ACCESS | KEY_WOW64_64KEY, NULL, &application, &disposition);
+    if (ret) { skip("cannot create test catalog: %ld\n", ret); return FALSE; }
+    if (disposition != REG_CREATED_NEW_KEY)
+    {
+        RegCloseKey(application);
+        skip("test application already exists; leaving it untouched\n");
+        return FALSE;
+    }
+    ret = RegSetValueExW(application, L"CatalogVersion", 0, REG_DWORD, (BYTE *)&version, sizeof(version));
+    ok(!ret, "set catalog version failed %ld\n", ret);
+    for (index = 0; index < ARRAY_SIZE(names); index++)
+    {
+        ret = RegCreateKeyExW(application, names[index], 0, NULL, 0, KEY_ALL_ACCESS | KEY_WOW64_64KEY,
+                NULL, &product, NULL);
+        ok(!ret, "create SKU failed %ld\n", ret);
+        if (!ret)
+        {
+            ret = RegSetValueExW(product, L"Name", 0, REG_SZ, (const BYTE *)name, sizeof(name));
+            ok(!ret, "set SKU name failed %ld\n", ret);
+            RegCloseKey(product);
+        }
+    }
+    RegCloseKey(application);
+    return TRUE;
+}
+
+static void test_catalog_context(void)
+{
+    HSLC first = NULL, second = NULL;
+    HMODULE slc;
+    HRESULT (WINAPI *slc_open)(HSLC *);
+    HRESULT (WINAPI *slc_close)(HSLC);
+    HRESULT (WINAPI *slc_query)(HSLC, const SLID *, const SLID *, LPCWSTR, UINT *, SL_LICENSING_STATUS **);
+    SL_LICENSING_STATUS *status = NULL;
+    HKEY key;
+    UINT count;
+    HRESULT hr;
+
+    if (!create_catalog()) return;
+    hr = p_open(&first);
+    ok(hr == S_OK && first, "open failed %#lx\n", hr);
+    if (FAILED(hr) || !first) goto cleanup;
+    check_unlicensed(first, &app, NULL, 2);
+    check_unlicensed(first, &app, &sku1, 1);
+    expect_query_error(first, NULL, NULL, NULL, SL_E_RIGHT_NOT_CONSUMED);
+    expect_query_error(first, &app, &unknown, NULL, SL_E_PRODUCT_SKU_NOT_INSTALLED);
+    expect_query_error(first, &app, NULL, L"test-right", SL_E_NOT_SUPPORT);
+    hr = p_consume(first, &app, &sku1, NULL, NULL);
+    ok(hr == SL_E_RIGHT_NOT_GRANTED, "unlicensed SKU granted a right: %#lx\n", hr);
+    check_unlicensed(first, NULL, NULL, 1);
+    check_unlicensed(first, &app, NULL, 2);
+    check_unlicensed(first, NULL, NULL, 1);
+    hr = p_consume(first, NULL, NULL, NULL, NULL);
+    ok(hr == E_INVALIDARG, "invalid consume returned %#lx\n", hr);
+    check_unlicensed(first, NULL, NULL, 1);
+    hr = p_open(&second);
+    ok(hr == S_OK && second, "second open failed %#lx\n", hr);
+    if (second) expect_query_error(second, NULL, NULL, NULL, SL_E_RIGHT_NOT_CONSUMED);
+    hr = p_consume(first, &app, &unknown, NULL, NULL);
+    ok(hr == SL_E_PRODUCT_SKU_NOT_INSTALLED, "unknown SKU returned %#lx\n", hr);
+    expect_query_error(first, NULL, NULL, NULL, SL_E_RIGHT_NOT_CONSUMED);
+    if (second) p_close(second);
+    p_close(first);
+    first = NULL;
+
+    slc = LoadLibraryA("slc.dll");
+    ok(!!slc, "cannot load slc.dll\n");
+    if (slc)
+    {
+        slc_open = (void *)GetProcAddress(slc, "SLOpen");
+        slc_close = (void *)GetProcAddress(slc, "SLClose");
+        slc_query = (void *)GetProcAddress(slc, "SLGetLicensingStatusInformation");
+        ok(slc_open && slc_close && slc_query, "missing SLC exports\n");
+        if (slc_open && slc_close && slc_query)
+        {
+            hr = slc_open(&first);
+            ok(hr == S_OK && first, "cross-DLL open returned %#lx, %p\n", hr, first);
+            if (SUCCEEDED(hr) && first)
+            {
+                hr = p_consume(first, &app, &sku2, NULL, NULL);
+                ok(hr == SL_E_RIGHT_NOT_GRANTED, "cross-DLL consume returned %#lx\n", hr);
+                count = 0;
+                hr = slc_query(first, NULL, NULL, NULL, &count, &status);
+                ok(hr == S_OK && count == 1 && status, "cross-DLL query returned %#lx, %u\n", hr, count);
+                if (status && count == 1) ok(IsEqualGUID(&status[0].SkuId, &sku2), "cross-DLL history changed\n");
+                LocalFree(status);
+                hr = slc_close(first);
+                ok(hr == S_OK, "cross-DLL close returned %#lx\n", hr);
+            }
+        }
+        FreeLibrary(slc);
+    }
+cleanup:
+    if (!RegOpenKeyExW(HKEY_LOCAL_MACHINE, app_path, 0, KEY_ALL_ACCESS | KEY_WOW64_64KEY, &key))
+    {
+        RegDeleteTreeW(key, NULL);
+        RegCloseKey(key);
+        RegDeleteKeyExW(HKEY_LOCAL_MACHINE, app_path, KEY_WOW64_64KEY, 0);
+    }
+}
+
+START_TEST(context)
+{
+    HMODULE module = LoadLibraryA("sppc.dll");
+    if (!module) { win_skip("sppc.dll is unavailable\n"); return; }
+    p_open = (void *)GetProcAddress(module, "SLOpen");
+    p_close = (void *)GetProcAddress(module, "SLClose");
+    p_consume = (void *)GetProcAddress(module, "SLConsumeRight");
+    p_query = (void *)GetProcAddress(module, "SLGetLicensingStatusInformation");
+    if (!p_open || !p_close || !p_consume || !p_query) { win_skip("core exports unavailable\n"); FreeLibrary(module); return; }
+    test_empty_context();
+    test_catalog_context();
+    FreeLibrary(module);
+}
