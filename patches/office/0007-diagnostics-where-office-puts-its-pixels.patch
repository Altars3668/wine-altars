diff --git a/dlls/d3d11/texture.c b/dlls/d3d11/texture.c
index b2ef96d..69a9d05 100644
--- a/dlls/d3d11/texture.c
+++ b/dlls/d3d11/texture.c
@@ -848,6 +848,35 @@ static HRESULT STDMETHODCALLTYPE d3d10_texture2d_Map(ID3D10Texture2D *iface, UIN
     {
         mapped_texture->pData = wined3d_map_desc.data;
         mapped_texture->RowPitch = wined3d_map_desc.row_pitch;
+
+        /* altars: measurement only -- is there anything in the pixels Office reads back? */
+        if (TRACE_ON(d3d11) && map_type != D3D10_MAP_WRITE_DISCARD && wined3d_map_desc.data)
+        {
+            const unsigned int *px = wined3d_map_desc.data;
+            unsigned int stride = wined3d_map_desc.row_pitch / 4, first, distinct = 0, nonzero = 0;
+            unsigned int seen[8], y, x, i, n = 0;
+
+            first = px[0];
+            for (y = 0; y < texture->desc.Height; ++y)
+            {
+                for (x = 0; x < texture->desc.Width; ++x)
+                {
+                    unsigned int v = px[y * stride + x];
+                    if (v) ++nonzero;
+                    if (v != first)
+                    {
+                        for (i = 0; i < n; ++i) if (seen[i] == v) break;
+                        if (i == n && n < ARRAY_SIZE(seen)) seen[n++] = v;
+                        ++distinct;
+                    }
+                }
+            }
+            TRACE("altars-map %ux%u first %08x differing %u nonzero %u of %u; samples:",
+                    texture->desc.Width, texture->desc.Height, first, distinct, nonzero,
+                    texture->desc.Width * texture->desc.Height);
+            for (i = 0; i < n; ++i) TRACE(" %08x", seen[i]);
+            TRACE("\n");
+        }
     }
 
     return hr;
@@ -981,6 +1010,12 @@ HRESULT d3d_texture2d_create(struct d3d_device *device, const D3D11_TEXTURE2D_DE
     texture->ID3D11Texture2D_iface.lpVtbl = &d3d11_texture2d_vtbl;
     texture->ID3D10Texture2D_iface.lpVtbl = &d3d10_texture2d_vtbl;
     texture->refcount = 1;
+
+    /* altars: measurement only -- what shape are the surfaces Office renders into? */
+    TRACE("altars-tex2d %ux%u fmt %u mip %u arr %u usage %u bind %#x cpu %#x misc %#x samples %u.\n",
+            desc->Width, desc->Height, desc->Format, desc->MipLevels, desc->ArraySize,
+            desc->Usage, desc->BindFlags, desc->CPUAccessFlags, desc->MiscFlags,
+            desc->SampleDesc.Count);
     wined3d_mutex_lock();
     texture->desc = *desc;
 
