+static HRESULT STDMETHODCALLTYPE d2d_svg_element_ReplaceChild(ID2D1SvgElement *iface,
+        ID2D1SvgElement *new_child, ID2D1SvgElement *old_child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct d2d_svg_element *old, *new_element;
+    HRESULT hr;
+
+    TRACE("iface %p, new_child %p, old_child %p.\n", iface, new_child, old_child);
+
+    if (!(old = unsafe_impl_from_ID2D1SvgElement(old_child)) || old->parent != element)
+        return E_INVALIDARG;
+
+    if (!(new_element = unsafe_impl_from_ID2D1SvgElement(new_child)))
+        return E_INVALIDARG;
+
+    if (FAILED(hr = d2d_svg_element_insert_child(element, new_element, old)))
+        return hr;
+
+    d2d_svg_element_remove_child(old);
+
+    return S_OK;
+}
