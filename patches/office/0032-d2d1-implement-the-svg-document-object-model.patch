         d2d_device_context_draw_glyph_run_outline(context, baseline_origin, glyph_run, brush);
     else
@@ -3013,10 +3052,20 @@ static HRESULT STDMETHODCALLTYPE d2d_device_context_GetSvgGlyphImage(ID2D1Device
