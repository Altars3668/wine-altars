+struct d2d_svg_document
+{
+    ID2D1SvgDocument ID2D1SvgDocument_iface;
+    LONG refcount;
+
+    ID2D1Factory *factory;
+    D2D1_SIZE_F viewport_size;
+    /* Strong reference; the document owns the element tree. */
+    ID2D1SvgElement *root;
+    /* Every live element of this document, linked through
+     * d2d_svg_element.document_entry. The document clears the back pointers of
+     * the elements still listed here when it is destroyed. */
+    struct list elements;
+};
+
+struct d2d_svg_element
+{
+    ID2D1SvgElement ID2D1SvgElement_iface;
+    LONG refcount;
+
+    ID2D1Factory *factory;
+    /* Weak back pointer, cleared by d2d_svg_document destruction. */
+    struct d2d_svg_document *document;
+    /* Weak back pointer; a parent holds a strong reference on each of its
+     * children, so a non-NULL parent is always alive. */
+    struct d2d_svg_element *parent;
+    struct list document_entry;
+    struct list entry;
+    struct list children;
+    WCHAR *tag_name;
+};
+
+HRESULT d2d_svg_document_create(ID2D1Factory *factory, const D2D1_SIZE_F *viewport_size,
+        ID2D1SvgDocument **document);
