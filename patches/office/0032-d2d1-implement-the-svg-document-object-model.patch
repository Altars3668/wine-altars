+static HRESULT STDMETHODCALLTYPE d2d_svg_element_CreateChild(ID2D1SvgElement *iface,
+        const WCHAR *tag_name, ID2D1SvgElement **new_child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct d2d_svg_element *child;
+    HRESULT hr;
+
+    TRACE("iface %p, tag_name %s, new_child %p.\n", iface, debugstr_w(tag_name), new_child);
+
+    *new_child = NULL;
+
+    if (!tag_name)
+        return E_INVALIDARG;
+
+    if (!element->document)
+    {
+        WARN("Element %p is no longer attached to a document.\n", element);
+        return E_FAIL;
+    }
+
+    if (FAILED(hr = d2d_svg_element_create(element->document, tag_name, &child)))
+        return hr;
+
+    list_add_tail(&element->children, &child->entry);
+    child->parent = element;
+    /* One reference for the parent, the initial one goes to the caller. */
+    ID2D1SvgElement_AddRef(&child->ID2D1SvgElement_iface);
+
+    *new_child = &child->ID2D1SvgElement_iface;
+
+    return S_OK;
+}
