+        for (i = 0; i < opacity_values_size; ++i)
+            if (((const unsigned char *)opacity_values)[i]) ++set;
+
+        TRACE("altars-glyphfill run_rect %s, bounds %s, transform {%.2f %.2f %.2f %.2f %.2f %.2f}, "
+                "clip %s (depth %u), brush %p, mask %ux%u, coverage %zu/%zu.\n",
+                debug_d2d_rect_f(&run_rect), wine_dbgstr_rect(&bounds),
