+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, new_child %p.\n", iface, new_child);
+
+    return d2d_svg_element_insert_child(element, unsafe_impl_from_ID2D1SvgElement(new_child), NULL);
+}
