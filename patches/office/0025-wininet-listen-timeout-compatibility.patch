Subject: [PATCH] wininet: match reserved LISTEN_TIMEOUT option semantics

原生 Windows 33 项设置/查询结果已对照：有效句柄、非空缓冲区、非零长度
接受设置；全局/无效句柄及空参数保留不同错误；查询清零长度并拒绝。
ANSI 与 Unicode 结果一致，不把此选项冒充连接或接收超时。
Office OneAuthHttpTask 的设置失败分支直接传播12009；本改动不涉及许可判断。
不依赖诊断补丁0024。
---
--- a/dlls/wininet/internet.c
+++ b/dlls/wininet/internet.c
@@ -3227,6 +3227,20 @@
     return query_global_option(option, buffer, size, unicode);
 }
 
+/* Windows 对这个保留选项接受设置，但不提供可查询的值。
+ * 无论句柄是否有效，非空长度指针都会被置零。 */
+static DWORD query_listen_timeout(HINTERNET handle, DWORD *size)
+{
+    object_header_t *hdr;
+
+    if (!size) return ERROR_INVALID_PARAMETER;
+    *size = 0;
+    if (!handle) return ERROR_INTERNET_INCORRECT_HANDLE_TYPE;
+    if (!(hdr = get_handle_object(handle))) return ERROR_INVALID_HANDLE;
+    WININET_Release(hdr);
+    return ERROR_INVALID_PARAMETER;
+}
+
 /***********************************************************************
  *           InternetQueryOptionW (WININET.@)
  *
@@ -3245,7 +3259,9 @@
 
     TRACE("%p %ld %p %p\n", hInternet, dwOption, lpBuffer, lpdwBufferLength);
 
-    if(hInternet) {
+    if (dwOption == INTERNET_OPTION_LISTEN_TIMEOUT) {
+        res = query_listen_timeout(hInternet, lpdwBufferLength);
+    }else if(hInternet) {
         hdr = get_handle_object(hInternet);
         if (hdr) {
             res = hdr->vtbl->QueryOption(hdr, dwOption, lpBuffer, lpdwBufferLength, TRUE);
@@ -3278,7 +3294,9 @@
 
     TRACE("%p %ld %p %p\n", hInternet, dwOption, lpBuffer, lpdwBufferLength);
 
-    if(hInternet) {
+    if (dwOption == INTERNET_OPTION_LISTEN_TIMEOUT) {
+        res = query_listen_timeout(hInternet, lpdwBufferLength);
+    }else if(hInternet) {
         hdr = get_handle_object(hInternet);
         if (hdr) {
             res = hdr->vtbl->QueryOption(hdr, dwOption, lpBuffer, lpdwBufferLength, FALSE);
@@ -3449,6 +3467,23 @@
     DWORD res;
 
     TRACE("(%p %ld %p %ld)\n", hInternet, dwOption, lpBuffer, dwBufferLength);
+
+    if (dwOption == INTERNET_OPTION_LISTEN_TIMEOUT)
+    {
+        /* 原生对照：先校验非空缓冲区和非零长度，再校验句柄。
+         * 这是保留选项，不读取数值，也不把它冒充连接或接收超时。
+         * Windows 接受 1、3、4、8 字节，不能强加 sizeof(DWORD)。 */
+        if (!lpBuffer || !dwBufferLength) res = ERROR_INVALID_PARAMETER;
+        else if (!hInternet) res = ERROR_INTERNET_INCORRECT_HANDLE_TYPE;
+        else if (!(lpwhh = get_handle_object(hInternet))) res = ERROR_INVALID_HANDLE;
+        else
+        {
+            WININET_Release(lpwhh);
+            res = ERROR_SUCCESS;
+        }
+        SetLastError(res);
+        return res == ERROR_SUCCESS;
+    }
 
     lpwhh = (object_header_t*) get_handle_object( hInternet );
     if(lpwhh)
