Subject: [PATCH] ieframe: implement WebBrowser container properties

get_Parent、get_Container、get_TopLevelContainer 三个都是 E_NOTIMPL。

对嵌入控件来说这三个问题都有确定答案：父自动化对象和容器就是宿主放进来的
client site（容器优先取 IOleClientSite::GetContainer，拿不到就退回 site 本身），
而这个对象**本身就是可嵌入的那个控件**，所以它的容器永远是别的应用，
TopLevelContainer 恒为 VARIANT_FALSE——只有 InternetExplorer 才答 TRUE。

宿主不提供 IDispatch 时返回 E_NOINTERFACE 而不是 E_NOTIMPL：那是"这个宿主
没有可给的自动化对象"，不是"这个方法没写"。

---
diff --git a/dlls/ieframe/webbrowser.c b/dlls/ieframe/webbrowser.c
index 857287f..1cd5a70 100644
--- a/dlls/ieframe/webbrowser.c
+++ b/dlls/ieframe/webbrowser.c
@@ -368,18 +368,49 @@ static HRESULT WINAPI WebBrowser_get_Application(IWebBrowser2 *iface, IDispatch
     return S_OK;
 }
 
+/* For an embedded control the parent automation object is whatever the host
+ * put in as the client site.  A host that exposes no IDispatch has no parent
+ * to give, which is E_NOINTERFACE rather than "not implemented". */
 static HRESULT WINAPI WebBrowser_get_Parent(IWebBrowser2 *iface, IDispatch **ppDisp)
 {
     WebBrowser *This = impl_from_IWebBrowser2(iface);
-    FIXME("(%p)->(%p)\n", This, ppDisp);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, ppDisp);
+
+    if(!ppDisp)
+        return E_POINTER;
+    *ppDisp = NULL;
+    if(!This->client)
+        return E_UNEXPECTED;
+
+    return IOleClientSite_QueryInterface(This->client, &IID_IDispatch, (void**)ppDisp);
 }
 
 static HRESULT WINAPI WebBrowser_get_Container(IWebBrowser2 *iface, IDispatch **ppDisp)
 {
     WebBrowser *This = impl_from_IWebBrowser2(iface);
-    FIXME("(%p)->(%p)\n", This, ppDisp);
-    return E_NOTIMPL;
+    IOleContainer *container;
+    HRESULT hres;
+
+    TRACE("(%p)->(%p)\n", This, ppDisp);
+
+    if(!ppDisp)
+        return E_POINTER;
+    *ppDisp = NULL;
+    if(!This->client)
+        return E_UNEXPECTED;
+
+    /* The container proper, when the site offers one; otherwise the site
+     * itself is the closest thing the host has given us. */
+    hres = IOleClientSite_GetContainer(This->client, &container);
+    if(SUCCEEDED(hres)) {
+        hres = IOleContainer_QueryInterface(container, &IID_IDispatch, (void**)ppDisp);
+        IOleContainer_Release(container);
+        if(SUCCEEDED(hres))
+            return hres;
+    }
+
+    return IOleClientSite_QueryInterface(This->client, &IID_IDispatch, (void**)ppDisp);
 }
 
 static HRESULT WINAPI WebBrowser_get_Document(IWebBrowser2 *iface, IDispatch **ppDisp)
@@ -410,11 +441,19 @@ static HRESULT WINAPI WebBrowser_get_Document(IWebBrowser2 *iface, IDispatch **p
     return disp ? S_OK : S_FALSE;
 }
 
+/* This object is the embeddable control, so its container is always some other
+ * application -- never the top-level browser.  Only InternetExplorer answers
+ * TRUE here. */
 static HRESULT WINAPI WebBrowser_get_TopLevelContainer(IWebBrowser2 *iface, VARIANT_BOOL *pBool)
 {
     WebBrowser *This = impl_from_IWebBrowser2(iface);
-    FIXME("(%p)->(%p)\n", This, pBool);
-    return E_NOTIMPL;
+
+    TRACE("(%p)->(%p)\n", This, pBool);
+
+    if(!pBool)
+        return E_POINTER;
+    *pBool = VARIANT_FALSE;
+    return S_OK;
 }
 
 static HRESULT WINAPI WebBrowser_get_Type(IWebBrowser2 *iface, BSTR *Type)
