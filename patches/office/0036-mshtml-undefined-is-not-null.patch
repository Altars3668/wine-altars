Subject: [PATCH] mshtml: undefined is not null

两处把 JavaScript 的 undefined 当成了 null，或反之。在脚本里这两个值不等价，
DOM 规范也分得很清楚。

IDOMKeyboardEvent::get_char 此前是 stub。规范要求：产生字符的按键返回那个
字符，不产生字符的按键（方向键、功能键）返回 **null**，而不是空字符串。
补齐实现，并按 UTF-16 处理增补平面（charCode > 0xffff 时拆成代理对）。

IHTMLWindow2::get_opener 返回 VT_EMPTY（undefined），但没有 opener 的窗口
其 opener 是 **null**。put_opener 相应地接受 VT_NULL/VT_EMPTY 并返回 S_OK，
其他取值仍是 E_NOTIMPL——脚本给 opener 赋别的值确实不是这里能处理的。

验证：Office 登录页输入邮箱时，此前每次 24 次 E_NOTIMPL 加 24 次
DISP_E_MEMBERNOTFOUND(0x80020009)，现在归零。

---
diff --git a/dlls/mshtml/htmlevent.c b/dlls/mshtml/htmlevent.c
index cb5c112..fdce728 100644
--- a/dlls/mshtml/htmlevent.c
+++ b/dlls/mshtml/htmlevent.c
@@ -2951,8 +2951,35 @@ static HRESULT WINAPI DOMKeyboardEvent_get_which(IDOMKeyboardEvent *iface, LONG
 static HRESULT WINAPI DOMKeyboardEvent_get_char(IDOMKeyboardEvent *iface, VARIANT *p)
 {
     DOMKeyboardEvent *This = impl_from_IDOMKeyboardEvent(iface);
-    FIXME("(%p)->(%p)\n", This, p);
-    return E_NOTIMPL;
+    WCHAR buf[3];
+    unsigned len = 0;
+    UINT32 char_code;
+    nsresult nsres;
+
+    TRACE("(%p)->(%p)\n", This, p);
+
+    nsres = nsIDOMKeyEvent_GetCharCode(This->nsevent, &char_code);
+    if(NS_FAILED(nsres))
+        return E_FAIL;
+
+    /* 不产生字符的按键（方向键、功能键等）返回 null，不是空字符串：
+     * 脚本用 event.char 是否为 null 来区分字符输入和控制键。 */
+    if(!char_code) {
+        V_VT(p) = VT_NULL;
+        return S_OK;
+    }
+
+    if(char_code > 0xffff) {
+        char_code -= 0x10000;
+        buf[len++] = 0xd800 | (char_code >> 10);
+        buf[len++] = 0xdc00 | (char_code & 0x3ff);
+    }else {
+        buf[len++] = char_code;
+    }
+    buf[len] = 0;
+
+    V_VT(p) = VT_BSTR;
+    return (V_BSTR(p) = SysAllocString(buf)) ? S_OK : E_OUTOFMEMORY;
 }
 
 static HRESULT WINAPI DOMKeyboardEvent_get_locale(IDOMKeyboardEvent *iface, BSTR *p)
diff --git a/dlls/mshtml/htmlwindow.c b/dlls/mshtml/htmlwindow.c
index 1977c61..4febe1a 100644
--- a/dlls/mshtml/htmlwindow.c
+++ b/dlls/mshtml/htmlwindow.c
@@ -800,7 +800,15 @@ static HRESULT WINAPI HTMLWindow2_close(IHTMLWindow2 *iface)
 static HRESULT WINAPI HTMLWindow2_put_opener(IHTMLWindow2 *iface, VARIANT v)
 {
     HTMLWindow *This = impl_from_IHTMLWindow2(iface);
-    FIXME("(%p)->(%s)\n", This, debugstr_variant(&v));
+
+    TRACE("(%p)->(%s)\n", This, debugstr_variant(&v));
+
+    /* 置空是脚本断开打开者引用的常规做法，而这里本来就没有记录打开者，
+     * 所以接受它即可。设成其他值仍未实现，不假装已经保存。 */
+    if(V_VT(&v) == VT_NULL || V_VT(&v) == VT_EMPTY)
+        return S_OK;
+
+    FIXME("(%p)->(%s) not supported\n", This, debugstr_variant(&v));
     return E_NOTIMPL;
 }
 
@@ -808,9 +816,12 @@ static HRESULT WINAPI HTMLWindow2_get_opener(IHTMLWindow2 *iface, VARIANT *p)
 {
     HTMLWindow *This = impl_from_IHTMLWindow2(iface);
 
-    FIXME("(%p)->(%p) returning empty\n", This, p);
+    TRACE("(%p)->(%p)\n", This, p);
 
-    V_VT(p) = VT_EMPTY;
+    /* 没有打开者时是 null，不是 undefined：脚本用 `opener !== null` 之类的判断
+     * 区分"没有打开者"和"属性不存在"，VT_EMPTY 会落到后者。
+     * 由 window.open 创建的窗口尚未记录打开者，那种情况仍然返回 null。 */
+    V_VT(p) = VT_NULL;
     return S_OK;
 }
 
