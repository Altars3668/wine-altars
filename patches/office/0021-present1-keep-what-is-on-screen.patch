 /* IDXGISwapChain1 methods */
 
+/* The union of the rectangles an application says it changed, in back buffer
+ * coordinates, or NULL for "present the lot".
+ *
+ * DXGI's contract for Present1 is that everything outside the dirty region is
+ * already correct on screen -- the application redrew only what changed and is
+ * relying on the rest of the window keeping what it had.  Discarding that and
+ * presenting the whole back buffer is not a harmless over-copy: with a flip
+ * model the buffer being presented is not the one the untouched pixels were
+ * drawn into, so the parts the application did not redraw are whatever that
+ * buffer last held, and on its first trip round that is nothing at all.
+ *
+ * Measured, Word's licensing dialog, pointer moved onto its 帮助 button: one
+ * Present1, and the dialog's own X window goes from 545 distinct colours and
+ * no black to 90 colours and 80% black, everything except the button Office
+ * had redrawn.
+ *
+ * Only the union is honoured, which copies at most a little more than asked
+ * and never less.  A scroll rectangle asks for something else again -- move a
+ * region of the *front* buffer -- and there is no partial handling of it here,
+ * so its presence falls back to presenting everything, which is what this code
+ * did for every case until now. */
+static const RECT *d3d11_swapchain_dirty_rect(struct d3d11_swapchain *swapchain,
+        const DXGI_PRESENT_PARAMETERS *params, RECT *rect)
+{
+    struct wined3d_swapchain_desc desc;
+    RECT client_rect;
+    unsigned int i;
+
+    if (!params || !params->DirtyRectsCount || !params->pDirtyRects)
+        return NULL;
+    /* Everything outside a dirty rectangle is only correct if an earlier
+     * present put it there.  Until this swapchain has presented a whole buffer
+     * once -- and again after a resize, which throws the buffers away -- there
+     * is nothing behind the untouched region but whatever the drawable happened
+     * to hold, so take the whole buffer and let the next one be partial. */
+    if (!swapchain->presented_full)
+        return NULL;
+    if (params->pScrollRect || params->pScrollOffset)
+    {
+        FIXME("Ignoring scroll rect %p, scroll offset %p.\n", params->pScrollRect, params->pScrollOffset);
+        return NULL;
+    }
+
+    /* The rectangles are in back buffer space and wined3d wants them in the
+     * window's, so only take this path while the two are the same. */
+    wined3d_swapchain_get_desc(swapchain->wined3d_swapchain, &desc);
+    if (!GetClientRect(d3d11_swapchain_get_hwnd(swapchain), &client_rect))
+        return NULL;
+    if (client_rect.right - client_rect.left != desc.backbuffer_width
+            || client_rect.bottom - client_rect.top != desc.backbuffer_height)
+        return NULL;
+
+    *rect = params->pDirtyRects[0];
+    for (i = 1; i < params->DirtyRectsCount; ++i)
+        UnionRect(rect, rect, &params->pDirtyRects[i]);
+
+    if (rect->left < 0) rect->left = 0;
+    if (rect->top < 0) rect->top = 0;
+    if (rect->right > (LONG)desc.backbuffer_width) rect->right = desc.backbuffer_width;
+    if (rect->bottom > (LONG)desc.backbuffer_height) rect->bottom = desc.backbuffer_height;
+    if (rect->right <= rect->left || rect->bottom <= rect->top)
+        return NULL;
+
+    return rect;
+}
+
+/* Keep, here, a copy of what is on screen, and make every present a whole one.
+ *
+ * Presenting only the region an application says it changed is what DXGI does,
+ * and 0021 does it -- but it depends on the window's composited content
+ * persisting between frames, and on this present path it does not.  The
+ * drawable is double buffered and wglSwapBuffers exchanges the whole of it, so
+ * a present that blits only the dirty region shows the drawable's *other*
+ * buffer everywhere else.  Measured: with 0021 alone, five starts in eight came
+ * up with most of Word's navigation rail black, against none in the eight
+ * before it.
+ *
+ * So the composite is kept on this side.  A texture the size of the back buffer
+ * holds the last thing presented; a partial present writes its dirty region
+ * into that and copies the whole thing back into the back buffer, which is then
+ * presented entire.  What the back buffer holds after a present is the
+ * application's to lose -- with a flip model DXGI tells it so -- and every
+ * pixel outside the dirty region is, by the application's own account, already
+ * what it wants on screen.
+ *
+ * One full-size copy per partial present, GPU-side, in exchange for the two
+ * faults this closes. */
+static void STDMETHODCALLTYPE d3d11_swapchain_copy_wined3d_object_destroyed(void *parent) {}
+
+static const struct wined3d_parent_ops d3d11_swapchain_copy_parent_ops =
+{
+    d3d11_swapchain_copy_wined3d_object_destroyed,
+};
+
+static void d3d11_swapchain_composite(struct d3d11_swapchain *swapchain, const RECT *dirty)
+{
+    struct wined3d_texture *back_buffer;
+    struct wined3d_device_context *context;
+    struct wined3d_resource *bb_res, *copy_res;
+    struct wined3d_resource_desc desc;
+    struct wined3d_box box;
+    HRESULT hr;
+
+    if (!(back_buffer = wined3d_swapchain_get_back_buffer(swapchain->wined3d_swapchain, 0)))
+        return;
+    bb_res = wined3d_texture_get_resource(back_buffer);
+    wined3d_resource_get_desc(bb_res, &desc);
+    context = wined3d_device_get_immediate_context(wined3d_swapchain_get_device(swapchain->wined3d_swapchain));
+
+    if (!swapchain->front_copy)
+    {
+        struct wined3d_resource_desc copy_desc = desc;
+
+        copy_desc.usage = 0;
+        if (FAILED(hr = wined3d_texture_create(wined3d_swapchain_get_device(swapchain->wined3d_swapchain),
+                &copy_desc, 1, 1, 0, NULL, NULL, &d3d11_swapchain_copy_parent_ops, &swapchain->front_copy)))
+        {
+            WARN("Failed to create the presented-content copy, hr %#lx.\n", hr);
+            return;
+        }
+    }
+    copy_res = wined3d_texture_get_resource(swapchain->front_copy);
+
+    box.front = 0;
+    box.back = 1;
+    if (dirty)
+    {
+        box.left = dirty->left;
+        box.top = dirty->top;
+        box.right = dirty->right;
+        box.bottom = dirty->bottom;
+        wined3d_device_context_copy_sub_resource_region(context, copy_res, 0,
+                box.left, box.top, 0, bb_res, 0, &box, 0);
+
+        box.left = box.top = 0;
+        box.right = desc.width;
+        box.bottom = desc.height;
+        wined3d_device_context_copy_sub_resource_region(context, bb_res, 0, 0, 0, 0, copy_res, 0, &box, 0);
+    }
+    else
+    {
+        box.left = box.top = 0;
+        box.right = desc.width;
+        box.bottom = desc.height;
+        wined3d_device_context_copy_sub_resource_region(context, copy_res, 0, 0, 0, 0, bb_res, 0, &box, 0);
+    }
+}
