From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 23:20:45 -0400
Subject: [PATCH] shcore: Hand out feature state subscriptions and add the rest
 of the feature staging functions.

WinAppSDK's CoreMessagingXP.dll, which Office ships, imports UnsubscribeFeatureStateChangeNotification,
and WIL's feature flags use the whole set.  No feature changes its state here, so a subscription only
has to be something to let go of later; the old stub left the caller's handle as it was.
GetFeatureVariant answers that nothing is staged, and RecordFeatureError keeps nothing, as
RecordFeatureUsage already does.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/shcore/main.c b/dlls/shcore/main.c
index ea911288c6e..49d18e9823c 100644
--- a/dlls/shcore/main.c
+++ b/dlls/shcore/main.c
@@ -2538,13 +2538,63 @@ BOOL WINAPI IsOS(DWORD feature)
     return FALSE;
 }
 
+struct feature_subscription
+{
+    FEATURE_STATE_CHANGE_CALLBACK *callback;
+    void *context;
+};
+
 /*************************************************************************
  * SubscribeFeatureStateChangeNotification        [SHCORE.@]
+ *
+ * No feature changes its state here, so the callback is never called; the subscription only has to
+ * be something UnsubscribeFeatureStateChangeNotification() can let go of.
  */
 void WINAPI SubscribeFeatureStateChangeNotification(FEATURE_STATE_CHANGE_SUBSCRIPTION *subscription,
                                                     FEATURE_STATE_CHANGE_CALLBACK *callback, void *context)
 {
-    FIXME("(%p, %p, %p) stub\n", subscription, callback, context);
+    struct feature_subscription *sub;
+
+    TRACE("(%p, %p, %p)\n", subscription, callback, context);
+
+    if (!subscription) return;
+    if ((sub = malloc(sizeof(*sub))))
+    {
+        sub->callback = callback;
+        sub->context = context;
+    }
+    *subscription = (FEATURE_STATE_CHANGE_SUBSCRIPTION)sub;
+}
+
+/*************************************************************************
+ * UnsubscribeFeatureStateChangeNotification        [SHCORE.@]
+ */
+void WINAPI UnsubscribeFeatureStateChangeNotification(FEATURE_STATE_CHANGE_SUBSCRIPTION subscription)
+{
+    TRACE("(%p)\n", subscription);
+
+    free(subscription);
+}
+
+/*************************************************************************
+ * GetFeatureVariant        [SHCORE.@]
+ */
+UINT32 WINAPI GetFeatureVariant(UINT32 feature, FEATURE_CHANGE_TIME change_time, UINT32 *payload_id,
+                                BOOL *has_notification)
+{
+    FIXME("(%u, %u, %p, %p) semi-stub\n", feature, change_time, payload_id, has_notification);
+
+    if (payload_id) *payload_id = 0;
+    if (has_notification) *has_notification = FALSE;
+    return 0;
+}
+
+/*************************************************************************
+ * RecordFeatureError        [SHCORE.@]
+ */
+void WINAPI RecordFeatureError(UINT32 feature, const FEATURE_ERROR *error)
+{
+    TRACE("(%u, %p)\n", feature, error);
 }
 
 /*************************************************************************
diff --git a/dlls/shcore/shcore.spec b/dlls/shcore/shcore.spec
index fb36df4f3fa..698fbfb73d6 100644
--- a/dlls/shcore/shcore.spec
+++ b/dlls/shcore/shcore.spec
@@ -10,7 +10,7 @@
 @ stdcall GetDpiForMonitor(long long ptr ptr)
 @ stub GetDpiForShellUIComponent
 @ stdcall GetFeatureEnabledState(long long)
-# @ stub GetFeatureVariant
+@ stdcall GetFeatureVariant(long long ptr ptr)
 @ stdcall GetProcessDpiAwareness(long ptr)
 @ stdcall GetProcessReference(ptr)
 @ stdcall GetScaleFactorForDevice(long)
@@ -30,7 +30,7 @@
 @ stdcall IsOS(long)
 # @ stub IsProcessInIsolatedContainer
 # @ stub IsProcessInWDAGContainer
-# @ stub RecordFeatureError
+@ stdcall RecordFeatureError(long ptr)
 @ stdcall RecordFeatureUsage(long long long str)
 @ stdcall RegisterScaleChangeEvent(ptr ptr)
 @ stdcall RegisterScaleChangeNotifications(long ptr long ptr)
@@ -94,7 +94,7 @@
 @ stdcall SetProcessReference(ptr)
 @ stdcall SubscribeFeatureStateChangeNotification(ptr ptr ptr)
 @ stub UnregisterScaleChangeEvent
-# @ stub UnsubscribeFeatureStateChangeNotification
+@ stdcall UnsubscribeFeatureStateChangeNotification(ptr)
 
 100 stub -noname SHManagedCreateStreamOnFile
 101 stub -noname SHManagedCreateFile
diff --git a/include/featurestagingapi.h b/include/featurestagingapi.h
index 7b3ae3283eb..25ca1e7aea0 100644
--- a/include/featurestagingapi.h
+++ b/include/featurestagingapi.h
@@ -26,6 +26,7 @@ extern "C" {
 DECLARE_HANDLE(FEATURE_STATE_CHANGE_SUBSCRIPTION);
 
 typedef void WINAPI FEATURE_STATE_CHANGE_CALLBACK(void*);
+typedef FEATURE_STATE_CHANGE_CALLBACK *PFEATURE_STATE_CHANGE_CALLBACK;
 
 typedef enum FEATURE_CHANGE_TIME
 {
@@ -42,7 +43,31 @@ typedef enum FEATURE_ENABLED_STATE
     FEATURE_ENABLED_STATE_ENABLED
 } FEATURE_ENABLED_STATE;
 
+typedef struct FEATURE_ERROR
+{
+    HRESULT hr;
+    UINT16 lineNumber;
+    PCSTR file;
+    PCSTR process;
+    PCSTR module;
+    UINT32 callerReturnAddressOffset;
+    PCSTR callerModule;
+    PCSTR message;
+    UINT16 originLineNumber;
+    PCSTR originFile;
+    PCSTR originModule;
+    UINT32 originCallerReturnAddressOffset;
+    PCSTR originCallerModule;
+    PCSTR originName;
+} FEATURE_ERROR;
+
+FEATURE_ENABLED_STATE WINAPI GetFeatureEnabledState(UINT32 feature_id, FEATURE_CHANGE_TIME change_time);
+UINT32 WINAPI GetFeatureVariant(UINT32 feature_id, FEATURE_CHANGE_TIME change_time, UINT32 *payload_id, BOOL *has_notification);
+void WINAPI RecordFeatureError(UINT32 feature_id, const FEATURE_ERROR *error);
 void WINAPI RecordFeatureUsage(UINT32 feature_id, UINT32 kind, UINT32 addend, const CHAR *origin_name);
+void WINAPI SubscribeFeatureStateChangeNotification(FEATURE_STATE_CHANGE_SUBSCRIPTION *subscription,
+                                                    PFEATURE_STATE_CHANGE_CALLBACK callback, void *context);
+void WINAPI UnsubscribeFeatureStateChangeNotification(FEATURE_STATE_CHANGE_SUBSCRIPTION subscription);
 
 #ifdef __cplusplus
 }
