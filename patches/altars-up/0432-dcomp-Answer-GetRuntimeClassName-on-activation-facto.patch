         IActivationFactory_Release( activation );
     }
 
@@ -1372,6 +1377,32 @@ static struct tracker_event *add_event( enum tracker_event_kind kind, INT32 id )
     return event;
 }
 
+/* the states it went through, with the values between summed up */
+static void trace_events( const char *what )
+{
+    static const char *names[] = {"values", "idle", "custom animation", "inertia", "interacting", "ignored"};
+    float first = 0.0f, last = 0.0f, highest = 0.0f;
+    unsigned int i, values = 0;
+
+    for (i = 0; i <= event_count; i++)
+    {
+        if (i < event_count && events[i].kind == EVENT_VALUES)
+        {
+            last = events[i].position.Y;
+            if (!values++) first = highest = last;
+            highest = max( highest, last );
+            continue;
+        }
+        if (values) trace( "%s: %u values %f to %f, highest %f.\n", what, values, first, last, highest );
+        values = 0;
+        if (i == event_count) break;
+        if (events[i].kind == EVENT_INERTIA)
+            trace( "%s: inertia for request %d, velocity %f, natural %f, modified %d %f.\n", what, events[i].id,
+                   events[i].velocity.Y, events[i].natural.Y, events[i].has_modified, events[i].modified.Y );
+        else trace( "%s: %s for request %d.\n", what, names[events[i].kind], events[i].id );
+    }
+}
+
 static HRESULT WINAPI owner_QueryInterface( IInteractionTrackerOwner *iface, REFIID iid, void **out )
 {
     if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
@@ -1696,7 +1727,7 @@ static void test_tracker_motion(void)
     IInspectable *inspectable;
     Vector3 v3, center = {0};
     int i, idle, custom;
