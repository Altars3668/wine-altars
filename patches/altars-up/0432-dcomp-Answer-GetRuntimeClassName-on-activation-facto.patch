@@ -196,7 +196,12 @@ static void test_effect_source_parameter(void)
     ok( hr == S_OK, "got hr %#lx.\n", hr );
     if (activation)
     {
-        check_class( activation, RuntimeClass_Windows_UI_Composition_CompositionEffectSourceParameter );
+        HSTRING name = NULL;
+
+        /* an activation factory is no runtime class, and says so */
