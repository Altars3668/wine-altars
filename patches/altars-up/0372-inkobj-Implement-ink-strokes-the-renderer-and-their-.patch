+
+    TRACE("iface %p, m11 %.8e, m12 %.8e, m21 %.8e, m22 %.8e, dx %.8e, dy %.8e.\n", iface, m11, m12, m21, m22, dx, dy);
+
+    transform->xform.eM11 = m11;
+    transform->xform.eM12 = m12;
+    transform->xform.eM21 = m21;
+    transform->xform.eM22 = m22;
+    transform->xform.eDx = dx;
+    transform->xform.eDy = dy;
+    return S_OK;
+}
+
+#define DEFINE_ELEMENT(name) \
+    static HRESULT WINAPI transform_get_##name(IInkTransform *iface, float *value) \
+    { \
+        TRACE("iface %p, value %p.\n", iface, value); \
+        if (!value) return E_POINTER; \
+        *value = impl_from_IInkTransform(iface)->xform.name; \
+        return S_OK; \
+    } \
+    static HRESULT WINAPI transform_put_##name(IInkTransform *iface, float value) \
+    { \
+        TRACE("iface %p, value %.8e.\n", iface, value); \
+        impl_from_IInkTransform(iface)->xform.name = value; \
+        return S_OK; \
+    }
+
+DEFINE_ELEMENT(eM11)
+DEFINE_ELEMENT(eM12)
+DEFINE_ELEMENT(eM21)
+DEFINE_ELEMENT(eM22)
+DEFINE_ELEMENT(eDx)
+DEFINE_ELEMENT(eDy)
+
+static HRESULT WINAPI transform_get_Data(IInkTransform *iface, XFORM *xform)
+{
