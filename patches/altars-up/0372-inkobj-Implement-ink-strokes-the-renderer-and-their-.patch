+
+    TRACE("iface %p, degrees %.8e, x %.8e, y %.8e.\n", iface, degrees, x, y);
+
+    xform_identity(&xform);
+    xform_rotate(&xform, degrees, x, y);
+    return stroke_transform(iface, &xform, FALSE);
+}
+
+static HRESULT WINAPI stroke_Shear(IInkStrokeDisp *iface, float horizontal, float vertical)
+{
+    XFORM xform;
+
+    TRACE("iface %p, horizontal %.8e, vertical %.8e.\n", iface, horizontal, vertical);
+
+    xform_identity(&xform);
+    xform_shear(&xform, horizontal, vertical);
+    return stroke_transform(iface, &xform, FALSE);
+}
+
+static HRESULT WINAPI stroke_ScaleTransform(IInkStrokeDisp *iface, float horizontal, float vertical)
+{
+    XFORM xform;
+
+    TRACE("iface %p, horizontal %.8e, vertical %.8e.\n", iface, horizontal, vertical);
