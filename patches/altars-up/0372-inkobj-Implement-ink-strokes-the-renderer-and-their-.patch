+
+static HRESULT WINAPI strokes_get__NewEnum(IInkStrokes *iface, IUnknown **out)
+{
+    struct strokes *strokes = impl_from_IInkStrokes(iface);
+    IDispatch **items;
+    unsigned int i, n = 0;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection(&strokes->ink->cs);
+    if (!(items = malloc(max(1, strokes->count) * sizeof(*items))))
+        hr = E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i < strokes->count; ++i)
+    {
+        if (SUCCEEDED(hr = stroke_create(strokes->ink, strokes->items[i], (IInkStrokeDisp **)&items[n])))
+            ++n;
+    }
+    LeaveCriticalSection(&strokes->ink->cs);
+
+    if (SUCCEEDED(hr))
+        hr = variant_enum_create(items, n, (IEnumVARIANT **)out);
+    for (i = 0; i < n; ++i)
+        IDispatch_Release(items[i]);
+    free(items);
+    return hr;
+}
