+static HRESULT WINAPI ink_GetBoundingBox(IInkDisp *iface, InkBoundingBoxMode mode, IInkRectangle **out)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data **data;
+    unsigned int count;
+    RECT rect;
+    HRESULT hr;
+
+    TRACE("iface %p, mode %d, out %p.\n", iface, mode, out);
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = ink_get_data(ink, &data, &count))) return hr;
+    hr = strokes_bounds(data, count, mode, NULL, FALSE, &rect);
+    strokes_free_data(data, count);
+    if (FAILED(hr)) return hr;
+    return rectangle_create(&rect, out);
+}
+
+/* no collection deletes every stroke */
+static HRESULT WINAPI ink_DeleteStrokes(IInkDisp *iface, IInkStrokes *strokes)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data **data;
+    unsigned int count, i;
+    HRESULT hr;
+
+    TRACE("iface %p, strokes %p.\n", iface, strokes);
+
+    if (strokes) hr = strokes_get_data(strokes, &data, &count);
+    else hr = ink_get_data(ink, &data, &count);
+    if (FAILED(hr)) return hr;
+
+    EnterCriticalSection(&ink->cs);
+    if (SUCCEEDED(hr = ink_check_data(ink, data, count)))
+    {
+        for (i = 0; i < count; ++i)
+            ink_delete_stroke(ink, data[i]);
+    }
+    LeaveCriticalSection(&ink->cs);
+    strokes_free_data(data, count);
+    return hr;
+}
+
+static HRESULT WINAPI ink_DeleteStroke(IInkDisp *iface, IInkStrokeDisp *stroke)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data *data;
+    HRESULT hr;
+
+    TRACE("iface %p, stroke %p.\n", iface, stroke);
+
+    if (!(data = stroke_data_from_IInkStrokeDisp(stroke))) return E_INVALIDARG;
+    EnterCriticalSection(&ink->cs);
+    if (SUCCEEDED(hr = ink_check_data(ink, &data, 1)))
+        ink_delete_stroke(ink, data);
+    LeaveCriticalSection(&ink->cs);
+    return hr;
+}
+
+/* a new ink with copies of the strokes, which keep their ids */
+static HRESULT ink_copy_strokes(struct ink *ink, struct stroke_data **data, unsigned int count, struct ink **out)
+{
+    struct stroke_data *copy;
+    IInkDisp *iface;
+    struct ink *dst;
+    unsigned int i;
+    HRESULT hr;
+
+    if (FAILED(hr = ink_create(&iface))) return hr;
+    dst = impl_from_IInkDisp(iface);
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(hr = stroke_data_copy(data[i], &copy))) break;
+        ink_add_stroke(dst, copy);
+        copy->id = data[i]->id;
+        dst->next_id = max(dst->next_id, copy->id + 1);
+        stroke_data_release(copy);
+    }
+    if (FAILED(hr))
+    {
+        IInkDisp_Release(iface);
+        return hr;
+    }
+    dst->dirty = VARIANT_FALSE;
+    *out = dst;
+    return S_OK;
+}
+
+static HRESULT ink_extract(struct ink *ink, struct stroke_data **data, unsigned int count, InkExtractFlags flags,
+        IInkDisp **out)
+{
+    struct ink *extracted;
+    unsigned int i;
+    HRESULT hr;
+
+    EnterCriticalSection(&ink->cs);
+    if (SUCCEEDED(hr = ink_check_data(ink, data, count))
+            && SUCCEEDED(hr = ink_copy_strokes(ink, data, count, &extracted)))
+    {
+        if (flags & IEF_RemoveFromOriginal)
+            for (i = 0; i < count; ++i) ink_delete_stroke(ink, data[i]);
+        *out = &extracted->IInkDisp_iface;
+    }
+    LeaveCriticalSection(&ink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI ink_ExtractStrokes(IInkDisp *iface, IInkStrokes *strokes, InkExtractFlags flags, IInkDisp **out)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data **data;
+    unsigned int count;
+    HRESULT hr;
+
+    TRACE("iface %p, strokes %p, flags %#x, out %p.\n", iface, strokes, flags, out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (strokes) hr = strokes_get_data(strokes, &data, &count);
+    else hr = ink_get_data(ink, &data, &count);
+    if (FAILED(hr)) return hr;
+    hr = ink_extract(ink, data, count, flags, out);
+    strokes_free_data(data, count);
+    return hr;
+}
+
+static BOOL stroke_data_inside(const struct stroke_data *data, const RECT *rect)
+{
+    unsigned int i;
+
+    for (i = 0; i < data->packet_count; ++i)
+    {
+        LONG x = stroke_x(data, i), y = stroke_y(data, i);
+
+        if (x < rect->left || x > rect->right || y < rect->top || y > rect->bottom) return FALSE;
+    }
+    return TRUE;
+}
+
+/* strokes that cross the rectangle's edge would be cut there; only whole ones are taken */
+static HRESULT WINAPI ink_ExtractWithRectangle(IInkDisp *iface, IInkRectangle *rectangle, InkExtractFlags flags,
+        IInkDisp **out)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data **data;
+    unsigned int count, i, n = 0;
+    RECT rect;
+    HRESULT hr;
+
+    TRACE("iface %p, rectangle %p, flags %#x, out %p.\n", iface, rectangle, flags, out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = rectangle_get(rectangle, &rect))) return hr;
+    if (FAILED(hr = ink_get_data(ink, &data, &count))) return hr;
+    for (i = 0; i < count; ++i)
+    {
+        if (stroke_data_inside(data[i], &rect)) data[n++] = data[i];
+        else
+        {
+            FIXME("Stroke %ld is not cut at the rectangle.\n", data[i]->id);
+            stroke_data_release(data[i]);
+        }
+    }
+    hr = ink_extract(ink, data, n, flags, out);
+    strokes_free_data(data, n);
+    return hr;
+}
+
+static HRESULT WINAPI ink_Clip(IInkDisp *iface, IInkRectangle *rectangle)
+{
+    FIXME("iface %p, rectangle %p, not implemented.\n", iface, rectangle);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_Clone(IInkDisp *iface, IInkDisp **out)
+{
+    struct ink *ink = impl_from_IInkDisp(iface), *clone;
+    struct stroke_data **data, *stroke_data;
+    unsigned int count, i, j, k;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    EnterCriticalSection(&ink->cs);
+    if (FAILED(hr = ink_get_data(ink, &data, &count)))
+    {
+        LeaveCriticalSection(&ink->cs);
+        return hr;
+    }
+    if (SUCCEEDED(hr = ink_copy_strokes(ink, data, count, &clone)))
+    {
+        clone->next_id = ink->next_id;
+        clone->dirty = ink->dirty;
+        hr = extended_properties_copy(clone->properties, ink->properties);
+
+        /* the named collections name the copies */
+        for (i = 0; SUCCEEDED(hr) && i < ink->custom_count; ++i)
+        {
+            struct custom_entry entry = {0};
+
+            if (!(entry.name = SysAllocString(ink->custom[i].name))
+                    || !(entry.items = malloc(max(1, ink->custom[i].count) * sizeof(*entry.items))))
+            {
+                SysFreeString(entry.name);
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            for (j = 0; j < ink->custom[i].count; ++j)
+            {
+                k = 0;
+                LIST_FOR_EACH_ENTRY(stroke_data, &clone->strokes, struct stroke_data, entry)
+                {
+                    if (data[k++] != ink->custom[i].items[j]) continue;
+                    stroke_data_addref(stroke_data);
+                    entry.items[entry.count++] = stroke_data;
+                    break;
+                }
+            }
+            if (clone->custom_count == clone->custom_capacity)
+            {
+                unsigned int capacity = max(4, clone->custom_capacity * 2);
+                struct custom_entry *custom = realloc(clone->custom, capacity * sizeof(*custom));
+
+                if (!custom)
+                {
+                    custom_entry_clear(&entry);
+                    hr = E_OUTOFMEMORY;
+                    break;
+                }
+                clone->custom = custom;
+                clone->custom_capacity = capacity;
+            }
+            clone->custom[clone->custom_count++] = entry;
+        }
+        if (SUCCEEDED(hr)) *out = &clone->IInkDisp_iface;
+        else IInkDisp_Release(&clone->IInkDisp_iface);
+    }
+    LeaveCriticalSection(&ink->cs);
+    strokes_free_data(data, count);
+    return hr;
+}
+
+static HRESULT ink_select(struct ink *ink, BOOL (*test)(const struct stroke_data *, const void *), const void *context,
+        IInkStrokes **out)
+{
+    struct stroke_data **data;
+    unsigned int count, i, n = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = ink_get_data(ink, &data, &count))) return hr;
+    for (i = 0; i < count; ++i)
+    {
+        if (test(data[i], context)) data[n++] = data[i];
+        else stroke_data_release(data[i]);
+    }
+    hr = strokes_create(ink, data, n, out);
+    strokes_free_data(data, n);
+    return hr;
+}
+
+struct circle
+{
+    float x, y, radius;
+};
+
+static BOOL hit_circle(const struct stroke_data *data, const void *context)
+{
+    const struct circle *circle = context;
+    float index;
+
+    return data->packet_count && stroke_data_nearest(data, circle->x, circle->y, &index) <= circle->radius;
+}
+
+static HRESULT WINAPI ink_HitTestCircle(IInkDisp *iface, LONG x, LONG y, float radius, IInkStrokes **out)
+{
+    struct circle circle = {x, y, radius};
+
+    TRACE("iface %p, x %ld, y %ld, radius %.8e, out %p.\n", iface, x, y, radius, out);
+
+    if (!out) return E_POINTER;
+    return ink_select(impl_from_IInkDisp(iface), hit_circle, &circle, out);
+}
+
+struct area
+{
+    const float *points;
+    unsigned int count;
+    RECT rect;
+    float percent;
+};
+
+/* the share of a stroke's points inside the area; with no share asked for, any point */
+static BOOL hit_area(const struct stroke_data *data, const void *context)
+{
+    const struct area *area = context;
+    unsigned int i, inside = 0;
+
+    if (!data->packet_count) return FALSE;
+    for (i = 0; i < data->packet_count; ++i)
+    {
+        LONG x = stroke_x(data, i), y = stroke_y(data, i);
+
+        if (area->points)
+            inside += point_in_polygon(x, y, area->points, area->count);
+        else
+            inside += x >= area->rect.left && x <= area->rect.right && y >= area->rect.top && y <= area->rect.bottom;
+    }
+    if (area->percent <= 0.0f) return inside > 0;
+    return inside * 100.0f >= area->percent * data->packet_count;
+}
+
+static HRESULT WINAPI ink_HitTestWithRectangle(IInkDisp *iface, IInkRectangle *rectangle, float percent, IInkStrokes **out)
+{
+    struct area area = {0};
+    HRESULT hr;
+
+    TRACE("iface %p, rectangle %p, percent %.8e, out %p.\n", iface, rectangle, percent, out);
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = rectangle_get(rectangle, &area.rect))) return hr;
+    area.percent = percent;
+    return ink_select(impl_from_IInkDisp(iface), hit_area, &area, out);
+}
+
+static HRESULT WINAPI ink_HitTestWithLasso(IInkDisp *iface, VARIANT points, float percent, VARIANT *lasso_points,
+        IInkStrokes **out)
+{
+    struct area area = {0};
+    unsigned int count, i;
+    float *polygon;
+    LONG *values;
+    HRESULT hr;
+
+    TRACE("iface %p, points %s, percent %.8e, lasso_points %p, out %p.\n", iface, debugstr_variant(&points),
+            percent, lasso_points, out);
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = read_long_array(&points, &values, &count))) return hr;
+    if (count < 6 || !(polygon = malloc(count * sizeof(*polygon))))
+    {
+        free(values);
+        return count < 6 ? E_INVALIDARG : E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; ++i) polygon[i] = values[i];
+    area.points = polygon;
+    area.count = count / 2;
+    area.percent = percent;
+    hr = ink_select(impl_from_IInkDisp(iface), hit_area, &area, out);
+    if (SUCCEEDED(hr) && lasso_points)
+    {
+        VariantClear(lasso_points);
+        make_long_array(values, area.count * 2, lasso_points);
+    }
+    free(polygon);
+    free(values);
+    return hr;
+}
+
+static HRESULT WINAPI ink_NearestPoint(IInkDisp *iface, LONG x, LONG y, float *point_on_stroke,
+        float *distance, IInkStrokeDisp **out)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data *data, *nearest = NULL;
+    float best = FLT_MAX, best_index = 0.0f, index;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, x %ld, y %ld, point_on_stroke %p, distance %p, out %p.\n", iface, x, y, point_on_stroke,
+            distance, out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    EnterCriticalSection(&ink->cs);
+    LIST_FOR_EACH_ENTRY(data, &ink->strokes, struct stroke_data, entry)
+    {
+        float d;
+
+        if (!data->packet_count) continue;
+        if ((d = stroke_data_nearest(data, x, y, &index)) < best)
+        {
+            best = d;
+            best_index = index;
+            nearest = data;
+        }
+    }
+    if (nearest)
+    {
+        hr = stroke_create(ink, nearest, out);
+        if (point_on_stroke) *point_on_stroke = best_index;
+        if (distance) *distance = best;
+    }
+    LeaveCriticalSection(&ink->cs);
+    return hr;
+}
+
+/* nothing given makes an empty collection */
+static HRESULT WINAPI ink_CreateStrokes(IInkDisp *iface, VARIANT ids, IInkStrokes **out)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data **data, *stroke_data;
+    unsigned int count = 0, i, n = 0;
+    LONG *values = NULL;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, ids %s, out %p.\n", iface, debugstr_variant(&ids), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (V_VT(&ids) != VT_EMPTY && V_VT(&ids) != VT_ERROR && V_VT(&ids) != VT_NULL
+            && FAILED(hr = read_long_array(&ids, &values, &count)))
+        return hr;
+    if (!(data = malloc(max(1, count) * sizeof(*data))))
+    {
+        free(values);
+        return E_OUTOFMEMORY;
+    }
+
+    EnterCriticalSection(&ink->cs);
+    for (i = 0; i < count; ++i)
+    {
+        BOOL found = FALSE;
+
+        LIST_FOR_EACH_ENTRY(stroke_data, &ink->strokes, struct stroke_data, entry)
+        {
+            if (stroke_data->id != values[i]) continue;
+            data[n++] = stroke_data;
+            found = TRUE;
+            break;
+        }
+        if (!found)
+        {
+            hr = E_INVALIDARG;
+            break;
+        }
+    }
+    if (SUCCEEDED(hr))
+        hr = strokes_create(ink, data, n, out);
+    LeaveCriticalSection(&ink->cs);
+
+    free(data);
+    free(values);
+    return hr;
+}
+
+/* copies of the strokes, whatever ink they are in, scaled into the rectangle */
+static HRESULT WINAPI ink_AddStrokesAtRectangle(IInkDisp *iface, IInkStrokes *strokes, IInkRectangle *rectangle)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data **data, *copy;
+    unsigned int count, i;
+    RECT target, bounds;
+    XFORM xform;
+    HRESULT hr;
+
+    TRACE("iface %p, strokes %p, rectangle %p.\n", iface, strokes, rectangle);
+
+    if (FAILED(hr = rectangle_get(rectangle, &target))) return hr;
+    if (FAILED(hr = strokes_get_data(strokes, &data, &count))) return hr;
+    strokes_bounds(data, count, IBBM_PointsOnly, NULL, FALSE, &bounds);
+    scale_to_rectangle(&bounds, &target, &xform);
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+    {
+        if (SUCCEEDED(hr = stroke_data_copy(data[i], &copy)))
+        {
+            stroke_data_transform(copy, &xform, FALSE);
+            hr = ink_add_stroke(ink, copy);
+            stroke_data_release(copy);
+        }
+    }
+    strokes_free_data(data, count);
+    return hr;
+}
+
+static HRESULT WINAPI ink_Save(IInkDisp *iface, InkPersistenceFormat format, InkPersistenceCompressionMode compression,
+        VARIANT *data)
+{
+    FIXME("iface %p, format %d, compression %d, data %p, not implemented.\n", iface, format, compression, data);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_Load(IInkDisp *iface, VARIANT data)
+{
+    FIXME("iface %p, data %s, not implemented.\n", iface, debugstr_variant(&data));
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_CreateStroke(IInkDisp *iface, VARIANT packet_data, VARIANT packet_description,
+        IInkStrokeDisp **out)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    unsigned int size, count;
+    struct stroke_data *data;
+    GUID *description;
+    LONG *packets;
+    HRESULT hr;
+
+    TRACE("iface %p, packet_data %s, packet_description %s, out %p.\n", iface, debugstr_variant(&packet_data),
+            debugstr_variant(&packet_description), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = read_description(&packet_description, &description, &size))) return hr;
+    if (FAILED(hr = read_long_array(&packet_data, &packets, &count)))
+    {
+        free(description);
+        return hr;
+    }
+    if (!count || count % size)
+        hr = E_INVALIDARG;
+    else if (SUCCEEDED(hr = stroke_data_create(size, description, count / size, packets, NULL, &data)))
+    {
+        if (SUCCEEDED(hr = ink_add_stroke(ink, data)))
+            hr = stroke_create(ink, data, out);
+        stroke_data_release(data);
+    }
+    free(packets);
+    free(description);
+    return hr;
+}
+
+static HRESULT WINAPI ink_ClipboardCopyWithRectangle(IInkDisp *iface, IInkRectangle *rectangle,
+        InkClipboardFormats formats, InkClipboardModes modes, IDataObject **data)
+{
+    FIXME("iface %p, rectangle %p, formats %#x, modes %#x, data %p, not implemented.\n", iface, rectangle,
+            formats, modes, data);
