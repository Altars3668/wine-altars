+static HRESULT WINAPI stroke_FindIntersections(IInkStrokeDisp *iface, IInkStrokes *strokes, VARIANT *intersections)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    struct stroke_data *data = stroke->data, **others = NULL, *other;
+    unsigned int i, j, k, count = 0, n = 0, capacity = 16;
+    float *values, t, u;
+    HRESULT hr;
+
+    TRACE("iface %p, strokes %p, intersections %p.\n", iface, strokes, intersections);
+
+    if (!intersections) return E_POINTER;
+    if (strokes && FAILED(hr = strokes_get_data(strokes, &others, &count))) return hr;
+    if (!(values = malloc(capacity * sizeof(*values))))
+    {
+        strokes_free_data(others, count);
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = stroke_lock(stroke)))
+    {
+        strokes_free_data(others, count);
+        free(values);
+        return hr;
+    }
+    if (!strokes)
+    {
+        /* every other stroke of the ink */
+        LIST_FOR_EACH_ENTRY(other, &stroke->ink->strokes, struct stroke_data, entry) ++count;
+        if ((others = malloc(max(1, count) * sizeof(*others))))
+        {
+            count = 0;
+            LIST_FOR_EACH_ENTRY(other, &stroke->ink->strokes, struct stroke_data, entry)
+            {
+                stroke_data_addref(other);
+                others[count++] = other;
+            }
+        }
+        else count = 0;
+    }
+    for (i = 0; i + 1 < data->packet_count; ++i)
+    {
+        for (k = 0; k < count; ++k)
+        {
+            other = others[k];
+            if (other == data) continue;
+            for (j = 0; j + 1 < other->packet_count; ++j)
+            {
+                if (!segments_intersect(stroke_x(data, i), stroke_y(data, i), stroke_x(data, i + 1), stroke_y(data, i + 1),
+                        stroke_x(other, j), stroke_y(other, j), stroke_x(other, j + 1), stroke_y(other, j + 1), &t, &u))
+                    continue;
+                if (n == capacity)
+                {
+                    float *tmp = realloc(values, (capacity *= 2) * sizeof(*values));
+                    if (!tmp) break;
+                    values = tmp;
+                }
+                values[n++] = i + t;
+            }
+        }
+    }
+    stroke_unlock(stroke, FALSE);
+    strokes_free_data(others, count);
+
+    hr = make_float_array(values, n, intersections);
+    free(values);
+    return hr;
+}
