+DEFINE_DISPATCH_METHODS(strokes, IInkStrokes, IInkStrokes_tid)
+
+static HRESULT WINAPI strokes_get_Count(IInkStrokes *iface, LONG *count)
+{
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count) return E_POINTER;
+    *count = impl_from_IInkStrokes(iface)->count;
