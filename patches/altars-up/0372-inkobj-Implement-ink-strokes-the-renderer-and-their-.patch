+
+WINE_DEFAULT_DEBUG_CHANNEL(inkobj);
+
+static HINSTANCE inkobj_instance;
+static ITypeLib *typelib;
+static ITypeInfo *typeinfos[LAST_tid];
+
+static REFIID tid_ids[] =
+{
+    &IID_IInkDisp,
+    &IID_IInkStrokes,
+    &IID_IInkStrokeDisp,
+    &IID_IInkCustomStrokes,
+    &IID_IInkDrawingAttributes,
+    &IID_IInkExtendedProperties,
+    &IID_IInkExtendedProperty,
+    &IID_IInkRectangle,
+    &IID_IInkTransform,
+    &IID_IInkRenderer,
+};
+
+/* the type library is the module's own; Windows registers it, but reading it from the
+ * module does not depend on that */
+static HRESULT load_typelib(void)
+{
+    WCHAR path[MAX_PATH];
+    ITypeLib *tl;
+    HRESULT hr;
+
+    if (typelib)
+        return S_OK;
+
+    GetModuleFileNameW(inkobj_instance, path, ARRAY_SIZE(path));
+    if (FAILED(hr = LoadTypeLibEx(path, REGKIND_NONE, &tl)))
+    {
+        ERR("Failed to load the type library, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    if (InterlockedCompareExchangePointer((void **)&typelib, tl, NULL))
+        ITypeLib_Release(tl);
+    return S_OK;
+}
+
+HRESULT get_typeinfo(tid_t tid, ITypeInfo **typeinfo)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = load_typelib()))
+        return hr;
+
+    if (!typeinfos[tid])
+    {
+        ITypeInfo *info;
+
+        if (FAILED(hr = ITypeLib_GetTypeInfoOfGuid(typelib, tid_ids[tid], &info)))
+        {
+            ERR("No type information for %s, hr %#lx.\n", debugstr_guid(tid_ids[tid]), hr);
+            return hr;
+        }
+        if (InterlockedCompareExchangePointer((void **)(typeinfos + tid), info, NULL))
+            ITypeInfo_Release(info);
+    }
+
+    *typeinfo = typeinfos[tid];
+    ITypeInfo_AddRef(*typeinfo);
+    return S_OK;
+}
+
+HRESULT dispatch_get_type_info(tid_t tid, UINT index, ITypeInfo **info)
+{
+    if (index)
+        return DISP_E_BADINDEX;
+    return get_typeinfo(tid, info);
+}
+
+HRESULT dispatch_get_ids_of_names(tid_t tid, LPOLESTR *names, UINT count, DISPID *ids)
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (FAILED(hr = get_typeinfo(tid, &info)))
+        return hr;
+    hr = ITypeInfo_GetIDsOfNames(info, names, count, ids);
+    ITypeInfo_Release(info);
+    return hr;
+}
+
+HRESULT dispatch_invoke(tid_t tid, void *iface, DISPID id, WORD flags, DISPPARAMS *params,
+        VARIANT *result, EXCEPINFO *excep, UINT *arg_err)
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (FAILED(hr = get_typeinfo(tid, &info)))
+        return hr;
+    hr = ITypeInfo_Invoke(info, iface, id, flags, params, result, excep, arg_err);
+    ITypeInfo_Release(info);
+    return hr;
+}
+
+void xform_identity(XFORM *xform)
+{
+    xform->eM11 = xform->eM22 = 1.0f;
+    xform->eM12 = xform->eM21 = 0.0f;
+    xform->eDx = xform->eDy = 0.0f;
+}
+
+void xform_multiply(XFORM *out, const XFORM *first, const XFORM *second)
+{
+    XFORM ret;
+
+    ret.eM11 = first->eM11 * second->eM11 + first->eM12 * second->eM21;
+    ret.eM12 = first->eM11 * second->eM12 + first->eM12 * second->eM22;
+    ret.eM21 = first->eM21 * second->eM11 + first->eM22 * second->eM21;
+    ret.eM22 = first->eM21 * second->eM12 + first->eM22 * second->eM22;
+    ret.eDx = first->eDx * second->eM11 + first->eDy * second->eM21 + second->eDx;
+    ret.eDy = first->eDx * second->eM12 + first->eDy * second->eM22 + second->eDy;
+    *out = ret;
+}
+
+BOOL xform_invert(XFORM *out, const XFORM *xform)
+{
+    float det = xform->eM11 * xform->eM22 - xform->eM12 * xform->eM21;
+    XFORM ret;
+
+    if (fabsf(det) < 1e-12f)
+        return FALSE;
+
+    ret.eM11 = xform->eM22 / det;
+    ret.eM12 = -xform->eM12 / det;
+    ret.eM21 = -xform->eM21 / det;
+    ret.eM22 = xform->eM11 / det;
+    ret.eDx = -(xform->eDx * ret.eM11 + xform->eDy * ret.eM21);
+    ret.eDy = -(xform->eDx * ret.eM12 + xform->eDy * ret.eM22);
+    *out = ret;
+    return TRUE;
+}
+
+void xform_apply(const XFORM *xform, float *x, float *y)
+{
+    float px = *x, py = *y;
+
+    *x = px * xform->eM11 + py * xform->eM21 + xform->eDx;
+    *y = px * xform->eM12 + py * xform->eM22 + xform->eDy;
+}
+
+/* how much a transform scales lengths, as it scales areas */
+float xform_scale(const XFORM *xform)
+{
+    return sqrtf(fabsf(xform->eM11 * xform->eM22 - xform->eM12 * xform->eM21));
+}
+
+/* each of these applies its operation after the transform there is */
+void xform_translate(XFORM *xform, float dx, float dy)
+{
+    xform->eDx += dx;
+    xform->eDy += dy;
+}
+
+void xform_rotate(XFORM *xform, float degrees, float x, float y)
+{
+    float angle = degrees * 3.14159265358979f / 180.0f;
+    XFORM rotation;
+
+    rotation.eM11 = cosf(angle);
+    rotation.eM12 = sinf(angle);
+    rotation.eM21 = -rotation.eM12;
+    rotation.eM22 = rotation.eM11;
+    rotation.eDx = x - x * rotation.eM11 - y * rotation.eM21;
+    rotation.eDy = y - x * rotation.eM12 - y * rotation.eM22;
+    xform_multiply(xform, xform, &rotation);
+}
+
+void xform_scale_by(XFORM *xform, float sx, float sy)
+{
+    XFORM scale = {sx, 0.0f, 0.0f, sy, 0.0f, 0.0f};
+
+    xform_multiply(xform, xform, &scale);
+}
+
+void xform_shear(XFORM *xform, float horizontal, float vertical)
+{
+    XFORM shear = {1.0f, vertical, horizontal, 1.0f, 0.0f, 0.0f};
+
+    xform_multiply(xform, xform, &shear);
+}
+
+struct variant_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG refcount;
+    unsigned int index;
+    unsigned int count;
+    IDispatch *items[];
+};
+
+static inline struct variant_enum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct variant_enum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI variant_enum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IEnumVARIANT) || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IEnumVARIANT_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI variant_enum_AddRef(IEnumVARIANT *iface)
+{
+    struct variant_enum *e = impl_from_IEnumVARIANT(iface);
+    ULONG refcount = InterlockedIncrement(&e->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI variant_enum_Release(IEnumVARIANT *iface)
+{
+    struct variant_enum *e = impl_from_IEnumVARIANT(iface);
+    ULONG refcount = InterlockedDecrement(&e->refcount);
+    unsigned int i;
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        for (i = 0; i < e->count; ++i)
+            IDispatch_Release(e->items[i]);
+        free(e);
+    }
+    return refcount;
+}
+
+static HRESULT WINAPI variant_enum_Next(IEnumVARIANT *iface, ULONG count, VARIANT *items, ULONG *fetched)
+{
+    struct variant_enum *e = impl_from_IEnumVARIANT(iface);
+    ULONG i;
+
+    TRACE("iface %p, count %lu, items %p, fetched %p.\n", iface, count, items, fetched);
+
+    for (i = 0; i < count && e->index < e->count; ++i, ++e->index)
+    {
+        V_VT(&items[i]) = VT_DISPATCH;
+        V_DISPATCH(&items[i]) = e->items[e->index];
+        IDispatch_AddRef(V_DISPATCH(&items[i]));
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI variant_enum_Skip(IEnumVARIANT *iface, ULONG count)
+{
+    struct variant_enum *e = impl_from_IEnumVARIANT(iface);
+
+    TRACE("iface %p, count %lu.\n", iface, count);
+
+    if (count > e->count - e->index)
+    {
+        e->index = e->count;
+        return S_FALSE;
+    }
+    e->index += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI variant_enum_Reset(IEnumVARIANT *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    impl_from_IEnumVARIANT(iface)->index = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI variant_enum_Clone(IEnumVARIANT *iface, IEnumVARIANT **out)
+{
+    struct variant_enum *e = impl_from_IEnumVARIANT(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (SUCCEEDED(hr = variant_enum_create(e->items, e->count, out)))
+        impl_from_IEnumVARIANT(*out)->index = e->index;
+    return hr;
+}
+
+static const IEnumVARIANTVtbl variant_enum_vtbl =
+{
+    variant_enum_QueryInterface,
+    variant_enum_AddRef,
+    variant_enum_Release,
+    variant_enum_Next,
+    variant_enum_Skip,
+    variant_enum_Reset,
+    variant_enum_Clone,
+};
+
+/* enumerates a snapshot of a collection's items */
+HRESULT variant_enum_create(IDispatch **items, unsigned int count, IEnumVARIANT **out)
+{
+    struct variant_enum *e;
+    unsigned int i;
+
+    if (!(e = calloc(1, offsetof(struct variant_enum, items[count]))))
+        return E_OUTOFMEMORY;
+
+    e->IEnumVARIANT_iface.lpVtbl = &variant_enum_vtbl;
+    e->refcount = 1;
+    e->count = count;
+    for (i = 0; i < count; ++i)
+    {
+        e->items[i] = items[i];
+        IDispatch_AddRef(items[i]);
+    }
+
+    *out = &e->IEnumVARIANT_iface;
+    return S_OK;
+}
+
+struct class_factory
+{
+    IClassFactory IClassFactory_iface;
+    const CLSID *clsid;
+    HRESULT (*create)(REFIID riid, void **out);
+};
+
+static inline struct class_factory *impl_from_IClassFactory(IClassFactory *iface)
+{
+    return CONTAINING_RECORD(iface, struct class_factory, IClassFactory_iface);
+}
+
+static HRESULT WINAPI class_factory_QueryInterface(IClassFactory *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IClassFactory))
+    {
+        *out = iface;
+        IClassFactory_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI class_factory_AddRef(IClassFactory *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI class_factory_Release(IClassFactory *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI class_factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID riid, void **out)
+{
+    struct class_factory *factory = impl_from_IClassFactory(iface);
+
+    TRACE("iface %p, outer %p, riid %s, out %p.\n", iface, outer, debugstr_guid(riid), out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (outer)
+        return CLASS_E_NOAGGREGATION;
+
+    return factory->create(riid, out);
+}
+
+static HRESULT WINAPI class_factory_LockServer(IClassFactory *iface, BOOL lock)
+{
+    TRACE("iface %p, lock %d.\n", iface, lock);
+    return S_OK;
+}
+
+static const IClassFactoryVtbl class_factory_vtbl =
+{
+    class_factory_QueryInterface,
+    class_factory_AddRef,
+    class_factory_Release,
+    class_factory_CreateInstance,
+    class_factory_LockServer,
+};
+
+static HRESULT query_created(IUnknown *object, HRESULT hr, REFIID riid, void **out)
+{
+    if (FAILED(hr))
+        return hr;
+    hr = IUnknown_QueryInterface(object, riid, out);
+    IUnknown_Release(object);
+    return hr;
+}
+
+static HRESULT create_ink(REFIID riid, void **out)
+{
+    IInkDisp *ink;
+    HRESULT hr = ink_create(&ink);
+    return query_created((IUnknown *)ink, hr, riid, out);
+}
+
+static HRESULT create_renderer(REFIID riid, void **out)
+{
+    IInkRenderer *renderer;
+    HRESULT hr = renderer_create(&renderer);
+    return query_created((IUnknown *)renderer, hr, riid, out);
+}
+
+static HRESULT create_drawing_attributes(REFIID riid, void **out)
+{
+    IInkDrawingAttributes *attributes;
+    HRESULT hr = drawing_attributes_create(&attributes);
+    return query_created((IUnknown *)attributes, hr, riid, out);
+}
+
+static HRESULT create_transform(REFIID riid, void **out)
+{
+    IInkTransform *transform;
+    XFORM identity;
+    HRESULT hr;
+
+    xform_identity(&identity);
+    hr = transform_create(&identity, &transform);
+    return query_created((IUnknown *)transform, hr, riid, out);
+}
+
+static HRESULT create_rectangle(REFIID riid, void **out)
+{
+    static const RECT empty;
+    IInkRectangle *rectangle;
+    HRESULT hr = rectangle_create(&empty, &rectangle);
+    return query_created((IUnknown *)rectangle, hr, riid, out);
+}
+
+static struct class_factory factories[] =
+{
+    {{&class_factory_vtbl}, &CLSID_InkDisp, create_ink},
+    {{&class_factory_vtbl}, &CLSID_InkRenderer, create_renderer},
+    {{&class_factory_vtbl}, &CLSID_InkDrawingAttributes, create_drawing_attributes},
+    {{&class_factory_vtbl}, &CLSID_InkTransform, create_transform},
+    {{&class_factory_vtbl}, &CLSID_InkRectangle, create_rectangle},
+};
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    TRACE("instance %p, reason %lu, reserved %p.\n", instance, reason, reserved);
+
+    switch (reason)
+    {
+    case DLL_PROCESS_ATTACH:
+        inkobj_instance = instance;
+        DisableThreadLibraryCalls(instance);
+        break;
+    case DLL_PROCESS_DETACH:
+        if (reserved) break;
+        for (unsigned int i = 0; i < ARRAY_SIZE(typeinfos); ++i)
+            if (typeinfos[i]) ITypeInfo_Release(typeinfos[i]);
+        if (typelib) ITypeLib_Release(typelib);
+        break;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *      DllGetClassObject (INKOBJ.@)
+ */
+HRESULT WINAPI DllGetClassObject(REFCLSID clsid, REFIID riid, void **out)
+{
+    unsigned int i;
+
+    TRACE("clsid %s, riid %s, out %p.\n", debugstr_guid(clsid), debugstr_guid(riid), out);
+
+    for (i = 0; i < ARRAY_SIZE(factories); ++i)
+    {
+        if (IsEqualGUID(clsid, factories[i].clsid))
+            return IClassFactory_QueryInterface(&factories[i].IClassFactory_iface, riid, out);
+    }
+
+    FIXME("Class %s is not implemented.\n", debugstr_guid(clsid));
+    *out = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
