+
+    TRACE("iface %p, m11 %p, m12 %p, m21 %p, m22 %p, dx %p, dy %p.\n", iface, m11, m12, m21, m22, dx, dy);
+
+    if (!m11 || !m12 || !m21 || !m22 || !dx || !dy) return E_POINTER;
+    *m11 = transform->xform.eM11;
+    *m12 = transform->xform.eM12;
+    *m21 = transform->xform.eM21;
+    *m22 = transform->xform.eM22;
+    *dx = transform->xform.eDx;
