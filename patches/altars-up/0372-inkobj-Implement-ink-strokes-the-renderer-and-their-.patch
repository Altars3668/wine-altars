+#include "inkobj_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(inkobj);
+
+struct extended_property
+{
+    IInkExtendedProperty IInkExtendedProperty_iface;
+    LONG refcount;
+    GUID guid;
+    VARIANT data;
+};
+
+static inline struct extended_property *impl_from_IInkExtendedProperty(IInkExtendedProperty *iface)
+{
+    return CONTAINING_RECORD(iface, struct extended_property, IInkExtendedProperty_iface);
+}
+
+static HRESULT WINAPI extended_property_QueryInterface(IInkExtendedProperty *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IInkExtendedProperty) || IsEqualGUID(riid, &IID_IDispatch)
+            || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IInkExtendedProperty_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI extended_property_AddRef(IInkExtendedProperty *iface)
+{
+    struct extended_property *property = impl_from_IInkExtendedProperty(iface);
+    ULONG refcount = InterlockedIncrement(&property->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI extended_property_Release(IInkExtendedProperty *iface)
+{
+    struct extended_property *property = impl_from_IInkExtendedProperty(iface);
+    ULONG refcount = InterlockedDecrement(&property->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        VariantClear(&property->data);
+        free(property);
+    }
+    return refcount;
+}
+
+DEFINE_DISPATCH_METHODS(extended_property, IInkExtendedProperty, IInkExtendedProperty_tid)
+
+static HRESULT WINAPI extended_property_get_Guid(IInkExtendedProperty *iface, BSTR *guid)
+{
+    struct extended_property *property = impl_from_IInkExtendedProperty(iface);
+    WCHAR buffer[39];
+
+    TRACE("iface %p, guid %p.\n", iface, guid);
+
+    if (!guid) return E_POINTER;
+    StringFromGUID2(&property->guid, buffer, ARRAY_SIZE(buffer));
+    if (!(*guid = SysAllocString(buffer))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT WINAPI extended_property_get_Data(IInkExtendedProperty *iface, VARIANT *data)
+{
+    TRACE("iface %p, data %p.\n", iface, data);
+
+    if (!data) return E_POINTER;
+    VariantInit(data);
+    return VariantCopy(data, &impl_from_IInkExtendedProperty(iface)->data);
+}
+
+static HRESULT WINAPI extended_property_put_Data(IInkExtendedProperty *iface, VARIANT data)
+{
+    struct extended_property *property = impl_from_IInkExtendedProperty(iface);
+    VARIANT copy;
+    HRESULT hr;
+
+    TRACE("iface %p, data %s.\n", iface, debugstr_variant(&data));
+
+    VariantInit(&copy);
+    if (FAILED(hr = VariantCopy(&copy, &data)))
+        return hr;
+    VariantClear(&property->data);
+    property->data = copy;
+    return S_OK;
+}
+
+static const IInkExtendedPropertyVtbl extended_property_vtbl =
+{
+    extended_property_QueryInterface,
+    extended_property_AddRef,
+    extended_property_Release,
+    extended_property_GetTypeInfoCount,
+    extended_property_GetTypeInfo,
+    extended_property_GetIDsOfNames,
+    extended_property_Invoke,
+    extended_property_get_Guid,
+    extended_property_get_Data,
+    extended_property_put_Data,
+};
+
+static HRESULT extended_property_create(const GUID *guid, const VARIANT *data, struct extended_property **out)
+{
+    struct extended_property *property;
+    HRESULT hr;
+
+    if (!(property = calloc(1, sizeof(*property))))
+        return E_OUTOFMEMORY;
+
+    property->IInkExtendedProperty_iface.lpVtbl = &extended_property_vtbl;
+    property->refcount = 1;
+    property->guid = *guid;
+    VariantInit(&property->data);
+    if (FAILED(hr = VariantCopy(&property->data, data)))
+    {
+        free(property);
+        return hr;
+    }
+
+    *out = property;
+    return S_OK;
+}
+
+struct extended_properties
+{
+    IInkExtendedProperties IInkExtendedProperties_iface;
+    LONG refcount;
+    struct extended_property **items;
+    unsigned int count;
+    unsigned int capacity;
+};
+
+static const IInkExtendedPropertiesVtbl extended_properties_vtbl;
+
+static inline struct extended_properties *impl_from_IInkExtendedProperties(IInkExtendedProperties *iface)
+{
+    return CONTAINING_RECORD(iface, struct extended_properties, IInkExtendedProperties_iface);
+}
+
+static HRESULT WINAPI extended_properties_QueryInterface(IInkExtendedProperties *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IInkExtendedProperties) || IsEqualGUID(riid, &IID_IDispatch)
+            || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IInkExtendedProperties_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI extended_properties_AddRef(IInkExtendedProperties *iface)
+{
+    struct extended_properties *properties = impl_from_IInkExtendedProperties(iface);
+    ULONG refcount = InterlockedIncrement(&properties->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static void extended_properties_clear(struct extended_properties *properties)
+{
+    unsigned int i;
+
+    for (i = 0; i < properties->count; ++i)
+        IInkExtendedProperty_Release(&properties->items[i]->IInkExtendedProperty_iface);
+    properties->count = 0;
+}
+
+static ULONG WINAPI extended_properties_Release(IInkExtendedProperties *iface)
+{
+    struct extended_properties *properties = impl_from_IInkExtendedProperties(iface);
+    ULONG refcount = InterlockedDecrement(&properties->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        extended_properties_clear(properties);
+        free(properties->items);
+        free(properties);
+    }
+    return refcount;
+}
+
+DEFINE_DISPATCH_METHODS(extended_properties, IInkExtendedProperties, IInkExtendedProperties_tid)
+
+static HRESULT WINAPI extended_properties_get_Count(IInkExtendedProperties *iface, LONG *count)
+{
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count) return E_POINTER;
+    *count = impl_from_IInkExtendedProperties(iface)->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI extended_properties_get__NewEnum(IInkExtendedProperties *iface, IUnknown **out)
+{
+    struct extended_properties *properties = impl_from_IInkExtendedProperties(iface);
+    IDispatch **items;
+    unsigned int i;
+    HRESULT hr;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out) return E_POINTER;
+    if (!(items = malloc(properties->count * sizeof(*items) + 1)))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < properties->count; ++i)
+        items[i] = (IDispatch *)&properties->items[i]->IInkExtendedProperty_iface;
+    hr = variant_enum_create(items, properties->count, (IEnumVARIANT **)out);
+    free(items);
+    return hr;
+}
+
+/* a property is named by its index or by its GUID */
+static int extended_properties_find(struct extended_properties *properties, const VARIANT *identifier)
+{
+    VARIANT index;
+    unsigned int i;
+    GUID guid;
+
+    if (V_VT(identifier) == VT_BSTR)
+    {
+        if (FAILED(IIDFromString(V_BSTR(identifier), &guid)))
+            return -1;
+        for (i = 0; i < properties->count; ++i)
+            if (IsEqualGUID(&properties->items[i]->guid, &guid)) return i;
+        return -1;
+    }
+
+    VariantInit(&index);
+    if (FAILED(VariantChangeType(&index, identifier, 0, VT_I4)))
+        return -1;
+    if (V_I4(&index) < 0 || V_I4(&index) >= properties->count)
+        return -1;
+    return V_I4(&index);
+}
+
+static HRESULT WINAPI extended_properties_Item(IInkExtendedProperties *iface, VARIANT identifier,
+        IInkExtendedProperty **out)
+{
+    struct extended_properties *properties = impl_from_IInkExtendedProperties(iface);
+    int index;
+
+    TRACE("iface %p, identifier %s, out %p.\n", iface, debugstr_variant(&identifier), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if ((index = extended_properties_find(properties, &identifier)) < 0)
+        return E_INVALIDARG;
+
+    *out = &properties->items[index]->IInkExtendedProperty_iface;
+    IInkExtendedProperty_AddRef(*out);
+    return S_OK;
+}
+
+static HRESULT extended_properties_set(struct extended_properties *properties, const GUID *guid,
+        const VARIANT *data, IInkExtendedProperty **out)
+{
+    struct extended_property *property;
+    unsigned int i;
+    HRESULT hr;
+
+    /* a property that is there takes the new data */
+    for (i = 0; i < properties->count; ++i)
+    {
+        if (!IsEqualGUID(&properties->items[i]->guid, guid)) continue;
+        if (FAILED(hr = extended_property_put_Data(&properties->items[i]->IInkExtendedProperty_iface, *data)))
+            return hr;
+        if (out)
+        {
+            *out = &properties->items[i]->IInkExtendedProperty_iface;
+            IInkExtendedProperty_AddRef(*out);
+        }
+        return S_OK;
+    }
+
+    if (properties->count == properties->capacity)
+    {
+        unsigned int capacity = max(4, properties->capacity * 2);
+        struct extended_property **items;
+
+        if (!(items = realloc(properties->items, capacity * sizeof(*items))))
+            return E_OUTOFMEMORY;
+        properties->items = items;
+        properties->capacity = capacity;
+    }
+
+    if (FAILED(hr = extended_property_create(guid, data, &property)))
+        return hr;
+    properties->items[properties->count++] = property;
+    if (out)
+    {
+        *out = &property->IInkExtendedProperty_iface;
+        IInkExtendedProperty_AddRef(*out);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI extended_properties_Add(IInkExtendedProperties *iface, BSTR guid_str, VARIANT data,
+        IInkExtendedProperty **out)
+{
+    struct extended_properties *properties = impl_from_IInkExtendedProperties(iface);
+    GUID guid;
+
+    TRACE("iface %p, guid %s, data %s, out %p.\n", iface, debugstr_w(guid_str), debugstr_variant(&data), out);
+
+    if (out) *out = NULL;
+    if (!guid_str || FAILED(IIDFromString(guid_str, &guid)))
+        return E_INVALIDARG;
+    return extended_properties_set(properties, &guid, &data, out);
+}
+
+static HRESULT WINAPI extended_properties_Remove(IInkExtendedProperties *iface, VARIANT identifier)
+{
+    struct extended_properties *properties = impl_from_IInkExtendedProperties(iface);
+    int index;
+
+    TRACE("iface %p, identifier %s.\n", iface, debugstr_variant(&identifier));
+
+    if ((index = extended_properties_find(properties, &identifier)) < 0)
+        return E_INVALIDARG;
+
+    IInkExtendedProperty_Release(&properties->items[index]->IInkExtendedProperty_iface);
+    memmove(properties->items + index, properties->items + index + 1,
+            (properties->count - index - 1) * sizeof(*properties->items));
+    properties->count--;
+    return S_OK;
+}
+
+static HRESULT WINAPI extended_properties_Clear(IInkExtendedProperties *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    extended_properties_clear(impl_from_IInkExtendedProperties(iface));
+    return S_OK;
+}
+
+static HRESULT WINAPI extended_properties_DoesPropertyExist(IInkExtendedProperties *iface, BSTR guid_str,
+        VARIANT_BOOL *exists)
+{
+    struct extended_properties *properties = impl_from_IInkExtendedProperties(iface);
+    unsigned int i;
+    GUID guid;
+
+    TRACE("iface %p, guid %s, exists %p.\n", iface, debugstr_w(guid_str), exists);
+
+    if (!exists) return E_POINTER;
+    *exists = VARIANT_FALSE;
+    if (!guid_str || FAILED(IIDFromString(guid_str, &guid)))
+        return E_INVALIDARG;
+    for (i = 0; i < properties->count; ++i)
+        if (IsEqualGUID(&properties->items[i]->guid, &guid)) *exists = VARIANT_TRUE;
+    return S_OK;
+}
+
+static const IInkExtendedPropertiesVtbl extended_properties_vtbl =
+{
+    extended_properties_QueryInterface,
+    extended_properties_AddRef,
+    extended_properties_Release,
+    extended_properties_GetTypeInfoCount,
+    extended_properties_GetTypeInfo,
+    extended_properties_GetIDsOfNames,
+    extended_properties_Invoke,
+    extended_properties_get_Count,
+    extended_properties_get__NewEnum,
+    extended_properties_Item,
+    extended_properties_Add,
+    extended_properties_Remove,
+    extended_properties_Clear,
+    extended_properties_DoesPropertyExist,
+};
+
+HRESULT extended_properties_create(IInkExtendedProperties **out)
+{
+    struct extended_properties *properties;
+
+    if (!(properties = calloc(1, sizeof(*properties))))
+        return E_OUTOFMEMORY;
+
+    properties->IInkExtendedProperties_iface.lpVtbl = &extended_properties_vtbl;
+    properties->refcount = 1;
+
+    *out = &properties->IInkExtendedProperties_iface;
+    return S_OK;
+}
+
+/* copies the properties of any implementation into one of these */
+HRESULT extended_properties_copy(IInkExtendedProperties *dst_iface, IInkExtendedProperties *src)
+{
+    struct extended_properties *dst = impl_from_IInkExtendedProperties(dst_iface);
+    IInkExtendedProperty *property;
+    LONG count, i;
+    VARIANT index, data;
+    BSTR guid_str;
+    HRESULT hr;
+    GUID guid;
+
+    if (FAILED(hr = IInkExtendedProperties_get_Count(src, &count)))
+        return hr;
+    for (i = 0; i < count; ++i)
+    {
+        V_VT(&index) = VT_I4;
+        V_I4(&index) = i;
+        if (FAILED(hr = IInkExtendedProperties_Item(src, index, &property)))
+            return hr;
+        hr = IInkExtendedProperty_get_Guid(property, &guid_str);
+        if (SUCCEEDED(hr))
+        {
+            hr = IIDFromString(guid_str, &guid);
+            SysFreeString(guid_str);
+        }
+        if (SUCCEEDED(hr) && SUCCEEDED(hr = IInkExtendedProperty_get_Data(property, &data)))
+        {
+            hr = extended_properties_set(dst, &guid, &data, NULL);
+            VariantClear(&data);
+        }
+        IInkExtendedProperty_Release(property);
+        if (FAILED(hr))
+            return hr;
+    }
+    return S_OK;
+}
+
+static const IInkDrawingAttributesVtbl drawing_attributes_vtbl;
+
+static inline struct drawing_attributes *impl_from_IInkDrawingAttributes(IInkDrawingAttributes *iface)
+{
+    return CONTAINING_RECORD(iface, struct drawing_attributes, IInkDrawingAttributes_iface);
+}
+
+struct drawing_attributes *unsafe_impl_from_IInkDrawingAttributes(IInkDrawingAttributes *iface)
+{
+    if (!iface || iface->lpVtbl != &drawing_attributes_vtbl)
+        return NULL;
+    return impl_from_IInkDrawingAttributes(iface);
+}
+
+static HRESULT WINAPI drawing_attributes_QueryInterface(IInkDrawingAttributes *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IInkDrawingAttributes) || IsEqualGUID(riid, &IID_IDispatch)
+            || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IInkDrawingAttributes_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI drawing_attributes_AddRef(IInkDrawingAttributes *iface)
+{
+    struct drawing_attributes *attributes = impl_from_IInkDrawingAttributes(iface);
+    ULONG refcount = InterlockedIncrement(&attributes->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI drawing_attributes_Release(IInkDrawingAttributes *iface)
+{
+    struct drawing_attributes *attributes = impl_from_IInkDrawingAttributes(iface);
+    ULONG refcount = InterlockedDecrement(&attributes->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        IInkExtendedProperties_Release(attributes->properties);
+        free(attributes);
+    }
+    return refcount;
+}
+
+DEFINE_DISPATCH_METHODS(drawing_attributes, IInkDrawingAttributes, IInkDrawingAttributes_tid)
+
+static HRESULT WINAPI drawing_attributes_get_Color(IInkDrawingAttributes *iface, LONG *color)
+{
+    TRACE("iface %p, color %p.\n", iface, color);
+
+    if (!color) return E_POINTER;
+    *color = impl_from_IInkDrawingAttributes(iface)->color;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_put_Color(IInkDrawingAttributes *iface, LONG color)
+{
+    TRACE("iface %p, color %#lx.\n", iface, color);
+
+    impl_from_IInkDrawingAttributes(iface)->color = color;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_get_Width(IInkDrawingAttributes *iface, float *width)
+{
+    TRACE("iface %p, width %p.\n", iface, width);
+
+    if (!width) return E_POINTER;
+    *width = impl_from_IInkDrawingAttributes(iface)->width;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_put_Width(IInkDrawingAttributes *iface, float width)
+{
+    TRACE("iface %p, width %.8e.\n", iface, width);
+
+    if (!(width >= 0.0f)) return E_INVALIDARG;
+    impl_from_IInkDrawingAttributes(iface)->width = width;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_get_Height(IInkDrawingAttributes *iface, float *height)
+{
+    TRACE("iface %p, height %p.\n", iface, height);
+
+    if (!height) return E_POINTER;
+    *height = impl_from_IInkDrawingAttributes(iface)->height;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_put_Height(IInkDrawingAttributes *iface, float height)
+{
+    TRACE("iface %p, height %.8e.\n", iface, height);
+
+    if (!(height >= 0.0f)) return E_INVALIDARG;
+    impl_from_IInkDrawingAttributes(iface)->height = height;
+    return S_OK;
+}
+
+#define DEFINE_FLAG(name, field) \
+    static HRESULT WINAPI drawing_attributes_get_##name(IInkDrawingAttributes *iface, VARIANT_BOOL *flag) \
+    { \
+        TRACE("iface %p, flag %p.\n", iface, flag); \
+        if (!flag) return E_POINTER; \
+        *flag = impl_from_IInkDrawingAttributes(iface)->field; \
+        return S_OK; \
+    } \
+    static HRESULT WINAPI drawing_attributes_put_##name(IInkDrawingAttributes *iface, VARIANT_BOOL flag) \
+    { \
+        TRACE("iface %p, flag %#x.\n", iface, flag); \
+        impl_from_IInkDrawingAttributes(iface)->field = flag ? VARIANT_TRUE : VARIANT_FALSE; \
+        return S_OK; \
+    }
+
+DEFINE_FLAG(FitToCurve, fit_to_curve)
+DEFINE_FLAG(IgnorePressure, ignore_pressure)
+DEFINE_FLAG(AntiAliased, antialiased)
+
+static HRESULT WINAPI drawing_attributes_get_Transparency(IInkDrawingAttributes *iface, LONG *transparency)
+{
+    TRACE("iface %p, transparency %p.\n", iface, transparency);
+
+    if (!transparency) return E_POINTER;
+    *transparency = impl_from_IInkDrawingAttributes(iface)->transparency;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_put_Transparency(IInkDrawingAttributes *iface, LONG transparency)
+{
+    TRACE("iface %p, transparency %ld.\n", iface, transparency);
+
+    if (transparency < 0 || transparency > 255) return E_INVALIDARG;
+    impl_from_IInkDrawingAttributes(iface)->transparency = transparency;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_get_RasterOperation(IInkDrawingAttributes *iface, InkRasterOperation *op)
+{
+    TRACE("iface %p, op %p.\n", iface, op);
+
+    if (!op) return E_POINTER;
+    *op = impl_from_IInkDrawingAttributes(iface)->raster_operation;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_put_RasterOperation(IInkDrawingAttributes *iface, InkRasterOperation op)
+{
+    TRACE("iface %p, op %d.\n", iface, op);
+
+    if (op < IRO_Black || op > IRO_White) return E_INVALIDARG;
+    impl_from_IInkDrawingAttributes(iface)->raster_operation = op;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_get_PenTip(IInkDrawingAttributes *iface, InkPenTip *tip)
+{
+    TRACE("iface %p, tip %p.\n", iface, tip);
+
+    if (!tip) return E_POINTER;
+    *tip = impl_from_IInkDrawingAttributes(iface)->pen_tip;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_put_PenTip(IInkDrawingAttributes *iface, InkPenTip tip)
+{
+    TRACE("iface %p, tip %d.\n", iface, tip);
+
+    if (tip != IPT_Ball && tip != IPT_Rectangle) return E_INVALIDARG;
+    impl_from_IInkDrawingAttributes(iface)->pen_tip = tip;
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_get_ExtendedProperties(IInkDrawingAttributes *iface,
+        IInkExtendedProperties **properties)
+{
+    TRACE("iface %p, properties %p.\n", iface, properties);
+
+    if (!properties) return E_POINTER;
+    *properties = impl_from_IInkDrawingAttributes(iface)->properties;
+    IInkExtendedProperties_AddRef(*properties);
+    return S_OK;
+}
+
+static HRESULT WINAPI drawing_attributes_Clone(IInkDrawingAttributes *iface, IInkDrawingAttributes **out)
+{
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out) return E_POINTER;
+    return drawing_attributes_clone(iface, out);
+}
+
+static const IInkDrawingAttributesVtbl drawing_attributes_vtbl =
+{
+    drawing_attributes_QueryInterface,
+    drawing_attributes_AddRef,
+    drawing_attributes_Release,
+    drawing_attributes_GetTypeInfoCount,
+    drawing_attributes_GetTypeInfo,
+    drawing_attributes_GetIDsOfNames,
+    drawing_attributes_Invoke,
+    drawing_attributes_get_Color,
+    drawing_attributes_put_Color,
+    drawing_attributes_get_Width,
+    drawing_attributes_put_Width,
+    drawing_attributes_get_Height,
+    drawing_attributes_put_Height,
+    drawing_attributes_get_FitToCurve,
+    drawing_attributes_put_FitToCurve,
+    drawing_attributes_get_IgnorePressure,
+    drawing_attributes_put_IgnorePressure,
+    drawing_attributes_get_AntiAliased,
+    drawing_attributes_put_AntiAliased,
+    drawing_attributes_get_Transparency,
+    drawing_attributes_put_Transparency,
+    drawing_attributes_get_RasterOperation,
+    drawing_attributes_put_RasterOperation,
+    drawing_attributes_get_PenTip,
+    drawing_attributes_put_PenTip,
+    drawing_attributes_get_ExtendedProperties,
+    drawing_attributes_Clone,
+};
+
+/* the Tablet PC defaults: a black ball pen 53 HIMETRIC wide, antialiased and opaque */
+HRESULT drawing_attributes_create(IInkDrawingAttributes **out)
+{
+    struct drawing_attributes *attributes;
+    HRESULT hr;
+
+    if (!(attributes = calloc(1, sizeof(*attributes))))
+        return E_OUTOFMEMORY;
+
+    attributes->IInkDrawingAttributes_iface.lpVtbl = &drawing_attributes_vtbl;
+    attributes->refcount = 1;
+    attributes->color = RGB(0, 0, 0);
+    attributes->width = 53.0f;
+    attributes->height = 1.0f;
+    attributes->fit_to_curve = VARIANT_FALSE;
+    attributes->ignore_pressure = VARIANT_FALSE;
+    attributes->antialiased = VARIANT_TRUE;
+    attributes->transparency = 0;
+    attributes->raster_operation = IRO_CopyPen;
+    attributes->pen_tip = IPT_Ball;
+    if (FAILED(hr = extended_properties_create(&attributes->properties)))
+    {
+        free(attributes);
+        return hr;
+    }
+
+    *out = &attributes->IInkDrawingAttributes_iface;
+    return S_OK;
+}
+
+/* copies any implementation's attributes into a new object of ours */
+HRESULT drawing_attributes_clone(IInkDrawingAttributes *src, IInkDrawingAttributes **out)
+{
+    struct drawing_attributes *attributes, *impl;
+    IInkExtendedProperties *properties;
+    IInkDrawingAttributes *iface;
+    HRESULT hr;
+
+    if (FAILED(hr = drawing_attributes_create(&iface)))
+        return hr;
+    attributes = impl_from_IInkDrawingAttributes(iface);
+
+    if ((impl = unsafe_impl_from_IInkDrawingAttributes(src)))
+    {
+        attributes->color = impl->color;
+        attributes->width = impl->width;
+        attributes->height = impl->height;
+        attributes->fit_to_curve = impl->fit_to_curve;
+        attributes->ignore_pressure = impl->ignore_pressure;
+        attributes->antialiased = impl->antialiased;
+        attributes->transparency = impl->transparency;
+        attributes->raster_operation = impl->raster_operation;
+        attributes->pen_tip = impl->pen_tip;
+        hr = extended_properties_copy(attributes->properties, impl->properties);
+    }
+    else
+    {
+        IInkDrawingAttributes_get_Color(src, &attributes->color);
+        IInkDrawingAttributes_get_Width(src, &attributes->width);
+        IInkDrawingAttributes_get_Height(src, &attributes->height);
+        IInkDrawingAttributes_get_FitToCurve(src, &attributes->fit_to_curve);
+        IInkDrawingAttributes_get_IgnorePressure(src, &attributes->ignore_pressure);
+        IInkDrawingAttributes_get_AntiAliased(src, &attributes->antialiased);
+        IInkDrawingAttributes_get_Transparency(src, &attributes->transparency);
+        IInkDrawingAttributes_get_RasterOperation(src, &attributes->raster_operation);
+        IInkDrawingAttributes_get_PenTip(src, &attributes->pen_tip);
+        if (SUCCEEDED(hr = IInkDrawingAttributes_get_ExtendedProperties(src, &properties)))
+        {
+            hr = extended_properties_copy(attributes->properties, properties);
+            IInkExtendedProperties_Release(properties);
+        }
+    }
+
+    if (FAILED(hr))
+    {
+        IInkDrawingAttributes_Release(iface);
+        return hr;
+    }
+    *out = iface;
+    return S_OK;
+}
