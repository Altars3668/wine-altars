+static HRESULT WINAPI stroke_Transform(IInkStrokeDisp *iface, IInkTransform *transform, VARIANT_BOOL apply_on_pen_width)
+{
+    XFORM xform;
+    HRESULT hr;
+
+    TRACE("iface %p, transform %p, apply_on_pen_width %#x.\n", iface, transform, apply_on_pen_width);
+
+    if (FAILED(hr = transform_get(transform, &xform))) return hr;
+    return stroke_transform(iface, &xform, !!apply_on_pen_width);
+}
+
+/* the points' bounds are scaled onto the rectangle */
+static HRESULT scale_to_rectangle(const RECT *bounds, const RECT *target, XFORM *xform)
+{
+    float sx = bounds->right > bounds->left ? (float)(target->right - target->left) / (bounds->right - bounds->left) : 1.0f;
+    float sy = bounds->bottom > bounds->top ? (float)(target->bottom - target->top) / (bounds->bottom - bounds->top) : 1.0f;
+
+    xform_identity(xform);
+    xform_translate(xform, -bounds->left, -bounds->top);
+    xform_scale_by(xform, sx, sy);
+    xform_translate(xform, target->left, target->top);
+    return S_OK;
+}
+
+static HRESULT WINAPI stroke_ScaleToRectangle(IInkStrokeDisp *iface, IInkRectangle *rectangle)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    RECT target, bounds;
+    XFORM xform;
+    HRESULT hr;
+
+    TRACE("iface %p, rectangle %p.\n", iface, rectangle);
+
+    if (FAILED(hr = rectangle_get(rectangle, &target))) return hr;
+    if (FAILED(hr = stroke_lock(stroke))) return hr;
+    stroke_data_bounds(stroke->data, NULL, IBBM_PointsOnly, NULL, FALSE, &bounds);
+    scale_to_rectangle(&bounds, &target, &xform);
+    stroke_data_transform(stroke->data, &xform, FALSE);
+    stroke_unlock(stroke, TRUE);
+    return S_OK;
+}
+
+static HRESULT WINAPI stroke_Move(IInkStrokeDisp *iface, float dx, float dy)
+{
+    XFORM xform;
+
+    TRACE("iface %p, dx %.8e, dy %.8e.\n", iface, dx, dy);
+
+    xform_identity(&xform);
+    xform_translate(&xform, dx, dy);
+    return stroke_transform(iface, &xform, FALSE);
+}
+
+static HRESULT WINAPI stroke_Rotate(IInkStrokeDisp *iface, float degrees, float x, float y)
+{
