+}
+
+static HRESULT WINAPI ink_ClipboardCopy(IInkDisp *iface, IInkStrokes *strokes, InkClipboardFormats formats,
+        InkClipboardModes modes, IDataObject **data)
+{
+    FIXME("iface %p, strokes %p, formats %#x, modes %#x, data %p, not implemented.\n", iface, strokes,
+            formats, modes, data);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_CanPaste(IInkDisp *iface, IDataObject *data, VARIANT_BOOL *can_paste)
+{
+    FIXME("iface %p, data %p, can_paste %p, not implemented.\n", iface, data, can_paste);
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ink_ClipboardPaste(IInkDisp *iface, LONG x, LONG y, IDataObject *data, IInkStrokes **strokes)
+{
+    FIXME("iface %p, x %ld, y %ld, data %p, strokes %p, not implemented.\n", iface, x, y, data, strokes);
+    return E_NOTIMPL;
+}
+
+static const IInkDispVtbl ink_vtbl =
+{
+    ink_QueryInterface,
+    ink_AddRef,
+    ink_Release,
+    ink_GetTypeInfoCount,
+    ink_GetTypeInfo,
+    ink_GetIDsOfNames,
+    ink_Invoke,
+    ink_get_Strokes,
+    ink_get_ExtendedProperties,
+    ink_get_Dirty,
+    ink_put_Dirty,
+    ink_get_CustomStrokes,
+    ink_GetBoundingBox,
+    ink_DeleteStrokes,
+    ink_DeleteStroke,
+    ink_ExtractStrokes,
+    ink_ExtractWithRectangle,
+    ink_Clip,
+    ink_Clone,
+    ink_HitTestCircle,
+    ink_HitTestWithRectangle,
+    ink_HitTestWithLasso,
+    ink_NearestPoint,
+    ink_CreateStrokes,
+    ink_AddStrokesAtRectangle,
+    ink_Save,
+    ink_Load,
+    ink_CreateStroke,
+    ink_ClipboardCopyWithRectangle,
+    ink_ClipboardCopy,
+    ink_CanPaste,
+    ink_ClipboardPaste,
+};
+
+HRESULT ink_create(IInkDisp **out)
+{
+    struct ink *ink;
+    HRESULT hr;
+
+    if (!(ink = calloc(1, sizeof(*ink))))
+        return E_OUTOFMEMORY;
+
+    ink->IInkDisp_iface.lpVtbl = &ink_vtbl;
+    ink->IInkCustomStrokes_iface.lpVtbl = &custom_strokes_vtbl;
+    ink->refcount = 1;
+    InitializeCriticalSectionEx(&ink->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    ink->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": ink.cs");
+    list_init(&ink->strokes);
+    ink->next_id = 1;
+    if (FAILED(hr = extended_properties_create(&ink->properties)))
+    {
+        DeleteCriticalSection(&ink->cs);
+        free(ink);
+        return hr;
+    }
+
+    *out = &ink->IInkDisp_iface;
+    return S_OK;
+}
