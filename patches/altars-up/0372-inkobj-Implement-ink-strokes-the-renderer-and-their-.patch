+static void test_renderer(void)
+{
+    static const LONG points[] = {2540, 2540, 5080, 2540};
+    IInkRenderer *renderer;
+    IInkStrokes *strokes;
+    IInkStrokeDisp *stroke;
+    VARIANT data, description;
+    IInkDisp *ink;
+    LONG x, y;
+    HBITMAP bitmap;
+    DWORD *bits;
+    HDC hdc;
+    HRESULT hr;
+    int dpi;
+
+    if (!(renderer = create(&CLSID_InkRenderer, &IID_IInkRenderer))) return;
+    if (!(ink = create(&CLSID_InkDisp, &IID_IInkDisp)))
+    {
+        IInkRenderer_Release(renderer);
+        return;
+    }
+
+    hdc = CreateCompatibleDC(NULL);
+    dpi = GetDeviceCaps(hdc, LOGPIXELSX);
+
+    x = dpi;
+    y = 2 * dpi;
+    hr = IInkRenderer_PixelToInkSpace(renderer, (LONG_PTR)hdc, &x, &y);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(x == 2540 && y == 5080, "Got %ld, %ld.\n", x, y);
+    hr = IInkRenderer_InkSpaceToPixel(renderer, (LONG_PTR)hdc, &x, &y);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(x == dpi && y == 2 * dpi, "Got %ld, %ld.\n", x, y);
+
+    data = long_array(points, ARRAY_SIZE(points));
+    V_VT(&description) = VT_EMPTY;
+    hr = IInkDisp_CreateStroke(ink, data, description, &stroke);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    VariantClear(&data);
+
+    {
+        BITMAPINFO info = {{sizeof(info.bmiHeader), 3 * dpi, -2 * dpi, 1, 32, BI_RGB}};
+
+        bitmap = CreateDIBSection(hdc, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0);
+        SelectObject(hdc, bitmap);
+        memset(bits, 0xff, 3 * dpi * 2 * dpi * 4);
+    }
+
+    hr = IInkDisp_get_Strokes(ink, &strokes);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkRenderer_Draw(renderer, (LONG_PTR)hdc, strokes);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    GdiFlush();
+    /* a black line from one inch to two, at one inch down */
+    ok((bits[dpi * 3 * dpi + 3 * dpi / 2] & 0xffffff) == 0, "Got %#lx.\n", bits[dpi * 3 * dpi + 3 * dpi / 2]);
+    ok((bits[dpi / 2 * 3 * dpi + 3 * dpi / 2] & 0xffffff) == 0xffffff, "Got %#lx.\n", bits[dpi / 2 * 3 * dpi + 3 * dpi / 2]);
+    ok((bits[dpi * 3 * dpi + dpi / 2] & 0xffffff) == 0xffffff, "Got %#lx.\n", bits[dpi * 3 * dpi + dpi / 2]);
+    IInkStrokes_Release(strokes);
+
+    DeleteDC(hdc);
+    DeleteObject(bitmap);
+    IInkStrokeDisp_Release(stroke);
+    IInkDisp_Release(ink);
+    IInkRenderer_Release(renderer);
+}
+
+START_TEST(inkobj)
+{
+    CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+
+    test_classes();
+    test_drawing_attributes();
+    test_transform();
+    test_rectangle();
+    test_ink();
+    test_renderer();
+
+    CoUninitialize();
+}
