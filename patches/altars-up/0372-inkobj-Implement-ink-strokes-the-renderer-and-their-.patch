+static HRESULT stroke_transform(IInkStrokeDisp *iface, const XFORM *xform, BOOL scale_width)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    HRESULT hr;
+
+    if (FAILED(hr = stroke_lock(stroke))) return hr;
+    stroke_data_transform(stroke->data, xform, scale_width);
+    stroke_unlock(stroke, TRUE);
+    return S_OK;
+}
