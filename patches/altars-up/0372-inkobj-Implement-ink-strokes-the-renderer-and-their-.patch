+/* the part from the split point on becomes a new stroke of the ink, the point interpolated */
+static HRESULT WINAPI stroke_Split(IInkStrokeDisp *iface, float at, IInkStrokeDisp **out)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    struct stroke_data *data = stroke->data, *tail;
+    unsigned int i, first, size = data->packet_size, n;
+    float t;
+    LONG *packets;
+    HRESULT hr;
+
+    TRACE("iface %p, at %.8e, out %p.\n", iface, at, out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (FAILED(hr = stroke_lock(stroke))) return hr;
+    if (!(at > 0.0f) || !(at < data->packet_count - 1.0f))
+    {
+        stroke_unlock(stroke, FALSE);
+        return E_INVALIDARG;
+    }
+
+    first = floorf(at);
+    t = at - first;
+    n = data->packet_count - first;
+    if (!(packets = malloc(n * size * sizeof(*packets))))
+    {
+        stroke_unlock(stroke, FALSE);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(packets, data->packets + first * size, n * size * sizeof(*packets));
+    for (i = 0; i < size; ++i)
+        packets[i] = lroundf(packets[i] + t * (data->packets[(first + 1) * size + i] - packets[i]));
+
+    if (SUCCEEDED(hr = stroke_data_create(size, data->description, n, packets, data->attributes, &tail)))
+    {
+        extended_properties_copy(tail->properties, data->properties);
+        /* this stroke ends at the split point */
+        if (t > 0.0f)
+        {
+            memcpy(data->packets + (first + 1) * size, packets, size * sizeof(*packets));
+            data->packet_count = first + 2;
+        }
+        else data->packet_count = first + 1;
+        hr = ink_add_stroke(stroke->ink, tail);
+    }
+    stroke_unlock(stroke, SUCCEEDED(hr));
+    free(packets);
+
+    if (SUCCEEDED(hr))
+    {
+        hr = stroke_create(stroke->ink, tail, out);
+        stroke_data_release(tail);
+    }
+    return hr;
+}
