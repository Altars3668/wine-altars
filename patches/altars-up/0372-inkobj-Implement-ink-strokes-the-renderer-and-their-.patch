+static HRESULT strokes_create(struct ink *ink, struct stroke_data **data, unsigned int count, IInkStrokes **out)
+{
+    struct strokes *strokes;
+    unsigned int i;
+
+    if (!(strokes = calloc(1, sizeof(*strokes))))
+        return E_OUTOFMEMORY;
+
+    strokes->IInkStrokes_iface.lpVtbl = &strokes_vtbl;
+    strokes->refcount = 1;
+    strokes->ink = ink;
+    IInkDisp_AddRef(&ink->IInkDisp_iface);
+    for (i = 0; i < count; ++i)
+    {
+        if (data[i]->deleted) continue;
+        if (FAILED(strokes_append(strokes, data[i])))
+        {
+            IInkStrokes_Release(&strokes->IInkStrokes_iface);
+            return E_OUTOFMEMORY;
+        }
+    }
+
+    *out = &strokes->IInkStrokes_iface;
+    return S_OK;
+}
