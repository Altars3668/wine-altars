+/* a polyline is its own Bezier curve: each segment's control points lie on it */
+static HRESULT WINAPI stroke_get_BezierPoints(IInkStrokeDisp *iface, VARIANT *points)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    struct stroke_data *data = stroke->data;
+    unsigned int i, n;
+    LONG *values;
+    HRESULT hr;
+
+    TRACE("iface %p, points %p.\n", iface, points);
+
+    if (!points) return E_POINTER;
+    if (FAILED(hr = stroke_lock(stroke))) return hr;
+
+    n = data->packet_count ? 3 * (data->packet_count - 1) + 1 : 0;
+    if (!(values = malloc(max(1, 2 * n) * sizeof(*values))))
+    {
+        stroke_unlock(stroke, FALSE);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < data->packet_count; ++i)
+    {
+        values[6 * i] = stroke_x(data, i);
+        values[6 * i + 1] = stroke_y(data, i);
+        if (i + 1 == data->packet_count) break;
+        values[6 * i + 2] = lroundf(stroke_x(data, i) + (stroke_x(data, i + 1) - stroke_x(data, i)) / 3.0f);
+        values[6 * i + 3] = lroundf(stroke_y(data, i) + (stroke_y(data, i + 1) - stroke_y(data, i)) / 3.0f);
+        values[6 * i + 4] = lroundf(stroke_x(data, i) + 2.0f * (stroke_x(data, i + 1) - stroke_x(data, i)) / 3.0f);
+        values[6 * i + 5] = lroundf(stroke_y(data, i) + 2.0f * (stroke_y(data, i + 1) - stroke_y(data, i)) / 3.0f);
+    }
+    stroke_unlock(stroke, FALSE);
+
+    hr = make_long_array(values, 2 * n, points);
+    free(values);
+    return hr;
+}
