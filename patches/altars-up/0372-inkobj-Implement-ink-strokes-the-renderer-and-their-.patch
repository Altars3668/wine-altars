+static void test_rectangle(void)
+{
+    IInkRectangle *rectangle;
+    LONG top, left, bottom, right;
+    RECT rect;
+    HRESULT hr;
+
+    if (!(rectangle = create(&CLSID_InkRectangle, &IID_IInkRectangle))) return;
+
+    hr = IInkRectangle_get_Data(rectangle, &rect);
+    ok(hr == S_OK && IsRectEmpty(&rect) && !rect.left && !rect.top, "Got hr %#lx, %s.\n", hr, wine_dbgstr_rect(&rect));
+    hr = IInkRectangle_SetRectangle(rectangle, 1, 2, 3, 4);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkRectangle_get_Data(rectangle, &rect);
+    ok(hr == S_OK && rect.top == 1 && rect.left == 2 && rect.bottom == 3 && rect.right == 4,
+            "Got hr %#lx, %s.\n", hr, wine_dbgstr_rect(&rect));
+    hr = IInkRectangle_GetRectangle(rectangle, &top, &left, &bottom, &right);
+    ok(hr == S_OK && top == 1 && left == 2 && bottom == 3 && right == 4, "Got hr %#lx, %ld %ld %ld %ld.\n",
+            hr, top, left, bottom, right);
+    hr = IInkRectangle_put_Right(rectangle, 10);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkRectangle_get_Right(rectangle, &right);
+    ok(hr == S_OK && right == 10, "Got hr %#lx, right %ld.\n", hr, right);
+
+    IInkRectangle_Release(rectangle);
+}
