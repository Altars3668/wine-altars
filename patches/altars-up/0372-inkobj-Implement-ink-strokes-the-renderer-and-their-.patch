+
+    if (!xform) return E_POINTER;
+    *xform = impl_from_IInkTransform(iface)->xform;
+    return S_OK;
+}
+
+static HRESULT WINAPI transform_put_Data(IInkTransform *iface, XFORM xform)
+{
+    TRACE("iface %p.\n", iface);
+
+    impl_from_IInkTransform(iface)->xform = xform;
+    return S_OK;
+}
+
+static const IInkTransformVtbl transform_vtbl =
+{
+    transform_QueryInterface,
+    transform_AddRef,
+    transform_Release,
+    transform_GetTypeInfoCount,
+    transform_GetTypeInfo,
+    transform_GetIDsOfNames,
+    transform_Invoke,
+    transform_Reset,
+    transform_Translate,
+    transform_Rotate,
+    transform_Reflect,
+    transform_Shear,
+    transform_ScaleTransform,
+    transform_GetTransform,
+    transform_SetTransform,
+    transform_get_eM11,
+    transform_put_eM11,
+    transform_get_eM12,
+    transform_put_eM12,
+    transform_get_eM21,
+    transform_put_eM21,
+    transform_get_eM22,
+    transform_put_eM22,
+    transform_get_eDx,
+    transform_put_eDx,
+    transform_get_eDy,
+    transform_put_eDy,
+    transform_get_Data,
+    transform_put_Data,
+};
+
+HRESULT transform_create(const XFORM *xform, IInkTransform **out)
+{
+    struct transform *transform;
+
+    if (!(transform = calloc(1, sizeof(*transform))))
+        return E_OUTOFMEMORY;
+
+    transform->IInkTransform_iface.lpVtbl = &transform_vtbl;
+    transform->refcount = 1;
+    transform->xform = *xform;
+
+    *out = &transform->IInkTransform_iface;
+    return S_OK;
+}
+
+HRESULT transform_get(IInkTransform *transform, XFORM *xform)
+{
+    if (!transform)
+        return E_INVALIDARG;
+    return IInkTransform_GetTransform(transform, &xform->eM11, &xform->eM12, &xform->eM21, &xform->eM22,
+            &xform->eDx, &xform->eDy);
+}
+
+HRESULT transform_set(IInkTransform *transform, const XFORM *xform)
+{
+    if (!transform)
+        return E_INVALIDARG;
+    return IInkTransform_SetTransform(transform, xform->eM11, xform->eM12, xform->eM21, xform->eM22,
+            xform->eDx, xform->eDy);
+}
