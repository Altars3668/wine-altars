+static void *create(const CLSID *clsid, const IID *iid)
+{
+    void *object = NULL;
+    HRESULT hr;
+
+    hr = CoCreateInstance(clsid, NULL, CLSCTX_INPROC_SERVER, iid, &object);
+    ok(hr == S_OK, "Failed to create %s, hr %#lx.\n", wine_dbgstr_guid(clsid), hr);
+    return object;
+}
+
+static VARIANT long_array(const LONG *values, unsigned int count)
+{
+    SAFEARRAY *array = SafeArrayCreateVector(VT_I4, 0, count);
+    LONG *data;
+    VARIANT v;
+
+    SafeArrayAccessData(array, (void **)&data);
+    memcpy(data, values, count * sizeof(*values));
+    SafeArrayUnaccessData(array);
+    V_VT(&v) = VT_ARRAY | VT_I4;
+    V_ARRAY(&v) = array;
+    return v;
+}
+
+static unsigned int read_longs(VARIANT *v, LONG *values, unsigned int max)
+{
+    LONG lower, upper, *data;
+    unsigned int n;
+
+    ok(V_VT(v) == (VT_ARRAY | VT_I4), "Got type %#x.\n", V_VT(v));
+    if (V_VT(v) != (VT_ARRAY | VT_I4)) return 0;
+    SafeArrayGetLBound(V_ARRAY(v), 1, &lower);
+    SafeArrayGetUBound(V_ARRAY(v), 1, &upper);
+    n = upper - lower + 1;
+    SafeArrayAccessData(V_ARRAY(v), (void **)&data);
+    memcpy(values, data, min(n, max) * sizeof(*values));
+    SafeArrayUnaccessData(V_ARRAY(v));
+    VariantClear(v);
+    return n;
+}
+
+static void test_classes(void)
+{
+    static const CLSID *classes[] =
+    {
+        &CLSID_InkDisp, &CLSID_InkRenderer, &CLSID_InkDrawingAttributes, &CLSID_InkTransform, &CLSID_InkRectangle,
+    };
+    unsigned int i, count;
+    IDispatch *dispatch;
+    ITypeInfo *info;
+    TYPEATTR *attr;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(classes); ++i)
+    {
+        if (!(dispatch = create(classes[i], &IID_IDispatch))) continue;
+        hr = IDispatch_GetTypeInfoCount(dispatch, &count);
+        ok(hr == S_OK && count == 1, "Got hr %#lx, count %u.\n", hr, count);
+        hr = IDispatch_GetTypeInfo(dispatch, 0, 0, &info);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        if (hr == S_OK)
+        {
+            ITypeInfo_GetTypeAttr(info, &attr);
+            ok(attr->typekind == TKIND_DISPATCH || attr->typekind == TKIND_INTERFACE, "Got kind %d.\n", attr->typekind);
+            ITypeInfo_ReleaseTypeAttr(info, attr);
+            ITypeInfo_Release(info);
+        }
+        IDispatch_Release(dispatch);
+    }
+}
+
+static void test_drawing_attributes(void)
+{
+    IInkDrawingAttributes *attributes, *clone;
+    IInkExtendedProperties *properties;
+    InkRasterOperation op;
+    VARIANT_BOOL flag;
+    InkPenTip tip;
+    float width;
+    LONG value;
+    HRESULT hr;
+
+    if (!(attributes = create(&CLSID_InkDrawingAttributes, &IID_IInkDrawingAttributes))) return;
+
+    hr = IInkDrawingAttributes_get_Color(attributes, &value);
+    ok(hr == S_OK && value == 0, "Got hr %#lx, color %#lx.\n", hr, value);
+    hr = IInkDrawingAttributes_get_Width(attributes, &width);
+    ok(hr == S_OK && width == 53.0f, "Got hr %#lx, width %f.\n", hr, width);
+    hr = IInkDrawingAttributes_get_Height(attributes, &width);
+    ok(hr == S_OK && width == 1.0f, "Got hr %#lx, height %f.\n", hr, width);
+    hr = IInkDrawingAttributes_get_FitToCurve(attributes, &flag);
+    ok(hr == S_OK && flag == VARIANT_FALSE, "Got hr %#lx, flag %#x.\n", hr, flag);
+    hr = IInkDrawingAttributes_get_IgnorePressure(attributes, &flag);
+    ok(hr == S_OK && flag == VARIANT_FALSE, "Got hr %#lx, flag %#x.\n", hr, flag);
+    hr = IInkDrawingAttributes_get_AntiAliased(attributes, &flag);
+    ok(hr == S_OK && flag == VARIANT_TRUE, "Got hr %#lx, flag %#x.\n", hr, flag);
+    hr = IInkDrawingAttributes_get_Transparency(attributes, &value);
+    ok(hr == S_OK && value == 0, "Got hr %#lx, transparency %ld.\n", hr, value);
+    hr = IInkDrawingAttributes_get_RasterOperation(attributes, &op);
+    ok(hr == S_OK && op == IRO_CopyPen, "Got hr %#lx, op %d.\n", hr, op);
+    hr = IInkDrawingAttributes_get_PenTip(attributes, &tip);
+    ok(hr == S_OK && tip == IPT_Ball, "Got hr %#lx, tip %d.\n", hr, tip);
+    hr = IInkDrawingAttributes_get_ExtendedProperties(attributes, &properties);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkExtendedProperties_get_Count(properties, &value);
+    ok(hr == S_OK && !value, "Got hr %#lx, count %ld.\n", hr, value);
+    IInkExtendedProperties_Release(properties);
+
+    hr = IInkDrawingAttributes_put_Color(attributes, RGB(255, 0, 0));
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkDrawingAttributes_put_Width(attributes, 200.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkDrawingAttributes_Clone(attributes, &clone);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(clone != attributes, "Got the same object.\n");
+    hr = IInkDrawingAttributes_get_Color(clone, &value);
+    ok(hr == S_OK && value == RGB(255, 0, 0), "Got hr %#lx, color %#lx.\n", hr, value);
+    hr = IInkDrawingAttributes_get_Width(clone, &width);
+    ok(hr == S_OK && width == 200.0f, "Got hr %#lx, width %f.\n", hr, width);
+    IInkDrawingAttributes_Release(clone);
+
+    IInkDrawingAttributes_Release(attributes);
+}
