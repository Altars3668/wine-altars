+
+static HRESULT stroke_create(struct ink *ink, struct stroke_data *data, IInkStrokeDisp **out)
+{
+    struct stroke *stroke;
+
+    if (!(stroke = calloc(1, sizeof(*stroke))))
+        return E_OUTOFMEMORY;
+
+    stroke->IInkStrokeDisp_iface.lpVtbl = &stroke_vtbl;
+    stroke->refcount = 1;
+    stroke->ink = ink;
+    IInkDisp_AddRef(&ink->IInkDisp_iface);
+    stroke->data = data;
+    stroke_data_addref(data);
+
+    *out = &stroke->IInkStrokeDisp_iface;
+    return S_OK;
+}
+
+struct strokes
+{
+    IInkStrokes IInkStrokes_iface;
+    LONG refcount;
+    struct ink *ink;
+    struct stroke_data **items;
+    unsigned int count;
+    unsigned int capacity;
+};
+
+static const IInkStrokesVtbl strokes_vtbl;
+
+static inline struct strokes *impl_from_IInkStrokes(IInkStrokes *iface)
+{
+    return CONTAINING_RECORD(iface, struct strokes, IInkStrokes_iface);
+}
+
+static struct strokes *unsafe_impl_from_IInkStrokes(IInkStrokes *iface)
+{
+    if (!iface || iface->lpVtbl != &strokes_vtbl)
+        return NULL;
+    return impl_from_IInkStrokes(iface);
+}
+
+void strokes_free_data(struct stroke_data **data, unsigned int count)
+{
+    unsigned int i;
+
+    if (!data) return;
+    for (i = 0; i < count; ++i)
+        stroke_data_release(data[i]);
+    free(data);
+}
+
+/* the strokes of any collection, each with a reference */
+HRESULT strokes_get_data(IInkStrokes *iface, struct stroke_data ***data, unsigned int *count)
+{
+    struct strokes *strokes = unsafe_impl_from_IInkStrokes(iface);
+    IInkStrokeDisp *stroke;
+    unsigned int i;
+    LONG n;
+    HRESULT hr;
+
+    *data = NULL;
+    *count = 0;
+    if (!iface)
+        return E_INVALIDARG;
+
+    if (strokes)
+    {
+        EnterCriticalSection(&strokes->ink->cs);
+        if ((*data = malloc(max(1, strokes->count) * sizeof(**data))))
+        {
+            for (i = 0; i < strokes->count; ++i)
+            {
+                stroke_data_addref(strokes->items[i]);
+                (*data)[i] = strokes->items[i];
+            }
+            *count = strokes->count;
+        }
+        LeaveCriticalSection(&strokes->ink->cs);
+        return *data ? S_OK : E_OUTOFMEMORY;
+    }
+
+    if (FAILED(hr = IInkStrokes_get_Count(iface, &n)))
+        return hr;
+    if (!(*data = malloc(max(1, n) * sizeof(**data))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < n; ++i)
+    {
+        struct stroke_data *stroke_data;
+
+        if (FAILED(hr = IInkStrokes_Item(iface, i, &stroke)))
+            break;
+        stroke_data = stroke_data_from_IInkStrokeDisp(stroke);
+        if (stroke_data) stroke_data_addref(stroke_data);
+        IInkStrokeDisp_Release(stroke);
+        if (!stroke_data)
+        {
+            hr = E_INVALIDARG;
+            break;
+        }
+        (*data)[(*count)++] = stroke_data;
+    }
+    if (FAILED(hr))
+    {
+        strokes_free_data(*data, *count);
+        *data = NULL;
+        *count = 0;
+    }
+    return hr;
+}
+
+static unsigned int strokes_find(struct strokes *strokes, struct stroke_data *data)
+{
+    unsigned int i;
+
+    for (i = 0; i < strokes->count; ++i)
+        if (strokes->items[i] == data) return i;
+    return ~0u;
+}
+
+static HRESULT strokes_append(struct strokes *strokes, struct stroke_data *data)
+{
+    if (strokes_find(strokes, data) != ~0u)
+        return S_OK;
+    if (strokes->count == strokes->capacity)
+    {
+        unsigned int capacity = max(8, strokes->capacity * 2);
+        struct stroke_data **items;
+
+        if (!(items = realloc(strokes->items, capacity * sizeof(*items))))
+            return E_OUTOFMEMORY;
+        strokes->items = items;
+        strokes->capacity = capacity;
+    }
+    stroke_data_addref(data);
+    strokes->items[strokes->count++] = data;
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_QueryInterface(IInkStrokes *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IInkStrokes) || IsEqualGUID(riid, &IID_IDispatch)
+            || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IInkStrokes_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI strokes_AddRef(IInkStrokes *iface)
+{
+    struct strokes *strokes = impl_from_IInkStrokes(iface);
+    ULONG refcount = InterlockedIncrement(&strokes->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI strokes_Release(IInkStrokes *iface)
+{
+    struct strokes *strokes = impl_from_IInkStrokes(iface);
+    ULONG refcount = InterlockedDecrement(&strokes->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        strokes_free_data(strokes->items, strokes->count);
+        IInkDisp_Release(&strokes->ink->IInkDisp_iface);
+        free(strokes);
+    }
+    return refcount;
+}
