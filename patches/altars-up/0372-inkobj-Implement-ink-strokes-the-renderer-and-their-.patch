+    ULONG refcount = InterlockedDecrement(&renderer->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+        free(renderer);
+    return refcount;
+}
+
+DEFINE_DISPATCH_METHODS(renderer, IInkRenderer, IInkRenderer_tid)
+
+static HRESULT WINAPI renderer_GetViewTransform(IInkRenderer *iface, IInkTransform *transform)
+{
+    TRACE("iface %p, transform %p.\n", iface, transform);
+
+    if (!transform) return E_POINTER;
+    return transform_set(transform, &impl_from_IInkRenderer(iface)->view);
+}
+
+/* no transform is the identity (not measured) */
+static HRESULT WINAPI renderer_SetViewTransform(IInkRenderer *iface, IInkTransform *transform)
+{
+    struct renderer *renderer = impl_from_IInkRenderer(iface);
+
+    TRACE("iface %p, transform %p.\n", iface, transform);
+
+    if (!transform)
+    {
+        xform_identity(&renderer->view);
+        return S_OK;
+    }
+    return transform_get(transform, &renderer->view);
+}
+
+static HRESULT WINAPI renderer_GetObjectTransform(IInkRenderer *iface, IInkTransform *transform)
+{
+    TRACE("iface %p, transform %p.\n", iface, transform);
+
+    if (!transform) return E_POINTER;
+    return transform_set(transform, &impl_from_IInkRenderer(iface)->object);
+}
+
+static HRESULT WINAPI renderer_SetObjectTransform(IInkRenderer *iface, IInkTransform *transform)
+{
+    struct renderer *renderer = impl_from_IInkRenderer(iface);
+
+    TRACE("iface %p, transform %p.\n", iface, transform);
+
+    if (!transform)
+    {
+        xform_identity(&renderer->object);
+        return S_OK;
+    }
+    return transform_get(transform, &renderer->object);
+}
+
+/* ink space goes through the object transform, then the view transform, then from HIMETRIC
+ * to the device's pixels */
+static void renderer_to_pixels(struct renderer *renderer, HDC hdc, XFORM *xform, float *width_scale)
+{
+    float dpi_x = GetDeviceCaps(hdc, LOGPIXELSX), dpi_y = GetDeviceCaps(hdc, LOGPIXELSY);
+    XFORM himetric = {dpi_x / HIMETRIC_PER_INCH, 0.0f, 0.0f, dpi_y / HIMETRIC_PER_INCH, 0.0f, 0.0f};
+
+    xform_multiply(xform, &renderer->object, &renderer->view);
+    xform_multiply(xform, xform, &himetric);
+    /* the object transform moves the points only; the view transform scales the pen too */
+    *width_scale = (renderer->scale_pen_width ? xform_scale(&renderer->view) : 1.0f) * xform_scale(&himetric);
+}
+
+static ARGB ink_argb(const struct drawing_attributes *attributes)
+{
+    LONG color = attributes->color;
+
+    return ((ARGB)(255 - attributes->transparency) << 24) | (GetRValue(color) << 16) | (GetGValue(color) << 8)
+            | GetBValue(color);
+}
+
+static void draw_points_gdiplus(HDC hdc, const struct drawing_attributes *attributes, const GpPointF *points,
+        unsigned int count, float width, float height)
+{
+    GpGraphics *graphics;
+    GpStatus status;
+    GpPen *pen;
+
+    if ((status = GdipCreateFromHDC(hdc, &graphics)))
+    {
+        ERR("Failed to create graphics for %p, status %d.\n", hdc, status);
+        return;
+    }
+    GdipSetSmoothingMode(graphics, attributes->antialiased ? SmoothingModeAntiAlias : SmoothingModeNone);
+    GdipSetPixelOffsetMode(graphics, PixelOffsetModeHalf);
+
+    if (count == 1)
+    {
+        GpSolidFill *brush;
+
+        GdipCreateSolidFill(ink_argb(attributes), &brush);
+        if (attributes->pen_tip == IPT_Ball)
+            GdipFillEllipse(graphics, (GpBrush *)brush, points[0].X - width / 2.0f, points[0].Y - width / 2.0f,
+                    width, width);
+        else
+            GdipFillRectangle(graphics, (GpBrush *)brush, points[0].X - width / 2.0f, points[0].Y - height / 2.0f,
+                    width, height);
+        GdipDeleteBrush((GpBrush *)brush);
+    }
+    else
+    {
+        GdipCreatePen1(ink_argb(attributes), width, UnitPixel, &pen);
+        if (attributes->pen_tip == IPT_Ball)
+        {
+            GdipSetPenLineCap197819(pen, LineCapRound, LineCapRound, DashCapRound);
+            GdipSetPenLineJoin(pen, LineJoinRound);
+        }
+        else
+        {
+            GdipSetPenLineCap197819(pen, LineCapSquare, LineCapSquare, DashCapFlat);
+            GdipSetPenLineJoin(pen, LineJoinMiter);
+        }
+        /* Windows fits Bezier curves of its own; a cardinal spline goes through the same points */
+        if (attributes->fit_to_curve && count > 2)
+            GdipDrawCurve2(graphics, pen, points, count, 0.5f);
+        else
+            GdipDrawLines(graphics, pen, points, count);
+        GdipDeletePen(pen);
+    }
+    GdipDeleteGraphics(graphics);
+}
+
+/* raster operations other than copying the pen are GDI's, and GDI does not smooth */
+static void draw_points_gdi(HDC hdc, const struct drawing_attributes *attributes, const GpPointF *points,
+        unsigned int count, float width)
+{
+    LOGBRUSH brush = {BS_SOLID, attributes->color & 0xffffff, 0};
+    int old_rop = SetROP2(hdc, attributes->raster_operation);
+    DWORD style = PS_GEOMETRIC | PS_SOLID;
+    HPEN pen, old_pen;
+    POINT *pts;
+    unsigned int i;
+
+    if (!(pts = malloc(max(2, count) * sizeof(*pts))))
+        return;
+    for (i = 0; i < count; ++i)
+    {
+        pts[i].x = lroundf(points[i].X);
+        pts[i].y = lroundf(points[i].Y);
+    }
+    if (count == 1) pts[count++] = pts[0];
+
+    style |= attributes->pen_tip == IPT_Ball ? PS_ENDCAP_ROUND | PS_JOIN_ROUND : PS_ENDCAP_SQUARE | PS_JOIN_MITER;
+    pen = ExtCreatePen(style, max(1, lroundf(width)), &brush, 0, NULL);
+    old_pen = SelectObject(hdc, pen);
+    Polyline(hdc, pts, count);
+    SelectObject(hdc, old_pen);
+    DeleteObject(pen);
+    SetROP2(hdc, old_rop);
+    free(pts);
+}
+
+static HRESULT draw_stroke(struct renderer *renderer, HDC hdc, const struct stroke_data *data,
+        IInkDrawingAttributes *attributes_iface)
+{
+    struct drawing_attributes *attributes;
+    IInkDrawingAttributes *copy = NULL;
+    float width, height, width_scale;
+    unsigned int i;
+    GpPointF *points;
+    XFORM xform;
+    HRESULT hr;
+
+    if (!data->packet_count)
+        return S_OK;
+    if (!attributes_iface)
+        attributes_iface = data->attributes;
+    if (!(attributes = unsafe_impl_from_IInkDrawingAttributes(attributes_iface)))
+    {
+        if (FAILED(hr = drawing_attributes_clone(attributes_iface, &copy)))
+            return hr;
+        attributes = unsafe_impl_from_IInkDrawingAttributes(copy);
+    }
+
+    if (!attributes->ignore_pressure && data->packet_size > 2)
+    {
+        for (i = 2; i < data->packet_size; ++i)
+            if (IsEqualGUID(&data->description[i], &GUID_PACKETPROPERTY_GUID_NORMAL_PRESSURE))
+            {
+                static int once;
+                if (!once++) FIXME("The pen's pressure does not change the width yet.\n");
+            }
+    }
+
+    renderer_to_pixels(renderer, hdc, &xform, &width_scale);
+    width = max(1.0f, attributes->width * width_scale);
+    height = attributes->pen_tip == IPT_Rectangle ? max(1.0f, attributes->height * width_scale) : width;
+
+    if (!(points = malloc(data->packet_count * sizeof(*points))))
+    {
+        if (copy) IInkDrawingAttributes_Release(copy);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < data->packet_count; ++i)
+    {
+        points[i].X = data->packets[i * data->packet_size];
+        points[i].Y = data->packets[i * data->packet_size + 1];
+        xform_apply(&xform, &points[i].X, &points[i].Y);
+    }
+
+    if (attributes->raster_operation == IRO_CopyPen)
+    {
+        InitOnceExecuteOnce(&gdiplus_once, start_gdiplus, NULL, NULL);
+        draw_points_gdiplus(hdc, attributes, points, data->packet_count, width, height);
+    }
+    else if (attributes->raster_operation != IRO_NoOperation)
+        draw_points_gdi(hdc, attributes, points, data->packet_count, width);
+
+    free(points);
+    if (copy) IInkDrawingAttributes_Release(copy);
+    return S_OK;
+}
+
+static HRESULT WINAPI renderer_Draw(IInkRenderer *iface, LONG_PTR hdc, IInkStrokes *strokes)
+{
+    struct renderer *renderer = impl_from_IInkRenderer(iface);
+    struct stroke_data **data;
+    unsigned int count, i;
+    HRESULT hr;
+
+    TRACE("iface %p, hdc %#Ix, strokes %p.\n", iface, hdc, strokes);
+
+    if (!hdc) return E_INVALIDARG;
+    if (!strokes) return S_OK;
+    if (FAILED(hr = strokes_get_data(strokes, &data, &count))) return hr;
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+        if (!data[i]->deleted) hr = draw_stroke(renderer, (HDC)hdc, data[i], NULL);
+    strokes_free_data(data, count);
+    return hr;
+}
+
+static HRESULT WINAPI renderer_DrawStroke(IInkRenderer *iface, LONG_PTR hdc, IInkStrokeDisp *stroke,
+        IInkDrawingAttributes *attributes)
+{
+    struct stroke_data *data;
+
+    TRACE("iface %p, hdc %#Ix, stroke %p, attributes %p.\n", iface, hdc, stroke, attributes);
+
+    if (!hdc || !(data = stroke_data_from_IInkStrokeDisp(stroke))) return E_INVALIDARG;
+    if (data->deleted) return E_INVALIDARG;
+    return draw_stroke(impl_from_IInkRenderer(iface), (HDC)hdc, data, attributes);
+}
+
+/* between pixels and ink space the view transform applies, the object transform does not */
+static void renderer_view_to_pixels(struct renderer *renderer, HDC hdc, XFORM *xform)
+{
+    float dpi_x = GetDeviceCaps(hdc, LOGPIXELSX), dpi_y = GetDeviceCaps(hdc, LOGPIXELSY);
+    XFORM himetric = {dpi_x / HIMETRIC_PER_INCH, 0.0f, 0.0f, dpi_y / HIMETRIC_PER_INCH, 0.0f, 0.0f};
+
+    xform_multiply(xform, &renderer->view, &himetric);
+}
+
+static HRESULT convert_point(struct renderer *renderer, HDC hdc, LONG *x, LONG *y, BOOL to_ink)
+{
+    XFORM xform;
+    float fx, fy;
+
+    if (!x || !y) return E_POINTER;
+    if (!hdc) return E_INVALIDARG;
+
+    renderer_view_to_pixels(renderer, hdc, &xform);
+    if (to_ink && !xform_invert(&xform, &xform))
+        return E_INVALIDARG;
+    fx = *x;
+    fy = *y;
+    xform_apply(&xform, &fx, &fy);
+    *x = lroundf(fx);
+    *y = lroundf(fy);
+    return S_OK;
+}
+
+static HRESULT convert_points(struct renderer *renderer, HDC hdc, VARIANT *points, BOOL to_ink)
+{
+    SAFEARRAY *array;
+    LONG lower, upper, i, *values;
+    HRESULT hr;
+
+    if (!points) return E_POINTER;
+    if (!hdc) return E_INVALIDARG;
+    if (V_VT(points) != (VT_ARRAY | VT_I4) && V_VT(points) != (VT_ARRAY | VT_BYREF | VT_I4))
+        return E_INVALIDARG;
+    array = V_VT(points) & VT_BYREF ? *V_ARRAYREF(points) : V_ARRAY(points);
+    if (!array || SafeArrayGetDim(array) != 1) return E_INVALIDARG;
+    SafeArrayGetLBound(array, 1, &lower);
+    SafeArrayGetUBound(array, 1, &upper);
+    if ((upper - lower + 1) % 2) return E_INVALIDARG;
+
+    if (FAILED(hr = SafeArrayAccessData(array, (void **)&values))) return hr;
+    for (i = 0; SUCCEEDED(hr) && i + 1 <= upper - lower; i += 2)
+        hr = convert_point(renderer, hdc, &values[i], &values[i + 1], to_ink);
+    SafeArrayUnaccessData(array);
+    return hr;
+}
+
+static HRESULT WINAPI renderer_PixelToInkSpace(IInkRenderer *iface, LONG_PTR hdc, LONG *x, LONG *y)
+{
+    TRACE("iface %p, hdc %#Ix, x %p, y %p.\n", iface, hdc, x, y);
+
+    return convert_point(impl_from_IInkRenderer(iface), (HDC)hdc, x, y, TRUE);
+}
+
+static HRESULT WINAPI renderer_InkSpaceToPixel(IInkRenderer *iface, LONG_PTR hdc, LONG *x, LONG *y)
+{
+    TRACE("iface %p, hdc %#Ix, x %p, y %p.\n", iface, hdc, x, y);
+
+    return convert_point(impl_from_IInkRenderer(iface), (HDC)hdc, x, y, FALSE);
+}
+
+static HRESULT WINAPI renderer_PixelToInkSpaceFromPoints(IInkRenderer *iface, LONG_PTR hdc, VARIANT *points)
+{
+    TRACE("iface %p, hdc %#Ix, points %p.\n", iface, hdc, points);
+
+    return convert_points(impl_from_IInkRenderer(iface), (HDC)hdc, points, TRUE);
+}
+
+static HRESULT WINAPI renderer_InkSpaceToPixelFromPoints(IInkRenderer *iface, LONG_PTR hdc, VARIANT *points)
+{
+    TRACE("iface %p, hdc %#Ix, points %p.\n", iface, hdc, points);
+
+    return convert_points(impl_from_IInkRenderer(iface), (HDC)hdc, points, FALSE);
+}
+
+/* the bounds in ink space of what the strokes draw, through the object transform */
+static HRESULT WINAPI renderer_Measure(IInkRenderer *iface, IInkStrokes *strokes, IInkRectangle **out)
+{
+    struct renderer *renderer = impl_from_IInkRenderer(iface);
+    struct stroke_data **data;
+    unsigned int count, i;
+    BOOL first = TRUE;
+    RECT rect = {0}, bounds;
+    HRESULT hr;
+
+    TRACE("iface %p, strokes %p, out %p.\n", iface, strokes, out);
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = strokes_get_data(strokes, &data, &count))) return hr;
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+    {
+        if (data[i]->deleted || !data[i]->packet_count) continue;
+        if (FAILED(hr = stroke_data_bounds(data[i], NULL, IBBM_Default, &renderer->object, FALSE, &bounds)))
+            break;
+        if (first) rect = bounds;
+        else UnionRect(&rect, &rect, &bounds);
+        first = FALSE;
+    }
+    strokes_free_data(data, count);
+    if (FAILED(hr)) return hr;
+    return rectangle_create(&rect, out);
+}
+
+static HRESULT WINAPI renderer_MeasureStroke(IInkRenderer *iface, IInkStrokeDisp *stroke,
+        IInkDrawingAttributes *attributes, IInkRectangle **out)
+{
+    struct renderer *renderer = impl_from_IInkRenderer(iface);
+    struct stroke_data *data;
+    RECT rect;
+    HRESULT hr;
+
+    TRACE("iface %p, stroke %p, attributes %p, out %p.\n", iface, stroke, attributes, out);
+
+    if (!out) return E_POINTER;
+    if (!(data = stroke_data_from_IInkStrokeDisp(stroke))) return E_INVALIDARG;
+    if (FAILED(hr = stroke_data_bounds(data, attributes, IBBM_Default, &renderer->object, FALSE, &rect)))
+        return hr;
+    return rectangle_create(&rect, out);
+}
+
+static HRESULT WINAPI renderer_Move(IInkRenderer *iface, float dx, float dy)
+{
+    TRACE("iface %p, dx %.8e, dy %.8e.\n", iface, dx, dy);
+
+    xform_translate(&impl_from_IInkRenderer(iface)->view, dx, dy);
+    return S_OK;
+}
+
+static HRESULT WINAPI renderer_Rotate(IInkRenderer *iface, float degrees, float x, float y)
+{
+    TRACE("iface %p, degrees %.8e, x %.8e, y %.8e.\n", iface, degrees, x, y);
+
+    xform_rotate(&impl_from_IInkRenderer(iface)->view, degrees, x, y);
+    return S_OK;
+}
+
+static HRESULT WINAPI renderer_ScaleTransform(IInkRenderer *iface, float horizontal, float vertical,
+        VARIANT_BOOL apply_on_pen_width)
+{
+    struct renderer *renderer = impl_from_IInkRenderer(iface);
+
+    TRACE("iface %p, horizontal %.8e, vertical %.8e, apply_on_pen_width %#x.\n", iface, horizontal, vertical,
+            apply_on_pen_width);
+
+    xform_scale_by(&renderer->view, horizontal, vertical);
+    renderer->scale_pen_width = !!apply_on_pen_width;
+    return S_OK;
+}
+
+static const IInkRendererVtbl renderer_vtbl =
+{
+    renderer_QueryInterface,
+    renderer_AddRef,
+    renderer_Release,
+    renderer_GetTypeInfoCount,
+    renderer_GetTypeInfo,
+    renderer_GetIDsOfNames,
+    renderer_Invoke,
+    renderer_GetViewTransform,
+    renderer_SetViewTransform,
+    renderer_GetObjectTransform,
+    renderer_SetObjectTransform,
+    renderer_Draw,
+    renderer_DrawStroke,
+    renderer_PixelToInkSpace,
+    renderer_InkSpaceToPixel,
+    renderer_PixelToInkSpaceFromPoints,
+    renderer_InkSpaceToPixelFromPoints,
+    renderer_Measure,
+    renderer_MeasureStroke,
+    renderer_Move,
+    renderer_Rotate,
+    renderer_ScaleTransform,
+};
+
+HRESULT renderer_create(IInkRenderer **out)
+{
+    struct renderer *renderer;
+
+    if (!(renderer = calloc(1, sizeof(*renderer))))
+        return E_OUTOFMEMORY;
+
+    renderer->IInkRenderer_iface.lpVtbl = &renderer_vtbl;
+    renderer->refcount = 1;
+    xform_identity(&renderer->view);
+    xform_identity(&renderer->object);
+    renderer->scale_pen_width = TRUE;
+
+    *out = &renderer->IInkRenderer_iface;
+    return S_OK;
+}
