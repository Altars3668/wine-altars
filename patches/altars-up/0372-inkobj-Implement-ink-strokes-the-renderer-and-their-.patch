+#include <float.h>
+#include <math.h>
+
+#include "inkobj_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(inkobj);
+
+/* the packet properties every stroke has, first */
+static const GUID GUID_PACKETPROPERTY_GUID_X = {0x598a6a8f, 0x52c0, 0x4ba0, {0x93, 0xaf, 0xaf, 0x35, 0x74, 0x11, 0xa5, 0x61}};
+static const GUID GUID_PACKETPROPERTY_GUID_Y = {0xb53f9f75, 0x04e0, 0x4498, {0xa7, 0xee, 0xc3, 0x0d, 0xbb, 0x5a, 0x90, 0x11}};
+
+/* a named collection of the ink's strokes */
+struct custom_entry
+{
+    BSTR name;
+    struct stroke_data **items;
+    unsigned int count;
+};
+
+struct ink
+{
+    IInkDisp IInkDisp_iface;
+    IInkCustomStrokes IInkCustomStrokes_iface;
+    LONG refcount;
+
+    CRITICAL_SECTION cs;
+    struct list strokes;
+    LONG next_id;
+    VARIANT_BOOL dirty;
+    IInkExtendedProperties *properties;
+    struct custom_entry *custom;
+    unsigned int custom_count;
+    unsigned int custom_capacity;
+};
+
+static struct ink *impl_from_IInkDisp(IInkDisp *iface);
+
+/* a stroke's own data; the ink holds it while the stroke is in it, and each object that
+ * stands for the stroke or collects it holds it too, so a deleted stroke can still say so */
+static void stroke_data_addref(struct stroke_data *data)
+{
+    InterlockedIncrement(&data->refcount);
+}
+
+void stroke_data_release(struct stroke_data *data)
+{
+    if (InterlockedDecrement(&data->refcount))
+        return;
+
+    free(data->description);
+    free(data->packets);
+    if (data->attributes) IInkDrawingAttributes_Release(data->attributes);
+    if (data->properties) IInkExtendedProperties_Release(data->properties);
+    free(data);
+}
+
+static HRESULT stroke_data_create(unsigned int packet_size, const GUID *description, unsigned int packet_count,
+        const LONG *packets, IInkDrawingAttributes *attributes, struct stroke_data **out)
+{
+    struct stroke_data *data;
+    HRESULT hr;
+
+    if (!(data = calloc(1, sizeof(*data))))
+        return E_OUTOFMEMORY;
+    data->refcount = 1;
+    data->packet_size = packet_size;
+    data->packet_count = packet_count;
+    if (!(data->description = malloc(packet_size * sizeof(*description)))
+            || !(data->packets = malloc(max(1, packet_count * packet_size) * sizeof(*packets))))
+    {
+        stroke_data_release(data);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(data->description, description, packet_size * sizeof(*description));
+    memcpy(data->packets, packets, packet_count * packet_size * sizeof(*packets));
+
+    if (attributes) hr = drawing_attributes_clone(attributes, &data->attributes);
+    else hr = drawing_attributes_create(&data->attributes);
+    if (SUCCEEDED(hr))
+        hr = extended_properties_create(&data->properties);
+    if (FAILED(hr))
+    {
+        stroke_data_release(data);
+        return hr;
+    }
+
+    *out = data;
+    return S_OK;
+}
+
+static HRESULT stroke_data_copy(const struct stroke_data *src, struct stroke_data **out)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = stroke_data_create(src->packet_size, src->description, src->packet_count, src->packets,
+            src->attributes, out)))
+        return hr;
+    if (FAILED(hr = extended_properties_copy((*out)->properties, src->properties)))
+    {
+        stroke_data_release(*out);
+        return hr;
+    }
+    return S_OK;
+}
+
+static unsigned int stroke_data_property(const struct stroke_data *data, const GUID *guid)
+{
+    unsigned int i;
+
+    for (i = 0; i < data->packet_size; ++i)
+        if (IsEqualGUID(&data->description[i], guid)) return i;
+    return ~0u;
+}
+
+static inline LONG stroke_x(const struct stroke_data *data, unsigned int i)
+{
+    return data->packets[i * data->packet_size];
+}
+
+static inline LONG stroke_y(const struct stroke_data *data, unsigned int i)
+{
+    return data->packets[i * data->packet_size + 1];
+}
+
+/* applies a transform to the points; with scale_width, also to the pen's width and height */
+static void stroke_data_transform(struct stroke_data *data, const XFORM *xform, BOOL scale_width)
+{
+    unsigned int i;
+
+    for (i = 0; i < data->packet_count; ++i)
+    {
+        float x = stroke_x(data, i), y = stroke_y(data, i);
+
+        xform_apply(xform, &x, &y);
+        data->packets[i * data->packet_size] = lroundf(x);
+        data->packets[i * data->packet_size + 1] = lroundf(y);
+    }
+
+    if (scale_width)
+    {
+        float scale = xform_scale(xform), width, height;
+
+        IInkDrawingAttributes_get_Width(data->attributes, &width);
+        IInkDrawingAttributes_get_Height(data->attributes, &height);
+        IInkDrawingAttributes_put_Width(data->attributes, width * scale);
+        IInkDrawingAttributes_put_Height(data->attributes, height * scale);
+    }
+}
+
+/* the bounds of the points, or of the pen's trace over them, through a transform */
+HRESULT stroke_data_bounds(const struct stroke_data *data, IInkDrawingAttributes *attributes,
+        InkBoundingBoxMode mode, const XFORM *xform, BOOL scale_width, RECT *rect)
+{
+    float left = FLT_MAX, top = FLT_MAX, right = -FLT_MAX, bottom = -FLT_MAX;
+    float width = 0.0f, height = 0.0f;
+    unsigned int i;
+
+    if (mode < IBBM_Default || mode > IBBM_Union)
+        return E_INVALIDARG;
+    if (!attributes)
+        attributes = data->attributes;
+
+    for (i = 0; i < data->packet_count; ++i)
+    {
+        float x = stroke_x(data, i), y = stroke_y(data, i);
+
+        if (xform) xform_apply(xform, &x, &y);
+        left = min(left, x);
+        top = min(top, y);
+        right = max(right, x);
+        bottom = max(bottom, y);
+    }
+    if (!data->packet_count)
+    {
+        SetRectEmpty(rect);
+        return S_OK;
+    }
+
+    if (mode != IBBM_PointsOnly)
+    {
+        InkPenTip tip;
+
+        IInkDrawingAttributes_get_Width(attributes, &width);
+        IInkDrawingAttributes_get_PenTip(attributes, &tip);
+        if (tip == IPT_Rectangle) IInkDrawingAttributes_get_Height(attributes, &height);
+        else height = width;
+        if (xform && scale_width)
+        {
+            width *= xform_scale(xform);
+            height *= xform_scale(xform);
+        }
+    }
+
+    rect->left = floorf(left - width / 2.0f);
+    rect->top = floorf(top - height / 2.0f);
+    rect->right = ceilf(right + width / 2.0f);
+    rect->bottom = ceilf(bottom + height / 2.0f);
+    return S_OK;
+}
+
+static float point_segment_distance(float px, float py, float ax, float ay, float bx, float by, float *t)
+{
+    float dx = bx - ax, dy = by - ay, len = dx * dx + dy * dy, u = 0.0f;
+
+    if (len > 0.0f)
+    {
+        u = ((px - ax) * dx + (py - ay) * dy) / len;
+        u = max(0.0f, min(1.0f, u));
+    }
+    if (t) *t = u;
+    dx = ax + u * dx - px;
+    dy = ay + u * dy - py;
+    return sqrtf(dx * dx + dy * dy);
+}
+
+/* the distance from a point to the stroke's polyline, and where on it, as a fractional
+ * index into the points */
+static float stroke_data_nearest(const struct stroke_data *data, float x, float y, float *index)
+{
+    float best = FLT_MAX, t;
+    unsigned int i;
+
+    *index = 0.0f;
+    if (data->packet_count == 1)
+        return point_segment_distance(x, y, stroke_x(data, 0), stroke_y(data, 0), stroke_x(data, 0), stroke_y(data, 0), &t);
+
+    for (i = 0; i + 1 < data->packet_count; ++i)
+    {
+        float d = point_segment_distance(x, y, stroke_x(data, i), stroke_y(data, i),
+                stroke_x(data, i + 1), stroke_y(data, i + 1), &t);
+        if (d < best)
+        {
+            best = d;
+            *index = i + t;
+        }
+    }
+    return best;
+}
+
+static BOOL segments_intersect(float ax, float ay, float bx, float by, float cx, float cy, float dx, float dy,
+        float *t, float *u)
+{
+    float rx = bx - ax, ry = by - ay, sx = dx - cx, sy = dy - cy;
+    float denom = rx * sy - ry * sx;
+
+    if (fabsf(denom) < 1e-9f)
+        return FALSE;
+    *t = ((cx - ax) * sy - (cy - ay) * sx) / denom;
+    *u = ((cx - ax) * ry - (cy - ay) * rx) / denom;
+    return *t >= 0.0f && *t <= 1.0f && *u >= 0.0f && *u <= 1.0f;
+}
+
+static BOOL point_in_polygon(float x, float y, const float *points, unsigned int count)
+{
+    unsigned int i, j;
+    BOOL inside = FALSE;
+
+    for (i = 0, j = count - 1; i < count; j = i++)
+    {
+        float xi = points[2 * i], yi = points[2 * i + 1], xj = points[2 * j], yj = points[2 * j + 1];
+
+        if ((yi > y) != (yj > y) && x < (xj - xi) * (y - yi) / (yj - yi) + xi)
+            inside = !inside;
+    }
+    return inside;
+}
+
+static HRESULT make_long_array(const LONG *values, unsigned int count, VARIANT *out)
+{
+    SAFEARRAY *array;
+    LONG *data;
+
+    VariantInit(out);
+    if (!(array = SafeArrayCreateVector(VT_I4, 0, count)))
+        return E_OUTOFMEMORY;
+    if (count)
+    {
+        SafeArrayAccessData(array, (void **)&data);
+        memcpy(data, values, count * sizeof(*values));
+        SafeArrayUnaccessData(array);
+    }
+    V_VT(out) = VT_ARRAY | VT_I4;
+    V_ARRAY(out) = array;
+    return S_OK;
+}
+
+static HRESULT make_float_array(const float *values, unsigned int count, VARIANT *out)
+{
+    SAFEARRAY *array;
+    float *data;
+
+    VariantInit(out);
+    if (!(array = SafeArrayCreateVector(VT_R4, 0, count)))
+        return E_OUTOFMEMORY;
+    if (count)
+    {
+        SafeArrayAccessData(array, (void **)&data);
+        memcpy(data, values, count * sizeof(*values));
+        SafeArrayUnaccessData(array);
+    }
+    V_VT(out) = VT_ARRAY | VT_R4;
+    V_ARRAY(out) = array;
+    return S_OK;
+}
+
+/* reads a one-dimensional array of numbers, as automation clients pass them */
+static HRESULT read_long_array(const VARIANT *in, LONG **values, unsigned int *count)
+{
+    const VARIANT *v = in;
+    LONG lower, upper, i;
+    SAFEARRAY *array;
+    VARTYPE vt;
+    HRESULT hr;
+
+    *values = NULL;
+    *count = 0;
+    while (V_VT(v) == (VT_BYREF | VT_VARIANT))
+        v = V_VARIANTREF(v);
+    if (!(V_VT(v) & VT_ARRAY))
+        return E_INVALIDARG;
+    array = (V_VT(v) & VT_BYREF) ? *V_ARRAYREF(v) : V_ARRAY(v);
+    if (!array || SafeArrayGetDim(array) != 1)
+        return E_INVALIDARG;
+    SafeArrayGetVartype(array, &vt);
+    switch (vt)
+    {
+    case VT_I1: case VT_UI1: case VT_I2: case VT_UI2: case VT_I4: case VT_UI4: case VT_INT: case VT_UINT:
+    case VT_I8: case VT_UI8: case VT_R4: case VT_R8: case VT_BOOL: case VT_VARIANT:
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    SafeArrayGetLBound(array, 1, &lower);
+    SafeArrayGetUBound(array, 1, &upper);
+    if (upper < lower)
+        return S_OK;
+    if (!(*values = malloc((upper - lower + 1) * sizeof(**values))))
+        return E_OUTOFMEMORY;
+
+    for (i = lower; i <= upper; ++i)
+    {
+        VARIANT element, number;
+
+        VariantInit(&element);
+        VariantInit(&number);
+        if (vt == VT_VARIANT)
+            hr = SafeArrayGetElement(array, &i, &element);
+        else
+        {
+            V_VT(&element) = vt;
+            hr = SafeArrayGetElement(array, &i, &V_I4(&element));
+        }
+        if (SUCCEEDED(hr))
+            hr = VariantChangeType(&number, &element, 0, VT_I4);
+        VariantClear(&element);
+        if (FAILED(hr))
+        {
+            free(*values);
+            *values = NULL;
+            return E_INVALIDARG;
+        }
+        (*values)[i - lower] = V_I4(&number);
+    }
+    *count = upper - lower + 1;
+    return S_OK;
+}
+
+/* the packet description: GUIDs as strings; nothing given means X and Y */
+static HRESULT read_description(const VARIANT *in, GUID **guids, unsigned int *count)
+{
+    const VARIANT *v = in;
+    LONG lower, upper, i;
+    SAFEARRAY *array;
+    VARTYPE vt;
+
+    while (V_VT(v) == (VT_BYREF | VT_VARIANT))
+        v = V_VARIANTREF(v);
+    if (V_VT(v) == VT_EMPTY || V_VT(v) == VT_ERROR || V_VT(v) == VT_NULL)
+    {
+        if (!(*guids = malloc(2 * sizeof(**guids))))
+            return E_OUTOFMEMORY;
+        (*guids)[0] = GUID_PACKETPROPERTY_GUID_X;
+        (*guids)[1] = GUID_PACKETPROPERTY_GUID_Y;
+        *count = 2;
+        return S_OK;
+    }
+    if (!(V_VT(v) & VT_ARRAY))
+        return E_INVALIDARG;
+    array = (V_VT(v) & VT_BYREF) ? *V_ARRAYREF(v) : V_ARRAY(v);
+    if (!array || SafeArrayGetDim(array) != 1)
+        return E_INVALIDARG;
+    SafeArrayGetVartype(array, &vt);
+    SafeArrayGetLBound(array, 1, &lower);
+    SafeArrayGetUBound(array, 1, &upper);
+    if (upper - lower + 1 < 2 || !(*guids = malloc((upper - lower + 1) * sizeof(**guids))))
+        return upper - lower + 1 < 2 ? E_INVALIDARG : E_OUTOFMEMORY;
+
+    for (i = lower; i <= upper; ++i)
+    {
+        VARIANT element;
+        HRESULT hr;
+
+        VariantInit(&element);
+        if (vt == VT_VARIANT) hr = SafeArrayGetElement(array, &i, &element);
+        else if (vt == VT_BSTR)
+        {
+            V_VT(&element) = VT_BSTR;
+            hr = SafeArrayGetElement(array, &i, &V_BSTR(&element));
+        }
+        else hr = E_INVALIDARG;
+        if (SUCCEEDED(hr) && V_VT(&element) != VT_BSTR) hr = E_INVALIDARG;
+        if (SUCCEEDED(hr)) hr = IIDFromString(V_BSTR(&element), &(*guids)[i - lower]);
+        VariantClear(&element);
+        if (FAILED(hr))
+        {
+            free(*guids);
+            return E_INVALIDARG;
+        }
+    }
+    *count = upper - lower + 1;
+
+    /* X and Y come first */
+    if (!IsEqualGUID(&(*guids)[0], &GUID_PACKETPROPERTY_GUID_X) || !IsEqualGUID(&(*guids)[1], &GUID_PACKETPROPERTY_GUID_Y))
+    {
+        free(*guids);
+        return E_INVALIDARG;
+    }
+    return S_OK;
+}
+
+/* a range of packets as the stroke methods take it: count -1 is the rest */
+static HRESULT packet_range(const struct stroke_data *data, LONG index, LONG count, unsigned int *start,
+        unsigned int *n)
+{
+    if (index < 0 || (index >= data->packet_count && data->packet_count))
+        return E_INVALIDARG;
+    if (count == -1)
+        count = data->packet_count - index;
+    if (count < 0 || index + count > data->packet_count)
+        return E_INVALIDARG;
+    *start = index;
+    *n = count;
+    return S_OK;
+}
