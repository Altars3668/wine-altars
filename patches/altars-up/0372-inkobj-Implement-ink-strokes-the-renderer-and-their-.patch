+/* where the polyline crosses itself, as fractional indices into its points */
+static HRESULT WINAPI stroke_get_SelfIntersections(IInkStrokeDisp *iface, VARIANT *intersections)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    struct stroke_data *data = stroke->data;
+    unsigned int i, j, n = 0, capacity = 16;
+    float *values, t, u;
+    HRESULT hr;
+
+    TRACE("iface %p, intersections %p.\n", iface, intersections);
+
+    if (!intersections) return E_POINTER;
+    if (!(values = malloc(capacity * sizeof(*values)))) return E_OUTOFMEMORY;
+    if (FAILED(hr = stroke_lock(stroke)))
+    {
+        free(values);
+        return hr;
+    }
+    for (i = 0; i + 1 < data->packet_count; ++i)
+    {
+        for (j = i + 2; j + 1 < data->packet_count; ++j)
+        {
+            if (!segments_intersect(stroke_x(data, i), stroke_y(data, i), stroke_x(data, i + 1), stroke_y(data, i + 1),
+                    stroke_x(data, j), stroke_y(data, j), stroke_x(data, j + 1), stroke_y(data, j + 1), &t, &u))
+                continue;
+            if (n + 2 > capacity)
+            {
+                float *tmp = realloc(values, (capacity *= 2) * sizeof(*values));
+                if (!tmp) break;
+                values = tmp;
+            }
+            values[n++] = i + t;
+            values[n++] = j + u;
+        }
+    }
+    stroke_unlock(stroke, FALSE);
+
+    hr = make_float_array(values, n, intersections);
+    free(values);
+    return hr;
+}
