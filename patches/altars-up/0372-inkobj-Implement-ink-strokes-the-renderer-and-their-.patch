+static const IInkDispVtbl ink_vtbl;
+
+static struct ink *impl_from_IInkDisp(IInkDisp *iface)
+{
+    return CONTAINING_RECORD(iface, struct ink, IInkDisp_iface);
+}
+
+static HRESULT ink_add_stroke(struct ink *ink, struct stroke_data *data)
+{
+    EnterCriticalSection(&ink->cs);
+    data->id = ink->next_id++;
+    data->deleted = FALSE;
+    stroke_data_addref(data);
+    list_add_tail(&ink->strokes, &data->entry);
+    ink->dirty = VARIANT_TRUE;
+    LeaveCriticalSection(&ink->cs);
+    return S_OK;
+}
+
+/* a deleted stroke leaves the ink and its named collections; objects standing for it
+ * then say it is deleted */
+static void ink_delete_stroke(struct ink *ink, struct stroke_data *data)
+{
+    unsigned int i, j;
+
+    EnterCriticalSection(&ink->cs);
+    if (!data->deleted)
+    {
+        data->deleted = TRUE;
+        list_remove(&data->entry);
+        for (i = 0; i < ink->custom_count; ++i)
+        {
+            struct custom_entry *entry = &ink->custom[i];
+
+            for (j = 0; j < entry->count; ++j)
+            {
+                if (entry->items[j] != data) continue;
+                stroke_data_release(data);
+                memmove(entry->items + j, entry->items + j + 1, (entry->count - j - 1) * sizeof(*entry->items));
+                entry->count--;
+                break;
+            }
+        }
+        stroke_data_release(data);
+        ink->dirty = VARIANT_TRUE;
+    }
+    LeaveCriticalSection(&ink->cs);
+}
+
+/* the strokes of the ink, each with a reference */
+static HRESULT ink_get_data(struct ink *ink, struct stroke_data ***data, unsigned int *count)
+{
+    struct stroke_data *stroke_data;
+    unsigned int n = 0;
+
+    EnterCriticalSection(&ink->cs);
+    LIST_FOR_EACH_ENTRY(stroke_data, &ink->strokes, struct stroke_data, entry) ++n;
+    if (!(*data = malloc(max(1, n) * sizeof(**data))))
+    {
+        LeaveCriticalSection(&ink->cs);
+        return E_OUTOFMEMORY;
+    }
+    n = 0;
+    LIST_FOR_EACH_ENTRY(stroke_data, &ink->strokes, struct stroke_data, entry)
+    {
+        stroke_data_addref(stroke_data);
+        (*data)[n++] = stroke_data;
+    }
+    LeaveCriticalSection(&ink->cs);
+    *count = n;
+    return S_OK;
+}
+
+/* strokes given to a method of the ink must be its own */
+static HRESULT ink_check_data(struct ink *ink, struct stroke_data **data, unsigned int count)
+{
+    struct stroke_data *stroke_data;
+    unsigned int i;
+    BOOL ours;
+
+    for (i = 0; i < count; ++i)
+    {
+        ours = FALSE;
+        LIST_FOR_EACH_ENTRY(stroke_data, &ink->strokes, struct stroke_data, entry)
+            if (stroke_data == data[i]) ours = TRUE;
+        if (!ours) return E_INVALIDARG;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI ink_QueryInterface(IInkDisp *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualGUID(riid, &IID_IInkDisp) || IsEqualGUID(riid, &IID_IDispatch)
+            || IsEqualGUID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IInkDisp_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ink_AddRef(IInkDisp *iface)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    ULONG refcount = InterlockedIncrement(&ink->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+    return refcount;
+}
+
+static ULONG WINAPI ink_Release(IInkDisp *iface)
+{
+    struct ink *ink = impl_from_IInkDisp(iface);
+    ULONG refcount = InterlockedDecrement(&ink->refcount);
+    struct stroke_data *data, *next;
+    unsigned int i;
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        for (i = 0; i < ink->custom_count; ++i)
+            custom_entry_clear(&ink->custom[i]);
+        free(ink->custom);
+        LIST_FOR_EACH_ENTRY_SAFE(data, next, &ink->strokes, struct stroke_data, entry)
+        {
+            list_remove(&data->entry);
+            stroke_data_release(data);
+        }
+        IInkExtendedProperties_Release(ink->properties);
+        ink->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection(&ink->cs);
+        free(ink);
+    }
+    return refcount;
+}
