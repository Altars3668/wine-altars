+
+static HRESULT WINAPI strokes_Item(IInkStrokes *iface, LONG index, IInkStrokeDisp **out)
+{
+    struct strokes *strokes = impl_from_IInkStrokes(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, index %ld, out %p.\n", iface, index, out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    EnterCriticalSection(&strokes->ink->cs);
+    if (index < 0 || index >= strokes->count)
+        hr = E_INVALIDARG;
+    else
+        hr = stroke_create(strokes->ink, strokes->items[index], out);
+    LeaveCriticalSection(&strokes->ink->cs);
+    return hr;
