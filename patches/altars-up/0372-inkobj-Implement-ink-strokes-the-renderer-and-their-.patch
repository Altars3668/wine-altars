+static void test_transform(void)
+{
+    float m11, m12, m21, m22, dx, dy;
+    IInkTransform *transform;
+    HRESULT hr;
+
+    if (!(transform = create(&CLSID_InkTransform, &IID_IInkTransform))) return;
+
+    hr = IInkTransform_GetTransform(transform, &m11, &m12, &m21, &m22, &dx, &dy);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(m11 == 1.0f && m12 == 0.0f && m21 == 0.0f && m22 == 1.0f && dx == 0.0f && dy == 0.0f,
+            "Got %f %f %f %f %f %f.\n", m11, m12, m21, m22, dx, dy);
+
+    hr = IInkTransform_Translate(transform, 10.0f, 20.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkTransform_ScaleTransform(transform, 2.0f, 3.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IInkTransform_GetTransform(transform, &m11, &m12, &m21, &m22, &dx, &dy);
+    ok(m11 == 2.0f && m22 == 3.0f, "Got %f %f.\n", m11, m22);
+    /* the translation is scaled when the scale comes after it */
+    ok((dx == 20.0f && dy == 60.0f) || (dx == 10.0f && dy == 20.0f), "Got %f %f.\n", dx, dy);
+    trace("translate then scale: offset %f, %f.\n", dx, dy);
+
+    hr = IInkTransform_Reset(transform);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IInkTransform_GetTransform(transform, &m11, &m12, &m21, &m22, &dx, &dy);
+    ok(m11 == 1.0f && m22 == 1.0f && dx == 0.0f && dy == 0.0f, "Got %f %f %f %f.\n", m11, m22, dx, dy);
+
+    hr = IInkTransform_SetTransform(transform, 1.0f, 2.0f, 3.0f, 4.0f, 5.0f, 6.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkTransform_get_eDy(transform, &dy);
+    ok(hr == S_OK && dy == 6.0f, "Got hr %#lx, dy %f.\n", hr, dy);
+
+    IInkTransform_Release(transform);
+}
