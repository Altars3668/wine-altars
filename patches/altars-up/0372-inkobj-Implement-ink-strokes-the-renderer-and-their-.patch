+/* a collection holds strokes of its own ink only */
+static HRESULT strokes_add_data(struct strokes *strokes, struct stroke_data **data, unsigned int count)
+{
+    unsigned int i;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&strokes->ink->cs);
+    for (i = 0; i < count; ++i)
+    {
+        struct stroke_data *stroke_data;
+        BOOL ours = FALSE;
+
+        LIST_FOR_EACH_ENTRY(stroke_data, &strokes->ink->strokes, struct stroke_data, entry)
+            if (stroke_data == data[i]) ours = TRUE;
+        if (!ours)
+        {
+            hr = E_INVALIDARG;
+            break;
+        }
+    }
+    for (i = 0; SUCCEEDED(hr) && i < count; ++i)
+        hr = strokes_append(strokes, data[i]);
+    LeaveCriticalSection(&strokes->ink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI strokes_Add(IInkStrokes *iface, IInkStrokeDisp *stroke)
+{
+    struct stroke_data *data;
+
+    TRACE("iface %p, stroke %p.\n", iface, stroke);
+
+    if (!(data = stroke_data_from_IInkStrokeDisp(stroke))) return E_INVALIDARG;
+    return strokes_add_data(impl_from_IInkStrokes(iface), &data, 1);
+}
+
+static HRESULT WINAPI strokes_AddStrokes(IInkStrokes *iface, IInkStrokes *others)
+{
+    struct stroke_data **data;
+    unsigned int count;
+    HRESULT hr;
+
+    TRACE("iface %p, others %p.\n", iface, others);
+
+    if (FAILED(hr = strokes_get_data(others, &data, &count))) return hr;
+    hr = strokes_add_data(impl_from_IInkStrokes(iface), data, count);
+    strokes_free_data(data, count);
+    return hr;
+}
+
+static HRESULT strokes_remove_data(struct strokes *strokes, struct stroke_data **data, unsigned int count)
+{
+    unsigned int i, index;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection(&strokes->ink->cs);
+    for (i = 0; i < count; ++i)
+    {
+        if ((index = strokes_find(strokes, data[i])) == ~0u)
+        {
+            hr = E_INVALIDARG;
+            continue;
+        }
+        stroke_data_release(strokes->items[index]);
+        memmove(strokes->items + index, strokes->items + index + 1, (strokes->count - index - 1) * sizeof(*strokes->items));
+        strokes->count--;
+    }
+    LeaveCriticalSection(&strokes->ink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI strokes_Remove(IInkStrokes *iface, IInkStrokeDisp *stroke)
+{
+    struct stroke_data *data;
+
+    TRACE("iface %p, stroke %p.\n", iface, stroke);
+
+    if (!(data = stroke_data_from_IInkStrokeDisp(stroke))) return E_INVALIDARG;
+    return strokes_remove_data(impl_from_IInkStrokes(iface), &data, 1);
+}
+
+static HRESULT WINAPI strokes_RemoveStrokes(IInkStrokes *iface, IInkStrokes *others)
+{
+    struct stroke_data **data;
+    unsigned int count;
+    HRESULT hr;
+
+    TRACE("iface %p, others %p.\n", iface, others);
+
+    if (FAILED(hr = strokes_get_data(others, &data, &count))) return hr;
+    hr = strokes_remove_data(impl_from_IInkStrokes(iface), data, count);
+    strokes_free_data(data, count);
+    return hr;
+}
+
+static HRESULT WINAPI strokes_ModifyDrawingAttributes(IInkStrokes *iface, IInkDrawingAttributes *attributes)
+{
+    struct strokes *strokes = impl_from_IInkStrokes(iface);
+    unsigned int i;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, attributes %p.\n", iface, attributes);
+
+    if (!attributes) return E_INVALIDARG;
+    EnterCriticalSection(&strokes->ink->cs);
+    for (i = 0; SUCCEEDED(hr) && i < strokes->count; ++i)
+    {
+        IInkDrawingAttributes *copy;
+
+        if (strokes->items[i]->deleted) continue;
+        if (SUCCEEDED(hr = drawing_attributes_clone(attributes, &copy)))
+        {
+            IInkDrawingAttributes_Release(strokes->items[i]->attributes);
+            strokes->items[i]->attributes = copy;
+            strokes->ink->dirty = VARIANT_TRUE;
+        }
+    }
+    LeaveCriticalSection(&strokes->ink->cs);
+    return hr;
+}
+
+static HRESULT strokes_bounds(struct stroke_data **items, unsigned int count, InkBoundingBoxMode mode,
+        const XFORM *xform, BOOL scale_width, RECT *rect)
+{
+    BOOL first = TRUE;
+    unsigned int i;
+    HRESULT hr;
+
+    SetRectEmpty(rect);
+    for (i = 0; i < count; ++i)
+    {
+        RECT bounds;
+
+        if (items[i]->deleted || !items[i]->packet_count) continue;
+        if (FAILED(hr = stroke_data_bounds(items[i], NULL, mode, xform, scale_width, &bounds)))
+            return hr;
+        if (first) *rect = bounds;
+        else
+        {
+            rect->left = min(rect->left, bounds.left);
+            rect->top = min(rect->top, bounds.top);
+            rect->right = max(rect->right, bounds.right);
+            rect->bottom = max(rect->bottom, bounds.bottom);
+        }
+        first = FALSE;
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_GetBoundingBox(IInkStrokes *iface, InkBoundingBoxMode mode, IInkRectangle **out)
+{
+    struct strokes *strokes = impl_from_IInkStrokes(iface);
+    RECT rect;
+    HRESULT hr;
+
+    TRACE("iface %p, mode %d, out %p.\n", iface, mode, out);
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection(&strokes->ink->cs);
+    hr = strokes_bounds(strokes->items, strokes->count, mode, NULL, FALSE, &rect);
+    LeaveCriticalSection(&strokes->ink->cs);
+    if (FAILED(hr)) return hr;
+    return rectangle_create(&rect, out);
+}
+
+static HRESULT strokes_transform(struct strokes *strokes, const XFORM *xform, BOOL scale_width)
+{
+    unsigned int i;
+
+    EnterCriticalSection(&strokes->ink->cs);
+    for (i = 0; i < strokes->count; ++i)
+        if (!strokes->items[i]->deleted) stroke_data_transform(strokes->items[i], xform, scale_width);
+    strokes->ink->dirty = VARIANT_TRUE;
+    LeaveCriticalSection(&strokes->ink->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI strokes_Transform(IInkStrokes *iface, IInkTransform *transform, VARIANT_BOOL apply_on_pen_width)
+{
+    XFORM xform;
+    HRESULT hr;
+
+    TRACE("iface %p, transform %p, apply_on_pen_width %#x.\n", iface, transform, apply_on_pen_width);
+
+    if (FAILED(hr = transform_get(transform, &xform))) return hr;
+    return strokes_transform(impl_from_IInkStrokes(iface), &xform, !!apply_on_pen_width);
+}
+
+static HRESULT WINAPI strokes_ScaleToRectangle(IInkStrokes *iface, IInkRectangle *rectangle)
+{
+    struct strokes *strokes = impl_from_IInkStrokes(iface);
+    RECT target, bounds;
+    XFORM xform;
+    HRESULT hr;
+
+    TRACE("iface %p, rectangle %p.\n", iface, rectangle);
+
+    if (FAILED(hr = rectangle_get(rectangle, &target))) return hr;
+    EnterCriticalSection(&strokes->ink->cs);
+    strokes_bounds(strokes->items, strokes->count, IBBM_PointsOnly, NULL, FALSE, &bounds);
+    scale_to_rectangle(&bounds, &target, &xform);
+    strokes_transform(strokes, &xform, FALSE);
+    LeaveCriticalSection(&strokes->ink->cs);
+    return S_OK;
+}
