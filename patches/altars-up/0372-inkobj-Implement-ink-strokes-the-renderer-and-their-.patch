+/* strokes are never recognized here: there is no recognizer */
+static HRESULT WINAPI strokes_get_RecognitionResult(IInkStrokes *iface, IInkRecognitionResult **result)
+{
+    TRACE("iface %p, result %p.\n", iface, result);
