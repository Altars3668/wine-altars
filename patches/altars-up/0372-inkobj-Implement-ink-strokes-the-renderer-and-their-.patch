+DEFINE_DISPATCH_METHODS(custom_strokes, IInkCustomStrokes, IInkCustomStrokes_tid)
+
+static void custom_entry_clear(struct custom_entry *entry)
+{
+    SysFreeString(entry->name);
+    strokes_free_data(entry->items, entry->count);
+}
+
+static HRESULT WINAPI custom_strokes_get_Count(IInkCustomStrokes *iface, LONG *count)
+{
+    struct ink *ink = impl_from_IInkCustomStrokes(iface);
+
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count) return E_POINTER;
+    *count = ink->custom_count;
+    return S_OK;
+}
+
+static HRESULT WINAPI custom_strokes_get__NewEnum(IInkCustomStrokes *iface, IUnknown **out)
+{
+    struct ink *ink = impl_from_IInkCustomStrokes(iface);
+    unsigned int i, n = 0;
+    IDispatch **items;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, out %p.\n", iface, out);
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection(&ink->cs);
+    if (!(items = malloc(max(1, ink->custom_count) * sizeof(*items))))
+        hr = E_OUTOFMEMORY;
+    for (i = 0; SUCCEEDED(hr) && i < ink->custom_count; ++i)
+    {
+        if (SUCCEEDED(hr = strokes_create(ink, ink->custom[i].items, ink->custom[i].count, (IInkStrokes **)&items[n])))
+            ++n;
+    }
+    LeaveCriticalSection(&ink->cs);
+
+    if (SUCCEEDED(hr))
+        hr = variant_enum_create(items, n, (IEnumVARIANT **)out);
+    for (i = 0; i < n; ++i)
+        IDispatch_Release(items[i]);
+    free(items);
+    return hr;
+}
+
+/* an entry is named by its index or its name */
+static int custom_strokes_find(struct ink *ink, const VARIANT *identifier)
+{
+    VARIANT index;
+    unsigned int i;
+
+    if (V_VT(identifier) == VT_BSTR)
+    {
+        for (i = 0; i < ink->custom_count; ++i)
+            if (!wcscmp(ink->custom[i].name, V_BSTR(identifier))) return i;
+        return -1;
+    }
+
+    VariantInit(&index);
+    if (FAILED(VariantChangeType(&index, identifier, 0, VT_I4)))
+        return -1;
+    if (V_I4(&index) < 0 || V_I4(&index) >= ink->custom_count)
+        return -1;
+    return V_I4(&index);
+}
+
+static HRESULT WINAPI custom_strokes_Item(IInkCustomStrokes *iface, VARIANT identifier, IInkStrokes **out)
+{
+    struct ink *ink = impl_from_IInkCustomStrokes(iface);
+    HRESULT hr;
+    int index;
+
+    TRACE("iface %p, identifier %s, out %p.\n", iface, debugstr_variant(&identifier), out);
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    EnterCriticalSection(&ink->cs);
+    if ((index = custom_strokes_find(ink, &identifier)) < 0)
+        hr = E_INVALIDARG;
+    else
+        hr = strokes_create(ink, ink->custom[index].items, ink->custom[index].count, out);
+    LeaveCriticalSection(&ink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI custom_strokes_Add(IInkCustomStrokes *iface, BSTR name, IInkStrokes *strokes)
+{
+    struct ink *ink = impl_from_IInkCustomStrokes(iface);
+    struct custom_entry entry = {0};
+    VARIANT identifier;
+    HRESULT hr;
+
+    TRACE("iface %p, name %s, strokes %p.\n", iface, debugstr_w(name), strokes);
+
+    if (!name || !strokes) return E_INVALIDARG;
+    if (FAILED(hr = strokes_get_data(strokes, &entry.items, &entry.count))) return hr;
+    if (!(entry.name = SysAllocString(name)))
+    {
+        strokes_free_data(entry.items, entry.count);
+        return E_OUTOFMEMORY;
+    }
+
+    EnterCriticalSection(&ink->cs);
+    V_VT(&identifier) = VT_BSTR;
+    V_BSTR(&identifier) = name;
+    /* a name is there once (what Windows does with a second is not measured) */
+    if (custom_strokes_find(ink, &identifier) >= 0)
+        hr = E_INVALIDARG;
+    else if (ink->custom_count == ink->custom_capacity)
+    {
+        unsigned int capacity = max(4, ink->custom_capacity * 2);
+        struct custom_entry *custom = realloc(ink->custom, capacity * sizeof(*custom));
+
+        if (!custom) hr = E_OUTOFMEMORY;
+        else
+        {
+            ink->custom = custom;
+            ink->custom_capacity = capacity;
+        }
+    }
+    if (SUCCEEDED(hr))
+    {
+        ink->custom[ink->custom_count++] = entry;
+        ink->dirty = VARIANT_TRUE;
+    }
+    LeaveCriticalSection(&ink->cs);
+
+    if (FAILED(hr))
+        custom_entry_clear(&entry);
+    return hr;
+}
+
+static HRESULT WINAPI custom_strokes_Remove(IInkCustomStrokes *iface, VARIANT identifier)
+{
+    struct ink *ink = impl_from_IInkCustomStrokes(iface);
+    HRESULT hr = S_OK;
+    int index;
+
+    TRACE("iface %p, identifier %s.\n", iface, debugstr_variant(&identifier));
+
+    EnterCriticalSection(&ink->cs);
+    if ((index = custom_strokes_find(ink, &identifier)) < 0)
+        hr = E_INVALIDARG;
+    else
+    {
+        custom_entry_clear(&ink->custom[index]);
+        memmove(ink->custom + index, ink->custom + index + 1, (ink->custom_count - index - 1) * sizeof(*ink->custom));
+        ink->custom_count--;
+        ink->dirty = VARIANT_TRUE;
+    }
+    LeaveCriticalSection(&ink->cs);
+    return hr;
+}
+
+static HRESULT WINAPI custom_strokes_Clear(IInkCustomStrokes *iface)
+{
+    struct ink *ink = impl_from_IInkCustomStrokes(iface);
+    unsigned int i;
+
+    TRACE("iface %p.\n", iface);
+
+    EnterCriticalSection(&ink->cs);
+    for (i = 0; i < ink->custom_count; ++i)
+        custom_entry_clear(&ink->custom[i]);
+    if (ink->custom_count) ink->dirty = VARIANT_TRUE;
+    ink->custom_count = 0;
+    LeaveCriticalSection(&ink->cs);
+    return S_OK;
+}
+
+static const IInkCustomStrokesVtbl custom_strokes_vtbl =
