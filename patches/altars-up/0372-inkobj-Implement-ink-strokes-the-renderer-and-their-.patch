+static HRESULT get_packet_values(struct stroke *stroke, unsigned int property, LONG index, LONG count, VARIANT *out)
+{
+    struct stroke_data *data = stroke->data;
+    unsigned int start, n, i;
+    LONG *values;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (FAILED(hr = stroke_lock(stroke))) return hr;
+    if (FAILED(hr = packet_range(data, index, count, &start, &n)))
+    {
+        stroke_unlock(stroke, FALSE);
+        return hr;
+    }
+    if (!(values = malloc(max(1, n * data->packet_size) * sizeof(*values))))
+    {
+        stroke_unlock(stroke, FALSE);
+        return E_OUTOFMEMORY;
+    }
+    if (property == ~0u)
+    {
+        memcpy(values, data->packets + start * data->packet_size, n * data->packet_size * sizeof(*values));
+        n *= data->packet_size;
+    }
+    else
+    {
+        for (i = 0; i < n; ++i)
+            values[i] = data->packets[(start + i) * data->packet_size + property];
+    }
+    stroke_unlock(stroke, FALSE);
+
+    hr = make_long_array(values, n, out);
+    free(values);
+    return hr;
+}
+
+static HRESULT WINAPI stroke_GetPoints(IInkStrokeDisp *iface, LONG index, LONG count, VARIANT *points)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    struct stroke_data *data = stroke->data;
+    unsigned int start, n, i;
+    LONG *values;
+    HRESULT hr;
+
+    TRACE("iface %p, index %ld, count %ld, points %p.\n", iface, index, count, points);
+
+    if (!points) return E_POINTER;
+    if (FAILED(hr = stroke_lock(stroke))) return hr;
+    if (FAILED(hr = packet_range(data, index, count, &start, &n)))
+    {
+        stroke_unlock(stroke, FALSE);
+        return hr;
+    }
+    if (!(values = malloc(max(1, 2 * n) * sizeof(*values))))
+    {
+        stroke_unlock(stroke, FALSE);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < n; ++i)
+    {
+        values[2 * i] = stroke_x(data, start + i);
+        values[2 * i + 1] = stroke_y(data, start + i);
+    }
+    stroke_unlock(stroke, FALSE);
+
+    hr = make_long_array(values, 2 * n, points);
+    free(values);
+    return hr;
+}
+
+static HRESULT WINAPI stroke_SetPoints(IInkStrokeDisp *iface, VARIANT points, LONG index, LONG count, LONG *set)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    struct stroke_data *data = stroke->data;
+    unsigned int start, n, i, values_count;
+    LONG *values;
+    HRESULT hr;
+
+    TRACE("iface %p, points %s, index %ld, count %ld, set %p.\n", iface, debugstr_variant(&points), index, count, set);
+
+    if (FAILED(hr = read_long_array(&points, &values, &values_count))) return hr;
+    if (FAILED(hr = stroke_lock(stroke)))
+    {
+        free(values);
+        return hr;
+    }
+    if (FAILED(hr = packet_range(data, index, count, &start, &n)))
+    {
+        stroke_unlock(stroke, FALSE);
+        free(values);
+        return hr;
+    }
+    n = min(n, values_count / 2);
+    for (i = 0; i < n; ++i)
+    {
+        data->packets[(start + i) * data->packet_size] = values[2 * i];
+        data->packets[(start + i) * data->packet_size + 1] = values[2 * i + 1];
+    }
+    stroke_unlock(stroke, TRUE);
+    free(values);
+    if (set) *set = n;
+    return S_OK;
+}
+
+static HRESULT WINAPI stroke_GetPacketData(IInkStrokeDisp *iface, LONG index, LONG count, VARIANT *packets)
+{
+    TRACE("iface %p, index %ld, count %ld, packets %p.\n", iface, index, count, packets);
+
+    return get_packet_values(impl_from_IInkStrokeDisp(iface), ~0u, index, count, packets);
+}
+
+static HRESULT WINAPI stroke_GetPacketValuesByProperty(IInkStrokeDisp *iface, BSTR name, LONG index, LONG count,
+        VARIANT *values)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    unsigned int property;
+    GUID guid;
+
+    TRACE("iface %p, name %s, index %ld, count %ld, values %p.\n", iface, debugstr_w(name), index, count, values);
+
+    if (!name || FAILED(IIDFromString(name, &guid))) return E_INVALIDARG;
+    if ((property = stroke_data_property(stroke->data, &guid)) == ~0u) return E_INVALIDARG;
+    return get_packet_values(stroke, property, index, count, values);
+}
+
+static HRESULT WINAPI stroke_SetPacketValuesByProperty(IInkStrokeDisp *iface, BSTR name, VARIANT packet_values,
+        LONG index, LONG count, LONG *set)
+{
+    struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
+    struct stroke_data *data = stroke->data;
+    unsigned int property, start, n, i, values_count;
+    LONG *values;
+    HRESULT hr;
+    GUID guid;
+
+    TRACE("iface %p, name %s, values %s, index %ld, count %ld, set %p.\n", iface, debugstr_w(name),
+            debugstr_variant(&packet_values), index, count, set);
+
+    if (!name || FAILED(IIDFromString(name, &guid))) return E_INVALIDARG;
+    if (FAILED(hr = read_long_array(&packet_values, &values, &values_count))) return hr;
+    if (FAILED(hr = stroke_lock(stroke)))
+    {
+        free(values);
+        return hr;
+    }
+    if ((property = stroke_data_property(data, &guid)) == ~0u)
+        hr = E_INVALIDARG;
+    else if (SUCCEEDED(hr = packet_range(data, index, count, &start, &n)))
+    {
+        n = min(n, values_count);
+        for (i = 0; i < n; ++i)
+            data->packets[(start + i) * data->packet_size + property] = values[i];
+        if (set) *set = n;
+    }
+    stroke_unlock(stroke, SUCCEEDED(hr));
+    free(values);
+    return hr;
+}
