+static void test_ink(void)
+{
+    static const LONG points[] = {1000, 1000, 2000, 1500, 3000, 1000};
+    VARIANT data, description, v;
+    IInkStrokeDisp *stroke, *stroke2, *item;
+    IInkRectangle *box;
+    IInkStrokes *strokes;
+    VARIANT_BOOL deleted;
+    LONG values[16], id, count;
+    IInkDisp *ink, *other;
+    RECT rect;
+    HRESULT hr;
+    unsigned int n;
+
+    if (!(ink = create(&CLSID_InkDisp, &IID_IInkDisp))) return;
+
+    hr = IInkDisp_get_Strokes(ink, &strokes);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokes_get_Count(strokes, &count);
+    ok(hr == S_OK && !count, "Got hr %#lx, count %ld.\n", hr, count);
+    IInkStrokes_Release(strokes);
+
+    data = long_array(points, ARRAY_SIZE(points));
+    V_VT(&description) = VT_EMPTY;
+    hr = IInkDisp_CreateStroke(ink, data, description, &stroke);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkDisp_CreateStroke(ink, data, description, &stroke2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    VariantClear(&data);
+
+    hr = IInkStrokeDisp_get_ID(stroke, &id);
+    ok(hr == S_OK && id == 1, "Got hr %#lx, id %ld.\n", hr, id);
+    hr = IInkStrokeDisp_get_ID(stroke2, &id);
+    ok(hr == S_OK && id == 2, "Got hr %#lx, id %ld.\n", hr, id);
+
+    hr = IInkStrokeDisp_get_PacketCount(stroke, &count);
+    ok(hr == S_OK && count == 3, "Got hr %#lx, count %ld.\n", hr, count);
+    hr = IInkStrokeDisp_get_PacketSize(stroke, &count);
+    ok(hr == S_OK && count == 8, "Got hr %#lx, size %ld.\n", hr, count);
+    hr = IInkStrokeDisp_GetPoints(stroke, 0, -1, &v);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    n = read_longs(&v, values, ARRAY_SIZE(values));
+    ok(n == 6 && !memcmp(values, points, sizeof(points)), "Got %u points.\n", n);
+    hr = IInkStrokeDisp_GetPoints(stroke, 1, 1, &v);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    n = read_longs(&v, values, ARRAY_SIZE(values));
+    ok(n == 2 && values[0] == 2000 && values[1] == 1500, "Got %u values, %ld %ld.\n", n, values[0], values[1]);
+
+    hr = IInkStrokeDisp_GetBoundingBox(stroke, IBBM_PointsOnly, &box);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IInkRectangle_get_Data(box, &rect);
+    ok(rect.left == 1000 && rect.top == 1000 && rect.right == 3000 && rect.bottom == 1500, "Got %s.\n",
+            wine_dbgstr_rect(&rect));
+    IInkRectangle_Release(box);
+    hr = IInkStrokeDisp_GetBoundingBox(stroke, IBBM_Default, &box);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    IInkRectangle_get_Data(box, &rect);
+    /* the default pen is 53 wide */
+    ok(rect.left < 1000 && rect.right > 3000, "Got %s.\n", wine_dbgstr_rect(&rect));
+    trace("default bounds %s.\n", wine_dbgstr_rect(&rect));
+    IInkRectangle_Release(box);
+
+    hr = IInkStrokeDisp_get_Ink(stroke, &other);
+    ok(hr == S_OK && other == ink, "Got hr %#lx, ink %p.\n", hr, other);
+    IInkDisp_Release(other);
+
+    hr = IInkStrokeDisp_Move(stroke, 10.0f, -10.0f);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokeDisp_GetPoints(stroke, 0, 1, &v);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    n = read_longs(&v, values, ARRAY_SIZE(values));
+    ok(n == 2 && values[0] == 1010 && values[1] == 990, "Got %ld %ld.\n", values[0], values[1]);
+
+    hr = IInkDisp_get_Strokes(ink, &strokes);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokes_get_Count(strokes, &count);
+    ok(hr == S_OK && count == 2, "Got hr %#lx, count %ld.\n", hr, count);
+    hr = IInkStrokes_Item(strokes, 1, &item);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokeDisp_get_ID(item, &id);
+    ok(hr == S_OK && id == 2, "Got hr %#lx, id %ld.\n", hr, id);
+    IInkStrokeDisp_Release(item);
+    hr = IInkStrokes_Item(strokes, 2, &item);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    hr = IInkDisp_DeleteStroke(ink, stroke);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokeDisp_get_Deleted(stroke, &deleted);
+    ok(hr == S_OK && deleted == VARIANT_TRUE, "Got hr %#lx, deleted %#x.\n", hr, deleted);
+    hr = IInkStrokeDisp_get_Deleted(stroke2, &deleted);
+    ok(hr == S_OK && deleted == VARIANT_FALSE, "Got hr %#lx, deleted %#x.\n", hr, deleted);
+    IInkStrokes_Release(strokes);
+
+    hr = IInkDisp_get_Strokes(ink, &strokes);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokes_get_Count(strokes, &count);
+    ok(hr == S_OK && count == 1, "Got hr %#lx, count %ld.\n", hr, count);
+    IInkStrokes_Release(strokes);
+
+    hr = IInkDisp_Clone(ink, &other);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkDisp_get_Strokes(other, &strokes);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokes_get_Count(strokes, &count);
+    ok(hr == S_OK && count == 1, "Got hr %#lx, count %ld.\n", hr, count);
+    IInkStrokes_Release(strokes);
+    IInkDisp_Release(other);
+
+    IInkStrokeDisp_Release(stroke2);
+    IInkStrokeDisp_Release(stroke);
+    IInkDisp_Release(ink);
+}
