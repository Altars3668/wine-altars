+static HRESULT WINAPI strokes_ToString(IInkStrokes *iface, BSTR *string)
+{
+    TRACE("iface %p, string %p.\n", iface, string);
+
+    if (!string) return E_POINTER;
+    return (*string = SysAllocString(L"")) ? S_OK : E_OUTOFMEMORY;
