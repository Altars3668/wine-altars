From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 11:56:57 -0400
Subject: [PATCH] wbemprox: Implement the product classes of
 root\SecurityCenter2.

AntiVirusProduct, AntiSpywareProduct and FirewallProduct are how
scripts and inventory tools ask which security products a machine has.
The namespace was there with no classes in it.  Each now lists the
products of the Security Center's product list for its kind, with their
name, GUID, remediation path as the product's executable, and the
timestamp of their state.

productState is not documented.  Its middle byte is 0x10 for a product
that is on, its low byte 0x10 for signatures out of date, and products
not from Microsoft have 0x04 in the third byte (266240 for one that is
on and up to date), which is what Windows is seen to give them.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wbemprox/builtin.c b/dlls/wbemprox/builtin.c
index 24c8a67ff92..046648d4c4a 100644
--- a/dlls/wbemprox/builtin.c
+++ b/dlls/wbemprox/builtin.c
@@ -41,6 +41,8 @@
 #include "ntddstor.h"
 #include "setupapi.h"
 #include "devguid.h"
+#include "wscapi.h"
+#include "iwscapi.h"
 
 #include "wine/debug.h"
 #include "wbemprox_private.h"
@@ -466,6 +468,15 @@ static const struct column col_rawsmbiostables[] =
     { L"SmbiosMinorVersion",  CIM_UINT8 },
     { L"Used20CallingMethod", CIM_BOOLEAN },
 };
+static const struct column col_securityproduct[] =
+{
+    { L"displayName",              CIM_STRING|COL_FLAG_DYNAMIC },
+    { L"instanceGuid",             CIM_STRING|COL_FLAG_DYNAMIC|COL_FLAG_KEY },
+    { L"pathToSignedProductExe",   CIM_STRING|COL_FLAG_DYNAMIC },
+    { L"pathToSignedReportingExe", CIM_STRING|COL_FLAG_DYNAMIC },
+    { L"productState",             CIM_UINT32 },
+    { L"timestamp",                CIM_STRING|COL_FLAG_DYNAMIC },
+};
 static const struct column col_service[] =
 {
     { L"AcceptPause",   CIM_BOOLEAN },
@@ -1049,6 +1060,15 @@ struct record_rawsmbiostables
     UINT8        minor_version;
     int          used_20_calling_method;
 };
+struct record_securityproduct
+{
+    const WCHAR *display_name;
+    const WCHAR *instance_guid;
+    const WCHAR *path_to_signed_product_exe;
+    const WCHAR *path_to_signed_reporting_exe;
+    UINT32       product_state;
+    const WCHAR *timestamp;
+};
 struct record_service
 {
     int          accept_pause;
@@ -5091,6 +5111,112 @@ static struct table win_storage_builtin_classes[] =
     { L"MSFT_PhysicalDisk", C(col_msft_phys_disk), 0, 0, NULL, fill_msft_phys_disk },
 };
 
+/* not documented; what Windows gives products not from Microsoft */
+static UINT32 get_product_state( WSC_SECURITY_PRODUCT_STATE state, WSC_SECURITY_SIGNATURE_STATUS signature )
+{
+    UINT32 ret = 0x40000;
+
+    if (state == WSC_SECURITY_PRODUCT_STATE_ON) ret |= 0x1000;
+    if (signature != WSC_SECURITY_PRODUCT_UP_TO_DATE) ret |= 0x10;
+    return ret;
+}
+
+static enum fill_status fill_securityproduct( struct table *table, const struct expr *cond, WSC_SECURITY_PROVIDER provider )
+{
+    struct record_securityproduct *rec;
+    enum fill_status status = FILL_STATUS_FAILED;
+    WSC_SECURITY_SIGNATURE_STATUS signature;
+    WSC_SECURITY_PRODUCT_STATE state;
+    IWSCProductList *list;
+    IWscProduct *product;
+    UINT row = 0, offset = 0;
+    LONG i, count;
+    HRESULT hr, init;
+
+    init = CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    if (FAILED(hr = CoCreateInstance( &CLSID_WSCProductList, NULL, CLSCTX_INPROC_SERVER, &IID_IWSCProductList,
+                                      (void **)&list )))
+    {
+        WARN( "failed to create the product list, hr %#lx\n", hr );
+        goto done;
+    }
+    if (FAILED(hr = IWSCProductList_Initialize( list, provider )) || FAILED(hr = IWSCProductList_get_Count( list, &count )))
+    {
+        WARN( "failed to list the products, hr %#lx\n", hr );
+        IWSCProductList_Release( list );
+        goto done;
+    }
+    if (!resize_table( table, max( count, 1 ), sizeof(*rec) ))
+    {
+        IWSCProductList_Release( list );
+        goto done;
+    }
+
+    status = FILL_STATUS_UNFILTERED;
+    for (i = 0; i < count; i++)
+    {
+        BSTR name = NULL, guid = NULL, path = NULL, timestamp = NULL;
+
+        if (FAILED(IWSCProductList_get_Item( list, i, &product ))) continue;
+        if (FAILED(IWscProduct_get_ProductState( product, &state ))) state = WSC_SECURITY_PRODUCT_STATE_OFF;
+        if (FAILED(IWscProduct_get_SignatureStatus( product, &signature ))) signature = WSC_SECURITY_PRODUCT_OUT_OF_DATE;
+        IWscProduct_get_ProductName( product, &name );
+        IWscProduct_get_ProductGuid( product, &guid );
+        IWscProduct_get_RemediationPath( product, &path );
+        IWscProduct_get_ProductStateTimestamp( product, &timestamp );
+        IWscProduct_Release( product );
+
+        rec = (struct record_securityproduct *)(table->data + offset);
+        rec->display_name                 = name ? wcsdup( name ) : NULL;
+        rec->instance_guid                = guid ? wcsdup( guid ) : NULL;
+        rec->path_to_signed_product_exe   = path ? wcsdup( path ) : NULL;
+        rec->path_to_signed_reporting_exe = path ? wcsdup( path ) : NULL;
+        rec->product_state                = get_product_state( state, signature );
+        rec->timestamp                    = timestamp ? wcsdup( timestamp ) : NULL;
+        SysFreeString( name );
+        SysFreeString( guid );
+        SysFreeString( path );
+        SysFreeString( timestamp );
+        if (!match_row( table, row, cond, &status ))
+        {
+            free_row_values( table, row );
+            continue;
+        }
+        offset += sizeof(*rec);
+        row++;
+    }
+    IWSCProductList_Release( list );
+
+    TRACE("created %u rows\n", row);
+    table->num_rows = row;
+
+done:
+    if (SUCCEEDED(init)) CoUninitialize();
+    return status;
+}
+
+static enum fill_status fill_antispywareproduct( struct table *table, const struct expr *cond )
+{
+    return fill_securityproduct( table, cond, WSC_SECURITY_PROVIDER_ANTISPYWARE );
+}
+
+static enum fill_status fill_antivirusproduct( struct table *table, const struct expr *cond )
+{
+    return fill_securityproduct( table, cond, WSC_SECURITY_PROVIDER_ANTIVIRUS );
+}
+
+static enum fill_status fill_firewallproduct( struct table *table, const struct expr *cond )
+{
+    return fill_securityproduct( table, cond, WSC_SECURITY_PROVIDER_FIREWALL );
+}
+
+static struct table securitycenter2_builtin_classes[] =
+{
+    { L"AntiSpywareProduct", C(col_securityproduct), 0, 0, NULL, fill_antispywareproduct },
+    { L"AntiVirusProduct", C(col_securityproduct), 0, 0, NULL, fill_antivirusproduct },
+    { L"FirewallProduct", C(col_securityproduct), 0, 0, NULL, fill_firewallproduct },
+};
+
 #undef C
 #undef D
 
@@ -5104,7 +5230,7 @@ builtin_namespaces[WBEMPROX_NAMESPACE_LAST] =
 {
     {L"cimv2", cimv2_builtin_classes, ARRAY_SIZE(cimv2_builtin_classes)},
     {L"Microsoft\\Windows\\Storage", win_storage_builtin_classes, ARRAY_SIZE(win_storage_builtin_classes)},
-    {L"SecurityCenter2", NULL, 0},
+    {L"SecurityCenter2", securitycenter2_builtin_classes, ARRAY_SIZE(securitycenter2_builtin_classes)},
     {L"StandardCimv2", NULL, 0},
     {L"wmi", wmi_builtin_classes, ARRAY_SIZE(wmi_builtin_classes)},
 };
diff --git a/dlls/wbemprox/tests/query.c b/dlls/wbemprox/tests/query.c
index e06c8063fea..435a02c0e94 100644
--- a/dlls/wbemprox/tests/query.c
+++ b/dlls/wbemprox/tests/query.c
@@ -25,6 +25,8 @@
 #include "initguid.h"
 #include "objidl.h"
 #include "wbemcli.h"
+#include "wscapi.h"
+#include "iwscapi.h"
 #include "wine/test.h"
 
 static HRESULT exec_query( IWbemServices *services, const WCHAR *str, IEnumWbemClassObject **result )
@@ -2674,6 +2676,126 @@ static void test_MSFT_PhysicalDisk( IWbemLocator *locator )
     SysFreeString( query );
 }
 
+static IWscProduct *find_wsc_product( IWSCProductList *list, LONG count, const WCHAR *guid )
+{
+    IWscProduct *product;
+    BSTR str;
+    LONG i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (FAILED(IWSCProductList_get_Item( list, i, &product ))) continue;
+        if (SUCCEEDED(IWscProduct_get_ProductGuid( product, &str )))
+        {
+            BOOL match = !wcsicmp( str, guid );
+            SysFreeString( str );
+            if (match) return product;
+        }
+        IWscProduct_Release( product );
+    }
+    return NULL;
+}
+
+static void test_security_products( IWbemServices *services, const WCHAR *class, WSC_SECURITY_PROVIDER provider )
+{
+    BSTR wql = SysAllocString( L"wql" ), query;
+    WSC_SECURITY_SIGNATURE_STATUS signature;
+    WSC_SECURITY_PRODUCT_STATE state;
+    IWSCProductList *list = NULL;
+    IEnumWbemClassObject *result;
+    LONG count = 0, instances = 0;
+    IWscProduct *product;
+    IWbemClassObject *obj;
+    WCHAR buf[64];
+    VARIANT val;
+    ULONG n;
+    HRESULT hr;
+    BSTR str;
+
+    hr = CoCreateInstance( &CLSID_WSCProductList, NULL, CLSCTX_INPROC_SERVER, &IID_IWSCProductList, (void **)&list );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (list)
+    {
+        hr = IWSCProductList_Initialize( list, provider );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        hr = IWSCProductList_get_Count( list, &count );
+        ok( hr == S_OK, "got %#lx\n", hr );
+    }
+
+    swprintf( buf, ARRAY_SIZE(buf), L"SELECT * FROM %s", class );
+    query = SysAllocString( buf );
+    hr = IWbemServices_ExecQuery( services, wql, query, 0, NULL, &result );
+    ok( hr == S_OK, "%s: got %#lx\n", debugstr_w(class), hr );
+    SysFreeString( query );
+    SysFreeString( wql );
+    if (hr != S_OK) goto done;
+
+    for (;;)
+    {
+        hr = IEnumWbemClassObject_Next( result, 10000, 1, &obj, &n );
+        if (hr != S_OK) break;
+        instances++;
+
+        check_property( obj, L"displayName", VT_BSTR, CIM_STRING );
+        check_property( obj, L"instanceGuid", VT_BSTR, CIM_STRING );
+        check_property( obj, L"pathToSignedProductExe", VT_BSTR, CIM_STRING );
+        check_property( obj, L"pathToSignedReportingExe", VT_BSTR, CIM_STRING );
+        check_property( obj, L"productState", VT_I4, CIM_UINT32 );
+        check_property( obj, L"timestamp", VT_BSTR, CIM_STRING );
+
+        /* the same product, as Security Center lists it */
+        hr = IWbemClassObject_Get( obj, L"instanceGuid", 0, &val, NULL, NULL );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        product = list ? find_wsc_product( list, count, V_BSTR(&val) ) : NULL;
+        ok( product != NULL, "%s: %s not in the product list\n", debugstr_w(class), debugstr_w(V_BSTR(&val)) );
+        VariantClear( &val );
+        if (product)
+        {
+            hr = IWbemClassObject_Get( obj, L"displayName", 0, &val, NULL, NULL );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            hr = IWscProduct_get_ProductName( product, &str );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            ok( !wcscmp( V_BSTR(&val), str ), "got %s, %s\n", debugstr_w(V_BSTR(&val)), debugstr_w(str) );
+            SysFreeString( str );
+            VariantClear( &val );
+
+            hr = IWbemClassObject_Get( obj, L"productState", 0, &val, NULL, NULL );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            hr = IWscProduct_get_ProductState( product, &state );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            hr = IWscProduct_get_SignatureStatus( product, &signature );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            ok( !!(V_I4(&val) & 0x1000) == (state == WSC_SECURITY_PRODUCT_STATE_ON),
+                "productState %#lx, state %u\n", V_I4(&val), state );
+            ok( !!(V_I4(&val) & 0xff) == (signature != WSC_SECURITY_PRODUCT_UP_TO_DATE),
+                "productState %#lx, signature %u\n", V_I4(&val), signature );
+
+            hr = IWbemClassObject_Get( obj, L"pathToSignedProductExe", 0, &val, NULL, NULL );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            hr = IWscProduct_get_RemediationPath( product, &str );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            trace( "pathToSignedProductExe %s, remediation path %s\n", debugstr_w(V_BSTR(&val)), debugstr_w(str) );
+            SysFreeString( str );
+            VariantClear( &val );
+
+            hr = IWbemClassObject_Get( obj, L"timestamp", 0, &val, NULL, NULL );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            hr = IWscProduct_get_ProductStateTimestamp( product, &str );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            trace( "timestamp %s, product state timestamp %s\n", debugstr_w(V_BSTR(&val)), debugstr_w(str) );
+            SysFreeString( str );
+            VariantClear( &val );
+            IWscProduct_Release( product );
+        }
+        IWbemClassObject_Release( obj );
+    }
+    ok( instances == count, "%s: %ld instances, %ld products\n", debugstr_w(class), instances, count );
+    IEnumWbemClassObject_Release( result );
+
+done:
+    if (list) IWSCProductList_Release( list );
+}
+
 static void test_SecurityCenter2( IWbemLocator *locator )
 {
     BSTR path = SysAllocString( L"ROOT\\SecurityCenter2" );
@@ -2683,6 +2805,10 @@ static void test_SecurityCenter2( IWbemLocator *locator )
     hr = IWbemLocator_ConnectServer( locator, path, NULL, NULL, NULL, 0, NULL, NULL, &services );
     ok( hr == S_OK, "failed to get IWbemServices interface %#lx\n", hr );
 
+    test_security_products( services, L"AntiSpywareProduct", WSC_SECURITY_PROVIDER_ANTISPYWARE );
+    test_security_products( services, L"AntiVirusProduct", WSC_SECURITY_PROVIDER_ANTIVIRUS );
+    test_security_products( services, L"FirewallProduct", WSC_SECURITY_PROVIDER_FIREWALL );
+
     IWbemServices_Release( services );
     SysFreeString( path );
 }
