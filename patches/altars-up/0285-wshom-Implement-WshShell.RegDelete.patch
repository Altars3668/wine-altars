From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 17:01:48 -0400
Subject: [PATCH] wshom: Implement WshShell.RegDelete().

It was a stub returning E_NOTIMPL, so a script that put a setting back
the way it found it by deleting the value it had added left the value
behind.  As documented, a path ending in a backslash names a key, which
cannot have subkeys, and any other path names a value; the errors are
those of RegDeleteKeyW() and RegDeleteKeyValueW().

split_reg_path() now always allocates the key path when the path names
a value: for a value right under the root ("HKCU\name") it handed back
a pointer into the name, which RegRead() and RegWrite() then freed.

The new tests have not been run on Windows yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wshom.ocx/shell.c b/dlls/wshom.ocx/shell.c
index 4056201a6b7..b56b139464d 100644
--- a/dlls/wshom.ocx/shell.c
+++ b/dlls/wshom.ocx/shell.c
@@ -1552,37 +1552,33 @@ static HKEY get_root_key(const WCHAR *path)
 }
 
 /* Caller is responsible to free 'subkey' if 'value' is not NULL */
+/* The key path after the root and, unless the path ends in a backslash and so names a key, the value name
+ * after the last backslash; the key path is allocated when there is a value name. */
 static HRESULT split_reg_path(const WCHAR *path, WCHAR **subkey, WCHAR **value)
 {
+    const WCHAR *first, *last;
+    unsigned int len;
+
     *value = NULL;
 
     /* at least one separator should be present */
-    *subkey = wcschr(path, '\\');
-    if (!*subkey)
+    if (!(first = wcschr(path, '\\')))
         return HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND);
 
     /* default value or not */
-    if ((*subkey)[lstrlenW(*subkey)-1] == '\\') {
-        (*subkey)++;
-        *value = NULL;
-    }
-    else {
-        *value = wcsrchr(*subkey, '\\');
-        if (*value - *subkey > 1) {
-            unsigned int len = *value - *subkey - 1;
-            WCHAR *ret;
-
-            ret = malloc((len + 1)*sizeof(WCHAR));
-            if (!ret)
-                return E_OUTOFMEMORY;
-
-            memcpy(ret, *subkey + 1, len*sizeof(WCHAR));
-            ret[len] = 0;
-            *subkey = ret;
-        }
-        (*value)++;
+    if (first[lstrlenW(first) - 1] == '\\')
+    {
+        *subkey = (WCHAR *)first + 1;
+        return S_OK;
     }
 
+    last = wcsrchr(first, '\\');
+    len = last > first ? last - first - 1 : 0;
+    if (!(*subkey = malloc((len + 1) * sizeof(WCHAR))))
+        return E_OUTOFMEMORY;
+    memcpy(*subkey, first + 1, len * sizeof(WCHAR));
+    (*subkey)[len] = 0;
+    *value = (WCHAR *)last + 1;
     return S_OK;
 }
 
@@ -1806,10 +1802,46 @@ fail:
     return hr;
 }
 
-static HRESULT WINAPI WshShell3_RegDelete(IWshShell3 *iface, BSTR Name)
+static HRESULT WINAPI WshShell3_RegDelete(IWshShell3 *iface, BSTR name)
 {
-    FIXME("(%s): stub\n", debugstr_w(Name));
-    return E_NOTIMPL;
+    WCHAR *subkey, *val, *key;
+    unsigned int len;
+    HRESULT hr;
+    HKEY root;
+    LONG ret;
+
+    TRACE("(%s)\n", debugstr_w(name));
+
+    if (!name)
+        return E_POINTER;
+
+    root = get_root_key(name);
+    if (!root)
+        return HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND);
+
+    hr = split_reg_path(name, &subkey, &val);
+    if (FAILED(hr))
+        return hr;
+
+    if (val)
+    {
+        ret = RegDeleteKeyValueW(root, subkey, val);
+        free(subkey);
+    }
+    else
+    {
+        /* a path ending in a backslash names the key, which cannot have subkeys */
+        len = lstrlenW(subkey);
+        while (len && subkey[len - 1] == '\\') len--;
+        if (!(key = malloc((len + 1) * sizeof(WCHAR))))
+            return E_OUTOFMEMORY;
+        memcpy(key, subkey, len * sizeof(WCHAR));
+        key[len] = 0;
+        ret = RegDeleteKeyW(root, key);
+        free(key);
+    }
+
+    return ret ? HRESULT_FROM_WIN32(ret) : S_OK;
 }
 
 static HRESULT WINAPI WshShell3_LogEvent(IWshShell3 *iface, VARIANT *Type, BSTR Message, BSTR Target, VARIANT_BOOL *out_Success)
diff --git a/dlls/wshom.ocx/tests/wshom.c b/dlls/wshom.ocx/tests/wshom.c
index 9eb38a66457..280eed05a74 100644
--- a/dlls/wshom.ocx/tests/wshom.c
+++ b/dlls/wshom.ocx/tests/wshom.c
@@ -639,6 +639,52 @@ static void test_registry(void)
     SysFreeString(name);
 
     delete_key(root);
+
+    /* RegDelete() */
+    hr = IWshShell3_RegDelete(sh3, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+
+    name = SysAllocString(L"HKEY_broken_key");
+    hr = IWshShell3_RegDelete(sh3, name);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND), "Unexpected hr %#lx.\n", hr);
+    SysFreeString(name);
+
+    ret = RegCreateKeyA(HKEY_CURRENT_USER, "Software\\Wine\\Test\\sub", &root);
+    ok(!ret, "Unexpected retval %ld.\n", ret);
+    RegCloseKey(root);
+    ret = RegCreateKeyA(HKEY_CURRENT_USER, "Software\\Wine\\Test", &root);
+    ok(!ret, "Unexpected retval %ld.\n", ret);
+    dwvalue = 1;
+    ret = RegSetValueExA(root, "regsz", 0, REG_DWORD, (const BYTE *)&dwvalue, sizeof(dwvalue));
+    ok(!ret, "Unexpected retval %ld.\n", ret);
+
+    /* a path not ending in a backslash names a value */
+    name = SysAllocString(L"HKEY_CURRENT_USER\\Software\\Wine\\Test\\regsz");
+    hr = IWshShell3_RegDelete(sh3, name);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ret = RegQueryValueExA(root, "regsz", 0, &type, NULL, NULL);
+    ok(ret == ERROR_FILE_NOT_FOUND, "Unexpected retval %ld.\n", ret);
+    hr = IWshShell3_RegDelete(sh3, name);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND), "Unexpected hr %#lx.\n", hr);
+    SysFreeString(name);
+
+    /* one ending in a backslash names a key, which has to have no subkeys */
+    name = SysAllocString(L"HKCU\\Software\\Wine\\Test\\");
+    hr = IWshShell3_RegDelete(sh3, name);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_ACCESS_DENIED), "Unexpected hr %#lx.\n", hr);
+    SysFreeString(name);
+    name = SysAllocString(L"HKCU\\Software\\Wine\\Test\\sub\\");
+    hr = IWshShell3_RegDelete(sh3, name);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    SysFreeString(name);
+    name = SysAllocString(L"HKCU\\Software\\Wine\\Test\\");
+    hr = IWshShell3_RegDelete(sh3, name);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IWshShell3_RegDelete(sh3, name);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND), "Unexpected hr %#lx.\n", hr);
+    SysFreeString(name);
+    RegCloseKey(root);
+
     IWshShell3_Release(sh3);
 }
 
