From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 06:40:00 -0400
Subject: [PATCH] wscapi: Answer the way Windows 11 does where it was measured.

On build 29671: the health of no provider at all is S_OK and good; a product
list asked for its count before Initialize says OLE_E_BLANK and leaves the
count alone; Defender, the only antivirus there, is not the default product;
and the antispyware list is empty although Defender fights spyware, while the
antispyware provider's health is good.  So the scanner is listed as an
antivirus only, and is not the default either.  The tests check those codes
now, accept the literal "NULL" GUID Windows gives its own firewall, and trace
the GUIDs, the substatus of IWscProduct2 and IWscProduct3 for the next run.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wscapi/main.c b/dlls/wscapi/main.c
index 43ddbf27c88..b5157f134b3 100644
--- a/dlls/wscapi/main.c
+++ b/dlls/wscapi/main.c
@@ -125,7 +125,8 @@ HRESULT WINAPI WscGetSecurityProviderHealth( DWORD providers, WSC_SECURITY_PROVI
     TRACE( "%#lx, %p\n", providers, health );
 
     if (!health) return E_INVALIDARG;
-    if (!providers || (providers & ~WSC_SECURITY_PROVIDER_ALL)) return E_INVALIDARG;
+    /* no provider at all is in good health, as on Windows */
+    if (providers & ~WSC_SECURITY_PROVIDER_ALL) return E_INVALIDARG;
 
     query_antivirus( &params );
     for (bit = 1; bit <= providers; bit <<= 1)
@@ -415,9 +416,10 @@ static HRESULT WINAPI product_get_ProductIsDefault( IWscProduct3 *iface, BOOL *v
 {
     TRACE( "%p, %p\n", iface, val );
 
-    /* the only one */
+    /* Being the only antivirus does not make one the default: Windows 11 says no for its own Defender
+     * too.  That takes the user's choice, through WSCDefaultProduct. */
     if (!val) return E_POINTER;
-    *val = TRUE;
+    *val = FALSE;
     return S_OK;
 }
 
@@ -602,7 +604,10 @@ static HRESULT WINAPI product_list_Initialize( IWSCProductList *iface, ULONG pro
 
     list->provider = provider;
     query_antivirus( &list->params );
-    list->count = provider != WSC_SECURITY_PROVIDER_FIREWALL && list->params.state != ANTIVIRUS_NONE ? 1 : 0;
+    /* The scanner is an antivirus and nothing else.  Windows 11 does not list its Defender, which fights
+     * spyware as well, as an antispyware product either; the antispyware provider's health follows the
+     * antivirus all the same. */
+    list->count = provider == WSC_SECURITY_PROVIDER_ANTIVIRUS && list->params.state != ANTIVIRUS_NONE ? 1 : 0;
     return S_OK;
 }
 
@@ -613,7 +618,7 @@ static HRESULT WINAPI product_list_get_Count( IWSCProductList *iface, LONG *val
     TRACE( "%p, %p\n", iface, val );
 
     if (!val) return E_POINTER;
-    if (!list->provider) return E_UNEXPECTED;
+    if (!list->provider) return OLE_E_BLANK;
     *val = list->count;
     return S_OK;
 }
@@ -626,7 +631,7 @@ static HRESULT WINAPI product_list_get_Item( IWSCProductList *iface, ULONG index
     TRACE( "%p, %lu, %p\n", iface, index, val );
 
     if (!val) return E_POINTER;
-    if (!list->provider) return E_UNEXPECTED;
+    if (!list->provider) return OLE_E_BLANK;
     if (index >= list->count) return E_INVALIDARG;
 
     if (!(product = calloc( 1, sizeof(*product) ))) return E_OUTOFMEMORY;
diff --git a/dlls/wscapi/tests/wscapi.c b/dlls/wscapi/tests/wscapi.c
index 9729d98dc69..a6997d48f8a 100644
--- a/dlls/wscapi/tests/wscapi.c
+++ b/dlls/wscapi/tests/wscapi.c
@@ -17,6 +17,7 @@
  */
 
 #include <stdarg.h>
+#include <string.h>
 
 #define COBJMACROS
 #include "windef.h"
@@ -36,16 +37,17 @@ static void test_WscGetSecurityProviderHealth(void)
     HRESULT hr;
 
     hr = WscGetSecurityProviderHealth( WSC_SECURITY_PROVIDER_ANTIVIRUS, NULL );
-    trace( "no health pointer: %#lx\n", hr );
-    ok( FAILED(hr), "got %#lx\n", hr );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
 
     health = 0xdeadbeef;
     hr = WscGetSecurityProviderHealth( 0, &health );
-    trace( "no provider: %#lx, health %#x\n", hr, health );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( health == WSC_SECURITY_PROVIDER_HEALTH_GOOD, "got health %#x\n", health );
 
     health = 0xdeadbeef;
     hr = WscGetSecurityProviderHealth( 0x80, &health );
-    trace( "unknown provider: %#lx, health %#x\n", hr, health );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( health == 0xdeadbeef, "got health %#x\n", health );
 
     for (provider = WSC_SECURITY_PROVIDER_FIREWALL; provider <= WSC_SECURITY_PROVIDER_SERVICE; provider <<= 1)
     {
@@ -80,13 +82,12 @@ static void test_WscRegisterForChanges(void)
     HRESULT hr;
 
     hr = WscRegisterForChanges( NULL, NULL, changes_callback, NULL );
-    trace( "no handle pointer: %#lx\n", hr );
-    ok( FAILED(hr), "got %#lx\n", hr );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
 
     handle = (HANDLE)0xdeadbeef;
     hr = WscRegisterForChanges( NULL, &handle, NULL, NULL );
-    trace( "no callback: %#lx, handle %p\n", hr, handle );
-    ok( FAILED(hr), "got %#lx\n", hr );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( handle == (HANDLE)0xdeadbeef, "got handle %p\n", handle );
 
     handle = NULL;
     hr = WscRegisterForChanges( NULL, &handle, changes_callback, (void *)0xdeadbeef );
@@ -96,7 +97,40 @@ static void test_WscRegisterForChanges(void)
     ok( hr == S_OK, "got %#lx\n", hr );
 
     hr = WscUnRegisterChanges( NULL );
-    trace( "unregistering NULL: %#lx\n", hr );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+}
+
+/* what the later interfaces add, which says how the product is doing in more detail */
+static void trace_product_details( IWscProduct *product )
+{
+    WSC_SECURITY_PRODUCT_SUBSTATUS substatus[6];
+    IWscProduct2 *product2;
+    IWscProduct3 *product3;
+    HRESULT hr, hrs[6];
+    DWORD days;
+
+    hr = IWscProduct_QueryInterface( product, &IID_IWscProduct2, (void **)&product2 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (FAILED(hr)) return;
+    memset( substatus, 0xcc, sizeof(substatus) );
+    hrs[0] = IWscProduct2_get_AntivirusScanSubstatus( product2, &substatus[0] );
+    hrs[1] = IWscProduct2_get_AntivirusSettingsSubstatus( product2, &substatus[1] );
+    hrs[2] = IWscProduct2_get_AntivirusProtectionUpdateSubstatus( product2, &substatus[2] );
+    hrs[3] = IWscProduct2_get_FirewallDomainProfileSubstatus( product2, &substatus[3] );
+    hrs[4] = IWscProduct2_get_FirewallPrivateProfileSubstatus( product2, &substatus[4] );
+    hrs[5] = IWscProduct2_get_FirewallPublicProfileSubstatus( product2, &substatus[5] );
+    trace( "  scan %#lx/%d, settings %#lx/%d, update %#lx/%d, domain %#lx/%d, private %#lx/%d, public %#lx/%d\n",
+           hrs[0], substatus[0], hrs[1], substatus[1], hrs[2], substatus[2], hrs[3], substatus[3],
+           hrs[4], substatus[4], hrs[5], substatus[5] );
+    IWscProduct2_Release( product2 );
+
+    hr = IWscProduct_QueryInterface( product, &IID_IWscProduct3, (void **)&product3 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (FAILED(hr)) return;
+    days = 0xdeadbeef;
+    hr = IWscProduct3_get_AntivirusDaysUntilExpired( product3, &days );
+    trace( "  days until expired %#lx, %lu\n", hr, days );
+    IWscProduct3_Release( product3 );
 }
 
 static void test_product_list(ULONG provider)
@@ -116,7 +150,11 @@ static void test_product_list(ULONG provider)
 
     count = 0xdeadbeef;
     hr = IWSCProductList_get_Count( list, &count );
-    trace( "count before initializing: %#lx, %ld\n", hr, count );
+    ok( hr == OLE_E_BLANK, "got %#lx\n", hr );
+    ok( count == 0xdeadbeef, "got count %ld\n", count );
+    product = (IWscProduct *)0xdeadbeef;
+    hr = IWSCProductList_get_Item( list, 0, &product );
+    trace( "item before initializing: %#lx, %p\n", hr, product );
 
     hr = IWSCProductList_Initialize( list, provider );
     ok( hr == S_OK, "provider %#lx: got %#lx\n", provider, hr );
@@ -152,9 +190,11 @@ static void test_product_list(ULONG provider)
         trace( "  state %u, signatures %u\n", state, signatures );
         if (state == WSC_SECURITY_PRODUCT_STATE_ON && signatures == WSC_SECURITY_PRODUCT_UP_TO_DATE) good_found = TRUE;
 
+        /* Windows's own firewall has none, and says so as a string */
         hr = IWscProduct_get_ProductGuid( product, &str );
         ok( hr == S_OK, "got %#lx\n", hr );
-        ok( str && str[0] == '{', "got guid %s\n", wine_dbgstr_w(str) );
+        ok( str && (str[0] == '{' || !wcscmp( str, L"NULL" )), "got guid %s\n", wine_dbgstr_w(str) );
+        trace( "  guid %s\n", wine_dbgstr_w(str) );
         SysFreeString( str );
 
         hr = IWscProduct_get_RemediationPath( product, &str );
@@ -171,13 +211,14 @@ static void test_product_list(ULONG provider)
         ok( hr == S_OK, "got %#lx\n", hr );
         trace( "  default %d\n", is_default );
 
+        trace_product_details( product );
         IWscProduct_Release( product );
     }
 
     product = (IWscProduct *)0xdeadbeef;
     hr = IWSCProductList_get_Item( list, count, &product );
-    trace( "item past the end: %#lx, %p\n", hr, product );
-    ok( FAILED(hr), "got %#lx\n", hr );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( product == (IWscProduct *)0xdeadbeef, "got %p\n", product );
 
     /* the health of the antivirus is the state of the products */
     if (provider == WSC_SECURITY_PROVIDER_ANTIVIRUS && antivirus_health == WSC_SECURITY_PROVIDER_HEALTH_GOOD)
@@ -197,12 +238,13 @@ static void test_product_list_initialize(void)
     ok( hr == S_OK, "got %#lx\n", hr );
     if (FAILED(hr)) return;
 
+    /* only antivirus, antispyware and firewall products are listed */
     hr = IWSCProductList_Initialize( list, WSC_SECURITY_PROVIDER_AUTOUPDATE_SETTINGS );
-    trace( "initializing for automatic updates: %#lx\n", hr );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
     hr = IWSCProductList_Initialize( list, WSC_SECURITY_PROVIDER_ANTIVIRUS );
-    trace( "initializing for an antivirus after that: %#lx\n", hr );
+    ok( hr == S_OK, "got %#lx\n", hr );
     hr = IWSCProductList_Initialize( list, WSC_SECURITY_PROVIDER_ANTIVIRUS );
-    trace( "initializing a second time: %#lx\n", hr );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_ALREADY_INITIALIZED ), "got %#lx\n", hr );
     IWSCProductList_Release( list );
 }
 
