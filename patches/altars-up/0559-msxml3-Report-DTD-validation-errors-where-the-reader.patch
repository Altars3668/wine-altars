-/* the first error DTD validation raises, as MSXML names it */
+/* DTD validation as MSXML does it: in the order the reader meets things, each error at the start tag,
+ * the text or the end tag it is about, where the reader was then.  libxml2 validates a tree, and in
+ * another order, so each error it raises is placed in reading order and the first one is kept.  The
+ * nodes of the tree are numbered for that in document order. */
+struct dtd_validation
+{
+    xmlDocPtr doc;
+    HRESULT code;
+    ULONG_PTR key;          /* place in reading order: twice the node's number, plus one for its end tag */
+    int rank;               /* order of errors in one place */
+    xmlNodePtr node;        /* the node it is at, NULL for the end of the document */
+    BOOL end_tag;
+};
+
+static void dtd_number_nodes(xmlNodePtr node, ULONG_PTR *count)
+{
+    for (; node; node = node->next)
+    {
+        node->_private = (void *)++*count;
+        if (node->type == XML_ELEMENT_NODE) dtd_number_nodes(node->children, count);
+    }
+}
+
+static ULONG_PTR dtd_error_key(xmlNodePtr node, BOOL end_tag)
+{
+    if (!node) return ~(ULONG_PTR)0;
+    if (end_tag) while (node->last && node->type == XML_ELEMENT_NODE) node = node->last;
+    return 2 * (ULONG_PTR)node->_private + (end_tag ? 1 : 0);
+}
+
+static xmlElementPtr dtd_element_decl(xmlDocPtr doc, xmlNodePtr elem)
+{
+    xmlElementPtr decl = NULL;
+
+    if (!doc->intSubset) return NULL;
+    if (elem->ns && elem->ns->prefix) decl = xmlGetDtdQElementDesc(doc->intSubset, elem->name, elem->ns->prefix);
+    if (!decl) decl = xmlGetDtdElementDesc(doc->intSubset, elem->name);
+    return decl;
+}
+
+/* the name an element has in the DTD's content models */
+static const xmlChar *dtd_element_name(xmlNodePtr elem, xmlChar *buffer, int size)
+{
+    if (!elem->ns || !elem->ns->prefix) return elem->name;
+    return xmlBuildQName(elem->name, elem->ns->prefix, buffer, size);
+}
+
+static BOOL dtd_mixed_allows(xmlElementContentPtr content, const xmlChar *name)
+{
+    for (; content; content = content->c2)
+    {
+        xmlElementContentPtr item = content->type == XML_ELEMENT_CONTENT_OR ? content->c1 : content;
+        if (item && item->type == XML_ELEMENT_CONTENT_ELEMENT)
+        {
+            xmlChar buffer[64], *qname = item->prefix ? xmlBuildQName(item->name, item->prefix, buffer, sizeof(buffer)) : (xmlChar *)item->name;
+            BOOL match = xmlStrEqual(qname, name);
+            if (qname != item->name && qname != buffer) xmlFree(qname);
+            if (match) return TRUE;
+        }
+        if (content->type != XML_ELEMENT_CONTENT_OR) break;
+    }
+    return FALSE;
+}
+
+/* content the DTD does not allow: text where it may not be, an element that may not come there,
+ * or, at the end tag, elements missing; MSXML names each, where the reader meets it */
+static HRESULT dtd_content_error(xmlDocPtr doc, xmlNodePtr elem, xmlNodePtr *at, BOOL *end_tag)
+{
+    xmlElementPtr decl = dtd_element_decl(doc, elem);
+    xmlRegExecCtxtPtr exec = NULL;
+    BOOL elements = FALSE;
+    xmlNodePtr child;
+    HRESULT code = 0;
+
+    *at = elem;
+    *end_tag = FALSE;
+    if (!decl) return E_XML_INVALID_CONTENT;
+    if (decl->etype == XML_ELEMENT_TYPE_ELEMENT && decl->contModel)
+        exec = xmlRegNewExecCtxt(decl->contModel, NULL, NULL);
+    for (child = elem->children; child && !code; child = child->next)
+    {
+        xmlChar buffer[64];
+        const xmlChar *name;
+
+        switch (child->type)
+        {
+        case XML_TEXT_NODE:
+        case XML_CDATA_SECTION_NODE:
+            if (decl->etype == XML_ELEMENT_TYPE_EMPTY ||
+                    (decl->etype == XML_ELEMENT_TYPE_ELEMENT && !xmlIsBlankNode(child)))
+            {
+                code = E_XML_ILLEGAL_TEXT;
+                *at = child;
+            }
+            break;
+        case XML_ELEMENT_NODE:
+            elements = TRUE;
+            name = dtd_element_name(child, buffer, sizeof(buffer));
+            if (decl->etype == XML_ELEMENT_TYPE_EMPTY ||
+                    (decl->etype == XML_ELEMENT_TYPE_MIXED && !dtd_mixed_allows(decl->content, name)) ||
+                    (exec && xmlRegExecPushString(exec, name, NULL) < 0))
+            {
+                code = E_XML_INVALID_CONTENT;
+                *at = child;
+            }
+            if (name != child->name && name != buffer) xmlFree((xmlChar *)name);
+            break;
+        default:
+            break;
+        }
+    }
+    if (!code && decl->etype == XML_ELEMENT_TYPE_ELEMENT)
+    {
+        *end_tag = TRUE;
+        if (!elements) code = E_XML_EMPTY_NOT_ALLOWED;
+        else if (!exec || xmlRegExecPushString(exec, NULL, NULL) != 1) code = E_XML_ELEMENT_NOT_COMPLETE;
+        else code = E_XML_INVALID_CONTENT;
+    }
+    if (exec) xmlRegFreeExecCtxt(exec);
+    return code ? code : E_XML_INVALID_CONTENT;
+}
+
+/* a value of a type that is one name, or one name token: MSXML reads it as such */
+static HRESULT dtd_attribute_value_error(xmlDocPtr doc, xmlNodePtr elem, const char *attr_name)
+{
+    HRESULT code = E_XML_ATTRIBUTE_VALUE;
+    xmlAttributePtr decl;
+    xmlChar *value, *p, *end;
+
+    if (!doc->intSubset || !elem || !attr_name) return code;
+    if (!(decl = xmlGetDtdAttrDesc(doc->intSubset, elem->name, (const xmlChar *)attr_name))) return code;
+    if (decl->atype != XML_ATTRIBUTE_ID && decl->atype != XML_ATTRIBUTE_IDREF &&
+            decl->atype != XML_ATTRIBUTE_ENTITY && decl->atype != XML_ATTRIBUTE_NMTOKEN) return code;
+    if (!(value = xmlGetProp(elem, (const xmlChar *)attr_name))) return code;
+    for (p = value; xml_is_space(*p); p++);
+    for (end = p + xmlStrlen(p); end > p && xml_is_space(end[-1]); end--);
+    *end = 0;
+    if (xmlStrchr(p, ' ') || xmlStrchr(p, '\t') || xmlStrchr(p, '\r') || xmlStrchr(p, '\n'))
+        code = E_SAX_MULTIPLE_NAMES;
+    else if (decl->atype != XML_ATTRIBUTE_NMTOKEN && !xmlValidateNameValue(p) && xmlValidateNmtokenValue(p))
+        code = E_SAX_BADSTARTNAMECHAR;
+    xmlFree(value);
+    return code;
+}
+
 static void dtd_validation_error(void *ctx, const xmlError *error)
 {
-    HRESULT *code = ctx;
-    xmlNodePtr child, node = error->node;
-    BOOL elements = FALSE, text = FALSE;
+    struct dtd_validation *v = ctx;
+    xmlNodePtr node = error->node, at = node;
+    BOOL end_tag = FALSE;
+    ULONG_PTR key;
+    HRESULT code;
+    int rank;
 
     TRACE("%d: %s", error->code, debugstr_a(error->message));
-    if (*code || error->domain != XML_FROM_VALID || error->level < XML_ERR_ERROR) return;
+    if (error->domain != XML_FROM_VALID || error->level < XML_ERR_ERROR) return;
+    if (node && node->type != XML_ELEMENT_NODE) node = at = NULL;
+    /* at the start tag of an element: whether its parent may have it there, then whether the root
+     * is the DOCTYPE's, whether it is declared, its attributes, the ones it lacks */
     switch (error->code)
     {
-    case XML_DTD_UNKNOWN_ELEM: *code = E_XML_ELEMENT_UNDECLARED; break;
-    case XML_DTD_UNKNOWN_ID: *code = E_XML_ELEMENT_ID_NOT_FOUND; break;
-    case XML_DTD_ROOT_NAME: *code = E_XML_ROOT_NAME_MISMATCH; break;
-    case XML_DTD_UNKNOWN_ATTRIBUTE: *code = E_XML_ATTRIBUTE_NOT_DEFINED; break;
-    case XML_DTD_ATTRIBUTE_DEFAULT: *code = E_XML_ATTRIBUTE_FIXED; break;
-    case XML_DTD_ATTRIBUTE_VALUE: *code = E_XML_ATTRIBUTE_VALUE; break;
-    case XML_DTD_MISSING_ATTRIBUTE: *code = E_XML_REQUIRED_ATTRIBUTE_MISSING; break;
     case XML_DTD_CONTENT_MODEL:
     case XML_DTD_NOT_EMPTY:
     case XML_DTD_NOT_PCDATA:
-        /* MSXML tells apart text where only elements may be, no elements where some must be,
-         * and the wrong elements */
-        for (child = node && node->type == XML_ELEMENT_NODE ? node->children : NULL; child; child = child->next)
-        {
-            if (child->type == XML_ELEMENT_NODE) elements = TRUE;
-            else if ((child->type == XML_TEXT_NODE || child->type == XML_CDATA_SECTION_NODE) &&
-                    !xmlIsBlankNode(child)) text = TRUE;
-        }
-        if (error->code == XML_DTD_CONTENT_MODEL && text) *code = E_XML_ILLEGAL_TEXT;
-        else if (error->code == XML_DTD_CONTENT_MODEL && !elements) *code = E_XML_EMPTY_NOT_ALLOWED;
-        else *code = E_XML_INVALID_CONTENT;
-        break;
-    default:
-        *code = E_XML_INVALID;
+    case XML_DTD_INVALID_CHILD:
+        code = node ? dtd_content_error(v->doc, node, &at, &end_tag) : E_XML_INVALID_CONTENT;
+        rank = 0;
         break;
-    }
+    case XML_DTD_ROOT_NAME: code = E_XML_ROOT_NAME_MISMATCH; rank = 1; break;
+    case XML_DTD_UNKNOWN_ELEM: code = E_XML_ELEMENT_UNDECLARED; rank = 2; break;
+    case XML_DTD_UNKNOWN_ATTRIBUTE: code = E_XML_ATTRIBUTE_NOT_DEFINED; rank = 3; break;
+    case XML_DTD_ATTRIBUTE_DEFAULT: code = E_XML_ATTRIBUTE_FIXED; rank = 3; break;
+    case XML_DTD_ATTRIBUTE_VALUE: code = dtd_attribute_value_error(v->doc, node, error->str1); rank = 3; break;
+    case XML_DTD_ID_REDEFINED: code = E_XML_DUPLICATE_ID; rank = 3; break;
+    case XML_DTD_MISSING_ATTRIBUTE: code = E_XML_REQUIRED_ATTRIBUTE_MISSING; rank = 4; break;
+    /* checked when the whole document has been read */
+    case XML_DTD_UNKNOWN_ID: code = E_XML_ELEMENT_ID_NOT_FOUND; at = NULL; rank = 5; break;
+    default: code = E_XML_INVALID; rank = 5; break;
+    }
+    key = dtd_error_key(at, end_tag);
+    if (v->code && (key > v->key || (key == v->key && rank >= v->rank))) return;
+    v->code = code;
+    v->key = key;
+    v->rank = rank;
+    v->node = at;
+    v->end_tag = end_tag;
 }
 
 static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, struct parse_error *error)
@@ -5262,19 +5482,30 @@ static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, str
         xmlValidCtxtPtr context = xmlNewValidCtxt();
         xmlStructuredErrorFunc handler = xmlStructuredError;
         void *handler_context = xmlStructuredErrorContext;
-        HRESULT code = S_OK;
