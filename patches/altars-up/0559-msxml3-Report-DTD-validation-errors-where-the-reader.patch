diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index ae48396231a..fb7ba2a0592 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -20403,6 +20403,155 @@ static void test_load_pending_stream(void)
     }
 }
 
+/* Validating against the DTD as it reads, Windows reports the first error it meets, where it meets it:
+ * at the end of the start tag of an element that is undeclared, has attributes it may not have or
+ * lacks some, or may not come where it is; at the start of text that may not be where it is; at the
+ * name in the end tag of an element whose content is incomplete; and at the end of the document, with
+ * no offset or line, for an IDREF to no ID.  validate() on a document loaded without validation
+ * names the same errors at no position. */
+static void test_dtd_validation_errors(void)
+{
+    static const struct
