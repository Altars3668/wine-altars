From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 17:02:14 -0400
Subject: [PATCH] mfplat: Give the transforms MFTEnumEx finds in the registry
 their name and both lists of types.

On Windows an activation object MFTEnumEx returns for a registered
transform carries its friendly name and its input and output types,
whatever the enumeration was filtered on.  Wine never read the name,
and read the types only on the side it filtered.  Office looks for a
WebP decoder this way.  The test passes on Windows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 3adedf3ee055d92c9c4a1df216df06d755e343b0)

diff --git a/dlls/mfplat/main.c b/dlls/mfplat/main.c
index c739e27cf01..ae3219084e2 100644
--- a/dlls/mfplat/main.c
+++ b/dlls/mfplat/main.c
@@ -1103,6 +1103,34 @@ static void mft_get_reg_flags(const WCHAR *clsidW, const WCHAR *nameW, DWORD *fl
     RegCloseKey(hmft);
 }
 
+static void mft_get_reg_name(const WCHAR *clsidW, WCHAR **name)
+{
+    DWORD reg_type, size;
+    HKEY hroot, hmft;
+    LONG ret;
+
+    *name = NULL;
+
+    if (RegOpenKeyW(HKEY_CLASSES_ROOT, transform_keyW, &hroot))
+        return;
+    ret = RegOpenKeyW(hroot, clsidW, &hmft);
+    RegCloseKey(hroot);
+    if (ret)
+        return;
+
+    if (!RegQueryValueExW(hmft, NULL, NULL, &reg_type, NULL, &size) && reg_type == REG_SZ && size
+            && (*name = malloc(size + sizeof(WCHAR))))
+    {
+        if (RegQueryValueExW(hmft, NULL, NULL, &reg_type, (BYTE *)*name, &size))
+        {
+            free(*name);
+            *name = NULL;
+        }
+        else (*name)[size / sizeof(WCHAR)] = 0;
+    }
+    RegCloseKey(hmft);
+}
+
 static HRESULT mft_collect_machine_reg(struct list *mfts, const GUID *category, UINT32 flags,
         IMFPluginControl *plugin_control, const MFT_REGISTER_TYPE_INFO *input_type,
         const MFT_REGISTER_TYPE_INFO *output_type)
@@ -1132,11 +1160,9 @@ static HRESULT mft_collect_machine_reg(struct list *mfts, const GUID *category,
 
         mft_get_reg_flags(clsidW, L"MFTFlags", &mft.flags);
 
-        if (output_type)
-            mft_get_reg_type_info_internal(clsidW, L"OutputTypes", &mft.output_types, &mft.output_types_count);
-
-        if (input_type)
-            mft_get_reg_type_info_internal(clsidW, L"InputTypes", &mft.input_types, &mft.input_types_count);
+        /* the activation objects carry the name and the types, whatever was asked for */
+        mft_get_reg_type_info_internal(clsidW, L"OutputTypes", &mft.output_types, &mft.output_types_count);
+        mft_get_reg_type_info_internal(clsidW, L"InputTypes", &mft.input_types, &mft.input_types_count);
 
         if (!mft_is_type_info_match(&mft, category, flags, plugin_control, input_type, output_type))
         {
@@ -1144,6 +1170,7 @@ static HRESULT mft_collect_machine_reg(struct list *mfts, const GUID *category,
             free(mft.output_types);
             goto next;
         }
+        mft_get_reg_name(clsidW, &mft.name);
 
         cur = malloc(sizeof(*cur));
         /* Reuse allocated type arrays. */
diff --git a/dlls/mfplat/tests/mfplat.c b/dlls/mfplat/tests/mfplat.c
index 155708aa958..3d25dce9925 100644
--- a/dlls/mfplat/tests/mfplat.c
+++ b/dlls/mfplat/tests/mfplat.c
@@ -1094,6 +1094,44 @@ if(0)
     ok(!count, "got %d\n", count);
     ok(clsids == NULL, "Expected clsids == NULL\n");
 
+    /* the activation objects carry the name and both lists of types, whatever the enumeration asked for */
+    if (pMFTEnumEx)
+    {
+        IMFActivate **activates;
+        UINT32 i, size;
+        UINT8 *blob;
+        BOOL found = FALSE;
+        GUID clsid;
+
+        ret = MFTRegister(DUMMY_CLSID, MFT_CATEGORY_OTHER, name, 0, 1, input, 1, output, NULL);
+        ok(ret == S_OK, "Failed to register dummy transform, hr %#lx.\n", ret);
+        hr = pMFTEnumEx(MFT_CATEGORY_OTHER, MFT_ENUM_FLAG_SYNCMFT, input, NULL, &activates, &count);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        for (i = 0; SUCCEEDED(hr) && i < count; i++)
+        {
+            if (SUCCEEDED(IMFActivate_GetGUID(activates[i], &MFT_TRANSFORM_CLSID_Attribute, &clsid))
+                    && IsEqualGUID(&clsid, &DUMMY_CLSID))
+            {
+                found = TRUE;
+                hr = IMFActivate_GetAllocatedString(activates[i], &MFT_FRIENDLY_NAME_Attribute, &mft_name, &size);
+                ok(hr == S_OK && !lstrcmpW(mft_name, L"Wine test"), "Unexpected hr %#lx, name %s.\n", hr,
+                        hr == S_OK ? wine_dbgstr_w(mft_name) : "");
+                if (hr == S_OK) CoTaskMemFree(mft_name);
+                hr = IMFActivate_GetAllocatedBlob(activates[i], &MFT_INPUT_TYPES_Attributes, &blob, &size);
+                ok(hr == S_OK && size == sizeof(input) && !memcmp(blob, input, size), "Unexpected hr %#lx, size %u.\n",
+                        hr, size);
+                if (hr == S_OK) CoTaskMemFree(blob);
+                hr = IMFActivate_GetAllocatedBlob(activates[i], &MFT_OUTPUT_TYPES_Attributes, &blob, &size);
+                ok(hr == S_OK && size == sizeof(output) && !memcmp(blob, output, size),
+                        "Unexpected hr %#lx, size %u.\n", hr, size);
+                if (hr == S_OK) CoTaskMemFree(blob);
+            }
+            IMFActivate_Release(activates[i]);
+        }
+        ok(found, "Transform was not part of enumeration.\n");
+        CoTaskMemFree(activates);
+    }
+
     ret = MFTUnregister(DUMMY_CLSID);
     ok(ret == S_OK ||
        /* w7pro64 */
