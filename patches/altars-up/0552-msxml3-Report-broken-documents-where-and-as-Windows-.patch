+        { "<1a/>", 0xc00ce504 /* XML_E_BADSTARTNAMECHAR */, 1, 2, 1, L"<1a/>" },
+        { "<a b='<'/>", 0xc00ce506 /* XML_E_BADCHARINSTRING */, 1, 7, 6, L"<a b='<'/>" },
+        { "<a b=1/>", 0xc00ce502 /* XML_E_MISSINGQUOTE */, 1, 6, 5, L"<a b=1/>" },
+        { "<a>\n  <b>\n</a>", 0xc00ce56d, 3, 3, 12, L"</a>" },
