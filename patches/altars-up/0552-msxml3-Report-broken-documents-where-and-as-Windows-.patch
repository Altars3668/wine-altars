@@ -1417,8 +1491,8 @@ static HRESULT WINAPI domdoc_get_parseError(IXMLDOMDocument3 *iface, IXMLDOMPars
 {
     domdoc *doc = impl_from_IXMLDOMDocument3(iface);
     const struct parse_error *error = &doc->parse_error;
-    BSTR error_string = NULL;
