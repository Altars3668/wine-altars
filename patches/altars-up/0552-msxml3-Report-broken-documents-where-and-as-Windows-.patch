+        { "<a b='1' b='2'/>", 0xc00ce554 /* XML_E_DUPLICATEATTRIBUTE */, 1, 17, 16, L"<a b='1' b='2'/>" },
+        { "<a>\x01</a>", 0xc00ce508 /* XML_E_BADCHARDATA */, 1, 4, 3, L"<a>\x01</a>" },
+        { "<?xml version='2.0'?><a/>", 0xc00ce57f /* XML_E_INVALID_VERSION */, 1, 16, 15,
+          L"<?xml version='2.0'?><a/>" },
+        { "<a/><b/>", 0xc00ce555 /* XML_E_MULTIPLEROOTS */, 1, 6, 5, L"<a/><b/>" },
+        { "text", 0xc00ce556 /* XML_E_INVALIDATROOTLEVEL */, 1, 1, 0, L"text" },
