 }
@@ -1515,6 +1591,7 @@ static HRESULT WINAPI domdoc_loadXML(IXMLDOMDocument3 *iface, BSTR data, VARIANT
         if (SUCCEEDED(hr = stream_wrapper_create(ptr, lstrlenW(ptr) * sizeof(WCHAR), &stream)))
         {
             hr = parse_stream(stream, true, doc->node->properties, &node, &error);
+            if (FAILED(hr)) parse_error_set_source(&error, ptr, lstrlenW(ptr));
