@@ -273,9 +273,67 @@ static HRESULT WINAPI PersistStreamInit_IsDirty(IPersistStreamInit *iface)
 static void domdoc_set_parse_error(domdoc *doc, struct parse_error *error)
 {
     SysFreeString(doc->parse_error.reason);
+    SysFreeString(doc->parse_error.srctext);
     doc->parse_error = *error;
 }
 
+/* the line an error is on and where in the text it is, from the text parsed */
+static void parse_error_set_source(struct parse_error *error, const WCHAR *text, size_t len)
+{
+    size_t start = 0, end, i;
+    LONG line = 1;
+
+    if (!error->code || error->line <= 0 || !text) return;
+    for (i = 0; i < len && line < error->line; i++)
+    {
+        if (text[i] == '\r' && i + 1 < len && text[i + 1] == '\n') i++;
+        if (text[i] == '\r' || text[i] == '\n')
+        {
+            line++;
+            start = i + 1;
+        }
+    }
+    if (line != error->line) return;
+    for (end = start; end < len && text[end] != '\r' && text[end] != '\n'; end++);
+    error->srctext = SysAllocStringLen(text + start, end - start);
+    error->filepos = start + max(error->linepos, 1) - 1;
+}
+
+/* the same for text in bytes: UTF-16 when it says so or looks so, else UTF-8 */
+static void parse_error_set_source_bytes(struct parse_error *error, const BYTE *data, size_t size)
+{
+    WCHAR *text;
+    int len;
+
+    if (!error->code || error->line <= 0 || !data || !size) return;
+    if (size >= 2 && data[0] == 0xff && data[1] == 0xfe)
+        return parse_error_set_source(error, (const WCHAR *)(data + 2), (size - 2) / sizeof(WCHAR));
+    if (size >= 2 && data[0] && !data[1])
+        return parse_error_set_source(error, (const WCHAR *)data, size / sizeof(WCHAR));
+    if (size >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf)
+    {
+        data += 3;
+        size -= 3;
+    }
+    if (!(len = MultiByteToWideChar(CP_UTF8, 0, (const char *)data, size, NULL, 0))) return;
+    if (!(text = malloc(len * sizeof(WCHAR)))) return;
+    MultiByteToWideChar(CP_UTF8, 0, (const char *)data, size, text, len);
+    parse_error_set_source(error, text, len);
+    free(text);
+}
+
+/* nothing to parse: the parser's error for it, at no position, as on Windows */
+static void domdoc_set_missing_root_error(domdoc *doc)
+{
+    struct parse_error error = { E_SAX_MISSINGROOT };
+    WCHAR msg[1024];
+
+    if (FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_FROM_HMODULE, MSXML_hInstance,
+            E_SAX_MISSINGROOT, 0, msg, ARRAY_SIZE(msg), NULL))
+        error.reason = SysAllocString(msg);
+    domdoc_set_parse_error(doc, &error);
+}
+
 static HRESULT domdoc_load_from_stream(domdoc *doc, ISequentialStream *stream)
 {
     struct parse_error error;
@@ -283,6 +341,7 @@ static HRESULT domdoc_load_from_stream(domdoc *doc, ISequentialStream *stream)
     struct domnode *node;
