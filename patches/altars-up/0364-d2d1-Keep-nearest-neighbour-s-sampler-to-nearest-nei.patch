From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 06:15:39 -0400
Subject: [PATCH] d2d1: Keep nearest neighbour's sampler to nearest neighbour.

A bitmap brush's sampler was picked by its interpolation mode modulo
two, so cubic and anisotropic took nearest neighbour's slot: whichever
of them a context drew first decided how the others were filtered.
Cubic images came out blocky after a nearest neighbour draw, and
nearest neighbour ones blurred after a cubic one.  Nearest neighbour
now has its slot to itself; every other mode is drawn linearly, as
before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/d2d1/brush.c b/dlls/d2d1/brush.c
index 800ac99f664..aa827f81a1c 100644
--- a/dlls/d2d1/brush.c
+++ b/dlls/d2d1/brush.c
@@ -1708,8 +1708,10 @@ static void d2d_brush_bind_bitmap(struct d2d_bitmap *bitmap, struct d2d_device_c
     ID3D11Device1_GetImmediateContext(context->d3d_device, &d3d_context);
     ID3D11DeviceContext_PSSetShaderResources(d3d_context, brush_idx, 1, &bitmap->srv);
 
+    /* Point sampling is only for nearest neighbour; the modes Direct3D has no filter for are drawn linearly,
+     * and must not share nearest neighbour's sampler. */
     sampler_state = &context->sampler_states
-            [interpolation_mode % D2D_SAMPLER_INTERPOLATION_MODE_COUNT]
+            [interpolation_mode == D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR ? 0 : 1]
             [extend_mode_x % D2D_SAMPLER_EXTEND_MODE_COUNT]
             [extend_mode_y % D2D_SAMPLER_EXTEND_MODE_COUNT];
 
diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index faa6e0346b7..8e830846cda 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -21368,6 +21368,73 @@ static void test_glyph_run_world_bounds(BOOL d3d11)
     release_test_context(&ctx);
 }
 
+/* Each mode is drawn with its own sampling whatever was drawn before it: two texels, black and white,
+ * stretched over 64 pixels, are a step with nearest neighbour and a ramp with every other mode. */
+static void test_bitmap_interpolation_modes(BOOL d3d11)
+{
+    static const DWORD bitmap_data[] = {0xff000000, 0xffffffff};
+    static const D2D1_INTERPOLATION_MODE modes[] =
+    {
+        D2D1_INTERPOLATION_MODE_CUBIC,
+        D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR,
+        D2D1_INTERPOLATION_MODE_ANISOTROPIC,
+        D2D1_INTERPOLATION_MODE_LINEAR,
+        D2D1_INTERPOLATION_MODE_HIGH_QUALITY_CUBIC,
+        D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR,
+    };
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc = {{DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_IGNORE}, 96.0f, 96.0f};
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    unsigned int i, j, pass;
+    ID2D1Bitmap1 *bitmap;
+    D2D1_COLOR_F colour;
+    BYTE left, right;
+    D2D1_SIZE_U size;
+    D2D1_RECT_F dst;
+    HRESULT hr;
+
+    /* the second pass draws them in the opposite order: cubic comes first once and nearest neighbour
+     * once, as whichever came first used to decide the sampling of both */
+    for (pass = 0; pass < 2; ++pass)
+    {
+        if (!init_test_context(&ctx, d3d11))
+            return;
+
+        set_size_u(&size, 2, 1);
+        hr = ID2D1DeviceContext_CreateBitmap(ctx.context, size, bitmap_data, sizeof(bitmap_data), &bitmap_desc, &bitmap);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+        ID2D1DeviceContext_BeginDraw(ctx.context);
+        set_color(&colour, 0.0f, 0.0f, 1.0f, 1.0f);
+        ID2D1DeviceContext_Clear(ctx.context, &colour);
+        for (i = 0; i < ARRAY_SIZE(modes); ++i)
+        {
+            j = pass ? ARRAY_SIZE(modes) - 1 - i : i;
+            set_rect(&dst, 0.0f, 8.0f * j, 64.0f, 8.0f * j + 4.0f);
+            ID2D1DeviceContext_DrawBitmap(ctx.context, (ID2D1Bitmap *)bitmap, &dst, 1.0f, modes[j], NULL, NULL);
+        }
+        hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+        get_surface_readback(&ctx, &rb);
+        for (i = 0; i < ARRAY_SIZE(modes); ++i)
+        {
+            winetest_push_context("pass %u, mode %#x", pass, modes[i]);
+            left = get_readback_colour(&rb, 24, 8 * i + 2) & 0xff;
+            right = get_readback_colour(&rb, 40, 8 * i + 2) & 0xff;
+            if (modes[i] == D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR)
+                ok(left == 0x00 && right == 0xff, "Got %#x, %#x.\n", left, right);
+            else
+                ok(left > 0x10 && left < 0x80 && right > 0x80 && right < 0xf0, "Got %#x, %#x.\n", left, right);
+            winetest_pop_context();
+        }
+        release_resource_readback(&rb);
+
+        ID2D1Bitmap1_Release(bitmap);
+        release_test_context(&ctx);
+    }
+}
+
 static void test_sprite_batch(BOOL d3d11)
 {
     D2D1_MATRIX_3X2_F transforms[4];
@@ -21856,6 +21923,7 @@ START_TEST(d2d1)
     queue_d3d10_test(test_transformed_geometry);
     queue_d3d10_test(test_glyph_run_world_bounds);
     queue_test(test_sprite_batch);
+    queue_test(test_bitmap_interpolation_modes);
 
     run_queued_tests();
 }
