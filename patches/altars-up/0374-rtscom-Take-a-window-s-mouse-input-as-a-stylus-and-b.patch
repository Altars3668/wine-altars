+static HRESULT WINAPI plugin_QueryInterface(IStylusSyncPlugin *iface, REFIID riid, void **out)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_IStylusPlugin)
+            || IsEqualGUID(riid, &IID_IStylusSyncPlugin))
+    {
+        *out = iface;
+        IStylusSyncPlugin_AddRef(iface);
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
