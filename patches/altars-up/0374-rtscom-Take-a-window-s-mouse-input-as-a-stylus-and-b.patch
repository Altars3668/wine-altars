+static HRESULT add_plugin( struct rtstylus *This, struct plugin **plugins, ULONG *count, ULONG index,
+        IStylusPlugin *plugin )
+{
+    RealTimeStylusDataInterest interest = RTSDI_DefaultEvents;
+    struct plugin *array;
+    HRESULT hr;
+
+    if (!plugin) return E_POINTER;
+    if (index > *count) return E_INVALIDARG;
+    if (FAILED(hr = IStylusPlugin_DataInterest( plugin, &interest )))
+        WARN( "Plugin %p gives no data interest, hr %#lx.\n", plugin, hr );
+    TRACE( "Plugin %p wants %#x.\n", plugin, interest );
+
+    EnterCriticalSection( &This->cs );
+    if (index > *count)
+    {
+        LeaveCriticalSection( &This->cs );
+        return E_INVALIDARG;
+    }
+    if (!(array = realloc( *plugins, (*count + 1) * sizeof(*array) )))
+    {
+        LeaveCriticalSection( &This->cs );
+        return E_OUTOFMEMORY;
+    }
+    memmove( array + index + 1, array + index, (*count - index) * sizeof(*array) );
+    array[index].plugin = plugin;
+    array[index].interest = interest;
+    IStylusPlugin_AddRef( plugin );
+    *plugins = array;
+    (*count)++;
+    LeaveCriticalSection( &This->cs );
+    return S_OK;
+}
+
+static HRESULT remove_plugin( struct rtstylus *This, struct plugin *plugins, ULONG *count, ULONG index,
+        IStylusPlugin **removed )
+{
+    IStylusPlugin *plugin;
+
+    EnterCriticalSection( &This->cs );
+    if (index >= *count)
+    {
+        LeaveCriticalSection( &This->cs );
+        return E_INVALIDARG;
+    }
+    plugin = plugins[index].plugin;
+    memmove( plugins + index, plugins + index + 1, (*count - index - 1) * sizeof(*plugins) );
+    (*count)--;
+    LeaveCriticalSection( &This->cs );
+
+    if (removed) *removed = plugin;
+    else IStylusPlugin_Release( plugin );
+    return S_OK;
+}
+
+static HRESULT get_plugin( struct rtstylus *This, struct plugin *plugins, ULONG count, ULONG index,
+        REFIID iid, void **out )
+{
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    EnterCriticalSection( &This->cs );
+    if (index >= count) hr = E_INVALIDARG;
+    else hr = IStylusPlugin_QueryInterface( plugins[index].plugin, iid, out );
+    LeaveCriticalSection( &This->cs );
+    return hr;
+}
