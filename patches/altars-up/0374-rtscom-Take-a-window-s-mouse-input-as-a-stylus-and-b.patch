+static HRESULT WINAPI rtstylus_AddCustomStylusDataToQueue(IRealTimeStylus *iface, StylusQueue sq, const GUID *pGuidId,
+                                                          ULONG cbData, BYTE *pbData)
+{
+    struct rtstylus *This = impl_from_IRealTimeStylus(iface);
+    struct event *event;
+    size_t size = offsetof( struct event, data[cbData] );
+
+    TRACE( "%p, %d, %s, %lu, %p\n", This, sq, debugstr_guid( pGuidId ), cbData, pbData );
+
+    if (!pGuidId || (cbData && !pbData)) return E_INVALIDARG;
+    if (sq != SyncStylusQueue && sq != AsyncStylusQueueImmediate && sq != AsyncStylusQueue) return E_INVALIDARG;
+    if (!(event = calloc( 1, size ))) return E_OUTOFMEMORY;
+    event->type = NOTIFY_CUSTOM;
+    event->guid = *pGuidId;
+    event->size = cbData;
+    memcpy( event->data, pbData, cbData );
+
+    /* the sync queue reaches every plugin in order; the async ones only the async plugins */
+    if (sq == SyncStylusQueue)
+        dispatch_event( This, event, size );
+    else
+        notify( This, event, TRUE );
+    free( event );
+    return S_OK;
+}
