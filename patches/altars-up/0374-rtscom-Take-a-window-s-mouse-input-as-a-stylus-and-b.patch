+/* X and Y in HIMETRIC over the virtual screen, a thousand to the centimetre */
+static HRESULT WINAPI rtstylus_GetPacketDescriptionData(IRealTimeStylus *iface, TABLET_CONTEXT_ID tcid, FLOAT *pfInkToDeviceScaleX,
+                                                        FLOAT *pfInkToDeviceScaleY, ULONG *pcPacketProperties, PACKET_PROPERTY **ppPacketProperties)
+{
+    struct rtstylus *This = impl_from_IRealTimeStylus(iface);
+    int dpi_x, dpi_y, width, height;
+    PACKET_PROPERTY *properties;
+    GUID guids[3];
+    ULONG count, i;
+    HDC hdc;
+
+    TRACE( "%p, %lu, %p, %p, %p, %p\n", This, tcid, pfInkToDeviceScaleX, pfInkToDeviceScaleY, pcPacketProperties, ppPacketProperties );
+
+    if (!pcPacketProperties || !ppPacketProperties) return E_POINTER;
+    if (tcid != MOUSE_TABLET_CONTEXT) return E_INVALIDARG;
+
+    hdc = GetDC( 0 );
+    dpi_x = GetDeviceCaps( hdc, LOGPIXELSX );
+    dpi_y = GetDeviceCaps( hdc, LOGPIXELSY );
+    ReleaseDC( 0, hdc );
+    width = GetSystemMetrics( SM_CXVIRTUALSCREEN );
+    height = GetSystemMetrics( SM_CYVIRTUALSCREEN );
+
+    EnterCriticalSection( &This->cs );
+    count = mouse_description( This, guids );
+    LeaveCriticalSection( &This->cs );
+    if (!(properties = CoTaskMemAlloc( count * sizeof(*properties) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        properties[i].guid = guids[i];
+        if (IsEqualGUID( &guids[i], &GUID_PACKETPROPERTY_GUID_X ))
+        {
+            properties[i].PropertyMetrics.nLogicalMin = 0;
+            properties[i].PropertyMetrics.nLogicalMax = MulDiv( width, HIMETRIC_PER_INCH, dpi_x );
+            properties[i].PropertyMetrics.Units = PROPERTY_UNITS_CENTIMETERS;
+            properties[i].PropertyMetrics.fResolution = 1000.0f;
+        }
+        else if (IsEqualGUID( &guids[i], &GUID_PACKETPROPERTY_GUID_Y ))
+        {
+            properties[i].PropertyMetrics.nLogicalMin = 0;
+            properties[i].PropertyMetrics.nLogicalMax = MulDiv( height, HIMETRIC_PER_INCH, dpi_y );
+            properties[i].PropertyMetrics.Units = PROPERTY_UNITS_CENTIMETERS;
+            properties[i].PropertyMetrics.fResolution = 1000.0f;
+        }
+        else
+        {
+            properties[i].PropertyMetrics.nLogicalMin = 0;
+            properties[i].PropertyMetrics.nLogicalMax = IP_CURSOR_DOWN;
+            properties[i].PropertyMetrics.Units = PROPERTY_UNITS_DEFAULT;
+            properties[i].PropertyMetrics.fResolution = 1.0f;
+        }
