 #include <stdarg.h>
 
 #define COBJMACROS
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "ole2.h"
+#include "ocidl.h"
+#include <initguid.h>
+#include "oleidl.h"
+#include "rpcproxy.h"
+#include "rtscom.h"
+#include "wine/inkobj.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(rtscom);
+
+DEFINE_GUID(GUID_PACKETPROPERTY_GUID_X, 0x598a6a8f, 0x52c0, 0x4ba0, 0x93, 0xaf, 0xaf, 0x35, 0x74, 0x11, 0xa5, 0x61);
+DEFINE_GUID(GUID_PACKETPROPERTY_GUID_Y, 0xb53f9f75, 0x04e0, 0x4498, 0xa7, 0xee, 0xc3, 0x0d, 0xbb, 0x5a, 0x90, 0x11);
+DEFINE_GUID(GUID_PACKETPROPERTY_GUID_NORMAL_PRESSURE, 0x7307502d, 0xf9f4, 0x4e18, 0xb3, 0xf2, 0x2c, 0xe1, 0xb1, 0xa3, 0x61, 0x0c);
+DEFINE_GUID(GUID_PACKETPROPERTY_GUID_PACKET_STATUS, 0x6e0e07bf, 0xafe7, 0x4cf7, 0x87, 0xd1, 0xaf, 0x64, 0x46, 0x20, 0x84, 0x18);
+
+/* the mouse is the one tablet there is, with one stylus: not measured what numbers Windows gives them */
+#define MOUSE_TABLET_CONTEXT 1
+#define MOUSE_STYLUS 1
+
+/* packet status bits */
+#define IP_CURSOR_DOWN 0x1
+
+#define HIMETRIC_PER_INCH 2540
+
+#define WM_RTS_ASYNC (WM_USER + 1)
+
+struct plugin
+{
+    IStylusPlugin *plugin;
+    RealTimeStylusDataInterest interest;
+};
+
+struct rtstylus
+{
+    IRealTimeStylus IRealTimeStylus_iface;
+    IRealTimeStylus2 IRealTimeStylus2_iface;
+    IRealTimeStylus3 IRealTimeStylus3_iface;
+    IRealTimeStylusSynchronization IRealTimeStylusSynchronization_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    BOOL enabled;
+    HWND hwnd;
+    RECT input_rect;
+    struct plugin *sync_plugins;
+    ULONG sync_count;
+    struct plugin *async_plugins;
+    ULONG async_count;
+    IRealTimeStylus *child;
+    BOOL use_mouse;
+    IInkTablet *single_tablet;
+    GUID *desired;
+    ULONG desired_count;
+    BOOL flicks;
+    BOOL multi_touch;
+
+    /* input, taken on the window's thread */
+    struct list entry;
+    DWORD thread;
+    BOOL hooked;
+    HWND async_window;
+    BOOL down;
+    BOOL in_range;
+};
+
+static CRITICAL_SECTION styluses_cs;
+static CRITICAL_SECTION_DEBUG styluses_cs_debug =
+{
+    0, 0, &styluses_cs,
+    { &styluses_cs_debug.ProcessLocksList, &styluses_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": styluses_cs") }
+};
+static CRITICAL_SECTION styluses_cs = { &styluses_cs_debug, -1, 0, 0, 0, 0 };
+static struct list enabled_styluses = LIST_INIT(enabled_styluses);
+
+/* one mouse hook for each thread with windows that give input to styluses */
+struct thread_hook
+{
+    struct list entry;
+    DWORD thread;
+    HHOOK hook;
+    unsigned int count;
+};
+
+static struct list thread_hooks = LIST_INIT(thread_hooks);
+
+static HINSTANCE rtscom_instance;
+
+static struct rtstylus *impl_from_IRealTimeStylus( IRealTimeStylus *iface )
+{
+    return CONTAINING_RECORD( iface, struct rtstylus, IRealTimeStylus_iface );
+}
+
+static struct rtstylus *impl_from_IRealTimeStylus2( IRealTimeStylus2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct rtstylus, IRealTimeStylus2_iface );
+}
+
+static struct rtstylus *impl_from_IRealTimeStylus3( IRealTimeStylus3 *iface )
+{
+    return CONTAINING_RECORD( iface, struct rtstylus, IRealTimeStylus3_iface );
+}
+
+static struct rtstylus *impl_from_IRealTimeStylusSynchronization( IRealTimeStylusSynchronization *iface )
+{
+    return CONTAINING_RECORD( iface, struct rtstylus, IRealTimeStylusSynchronization_iface );
+}
+
+/* the packet description the mouse gives: X and Y always, and its status when asked for */
+static ULONG mouse_description( struct rtstylus *This, GUID *guids )
+{
+    ULONG count = 0, i;
+
+    guids[count++] = GUID_PACKETPROPERTY_GUID_X;
+    guids[count++] = GUID_PACKETPROPERTY_GUID_Y;
+    for (i = 0; i < This->desired_count; i++)
+        if (IsEqualGUID( &This->desired[i], &GUID_PACKETPROPERTY_GUID_PACKET_STATUS ))
+            guids[count++] = GUID_PACKETPROPERTY_GUID_PACKET_STATUS;
+    return count;
+}
+
+/* a mouse position in HIMETRIC from the window's client origin */
+static ULONG mouse_packet( struct rtstylus *This, POINT pt, BOOL down, LONG *packet )
+{
+    GUID guids[3];
+    ULONG count = mouse_description( This, guids ), i;
+    HDC hdc = GetDC( This->hwnd );
+    int dpi_x = GetDeviceCaps( hdc, LOGPIXELSX ), dpi_y = GetDeviceCaps( hdc, LOGPIXELSY );
+
+    ReleaseDC( This->hwnd, hdc );
+    ScreenToClient( This->hwnd, &pt );
+    for (i = 0; i < count; i++)
+    {
+        if (IsEqualGUID( &guids[i], &GUID_PACKETPROPERTY_GUID_X ))
+            packet[i] = MulDiv( pt.x, HIMETRIC_PER_INCH, dpi_x );
+        else if (IsEqualGUID( &guids[i], &GUID_PACKETPROPERTY_GUID_Y ))
+            packet[i] = MulDiv( pt.y, HIMETRIC_PER_INCH, dpi_y );
+        else
+            packet[i] = down ? IP_CURSOR_DOWN : 0;
+    }
+    return count;
+}
+
+enum notification
+{
+    NOTIFY_ENABLED,
+    NOTIFY_DISABLED,
+    NOTIFY_IN_RANGE,
+    NOTIFY_OUT_OF_RANGE,
+    NOTIFY_DOWN,
+    NOTIFY_PACKETS,
+    NOTIFY_UP,
+    NOTIFY_IN_AIR,
+    NOTIFY_CUSTOM,
+};
+
+struct event
+{
+    enum notification type;
+    ULONG count;
+    LONG packet[32];
+    GUID guid;
+    ULONG size;
+    BYTE data[];
+};
+
+static const RealTimeStylusDataInterest event_interest[] =
+{
+    [NOTIFY_ENABLED] = RTSDI_RealTimeStylusEnabled,
+    [NOTIFY_DISABLED] = RTSDI_RealTimeStylusDisabled,
+    [NOTIFY_IN_RANGE] = RTSDI_StylusInRange,
+    [NOTIFY_OUT_OF_RANGE] = RTSDI_StylusOutOfRange,
+    [NOTIFY_DOWN] = RTSDI_StylusDown,
+    [NOTIFY_PACKETS] = RTSDI_Packets,
+    [NOTIFY_UP] = RTSDI_StylusUp,
+    [NOTIFY_IN_AIR] = RTSDI_InAirPackets,
+    [NOTIFY_CUSTOM] = RTSDI_CustomStylusDataAdded,
+};
+
+/* each plugin sees the packets the ones before it passed on */
+static void notify_plugin( struct rtstylus *This, IStylusPlugin *plugin, struct event *event )
+{
+    IRealTimeStylus *rts = &This->IRealTimeStylus_iface;
+    StylusInfo info = {MOUSE_TABLET_CONTEXT, MOUSE_STYLUS, FALSE};
+    TABLET_CONTEXT_ID tcid = MOUSE_TABLET_CONTEXT;
+    LONG *changed = NULL;
+    ULONG changed_count = 0;
+    HRESULT hr = S_OK;
+
+    switch (event->type)
+    {
+    case NOTIFY_ENABLED:
+        hr = IStylusPlugin_RealTimeStylusEnabled( plugin, rts, 1, &tcid );
+        break;
+    case NOTIFY_DISABLED:
+        hr = IStylusPlugin_RealTimeStylusDisabled( plugin, rts, 1, &tcid );
+        break;
+    case NOTIFY_IN_RANGE:
+        hr = IStylusPlugin_StylusInRange( plugin, rts, MOUSE_TABLET_CONTEXT, MOUSE_STYLUS );
+        break;
+    case NOTIFY_OUT_OF_RANGE:
+        hr = IStylusPlugin_StylusOutOfRange( plugin, rts, MOUSE_TABLET_CONTEXT, MOUSE_STYLUS );
+        break;
+    case NOTIFY_DOWN:
+        hr = IStylusPlugin_StylusDown( plugin, rts, &info, event->count, event->packet, &changed );
+        break;
+    case NOTIFY_UP:
+        hr = IStylusPlugin_StylusUp( plugin, rts, &info, event->count, event->packet, &changed );
+        break;
+    case NOTIFY_PACKETS:
+        hr = IStylusPlugin_Packets( plugin, rts, &info, 1, event->count, event->packet, &changed_count, &changed );
+        break;
+    case NOTIFY_IN_AIR:
+        hr = IStylusPlugin_InAirPackets( plugin, rts, &info, 1, event->count, event->packet, &changed_count, &changed );
+        break;
+    case NOTIFY_CUSTOM:
+        hr = IStylusPlugin_CustomStylusDataAdded( plugin, rts, &event->guid, event->size, event->size ? event->data : NULL );
+        break;
+    }
+    if (FAILED(hr))
+        WARN( "Plugin %p failed notification %d, hr %#lx.\n", plugin, event->type, hr );
+    if (changed && changed != event->packet)
+        memcpy( event->packet, changed, event->count * sizeof(*changed) );
+}
+
+/* the plugins are called without the lock held, as they may call back */
+static void notify( struct rtstylus *This, struct event *event, BOOL async )
+{
+    RealTimeStylusDataInterest interest = event_interest[event->type];
+    struct plugin *plugins;
+    ULONG count, i;
+
+    EnterCriticalSection( &This->cs );
+    count = async ? This->async_count : This->sync_count;
+    if (!(plugins = malloc( max( 1, count ) * sizeof(*plugins) )))
+    {
+        LeaveCriticalSection( &This->cs );
+        return;
+    }
+    memcpy( plugins, async ? This->async_plugins : This->sync_plugins, count * sizeof(*plugins) );
+    for (i = 0; i < count; i++) IStylusPlugin_AddRef( plugins[i].plugin );
+    LeaveCriticalSection( &This->cs );
+
+    for (i = 0; i < count; i++)
+    {
+        if (plugins[i].interest & interest)
+            notify_plugin( This, plugins[i].plugin, event );
+        IStylusPlugin_Release( plugins[i].plugin );
+    }
+    free( plugins );
+}
+
+static LRESULT CALLBACK async_window_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_RTS_ASYNC)
+    {
+        struct rtstylus *This = (struct rtstylus *)wparam;
+        struct event *event = (struct event *)lparam;
+
+        notify( This, event, TRUE );
+        free( event );
+        IRealTimeStylus_Release( &This->IRealTimeStylus_iface );
+        return 0;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static HWND create_async_window(void)
+{
+    static const WCHAR class_name[] = L"__wine_rtscom_async";
+    WNDCLASSW class = {0};
+
+    class.lpfnWndProc = async_window_proc;
+    class.hInstance = rtscom_instance;
+    class.lpszClassName = class_name;
+    RegisterClassW( &class );
+    return CreateWindowW( class_name, NULL, 0, 0, 0, 0, 0, HWND_MESSAGE, NULL, rtscom_instance, NULL );
+}
+
+/* sync plugins now, on the window's thread; async plugins after, from its message queue */
+static void dispatch_event( struct rtstylus *This, struct event *event, size_t size )
+{
+    struct event *copy;
+
+    notify( This, event, FALSE );
+
+    if (!This->async_count) return;
+    if (!This->async_window && !(This->async_window = create_async_window()))
+    {
+        notify( This, event, TRUE );
+        return;
+    }
+    if (!(copy = malloc( size ))) return;
+    memcpy( copy, event, size );
+    IRealTimeStylus_AddRef( &This->IRealTimeStylus_iface );
+    if (!PostMessageW( This->async_window, WM_RTS_ASYNC, (WPARAM)This, (LPARAM)copy ))
+    {
+        free( copy );
+        IRealTimeStylus_Release( &This->IRealTimeStylus_iface );
+    }
+}
+
+static BOOL point_in_input( struct rtstylus *This, POINT pt )
+{
+    RECT rect;
+
+    if (IsRectEmpty( &This->input_rect ))
+    {
+        GetClientRect( This->hwnd, &rect );
+        MapWindowPoints( This->hwnd, HWND_DESKTOP, (POINT *)&rect, 2 );
+    }
+    else
+    {
+        rect = This->input_rect;
+        MapWindowPoints( This->hwnd, HWND_DESKTOP, (POINT *)&rect, 2 );
+    }
+    return PtInRect( &rect, pt );
+}
+
+static void handle_mouse( struct rtstylus *This, UINT msg, POINT pt )
+{
+    struct event event = {0};
+    BOOL inside = point_in_input( This, pt );
+
+    switch (msg)
+    {
+    case WM_LBUTTONDOWN:
+        if (!inside || This->down) return;
+        This->down = TRUE;
+        event.type = NOTIFY_DOWN;
+        break;
+    case WM_LBUTTONUP:
+        if (!This->down) return;
+        This->down = FALSE;
+        event.type = NOTIFY_UP;
+        break;
+    case WM_MOUSEMOVE:
+        if (This->down) event.type = NOTIFY_PACKETS;
+        else if (inside)
+        {
+            if (!This->in_range)
+            {
+                struct event range = {NOTIFY_IN_RANGE};
+
+                This->in_range = TRUE;
+                dispatch_event( This, &range, sizeof(range) );
+            }
+            event.type = NOTIFY_IN_AIR;
+        }
+        else
+        {
+            if (This->in_range)
+            {
+                struct event range = {NOTIFY_OUT_OF_RANGE};
+
+                This->in_range = FALSE;
+                dispatch_event( This, &range, sizeof(range) );
+            }
+            return;
+        }
+        break;
+    default:
+        return;
+    }
+
+    event.count = mouse_packet( This, pt, This->down || msg == WM_LBUTTONUP, event.packet );
+    TRACE( "%p, event %d at %ld, %ld.\n", This, event.type, event.packet[0], event.packet[1] );
+    dispatch_event( This, &event, sizeof(event) );
+}
+
+static LRESULT CALLBACK mouse_hook( int code, WPARAM wparam, LPARAM lparam )
+{
+    MOUSEHOOKSTRUCT *info = (MOUSEHOOKSTRUCT *)lparam;
+    struct rtstylus *This, *targets[8];
+    struct thread_hook *thread_hook;
+    unsigned int count = 0, i;
+    HHOOK hook = NULL;
+
+    EnterCriticalSection( &styluses_cs );
+    LIST_FOR_EACH_ENTRY( thread_hook, &thread_hooks, struct thread_hook, entry )
+        if (thread_hook->thread == GetCurrentThreadId()) hook = thread_hook->hook;
+    LIST_FOR_EACH_ENTRY( This, &enabled_styluses, struct rtstylus, entry )
+    {
+        if (This->thread != GetCurrentThreadId()) continue;
+        if (code != HC_ACTION || !This->use_mouse) continue;
+        if (info->hwnd != This->hwnd && !IsChild( This->hwnd, info->hwnd ) && !This->down) continue;
+        if (count == ARRAY_SIZE(targets)) break;
+        IRealTimeStylus_AddRef( &This->IRealTimeStylus_iface );
+        targets[count++] = This;
+    }
+    LeaveCriticalSection( &styluses_cs );
+
+    for (i = 0; i < count; i++)
+    {
+        handle_mouse( targets[i], wparam, info->pt );
+        IRealTimeStylus_Release( &targets[i]->IRealTimeStylus_iface );
+    }
+    return CallNextHookEx( hook, code, wparam, lparam );
+}
+
+static HRESULT start_input( struct rtstylus *This )
+{
+    struct thread_hook *thread_hook;
+    HRESULT hr = S_OK;
+
+    This->thread = GetWindowThreadProcessId( This->hwnd, NULL );
+
+    EnterCriticalSection( &styluses_cs );
+    LIST_FOR_EACH_ENTRY( thread_hook, &thread_hooks, struct thread_hook, entry )
+        if (thread_hook->thread == This->thread) break;
+    if (&thread_hook->entry == &thread_hooks)
+    {
+        if (!(thread_hook = calloc( 1, sizeof(*thread_hook) )))
+            hr = E_OUTOFMEMORY;
+        else if (!(thread_hook->hook = SetWindowsHookExW( WH_MOUSE, mouse_hook, NULL, This->thread )))
+        {
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+            free( thread_hook );
+        }
+        else
+        {
+            thread_hook->thread = This->thread;
+            list_add_tail( &thread_hooks, &thread_hook->entry );
+        }
+    }
+    if (SUCCEEDED(hr))
+    {
+        thread_hook->count++;
+        list_add_tail( &enabled_styluses, &This->entry );
+        This->hooked = TRUE;
+    }
+    LeaveCriticalSection( &styluses_cs );
+    return hr;
+}
+
+static void stop_input( struct rtstylus *This )
+{
+    struct thread_hook *thread_hook;
+
+    EnterCriticalSection( &styluses_cs );
+    list_remove( &This->entry );
+    LIST_FOR_EACH_ENTRY( thread_hook, &thread_hooks, struct thread_hook, entry )
+    {
+        if (thread_hook->thread != This->thread) continue;
+        if (!--thread_hook->count)
+        {
+            UnhookWindowsHookEx( thread_hook->hook );
+            list_remove( &thread_hook->entry );
+            free( thread_hook );
+        }
+        break;
+    }
+    LeaveCriticalSection( &styluses_cs );
+    This->hooked = FALSE;
+    This->down = This->in_range = FALSE;
+}
+
+static HRESULT WINAPI rtstylus_QueryInterface(IRealTimeStylus *iface, REFIID iid, void **obj)
+{
+    struct rtstylus *This = impl_from_IRealTimeStylus(iface);
+
+    TRACE( "(%p)->(%s %p)\n", This, debugstr_guid( iid ), obj );
+
+    if (IsEqualIID( iid, &IID_IUnknown ) ||
+        IsEqualIID( iid, &IID_IRealTimeStylus ))
+        *obj = &This->IRealTimeStylus_iface;
+    else if (IsEqualIID( iid, &IID_IRealTimeStylus2 ))
+        *obj = &This->IRealTimeStylus2_iface;
+    else if (IsEqualIID( iid, &IID_IRealTimeStylus3 ))
+        *obj = &This->IRealTimeStylus3_iface;
+    else if (IsEqualIID( iid, &IID_IRealTimeStylusSynchronization ))
+        *obj = &This->IRealTimeStylusSynchronization_iface;
+    else
+    {
+        WARN( "interface %s not implemented\n", debugstr_guid( iid ) );
+        *obj = NULL;
+        return E_NOINTERFACE;
+    }
+
+    IUnknown_AddRef( (IUnknown *)*obj );
+    return S_OK;
+}
+
+static ULONG WINAPI rtstylus_AddRef(IRealTimeStylus *iface)
+{
+    struct rtstylus *This = impl_from_IRealTimeStylus(iface);
+    ULONG ref = InterlockedIncrement( &This->ref );
+
+    TRACE( "(%p) ref = %lu\n", This, ref );
+    return ref;
+}
+
+static void release_plugins( struct plugin *plugins, ULONG count )
+{
+    ULONG i;
+
+    for (i = 0; i < count; i++)
+        IStylusPlugin_Release( plugins[i].plugin );
+}
