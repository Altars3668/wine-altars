+static HRESULT WINAPI rtstylus_ClearStylusQueues(IRealTimeStylus *iface)
+{
+    struct rtstylus *This = impl_from_IRealTimeStylus(iface);
+    MSG msg;
+
+    TRACE( "%p\n", This );
+
+    if (This->async_window && GetCurrentThreadId() == This->thread)
+    {
+        while (PeekMessageW( &msg, This->async_window, WM_RTS_ASYNC, WM_RTS_ASYNC, PM_REMOVE ))
+        {
+            free( (void *)msg.lParam );
+            IRealTimeStylus_Release( &This->IRealTimeStylus_iface );
+        }
+    }
+    return S_OK;
+}
