+/* the window's mouse input is taken from its own thread, by a hook there */
+static HRESULT WINAPI rtstylus_put_Enabled(IRealTimeStylus *iface, BOOL fEnable)
+{
+    struct rtstylus *This = impl_from_IRealTimeStylus(iface);
+    struct event event = {0};
+    HRESULT hr = S_OK;
+
+    TRACE( "%p, %d\n", This, fEnable );
+
+    EnterCriticalSection( &This->cs );
+    if (!fEnable == !This->enabled)
+    {
+        LeaveCriticalSection( &This->cs );
+        return S_OK;
+    }
+    if (fEnable)
+    {
+        if (!This->hwnd || !IsWindow( This->hwnd ))
+            hr = HRESULT_FROM_WIN32( ERROR_INVALID_WINDOW_HANDLE );
+        else if (SUCCEEDED(hr = start_input( This )))
+            This->enabled = TRUE;
+    }
+    else
+    {
+        stop_input( This );
+        This->enabled = FALSE;
+    }
+    LeaveCriticalSection( &This->cs );
+
+    if (SUCCEEDED(hr))
+    {
+        event.type = fEnable ? NOTIFY_ENABLED : NOTIFY_DISABLED;
+        notify( This, &event, FALSE );
+        notify( This, &event, TRUE );
+    }
+    return hr;
+}
