+static ULONG WINAPI rtstylus_Release(IRealTimeStylus *iface)
+{
+    struct rtstylus *This = impl_from_IRealTimeStylus(iface);
+    ULONG ref = InterlockedDecrement(&This->ref);
+
+    TRACE( "(%p) ref = %lu\n", This, ref );
+
+    if (!ref)
+    {
+        if (This->hooked) stop_input( This );
+        if (This->async_window) PostMessageW( This->async_window, WM_CLOSE, 0, 0 );
+        release_plugins( This->sync_plugins, This->sync_count );
+        release_plugins( This->async_plugins, This->async_count );
+        free( This->sync_plugins );
+        free( This->async_plugins );
+        if (This->child) IRealTimeStylus_Release( This->child );
+        if (This->single_tablet) IInkTablet_Release( This->single_tablet );
+        free( This->desired );
+        This->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &This->cs );
+        free( This );
+    }
+
+    return ref;
+}
