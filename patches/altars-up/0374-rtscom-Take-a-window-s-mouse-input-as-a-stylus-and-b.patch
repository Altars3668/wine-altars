+static void test_realtime_stylus(void)
+{
+    struct plugin plugin = {{&plugin_vtbl}, 1, 0, 0, RTSDI_AllData};
+    IStylusSyncPlugin *out;
+    IRealTimeStylus *rts;
+    IUnknown *unk;
+    ULONG count, i;
+    GUID *guids;
+    HANDLE_PTR hwnd_value;
+    BOOL enabled;
+    HWND hwnd;
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_RealTimeStylus, NULL, CLSCTX_INPROC_SERVER, &IID_IRealTimeStylus, (void **)&rts);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK) return;
+
+    hr = IRealTimeStylus_QueryInterface(rts, &IID_IRealTimeStylus3, (void **)&unk);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr == S_OK) IUnknown_Release(unk);
+    hr = IRealTimeStylus_QueryInterface(rts, &IID_IRealTimeStylusSynchronization, (void **)&unk);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr == S_OK) IUnknown_Release(unk);
+
+    hr = IRealTimeStylus_get_Enabled(rts, &enabled);
+    ok(hr == S_OK && !enabled, "Got hr %#lx, enabled %d.\n", hr, enabled);
+    hr = IRealTimeStylus_get_HWND(rts, &hwnd_value);
+    ok(hr == S_OK && !hwnd_value, "Got hr %#lx, hwnd %#Ix.\n", hr, hwnd_value);
+
+    hr = IRealTimeStylus_GetDesiredPacketDescription(rts, &count, &guids);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(count >= 2 && IsEqualGUID(&guids[0], &GUID_X) && IsEqualGUID(&guids[1], &GUID_Y), "Got %lu properties.\n", count);
+    for (i = 0; i < count; ++i) trace("desired %lu: %s\n", i, wine_dbgstr_guid(&guids[i]));
+    CoTaskMemFree(guids);
+
+    hr = IRealTimeStylus_GetStylusSyncPluginCount(rts, &count);
+    ok(hr == S_OK && !count, "Got hr %#lx, count %lu.\n", hr, count);
+    hr = IRealTimeStylus_AddStylusSyncPlugin(rts, 1, &plugin.IStylusSyncPlugin_iface);
+    ok(FAILED(hr), "Got hr %#lx.\n", hr);
+    hr = IRealTimeStylus_AddStylusSyncPlugin(rts, 0, &plugin.IStylusSyncPlugin_iface);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(plugin.interest_calls == 1, "Got %ld calls.\n", plugin.interest_calls);
+    ok(plugin.refcount == 2, "Got refcount %ld.\n", plugin.refcount);
+    hr = IRealTimeStylus_GetStylusSyncPluginCount(rts, &count);
+    ok(hr == S_OK && count == 1, "Got hr %#lx, count %lu.\n", hr, count);
+    hr = IRealTimeStylus_GetStylusSyncPlugin(rts, 0, &out);
+    ok(hr == S_OK && out == &plugin.IStylusSyncPlugin_iface, "Got hr %#lx, plugin %p.\n", hr, out);
+    if (hr == S_OK) IStylusSyncPlugin_Release(out);
+
+    hwnd = CreateWindowA("static", "rtscom", WS_POPUP, 0, 0, 100, 100, NULL, NULL, NULL, NULL);
+    hr = IRealTimeStylus_put_HWND(rts, (HANDLE_PTR)hwnd);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IRealTimeStylus_put_Enabled(rts, TRUE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(plugin.enabled_calls == 1, "Got %ld calls.\n", plugin.enabled_calls);
+    hr = IRealTimeStylus_get_Enabled(rts, &enabled);
+    ok(hr == S_OK && enabled, "Got hr %#lx, enabled %d.\n", hr, enabled);
+    hr = IRealTimeStylus_put_Enabled(rts, FALSE);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    out = NULL;
+    hr = IRealTimeStylus_RemoveStylusSyncPlugin(rts, 0, &out);
+    ok(hr == S_OK && out == &plugin.IStylusSyncPlugin_iface, "Got hr %#lx, plugin %p.\n", hr, out);
+    if (out) IStylusSyncPlugin_Release(out);
+    ok(plugin.refcount == 1, "Got refcount %ld.\n", plugin.refcount);
+
+    IRealTimeStylus_Release(rts);
+    DestroyWindow(hwnd);
+}
+
+static void test_stroke_builder(void)
+{
+    static const LONG packets[] = {100, 200, 300, 400, 500, 600};
+    PACKET_PROPERTY properties[2] = {{GUID_X}, {GUID_Y}};
+    IInkStrokeDisp *stroke, *ended;
+    IStrokeBuilder *builder;
+    IInkStrokes *strokes;
+    IInkDisp *ink, *got;
+    IUnknown *unk;
+    LONG count;
+    RECT dirty;
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_StrokeBuilder, NULL, CLSCTX_INPROC_SERVER, &IID_IStrokeBuilder, (void **)&builder);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK) return;
+
+    hr = IStrokeBuilder_QueryInterface(builder, &IID_IStylusAsyncPlugin, (void **)&unk);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr == S_OK) IUnknown_Release(unk);
+    hr = IStrokeBuilder_QueryInterface(builder, &IID_IStylusSyncPlugin, (void **)&unk);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr == S_OK) IUnknown_Release(unk);
+
+    hr = CoCreateInstance(&CLSID_InkDisp, NULL, CLSCTX_INPROC_SERVER, &IID_IInkDisp, (void **)&ink);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr != S_OK)
+    {
+        IStrokeBuilder_Release(builder);
+        return;
+    }
+    hr = IStrokeBuilder_putref_Ink(builder, ink);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IStrokeBuilder_get_Ink(builder, &got);
+    ok(hr == S_OK && got == ink, "Got hr %#lx, ink %p.\n", hr, got);
+    if (hr == S_OK) IInkDisp_Release(got);
+
+    hr = IStrokeBuilder_CreateStroke(builder, ARRAY_SIZE(packets), packets, 2, properties, 1.0f, 1.0f, &stroke);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokeDisp_get_PacketCount(stroke, &count);
+    ok(hr == S_OK && count == 3, "Got hr %#lx, count %ld.\n", hr, count);
+    IInkStrokeDisp_Release(stroke);
+
+    stroke = NULL;
+    hr = IStrokeBuilder_BeginStroke(builder, 1, 1, packets, 2, properties, 1.0f, 1.0f, &stroke);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IStrokeBuilder_AppendPackets(builder, 1, 1, 4, packets + 2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IStrokeBuilder_AppendPackets(builder, 1, 2, 2, packets);
+    ok(FAILED(hr), "Got hr %#lx.\n", hr);
+    hr = IStrokeBuilder_EndStroke(builder, 1, 1, &ended, &dirty);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (hr == S_OK)
+    {
+        LONG id1, id2;
+
+        IInkStrokeDisp_get_ID(ended, &id1);
+        IInkStrokeDisp_get_ID(stroke, &id2);
+        ok(id1 == id2, "Got ids %ld, %ld.\n", id1, id2);
+        hr = IInkStrokeDisp_get_PacketCount(ended, &count);
+        ok(hr == S_OK && count == 3, "Got hr %#lx, count %ld.\n", hr, count);
+        ok(dirty.left <= 100 && dirty.right >= 500, "Got %s.\n", wine_dbgstr_rect(&dirty));
+        IInkStrokeDisp_Release(ended);
+    }
+    if (stroke) IInkStrokeDisp_Release(stroke);
+    hr = IStrokeBuilder_EndStroke(builder, 1, 1, &ended, &dirty);
+    ok(FAILED(hr), "Got hr %#lx.\n", hr);
+
+    hr = IInkDisp_get_Strokes(ink, &strokes);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IInkStrokes_get_Count(strokes, &count);
+    ok(hr == S_OK && count == 2, "Got hr %#lx, count %ld.\n", hr, count);
+    IInkStrokes_Release(strokes);
+
+    IInkDisp_Release(ink);
+    IStrokeBuilder_Release(builder);
+}
+
+START_TEST(rtscom)
+{
+    CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+
+    test_realtime_stylus();
+    test_stroke_builder();
+
+    CoUninitialize();
+}
