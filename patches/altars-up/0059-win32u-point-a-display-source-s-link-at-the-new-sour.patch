From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 07:49:55 -0400
Subject: [PATCH] win32u: point a display source's link at the new source when
 the host replaces an output.

Word on a phone's remote desktop still came out framed at the old size
after the phone was turned, and later clipped to 1024x768 for the rest of
the session.  The configuration each process read back was not the one
that had just been committed.

Every source is reached through a link key named by its enumeration order,
pointing at a key named after the driver's own source.  Re-pointing a link
that already existed opened it by name with REG_OPTION_OPEN_LINK, which does
not open the link itself -- on Windows either, only OBJ_OPENLINK does -- so
the name resolved to the old target, the new target was written into that
key as an ordinary value, and the link kept pointing where it did.

A host that keeps its outputs never noticed.  Xwayland gives every output it
is handed a new id, and gnome-remote-desktop hands it a new output whenever
a client reconnects or turns round; the same link name then has to point at
a different source.  Left behind, it made the session read the old output's
modes, so the monitor kept its old size; once the old output had been one of
two, its key named a monitor that no longer existed, the stored
configuration could not be read at all, and every process was given the
1024x768 stand-in until the wineserver went away.

Open an existing link with OBJ_OPENLINK and set its target there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit a17547ac2d0b699c50d6f8b75b8785efe9a7eb1c)

diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 4640bf47f55..05384404b56 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -1843,29 +1843,56 @@ static void add_gpu( const char *name, const struct pci_id *pci_id, const GUID *
     if (opengl_gpu) free_gpu_info( opengl_gpu );
 }
 
+/* Point the link key name at target, creating the link if it is not there yet.
+ *
+ * A link that already exists has to be opened as the link, with OBJ_OPENLINK,
+ * to be pointed anywhere else.  Opened by name like any other key it resolves
+ * to the key it points at now -- REG_OPTION_OPEN_LINK does not change that, on
+ * Windows either -- and the new target is written into that key as an
+ * ordinary value while the link goes on pointing where it did.
+ *
+ * The source links are where this shows.  They are named by enumeration order
+ * and point at keys named after the driver's own sources, so when the host
+ * replaces an output the same name has to point somewhere new: Xwayland gives
+ * every output it is handed a new id, and a remote desktop client that is
+ * reconnected or turned round is handed a new output.  A link left behind
+ * makes the session read the modes and monitors of an output that is gone --
+ * its old resolution, or a monitor that no longer exists, after which every
+ * process is given the 1024x768 stand-in, for as long as the session lasts. */
+static BOOL set_reg_link( HKEY root, const char *name, const char *target )
+{
+    WCHAR nameW[MAX_PATH], targetW[MAX_PATH];
+    UNICODE_STRING str = { 0, 0, nameW };
+    OBJECT_ATTRIBUTES attr;
+    unsigned int len;
+    HANDLE hkey;
+
+    if (!(hkey = reg_create_ascii_key( root, name, REG_OPTION_VOLATILE | REG_OPTION_CREATE_LINK, NULL )))
+    {
+        str.Length = str.MaximumLength = asciiz_to_unicode( nameW, name ) - sizeof(WCHAR);
+        InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE | OBJ_OPENLINK, root, NULL );
+        if (NtOpenKeyEx( &hkey, MAXIMUM_ALLOWED, &attr, 0 )) return FALSE;
+    }
+
+    len = asciiz_to_unicode( targetW, target ) - sizeof(WCHAR);
+    set_reg_value( hkey, symbolic_link_valueW, REG_LINK, targetW, len );
+    NtClose( hkey );
+    return TRUE;
+}
+
 static BOOL write_source_to_registry( struct source *source )
 {
     struct gpu *gpu = source->gpu;
-    unsigned int len, source_index = gpu->source_count;
-    char name[64], buffer[MAX_PATH];
-    WCHAR bufferW[MAX_PATH];
-    HKEY hkey;
+    unsigned int source_index = gpu->source_count;
+    char name[64], buffer[MAX_PATH], target[MAX_PATH];
 
     snprintf( buffer, sizeof(buffer), "%s\\Video\\%s\\%04x", control_keyA, gpu->guid, source_index );
-    len = asciiz_to_unicode( bufferW, buffer ) - sizeof(WCHAR);
-
-    hkey = reg_create_ascii_key( NULL, buffer, REG_OPTION_VOLATILE | REG_OPTION_CREATE_LINK, NULL );
-    if (!hkey) hkey = reg_create_ascii_key( NULL, buffer, REG_OPTION_VOLATILE | REG_OPTION_OPEN_LINK, NULL );
 
     snprintf( name, sizeof(name), "\\Device\\Video%u", source->id );
     set_reg_ascii_value( video_key, name, buffer );
 
-    if (!hkey) return FALSE;
-
-    snprintf( buffer, sizeof(buffer), "%s\\Class\\%s\\%04X", control_keyA, guid_devclass_displayA, gpu->index );
-    len = asciiz_to_unicode( bufferW, buffer ) - sizeof(WCHAR);
-    set_reg_value( hkey, symbolic_link_valueW, REG_LINK, bufferW, len );
-    NtClose( hkey );
+    snprintf( target, sizeof(target), "%s\\Class\\%s\\%04X", control_keyA, guid_devclass_displayA, gpu->index );
+    if (!set_reg_link( NULL, buffer, target )) return FALSE;
 
     /* Following information is Wine specific, it doesn't really exist on Windows. */
     source->key = reg_create_ascii_key( NULL, source->path, REG_OPTION_VOLATILE, NULL );
@@ -1875,12 +1902,7 @@ static BOOL write_source_to_registry( struct source *source )
     set_reg_value( source->key, dpiW, REG_DWORD, &source->dpi, sizeof(source->dpi) );
 
     snprintf( buffer, sizeof(buffer), "System\\CurrentControlSet\\Control\\Video\\%s\\%04x", gpu->guid, source_index );
-    hkey = reg_create_ascii_key( config_key, buffer, REG_OPTION_VOLATILE | REG_OPTION_CREATE_LINK, NULL );
-    if (!hkey) hkey = reg_create_ascii_key( config_key, buffer, REG_OPTION_VOLATILE | REG_OPTION_OPEN_LINK, NULL );
-
-    len = asciiz_to_unicode( bufferW, source->path ) - sizeof(WCHAR);
-    set_reg_value( hkey, symbolic_link_valueW, REG_LINK, bufferW, len );
-    NtClose( hkey );
+    set_reg_link( config_key, buffer, source->path );
 
     return TRUE;
 }
