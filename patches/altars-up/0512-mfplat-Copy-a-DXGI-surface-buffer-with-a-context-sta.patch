From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 00:16:16 -0400
Subject: [PATCH] mfplat: Copy a DXGI surface buffer with a context state of
 its own.

Locking and unlocking a DXGI surface buffer copies between the texture
and the readback texture through the immediate context of the
application's device, which drops the copies while a state emulating
ID3D10Device is active.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/mfplat/buffer.c b/dlls/mfplat/buffer.c
index 0ab7cd0336d..fed2fa5dc64 100644
--- a/dlls/mfplat/buffer.c
+++ b/dlls/mfplat/buffer.c
@@ -26,6 +26,7 @@
 #include "d3d11.h"
 #include "mfd3d12.h"
 #include "initguid.h"
+#include "d3d11_1.h"
 #include "d3d9.h"
 #include "evr.h"
 
@@ -996,6 +997,35 @@ static HRESULT dxgi_surface_buffer_create_readback_texture(struct buffer *buffer
     return hr;
 }
 
+/* The copies are made with a state of our own: the application's device may have one emulating ID3D10Device
+ * active, which drops them. */
+static void dxgi_surface_buffer_copy(ID3D11Device *device, ID3D11Resource *dst, UINT dst_idx, ID3D11Resource *src,
+        UINT src_idx)
+{
+    ID3DDeviceContextState *state = NULL, *prev = NULL;
+    ID3D11DeviceContext1 *context;
+    ID3D11Device1 *device1;
+    D3D_FEATURE_LEVEL level;
+
+    if (FAILED(ID3D11Device_QueryInterface(device, &IID_ID3D11Device1, (void **)&device1)))
+        return;
+    level = ID3D11Device1_GetFeatureLevel(device1);
+    ID3D11Device1_GetImmediateContext1(device1, &context);
+    if (SUCCEEDED(ID3D11Device1_CreateDeviceContextState(device1, 0, &level, 1, D3D11_SDK_VERSION,
+            &IID_ID3D11Device1, NULL, &state)))
+        ID3D11DeviceContext1_SwapDeviceContextState(context, state, &prev);
+    ID3D11DeviceContext1_CopySubresourceRegion(context, dst, dst_idx, 0, 0, 0, src, src_idx, NULL);
+    if (prev)
+    {
+        ID3D11DeviceContext1_SwapDeviceContextState(context, prev, NULL);
+        ID3DDeviceContextState_Release(prev);
+    }
+    if (state)
+        ID3DDeviceContextState_Release(state);
+    ID3D11DeviceContext1_Release(context);
+    ID3D11Device1_Release(device1);
+}
+
 static HRESULT dxgi_surface_buffer_map(struct buffer *buffer, MF2DBuffer_LockFlags flags)
 {
     ID3D11DeviceContext *immediate_context;
@@ -1010,8 +1040,8 @@ static HRESULT dxgi_surface_buffer_map(struct buffer *buffer, MF2DBuffer_LockFla
 
     if (flags == MF2DBuffer_LockFlags_Read || flags == MF2DBuffer_LockFlags_ReadWrite)
     {
-        ID3D11DeviceContext_CopySubresourceRegion(immediate_context, (ID3D11Resource *)buffer->dxgi_surface.rb_texture,
-                0, 0, 0, 0, (ID3D11Resource *)buffer->dxgi_surface.texture, buffer->dxgi_surface.sub_resource_idx, NULL);
+        dxgi_surface_buffer_copy(device, (ID3D11Resource *)buffer->dxgi_surface.rb_texture, 0,
+                (ID3D11Resource *)buffer->dxgi_surface.texture, buffer->dxgi_surface.sub_resource_idx);
     }
 
     memset(&buffer->dxgi_surface.map_desc, 0, sizeof(buffer->dxgi_surface.map_desc));
@@ -1039,8 +1069,8 @@ static void dxgi_surface_buffer_unmap(struct buffer *buffer, MF2DBuffer_LockFlag
 
     if (flags == MF2DBuffer_LockFlags_Write || flags == MF2DBuffer_LockFlags_ReadWrite)
     {
-        ID3D11DeviceContext_CopySubresourceRegion(immediate_context, (ID3D11Resource *)buffer->dxgi_surface.texture,
-                buffer->dxgi_surface.sub_resource_idx, 0, 0, 0, (ID3D11Resource *)buffer->dxgi_surface.rb_texture, 0, NULL);
+        dxgi_surface_buffer_copy(device, (ID3D11Resource *)buffer->dxgi_surface.texture,
+                buffer->dxgi_surface.sub_resource_idx, (ID3D11Resource *)buffer->dxgi_surface.rb_texture, 0);
     }
 
     ID3D11DeviceContext_Release(immediate_context);
