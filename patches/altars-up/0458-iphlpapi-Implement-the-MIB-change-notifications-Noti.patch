+
+static DWORD initial_thread;
+static LONG initial_calls;
+
+static void WINAPI interface_change_callback(void *context, MIB_IPINTERFACE_ROW *row, MIB_NOTIFICATION_TYPE type)
+{
+    if (type != MibInitialNotification) return;
+    ok(!row, "Unexpected row %p.\n", row);
+    initial_thread = GetCurrentThreadId();
+    InterlockedIncrement(&initial_calls);
+}
+
+static void WINAPI route_change_callback(void *context, MIB_IPFORWARD_ROW2 *row, MIB_NOTIFICATION_TYPE type)
+{
+    if (type != MibInitialNotification) return;
+    ok(!row, "Unexpected row %p.\n", row);
+    initial_thread = GetCurrentThreadId();
+    InterlockedIncrement(&initial_calls);
+}
+
+static void WINAPI hint_change_callback(void *context, NL_NETWORK_CONNECTIVITY_HINT hint)
+{
+    initial_thread = GetCurrentThreadId();
+    InterlockedIncrement(&initial_calls);
+}
+
+/* the first call tells only that the registration is done; it comes before the function returns, on its thread, but
+ * for the connectivity hint, whose first call comes later on another thread */
+static void test_change_notifications(void)
+{
+    MIB_UNICASTIPADDRESS_TABLE *table;
+    HANDLE handle;
+    DWORD ret;
+    unsigned int i;
+
+    initial_calls = 0;
+    initial_thread = 0;
+    ret = NotifyIpInterfaceChange(AF_UNSPEC, interface_change_callback, NULL, TRUE, &handle);
+    ok(ret == NO_ERROR, "Unexpected ret %#lx.\n", ret);
+    /* one for each family */
+    ok(initial_calls == 2, "got %ld calls\n", initial_calls);
+    ok(initial_thread == GetCurrentThreadId(), "called on another thread\n");
+    ret = CancelMibChangeNotify2(handle);
+    ok(ret == NO_ERROR, "Unexpected ret %#lx.\n", ret);
+
+    initial_calls = 0;
+    initial_thread = 0;
+    ret = NotifyRouteChange2(AF_INET, route_change_callback, NULL, TRUE, &handle);
+    ok(ret == NO_ERROR, "Unexpected ret %#lx.\n", ret);
+    ok(initial_calls == 1, "got %ld calls\n", initial_calls);
+    ok(initial_thread == GetCurrentThreadId(), "called on another thread\n");
+    ret = CancelMibChangeNotify2(handle);
+    ok(ret == NO_ERROR, "Unexpected ret %#lx.\n", ret);
+
+    initial_calls = 0;
+    initial_thread = 0;
+    ret = NotifyRouteChange2(AF_INET, route_change_callback, NULL, FALSE, &handle);
+    ok(ret == NO_ERROR, "Unexpected ret %#lx.\n", ret);
+    ok(!initial_calls, "got %ld calls\n", initial_calls);
+    ret = CancelMibChangeNotify2(handle);
+    ok(ret == NO_ERROR, "Unexpected ret %#lx.\n", ret);
+
+    initial_calls = 0;
+    initial_thread = 0;
+    ret = NotifyNetworkConnectivityHintChange(hint_change_callback, NULL, TRUE, &handle);
+    ok(ret == NO_ERROR, "Unexpected ret %#lx.\n", ret);
+    for (i = 0; i < 50 && !initial_calls; i++) Sleep(20);
+    ok(initial_calls == 1, "got %ld calls\n", initial_calls);
+    ok(initial_thread && initial_thread != GetCurrentThreadId(), "called on this thread\n");
+    ret = CancelMibChangeNotify2(handle);
+    ok(ret == NO_ERROR, "Unexpected ret %#lx.\n", ret);
+
+    /* with no tentative address the table comes at once */
+    table = NULL;
+    handle = (HANDLE)0xdeadbeef;
+    ret = NotifyStableUnicastIpAddressTable(AF_UNSPEC, &table, NULL, NULL, &handle);
+    ok(ret == NO_ERROR || ret == ERROR_IO_PENDING, "Unexpected ret %#lx.\n", ret);
+    if (ret == NO_ERROR)
+    {
+        ok(table != NULL, "no table\n");
+        ok(!handle, "got handle %p\n", handle);
+        FreeMibTable(table);
+    }
+    else CancelMibChangeNotify2(handle);
+}
+
+static void test_GetIpNetEntry2(void)
+{
+    MIB_IPNET_TABLE2 *table;
+    MIB_IPNET_ROW2 row;
+    DWORD ret;
+    ULONG i;
+
+    ret = GetIpNetEntry2(NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+
+    ret = GetIpNetTable2(AF_INET, &table);
+    if (ret)
+    {
+        skip("no neighbour table\n");
+        return;
+    }
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        memset(&row, 0, sizeof(row));
+        row.Address = table->Table[i].Address;
+        row.InterfaceLuid = table->Table[i].InterfaceLuid;
+        ret = GetIpNetEntry2(&row);
+        ok(!ret, "got %lu\n", ret);
+        ok(row.InterfaceIndex == table->Table[i].InterfaceIndex, "got index %lu\n", row.InterfaceIndex);
+        ok(row.PhysicalAddressLength == table->Table[i].PhysicalAddressLength, "got length %lu\n",
+           row.PhysicalAddressLength);
+        memset(&row, 0, sizeof(row));
+        row.Address = table->Table[i].Address;
+        row.InterfaceIndex = table->Table[i].InterfaceIndex;
+        ret = GetIpNetEntry2(&row);
+        ok(!ret, "by index: got %lu\n", ret);
+        break;
+    }
+    if (table->NumEntries)
+    {
+        memset(&row, 0, sizeof(row));
+        row.Address.Ipv4.sin_family = AF_INET;
+        row.Address.Ipv4.sin_addr.s_addr = htonl(0xc0000263); /* 192.0.2.99, never a neighbour */
+        row.InterfaceLuid = table->Table[0].InterfaceLuid;
+        ret = GetIpNetEntry2(&row);
+        ok(ret == ERROR_NOT_FOUND, "got %lu\n", ret);
+    }
+    FreeMibTable(table);
 }
 
