+/******************************************************************
+ *    GetIpNetEntry2 (IPHLPAPI.@)
+ *
+ * The neighbour entry for an address on an interface, the interface given by its LUID or else its index.
+ */
+DWORD WINAPI GetIpNetEntry2( MIB_IPNET_ROW2 *row )
+{
+    MIB_IPNET_TABLE2 *table;
+    ULONG i;
+    DWORD err;
+
+    TRACE( "%p\n", row );
+
+    if (!row) return ERROR_INVALID_PARAMETER;
+    if (row->Address.si_family != AF_INET && row->Address.si_family != AF_INET6) return ERROR_INVALID_PARAMETER;
+    if (!row->InterfaceLuid.Value && ConvertInterfaceIndexToLuid( row->InterfaceIndex, &row->InterfaceLuid ))
+        return ERROR_FILE_NOT_FOUND;
+    if ((err = GetIpNetTable2( row->Address.si_family, &table ))) return err;
+
+    err = ERROR_NOT_FOUND;
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        const MIB_IPNET_ROW2 *entry = table->Table + i;
+
+        if (entry->InterfaceLuid.Value != row->InterfaceLuid.Value) continue;
+        if (row->Address.si_family == AF_INET
+            ? entry->Address.Ipv4.sin_addr.s_addr != row->Address.Ipv4.sin_addr.s_addr
+            : memcmp( &entry->Address.Ipv6.sin6_addr, &row->Address.Ipv6.sin6_addr, sizeof(IN6_ADDR) ))
+            continue;
+        *row = *entry;
+        err = NO_ERROR;
+        break;
+    }
+    FreeMibTable( table );
+    return err;
+}
