+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+
+#define IPHLPAPI_DLL_LINKAGE
+#include "windef.h"
+#include "winbase.h"
+#include "winsock2.h"
+#include "winternl.h"
+#include "ws2ipdef.h"
+#include "iphlpapi.h"
+#include "ifdef.h"
+#include "netioapi.h"
+#include "netiodef.h"
+#include "wine/nsi.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(iphlpapi);
+
+/* What a registration watches.  Each kind but the hint has a table per address family; the thread keeps the
+ * last one it saw of each that someone watches, and on a change compares it with the new one row by row. */
+enum notify_kind
+{
+    NOTIFY_UNICAST,
+    NOTIFY_INTERFACE,
+    NOTIFY_ROUTE,
+    NOTIFY_STABLE,
+    NOTIFY_HINT,
+};
+
+struct notify
+{
+    struct list entry;
+    LONG refs;              /* the list's, and one for each callback running */
+    enum notify_kind kind;
+    ADDRESS_FAMILY family;
+    void *callback;
+    void *context;
+    BOOL listed;
+    BOOL initial;           /* the hint's first call is still to come */
+};
+
+static CRITICAL_SECTION notify_cs;
+static CRITICAL_SECTION_DEBUG notify_cs_debug =
+{
+    0, 0, &notify_cs,
+    { &notify_cs_debug.ProcessLocksList, &notify_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": notify_cs") }
+};
+static CRITICAL_SECTION notify_cs = { &notify_cs_debug, -1, 0, 0, 0, 0 };
+static CONDITION_VARIABLE notify_cv = CONDITION_VARIABLE_INIT;
+static struct list notify_list = LIST_INIT( notify_list );
+static HANDLE notify_thread, notify_wake;
+static DWORD notify_thread_id;
+
+/* the tables the thread waits on, and what it saw of them */
+static struct watch
+{
+    const NPI_MODULEID *module;
+    DWORD table;
+    ADDRESS_FAMILY family;
+    enum notify_kind kind;
+    OVERLAPPED ovr;
+    BOOL armed;
+    BOOL changed;
+    void *snapshot;         /* a MIB table, when someone watches it */
+}
+watches[] =
+{
+    { &NPI_MS_IPV4_MODULEID, NSI_IP_UNICAST_TABLE, AF_INET, NOTIFY_UNICAST },
+    { &NPI_MS_IPV6_MODULEID, NSI_IP_UNICAST_TABLE, AF_INET6, NOTIFY_UNICAST },
+    { &NPI_MS_IPV4_MODULEID, NSI_IP_INTERFACE_TABLE, AF_INET, NOTIFY_INTERFACE },
+    { &NPI_MS_IPV6_MODULEID, NSI_IP_INTERFACE_TABLE, AF_INET6, NOTIFY_INTERFACE },
+    { &NPI_MS_IPV4_MODULEID, NSI_IP_FORWARD_TABLE, AF_INET, NOTIFY_ROUTE },
+    { &NPI_MS_IPV6_MODULEID, NSI_IP_FORWARD_TABLE, AF_INET6, NOTIFY_ROUTE },
+};
+
+static NL_NETWORK_CONNECTIVITY_HINT last_hint;
+
+static BOOL family_matches( ADDRESS_FAMILY watched, ADDRESS_FAMILY family )
+{
+    return watched == AF_UNSPEC || watched == family;
+}
+
+static BOOL is_watched( const struct watch *watch )
+{
+    struct notify *notify;
+
+    LIST_FOR_EACH_ENTRY( notify, &notify_list, struct notify, entry )
+    {
+        if ((notify->kind == watch->kind || (notify->kind == NOTIFY_STABLE && watch->kind == NOTIFY_UNICAST)) &&
+            family_matches( notify->family, watch->family ))
+            return TRUE;
+    }
+    return FALSE;
+}
+
+static void *get_table( const struct watch *watch )
+{
+    void *table = NULL;
+
+    switch (watch->kind)
+    {
+    case NOTIFY_UNICAST:   GetUnicastIpAddressTable( watch->family, (MIB_UNICASTIPADDRESS_TABLE **)&table ); break;
+    case NOTIFY_INTERFACE: GetIpInterfaceTable( watch->family, (MIB_IPINTERFACE_TABLE **)&table ); break;
+    case NOTIFY_ROUTE:     GetIpForwardTable2( watch->family, (MIB_IPFORWARD_TABLE2 **)&table ); break;
+    default: break;
+    }
+    return table;
+}
+
+/* the snapshots of the tables someone watches; the others are dropped */
+static void update_snapshots(void)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(watches); i++)
+    {
+        if (!is_watched( &watches[i] ))
+        {
+            FreeMibTable( watches[i].snapshot );
+            watches[i].snapshot = NULL;
+        }
+        else if (!watches[i].snapshot) watches[i].snapshot = get_table( &watches[i] );
+    }
+}
+
+static BOOL same_address( const SOCKADDR_INET *a, const SOCKADDR_INET *b )
+{
+    if (a->si_family != b->si_family) return FALSE;
+    if (a->si_family == AF_INET) return a->Ipv4.sin_addr.s_addr == b->Ipv4.sin_addr.s_addr;
+    return !memcmp( &a->Ipv6.sin6_addr, &b->Ipv6.sin6_addr, sizeof(a->Ipv6.sin6_addr) ) &&
+           a->Ipv6.sin6_scope_id == b->Ipv6.sin6_scope_id;
+}
+
+/* the rows of two tables, by kind: the same row, and whether something in it changed */
+static const void *row_at( enum notify_kind kind, const void *table, ULONG i )
+{
+    switch (kind)
+    {
+    case NOTIFY_UNICAST:   return &((const MIB_UNICASTIPADDRESS_TABLE *)table)->Table[i];
+    case NOTIFY_INTERFACE: return &((const MIB_IPINTERFACE_TABLE *)table)->Table[i];
+    case NOTIFY_ROUTE:     return &((const MIB_IPFORWARD_TABLE2 *)table)->Table[i];
+    default:               return NULL;
+    }
+}
+
+static ULONG row_count( const void *table )
+{
+    return table ? *(const ULONG *)table : 0;
+}
+
+static BOOL same_row( enum notify_kind kind, const void *a, const void *b )
+{
+    switch (kind)
+    {
+    case NOTIFY_UNICAST:
+    {
+        const MIB_UNICASTIPADDRESS_ROW *x = a, *y = b;
+        return x->InterfaceLuid.Value == y->InterfaceLuid.Value && same_address( &x->Address, &y->Address );
+    }
+    case NOTIFY_INTERFACE:
+    {
+        const MIB_IPINTERFACE_ROW *x = a, *y = b;
+        return x->InterfaceLuid.Value == y->InterfaceLuid.Value;
+    }
+    case NOTIFY_ROUTE:
+    {
+        const MIB_IPFORWARD_ROW2 *x = a, *y = b;
+        return x->InterfaceLuid.Value == y->InterfaceLuid.Value &&
+               x->DestinationPrefix.PrefixLength == y->DestinationPrefix.PrefixLength &&
+               same_address( &x->DestinationPrefix.Prefix, &y->DestinationPrefix.Prefix ) &&
+               same_address( &x->NextHop, &y->NextHop );
+    }
+    default:
+        return FALSE;
+    }
+}
+
+static BOOL row_changed( enum notify_kind kind, const void *a, const void *b )
+{
+    switch (kind)
+    {
+    case NOTIFY_UNICAST:
+    {
+        const MIB_UNICASTIPADDRESS_ROW *x = a, *y = b;
+        return x->DadState != y->DadState || x->OnLinkPrefixLength != y->OnLinkPrefixLength ||
+               x->PrefixOrigin != y->PrefixOrigin || x->SuffixOrigin != y->SuffixOrigin ||
+               x->SkipAsSource != y->SkipAsSource;
+    }
+    case NOTIFY_INTERFACE:
+    {
+        const MIB_IPINTERFACE_ROW *x = a, *y = b;
+        return x->Connected != y->Connected || x->NlMtu != y->NlMtu || x->Metric != y->Metric ||
+               x->ForwardingEnabled != y->ForwardingEnabled || x->DisableDefaultRoutes != y->DisableDefaultRoutes;
+    }
+    case NOTIFY_ROUTE:
+    {
+        const MIB_IPFORWARD_ROW2 *x = a, *y = b;
+        return x->Metric != y->Metric || x->Protocol != y->Protocol || x->Loopback != y->Loopback;
+    }
+    default:
+        return FALSE;
+    }
+}
+
+static void call( struct notify *notify, const void *row, MIB_NOTIFICATION_TYPE type )
+{
+    switch (notify->kind)
+    {
+    case NOTIFY_UNICAST:
+        ((PUNICAST_IPADDRESS_CHANGE_CALLBACK)notify->callback)( notify->context, (MIB_UNICASTIPADDRESS_ROW *)row, type );
+        break;
+    case NOTIFY_INTERFACE:
+        ((PIPINTERFACE_CHANGE_CALLBACK)notify->callback)( notify->context, (MIB_IPINTERFACE_ROW *)row, type );
+        break;
+    case NOTIFY_ROUTE:
+        ((PIPFORWARD_CHANGE_CALLBACK)notify->callback)( notify->context, (MIB_IPFORWARD_ROW2 *)row, type );
+        break;
+    default:
+        break;
+    }
+}
+
+static void release_notify( struct notify *notify )
+{
+    if (InterlockedDecrement( &notify->refs )) return;
+    free( notify );
+}
+
+/* the registrations of a kind for a family, each with a reference taken: callbacks may cancel any of them */
+static struct notify **take_notifies( enum notify_kind kind, ADDRESS_FAMILY family, unsigned int *count )
+{
+    struct notify **ret, *notify;
+    unsigned int i = 0;
+
+    *count = 0;
+    if (!(ret = malloc( list_count( &notify_list ) * sizeof(*ret) + 1 ))) return NULL;
+    LIST_FOR_EACH_ENTRY( notify, &notify_list, struct notify, entry )
+    {
+        if (notify->kind != kind || (family != AF_UNSPEC && !family_matches( notify->family, family ))) continue;
+        InterlockedIncrement( &notify->refs );
+        ret[i++] = notify;
+    }
+    *count = i;
+    return ret;
+}
+
+static void release_notifies( struct notify **notifies, unsigned int count )
+{
+    while (count--) release_notify( notifies[count] );
+    free( notifies );
+    WakeAllConditionVariable( &notify_cv );
+}
+
+/* call one registration with the lock not held, unless it was cancelled; a canceller waits for this */
+static void dispatch( struct notify *notify, const void *row, MIB_NOTIFICATION_TYPE type )
+{
+    if (!notify->listed) return;
+    InterlockedIncrement( &notify->refs );
+    LeaveCriticalSection( &notify_cs );
+    call( notify, row, type );
+    EnterCriticalSection( &notify_cs );
+    release_notify( notify );
+    WakeAllConditionVariable( &notify_cv );
+}
+
+/* tell those watching a table what changed in it: deleted rows first, then new and changed ones */
+static void dispatch_changes( const struct watch *watch, const void *old, const void *new )
+{
+    ULONG i, j, old_count = row_count( old ), new_count = row_count( new );
+    struct notify **notifies;
+    unsigned int k, count;
+
+    if (!(notifies = take_notifies( watch->kind, watch->family, &count ))) return;
+    for (k = 0; k < count; k++)
+    {
+        for (i = 0; i < old_count; i++)
+        {
+            const void *row = row_at( watch->kind, old, i );
+            for (j = 0; j < new_count; j++) if (same_row( watch->kind, row, row_at( watch->kind, new, j ) )) break;
+            if (j == new_count) dispatch( notifies[k], row, MibDeleteInstance );
+        }
+        for (j = 0; j < new_count; j++)
+        {
+            const void *row = row_at( watch->kind, new, j );
+            for (i = 0; i < old_count; i++) if (same_row( watch->kind, row_at( watch->kind, old, i ), row )) break;
+            if (i == old_count) dispatch( notifies[k], row, MibAddInstance );
+            else if (row_changed( watch->kind, row_at( watch->kind, old, i ), row ))
+                dispatch( notifies[k], row, MibParameterNotification );
+        }
+    }
+    release_notifies( notifies, count );
+}
+
+static BOOL is_stable( const MIB_UNICASTIPADDRESS_TABLE *table )
+{
+    ULONG i;
+
+    for (i = 0; i < table->NumEntries; i++)
+        if (table->Table[i].DadState == IpDadStateTentative) return FALSE;
+    return TRUE;
+}
+
+/* a waiting NotifyStableUnicastIpAddressTable is called once, with the table, when no address is tentative */
+static void dispatch_stable(void)
+{
+    MIB_UNICASTIPADDRESS_TABLE *table;
+    struct notify **notifies;
+    unsigned int k, count;
+
+    if (!(notifies = take_notifies( NOTIFY_STABLE, AF_UNSPEC, &count ))) return;
+    for (k = 0; k < count; k++)
+    {
+        struct notify *notify = notifies[k];
+
+        if (!notify->listed || GetUnicastIpAddressTable( notify->family, &table )) continue;
+        if (!is_stable( table ))
+        {
+            FreeMibTable( table );
+            continue;
+        }
+        /* it is done with: the list's reference goes */
+        list_remove( &notify->entry );
+        notify->listed = FALSE;
+        release_notify( notify );
+        LeaveCriticalSection( &notify_cs );
+        ((PSTABLE_UNICAST_IPADDRESS_TABLE_CALLBACK)notify->callback)( notify->context, table );
+        EnterCriticalSection( &notify_cs );
+    }
+    release_notifies( notifies, count );
+}
+
+/* the hints that want their first call, or all of them when the hint changed */
+static void dispatch_hint( BOOL first_only )
+{
+    NL_NETWORK_CONNECTIVITY_HINT hint;
+    struct notify **notifies;
+    unsigned int k, count;
+    BOOL changed;
+
+    if (GetNetworkConnectivityHint( &hint )) return;
+    changed = memcmp( &hint, &last_hint, sizeof(hint) ) != 0;
+    if (!first_only) last_hint = hint;
+    if (!(notifies = take_notifies( NOTIFY_HINT, AF_UNSPEC, &count ))) return;
+    for (k = 0; k < count; k++)
+    {
+        struct notify *notify = notifies[k];
+
+        if (!notify->listed || !(notify->initial || (changed && !first_only))) continue;
+        notify->initial = FALSE;
+        LeaveCriticalSection( &notify_cs );
+        ((PNETWORK_CONNECTIVITY_HINT_CHANGE_CALLBACK)notify->callback)( notify->context, hint );
+        EnterCriticalSection( &notify_cs );
+    }
+    release_notifies( notifies, count );
+}
+
+/* whether a hint registration keeps the last hint up to date; the lock is held */
+static BOOL has_hint_notify(void)
+{
+    struct notify *notify;
+
+    LIST_FOR_EACH_ENTRY( notify, &notify_list, struct notify, entry )
+        if (notify->kind == NOTIFY_HINT) return TRUE;
+    return FALSE;
+}
+
+static void arm( struct watch *watch )
+{
+    HANDLE handle;
+    DWORD err;
+
+    if (!watch->ovr.hEvent) watch->ovr.hEvent = CreateEventW( NULL, TRUE, FALSE, NULL );
+    ResetEvent( watch->ovr.hEvent );
+    err = NsiRequestChangeNotification( 0, watch->module, watch->table, &watch->ovr, &handle );
+    watch->armed = (err == ERROR_IO_PENDING || !err);
+    if (!watch->armed) WARN( "table %lu: error %lu\n", watch->table, err );
+}
+
+static DWORD WINAPI notify_proc( void *arg )
+{
+    HANDLE events[ARRAY_SIZE(watches) + 1];
+    unsigned int i, count;
+    DWORD ret, timeout = INFINITE;
+    HMODULE module;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_iphlpapi_notify" );
+    /* the thread outlives any FreeLibrary of the module */
+    GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_PIN,
+                        (const WCHAR *)notify_proc, &module );
+    for (i = 0; i < ARRAY_SIZE(watches); i++) arm( &watches[i] );
+
+    for (;;)
+    {
+        events[0] = notify_wake;
+        for (i = 0, count = 1; i < ARRAY_SIZE(watches); i++)
+            if (watches[i].armed) events[count++] = watches[i].ovr.hEvent;
+
+        ret = WaitForMultipleObjects( count, events, FALSE, timeout );
+
+        EnterCriticalSection( &notify_cs );
+        if (ret == WAIT_TIMEOUT)
+        {
+            /* changes come in bursts; they are handled once the burst is over */
+            timeout = INFINITE;
+            for (i = 0; i < ARRAY_SIZE(watches); i++)
+            {
+                void *table;
+
+                if (!watches[i].changed) continue;
+                watches[i].changed = FALSE;
+                if (!is_watched( &watches[i] )) continue;
+                table = get_table( &watches[i] );
+                dispatch_changes( &watches[i], watches[i].snapshot, table );
+                FreeMibTable( watches[i].snapshot );
+                watches[i].snapshot = table;
+            }
+            dispatch_stable();
+            dispatch_hint( FALSE );
+        }
+        else if (ret == WAIT_OBJECT_0)
+        {
+            /* a registration came or went; a new hint wants its first call */
+            update_snapshots();
+            dispatch_hint( TRUE );
+        }
+        else if (ret > WAIT_OBJECT_0 && ret < WAIT_OBJECT_0 + count)
+        {
+            for (i = 0; i < ARRAY_SIZE(watches); i++)
+            {
+                if (!watches[i].armed || events[ret - WAIT_OBJECT_0] != watches[i].ovr.hEvent) continue;
+                watches[i].changed = TRUE;
+                arm( &watches[i] );
+            }
+            timeout = 100;
+        }
+        else
+        {
+            ERR( "wait failed, ret %lu, error %lu\n", ret, GetLastError() );
+            LeaveCriticalSection( &notify_cs );
+            return 1;
+        }
+        LeaveCriticalSection( &notify_cs );
+    }
+}
+
+/* list a registration, starting the thread the first time; the lock is held */
+static DWORD add_notify( struct notify *notify )
+{
+    if (!notify_thread)
+    {
+        if (!(notify_wake = CreateEventW( NULL, FALSE, FALSE, NULL ))) return GetLastError();
+        if (!(notify_thread = CreateThread( NULL, 0, notify_proc, NULL, 0, &notify_thread_id )))
+        {
+            CloseHandle( notify_wake );
+            notify_wake = NULL;
+            return GetLastError();
+        }
+    }
+    notify->refs = 1;
+    notify->listed = TRUE;
+    list_add_tail( &notify_list, &notify->entry );
+    update_snapshots();
+    SetEvent( notify_wake );
+    return NO_ERROR;
+}
+
+static DWORD register_notify( enum notify_kind kind, ADDRESS_FAMILY family, void *callback, void *context,
+                              BOOLEAN initial, HANDLE *handle )
+{
+    struct notify *notify;
+    DWORD err;
+
+    if (family != AF_UNSPEC && family != AF_INET && family != AF_INET6) return ERROR_INVALID_PARAMETER;
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    if (!(notify = calloc( 1, sizeof(*notify) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    notify->kind = kind;
+    notify->family = family;
+    notify->callback = callback;
+    notify->context = context;
+
+    EnterCriticalSection( &notify_cs );
+    err = add_notify( notify );
+    LeaveCriticalSection( &notify_cs );
+    if (err)
+    {
+        free( notify );
+        return err;
+    }
+    *handle = notify;
+    /* the first call comes on the registering thread before this returns, telling only that it is registered; it
+     * comes for each address family watched */
+    if (initial)
+    {
+        call( notify, NULL, MibInitialNotification );
+        if (family == AF_UNSPEC) call( notify, NULL, MibInitialNotification );
+    }
+    return NO_ERROR;
+}
+
+/******************************************************************
+ *    NotifyUnicastIpAddressChange (IPHLPAPI.@)
+ */
+DWORD WINAPI NotifyUnicastIpAddressChange( ADDRESS_FAMILY family, PUNICAST_IPADDRESS_CHANGE_CALLBACK callback,
+                                           void *context, BOOLEAN init_notify, HANDLE *handle )
+{
+    TRACE( "family %u, callback %p, context %p, init_notify %u, handle %p.\n",
+           family, callback, context, init_notify, handle );
+    return register_notify( NOTIFY_UNICAST, family, callback, context, init_notify, handle );
+}
+
+/******************************************************************
+ *    NotifyIpInterfaceChange (IPHLPAPI.@)
+ */
+DWORD WINAPI NotifyIpInterfaceChange( ADDRESS_FAMILY family, PIPINTERFACE_CHANGE_CALLBACK callback,
+                                      void *context, BOOLEAN init_notify, HANDLE *handle )
+{
+    TRACE( "family %u, callback %p, context %p, init_notify %u, handle %p.\n",
+           family, callback, context, init_notify, handle );
+    return register_notify( NOTIFY_INTERFACE, family, callback, context, init_notify, handle );
+}
+
+/******************************************************************
+ *    NotifyRouteChange2 (IPHLPAPI.@)
+ */
+DWORD WINAPI NotifyRouteChange2( ADDRESS_FAMILY family, PIPFORWARD_CHANGE_CALLBACK callback, void *context,
+                                 BOOLEAN init_notify, HANDLE *handle )
+{
+    TRACE( "family %u, callback %p, context %p, init_notify %u, handle %p.\n",
+           family, callback, context, init_notify, handle );
+    return register_notify( NOTIFY_ROUTE, family, callback, context, init_notify, handle );
+}
+
+/******************************************************************
+ *    NotifyNetworkConnectivityHintChange (IPHLPAPI.@)
+ *
+ * Unlike the others, its first call comes on the notification thread, after this returns.
+ */
+DWORD WINAPI NotifyNetworkConnectivityHintChange( PNETWORK_CONNECTIVITY_HINT_CHANGE_CALLBACK callback,
+                                                  void *context, BOOLEAN init_notify, HANDLE *handle )
+{
+    struct notify *notify;
+    DWORD err;
+
+    TRACE( "callback %p, context %p, init_notify %u, handle %p.\n", callback, context, init_notify, handle );
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    if (!(notify = calloc( 1, sizeof(*notify) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    notify->kind = NOTIFY_HINT;
+    notify->callback = callback;
+    notify->context = context;
+    notify->initial = init_notify;
+
+    EnterCriticalSection( &notify_cs );
+    if (!has_hint_notify()) GetNetworkConnectivityHint( &last_hint );
+    err = add_notify( notify );
+    LeaveCriticalSection( &notify_cs );
+    if (err)
+    {
+        free( notify );
+        return err;
+    }
+    *handle = notify;
+    return NO_ERROR;
+}
+
+/******************************************************************
+ *    NotifyStableUnicastIpAddressTable (IPHLPAPI.@)
+ *
+ * When no address is tentative the table comes back at once and the callback is never called.
+ */
+DWORD WINAPI NotifyStableUnicastIpAddressTable( ADDRESS_FAMILY family, MIB_UNICASTIPADDRESS_TABLE **table,
+                                                PSTABLE_UNICAST_IPADDRESS_TABLE_CALLBACK callback, void *context,
+                                                HANDLE *handle )
+{
+    struct notify *notify;
+    DWORD err;
+
+    TRACE( "family %u, table %p, callback %p, context %p, handle %p.\n", family, table, callback, context, handle );
+
+    if (!table || !handle) return ERROR_INVALID_PARAMETER;
+    if (family != AF_UNSPEC && family != AF_INET && family != AF_INET6) return ERROR_INVALID_PARAMETER;
+    *handle = NULL;
+    if ((err = GetUnicastIpAddressTable( family, table ))) return err;
+    if (is_stable( *table )) return NO_ERROR;
+    FreeMibTable( *table );
+    *table = NULL;
+
+    if (!(notify = calloc( 1, sizeof(*notify) ))) return ERROR_NOT_ENOUGH_MEMORY;
+    notify->kind = NOTIFY_STABLE;
+    notify->family = family;
+    notify->callback = callback;
+    notify->context = context;
+    EnterCriticalSection( &notify_cs );
+    err = add_notify( notify );
+    LeaveCriticalSection( &notify_cs );
+    if (err)
+    {
+        free( notify );
+        return err;
+    }
+    *handle = notify;
+    return ERROR_IO_PENDING;
+}
+
+/******************************************************************
+ *    CancelMibChangeNotify2 (IPHLPAPI.@)
+ *
+ * Waits for callbacks of the registration that are running, unless called from one of them.
+ */
+DWORD WINAPI CancelMibChangeNotify2( HANDLE handle )
+{
+    struct notify *notify = handle, *iter;
+    BOOL found = FALSE;
+
+    TRACE( "handle %p.\n", handle );
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+
+    EnterCriticalSection( &notify_cs );
+    LIST_FOR_EACH_ENTRY( iter, &notify_list, struct notify, entry )
+        if (iter == notify) found = TRUE;
+    if (!found)
+    {
+        LeaveCriticalSection( &notify_cs );
+        return ERROR_INVALID_PARAMETER;
+    }
+    list_remove( &notify->entry );
+    notify->listed = FALSE;
+    if (GetCurrentThreadId() != notify_thread_id)
+        while (notify->refs > 1) SleepConditionVariableCS( &notify_cv, &notify_cs, INFINITE );
+    release_notify( notify );
+    if (notify_wake) SetEvent( notify_wake );
+    LeaveCriticalSection( &notify_cs );
+    return NO_ERROR;
+}
+
+/******************************************************************
+ *    NotifyRouteChange (IPHLPAPI.@)
+ *
+ * Notify caller whenever the IPv4 routing table is changed.
+ */
+DWORD WINAPI NotifyRouteChange( HANDLE *handle, OVERLAPPED *overlapped )
+{
+    TRACE( "handle %p, overlapped %p.\n", handle, overlapped );
+
+    return NsiRequestChangeNotification( 0, &NPI_MS_IPV4_MODULEID, NSI_IP_FORWARD_TABLE, overlapped, handle );
+}
