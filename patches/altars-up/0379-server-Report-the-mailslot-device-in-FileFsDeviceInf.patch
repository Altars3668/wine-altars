From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 14:22:30 -0400
Subject: [PATCH] server: Report the mailslot device in
 FileFsDeviceInformation.

Both ends of a mailslot answered STATUS_OBJECT_TYPE_MISMATCH, so
GetFileType() failed on them with ERROR_INVALID_HANDLE.  Windows gives
FILE_DEVICE_MAILSLOT, which GetFileType() reports as FILE_TYPE_UNKNOWN
without an error.  The characteristics are left 0 until they are
measured; the test prints them.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index fa94f6862f6..5428b1d2dfb 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -942,7 +942,8 @@ static void append_file_test(void)
 
 static void nt_mailslot_test(void)
 {
-    HANDLE hslot;
+    FILE_FS_DEVICE_INFORMATION device_info;
+    HANDLE hslot, client;
     ACCESS_MASK DesiredAccess;
     OBJECT_ATTRIBUTES attr;
 
@@ -997,6 +998,25 @@ static void nt_mailslot_test(void)
     ok( rc == STATUS_SUCCESS, "Create MailslotFile failed rc = %lx\n", rc);
     ok( hslot != 0, "Handle is invalid\n");
 
+    /* both ends are on the mailslot device */
+    memset( &device_info, 0xaa, sizeof(device_info) );
+    rc = pNtQueryVolumeInformationFile( hslot, &IoStatusBlock, &device_info, sizeof(device_info),
+                                        FileFsDeviceInformation );
+    ok( rc == STATUS_SUCCESS, "NtQueryVolumeInformationFile failed rc = %lx\n", rc );
+    ok( IoStatusBlock.Information == sizeof(device_info), "Information = %Iu\n", IoStatusBlock.Information );
+    ok( device_info.DeviceType == FILE_DEVICE_MAILSLOT, "DeviceType = %lu\n", device_info.DeviceType );
+    trace( "mailslot Characteristics %#lx\n", device_info.Characteristics );
+
+    client = CreateFileW( L"\\\\.\\mailslot\\R:\\FRED", GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    ok( client != INVALID_HANDLE_VALUE, "opening the mailslot failed, error %lu\n", GetLastError() );
+    memset( &device_info, 0xaa, sizeof(device_info) );
+    rc = pNtQueryVolumeInformationFile( client, &IoStatusBlock, &device_info, sizeof(device_info),
+                                        FileFsDeviceInformation );
+    ok( rc == STATUS_SUCCESS, "NtQueryVolumeInformationFile failed rc = %lx\n", rc );
+    ok( device_info.DeviceType == FILE_DEVICE_MAILSLOT, "DeviceType = %lu\n", device_info.DeviceType );
+    trace( "mailslot client Characteristics %#lx\n", device_info.Characteristics );
+    CloseHandle( client );
+
     rc = pNtClose(hslot);
     ok( rc == STATUS_SUCCESS, "NtClose failed\n");
 }
