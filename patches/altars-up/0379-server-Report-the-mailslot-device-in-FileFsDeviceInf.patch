@@ -142,12 +145,13 @@ static void mail_writer_write( struct fd *fd, struct async *async, file_pos_t po
 
 static const struct fd_ops mail_writer_fd_ops =
 {
-    .get_fd_type   = mail_writer_get_fd_type,
-    .read          = mail_writer_read,
-    .write         = mail_writer_write,
-    .get_file_info = default_fd_get_file_info,
-    .ioctl         = default_fd_ioctl,
-    .queue_async   = default_fd_queue_async,
+    .get_fd_type     = mail_writer_get_fd_type,
+    .read            = mail_writer_read,
+    .write           = mail_writer_write,
+    .get_file_info   = default_fd_get_file_info,
+    .get_volume_info = mailslot_get_volume_info,
+    .ioctl           = default_fd_ioctl,
+    .queue_async     = default_fd_queue_async,
 };
 
 
@@ -340,6 +344,25 @@ static void mailslot_get_file_info( struct fd *fd, obj_handle_t handle, unsigned
     }
 }
 
+/* both ends of a mailslot are on the mailslot file system's device */
+static void mailslot_get_volume_info( struct fd *fd, struct async *async, unsigned int info_class )
+{
+    switch (info_class)
+    {
+    case FileFsDeviceInformation:
+        {
+            static const FILE_FS_DEVICE_INFORMATION device_info = { FILE_DEVICE_MAILSLOT, 0 };
+            if (get_reply_max_size() >= sizeof(device_info))
+                set_reply_data( &device_info, sizeof(device_info) );
+            else
+                set_error( STATUS_BUFFER_TOO_SMALL );
+            break;
+        }
+    default:
+        set_error( STATUS_NOT_IMPLEMENTED );
+    }
+}
+
 static struct fd *mailslot_get_fd( struct object *obj )
 {
     struct mailslot *mailslot = (struct mailslot *) obj;
