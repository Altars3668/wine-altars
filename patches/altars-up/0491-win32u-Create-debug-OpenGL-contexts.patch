From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:18 -0400
Subject: [PATCH] win32u: Create debug OpenGL contexts.

WGL_CONTEXT_DEBUG_BIT_ARB has the value GLX and EGL give it and is
passed on, for legacy versions too; only the robustness bits are left
out with a FIXME.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/win32u/opengl.c b/dlls/win32u/opengl.c
index 630301d6f64..d427405b155 100644
--- a/dlls/win32u/opengl.c
+++ b/dlls/win32u/opengl.c
@@ -2996,18 +2996,21 @@ static struct opengl_context *win32u_context_create( HDC hdc, struct opengl_cont
         RtlSetLastWin32Error( ERROR_INVALID_PROFILE_ARB );
         return FALSE;
     }
-    if (attrs.flags & ~WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB)
+    /* GLX and EGL give the debug and forward compatible bits the same values */
+    if (attrs.flags & ~(WGL_CONTEXT_DEBUG_BIT_ARB | WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB))
     {
-        FIXME( "Unknown WGL_CONTEXT_FLAGS_ARB %#x\n", attrs.flags & ~WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB );
-        attrs.flags &= WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB;
+        FIXME( "Unknown WGL_CONTEXT_FLAGS_ARB %#x\n",
+               attrs.flags & ~(WGL_CONTEXT_DEBUG_BIT_ARB | WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB) );
+        attrs.flags &= WGL_CONTEXT_DEBUG_BIT_ARB | WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB;
     }
 
-    if ((attrs.major >= 0 && attrs.major < 3) || (attrs.major == 3 && attrs.minor == 0 && !attrs.flags))
+    if ((attrs.major >= 0 && attrs.major < 3) ||
+        (attrs.major == 3 && attrs.minor == 0 && !(attrs.flags & WGL_CONTEXT_FORWARD_COMPATIBLE_BIT_ARB)))
     {
         WARN( "Ignoring legacy OpenGL version %d.%d\n", attrs.major, attrs.minor == -1 ? 0 : attrs.minor );
         attrs.profile = WGL_CONTEXT_COMPATIBILITY_PROFILE_BIT_ARB;
         attrs.major = attrs.minor = -1;
-        attrs.flags = 0;
+        attrs.flags &= WGL_CONTEXT_DEBUG_BIT_ARB;
     }
     else if ((attrs.major > 3 || attrs.minor >= 2) && !attrs.profile)
     {
