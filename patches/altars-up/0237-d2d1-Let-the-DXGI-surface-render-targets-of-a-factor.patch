From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 20:51:53 -0400
Subject: [PATCH] d2d1: Let the DXGI surface render targets of a factory share
 a device.

PowerPoint could not export a slide as an image, or save a presentation
as pictures, once a shape on it had both a reflection and a bevel: its
Art layer creates the effects and their inputs in a device context of
its own on the device of one DXGI surface render target, and draws them
into other targets it creates later on the same Direct3D device.  Each
target had a Direct2D device of its own, so the pixel shaders the
effects had loaded were not found ("Pixel shader ... was never
loaded"), DrawImage() failed and Office gave up on the export.

Measured on Windows 11 build 29671: the DXGI surface render targets a
factory creates on one DXGI device share one device, which is none of
those CreateDevice() makes (two calls to it give two devices), and which
lasts as long as something holds it -- a target created after all the
others were released gets a new one, without the shaders loaded before.
An effect of another device drawn into such a target is
D2DERR_WRONG_RESOURCE_DOMAIN, which Wine does not check yet.

The factory now keeps, for each DXGI device, the device of its surface
render targets while it is alive, and the device takes itself out when
it goes.  The tests pass on Windows and fail without this change.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 32ea29dff0318613e4c624ebc6432bc21f8bfc55)

diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index 9cf7c7b574a..554efd41bc8 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -898,6 +898,9 @@ struct d2d_device
     ID2D1Factory1 *factory;
     IDXGIDevice *dxgi_device;
     bool allow_get_dxgi_device;
+    /* the device the factory's DXGI surface render targets on this DXGI device share */
+    bool surface_target;
+    struct list surface_target_entry;
 
     ID3D10Blob *precompiled_shape_vs[D2D_SHAPE_TYPE_COUNT];
     ID3D10Blob *precompiled_shape_ps;
@@ -984,6 +987,10 @@ struct d2d_factory
     struct list effects;
     INIT_ONCE init_builtins;
 
+    /* devices of DXGI surface render targets, one for each DXGI device while any of them is alive */
+    struct list surface_target_devices;
+    SRWLOCK surface_target_lock;
+
     CRITICAL_SECTION cs;
     D2D1_FACTORY_TYPE factory_type;
 };
@@ -996,6 +1003,7 @@ static inline struct d2d_factory *unsafe_impl_from_ID2D1Factory(ID2D1Factory *if
 void d2d_effects_init_builtins(struct d2d_factory *factory);
 HRESULT d2d_factory_create_device(ID2D1Factory1 *factory, IDXGIDevice *dxgi_device,
         bool allow_get_dxgi_device, REFIID iid, void **device);
+void d2d_factory_remove_surface_target_device(ID2D1Factory1 *factory, struct d2d_device *device);
 struct d2d_effect_registration * d2d_factory_get_registered_effect(ID2D1Factory *factory,
         const GUID *effect_id);
 void d2d_factory_register_effect(struct d2d_factory *factory,
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index a5976e486d1..7f0e22c12b1 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -6238,6 +6238,8 @@ static ULONG WINAPI d2d_device_Release(ID2D1Device6 *iface)
 
     if (!refcount)
     {
+        if (device->surface_target)
+            d2d_factory_remove_surface_target_device(device->factory, device);
         IDXGIDevice_Release(device->dxgi_device);
         ID2D1Factory1_Release(device->factory);
         d2d_device_indexed_objects_clear(&device->shaders);
diff --git a/dlls/d2d1/factory.c b/dlls/d2d1/factory.c
index 80c147638cd..7fa2c0e2af6 100644
--- a/dlls/d2d1/factory.c
+++ b/dlls/d2d1/factory.c
@@ -455,11 +455,72 @@ static HRESULT STDMETHODCALLTYPE d2d_factory_CreateHwndRenderTarget(ID2D1Factory
     return S_OK;
 }
 
+static BOOL is_same_object(IUnknown *a, IUnknown *b)
+{
+    IUnknown *unk_a, *unk_b;
+
+    IUnknown_QueryInterface(a, &IID_IUnknown, (void **)&unk_a);
+    IUnknown_QueryInterface(b, &IID_IUnknown, (void **)&unk_b);
+    IUnknown_Release(unk_a);
+    IUnknown_Release(unk_b);
+    return unk_a == unk_b;
+}
+
+void d2d_factory_remove_surface_target_device(ID2D1Factory1 *iface, struct d2d_device *device)
+{
+    struct d2d_factory *factory = unsafe_impl_from_ID2D1Factory((ID2D1Factory *)iface);
+
+    AcquireSRWLockExclusive(&factory->surface_target_lock);
+    list_remove(&device->surface_target_entry);
+    ReleaseSRWLockExclusive(&factory->surface_target_lock);
+}
+
+/* DXGI surface render targets of a factory on the same DXGI device share one Direct2D device, apart from those
+ * CreateDevice() makes, for as long as any of them holds it: what one of them creates, another can draw.  Office
+ * creates its effects in a context of the device of one target, and draws them into targets it makes later. */
+static HRESULT d2d_factory_get_surface_target_device(struct d2d_factory *factory, IDXGIDevice *dxgi_device,
+        struct d2d_device **device)
+{
+    struct d2d_device *entry;
+    ID2D1Device *iface;
+    HRESULT hr = S_OK;
+    LONG refcount;
+
+    *device = NULL;
+    AcquireSRWLockExclusive(&factory->surface_target_lock);
+    LIST_FOR_EACH_ENTRY(entry, &factory->surface_target_devices, struct d2d_device, surface_target_entry)
+    {
+        if (!is_same_object((IUnknown *)entry->dxgi_device, (IUnknown *)dxgi_device))
+            continue;
+        /* one being destroyed is left alone */
+        while ((refcount = ReadNoFence(&entry->refcount)) > 0)
+        {
+            if (InterlockedCompareExchange(&entry->refcount, refcount + 1, refcount) == refcount)
+            {
+                *device = entry;
+                break;
+            }
+        }
+        if (*device)
+            break;
+    }
+    if (!*device && SUCCEEDED(hr = d2d_factory_create_device((ID2D1Factory1 *)&factory->ID2D1Factory7_iface,
+            dxgi_device, true, &IID_ID2D1Device, (void **)&iface)))
+    {
+        *device = unsafe_impl_from_ID2D1Device((ID2D1Device1 *)iface);
+        (*device)->surface_target = true;
+        list_add_head(&factory->surface_target_devices, &(*device)->surface_target_entry);
+    }
+    ReleaseSRWLockExclusive(&factory->surface_target_lock);
+    return hr;
+}
+
 static HRESULT STDMETHODCALLTYPE d2d_factory_CreateDxgiSurfaceRenderTarget(ID2D1Factory7 *iface,
         IDXGISurface *surface, const D2D1_RENDER_TARGET_PROPERTIES *desc, ID2D1RenderTarget **render_target)
 {
+    struct d2d_factory *factory = impl_from_ID2D1Factory7(iface);
     IDXGIDevice *dxgi_device;
-    ID2D1Device *device;
+    struct d2d_device *device;
     HRESULT hr;
 
     TRACE("iface %p, surface %p, desc %p, render_target %p.\n", iface, surface, desc, render_target);
@@ -470,7 +531,7 @@ static HRESULT STDMETHODCALLTYPE d2d_factory_CreateDxgiSurfaceRenderTarget(ID2D1
         return hr;
     }
 
-    hr = ID2D1Factory1_CreateDevice((ID2D1Factory1 *)iface, dxgi_device, &device);
+    hr = d2d_factory_get_surface_target_device(factory, dxgi_device, &device);
     IDXGIDevice_Release(dxgi_device);
     if (FAILED(hr))
     {
@@ -478,9 +539,8 @@ static HRESULT STDMETHODCALLTYPE d2d_factory_CreateDxgiSurfaceRenderTarget(ID2D1
         return hr;
     }
 
-    hr = d2d_d3d_create_render_target(unsafe_impl_from_ID2D1Device((ID2D1Device1 *)device), surface,
-            NULL, NULL, desc, (void **)render_target);
-    ID2D1Device_Release(device);
+    hr = d2d_d3d_create_render_target(device, surface, NULL, NULL, desc, (void **)render_target);
+    ID2D1Device6_Release(&device->ID2D1Device6_iface);
     return hr;
 }
 
@@ -1360,6 +1420,8 @@ static void d2d_factory_init(struct d2d_factory *factory, D2D1_FACTORY_TYPE fact
     factory->refcount = 1;
     d2d_factory_reload_sysmetrics(factory);
     list_init(&factory->effects);
+    list_init(&factory->surface_target_devices);
+    InitializeSRWLock(&factory->surface_target_lock);
     InitializeCriticalSection(&factory->cs);
     InitOnceInitialize(&factory->init_builtins);
 }
diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index 481d3bb40b4..8f28e45bf18 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -18649,6 +18649,280 @@ static void test_effect_custom_pixel_shader(BOOL d3d11)
     release_test_context(&ctx);
 }
 
+/* The DXGI surface render targets of a factory on one DXGI device share a device of their own for as long as any
+ * of them holds it, apart from the ones CreateDevice() makes. */
+static void test_device_of_surface_target(BOOL d3d11)
+{
+    static const char ps_code[] = "float4 main() : sv_target { return 0; }";
+    D2D1_PROPERTY_BINDING binding = { L"Context", NULL, effect_impl_get_context };
+    ID2D1Device *device, *device2, *target_device, *target_device2;
+    ID2D1EffectContext *effect_context;
+    D2D1_RENDER_TARGET_PROPERTIES desc;
+    ID2D1RenderTarget *rt, *rt2;
+    ID2D1DeviceContext *context;
+    IDXGISwapChain *swapchain;
+    ID2D1Factory1 *factory;
+    IDXGISurface *surface;
+    ID2D1Effect *effect;
+    IDXGIDevice *dxgi;
+    ID3D10Blob *blob;
+    BOOL loaded;
+    HWND window;
+    HRESULT hr;
+
+    if (!(dxgi = create_device(d3d11)))
+    {
+        skip("Failed to create a device.\n");
+        return;
+    }
+    hr = D2D1CreateFactory(D2D1_FACTORY_TYPE_SINGLE_THREADED, &IID_ID2D1Factory1, NULL, (void **)&factory);
+    if (FAILED(hr))
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        IDXGIDevice_Release(dxgi);
+        return;
+    }
+    window = create_window();
+    swapchain = create_swapchain(dxgi, window, TRUE);
+    hr = IDXGISwapChain_GetBuffer(swapchain, 0, &IID_IDXGISurface, (void **)&surface);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    hr = ID2D1Factory1_CreateDevice(factory, dxgi, &device);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Factory1_CreateDevice(factory, dxgi, &device2);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(device != device2, "Got the same device twice.\n");
+
+    desc.type = D2D1_RENDER_TARGET_TYPE_DEFAULT;
+    desc.pixelFormat.format = DXGI_FORMAT_UNKNOWN;
+    desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    desc.dpiX = 0.0f;
+    desc.dpiY = 0.0f;
+    desc.usage = D2D1_RENDER_TARGET_USAGE_NONE;
+    desc.minLevel = D2D1_FEATURE_LEVEL_DEFAULT;
+    hr = ID2D1Factory1_CreateDxgiSurfaceRenderTarget(factory, surface, &desc, &rt);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1RenderTarget_QueryInterface(rt, &IID_ID2D1DeviceContext, (void **)&context);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_GetDevice(context, &target_device);
+    ID2D1DeviceContext_Release(context);
+    hr = ID2D1Factory1_CreateDxgiSurfaceRenderTarget(factory, surface, &desc, &rt2);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1RenderTarget_QueryInterface(rt2, &IID_ID2D1DeviceContext, (void **)&context);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_GetDevice(context, &target_device2);
+    ok(target_device == target_device2, "Targets on the same DXGI device have different devices.\n");
+    ok(target_device != device && target_device != device2, "A target took a device CreateDevice() made.\n");
+
+    /* A shader loaded on the targets' device is gone once no target holds it any more. */
+    hr = ID2D1Factory1_RegisterEffectFromString(factory, &CLSID_AuxEffect, effect_xml_b, &binding, 1,
+            effect_impl_create);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_AuxEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Effect_GetValueByName(effect, L"Context", D2D1_PROPERTY_TYPE_IUNKNOWN, (BYTE *)&effect_context,
+            sizeof(effect_context));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = D3DCompile(ps_code, strlen(ps_code), NULL, NULL, NULL, "main", "ps_4_0", 0, 0, &blob, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ID2D1EffectContext_LoadPixelShader(effect_context, &GUID_TestPixelShader,
+            ID3D10Blob_GetBufferPointer(blob), ID3D10Blob_GetBufferSize(blob));
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ID3D10Blob_Release(blob);
+    ID2D1Effect_Release(effect);
+    ID2D1DeviceContext_Release(context);
+    ID2D1Device_Release(target_device2);
+    ID2D1Device_Release(target_device);
+    ID2D1RenderTarget_Release(rt2);
+    ID2D1RenderTarget_Release(rt);
+
+    hr = ID2D1Factory1_CreateDxgiSurfaceRenderTarget(factory, surface, &desc, &rt);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1RenderTarget_QueryInterface(rt, &IID_ID2D1DeviceContext, (void **)&context);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_AuxEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Effect_GetValueByName(effect, L"Context", D2D1_PROPERTY_TYPE_IUNKNOWN, (BYTE *)&effect_context,
+            sizeof(effect_context));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    loaded = ID2D1EffectContext_IsShaderLoaded(effect_context, &GUID_TestPixelShader);
+    ok(!loaded, "The shader outlived the targets' device.\n");
+    ID2D1Effect_Release(effect);
+    ID2D1DeviceContext_Release(context);
+    ID2D1RenderTarget_Release(rt);
+    hr = ID2D1Factory1_UnregisterEffect(factory, &CLSID_AuxEffect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1Device_Release(device2);
+    ID2D1Device_Release(device);
+    IDXGISurface_Release(surface);
+    IDXGISwapChain_Release(swapchain);
+    DestroyWindow(window);
+    ID2D1Factory1_Release(factory);
+    IDXGIDevice_Release(dxgi);
+}
+
+/* Office creates its effects, and their inputs, in a device context of its own on the device of one DXGI surface
+ * render target, and draws them into other targets it creates later: they share that device.  An effect of a device
+ * CreateDevice() made cannot be drawn there. */
+static void test_effect_device_of_surface_target(BOOL d3d11)
+{
+    static const char ps_code[] =
+        "float4 main() : sv_target\n"
+        "{\n"
+        "    return float4(0.1, 0.2, 0.3, 0.4);\n"
+        "}";
+    static const WCHAR *description =
+        L"<?xml version='1.0'?>                                                       \
+            <Effect>                                                                  \
+                <Property name='DisplayName' type='string' value='PSEffect'/>         \
+                <Property name='Author'      type='string' value='The Wine Project'/> \
+                <Property name='Category'    type='string' value='Test'/>             \
+                <Property name='Description' type='string' value='Test effect.'/>     \
+                <Inputs>                                                              \
+                    <Input name='Source'/>                                            \
+                </Inputs>                                                             \
+                <Property name='Context' type='iunknown'>                             \
+                    <Property name='DisplayName' type='string' value='Context'/>      \
+                </Property>                                                           \
+            </Effect>                                                                 \
+        ";
+    D2D1_PROPERTY_BINDING binding = { L"Context", NULL, effect_impl_get_context };
+    ID2D1DeviceContext *context, *target_context, *other_context;
+    ID2D1Device *target_device, *other_device;
+    ID2D1EffectContext *effect_context;
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+    D2D1_RENDER_TARGET_PROPERTIES desc;
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    ID2D1Effect *effect, *aux;
+    D2D1_SIZE_U input_size;
+    ID2D1Factory1 *factory;
+    ID2D1RenderTarget *rt;
+    ID2D1Bitmap1 *bitmap;
+    ID2D1Image *output;
+    DWORD colour, pixel;
+    ID3D10Blob *blob;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    if (!(factory = ctx.factory1))
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    ID2D1DeviceContext_GetDevice(ctx.context, &target_device);
+    hr = ID2D1Device_CreateDeviceContext(target_device, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &context);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    hr = ID2D1Factory1_RegisterEffectFromString(factory, &CLSID_AuxEffect, effect_xml_b, &binding, 1,
+            effect_impl_create);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_AuxEffect, &aux);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Effect_GetValueByName(aux, L"Context", D2D1_PROPERTY_TYPE_IUNKNOWN, (BYTE *)&effect_context,
+            sizeof(effect_context));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = D3DCompile(ps_code, strlen(ps_code), NULL, NULL, NULL, "main", "ps_4_0", 0, 0, &blob, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ID2D1EffectContext_LoadPixelShader(effect_context, &GUID_TestPixelShader,
+            ID3D10Blob_GetBufferPointer(blob), ID3D10Blob_GetBufferSize(blob));
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ID3D10Blob_Release(blob);
+
+    hr = ID2D1Factory1_RegisterEffectFromString(factory, &CLSID_TestEffect, description, &binding, 1,
+            custom_effect_impl_create);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_TestEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_size_u(&input_size, 1, 1);
+    pixel = 0xabcd00ff;
+    bitmap_desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    bitmap_desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_IGNORE;
+    bitmap_desc.dpiX = 96.0f;
+    bitmap_desc.dpiY = 96.0f;
+    bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_NONE;
+    bitmap_desc.colorContext = NULL;
+    hr = ID2D1DeviceContext_CreateBitmap(context, input_size, &pixel, sizeof(pixel), &bitmap_desc, &bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)bitmap, FALSE);
+    ID2D1Effect_GetOutput(effect, &output);
+
+    /* a later target on the same DXGI device */
+    desc.type = D2D1_RENDER_TARGET_TYPE_DEFAULT;
+    desc.pixelFormat.format = DXGI_FORMAT_UNKNOWN;
+    desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    desc.dpiX = 0.0f;
+    desc.dpiY = 0.0f;
+    desc.usage = D2D1_RENDER_TARGET_USAGE_NONE;
+    desc.minLevel = D2D1_FEATURE_LEVEL_DEFAULT;
+    hr = ID2D1Factory_CreateDxgiSurfaceRenderTarget(ctx.factory, ctx.surface, &desc, &rt);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1RenderTarget_QueryInterface(rt, &IID_ID2D1DeviceContext, (void **)&target_context);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1DeviceContext_BeginDraw(target_context);
+    ID2D1DeviceContext_Clear(target_context, 0);
+    ID2D1DeviceContext_DrawImage(target_context, output, NULL, NULL, 0, 0);
+    hr = ID2D1DeviceContext_EndDraw(target_context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    get_surface_readback(&ctx, &rb);
+    colour = get_readback_colour(&rb, 0, 0);
+    ok(compare_colour(colour, 0x661a334c, 1), "Got unexpected colour %#lx.\n", colour);
+    release_resource_readback(&rb);
+
+    /* an effect of another device */
+    hr = ID2D1Factory1_CreateDevice(factory, ctx.device, &other_device);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Device_CreateDeviceContext(other_device, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &other_context);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Image_Release(output);
+    ID2D1Bitmap1_Release(bitmap);
+    ID2D1Effect_Release(effect);
+    ID2D1Effect_Release(aux);
+    /* its shaders are loaded on that device first, or the effect cannot be created there */
+    hr = ID2D1DeviceContext_CreateEffect(other_context, &CLSID_AuxEffect, &aux);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Effect_GetValueByName(aux, L"Context", D2D1_PROPERTY_TYPE_IUNKNOWN, (BYTE *)&effect_context,
+            sizeof(effect_context));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = D3DCompile(ps_code, strlen(ps_code), NULL, NULL, NULL, "main", "ps_4_0", 0, 0, &blob, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ID2D1EffectContext_LoadPixelShader(effect_context, &GUID_TestPixelShader,
+            ID3D10Blob_GetBufferPointer(blob), ID3D10Blob_GetBufferSize(blob));
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ID3D10Blob_Release(blob);
+    hr = ID2D1DeviceContext_CreateEffect(other_context, &CLSID_TestEffect, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1DeviceContext_CreateBitmap(other_context, input_size, &pixel, sizeof(pixel), &bitmap_desc, &bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)bitmap, FALSE);
+    ID2D1Effect_GetOutput(effect, &output);
+    ID2D1DeviceContext_BeginDraw(target_context);
+    ID2D1DeviceContext_DrawImage(target_context, output, NULL, NULL, 0, 0);
+    hr = ID2D1DeviceContext_EndDraw(target_context, NULL, NULL);
