From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 18 Sep 2026 15:41:52 -0400
Subject: [PATCH] wineps: give the properties sheet the pages Windows has, and
 follow the locale.

An application's "printer properties" button is DocumentProperties with
DM_IN_PROMPT, and what came back here was a single page called Options
carrying paper size, tray, orientation and quality -- next to a print dialog
the application drew itself, it reads as something other than a printer
properties sheet, because it is missing most of what one has.

Split it the way Windows splits it: Layout takes orientation, duplex, copies
and collate; Paper/Quality takes paper size, tray, print quality and colour.
One dialog proc still serves both. A control that is not on the page being
initialised is simply not found, so every call that would touch it is already
a no-op and neither page needs to know which controls belong to it.

Colour is offered only when the PPD claims *ColorDevice. A PPD that does not
mention it is the ordinary case for a mono laser, and accepting a setting that
is then silently dropped is worse than not offering the choice.

The default paper size also stops ignoring the locale. LOCALE_IPAPERSIZE was
already consulted and then overwritten unconditionally by the PPD's default,
so a desktop set to a country that uses A4 still defaulted to Letter whenever
the PPD came from a model sold in the US -- first noticed, as ever, on a
misprinted page. The PPD default now applies first and the locale's size wins
after it, but only if the PPD actually lists that size.

Translations for the new strings are added to zh_CN.po.

(cherry picked from commit 16ecf8114c9a20acd49e83f20836b255b0567d48)

diff --git a/dlls/wineps.drv/driver.c b/dlls/wineps.drv/driver.c
index 1170e161b17..8bd80f8ba17 100644
--- a/dlls/wineps.drv/driver.c
+++ b/dlls/wineps.drv/driver.c
@@ -235,7 +235,10 @@ typedef struct
 /****************************************************************
  *       PSDRV_PaperDlgProc
  *
- * Dialog proc for 'Paper' propsheet
+ * Dialog proc for both propsheet pages.  Each page carries a subset of the
+ * controls; the ones it does not have are simply not found, and every call
+ * below that would touch them is a no-op, so one proc covers both without
+ * either page needing to know which controls it owns.
  */
 static INT_PTR CALLBACK PSDRV_PaperDlgProc(HWND hwnd, UINT msg,
                                            WPARAM wParam, LPARAM lParam)
@@ -353,6 +356,35 @@ static INT_PTR CALLBACK PSDRV_PaperDlgProc(HWND hwnd, UINT msg,
     {
         SendDlgItemMessageA(hwnd, IDD_TRAY, CB_SETCURSEL, Cursel, 0);
     }
+
+    SetDlgItemInt(hwnd, IDD_COPIES,
+                  (di->pi->Devmode->dmPublic.dmFields & DM_COPIES) &&
+                  di->pi->Devmode->dmPublic.dmCopies > 0 ?
+                  di->pi->Devmode->dmPublic.dmCopies : 1, FALSE);
+    CheckDlgButton(hwnd, IDD_COLLATE,
+                   di->pi->Devmode->dmPublic.dmCollate == DMCOLLATE_TRUE ?
+                   BST_CHECKED : BST_UNCHECKED);
+
+    /* A PPD that never says *ColorDevice is the usual case for a mono laser,
+     * so only offer the choice when the PPD actually claims colour.  Offering
+     * it on a printer that has none is worse than not offering it: the setting
+     * would be accepted and then silently ignored. */
+    if (di->pi->ppd->ColorDevice == CD_False || di->pi->ppd->ColorDevice == CD_NotSpecified)
+    {
+        ShowWindow(GetDlgItem(hwnd, IDD_COLOR), SW_HIDE);
+        ShowWindow(GetDlgItem(hwnd, IDD_COLOR_NAME), SW_HIDE);
+    }
+    else
+    {
+        WCHAR buf[64];
+
+        LoadStringW(PSDRV_hInstance, IDS_MONOCHROME, buf, ARRAY_SIZE(buf));
+        SendDlgItemMessageW(hwnd, IDD_COLOR, CB_INSERTSTRING, 0, (LPARAM)buf);
+        LoadStringW(PSDRV_hInstance, IDS_COLOR, buf, ARRAY_SIZE(buf));
+        SendDlgItemMessageW(hwnd, IDD_COLOR, CB_INSERTSTRING, 1, (LPARAM)buf);
+        SendDlgItemMessageW(hwnd, IDD_COLOR, CB_SETCURSEL,
+                            di->pi->Devmode->dmPublic.dmColor == DMCOLOR_MONOCHROME ? 0 : 1, 0);
+    }
     break;
 
   case WM_COMMAND:
@@ -383,6 +415,38 @@ static INT_PTR CALLBACK PSDRV_PaperDlgProc(HWND hwnd, UINT msg,
         SendMessageW(GetParent(hwnd), PSM_CHANGED, 0, 0);
       }
       break;
+    case IDD_COPIES:
+      if (HIWORD(wParam) == EN_CHANGE)
+      {
+        BOOL ok;
+        UINT n = GetDlgItemInt(hwnd, IDD_COPIES, &ok, FALSE);
+
+        /* An empty box while the user is retyping is not an error; leave the
+         * devmode alone until there is a number to put in it. */
+        if (ok && n >= 1 && n <= 9999)
+        {
+          di->dlgdm->dmPublic.dmCopies = n;
+          di->dlgdm->dmPublic.dmFields |= DM_COPIES;
+          SendMessageW(GetParent(hwnd), PSM_CHANGED, 0, 0);
+        }
+      }
+      break;
+    case IDD_COLLATE:
+      di->dlgdm->dmPublic.dmCollate =
+        IsDlgButtonChecked(hwnd, IDD_COLLATE) == BST_CHECKED ?
+        DMCOLLATE_TRUE : DMCOLLATE_FALSE;
+      di->dlgdm->dmPublic.dmFields |= DM_COLLATE;
+      SendMessageW(GetParent(hwnd), PSM_CHANGED, 0, 0);
+      break;
+    case IDD_COLOR:
+      if (HIWORD(wParam) == CBN_SELCHANGE)
+      {
+        Cursel = SendDlgItemMessageW(hwnd, IDD_COLOR, CB_GETCURSEL, 0, 0);
+        di->dlgdm->dmPublic.dmColor = Cursel ? DMCOLOR_COLOR : DMCOLOR_MONOCHROME;
+        di->dlgdm->dmPublic.dmFields |= DM_COLOR;
+        SendMessageW(GetParent(hwnd), PSM_CHANGED, 0, 0);
+      }
+      break;
     case IDD_ORIENT_PORTRAIT:
     case IDD_ORIENT_LANDSCAPE:
       TRACE("Setting orientation to %s\n", wParam == IDD_ORIENT_PORTRAIT ?
@@ -532,11 +596,16 @@ LONG WINAPI DrvDocumentPropertySheets(PROPSHEETUI_INFO *info, LPARAM lparam)
             *di->dlgdm = *pi->Devmode;
             psp.dwSize = sizeof(psp);
             psp.hInstance = PSDRV_hInstance;
-            psp.pszTemplate = L"PAPER";
             psp.pszIcon = NULL;
             psp.pfnDlgProc = PSDRV_PaperDlgProc;
             psp.lParam = (LPARAM)di;
 
+            /* Layout first, then Paper/Quality: the order Windows uses. */
+            psp.pszTemplate = L"LAYOUT";
+            if (!info->pfnComPropSheet(info->hComPropSheet, CPSFUNC_ADD_PROPSHEETPAGEW, (LPARAM)&psp, 0))
+                return ERR_CPSUI_GETLASTERROR;
+
+            psp.pszTemplate = L"PAPER";
             if (!info->pfnComPropSheet(info->hComPropSheet, CPSFUNC_ADD_PROPSHEETPAGEW, (LPARAM)&psp, 0))
                 return ERR_CPSUI_GETLASTERROR;
         }
diff --git a/dlls/wineps.drv/init.c b/dlls/wineps.drv/init.c
index e8073aa1881..6f9f8e2918e 100644
--- a/dlls/wineps.drv/init.c
+++ b/dlls/wineps.drv/init.c
@@ -650,19 +650,6 @@ PRINTERINFO *PSDRV_FindPrinterInfo(LPCWSTR name)
     pi->Devmode = get_devmode( hPrinter, name, &using_default_devmode, size );
     if (!pi->Devmode) goto fail;
 
-    if(using_default_devmode) {
-        DWORD papersize;
-
-	if(GetLocaleInfoW(LOCALE_USER_DEFAULT, LOCALE_IPAPERSIZE | LOCALE_RETURN_NUMBER,
-			  (LPWSTR)&papersize, sizeof(papersize)/sizeof(WCHAR))) {
-	    DEVMODEW dm;
-	    memset(&dm, 0, sizeof(dm));
-	    dm.dmFields = DM_PAPERSIZE;
-	    dm.dmPaperSize = papersize;
-	    PSDRV_MergeDevmodes(pi->Devmode, &dm, pi);
-	}
-    }
-
     if(pi->ppd->DefaultPageSize) { /* We'll let the ppd override the devmode */
         DEVMODEW dm;
         memset(&dm, 0, sizeof(dm));
@@ -671,6 +658,33 @@ PRINTERINFO *PSDRV_FindPrinterInfo(LPCWSTR name)
         PSDRV_MergeDevmodes(pi->Devmode, &dm, pi);
     }
 
+    /* A devmode the user has never touched should follow the locale where the
+     * printer can, which is what Windows does.  Taking the PPD's default
+     * unconditionally is how a desktop set to a country that uses A4 ends up
+     * defaulting to Letter, merely because the PPD was written for a model
+     * sold in the US -- and the first anyone notices is a misprinted page.
+     * Only a size the PPD actually lists is used: selecting one the printer
+     * does not have would be worse than leaving its own default alone. */
+    if(using_default_devmode) {
+        DWORD papersize;
+
+	if(GetLocaleInfoW(LOCALE_USER_DEFAULT, LOCALE_IPAPERSIZE | LOCALE_RETURN_NUMBER,
+			  (LPWSTR)&papersize, sizeof(papersize)/sizeof(WCHAR))) {
+	    PAGESIZE *ps;
+
+	    LIST_FOR_EACH_ENTRY(ps, &pi->ppd->PageSizes, PAGESIZE, entry) {
+		DEVMODEW dm;
+
+		if (ps->WinPage != papersize) continue;
+		memset(&dm, 0, sizeof(dm));
+		dm.dmFields = DM_PAPERSIZE;
+		dm.dmPaperSize = papersize;
+		PSDRV_MergeDevmodes(pi->Devmode, &dm, pi);
+		break;
+	    }
+	}
+    }
+
     if (pi->Devmode->dmPublic.dmDriverExtra != size - pi->Devmode->dmPublic.dmSize)
     {
         pi->Devmode->dmPublic.dmDriverExtra = size - pi->Devmode->dmPublic.dmSize;
diff --git a/dlls/wineps.drv/psdlg.h b/dlls/wineps.drv/psdlg.h
index c16f1f34270..b5be402fc90 100644
--- a/dlls/wineps.drv/psdlg.h
+++ b/dlls/wineps.drv/psdlg.h
@@ -32,7 +32,14 @@
 #define IDD_QUALITY 112
 #define IDD_TRAY_NAME 113
 #define IDD_TRAY 114
+#define IDD_COPIES 120
+#define IDD_COPIES_NAME 121
+#define IDD_COLLATE 122
+#define IDD_COLOR 123
+#define IDD_COLOR_NAME 124
 
 #define IDS_DPI 1000
+#define IDS_COLOR 1001
+#define IDS_MONOCHROME 1002
 
 #endif /* __WINE_PSDLG_H */
diff --git a/dlls/wineps.drv/wineps.rc b/dlls/wineps.drv/wineps.rc
index de6ad78d37a..5cd4167e8da 100644
--- a/dlls/wineps.drv/wineps.rc
+++ b/dlls/wineps.drv/wineps.rc
@@ -22,31 +22,53 @@
 
 LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT
 
-PAPER DIALOG 5, 43, 227, 230
+/* Two pages, named and grouped as Windows' printing preferences are: what the
+ * page looks like goes on "Layout", what it is printed on goes on
+ * "Paper/Quality".  One dialog proc serves both -- a control that is not on
+ * the page being initialised simply is not found, and every call that would
+ * touch it is a no-op, so neither page needs to know about the other. */
+
+LAYOUT DIALOG 5, 43, 227, 215
 STYLE  WS_POPUP | WS_CAPTION | WS_CLIPSIBLINGS | WS_VISIBLE
-CAPTION "Paper"
+CAPTION "Layout"
 FONT 8, "MS Shell Dlg"
 {
- LTEXT "Paper Si&ze:", -1, 10, 6, 200, 8
- LISTBOX IDD_PAPERS, 10, 18, 200, 60, LBS_STANDARD | LBS_HASSTRINGS |
-	 WS_TABSTOP
- GROUPBOX "Orientation", -1, 10, 80, 200, 50
+ GROUPBOX "Orientation", -1, 10, 6, 200, 50
  CONTROL "&Portrait", IDD_ORIENT_PORTRAIT, "Button", BS_AUTORADIOBUTTON |
-	WS_TABSTOP, 20, 93, 180, 10
+	WS_TABSTOP, 20, 20, 180, 10
  CONTROL "&Landscape", IDD_ORIENT_LANDSCAPE, "Button", BS_AUTORADIOBUTTON,
-	 20, 110, 180, 10
- LTEXT "Duplex:", IDD_DUPLEX_NAME, 10, 140, 200, 8
- COMBOBOX IDD_DUPLEX, 10, 151, 200, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS |
+	 20, 36, 180, 10
+ LTEXT "Print on &Both Sides:", IDD_DUPLEX_NAME, 10, 66, 200, 8
+ COMBOBOX IDD_DUPLEX, 10, 77, 200, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS |
+        WS_TABSTOP
+ LTEXT "&Copies:", IDD_COPIES_NAME, 10, 102, 60, 8
+ EDITTEXT IDD_COPIES, 10, 113, 44, 12, ES_NUMBER | WS_TABSTOP
+ CONTROL "C&ollate", IDD_COLLATE, "Button", BS_AUTOCHECKBOX | WS_TABSTOP,
+	 70, 114, 140, 10
+}
+
+PAPER DIALOG 5, 43, 227, 215
+STYLE  WS_POPUP | WS_CAPTION | WS_CLIPSIBLINGS | WS_VISIBLE
+CAPTION "Paper/Quality"
+FONT 8, "MS Shell Dlg"
+{
+ LTEXT "Paper Si&ze:", -1, 10, 6, 200, 8
+ LISTBOX IDD_PAPERS, 10, 18, 200, 70, LBS_STANDARD | LBS_HASSTRINGS |
+	 WS_TABSTOP
+ LTEXT "Paper &Tray:", IDD_TRAY_NAME, 10, 95, 200, 8
+ COMBOBOX IDD_TRAY, 10, 106, 200, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS |
         WS_TABSTOP
- LTEXT "Print &Quality:", -1, 10, 170, 200, 8
- COMBOBOX IDD_QUALITY, 10, 181, 200, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS |
+ LTEXT "Print &Quality:", -1, 10, 128, 200, 8
+ COMBOBOX IDD_QUALITY, 10, 139, 200, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS |
         WS_TABSTOP
- LTEXT "Paper &Tray:", IDD_TRAY_NAME, 10, 200, 200, 8
- COMBOBOX IDD_TRAY, 10, 211, 200, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS |
+ LTEXT "C&olor:", IDD_COLOR_NAME, 10, 161, 200, 8
+ COMBOBOX IDD_COLOR, 10, 172, 200, 60, CBS_DROPDOWNLIST | CBS_HASSTRINGS |
         WS_TABSTOP
 }
 
 STRINGTABLE
 {
  IDS_DPI "#msgctxt#unit: dots/inch#dpi"
+ IDS_COLOR "Color"
+ IDS_MONOCHROME "Black and White"
 }
