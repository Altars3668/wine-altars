+/*** HttpMultipartFormDataContent: a plain activation, then parts get added ***/
+
+struct multipart_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    LONG ref;
+};
+
+static inline struct multipart_statics *multipart_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct multipart_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI multipart_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct multipart_statics *impl = multipart_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI multipart_factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &multipart_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI multipart_factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &multipart_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI multipart_factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI multipart_factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI multipart_factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI multipart_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct http_content *impl;
+    HRESULT hr;
+
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    if (FAILED(hr = create_content( CONTENT_MULTIPART, &impl ))) return hr;
+
+    if (FAILED(hr = set_media_type( impl, L"multipart/form-data" )))
+    {
+        IHttpContent_Release( &impl->IHttpContent_iface );
+        return hr;
+    }
+
+    *instance = (IInspectable *)&impl->IHttpContent_iface;
+    return S_OK;
+}
+
+static const struct IActivationFactoryVtbl multipart_factory_vtbl =
+{
+    multipart_factory_QueryInterface,
+    multipart_factory_AddRef,
