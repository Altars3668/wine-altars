+DEFINE_IINSPECTABLE_( buffer_create, IHttpBufferContentFactory, struct buffer_content_statics,
+                      buffer_content_statics_from_IHttpBufferContentFactory,
+                      IHttpBufferContentFactory_iface, &impl->IActivationFactory_iface )
+
+static HRESULT create_buffer_content( IBuffer *buffer, UINT32 offset, UINT32 count, IHttpContent **out )
+{
+    struct http_content *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!buffer) return E_INVALIDARG;
+    if (FAILED(hr = create_content( CONTENT_BUFFER, &impl ))) return hr;
+
+    IBuffer_AddRef( buffer );
+    impl->buffer = buffer;
+    impl->offset = offset;
+    impl->count = count;
+
+    *out = &impl->IHttpContent_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_create_CreateFromBuffer( IHttpBufferContentFactory *iface, IBuffer *content,
+                                                      IHttpContent **value )
+{
+    UINT32 length = 0;
+
+    TRACE( "iface %p, content %p, value %p.\n", iface, content, value );
+
+    if (!content) return E_INVALIDARG;
+    IBuffer_get_Length( content, &length );
+    return create_buffer_content( content, 0, length, value );
+}
+
+static HRESULT WINAPI buffer_create_CreateFromBufferWithOffset( IHttpBufferContentFactory *iface,
+        IBuffer *content, UINT32 offset, UINT32 count, IHttpContent **value )
+{
+    UINT32 length = 0;
+
+    TRACE( "iface %p, content %p, offset %u, count %u, value %p.\n", iface, content, offset, count, value );
+
+    if (!content) return E_INVALIDARG;
+    IBuffer_get_Length( content, &length );
+    /* A window past the end of the buffer is not a body anyone can send. */
+    if (offset > length || count > length - offset) return E_BOUNDS;
+    return create_buffer_content( content, offset, count, value );
+}
+
+static const struct IHttpBufferContentFactoryVtbl buffer_create_vtbl =
+{
+    buffer_create_QueryInterface,
+    buffer_create_AddRef,
+    buffer_create_Release,
+    buffer_create_GetIids,
+    buffer_create_GetRuntimeClassName,
+    buffer_create_GetTrustLevel,
+    buffer_create_CreateFromBuffer,
+    buffer_create_CreateFromBufferWithOffset,
+};
