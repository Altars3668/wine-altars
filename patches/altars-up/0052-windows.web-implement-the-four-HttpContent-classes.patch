+static struct buffer_content_statics buffer_content_statics =
+{
+    {&buffer_content_factory_vtbl},
+    {&buffer_create_vtbl},
+    1,
+};
+
+IActivationFactory *http_buffer_content_factory = &buffer_content_statics.IActivationFactory_iface;
