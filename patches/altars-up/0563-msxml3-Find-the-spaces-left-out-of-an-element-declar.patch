From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 11:41:52 -0400
Subject: [PATCH] msxml3: Find the spaces left out of an element declared EMPTY
 when MSXML 6.0 validates a document.

Without validating as it reads, a document leaves out spaces that are
all an element holds, in MSXML 3.0 and 6.0 alike.  validate() in MSXML
3.0 then finds such an element declared EMPTY valid; MSXML 6.0 still
reports the spaces, XML_ILLEGAL_TEXT (tools/msxmlmoreprobe in the
wine-altars repository, its validation and spaces sections).  The
document remembers where it left spaces out, so look for them there.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index cd350e6e1b5..39c5a860cc0 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -4765,7 +4765,7 @@ static void parse_context_cleanup(struct parse_context *c)
         ISAXXMLReaderExtension_Release(c->reader_extension);
 }
 
-static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, struct parse_error *error);
+static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, bool loaded, struct parse_error *error);
 
 HRESULT parse_stream(ISequentialStream *stream, bool utf16, const struct domdoc_properties *properties,
         struct domnode **tree, struct parse_error *error)
@@ -4808,7 +4808,7 @@ HRESULT parse_stream(ISequentialStream *stream, bool utf16, const struct domdoc_
         if (required)
         {
             struct parse_error validation;
-            hr = node_validate_tree(context.root, context.root, &validation);
+            hr = node_validate_tree(context.root, context.root, false, &validation);
             /* spaces in an element declared EMPTY, which the document leaves out, if they come first */
             if (SUCCEEDED(hr) && context.space_line && (hr == S_OK || !validation.line ||
                     context.space_line < validation.line || (context.space_line == validation.line &&
@@ -5462,7 +5462,36 @@ static void dtd_validation_error(void *ctx, const xmlError *error)
     v->end_tag = end_tag;
 }
 
-static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, struct parse_error *error)
+/* MSXML 6.0, validating a document it has loaded, still finds the spaces it left out of an element
+ * declared EMPTY right after its start tag */
+static void dtd_check_left_out_spaces(struct dtd_validation *v, xmlNodePtr node, bool siblings)
+{
+    for (; node; node = siblings ? node->next : NULL)
+    {
+        struct domnode *domnode;
+        xmlElementPtr decl;
+        ULONG_PTR key;
+
+        if (node->type != XML_ELEMENT_NODE) continue;
+        if ((domnode = node->_private2) && (domnode->flags & DOMNODE_IGNORED_WS_AFTER_STARTTAG) &&
+                (decl = dtd_element_decl(v->doc, node)) && decl->etype == XML_ELEMENT_TYPE_EMPTY)
+        {
+            key = 2 * (ULONG_PTR)node->_private + 1;
+            if (!v->code || key < v->key || (key == v->key && v->rank > 0))
+            {
+                v->code = E_XML_ILLEGAL_TEXT;
+                v->key = key;
+                v->rank = 0;
+                v->node = NULL;
+                v->end_tag = FALSE;
+            }
+        }
+        dtd_check_left_out_spaces(v, node->children, true);
+    }
+}
+
+/* loaded: the document is validated after it was loaded, not as it is read */
+static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, bool loaded, struct parse_error *error)
 {
     IXMLDOMSchemaCollection2 *schema = doc->properties->schemaCache;
     HRESULT hr = S_OK;
@@ -5494,7 +5523,9 @@ static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, str
         xmlSetStructuredErrorFunc(&validation, dtd_validation_error);
         valid = node == doc ? xmlValidateDocument(context, xmldoc) : xmlValidateElement(context, xmldoc, xmlnode);
         xmlSetStructuredErrorFunc(handler_context, handler);
-        if (!valid)
+        if (loaded && doc->properties->version >= MSXML6)
+            dtd_check_left_out_spaces(&validation, node == doc ? xmldoc->children : xmlnode, node == doc);
+        if (!valid || validation.code)
         {
             struct domnode *at = validation.node ? validation.node->_private2 : NULL;
 
@@ -5534,7 +5565,7 @@ HRESULT node_validate(struct domnode *doc, IXMLDOMNode *node_obj, IXMLDOMParseEr
 
     if (!(node = get_node_obj(node_obj))) return E_FAIL;
     if (node->owner != doc && node != doc) hr = E_FAIL;
-    else hr = node_validate_tree(doc, node, &error);
+    else hr = node_validate_tree(doc, node, true, &error);
     if (err) *err = create_parseError(error.code, NULL, error.reason, NULL, 0, 0, 0);
     SysFreeString(error.reason);
     return hr;
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index 6aa9478f2db..b69d49cc85e 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -20448,7 +20448,7 @@ static void test_dtd_validation_errors(void)
           .validate_code = { 0xc00ce014, 0xc00ce014 } },
         { "<!DOCTYPE r [<!ELEMENT r EMPTY>]><r>t</r>", 0xc00ce018, 1, 37, 36,
           .validate_code = { 0xc00ce018, 0xc00ce018 } },
-        /* MSXML 3.0 leaves the space out of the document, MSXML 6.0 does not */
+        /* both leave the space out of the document, MSXML 6.0 still finds it when validating it */
         { "<!DOCTYPE r [<!ELEMENT r EMPTY>]><r> </r>", 0xc00ce018, 1, 37, 36, .validate_code = { 0, 0xc00ce018 } },
         { "<!DOCTYPE r [<!ELEMENT r (#PCDATA)><!ELEMENT a EMPTY>]><r><a/></r>", 0xc00ce014, 1, 63, 62,
           .validate_code = { 0xc00ce014, 0xc00ce014 } },
@@ -20540,14 +20540,12 @@ static void test_dtd_validation_errors(void)
         ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
         error = NULL;
         hr = IXMLDOMDocument2_validate(doc, &error);
-        todo_wine_if(i == 1 && j == 11)
         ok(hr == (tests[j].validate_code[i] ? S_FALSE : S_OK), "Unexpected hr %#lx.\n", hr);
         code = line = linepos = filepos = -1;
         IXMLDOMParseError_get_errorCode(error, &code);
         IXMLDOMParseError_get_line(error, &line);
         IXMLDOMParseError_get_linepos(error, &linepos);
         IXMLDOMParseError_get_filepos(error, &filepos);
-        todo_wine_if(i == 1 && j == 11)
         ok(code == tests[j].validate_code[i], "Unexpected error code %#lx.\n", code);
         ok(!line && !linepos && !filepos, "Unexpected position %ld:%ld, %ld.\n", line, linepos, filepos);
         IXMLDOMParseError_Release(error);
