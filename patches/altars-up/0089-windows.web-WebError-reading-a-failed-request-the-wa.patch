+/* What a request's failure says, as Windows reads it: winhttp's errors and HTTP statuses map, nothing else does. */
+static void test_WebErrorStatics(void)
+{
+    static const struct
+    {
+        INT32 hr;
+        WebErrorStatus status;
+    }
+    tests[] =
+    {
+        {0x80072ee2, WebErrorStatus_Timeout},
+        {0x80072ee7, WebErrorStatus_HostNameNotResolved},
+        {0x80072ef1, WebErrorStatus_OperationCanceled},
+        {0x80072efd, WebErrorStatus_CannotConnect},
+        {0x80072efe, WebErrorStatus_ConnectionAborted},
+        {0x80072eff, WebErrorStatus_ConnectionReset},
+        {0x80072f05, WebErrorStatus_CertificateExpired},
+        {0x80072f06, WebErrorStatus_CertificateCommonNameIsIncorrect},
+        {0x80072f07, WebErrorStatus_HttpToHttpsOnRedirection},
+        {0x80072f08, WebErrorStatus_HttpsToHttpOnRedirection},
+        {0x80072f17, WebErrorStatus_CertificateContainsErrors},
+        {0x80072f78, WebErrorStatus_ErrorHttpInvalidServerResponse},
+        {0x80072f83, WebErrorStatus_Disconnected},
+        {0x80072f84, WebErrorStatus_ServerUnreachable},
+        {0x80072f89, WebErrorStatus_CertificateIsInvalid},
+        {0x80072f8a, WebErrorStatus_CertificateRevoked},
+        {0x80190001, WebErrorStatus_UnexpectedStatusCode},
+        {0x80190003, WebErrorStatus_UnexpectedRedirection},
+        {0x80190004, WebErrorStatus_UnexpectedClientError},
+        {0x80190005, WebErrorStatus_UnexpectedServerError},
+        {0x8019012c, WebErrorStatus_MultipleChoices},
+        {0x80190130, WebErrorStatus_NotModified},
+        {0x80190133, WebErrorStatus_TemporaryRedirect},
+        {0x80190194, WebErrorStatus_NotFound},
+        {0x801901a1, WebErrorStatus_ExpectationFailed},
+        {0x801901f4, WebErrorStatus_InternalServerError},
+        {0x801901f9, WebErrorStatus_HttpVersionNotSupported},
+        /* neither winhttp's nor HTTP's */
+        {S_OK, WebErrorStatus_Unknown},
+        {1, WebErrorStatus_Unknown},
+        {E_FAIL, WebErrorStatus_Unknown},
+        {E_ABORT, WebErrorStatus_Unknown},
+        {0x800704c7, WebErrorStatus_Unknown},
+        {0x8007274d, WebErrorStatus_Unknown},
+        {0x80090325, WebErrorStatus_Unknown},
+        {0x80190000, WebErrorStatus_Unknown},
+        {0x80190006, WebErrorStatus_Unknown},
+        {0x80190063, WebErrorStatus_Unknown},
+        {0x80190132, WebErrorStatus_Unknown},
+        {0x801901a2, WebErrorStatus_Unknown},
+        {0x801901fa, WebErrorStatus_Unknown},
+        {0x80072ef0, WebErrorStatus_Unknown},
+        {0x00072efd, WebErrorStatus_Unknown},
+        {0xc0072efd, WebErrorStatus_Unknown},
+        {0x80082efd, WebErrorStatus_Unknown},
+    };
+    IWebErrorStatics *statics;
+    WebErrorStatus status;
+    HSTRING str;
+    HRESULT hr;
+    int i;
+
+    if (!(statics = get_factory( L"Windows.Web.WebError", &IID_IWebErrorStatics ))) return;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        status = -1;
+        hr = IWebErrorStatics_GetStatus( statics, tests[i].hr, &status );
+        ok( hr == S_OK, "%#x: got hr %#lx.\n", tests[i].hr, hr );
+        ok( status == tests[i].status, "%#x: got %d, expected %d.\n", tests[i].hr, status, tests[i].status );
+    }
+
+    /* the statics have no class name of their own */
+    str = (HSTRING)0xdeadbeef;
+    hr = IWebErrorStatics_GetRuntimeClassName( statics, &str );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    IWebErrorStatics_Release( statics );
+}
+
 START_TEST(http)
 {
     HRESULT hr;
@@ -767,6 +847,7 @@ START_TEST(http)
     test_content_text();
     test_content_buffer();
     test_client();
+    test_WebErrorStatics();
 
     RoUninitialize();
 }
