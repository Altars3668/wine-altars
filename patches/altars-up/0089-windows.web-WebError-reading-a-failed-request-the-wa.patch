+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+/*
+ * What the HRESULT a web request failed with says, as a WebErrorStatus.  The
+ * table is the one Windows answers with, measured code by code: sixteen of
+ * the WinINet and WinHTTP errors, which share their numbers; an HTTP status
+ * code folded into 0x8019xxxx as itself when WebErrorStatus names it, and
+ * 0x80190001, 3, 4 and 5 as the unexpected status, redirection, client and
+ * server errors; everything else Unknown.
+ */
+static const struct
+{
+    DWORD error;
+    WebErrorStatus status;
+}
+internet_errors[] =
+{
+    { 12002 /* ERROR_INTERNET_TIMEOUT */, WebErrorStatus_Timeout },
+    { 12007 /* ERROR_INTERNET_NAME_NOT_RESOLVED */, WebErrorStatus_HostNameNotResolved },
+    { 12017 /* ERROR_INTERNET_OPERATION_CANCELLED */, WebErrorStatus_OperationCanceled },
+    { 12029 /* ERROR_INTERNET_CANNOT_CONNECT */, WebErrorStatus_CannotConnect },
+    { 12030 /* ERROR_INTERNET_CONNECTION_ABORTED */, WebErrorStatus_ConnectionAborted },
+    { 12031 /* ERROR_INTERNET_CONNECTION_RESET */, WebErrorStatus_ConnectionReset },
+    { 12037 /* ERROR_INTERNET_SEC_CERT_DATE_INVALID */, WebErrorStatus_CertificateExpired },
+    { 12038 /* ERROR_INTERNET_SEC_CERT_CN_INVALID */, WebErrorStatus_CertificateCommonNameIsIncorrect },
+    { 12039 /* ERROR_INTERNET_HTTP_TO_HTTPS_ON_REDIR */, WebErrorStatus_HttpToHttpsOnRedirection },
+    { 12040 /* ERROR_INTERNET_HTTPS_TO_HTTP_ON_REDIR */, WebErrorStatus_HttpsToHttpOnRedirection },
+    { 12055 /* ERROR_INTERNET_SEC_CERT_ERRORS */, WebErrorStatus_CertificateContainsErrors },
+    { 12152 /* ERROR_HTTP_INVALID_SERVER_RESPONSE */, WebErrorStatus_ErrorHttpInvalidServerResponse },
+    { 12163 /* ERROR_INTERNET_DISCONNECTED */, WebErrorStatus_Disconnected },
+    { 12164 /* ERROR_INTERNET_SERVER_UNREACHABLE */, WebErrorStatus_ServerUnreachable },
+    { 12169 /* ERROR_INTERNET_SEC_INVALID_CERT */, WebErrorStatus_CertificateIsInvalid },
+    { 12170 /* ERROR_INTERNET_SEC_CERT_REVOKED */, WebErrorStatus_CertificateRevoked },
+};
+
+static WebErrorStatus status_from_hresult( HRESULT hr )
+{
+    UINT32 code = hr & 0xffff, i;
+
+    if ((hr & 0xffff0000) == 0x80190000)
+    {
+        switch (code)
+        {
+        case 1: return WebErrorStatus_UnexpectedStatusCode;
+        case 3: return WebErrorStatus_UnexpectedRedirection;
+        case 4: return WebErrorStatus_UnexpectedClientError;
+        case 5: return WebErrorStatus_UnexpectedServerError;
+        }
+        if ((code >= 300 && code <= 305) || code == 307 || (code >= 400 && code <= 417) || (code >= 500 && code <= 505))
+            return code;
+        return WebErrorStatus_Unknown;
+    }
+    if ((hr & 0xffff0000) == 0x80070000)
+    {
+        for (i = 0; i < ARRAY_SIZE(internet_errors); i++)
+            if (internet_errors[i].error == code) return internet_errors[i].status;
+    }
+    return WebErrorStatus_Unknown;
+}
+
+struct web_error_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IWebErrorStatics IWebErrorStatics_iface;
+    LONG ref;
+};
+
+static inline struct web_error_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct web_error_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct web_error_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        IInspectable_AddRef( (*out = &impl->IActivationFactory_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IWebErrorStatics ))
+    {
+        IInspectable_AddRef( (*out = &impl->IWebErrorStatics_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    struct web_error_statics *impl = impl_from_IActivationFactory( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    struct web_error_statics *impl = impl_from_IActivationFactory( iface );
+    return InterlockedDecrement( &impl->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+/* as Windows answers for a class with only static members */
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return E_ILLEGAL_METHOD_CALL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, IWebErrorStatics, struct web_error_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_GetStatus( IWebErrorStatics *iface, INT32 hresult, WebErrorStatus *status )
+{
+    TRACE( "iface %p, hresult %#lx, status %p.\n", iface, (ULONG)hresult, status );
+
+    if (!status) return E_POINTER;
+    *status = status_from_hresult( hresult );
+    return S_OK;
+}
+
+static const struct IWebErrorStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable methods */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* IWebErrorStatics methods */
+    statics_GetStatus,
+};
+
+static struct web_error_statics web_error_statics =
+{
+    {&factory_vtbl},
+    {&statics_vtbl},
+    1,
+};
+
+IActivationFactory *web_error_factory = &web_error_statics.IActivationFactory_iface;
