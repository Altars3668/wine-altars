From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 01:53:33 -0400
Subject: [PATCH] ntdll: Report the file mode in FileAllInformation.

[MS-FSA] 2.1.5.12.3 fills each part of FileAllInformation as the query of
its own class does; the mode is the options the handle was opened with,
which ntdll has from the fd cache, and FileAllInformation answered 0.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 403df1b32d4..2af179e60fb 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -4974,6 +4974,7 @@ static void test_file_mode(void)
 {
     UNICODE_STRING file_name, pipe_dev_name, mountmgr_dev_name, mailslot_dev_name;
     WCHAR tmp_path[MAX_PATH], dos_file_name[MAX_PATH];
+    union { FILE_ALL_INFORMATION info; BYTE buffer[1024]; } all;
     FILE_MODE_INFORMATION mode;
     OBJECT_ATTRIBUTES attr;
     IO_STATUS_BLOCK io;
@@ -5036,7 +5037,7 @@ static void test_file_mode(void)
             file = CreateFileW(dos_file_name, GENERIC_READ | GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, 0);
             ok(file != INVALID_HANDLE_VALUE, "CreateFile failed: %lu\n", GetLastError());
             CloseHandle(file);
-            access |= GENERIC_WRITE | DELETE;
+            access |= GENERIC_WRITE | DELETE | FILE_READ_ATTRIBUTES;
         }
 
         status = pNtOpenFile(&file, access, &attr, &io, 0, option_tests[i].options);
@@ -5048,6 +5049,15 @@ static void test_file_mode(void)
         ok(mode.Mode == option_tests[i].mode, "[%u] Mode = %lx, expected %lx\n",
            i, mode.Mode, option_tests[i].mode);
 
+        if (option_tests[i].file_name == &file_name)
+        {
+            memset(&all, 0xcc, sizeof(all));
+            status = pNtQueryInformationFile(file, &io, &all, sizeof(all), FileAllInformation);
+            ok(status == STATUS_SUCCESS, "[%u] can't get FileAllInformation: %lx\n", i, status);
+            ok(all.info.ModeInformation.Mode == option_tests[i].mode, "[%u] Mode = %lx, expected %lx\n",
+               i, all.info.ModeInformation.Mode, option_tests[i].mode);
+        }
+
         pNtClose(file);
         if (option_tests[i].file_name == &file_name)
             DeleteFileW(dos_file_name);
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 413da035173..3d432c02ab7 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5278,7 +5278,9 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                 info->EaInformation.EaSize = 0;
                 info->AccessInformation.AccessFlags = 0;  /* FIXME */
                 info->PositionInformation.CurrentByteOffset.QuadPart = lseek( fd, 0, SEEK_CUR );
-                info->ModeInformation.Mode = 0;  /* FIXME */
+                info->ModeInformation.Mode = options & (FILE_WRITE_THROUGH | FILE_SEQUENTIAL_ONLY |
+                                                        FILE_NO_INTERMEDIATE_BUFFERING |
+                                                        FILE_SYNCHRONOUS_IO_ALERT | FILE_SYNCHRONOUS_IO_NONALERT);
                 info->AlignmentInformation.AlignmentRequirement = 1;  /* FIXME */
                 status = server_get_name_info( handle, &info->NameInformation, &name_len );
                 io->Information = FIELD_OFFSET(FILE_ALL_INFORMATION, NameInformation.FileName) + name_len;
