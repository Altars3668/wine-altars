+static void test_GetCharsetInfo_aliases(IMultiLanguage2 *ml2)
+{
+    /* IMultiLanguage2 knows its own table, IMultiLanguage the MIME database's code pages */
+    static const struct
+    {
+        const WCHAR *charset, *ret_charset;
+        UINT family_cp, cp, family_cp1, cp1;
+    }
+    tests[] =
+    {
+        { L"latin1", L"latin1", 1252, 28591, 1252, 1252 },
+        { L"iso_8859-1", L"iso_8859-1", 1252, 28591, 1252, 1252 },
+        { L"ascii", L"ascii", 1252, 20127, 1252, 1252 },
+        { L"UTF-16", L"utf-16", 1200, 1200 },
+        { L"ibm852", L"IBM852", 1250, 852, 852, 852 },
+        { L"GBK", L"GBK", 936, 936, 936, 936 },
+        { L"euc-kr", L"euc-kr", 949, 51949, 949, 949 },
+        { L"iso-2022-kr", L"iso-2022-kr", 949, 50225, 949, 50225 },
+        { L"csKOI8R", L"csKOI8R", 1251, 20866, 1251, 20866 },
+        { L"iso-8859-15", L"iso-8859-15", 1252, 28605 },
+        { L"cp1252" },
+        { L"utf-32" },
+    };
+    IMultiLanguage *ml;
+    MIMECSETINFO info;
+    unsigned int i;
+    HRESULT hr;
+
+    hr = IMultiLanguage2_QueryInterface(ml2, &IID_IMultiLanguage, (void **)&ml);
+    ok(hr == S_OK, "got %08lx\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        memset(&info, 0, sizeof(info));
+        hr = IMultiLanguage2_GetCharsetInfo(ml2, (BSTR)tests[i].charset, &info);
+        ok(hr == (tests[i].cp ? S_OK : E_FAIL), "%s: got %08lx\n", wine_dbgstr_w(tests[i].charset), hr);
+        if (hr == S_OK)
+        {
+            ok(!lstrcmpW(info.wszCharset, tests[i].ret_charset), "%s: got %s\n",
+               wine_dbgstr_w(tests[i].charset), wine_dbgstr_w(info.wszCharset));
+            ok(info.uiCodePage == tests[i].family_cp && info.uiInternetEncoding == tests[i].cp,
+               "%s: got %u, %u\n", wine_dbgstr_w(tests[i].charset), info.uiCodePage, info.uiInternetEncoding);
+        }
+
+        memset(&info, 0, sizeof(info));
+        hr = IMultiLanguage_GetCharsetInfo(ml, (BSTR)tests[i].charset, &info);
+        ok(hr == (tests[i].cp1 ? S_OK : E_FAIL), "%s: IMultiLanguage got %08lx\n", wine_dbgstr_w(tests[i].charset), hr);
+        if (hr == S_OK)
+        {
+            ok(!lstrcmpW(info.wszCharset, tests[i].ret_charset), "%s: IMultiLanguage got %s\n",
+               wine_dbgstr_w(tests[i].charset), wine_dbgstr_w(info.wszCharset));
+            ok(info.uiCodePage == tests[i].family_cp1 && info.uiInternetEncoding == tests[i].cp1,
+               "%s: IMultiLanguage got %u, %u\n", wine_dbgstr_w(tests[i].charset), info.uiCodePage,
+               info.uiInternetEncoding);
+        }
+    }
+    IMultiLanguage_Release(ml);
+}
