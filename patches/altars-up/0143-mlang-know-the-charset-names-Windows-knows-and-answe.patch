+/* IMultiLanguage's GetCharsetInfo() takes the code pages from the MIME database in the registry,
+ * which IMultiLanguage2's does not: latin1 is an alias of the database's iso-8859-1, which is
+ * code page 1252, not 28591. The names are as IMultiLanguage2 has them. */
+static HRESULT get_database_charset_info(const WCHAR *charset, MIMECSETINFO *info)
+{
+    WCHAR name[MAX_MIMECSET_NAME], alias[MAX_MIMECSET_NAME];
+    DWORD i, size, family, cp;
+    HKEY charsets, key = NULL;
+    HRESULT hr = E_FAIL;
+    BOOL found = FALSE;
+
+    if (!charset || RegOpenKeyExW(HKEY_CLASSES_ROOT, L"MIME\\Database\\Charset", 0, KEY_READ, &charsets))
+        return E_FAIL;
+    for (i = 0; !found && !RegEnumKeyW(charsets, i, name, ARRAY_SIZE(name)); i++)
+        found = !lstrcmpiW(name, charset);
+
+    if (found && !RegOpenKeyExW(charsets, name, 0, KEY_READ, &key))
+    {
+        size = sizeof(alias);
+        if (!RegQueryValueExW(key, L"AliasForCharset", NULL, NULL, (BYTE *)alias, &size))
+        {
+            RegCloseKey(key);
+            if (RegOpenKeyExW(charsets, alias, 0, KEY_READ, &key)) key = NULL;
+        }
+    }
+    if (key)
+    {
+        size = sizeof(family);
+        if (!RegQueryValueExW(key, L"Codepage", NULL, NULL, (BYTE *)&family, &size))
+        {
+            size = sizeof(cp);
+            if (RegQueryValueExW(key, L"InternetEncoding", NULL, NULL, (BYTE *)&cp, &size)) cp = family;
+            info->uiCodePage = family;
+            info->uiInternetEncoding = cp;
+            lstrcpyW(info->wszCharset, name);
+            for (i = 0; i < ARRAY_SIZE(charset_names); i++)
+                if (!lstrcmpiW(charset_names[i].name, name)) lstrcpyW(info->wszCharset, charset_names[i].name);
+            hr = S_OK;
+        }
+        RegCloseKey(key);
+    }
+    RegCloseKey(charsets);
+    return hr;
+}
+
