From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 18 Sep 2026 04:07:59 -0400
Subject: [PATCH] kernelbase: print the registers and the stack words at an
 unhandled fault.

The stack scan already here answers "where did execution come from".  When
an indirect call is what faulted, the question is instead "where did that
address come from", and the answer is in the registers the caller had just
loaded and in the words it had spilled -- neither of which was printed.
winedbg does not get far enough to show them: it starts, prints two dbghelp
fixmes, and stops.

With both, a fault on `call *0xb8(%rsp)` can be followed back through the
spilled slots to the object and table the bad pointer was fetched from,
without a debugger.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
(cherry picked from commit c347352f5a0195e36310310a7ec98c93a2021c81)

diff --git a/dlls/kernelbase/debug.c b/dlls/kernelbase/debug.c
index 670fdc72215..a83dd8c2a9a 100644
--- a/dlls/kernelbase/debug.c
+++ b/dlls/kernelbase/debug.c
@@ -521,11 +521,64 @@ static void stack_scan_from( const ULONG_PTR *sp, const char *what )
 #endif
 }
 
+/******************************************************************
+ *		dump_registers
+ *
+ * Diagnostic only.  When an indirect call faults, the stack alone says very
+ * little: the address jumped to is already in the fault message, but where
+ * that value came from is in the registers the caller had just loaded.
+ * winedbg does not get far enough to print them (see dump_stack_scan), so
+ * print them here, next to the scan.
+ */
+static void dump_registers( const EXCEPTION_POINTERS *ptr )
+{
+#ifdef __x86_64__
+    const CONTEXT *c = ptr->ContextRecord;
+
+    if (!c) return;
+    MESSAGE( "wine: registers at the fault:\n" );
+    MESSAGE( "wine:   rip=%p rsp=%p rbp=%p\n", (void *)c->Rip, (void *)c->Rsp, (void *)c->Rbp );
+    MESSAGE( "wine:   rax=%p rbx=%p rcx=%p rdx=%p\n",
+             (void *)c->Rax, (void *)c->Rbx, (void *)c->Rcx, (void *)c->Rdx );
+    MESSAGE( "wine:   rsi=%p rdi=%p  r8=%p  r9=%p\n",
+             (void *)c->Rsi, (void *)c->Rdi, (void *)c->R8, (void *)c->R9 );
+    MESSAGE( "wine:   r10=%p r11=%p r12=%p r13=%p\n",
+             (void *)c->R10, (void *)c->R11, (void *)c->R12, (void *)c->R13 );
+    MESSAGE( "wine:   r14=%p r15=%p\n", (void *)c->R14, (void *)c->R15 );
+#endif
+}
+
+/******************************************************************
+ *		dump_stack_raw
+ *
+ * Diagnostic only.  The scan above only prints slots that point into a
+ * module, which is what you want for a call chain -- but when the faulting
+ * value is not a code address at all, the interesting part is the raw words
+ * around it and what sits next to them.
+ */
+static void dump_stack_raw( const EXCEPTION_POINTERS *ptr )
+{
+#ifdef __x86_64__
+    const NT_TIB *tib = (const NT_TIB *)NtCurrentTeb();
+    const ULONG_PTR *sp;
+    int i;
+
+    if (!ptr->ContextRecord) return;
+    sp = (const ULONG_PTR *)ptr->ContextRecord->Rsp;
+    if (sp < (const ULONG_PTR *)tib->StackLimit || sp >= (const ULONG_PTR *)tib->StackBase) return;
+
+    MESSAGE( "wine: stack words at the fault:\n" );
+    for (i = 0; i < 32 && sp + i + 1 < (const ULONG_PTR *)tib->StackBase; i += 2)
+        MESSAGE( "wine:   rsp+0x%02x: %p %p\n", i * 8, (void *)sp[i], (void *)sp[i + 1] );
+#endif
+}
+
 static void dump_stack_scan( const EXCEPTION_POINTERS *ptr )
 {
 #ifdef __x86_64__
     if (!ptr->ContextRecord) return;
     stack_scan_from( (const ULONG_PTR *)ptr->ContextRecord->Rsp, "the fault" );
+    dump_stack_raw( ptr );
 #endif
 }
 
@@ -548,6 +601,7 @@ static BOOL start_debugger( EXCEPTION_POINTERS *epointers, HANDLE event )
 
     format_exception_msg( epointers, buffer, sizeof(buffer) );
     MESSAGE( "wine: %s (thread %04lx), starting debugger...\n", buffer, GetCurrentThreadId() );
+    dump_registers( epointers );
     dump_stack_scan( epointers );
 
     InitializeObjectAttributes( &attr, &nameW, 0, 0, NULL );
