From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 06:52:36 -0400
Subject: [PATCH] dcomp: Finish a suspended draw when the same surface begins
 another.

Office's AirSpace begins a draw on a surface, suspends it, and begins
another on the same surface with another update rectangle; its UI thread
ends the draw later.  BeginDraw refused the second with
DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED, AirSpace threw
AirSpace::DeviceError (over six hundred times in an Excel sweep, after
checking GetDeviceRemovedReason twice each time) and gave up drawing:
Excel's sheet tabs showed an empty tab with no name, underline, arrows
or new-sheet button.  The suspended draw is now finished first, as
EndDraw would finish it, and what both draws drew lands; the sheet tabs
are drawn and no DeviceError is thrown.  EndDraw shares the code.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/dcomp/surface.c b/dlls/dcomp/surface.c
index 2715e0c63d3..3b2d344c118 100644
--- a/dlls/dcomp/surface.c
+++ b/dlls/dcomp/surface.c
@@ -456,6 +456,29 @@ static HRESULT surface_end_target( struct drawing_surface *surface )
  * otherwise on a scratch texture that EndDraw copies into the tiles; the
  * offset says where in what is handed out the rectangle begins.
  */
+/* ends a draw, and what it drew goes into its tile or from the scratch texture into the tiles it covers */
+static HRESULT surface_finish_draw( struct drawing_surface *surface )
+{
+    HRESULT hr = S_OK, ret;
+
+    if (surface->target)
+    {
+        if (!surface->suspended) hr = surface_end_target( surface );
+        ID2D1Bitmap1_Release( surface->target );
+        surface->target = NULL;
+    }
+    if (!surface->update_tile)
+    {
+        ret = surface_write( surface, &surface->update, (ID3D11Resource *)surface->scratch, 0, 0 );
+        if (SUCCEEDED(hr)) hr = ret;
+    }
+    else surface->update_tile->version++;
+    surface->drawing = FALSE;
+    surface->suspended = FALSE;
+    if (surface->device->drawing == surface) surface->device->drawing = NULL;
+    return hr;
+}
+
 static HRESULT WINAPI surface_interop_BeginDraw( ICompositionDrawingSurfaceInterop2 *iface, const RECT *update_rect,
                                                  REFIID iid, void **update_object, POINT *update_offset )
 {
@@ -484,6 +507,14 @@ static HRESULT WINAPI surface_interop_BeginDraw( ICompositionDrawingSurfaceInter
 
     graphics_device_lock( device );
     compositor_lock( surface->base.compositor );
+    /* Office's AirSpace begins a draw, suspends it and begins another on the same surface with another update
+     * rectangle, and Excel's sheet tabs are drawn so on Windows: the suspended draw is finished first, as EndDraw
+     * would. */
+    if (surface->drawing && surface->suspended)
+    {
+        surface_finish_draw( surface );
+        compositor_changed( surface->base.compositor );
+    }
     if (surface->drawing || (device->drawing && !device->drawing->suspended))
     {
         hr = DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
@@ -566,21 +597,7 @@ static HRESULT WINAPI surface_interop_EndDraw( ICompositionDrawingSurfaceInterop
         hr = DCOMPOSITION_ERROR_SURFACE_NOT_BEING_RENDERED;
         goto done;
     }
-    if (surface->target)
-    {
-        if (!surface->suspended) hr = surface_end_target( surface );
-        ID2D1Bitmap1_Release( surface->target );
-        surface->target = NULL;
-    }
-    if (!surface->update_tile)
-    {
-        HRESULT ret = surface_write( surface, &surface->update, (ID3D11Resource *)surface->scratch, 0, 0 );
-        if (SUCCEEDED(hr)) hr = ret;
-    }
-    else surface->update_tile->version++;
-    surface->drawing = FALSE;
-    surface->suspended = FALSE;
-    if (device->drawing == surface) device->drawing = NULL;
+    hr = surface_finish_draw( surface );
 
 done:
     compositor_changed( surface->base.compositor );
