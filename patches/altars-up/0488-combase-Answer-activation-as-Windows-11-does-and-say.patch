From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:18 -0400
Subject: [PATCH] combase: Answer activation as Windows 11 does, and say what
 is not supported.

A class with no in-process server is REGDB_E_CLASSNOTREG for
CoCreateInstance, and CoCreateInstanceEx fills the MULTI_QI results with
the failure on every path (tools/startupgapsprobe misc).
RoGetActivationFactory and RoActivateInstance trace instead of calling
themselves semi-stubs, and a Windows Runtime class served by another
process gets a FIXME and CO_E_SERVER_EXEC_FAILURE instead of
REGDB_E_READREGDB.  DllDebugObjectRPCHook says TRUE without a FIXME:
Wine tells no debugger of the calls made through COM.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index c945acd1905..5b2b0b0495e 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -2101,6 +2101,8 @@ static HRESULT com_get_class_object(REFCLSID requested, DWORD clscontext,
         hr = rpc_get_local_class_object(rclsid, riid, obj);
         if (SUCCEEDED(hr))
             return hr;
+        /* a class with no local server is not registered for the context, as for the others */
+        if (hr == REGDB_E_KEYMISSING) hr = REGDB_E_CLASSNOTREG;
     }
 
     /* Finally try remote: this requires networked DCOM (a lot of work) */
@@ -2147,8 +2149,12 @@ HRESULT WINAPI DECLSPEC_HOTPATCH CoCreateInstanceEx(REFCLSID rclsid, IUnknown *o
     if (!(cls_context & CLSCTX_APPCONTAINER))
         CoGetTreatAsClass(rclsid, &clsid);
 
+    /* what failed, failed for each interface asked for */
     if (FAILED(hr = com_get_class_object(&clsid, cls_context, NULL, &IID_IClassFactory, (void **)&factory)))
+    {
+        init_multi_qi(count, results, hr);
         return hr;
+    }
 
     hr = IClassFactory_CreateInstance(factory, outer, results[0].pIID, (void **)&unk);
     IClassFactory_Release(factory);
@@ -2159,6 +2165,7 @@ HRESULT WINAPI DECLSPEC_HOTPATCH CoCreateInstanceEx(REFCLSID rclsid, IUnknown *o
         else
             FIXME("no instance created for interface %s of class %s, hr %#lx.\n",
                     debugstr_guid(results[0].pIID), debugstr_guid(&clsid), hr);
+        init_multi_qi(count, results, hr);
         return hr;
     }
 
diff --git a/dlls/combase/roapi.c b/dlls/combase/roapi.c
index e4fa618feda..c610b611897 100644
--- a/dlls/combase/roapi.c
+++ b/dlls/combase/roapi.c
@@ -46,7 +46,7 @@ static HRESULT get_library_for_classid(const WCHAR *classid, WCHAR **out)
 {
     ACTCTX_SECTION_KEYED_DATA data;
     HKEY hkey_root, hkey_class;
-    DWORD type, size;
+    DWORD type, size, activation;
     HRESULT hr;
     WCHAR *buf = NULL;
 
@@ -86,6 +86,17 @@ static HRESULT get_library_for_classid(const WCHAR *classid, WCHAR **out)
     }
     RegCloseKey(hkey_root);
 
+    /* a class served by another process has no DllPath, but a Server to start */
+    size = sizeof(activation);
+    if (!RegQueryValueExW(hkey_class, L"ActivationType", NULL, &type, (BYTE *)&activation, &size) &&
+        type == REG_DWORD && activation)
+    {
+        FIXME("Class %s is activated in another process (%lu), which is not supported\n",
+              debugstr_w(classid), activation);
+        hr = CO_E_SERVER_EXEC_FAILURE;
+        goto done;
+    }
+
     /* load (and expand) DllPath registry value */
     if (RegQueryValueExW(hkey_class, L"DllPath", NULL, &type, NULL, &size))
     {
@@ -166,7 +177,7 @@ HRESULT WINAPI DECLSPEC_HOTPATCH RoGetActivationFactory(HSTRING classid, REFIID
     HMODULE module;
     HRESULT hr;
 
-    FIXME("(%s, %s, %p): semi-stub\n", debugstr_hstring(classid), debugstr_guid(iid), class_factory);
+    TRACE("(%s, %s, %p)\n", debugstr_hstring(classid), debugstr_guid(iid), class_factory);
 
     if (!iid || !class_factory)
         return E_INVALIDARG;
@@ -240,7 +251,7 @@ HRESULT WINAPI RoActivateInstance(HSTRING classid, IInspectable **instance)
     IActivationFactory *factory;
     HRESULT hr;
 
-    FIXME("(%p, %p): semi-stub\n", classid, instance);
+    TRACE("(%s, %p)\n", debugstr_hstring(classid), instance);
 
     hr = RoGetActivationFactory(classid, &IID_IActivationFactory, (void **)&factory);
     if (SUCCEEDED(hr))
diff --git a/dlls/combase/rpc.c b/dlls/combase/rpc.c
index 2d4c1afae60..0dd921f698d 100644
--- a/dlls/combase/rpc.c
+++ b/dlls/combase/rpc.c
@@ -2305,7 +2305,9 @@ void rpc_start_remoting(struct apartment *apt)
  */
 BOOL WINAPI DllDebugObjectRPCHook(BOOL trace, /* ORPC_INIT_ARGS * */ void *args)
 {
-    FIXME("%d, %p: stub\n", trace, args);
+    /* a debugger asks to be told of the calls made through COM, which Wine does not tell anyone; Windows 11
+     * says TRUE */
+    TRACE("%d, %p\n", trace, args);
 
     return TRUE;
 }
