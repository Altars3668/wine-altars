+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(appx);
+
+/* Wine has no AppX package store, so a deployment cannot be carried out and no
+ * package is ever registered.  Returning E_NOTIMPL from the PackageManager
+ * methods does not say that: it leaves the [out] operation untouched, and a
+ * caller that follows the documented contract -- inspect the operation, then
+ * read the DeploymentResult off it -- dereferences a pointer that was never
+ * written.  So report the failure the way Windows reports a deployment that
+ * failed: an operation that reaches Error, with the reason both in
+ * IAsyncInfo::ErrorCode and in the DeploymentResult handed back by GetResults. */
+#define DEPLOYMENT_NOT_SUPPORTED HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED )
+
+static const WCHAR deployment_error_text[] =
+    L"Windows.Management.Deployment is not implemented: no package was deployed.";
+
+struct deployment_result
+{
+    IDeploymentResult IDeploymentResult_iface;
+    LONG ref;
+
+    HRESULT extended_error;
+};
+
+static inline struct deployment_result *impl_from_IDeploymentResult( IDeploymentResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct deployment_result, IDeploymentResult_iface );
+}
+
+static HRESULT WINAPI deployment_result_QueryInterface( IDeploymentResult *iface, REFIID iid, void **out )
+{
+    struct deployment_result *impl = impl_from_IDeploymentResult( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IDeploymentResult ))
+    {
+        *out = &impl->IDeploymentResult_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI deployment_result_AddRef( IDeploymentResult *iface )
+{
+    struct deployment_result *impl = impl_from_IDeploymentResult( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI deployment_result_Release( IDeploymentResult *iface )
+{
+    struct deployment_result *impl = impl_from_IDeploymentResult( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI deployment_result_GetIids( IDeploymentResult *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI deployment_result_GetRuntimeClassName( IDeploymentResult *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Management_Deployment_DeploymentResult,
+                                ARRAY_SIZE(RuntimeClass_Windows_Management_Deployment_DeploymentResult) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI deployment_result_GetTrustLevel( IDeploymentResult *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI deployment_result_get_ErrorText( IDeploymentResult *iface, HSTRING *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    return WindowsCreateString( deployment_error_text, ARRAY_SIZE(deployment_error_text) - 1, value );
+}
+
+static HRESULT WINAPI deployment_result_get_ActivityId( IDeploymentResult *iface, GUID *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    /* No deployment ran, so there is no activity to correlate against. */
+    memset( value, 0, sizeof(*value) );
+    return S_OK;
+}
+
+static HRESULT WINAPI deployment_result_get_ExtendedErrorCode( IDeploymentResult *iface, HRESULT *value )
+{
+    struct deployment_result *impl = impl_from_IDeploymentResult( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->extended_error;
+    return S_OK;
+}
+
+static const struct IDeploymentResultVtbl deployment_result_vtbl =
+{
+    deployment_result_QueryInterface,
+    deployment_result_AddRef,
+    deployment_result_Release,
+    /* IInspectable methods */
+    deployment_result_GetIids,
+    deployment_result_GetRuntimeClassName,
+    deployment_result_GetTrustLevel,
+    /* IDeploymentResult methods */
+    deployment_result_get_ErrorText,
+    deployment_result_get_ActivityId,
+    deployment_result_get_ExtendedErrorCode,
+};
+
+static HRESULT deployment_result_create( HRESULT extended_error, IDeploymentResult **out )
+{
+    struct deployment_result *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IDeploymentResult_iface.lpVtbl = &deployment_result_vtbl;
+    impl->ref = 1;
+    impl->extended_error = extended_error;
+
+    *out = &impl->IDeploymentResult_iface;
+    return S_OK;
+}
+
+struct deployment_operation
+{
+    IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress IAsyncOperationWithProgress_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress *completed;
+    IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress *progress;
+    IDeploymentResult *result;
+    HRESULT hr;
+    BOOL closed;
+};
+
+static inline struct deployment_operation *impl_from_IAsyncOperationWithProgress(
+        IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface )
+{
+    return CONTAINING_RECORD( iface, struct deployment_operation, IAsyncOperationWithProgress_iface );
+}
+
+static HRESULT WINAPI async_QueryInterface( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                            REFIID iid, void **out )
+{
+    struct deployment_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress ))
+    {
+        *out = &impl->IAsyncOperationWithProgress_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        *out = &impl->IAsyncInfo_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI async_AddRef( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface )
+{
+    struct deployment_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI async_Release( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface )
+{
+    struct deployment_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->completed)
+            IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_Release( impl->completed );
+        if (impl->progress)
+            IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_Release( impl->progress );
+        if (impl->result) IDeploymentResult_Release( impl->result );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI async_GetIids( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                     ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI async_GetRuntimeClassName( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                                 HSTRING *class_name )
+{
+    static const WCHAR name[] =
+        L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Management.Deployment.DeploymentResult, "
+        L"Windows.Management.Deployment.DeploymentProgress>";
+
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
+}
+
+static HRESULT WINAPI async_GetTrustLevel( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                           TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_put_Progress( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                          IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress *handler )
+{
+    struct deployment_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if (impl->progress)
+        IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_Release( impl->progress );
+    if ((impl->progress = handler))
+        IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_AddRef( impl->progress );
+    LeaveCriticalSection( &impl->cs );
+
+    /* The operation failed before it could report any progress, so the handler
+     * is recorded for get_Progress and never invoked. */
+    return S_OK;
+}
+
+static HRESULT WINAPI async_get_Progress( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                          IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress **handler )
+{
+    struct deployment_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (!handler) return E_POINTER;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed)
+    {
+        LeaveCriticalSection( &impl->cs );
+        *handler = NULL;
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if ((*handler = impl->progress))
+        IAsyncOperationProgressHandler_DeploymentResult_DeploymentProgress_AddRef( *handler );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_put_Completed( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                           IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress *handler )
+{
+    struct deployment_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if (impl->completed)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    }
+    if ((impl->completed = handler))
+        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_AddRef( impl->completed );
+    LeaveCriticalSection( &impl->cs );
+
+    /* The operation is already in its terminal state, so the handler has to run
+     * now: nothing else will ever call it. */
+    if (handler)
+        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_Invoke( handler, iface,
+                                                                                               Error );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_get_Completed( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                           IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress **handler )
+{
+    struct deployment_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (!handler) return E_POINTER;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed)
+    {
+        LeaveCriticalSection( &impl->cs );
+        *handler = NULL;
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if ((*handler = impl->completed))
+        IAsyncOperationWithProgressCompletedHandler_DeploymentResult_DeploymentProgress_AddRef( *handler );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI async_GetResults( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress *iface,
+                                        IDeploymentResult **results )
+{
+    struct deployment_operation *impl = impl_from_IAsyncOperationWithProgress( iface );
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    if (!results) return E_POINTER;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed)
+    {
+        LeaveCriticalSection( &impl->cs );
+        *results = NULL;
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    /* A deployment that failed still has a result to describe why it failed,
+     * and that is where callers are told to look for the reason. */
+    if ((*results = impl->result)) IDeploymentResult_AddRef( *results );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static const struct IAsyncOperationWithProgress_DeploymentResult_DeploymentProgressVtbl async_vtbl =
+{
+    async_QueryInterface,
+    async_AddRef,
+    async_Release,
+    /* IInspectable methods */
+    async_GetIids,
+    async_GetRuntimeClassName,
+    async_GetTrustLevel,
+    /* IAsyncOperationWithProgress<DeploymentResult *, DeploymentProgress> methods */
+    async_put_Progress,
+    async_get_Progress,
+    async_put_Completed,
+    async_get_Completed,
+    async_GetResults,
+};
+
+DEFINE_IINSPECTABLE( async_info, IAsyncInfo, struct deployment_operation, IAsyncOperationWithProgress_iface )
+
+static HRESULT WINAPI async_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    struct deployment_operation *impl = impl_from_IAsyncInfo( iface );
+
+    TRACE( "iface %p, id %p.\n", iface, id );
+
+    if (!id) return E_POINTER;
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *id = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct deployment_operation *impl = impl_from_IAsyncInfo( iface );
+
+    TRACE( "iface %p, status %p.\n", iface, status );
+
+    if (!status) return E_POINTER;
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *status = Error;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error_code )
+{
+    struct deployment_operation *impl = impl_from_IAsyncInfo( iface );
+
+    TRACE( "iface %p, error_code %p.\n", iface, error_code );
+
+    if (!error_code) return E_POINTER;
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    *error_code = impl->hr;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_Cancel( IAsyncInfo *iface )
+{
+    struct deployment_operation *impl = impl_from_IAsyncInfo( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    /* Already in a terminal state: there is nothing left to cancel. */
+    if (impl->closed) return E_ILLEGAL_METHOD_CALL;
+    return S_OK;
+}
+
+static HRESULT WINAPI async_info_Close( IAsyncInfo *iface )
+{
+    struct deployment_operation *impl = impl_from_IAsyncInfo( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &impl->cs );
+    impl->closed = TRUE;
+    if (impl->result)
+    {
+        IDeploymentResult_Release( impl->result );
+        impl->result = NULL;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
+
+static const struct IAsyncInfoVtbl async_info_vtbl =
+{
+    async_info_QueryInterface,
+    async_info_AddRef,
+    async_info_Release,
+    /* IInspectable methods */
+    async_info_GetIids,
+    async_info_GetRuntimeClassName,
+    async_info_GetTrustLevel,
+    /* IAsyncInfo methods */
+    async_info_get_Id,
+    async_info_get_Status,
+    async_info_get_ErrorCode,
+    async_info_Cancel,
+    async_info_Close,
+};
+
+/* Hand back an operation that has already failed, carrying the reason.  Every
+ * PackageManager method that returns an operation returns this one: Wine cannot
+ * deploy a package, and this is how a deployment that did not happen is
+ * reported. */
+HRESULT deployment_not_supported( IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    struct deployment_operation *impl;
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = deployment_result_create( DEPLOYMENT_NOT_SUPPORTED, &impl->result )))
+    {
+        free( impl );
+        return hr;
+    }
+
+    impl->IAsyncOperationWithProgress_iface.lpVtbl = &async_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &async_info_vtbl;
+    impl->ref = 1;
+    impl->hr = DEPLOYMENT_NOT_SUPPORTED;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)( __FILE__ ": deployment_operation.cs" );
+
+    *operation = &impl->IAsyncOperationWithProgress_iface;
+    return S_OK;
+}
+
+/* An iterator over nothing.  No AppX package is ever registered in a Wine
+ * prefix, so every package query has the same, truthful answer: none. */
+struct package_iterator
+{
+    IIterator_Package IIterator_Package_iface;
+    LONG ref;
+};
+
+static inline struct package_iterator *impl_from_IIterator_Package( IIterator_Package *iface )
+{
+    return CONTAINING_RECORD( iface, struct package_iterator, IIterator_Package_iface );
+}
+
+static HRESULT WINAPI package_iterator_QueryInterface( IIterator_Package *iface, REFIID iid, void **out )
+{
+    struct package_iterator *impl = impl_from_IIterator_Package( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IIterator_Package ))
+    {
+        *out = &impl->IIterator_Package_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
