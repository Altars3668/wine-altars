+/* what the reader reports of a DTD: declarations, and entities expanded or skipped, as a list of events */
+static char dtd_events[128][320];
+static unsigned int dtd_event_count;
+
+static void WINAPIV add_dtd_event(const char *format, ...)
+{
+    va_list args;
+
+    if (dtd_event_count == ARRAY_SIZE(dtd_events)) return;
+    va_start(args, format);
+    vsnprintf(dtd_events[dtd_event_count++], sizeof(dtd_events[0]), format, args);
+    va_end(args);
+}
+
+static const char *dtd_str(const WCHAR *str, int len)
+{
+    static char buffers[16][160];
+    static unsigned int index;
+    char *buf = buffers[index++ % ARRAY_SIZE(buffers)];
+    int size = 0;
+
+    if (!str) return "NULL";
+    if (len) size = WideCharToMultiByte(CP_UTF8, 0, str, len, buf + 1, sizeof(buffers[0]) - 3, NULL, NULL);
+    buf[0] = '"';
+    buf[size + 1] = '"';
+    buf[size + 2] = 0;
+    return buf;
+}
