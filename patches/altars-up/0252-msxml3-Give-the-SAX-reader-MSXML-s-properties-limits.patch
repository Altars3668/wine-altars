+static void test_saxreader_dtd_windows(void)
+{
+    static const struct { const CLSID *clsid; const char *name; } readers[] =
+    {
+        { &CLSID_SAXXMLReader, "SAXXMLReader" },
+        { &CLSID_SAXXMLReader30, "SAXXMLReader30" },
+        { &sax_reader_60, "SAXXMLReader60" },
+    };
+    static const char **expect_v3[] =
+    {
+        dtd_events0_v3, dtd_events1_v3, dtd_events2_v3, dtd_events3_v3, dtd_events4_v3, dtd_events5_v3,
+        dtd_events6_v3, dtd_events7_v3,
+    };
+    static const char **expect_v6[] =
+    {
+        dtd_events0_v6, dtd_events1_v6, dtd_events2_v6, dtd_events3_v6, dtd_events4_v6, dtd_events5_v6,
+        dtd_events6_v6, dtd_events7_v6,
+    };
+    const WCHAR *url;
+    char cwd[MAX_PATH * 3];
+    ISAXXMLReader *reader;
+    unsigned int i, j;
+    VARIANT v;
+    HRESULT hr;
+
+    get_dtd_cwd(cwd, sizeof(cwd));
+    for (i = 0; i < ARRAY_SIZE(readers); i++)
+    {
+        winetest_push_context("%s", readers[i].name);
+        hr = CoCreateInstance(readers[i].clsid, NULL, CLSCTX_INPROC_SERVER, &IID_ISAXXMLReader, (void **)&reader);
+        if (FAILED(hr))
+        {
+            win_skip("SAX reader %s is not registered\n", readers[i].name);
+            winetest_pop_context();
+            continue;
+        }
+
+        /* no base URL until one is set */
+        url = (const WCHAR *)0xdeadbeef;
+        hr = ISAXXMLReader_getBaseURL(reader, &url);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(i == 2 ? url && !*url : !url, "got %s\n", debugstr_w(url));
+        url = (const WCHAR *)0xdeadbeef;
+        hr = ISAXXMLReader_getSecureBaseURL(reader, &url);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(i == 2 ? url && !*url : !url, "got %s\n", debugstr_w(url));
+        hr = ISAXXMLReader_putSecureBaseURL(reader, L"http://example.com/secure/");
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = ISAXXMLReader_getSecureBaseURL(reader, &url);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(url && !wcscmp(url, L"http://example.com/secure/"), "got %s\n", debugstr_w(url));
+        ISAXXMLReader_Release(reader);
+
+        for (j = 0; j < ARRAY_SIZE(dtd_docs); j++)
+        {
+            winetest_push_context("doc %u", j);
+            hr = CoCreateInstance(readers[i].clsid, NULL, CLSCTX_INPROC_SERVER, &IID_ISAXXMLReader, (void **)&reader);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            ISAXXMLReader_putContentHandler(reader, &dtd_content);
+            ISAXXMLReader_putDTDHandler(reader, &dtd_dtd);
+            ISAXXMLReader_putErrorHandler(reader, &dtd_error);
+            V_VT(&v) = VT_UNKNOWN;
+            V_UNKNOWN(&v) = (IUnknown *)&dtd_decl;
+            hr = ISAXXMLReader_putProperty(reader, L"http://xml.org/sax/properties/declaration-handler", v);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            V_UNKNOWN(&v) = (IUnknown *)&dtd_lexical;
+            hr = ISAXXMLReader_putProperty(reader, L"http://xml.org/sax/properties/lexical-handler", v);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            hr = ISAXXMLReader_putFeature(reader, L"prohibit-dtd", VARIANT_FALSE);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            if (j == 7)
+            {
+                /* system identifiers are resolved against the base URL in MSXML 6 */
+                hr = ISAXXMLReader_putBaseURL(reader, L"http://example.com/dir/doc.xml");
+                ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+                hr = ISAXXMLReader_getBaseURL(reader, &url);
+                ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+                ok(url && !wcscmp(url, L"http://example.com/dir/doc.xml"), "got %s\n", debugstr_w(url));
+            }
+
+            dtd_event_count = 0;
+            V_VT(&v) = VT_BSTR;
+            V_BSTR(&v) = SysAllocString(dtd_docs[j]);
+            hr = ISAXXMLReader_parse(reader, v);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            VariantClear(&v);
+            check_dtd_events(__LINE__, i == 2 ? expect_v6[j] : expect_v3[j], cwd);
+
+            ISAXXMLReader_Release(reader);
+            winetest_pop_context();
+        }
+        winetest_pop_context();
+    }
+}
