+#define check_limit_property(a, b, c, d, e) check_limit_property_(__LINE__, a, b, c, d, e)
+static void check_limit_property_(unsigned int line, ISAXXMLReader *reader, const WCHAR *name, HRESULT expect_hr,
+        VARTYPE expect_vt, LONG expect_value)
+{
+    VARIANT v;
+    HRESULT hr;
+
+    V_VT(&v) = VT_ERROR;
+    V_I4(&v) = 0xdead;
+    hr = ISAXXMLReader_getProperty(reader, name, &v);
+    ok_(__FILE__, line)(hr == expect_hr, "%s: got %#lx\n", debugstr_w(name), hr);
+    if (FAILED(hr)) return;
+    ok_(__FILE__, line)(V_VT(&v) == expect_vt, "%s: got type %d\n", debugstr_w(name), V_VT(&v));
+    if (V_VT(&v) == VT_I4)
+        ok_(__FILE__, line)(V_I4(&v) == expect_value, "%s: got %ld\n", debugstr_w(name), V_I4(&v));
+    else if (V_VT(&v) == VT_BSTR || V_VT(&v) == VT_UNKNOWN || V_VT(&v) == VT_DISPATCH)
+        ok_(__FILE__, line)(!V_UNKNOWN(&v), "%s: got %p\n", debugstr_w(name), V_UNKNOWN(&v));
+    VariantClear(&v);
+}
+
+#define put_limit(a, b, c, d, e) put_limit_(__LINE__, a, b, c, d, e)
+static void put_limit_(unsigned int line, ISAXXMLReader *reader, const WCHAR *name, VARIANT value, HRESULT expect_hr,
+        LONG expect_value)
+{
+    HRESULT hr;
+
+    if (V_VT(&value) == VT_BSTR)
+        V_BSTR(&value) = SysAllocString(V_BSTR(&value));
+    hr = ISAXXMLReader_putProperty(reader, name, value);
+    ok_(__FILE__, line)(hr == expect_hr, "%s %s: got %#lx\n", debugstr_w(name), wine_dbgstr_variant(&value), hr);
+    check_limit_property_(line, reader, name, S_OK, VT_I4, expect_value);
+    if (V_VT(&value) == VT_BSTR) VariantClear(&value);
+}
