+static void test_saxreader_prohibit_dtd_windows(void)
+{
+    static const struct
+    {
+        const GUID *clsid;
+        const char *name;
+        VARIANT_BOOL default_value;
+        HRESULT error;
+        const char *fatal_event;
+    }
+    tests[] =
+    {
+        { &CLSID_SAXXMLReader30, "SAXXMLReader30", VARIANT_FALSE, 0xc00ce556,
+            "fatalError 0xc00ce556 at 1:11" },
+        { &sax_reader_60, "SAXXMLReader60", VARIANT_TRUE, 0xc00cee4e,
+            "fatalError 0xc00cee4e at 1:9" },
+    };
+    ISAXXMLReader *reader;
+    VARIANT_BOOL value;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context("%s", tests[i].name);
+        hr = CoCreateInstance(tests[i].clsid, NULL, CLSCTX_INPROC_SERVER, &IID_ISAXXMLReader, (void **)&reader);
+        if (FAILED(hr))
+        {
+            win_skip("%s is not registered\n", tests[i].name);
+            winetest_pop_context();
+            continue;
+        }
+        hr = ISAXXMLReader_putErrorHandler(reader, &limit_error);
+        ok(hr == S_OK, "got %#lx\n", hr);
+
+        value = 0xdead;
+        hr = ISAXXMLReader_getFeature(reader, L"prohibit-dtd", &value);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        ok(value == tests[i].default_value, "got %d\n", value);
+
+        dtd_event_count = 0;
+        hr = parse_limit_string(reader, L"<!DOCTYPE a [<!ELEMENT a (#PCDATA)>]><a>x</a>");
+        ok(hr == (i ? tests[i].error : S_OK), "default: got %#lx\n", hr);
+        if (i)
+        {
+            const char *events[] = { tests[i].fatal_event, NULL };
+            check_dtd_events(__LINE__, events, NULL);
+        }
+        hr = ISAXXMLReader_putFeature(reader, L"prohibit-dtd", VARIANT_TRUE);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        dtd_event_count = 0;
+        hr = parse_limit_string(reader, L"<!DOCTYPE a [<!ELEMENT a (#PCDATA)>]><a>x</a>");
+        ok(hr == tests[i].error, "got %#lx\n", hr);
+        {
+            const char *events[] = { tests[i].fatal_event, NULL };
+            check_dtd_events(__LINE__, events, NULL);
+        }
+        dtd_event_count = 0;
+        hr = parse_limit_string(reader, L"<!DOCTYPE a><a>x</a>");
+        ok(hr == tests[i].error, "got %#lx\n", hr);
+        {
+            const char *events[] = { tests[i].fatal_event, NULL };
+            check_dtd_events(__LINE__, events, NULL);
+        }
+        hr = parse_limit_string(reader, L"<a>x</a>");
+        ok(hr == S_OK, "got %#lx\n", hr);
+
+        hr = ISAXXMLReader_putFeature(reader, L"prohibit-dtd", VARIANT_FALSE);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        hr = parse_limit_string(reader, L"<!DOCTYPE a [<!ELEMENT a (#PCDATA)>]><a>x</a>");
+        ok(hr == S_OK, "got %#lx\n", hr);
+
+        ISAXXMLReader_Release(reader);
+        winetest_pop_context();
+    }
+}
