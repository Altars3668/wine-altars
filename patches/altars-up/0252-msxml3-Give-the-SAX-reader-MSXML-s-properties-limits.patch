+    L"<!DOCTYPE a PUBLIC \"-//X//EN\" \"missing.dtd\" [<!ENTITY i \"in\">]><a>&i;</a>",
+    /* content models as written */
+    L"<!DOCTYPE a [<!ELEMENT g (b)*><!ELEMENT h (b*)><!ELEMENT i (a,(b,c))><!ELEMENT j ((a|b),c)>"
+     "<!ELEMENT k (a|(b|c))><!ELEMENT l (p:x|y)+><!ELEMENT m (#PCDATA|a|b)*><!ELEMENT n (a)>"
+     "<!ENTITY % pe \"<!ENTITY fromp 'q'>\"> %pe;]><a/>",
+    /* an entity in an attribute value is replaced without being reported */
+    L"<!DOCTYPE a [<!ENTITY e \"v\"><!ENTITY m \"<b>t</b>&e;\">]><a x=\"1&e;2\">&m;</a>",
+    L"<!DOCTYPE a><a/>",
+    L"<!DOCTYPE a [<!ENTITY ext SYSTEM \"nonexistent-wa.xml\">]><a>&ext;</a>",
+    L"<!DOCTYPE a PUBLIC \"-//X//EN\" \"sub/missing.dtd\" [<!NOTATION n SYSTEM \"rel/n\">]><a/>",
+};
