+static void get_dtd_cwd(char *cwd, int size)
+{
+    WCHAR dir[MAX_PATH];
+    char *p;
+
+    GetCurrentDirectoryW(ARRAY_SIZE(dir), dir);
+    strcpy(cwd, "file:///");
+    WideCharToMultiByte(CP_UTF8, 0, dir, -1, cwd + 8, size - 8, NULL, NULL);
+    for (p = cwd; *p; p++) if (*p == '\\') *p = '/';
+    if (p[-1] == '/') p[-1] = 0;
+}
