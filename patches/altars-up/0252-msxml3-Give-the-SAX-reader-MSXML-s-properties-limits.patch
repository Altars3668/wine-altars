+static void check_dtd_events(unsigned int line, const char **expect, const char *cwd)
+{
+    char event[400];
+    unsigned int i;
+    const char *p;
+
+    for (i = 0; expect[i] && i < dtd_event_count; i++)
+    {
+        if ((p = strstr(expect[i], "<cwd>")))
+            sprintf(event, "%.*s%s%s", (int)(p - expect[i]), expect[i], cwd, p + 5);
+        else
+            strcpy(event, expect[i]);
+        ok_(__FILE__, line)(!strcmp(dtd_events[i], event), "event %u: got %s, expected %s\n", i, dtd_events[i], event);
+    }
+    ok_(__FILE__, line)(!expect[i] && i == dtd_event_count, "got %u events, expected %u\n", dtd_event_count,
+            i + (expect[i] ? 1 : 0));
+    for (; i < dtd_event_count; i++) trace("extra event %u: %s\n", i, dtd_events[i]);
+    for (; expect[i]; i++) trace("missing event %u: %s\n", i, expect[i]);
+}
