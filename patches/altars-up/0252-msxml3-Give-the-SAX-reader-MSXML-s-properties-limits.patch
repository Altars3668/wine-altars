+static HRESULT WINAPI limit_error_QueryInterface(ISAXErrorHandler *iface, REFIID riid, void **obj)
+{
+    *obj = iface;
+    return S_OK;
+}
+static ULONG WINAPI limit_error_AddRef(ISAXErrorHandler *iface) { return 2; }
+static ULONG WINAPI limit_error_Release(ISAXErrorHandler *iface) { return 1; }
+static HRESULT WINAPI limit_error_error(ISAXErrorHandler *iface, ISAXLocator *locator, const WCHAR *message, HRESULT hr)
+{
+    add_dtd_event("error %#lx", hr);
+    return S_OK;
+}
+static HRESULT WINAPI limit_error_fatalError(ISAXErrorHandler *iface, ISAXLocator *locator, const WCHAR *message,
+        HRESULT hr)
+{
+    int line = -1, column = -1;
+
+    ISAXLocator_getLineNumber(locator, &line);
+    ISAXLocator_getColumnNumber(locator, &column);
+    add_dtd_event("fatalError %#lx at %d:%d", hr, line, column);
+    return S_OK;
+}
+static HRESULT WINAPI limit_error_ignorableWarning(ISAXErrorHandler *iface, ISAXLocator *locator,
+        const WCHAR *message, HRESULT hr)
+{
+    add_dtd_event("ignorableWarning %#lx", hr);
+    return S_OK;
+}
+
+static const ISAXErrorHandlerVtbl limit_error_vtbl =
+{
+    limit_error_QueryInterface,
+    limit_error_AddRef,
+    limit_error_Release,
+    limit_error_error,
+    limit_error_fatalError,
+    limit_error_ignorableWarning,
+};
+static ISAXErrorHandler limit_error = { &limit_error_vtbl };
+
+static HRESULT parse_limit_stream(ISAXXMLReader *reader, const char *data, unsigned int size)
+{
+    IStream *stream;
+    VARIANT v;
+    HRESULT hr;
+
+    CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    IStream_Write(stream, data, size, NULL);
+    IStream_Seek(stream, (LARGE_INTEGER){{0}}, STREAM_SEEK_SET, NULL);
+    V_VT(&v) = VT_UNKNOWN;
+    V_UNKNOWN(&v) = (IUnknown *)stream;
+    hr = ISAXXMLReader_parse(reader, v);
+    IStream_Release(stream);
+    return hr;
+}
+
+static HRESULT parse_limit_string(ISAXXMLReader *reader, const WCHAR *xml)
+{
+    VARIANT v;
+    HRESULT hr;
+
+    V_VT(&v) = VT_BSTR;
+    if (!(V_BSTR(&v) = SysAllocString(xml))) return E_OUTOFMEMORY;
+    hr = ISAXXMLReader_parse(reader, v);
+    VariantClear(&v);
+    return hr;
+}
