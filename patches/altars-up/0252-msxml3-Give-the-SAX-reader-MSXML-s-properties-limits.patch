+        const WCHAR *local, int local_len, const WCHAR *qname, int qname_len, ISAXAttributes *attributes)
+{
+    char event[320];
+    const WCHAR *name, *value;
+    int i, count = 0, name_len, value_len;
+
+    sprintf(event, "startElement %s", dtd_str(qname, qname_len));
+    ISAXAttributes_getLength(attributes, &count);
+    for (i = 0; i < count; i++)
+    {
+        ISAXAttributes_getQName(attributes, i, &name, &name_len);
+        ISAXAttributes_getValue(attributes, i, &value, &value_len);
+        sprintf(event + strlen(event), " %.*s=%s", name_len, dtd_str(name, name_len) + 1, dtd_str(value, value_len));
+    }
+    add_dtd_event("%s", event);
+    return S_OK;
