+/* MSXML 4 and later resolve system identifiers against the reader's base URL or the current directory. */
+static void saxreader_resolve_system_id(struct saxlocator *locator, BSTR *systemid)
+{
+    WCHAR base[INTERNET_MAX_URL_LENGTH], url[INTERNET_MAX_URL_LENGTH], dir[MAX_PATH + 1];
+    DWORD len = ARRAY_SIZE(url), size = ARRAY_SIZE(base), dir_len;
+    const struct saxreader *reader = locator->saxreader;
+    BSTR resolved;
+
+    if (!*systemid || reader->version < MSXML4) return;
+
+    if (reader->base_url && *reader->base_url)
+        lstrcpynW(base, reader->base_url, ARRAY_SIZE(base));
+    else if (reader->parse_url)
+        lstrcpynW(base, reader->parse_url, ARRAY_SIZE(base));
+    else
+    {
+        dir_len = GetCurrentDirectoryW(MAX_PATH, dir);
+        if (!dir_len || dir_len >= MAX_PATH) return;
+        if (dir[dir_len - 1] != '\\') wcscpy(dir + dir_len, L"\\");
+        if (FAILED(UrlCreateFromPathW(dir, base, &size, 0))) return;
+    }
+    if (FAILED(UrlCombineW(base, *systemid, url, &len, 0))) return;
+    if (!(resolved = SysAllocString(url)))
+        return saxreader_set_error(locator, E_OUTOFMEMORY);
+    SysFreeString(*systemid);
+    *systemid = resolved;
+}
