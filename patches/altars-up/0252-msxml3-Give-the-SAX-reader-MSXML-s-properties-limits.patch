+#define check_decl(a, b, c) check_decl_(__LINE__, a, b, c)
+static void check_decl_(unsigned int line, ISAXXMLReader *reader, const WCHAR *name, const WCHAR *expect)
+{
+    VARIANT v;
+    HRESULT hr;
+
+    V_VT(&v) = VT_EMPTY;
+    hr = ISAXXMLReader_getProperty(reader, name, &v);
+    ok_(__FILE__, line)(hr == S_OK, "%s: got %#lx\n", debugstr_w(name), hr);
+    ok_(__FILE__, line)(V_VT(&v) == VT_BSTR, "%s: got type %d\n", debugstr_w(name), V_VT(&v));
+    if (V_VT(&v) != VT_BSTR) return;
+    ok_(__FILE__, line)(expect ? V_BSTR(&v) && !wcscmp(V_BSTR(&v), expect) : !V_BSTR(&v), "%s: got %s\n",
+            debugstr_w(name), debugstr_w(V_BSTR(&v)));
+    VariantClear(&v);
+}
