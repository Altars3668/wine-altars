From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 15:47:24 -0400
Subject: [PATCH] ntdll: Resolve file names under \??\GLOBALROOT.

"\??\GLOBALROOT" is a link to the root of the object namespace, so
"\\?\GLOBALROOT\??\C:\Windows\win.ini" names the same file as
"C:\Windows\win.ini", but get_dos_prefix_len() took "GLOBALROOT" for a
DOS device name and CreateFileW(), GetFileAttributesW() and
NtCreateFile() failed on it.  Skip any number of leading
"\??\GLOBALROOT" components, case-insensitively, before looking for the
DOS prefixes; other names, "\Device\..." after GLOBALROOT included,
are resolved as before.

CrossOver 26.3 strips the prefix as well, but compares a byte length
with a character count and only handles a following "\??\".

The new tests have not been run on Windows yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index de63b2b19e2..627471f82f8 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -7321,6 +7321,88 @@ static void test_stream_names(void)
     DeleteFileW(path);
 }
 
+static void test_globalroot_file(void)
+{
+    static const WCHAR *const prefixes[] = { L"GLOBALROOT", L"gLoBaLrOoT" };
+    WCHAR windows_dir[MAX_PATH], plain[MAX_PATH], win32_path[MAX_PATH + 32], nt_path[MAX_PATH + 32];
+    BY_HANDLE_FILE_INFORMATION plain_info, globalroot_info;
+    HANDLE plain_file, file;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING name;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    DWORD ret, i;
+    BOOL success;
+
+    ret = GetWindowsDirectoryW(windows_dir, ARRAY_SIZE(windows_dir));
+    ok(ret && ret <= ARRAY_SIZE(windows_dir) - ARRAY_SIZE(L"\\win.ini"),
+       "GetWindowsDirectoryW returned %lu, error %lu\n", ret, GetLastError());
+    if (!ret || ret > ARRAY_SIZE(windows_dir) - ARRAY_SIZE(L"\\win.ini")) return;
+
+    swprintf(plain, ARRAY_SIZE(plain), L"%s\\win.ini", windows_dir);
+    plain_file = CreateFileW(plain, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                             NULL, OPEN_EXISTING, 0, NULL);
+    ok(plain_file != INVALID_HANDLE_VALUE, "CreateFileW(%s) failed, error %lu\n",
+       wine_dbgstr_w(plain), GetLastError());
+    if (plain_file == INVALID_HANDLE_VALUE) return;
+    success = GetFileInformationByHandle(plain_file, &plain_info);
+    ok(success, "GetFileInformationByHandle(%s) failed, error %lu\n", wine_dbgstr_w(plain), GetLastError());
+    if (!success)
+    {
+        CloseHandle(plain_file);
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(prefixes); i++)
+    {
+        swprintf(win32_path, ARRAY_SIZE(win32_path), L"\\\\?\\%s\\??\\%s", prefixes[i], plain);
+        swprintf(nt_path, ARRAY_SIZE(nt_path), L"\\??\\%s\\??\\%s", prefixes[i], plain);
+        winetest_push_context("%s", wine_dbgstr_w(prefixes[i]));
+
+        ret = GetFileAttributesW(win32_path);
+        ok(ret != INVALID_FILE_ATTRIBUTES, "GetFileAttributesW(%s) failed, error %lu\n",
+           wine_dbgstr_w(win32_path), GetLastError());
+        file = CreateFileW(win32_path, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                           NULL, OPEN_EXISTING, 0, NULL);
+        ok(file != INVALID_HANDLE_VALUE, "CreateFileW(%s) failed, error %lu\n",
+           wine_dbgstr_w(win32_path), GetLastError());
+        if (file != INVALID_HANDLE_VALUE)
+        {
+            success = GetFileInformationByHandle(file, &globalroot_info);
+            ok(success, "GetFileInformationByHandle failed, error %lu\n", GetLastError());
+            if (success)
+                ok(globalroot_info.dwVolumeSerialNumber == plain_info.dwVolumeSerialNumber &&
+                   globalroot_info.nFileIndexHigh == plain_info.nFileIndexHigh &&
+                   globalroot_info.nFileIndexLow == plain_info.nFileIndexLow,
+                   "GLOBALROOT CreateFileW opened a different file\n");
+            CloseHandle(file);
+        }
+
+        name.Buffer = nt_path;
+        name.Length = lstrlenW(nt_path) * sizeof(WCHAR);
+        name.MaximumLength = sizeof(nt_path);
+        InitializeObjectAttributes(&attr, &name, OBJ_CASE_INSENSITIVE, NULL, NULL);
+        status = pNtCreateFile(&file, FILE_READ_ATTRIBUTES | SYNCHRONIZE, &attr, &io, NULL, 0,
+                               FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                               FILE_OPEN, FILE_NON_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT, NULL, 0);
+        ok(status == STATUS_SUCCESS, "NtCreateFile(%s) failed, status %#lx\n",
+           wine_dbgstr_w(nt_path), status);
+        if (status == STATUS_SUCCESS)
+        {
+            success = GetFileInformationByHandle(file, &globalroot_info);
+            ok(success, "GetFileInformationByHandle on NtCreateFile failed, error %lu\n", GetLastError());
+            if (success)
+                ok(globalroot_info.dwVolumeSerialNumber == plain_info.dwVolumeSerialNumber &&
+                   globalroot_info.nFileIndexHigh == plain_info.nFileIndexHigh &&
+                   globalroot_info.nFileIndexLow == plain_info.nFileIndexLow,
+                   "GLOBALROOT NtCreateFile opened a different file\n");
+            CloseHandle(file);
+        }
+        winetest_pop_context();
+    }
+    CloseHandle(plain_file);
+}
+
 START_TEST(file)
 {
     char temp_path[MAX_PATH];
@@ -7351,6 +7433,7 @@ START_TEST(file)
     test_CreateFile();
     test_CreateFileA();
     test_CreateFileW();
+    test_globalroot_file();
     test_CreateFile2();
     test_DeleteFileA();
     test_DeleteFileW();
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 74b746b68fa..b2fa59581db 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -3470,14 +3470,25 @@ failed:
 static inline int get_dos_prefix_len( const UNICODE_STRING *name )
 {
     static const WCHAR dosdev_prefixW[] = {'\\','D','o','s','D','e','v','i','c','e','s','\\'};
+    static const WCHAR globalrootW[] = {'\\','?','?','\\','G','L','O','B','A','L','R','O','O','T','\\'};
+    const WCHAR *prefix = name->Buffer;
+    unsigned int length = name->Length;
+    int prefix_len = 0;
 
-    if (name->Length >= sizeof(nt_prefixW) &&
-        !memcmp( name->Buffer, nt_prefixW, sizeof(nt_prefixW) ))
-        return ARRAY_SIZE( nt_prefixW );
+    /* GLOBALROOT points to the object namespace root; retain the separator before the next prefix. */
+    while (length >= sizeof(globalrootW) && !wcsnicmp( prefix, globalrootW, ARRAY_SIZE( globalrootW ) ))
+    {
+        prefix += ARRAY_SIZE( globalrootW ) - 1;
+        prefix_len += ARRAY_SIZE( globalrootW ) - 1;
+        length -= (ARRAY_SIZE( globalrootW ) - 1) * sizeof(WCHAR);
+    }
+
+    if (length >= sizeof(nt_prefixW) && !memcmp( prefix, nt_prefixW, sizeof(nt_prefixW) ))
+        return prefix_len + ARRAY_SIZE( nt_prefixW );
 
-    if (name->Length >= sizeof(dosdev_prefixW) &&
-        !wcsnicmp( name->Buffer, dosdev_prefixW, ARRAY_SIZE( dosdev_prefixW )))
-        return ARRAY_SIZE( dosdev_prefixW );
+    if (length >= sizeof(dosdev_prefixW) &&
+        !wcsnicmp( prefix, dosdev_prefixW, ARRAY_SIZE( dosdev_prefixW ) ))
+        return prefix_len + ARRAY_SIZE( dosdev_prefixW );
 
     return 0;
 }
