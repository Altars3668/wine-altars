+static HRESULT WINAPI queue_factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* DispatcherQueue is not activatable; it comes from a controller. */
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    if (instance) *instance = NULL;
