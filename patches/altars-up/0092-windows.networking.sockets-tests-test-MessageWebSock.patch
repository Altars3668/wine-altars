+static void test_messages(void)
+{
+    static const struct
+    {
+        SocketMessageType type;
+        UINT32 size;
+        const char *data;
+    }
+    expect[] =
+    {
+        {SocketMessageType_Utf8, 5, "world"},
+        {SocketMessageType_Binary, 3, "\x01\x02\x03"},
+        {SocketMessageType_Utf8, 8, "fragment"},
+        {SocketMessageType_Utf8, 5, "\xe4\xb8\xad\xc3\xa9"},
+    };
+    IAsyncOperationWithProgress_UINT32_UINT32 *op;
+    IWebSocketControl *base_control;
+    IMessageWebSocketControl *control;
+    IWebSocketInformation *information;
+    struct message_handler messages;
+    struct closed_handler closed;
+    EventRegistrationToken token;
+    IMessageWebSocket3 *socket3;
+    IMessageWebSocket *socket;
+    IVector_HSTRING *protocols;
+    HSTRING name, value, str;
+    IHostName *address;
+    IWebSocket *base;
+    IBuffer *buffer;
+    HRESULT hr, error;
+    UINT32 i;
+
+    init_handlers( &messages, &closed );
+    socket = activate( L"Windows.Networking.Sockets.MessageWebSocket", &IID_IMessageWebSocket );
+    base = base_of( socket );
+    IMessageWebSocket_add_MessageReceived( socket, &messages.iface, &token );
+    IWebSocket_add_Closed( base, &closed.iface, &token );
+
+    /* the protocols asked for, and the headers set, go with the handshake */
+    IMessageWebSocket_get_Control( socket, &control );
+    IMessageWebSocketControl_QueryInterface( control, &IID_IWebSocketControl, (void **)&base_control );
+    IWebSocketControl_get_SupportedProtocols( base_control, &protocols );
+    str = hstr( L"chat" );
+    IVector_HSTRING_Append( protocols, str );
+    WindowsDeleteString( str );
+    IVector_HSTRING_Release( protocols );
+    IWebSocketControl_Release( base_control );
+    IMessageWebSocketControl_Release( control );
+    name = hstr( L"X-Test" );
+    value = hstr( L"1" );
+    hr = IWebSocket_SetRequestHeader( base, name, value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsDeleteString( name );
+    WindowsDeleteString( value );
+
+    hr = connect_to( socket, server_uri( "/echo" ) );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !!strstr( server_request, "\r\nX-Test: 1\r\n" ), "got %s.\n", debugstr_a( server_request ) );
+    ok( !!strstr( server_request, "\r\nSec-WebSocket-Protocol: chat\r\n" ), "got %s.\n", debugstr_a( server_request ) );
+    ok( !!strstr( server_request, "\r\nCache-Control: no-cache\r\n" ), "got %s.\n", debugstr_a( server_request ) );
+
+    /* the information has the protocol the server chose, and where this end is */
+    IMessageWebSocket_get_Information( socket, &information );
+    str = NULL;
+    IWebSocketInformation_get_Protocol( information, &str );
+    ok( !wcscmp( WindowsGetStringRawBuffer( str, NULL ), L"chat" ), "got %s.\n", debugstr_hstring( str ) );
+    WindowsDeleteString( str );
+    address = NULL;
+    IWebSocketInformation_get_LocalAddress( information, &address );
+    ok( !!address, "got no address.\n" );
+    if (address)
+    {
+        str = NULL;
+        IHostName_get_CanonicalName( address, &str );
+        ok( !wcscmp( WindowsGetStringRawBuffer( str, NULL ), L"127.0.0.1" ), "got %s.\n", debugstr_hstring( str ) );
+        WindowsDeleteString( str );
+        IHostName_Release( address );
+    }
+    IWebSocketInformation_Release( information );
+
+    /* each write is a message, text or binary as the control says at the time */
+    set_message_type( socket, SocketMessageType_Utf8 );
+    hr = write_message( socket, "hello", &error );
+    ok( hr == S_OK && error == S_OK, "got hr %#lx, error %#lx.\n", hr, error );
+    set_message_type( socket, SocketMessageType_Binary );
+    hr = write_message( socket, "bin", &error );
+    ok( hr == S_OK && error == S_OK, "got hr %#lx, error %#lx.\n", hr, error );
+
+    /* or a frame at a time */
+    hr = IMessageWebSocket_QueryInterface( socket, &IID_IMessageWebSocket3, (void **)&socket3 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    buffer = create_buffer( "ab", 2 );
+    hr = IMessageWebSocket3_SendNonfinalFrameAsync( socket3, buffer, &op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    wait_op( op, &error );
+    ok( error == S_OK, "got error %#lx.\n", error );
+    IAsyncOperationWithProgress_UINT32_UINT32_Release( op );
+    IBuffer_Release( buffer );
+    buffer = create_buffer( "cd", 2 );
+    hr = IMessageWebSocket3_SendFinalFrameAsync( socket3, buffer, &op );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    wait_op( op, &error );
+    ok( error == S_OK, "got error %#lx.\n", error );
+    IAsyncOperationWithProgress_UINT32_UINT32_Release( op );
+    IBuffer_Release( buffer );
+    IMessageWebSocket3_Release( socket3 );
+
+    /* what comes back arrives whole, fragments and all */
+    set_message_type( socket, SocketMessageType_Utf8 );
+    hr = write_message( socket, "send", &error );
+    ok( hr == S_OK && error == S_OK, "got hr %#lx, error %#lx.\n", hr, error );
+    wait_messages( &messages, ARRAY_SIZE(expect) );
+    for (i = 0; i < messages.count && i < ARRAY_SIZE(expect); i++)
+    {
+        winetest_push_context( "%u", i );
+        ok( messages.messages[i].type == expect[i].type, "got type %d.\n", messages.messages[i].type );
+        ok( messages.messages[i].complete == TRUE, "got complete %d.\n", messages.messages[i].complete );
+        ok( messages.messages[i].error == S_OK, "got error %#lx.\n", messages.messages[i].error );
+        ok( messages.messages[i].size == expect[i].size && !memcmp( messages.messages[i].data, expect[i].data, expect[i].size ),
+            "got %s.\n", debugstr_an( messages.messages[i].data, messages.messages[i].size ) );
+        winetest_pop_context();
+    }
+
+    hr = close_socket( socket, 1000, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !WaitForSingleObject( closed.event, 5000 ), "no Closed.\n" );
+    ok( closed.code == 1000, "got %u.\n", closed.code );
+    ok( !WaitForSingleObject( server_done, 5000 ), "the server is not done.\n" );
+    ok( !strcmp( server_log, "81:hello 82:bin 02:ab 80:cd 81:send 88:1000: " ), "got %s.\n", debugstr_a( server_log ) );
+
+    IWebSocket_Release( base );
+    IMessageWebSocket_Release( socket );
+    free_handlers( &messages, &closed );
+}
+
+static void test_close(void)
+{
+    WCHAR long_reason[131], wide_reason[51];
+    struct message_handler messages;
+    struct closed_handler closed;
+    IMessageWebSocket *socket;
+    IClosable *closable;
+    HRESULT hr, error;
+    int i;
+
+    /* the server closes first: Closed says how, and this side can still write until it closes */
+    init_handlers( &messages, &closed );
+    socket = connect_socket( "/bye", &messages, &closed );
+    ok( !WaitForSingleObject( closed.event, 5000 ), "no Closed.\n" );
+    ok( closed.code == 1000, "got %u.\n", closed.code );
+    ok( !wcscmp( closed.reason, L"bye" ), "got %s.\n", debugstr_w( closed.reason ) );
+    hr = write_message( socket, "late", &error );
+    ok( hr == S_OK && error == S_OK, "got hr %#lx, error %#lx.\n", hr, error );
+    hr = close_socket( socket, 1000, L"done" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !WaitForSingleObject( server_done, 5000 ), "the server is not done.\n" );
+    ok( !strcmp( server_log, "82:late 88:1000:done " ), "got %s.\n", debugstr_a( server_log ) );
+    ok( closed.count == 1, "got %ld Closed.\n", closed.count );
+    IMessageWebSocket_Release( socket );
+    free_handlers( &messages, &closed );
+
+    /* this side closes: Closed comes with the answer, and nothing more is written or connected */
+    init_handlers( &messages, &closed );
+    socket = connect_socket( "/echo", &messages, &closed );
+    hr = close_socket( socket, 1000, L"done" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !WaitForSingleObject( closed.event, 5000 ), "no Closed.\n" );
+    ok( closed.code == 1000, "got %u.\n", closed.code );
+    ok( !wcscmp( closed.reason, L"done" ), "got %s.\n", debugstr_w( closed.reason ) );
+    ok( !WaitForSingleObject( server_done, 5000 ), "the server is not done.\n" );
+    ok( !strcmp( server_log, "88:1000:done " ), "got %s.\n", debugstr_a( server_log ) );
+    hr = write_message( socket, "gone", &error );
+    ok( hr == RO_E_CLOSED_, "got hr %#lx.\n", hr );
+    hr = connect_to( socket, server_uri( "/echo" ) );
+    ok( hr == RO_E_CLOSED_, "got hr %#lx.\n", hr );
+    hr = close_socket( socket, 1000, L"again" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IMessageWebSocket_Release( socket );
+    free_handlers( &messages, &closed );
+
+    /* closing without a status sends an empty close frame, and an empty answer is 1005 */
+    init_handlers( &messages, &closed );
+    socket = connect_socket( "/echo", &messages, &closed );
+    IMessageWebSocket_QueryInterface( socket, &IID_IClosable, (void **)&closable );
+    hr = IClosable_Close( closable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !WaitForSingleObject( closed.event, 5000 ), "no Closed.\n" );
+    ok( closed.code == 1005, "got %u.\n", closed.code );
+    ok( closed.null_reason, "got %s.\n", debugstr_w( closed.reason ) );
+    ok( !WaitForSingleObject( server_done, 5000 ), "the server is not done.\n" );
+    ok( !strcmp( server_log, "88: " ), "got %s.\n", debugstr_a( server_log ) );
+    hr = write_message( socket, "gone", &error );
+    ok( hr == RO_E_CLOSED_, "got hr %#lx.\n", hr );
+    hr = IClosable_Close( closable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IClosable_Release( closable );
+    IMessageWebSocket_Release( socket );
+    free_handlers( &messages, &closed );
+
+    /* a status no close frame may carry, or a reason past 123 bytes of UTF-8, is refused */
+    for (i = 0; i < 130; i++) long_reason[i] = 'x';
+    long_reason[i] = 0;
+    for (i = 0; i < 50; i++) wide_reason[i] = 0x4e2d;
+    wide_reason[i] = 0;
+    init_handlers( &messages, &closed );
+    socket = connect_socket( "/echo", &messages, &closed );
+    hr = close_socket( socket, 999, L"r" );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = close_socket( socket, 1006, L"r" );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = close_socket( socket, 2999, L"r" );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = close_socket( socket, 1005, L"r" );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = close_socket( socket, 1000, long_reason );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = close_socket( socket, 1000, wide_reason );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = write_message( socket, "ok", &error );
+    ok( hr == S_OK && error == S_OK, "got hr %#lx, error %#lx.\n", hr, error );
+    hr = close_socket( socket, 5000, L"r" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !WaitForSingleObject( closed.event, 5000 ), "no Closed.\n" );
+    ok( closed.code == 5000, "got %u.\n", closed.code );
+    ok( !WaitForSingleObject( server_done, 5000 ), "the server is not done.\n" );
+    ok( !strcmp( server_log, "82:ok 88:5000:r " ), "got %s.\n", debugstr_a( server_log ) );
+    IMessageWebSocket_Release( socket );
+    free_handlers( &messages, &closed );
+
+    /* a close frame never answered: Closed with 1006 once the connection ends */
+    init_handlers( &messages, &closed );
+    socket = connect_socket( "/hold", &messages, &closed );
+    hr = close_socket( socket, 1000, L"x" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = write_message( socket, "gone", &error );
+    ok( hr == RO_E_CLOSED_, "got hr %#lx.\n", hr );
+    ok( !WaitForSingleObject( closed.event, 5000 ), "no Closed.\n" );
+    ok( closed.code == 1006, "got %u.\n", closed.code );
+    ok( closed.null_reason, "got %s.\n", debugstr_w( closed.reason ) );
+    ok( !WaitForSingleObject( server_done, 5000 ), "the server is not done.\n" );
+    ok( !strcmp( server_log, "88:1000:x " ), "got %s.\n", debugstr_a( server_log ) );
+    IMessageWebSocket_Release( socket );
+    free_handlers( &messages, &closed );
+}
+
+/* A connection lost, or a server breaking the protocol, raises no Closed but one last message. */
+static void test_failure(void)
+{
+    static const struct
+    {
+        const char *path;
+        HRESULT error;
+    }
+    tests[] =
+    {
+        {"/drop", 0x80072efe /* ERROR_WINHTTP_CONNECTION_ERROR */},
+        {"/bad", 0x80072f78 /* ERROR_WINHTTP_INVALID_SERVER_RESPONSE */},
+    };
+    struct message_handler messages;
+    struct closed_handler closed;
+    IMessageWebSocket *socket;
+    HRESULT hr, error;
+    int i;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context( "%s", tests[i].path );
+        init_handlers( &messages, &closed );
+        socket = connect_socket( tests[i].path, &messages, &closed );
+        wait_messages( &messages, 1 );
+        ok( messages.messages[0].type == SocketMessageType_Utf8, "got type %d.\n", messages.messages[0].type );
+        ok( messages.messages[0].complete == TRUE, "got complete %d.\n", messages.messages[0].complete );
+        ok( messages.messages[0].error == tests[i].error, "got error %#lx.\n", messages.messages[0].error );
+        ok( WaitForSingleObject( closed.event, 200 ) == WAIT_TIMEOUT, "got Closed %u.\n", closed.code );
+
+        /* writing is accepted, and fails */
+        hr = write_message( socket, "gone", &error );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( error == HRESULT_FROM_WIN32( ERROR_WINHTTP_CONNECTION_ERROR ), "got error %#lx.\n", error );
+
+        /* closing sends nothing, and Closed comes with 1006 before it returns */
+        hr = close_socket( socket, 1000, L"bye" );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( closed.count == 1, "got %ld Closed.\n", closed.count );
+        ok( closed.code == 1006, "got %u.\n", closed.code );
+        ok( closed.null_reason, "got %s.\n", debugstr_w( closed.reason ) );
+        ok( closed.thread == GetCurrentThreadId(), "Closed from another thread.\n" );
+        ok( !WaitForSingleObject( server_done, 5000 ), "the server is not done.\n" );
+        ok( !server_log[0], "got %s.\n", debugstr_a( server_log ) );
+        IMessageWebSocket_Release( socket );
+        free_handlers( &messages, &closed );
+        winetest_pop_context();
+    }
+}
+
+static void test_connect_errors(void)
+{
+    IMessageWebSocket *socket;
+    HRESULT hr;
+
+    /* a server that will not upgrade answers with its status */
+    socket = activate( L"Windows.Networking.Sockets.MessageWebSocket", &IID_IMessageWebSocket );
+    hr = connect_to( socket, server_uri( "/notfound" ) );
+    ok( hr == 0x80190194, "got hr %#lx.\n", hr );
+    ok( !WaitForSingleObject( server_done, 5000 ), "the server is not done.\n" );
+    IMessageWebSocket_Release( socket );
+
+    /* nothing listening */
+    socket = activate( L"Windows.Networking.Sockets.MessageWebSocket", &IID_IMessageWebSocket );
+    hr = connect_to( socket, create_uri( L"ws://127.0.0.1:1/x" ) );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_WINHTTP_CANNOT_CONNECT ), "got hr %#lx.\n", hr );
+
+    /* only a web socket address */
+    hr = connect_to( socket, create_uri( L"http://127.0.0.1/x" ) );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    IMessageWebSocket_Release( socket );
+}
+
+static void test_web_socket_error(void)
+{
+    static const struct
+    {
+        INT32 hresult;
+        WebErrorStatus status;
+    }
+    tests[] =
+    {
+        {S_OK, WebErrorStatus_Unknown},
+        {E_FAIL, WebErrorStatus_Unknown},
+        {0x80072efd, WebErrorStatus_CannotConnect},
+        {0x80072ee2, WebErrorStatus_Timeout},
+        {0x80072ee7, WebErrorStatus_HostNameNotResolved},
+        {0x80072efe, WebErrorStatus_ConnectionAborted},
+        {0x80072eff, WebErrorStatus_ConnectionReset},
+        {0x80072f78, WebErrorStatus_ErrorHttpInvalidServerResponse},
+        {0x80072f06, WebErrorStatus_CertificateCommonNameIsIncorrect},
+        {0x80072f05, WebErrorStatus_CertificateExpired},
+        {0x80190194, WebErrorStatus_NotFound},
+        {0x80190130, WebErrorStatus_NotModified},
+    };
+    IWebSocketErrorStatics *statics;
+    WebErrorStatus status;
+    HRESULT hr;
+    int i;
+
+    statics = get_factory( L"Windows.Networking.Sockets.WebSocketError", &IID_IWebSocketErrorStatics );
+    if (!statics) return;
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        status = -1;
+        hr = IWebSocketErrorStatics_GetStatus( statics, tests[i].hresult, &status );
+        ok( hr == S_OK, "%#x: got hr %#lx.\n", tests[i].hresult, hr );
+        ok( status == tests[i].status, "%#x: got %d.\n", tests[i].hresult, status );
+    }
+    IWebSocketErrorStatics_Release( statics );
+}
+
+START_TEST(messagewebsocket)
+{
+    HRESULT hr;
+
+    hr = RoInitialize( RO_INIT_MULTITHREADED );
+    ok( hr == S_OK, "RoInitialize failed, hr %#lx\n", hr );
+
+    test_defaults();
+    test_web_socket_error();
+    if (start_server())
+    {
+        test_messages();
+        test_close();
+        test_failure();
+        test_connect_errors();
+    }
+    else skip( "no server.\n" );
+
+    RoUninitialize();
+}
