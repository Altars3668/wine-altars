+#define RO_E_CLOSED_ 0x80000013
+
+static HSTRING hstr( const WCHAR *str )
+{
+    HSTRING ret = NULL;
+    if (str) WindowsCreateString( str, wcslen( str ), &ret );
+    return ret;
+}
+
+static void *get_factory( const WCHAR *name, const IID *iid )
+{
+    HSTRING str = hstr( name );
+    void *factory = NULL;
+    HRESULT hr;
+
+    hr = RoGetActivationFactory( str, iid, &factory );
+    ok( hr == S_OK, "RoGetActivationFactory %s got hr %#lx.\n", debugstr_w( name ), hr );
+    WindowsDeleteString( str );
+    return factory;
+}
+
+static void *activate( const WCHAR *name, const IID *iid )
+{
+    HSTRING str = hstr( name );
+    IInspectable *inspectable;
+    void *ret = NULL;
+    HRESULT hr;
+
+    hr = RoActivateInstance( str, &inspectable );
+    ok( hr == S_OK, "RoActivateInstance %s got hr %#lx.\n", debugstr_w( name ), hr );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) return NULL;
+    IInspectable_QueryInterface( inspectable, iid, &ret );
+    IInspectable_Release( inspectable );
+    return ret;
+}
+
+static AsyncStatus wait_op( void *op, HRESULT *error )
+{
+    AsyncStatus status = Started;
+    IAsyncInfo *info;
+    int i;
+
+    *error = E_FAIL;
+    if (FAILED(IUnknown_QueryInterface( (IUnknown *)op, &IID_IAsyncInfo, (void **)&info ))) return Error;
+    for (i = 0; i < 1000 && status == Started; i++)
+    {
+        IAsyncInfo_get_Status( info, &status );
+        if (status == Started) Sleep( 10 );
+    }
+    IAsyncInfo_get_ErrorCode( info, error );
+    IAsyncInfo_Release( info );
+    return status;
+}
+
+static IBuffer *create_buffer( const void *data, UINT32 len )
+{
+    IBufferFactory *factory = get_factory( L"Windows.Storage.Streams.Buffer", &IID_IBufferFactory );
+    IBufferByteAccess *access;
+    IBuffer *buffer = NULL;
+    BYTE *bytes;
+
+    IBufferFactory_Create( factory, len, &buffer );
+    IBufferFactory_Release( factory );
+    IBuffer_QueryInterface( buffer, &IID_IBufferByteAccess, (void **)&access );
+    IBufferByteAccess_Buffer( access, &bytes );
+    memcpy( bytes, data, len );
+    IBufferByteAccess_Release( access );
+    IBuffer_put_Length( buffer, len );
+    return buffer;
+}
+
+/*** a web socket server in the process ***/
+
+static SOCKET listener;
+static int port;
+static HANDLE server_done;
+static char server_request[4096];   /* the last handshake */
+static char server_log[512];        /* the frames sent since, as "first byte:payload " */
+
+static void send_all( SOCKET s, const void *data, int len )
+{
+    int ret;
+
+    while (len > 0 && (ret = send( s, data, len, 0 )) > 0)
+    {
+        data = (const char *)data + ret;
+        len -= ret;
+    }
+}
+
+static BOOL recv_all( SOCKET s, void *data, int len )
+{
+    int ret;
+
+    while (len > 0)
+    {
+        if ((ret = recv( s, data, len, 0 )) <= 0) return FALSE;
+        data = (char *)data + ret;
+        len -= ret;
+    }
+    return TRUE;
+}
+
+static void send_frame( SOCKET s, BYTE first, const void *data, int len )
+{
+    BYTE head[2] = {first, len};
+
+    send_all( s, head, 2 );
+    send_all( s, data, len );
+}
+
+/* a frame from the client, which masks it, logged; returns its opcode, or -1 */
+static int read_frame( SOCKET s, BYTE *payload, int *payload_len )
+{
+    BYTE head[2], mask[4];
+    int len, i, n;
+
+    if (!recv_all( s, head, 2 )) return -1;
+    len = head[1] & 0x7f;
+    if (!(head[1] & 0x80) || len > 125) return -1;
+    if (!recv_all( s, mask, 4 ) || !recv_all( s, payload, len )) return -1;
+    for (i = 0; i < len; i++) payload[i] ^= mask[i % 4];
+    *payload_len = len;
+
+    n = strlen( server_log );
+    if ((head[0] & 0x0f) == 8 && len >= 2)
+        snprintf( server_log + n, sizeof(server_log) - n, "%02x:%u:%.*s ", head[0], (payload[0] << 8) | payload[1],
+                  len - 2, payload + 2 );
+    else
+        snprintf( server_log + n, sizeof(server_log) - n, "%02x:%.*s ", head[0], len, payload );
+    return head[0] & 0x0f;
+}
+
+static void accept_key( const char *key, char *out, DWORD out_len )
+{
+    static const char guid[] = "258EAFA5-E914-47DA-95CA-C5AB0DC85B11";
+    char buffer[128];
+    HCRYPTPROV prov;
+    HCRYPTHASH hash;
+    BYTE digest[20];
+    DWORD len = sizeof(digest);
+
+    sprintf( buffer, "%s%s", key, guid );
+    CryptAcquireContextW( &prov, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT );
+    CryptCreateHash( prov, CALG_SHA1, 0, 0, &hash );
+    CryptHashData( hash, (BYTE *)buffer, strlen( buffer ), 0 );
+    CryptGetHashParam( hash, HP_HASHVAL, digest, &len, 0 );
+    CryptDestroyHash( hash );
+    CryptReleaseContext( prov, 0 );
+    CryptBinaryToStringA( digest, sizeof(digest), CRYPT_STRING_BASE64 | CRYPT_STRING_NOCRLF, out, &out_len );
+}
+
+static DWORD WINAPI server_thread( void *arg )
+{
+    for (;;)
+    {
+        char buf[4096], head[512], accept_value[64], *key, *end;
+        int len = 0, ret, plen, opcode;
+        BYTE payload[128];
+        SOCKET s;
+
+        if ((s = accept( listener, NULL, NULL )) == INVALID_SOCKET) return 0;
+        while ((ret = recv( s, buf + len, sizeof(buf) - 1 - len, 0 )) > 0)
+        {
+            len += ret;
+            buf[len] = 0;
+            if (strstr( buf, "\r\n\r\n" )) break;
+        }
+        buf[len] = 0;
+        strcpy( server_request, buf );
+        server_log[0] = 0;
+
+        if (strstr( buf, "GET /notfound" ))
+        {
+            static const char response[] = "HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\n\r\n";
+            send_all( s, response, sizeof(response) - 1 );
+            closesocket( s );
+            SetEvent( server_done );
+            continue;
+        }
+        if (!(key = strstr( buf, "Sec-WebSocket-Key: " )) || !(end = strstr( key, "\r\n" )))
+        {
+            closesocket( s );
+            SetEvent( server_done );
+            continue;
+        }
+        *end = 0;
+        accept_key( key + 19, accept_value, sizeof(accept_value) );
+        *end = '\r';
+        sprintf( head, "HTTP/1.1 101 Switching Protocols\r\nUpgrade: websocket\r\nConnection: Upgrade\r\n"
+                 "Sec-WebSocket-Accept: %s\r\n%s\r\n", accept_value,
+                 strstr( buf, "Sec-WebSocket-Protocol: " ) ? "Sec-WebSocket-Protocol: chat\r\n" : "" );
+        send_all( s, head, strlen( head ) );
+
+        if (strstr( buf, "GET /echo" ))
+        {
+            /* close frames are echoed; "send" asks for a text, a binary, a fragmented and a non-ASCII message */
+            while ((opcode = read_frame( s, payload, &plen )) >= 0)
+            {
+                if (opcode == 8)
+                {
+                    send_frame( s, 0x88, payload, plen );
+                    break;
+                }
+                if (plen == 4 && !memcmp( payload, "send", 4 ))
+                {
+                    send_frame( s, 0x81, "world", 5 );
+                    send_frame( s, 0x82, "\x01\x02\x03", 3 );
+                    send_frame( s, 0x01, "frag", 4 );
+                    send_frame( s, 0x80, "ment", 4 );
+                    send_frame( s, 0x81, "\xe4\xb8\xad\xc3\xa9", 5 );
+                }
+            }
+        }
+        else if (strstr( buf, "GET /bye" ))
+        {
+            /* the server closes first */
+            static const BYTE bye[] = {0x03, 0xe8, 'b', 'y', 'e'};
+            send_frame( s, 0x88, bye, sizeof(bye) );
+            while ((opcode = read_frame( s, payload, &plen )) >= 0 && opcode != 8);
+        }
+        else if (strstr( buf, "GET /hold" ))
+        {
+            /* the close frame goes unanswered, and the connection ends a little later */
+            while ((opcode = read_frame( s, payload, &plen )) >= 0 && opcode != 8);
+            Sleep( 500 );
+        }
+        else if (strstr( buf, "GET /drop" ))
+        {
+            /* the connection ends with no close frame */
+            Sleep( 200 );
+        }
+        else if (strstr( buf, "GET /bad" ))
+        {
+            /* 999, which no close frame may carry */
+            static const BYTE bad[] = {0x03, 0xe7};
+            send_frame( s, 0x88, bad, sizeof(bad) );
+            while (read_frame( s, payload, &plen ) >= 0);
+        }
+        closesocket( s );
+        SetEvent( server_done );
+    }
+}
+
+static BOOL start_server(void)
+{
+    struct sockaddr_in addr = {0};
+    int addr_len = sizeof(addr);
+    WSADATA wsa;
+
+    WSAStartup( MAKEWORD(2, 2), &wsa );
+    listener = socket( AF_INET, SOCK_STREAM, 0 );
+    addr.sin_family = AF_INET;
+    addr.sin_addr.s_addr = htonl( INADDR_LOOPBACK );
+    if (bind( listener, (struct sockaddr *)&addr, sizeof(addr) ) || listen( listener, 16 )) return FALSE;
+    getsockname( listener, (struct sockaddr *)&addr, &addr_len );
+    port = ntohs( addr.sin_port );
+    server_done = CreateEventW( NULL, FALSE, FALSE, NULL );
+    CloseHandle( CreateThread( NULL, 0, server_thread, NULL, 0, NULL ) );
+    return TRUE;
+}
+
+/*** the handlers ***/
+
+struct message
+{
+    SocketMessageType type;
+    boolean complete;
+    HRESULT error;      /* what asking for the data answered */
+    UINT32 size;
+    char data[64];
+};
+
+struct message_handler
+{
+    ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs iface;
+    struct message messages[8];
+    LONG count;
+    HANDLE event;
+};
+
+static HRESULT WINAPI message_handler_QueryInterface( ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs *iface,
+                                                      REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI message_handler_AddRef( ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI message_handler_Release( ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI message_handler_Invoke( ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs *iface,
+                                              IMessageWebSocket *sender, IMessageWebSocketMessageReceivedEventArgs *args )
+{
+    struct message_handler *impl = CONTAINING_RECORD( iface, struct message_handler, iface );
+    struct message *message = &impl->messages[impl->count % ARRAY_SIZE(impl->messages)];
+    IMessageWebSocketMessageReceivedEventArgs2 *args2;
+    IDataReader *reader = (void *)0xdeadbeef;
+
+    memset( message, 0, sizeof(*message) );
+    message->complete = 2;
+    IMessageWebSocketMessageReceivedEventArgs_get_MessageType( args, &message->type );
+    if (SUCCEEDED(IMessageWebSocketMessageReceivedEventArgs_QueryInterface( args, &IID_IMessageWebSocketMessageReceivedEventArgs2,
+                                                                          (void **)&args2 )))
+    {
+        IMessageWebSocketMessageReceivedEventArgs2_get_IsMessageComplete( args2, &message->complete );
+        IMessageWebSocketMessageReceivedEventArgs2_Release( args2 );
+    }
+    message->error = IMessageWebSocketMessageReceivedEventArgs_GetDataReader( args, &reader );
+    if (FAILED(message->error))
+    {
+        IInputStream *stream = (void *)0xdeadbeef;
+        HRESULT hr;
+
+        ok( reader == (void *)0xdeadbeef, "got reader %p.\n", reader );
+        hr = IMessageWebSocketMessageReceivedEventArgs_GetDataStream( args, &stream );
+        ok( hr == message->error, "got hr %#lx.\n", hr );
+        ok( stream == (void *)0xdeadbeef, "got stream %p.\n", stream );
+    }
+    else if (reader)
+    {
+        IDataReader_get_UnconsumedBufferLength( reader, &message->size );
+        if (message->size <= sizeof(message->data)) IDataReader_ReadBytes( reader, message->size, (BYTE *)message->data );
+        IDataReader_Release( reader );
+    }
+    InterlockedIncrement( &impl->count );
+    SetEvent( impl->event );
+    return S_OK;
+}
+
+static const ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgsVtbl message_handler_vtbl =
+{
+    message_handler_QueryInterface,
+    message_handler_AddRef,
+    message_handler_Release,
+    message_handler_Invoke,
+};
+
+struct closed_handler
+{
+    ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs iface;
+    LONG count;
+    UINT16 code;
+    WCHAR reason[128];
+    BOOL null_reason;
+    DWORD thread;
+    HANDLE event;
+};
+
+static HRESULT WINAPI closed_handler_QueryInterface( ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs *iface, REFIID iid,
+                                                     void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI closed_handler_AddRef( ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI closed_handler_Release( ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI closed_handler_Invoke( ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs *iface, IWebSocket *sender,
+                                             IWebSocketClosedEventArgs *args )
+{
+    struct closed_handler *impl = CONTAINING_RECORD( iface, struct closed_handler, iface );
+    HSTRING reason = NULL;
+
+    IWebSocketClosedEventArgs_get_Code( args, &impl->code );
+    IWebSocketClosedEventArgs_get_Reason( args, &reason );
+    impl->null_reason = !reason;
+    lstrcpynW( impl->reason, reason ? WindowsGetStringRawBuffer( reason, NULL ) : L"", ARRAY_SIZE(impl->reason) );
+    WindowsDeleteString( reason );
+    impl->thread = GetCurrentThreadId();
+    InterlockedIncrement( &impl->count );
+    SetEvent( impl->event );
+    return S_OK;
+}
+
+static const ITypedEventHandler_IWebSocket_WebSocketClosedEventArgsVtbl closed_handler_vtbl =
+{
+    closed_handler_QueryInterface,
+    closed_handler_AddRef,
+    closed_handler_Release,
+    closed_handler_Invoke,
+};
+
+static void init_handlers( struct message_handler *messages, struct closed_handler *closed )
+{
+    memset( messages, 0, sizeof(*messages) );
+    messages->iface.lpVtbl = &message_handler_vtbl;
+    messages->event = CreateEventW( NULL, FALSE, FALSE, NULL );
+    memset( closed, 0, sizeof(*closed) );
+    closed->iface.lpVtbl = &closed_handler_vtbl;
+    closed->event = CreateEventW( NULL, FALSE, FALSE, NULL );
+}
+
+static void free_handlers( struct message_handler *messages, struct closed_handler *closed )
+{
+    CloseHandle( messages->event );
+    CloseHandle( closed->event );
+}
+
+/*** helpers ***/
+
+static IUriRuntimeClass *create_uri( const WCHAR *text )
+{
+    IUriRuntimeClassFactory *factory = get_factory( L"Windows.Foundation.Uri", &IID_IUriRuntimeClassFactory );
+    IUriRuntimeClass *uri = NULL;
+    HSTRING str = hstr( text );
+
+    IUriRuntimeClassFactory_CreateUri( factory, str, &uri );
+    WindowsDeleteString( str );
+    IUriRuntimeClassFactory_Release( factory );
+    return uri;
+}
+
+static IUriRuntimeClass *server_uri( const char *path )
+{
+    WCHAR buf[64];
+
+    swprintf( buf, ARRAY_SIZE(buf), L"ws://127.0.0.1:%d%S", port, path );
+    return create_uri( buf );
+}
+
+static IWebSocket *base_of( IMessageWebSocket *socket )
+{
+    IWebSocket *base = NULL;
+    IMessageWebSocket_QueryInterface( socket, &IID_IWebSocket, (void **)&base );
+    return base;
+}
+
+static HRESULT connect_to( IMessageWebSocket *socket, IUriRuntimeClass *uri )
+{
+    IWebSocket *base = base_of( socket );
+    IAsyncAction *action;
+    AsyncStatus status;
+    HRESULT hr, error;
+
+    hr = IWebSocket_ConnectAsync( base, uri, &action );
+    IWebSocket_Release( base );
+    IUriRuntimeClass_Release( uri );
+    if (FAILED(hr)) return hr;
+    status = wait_op( action, &error );
+    ok( status == Completed || status == Error, "got status %d.\n", status );
+    IAsyncAction_Release( action );
+    return error;
+}
+
+static IMessageWebSocket *connect_socket( const char *path, struct message_handler *messages, struct closed_handler *closed )
+{
+    IMessageWebSocket *socket = activate( L"Windows.Networking.Sockets.MessageWebSocket", &IID_IMessageWebSocket );
+    EventRegistrationToken token;
+    IWebSocket *base;
+    HRESULT hr;
+
+    base = base_of( socket );
+    hr = IMessageWebSocket_add_MessageReceived( socket, &messages->iface, &token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IWebSocket_add_Closed( base, &closed->iface, &token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IWebSocket_Release( base );
+    hr = connect_to( socket, server_uri( path ) );
+    ok( hr == S_OK, "connecting to %s got hr %#lx.\n", path, hr );
+    return socket;
+}
+
+static void set_message_type( IMessageWebSocket *socket, SocketMessageType type )
+{
+    IMessageWebSocketControl *control;
+
+    IMessageWebSocket_get_Control( socket, &control );
+    IMessageWebSocketControl_put_MessageType( control, type );
+    IMessageWebSocketControl_Release( control );
+}
+
+/* writes a message: the call's result, and in *error the operation's */
+static HRESULT write_message( IMessageWebSocket *socket, const char *text, HRESULT *error )
+{
+    IAsyncOperationWithProgress_UINT32_UINT32 *op;
+    IBuffer *buffer = create_buffer( text, strlen( text ) );
+    IWebSocket *base = base_of( socket );
+    IOutputStream *stream = NULL;
+    UINT32 written = 0;
+    AsyncStatus status;
+    HRESULT hr;
+
+    *error = E_FAIL;
+    IWebSocket_get_OutputStream( base, &stream );
+    hr = IOutputStream_WriteAsync( stream, buffer, &op );
+    if (SUCCEEDED(hr))
+    {
+        status = wait_op( op, error );
+        if (status == Completed)
+        {
+            IAsyncOperationWithProgress_UINT32_UINT32_GetResults( op, &written );
+            ok( written == strlen( text ), "got %u written.\n", written );
+        }
+        else ok( status == Error, "got status %d.\n", status );
+        IAsyncOperationWithProgress_UINT32_UINT32_Release( op );
+    }
+    IOutputStream_Release( stream );
+    IWebSocket_Release( base );
+    IBuffer_Release( buffer );
+    return hr;
+}
+
+static HRESULT close_socket( IMessageWebSocket *socket, UINT16 code, const WCHAR *reason )
+{
+    IWebSocket *base = base_of( socket );
+    HSTRING str = hstr( reason );
+    HRESULT hr;
+
+    hr = IWebSocket_CloseWithStatus( base, code, str );
+    WindowsDeleteString( str );
+    IWebSocket_Release( base );
+    return hr;
+}
+
+static void wait_messages( struct message_handler *messages, LONG count )
+{
+    while (messages->count < count && !WaitForSingleObject( messages->event, 5000 ));
+    ok( messages->count == count, "got %ld messages.\n", messages->count );
+}
