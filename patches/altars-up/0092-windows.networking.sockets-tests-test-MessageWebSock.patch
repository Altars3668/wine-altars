+    IMessageWebSocketControl_QueryInterface( control, &IID_IWebSocketControl, (void **)&base_control );
+    value = 0;
+    IWebSocketControl_get_OutboundBufferSizeInBytes( base_control, &value );
+    ok( value == 65536, "got %u.\n", value );
+    IWebSocketControl_Release( base_control );
+    hr = IMessageWebSocketControl_QueryInterface( control, &IID_IMessageWebSocketControl2, (void **)&control2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    mode = -1;
+    IMessageWebSocketControl2_get_ReceiveMode( control2, &mode );
+    ok( mode == MessageWebSocketReceiveMode_FullMessage, "got %d.\n", mode );
+    span.Duration = 0;
+    IMessageWebSocketControl2_get_DesiredUnsolicitedPongInterval( control2, &span );
+    ok( span.Duration == 300000000, "got %I64d.\n", span.Duration );
+    span.Duration = 0;
+    IMessageWebSocketControl2_get_ActualUnsolicitedPongInterval( control2, &span );
+    ok( span.Duration == 300000000, "got %I64d.\n", span.Duration );
+    IMessageWebSocketControl2_Release( control2 );
+    IMessageWebSocketControl_Release( control );
+
+    /* the information and the output stream are there from the start, each the one object */
+    hr = IMessageWebSocket_get_Information( socket, &information );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IMessageWebSocket_get_Information( socket, &information2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( information == information2, "got %p and %p.\n", information, information2 );
+    address = (void *)0xdeadbeef;
+    hr = IWebSocketInformation_get_LocalAddress( information, &address );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !address, "got %p.\n", address );
+    protocol = (void *)0xdeadbeef;
+    hr = IWebSocketInformation_get_Protocol( information, &protocol );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !protocol, "got %s.\n", debugstr_hstring( protocol ) );
+    IWebSocketInformation_Release( information2 );
+    IWebSocketInformation_Release( information );
+
+    base = base_of( socket );
+    hr = IWebSocket_get_OutputStream( base, &stream );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IWebSocket_get_OutputStream( base, &stream2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( stream == stream2, "got %p and %p.\n", stream, stream2 );
+    IOutputStream_Release( stream2 );
+    IOutputStream_Release( stream );
+
+    hr = IWebSocket_SetRequestHeader( base, NULL, NULL );
