new file mode 100644
index 00000000000..57ebff5280a
--- /dev/null
+++ b/dlls/dcomp/capture.c
@@ -0,0 +1,130 @@
+/*
+ * Captures of composition visuals, for Windows.Graphics.Capture
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+static inline struct capture *impl_from_IUnknown( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct capture, IUnknown_iface );
+}
+
+static HRESULT WINAPI capture_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        IUnknown_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI capture_AddRef( IUnknown *iface )
+{
+    struct capture *capture = impl_from_IUnknown( iface );
+    ULONG ref = InterlockedIncrement( &capture->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+/* the frame being drawn holds the compositor's lock, so a capture that goes is not in one */
+static ULONG WINAPI capture_Release( IUnknown *iface )
+{
+    struct capture *capture = impl_from_IUnknown( iface );
+    ULONG ref = InterlockedDecrement( &capture->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        compositor_lock( capture->compositor );
+        list_remove( &capture->entry );
+        compositor_unlock( capture->compositor );
+        IWineCompositionCaptureSink_Release( capture->sink );
+        if (capture->sources) ID2D1DeviceContext_Release( capture->sources );
+        ID2D1DeviceContext_Release( capture->context );
+        ID3D11Device_Release( capture->device );
+        object_release( &capture->visual->base );
+        free( capture );
+    }
+    return ref;
+}
+
+static const IUnknownVtbl capture_vtbl =
+{
+    capture_QueryInterface,
+    capture_AddRef,
+    capture_Release,
+};
+
+HRESULT capture_start( struct visual *visual, ID3D11Device *device, IWineCompositionCaptureSink *sink, IUnknown **out )
+{
+    static const D2D1_CREATION_PROPERTIES props = {D2D1_THREADING_MODE_MULTI_THREADED};
+    struct compositor *compositor = visual->base.compositor;
+    ID2D1DeviceContext *context;
+    struct capture *capture;
+    IDXGIDevice *dxgi;
+    ID2D1Device *d2d;
+    HRESULT hr;
+
+    TRACE( "visual %p, device %p, sink %p, out %p.\n", visual, device, sink, out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!device || !sink) return E_INVALIDARG;
+
+    /* a Direct2D device of the capture's own, on its Direct3D device */
+    if (FAILED(hr = ID3D11Device_QueryInterface( device, &IID_IDXGIDevice, (void **)&dxgi ))) return hr;
+    hr = D2D1CreateDevice( dxgi, &props, &d2d );
+    IDXGIDevice_Release( dxgi );
+    if (FAILED(hr)) return hr;
+    hr = ID2D1Device_CreateDeviceContext( d2d, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &context );
+    ID2D1Device_Release( d2d );
+    if (FAILED(hr)) return hr;
+
+    if (!(capture = calloc( 1, sizeof(*capture) )))
+    {
+        ID2D1DeviceContext_Release( context );
+        return E_OUTOFMEMORY;
+    }
+    capture->IUnknown_iface.lpVtbl = &capture_vtbl;
+    capture->ref = 1;
+    capture->compositor = compositor;
+    capture->visual = visual;
+    object_addref( &visual->base );
+    capture->device = device;
+    ID3D11Device_AddRef( device );
+    capture->context = context;
+    capture->sink = sink;
+    IWineCompositionCaptureSink_AddRef( sink );
+
+    compositor_lock( compositor );
+    list_add_tail( compositor_captures( compositor ), &capture->entry );
+    compositor_unlock( compositor );
+    compositor_queue_frame( compositor );
+
+    *out = &capture->IUnknown_iface;
+    return S_OK;
+}
