+#pragma makedep header
+
+import "unknwn.idl";
+import "d3d11.idl";
+
+/*
+ * What captures a composition visual (Windows.Graphics.Capture) gives the
+ * composition: the texture to draw each frame into, and a call once it is
+ * drawn.  Both are called on the compositor's thread with its lock held.
+ */
+[
+    object,
+    local,
+    uuid(8e3e8546-236a-4150-b1f5-7fd71ac83d2c)
+]
+interface IWineCompositionCaptureSink : IUnknown
+{
+    /* S_FALSE, and no texture, while every buffer is in use */
+    HRESULT get_buffer([out] ID3D11Texture2D **texture);
+    /* the size is of what was drawn, the time in 100 ns units from the performance counter */
+    void frame_drawn([in] ID3D11Texture2D *texture, [in] UINT width, [in] UINT height, [in] LONGLONG time);
+}
+
+/* What a visual of Wine's composition offers a capture of it. */
+[
+    object,
+    local,
+    uuid(2c5bfbc8-6db9-45d9-b0d8-47ffb816c2c9)
+]
+interface IWineCompositionVisualCapture : IUnknown
+{
+    HRESULT get_size([out] UINT *width, [out] UINT *height);
+    /* Draws the visual, and what is in it, into the sink's buffers on every frame the compositor draws from
+     * now on, the first one soon.  Releasing the object returned stops it. */
+    HRESULT start([in] ID3D11Device *device, [in] IWineCompositionCaptureSink *sink, [out] IUnknown **capture);
+}
