+/* the size a visual is laid out at, its own and its share of its parent's; called with the compositor locked */
+Vector2 visual_layout_size( struct visual *visual )
+{
+    struct visual_state state;
+    Vector2 parent = {0.0f, 0.0f}, size;
+    RECT client;
+
+    if (visual->parent) parent = visual_layout_size( visual->parent );
+    else if (visual->root_of && visual->root_of->hwnd && GetClientRect( visual->root_of->hwnd, &client ))
+    {
+        parent.X = client.right;
+        parent.Y = client.bottom;
+    }
+    visual_get_state( visual, &state );
+    size.X = state.size.X + state.relative_size.X * parent.X;
+    size.Y = state.size.Y + state.relative_size.Y * parent.Y;
+    return size;
+}
+
+/*** what Windows.Graphics.Capture takes of a visual ***/
+
+static inline struct visual *impl_from_IWineCompositionVisualCapture( IWineCompositionVisualCapture *iface )
+{
+    return CONTAINING_RECORD( iface, struct visual, IWineCompositionVisualCapture_iface );
+}
+
+static HRESULT WINAPI visual_capture_QueryInterface( IWineCompositionVisualCapture *iface, REFIID iid, void **out )
+{
+    struct visual *visual = impl_from_IWineCompositionVisualCapture( iface );
+    return IInspectable_QueryInterface( object_inspectable( &visual->base ), iid, out );
+}
+
+static ULONG WINAPI visual_capture_AddRef( IWineCompositionVisualCapture *iface )
+{
+    struct visual *visual = impl_from_IWineCompositionVisualCapture( iface );
+    return object_addref( &visual->base );
+}
+
+static ULONG WINAPI visual_capture_Release( IWineCompositionVisualCapture *iface )
+{
+    struct visual *visual = impl_from_IWineCompositionVisualCapture( iface );
+    return object_release( &visual->base );
+}
+
+static HRESULT WINAPI visual_capture_get_size( IWineCompositionVisualCapture *iface, UINT *width, UINT *height )
+{
+    struct visual *visual = impl_from_IWineCompositionVisualCapture( iface );
+    Vector2 size;
+
+    TRACE( "iface %p, width %p, height %p.\n", iface, width, height );
+
+    compositor_lock( visual->base.compositor );
+    size = visual_layout_size( visual );
+    compositor_unlock( visual->base.compositor );
+    *width = size.X > 0.0f ? ceilf( size.X ) : 0;
+    *height = size.Y > 0.0f ? ceilf( size.Y ) : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_capture_start( IWineCompositionVisualCapture *iface, ID3D11Device *device,
+                                            IWineCompositionCaptureSink *sink, IUnknown **capture )
+{
+    struct visual *visual = impl_from_IWineCompositionVisualCapture( iface );
+    return capture_start( visual, device, sink, capture );
+}
+
+static const struct IWineCompositionVisualCaptureVtbl visual_capture_vtbl =
+{
+    visual_capture_QueryInterface,
+    visual_capture_AddRef,
+    visual_capture_Release,
+    /* IWineCompositionVisualCapture methods */
+    visual_capture_get_size,
+    visual_capture_start,
+};
