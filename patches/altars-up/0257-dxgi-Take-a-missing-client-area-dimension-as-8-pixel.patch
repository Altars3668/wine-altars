From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 08:07:28 -0400
Subject: [PATCH] dxgi: Take a missing client area dimension as 8 pixels in
 ResizeBuffers().

ResizeBuffers() with a zero width or height uses the window's client area,
and a dimension the client area does not have becomes 8 pixels, as for a
new swapchain.  It used to fail and leave the swapchain zero-sized.
Measured on Windows 11 for the flip and blit models on Direct3D 11 and the
flip model on Direct3D 12: a 0x0 client area gives 8x8, 100x0 gives 100x8
and 0x100 gives 8x100.

Present() is occluded only for a blit model swapchain, and for one whose
window has no client area whether it is minimized or not; a flip model
swapchain presents to a minimized window as usual, which the present count
test already expected.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/dxgi/swapchain.c b/dlls/dxgi/swapchain.c
index 536f0415422..c268985d72f 100644
--- a/dlls/dxgi/swapchain.c
+++ b/dlls/dxgi/swapchain.c
@@ -100,6 +100,25 @@ BOOL dxgi_validate_swapchain_desc(const DXGI_SWAP_CHAIN_DESC1 *desc)
     return TRUE;
 }
 
+/* ResizeBuffers() takes a zero width or height from the window's client area, and a dimension the
+ * client area does not have is 8 pixels, as for a new swapchain. */
+static BOOL dxgi_swapchain_size_from_window(HWND window, UINT *width, UINT *height)
+{
+    RECT client_rect;
+
+    if (!GetClientRect(window, &client_rect))
+    {
+        WARN("Failed to get client rect, last error %#lx.\n", GetLastError());
+        return FALSE;
+    }
+
+    if (!*width)
+        *width = client_rect.right ? client_rect.right : 8;
+    if (!*height)
+        *height = client_rect.bottom ? client_rect.bottom : 8;
+    return TRUE;
+}
+
 BOOL dxgi_validate_swapchain_fullscreen_desc(const DXGI_SWAP_CHAIN_FULLSCREEN_DESC *desc)
 {
     if (desc && !desc->Windowed)
@@ -473,6 +492,25 @@ static void d3d11_swapchain_composite(struct d3d11_swapchain *swapchain, const R
     }
 }
 
+/* A blit model swapchain has nothing to present into while its window has no client area,
+ * minimized or not; a flip model one presents regardless. */
+static BOOL d3d11_swapchain_is_occluded(struct d3d11_swapchain *swapchain)
+{
+    struct wined3d_swapchain_desc wined3d_desc;
+    RECT client_rect;
+
+    wined3d_mutex_lock();
+    wined3d_swapchain_get_desc(swapchain->wined3d_swapchain, &wined3d_desc);
+    wined3d_mutex_unlock();
+
+    if (wined3d_desc.swap_effect == WINED3D_SWAP_EFFECT_FLIP_DISCARD
+            || wined3d_desc.swap_effect == WINED3D_SWAP_EFFECT_FLIP_SEQUENTIAL)
+        return FALSE;
+    if (IsIconic(wined3d_desc.device_window))
+        return TRUE;
+    return GetClientRect(wined3d_desc.device_window, &client_rect) && IsRectEmpty(&client_rect);
+}
+
 static HRESULT d3d11_swapchain_present(struct d3d11_swapchain *swapchain,
         unsigned int sync_interval, unsigned int flags,
         const DXGI_PRESENT_PARAMETERS *present_parameters)
@@ -487,7 +525,7 @@ static HRESULT d3d11_swapchain_present(struct d3d11_swapchain *swapchain,
         return DXGI_ERROR_INVALID_CALL;
     }
 
-    if (IsIconic(d3d11_swapchain_get_hwnd(swapchain)))
+    if (d3d11_swapchain_is_occluded(swapchain))
         return DXGI_STATUS_OCCLUDED;
 
     if (flags & ~(DXGI_PRESENT_TEST | DXGI_PRESENT_ALLOW_TEARING))
@@ -761,6 +799,11 @@ static HRESULT STDMETHODCALLTYPE d3d11_swapchain_ResizeBuffers(IDXGISwapChain4 *
     if (format != DXGI_FORMAT_UNKNOWN)
         wined3d_desc.backbuffer_format = wined3dformat_from_dxgi_format(format);
     wined3d_desc.flags = wined3d_swapchain_flags_from_dxgi(flags);
+    if ((!width || !height) && !dxgi_swapchain_size_from_window(wined3d_desc.device_window, &width, &height))
+    {
+        wined3d_mutex_unlock();
+        return DXGI_ERROR_INVALID_CALL;
+    }
     hr = wined3d_swapchain_resize_buffers(swapchain->wined3d_swapchain, buffer_count, width, height,
             wined3d_desc.backbuffer_format, wined3d_desc.multisample_type,
             wined3d_desc.multisample_quality, wined3d_desc.flags);
@@ -2811,21 +2854,8 @@ static HRESULT d3d12_swapchain_resize_buffers(struct d3d12_swapchain *swapchain,
 
     if (buffer_count)
         new_desc.BufferCount = buffer_count;
-    if (!width || !height)
-    {
-        RECT client_rect;
-
-        if (!GetClientRect(swapchain->window, &client_rect))
-        {
-            WARN("Failed to get client rect, last error %#lx.\n", GetLastError());
-            return DXGI_ERROR_INVALID_CALL;
-        }
-
-        if (!width)
-            width = client_rect.right;
-        if (!height)
-            height = client_rect.bottom;
-    }
+    if ((!width || !height) && !dxgi_swapchain_size_from_window(swapchain->window, &width, &height))
+        return DXGI_ERROR_INVALID_CALL;
     new_desc.Width = width;
     new_desc.Height = height;
 
diff --git a/dlls/dxgi/tests/dxgi.c b/dlls/dxgi/tests/dxgi.c
index 59ed17f00a2..8c74d6b664e 100644
--- a/dlls/dxgi/tests/dxgi.c
+++ b/dlls/dxgi/tests/dxgi.c
@@ -8525,13 +8525,11 @@ static void test_swapchain_present_count(IUnknown *device, BOOL is_d3d12)
 
         ShowWindow(window, SW_MINIMIZE);
         hr = IDXGISwapChain_Present(swapchain, 0, 0);
-        todo_wine_if(!is_d3d12 && is_flip_model(swap_effect))
         ok(hr == (is_flip_model(swap_effect) ? S_OK : DXGI_STATUS_OCCLUDED),
                 "Got unexpected hr %#lx.\n", hr);
         expected = present_count + !!is_flip_model(swap_effect);
         hr = IDXGISwapChain_GetLastPresentCount(swapchain, &present_count);
         ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
-        todo_wine_if(!is_d3d12 && is_flip_model(swap_effect))
         ok(present_count == expected, "Got unexpected present count %u, expected %u.\n", present_count, expected);
 
         ShowWindow(window, SW_NORMAL);
@@ -8646,10 +8644,10 @@ static void test_zero_size(IUnknown *device, BOOL is_d3d12)
 {
     DXGI_SWAP_CHAIN_DESC swapchain_desc;
     IDXGISwapChain *swapchain;
-    unsigned int i, expected;
+    unsigned int i, j, expected;
     IDXGIFactory *factory;
+    HRESULT hr, expected_hr;
     HWND window;
-    HRESULT hr;
     RECT r;
 
     static const struct
@@ -8668,6 +8666,23 @@ static void test_zero_size(IUnknown *device, BOOL is_d3d12)
          * 176x4 client rect on my system. */
         {100, 60}
     };
+    static const struct
+    {
+        INT w, h;
+        UINT expected_w, expected_h;
+    }
+    resize_tests[] =
+    {
+        {0, 0, 8, 8},
+        {100, 0, 100, 8},
+        {0, 100, 8, 100},
+        {320, 240, 320, 240},
+    };
+    static const DXGI_SWAP_EFFECT swap_effects[] =
+    {
+        DXGI_SWAP_EFFECT_DISCARD,
+        DXGI_SWAP_EFFECT_FLIP_DISCARD,
+    };
 
     get_factory(device, is_d3d12, &factory);
 
@@ -8708,6 +8723,40 @@ static void test_zero_size(IUnknown *device, BOOL is_d3d12)
         DestroyWindow(window);
     }
 
+    /* ResizeBuffers() takes the same sizes from a window that has lost its client area; a blit
+     * model swapchain stops presenting to such a window, a flip model one does not. */
+    window = CreateWindowA("static", "dxgi_test", WS_POPUP | WS_VISIBLE, 0, 0, 320, 240, 0, 0, 0, 0);
+    for (i = 0; i < ARRAY_SIZE(swap_effects); ++i)
+    {
+        if (is_d3d12 && !is_flip_model(swap_effects[i]))
+            continue;
+        if (swap_effects[i] == DXGI_SWAP_EFFECT_FLIP_DISCARD && !dxgi_1_4_supported(device, is_d3d12))
+            continue;
+
+        winetest_push_context("swap effect %#x", swap_effects[i]);
+        swapchain = create_swapchain(device, is_d3d12, window, 0, swap_effects[i]);
+        for (j = 0; j < ARRAY_SIZE(resize_tests); ++j)
+        {
+            SetWindowPos(window, NULL, 0, 0, resize_tests[j].w, resize_tests[j].h, SWP_NOMOVE | SWP_NOZORDER);
+            hr = IDXGISwapChain_ResizeBuffers(swapchain, 0, 0, 0, DXGI_FORMAT_UNKNOWN, 0);
+            ok(hr == S_OK, "Test %u: got unexpected hr %#lx.\n", j, hr);
+            hr = IDXGISwapChain_GetDesc(swapchain, &swapchain_desc);
+            ok(hr == S_OK, "Test %u: got unexpected hr %#lx.\n", j, hr);
+            ok(swapchain_desc.BufferDesc.Width == resize_tests[j].expected_w
+                    && swapchain_desc.BufferDesc.Height == resize_tests[j].expected_h,
+                    "Test %u: got size %ux%u.\n", j, swapchain_desc.BufferDesc.Width,
+                    swapchain_desc.BufferDesc.Height);
+
+            hr = IDXGISwapChain_Present(swapchain, 0, 0);
+            expected_hr = is_flip_model(swap_effects[i]) || (resize_tests[j].w && resize_tests[j].h)
+                    ? S_OK : DXGI_STATUS_OCCLUDED;
+            ok(hr == expected_hr, "Test %u: got unexpected hr %#lx.\n", j, hr);
+        }
+        IDXGISwapChain_Release(swapchain);
+        winetest_pop_context();
+    }
+    DestroyWindow(window);
+
     IDXGIFactory_Release(factory);
 }
 
