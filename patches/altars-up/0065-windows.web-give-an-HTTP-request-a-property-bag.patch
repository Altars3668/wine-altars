From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 12:23:50 -0400
Subject: [PATCH] windows.web: give an HTTP request a property bag.

HttpRequestMessage.Properties is the caller's own map, carried with the
request and never sent.  React Native's HTTP module keeps each request's
arguments in it and its filters look them up there again, so with the
property returning E_NOTIMPL no request of Office's React Native UI got any
further than being built.

The request now makes a PropertySet from wintypes the first time it is asked
for and hands out the same one after that, typed in the IDL as the
IMap<HSTRING, IInspectable> it is.  As a probe measured on Windows, it starts
empty, keeps what is inserted, finds it again and answers E_BOUNDS for a key
it does not have.  Windows' own object is a plain map, class name
Windows.Foundation.Collections.IMap`2<String, Object>, which does not also
answer for IPropertySet and IObservableMap as this one does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 970945bdf951653b3cd6d6813010c8d9cad43bce)

diff --git a/dlls/windows.web/message.c b/dlls/windows.web/message.c
index e374a82cc1b..6e6fe7c6ca4 100644
--- a/dlls/windows.web/message.c
+++ b/dlls/windows.web/message.c
@@ -40,6 +40,7 @@ struct request_message
     IMap_HSTRING_HSTRING *headers;
     IHttpMethod *method;
     IInspectable *uri;
+    IMap_HSTRING_IInspectable *properties;
 };
 
 static inline struct request_message *impl_from_IHttpRequestMessage( IHttpRequestMessage *iface )
@@ -99,6 +100,7 @@ static ULONG WINAPI request_Release( IHttpRequestMessage *iface )
         if (impl->headers) IMap_HSTRING_HSTRING_Release( impl->headers );
         if (impl->method) IHttpMethod_Release( impl->method );
         if (impl->uri) IInspectable_Release( impl->uri );
+        if (impl->properties) IMap_HSTRING_IInspectable_Release( impl->properties );
         free( impl );
     }
     return ref;
@@ -161,11 +163,41 @@ static HRESULT WINAPI request_get_Headers( IHttpRequestMessage *iface, IMap_HSTR
     return S_OK;
 }
 
-static HRESULT WINAPI request_get_Properties( IHttpRequestMessage *iface, IInspectable **value )
+/* The caller's own bag, carried with the request and never sent.  React
+ * Native's HTTP module keeps each request's arguments in it and its filters
+ * look them up there again, so without one no request of Office's React
+ * Native UI ever goes out -- the AutoSave dialog waits for its accounts for
+ * good.  wintypes has the PropertySet this is; make one the first time it is
+ * asked for, and hand out the same one after that. */
+static HRESULT WINAPI request_get_Properties( IHttpRequestMessage *iface, IMap_HSTRING_IInspectable **value )
 {
-    FIXME( "iface %p, value %p: the property bag is not implemented.\n", iface, value );
-    if (value) *value = NULL;
-    return E_NOTIMPL;
+    static const WCHAR class_name[] = L"Windows.Foundation.Collections.PropertySet";
+    struct request_message *impl = impl_from_IHttpRequestMessage( iface );
+    IMap_HSTRING_IInspectable *properties;
+    IInspectable *inspectable;
+    HSTRING str;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+
+    if (!impl->properties)
+    {
+        if (FAILED(hr = WindowsCreateString( class_name, ARRAY_SIZE(class_name) - 1, &str ))) return hr;
+        hr = RoActivateInstance( str, &inspectable );
+        WindowsDeleteString( str );
+        if (FAILED(hr)) return hr;
+        hr = IInspectable_QueryInterface( inspectable, &IID_IMap_HSTRING_IInspectable, (void **)&properties );
+        IInspectable_Release( inspectable );
+        if (FAILED(hr)) return hr;
+        if (InterlockedCompareExchangePointer( (void **)&impl->properties, properties, NULL ))
+            IMap_HSTRING_IInspectable_Release( properties );
+    }
+
+    IMap_HSTRING_IInspectable_AddRef( impl->properties );
+    *value = impl->properties;
+    return S_OK;
 }
 
 static HRESULT WINAPI request_get_TransportInformation( IHttpRequestMessage *iface, IInspectable **value )
diff --git a/include/windows.web.http.idl b/include/windows.web.http.idl
index 2d1342114ea..b797e464743 100644
--- a/include/windows.web.http.idl
+++ b/include/windows.web.http.idl
@@ -296,9 +296,7 @@ namespace Windows.Web.Http {
         [propget] HRESULT Headers([out, retval] Windows.Foundation.Collections.IMap<HSTRING, HSTRING> **value);
         [propget] HRESULT Method([out, retval] Windows.Web.Http.HttpMethod **value);
         [propput] HRESULT Method([in] Windows.Web.Http.HttpMethod *value);
-        /* IMap<HSTRING, IInspectable *> of whatever the caller wants to carry
-         * alongside the request. */
-        [propget] HRESULT Properties([out, retval] IInspectable **value);
+        [propget] HRESULT Properties([out, retval] Windows.Foundation.Collections.IMap<HSTRING, IInspectable *> **value);
         /* Windows.Foundation.Uri * */
         [propget] HRESULT RequestUri([out, retval] IInspectable **value);
         [propput] HRESULT RequestUri([in] IInspectable *value);
