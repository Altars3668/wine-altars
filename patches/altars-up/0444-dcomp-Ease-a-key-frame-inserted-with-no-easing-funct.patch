From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 09:17:48 -0400
Subject: [PATCH] dcomp: Ease a key frame inserted with no easing function out,
 as Windows does.

It went linearly.  Windows 11 build 29671 eases it along the cubic
bezier through (0.41, 0.52) and (0, 0.94): the progress it gives each
frame of such an animation, inverted through that curve, is a frame
time of exactly 17 ms after another (tools/trackerprobe, inertia.c,
three animations of an InteractionTracker's position).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/dcomp/animation.c b/dlls/dcomp/animation.c
index 347fd30056a..f7611b7cb05 100644
--- a/dlls/dcomp/animation.c
+++ b/dlls/dcomp/animation.c
@@ -157,35 +157,51 @@ static float bezier_slope( float a, float b, float t )
     return 3.0f * s * s * a + 6.0f * s * t * (b - a) + 3.0f * t * t * (1.0f - b);
 }
 
-/* what an easing function makes of the progress between two key frames; called with the compositor locked */
+/* a cubic bezier from (0, 0) to (1, 1) through p1 and p2, at t */
+static float ease_bezier( Vector2 p1, Vector2 p2, float t )
+{
+    float low = 0.0f, high = 1.0f, s = t, x;
+    int i;
+
+    /* where the curve's x is t, by Newton's method, and by halves where that does not settle */
+    for (i = 0; i < 8; i++)
+    {
+        float slope = bezier_slope( p1.X, p2.X, s );
+        x = bezier( p1.X, p2.X, s ) - t;
+        if (fabsf( x ) < 1e-5f) return bezier( p1.Y, p2.Y, s );
+        if (fabsf( slope ) < 1e-6f) break;
+        s -= x / slope;
+    }
+    s = t;
+    for (i = 0; i < 32; i++)
+    {
+        x = bezier( p1.X, p2.X, s );
+        if (fabsf( x - t ) < 1e-5f) break;
+        if (x < t) low = s; else high = s;
+        s = (low + high) / 2.0f;
+    }
+    return bezier( p1.Y, p2.Y, s );
+}
+
+/*
+ * What an easing function makes of the progress between two key frames; called
+ * with the compositor locked.  A key frame inserted with none eases out, along
+ * the cubic bezier through (0.41, 0.52) and (0, 0.94): the progress Windows 11
+ * gives each frame of such an animation is that curve, frame for frame
+ * (tools/trackerprobe, inertia.c).
+ */
 static float ease( ICompositionEasingFunction *iface, float t )
 {
+    static const Vector2 default_p1 = {0.41f, 0.52f}, default_p2 = {0.0f, 0.94f};
     struct easing *easing = unsafe_impl_from_ICompositionEasingFunction( iface );
-    float low = 0.0f, high = 1.0f, s = t, x;
-    int i, step;
+    int step;
 
+    if (!iface) return ease_bezier( default_p1, default_p2, t );
     if (!easing) return t;
     switch (easing->kind)
     {
     case EASING_CUBIC_BEZIER:
-        /* where the curve's x is t, by Newton's method, and by halves where that does not settle */
-        for (i = 0; i < 8; i++)
-        {
-            float slope = bezier_slope( easing->p1.X, easing->p2.X, s );
-            x = bezier( easing->p1.X, easing->p2.X, s ) - t;
-            if (fabsf( x ) < 1e-5f) return bezier( easing->p1.Y, easing->p2.Y, s );
-            if (fabsf( slope ) < 1e-6f) break;
-            s -= x / slope;
-        }
-        s = t;
-        for (i = 0; i < 32; i++)
-        {
-            x = bezier( easing->p1.X, easing->p2.X, s );
-            if (fabsf( x - t ) < 1e-5f) break;
-            if (x < t) low = s; else high = s;
-            s = (low + high) / 2.0f;
-        }
-        return bezier( easing->p1.Y, easing->p2.Y, s );
+        return ease_bezier( easing->p1, easing->p2, t );
     case EASING_STEP:
         if (easing->step_count <= 0) return t;
         step = easing->initial_step + (int)floorf( t * (easing->final_step - easing->initial_step) );
