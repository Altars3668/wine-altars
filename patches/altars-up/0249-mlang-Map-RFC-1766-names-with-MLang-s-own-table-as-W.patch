+    unsigned int i;
+    size_t len;
 
-    while (IEnumRfc1766_Next(iface, 1, &info, &num) == S_OK)
+    for (i = 0; i < ARRAY_SIZE(rfc1766_names); i++)
     {
-        if (!wcsicmp(info.wszRfc1766, rfc1766))
