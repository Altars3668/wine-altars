+ * width gives the locale of its language, the part before the first dash, and S_FALSE: de-de is
+ * de, kok-x is kok; longer names are refused. */
+static HRESULT lcid_from_rfc1766( LCID *lcid, const WCHAR *rfc1766 )
 {
-    RFC1766INFO info;
