+static HRESULT WINAPI virtual_Trim( ICompositionVirtualDrawingSurface *iface, UINT32 rects_size, RectInt32 *rects )
+{
+    struct drawing_surface *surface = impl_from_ICompositionVirtualDrawingSurface( iface );
+    struct tile *tile, *next;
+    UINT32 i;
+
+    TRACE( "iface %p, rects_size %u, rects %p.\n", iface, rects_size, rects );
+
+    if (rects_size && !rects) return E_INVALIDARG;
+
+    /* a tile none of the rectangles to keep touches is let go of; the rest keep their pixels */
+    compositor_lock( surface->base.compositor );
+    LIST_FOR_EACH_ENTRY_SAFE( tile, next, &surface->tiles, struct tile, entry )
+    {
+        BOOL keep = FALSE;
+
+        if (surface->drawing && tile == surface->update_tile) continue;
+        for (i = 0; i < rects_size && !keep; i++)
+        {
+            RECT rect, part;
+            SetRect( &rect, rects[i].X, rects[i].Y, rects[i].X + rects[i].Width, rects[i].Y + rects[i].Height );
+            keep = IntersectRect( &part, &rect, &tile->rect );
+        }
+        if (!keep) tile_destroy( tile );
+    }
+    compositor_changed( surface->base.compositor );
+    compositor_unlock( surface->base.compositor );
+    return S_OK;
+}
