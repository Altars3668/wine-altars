+static HRESULT tracker_create( ICompositor *compositor_iface, IInteractionTrackerOwner *owner, IInteractionTracker **out )
+{
+    struct compositor *compositor;
+    struct tracker *tracker;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!compositor_iface || !(compositor = unsafe_impl_from_ICompositor( compositor_iface ))) return E_INVALIDARG;
+
+    if (!(tracker = calloc( 1, sizeof(*tracker) ))) return E_OUTOFMEMORY;
+    object_init( &tracker->base, &tracker_ops, compositor );
+    tracker->IInteractionTracker_iface.lpVtbl = &tracker_vtbl;
+    tracker->IInteractionTracker2_iface.lpVtbl = &tracker2_vtbl;
+    tracker->IInteractionTracker3_iface.lpVtbl = &tracker3_vtbl;
+    tracker->IInteractionTracker4_iface.lpVtbl = &tracker4_vtbl;
+    tracker->IInteractionTracker5_iface.lpVtbl = &tracker5_vtbl;
+    if (FAILED(hr = collection_create( tracker, &tracker->sources )))
+    {
+        object_release( &tracker->base );
+        return hr;
+    }
+    if ((tracker->owner = owner)) IInteractionTrackerOwner_AddRef( owner );
+    /* as Windows has them */
+    tracker->scale = tracker->min_scale = tracker->max_scale = 1.0f;
+    tracker->scale_velocity = 1.0f;
+    compositor_lock( compositor );
+    list_add_tail( compositor_trackers( compositor ), &tracker->compositor_entry );
+    compositor_unlock( compositor );
+    *out = &tracker->IInteractionTracker_iface;
+    return S_OK;
+}
+
+struct tracker *unsafe_impl_from_IInteractionTracker( IInteractionTracker *iface )
+{
+    if (!iface || iface->lpVtbl != &tracker_vtbl) return NULL;
+    return impl_from_IInteractionTracker( iface );
+}
