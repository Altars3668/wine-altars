+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct statics *statics = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &statics->IActivationFactory_iface;
+    else if (!statics->tracker && IsEqualGUID( iid, &IID_IVisualInteractionSourceStatics ))
+        *out = &statics->IVisualInteractionSourceStatics_iface;
+    else if (!statics->tracker && IsEqualGUID( iid, &IID_IVisualInteractionSourceStatics2 ))
+        *out = &statics->IVisualInteractionSourceStatics2_iface;
+    else if (statics->tracker && IsEqualGUID( iid, &IID_IInteractionTrackerStatics ))
+        *out = &statics->IInteractionTrackerStatics_iface;
+    else if (statics->tracker && IsEqualGUID( iid, &IID_IInteractionTrackerStatics2 ))
+        *out = &statics->IInteractionTrackerStatics2_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
