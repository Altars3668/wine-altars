+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/*
+ * The compositor is the engine: every object it makes shares its lock and
+ * keeps it alive, and a commit draws each window target's tree as it stands.
+ * As on Windows it is made only on a thread with a dispatcher queue, is not
+ * itself a CompositionObject, and is agile.
+ */
+struct compositor
+{
+    ICompositor ICompositor_iface;
+    ICompositor2 ICompositor2_iface;
+    ICompositor3 ICompositor3_iface;
+    ICompositor4 ICompositor4_iface;
+    ICompositor5 ICompositor5_iface;
+    ICompositor6 ICompositor6_iface;
+    ICompositor7 ICompositor7_iface;
+    ICompositor8 ICompositor8_iface;
+    ICompositorInterop ICompositorInterop_iface;
+    ICompositorDesktopInterop ICompositorDesktopInterop_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    struct list targets;
+    IDispatcherQueue *queue;
+    HSTRING comment;
+    FLOAT playback_rate;
+    BOOL closed;
+
+    BOOL manual;                /* made for a CompositorController: draws when that commits */
+    ICompositorController *controller;
+    BOOL changed;               /* since the last commit */
+    BOOL work_queued;           /* on the dispatcher queue, to commit or to say one is needed */
+    struct list commit_needed;
+    UINT64 next_token;
+
+    struct list running;        /* key frame animations running */
+    struct list batches;        /* open ones */
+    struct list trackers;
+    /* while key frame animations run, a frame is drawn on the compositor's thread every 16ms */
+    ITypedEventHandler_DispatcherQueueTimer_IInspectable frame_handler;
+    IDispatcherQueueTimer *frame_timer;
+    BOOL frames_running;
+};
+
+struct commit_needed_handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    ITypedEventHandler_CompositorController_IInspectable *handler;
+};
+
+static void compositor_queue_work( struct compositor *compositor );
+
+static inline struct compositor *impl_from_ICompositor( ICompositor *iface )
+{
+    return CONTAINING_RECORD( iface, struct compositor, ICompositor_iface );
+}
+
+void compositor_lock( struct compositor *compositor )
+{
+    EnterCriticalSection( &compositor->cs );
+}
+
+void compositor_unlock( struct compositor *compositor )
+{
+    LeaveCriticalSection( &compositor->cs );
+}
+
+ICompositor *compositor_iface( struct compositor *compositor )
+{
+    return &compositor->ICompositor_iface;
+}
+
+struct list *compositor_targets( struct compositor *compositor )
+{
+    return &compositor->targets;
+}
+
+struct list *compositor_running( struct compositor *compositor )
+{
+    return &compositor->running;
+}
+
+struct list *compositor_batches( struct compositor *compositor )
+{
+    return &compositor->batches;
+}
+
+struct list *compositor_trackers( struct compositor *compositor )
+{
+    return &compositor->trackers;
+}
+
+IDispatcherQueue *compositor_dispatcher_queue( struct compositor *compositor )
+{
+    return compositor->queue;
+}
+
+/* the time animations go by, in 100ns units */
+LONGLONG compositor_time( void )
+{
+    static LARGE_INTEGER frequency;
+    LARGE_INTEGER counter;
+
+    if (!frequency.QuadPart) QueryPerformanceFrequency( &frequency );
+    QueryPerformanceCounter( &counter );
+    return counter.QuadPart / frequency.QuadPart * 10000000 + counter.QuadPart % frequency.QuadPart * 10000000 / frequency.QuadPart;
+}
+
+void compositor_add_ref( struct compositor *compositor )
+{
+    ICompositor_AddRef( &compositor->ICompositor_iface );
+}
+
+void compositor_release( struct compositor *compositor )
+{
+    ICompositor_Release( &compositor->ICompositor_iface );
+}
+
+/*
+ * Draws every window target as its tree stands now.  The graphics devices the
+ * trees draw with are locked first: an application may hold a device's lock
+ * when it calls in to draw on a surface, and that takes the compositor's.
+ * Animations move on each frame; a commit also ends the commit batches.
+ */
+static HRESULT compositor_render( struct compositor *compositor, BOOL commit )
+{
+    struct graphics_device **devices = NULL;
+    unsigned int count = 0, i;
+    struct target *target;
+    HRESULT hr = S_OK;
+
+    compositor_lock( compositor );
+    if ((devices = calloc( list_count( &compositor->targets ) + 1, sizeof(*devices) )))
+    {
+        LIST_FOR_EACH_ENTRY( target, &compositor->targets, struct target, entry )
+        {
+            struct graphics_device *device = target->root ? render_tree_device( target->root ) : NULL;
+
+            if (!device) continue;
+            for (i = 0; i < count; i++) if (devices[i] == device) break;
+            if (i < count) continue;
+            ICompositionGraphicsDevice_AddRef( &device->ICompositionGraphicsDevice_iface );
+            devices[count++] = device;
+        }
+    }
+    compositor_unlock( compositor );
+
+    for (i = 0; i < count; i++) graphics_device_lock( devices[i] );
+    compositor_lock( compositor );
+    if (commit)
+    {
+        compositor->changed = FALSE;
+        batches_commit( compositor );
+    }
+    animations_frame( compositor );
+    trackers_frame( compositor );
+    LIST_FOR_EACH_ENTRY( target, &compositor->targets, struct target, entry )
+    {
+        HRESULT ret = render_target( compositor, target );
+        if (FAILED(ret) && SUCCEEDED(hr)) hr = ret;
+    }
+    if (animations_running( compositor )) compositor_request_frames( compositor );
+    compositor_unlock( compositor );
+    for (i = 0; i < count; i++)
+    {
+        graphics_device_unlock( devices[i] );
+        ICompositionGraphicsDevice_Release( &devices[i]->ICompositionGraphicsDevice_iface );
+    }
+    free( devices );
+
+    if (FAILED(hr)) WARN( "drawing failed, hr %#lx.\n", hr );
+    return hr;
+}
+
+HRESULT compositor_commit( struct compositor *compositor )
+{
+    compositor_render( compositor, TRUE );
+    return S_OK;
+}
+
+static inline struct compositor *impl_from_frame_handler( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct compositor, frame_handler );
+}
+
+static HRESULT WINAPI frame_handler_QueryInterface( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface,
+                                                    REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ITypedEventHandler_DispatcherQueueTimer_IInspectable ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* the handler lives as long as the compositor, which releases the timer before it goes */
+static ULONG WINAPI frame_handler_AddRef( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI frame_handler_Release( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI frame_handler_Invoke( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface,
+                                            IDispatcherQueueTimer *timer, IInspectable *args )
+{
+    struct compositor *compositor = impl_from_frame_handler( iface );
+    BOOL done = FALSE;
+
+    compositor_render( compositor, FALSE );
+    compositor_lock( compositor );
+    if (compositor->frames_running && !animations_running( compositor ))
+    {
+        IDispatcherQueueTimer_Stop( compositor->frame_timer );
+        compositor->frames_running = FALSE;
+        done = TRUE;
+    }
+    compositor_unlock( compositor );
+    /* the frames held the compositor while they ran */
+    if (done) compositor_release( compositor );
+    return S_OK;
+}
+
+static const ITypedEventHandler_DispatcherQueueTimer_IInspectableVtbl frame_handler_vtbl =
+{
+    frame_handler_QueryInterface,
+    frame_handler_AddRef,
+    frame_handler_Release,
+    frame_handler_Invoke,
+};
+
+/* called with the compositor locked */
+void compositor_request_frames( struct compositor *compositor )
+{
+    EventRegistrationToken token;
+    TimeSpan interval = {166667};
+
+    if (compositor->frames_running || !compositor->queue) return;
+    if (!compositor->frame_timer)
+    {
+        if (FAILED(IDispatcherQueue_CreateTimer( compositor->queue, &compositor->frame_timer ))) return;
+        IDispatcherQueueTimer_put_Interval( compositor->frame_timer, interval );
+        IDispatcherQueueTimer_add_Tick( compositor->frame_timer, &compositor->frame_handler, &token );
+    }
+    IDispatcherQueueTimer_Start( compositor->frame_timer );
+    compositor->frames_running = TRUE;
+    compositor_add_ref( compositor );
+}
+
+/*
+ * Called with the compositor locked, when what a commit would draw has
+ * changed.  A compositor of its own commits on its thread soon after; one of a
+ * controller's raises CommitNeeded there instead.
+ */
+void compositor_changed( struct compositor *compositor )
+{
+    if (compositor->changed) return;
+    compositor->changed = TRUE;
+    compositor_queue_work( compositor );
+}
+
+void compositor_set_controller( struct compositor *compositor, ICompositorController *controller )
+{
+    compositor_lock( compositor );
+    compositor->controller = controller;
+    compositor_unlock( compositor );
+}
+
+HRESULT compositor_add_commit_needed( struct compositor *compositor,
+                                      ITypedEventHandler_CompositorController_IInspectable *handler,
+                                      EventRegistrationToken *token )
+{
+    struct commit_needed_handler *entry;
+
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ITypedEventHandler_CompositorController_IInspectable_AddRef( (entry->handler = handler) );
+    compositor_lock( compositor );
+    entry->token.value = ++compositor->next_token;
+    list_add_tail( &compositor->commit_needed, &entry->entry );
+    /* what changed before anyone listened still needs a commit */
+    if (compositor->changed) compositor_queue_work( compositor );
+    compositor_unlock( compositor );
+    *token = entry->token;
+    return S_OK;
+}
+
+HRESULT compositor_remove_commit_needed( struct compositor *compositor, EventRegistrationToken token )
+{
+    struct commit_needed_handler *entry, *found = NULL;
+
+    compositor_lock( compositor );
+    LIST_FOR_EACH_ENTRY( entry, &compositor->commit_needed, struct commit_needed_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    compositor_unlock( compositor );
+    if (found)
+    {
+        ITypedEventHandler_CompositorController_IInspectable_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
+
+/* the work a compositor has queued on its dispatcher queue */
+struct work
+{
+    IDispatcherQueueHandler IDispatcherQueueHandler_iface;
+    LONG ref;
+    struct compositor *compositor;
+};
+
+static inline struct work *impl_from_IDispatcherQueueHandler( IDispatcherQueueHandler *iface )
+{
+    return CONTAINING_RECORD( iface, struct work, IDispatcherQueueHandler_iface );
+}
+
+static HRESULT WINAPI work_QueryInterface( IDispatcherQueueHandler *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IDispatcherQueueHandler ))
+    {
+        IDispatcherQueueHandler_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI work_AddRef( IDispatcherQueueHandler *iface )
+{
+    struct work *work = impl_from_IDispatcherQueueHandler( iface );
+    return InterlockedIncrement( &work->ref );
+}
+
+static ULONG WINAPI work_Release( IDispatcherQueueHandler *iface )
+{
+    struct work *work = impl_from_IDispatcherQueueHandler( iface );
+    ULONG ref = InterlockedDecrement( &work->ref );
+
+    if (!ref)
+    {
+        compositor_release( work->compositor );
+        free( work );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI work_Invoke( IDispatcherQueueHandler *iface )
+{
+    struct work *work = impl_from_IDispatcherQueueHandler( iface );
+    struct compositor *compositor = work->compositor;
+    ITypedEventHandler_CompositorController_IInspectable **handlers = NULL;
+    ICompositorController *controller = NULL;
+    struct commit_needed_handler *entry;
+    unsigned int count = 0, i;
+
+    TRACE( "compositor %p.\n", compositor );
+
+    compositor_lock( compositor );
+    compositor->work_queued = FALSE;
+    if (!compositor->changed || compositor->closed)
+    {
+        compositor_unlock( compositor );
+        return S_OK;
+    }
+    if (!compositor->manual)
+    {
+        compositor_unlock( compositor );
+        return compositor_commit( compositor );
+    }
+    if ((controller = compositor->controller)) ICompositorController_AddRef( controller );
+    if (controller && (handlers = calloc( list_count( &compositor->commit_needed ) + 1, sizeof(*handlers) )))
+    {
+        LIST_FOR_EACH_ENTRY( entry, &compositor->commit_needed, struct commit_needed_handler, entry )
+            ITypedEventHandler_CompositorController_IInspectable_AddRef( (handlers[count++] = entry->handler) );
+    }
+    compositor_unlock( compositor );
+
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_CompositorController_IInspectable_Invoke( handlers[i], controller, NULL );
+        ITypedEventHandler_CompositorController_IInspectable_Release( handlers[i] );
+    }
+    free( handlers );
+    if (controller) ICompositorController_Release( controller );
+    return S_OK;
+}
+
+static const struct IDispatcherQueueHandlerVtbl work_vtbl =
+{
+    work_QueryInterface,
+    work_AddRef,
+    work_Release,
+    /* IDispatcherQueueHandler methods */
+    work_Invoke,
+};
+
+/* called with the compositor locked */
+static void compositor_queue_work( struct compositor *compositor )
+{
+    boolean queued = FALSE;
+    struct work *work;
+
+    if (compositor->work_queued || !compositor->queue) return;
+    if (compositor->manual && list_empty( &compositor->commit_needed )) return;
+    if (!(work = calloc( 1, sizeof(*work) ))) return;
+    work->IDispatcherQueueHandler_iface.lpVtbl = &work_vtbl;
+    work->ref = 1;
+    work->compositor = compositor;
+    compositor_add_ref( compositor );
+    if (SUCCEEDED(IDispatcherQueue_TryEnqueue( compositor->queue, &work->IDispatcherQueueHandler_iface, &queued ))
+        && queued)
+        compositor->work_queued = TRUE;
+    else WARN( "could not queue work on the dispatcher queue.\n" );
+    IDispatcherQueueHandler_Release( &work->IDispatcherQueueHandler_iface );
+}
+
+static HRESULT WINAPI compositor_QueryInterface( ICompositor *iface, REFIID iid, void **out )
+{
+    struct compositor *compositor = impl_from_ICompositor( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ICompositor ))
+        *out = &compositor->ICompositor_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositor2 )) *out = &compositor->ICompositor2_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositor3 )) *out = &compositor->ICompositor3_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositor4 )) *out = &compositor->ICompositor4_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositor5 )) *out = &compositor->ICompositor5_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositor6 )) *out = &compositor->ICompositor6_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositor7 )) *out = &compositor->ICompositor7_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositor8 )) *out = &compositor->ICompositor8_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositorInterop )) *out = &compositor->ICompositorInterop_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositorDesktopInterop )) *out = &compositor->ICompositorDesktopInterop_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable )) *out = &compositor->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI compositor_AddRef( ICompositor *iface )
+{
+    struct compositor *compositor = impl_from_ICompositor( iface );
+    ULONG ref = InterlockedIncrement( &compositor->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI compositor_Release( ICompositor *iface )
+{
+    struct compositor *compositor = impl_from_ICompositor( iface );
+    ULONG ref = InterlockedDecrement( &compositor->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        struct commit_needed_handler *entry, *next;
+
+        LIST_FOR_EACH_ENTRY_SAFE( entry, next, &compositor->commit_needed, struct commit_needed_handler, entry )
+        {
+            list_remove( &entry->entry );
+            ITypedEventHandler_CompositorController_IInspectable_Release( entry->handler );
+            free( entry );
+        }
+        if (compositor->frame_timer)
+        {
+            IDispatcherQueueTimer_Stop( compositor->frame_timer );
+            IDispatcherQueueTimer_Release( compositor->frame_timer );
+        }
+        if (compositor->queue) IDispatcherQueue_Release( compositor->queue );
+        WindowsDeleteString( compositor->comment );
+        compositor->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &compositor->cs );
+        free( compositor );
+    }
+    return ref;
+}
