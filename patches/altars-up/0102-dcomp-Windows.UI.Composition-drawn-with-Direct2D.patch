+static HRESULT WINAPI scoped_get_IsActive( ICompositionScopedBatch *iface, boolean *value )
+{
+    struct batch *batch = impl_from_ICompositionScopedBatch( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( batch->base.compositor );
+    *value = !batch->ended && !batch->suspended;
+    compositor_unlock( batch->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI scoped_get_IsEnded( ICompositionScopedBatch *iface, boolean *value )
+{
+    struct batch *batch = impl_from_ICompositionScopedBatch( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( batch->base.compositor );
+    *value = batch->ended;
+    compositor_unlock( batch->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI scoped_End( ICompositionScopedBatch *iface )
+{
+    struct batch *batch = impl_from_ICompositionScopedBatch( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    compositor_lock( batch->base.compositor );
+    if (batch->ended)
+    {
+        compositor_unlock( batch->base.compositor );
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    batch_end( batch );
+    compositor_unlock( batch->base.compositor );
+    return S_OK;
+}
