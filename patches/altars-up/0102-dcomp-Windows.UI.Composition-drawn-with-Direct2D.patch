+static HRESULT start_animation( void *object, const WCHAR *property, void *animation )
+{
+    ICompositionAnimation *anim = NULL;
+    ICompositionObject *obj;
+    HSTRING str;
+    HRESULT hr;
+
+    IUnknown_QueryInterface( (IUnknown *)object, &IID_ICompositionObject, (void **)&obj );
+    IUnknown_QueryInterface( (IUnknown *)animation, &IID_ICompositionAnimation, (void **)&anim );
+    str = hstring( property );
+    hr = ICompositionObject_StartAnimation( obj, str, anim );
+    WindowsDeleteString( str );
+    ICompositionAnimation_Release( anim );
+    ICompositionObject_Release( obj );
+    return hr;
+}
+
+static HRESULT stop_animation( void *object, const WCHAR *property )
+{
+    ICompositionObject *obj;
+    HSTRING str;
+    HRESULT hr;
+
+    IUnknown_QueryInterface( (IUnknown *)object, &IID_ICompositionObject, (void **)&obj );
+    str = hstring( property );
+    hr = ICompositionObject_StopAnimation( obj, str );
+    WindowsDeleteString( str );
+    ICompositionObject_Release( obj );
+    return hr;
+}
+
+/* a scalar animation of one key frame, and maybe an expression key frame */
+static HRESULT start_scalar( ICompositor *compositor, void *object, const WCHAR *property, const WCHAR *frame )
+{
+    IScalarKeyFrameAnimation *scalar;
+    IKeyFrameAnimation *keyframe;
+    HSTRING str;
+    HRESULT hr;
+
+    ICompositor_CreateScalarKeyFrameAnimation( compositor, &scalar );
+    IScalarKeyFrameAnimation_InsertKeyFrame( scalar, 1.0f, 0.5f );
+    if (frame)
+    {
+        IScalarKeyFrameAnimation_QueryInterface( scalar, &IID_IKeyFrameAnimation, (void **)&keyframe );
+        str = hstring( frame );
+        IKeyFrameAnimation_InsertExpressionKeyFrame( keyframe, 0.5f, str );
+        WindowsDeleteString( str );
+        IKeyFrameAnimation_Release( keyframe );
+    }
+    hr = start_animation( object, property, scalar );
+    IScalarKeyFrameAnimation_Release( scalar );
+    return hr;
+}
+
+static HRESULT start_expression( ICompositor *compositor, void *object, const WCHAR *property, const WCHAR *text )
+{
+    IExpressionAnimation *expression;
+    HSTRING str;
+    HRESULT hr;
+
+    str = hstring( text );
+    hr = ICompositor_CreateExpressionAnimationWithExpression( compositor, str, &expression );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = start_animation( object, property, expression );
+    IExpressionAnimation_Release( expression );
+    return hr;
+}
