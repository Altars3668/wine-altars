+
+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/*
+ * An animation object is a description.  Starting it on a property takes a
+ * copy of what it says -- changing the animation afterwards does not change
+ * what runs -- and checks, as Windows does, that the property is there and
+ * that the animation computes a value of its type.  A running expression
+ * animation is computed whenever the property is read; a key frame animation
+ * by the time since its first frame, until it completes and leaves the
+ * property at its last value.
+ */
+
+enum animation_kind
+{
+    ANIMATION_EXPRESSION,
+    ANIMATION_KEY_FRAME,
+};
+
+struct parameter
+{
+    struct list entry;
+    WCHAR *name;
+    struct value value;
+    ICompositionObject *reference;
+};
+
+struct key_frame
+{
+    float progress;
+    struct value value;             /* VALUE_NONE for an expression key frame */
+    WCHAR *text;
+    struct expression *expression;
+    ICompositionEasingFunction *easing;
+};
+
+struct animation
+{
+    struct object base;
+    ICompositionAnimation ICompositionAnimation_iface;
+    ICompositionAnimation2 ICompositionAnimation2_iface;
+    ICompositionAnimation3 ICompositionAnimation3_iface;
+    ICompositionAnimation4 ICompositionAnimation4_iface;
+    ICompositionAnimationBase ICompositionAnimationBase_iface;
+    IExpressionAnimation IExpressionAnimation_iface;
+    IKeyFrameAnimation IKeyFrameAnimation_iface;
+    IKeyFrameAnimation2 IKeyFrameAnimation2_iface;
+    IKeyFrameAnimation3 IKeyFrameAnimation3_iface;
+    IScalarKeyFrameAnimation IScalarKeyFrameAnimation_iface;
+    IVector2KeyFrameAnimation IVector2KeyFrameAnimation_iface;
+    IVector3KeyFrameAnimation IVector3KeyFrameAnimation_iface;
+    IVector4KeyFrameAnimation IVector4KeyFrameAnimation_iface;
+    IColorKeyFrameAnimation IColorKeyFrameAnimation_iface;
+    IQuaternionKeyFrameAnimation IQuaternionKeyFrameAnimation_iface;
+    IBooleanKeyFrameAnimation IBooleanKeyFrameAnimation_iface;
+    enum animation_kind kind;
+    enum value_type type;           /* what a key frame animation animates */
+
+    struct list parameters;
+    HSTRING target;
+    HSTRING text;                   /* an expression animation's expression */
+    struct key_frame *frames;       /* by progress */
+    unsigned int frame_count;
+    BOOL frames_checked;            /* as on Windows, a bad expression key frame fails one start only */
+    TimeSpan delay;
+    TimeSpan duration;
+    AnimationIterationBehavior iteration_behavior;
+    INT32 iteration_count;
+    AnimationStopBehavior stop_behavior;
+    AnimationDirection direction;
+    AnimationDelayBehavior delay_behavior;
+    CompositionColorSpace color_space;
+};
+
+struct batch;
+
+/* an animation started on a property, with what it said when it was started */
+struct running
+{
+    struct list entry;              /* in the object's animations */
+    struct list time_entry;         /* in the compositor's running key frame animations */
+    struct object *object;
+    WCHAR *property;                /* the whole property, as Offset */
+    WCHAR *member;                  /* a member of it, as X, or NULL */
+    enum value_type type;           /* of what is animated */
+    enum animation_kind kind;
+    struct list parameters;
+    struct expression *expression;
+    struct key_frame *frames;
+    unsigned int frame_count;
+    LONGLONG delay, duration;
+    AnimationIterationBehavior iteration_behavior;
+    INT32 iteration_count;
+    AnimationStopBehavior stop_behavior;
+    AnimationDirection direction;
+    AnimationDelayBehavior delay_behavior;
+    LONGLONG start;                 /* when its first frame was, or 0 before */
+    struct value starting;          /* the property's value when it started */
+    struct value last;              /* what the latest frame made of it */
+    BOOL has_last;
+    struct batch *batches[2];       /* the scoped and the commit batch it counts in */
+};
+
+/*** easing functions ***/
+
+struct easing
+{
+    struct object base;
+    ICompositionEasingFunction ICompositionEasingFunction_iface;
+    ILinearEasingFunction ILinearEasingFunction_iface;
+    ICubicBezierEasingFunction ICubicBezierEasingFunction_iface;
+    IStepEasingFunction IStepEasingFunction_iface;
+    int kind;
+    Vector2 p1, p2;
+    INT32 step_count, initial_step, final_step;
+    boolean initial_single_frame, final_single_frame;
+};
+
+static const struct ICompositionEasingFunctionVtbl easing_vtbl;
+
+static struct easing *unsafe_impl_from_ICompositionEasingFunction( ICompositionEasingFunction *iface );
+
+static float bezier( float a, float b, float t )
+{
+    /* one coordinate of a cubic bezier from (0, 0) to (1, 1) */
+    float s = 1.0f - t;
+    return 3.0f * s * s * t * a + 3.0f * s * t * t * b + t * t * t;
+}
+
+static float bezier_slope( float a, float b, float t )
+{
+    float s = 1.0f - t;
+    return 3.0f * s * s * a + 6.0f * s * t * (b - a) + 3.0f * t * t * (1.0f - b);
+}
+
+/* what an easing function makes of the progress between two key frames; called with the compositor locked */
+static float ease( ICompositionEasingFunction *iface, float t )
+{
+    struct easing *easing = unsafe_impl_from_ICompositionEasingFunction( iface );
+    float low = 0.0f, high = 1.0f, s = t, x;
+    int i, step;
+
+    if (!easing) return t;
+    switch (easing->kind)
+    {
+    case EASING_CUBIC_BEZIER:
+        /* where the curve's x is t, by Newton's method, and by halves where that does not settle */
+        for (i = 0; i < 8; i++)
+        {
+            float slope = bezier_slope( easing->p1.X, easing->p2.X, s );
+            x = bezier( easing->p1.X, easing->p2.X, s ) - t;
+            if (fabsf( x ) < 1e-5f) return bezier( easing->p1.Y, easing->p2.Y, s );
+            if (fabsf( slope ) < 1e-6f) break;
+            s -= x / slope;
+        }
+        s = t;
+        for (i = 0; i < 32; i++)
+        {
+            x = bezier( easing->p1.X, easing->p2.X, s );
+            if (fabsf( x - t ) < 1e-5f) break;
+            if (x < t) low = s; else high = s;
+            s = (low + high) / 2.0f;
+        }
+        return bezier( easing->p1.Y, easing->p2.Y, s );
+    case EASING_STEP:
+        if (easing->step_count <= 0) return t;
+        step = easing->initial_step + (int)floorf( t * (easing->final_step - easing->initial_step) );
+        if (t >= 1.0f) step = easing->final_step;
+        return (float)step / easing->step_count;
+    default:
+        return t;
+    }
+}
+
+/*** parameters ***/
+
+static void parameter_free( struct parameter *parameter )
+{
+    list_remove( &parameter->entry );
+    if (parameter->reference) ICompositionObject_Release( parameter->reference );
+    free( parameter->name );
+    free( parameter );
+}
+
+static void parameters_free( struct list *parameters )
+{
+    struct parameter *parameter, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( parameter, next, parameters, struct parameter, entry ) parameter_free( parameter );
+}
+
+static struct parameter *parameter_find( struct list *parameters, const WCHAR *name )
+{
+    struct parameter *parameter;
+    LIST_FOR_EACH_ENTRY( parameter, parameters, struct parameter, entry )
+        if (!wcsicmp( parameter->name, name )) return parameter;
+    return NULL;
+}
+
+static HRESULT parameters_copy( struct list *dst, struct list *src )
+{
+    struct parameter *parameter, *copy;
+
+    LIST_FOR_EACH_ENTRY( parameter, src, struct parameter, entry )
+    {
+        if (!(copy = calloc( 1, sizeof(*copy) )) || !(copy->name = wcsdup( parameter->name )))
+        {
+            free( copy );
+            parameters_free( dst );
+            return E_OUTOFMEMORY;
+        }
+        copy->value = parameter->value;
+        if ((copy->reference = parameter->reference)) ICompositionObject_AddRef( copy->reference );
+        list_add_tail( dst, &copy->entry );
+    }
+    return S_OK;
+}
+
+static HRESULT animation_set_parameter( struct animation *animation, HSTRING key, const struct value *value,
+                                        ICompositionObject *reference )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( key, NULL );
+    struct parameter *parameter;
+
+    if (!key || !*name) return E_INVALIDARG;
+    compositor_lock( animation->base.compositor );
+    if ((parameter = parameter_find( &animation->parameters, name ))) parameter_free( parameter );
+    if (!(parameter = calloc( 1, sizeof(*parameter) )) || !(parameter->name = wcsdup( name )))
+    {
+        compositor_unlock( animation->base.compositor );
+        free( parameter );
+        return E_OUTOFMEMORY;
+    }
+    parameter->value = *value;
+    if ((parameter->reference = reference)) ICompositionObject_AddRef( reference );
+    list_add_tail( &animation->parameters, &parameter->entry );
+    compositor_unlock( animation->base.compositor );
+    return S_OK;
+}
+
+/* what the names of an expression are: the parameters it was started with */
+static BOOL parameters_lookup( void *data, const WCHAR *name, struct value *value )
+{
+    struct parameter *parameter = parameter_find( data, name );
+    struct object *object;
+
+    if (!parameter) return FALSE;
+    if (!parameter->reference)
+    {
+        *value = parameter->value;
+        return TRUE;
+    }
+    if (!(object = unsafe_impl_from_ICompositionObject( parameter->reference )))
+    {
+        FIXME( "parameter %s is not one of our objects.\n", debugstr_w( name ) );
+        return FALSE;
+    }
+    return value_object( value, object );
+}
+
+/*** key frames ***/
+
+static void frame_clear( struct key_frame *frame )
+{
+    free( frame->text );
+    expression_free( frame->expression );
+    if (frame->easing) ICompositionEasingFunction_Release( frame->easing );
+    memset( frame, 0, sizeof(*frame) );
+}
+
+static void frames_free( struct key_frame *frames, unsigned int count )
+{
+    unsigned int i;
+    for (i = 0; i < count; i++) frame_clear( &frames[i] );
+    free( frames );
+}
+
+/* a key frame at a progress there is one at already takes its place */
+static HRESULT animation_insert_frame( struct animation *animation, float progress, const struct value *value,
+                                       HSTRING text, ICompositionEasingFunction *easing )
+{
+    struct key_frame frame = {progress}, *frames;
+    unsigned int i;
+
+    if (!(progress >= 0.0f && progress <= 1.0f)) return E_INVALIDARG;
+    if (value) frame.value = *value;
+    else if (!text) return E_INVALIDARG;
+    else
+    {
+        if (!(frame.text = wcsdup( WindowsGetStringRawBuffer( text, NULL ) ))) return E_OUTOFMEMORY;
+        /* a bad one is found out when the animation is started */
+        expression_parse( frame.text, &frame.expression );
+    }
+    if ((frame.easing = easing)) ICompositionEasingFunction_AddRef( easing );
+
+    compositor_lock( animation->base.compositor );
+    for (i = 0; i < animation->frame_count; i++) if (animation->frames[i].progress >= progress) break;
+    if (i < animation->frame_count && animation->frames[i].progress == progress)
+    {
+        frame_clear( &animation->frames[i] );
+        animation->frames[i] = frame;
+    }
+    else if (!(frames = realloc( animation->frames, (animation->frame_count + 1) * sizeof(*frames) )))
+    {
+        compositor_unlock( animation->base.compositor );
+        frame_clear( &frame );
+        return E_OUTOFMEMORY;
+    }
+    else
+    {
+        animation->frames = frames;
+        memmove( frames + i + 1, frames + i, (animation->frame_count - i) * sizeof(*frames) );
+        frames[i] = frame;
+        animation->frame_count++;
+    }
+    animation->frames_checked = FALSE;
+    compositor_unlock( animation->base.compositor );
+    return S_OK;
+}
+
+static HRESULT frames_copy( const struct key_frame *src, unsigned int count, struct key_frame **out )
+{
+    struct key_frame *frames;
+    unsigned int i;
+
+    *out = NULL;
+    if (!count) return S_OK;
+    if (!(frames = calloc( count, sizeof(*frames) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++)
+    {
+        frames[i].progress = src[i].progress;
+        frames[i].value = src[i].value;
+        if (src[i].text)
+        {
+            if (!(frames[i].text = wcsdup( src[i].text )))
+            {
+                frames_free( frames, i );
+                return E_OUTOFMEMORY;
+            }
+            expression_parse( frames[i].text, &frames[i].expression );
+        }
+        if ((frames[i].easing = src[i].easing)) ICompositionEasingFunction_AddRef( frames[i].easing );
+    }
+    *out = frames;
+    return S_OK;
+}
+
+/*** running animations ***/
+
+
+static void running_context( struct running *running, struct eval_context *context, const struct value *current )
+{
+    memset( context, 0, sizeof(*context) );
+    context->lookup = parameters_lookup;
+    context->lookup_data = &running->parameters;
+    context->target = running->object;
+    context->starting = running->starting;
+    context->current = current ? *current : running->starting;
+    context->final = running->starting;
+}
+
+/* the value of an expression, if it is of the type wanted */
+static BOOL evaluate_as( const struct expression *expression, const struct eval_context *context, enum value_type type,
+                         struct value *out )
+{
+    struct value value;
+
+    if (!expression_evaluate( expression, context, &value )) return FALSE;
+    if (value.type != type && !((value.type == VALUE_VECTOR4 && type == VALUE_QUATERNION) ||
+                                (value.type == VALUE_QUATERNION && type == VALUE_VECTOR4)))
+    {
+        TRACE( "%s is not what is animated.\n", debugstr_value( &value ) );
+        return FALSE;
+    }
+    return value_convert( &value, type, out );
+}
+
+static BOOL frame_value( struct running *running, const struct key_frame *frame, struct value *out, int depth )
+{
+    struct eval_context context;
+
+    if (!frame->text)
+    {
+        *out = frame->value;
+        return TRUE;
+    }
+    running_context( running, &context, NULL );
+    context.depth = depth;
+    return frame->expression && evaluate_as( frame->expression, &context, running->type, out );
+}
+
+/* where a key frame animation is at progress p of an iteration */
+static BOOL frames_at( struct running *running, float p, struct value *out, int depth )
+{
+    struct value from, to;
+    unsigned int i;
+    float from_progress = 0.0f, t;
+
+    if (!running->frame_count)
+    {
+        *out = running->starting;
+        return TRUE;
+    }
+    for (i = 0; i < running->frame_count; i++) if (running->frames[i].progress >= p) break;
+    if (i == running->frame_count) return frame_value( running, &running->frames[i - 1], out, depth );
+    if (!frame_value( running, &running->frames[i], &to, depth )) return FALSE;
+    /* before the first key frame is where the property started */
+    if (i) from_progress = running->frames[i - 1].progress;
+    if (!i) from = running->starting;
+    else if (!frame_value( running, &running->frames[i - 1], &from, depth )) return FALSE;
+    if (running->frames[i].progress <= from_progress)
+    {
+        *out = to;
+        return TRUE;
+    }
+    t = (p - from_progress) / (running->frames[i].progress - from_progress);
+    t = ease( running->frames[i].easing, t );
+    value_interpolate( &from, &to, t, out );
+    return TRUE;
+}
+
+/* the progress of an iteration, as its direction goes */
+static float directed( AnimationDirection direction, INT64 iteration, float fraction )
+{
+    switch (direction)
+    {
+    case AnimationDirection_Reverse: return 1.0f - fraction;
+    case AnimationDirection_Alternate: return iteration & 1 ? 1.0f - fraction : fraction;
+    case AnimationDirection_AlternateReverse: return iteration & 1 ? fraction : 1.0f - fraction;
+    default: return fraction;
+    }
+}
+
+/* whether a key frame animation has run its course by now */
+static BOOL running_done( const struct running *running, LONGLONG now )
+{
+    if (running->kind != ANIMATION_KEY_FRAME || !running->start) return FALSE;
+    if (running->iteration_behavior == AnimationIterationBehavior_Forever) return FALSE;
+    return now - running->start - running->delay >= running->duration * running->iteration_count;
+}
+
+/* what a running animation makes of its property now */
+static BOOL running_value( struct running *running, LONGLONG now, struct value *out, int depth )
+{
+    struct eval_context context;
+    LONGLONG time;
+    INT64 iteration;
+
+    if (running->kind == ANIMATION_EXPRESSION)
+    {
+        running_context( running, &context, running->has_last ? &running->last : NULL );
+        context.depth = depth;
+        return evaluate_as( running->expression, &context, running->type, out );
+    }
+
+    if (!running->start) time = 0;
+    else time = now - running->start - running->delay;
+    if (time < 0 || !running->start)
+    {
+        /* before it starts, the property is as it was, unless told to take the first key frame's value */
+        if (running->delay_behavior != AnimationDelayBehavior_SetInitialValueBeforeDelay) return FALSE;
+        return frames_at( running, directed( running->direction, 0, 0.0f ), out, depth );
+    }
+    iteration = time / running->duration;
+    if (running->iteration_behavior == AnimationIterationBehavior_Count && iteration >= running->iteration_count)
+        return frames_at( running, directed( running->direction, running->iteration_count - 1, 1.0f ), out, depth );
+    return frames_at( running, directed( running->direction, iteration,
+                                         (float)(time - iteration * running->duration) / running->duration ), out, depth );
+}
+
+/*
+ * Applies the animations running on name, and on its members, to value.
+ * Called with the compositor locked.
+ */
+BOOL object_animate( struct object *object, const WCHAR *name, struct value *value, int depth )
+{
+    struct running *running;
+    BOOL animated = FALSE;
+    LONGLONG now = 0;
+
+    LIST_FOR_EACH_ENTRY( running, &object->animations, struct running, entry )
+    {
+        struct value result;
+
+        if (wcsicmp( running->property, name )) continue;
+        if (!now) now = compositor_time();
+        if (!running_value( running, now, &result, depth ))
+        {
+            if (running->has_last) result = running->last;
+            else continue;
+        }
+        running->last = result;
+        running->has_last = TRUE;
+        if (!running->member) *value = result;
+        else if (!value_set_member( value, running->member, &result )) continue;
+        animated = TRUE;
+    }
+    return animated;
+}
+
+static void batch_release_animation( struct batch *batch );
+
+/* called with the compositor locked; the property keeps the value the stop behavior says */
+static void running_stop( struct running *running, BOOL completed )
+{
+    struct compositor *compositor = running->object->compositor;
+    struct value value;
+    BOOL set = FALSE;
+    unsigned int i;
+
+    if (running->kind == ANIMATION_KEY_FRAME)
+    {
+        switch (completed ? AnimationStopBehavior_LeaveCurrentValue : running->stop_behavior)
+        {
+        case AnimationStopBehavior_LeaveCurrentValue:
+            if (completed) set = running_value( running, compositor_time(), &value, 0 );
+            else if ((set = running->has_last)) value = running->last;
+            break;
+        case AnimationStopBehavior_SetToInitialValue:
+            value = running->starting;
+            set = TRUE;
+            break;
+        case AnimationStopBehavior_SetToFinalValue:
+            set = frames_at( running, directed( running->direction, running->iteration_count - 1, 1.0f ), &value, 0 );
+            break;
+        }
+        if (set) object_set_value( running->object, running->property, running->member, &value );
+    }
+
+    list_remove( &running->entry );
+    if (running->kind == ANIMATION_KEY_FRAME) list_remove( &running->time_entry );
+    for (i = 0; i < ARRAY_SIZE(running->batches); i++)
+        if (running->batches[i]) batch_release_animation( running->batches[i] );
+    parameters_free( &running->parameters );
+    expression_free( running->expression );
+    frames_free( running->frames, running->frame_count );
+    free( running->property );
+    free( running );
+    compositor_changed( compositor );
+}
+
+void object_stop_animations( struct object *object )
+{
+    struct running *running, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( running, next, &object->animations, struct running, entry ) running_stop( running, FALSE );
+}
+
+static BOOL batch_take_animation( struct compositor *compositor, struct running *running );
+static struct animation *unsafe_impl_from_ICompositionAnimation( ICompositionAnimation *iface );
+
+/*
+ * Starts an animation on a property of an object, or on a member of one, as in
+ * Offset.X: checked as Windows checks it, and copied.
+ */
+HRESULT object_start_animation( struct object *object, HSTRING property, ICompositionAnimation *iface )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( property, NULL ), *dot;
+    struct animation *animation = unsafe_impl_from_ICompositionAnimation( iface );
+    struct running *running, *other, *next;
+    struct value whole, part, check;
+    struct eval_context context;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!property || !*name) return E_INVALIDARG;
+    if (!animation)
+    {
+        if (iface) FIXME( "animation %p is not one of ours.\n", iface );
+        return E_INVALIDARG;
+    }
+    if (!(running = calloc( 1, sizeof(*running) ))) return E_OUTOFMEMORY;
+    list_init( &running->parameters );
+    if (!(running->property = wcsdup( name )))
+    {
+        free( running );
+        return E_OUTOFMEMORY;
+    }
+    if ((dot = wcschr( running->property, '.' )))
+    {
+        running->member = (WCHAR *)dot + 1;
+        *(WCHAR *)dot = 0;
+    }
+    running->object = object;
+    running->kind = animation->kind;
+
+    compositor_lock( object->compositor );
+
+    /* the property, as it is now, animations and all */
+    if (!object_get_value( object, running->property, &whole, 0 ) ||
+        (running->member && !value_member( &whole, running->member, &part )))
+    {
+        WARN( "%s %p has no property %s.\n", debugstr_w( object->ops->class_name ), object, debugstr_w( name ) );
+        hr = E_INVALIDARG;
+        goto failed;
+    }
+    running->starting = running->member ? part : whole;
+    running->type = running->starting.type;
+
+    if (FAILED(hr = parameters_copy( &running->parameters, &animation->parameters ))) goto failed;
+    if (animation->kind == ANIMATION_EXPRESSION)
+    {
+        if (!animation->text || FAILED(expression_parse( WindowsGetStringRawBuffer( animation->text, NULL ),
+                                                           &running->expression )))
+        {
+            hr = E_INVALIDARG;
+            goto failed;
+        }
+        running_context( running, &context, NULL );
+        if (!evaluate_as( running->expression, &context, running->type, &check ))
+        {
+            WARN( "%s does not make a %s.\n", debugstr_hstring( animation->text ), debugstr_w( name ) );
+            hr = E_INVALIDARG;
+            goto failed;
+        }
+    }
+    else
+    {
+        if (animation->type != running->type)
+        {
+            WARN( "a key frame animation of type %u does not animate %s.\n", animation->type, debugstr_w( name ) );
+            hr = E_INVALIDARG;
+            goto failed;
+        }
+        if (FAILED(hr = frames_copy( animation->frames, animation->frame_count, &running->frames ))) goto failed;
+        running->frame_count = animation->frame_count;
+        if (!animation->frames_checked)
+        {
+            animation->frames_checked = TRUE;
+            for (i = 0; i < running->frame_count; i++)
+            {
+                if (!running->frames[i].text) continue;
+                if (!running->frames[i].expression || !frame_value( running, &running->frames[i], &check, 0 ))
+                {
+                    WARN( "key frame %s does not make a %s.\n", debugstr_w( running->frames[i].text ), debugstr_w( name ) );
+                    hr = E_INVALIDARG;
+                    goto failed;
+                }
+            }
+        }
+        running->delay = animation->delay.Duration;
+        running->duration = animation->duration.Duration;
+        running->iteration_behavior = animation->iteration_behavior;
+        running->iteration_count = animation->iteration_count;
+        running->stop_behavior = animation->stop_behavior;
+        running->direction = animation->direction;
+        running->delay_behavior = animation->delay_behavior;
+    }
+
+    /* one animation to a property: what was running there stops, as told to */
+    LIST_FOR_EACH_ENTRY_SAFE( other, next, &object->animations, struct running, entry )
+    {
+        if (wcsicmp( other->property, running->property )) continue;
+        if (!other->member || !running->member || !wcsicmp( other->member, running->member )) running_stop( other, FALSE );
+    }
+    list_add_tail( &object->animations, &running->entry );
+    if (running->kind == ANIMATION_KEY_FRAME) list_add_tail( compositor_running( object->compositor ), &running->time_entry );
+    batch_take_animation( object->compositor, running );
+    compositor_changed( object->compositor );
+    compositor_unlock( object->compositor );
+    TRACE( "started %p on %s of %s %p.\n", animation, debugstr_w( name ), debugstr_w( object->ops->class_name ), object );
+    return S_OK;
+
+failed:
+    compositor_unlock( object->compositor );
+    parameters_free( &running->parameters );
+    expression_free( running->expression );
+    frames_free( running->frames, running->frame_count );
+    free( running->property );
+    free( running );
+    return hr;
+}
+
+HRESULT object_stop_animation( struct object *object, HSTRING property )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( property, NULL );
+    struct running *running, *next;
+    WCHAR buffer[64];
+    const WCHAR *dot;
+
+    if (!property || !*name) return E_INVALIDARG;
+    compositor_lock( object->compositor );
+    if (!object_has_property( object, name ))
+    {
+        compositor_unlock( object->compositor );
+        return E_INVALIDARG;
+    }
+    LIST_FOR_EACH_ENTRY_SAFE( running, next, &object->animations, struct running, entry )
+    {
+        if ((dot = wcschr( name, '.' )))
+        {
+            if (dot - name >= ARRAY_SIZE(buffer)) break;
+            memcpy( buffer, name, (dot - name) * sizeof(WCHAR) );
+            buffer[dot - name] = 0;
+            if (wcsicmp( running->property, buffer ) || !running->member || wcsicmp( running->member, dot + 1 )) continue;
+        }
+        else if (wcsicmp( running->property, name )) continue;
+        running_stop( running, FALSE );
+    }
+    compositor_changed( object->compositor );
+    compositor_unlock( object->compositor );
+    return S_OK;
+}
+
+/* called with the compositor locked, each frame: key frame animations start, and those done complete */
+void animations_frame( struct compositor *compositor )
+{
+    struct running *running, *next;
+    LONGLONG now = compositor_time();
+
+    LIST_FOR_EACH_ENTRY_SAFE( running, next, compositor_running( compositor ), struct running, time_entry )
+    {
+        if (!running->start)
+        {
+            running->start = now;
+            continue;
+        }
+        if (running_done( running, now )) running_stop( running, TRUE );
+    }
+}
+
+BOOL animations_running( struct compositor *compositor )
+{
+    return !list_empty( compositor_running( compositor ) );
+}
