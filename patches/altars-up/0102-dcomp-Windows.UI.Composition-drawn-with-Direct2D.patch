+    action_info_get_Id,
+    action_info_get_Status,
+    action_info_get_ErrorCode,
+    action_info_Cancel,
+    action_info_Close,
+};
+
+HRESULT async_action_create_completed( IAsyncAction **out )
+{
+    struct completed_action *action;
+
+    if (!(action = calloc( 1, sizeof(*action) ))) return E_OUTOFMEMORY;
+    action->IAsyncAction_iface.lpVtbl = &action_vtbl;
+    action->IAsyncInfo_iface.lpVtbl = &action_info_vtbl;
+    action->ref = 1;
+    *out = &action->IAsyncAction_iface;
+    return S_OK;
+}
+
+/*** CompositorController ***/
+
+/*
+ * A controller's compositor draws only when the controller is told to
+ * commit; the controller says when there is something to commit.
+ */
+struct controller
+{
+    ICompositorController ICompositorController_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    struct compositor *compositor;
+};
+
+static inline struct controller *impl_from_ICompositorController( ICompositorController *iface )
+{
+    return CONTAINING_RECORD( iface, struct controller, ICompositorController_iface );
+}
+
+static HRESULT WINAPI controller_QueryInterface( ICompositorController *iface, REFIID iid, void **out )
+{
+    struct controller *controller = impl_from_ICompositorController( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositorController ))
+        *out = &controller->ICompositorController_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable )) *out = &controller->IClosable_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI controller_AddRef( ICompositorController *iface )
+{
+    struct controller *controller = impl_from_ICompositorController( iface );
+    ULONG ref = InterlockedIncrement( &controller->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI controller_Release( ICompositorController *iface )
+{
+    struct controller *controller = impl_from_ICompositorController( iface );
+    ULONG ref = InterlockedDecrement( &controller->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        compositor_set_controller( controller->compositor, NULL );
+        compositor_release( controller->compositor );
+        free( controller );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI controller_GetIids( ICompositorController *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI controller_GetRuntimeClassName( ICompositorController *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.UI.Composition.Core.CompositorController";
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI controller_GetTrustLevel( ICompositorController *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI controller_get_Compositor( ICompositorController *iface, ICompositor **value )
+{
+    struct controller *controller = impl_from_ICompositorController( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    ICompositor_AddRef( (*value = compositor_iface( controller->compositor )) );
+    return S_OK;
+}
+
+static HRESULT WINAPI controller_Commit( ICompositorController *iface )
+{
+    struct controller *controller = impl_from_ICompositorController( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    return compositor_commit( controller->compositor );
+}
+
+static HRESULT WINAPI controller_EnsurePreviousCommitCompletedAsync( ICompositorController *iface, IAsyncAction **operation )
+{
+    TRACE( "iface %p, operation %p.\n", iface, operation );
+
+    /* a commit is drawn and presented before Commit returns */
+    if (!operation) return E_POINTER;
+    return async_action_create_completed( operation );
+}
+
+static HRESULT WINAPI controller_add_CommitNeeded( ICompositorController *iface, __FITypedEventHandler_2_Windows__CUI__CComposition__CCore__CCompositorController_IInspectable *handler, EventRegistrationToken *token )
+{
+    struct controller *controller = impl_from_ICompositorController( iface );
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!handler || !token) return E_INVALIDARG;
+    return compositor_add_commit_needed( controller->compositor, handler, token );
+}
+
+static HRESULT WINAPI controller_remove_CommitNeeded( ICompositorController *iface, EventRegistrationToken token )
+{
+    struct controller *controller = impl_from_ICompositorController( iface );
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    return compositor_remove_commit_needed( controller->compositor, token );
