+/*
+ * Named values of any type for expressions to read and animations to set.  As
+ * on Windows, names are not case sensitive, a name keeps the type it was first
+ * given, and TryGet tells a missing name from one of another type.
+ */
+struct named_value
+{
+    WCHAR *name;
+    struct value value;
+};
+
+struct property_set
+{
+    struct object base;
+    ICompositionPropertySet ICompositionPropertySet_iface;
+    ICompositionPropertySet2 ICompositionPropertySet2_iface;
+    struct named_value *values;
+    unsigned int count;
+};
+
+static inline struct property_set *impl_from_set_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct property_set, base );
+}
+
+static struct named_value *set_find( struct property_set *set, const WCHAR *name )
+{
+    unsigned int i;
+    for (i = 0; i < set->count; i++) if (!wcsicmp( set->values[i].name, name )) return &set->values[i];
+    return NULL;
+}
+
+static BOOL valid_name( const WCHAR *name )
+{
+    if (!name || !*name) return FALSE;
+    for (; *name; name++)
+        if (!((*name >= 'a' && *name <= 'z') || (*name >= 'A' && *name <= 'Z') || (*name >= '0' && *name <= '9') ||
+              *name == '_'))
+            return FALSE;
+    return TRUE;
+}
+
+static HRESULT property_set_insert( struct property_set *set, HSTRING key, const struct value *value )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( key, NULL );
+    struct named_value *found, *values;
+    HRESULT hr = S_OK;
+
+    if (!key || !valid_name( name )) return E_INVALIDARG;
+    compositor_lock( set->base.compositor );
+    if ((found = set_find( set, name )))
+    {
+        if (found->value.type != value->type) hr = E_INVALIDARG;
+        else found->value = *value;
+    }
+    else if (!(values = realloc( set->values, (set->count + 1) * sizeof(*values) ))) hr = E_OUTOFMEMORY;
+    else
+    {
+        set->values = values;
+        if (!(values[set->count].name = wcsdup( name ))) hr = E_OUTOFMEMORY;
+        else values[set->count++].value = *value;
+    }
+    if (SUCCEEDED(hr)) compositor_changed( set->base.compositor );
+    compositor_unlock( set->base.compositor );
+    return hr;
+}
+
+/* what TryGet finds: what is set, not what an animation makes of it */
+static CompositionGetValueStatus property_set_find( struct property_set *set, HSTRING key, enum value_type type,
+                                                    struct value *value )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( key, NULL );
+    CompositionGetValueStatus status = CompositionGetValueStatus_NotFound;
+    struct named_value *found;
+
+    compositor_lock( set->base.compositor );
+    if (key && (found = set_find( set, name )))
+    {
+        if (found->value.type != type) status = CompositionGetValueStatus_TypeMismatch;
+        else
+        {
+            *value = found->value;
+            status = CompositionGetValueStatus_Succeeded;
+        }
+    }
+    compositor_unlock( set->base.compositor );
+    return status;
+}
+
+static HRESULT set_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct property_set *set = impl_from_set_object( object );
+
+    if (IsEqualGUID( iid, &IID_ICompositionPropertySet )) *out = &set->ICompositionPropertySet_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionPropertySet2 )) *out = &set->ICompositionPropertySet2_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void set_destroy( struct object *object )
+{
+    struct property_set *set = impl_from_set_object( object );
+    unsigned int i;
+
+    for (i = 0; i < set->count; i++) free( set->values[i].name );
+    free( set->values );
+    free( set );
+}
+
+static BOOL set_get_property( struct object *object, const WCHAR *name, struct value *value )
+{
+    struct named_value *found = set_find( impl_from_set_object( object ), name );
+
+    if (!found) return FALSE;
+    *value = found->value;
+    return TRUE;
+}
+
+static BOOL set_set_property( struct object *object, const WCHAR *name, const struct value *value )
+{
+    struct named_value *found = set_find( impl_from_set_object( object ), name );
+    struct value converted;
+
+    if (!found || !value_convert( value, found->value.type, &converted )) return FALSE;
+    found->value = converted;
+    return TRUE;
+}
+
+static const struct object_ops set_ops =
+{
+    L"Windows.UI.Composition.CompositionPropertySet",
+    set_query_interface,
+    set_destroy,
+    NULL,
+    set_get_property,
+    set_set_property,
+};
