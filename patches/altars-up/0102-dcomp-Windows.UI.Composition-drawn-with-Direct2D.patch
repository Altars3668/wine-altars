+/*** easing functions, the objects ***/
+
+static inline struct easing *impl_from_easing_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct easing, base );
+}
+
+static HRESULT easing_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct easing *easing = impl_from_easing_object( object );
+
+    if (IsEqualGUID( iid, &IID_ICompositionEasingFunction )) *out = &easing->ICompositionEasingFunction_iface;
+    else if (easing->kind == EASING_LINEAR && IsEqualGUID( iid, &IID_ILinearEasingFunction ))
+        *out = &easing->ILinearEasingFunction_iface;
+    else if (easing->kind == EASING_CUBIC_BEZIER && IsEqualGUID( iid, &IID_ICubicBezierEasingFunction ))
+        *out = &easing->ICubicBezierEasingFunction_iface;
+    else if (easing->kind == EASING_STEP && IsEqualGUID( iid, &IID_IStepEasingFunction ))
+        *out = &easing->IStepEasingFunction_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void easing_destroy( struct object *object )
+{
+    free( impl_from_easing_object( object ) );
+}
+
+static const struct object_ops easing_ops[] =
+{
+    { L"Windows.UI.Composition.LinearEasingFunction", easing_query_interface, easing_destroy },
+    { L"Windows.UI.Composition.CubicBezierEasingFunction", easing_query_interface, easing_destroy },
+    { L"Windows.UI.Composition.StepEasingFunction", easing_query_interface, easing_destroy },
+};
