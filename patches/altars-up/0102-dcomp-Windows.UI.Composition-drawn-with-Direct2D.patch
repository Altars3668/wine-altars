+static void test_property_sets(void)
+{
+    ICompositionPropertySet *props, *visual_props = NULL, *again = NULL;
+    IDispatcherQueueController *queue;
+    ICompositorController *controller;
+    ICompositionPropertySet2 *props2;
+    CompositionGetValueStatus status;
+    ICompositionObject *object;
+    ICompositor *compositor;
+    ISpriteVisual *sprite;
+    HSTRING str;
+    Vector2 v2;
+    boolean b;
+    FLOAT f;
+    HRESULT hr;
+
+    queue = create_queue( DQTAT_COM_STA );
+    if (!(controller = create_controller( &compositor ))) goto done;
+
+    hr = ICompositor_CreatePropertySet( compositor, &props );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( props, L"Windows.UI.Composition.CompositionPropertySet" );
+    check_interface( props, &IID_ICompositionPropertySet2, TRUE );
+    check_interface( props, &IID_ICompositionObject, TRUE );
+
+    str = hstring( L"foo" );
+    f = -1;
+    status = -1;
+    hr = ICompositionPropertySet_TryGetScalar( props, str, &f, &status );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( status == CompositionGetValueStatus_NotFound, "got status %d.\n", status );
+    ok( !f, "got value %f.\n", f );
+    hr = ICompositionPropertySet_InsertScalar( props, str, 2.5f );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    status = -1;
+    hr = ICompositionPropertySet_TryGetScalar( props, str, &f, &status );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( status == CompositionGetValueStatus_Succeeded, "got status %d.\n", status );
+    ok( f == 2.5f, "got value %f.\n", f );
+    v2.X = v2.Y = -1;
+    status = -1;
+    hr = ICompositionPropertySet_TryGetVector2( props, str, &v2, &status );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( status == CompositionGetValueStatus_TypeMismatch, "got status %d.\n", status );
+    ok( !v2.X && !v2.Y, "got value %f,%f.\n", v2.X, v2.Y );
+    /* a name keeps its type */
+    hr = ICompositionPropertySet_InsertVector2( props, str, (Vector2){3, 4} );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    WindowsDeleteString( str );
+    /* and is not case sensitive */
+    str = hstring( L"FOO" );
+    status = -1;
+    hr = ICompositionPropertySet_TryGetVector2( props, str, &v2, &status );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( status == CompositionGetValueStatus_TypeMismatch, "got status %d.\n", status );
+    WindowsDeleteString( str );
+    hr = ICompositionPropertySet_InsertScalar( props, NULL, 1.0f );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    str = hstring( L"bar.baz" );
+    hr = ICompositionPropertySet_InsertScalar( props, str, 1.0f );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    WindowsDeleteString( str );
+    ICompositionPropertySet_QueryInterface( props, &IID_ICompositionPropertySet2, (void **)&props2 );
+    str = hstring( L"flag" );
+    hr = ICompositionPropertySet2_InsertBoolean( props2, str, TRUE );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    b = 2;
+    status = -1;
+    ICompositionPropertySet2_TryGetBoolean( props2, str, &b, &status );
+    ok( status == CompositionGetValueStatus_Succeeded, "got status %d.\n", status );
+    ok( b == TRUE, "got value %d.\n", b );
+    WindowsDeleteString( str );
+    ICompositionPropertySet2_Release( props2 );
+
+    /* animations of a set's values, of the right type */
+    hr = start_expression( compositor, props, L"foo", L"Vector2(1, 1)" );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = start_expression( compositor, props, L"foo.X", L"1" );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = start_expression( compositor, props, L"nope", L"1" );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = start_expression( compositor, props, L"foo", L"1" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionPropertySet_Release( props );
+
+    /* every object has one, whose values it animates as its own */
+    ICompositor_CreateSpriteVisual( compositor, &sprite );
+    ISpriteVisual_QueryInterface( sprite, &IID_ICompositionObject, (void **)&object );
+    hr = ICompositionObject_get_Properties( object, &visual_props );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( visual_props, L"Windows.UI.Composition.CompositionPropertySet" );
+    ICompositionObject_get_Properties( object, &again );
+    ok( again == visual_props, "got another set.\n" );
+    str = hstring( L"foo" );
+    ICompositionPropertySet_InsertScalar( visual_props, str, 3.0f );
+    WindowsDeleteString( str );
+    hr = start_expression( compositor, sprite, L"foo", L"1" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionPropertySet_Release( again );
+    ICompositionPropertySet_Release( visual_props );
+    ICompositionObject_Release( object );
+    ISpriteVisual_Release( sprite );
+
+    ICompositor_Release( compositor );
+    ICompositorController_Release( controller );
+done:
+    if (queue) IDispatcherQueueController_Release( queue );
+}
+
+static void test_easing_and_batches(void)
+{
+    ICubicBezierEasingFunction *bezier = NULL;
+    IDispatcherQueueController *queue;
+    ICompositorController *controller;
+    ICompositionCommitBatch *commit, *again;
+    ILinearEasingFunction *linear = NULL;
+    ICompositionScopedBatch *batch = NULL;
+    IStepEasingFunction *step = NULL;
+    ICompositor2 *compositor2;
+    ICompositor *compositor;
+    Vector2 v2;
+    boolean b;
+    INT32 i;
+    HRESULT hr;
+
+    queue = create_queue( DQTAT_COM_STA );
+    if (!(controller = create_controller( &compositor ))) goto done;
+    ICompositor_QueryInterface( compositor, &IID_ICompositor2, (void **)&compositor2 );
+
+    hr = ICompositor_CreateLinearEasingFunction( compositor, &linear );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( linear, L"Windows.UI.Composition.LinearEasingFunction" );
+    check_interface( linear, &IID_ICompositionEasingFunction, TRUE );
+    ILinearEasingFunction_Release( linear );
+
+    hr = ICompositor_CreateCubicBezierEasingFunction( compositor, (Vector2){0.1f, 0.2f}, (Vector2){0.3f, 0.4f}, &bezier );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( bezier, L"Windows.UI.Composition.CubicBezierEasingFunction" );
+    ICubicBezierEasingFunction_get_ControlPoint1( bezier, &v2 );
+    ok( v2.X == 0.1f && v2.Y == 0.2f, "got control point %f,%f.\n", v2.X, v2.Y );
+    ICubicBezierEasingFunction_get_ControlPoint2( bezier, &v2 );
+    ok( v2.X == 0.3f && v2.Y == 0.4f, "got control point %f,%f.\n", v2.X, v2.Y );
+    ICubicBezierEasingFunction_Release( bezier );
+    /* the curve goes forward in time, but not necessarily in value */
+    hr = ICompositor_CreateCubicBezierEasingFunction( compositor, (Vector2){1.5f, 0.2f}, (Vector2){0.3f, 0.4f}, &bezier );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = ICompositor_CreateCubicBezierEasingFunction( compositor, (Vector2){0.5f, 2.0f}, (Vector2){0.3f, -1.0f}, &bezier );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICubicBezierEasingFunction_Release( bezier );
+
+    hr = ICompositor2_CreateStepEasingFunction( compositor2, &step );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( step, L"Windows.UI.Composition.StepEasingFunction" );
+    i = -1;
+    IStepEasingFunction_get_StepCount( step, &i );
+    ok( i == 1, "got step count %d.\n", i );
+    i = -1;
+    IStepEasingFunction_get_InitialStep( step, &i );
+    ok( !i, "got initial step %d.\n", i );
+    i = -1;
+    IStepEasingFunction_get_FinalStep( step, &i );
+    ok( i == 1, "got final step %d.\n", i );
+    b = 2;
+    IStepEasingFunction_get_IsInitialStepSingleFrame( step, &b );
+    ok( !b, "got IsInitialStepSingleFrame %d.\n", b );
+    hr = IStepEasingFunction_put_StepCount( step, 0 );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IStepEasingFunction_put_StepCount( step, 4 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IStepEasingFunction_get_FinalStep( step, &i );
+    ok( i == 1, "got final step %d.\n", i );
+    IStepEasingFunction_Release( step );
+    hr = ICompositor2_CreateStepEasingFunctionWithStepCount( compositor2, 5, &step );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IStepEasingFunction_get_FinalStep( step, &i );
+    ok( i == 5, "got final step %d.\n", i );
+    IStepEasingFunction_Release( step );
+
+    hr = ICompositor_CreateScopedBatch( compositor, CompositionBatchTypes_Animation, &batch );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( batch, L"Windows.UI.Composition.CompositionScopedBatch" );
+    b = 2;
+    ICompositionScopedBatch_get_IsActive( batch, &b );
+    ok( b == TRUE, "got IsActive %d.\n", b );
+    b = 2;
+    ICompositionScopedBatch_get_IsEnded( batch, &b );
+    ok( !b, "got IsEnded %d.\n", b );
+    hr = ICompositionScopedBatch_Suspend( batch );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionScopedBatch_get_IsActive( batch, &b );
+    ok( !b, "got IsActive %d.\n", b );
+    hr = ICompositionScopedBatch_Suspend( batch );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    hr = ICompositionScopedBatch_Resume( batch );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionScopedBatch_End( batch );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionScopedBatch_get_IsActive( batch, &b );
+    ok( !b, "got IsActive %d.\n", b );
+    ICompositionScopedBatch_get_IsEnded( batch, &b );
+    ok( b == TRUE, "got IsEnded %d.\n", b );
+    hr = ICompositionScopedBatch_End( batch );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    hr = ICompositionScopedBatch_Resume( batch );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    ICompositionScopedBatch_Release( batch );
+    hr = ICompositor_CreateScopedBatch( compositor, 0, &batch );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+
+    /* the batch of the next commit, the same one until then */
+    hr = ICompositor_GetCommitBatch( compositor, CompositionBatchTypes_Animation, &commit );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( commit, L"Windows.UI.Composition.CompositionCommitBatch" );
+    ICompositionCommitBatch_get_IsActive( commit, &b );
+    ok( b == TRUE, "got IsActive %d.\n", b );
+    ICompositor_GetCommitBatch( compositor, CompositionBatchTypes_Animation, &again );
+    ok( again == commit, "got another batch.\n" );
+    ICompositionCommitBatch_Release( again );
+    ICompositorController_Commit( controller );
+    ICompositionCommitBatch_get_IsActive( commit, &b );
+    ok( !b, "got IsActive %d.\n", b );
+    ICompositionCommitBatch_get_IsEnded( commit, &b );
+    ok( b == TRUE, "got IsEnded %d.\n", b );
+    ICompositor_GetCommitBatch( compositor, CompositionBatchTypes_Animation, &again );
+    ok( again != commit, "got the same batch.\n" );
+    ICompositionCommitBatch_Release( again );
+    ICompositionCommitBatch_Release( commit );
+
+    ICompositor2_Release( compositor2 );
+    ICompositor_Release( compositor );
+    ICompositorController_Release( controller );
+done:
+    if (queue) IDispatcherQueueController_Release( queue );
+}
