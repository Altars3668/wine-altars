+static HRESULT modifier_create( ICompositor *compositor_iface, enum modifier_kind kind, REFIID iid, void **out )
+{
+    struct compositor *compositor;
+    struct modifier *modifier;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(compositor = unsafe_impl_from_ICompositor( compositor_iface ))) return E_INVALIDARG;
+    if (!(modifier = calloc( 1, sizeof(*modifier) ))) return E_OUTOFMEMORY;
+    object_init( &modifier->base, &modifier_ops[kind], compositor );
+    modifier->ICompositionConditionalValue_iface.lpVtbl = &cond_vtbl;
+    modifier->IInteractionTrackerInertiaModifier_iface.lpVtbl = &inertia_vtbl;
+    modifier->IInteractionTrackerInertiaRestingValue_iface.lpVtbl = &resting_vtbl;
+    modifier->IInteractionTrackerInertiaMotion_iface.lpVtbl = &motion_vtbl;
+    modifier->kind = kind;
+    hr = IInspectable_QueryInterface( object_inspectable( &modifier->base ), iid, out );
+    object_release( &modifier->base );
+    return hr;
+}
