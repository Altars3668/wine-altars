+
+static HRESULT WINAPI graphics_remove_RenderingDeviceReplaced( ICompositionGraphicsDevice *iface, EventRegistrationToken token )
+{
+    struct graphics_device *device = impl_from_ICompositionGraphicsDevice( iface );
+    struct replaced_handler *entry, *found = NULL;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    compositor_lock( device->base.compositor );
+    LIST_FOR_EACH_ENTRY( entry, &device->replaced_handlers, struct replaced_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    compositor_unlock( device->base.compositor );
+    if (found)
+    {
+        ITypedEventHandler_CompositionGraphicsDevice_RenderingDeviceReplacedEventArgs_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
