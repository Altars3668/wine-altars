+/* called with the compositor locked */
+static void tracker_tell_owner( struct tracker *tracker, enum tracker_callback kind, INT32 request_id )
+{
+    IDispatcherQueue *queue;
+    struct owner_call *call;
+    boolean queued = FALSE;
+
+    if (!tracker->owner || !(queue = compositor_dispatcher_queue( tracker->base.compositor ))) return;
+    if (!(call = calloc( 1, sizeof(*call) ))) return;
+    if (!(call->args = args_create( kind, request_id, tracker->position, tracker->scale )))
+    {
+        free( call );
+        return;
+    }
+    call->IDispatcherQueueHandler_iface.lpVtbl = &owner_call_vtbl;
+    call->ref = 1;
+    IInteractionTracker_AddRef( &tracker->IInteractionTracker_iface );
+    call->tracker = tracker;
+    if (FAILED(IDispatcherQueue_TryEnqueue( queue, &call->IDispatcherQueueHandler_iface, &queued )) || !queued)
+        WARN( "could not queue the owner's callback.\n" );
+    IDispatcherQueueHandler_Release( &call->IDispatcherQueueHandler_iface );
+}
+
+static void tracker_values_changed( struct tracker *tracker, INT32 request_id )
+{
+    tracker_tell_owner( tracker, CALLBACK_VALUES_CHANGED, request_id );
+    compositor_changed( tracker->base.compositor );
+}
+
+static float clampf( float value, float low, float high )
+{
+    if (value > high) value = high;
+    if (value < low) value = low;
+    return value;
+}
+
+/* the bounds as they are now: animations of them, as Office's of what its content allows, count */
+static void tracker_bounds( struct tracker *tracker, Vector3 *min_position, Vector3 *max_position, float *min_scale,
+                            float *max_scale )
+{
+    struct value value;
+
+    *min_position = tracker->min_position;
+    *max_position = tracker->max_position;
+    *min_scale = tracker->min_scale;
+    *max_scale = tracker->max_scale;
+    if (list_empty( &tracker->base.animations )) return;
+    value_vector3( &value, *min_position );
+    if (object_animate( &tracker->base, L"MinPosition", &value, 0 )) value_get_vector3( &value, min_position );
+    value_vector3( &value, *max_position );
+    if (object_animate( &tracker->base, L"MaxPosition", &value, 0 )) value_get_vector3( &value, max_position );
+    value_scalar( &value, *min_scale );
+    if (object_animate( &tracker->base, L"MinScale", &value, 0 )) value_get_scalar( &value, min_scale );
+    value_scalar( &value, *max_scale );
+    if (object_animate( &tracker->base, L"MaxScale", &value, 0 )) value_get_scalar( &value, max_scale );
+}
+
+/* keeps position and scale within their bounds; the upper bound gives way to the lower one */
+static void tracker_clamp( struct tracker *tracker, BOOL position_unclamped )
+{
+    Vector3 low, high;
+    float low_scale, high_scale;
+
+    tracker_bounds( tracker, &low, &high, &low_scale, &high_scale );
+    tracker->scale = clampf( tracker->scale, low_scale, max( low_scale, high_scale ) );
+    if (position_unclamped) return;
+    tracker->position.X = clampf( tracker->position.X, low.X, max( low.X, high.X ) );
+    tracker->position.Y = clampf( tracker->position.Y, low.Y, max( low.Y, high.Y ) );
+    tracker->position.Z = clampf( tracker->position.Z, low.Z, max( low.Z, high.Z ) );
+}
+
+/* called with the compositor locked, each frame: bounds that animations moved move the position with them */
+void trackers_frame( struct compositor *compositor )
+{
+    struct tracker *tracker;
+
+    LIST_FOR_EACH_ENTRY( tracker, compositor_trackers( compositor ), struct tracker, compositor_entry )
+    {
+        Vector3 position = tracker->position;
+        float scale = tracker->scale;
+
+        if (list_empty( &tracker->base.animations )) continue;
+        tracker_clamp( tracker, FALSE );
+        if (!memcmp( &position, &tracker->position, sizeof(position) ) && scale == tracker->scale) continue;
+        tracker->natural_resting_position = tracker->position;
+        tracker->natural_resting_scale = tracker->scale;
+        tracker_tell_owner( tracker, CALLBACK_VALUES_CHANGED, 0 );
+    }
+}
+
+static HRESULT tracker_update_position( struct tracker *tracker, Vector3 value, BOOL relative, BOOL clamp,
+                                        INT32 *result )
+{
+    if (!result) return E_POINTER;
+
+    compositor_lock( tracker->base.compositor );
+    *result = ++tracker->request_id;
+    if (relative)
+    {
+        value.X += tracker->position.X;
+        value.Y += tracker->position.Y;
+        value.Z += tracker->position.Z;
+    }
+    tracker->position = value;
+    tracker_clamp( tracker, !clamp );
+    tracker->natural_resting_position = tracker->position;
+    tracker_values_changed( tracker, *result );
+    compositor_unlock( tracker->base.compositor );
+    return S_OK;
+}
+
+/* scaled about the center point: what is under it stays under it */
+static HRESULT tracker_update_scale( struct tracker *tracker, FLOAT value, Vector3 center, INT32 *result )
+{
+    float old;
+
+    if (!result) return E_POINTER;
+
+    compositor_lock( tracker->base.compositor );
+    *result = ++tracker->request_id;
+    old = tracker->scale;
+    tracker->scale = value;
+    tracker_clamp( tracker, TRUE );
+    if (old)
+    {
+        float ratio = tracker->scale / old;
+        tracker->position.X = (tracker->position.X + center.X) * ratio - center.X;
+        tracker->position.Y = (tracker->position.Y + center.Y) * ratio - center.Y;
+    }
+    tracker_clamp( tracker, FALSE );
+    tracker->natural_resting_scale = tracker->scale;
+    tracker->natural_resting_position = tracker->position;
+    tracker_values_changed( tracker, *result );
+    compositor_unlock( tracker->base.compositor );
+    return S_OK;
+}
