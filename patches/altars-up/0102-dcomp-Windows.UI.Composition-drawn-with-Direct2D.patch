+static void device_release_devices( struct graphics_device *device )
+{
+    if (device->context) ID2D1DeviceContext_Release( device->context );
+    if (device->multithread) ID2D1Multithread_Release( device->multithread );
+    if (device->d2d_device) ID2D1Device_Release( device->d2d_device );
+    if (device->d3d_device) ID3D11Device_Release( device->d3d_device );
+    if (device->rendering_device) IUnknown_Release( device->rendering_device );
+    device->context = NULL;
+    device->multithread = NULL;
+    device->d2d_device = NULL;
+    device->d3d_device = NULL;
+    device->rendering_device = NULL;
+}
+
+/*
+ * What the application draws with is a Direct2D device or a Direct3D one; the
+ * surfaces' textures are made on the Direct3D device under it either way.
+ */
+static HRESULT device_set_rendering_device( struct graphics_device *device, IUnknown *rendering_device )
+{
+    ID2D1DeviceContext *context = NULL;
+    ID2D1Multithread *multithread = NULL;
+    ID3D11Device *d3d = NULL;
+    ID2D1Device *d2d = NULL;
+    ID2D1Factory *factory;
+    HRESULT hr;
+
+    if (!rendering_device) return E_INVALIDARG;
+
+    if (SUCCEEDED(IUnknown_QueryInterface( rendering_device, &IID_ID2D1Device, (void **)&d2d )))
+    {
+        D2D1_BITMAP_PROPERTIES1 props = {{DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED}, 96.0f, 96.0f,
+                                         D2D1_BITMAP_OPTIONS_TARGET | D2D1_BITMAP_OPTIONS_CANNOT_DRAW};
+        IDXGISurface *surface;
+        ID2D1Bitmap1 *bitmap;
+
+        if (FAILED(hr = ID2D1Device_CreateDeviceContext( d2d, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &context ))) goto failed;
+        if (FAILED(hr = ID2D1DeviceContext_CreateBitmap( context, (D2D1_SIZE_U){1, 1}, NULL, 0, &props, &bitmap )))
+            goto failed;
+        hr = ID2D1Bitmap1_GetSurface( bitmap, &surface );
+        ID2D1Bitmap1_Release( bitmap );
+        if (FAILED(hr)) goto failed;
+        hr = IDXGISurface_GetDevice( surface, &IID_ID3D11Device, (void **)&d3d );
+        IDXGISurface_Release( surface );
+        if (FAILED(hr)) goto failed;
+    }
+    else if (SUCCEEDED(IUnknown_QueryInterface( rendering_device, &IID_ID3D11Device, (void **)&d3d )))
+    {
+        IDXGIDevice *dxgi;
+
+        if (FAILED(hr = ID3D11Device_QueryInterface( d3d, &IID_IDXGIDevice, (void **)&dxgi ))) goto failed;
+        hr = D2D1CreateDevice( dxgi, NULL, &d2d );
+        IDXGIDevice_Release( dxgi );
+        if (FAILED(hr)) goto failed;
+        if (FAILED(hr = ID2D1Device_CreateDeviceContext( d2d, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &context ))) goto failed;
+    }
+    else
+    {
+        WARN( "%p is neither a Direct2D nor a Direct3D 11 device.\n", rendering_device );
+        return E_INVALIDARG;
+    }
+
+    ID2D1Device_GetFactory( d2d, &factory );
+    if (FAILED(ID2D1Factory_QueryInterface( factory, &IID_ID2D1Multithread, (void **)&multithread ))) multithread = NULL;
+    else if (!ID2D1Multithread_GetMultithreadProtected( multithread ))
+    {
+        ID2D1Multithread_Release( multithread );
+        multithread = NULL;
+    }
+    ID2D1Factory_Release( factory );
+
+    device_release_devices( device );
+    device->rendering_device = rendering_device;
+    IUnknown_AddRef( rendering_device );
+    device->d3d_device = d3d;
+    device->d2d_device = d2d;
+    device->multithread = multithread;
+    device->context = context;
+    return S_OK;
+
+failed:
+    WARN( "failed to set up the device, hr %#lx.\n", hr );
+    if (context) ID2D1DeviceContext_Release( context );
+    if (d2d) ID2D1Device_Release( d2d );
+    if (d3d) ID3D11Device_Release( d3d );
+    return hr;
+}
+
+static void device_destroy( struct object *object )
+{
+    struct graphics_device *device = impl_from_device_object( object );
+    struct replaced_handler *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &device->replaced_handlers, struct replaced_handler, entry )
+    {
+        list_remove( &entry->entry );
+        ITypedEventHandler_CompositionGraphicsDevice_RenderingDeviceReplacedEventArgs_Release( entry->handler );
+        free( entry );
+    }
+    device_release_devices( device );
+    free( device );
+}
