+
+
+static HSTRING hstring( const WCHAR *s )
+{
+    HSTRING str = NULL;
+    WindowsCreateString( s, wcslen( s ), &str );
+    return str;
+}
+
+#define check_interface( obj, iid, supported ) check_interface_( __LINE__, obj, iid, supported )
+static void check_interface_( unsigned int line, void *obj, const IID *iid, BOOL supported )
+{
+    IUnknown *unk = NULL;
+    HRESULT hr;
+
+    hr = IUnknown_QueryInterface( (IUnknown *)obj, iid, (void **)&unk );
+    ok_(__FILE__, line)( hr == (supported ? S_OK : E_NOINTERFACE), "got hr %#lx for %s.\n", hr, debugstr_guid( iid ) );
+    if (unk) IUnknown_Release( unk );
+}
+
+#define check_class( obj, name ) check_class_( __LINE__, obj, name )
+static void check_class_( unsigned int line, void *obj, const WCHAR *name )
+{
+    IInspectable *inspectable;
+    HSTRING str = NULL;
+    HRESULT hr;
+
+    hr = IUnknown_QueryInterface( (IUnknown *)obj, &IID_IInspectable, (void **)&inspectable );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IInspectable_GetRuntimeClassName( inspectable, &str );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    ok_(__FILE__, line)( !wcscmp( WindowsGetStringRawBuffer( str, NULL ), name ), "got class %s.\n",
+                         debugstr_hstring( str ) );
+    WindowsDeleteString( str );
+    IInspectable_Release( inspectable );
+}
+
+static void pump_messages( DWORD ms )
+{
+    DWORD end = GetTickCount() + ms;
+    MSG msg;
+
+    while ((int)(end - GetTickCount()) > 0)
+    {
+        while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE )) DispatchMessageW( &msg );
+        MsgWaitForMultipleObjects( 0, NULL, FALSE, 10, QS_ALLINPUT );
+    }
+}
+
+static IDispatcherQueueController *create_queue( DISPATCHERQUEUE_THREAD_APARTMENTTYPE apartment_type )
+{
+    struct DispatcherQueueOptions options = {sizeof(options), DQTYPE_THREAD_CURRENT, apartment_type};
+    IDispatcherQueueController *controller = NULL;
+    HRESULT hr;
+
+    hr = CreateDispatcherQueueController( options, &controller );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    return controller;
+}
+
+/* the ways a thread can be when it asks for a compositor */
+static void check_activation( const char *what, HRESULT expected )
+{
+    IActivationFactory *factory = NULL;
+    IInspectable *inspectable = NULL;
+    HSTRING str;
+    HRESULT hr;
+
+    str = hstring( L"Windows.UI.Composition.Core.CompositorController" );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "%s: got hr %#lx.\n", what, hr );
+    if (factory)
+    {
+        hr = IActivationFactory_ActivateInstance( factory, &inspectable );
+        ok( hr == expected, "%s: got hr %#lx.\n", what, hr );
+        if (inspectable) IInspectable_Release( inspectable );
+        IActivationFactory_Release( factory );
+    }
+
+    str = hstring( L"Windows.UI.Composition.Compositor" );
+    inspectable = NULL;
+    hr = RoActivateInstance( str, &inspectable );
+    WindowsDeleteString( str );
+    ok( hr == expected, "%s: got hr %#lx.\n", what, hr );
+    if (inspectable) IInspectable_Release( inspectable );
+}
+
+static DWORD WINAPI mta_thread( void *arg )
+{
+    RoInitialize( RO_INIT_MULTITHREADED );
+    check_activation( "mta", E_ACCESSDENIED );
+    RoUninitialize();
+    return 0;
+}
+
+static DWORD WINAPI sta_thread( void *arg )
+{
+    IDispatcherQueueController *controller;
+
+    RoInitialize( RO_INIT_SINGLETHREADED );
+    check_activation( "sta", E_ACCESSDENIED );
+    controller = create_queue( DQTAT_COM_STA );
+    check_activation( "sta with a dispatcher queue", S_OK );
+    if (controller) IDispatcherQueueController_Release( controller );
+    RoUninitialize();
+    return 0;
+}
+
+static void test_activation(void)
+{
+    HANDLE thread;
+
+    thread = CreateThread( NULL, 0, mta_thread, NULL, 0, NULL );
+    WaitForSingleObject( thread, INFINITE );
+    CloseHandle( thread );
+    thread = CreateThread( NULL, 0, sta_thread, NULL, 0, NULL );
+    WaitForSingleObject( thread, INFINITE );
+    CloseHandle( thread );
+}
+
+/*** CommitNeeded ***/
+
+struct commit_needed
+{
+    ITypedEventHandler_CompositorController_IInspectable ITypedEventHandler_CompositorController_IInspectable_iface;
+    LONG count;
+    DWORD thread_id;
+};
+
+static struct commit_needed *impl_from_ITypedEventHandler_CompositorController_IInspectable( ITypedEventHandler_CompositorController_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct commit_needed, ITypedEventHandler_CompositorController_IInspectable_iface );
+}
+
+static HRESULT WINAPI commit_needed_QueryInterface( ITypedEventHandler_CompositorController_IInspectable *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ITypedEventHandler_CompositorController_IInspectable ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI commit_needed_AddRef( ITypedEventHandler_CompositorController_IInspectable *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI commit_needed_Release( ITypedEventHandler_CompositorController_IInspectable *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI commit_needed_Invoke( ITypedEventHandler_CompositorController_IInspectable *iface,
+                                            ICompositorController *sender, IInspectable *args )
+{
+    struct commit_needed *handler = impl_from_ITypedEventHandler_CompositorController_IInspectable( iface );
+
+    ok( !args, "got args %p.\n", args );
+    ok( GetCurrentThreadId() == handler->thread_id, "raised on thread %#lx.\n", GetCurrentThreadId() );
+    handler->count++;
+    return S_OK;
+}
+
+static const ITypedEventHandler_CompositorController_IInspectableVtbl commit_needed_vtbl =
+{
+    commit_needed_QueryInterface,
+    commit_needed_AddRef,
+    commit_needed_Release,
+    commit_needed_Invoke,
+};
+
+/*** the tests ***/
+
+static ICompositorController *create_controller( ICompositor **compositor )
+{
+    ICompositorController *controller = NULL;
+    IInspectable *inspectable;
+    HSTRING str;
+    HRESULT hr;
+
+    str = hstring( L"Windows.UI.Composition.Core.CompositorController" );
+    hr = RoActivateInstance( str, &inspectable );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return NULL;
+    IInspectable_QueryInterface( inspectable, &IID_ICompositorController, (void **)&controller );
+    IInspectable_Release( inspectable );
+    hr = ICompositorController_get_Compositor( controller, compositor );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    return controller;
+}
+
+static LRESULT CALLBACK wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static HWND create_window(void)
+{
+    WNDCLASSW cls = {0};
+
+    cls.lpfnWndProc = wndproc;
+    cls.hInstance = GetModuleHandleW( NULL );
+    cls.lpszClassName = L"dcomp_composition_test";
+    cls.hbrBackground = GetStockObject( WHITE_BRUSH );
+    RegisterClassW( &cls );
+    return CreateWindowExW( WS_EX_NOREDIRECTIONBITMAP, L"dcomp_composition_test", L"test", WS_POPUP | WS_VISIBLE,
+                            100, 100, 300, 200, NULL, NULL, NULL, NULL );
+}
+
+#define check_pixels( hwnd, expected ) check_pixels_( __LINE__, hwnd, expected )
+static void check_pixels_( unsigned int line, HWND hwnd, const DWORD *expected )
+{
+    static const POINT points[] = {{5, 5}, {15, 15}, {60, 60}, {105, 105}, {115, 115}, {200, 150}};
+    HDC hdc = GetDC( hwnd ), mem = CreateCompatibleDC( hdc );
+    HBITMAP bitmap = CreateCompatibleBitmap( hdc, 300, 200 );
+    unsigned int i;
+    BOOL ret;
+
+    SelectObject( mem, bitmap );
+    ret = PrintWindow( hwnd, mem, 2 /* PW_RENDERFULLCONTENT */ );
+    ok_(__FILE__, line)( ret, "PrintWindow failed.\n" );
+    for (i = 0; i < ARRAY_SIZE(points); i++)
+    {
+        COLORREF colour = GetPixel( mem, points[i].x, points[i].y );
+        /* what is composed is not what PrintWindow reads here */
+        todo_wine_if( expected[i] != 0xffffff )
+        ok_(__FILE__, line)( colour == expected[i], "pixel (%ld,%ld): got %06lx.\n", points[i].x, points[i].y, colour );
+    }
+    DeleteObject( bitmap );
+    DeleteDC( mem );
+    ReleaseDC( hwnd, hdc );
+}
