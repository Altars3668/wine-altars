+static inline struct drawing_surface *impl_from_surface_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct drawing_surface, base );
+}
+
+static HRESULT surface_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct drawing_surface *surface = impl_from_surface_object( object );
+
+    if (IsEqualGUID( iid, &IID_ICompositionSurface )) *out = &surface->ICompositionSurface_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionDrawingSurface )) *out = &surface->ICompositionDrawingSurface_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionDrawingSurface2 )) *out = &surface->ICompositionDrawingSurface2_iface;
+    else if (surface->is_virtual && IsEqualGUID( iid, &IID_ICompositionVirtualDrawingSurface ))
+        *out = &surface->ICompositionVirtualDrawingSurface_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionDrawingSurfaceInterop ) ||
+             IsEqualGUID( iid, &IID_ICompositionDrawingSurfaceInterop2 ))
+        *out = &surface->ICompositionDrawingSurfaceInterop2_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void surface_close( struct object *object )
+{
+    struct drawing_surface *surface = impl_from_surface_object( object );
+
+    if (surface->drawing)
+    {
+        if (surface->target && !surface->suspended) surface_end_target( surface );
+        if (surface->device->drawing == surface) surface->device->drawing = NULL;
+        surface->drawing = FALSE;
+    }
+    if (surface->target) ID2D1Bitmap1_Release( surface->target );
+    surface->target = NULL;
+    surface_drop_tiles( surface );
+    if (surface->scratch) ID3D11Texture2D_Release( surface->scratch );
+    surface->scratch = NULL;
+}
+
+static void surface_destroy( struct object *object )
+{
+    struct drawing_surface *surface = impl_from_surface_object( object );
+
+    compositor_lock( surface->base.compositor );
+    list_remove( &surface->device_entry );
+    compositor_unlock( surface->base.compositor );
+    ICompositionGraphicsDevice_Release( &surface->device->ICompositionGraphicsDevice_iface );
+    free( surface );
+}
