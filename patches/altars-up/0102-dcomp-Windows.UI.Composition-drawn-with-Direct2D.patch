diff --git a/dlls/dcomp/clip.c b/dlls/dcomp/clip.c
new file mode 100644
index 00000000000..d013a2ea4bf
--- /dev/null
+++ b/dlls/dcomp/clip.c
@@ -0,0 +1,880 @@
+/*
+ * Windows.UI.Composition clips: InsetClip and RectangleClip
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+enum clip_kind
+{
+    CLIP_INSET,
+    CLIP_RECTANGLE,
+};
+
+struct clip_state
+{
+    Vector2 anchor_point;
+    Vector2 center_point;
+    Vector2 offset;
+    FLOAT rotation_angle;
+    Vector2 scale;
+    Matrix3x2 transform_matrix;
+    /* the insets of an inset clip, the sides of a rectangle clip */
+    FLOAT left, top, right, bottom;
+    Vector2 radius[4];      /* top left, top right, bottom right, bottom left */
+};
+
+struct clip
+{
+    struct object base;
+    ICompositionClip ICompositionClip_iface;
+    ICompositionClip2 ICompositionClip2_iface;
+    IInsetClip IInsetClip_iface;
+    IRectangleClip IRectangleClip_iface;
+    enum clip_kind kind;
+    struct clip_state props;    /* as they were set */
+};
+
+static inline struct clip *impl_from_clip_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct clip, base );
+}
+
+static HRESULT clip_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct clip *clip = impl_from_clip_object( object );
+
+    if (IsEqualGUID( iid, &IID_ICompositionClip )) *out = &clip->ICompositionClip_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionClip2 )) *out = &clip->ICompositionClip2_iface;
+    else if (clip->kind == CLIP_INSET && IsEqualGUID( iid, &IID_IInsetClip )) *out = &clip->IInsetClip_iface;
+    else if (clip->kind == CLIP_RECTANGLE && IsEqualGUID( iid, &IID_IRectangleClip )) *out = &clip->IRectangleClip_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void clip_destroy( struct object *object )
+{
+    free( impl_from_clip_object( object ) );
+}
+
+#define CLIP_PROPERTIES \
+    { L"AnchorPoint", VALUE_VECTOR2, offsetof(struct clip_state, anchor_point) }, \
+    { L"CenterPoint", VALUE_VECTOR2, offsetof(struct clip_state, center_point) }, \
+    { L"Offset", VALUE_VECTOR2, offsetof(struct clip_state, offset) }, \
+    { L"RotationAngle", VALUE_SCALAR, offsetof(struct clip_state, rotation_angle) }, \
+    { L"Scale", VALUE_VECTOR2, offsetof(struct clip_state, scale) }, \
+    { L"TransformMatrix", VALUE_MATRIX3X2, offsetof(struct clip_state, transform_matrix) }
+
+static const struct property_desc inset_clip_properties[] =
+{
+    CLIP_PROPERTIES,
+    { L"LeftInset", VALUE_SCALAR, offsetof(struct clip_state, left) },
+    { L"TopInset", VALUE_SCALAR, offsetof(struct clip_state, top) },
+    { L"RightInset", VALUE_SCALAR, offsetof(struct clip_state, right) },
+    { L"BottomInset", VALUE_SCALAR, offsetof(struct clip_state, bottom) },
+    { NULL }
+};
+
+static const struct property_desc rectangle_clip_properties[] =
+{
+    CLIP_PROPERTIES,
+    { L"Left", VALUE_SCALAR, offsetof(struct clip_state, left) },
+    { L"Top", VALUE_SCALAR, offsetof(struct clip_state, top) },
+    { L"Right", VALUE_SCALAR, offsetof(struct clip_state, right) },
+    { L"Bottom", VALUE_SCALAR, offsetof(struct clip_state, bottom) },
+    { L"TopLeftRadius", VALUE_VECTOR2, offsetof(struct clip_state, radius[0]) },
+    { L"TopRightRadius", VALUE_VECTOR2, offsetof(struct clip_state, radius[1]) },
+    { L"BottomRightRadius", VALUE_VECTOR2, offsetof(struct clip_state, radius[2]) },
+    { L"BottomLeftRadius", VALUE_VECTOR2, offsetof(struct clip_state, radius[3]) },
+    { NULL }
+};
+
+static const struct property_desc *clip_properties( const struct clip *clip )
+{
+    return clip->kind == CLIP_INSET ? inset_clip_properties : rectangle_clip_properties;
+}
+
+static BOOL clip_get_property( struct object *object, const WCHAR *name, struct value *value )
+{
+    struct clip *clip = impl_from_clip_object( object );
+    const struct property_desc *desc;
+
+    if (!wcsicmp( name, L"RotationAngleInDegrees" ))
+        return value_scalar( value, clip->props.rotation_angle * 180.0f / 3.14159265358979f );
+    if (!(desc = property_find( clip_properties( clip ), name ))) return FALSE;
+    return property_get( desc, &clip->props, value );
+}
+
+static BOOL clip_set_property( struct object *object, const WCHAR *name, const struct value *value )
+{
+    struct clip *clip = impl_from_clip_object( object );
+    const struct property_desc *desc;
+    float f;
+
+    if (!wcsicmp( name, L"RotationAngleInDegrees" ))
+    {
+        if (!value_get_scalar( value, &f )) return FALSE;
+        clip->props.rotation_angle = f * 3.14159265358979f / 180.0f;
+        return TRUE;
+    }
+    if (!(desc = property_find( clip_properties( clip ), name ))) return FALSE;
+    return property_set( desc, &clip->props, value );
+}
+
+static void clip_get_state( struct clip *clip, struct clip_state *state )
+{
+    const struct property_desc *desc;
+    struct value value;
+    float f;
+
+    *state = clip->props;
+    if (list_empty( &clip->base.animations )) return;
+    for (desc = clip_properties( clip ); desc->name; desc++)
+    {
+        property_get( desc, state, &value );
+        if (object_animate( &clip->base, desc->name, &value, 0 )) property_set( desc, state, &value );
+    }
+    value_scalar( &value, state->rotation_angle * 180.0f / 3.14159265358979f );
+    if (object_animate( &clip->base, L"RotationAngleInDegrees", &value, 0 ) && value_get_scalar( &value, &f ))
+        state->rotation_angle = f * 3.14159265358979f / 180.0f;
+}
+
+static const struct object_ops inset_clip_ops =
+{
+    L"Windows.UI.Composition.InsetClip",
+    clip_query_interface,
+    clip_destroy,
+    NULL,
+    clip_get_property,
+    clip_set_property,
+};
+
+static const struct object_ops rectangle_clip_ops =
+{
+    L"Windows.UI.Composition.RectangleClip",
+    clip_query_interface,
+    clip_destroy,
+    NULL,
+    clip_get_property,
+    clip_set_property,
+};
