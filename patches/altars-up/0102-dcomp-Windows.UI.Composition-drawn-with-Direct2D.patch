+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/*
+ * The language is C's expressions over scalars, vectors, quaternions,
+ * matrices, colors and booleans, with member access into the objects an
+ * animation was given as reference parameters and into "this", and the
+ * functions Windows documents.  Names are not case sensitive.  An expression
+ * is parsed once, into a tree evaluated every frame.
+ */
+
+enum node_kind
+{
+    NODE_NUMBER,
+    NODE_BOOLEAN,
+    NODE_IDENTIFIER,
+    NODE_MEMBER,
+    NODE_CALL,
+    NODE_UNARY,
+    NODE_BINARY,
+    NODE_CONDITIONAL,
+};
+
+enum op
+{
+    OP_ADD = 1, OP_SUB, OP_MUL, OP_DIV, OP_MOD,
+    OP_LT, OP_GT, OP_LE, OP_GE, OP_EQ, OP_NE,
+    OP_AND, OP_OR, OP_NOT, OP_NEG,
+};
+
+struct node
+{
+    enum node_kind kind;
+    enum op op;
+    WCHAR *name;            /* an identifier, a member, or a function's full dotted name */
+    float number;
+    struct node *left, *right, *third;
+    struct node **args;
+    unsigned int arg_count;
+};
+
+struct expression
+{
+    struct node *root;
+};
+
+/*** values ***/
+
+static unsigned int value_components( enum value_type type )
+{
+    switch (type)
+    {
+    case VALUE_BOOLEAN:
+    case VALUE_SCALAR: return 1;
+    case VALUE_VECTOR2: return 2;
+    case VALUE_VECTOR3: return 3;
+    case VALUE_VECTOR4:
+    case VALUE_QUATERNION:
+    case VALUE_COLOR: return 4;
+    case VALUE_MATRIX3X2: return 6;
+    case VALUE_MATRIX4X4: return 16;
+    default: return 0;
+    }
+}
+
+static BOOL is_numeric( enum value_type type )
+{
+    return type >= VALUE_SCALAR && type <= VALUE_MATRIX4X4;
+}
+
+static BOOL is_vector( enum value_type type )
+{
+    return type == VALUE_VECTOR2 || type == VALUE_VECTOR3 || type == VALUE_VECTOR4;
+}
+
+static void value_set( struct value *value, enum value_type type, const float *f )
+{
+    memset( value, 0, sizeof(*value) );
+    value->type = type;
+    if (f) memcpy( value->f, f, value_components( type ) * sizeof(float) );
+}
+
+static BOOL value_truth( const struct value *value, BOOL *truth )
+{
+    if (value->type == VALUE_BOOLEAN || value->type == VALUE_SCALAR)
+    {
+        *truth = value->f[0] != 0.0f;
+        return TRUE;
+    }
+    return FALSE;
+}
+
+const char *debugstr_value( const struct value *value )
+{
+    switch (value->type)
+    {
+    case VALUE_BOOLEAN: return value->f[0] ? "true" : "false";
+    case VALUE_SCALAR: return wine_dbg_sprintf( "%g", value->f[0] );
+    case VALUE_VECTOR2: return wine_dbg_sprintf( "(%g,%g)", value->f[0], value->f[1] );
+    case VALUE_VECTOR3: return wine_dbg_sprintf( "(%g,%g,%g)", value->f[0], value->f[1], value->f[2] );
+    case VALUE_VECTOR4: return wine_dbg_sprintf( "(%g,%g,%g,%g)", value->f[0], value->f[1], value->f[2], value->f[3] );
+    case VALUE_QUATERNION: return wine_dbg_sprintf( "q(%g,%g,%g,%g)", value->f[0], value->f[1], value->f[2], value->f[3] );
+    case VALUE_COLOR: return wine_dbg_sprintf( "#%02x%02x%02x%02x", (int)value->f[0], (int)value->f[1],
+                                               (int)value->f[2], (int)value->f[3] );
+    case VALUE_MATRIX3X2: return wine_dbg_sprintf( "m3x2(%g,%g,%g,%g,%g,%g)", value->f[0], value->f[1], value->f[2],
+                                                   value->f[3], value->f[4], value->f[5] );
+    case VALUE_MATRIX4X4: return "m4x4";
+    case VALUE_OBJECT: return wine_dbg_sprintf( "object %p", value->object );
+    case VALUE_THIS: return "this";
+    default: return "none";
+    }
+}
+
+/*** parsing ***/
+
+struct parser
+{
+    const WCHAR *text;
+    const WCHAR *pos;
+    BOOL failed;
+};
+
+static void node_free( struct node *node )
+{
+    unsigned int i;
+
+    if (!node) return;
+    free( node->name );
+    node_free( node->left );
+    node_free( node->right );
+    node_free( node->third );
+    for (i = 0; i < node->arg_count; i++) node_free( node->args[i] );
+    free( node->args );
+    free( node );
+}
+
+static struct node *node_create( struct parser *parser, enum node_kind kind )
+{
+    struct node *node;
+
+    if (!(node = calloc( 1, sizeof(*node) ))) parser->failed = TRUE;
+    else node->kind = kind;
+    return node;
+}
+
+static void skip_spaces( struct parser *parser )
+{
+    while (*parser->pos == ' ' || *parser->pos == '\t' || *parser->pos == '\r' || *parser->pos == '\n') parser->pos++;
+}
+
+static BOOL accept( struct parser *parser, const WCHAR *token )
+{
+    size_t len = wcslen( token );
+
+    skip_spaces( parser );
+    if (wcsncmp( parser->pos, token, len )) return FALSE;
+    parser->pos += len;
+    return TRUE;
+}
+
+static BOOL is_name_start( WCHAR c )
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_';
+}
+
+static BOOL is_name_char( WCHAR c )
+{
+    return is_name_start( c ) || (c >= '0' && c <= '9');
+}
+
+static WCHAR *parse_name( struct parser *parser )
+{
+    const WCHAR *start;
+    WCHAR *name;
+
+    skip_spaces( parser );
+    if (!is_name_start( *parser->pos )) return NULL;
+    start = parser->pos;
+    while (is_name_char( *parser->pos )) parser->pos++;
+    if (!(name = malloc( (parser->pos - start + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( name, start, (parser->pos - start) * sizeof(WCHAR) );
+    name[parser->pos - start] = 0;
+    return name;
+}
+
+static struct node *parse_expression( struct parser *parser );
+
+static struct node *parse_primary( struct parser *parser )
+{
+    struct node *node;
+    WCHAR *name;
+
+    skip_spaces( parser );
+    if ((*parser->pos >= '0' && *parser->pos <= '9') || (*parser->pos == '.' && parser->pos[1] >= '0' && parser->pos[1] <= '9'))
+    {
+        WCHAR *end;
+        double number = wcstod( parser->pos, &end );
+
+        if (end == parser->pos) goto fail;
+        parser->pos = end;
+        /* a C float suffix is taken too */
+        if (*parser->pos == 'f' || *parser->pos == 'F') parser->pos++;
+        if (!(node = node_create( parser, NODE_NUMBER ))) return NULL;
+        node->number = number;
+        return node;
+    }
+    if (accept( parser, L"(" ))
+    {
+        node = parse_expression( parser );
+        if (!accept( parser, L")" ))
+        {
+            node_free( node );
+            goto fail;
+        }
+        return node;
+    }
+    if ((name = parse_name( parser )))
+    {
+        if (!wcsicmp( name, L"true" ) || !wcsicmp( name, L"false" ))
+        {
+            BOOL truth = !wcsicmp( name, L"true" );
+            free( name );
+            if (!(node = node_create( parser, NODE_BOOLEAN ))) return NULL;
+            node->number = truth;
+            return node;
+        }
+        if (!(node = node_create( parser, NODE_IDENTIFIER )))
+        {
+            free( name );
+            return NULL;
+        }
+        node->name = name;
+        return node;
+    }
+
+fail:
+    parser->failed = TRUE;
+    return NULL;
+}
+
+/* the dotted name a call is made through, as in Matrix4x4.CreateFromTranslation */
+static WCHAR *callee_name( const struct node *node )
+{
+    WCHAR *left, *name;
+
+    if (node->kind == NODE_IDENTIFIER) return wcsdup( node->name );
+    if (node->kind != NODE_MEMBER || !(left = callee_name( node->left ))) return NULL;
+    if ((name = malloc( (wcslen( left ) + wcslen( node->name ) + 2) * sizeof(WCHAR) )))
+    {
+        wcscpy( name, left );
+        wcscat( name, L"." );
+        wcscat( name, node->name );
+    }
+    free( left );
+    return name;
+}
+
+static struct node *parse_postfix( struct parser *parser )
+{
+    struct node *node = parse_primary( parser ), *next;
+
+    while (node && !parser->failed)
+    {
+        if (accept( parser, L"." ))
+        {
+            WCHAR *name;
+
+            skip_spaces( parser );
+            /* a matrix's members are _11 and the like */
+            if (!(name = parse_name( parser ))) break;
+            if (!(next = node_create( parser, NODE_MEMBER )))
+            {
+                free( name );
+                break;
+            }
+            next->name = name;
+            next->left = node;
+            node = next;
+        }
+        else if (accept( parser, L"(" ))
+        {
+            struct node **args;
+
+            if (!(next = node_create( parser, NODE_CALL ))) break;
+            if (!(next->name = callee_name( node )))
+            {
+                node_free( next );
+                parser->failed = TRUE;
+                break;
+            }
+            node_free( node );
+            node = next;
+            if (accept( parser, L")" )) continue;
+            do
+            {
+                struct node *arg = parse_expression( parser );
+                if (!arg) break;
+                if (!(args = realloc( node->args, (node->arg_count + 1) * sizeof(*args) )))
+                {
+                    node_free( arg );
+                    parser->failed = TRUE;
+                    break;
+                }
+                node->args = args;
+                node->args[node->arg_count++] = arg;
+            } while (accept( parser, L"," ));
+            if (!accept( parser, L")" )) parser->failed = TRUE;
+        }
+        else break;
+    }
+    if (parser->failed)
+    {
+        node_free( node );
+        return NULL;
+    }
+    return node;
+}
+
+static struct node *parse_unary( struct parser *parser )
+{
+    struct node *node;
+    enum op op;
+
+    skip_spaces( parser );
+    if (*parser->pos == '-' ) op = OP_NEG;
+    else if (*parser->pos == '!' && parser->pos[1] != '=') op = OP_NOT;
+    else if (*parser->pos == '+')
+    {
+        parser->pos++;
+        return parse_unary( parser );
+    }
+    else return parse_postfix( parser );
+
+    parser->pos++;
+    if (!(node = node_create( parser, NODE_UNARY ))) return NULL;
+    node->op = op;
+    if (!(node->left = parse_unary( parser )))
+    {
+        node_free( node );
+        return NULL;
+    }
+    return node;
+}
+
+static const struct
+{
+    const WCHAR *token;
+    enum op op;
+    int precedence;
+}
+binary_ops[] =
+{
+    /* the longer tokens are tried first */
+    { L"||", OP_OR, 1 },
+    { L"&&", OP_AND, 2 },
+    { L"==", OP_EQ, 3 },
+    { L"!=", OP_NE, 3 },
+    { L"<=", OP_LE, 4 },
+    { L">=", OP_GE, 4 },
+    { L"<", OP_LT, 4 },
+    { L">", OP_GT, 4 },
+    { L"+", OP_ADD, 5 },
+    { L"-", OP_SUB, 5 },
+    { L"*", OP_MUL, 6 },
+    { L"/", OP_DIV, 6 },
+    { L"%", OP_MOD, 6 },
+};
+
+static struct node *parse_binary( struct parser *parser, int min_precedence )
+{
+    struct node *left = parse_unary( parser ), *node;
+    unsigned int i;
+
+    while (left && !parser->failed)
+    {
+        skip_spaces( parser );
+        for (i = 0; i < ARRAY_SIZE(binary_ops); i++)
+            if (!wcsncmp( parser->pos, binary_ops[i].token, wcslen( binary_ops[i].token ) )) break;
+        if (i == ARRAY_SIZE(binary_ops) || binary_ops[i].precedence < min_precedence) break;
+        parser->pos += wcslen( binary_ops[i].token );
+        if (!(node = node_create( parser, NODE_BINARY ))) break;
+        node->op = binary_ops[i].op;
+        node->left = left;
+        left = node;
+        if (!(node->right = parse_binary( parser, binary_ops[i].precedence + 1 ))) parser->failed = TRUE;
+    }
+    if (parser->failed)
+    {
+        node_free( left );
+        return NULL;
+    }
+    return left;
+}
+
+static struct node *parse_expression( struct parser *parser )
+{
+    struct node *node = parse_binary( parser, 1 ), *conditional;
+
+    if (!node || !accept( parser, L"?" )) return node;
+    if (!(conditional = node_create( parser, NODE_CONDITIONAL )))
+    {
+        node_free( node );
+        return NULL;
+    }
+    conditional->left = node;
+    if (!(conditional->right = parse_expression( parser )) || !accept( parser, L":" ) ||
+        !(conditional->third = parse_expression( parser )))
+    {
+        parser->failed = TRUE;
+        node_free( conditional );
+        return NULL;
+    }
+    return conditional;
+}
+
+HRESULT expression_parse( const WCHAR *text, struct expression **out )
+{
+    struct parser parser = {text, text};
+    struct expression *expression;
+    struct node *root;
+
+    *out = NULL;
+    if (!text) return E_INVALIDARG;
+    root = parse_expression( &parser );
+    skip_spaces( &parser );
+    if (!root || parser.failed || *parser.pos)
+    {
+        WARN( "failed to parse %s at %s.\n", debugstr_w( text ), debugstr_w( parser.pos ) );
+        node_free( root );
+        return E_INVALIDARG;
+    }
+    if (!(expression = calloc( 1, sizeof(*expression) )))
+    {
+        node_free( root );
+        return E_OUTOFMEMORY;
+    }
+    expression->root = root;
+    *out = expression;
+    return S_OK;
+}
+
+void expression_free( struct expression *expression )
+{
+    if (!expression) return;
+    node_free( expression->root );
+    free( expression );
+}
+
+/*** evaluation ***/
+
+static BOOL evaluate( const struct node *node, const struct eval_context *context, struct value *out );
+
+/* vectors take their members as swizzles: x, y, z, w, in any order and up to four of them */
+static BOOL swizzle( const struct value *value, const WCHAR *name, struct value *out )
+{
+    unsigned int count = value_components( value->type ), len = wcslen( name ), i;
+    float f[4];
+
+    if (value->type == VALUE_MATRIX3X2 || value->type == VALUE_MATRIX4X4)
+    {
+        /* _11, _12 ... of a matrix, several at once too */
+        unsigned int columns = value->type == VALUE_MATRIX3X2 ? 2 : 4, n = 0;
+
+        if (len % 3) return FALSE;
+        for (i = 0; i < len; i += 3)
+        {
+            int row = name[i + 1] - '1', column = name[i + 2] - '1';
+            if (name[i] != '_' || n == 4 || row < 0 || column < 0 || column >= columns || row * columns + column >= count)
+                return FALSE;
+            f[n++] = value->f[row * columns + column];
+        }
+        value_set( out, n == 1 ? VALUE_SCALAR : VALUE_VECTOR2 + n - 2, f );
+        return TRUE;
+    }
+    if (value->type == VALUE_COLOR && len == 1)
+    {
+        static const WCHAR names[] = L"ARGB";
+        const WCHAR *c = wcschr( names, towupper( name[0] ) );
+        if (!c) return FALSE;
+        value_set( out, VALUE_SCALAR, &value->f[c - names] );
+        return TRUE;
+    }
+    /* a scalar has no members */
+    if (count < 2 || count > 4 || len > 4) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        WCHAR c = towlower( name[i] );
+        unsigned int index = c == 'w' ? 3 : c - 'x';
+
+        if (index >= count || (c < 'w' || c > 'z')) return FALSE;
+        f[i] = value->f[index];
+    }
+    value_set( out, len == 1 ? VALUE_SCALAR : VALUE_VECTOR2 + len - 2, f );
+    return TRUE;
+}
+
+static BOOL evaluate_member( const struct node *node, const struct eval_context *context, struct value *out )
+{
+    struct value left;
+
+    if (!evaluate( node->left, context, &left )) return FALSE;
+
+    if (left.type == VALUE_THIS)
+    {
+        if (!wcsicmp( node->name, L"StartingValue" )) *out = context->starting;
+        else if (!wcsicmp( node->name, L"CurrentValue" )) *out = context->current;
+        else if (!wcsicmp( node->name, L"FinalValue" )) *out = context->final;
+        else if (!wcsicmp( node->name, L"Target" ))
+        {
+            if (!context->target) return FALSE;
+            value_set( out, VALUE_OBJECT, NULL );
+            out->object = context->target;
+        }
+        else return FALSE;
+        return out->type != VALUE_NONE;
+    }
+    if (left.type == VALUE_OBJECT) return object_get_value( left.object, node->name, out, context->depth + 1 );
+    return swizzle( &left, node->name, out );
+}
+
+static BOOL evaluate_identifier( const struct node *node, const struct eval_context *context, struct value *out )
+{
+    if (!wcsicmp( node->name, L"this" ))
+    {
+        value_set( out, VALUE_THIS, NULL );
+        return TRUE;
+    }
+    if (!wcsicmp( node->name, L"Pi" ))
+    {
+        float pi = M_PI;
+        value_set( out, VALUE_SCALAR, &pi );
+        return TRUE;
+    }
+    if (context->lookup && context->lookup( context->lookup_data, node->name, out )) return TRUE;
+    WARN( "no parameter %s.\n", debugstr_w( node->name ) );
+    return FALSE;
+}
+
+static void matrix3x2_multiply( const float *a, const float *b, float *r )
+{
+    float t[6];
+    t[0] = a[0] * b[0] + a[1] * b[2];
+    t[1] = a[0] * b[1] + a[1] * b[3];
+    t[2] = a[2] * b[0] + a[3] * b[2];
+    t[3] = a[2] * b[1] + a[3] * b[3];
+    t[4] = a[4] * b[0] + a[5] * b[2] + b[4];
+    t[5] = a[4] * b[1] + a[5] * b[3] + b[5];
+    memcpy( r, t, sizeof(t) );
+}
+
+static void matrix4x4_multiply( const float *a, const float *b, float *r )
+{
+    float t[16];
+    int i, j, k;
+
+    for (i = 0; i < 4; i++)
+        for (j = 0; j < 4; j++)
+        {
+            t[i * 4 + j] = 0.0f;
+            for (k = 0; k < 4; k++) t[i * 4 + j] += a[i * 4 + k] * b[k * 4 + j];
+        }
+    memcpy( r, t, sizeof(t) );
+}
+
+static void quaternion_multiply( const float *a, const float *b, float *r )
+{
+    /* as System.Numerics has it: a * b */
+    float t[4];
+    t[0] = a[3] * b[0] + a[0] * b[3] + a[1] * b[2] - a[2] * b[1];
+    t[1] = a[3] * b[1] - a[0] * b[2] + a[1] * b[3] + a[2] * b[0];
+    t[2] = a[3] * b[2] + a[0] * b[1] - a[1] * b[0] + a[2] * b[3];
+    t[3] = a[3] * b[3] - a[0] * b[0] - a[1] * b[1] - a[2] * b[2];
+    memcpy( r, t, sizeof(t) );
+}
+
+static float apply_op( enum op op, float a, float b )
+{
+    switch (op)
+    {
+    case OP_ADD: return a + b;
+    case OP_SUB: return a - b;
+    case OP_MUL: return a * b;
+    case OP_DIV: return a / b;
+    case OP_MOD: return fmodf( a, b );
+    default: return 0.0f;
+    }
+}
+
+static BOOL evaluate_arithmetic( enum op op, const struct value *a, const struct value *b, struct value *out )
+{
+    unsigned int i, count;
+
+    if (!is_numeric( a->type ) || !is_numeric( b->type )) return FALSE;
+
+    if (a->type == b->type)
+    {
+        if (op == OP_MUL && a->type == VALUE_MATRIX3X2)
+        {
+            value_set( out, VALUE_MATRIX3X2, NULL );
+            matrix3x2_multiply( a->f, b->f, out->f );
+            return TRUE;
+        }
+        if (op == OP_MUL && a->type == VALUE_MATRIX4X4)
+        {
+            value_set( out, VALUE_MATRIX4X4, NULL );
+            matrix4x4_multiply( a->f, b->f, out->f );
+            return TRUE;
+        }
+        if (op == OP_MUL && a->type == VALUE_QUATERNION)
+        {
+            value_set( out, VALUE_QUATERNION, NULL );
+            quaternion_multiply( a->f, b->f, out->f );
+            return TRUE;
+        }
+        count = value_components( a->type );
+        value_set( out, a->type, NULL );
+        for (i = 0; i < count; i++) out->f[i] = apply_op( op, a->f[i], b->f[i] );
+        return TRUE;
+    }
+    /* a scalar goes with every component of the other */
+    if (b->type == VALUE_SCALAR)
+    {
+        count = value_components( a->type );
+        value_set( out, a->type, NULL );
+        for (i = 0; i < count; i++) out->f[i] = apply_op( op, a->f[i], b->f[0] );
+        return TRUE;
+    }
+    if (a->type == VALUE_SCALAR && (op == OP_MUL || op == OP_ADD || op == OP_SUB || op == OP_DIV))
+    {
+        count = value_components( b->type );
+        value_set( out, b->type, NULL );
+        for (i = 0; i < count; i++) out->f[i] = apply_op( op, a->f[0], b->f[i] );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL evaluate_binary( const struct node *node, const struct eval_context *context, struct value *out )
+{
+    struct value a, b;
+    BOOL ta, tb;
+    float f;
+
+    if (!evaluate( node->left, context, &a )) return FALSE;
+
+    if (node->op == OP_AND || node->op == OP_OR)
+    {
+        if (!value_truth( &a, &ta )) return FALSE;
+        if (node->op == OP_AND && !ta) goto done_false;
+        if (node->op == OP_OR && ta) goto done_true;
+        if (!evaluate( node->right, context, &b ) || !value_truth( &b, &tb )) return FALSE;
+        f = tb;
+        value_set( out, VALUE_BOOLEAN, &f );
+        return TRUE;
+    }
+
+    if (!evaluate( node->right, context, &b )) return FALSE;
+
+    switch (node->op)
+    {
+    case OP_ADD: case OP_SUB: case OP_MUL: case OP_DIV: case OP_MOD:
+        return evaluate_arithmetic( node->op, &a, &b, out );
+    case OP_LT: case OP_GT: case OP_LE: case OP_GE:
+        if (a.type != VALUE_SCALAR || b.type != VALUE_SCALAR) return FALSE;
+        switch (node->op)
+        {
+        case OP_LT: f = a.f[0] < b.f[0]; break;
+        case OP_GT: f = a.f[0] > b.f[0]; break;
+        case OP_LE: f = a.f[0] <= b.f[0]; break;
+        default: f = a.f[0] >= b.f[0]; break;
+        }
+        value_set( out, VALUE_BOOLEAN, &f );
+        return TRUE;
+    case OP_EQ: case OP_NE:
+    {
+        unsigned int i, count;
+        BOOL equal;
+
+        /* a boolean compares with a scalar as 0 or 1 */
+        if (a.type == VALUE_BOOLEAN) a.type = VALUE_SCALAR;
+        if (b.type == VALUE_BOOLEAN) b.type = VALUE_SCALAR;
+        if (a.type != b.type) return FALSE;
+        count = value_components( a.type );
+        for (i = 0, equal = TRUE; i < count; i++) if (a.f[i] != b.f[i]) equal = FALSE;
+        f = node->op == OP_EQ ? equal : !equal;
+        value_set( out, VALUE_BOOLEAN, &f );
+        return TRUE;
+    }
+    default:
+        return FALSE;
+    }
+
+done_true:
+    f = 1.0f;
+    value_set( out, VALUE_BOOLEAN, &f );
+    return TRUE;
+done_false:
+    f = 0.0f;
+    value_set( out, VALUE_BOOLEAN, &f );
+    return TRUE;
+}
+
+/*** functions ***/
+
+static float lerpf( float a, float b, float t )
+{
+    return a + (b - a) * t;
+}
+
+static float clamp_scalar( float value, float low, float high )
+{
+    return value < low ? low : value > high ? high : value;
+}
+
+static float roundf_away( float value )
+{
+    return value < 0 ? -floorf( -value + 0.5f ) : floorf( value + 0.5f );
+}
+
+static float length_of( const struct value *value )
+{
+    unsigned int i, count = value_components( value->type );
+    float sum = 0.0f;
+    for (i = 0; i < count; i++) sum += value->f[i] * value->f[i];
+    return sqrtf( sum );
+}
+
+static void matrix4x4_identity( float *m )
+{
+    memset( m, 0, 16 * sizeof(float) );
+    m[0] = m[5] = m[10] = m[15] = 1.0f;
+}
+
+static void matrix4x4_from_axis_angle( const float *axis, float angle, float *m )
+{
+    float x = axis[0], y = axis[1], z = axis[2], length = sqrtf( x * x + y * y + z * z );
+    float s = sinf( angle ), c = cosf( angle ), t = 1.0f - c;
+
+    matrix4x4_identity( m );
+    if (!length) return;
+    x /= length; y /= length; z /= length;
+    /* System.Numerics' CreateFromAxisAngle, for row vectors */
+    m[0] = x * x * t + c;      m[1] = x * y * t + z * s;  m[2] = x * z * t - y * s;
+    m[4] = x * y * t - z * s;  m[5] = y * y * t + c;      m[6] = y * z * t + x * s;
+    m[8] = x * z * t + y * s;  m[9] = y * z * t - x * s;  m[10] = z * z * t + c;
+}
+
+static BOOL matrix3x2_invert( const float *m, float *r )
+{
+    float det = m[0] * m[3] - m[1] * m[2];
+
+    if (fabsf( det ) < 1e-12f) return FALSE;
+    r[0] = m[3] / det;
+    r[1] = -m[1] / det;
+    r[2] = -m[2] / det;
+    r[3] = m[0] / det;
+    r[4] = (m[2] * m[5] - m[3] * m[4]) / det;
+    r[5] = (m[1] * m[4] - m[0] * m[5]) / det;
+    return TRUE;
+}
+
+static BOOL matrix4x4_invert( const float *m, float *out )
+{
+    float inv[16], det;
+    int i;
+
+    inv[0] = m[5] * m[10] * m[15] - m[5] * m[11] * m[14] - m[9] * m[6] * m[15] + m[9] * m[7] * m[14] + m[13] * m[6] * m[11] - m[13] * m[7] * m[10];
+    inv[4] = -m[4] * m[10] * m[15] + m[4] * m[11] * m[14] + m[8] * m[6] * m[15] - m[8] * m[7] * m[14] - m[12] * m[6] * m[11] + m[12] * m[7] * m[10];
+    inv[8] = m[4] * m[9] * m[15] - m[4] * m[11] * m[13] - m[8] * m[5] * m[15] + m[8] * m[7] * m[13] + m[12] * m[5] * m[11] - m[12] * m[7] * m[9];
+    inv[12] = -m[4] * m[9] * m[14] + m[4] * m[10] * m[13] + m[8] * m[5] * m[14] - m[8] * m[6] * m[13] - m[12] * m[5] * m[10] + m[12] * m[6] * m[9];
+    inv[1] = -m[1] * m[10] * m[15] + m[1] * m[11] * m[14] + m[9] * m[2] * m[15] - m[9] * m[3] * m[14] - m[13] * m[2] * m[11] + m[13] * m[3] * m[10];
+    inv[5] = m[0] * m[10] * m[15] - m[0] * m[11] * m[14] - m[8] * m[2] * m[15] + m[8] * m[3] * m[14] + m[12] * m[2] * m[11] - m[12] * m[3] * m[10];
+    inv[9] = -m[0] * m[9] * m[15] + m[0] * m[11] * m[13] + m[8] * m[1] * m[15] - m[8] * m[3] * m[13] - m[12] * m[1] * m[11] + m[12] * m[3] * m[9];
+    inv[13] = m[0] * m[9] * m[14] - m[0] * m[10] * m[13] - m[8] * m[1] * m[14] + m[8] * m[2] * m[13] + m[12] * m[1] * m[10] - m[12] * m[2] * m[9];
+    inv[2] = m[1] * m[6] * m[15] - m[1] * m[7] * m[14] - m[5] * m[2] * m[15] + m[5] * m[3] * m[14] + m[13] * m[2] * m[7] - m[13] * m[3] * m[6];
+    inv[6] = -m[0] * m[6] * m[15] + m[0] * m[7] * m[14] + m[4] * m[2] * m[15] - m[4] * m[3] * m[14] - m[12] * m[2] * m[7] + m[12] * m[3] * m[6];
+    inv[10] = m[0] * m[5] * m[15] - m[0] * m[7] * m[13] - m[4] * m[1] * m[15] + m[4] * m[3] * m[13] + m[12] * m[1] * m[7] - m[12] * m[3] * m[5];
+    inv[14] = -m[0] * m[5] * m[14] + m[0] * m[6] * m[13] + m[4] * m[1] * m[14] - m[4] * m[2] * m[13] - m[12] * m[1] * m[6] + m[12] * m[2] * m[5];
+    inv[3] = -m[1] * m[6] * m[11] + m[1] * m[7] * m[10] + m[5] * m[2] * m[11] - m[5] * m[3] * m[10] - m[9] * m[2] * m[7] + m[9] * m[3] * m[6];
+    inv[7] = m[0] * m[6] * m[11] - m[0] * m[7] * m[10] - m[4] * m[2] * m[11] + m[4] * m[3] * m[10] + m[8] * m[2] * m[7] - m[8] * m[3] * m[6];
+    inv[11] = -m[0] * m[5] * m[11] + m[0] * m[7] * m[9] + m[4] * m[1] * m[11] - m[4] * m[3] * m[9] - m[8] * m[1] * m[7] + m[8] * m[3] * m[5];
+    inv[15] = m[0] * m[5] * m[10] - m[0] * m[6] * m[9] - m[4] * m[1] * m[10] + m[4] * m[2] * m[9] + m[8] * m[1] * m[6] - m[8] * m[2] * m[5];
+
+    det = m[0] * inv[0] + m[1] * inv[4] + m[2] * inv[8] + m[3] * inv[12];
+    if (fabsf( det ) < 1e-12f) return FALSE;
+    for (i = 0; i < 16; i++) out[i] = inv[i] / det;
+    return TRUE;
+}
+
+static void quaternion_slerp( const float *a, const float *b, float t, float *r )
+{
+    float cosine = a[0] * b[0] + a[1] * b[1] + a[2] * b[2] + a[3] * b[3], sa, sb;
+    BOOL flip = cosine < 0.0f;
+    int i;
+
+    if (flip) cosine = -cosine;
+    if (cosine > 1.0f - 1e-6f)
+    {
+        sa = 1.0f - t;
+        sb = flip ? -t : t;
+    }
+    else
+    {
+        float angle = acosf( cosine ), s = 1.0f / sinf( angle );
+        sa = sinf( (1.0f - t) * angle ) * s;
+        sb = flip ? -sinf( t * angle ) * s : sinf( t * angle ) * s;
+    }
+    for (i = 0; i < 4; i++) r[i] = sa * a[i] + sb * b[i];
+}
+
+typedef float (*unary_fn)( float );
+
+static float to_degrees( float value ) { return value * 180.0f / (float)M_PI; }
+static float to_radians( float value ) { return value * (float)M_PI / 180.0f; }
+static float square( float value ) { return value * value; }
+static float round_fn( float value ) { return roundf_away( value ); }
+
+static const struct
+{
+    const WCHAR *name;
+    unary_fn fn;
+}
+unary_functions[] =
+{
+    { L"Abs", fabsf },
+    { L"Acos", acosf },
+    { L"Asin", asinf },
+    { L"Atan", atanf },
+    { L"Ceil", ceilf },
+    { L"Ceiling", ceilf },
+    { L"Cos", cosf },
+    { L"Floor", floorf },
+    { L"Ln", logf },
+    { L"Log10", log10f },
+    { L"Round", round_fn },
+    { L"Sin", sinf },
+    { L"Sqrt", sqrtf },
+    { L"Square", square },
+    { L"Tan", tanf },
+    { L"ToDegrees", to_degrees },
+    { L"ToRadians", to_radians },
+};
+
+static BOOL args_numeric( const struct value *args, unsigned int count )
+{
+    unsigned int i;
+    for (i = 0; i < count; i++) if (!is_numeric( args[i].type )) return FALSE;
+    return TRUE;
+}
+
+/* the component of a value that goes with component i of another: a scalar goes with every one */
+static float component( const struct value *value, unsigned int i )
+{
+    return value->type == VALUE_SCALAR ? value->f[0] : value->f[i];
+}
+
+static BOOL call_function( const WCHAR *full_name, struct value *args, unsigned int count, struct value *out )
+{
+    const WCHAR *name = full_name, *dot;
+    unsigned int i, n;
+    float f[16];
+
+    /* Vector3.Lerp and the like are Lerp, but Matrix4x4.CreateFromTranslation keeps its type */
+    if ((dot = wcsrchr( full_name, '.' )) && wcsnicmp( dot + 1, L"Create", 6 )) name = dot + 1;
+
+    for (i = 0; i < ARRAY_SIZE(unary_functions); i++)
+    {
+        unary_fn fn = unary_functions[i].fn;
+
+        if (wcsicmp( name, unary_functions[i].name )) continue;
+        if (count != 1 || !is_numeric( args[0].type ) || args[0].type >= VALUE_QUATERNION) return FALSE;
+        n = value_components( args[0].type );
+        value_set( out, args[0].type, NULL );
+        for (i = 0; i < n; i++) out->f[i] = fn( args[0].f[i] );
+        return TRUE;
+    }
+
+    if (!wcsicmp( name, L"Min" ) || !wcsicmp( name, L"Max" ) || !wcsicmp( name, L"Pow" ) || !wcsicmp( name, L"Mod" ))
+    {
+        BOOL is_min = !wcsicmp( name, L"Min" ), is_max = !wcsicmp( name, L"Max" ), is_pow = !wcsicmp( name, L"Pow" );
+        enum value_type type;
+
+        if (count != 2 || !args_numeric( args, 2 )) return FALSE;
+        type = args[0].type == VALUE_SCALAR ? args[1].type : args[0].type;
+        n = value_components( type );
+        value_set( out, type, NULL );
+        for (i = 0; i < n; i++)
+        {
+            float a = component( &args[0], i ), b = component( &args[1], i );
+            out->f[i] = is_min ? min( a, b ) : is_max ? max( a, b ) : is_pow ? powf( a, b ) : fmodf( a, b );
+        }
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Clamp" ))
+    {
+        if (count != 3 || !args_numeric( args, 3 )) return FALSE;
+        n = value_components( args[0].type );
+        value_set( out, args[0].type, NULL );
+        for (i = 0; i < n; i++)
+            out->f[i] = clamp_scalar( args[0].f[i], component( &args[1], i ), component( &args[2], i ) );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Lerp" ) || !wcsicmp( name, L"ColorLerp" ) || !wcsicmp( name, L"ColorLerpRGB" ) ||
+        !wcsicmp( name, L"ColorLerpHSL" ))
+    {
+        if (count != 3 || !args_numeric( args, 3 ) || args[2].type != VALUE_SCALAR || args[0].type != args[1].type)
+            return FALSE;
+        n = value_components( args[0].type );
+        value_set( out, args[0].type, NULL );
+        for (i = 0; i < n; i++) out->f[i] = lerpf( args[0].f[i], args[1].f[i], args[2].f[0] );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Slerp" ))
+    {
+        if (count != 3 || args[0].type != VALUE_QUATERNION || args[1].type != VALUE_QUATERNION ||
+            args[2].type != VALUE_SCALAR)
+            return FALSE;
+        value_set( out, VALUE_QUATERNION, NULL );
+        quaternion_slerp( args[0].f, args[1].f, args[2].f[0], out->f );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Concatenate" ))
+    {
+        if (count != 2 || args[0].type != VALUE_QUATERNION || args[1].type != VALUE_QUATERNION) return FALSE;
+        value_set( out, VALUE_QUATERNION, NULL );
+        /* the rotation of the first, then that of the second */
+        quaternion_multiply( args[1].f, args[0].f, out->f );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Length" ) || !wcsicmp( name, L"LengthSquared" ))
+    {
+        if (count != 1 || !is_numeric( args[0].type )) return FALSE;
+        f[0] = length_of( &args[0] );
+        if (!wcsicmp( name, L"LengthSquared" )) f[0] *= f[0];
+        value_set( out, VALUE_SCALAR, f );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Distance" ) || !wcsicmp( name, L"DistanceSquared" ))
+    {
+        struct value difference;
+        if (count != 2 || !evaluate_arithmetic( OP_SUB, &args[0], &args[1], &difference )) return FALSE;
+        f[0] = length_of( &difference );
+        if (!wcsicmp( name, L"DistanceSquared" )) f[0] *= f[0];
+        value_set( out, VALUE_SCALAR, f );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Normalize" ))
+    {
+        float length;
+        if (count != 1 || !is_numeric( args[0].type )) return FALSE;
+        length = length_of( &args[0] );
+        n = value_components( args[0].type );
+        value_set( out, args[0].type, NULL );
+        for (i = 0; i < n; i++) out->f[i] = length ? args[0].f[i] / length : 0.0f;
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Scale" ))
+    {
+        if (count != 2 || args[1].type != VALUE_SCALAR) return FALSE;
+        return evaluate_arithmetic( OP_MUL, &args[0], &args[1], out );
+    }
+    if (!wcsicmp( name, L"Inverse" ))
+    {
+        if (count != 1) return FALSE;
+        value_set( out, args[0].type, NULL );
+        if (args[0].type == VALUE_MATRIX3X2) return matrix3x2_invert( args[0].f, out->f );
+        if (args[0].type == VALUE_MATRIX4X4) return matrix4x4_invert( args[0].f, out->f );
+        return FALSE;
+    }
+    if (!wcsicmp( name, L"Transform" ))
+    {
+        if (count != 2) return FALSE;
+        if (args[0].type == VALUE_VECTOR2 && args[1].type == VALUE_MATRIX3X2)
+        {
+            const float *m = args[1].f;
+            f[0] = args[0].f[0] * m[0] + args[0].f[1] * m[2] + m[4];
+            f[1] = args[0].f[0] * m[1] + args[0].f[1] * m[3] + m[5];
+            value_set( out, VALUE_VECTOR2, f );
+            return TRUE;
+        }
+        if (args[0].type == VALUE_VECTOR4 && args[1].type == VALUE_MATRIX4X4)
+        {
+            const float *m = args[1].f;
+            for (i = 0; i < 4; i++)
+                f[i] = args[0].f[0] * m[i] + args[0].f[1] * m[4 + i] + args[0].f[2] * m[8 + i] + args[0].f[3] * m[12 + i];
+            value_set( out, VALUE_VECTOR4, f );
+            return TRUE;
+        }
+        return FALSE;
+    }
+
+    /* constructors */
+    if (!wcsicmp( name, L"Vector2" ) || !wcsicmp( name, L"Vector3" ) || !wcsicmp( name, L"Vector4" ) ||
+        !wcsicmp( name, L"Quaternion" ) || !wcsicmp( name, L"Matrix3x2" ) || !wcsicmp( name, L"ColorRGB" ))
+    {
+        enum value_type type = !wcsicmp( name, L"Vector2" ) ? VALUE_VECTOR2 : !wcsicmp( name, L"Vector3" ) ? VALUE_VECTOR3 :
+                               !wcsicmp( name, L"Vector4" ) ? VALUE_VECTOR4 : !wcsicmp( name, L"Quaternion" ) ? VALUE_QUATERNION :
+                               !wcsicmp( name, L"ColorRGB" ) ? VALUE_COLOR : VALUE_MATRIX3X2;
+        unsigned int want = value_components( type ), got = 0;
+
+        /* components may come in vectors too, as in Vector3(xy, z) */
+        for (i = 0; i < count; i++)
+        {
+            unsigned int j, c = value_components( args[i].type );
+            if (!is_numeric( args[i].type ) || args[i].type >= VALUE_QUATERNION || got + c > want) return FALSE;
+            for (j = 0; j < c; j++) f[got++] = args[i].f[j];
+        }
+        if (got != want)
+        {
+            /* a single scalar fills a vector */
+            if (count != 1 || args[0].type != VALUE_SCALAR || !is_vector( type )) return FALSE;
+            for (i = 0; i < want; i++) f[i] = args[0].f[0];
+        }
+        value_set( out, type, f );
+        return TRUE;
+    }
+    if (!wcsicmp( name, L"Matrix4x4" ))
+    {
+        if (count == 1 && args[0].type == VALUE_MATRIX3X2)
+        {
+            /* a 2D transform, in the plane */
+            matrix4x4_identity( f );
+            f[0] = args[0].f[0]; f[1] = args[0].f[1];
+            f[4] = args[0].f[2]; f[5] = args[0].f[3];
+            f[12] = args[0].f[4]; f[13] = args[0].f[5];
+            value_set( out, VALUE_MATRIX4X4, f );
+            return TRUE;
+        }
+        if (count != 16 || !args_numeric( args, 16 )) return FALSE;
+        for (i = 0; i < 16; i++)
+        {
+            if (args[i].type != VALUE_SCALAR) return FALSE;
+            f[i] = args[i].f[0];
+        }
+        value_set( out, VALUE_MATRIX4X4, f );
+        return TRUE;
+    }
+    if (!wcsicmp( full_name, L"Matrix3x2.CreateFromScale" ) || !wcsicmp( full_name, L"Matrix3x2.CreateScale" ))
+    {
+        if (count != 1 || args[0].type != VALUE_VECTOR2) return FALSE;
+        f[0] = args[0].f[0]; f[1] = 0.0f; f[2] = 0.0f; f[3] = args[0].f[1]; f[4] = f[5] = 0.0f;
+        value_set( out, VALUE_MATRIX3X2, f );
+        return TRUE;
+    }
+    if (!wcsicmp( full_name, L"Matrix3x2.CreateFromTranslation" ) || !wcsicmp( full_name, L"Matrix3x2.CreateTranslation" ))
+    {
+        if (count != 1 || args[0].type != VALUE_VECTOR2) return FALSE;
+        f[0] = 1.0f; f[1] = 0.0f; f[2] = 0.0f; f[3] = 1.0f; f[4] = args[0].f[0]; f[5] = args[0].f[1];
+        value_set( out, VALUE_MATRIX3X2, f );
+        return TRUE;
+    }
+    if (!wcsicmp( full_name, L"Matrix3x2.CreateRotation" ))
+    {
+        float c, s;
+        if (count != 1 || args[0].type != VALUE_SCALAR) return FALSE;
+        c = cosf( args[0].f[0] ); s = sinf( args[0].f[0] );
+        f[0] = c; f[1] = s; f[2] = -s; f[3] = c; f[4] = f[5] = 0.0f;
+        value_set( out, VALUE_MATRIX3X2, f );
+        return TRUE;
+    }
+    if (!wcsicmp( full_name, L"Matrix3x2.CreateSkew" ))
+    {
+        float tx, ty, cx = 0.0f, cy = 0.0f;
+        if ((count != 2 && count != 3) || args[0].type != VALUE_SCALAR || args[1].type != VALUE_SCALAR) return FALSE;
+        if (count == 3)
+        {
+            if (args[2].type != VALUE_VECTOR2) return FALSE;
+            cx = args[2].f[0]; cy = args[2].f[1];
+        }
+        tx = tanf( args[0].f[0] ); ty = tanf( args[1].f[0] );
+        f[0] = 1.0f; f[1] = ty; f[2] = tx; f[3] = 1.0f; f[4] = -cy * tx; f[5] = -cx * ty;
+        value_set( out, VALUE_MATRIX3X2, f );
+        return TRUE;
+    }
+    if (!wcsicmp( full_name, L"Matrix4x4.CreateFromScale" ) || !wcsicmp( full_name, L"Matrix4x4.CreateScale" ))
+    {
+        if (count != 1 || args[0].type != VALUE_VECTOR3) return FALSE;
+        matrix4x4_identity( f );
+        f[0] = args[0].f[0]; f[5] = args[0].f[1]; f[10] = args[0].f[2];
+        value_set( out, VALUE_MATRIX4X4, f );
+        return TRUE;
+    }
+    if (!wcsicmp( full_name, L"Matrix4x4.CreateFromTranslation" ) || !wcsicmp( full_name, L"Matrix4x4.CreateTranslation" ))
+    {
+        if (count != 1 || args[0].type != VALUE_VECTOR3) return FALSE;
+        matrix4x4_identity( f );
+        f[12] = args[0].f[0]; f[13] = args[0].f[1]; f[14] = args[0].f[2];
+        value_set( out, VALUE_MATRIX4X4, f );
+        return TRUE;
+    }
+    if (!wcsicmp( full_name, L"Matrix4x4.CreateFromAxisAngle" ))
+    {
+        if (count != 2 || args[0].type != VALUE_VECTOR3 || args[1].type != VALUE_SCALAR) return FALSE;
+        matrix4x4_from_axis_angle( args[0].f, args[1].f[0], f );
+        value_set( out, VALUE_MATRIX4X4, f );
+        return TRUE;
+    }
+    if (!wcsicmp( full_name, L"Quaternion.CreateFromAxisAngle" ))
+    {
+        float length, s;
+        if (count != 2 || args[0].type != VALUE_VECTOR3 || args[1].type != VALUE_SCALAR) return FALSE;
+        length = length_of( &args[0] );
+        s = length ? sinf( args[1].f[0] / 2.0f ) / length : 0.0f;
+        f[0] = args[0].f[0] * s; f[1] = args[0].f[1] * s; f[2] = args[0].f[2] * s; f[3] = cosf( args[1].f[0] / 2.0f );
+        value_set( out, VALUE_QUATERNION, f );
+        return TRUE;
+    }
+
+    FIXME( "function %s not implemented.\n", debugstr_w( full_name ) );
+    return FALSE;
+}
+
+static BOOL evaluate( const struct node *node, const struct eval_context *context, struct value *out )
+{
+    struct value args[16], a;
+    unsigned int i;
+    BOOL truth;
+    float f;
+
+    if (context->depth > 16)
+    {
+        WARN( "expressions refer to each other too deeply.\n" );
+        return FALSE;
+    }
+
+    switch (node->kind)
+    {
+    case NODE_NUMBER:
+        value_set( out, VALUE_SCALAR, &node->number );
+        return TRUE;
+    case NODE_BOOLEAN:
+        value_set( out, VALUE_BOOLEAN, &node->number );
+        return TRUE;
+    case NODE_IDENTIFIER:
+        return evaluate_identifier( node, context, out );
+    case NODE_MEMBER:
+        return evaluate_member( node, context, out );
+    case NODE_CALL:
+        if (node->arg_count > ARRAY_SIZE(args)) return FALSE;
+        for (i = 0; i < node->arg_count; i++) if (!evaluate( node->args[i], context, &args[i] )) return FALSE;
+        return call_function( node->name, args, node->arg_count, out );
+    case NODE_UNARY:
+        if (!evaluate( node->left, context, &a )) return FALSE;
+        if (node->op == OP_NOT)
+        {
+            if (!value_truth( &a, &truth )) return FALSE;
+            f = !truth;
+            value_set( out, VALUE_BOOLEAN, &f );
+            return TRUE;
+        }
+        if (!is_numeric( a.type )) return FALSE;
+        *out = a;
+        for (i = 0; i < value_components( a.type ); i++) out->f[i] = -a.f[i];
+        return TRUE;
+    case NODE_BINARY:
+        return evaluate_binary( node, context, out );
+    case NODE_CONDITIONAL:
+        if (!evaluate( node->left, context, &a ) || !value_truth( &a, &truth )) return FALSE;
+        return evaluate( truth ? node->right : node->third, context, out );
+    }
+    return FALSE;
+}
+
+BOOL expression_evaluate( const struct expression *expression, const struct eval_context *context, struct value *out )
+{
+    memset( out, 0, sizeof(*out) );
+    if (!expression || !evaluate( expression->root, context, out )) return FALSE;
+    if (out->type == VALUE_OBJECT || out->type == VALUE_THIS) return FALSE;
+    return TRUE;
+}
+
+/*** converting values to and from what properties hold ***/
+
+BOOL value_convert( const struct value *value, enum value_type type, struct value *out )
+{
+    if (value->type == type)
+    {
+        *out = *value;
+        return TRUE;
+    }
+    /* a scalar and a boolean are one another's */
+    if ((value->type == VALUE_SCALAR && type == VALUE_BOOLEAN) || (value->type == VALUE_BOOLEAN && type == VALUE_SCALAR))
+    {
+        value_set( out, type, value->f );
+        if (type == VALUE_BOOLEAN) out->f[0] = value->f[0] != 0.0f;
+        return TRUE;
+    }
+    /* a vector4 is a quaternion and back */
+    if ((value->type == VALUE_VECTOR4 && type == VALUE_QUATERNION) || (value->type == VALUE_QUATERNION && type == VALUE_VECTOR4))
+    {
+        value_set( out, type, value->f );
+        return TRUE;
+    }
+    return FALSE;
+}
+
+/* sets the member name names of a value, for an animation of a part of a property such as Offset.X */
+BOOL value_set_member( struct value *value, const WCHAR *name, const struct value *part )
+{
+    unsigned int count = value_components( value->type ), len = wcslen( name ), i;
+
+    if (!is_numeric( value->type ) || value->type == VALUE_MATRIX3X2 || value->type == VALUE_MATRIX4X4)
+        return FALSE;
+    if (value->type == VALUE_COLOR)
+    {
+        static const WCHAR names[] = L"ARGB";
+        const WCHAR *c;
+        if (len != 1 || part->type != VALUE_SCALAR || !(c = wcschr( names, towupper( name[0] ) ))) return FALSE;
+        value->f[c - names] = part->f[0];
+        return TRUE;
+    }
+    if (len > 4 || value_components( part->type ) != len || !is_numeric( part->type )) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        WCHAR c = towlower( name[i] );
+        unsigned int index = c == 'w' ? 3 : c - 'x';
+        if (index >= count || c < 'w' || c > 'z') return FALSE;
+        value->f[index] = part->f[i];
+    }
+    return TRUE;
+}
+
+/* a member of a value, as the X of an Offset */
+BOOL value_member( const struct value *value, const WCHAR *name, struct value *out )
+{
+    return is_numeric( value->type ) && swizzle( value, name, out );
+}
+
+BOOL value_scalar( struct value *value, float f )
+{
+    value_set( value, VALUE_SCALAR, &f );
+    return TRUE;
+}
+
+BOOL value_boolean( struct value *value, BOOL b )
+{
+    float f = !!b;
+    value_set( value, VALUE_BOOLEAN, &f );
+    return TRUE;
+}
+
+BOOL value_vector2( struct value *value, Vector2 v )
+{
+    float f[2] = {v.X, v.Y};
+    value_set( value, VALUE_VECTOR2, f );
+    return TRUE;
+}
+
+BOOL value_vector3( struct value *value, Vector3 v )
+{
+    float f[3] = {v.X, v.Y, v.Z};
+    value_set( value, VALUE_VECTOR3, f );
+    return TRUE;
+}
+
+BOOL value_vector4( struct value *value, Vector4 v )
+{
+    float f[4] = {v.X, v.Y, v.Z, v.W};
+    value_set( value, VALUE_VECTOR4, f );
+    return TRUE;
+}
+
+BOOL value_quaternion( struct value *value, Quaternion q )
+{
+    float f[4] = {q.X, q.Y, q.Z, q.W};
+    value_set( value, VALUE_QUATERNION, f );
+    return TRUE;
+}
+
+BOOL value_color( struct value *value, Color c )
+{
+    float f[4] = {c.A, c.R, c.G, c.B};
+    value_set( value, VALUE_COLOR, f );
+    return TRUE;
+}
+
+BOOL value_matrix3x2( struct value *value, const Matrix3x2 *m )
+{
+    float f[6] = {m->M11, m->M12, m->M21, m->M22, m->M31, m->M32};
+    value_set( value, VALUE_MATRIX3X2, f );
+    return TRUE;
+}
+
+BOOL value_matrix4x4( struct value *value, const Matrix4x4 *m )
+{
+    float f[16] = {m->M11, m->M12, m->M13, m->M14, m->M21, m->M22, m->M23, m->M24,
+                   m->M31, m->M32, m->M33, m->M34, m->M41, m->M42, m->M43, m->M44};
+    value_set( value, VALUE_MATRIX4X4, f );
+    return TRUE;
+}
+
+BOOL value_object( struct value *value, struct object *object )
+{
+    value_set( value, VALUE_OBJECT, NULL );
+    value->object = object;
+    return TRUE;
+}
+
+BOOL value_get_scalar( const struct value *value, float *f )
+{
+    struct value v;
+    if (!value_convert( value, VALUE_SCALAR, &v )) return FALSE;
+    *f = v.f[0];
+    return TRUE;
+}
+
+BOOL value_get_boolean( const struct value *value, boolean *b )
+{
+    struct value v;
+    if (!value_convert( value, VALUE_BOOLEAN, &v )) return FALSE;
+    *b = v.f[0] != 0.0f;
+    return TRUE;
+}
+
+BOOL value_get_vector2( const struct value *value, Vector2 *v )
+{
+    if (value->type != VALUE_VECTOR2) return FALSE;
+    v->X = value->f[0]; v->Y = value->f[1];
+    return TRUE;
+}
+
+BOOL value_get_vector3( const struct value *value, Vector3 *v )
+{
+    if (value->type != VALUE_VECTOR3) return FALSE;
+    v->X = value->f[0]; v->Y = value->f[1]; v->Z = value->f[2];
+    return TRUE;
+}
+
+BOOL value_get_vector4( const struct value *value, Vector4 *v )
+{
+    struct value c;
+    if (!value_convert( value, VALUE_VECTOR4, &c )) return FALSE;
+    v->X = c.f[0]; v->Y = c.f[1]; v->Z = c.f[2]; v->W = c.f[3];
+    return TRUE;
+}
+
+BOOL value_get_quaternion( const struct value *value, Quaternion *q )
+{
+    struct value c;
+    if (!value_convert( value, VALUE_QUATERNION, &c )) return FALSE;
+    q->X = c.f[0]; q->Y = c.f[1]; q->Z = c.f[2]; q->W = c.f[3];
+    return TRUE;
+}
+
+BOOL value_get_color( const struct value *value, Color *color )
+{
+    if (value->type != VALUE_COLOR) return FALSE;
+    color->A = clamp_scalar( roundf_away( value->f[0] ), 0.0f, 255.0f );
+    color->R = clamp_scalar( roundf_away( value->f[1] ), 0.0f, 255.0f );
+    color->G = clamp_scalar( roundf_away( value->f[2] ), 0.0f, 255.0f );
+    color->B = clamp_scalar( roundf_away( value->f[3] ), 0.0f, 255.0f );
+    return TRUE;
+}
+
+BOOL value_get_matrix3x2( const struct value *value, Matrix3x2 *m )
+{
+    if (value->type != VALUE_MATRIX3X2) return FALSE;
+    m->M11 = value->f[0]; m->M12 = value->f[1]; m->M21 = value->f[2];
+    m->M22 = value->f[3]; m->M31 = value->f[4]; m->M32 = value->f[5];
+    return TRUE;
+}
+
+BOOL value_get_matrix4x4( const struct value *value, Matrix4x4 *m )
+{
+    if (value->type != VALUE_MATRIX4X4) return FALSE;
+    m->M11 = value->f[0]; m->M12 = value->f[1]; m->M13 = value->f[2]; m->M14 = value->f[3];
+    m->M21 = value->f[4]; m->M22 = value->f[5]; m->M23 = value->f[6]; m->M24 = value->f[7];
+    m->M31 = value->f[8]; m->M32 = value->f[9]; m->M33 = value->f[10]; m->M34 = value->f[11];
+    m->M41 = value->f[12]; m->M42 = value->f[13]; m->M43 = value->f[14]; m->M44 = value->f[15];
+    return TRUE;
+}
+
+/* what a key frame animation computes between two values */
+void value_interpolate( const struct value *a, const struct value *b, float t, struct value *out )
+{
+    unsigned int i, count = value_components( a->type );
+
+    if (a->type != b->type)
+    {
+        *out = t < 1.0f ? *a : *b;
+        return;
+    }
+    switch (a->type)
+    {
+    case VALUE_BOOLEAN:
+        /* a boolean holds until its key frame comes */
+        *out = t < 1.0f ? *a : *b;
+        return;
+    case VALUE_QUATERNION:
+        value_set( out, VALUE_QUATERNION, NULL );
+        quaternion_slerp( a->f, b->f, t, out->f );
+        return;
+    default:
+        value_set( out, a->type, NULL );
+        for (i = 0; i < count; i++) out->f[i] = lerpf( a->f[i], b->f[i], t );
+        return;
+    }
+}
+
+/*** properties kept in an object's struct ***/
+
+const struct property_desc *property_find( const struct property_desc *descs, const WCHAR *name )
+{
+    for (; descs->name; descs++) if (!wcsicmp( descs->name, name )) return descs;
+    return NULL;
+}
+
+BOOL property_get( const struct property_desc *desc, const void *base, struct value *value )
+{
+    const char *field = (const char *)base + desc->offset;
+
+    switch (desc->type)
+    {
+    case VALUE_BOOLEAN:
+        return value_boolean( value, *(const boolean *)field );
+    case VALUE_COLOR:
+        return value_color( value, *(const Color *)field );
+    default:
+        value_set( value, desc->type, (const float *)field );
+        return TRUE;
+    }
+}
+
+BOOL property_set( const struct property_desc *desc, void *base, const struct value *value )
+{
+    char *field = (char *)base + desc->offset;
+    struct value v;
+
+    if (!value_convert( value, desc->type, &v )) return FALSE;
+    switch (desc->type)
+    {
+    case VALUE_BOOLEAN:
+        *(boolean *)field = v.f[0] != 0.0f;
+        return TRUE;
+    case VALUE_COLOR:
+        return value_get_color( &v, (Color *)field );
+    default:
+        memcpy( field, v.f, value_components( desc->type ) * sizeof(float) );
+        return TRUE;
+    }
+}
