+    struct compositor *compositor = impl_from_ICompositorDesktopInterop( iface );
+    struct target *target;
+    HRESULT hr;
+
+    TRACE( "iface %p, hwnd %p, topmost %d, result %p.\n", iface, hwnd, topmost, result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!hwnd || !IsWindow( hwnd )) return E_INVALIDARG;
+    if (FAILED(hr = target_create( compositor, hwnd, topmost, &target ))) return hr;
+    *result = &target->IDesktopWindowTarget_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI compositor_desktop_EnsureOnThread( ICompositorDesktopInterop *iface, DWORD thread_id )
+{
+    TRACE( "iface %p, thread_id %#lx.\n", iface, thread_id );
+    return S_OK;
+}
+
+static const struct ICompositorDesktopInteropVtbl compositor_desktop_vtbl =
+{
+    compositor_desktop_QueryInterface,
+    compositor_desktop_AddRef,
+    compositor_desktop_Release,
+    /* ICompositorDesktopInterop methods */
+    compositor_desktop_CreateDesktopWindowTarget,
+    compositor_desktop_EnsureOnThread,
+};
+
+DEFINE_IINSPECTABLE( compositor_closable, IClosable, struct compositor, ICompositor_iface )
+
+static HRESULT WINAPI compositor_closable_Close( IClosable *iface )
+{
+    struct compositor *compositor = impl_from_IClosable( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    compositor_lock( compositor );
+    compositor->closed = TRUE;
+    compositor_unlock( compositor );
+    return S_OK;
+}
+
+static const struct IClosableVtbl compositor_closable_vtbl =
+{
+    compositor_closable_QueryInterface,
+    compositor_closable_AddRef,
+    compositor_closable_Release,
+    /* IInspectable methods */
+    compositor_closable_GetIids,
+    compositor_closable_GetRuntimeClassName,
+    compositor_closable_GetTrustLevel,
+    /* IClosable methods */
+    compositor_closable_Close,
+};
+
+/* Windows makes a compositor only on a thread with a dispatcher queue, and says so with E_ACCESSDENIED. */
+static HRESULT current_dispatcher_queue( IDispatcherQueue **queue )
+{
+    static const WCHAR name[] = L"Windows.System.DispatcherQueue";
+    IDispatcherQueueStatics *statics;
+    HSTRING str;
+    HRESULT hr;
+
+    *queue = NULL;
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &str ))) return hr;
+    hr = RoGetActivationFactory( str, &IID_IDispatcherQueueStatics, (void **)&statics );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) return hr;
+    hr = IDispatcherQueueStatics_GetForCurrentThread( statics, queue );
+    IDispatcherQueueStatics_Release( statics );
+    if (SUCCEEDED(hr) && !*queue) hr = E_ACCESSDENIED;
+    return hr;
+}
+
+HRESULT current_thread_has_dispatcher_queue(void)
+{
+    IDispatcherQueue *queue;
+    HRESULT hr = current_dispatcher_queue( &queue );
+    if (queue) IDispatcherQueue_Release( queue );
+    return hr;
+}
+
+struct compositor *unsafe_impl_from_ICompositor( ICompositor *iface )
+{
+    if (!iface || iface->lpVtbl != &compositor_vtbl) return NULL;
+    return impl_from_ICompositor( iface );
+}
+
+HRESULT compositor_create( BOOL manual, struct compositor **out )
+{
+    struct compositor *compositor;
+    IDispatcherQueue *queue;
+    HRESULT hr;
+
+    if (FAILED(hr = current_dispatcher_queue( &queue )))
+    {
+        WARN( "no dispatcher queue on this thread, hr %#lx.\n", hr );
+        return E_ACCESSDENIED;
+    }
+    if (!(compositor = calloc( 1, sizeof(*compositor) )))
+    {
+        IDispatcherQueue_Release( queue );
+        return E_OUTOFMEMORY;
+    }
+    compositor->ICompositor_iface.lpVtbl = &compositor_vtbl;
+    compositor->ICompositor2_iface.lpVtbl = &compositor2_vtbl;
+    compositor->ICompositor3_iface.lpVtbl = &compositor3_vtbl;
+    compositor->ICompositor4_iface.lpVtbl = &compositor4_vtbl;
+    compositor->ICompositor5_iface.lpVtbl = &compositor5_vtbl;
+    compositor->ICompositor6_iface.lpVtbl = &compositor6_vtbl;
+    compositor->ICompositor7_iface.lpVtbl = &compositor7_vtbl;
+    compositor->ICompositor8_iface.lpVtbl = &compositor8_vtbl;
+    compositor->ICompositorInterop_iface.lpVtbl = &compositor_interop_vtbl;
+    compositor->ICompositorDesktopInterop_iface.lpVtbl = &compositor_desktop_vtbl;
+    compositor->IClosable_iface.lpVtbl = &compositor_closable_vtbl;
+    compositor->ref = 1;
+    compositor->queue = queue;
+    compositor->playback_rate = 1.0f;
+    compositor->manual = manual;
+    /* as on Windows, a new compositor has its first commit to make */
+    compositor->changed = TRUE;
+    list_init( &compositor->targets );
+    list_init( &compositor->commit_needed );
+    list_init( &compositor->running );
+    list_init( &compositor->batches );
+    list_init( &compositor->trackers );
+    compositor->frame_handler.lpVtbl = &frame_handler_vtbl;
+    InitializeCriticalSectionEx( &compositor->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    compositor->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": compositor.cs");
+    *out = compositor;
+    return S_OK;
+}
