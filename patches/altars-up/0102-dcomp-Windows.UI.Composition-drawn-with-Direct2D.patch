+static HRESULT source_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct interaction_source *source = impl_from_source_object( object );
+
+    if (IsEqualGUID( iid, &IID_IVisualInteractionSource )) *out = &source->IVisualInteractionSource_iface;
+    else if (IsEqualGUID( iid, &IID_IVisualInteractionSource2 )) *out = &source->IVisualInteractionSource2_iface;
+    else if (IsEqualGUID( iid, &IID_IVisualInteractionSource3 )) *out = &source->IVisualInteractionSource3_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionInteractionSource )) *out = &source->ICompositionInteractionSource_iface;
+    else if (IsEqualGUID( iid, &IID_IVisualInteractionSourceInterop ))
+        *out = &source->IVisualInteractionSourceInterop_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void source_destroy( struct object *object )
+{
+    struct interaction_source *source = impl_from_source_object( object );
+
+    compositor_lock( source->base.compositor );
+    if (source->visual->interaction_source == source) source->visual->interaction_source = NULL;
+    compositor_unlock( source->base.compositor );
+    IVisual_Release( &source->visual->IVisual_iface );
+    IInteractionSourceConfiguration_Release( source->wheel_config );
+    free( source );
+}
