+
+HRESULT brush_create( struct compositor *compositor, enum brush_kind kind, struct brush **out )
+{
+    struct brush *brush;
+
+    if (!(brush = calloc( 1, sizeof(*brush) ))) return E_OUTOFMEMORY;
+    object_init( &brush->base, kind == BRUSH_SURFACE ? &surface_brush_ops :
+                               kind == BRUSH_NINE_GRID ? &nine_grid_brush_ops : &color_brush_ops, compositor );
+    brush->ICompositionBrush_iface.lpVtbl = &brush_vtbl;
+    brush->ICompositionColorBrush_iface.lpVtbl = &color_vtbl;
+    brush->ICompositionSurfaceBrush_iface.lpVtbl = &surface_brush_vtbl;
+    brush->ICompositionSurfaceBrush2_iface.lpVtbl = &surface_brush2_vtbl;
+    brush->ICompositionSurfaceBrush3_iface.lpVtbl = &surface_brush3_vtbl;
+    brush->ICompositionNineGridBrush_iface.lpVtbl = &nine_grid_vtbl;
+    brush->kind = kind;
+
+    /* as Windows has them */
+    brush->stretch = CompositionStretch_Fill;
+    brush->interpolation = CompositionBitmapInterpolationMode_Linear;
+    brush->props.horizontal_alignment_ratio = brush->props.vertical_alignment_ratio = 0.5f;
+    brush->props.scale.X = brush->props.scale.Y = 1.0f;
+    brush->props.transform_matrix.M11 = brush->props.transform_matrix.M22 = 1.0f;
+    brush->props.inset_scales[0] = brush->props.inset_scales[1] = 1.0f;
+    brush->props.inset_scales[2] = brush->props.inset_scales[3] = 1.0f;
+
+    *out = brush;
+    return S_OK;
+}
