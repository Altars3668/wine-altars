+}
+
+static HRESULT collection_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct visual_collection *collection = impl_from_collection_object( object );
+
+    if (IsEqualGUID( iid, &IID_IVisualCollection ))
+    {
+        IVisualCollection_AddRef( (*out = &collection->IVisualCollection_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IIterable_Visual ))
+    {
+        IIterable_Visual_AddRef( (*out = &collection->IIterable_Visual_iface) );
+        return S_OK;
+    }
+    return object_query_interface( object, iid, out );
+}
+
+static void collection_destroy( struct object *object )
+{
+    struct visual_collection *collection = impl_from_collection_object( object );
+    IVisual_Release( &collection->owner->IVisual_iface );
+    free( collection );
+}
