+
+static HRESULT batch_add_completed( struct batch *batch, ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs *handler,
+                                    EventRegistrationToken *token )
+{
+    struct batch_handler *entry;
+
+    if (!token) return E_POINTER;
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_AddRef( (entry->handler = handler) );
+    compositor_lock( batch->base.compositor );
+    entry->token.value = ++batch->next_token;
+    list_add_tail( &batch->handlers, &entry->entry );
+    compositor_unlock( batch->base.compositor );
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT batch_remove_completed( struct batch *batch, EventRegistrationToken token )
+{
+    struct batch_handler *entry, *found = NULL;
+
+    compositor_lock( batch->base.compositor );
+    LIST_FOR_EACH_ENTRY( entry, &batch->handlers, struct batch_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    compositor_unlock( batch->base.compositor );
+    if (found)
+    {
+        ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
