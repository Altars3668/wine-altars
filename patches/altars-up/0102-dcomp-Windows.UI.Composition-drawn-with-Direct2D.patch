+/* a visual has one source at most */
+static HRESULT interaction_source_create( struct visual *visual, IVisualInteractionSource **out )
+{
+    struct interaction_source *source;
+    HRESULT hr;
+
+    if (!(source = calloc( 1, sizeof(*source) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = config_create( visual->base.compositor, &source->wheel_config )))
+    {
+        free( source );
+        return hr;
+    }
+    compositor_lock( visual->base.compositor );
+    if (visual->interaction_source)
+    {
+        compositor_unlock( visual->base.compositor );
+        IInteractionSourceConfiguration_Release( source->wheel_config );
+        free( source );
+        WARN( "visual %p has a source already.\n", visual );
+        return E_INVALIDARG;
+    }
+    visual->interaction_source = source;
+    compositor_unlock( visual->base.compositor );
+
+    object_init( &source->base, &source_ops, visual->base.compositor );
+    source->IVisualInteractionSource_iface.lpVtbl = &source_vtbl;
+    source->IVisualInteractionSource2_iface.lpVtbl = &source2_vtbl;
+    source->IVisualInteractionSource3_iface.lpVtbl = &source3_vtbl;
+    source->ICompositionInteractionSource_iface.lpVtbl = &isource_vtbl;
+    source->IVisualInteractionSourceInterop_iface.lpVtbl = &source_interop_vtbl;
+    IVisual_AddRef( &visual->IVisual_iface );
+    source->visual = visual;
+    /* as Windows has them */
+    source->x_rails = source->y_rails = TRUE;
+    source->redirection = VisualInteractionSourceRedirectionMode_CapableTouchpadOnly;
+    *out = &source->IVisualInteractionSource_iface;
+    return S_OK;
+}
