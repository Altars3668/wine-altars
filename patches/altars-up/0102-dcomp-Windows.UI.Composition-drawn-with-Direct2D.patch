+    if (!visual) return E_INVALIDARG;
+    compositor_lock( collection->base.compositor );
+    if (visual->parent != collection->owner)
+    {
+        compositor_changed( collection->base.compositor );
+        compositor_unlock( collection->base.compositor );
+        return E_INVALIDARG;
+    }
+    list_remove( &visual->entry );
+    visual->parent = NULL;
+    compositor_changed( collection->base.compositor );
+    compositor_unlock( collection->base.compositor );
+    IVisual_Release( &visual->IVisual_iface );
+    return S_OK;
