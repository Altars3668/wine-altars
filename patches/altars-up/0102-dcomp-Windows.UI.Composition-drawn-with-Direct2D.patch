+void visual_detach_all( struct visual *visual )
+{
+    struct visual *child, *next;
+    struct list children = LIST_INIT( children );
+
+    compositor_lock( visual->base.compositor );
+    LIST_FOR_EACH_ENTRY_SAFE( child, next, &visual->children, struct visual, entry )
+    {
+        list_remove( &child->entry );
+        child->parent = NULL;
+        list_add_tail( &children, &child->entry );
+    }
+    compositor_changed( visual->base.compositor );
+    compositor_unlock( visual->base.compositor );
+
+    LIST_FOR_EACH_ENTRY_SAFE( child, next, &children, struct visual, entry )
+    {
+        list_remove( &child->entry );
+        IVisual_Release( &child->IVisual_iface );
+    }
+}
