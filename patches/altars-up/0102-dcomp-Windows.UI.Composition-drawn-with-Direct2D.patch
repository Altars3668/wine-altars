+static HRESULT WINAPI compositor_GetCommitBatch( ICompositor *iface, CompositionBatchTypes batchType, ICompositionCommitBatch **result )
+{
+    struct compositor *compositor = impl_from_ICompositor( iface );
+    struct batch *open;
+    IInspectable *batch;
+    HRESULT hr;
+
+    TRACE( "iface %p, batchType %#x, result %p.\n", iface, batchType, result );
+
+    if (!result) return E_POINTER;
+    /* the batch of the next commit, the same one until then */
+    compositor_lock( compositor );
+    if ((open = batches_commit_batch( compositor )))
+    {
+        hr = IInspectable_QueryInterface( batches_object( open ), &IID_ICompositionCommitBatch, (void **)result );
+        compositor_unlock( compositor );
+        return hr;
+    }
+    compositor_unlock( compositor );
+    if (FAILED(hr = batch_create( compositor, batchType, FALSE, &batch ))) return hr;
+    hr = IInspectable_QueryInterface( batch, &IID_ICompositionCommitBatch, (void **)result );
+    IInspectable_Release( batch );
+    return hr;
+}
