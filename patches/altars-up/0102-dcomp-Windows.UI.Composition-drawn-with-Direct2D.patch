+
+    clip->props.left = left;
+    clip->props.top = top;
+    clip->props.right = right;
+    clip->props.bottom = bottom;
+    if (radius) memcpy( clip->props.radius, radius, sizeof(clip->props.radius) );
+    return S_OK;
+}
+
+static D2D1_MATRIX_3X2_F multiply( const D2D1_MATRIX_3X2_F *a, const D2D1_MATRIX_3X2_F *b )
+{
+    D2D1_MATRIX_3X2_F r;
+    r._11 = a->_11 * b->_11 + a->_12 * b->_21;
+    r._12 = a->_11 * b->_12 + a->_12 * b->_22;
+    r._21 = a->_21 * b->_11 + a->_22 * b->_21;
+    r._22 = a->_21 * b->_12 + a->_22 * b->_22;
+    r._31 = a->_31 * b->_11 + a->_32 * b->_21 + b->_31;
+    r._32 = a->_31 * b->_12 + a->_32 * b->_22 + b->_32;
+    return r;
+}
+
+/*
+ * Clips what a visual and its children draw, in the visual's space; the
+ * context's transform is the visual's.  Direct2D clips to rectangles only, so
+ * a rounded or turned clip is its bounding rectangle for now.
+ */
+BOOL clip_push( ID2D1DeviceContext *context, ICompositionClip *iface, Vector2 size )
+{
+    D2D1_MATRIX_3X2_F world, m, t;
+    struct clip_state state;
+    struct clip *clip;
+    D2D1_RECT_F rect;
+    float c, s;
+
+    if (!iface) return FALSE;
+    if (iface->lpVtbl != &clip_vtbl)
+    {
+        FIXME( "clip %p not supported.\n", iface );
+        return FALSE;
+    }
+    clip = impl_from_ICompositionClip( iface );
+    clip_get_state( clip, &state );
+
+    if (clip->kind == CLIP_INSET)
+    {
+        rect.left = state.left;
+        rect.top = state.top;
+        rect.right = size.X - state.right;
+        rect.bottom = size.Y - state.bottom;
+    }
+    else
+    {
+        rect.left = state.left;
+        rect.top = state.top;
+        rect.right = state.right;
+        rect.bottom = state.bottom;
+        if (state.radius[0].X || state.radius[1].X || state.radius[2].X || state.radius[3].X)
+            FIXME( "rounded corners not clipped.\n" );
+    }
+    if (rect.right < rect.left) rect.right = rect.left;
+    if (rect.bottom < rect.top) rect.bottom = rect.top;
+
+    /* the clip's own transform, the way a visual's goes */
+    m = (D2D1_MATRIX_3X2_F){{{1.0f, 0.0f, 0.0f, 1.0f, -state.center_point.X, -state.center_point.Y}}};
+    t = (D2D1_MATRIX_3X2_F){{{state.scale.X, 0.0f, 0.0f, state.scale.Y, 0.0f, 0.0f}}};
+    m = multiply( &m, &t );
+    c = cosf( state.rotation_angle );
+    s = sinf( state.rotation_angle );
+    if (s) FIXME( "turned clip clipped to its bounds.\n" );
+    t = (D2D1_MATRIX_3X2_F){{{c, s, -s, c, 0.0f, 0.0f}}};
+    m = multiply( &m, &t );
+    t = (D2D1_MATRIX_3X2_F){{{1.0f, 0.0f, 0.0f, 1.0f, state.center_point.X, state.center_point.Y}}};
+    m = multiply( &m, &t );
+    t = matrix_from_3x2( &state.transform_matrix );
+    m = multiply( &m, &t );
+    t = (D2D1_MATRIX_3X2_F){{{1.0f, 0.0f, 0.0f, 1.0f, state.offset.X - state.anchor_point.X * size.X,
+                              state.offset.Y - state.anchor_point.Y * size.Y}}};
+    m = multiply( &m, &t );
+
+    ID2D1DeviceContext_GetTransform( context, &world );
+    t = multiply( &m, &world );
+    ID2D1DeviceContext_SetTransform( context, &t );
+    ID2D1DeviceContext_PushAxisAlignedClip( context, &rect, D2D1_ANTIALIAS_MODE_ALIASED );
+    ID2D1DeviceContext_SetTransform( context, &world );
+    return TRUE;
+}
+
+void clip_pop( ID2D1DeviceContext *context, ICompositionClip *iface )
+{
+    ID2D1DeviceContext_PopAxisAlignedClip( context );
+}
