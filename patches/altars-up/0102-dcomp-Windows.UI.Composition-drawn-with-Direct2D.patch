+static HRESULT config_create( struct compositor *compositor, IInteractionSourceConfiguration **out )
+{
+    struct source_config *config;
+
+    if (!(config = calloc( 1, sizeof(*config) ))) return E_OUTOFMEMORY;
+    object_init( &config->base, &config_ops, compositor );
+    config->IInteractionSourceConfiguration_iface.lpVtbl = &config_vtbl;
