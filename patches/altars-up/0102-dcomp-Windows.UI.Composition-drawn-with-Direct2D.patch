+static const struct IDispatcherQueueHandlerVtbl owner_call_vtbl =
+{
+    owner_call_QueryInterface,
+    owner_call_AddRef,
+    owner_call_Release,
+    /* IDispatcherQueueHandler methods */
+    owner_call_Invoke,
+};
