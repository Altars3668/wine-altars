+static BOOL visual_get_property( struct object *object, const WCHAR *name, struct value *value )
+{
+    struct visual *visual = impl_from_visual_object( object );
+    const struct property_desc *desc;
+
+    if (!wcsicmp( name, L"RotationAngleInDegrees" ))
+        return value_scalar( value, visual->props.rotation_angle * 180.0f / 3.14159265358979f );
+    if (!(desc = property_find( visual_properties, name ))) return FALSE;
+    return property_get( desc, &visual->props, value );
+}
+
+static BOOL visual_set_property( struct object *object, const WCHAR *name, const struct value *value )
+{
+    struct visual *visual = impl_from_visual_object( object );
+    const struct property_desc *desc;
+    float f;
+
+    if (!wcsicmp( name, L"RotationAngleInDegrees" ))
+    {
+        if (!value_get_scalar( value, &f )) return FALSE;
+        visual->props.rotation_angle = f * 3.14159265358979f / 180.0f;
+        return TRUE;
+    }
+    if (!(desc = property_find( visual_properties, name ))) return FALSE;
+    return property_set( desc, &visual->props, value );
+}
+
+/* called with the compositor locked */
+void visual_get_state( struct visual *visual, struct visual_state *state )
+{
+    const struct property_desc *desc;
+    struct value value;
+    float f;
+
+    *state = visual->props;
+    if (list_empty( &visual->base.animations )) return;
+    for (desc = visual_properties; desc->name; desc++)
+    {
+        property_get( desc, state, &value );
+        if (object_animate( &visual->base, desc->name, &value, 0 )) property_set( desc, state, &value );
+    }
+    value_scalar( &value, state->rotation_angle * 180.0f / 3.14159265358979f );
+    if (object_animate( &visual->base, L"RotationAngleInDegrees", &value, 0 ) && value_get_scalar( &value, &f ))
+        state->rotation_angle = f * 3.14159265358979f / 180.0f;
+}
