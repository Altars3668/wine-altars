index 00000000000..602aa530cf2
--- /dev/null
+++ b/dlls/dcomp/target.c
@@ -0,0 +1,273 @@
+/*
+ * Windows.UI.Composition.Desktop.DesktopWindowTarget
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/* a window is composed by one target at most, whichever compositor made it */
+static struct list windows = LIST_INIT( windows );
+static CRITICAL_SECTION windows_cs;
+static CRITICAL_SECTION_DEBUG windows_cs_debug =
+{
+    0, 0, &windows_cs,
+    { &windows_cs_debug.ProcessLocksList, &windows_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": windows_cs") }
+};
+static CRITICAL_SECTION windows_cs = { &windows_cs_debug, -1, 0, 0, 0, 0 };
+
+struct window_entry
+{
+    struct list entry;
+    HWND hwnd;
+};
+
+static BOOL claim_window( HWND hwnd )
+{
+    struct window_entry *window;
+    BOOL ret = FALSE;
+
+    EnterCriticalSection( &windows_cs );
+    LIST_FOR_EACH_ENTRY( window, &windows, struct window_entry, entry )
+        if (window->hwnd == hwnd) goto done;
+    if ((window = calloc( 1, sizeof(*window) )))
+    {
+        window->hwnd = hwnd;
+        list_add_tail( &windows, &window->entry );
+        ret = TRUE;
+    }
+done:
+    LeaveCriticalSection( &windows_cs );
+    return ret;
+}
+
+static void release_window( HWND hwnd )
+{
+    struct window_entry *window;
+
+    EnterCriticalSection( &windows_cs );
+    LIST_FOR_EACH_ENTRY( window, &windows, struct window_entry, entry )
+    {
+        if (window->hwnd != hwnd) continue;
+        list_remove( &window->entry );
+        free( window );
+        break;
+    }
+    LeaveCriticalSection( &windows_cs );
+}
+
+static inline struct target *impl_from_target_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct target, base );
+}
+
+static HRESULT target_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct target *target = impl_from_target_object( object );
+
+    if (IsEqualGUID( iid, &IID_ICompositionTarget )) *out = &target->ICompositionTarget_iface;
+    else if (IsEqualGUID( iid, &IID_IDesktopWindowTarget )) *out = &target->IDesktopWindowTarget_iface;
+    else if (IsEqualGUID( iid, &IID_IDesktopWindowTargetInterop )) *out = &target->IDesktopWindowTargetInterop_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+/* called with the compositor locked: the window stops being composed */
+void target_detach( struct target *target )
+{
+    if (!target->hwnd) return;
+    list_remove( &target->entry );
+    render_release( target );
+    release_window( target->hwnd );
+    target->hwnd = NULL;
+}
+
+static void target_close( struct object *object )
+{
+    struct target *target = impl_from_target_object( object );
+    target_detach( target );
+}
+
+static void target_destroy( struct object *object )
+{
+    struct target *target = impl_from_target_object( object );
+
+    if (target->root)
+    {
+        if (target->root->root_of == target) target->root->root_of = NULL;
+        IVisual_Release( &target->root->IVisual_iface );
+    }
+    free( target );
+}
+
+static const struct object_ops target_ops =
+{
+    L"Windows.UI.Composition.Desktop.DesktopWindowTarget",
+    target_query_interface,
+    target_destroy,
+    target_close,
+};
+
+DEFINE_IINSPECTABLE( target, ICompositionTarget, struct target, base.ICompositionObject_iface )
+
+static HRESULT WINAPI target_get_Root( ICompositionTarget *iface, IVisual **value )
+{
+    struct target *target = impl_from_ICompositionTarget( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( target->base.compositor );
+    if ((*value = target->root ? &target->root->IVisual_iface : NULL)) IVisual_AddRef( *value );
+    compositor_unlock( target->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI target_put_Root( ICompositionTarget *iface, IVisual *value )
+{
+    struct target *target = impl_from_ICompositionTarget( iface );
+    struct visual *visual = value ? unsafe_impl_from_IVisual( value ) : NULL, *old;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (value && !visual) return E_INVALIDARG;
+    if (visual) IVisual_AddRef( &visual->IVisual_iface );
+    compositor_lock( target->base.compositor );
+    old = target->root;
+    if (old && old->root_of == target) old->root_of = NULL;
+    if ((target->root = visual)) visual->root_of = target;
+    compositor_changed( target->base.compositor );
+    compositor_unlock( target->base.compositor );
+    if (old) IVisual_Release( &old->IVisual_iface );
+    return S_OK;
+}
+
+static const struct ICompositionTargetVtbl target_vtbl =
+{
+    target_QueryInterface,
+    target_AddRef,
+    target_Release,
+    /* IInspectable methods */
+    target_GetIids,
+    target_GetRuntimeClassName,
+    target_GetTrustLevel,
+    /* ICompositionTarget methods */
+    target_get_Root,
+    target_put_Root,
+};
+
+DEFINE_IINSPECTABLE( desktop_target, IDesktopWindowTarget, struct target, base.ICompositionObject_iface )
+
+static HRESULT WINAPI desktop_target_get_IsTopmost( IDesktopWindowTarget *iface, boolean *value )
+{
+    struct target *target = impl_from_IDesktopWindowTarget( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = target->topmost;
+    return S_OK;
+}
+
+static const struct IDesktopWindowTargetVtbl desktop_target_vtbl =
+{
+    desktop_target_QueryInterface,
+    desktop_target_AddRef,
+    desktop_target_Release,
+    /* IInspectable methods */
+    desktop_target_GetIids,
+    desktop_target_GetRuntimeClassName,
+    desktop_target_GetTrustLevel,
+    /* IDesktopWindowTarget methods */
+    desktop_target_get_IsTopmost,
+};
+
+static inline struct target *impl_from_IDesktopWindowTargetInterop( IDesktopWindowTargetInterop *iface )
+{
+    return CONTAINING_RECORD( iface, struct target, IDesktopWindowTargetInterop_iface );
+}
+
+static HRESULT WINAPI target_interop_QueryInterface( IDesktopWindowTargetInterop *iface, REFIID iid, void **out )
+{
+    struct target *target = impl_from_IDesktopWindowTargetInterop( iface );
+    return IInspectable_QueryInterface( object_inspectable( &target->base ), iid, out );
+}
+
+static ULONG WINAPI target_interop_AddRef( IDesktopWindowTargetInterop *iface )
+{
+    struct target *target = impl_from_IDesktopWindowTargetInterop( iface );
+    return object_addref( &target->base );
+}
+
+static ULONG WINAPI target_interop_Release( IDesktopWindowTargetInterop *iface )
+{
+    struct target *target = impl_from_IDesktopWindowTargetInterop( iface );
+    return object_release( &target->base );
+}
+
+static HRESULT WINAPI target_interop_get_Hwnd( IDesktopWindowTargetInterop *iface, HWND *value )
+{
+    struct target *target = impl_from_IDesktopWindowTargetInterop( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = target->window;
+    return S_OK;
+}
+
+static const struct IDesktopWindowTargetInteropVtbl target_interop_vtbl =
+{
+    target_interop_QueryInterface,
+    target_interop_AddRef,
+    target_interop_Release,
+    /* IDesktopWindowTargetInterop methods */
+    target_interop_get_Hwnd,
+};
+
+HRESULT target_create( struct compositor *compositor, HWND hwnd, BOOL topmost, struct target **out )
+{
+    struct target *target;
+
+    if (!claim_window( hwnd ))
+    {
+        WARN( "window %p already has a target.\n", hwnd );
+        return DCOMPOSITION_ERROR_WINDOW_ALREADY_COMPOSED;
+    }
+    if (!(target = calloc( 1, sizeof(*target) )))
+    {
+        release_window( hwnd );
+        return E_OUTOFMEMORY;
+    }
+    object_init( &target->base, &target_ops, compositor );
+    target->ICompositionTarget_iface.lpVtbl = &target_vtbl;
+    target->IDesktopWindowTarget_iface.lpVtbl = &desktop_target_vtbl;
+    target->IDesktopWindowTargetInterop_iface.lpVtbl = &target_interop_vtbl;
+    target->hwnd = target->window = hwnd;
+    target->topmost = !!topmost;
+
+    compositor_lock( compositor );
+    list_add_tail( compositor_targets( compositor ), &target->entry );
+    compositor_unlock( compositor );
+
+    *out = target;
+    return S_OK;
+}
