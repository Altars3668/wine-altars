+struct visual_collection
+{
+    struct object base;
+    IVisualCollection IVisualCollection_iface;
+    IIterable_Visual IIterable_Visual_iface;
+    struct visual *owner;
+};
+
+static inline struct visual_collection *impl_from_collection_object( struct object *object )
+{
