+static HRESULT batch_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct batch *batch = impl_from_batch_object( object );
+
+    if (batch->scoped && IsEqualGUID( iid, &IID_ICompositionScopedBatch )) *out = &batch->ICompositionScopedBatch_iface;
+    else if (!batch->scoped && IsEqualGUID( iid, &IID_ICompositionCommitBatch )) *out = &batch->ICompositionCommitBatch_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void batch_destroy( struct object *object )
+{
+    struct batch *batch = impl_from_batch_object( object );
+    struct batch_handler *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &batch->handlers, struct batch_handler, entry )
+    {
+        list_remove( &entry->entry );
+        ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_Release( entry->handler );
+        free( entry );
+    }
+    free( batch );
