+/*
+ * The values expressions compute and properties hold.  Vectors, quaternions
+ * (x, y, z, w), colors (a, r, g, b, from 0 to 255) and matrices (by rows)
+ * keep their components in f.
+ */
+enum value_type
+{
+    VALUE_NONE,
+    VALUE_BOOLEAN,
+    VALUE_SCALAR,
+    VALUE_VECTOR2,
+    VALUE_VECTOR3,
+    VALUE_VECTOR4,
