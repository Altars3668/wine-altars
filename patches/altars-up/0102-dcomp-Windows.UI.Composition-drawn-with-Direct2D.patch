+    /* ICompositionDrawingSurfaceInterop methods */
+    surface_interop_BeginDraw,
+    surface_interop_EndDraw,
+    surface_interop_Resize,
+    surface_interop_Scroll,
+    surface_interop_ResumeDraw,
+    surface_interop_SuspendDraw,
+    /* ICompositionDrawingSurfaceInterop2 methods */
+    surface_interop_CopySurface,
+};
