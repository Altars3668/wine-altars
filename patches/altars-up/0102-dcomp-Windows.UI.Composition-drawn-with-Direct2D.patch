+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/* the tiles of a virtual surface */
+#define TILE_SIZE 512
+
+struct replaced_handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    ITypedEventHandler_CompositionGraphicsDevice_RenderingDeviceReplacedEventArgs *handler;
+};
+
+static UINT format_size( DirectXPixelFormat format )
+{
+    switch (format)
+    {
+    case DirectXPixelFormat_A8UIntNormalized: return 1;
+    case DirectXPixelFormat_R16G16B16A16Float: return 8;
+    default: return 4;
+    }
+}
+
+static BOOL format_supported( DirectXPixelFormat format )
+{
+    switch (format)
+    {
+    case DirectXPixelFormat_B8G8R8A8UIntNormalized:
+    case DirectXPixelFormat_R8G8B8A8UIntNormalized:
+    case DirectXPixelFormat_R16G16B16A16Float:
+    case DirectXPixelFormat_R10G10B10A2UIntNormalized:
+    case DirectXPixelFormat_A8UIntNormalized:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+/* a texture of the device's that a surface's pixels can be kept in, cleared */
+static HRESULT texture_create( ID3D11Device *device, UINT width, UINT height, DirectXPixelFormat format,
+                               ID3D11Texture2D **texture )
+{
+    D3D11_SUBRESOURCE_DATA data;
+    D3D11_TEXTURE2D_DESC desc;
+    HRESULT hr;
+
+    desc.Width = width;
+    desc.Height = height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = 0;
+
+    data.SysMemPitch = width * format_size( format );
+    data.SysMemSlicePitch = 0;
+    if (!(data.pSysMem = calloc( height, data.SysMemPitch ))) return E_OUTOFMEMORY;
+    hr = ID3D11Device_CreateTexture2D( device, &desc, &data, texture );
+    free( (void *)data.pSysMem );
+    if (FAILED(hr)) WARN( "failed to create a %ux%u texture, format %u, hr %#lx.\n", width, height, format, hr );
+    return hr;
+}
+
+static void texture_clear( ID3D11Device *device, ID3D11Texture2D *texture )
+{
+    static const float zero[4];
+    ID3D11RenderTargetView *view;
+    ID3D11DeviceContext *context;
+
+    if (FAILED(ID3D11Device_CreateRenderTargetView( device, (ID3D11Resource *)texture, NULL, &view ))) return;
+    ID3D11Device_GetImmediateContext( device, &context );
+    ID3D11DeviceContext_ClearRenderTargetView( context, view, zero );
+    ID3D11DeviceContext_Release( context );
+    ID3D11RenderTargetView_Release( view );
+}
+
+/*** tiles ***/
+
+static void tile_destroy( struct tile *tile )
+{
+    list_remove( &tile->entry );
+    ID3D11Texture2D_Release( tile->texture );
+    free( tile );
+}
+
+static void surface_drop_tiles( struct drawing_surface *surface )
+{
+    struct tile *tile, *next;
+    LIST_FOR_EACH_ENTRY_SAFE( tile, next, &surface->tiles, struct tile, entry ) tile_destroy( tile );
+}
+
+/* the rectangle of the tile that holds the point, whether there is one yet or not */
+static void surface_tile_rect( struct drawing_surface *surface, int x, int y, RECT *rect )
+{
+    if (!surface->is_virtual) SetRect( rect, 0, 0, surface->size.cx, surface->size.cy );
+    else
+    {
+        rect->left = x - x % TILE_SIZE;
+        rect->top = y - y % TILE_SIZE;
+        rect->right = rect->left + TILE_SIZE;
+        rect->bottom = rect->top + TILE_SIZE;
+    }
+}
+
+static HRESULT surface_get_tile( struct drawing_surface *surface, int x, int y, struct tile **out )
+{
+    struct tile *tile;
+    RECT rect;
+    HRESULT hr;
+
+    surface_tile_rect( surface, x, y, &rect );
+    LIST_FOR_EACH_ENTRY( tile, &surface->tiles, struct tile, entry )
+    {
+        if (EqualRect( &tile->rect, &rect ))
+        {
+            *out = tile;
+            return S_OK;
+        }
+    }
+
+    if (!(tile = calloc( 1, sizeof(*tile) ))) return E_OUTOFMEMORY;
+    tile->rect = rect;
+    if (FAILED(hr = texture_create( surface->device->d3d_device, rect.right - rect.left, rect.bottom - rect.top,
+                                    surface->pixel_format, &tile->texture )))
+    {
+        free( tile );
+        return hr;
+    }
+    list_add_tail( &surface->tiles, &tile->entry );
+    *out = tile;
+    return S_OK;
+}
+
+/* copies the part of the surface in rect to (x, y) of texture; where no tile is, texture is left as it was */
+static void surface_read( struct drawing_surface *surface, const RECT *rect, ID3D11Resource *texture, int x, int y )
+{
+    ID3D11DeviceContext *context;
+    struct tile *tile;
+
+    ID3D11Device_GetImmediateContext( surface->device->d3d_device, &context );
+    LIST_FOR_EACH_ENTRY( tile, &surface->tiles, struct tile, entry )
+    {
+        D3D11_BOX box;
+        RECT part;
+
+        if (!IntersectRect( &part, rect, &tile->rect )) continue;
+        box.left = part.left - tile->rect.left;
+        box.top = part.top - tile->rect.top;
+        box.right = part.right - tile->rect.left;
+        box.bottom = part.bottom - tile->rect.top;
+        box.front = 0;
+        box.back = 1;
+        ID3D11DeviceContext_CopySubresourceRegion( context, texture, 0, x + part.left - rect->left,
+                                                   y + part.top - rect->top, 0, (ID3D11Resource *)tile->texture,
+                                                   0, &box );
+    }
+    ID3D11DeviceContext_Release( context );
+}
+
+/* copies what is at (x, y) of texture into the part of the surface in rect, making the tiles it needs */
+static HRESULT surface_write( struct drawing_surface *surface, const RECT *rect, ID3D11Resource *texture, int x, int y )
+{
+    ID3D11DeviceContext *context;
+    HRESULT hr = S_OK;
+    int tx, ty;
+
+    ID3D11Device_GetImmediateContext( surface->device->d3d_device, &context );
+    for (ty = rect->top; ty < rect->bottom && SUCCEEDED(hr); ty = (ty - ty % TILE_SIZE) + TILE_SIZE)
+    {
+        for (tx = rect->left; tx < rect->right; tx = (tx - tx % TILE_SIZE) + TILE_SIZE)
+        {
+            struct tile *tile;
+            D3D11_BOX box;
+            RECT part;
+
+            if (FAILED(hr = surface_get_tile( surface, tx, ty, &tile ))) break;
+            if (!IntersectRect( &part, rect, &tile->rect )) continue;
+            box.left = x + part.left - rect->left;
+            box.top = y + part.top - rect->top;
+            box.right = box.left + part.right - part.left;
+            box.bottom = box.top + part.bottom - part.top;
+            box.front = 0;
+            box.back = 1;
+            ID3D11DeviceContext_CopySubresourceRegion( context, (ID3D11Resource *)tile->texture, 0,
+                                                       part.left - tile->rect.left, part.top - tile->rect.top, 0,
+                                                       texture, 0, &box );
+            if (!surface->is_virtual) break;
+        }
+        if (!surface->is_virtual) break;
+    }
+    ID3D11DeviceContext_Release( context );
+    return hr;
+}
+
+static HRESULT surface_scratch( struct drawing_surface *surface, UINT width, UINT height )
+{
+    D3D11_TEXTURE2D_DESC desc;
+
+    if (surface->scratch)
+    {
+        ID3D11Texture2D_GetDesc( surface->scratch, &desc );
+        if (desc.Width >= width && desc.Height >= height)
+        {
+            texture_clear( surface->device->d3d_device, surface->scratch );
+            return S_OK;
+        }
+        ID3D11Texture2D_Release( surface->scratch );
+        surface->scratch = NULL;
+    }
+    return texture_create( surface->device->d3d_device, width, height, surface->pixel_format, &surface->scratch );
+}
+
+/* moves the pixels in scroll by (dx, dy), changing only those that land in clip */
+static HRESULT surface_scroll( struct drawing_surface *surface, const RECT *scroll, const RECT *clip, int dx, int dy )
+{
+    RECT bounds, from, to;
+    ID3D11Texture2D *temp;
+    HRESULT hr;
+
+    SetRect( &bounds, 0, 0, surface->size.cx, surface->size.cy );
+    if (!IntersectRect( &from, scroll ? scroll : &bounds, &bounds )) return S_OK;
+    to = from;
+    OffsetRect( &to, dx, dy );
+    if (!IntersectRect( &to, &to, clip ? clip : &bounds ) || !IntersectRect( &to, &to, &bounds )) return S_OK;
+    from = to;
+    OffsetRect( &from, -dx, -dy );
+
+    if (FAILED(hr = texture_create( surface->device->d3d_device, to.right - to.left, to.bottom - to.top,
+                                    surface->pixel_format, &temp )))
+        return hr;
+    surface_read( surface, &from, (ID3D11Resource *)temp, 0, 0 );
+    hr = surface_write( surface, &to, (ID3D11Resource *)temp, 0, 0 );
+    ID3D11Texture2D_Release( temp );
+    return hr;
+}
+
+static HRESULT surface_resize( struct drawing_surface *surface, SIZE size )
+{
+    struct tile *old = NULL, *tile, *next;
+    HRESULT hr = S_OK;
+    RECT keep;
+
+    if (size.cx < 0 || size.cy < 0) return E_INVALIDARG;
+    if (surface->drawing) return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
+
+    if (surface->is_virtual)
+    {
+        /* the tiles outside are of no more use */
+        LIST_FOR_EACH_ENTRY_SAFE( tile, next, &surface->tiles, struct tile, entry )
+            if (tile->rect.left >= size.cx || tile->rect.top >= size.cy) tile_destroy( tile );
+        surface->size = size;
+        return S_OK;
+    }
+
+    /* what fits of the old pixels is kept */
+    if (!list_empty( &surface->tiles ))
+    {
+        old = LIST_ENTRY( list_head( &surface->tiles ), struct tile, entry );
+        list_remove( &old->entry );
+    }
+    surface->size = size;
+    if (old && size.cx && size.cy)
+    {
+        SetRect( &keep, 0, 0, min( size.cx, old->rect.right ), min( size.cy, old->rect.bottom ) );
+        hr = surface_write( surface, &keep, (ID3D11Resource *)old->texture, 0, 0 );
+    }
+    if (old)
+    {
+        ID3D11Texture2D_Release( old->texture );
+        free( old );
+    }
+    return hr;
+}
