+    IInteractionTrackerInertiaRestingValue IInteractionTrackerInertiaRestingValue_iface;
+    IInteractionTrackerInertiaMotion IInteractionTrackerInertiaMotion_iface;
+    enum modifier_kind kind;
+    IExpressionAnimation *expressions[2];   /* the condition, and the value */
+};
+
+static inline struct modifier *impl_from_modifier_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct modifier, base );
+}
+
+static HRESULT modifier_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct modifier *modifier = impl_from_modifier_object( object );
+
+    if (modifier->kind == MODIFIER_CONDITIONAL_VALUE && IsEqualGUID( iid, &IID_ICompositionConditionalValue ))
+        *out = &modifier->ICompositionConditionalValue_iface;
+    else if (modifier->kind != MODIFIER_CONDITIONAL_VALUE && IsEqualGUID( iid, &IID_IInteractionTrackerInertiaModifier ))
+        *out = &modifier->IInteractionTrackerInertiaModifier_iface;
+    else if (modifier->kind == MODIFIER_RESTING_VALUE && IsEqualGUID( iid, &IID_IInteractionTrackerInertiaRestingValue ))
+        *out = &modifier->IInteractionTrackerInertiaRestingValue_iface;
+    else if (modifier->kind == MODIFIER_MOTION && IsEqualGUID( iid, &IID_IInteractionTrackerInertiaMotion ))
+        *out = &modifier->IInteractionTrackerInertiaMotion_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void modifier_destroy( struct object *object )
+{
+    struct modifier *modifier = impl_from_modifier_object( object );
+
+    if (modifier->expressions[0]) IExpressionAnimation_Release( modifier->expressions[0] );
+    if (modifier->expressions[1]) IExpressionAnimation_Release( modifier->expressions[1] );
+    free( modifier );
+}
