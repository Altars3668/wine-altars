+};
+
+static inline struct batch_call *impl_from_IDispatcherQueueHandler( IDispatcherQueueHandler *iface )
+{
+    return CONTAINING_RECORD( iface, struct batch_call, IDispatcherQueueHandler_iface );
+}
+
+static HRESULT WINAPI batch_call_QueryInterface( IDispatcherQueueHandler *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IDispatcherQueueHandler ))
+    {
+        IDispatcherQueueHandler_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI batch_call_AddRef( IDispatcherQueueHandler *iface )
+{
+    struct batch_call *call = impl_from_IDispatcherQueueHandler( iface );
+    return InterlockedIncrement( &call->ref );
+}
+
+static ULONG WINAPI batch_call_Release( IDispatcherQueueHandler *iface )
+{
+    struct batch_call *call = impl_from_IDispatcherQueueHandler( iface );
+    ULONG ref = InterlockedDecrement( &call->ref );
+
+    if (!ref)
+    {
+        object_release( &call->batch->base );
+        free( call );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI batch_call_Invoke( IDispatcherQueueHandler *iface )
+{
+    struct batch_call *call = impl_from_IDispatcherQueueHandler( iface );
+    ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs **handlers = NULL;
+    struct batch *batch = call->batch;
+    ICompositionBatchCompletedEventArgs *args_iface;
+    struct batch_handler *entry;
+    struct batch_args *args;
+    unsigned int count = 0, i;
+
+    TRACE( "batch %p completed.\n", batch );
+
+    if (!(args = calloc( 1, sizeof(*args) ))) return E_OUTOFMEMORY;
+    object_init( &args->base, &batch_args_ops, batch->base.compositor );
+    args->ICompositionBatchCompletedEventArgs_iface.lpVtbl = &batch_args_vtbl;
+    args_iface = &args->ICompositionBatchCompletedEventArgs_iface;
+
+    compositor_lock( batch->base.compositor );
+    if ((handlers = calloc( list_count( &batch->handlers ) + 1, sizeof(*handlers) )))
+    {
+        LIST_FOR_EACH_ENTRY( entry, &batch->handlers, struct batch_handler, entry )
+            ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_AddRef( (handlers[count++] = entry->handler) );
+    }
+    compositor_unlock( batch->base.compositor );
+
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_Invoke( handlers[i],
+                object_inspectable( &batch->base ), args_iface );
+        ITypedEventHandler_IInspectable_CompositionBatchCompletedEventArgs_Release( handlers[i] );
+    }
+    free( handlers );
+    ICompositionBatchCompletedEventArgs_Release( args_iface );
+    return S_OK;
+}
+
+static const struct IDispatcherQueueHandlerVtbl batch_call_vtbl =
+{
+    batch_call_QueryInterface,
+    batch_call_AddRef,
+    batch_call_Release,
+    /* IDispatcherQueueHandler methods */
+    batch_call_Invoke,
+};
+
+/* called with the compositor locked */
+static void batch_complete( struct batch *batch )
+{
+    IDispatcherQueue *queue = compositor_dispatcher_queue( batch->base.compositor );
+    struct batch_call *call;
+    boolean queued = FALSE;
+
+    if (batch->completed) return;
+    batch->completed = TRUE;
+    if (!queue || !(call = calloc( 1, sizeof(*call) ))) return;
+    call->IDispatcherQueueHandler_iface.lpVtbl = &batch_call_vtbl;
+    call->ref = 1;
+    object_addref( &batch->base );
+    call->batch = batch;
+    if (FAILED(IDispatcherQueue_TryEnqueue( queue, &call->IDispatcherQueueHandler_iface, &queued )) || !queued)
+        WARN( "could not queue the batch's completion.\n" );
+    IDispatcherQueueHandler_Release( &call->IDispatcherQueueHandler_iface );
+}
+
+/* called with the compositor locked */
+static void batch_end( struct batch *batch )
+{
+    batch->ended = TRUE;
+    list_remove( &batch->entry );
+    if (!batch->pending) batch_complete( batch );
+    object_release( &batch->base );
+}
+
+static void batch_release_animation( struct batch *batch )
+{
+    if (!--batch->pending && batch->ended) batch_complete( batch );
+    object_release( &batch->base );
+}
+
+/* the open batches an animation started now counts in; called with the compositor locked */
+static BOOL batch_take_animation( struct compositor *compositor, struct running *running )
+{
+    BOOL infinite = running->kind == ANIMATION_EXPRESSION ||
+                    running->iteration_behavior == AnimationIterationBehavior_Forever;
+    struct batch *batch;
+    BOOL taken = FALSE;
+
+    LIST_FOR_EACH_ENTRY( batch, compositor_batches( compositor ), struct batch, entry )
+    {
+        unsigned int slot = batch->scoped ? 0 : 1;
+
+        if (batch->suspended || running->batches[slot]) continue;
+        if (!(batch->types & (infinite ? CompositionBatchTypes_InfiniteAnimation : CompositionBatchTypes_Animation)))
+            continue;
+        running->batches[slot] = batch;
+        object_addref( &batch->base );
+        batch->pending++;
+        taken = TRUE;
+    }
+    return taken;
+}
+
+HRESULT batch_create( struct compositor *compositor, CompositionBatchTypes types, BOOL scoped, IInspectable **out )
+{
+    struct batch *batch;
+
+    if (!types) return E_INVALIDARG;
+    if (!(batch = calloc( 1, sizeof(*batch) ))) return E_OUTOFMEMORY;
+    object_init( &batch->base, scoped ? &scoped_batch_ops : &commit_batch_ops, compositor );
+    batch->ICompositionScopedBatch_iface.lpVtbl = &scoped_vtbl;
+    batch->ICompositionCommitBatch_iface.lpVtbl = &commit_batch_vtbl;
+    batch->scoped = scoped;
+    batch->types = types;
+    list_init( &batch->handlers );
+    /* the compositor's list of open batches holds a reference until it ends */
+    compositor_lock( compositor );
+    object_addref( &batch->base );
+    list_add_tail( compositor_batches( compositor ), &batch->entry );
+    compositor_unlock( compositor );
+    *out = object_inspectable( &batch->base );
+    return S_OK;
+}
+
+/* a commit ends the commit batches; called with the compositor locked */
+void batches_commit( struct compositor *compositor )
+{
+    struct batch *batch, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( batch, next, compositor_batches( compositor ), struct batch, entry )
+        if (!batch->scoped) batch_end( batch );
+}
+
+IInspectable *batches_object( struct batch *batch )
+{
+    return object_inspectable( &batch->base );
+}
+
+/* the commit batch collecting what is started now, if one was asked for */
+struct batch *batches_commit_batch( struct compositor *compositor )
+{
+    struct batch *batch;
+
+    LIST_FOR_EACH_ENTRY( batch, compositor_batches( compositor ), struct batch, entry )
+        if (!batch->scoped) return batch;
+    return NULL;
+}
