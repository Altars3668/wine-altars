+
+HRESULT easing_create( struct compositor *compositor, int kind, Vector2 p1, Vector2 p2, INT32 steps, REFIID iid,
+                       void **out )
+{
+    struct easing *easing;
+    HRESULT hr;
+
+    /* a curve goes forward in time: its control points' x are between 0 and 1 */
+    if (kind == EASING_CUBIC_BEZIER && (!(p1.X >= 0.0f && p1.X <= 1.0f) || !(p2.X >= 0.0f && p2.X <= 1.0f)))
+        return E_INVALIDARG;
+    if (kind == EASING_STEP && steps < 1) return E_INVALIDARG;
+    if (!(easing = calloc( 1, sizeof(*easing) ))) return E_OUTOFMEMORY;
+    object_init( &easing->base, &easing_ops[kind], compositor );
+    easing->ICompositionEasingFunction_iface.lpVtbl = &easing_vtbl;
+    easing->ILinearEasingFunction_iface.lpVtbl = &linear_vtbl;
+    easing->ICubicBezierEasingFunction_iface.lpVtbl = &bezier_vtbl;
+    easing->IStepEasingFunction_iface.lpVtbl = &step_vtbl;
+    easing->kind = kind;
+    easing->p1 = p1;
+    easing->p2 = p2;
+    /* as Windows has them: the final step is the count */
+    easing->step_count = easing->final_step = steps;
+    hr = IInspectable_QueryInterface( object_inspectable( &easing->base ), iid, out );
+    object_release( &easing->base );
+    return hr;
+}
