+/* what an expression reads of a tracker; called with the compositor locked */
+static BOOL tracker_get_value( struct object *object, const WCHAR *name, struct value *value )
+{
+    struct tracker *tracker = impl_from_tracker_object( object );
+
+    if (!wcsicmp( name, L"Position" )) return value_vector3( value, tracker->position );
+    if (!wcsicmp( name, L"Scale" )) return value_scalar( value, tracker->scale );
+    if (!wcsicmp( name, L"MinPosition" )) return value_vector3( value, tracker->min_position );
+    if (!wcsicmp( name, L"MaxPosition" )) return value_vector3( value, tracker->max_position );
+    if (!wcsicmp( name, L"MinScale" )) return value_scalar( value, tracker->min_scale );
+    if (!wcsicmp( name, L"MaxScale" )) return value_scalar( value, tracker->max_scale );
+    if (!wcsicmp( name, L"NaturalRestingPosition" )) return value_vector3( value, tracker->natural_resting_position );
+    if (!wcsicmp( name, L"NaturalRestingScale" )) return value_scalar( value, tracker->natural_resting_scale );
+    if (!wcsicmp( name, L"PositionVelocityInPixelsPerSecond" )) return value_vector3( value, tracker->position_velocity );
+    if (!wcsicmp( name, L"ScaleVelocityInPercentPerSecond" )) return value_scalar( value, tracker->scale_velocity );
+    if (!wcsicmp( name, L"IsPositionRoundingSuggested" )) return value_boolean( value, tracker->position_rounding );
+    if (!wcsicmp( name, L"IsInertiaFromImpulse" )) return value_boolean( value, FALSE );
+    return FALSE;
+}
+
+/* what an animation may set: the bounds */
+static BOOL tracker_set_value( struct object *object, const WCHAR *name, const struct value *value )
+{
+    struct tracker *tracker = impl_from_tracker_object( object );
+
+    if (!wcsicmp( name, L"MinPosition" )) return value_get_vector3( value, &tracker->min_position );
+    if (!wcsicmp( name, L"MaxPosition" )) return value_get_vector3( value, &tracker->max_position );
+    if (!wcsicmp( name, L"MinScale" )) return value_get_scalar( value, &tracker->min_scale );
+    if (!wcsicmp( name, L"MaxScale" )) return value_get_scalar( value, &tracker->max_scale );
+    return FALSE;
+}
