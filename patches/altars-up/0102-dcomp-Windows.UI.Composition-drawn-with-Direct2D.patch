+DEFINE_IINSPECTABLE( iterable, IIterable_Visual, struct visual_collection, base.ICompositionObject_iface )
+
+static HRESULT WINAPI iterable_First( IIterable_Visual *iface, IIterator_Visual **value )
+{
+    struct visual_collection *collection = impl_from_IIterable_Visual( iface );
+    struct visual_iterator *iter;
+    struct visual *child;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    iter->IIterator_Visual_iface.lpVtbl = &iterator_vtbl;
+    iter->ref = 1;
+    compositor_lock( collection->base.compositor );
+    if (!(iter->items = calloc( list_count( &collection->owner->children ) + 1, sizeof(*iter->items) )))
+    {
+        compositor_unlock( collection->base.compositor );
+        free( iter );
+        return E_OUTOFMEMORY;
+    }
+    LIST_FOR_EACH_ENTRY( child, &collection->owner->children, struct visual, entry )
+        IVisual_AddRef( (iter->items[iter->count++] = &child->IVisual_iface) );
+    compositor_unlock( collection->base.compositor );
+    *value = &iter->IIterator_Visual_iface;
+    return S_OK;
+}
