+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( modifier->base.compositor );
+    if ((*value = modifier->expressions[0])) IExpressionAnimation_AddRef( *value );
+    compositor_unlock( modifier->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI cond_put_Condition( ICompositionConditionalValue *iface, IExpressionAnimation *value )
+{
+    struct modifier *modifier = impl_from_ICompositionConditionalValue( iface );
+    IExpressionAnimation *old;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (value) IExpressionAnimation_AddRef( value );
+    compositor_lock( modifier->base.compositor );
+    old = modifier->expressions[0];
+    modifier->expressions[0] = value;
+    compositor_unlock( modifier->base.compositor );
+    if (old) IExpressionAnimation_Release( old );
+    return S_OK;
