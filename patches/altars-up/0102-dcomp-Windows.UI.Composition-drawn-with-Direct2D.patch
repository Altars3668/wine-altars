+static void test_animations(void)
+{
+    static const struct
+    {
+        const WCHAR *property;
+        const WCHAR *frame;
+        HRESULT hr;
+    }
+    scalar_tests[] =
+    {
+        { L"Opacity", NULL, S_OK },
+        { L"opacity", NULL, S_OK },
+        { L"Nonexistent", NULL, E_INVALIDARG },
+        { L"Offset", NULL, E_INVALIDARG },
+        { L"Offset.X", NULL, S_OK },
+        { L"offset.x", NULL, S_OK },
+        { L"Offset.Q", NULL, E_INVALIDARG },
+        { L"Offset.XY", NULL, E_INVALIDARG },
+        { L"Size.X", NULL, S_OK },
+        { L"RotationAngleInDegrees", NULL, S_OK },
+        { L"IsVisible", NULL, E_INVALIDARG },
+        { L"Opacity", L"this.StartingValue * 2", S_OK },
+        { L"Opacity", L"this.StartingValue +* 2", E_INVALIDARG },
+        { L"Opacity", L"missing.Value", E_INVALIDARG },
+        { L"Opacity", L"Vector2(1, 2)", E_INVALIDARG },
+        { L"Opacity", L"Foo(1)", E_INVALIDARG },
+    },
+    expression_tests[] =
+    {
+        { L"Opacity", L"0.5", S_OK },
+        { L"Opacity", L"Vector2(1, 2)", E_INVALIDARG },
+        { L"Offset", L"0.5", E_INVALIDARG },
+        { L"Offset", L"Vector3(1, 2, 3)", S_OK },
+        { L"Offset", L"Vector2(1, 2)", E_INVALIDARG },
+        { L"Offset.X", L"7", S_OK },
+        { L"Opacity", L"missing.Opacity", E_INVALIDARG },
+        { L"Opacity", L"Foo(1)", E_INVALIDARG },
+        { L"Opacity", L"this.Target.Size.X / 100", S_OK },
+        { L"Opacity", L"this.StartingValue", S_OK },
+        { L"IsVisible", L"true", S_OK },
+        { L"IsVisible", L"1", E_INVALIDARG },
+        { L"Size", L"Vector2(1, 2) * 3", S_OK },
+        { L"TransformMatrix", L"Matrix4x4.CreateFromTranslation(Vector3(1, 2, 3))", S_OK },
+        { L"RotationAngleInDegrees", L"45", S_OK },
+        { L"Orientation", L"Quaternion(0, 0, 0, 1)", S_OK },
+    };
+    AnimationIterationBehavior iteration;
+    AnimationStopBehavior stop_behavior;
+    AnimationDelayBehavior delay_behavior;
+    IDispatcherQueueController *queue;
+    ICompositorController *controller;
+    IScalarKeyFrameAnimation *scalar;
+    IVector3KeyFrameAnimation *vector3;
+    IExpressionAnimation *expression;
+    ICompositionAnimation *animation;
+    ICompositionAnimation2 *animation2;
+    IKeyFrameAnimation2 *keyframe2;
+    IKeyFrameAnimation3 *keyframe3;
+    IKeyFrameAnimation *keyframe;
+    AnimationDirection direction;
+    ICompositor *compositor;
+    ISpriteVisual *sprite;
+    IVisual *visual;
+    unsigned int i;
+    TimeSpan span;
+    HSTRING str;
+    Vector3 v3;
+    INT32 count;
+    FLOAT f;
+    HRESULT hr;
+
+    queue = create_queue( DQTAT_COM_STA );
+    if (!(controller = create_controller( &compositor ))) goto done;
+    ICompositor_CreateSpriteVisual( compositor, &sprite );
+    ISpriteVisual_QueryInterface( sprite, &IID_IVisual, (void **)&visual );
+
+    /* key frame animations */
+    hr = ICompositor_CreateScalarKeyFrameAnimation( compositor, &scalar );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( scalar, L"Windows.UI.Composition.ScalarKeyFrameAnimation" );
+    check_interface( scalar, &IID_IKeyFrameAnimation3, TRUE );
+    check_interface( scalar, &IID_ICompositionAnimation4, TRUE );
+    check_interface( scalar, &IID_ICompositionAnimationBase, TRUE );
+    check_interface( scalar, &IID_IVector3KeyFrameAnimation, FALSE );
+    IScalarKeyFrameAnimation_QueryInterface( scalar, &IID_IKeyFrameAnimation, (void **)&keyframe );
+    span.Duration = -1;
+    IKeyFrameAnimation_get_Duration( keyframe, &span );
+    ok( span.Duration == 2500000, "got duration %I64d.\n", span.Duration );
+    span.Duration = -1;
+    IKeyFrameAnimation_get_DelayTime( keyframe, &span );
+    ok( !span.Duration, "got delay %I64d.\n", span.Duration );
+    iteration = -1;
+    IKeyFrameAnimation_get_IterationBehavior( keyframe, &iteration );
+    ok( iteration == AnimationIterationBehavior_Count, "got iteration behavior %d.\n", iteration );
+    count = -1;
+    IKeyFrameAnimation_get_IterationCount( keyframe, &count );
+    ok( count == 1, "got iteration count %d.\n", count );
+    count = -1;
+    IKeyFrameAnimation_get_KeyFrameCount( keyframe, &count );
+    ok( !count, "got key frame count %d.\n", count );
+    stop_behavior = -1;
+    IKeyFrameAnimation_get_StopBehavior( keyframe, &stop_behavior );
+    ok( stop_behavior == AnimationStopBehavior_LeaveCurrentValue, "got stop behavior %d.\n", stop_behavior );
+    IKeyFrameAnimation_QueryInterface( keyframe, &IID_IKeyFrameAnimation2, (void **)&keyframe2 );
+    direction = -1;
+    IKeyFrameAnimation2_get_Direction( keyframe2, &direction );
+    ok( direction == AnimationDirection_Normal, "got direction %d.\n", direction );
+    IKeyFrameAnimation2_Release( keyframe2 );
+    IKeyFrameAnimation_QueryInterface( keyframe, &IID_IKeyFrameAnimation3, (void **)&keyframe3 );
+    delay_behavior = -1;
+    IKeyFrameAnimation3_get_DelayBehavior( keyframe3, &delay_behavior );
+    ok( delay_behavior == AnimationDelayBehavior_SetInitialValueAfterDelay, "got delay behavior %d.\n", delay_behavior );
+    IKeyFrameAnimation3_Release( keyframe3 );
+    IScalarKeyFrameAnimation_QueryInterface( scalar, &IID_ICompositionAnimation2, (void **)&animation2 );
+    str = (HSTRING)0xdeadbeef;
+    hr = ICompositionAnimation2_get_Target( animation2, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !str, "got target %s.\n", debugstr_hstring( str ) );
+    ICompositionAnimation2_Release( animation2 );
+
+    hr = start_animation( sprite, L"Opacity", scalar );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IScalarKeyFrameAnimation_InsertKeyFrame( scalar, 1.5f, 1.0f );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IScalarKeyFrameAnimation_InsertKeyFrame( scalar, -0.5f, 1.0f );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IScalarKeyFrameAnimation_InsertKeyFrame( scalar, 1.0f, 0.5f );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IScalarKeyFrameAnimation_InsertKeyFrame( scalar, 1.0f, 0.25f );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    count = -1;
+    IKeyFrameAnimation_get_KeyFrameCount( keyframe, &count );
+    ok( count == 1, "got key frame count %d.\n", count );
+    span.Duration = 0;
+    hr = IKeyFrameAnimation_put_Duration( keyframe, span );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    span.Duration = 5000;
+    hr = IKeyFrameAnimation_put_Duration( keyframe, span );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    span.Duration = -10000;
+    hr = IKeyFrameAnimation_put_DelayTime( keyframe, span );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IKeyFrameAnimation_put_IterationCount( keyframe, 0 );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+
+    /* an expression key frame is checked when the animation is started, once */
+    str = hstring( L"this.StartingValue +* 2" );
+    hr = IKeyFrameAnimation_InsertExpressionKeyFrame( keyframe, 0.25f, str );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = start_animation( sprite, L"Opacity", scalar );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = start_animation( sprite, L"Opacity", scalar );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IKeyFrameAnimation_Release( keyframe );
+    IScalarKeyFrameAnimation_Release( scalar );
+
+    for (i = 0; i < ARRAY_SIZE(scalar_tests); i++)
+    {
+        hr = start_scalar( compositor, sprite, scalar_tests[i].property, scalar_tests[i].frame );
+        ok( hr == scalar_tests[i].hr, "%u: got hr %#lx.\n", i, hr );
+    }
+    hr = stop_animation( sprite, L"Opacity" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = stop_animation( sprite, L"Opacity" );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = stop_animation( sprite, L"Nonexistent" );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    IVisual_get_Opacity( visual, &f );
+    ok( f == 1.0f, "got opacity %f.\n", f );
+
+    hr = ICompositor_CreateVector3KeyFrameAnimation( compositor, &vector3 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( vector3, L"Windows.UI.Composition.Vector3KeyFrameAnimation" );
+    IVector3KeyFrameAnimation_InsertKeyFrame( vector3, 1.0f, (Vector3){1, 2, 3} );
+    hr = start_animation( sprite, L"Offset", vector3 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = start_animation( sprite, L"Size", vector3 );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = start_animation( sprite, L"Offset.XY", vector3 );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    /* what the property was set to is not what animates it */
+    IVisual_get_Offset( visual, &v3 );
+    ok( !v3.X && !v3.Y && !v3.Z, "got offset %f,%f,%f.\n", v3.X, v3.Y, v3.Z );
+    IVector3KeyFrameAnimation_Release( vector3 );
+
+    /* expression animations */
+    hr = ICompositor_CreateExpressionAnimation( compositor, &expression );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( expression, L"Windows.UI.Composition.ExpressionAnimation" );
+    check_interface( expression, &IID_IKeyFrameAnimation, FALSE );
+    str = (HSTRING)0xdeadbeef;
+    hr = IExpressionAnimation_get_Expression( expression, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !str, "got expression %s.\n", debugstr_hstring( str ) );
+    hr = start_animation( sprite, L"Opacity", expression );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    str = hstring( L"1 +" );
+    hr = IExpressionAnimation_put_Expression( expression, str );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = start_animation( sprite, L"Opacity", expression );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    IExpressionAnimation_QueryInterface( expression, &IID_ICompositionAnimation, (void **)&animation );
+    str = hstring( L"visual" );
+    hr = ICompositionAnimation_SetReferenceParameter( animation, str, NULL );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = ICompositionAnimation_SetScalarParameter( animation, str, 1.0f );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionAnimation_SetScalarParameter( animation, str, 2.0f );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionAnimation_ClearParameter( animation, str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionAnimation_ClearParameter( animation, str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsDeleteString( str );
+    hr = ICompositionAnimation_SetScalarParameter( animation, NULL, 1.0f );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ICompositionAnimation_Release( animation );
+    IExpressionAnimation_Release( expression );
+
+    for (i = 0; i < ARRAY_SIZE(expression_tests); i++)
+    {
+        hr = start_expression( compositor, sprite, expression_tests[i].property, expression_tests[i].frame );
+        ok( hr == expression_tests[i].hr, "%u: got hr %#lx.\n", i, hr );
+    }
+
+    IVisual_Release( visual );
+    ISpriteVisual_Release( sprite );
+    ICompositor_Release( compositor );
+    ICompositorController_Release( controller );
+done:
+    if (queue) IDispatcherQueueController_Release( queue );
+}
