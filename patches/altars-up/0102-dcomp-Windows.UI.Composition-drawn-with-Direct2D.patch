+/* an iterator over the children the collection had when it was made, bottom first */
+struct visual_iterator
+{
+    IIterator_Visual IIterator_Visual_iface;
+    LONG ref;
+    IVisual **items;
+    UINT count, index;
+};
+
+static inline struct visual_iterator *impl_from_IIterator_Visual( IIterator_Visual *iface )
+{
+    return CONTAINING_RECORD( iface, struct visual_iterator, IIterator_Visual_iface );
+}
+
+static HRESULT WINAPI iterator_QueryInterface( IIterator_Visual *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IIterator_Visual ))
+    {
+        IIterator_Visual_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI iterator_AddRef( IIterator_Visual *iface )
+{
+    struct visual_iterator *iter = impl_from_IIterator_Visual( iface );
+    return InterlockedIncrement( &iter->ref );
+}
+
+static ULONG WINAPI iterator_Release( IIterator_Visual *iface )
+{
+    struct visual_iterator *iter = impl_from_IIterator_Visual( iface );
+    ULONG ref = InterlockedDecrement( &iter->ref );
+
+    if (!ref)
+    {
+        while (iter->count) IVisual_Release( iter->items[--iter->count] );
+        free( iter->items );
+        free( iter );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI iterator_GetIids( IIterator_Visual *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_GetRuntimeClassName( IIterator_Visual *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p stub!\n", iface );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI iterator_GetTrustLevel( IIterator_Visual *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_Current( IIterator_Visual *iface, IVisual **value )
+{
+    struct visual_iterator *iter = impl_from_IIterator_Visual( iface );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (iter->index >= iter->count) return E_BOUNDS;
+    IVisual_AddRef( (*value = iter->items[iter->index]) );
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_get_HasCurrent( IIterator_Visual *iface, boolean *value )
+{
+    struct visual_iterator *iter = impl_from_IIterator_Visual( iface );
+
+    if (!value) return E_POINTER;
+    *value = iter->index < iter->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_MoveNext( IIterator_Visual *iface, boolean *value )
+{
+    struct visual_iterator *iter = impl_from_IIterator_Visual( iface );
+
+    if (!value) return E_POINTER;
+    if (iter->index < iter->count) iter->index++;
+    *value = iter->index < iter->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI iterator_GetMany( IIterator_Visual *iface, UINT32 items_size, IVisual **items, UINT *count )
+{
+    struct visual_iterator *iter = impl_from_IIterator_Visual( iface );
+    UINT i;
+
+    if (!count) return E_POINTER;
+    for (i = 0; i < items_size && iter->index < iter->count; i++, iter->index++)
+        IVisual_AddRef( (items[i] = iter->items[iter->index]) );
+    *count = i;
+    return S_OK;
+}
