+/* the owner hears from its tracker on the compositor's thread, after the call that moved it returns */
+struct owner_call
+{
+    IDispatcherQueueHandler IDispatcherQueueHandler_iface;
+    LONG ref;
+    struct tracker *tracker;
+    struct tracker_args *args;
+};
+
+static inline struct owner_call *impl_from_IDispatcherQueueHandler( IDispatcherQueueHandler *iface )
+{
+    return CONTAINING_RECORD( iface, struct owner_call, IDispatcherQueueHandler_iface );
+}
+
+static HRESULT WINAPI owner_call_QueryInterface( IDispatcherQueueHandler *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IDispatcherQueueHandler ))
+    {
+        IDispatcherQueueHandler_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI owner_call_AddRef( IDispatcherQueueHandler *iface )
+{
+    struct owner_call *call = impl_from_IDispatcherQueueHandler( iface );
+    return InterlockedIncrement( &call->ref );
+}
+
+static ULONG WINAPI owner_call_Release( IDispatcherQueueHandler *iface )
+{
+    struct owner_call *call = impl_from_IDispatcherQueueHandler( iface );
+    ULONG ref = InterlockedDecrement( &call->ref );
+
+    if (!ref)
+    {
+        IInspectable_Release( &call->args->IInspectable_iface );
+        IInteractionTracker_Release( &call->tracker->IInteractionTracker_iface );
+        free( call );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI owner_call_Invoke( IDispatcherQueueHandler *iface )
+{
+    struct owner_call *call = impl_from_IDispatcherQueueHandler( iface );
+    IInteractionTracker *sender = &call->tracker->IInteractionTracker_iface;
+    IInteractionTrackerOwner *owner = call->tracker->owner;
+    struct tracker_args *args = call->args;
+
+    TRACE( "tracker %p, callback %u, request %d.\n", call->tracker, args->kind, args->request_id );
+
+    switch (args->kind)
+    {
+    case CALLBACK_VALUES_CHANGED:
+        return IInteractionTrackerOwner_ValuesChanged( owner, sender, &args->IInteractionTrackerValuesChangedArgs_iface );
+    case CALLBACK_IDLE:
+        return IInteractionTrackerOwner_IdleStateEntered( owner, sender, &args->IInteractionTrackerIdleStateEnteredArgs_iface );
+    case CALLBACK_REQUEST_IGNORED:
+        return IInteractionTrackerOwner_RequestIgnored( owner, sender, &args->IInteractionTrackerRequestIgnoredArgs_iface );
+    case CALLBACK_CUSTOM_ANIMATION:
+        return IInteractionTrackerOwner_CustomAnimationStateEntered( owner, sender,
+                &args->IInteractionTrackerCustomAnimationStateEnteredArgs_iface );
+    }
+    return S_OK;
+}
