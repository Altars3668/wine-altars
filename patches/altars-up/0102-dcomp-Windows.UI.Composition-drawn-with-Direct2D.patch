+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    /* what a nine-grid stretches is a color or a surface */
+    if (value && (!(source = unsafe_impl_from_ICompositionBrush( value )) || source->kind == BRUSH_NINE_GRID))
+    {
+        FIXME( "brush %p cannot be stretched.\n", value );
+        return E_INVALIDARG;
+    }
+    if (source) ICompositionBrush_AddRef( value );
+    compositor_lock( brush->base.compositor );
+    old = brush->source;
+    brush->source = source;
+    compositor_changed( brush->base.compositor );
+    compositor_unlock( brush->base.compositor );
+    if (old) ICompositionBrush_Release( &old->ICompositionBrush_iface );
+    return S_OK;
+}
