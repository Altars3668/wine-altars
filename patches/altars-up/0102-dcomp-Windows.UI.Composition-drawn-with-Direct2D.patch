+static HRESULT WINAPI graphics_add_RenderingDeviceReplaced( ICompositionGraphicsDevice *iface, __FITypedEventHandler_2_Windows__CUI__CComposition__CCompositionGraphicsDevice_Windows__CUI__CComposition__CRenderingDeviceReplacedEventArgs *handler, EventRegistrationToken *token )
+{
+    struct graphics_device *device = impl_from_ICompositionGraphicsDevice( iface );
+    struct replaced_handler *entry;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!handler || !token) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ITypedEventHandler_CompositionGraphicsDevice_RenderingDeviceReplacedEventArgs_AddRef( (entry->handler = handler) );
+    compositor_lock( device->base.compositor );
+    entry->token.value = ++device->next_token;
+    list_add_tail( &device->replaced_handlers, &entry->entry );
+    compositor_unlock( device->base.compositor );
+    *token = entry->token;
+    return S_OK;
