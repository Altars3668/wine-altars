+/* the surfaces lose their pixels, and whoever asked to be told is told to draw them again */
+static HRESULT WINAPI device_interop_SetRenderingDevice( ICompositionGraphicsDeviceInterop *iface, IUnknown *value )
+{
+    struct graphics_device *device = impl_from_ICompositionGraphicsDeviceInterop( iface );
+    ITypedEventHandler_CompositionGraphicsDevice_RenderingDeviceReplacedEventArgs **handlers = NULL;
+    IRenderingDeviceReplacedEventArgs *args;
+    struct replaced_handler *entry;
+    struct drawing_surface *surface;
+    unsigned int count = 0, i;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_INVALIDARG;
+
+    compositor_lock( device->base.compositor );
+    if (device->drawing)
+    {
+        compositor_changed( device->base.compositor );
+        compositor_unlock( device->base.compositor );
+        return DCOMPOSITION_ERROR_SURFACE_BEING_RENDERED;
+    }
+    LIST_FOR_EACH_ENTRY( surface, &device->surfaces, struct drawing_surface, device_entry )
+    {
+        surface_drop_tiles( surface );
+        if (surface->scratch) ID3D11Texture2D_Release( surface->scratch );
+        surface->scratch = NULL;
+    }
+    if (FAILED(hr = device_set_rendering_device( device, value )))
+    {
+        compositor_changed( device->base.compositor );
+        compositor_unlock( device->base.compositor );
+        return hr;
+    }
+    if ((handlers = calloc( list_count( &device->replaced_handlers ) + 1, sizeof(*handlers) )))
+    {
+        LIST_FOR_EACH_ENTRY( entry, &device->replaced_handlers, struct replaced_handler, entry )
+            ITypedEventHandler_CompositionGraphicsDevice_RenderingDeviceReplacedEventArgs_AddRef( (handlers[count++] = entry->handler) );
+    }
+    compositor_changed( device->base.compositor );
+    compositor_unlock( device->base.compositor );
+
+    if (count && SUCCEEDED(replaced_args_create( device, &args )))
+    {
+        for (i = 0; i < count; i++)
+            ITypedEventHandler_CompositionGraphicsDevice_RenderingDeviceReplacedEventArgs_Invoke( handlers[i],
+                    &device->ICompositionGraphicsDevice_iface, args );
+        IRenderingDeviceReplacedEventArgs_Release( args );
+    }
+    for (i = 0; i < count; i++) ITypedEventHandler_CompositionGraphicsDevice_RenderingDeviceReplacedEventArgs_Release( handlers[i] );
+    free( handlers );
+    return S_OK;
+}
+
+static const struct ICompositionGraphicsDeviceInteropVtbl device_interop_vtbl =
+{
+    device_interop_QueryInterface,
+    device_interop_AddRef,
+    device_interop_Release,
+    /* ICompositionGraphicsDeviceInterop methods */
+    device_interop_GetRenderingDevice,
+    device_interop_SetRenderingDevice,
+};
+
+HRESULT graphics_device_create( struct compositor *compositor, IUnknown *rendering_device, struct graphics_device **out )
+{
+    struct graphics_device *device;
+    HRESULT hr;
+
+    if (!(device = calloc( 1, sizeof(*device) ))) return E_OUTOFMEMORY;
+    list_init( &device->surfaces );
+    list_init( &device->replaced_handlers );
+    if (FAILED(hr = device_set_rendering_device( device, rendering_device )))
+    {
+        free( device );
+        return hr;
+    }
+    object_init( &device->base, &device_ops, compositor );
+    device->ICompositionGraphicsDevice_iface.lpVtbl = &graphics_vtbl;
+    device->ICompositionGraphicsDevice2_iface.lpVtbl = &graphics2_vtbl;
+    device->ICompositionGraphicsDevice3_iface.lpVtbl = &graphics3_vtbl;
+    device->ICompositionGraphicsDeviceInterop_iface.lpVtbl = &device_interop_vtbl;
+    *out = device;
+    return S_OK;
+}
diff --git a/dlls/dcomp/target.c b/dlls/dcomp/target.c
