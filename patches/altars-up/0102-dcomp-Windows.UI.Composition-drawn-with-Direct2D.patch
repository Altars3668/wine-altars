+HRESULT visual_create( struct compositor *compositor, enum visual_kind kind, struct visual **out )
+{
+    struct visual *visual;
+
+    if (!(visual = calloc( 1, sizeof(*visual) ))) return E_OUTOFMEMORY;
+    object_init( &visual->base, kind == VISUAL_SPRITE ? &sprite_visual_ops : &container_visual_ops, compositor );
+    visual->IVisual_iface.lpVtbl = &visual_vtbl;
+    visual->IVisual2_iface.lpVtbl = &visual2_vtbl;
+    visual->IVisual3_iface.lpVtbl = &visual3_vtbl;
+    visual->IVisual4_iface.lpVtbl = &visual4_vtbl;
+    visual->IContainerVisual_iface.lpVtbl = &container_vtbl;
+    visual->ISpriteVisual_iface.lpVtbl = &sprite_vtbl;
+    visual->ISpriteVisual2_iface.lpVtbl = &sprite2_vtbl;
+    visual->kind = kind;
+    list_init( &visual->children );
+
+    /* as Windows has them */
+    visual->props.scale.X = visual->props.scale.Y = visual->props.scale.Z = 1.0f;
+    visual->props.rotation_axis.Z = 1.0f;
+    visual->props.orientation.W = 1.0f;
+    visual->props.transform_matrix.M11 = visual->props.transform_matrix.M22 = 1.0f;
+    visual->props.transform_matrix.M33 = visual->props.transform_matrix.M44 = 1.0f;
+    visual->props.opacity = 1.0f;
+    visual->props.is_visible = TRUE;
+    visual->is_hit_test_visible = TRUE;
+
+    *out = visual;
+    return S_OK;
+}
