+static HRESULT WINAPI compositor5_get_Comment( ICompositor5 *iface, HSTRING *value )
+{
+    struct compositor *compositor = impl_from_ICompositor5( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( compositor );
+    hr = WindowsDuplicateString( compositor->comment, value );
+    compositor_unlock( compositor );
+    return hr;
+}
+
+static HRESULT WINAPI compositor5_put_Comment( ICompositor5 *iface, HSTRING value )
+{
+    struct compositor *compositor = impl_from_ICompositor5( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    compositor_lock( compositor );
+    WindowsDeleteString( compositor->comment );
+    compositor->comment = copy;
+    compositor_unlock( compositor );
+    return S_OK;
+}
