+    else if (brush->kind == BRUSH_NINE_GRID && IsEqualGUID( iid, &IID_ICompositionNineGridBrush ))
+        *out = &brush->ICompositionNineGridBrush_iface;
+    else if (brush->kind == BRUSH_COLOR && IsEqualGUID( iid, &IID_ICompositionColorBrush ))
+        *out = &brush->ICompositionColorBrush_iface;
+    else if (brush->kind == BRUSH_SURFACE && IsEqualGUID( iid, &IID_ICompositionSurfaceBrush ))
+        *out = &brush->ICompositionSurfaceBrush_iface;
+    else if (brush->kind == BRUSH_SURFACE && IsEqualGUID( iid, &IID_ICompositionSurfaceBrush2 ))
+        *out = &brush->ICompositionSurfaceBrush2_iface;
+    else if (brush->kind == BRUSH_SURFACE && IsEqualGUID( iid, &IID_ICompositionSurfaceBrush3 ))
+        *out = &brush->ICompositionSurfaceBrush3_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
