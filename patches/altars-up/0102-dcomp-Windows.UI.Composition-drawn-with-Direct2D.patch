+static BOOL source_get_value( struct object *object, const WCHAR *name, struct value *value )
+{
+    struct interaction_source *source = impl_from_source_object( object );
+
+    if (!wcsicmp( name, L"DeltaPosition" )) return value_vector3( value, source->delta_position );
+    if (!wcsicmp( name, L"DeltaScale" )) return value_scalar( value, source->delta_scale );
+    if (!wcsicmp( name, L"Position" )) return value_vector3( value, source->position );
+    if (!wcsicmp( name, L"PositionVelocity" )) return value_vector3( value, source->position_velocity );
+    if (!wcsicmp( name, L"Scale" )) return value_scalar( value, source->scale );
+    if (!wcsicmp( name, L"ScaleVelocity" )) return value_scalar( value, source->scale_velocity );
+    if (!wcsicmp( name, L"IsPositionXRailsEnabled" )) return value_boolean( value, source->x_rails );
+    if (!wcsicmp( name, L"IsPositionYRailsEnabled" )) return value_boolean( value, source->y_rails );
+    return FALSE;
+}
+
+/* what an animation may set: whether the rails are on */
+static BOOL source_set_value( struct object *object, const WCHAR *name, const struct value *value )
+{
+    struct interaction_source *source = impl_from_source_object( object );
+
+    if (!wcsicmp( name, L"IsPositionXRailsEnabled" )) return value_get_boolean( value, &source->x_rails );
+    if (!wcsicmp( name, L"IsPositionYRailsEnabled" )) return value_get_boolean( value, &source->y_rails );
+    return FALSE;
+}
