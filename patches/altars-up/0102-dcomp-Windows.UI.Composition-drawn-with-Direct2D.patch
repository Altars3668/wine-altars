+static void visual_destroy( struct object *object )
+{
+    struct visual *visual = impl_from_visual_object( object );
+
+    visual_detach_all( visual );
+    if (visual->clip) ICompositionClip_Release( visual->clip );
+    if (visual->brush) ICompositionBrush_Release( &visual->brush->ICompositionBrush_iface );
+    if (visual->shadow) ICompositionShadow_Release( visual->shadow );
+    if (visual->parent_for_transform) IVisual_Release( &visual->parent_for_transform->IVisual_iface );
