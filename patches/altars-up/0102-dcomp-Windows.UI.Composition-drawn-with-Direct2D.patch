+
+static BOOL brush_get_property( struct object *object, const WCHAR *name, struct value *value )
+{
+    struct brush *brush = impl_from_brush_object( object );
+    const struct property_desc *desc;
+
+    if (brush->kind == BRUSH_SURFACE && !wcsicmp( name, L"RotationAngleInDegrees" ))
+        return value_scalar( value, brush->props.rotation_angle * 180.0f / 3.14159265358979f );
+    if (!(desc = property_find( brush_properties( brush ), name ))) return FALSE;
+    return property_get( desc, &brush->props, value );
+}
+
+static BOOL brush_set_property( struct object *object, const WCHAR *name, const struct value *value )
+{
+    struct brush *brush = impl_from_brush_object( object );
+    const struct property_desc *desc;
+    float f;
+
+    if (brush->kind == BRUSH_SURFACE && !wcsicmp( name, L"RotationAngleInDegrees" ))
+    {
+        if (!value_get_scalar( value, &f )) return FALSE;
+        brush->props.rotation_angle = f * 3.14159265358979f / 180.0f;
+        return TRUE;
+    }
+    if (!(desc = property_find( brush_properties( brush ), name ))) return FALSE;
+    return property_set( desc, &brush->props, value );
+}
+
+/* called with the compositor locked */
+void brush_get_state( struct brush *brush, struct brush_state *state )
+{
+    const struct property_desc *desc;
+    struct value value;
+    float f;
+
+    *state = brush->props;
+    if (list_empty( &brush->base.animations )) return;
+    for (desc = brush_properties( brush ); desc->name; desc++)
+    {
+        property_get( desc, state, &value );
+        if (object_animate( &brush->base, desc->name, &value, 0 )) property_set( desc, state, &value );
+    }
+    if (brush->kind != BRUSH_SURFACE) return;
+    value_scalar( &value, state->rotation_angle * 180.0f / 3.14159265358979f );
+    if (object_animate( &brush->base, L"RotationAngleInDegrees", &value, 0 ) && value_get_scalar( &value, &f ))
+        state->rotation_angle = f * 3.14159265358979f / 180.0f;
+}
