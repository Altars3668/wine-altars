+static void test_compositor(void)
+{
+    static const DWORD pixels_before[] = {0, 0, 0, 0, 0, 0};
+    static const DWORD pixels_after[] = {0, 0x0000ff, 0x0000ff, 0x0000ff, 0, 0};
+    static const DWORD pixels_moved[] = {0, 0, 0, 0, 0, 0};
+    struct commit_needed commit_needed = {{&commit_needed_vtbl}};
+    IDesktopWindowTarget *target = NULL, *target2 = (void *)0xdeadbeef;
+    ICompositorController *controller;
+    ICompositorDesktopInterop *desktop;
+    ICompositor *compositor = NULL, *again;
+    ICompositionColorBrush *color;
+    ICompositionTarget *ctarget;
+    IContainerVisual *container;
+    IVisualCollection *children;
+    IVisual *visual, *sprite_visual;
+    ICompositionBrush *brush;
+    ISpriteVisual *sprite;
+    EventRegistrationToken token;
+    Vector2 v2;
+    Vector3 v3;
+    INT32 count;
+    boolean b;
+    FLOAT f;
+    Color c;
+    HWND hwnd;
+    HRESULT hr;
+
+    if (!(controller = create_controller( &compositor ))) return;
+    commit_needed.thread_id = GetCurrentThreadId();
+
+    check_class( controller, L"Windows.UI.Composition.Core.CompositorController" );
+    check_interface( controller, &IID_IAgileObject, TRUE );
+    check_interface( controller, &IID_IClosable, TRUE );
+    check_class( compositor, L"Windows.UI.Composition.Compositor" );
+    check_interface( compositor, &IID_ICompositor2, TRUE );
+    check_interface( compositor, &IID_ICompositor5, TRUE );
+    check_interface( compositor, &IID_ICompositor6, TRUE );
+    check_interface( compositor, &IID_ICompositorInterop, TRUE );
+    check_interface( compositor, &IID_ICompositorDesktopInterop, TRUE );
+    check_interface( compositor, &IID_ICompositionObject, FALSE );
+    check_interface( compositor, &IID_IAgileObject, TRUE );
+    check_interface( compositor, &IID_IClosable, TRUE );
+    hr = ICompositorController_get_Compositor( controller, &again );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( again == compositor, "got another compositor.\n" );
+    ICompositor_Release( again );
+
+    /* a new compositor has its first commit to make, and says so on its thread */
+    hr = ICompositorController_add_CommitNeeded( controller, &commit_needed.ITypedEventHandler_CompositorController_IInspectable_iface, &token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    pump_messages( 200 );
+    ok( commit_needed.count == 1, "CommitNeeded raised %ld times.\n", commit_needed.count );
+    hr = ICompositorController_Commit( controller );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    /* one target to a window */
+    hwnd = create_window();
+    pump_messages( 100 );
+    ICompositor_QueryInterface( compositor, &IID_ICompositorDesktopInterop, (void **)&desktop );
+    hr = ICompositorDesktopInterop_CreateDesktopWindowTarget( desktop, hwnd, FALSE, &target );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( target, L"Windows.UI.Composition.Desktop.DesktopWindowTarget" );
+    hr = ICompositorDesktopInterop_CreateDesktopWindowTarget( desktop, hwnd, FALSE, &target2 );
+    ok( hr == DCOMPOSITION_ERROR_WINDOW_ALREADY_COMPOSED, "got hr %#lx.\n", hr );
+    ok( !target2, "got target %p.\n", target2 );
+    hr = ICompositorDesktopInterop_CreateDesktopWindowTarget( desktop, NULL, FALSE, &target2 );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    b = 2;
+    IDesktopWindowTarget_get_IsTopmost( target, &b );
+    ok( !b, "got IsTopmost %d.\n", b );
+    check_interface( target, &IID_ICompositionTarget, TRUE );
+    check_interface( target, &IID_IDesktopWindowTargetInterop, TRUE );
+    check_interface( target, &IID_ICompositionObject, TRUE );
+    ICompositorDesktopInterop_Release( desktop );
+
+    /* what a visual starts as */
+    hr = ICompositor_CreateContainerVisual( compositor, &container );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( container, L"Windows.UI.Composition.ContainerVisual" );
+    IContainerVisual_QueryInterface( container, &IID_IVisual, (void **)&visual );
+    IVisual_get_Size( visual, &v2 );
+    ok( !v2.X && !v2.Y, "got size %f,%f.\n", v2.X, v2.Y );
+    IVisual_get_Offset( visual, &v3 );
+    ok( !v3.X && !v3.Y && !v3.Z, "got offset %f,%f,%f.\n", v3.X, v3.Y, v3.Z );
+    IVisual_get_Opacity( visual, &f );
+    ok( f == 1.0f, "got opacity %f.\n", f );
+    IVisual_get_IsVisible( visual, &b );
+    ok( b == TRUE, "got IsVisible %d.\n", b );
+    IVisual_get_Scale( visual, &v3 );
+    ok( v3.X == 1.0f && v3.Y == 1.0f && v3.Z == 1.0f, "got scale %f,%f,%f.\n", v3.X, v3.Y, v3.Z );
+    IVisual_get_AnchorPoint( visual, &v2 );
+    ok( !v2.X && !v2.Y, "got anchor point %f,%f.\n", v2.X, v2.Y );
+    IVisual_get_RotationAngle( visual, &f );
+    ok( !f, "got rotation angle %f.\n", f );
+    v2.X = 300; v2.Y = 200;
+    IVisual_put_Size( visual, v2 );
+
+    hr = ICompositor_CreateSpriteVisual( compositor, &sprite );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ISpriteVisual_QueryInterface( sprite, &IID_IVisual, (void **)&sprite_visual );
+    v2.X = 100; v2.Y = 100;
+    IVisual_put_Size( sprite_visual, v2 );
+    v3.X = 10; v3.Y = 10; v3.Z = 0;
+    IVisual_put_Offset( sprite_visual, v3 );
+    c.A = 255; c.R = 255; c.G = 0; c.B = 0;
+    hr = ICompositor_CreateColorBrushWithColor( compositor, c, &color );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( color, L"Windows.UI.Composition.CompositionColorBrush" );
+    ICompositionColorBrush_QueryInterface( color, &IID_ICompositionBrush, (void **)&brush );
+    hr = ISpriteVisual_put_Brush( sprite, brush );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    IContainerVisual_get_Children( container, &children );
+    hr = IVisualCollection_InsertAtTop( children, sprite_visual );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    count = -1;
+    IVisualCollection_get_Count( children, &count );
+    ok( count == 1, "got count %d.\n", count );
+    check_interface( children, &IID_IIterable_Visual, TRUE );
+
+    IDesktopWindowTarget_QueryInterface( target, &IID_ICompositionTarget, (void **)&ctarget );
+    hr = ICompositionTarget_put_Root( ctarget, visual );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    /* what is drawn changes with a commit, and only then */
+    check_pixels( hwnd, pixels_before );
+    hr = ICompositorController_Commit( controller );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    pump_messages( 300 );
+    check_pixels( hwnd, pixels_after );
+    v3.X = 150; v3.Y = 50;
+    IVisual_put_Offset( sprite_visual, v3 );
+    pump_messages( 300 );
+    check_pixels( hwnd, pixels_after );
+    ICompositorController_Commit( controller );
+    pump_messages( 300 );
+    check_pixels( hwnd, pixels_moved );
+
+    hr = ICompositorController_remove_CommitNeeded( controller, token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    ICompositionTarget_Release( ctarget );
+    IVisualCollection_Release( children );
+    ICompositionBrush_Release( brush );
+    ICompositionColorBrush_Release( color );
+    IVisual_Release( sprite_visual );
+    ISpriteVisual_Release( sprite );
+    IVisual_Release( visual );
+    IContainerVisual_Release( container );
+    IDesktopWindowTarget_Release( target );
+    DestroyWindow( hwnd );
+    ICompositor_Release( compositor );
+    ICompositorController_Release( controller );
+}
