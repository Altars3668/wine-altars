+static const struct property_desc *brush_properties( const struct brush *brush )
+{
+    switch (brush->kind)
+    {
+    case BRUSH_COLOR: return color_brush_properties;
+    case BRUSH_NINE_GRID: return nine_grid_brush_properties;
+    default: return surface_brush_properties;
+    }
