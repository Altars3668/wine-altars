+static HRESULT visual_collection_create( struct visual *owner, IVisualCollection **out )
+{
+    struct visual_collection *collection;
+
+    if (!(collection = calloc( 1, sizeof(*collection) ))) return E_OUTOFMEMORY;
+    object_init( &collection->base, &collection_ops, owner->base.compositor );
+    collection->IVisualCollection_iface.lpVtbl = &collection_vtbl;
+    collection->IIterable_Visual_iface.lpVtbl = &iterable_vtbl;
+    IVisual_AddRef( &owner->IVisual_iface );
+    collection->owner = owner;
+    *out = &collection->IVisualCollection_iface;
+    return S_OK;
+}
