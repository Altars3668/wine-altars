+static void test_interactions(void)
+{
+    ICompositionInteractionSourceCollection *sources;
+    IVisualInteractionSourceStatics *source_statics;
+    IInteractionTrackerStatics *tracker_statics;
+    IVisualInteractionSource *source, *source2;
+    IInteractionSourceConfiguration *config;
+    ICompositionInteractionSource *isource;
+    IVisualInteractionSource2 *source2_iface;
+    IVisualInteractionSource3 *source3;
+    IDispatcherQueueController *queue;
+    ICompositorController *controller;
+    InteractionSourceRedirectionMode redirect;
+    VisualInteractionSourceRedirectionMode mode;
+    IInteractionTrackerOwner *owner;
+    IInteractionTracker *tracker;
+    InteractionChainingMode chaining;
+    IReference_Vector3 *decay;
+    IContainerVisual *container;
+    ICompositor *compositor;
+    IVisual *visual, *got;
+    INT32 count, id;
+    HSTRING str;
+    Vector3 v3;
+    boolean b;
+    FLOAT f;
+    HRESULT hr;
+
+    queue = create_queue( DQTAT_COM_STA );
+    if (!(controller = create_controller( &compositor ))) goto done;
+    ICompositor_CreateContainerVisual( compositor, &container );
+    IContainerVisual_QueryInterface( container, &IID_IVisual, (void **)&visual );
+
+    str = hstring( L"Windows.UI.Composition.Interactions.VisualInteractionSource" );
+    hr = RoGetActivationFactory( str, &IID_IVisualInteractionSourceStatics, (void **)&source_statics );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_interface( source_statics, &IID_IVisualInteractionSourceStatics2, TRUE );
+    source = (void *)0xdeadbeef;
+    hr = IVisualInteractionSourceStatics_Create( source_statics, NULL, &source );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ok( !source, "got source %p.\n", source );
+    hr = IVisualInteractionSourceStatics_Create( source_statics, visual, &source );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( source, L"Windows.UI.Composition.Interactions.VisualInteractionSource" );
+    /* one to a visual */
+    hr = IVisualInteractionSourceStatics_Create( source_statics, visual, &source2 );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    check_interface( source, &IID_ICompositionInteractionSource, TRUE );
+    check_interface( source, &IID_ICompositionObject, TRUE );
+    check_interface( source, &IID_IVisualInteractionSourceInterop, TRUE );
+    check_interface( source, &IID_IAgileObject, TRUE );
+    IVisualInteractionSource_get_Source( source, &got );
+    ok( got == visual, "got source visual %p.\n", got );
+    IVisual_Release( got );
+    b = 2;
+    IVisualInteractionSource_get_IsPositionXRailsEnabled( source, &b );
+    ok( b == TRUE, "got IsPositionXRailsEnabled %d.\n", b );
+    b = 2;
+    IVisualInteractionSource_get_IsPositionYRailsEnabled( source, &b );
+    ok( b == TRUE, "got IsPositionYRailsEnabled %d.\n", b );
+    mode = -1;
+    IVisualInteractionSource_get_ManipulationRedirectionMode( source, &mode );
+    ok( mode == VisualInteractionSourceRedirectionMode_CapableTouchpadOnly, "got redirection mode %d.\n", mode );
+    chaining = -1;
+    IVisualInteractionSource_get_PositionXChainingMode( source, &chaining );
+    ok( chaining == InteractionChainingMode_Auto, "got chaining mode %d.\n", chaining );
+    hr = IVisualInteractionSource_TryRedirectForManipulation( source, NULL );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    IVisualInteractionSource_QueryInterface( source, &IID_IVisualInteractionSource2, (void **)&source2_iface );
+    IVisualInteractionSource2_get_Scale( source2_iface, &f );
+    ok( !f, "got scale %f.\n", f );
+    hr = IVisualInteractionSource2_ConfigureDeltaPositionXModifiers( source2_iface, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IVisualInteractionSource2_Release( source2_iface );
+    IVisualInteractionSource_QueryInterface( source, &IID_IVisualInteractionSource3, (void **)&source3 );
+    hr = IVisualInteractionSource3_get_PointerWheelConfig( source3, &config );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( config, L"Windows.UI.Composition.Interactions.InteractionSourceConfiguration" );
+    redirect = -1;
+    IInteractionSourceConfiguration_get_PositionYSourceMode( config, &redirect );
+    ok( redirect == InteractionSourceRedirectionMode_Enabled, "got mode %d.\n", redirect );
+    IInteractionSourceConfiguration_Release( config );
+    IVisualInteractionSource3_Release( source3 );
+
+    str = hstring( L"Windows.UI.Composition.Interactions.InteractionTracker" );
+    hr = RoGetActivationFactory( str, &IID_IInteractionTrackerStatics, (void **)&tracker_statics );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IInteractionTrackerStatics_Create( tracker_statics, NULL, &tracker );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IInteractionTrackerStatics_Create( tracker_statics, compositor, &tracker );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( tracker, L"Windows.UI.Composition.Interactions.InteractionTracker" );
+    check_interface( tracker, &IID_IInteractionTracker5, TRUE );
+    check_interface( tracker, &IID_ICompositionInteractionSource, FALSE );
+    IInteractionTracker_get_Scale( tracker, &f );
+    ok( f == 1.0f, "got scale %f.\n", f );
+    IInteractionTracker_get_NaturalRestingScale( tracker, &f );
+    ok( !f, "got natural resting scale %f.\n", f );
+    IInteractionTracker_get_ScaleVelocityInPercentPerSecond( tracker, &f );
+    ok( f == 1.0f, "got scale velocity %f.\n", f );
+    IInteractionTracker_get_MaxPosition( tracker, &v3 );
+    ok( !v3.X && !v3.Y && !v3.Z, "got max position %f,%f,%f.\n", v3.X, v3.Y, v3.Z );
+    decay = (void *)0xdeadbeef;
+    IInteractionTracker_get_PositionInertiaDecayRate( tracker, &decay );
+    ok( !decay, "got decay rate %p.\n", decay );
+    owner = (void *)0xdeadbeef;
+    IInteractionTracker_get_Owner( tracker, &owner );
+    ok( !owner, "got owner %p.\n", owner );
+
+    hr = IInteractionTracker_get_InteractionSources( tracker, &sources );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( sources, L"Windows.UI.Composition.Interactions.CompositionInteractionSourceCollection" );
+    IVisualInteractionSource_QueryInterface( source, &IID_ICompositionInteractionSource, (void **)&isource );
+    hr = ICompositionInteractionSourceCollection_Add( sources, isource );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionInteractionSourceCollection_Add( sources, isource );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    count = -1;
+    ICompositionInteractionSourceCollection_get_Count( sources, &count );
+    ok( count == 1, "got count %d.\n", count );
+    hr = ICompositionInteractionSourceCollection_Remove( sources, isource );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionInteractionSourceCollection_Remove( sources, isource );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = ICompositionInteractionSourceCollection_Add( sources, isource );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionInteractionSourceCollection_Add( sources, NULL );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    /* what changes the tracker takes request numbers, three before this one */
+    hr = IInteractionTracker_TryUpdatePosition( tracker, (Vector3){30, 20, 0}, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( id == 4, "got request %d.\n", id );
+    ICompositionInteractionSource_Release( isource );
+    ICompositionInteractionSourceCollection_Release( sources );
+
+    IInteractionTracker_Release( tracker );
+    IInteractionTrackerStatics_Release( tracker_statics );
+    IVisualInteractionSource_Release( source );
+    IVisualInteractionSourceStatics_Release( source_statics );
+    IVisual_Release( visual );
+    IContainerVisual_Release( container );
+    ICompositor_Release( compositor );
+    ICompositorController_Release( controller );
+done:
+    if (queue) IDispatcherQueueController_Release( queue );
+}
+
+START_TEST(composition)
+{
+    IDispatcherQueueController *queue;
+
+    test_activation();
+
+    RoInitialize( RO_INIT_SINGLETHREADED );
+    queue = create_queue( DQTAT_COM_STA );
+    test_compositor();
+    if (queue) IDispatcherQueueController_Release( queue );
+    test_animations();
+    test_property_sets();
+    test_easing_and_batches();
+    test_interactions();
+    RoUninitialize();
+}
