+    InteractionChainingMode x_chaining, y_chaining, scale_chaining;
+    InteractionSourceMode x_mode, y_mode, scale_mode;
+    Vector3 delta_position, position, position_velocity;
+    FLOAT delta_scale, scale, scale_velocity;
+};
