+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+static inline struct object *impl_from_ICompositionObject( ICompositionObject *iface )
+{
+    return CONTAINING_RECORD( iface, struct object, ICompositionObject_iface );
+}
+
+IInspectable *object_inspectable( struct object *object )
+{
+    return (IInspectable *)&object->ICompositionObject_iface;
+}
+
+static const struct ICompositionObjectVtbl object_vtbl;
+
+struct object *unsafe_impl_from_ICompositionObject( ICompositionObject *iface )
+{
+    if (!iface || iface->lpVtbl != &object_vtbl) return NULL;
+    return impl_from_ICompositionObject( iface );
+}
+
+/*
+ * What a property of an object is now: what it was set to, or what its
+ * animation makes of that.  A name the object does not know may be one it was
+ * given in its property set.  Called with the compositor locked.
+ */
+BOOL object_get_value( struct object *object, const WCHAR *name, struct value *value, int depth )
+{
+    if (object->ops->get_property && object->ops->get_property( object, name, value ))
+    {
+        object_animate( object, name, value, depth );
+        return TRUE;
+    }
+    /* an animation of one of those is the object's own */
+    if (object->properties && object_get_value( object->properties, name, value, depth ))
+    {
+        object_animate( object, name, value, depth );
+        return TRUE;
+    }
+    WARN( "%s %p has no property %s.\n", debugstr_w( object->ops->class_name ), object, debugstr_w( name ) );
+    return FALSE;
+}
+
+/* sets a property, or a member of one, of the object or of its property set; called with the compositor locked */
+BOOL object_set_value( struct object *object, const WCHAR *name, const WCHAR *member, const struct value *value )
+{
+    struct object *target = object;
+    struct value whole;
+
+    if (!object->ops->get_property || !object->ops->get_property( object, name, &whole ))
+    {
+        if (!(target = object->properties) || !target->ops->get_property( target, name, &whole )) return FALSE;
+    }
+    if (member)
+    {
+        if (!value_set_member( &whole, member, value )) return FALSE;
+        value = &whole;
+    }
+    return target->ops->set_property && target->ops->set_property( target, name, value );
+}
+
+/* a property, or a member of one such as Offset.X */
+BOOL object_has_property( struct object *object, const WCHAR *name )
+{
+    const WCHAR *dot = wcschr( name, '.' );
+    WCHAR buffer[64];
+    struct value value;
+
+    if (dot)
+    {
+        if (dot - name >= ARRAY_SIZE(buffer)) return FALSE;
+        memcpy( buffer, name, (dot - name) * sizeof(WCHAR) );
+        buffer[dot - name] = 0;
+        name = buffer;
+    }
+    if (object->ops->get_property && object->ops->get_property( object, name, &value )) return TRUE;
+    return object->properties && object_has_property( object->properties, name );
+}
+
+HRESULT object_query_interface( struct object *object, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ICompositionObject ))
+    {
+        IInspectable_AddRef( (*out = &object->ICompositionObject_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_ICompositionObject2 ))
+    {
+        IInspectable_AddRef( (*out = &object->ICompositionObject2_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_ICompositionObject3 ))
+    {
+        IInspectable_AddRef( (*out = &object->ICompositionObject3_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_ICompositionObject4 ))
+    {
+        IInspectable_AddRef( (*out = &object->ICompositionObject4_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        IInspectable_AddRef( (*out = &object->IClosable_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s %s not implemented, returning E_NOINTERFACE.\n", debugstr_w( object->ops->class_name ),
+           debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+ULONG object_addref( struct object *object )
+{
+    ULONG ref = InterlockedIncrement( &object->ref );
+    TRACE( "%s %p, ref %lu.\n", debugstr_w( object->ops->class_name ), object, ref );
+    return ref;
+}
+
+ULONG object_release( struct object *object )
+{
+    ULONG ref = InterlockedDecrement( &object->ref );
+    struct compositor *compositor = object->compositor;
+
+    TRACE( "%s %p, ref %lu.\n", debugstr_w( object->ops->class_name ), object, ref );
+
+    if (!ref)
+    {
+        struct object *properties;
+
+        compositor_lock( compositor );
+        if (!object->closed && object->ops->close) object->ops->close( object );
+        object->closed = TRUE;
+        object_stop_animations( object );
+        properties = object->properties;
+        object->properties = NULL;
+        compositor_unlock( compositor );
+        if (properties) object_release( properties );
+        WindowsDeleteString( object->comment );
+        object->ops->destroy( object );
+        compositor_release( compositor );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI object_QueryInterface( ICompositionObject *iface, REFIID iid, void **out )
+{
+    struct object *object = impl_from_ICompositionObject( iface );
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    return object->ops->query_interface( object, iid, out );
+}
+
+static ULONG WINAPI object_AddRef( ICompositionObject *iface )
+{
+    return object_addref( impl_from_ICompositionObject( iface ) );
+}
+
+static ULONG WINAPI object_Release( ICompositionObject *iface )
+{
+    return object_release( impl_from_ICompositionObject( iface ) );
+}
+
+static HRESULT WINAPI object_GetIids( ICompositionObject *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI object_GetRuntimeClassName( ICompositionObject *iface, HSTRING *class_name )
+{
+    struct object *object = impl_from_ICompositionObject( iface );
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( object->ops->class_name, wcslen( object->ops->class_name ), class_name );
+}
+
+static HRESULT WINAPI object_GetTrustLevel( ICompositionObject *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI object_get_Compositor( ICompositionObject *iface, ICompositor **value )
+{
+    struct object *object = impl_from_ICompositionObject( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    ICompositor_AddRef( (*value = compositor_iface( object->compositor )) );
+    return S_OK;
+}
+
+/* a compositor of a thread with a dispatcher queue has no core dispatcher */
+static HRESULT WINAPI object_get_Dispatcher( ICompositionObject *iface, ICoreDispatcher **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+/* every object has a property set of its own, which expressions reach through it too */
+static HRESULT WINAPI object_get_Properties( ICompositionObject *iface, ICompositionPropertySet **value )
+{
+    struct object *object = impl_from_ICompositionObject( iface ), *properties = NULL;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( object->compositor );
+    if (!object->properties && SUCCEEDED(hr = property_set_create( object->compositor, &properties )))
+        object->properties = properties;
+    if (object->properties)
+        hr = IInspectable_QueryInterface( object_inspectable( object->properties ), &IID_ICompositionPropertySet,
+                                          (void **)value );
+    compositor_unlock( object->compositor );
+    return hr;
+}
+
+static HRESULT WINAPI object_StartAnimation( ICompositionObject *iface, HSTRING property, ICompositionAnimation *animation )
+{
+    struct object *object = impl_from_ICompositionObject( iface );
+    TRACE( "iface %p, property %s, animation %p.\n", iface, debugstr_hstring( property ), animation );
+    return object_start_animation( object, property, animation );
+}
+
+static HRESULT WINAPI object_StopAnimation( ICompositionObject *iface, HSTRING property )
+{
+    struct object *object = impl_from_ICompositionObject( iface );
+    TRACE( "iface %p, property %s.\n", iface, debugstr_hstring( property ) );
+    return object_stop_animation( object, property );
+}
+
+static const struct ICompositionObjectVtbl object_vtbl =
+{
+    object_QueryInterface,
+    object_AddRef,
+    object_Release,
+    /* IInspectable methods */
+    object_GetIids,
+    object_GetRuntimeClassName,
+    object_GetTrustLevel,
+    /* ICompositionObject methods */
+    object_get_Compositor,
+    object_get_Dispatcher,
+    object_get_Properties,
+    object_StartAnimation,
+    object_StopAnimation,
+};
+
+DEFINE_IINSPECTABLE( object2, ICompositionObject2, struct object, ICompositionObject_iface )
+
+static HRESULT WINAPI object2_get_Comment( ICompositionObject2 *iface, HSTRING *value )
+{
+    struct object *object = impl_from_ICompositionObject2( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( object->compositor );
+    hr = WindowsDuplicateString( object->comment, value );
+    compositor_unlock( object->compositor );
+    return hr;
+}
+
+static HRESULT WINAPI object2_put_Comment( ICompositionObject2 *iface, HSTRING value )
+{
+    struct object *object = impl_from_ICompositionObject2( iface );
+    HSTRING copy;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    compositor_lock( object->compositor );
+    WindowsDeleteString( object->comment );
+    object->comment = copy;
+    compositor_unlock( object->compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI object2_get_ImplicitAnimations( ICompositionObject2 *iface, IImplicitAnimationCollection **value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI object2_put_ImplicitAnimations( ICompositionObject2 *iface, IImplicitAnimationCollection *value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI object2_StartAnimationGroup( ICompositionObject2 *iface, ICompositionAnimationBase *value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI object2_StopAnimationGroup( ICompositionObject2 *iface, ICompositionAnimationBase *value )
+{
+    FIXME( "iface %p, value %p stub!\n", iface, value );
+    return E_NOTIMPL;
+}
+
+static const struct ICompositionObject2Vtbl object2_vtbl =
+{
+    object2_QueryInterface,
+    object2_AddRef,
+    object2_Release,
+    /* IInspectable methods */
+    object2_GetIids,
+    object2_GetRuntimeClassName,
+    object2_GetTrustLevel,
+    /* ICompositionObject2 methods */
+    object2_get_Comment,
+    object2_put_Comment,
+    object2_get_ImplicitAnimations,
+    object2_put_ImplicitAnimations,
+    object2_StartAnimationGroup,
+    object2_StopAnimationGroup,
+};
+
+DEFINE_IINSPECTABLE( object3, ICompositionObject3, struct object, ICompositionObject_iface )
+
+static HRESULT WINAPI object3_get_DispatcherQueue( ICompositionObject3 *iface, IDispatcherQueue **value )
+{
+    struct object *object = impl_from_ICompositionObject3( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if ((*value = compositor_dispatcher_queue( object->compositor ))) IDispatcherQueue_AddRef( *value );
+    return S_OK;
+}
+
+static const struct ICompositionObject3Vtbl object3_vtbl =
+{
+    object3_QueryInterface,
+    object3_AddRef,
+    object3_Release,
+    /* IInspectable methods */
+    object3_GetIids,
+    object3_GetRuntimeClassName,
+    object3_GetTrustLevel,
+    /* ICompositionObject3 methods */
+    object3_get_DispatcherQueue,
+};
+
+DEFINE_IINSPECTABLE( object4, ICompositionObject4, struct object, ICompositionObject_iface )
+
+static HRESULT WINAPI object4_TryGetAnimationController( ICompositionObject4 *iface, HSTRING property,
+                                                         IAnimationController **result )
+{
+    FIXME( "iface %p, property %s, result %p stub!\n", iface, debugstr_hstring( property ), result );
+    return E_NOTIMPL;
+}
+
+static const struct ICompositionObject4Vtbl object4_vtbl =
+{
+    object4_QueryInterface,
+    object4_AddRef,
+    object4_Release,
+    /* IInspectable methods */
+    object4_GetIids,
+    object4_GetRuntimeClassName,
+    object4_GetTrustLevel,
+    /* ICompositionObject4 methods */
+    object4_TryGetAnimationController,
+};
+
+DEFINE_IINSPECTABLE( object_closable, IClosable, struct object, ICompositionObject_iface )
+
+static HRESULT WINAPI object_closable_Close( IClosable *iface )
+{
+    struct object *object = impl_from_IClosable( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    compositor_lock( object->compositor );
+    if (!object->closed)
+    {
+        object->closed = TRUE;
+        if (object->ops->close) object->ops->close( object );
+    }
+    compositor_unlock( object->compositor );
+    return S_OK;
+}
+
+static const struct IClosableVtbl object_closable_vtbl =
+{
+    object_closable_QueryInterface,
+    object_closable_AddRef,
+    object_closable_Release,
+    /* IInspectable methods */
+    object_closable_GetIids,
+    object_closable_GetRuntimeClassName,
+    object_closable_GetTrustLevel,
+    /* IClosable methods */
+    object_closable_Close,
+};
+
+void object_init( struct object *object, const struct object_ops *ops, struct compositor *compositor )
+{
+    object->ICompositionObject_iface.lpVtbl = &object_vtbl;
+    object->ICompositionObject2_iface.lpVtbl = &object2_vtbl;
+    object->ICompositionObject3_iface.lpVtbl = &object3_vtbl;
+    object->ICompositionObject4_iface.lpVtbl = &object4_vtbl;
+    object->IClosable_iface.lpVtbl = &object_closable_vtbl;
+    object->ops = ops;
+    object->ref = 1;
+    object->compositor = compositor;
+    list_init( &object->animations );
+    compositor_add_ref( compositor );
+}
