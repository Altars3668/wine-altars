+static HRESULT visual_collection_create( struct visual *owner, IVisualCollection **out );
+
+static inline struct visual *impl_from_visual_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct visual, base );
+}
+
+static HRESULT visual_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct visual *visual = impl_from_visual_object( object );
+
+    if (IsEqualGUID( iid, &IID_IVisual )) *out = &visual->IVisual_iface;
+    else if (IsEqualGUID( iid, &IID_IVisual2 )) *out = &visual->IVisual2_iface;
+    else if (IsEqualGUID( iid, &IID_IVisual3 )) *out = &visual->IVisual3_iface;
+    else if (IsEqualGUID( iid, &IID_IVisual4 )) *out = &visual->IVisual4_iface;
+    else if (IsEqualGUID( iid, &IID_IContainerVisual )) *out = &visual->IContainerVisual_iface;
+    else if (visual->kind == VISUAL_SPRITE && IsEqualGUID( iid, &IID_ISpriteVisual )) *out = &visual->ISpriteVisual_iface;
