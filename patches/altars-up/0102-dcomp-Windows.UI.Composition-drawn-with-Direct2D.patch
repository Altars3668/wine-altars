+HRESULT clip_create( struct compositor *compositor, BOOL inset, ICompositionClip **out )
+{
+    struct clip *clip;
+
+    if (!(clip = calloc( 1, sizeof(*clip) ))) return E_OUTOFMEMORY;
+    object_init( &clip->base, inset ? &inset_clip_ops : &rectangle_clip_ops, compositor );
+    clip->ICompositionClip_iface.lpVtbl = &clip_vtbl;
+    clip->ICompositionClip2_iface.lpVtbl = &clip2_vtbl;
+    clip->IInsetClip_iface.lpVtbl = &inset_vtbl;
+    clip->IRectangleClip_iface.lpVtbl = &rectangle_vtbl;
+    clip->kind = inset ? CLIP_INSET : CLIP_RECTANGLE;
+    clip->props.scale.X = clip->props.scale.Y = 1.0f;
+    clip->props.transform_matrix.M11 = clip->props.transform_matrix.M22 = 1.0f;
+    *out = &clip->ICompositionClip_iface;
+    return S_OK;
+}
+
+HRESULT clip_set_sides( ICompositionClip *iface, FLOAT left, FLOAT top, FLOAT right, FLOAT bottom, const Vector2 *radius )
+{
