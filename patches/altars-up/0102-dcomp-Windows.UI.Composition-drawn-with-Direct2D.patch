+static HRESULT WINAPI collection_Remove( IVisualCollection *iface, IVisual *child )
+{
+    struct visual_collection *collection = impl_from_IVisualCollection( iface );
+    struct visual *visual = child ? unsafe_impl_from_IVisual( child ) : NULL;
