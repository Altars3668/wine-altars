+    else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Interactions_InteractionTrackerInertiaMotion ))
+        IActivationFactory_QueryInterface( inertia_motion_factory, &IID_IActivationFactory, (void **)factory );
+
+    if (*factory) return S_OK;
+    FIXME( "class %s not implemented.\n", debugstr_hstring( classid ) );
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
