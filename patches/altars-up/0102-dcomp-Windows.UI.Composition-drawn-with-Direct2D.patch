+HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **factory )
+{
+    const WCHAR *name = WindowsGetStringRawBuffer( classid, NULL );
+
+    TRACE( "classid %s, factory %p.\n", debugstr_hstring( classid ), factory );
+
+    *factory = NULL;
+    if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Core_CompositorController ))
+        IActivationFactory_QueryInterface( compositor_controller_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Compositor ))
+        IActivationFactory_QueryInterface( compositor_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Interactions_VisualInteractionSource ))
+        IActivationFactory_QueryInterface( interaction_source_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Interactions_InteractionTracker ))
+        IActivationFactory_QueryInterface( interaction_tracker_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Interactions_CompositionConditionalValue ))
+        IActivationFactory_QueryInterface( conditional_value_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Interactions_InteractionTrackerInertiaRestingValue ))
