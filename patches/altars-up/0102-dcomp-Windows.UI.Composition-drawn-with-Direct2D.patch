+static const struct object_ops collection_ops =
+{
+    L"Windows.UI.Composition.VisualCollection",
+    collection_query_interface,
+    collection_destroy,
+};
+
+enum insert_where
+{
+    INSERT_AT_TOP,
+    INSERT_AT_BOTTOM,
+    INSERT_ABOVE,
+    INSERT_BELOW,
+};
+
+/* the children are listed bottom first: the last one is drawn over the others */
+static HRESULT collection_insert( struct visual_collection *collection, IVisual *child_iface, IVisual *sibling_iface,
+                                  enum insert_where where )
+{
+    struct visual *owner = collection->owner, *child, *sibling = NULL;
+
+    if (!child_iface || !(child = unsafe_impl_from_IVisual( child_iface ))) return E_INVALIDARG;
+    if ((where == INSERT_ABOVE || where == INSERT_BELOW) &&
+        (!sibling_iface || !(sibling = unsafe_impl_from_IVisual( sibling_iface ))))
+        return E_INVALIDARG;
+    if (child == owner) return E_INVALIDARG;
+
+    compositor_lock( owner->base.compositor );
+    if (child->parent || (sibling && sibling->parent != owner))
+    {
+        compositor_changed( owner->base.compositor );
+        compositor_unlock( owner->base.compositor );
+        WARN( "child %p already has a parent %p, or sibling %p is not ours.\n", child, child->parent, sibling );
+        return E_INVALIDARG;
+    }
+    IVisual_AddRef( &child->IVisual_iface );
+    child->parent = owner;
+    switch (where)
+    {
+    case INSERT_AT_TOP: list_add_tail( &owner->children, &child->entry ); break;
+    case INSERT_AT_BOTTOM: list_add_head( &owner->children, &child->entry ); break;
+    case INSERT_ABOVE: list_add_after( &sibling->entry, &child->entry ); break;
+    case INSERT_BELOW: list_add_before( &sibling->entry, &child->entry ); break;
+    }
+    compositor_changed( owner->base.compositor );
+    compositor_unlock( owner->base.compositor );
+    return S_OK;
+}
+
