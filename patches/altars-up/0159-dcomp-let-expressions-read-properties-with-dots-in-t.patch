From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 14:43:06 -0400
Subject: [PATCH] dcomp: let expressions read properties with dots in their
 names

PowerPoint ties the amounts of its cross fade together with the expression
1-CompObj.Crossfade.Source2Amount, CompObj being the effect brush itself.  That
read as the member Source2Amount of a property Crossfade, which the brush does
not have, so the expression could not be evaluated and StartAnimation refused
it.  A member of a member of an object is now first taken as the object's
property of the two names together, when it has one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 2835e35f74e10d39b81ba6c38dd9dea071d48fa9)

diff --git a/dlls/dcomp/expression.c b/dlls/dcomp/expression.c
index 5187bc2f6b1..0afedf083ba 100644
--- a/dlls/dcomp/expression.c
+++ b/dlls/dcomp/expression.c
@@ -517,10 +517,37 @@ static BOOL swizzle( const struct value *value, const WCHAR *name, struct value
     return TRUE;
 }
 
+/*
+ * A property whose name has a dot in it, as an effect brush's
+ * Effect.Property, read as it is written: Brush.Effect.Property.  Called with
+ * the compositor locked.
+ */
+static BOOL evaluate_dotted_member( const struct node *node, const struct eval_context *context, struct value *out )
+{
+    struct value object;
+    size_t left, right;
+    WCHAR *name;
+    BOOL ret;
+
+    if (node->left->kind != NODE_MEMBER) return FALSE;
+    if (!evaluate( node->left->left, context, &object ) || object.type != VALUE_OBJECT) return FALSE;
+    left = wcslen( node->left->name );
+    right = wcslen( node->name );
+    if (!(name = malloc( (left + right + 2) * sizeof(WCHAR) ))) return FALSE;
+    memcpy( name, node->left->name, left * sizeof(WCHAR) );
+    name[left] = '.';
+    memcpy( name + left + 1, node->name, (right + 1) * sizeof(WCHAR) );
+    ret = !object_member_dot( object.object, name ) &&
+          object_get_value( object.object, name, out, context->depth + 1 );
+    free( name );
+    return ret;
+}
+
 static BOOL evaluate_member( const struct node *node, const struct eval_context *context, struct value *out )
 {
     struct value left;
 
+    if (evaluate_dotted_member( node, context, out )) return TRUE;
     if (!evaluate( node->left, context, &left )) return FALSE;
 
     if (left.type == VALUE_THIS)
diff --git a/dlls/dcomp/tests/composition.c b/dlls/dcomp/tests/composition.c
index 800d3b4b271..41ff8222d0b 100644
--- a/dlls/dcomp/tests/composition.c
+++ b/dlls/dcomp/tests/composition.c
@@ -2561,6 +2561,9 @@ static void test_effect_brush(void)
     IDispatcherQueueController *queue;
     ICompositionEffectBrush *brush, *brush2;
     ICompositionColorBrush *color, *color2;
+    IExpressionAnimation *expression;
+    ICompositionAnimation *animation;
+    ICompositionObject *object;
     IDesktopWindowTarget *target;
     ICompositionTarget *ctarget;
     ICompositor *compositor;
@@ -2637,6 +2640,23 @@ static void test_effect_brush(void)
     hr = start_scalar( compositor, brush, L"Crossfade.MultiplyAmount", NULL );
     ok( FAILED(hr), "got hr %#lx.\n", hr );
 
+    /* and expressions read them the same way, as PowerPoint ties one amount to the other */
+    str = hstring( L"1-CompObj.Crossfade.Source2Amount" );
+    hr = ICompositor_CreateExpressionAnimationWithExpression( compositor, str, &expression );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IExpressionAnimation_QueryInterface( expression, &IID_ICompositionAnimation, (void **)&animation );
+    ICompositionEffectBrush_QueryInterface( brush, &IID_ICompositionObject, (void **)&object );
+    str = hstring( L"CompObj" );
+    hr = ICompositionAnimation_SetReferenceParameter( animation, str, object );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsDeleteString( str );
+    hr = start_animation( brush, L"Crossfade.Source1Amount", expression );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionObject_Release( object );
+    ICompositionAnimation_Release( animation );
+    IExpressionAnimation_Release( expression );
+
     /* and it draws */
     hwnd = create_window();
     pump_messages( 100 );
