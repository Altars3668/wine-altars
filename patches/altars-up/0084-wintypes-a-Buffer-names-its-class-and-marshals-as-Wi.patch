From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 19:55:20 -0400
Subject: [PATCH] wintypes: a Buffer names its class and marshals as Windows'
 does.

GetRuntimeClassName says "Windows.Storage.Streams.Buffer", and IMarshal
is the free threaded marshaler's, as on Windows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 7fa613c58cddc15118f2885281f36bcc2340e7ed)

diff --git a/dlls/wintypes/buffer.c b/dlls/wintypes/buffer.c
index 620cb39709e..0a212814d32 100644
--- a/dlls/wintypes/buffer.c
+++ b/dlls/wintypes/buffer.c
@@ -120,6 +120,7 @@ struct buffer
 {
     IBuffer IBuffer_iface;
     IBufferByteAccess IBufferByteAccess_iface;
+    IUnknown *marshal;
     LONG ref;
 
     UINT32 capacity;
@@ -157,6 +158,21 @@ static HRESULT WINAPI buffer_QueryInterface( IBuffer *iface, REFIID iid, void **
         return S_OK;
     }
 
+    /* it marshals as the free threaded marshaler does, as Windows' does */
+    if (IsEqualGUID( iid, &IID_IMarshal ))
+    {
+        IUnknown *marshal;
+        HRESULT hr;
+
+        if (!impl->marshal)
+        {
+            if (FAILED(hr = CoCreateFreeThreadedMarshaler( (IUnknown *)&impl->IBuffer_iface, &marshal ))) return hr;
+            if (InterlockedCompareExchangePointer( (void **)&impl->marshal, marshal, NULL ))
+                IUnknown_Release( marshal );
+        }
+        return IUnknown_QueryInterface( impl->marshal, iid, out );
+    }
+
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -177,7 +193,11 @@ static ULONG WINAPI buffer_Release( IBuffer *iface )
 
     TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
 
-    if (!ref) free( impl );
+    if (!ref)
+    {
+        if (impl->marshal) IUnknown_Release( impl->marshal );
+        free( impl );
+    }
     return ref;
 }
 
@@ -189,8 +209,9 @@ static HRESULT WINAPI buffer_GetIids( IBuffer *iface, ULONG *iid_count, IID **ii
 
 static HRESULT WINAPI buffer_GetRuntimeClassName( IBuffer *iface, HSTRING *class_name )
 {
-    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
-    return E_NOTIMPL;
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Storage_Streams_Buffer,
+                                wcslen( RuntimeClass_Windows_Storage_Streams_Buffer ), class_name );
 }
 
 static HRESULT WINAPI buffer_GetTrustLevel( IBuffer *iface, TrustLevel *trust_level )
@@ -302,6 +323,7 @@ static HRESULT WINAPI buffer_factory_statics_Create( IBufferFactory *iface, UINT
 
     impl->IBuffer_iface.lpVtbl = &buffer_vtbl;
     impl->IBufferByteAccess_iface.lpVtbl = &buffer_byte_access_vtbl;
+    impl->marshal = NULL;
     impl->ref = 1;
     impl->capacity = capacity;
     impl->length = 0;
diff --git a/dlls/wintypes/tests/wintypes.c b/dlls/wintypes/tests/wintypes.c
index f774c822352..8525acbd35c 100644
--- a/dlls/wintypes/tests/wintypes.c
+++ b/dlls/wintypes/tests/wintypes.c
@@ -338,6 +338,13 @@ static void test_IBufferStatics(void)
     ok(hr == S_OK, "IBufferFactory_Create failed, hr %#lx.\n", hr);
 
     check_interface(buffer, &IID_IAgileObject, TRUE);
+    check_interface(buffer, &IID_IMarshal, TRUE);
+
+    hr = IBuffer_GetRuntimeClassName(buffer, &str);
+    ok(hr == S_OK, "GetRuntimeClassName failed, hr %#lx.\n", hr);
+    ok(!wcscmp(WindowsGetStringRawBuffer(str, NULL), L"Windows.Storage.Streams.Buffer"),
+       "got class %s.\n", debugstr_hstring(str));
+    WindowsDeleteString(str);
 
     if (0) /* Crash on Windows */
     {
