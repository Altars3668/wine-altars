From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 06:40:00 -0400
Subject: [PATCH] wbemprox: Leave products without a GUID out of the Security
 Center classes.

Windows 11 lists its own firewall in the WSC product list with a GUID of
"NULL", and FirewallProduct has no instance for it; it also names Defender
"Windows Defender" here and "Microsoft Defender Antivirus", localized, in the
product list.  So the test matches products by GUID only, traces the names,
and counts only those with a GUID.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wbemprox/builtin.c b/dlls/wbemprox/builtin.c
index 046648d4c4a..088d0fb14ab 100644
--- a/dlls/wbemprox/builtin.c
+++ b/dlls/wbemprox/builtin.c
@@ -5165,10 +5165,19 @@ static enum fill_status fill_securityproduct( struct table *table, const struct
         IWscProduct_get_RemediationPath( product, &path );
         IWscProduct_get_ProductStateTimestamp( product, &timestamp );
         IWscProduct_Release( product );
+        /* Windows lists its own firewall with a GUID of "NULL", and leaves it out here */
+        if (!guid || !wcscmp( guid, L"NULL" ))
+        {
+            SysFreeString( name );
+            SysFreeString( guid );
+            SysFreeString( path );
+            SysFreeString( timestamp );
+            continue;
+        }
 
         rec = (struct record_securityproduct *)(table->data + offset);
         rec->display_name                 = name ? wcsdup( name ) : NULL;
-        rec->instance_guid                = guid ? wcsdup( guid ) : NULL;
+        rec->instance_guid                = wcsdup( guid );
         rec->path_to_signed_product_exe   = path ? wcsdup( path ) : NULL;
         rec->path_to_signed_reporting_exe = path ? wcsdup( path ) : NULL;
         rec->product_state                = get_product_state( state, signature );
diff --git a/dlls/wbemprox/tests/query.c b/dlls/wbemprox/tests/query.c
index 435a02c0e94..4410bc12450 100644
--- a/dlls/wbemprox/tests/query.c
+++ b/dlls/wbemprox/tests/query.c
@@ -2676,6 +2676,26 @@ static void test_MSFT_PhysicalDisk( IWbemLocator *locator )
     SysFreeString( query );
 }
 
+/* Windows's own firewall is in the product list with a GUID of "NULL", and not in WMI */
+static LONG count_registered_products( IWSCProductList *list, LONG count )
+{
+    IWscProduct *product;
+    LONG i, ret = 0;
+    BSTR str;
+
+    for (i = 0; i < count; i++)
+    {
+        if (FAILED(IWSCProductList_get_Item( list, i, &product ))) continue;
+        if (SUCCEEDED(IWscProduct_get_ProductGuid( product, &str )))
+        {
+            if (wcscmp( str, L"NULL" )) ret++;
+            SysFreeString( str );
+        }
+        IWscProduct_Release( product );
+    }
+    return ret;
+}
+
 static IWscProduct *find_wsc_product( IWSCProductList *list, LONG count, const WCHAR *guid )
 {
     IWscProduct *product;
@@ -2751,11 +2771,13 @@ static void test_security_products( IWbemServices *services, const WCHAR *class,
         VariantClear( &val );
         if (product)
         {
+            /* not always the same: Windows 11 calls Defender "Windows Defender" here and gives the product list
+             * the localized "Microsoft Defender Antivirus" */
             hr = IWbemClassObject_Get( obj, L"displayName", 0, &val, NULL, NULL );
             ok( hr == S_OK, "got %#lx\n", hr );
             hr = IWscProduct_get_ProductName( product, &str );
             ok( hr == S_OK, "got %#lx\n", hr );
-            ok( !wcscmp( V_BSTR(&val), str ), "got %s, %s\n", debugstr_w(V_BSTR(&val)), debugstr_w(str) );
+            trace( "displayName %s, product name %s\n", debugstr_w(V_BSTR(&val)), debugstr_w(str) );
             SysFreeString( str );
             VariantClear( &val );
 
@@ -2789,6 +2811,7 @@ static void test_security_products( IWbemServices *services, const WCHAR *class,
         }
         IWbemClassObject_Release( obj );
     }
+    if (list) count = count_registered_products( list, count );
     ok( instances == count, "%s: %ld instances, %ld products\n", debugstr_w(class), instances, count );
     IEnumWbemClassObject_Release( result );
 
