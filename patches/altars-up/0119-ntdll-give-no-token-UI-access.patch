From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 11:55:55 -0400
Subject: [PATCH] ntdll: give no token UI access.

TokenUIAccess answered 1 with a FIXME.  Windows gives it only to a
process started for UI access, from a signed binary installed where it
trusts it; the token of an ordinary process, measured, answers 0 in a
DWORD.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 3f64ea29b048d61733e777d953b98b3ef8e77cf0)

diff --git a/dlls/advapi32/tests/security.c b/dlls/advapi32/tests/security.c
index 571842b67cf..aa38d5c33c0 100644
--- a/dlls/advapi32/tests/security.c
+++ b/dlls/advapi32/tests/security.c
@@ -1982,7 +1982,7 @@ static void test_token_attr(void)
 
 static void test_GetTokenInformation(void)
 {
-    DWORD is_app_container, size;
+    DWORD is_app_container, ui_access, size;
     HANDLE token;
     BOOL ret;
 
@@ -2001,6 +2001,14 @@ static void test_GetTokenInformation(void)
         ok(!is_app_container, "is_app_container = %lx\n", is_app_container);
     }
 
+    /* only a process started for UI access, and trusted to have it, has it */
+    size = 0;
+    ui_access = 0xdeadbeef;
+    ret = GetTokenInformation(token, TokenUIAccess, &ui_access, sizeof(ui_access), &size);
+    ok(ret, "GetTokenInformation failed: %lu\n", GetLastError());
+    ok(size == sizeof(ui_access), "size = %lu\n", size);
+    ok(!ui_access, "ui_access = %lx\n", ui_access);
+
     CloseHandle(token);
 }
 
diff --git a/dlls/ntdll/unix/security.c b/dlls/ntdll/unix/security.c
index 1e1b4f874cf..cfde4587c29 100644
--- a/dlls/ntdll/unix/security.c
+++ b/dlls/ntdll/unix/security.c
@@ -634,8 +634,8 @@ NTSTATUS WINAPI NtQueryInformationToken( HANDLE token, TOKEN_INFORMATION_CLASS c
         break;
 
     case TokenUIAccess:
-        *(DWORD *)info = 1;
-        FIXME("TokenUIAccess stub!\n");
+        /* only a process started with UIAccess, signed and installed where Windows trusts it, has it */
+        *(DWORD *)info = 0;
         break;
 
     case TokenAppContainerSid:
