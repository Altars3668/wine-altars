diff --git a/dlls/inetcomm/tests/mimeole.c b/dlls/inetcomm/tests/mimeole.c
index eef81fed44c..c6252e886b4 100644
--- a/dlls/inetcomm/tests/mimeole.c
+++ b/dlls/inetcomm/tests/mimeole.c
@@ -1169,6 +1169,47 @@ static void test_MimeOleGetPropertySchema(void)
     IMimePropertySchema_Release(schema);
 }
 
+static void test_classes(void)
+{
+    static const struct
+    {
+        const CLSID *clsid;
+        const IID *iid;
+    }
+    classes[] =
+    {
+        { &CLSID_IMimeInternational, &IID_IMimeInternational },
+        { &CLSID_IMimeBody, &IID_IMimeBody },
+        { &CLSID_IMimePropertySet, &IID_IMimePropertySet },
+        { &CLSID_IMimeMessageTree, &IID_IMimeMessageTree },
+        { &CLSID_IMimeMessage, &IID_IMimeMessage },
+        { &CLSID_IMimePropertySchema, &IID_IMimePropertySchema },
+    };
+    IMimeInternational *internat, *internat2;
+    IUnknown *unk;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(classes); i++)
+    {
+        winetest_push_context("%s", wine_dbgstr_guid(classes[i].clsid));
+        hr = CoCreateInstance(classes[i].clsid, NULL, CLSCTX_INPROC_SERVER, classes[i].iid, (void **)&unk);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        if (hr == S_OK) IUnknown_Release(unk);
+        winetest_pop_context();
+    }
+
+    /* the class gives an international object of its own, not the one MimeOleGetInternat gives */
+    hr = CoCreateInstance(&CLSID_IMimeInternational, NULL, CLSCTX_INPROC_SERVER, &IID_IMimeInternational,
+                          (void **)&internat);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = MimeOleGetInternat(&internat2);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    if (internat) ok(internat != internat2, "got the same object %p\n", internat);
+    if (internat) IMimeInternational_Release(internat);
+    IMimeInternational_Release(internat2);
+}
+
 typedef struct {
     const char *url;
     const char *content;
@@ -1642,6 +1683,7 @@ START_TEST(mimeole)
     test_BindToObject();
     test_BodyDeleteProp();
     test_MimeOleGetPropertySchema();
+    test_classes();
     test_mhtml_message();
     test_MimeOleObjectFromMoniker();
     test_mhtml_protocol();
