diff --git a/dlls/inetcomm/mimeintl.c b/dlls/inetcomm/mimeintl.c
index 9a4c610d996..8908b493a76 100644
--- a/dlls/inetcomm/mimeintl.c
+++ b/dlls/inetcomm/mimeintl.c
@@ -521,21 +521,38 @@ static IMimeInternationalVtbl mime_internat_vtbl =
 
 static internat_impl *global_internat;
 
-HRESULT MimeInternational_Construct(IMimeInternational **internat)
+static internat_impl *internat_create(void)
 {
-    global_internat = HeapAlloc(GetProcessHeap(), 0, sizeof(*global_internat));
-    global_internat->IMimeInternational_iface.lpVtbl = &mime_internat_vtbl;
-    global_internat->refs = 0;
-    InitializeCriticalSectionEx(&global_internat->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
-    global_internat->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": global_internat.cs");
+    internat_impl *internat;
+
+    if (!(internat = HeapAlloc(GetProcessHeap(), 0, sizeof(*internat)))) return NULL;
+    internat->IMimeInternational_iface.lpVtbl = &mime_internat_vtbl;
+    internat->refs = 1;
+    InitializeCriticalSectionEx(&internat->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    internat->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": internat_impl.cs");
+
+    list_init(&internat->charsets);
+    internat->next_charset_handle = 0;
+    internat->default_charset = NULL;
+    return internat;
+}
 
-    list_init(&global_internat->charsets);
-    global_internat->next_charset_handle = 0;
-    global_internat->default_charset = NULL;
+/* CLSID_IMimeInternational gives an object of its own, apart from the one MimeOleGetInternat gives */
+HRESULT MimeInternational_create(IUnknown *outer, void **obj)
+{
+    internat_impl *internat;
 
-    *internat = &global_internat->IMimeInternational_iface;
+    *obj = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(internat = internat_create())) return E_OUTOFMEMORY;
+    *obj = &internat->IMimeInternational_iface;
+    return S_OK;
+}
 
-    IMimeInternational_AddRef(*internat);
+HRESULT MimeInternational_Construct(IMimeInternational **internat)
+{
+    if (!(global_internat = internat_create())) return E_OUTOFMEMORY;
+    *internat = &global_internat->IMimeInternational_iface;
     return S_OK;
 }
 
