From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 02:19:40 -0400
Subject: [PATCH] kernelbase: Report progress from CopyFileEx and CopyFile2,
 and let them be cancelled.

Both took a progress routine and a cancel flag and ignored them with a
FIXME.  The test shows Windows calling the routine first with
CALLBACK_STREAM_SWITCH and, when it answers PROGRESS_CANCEL, failing with
ERROR_REQUEST_ABORTED and deleting the copy -- unless another open of the
destination does not share deletion, in which case the copy stays, so
the destination is opened for DELETE where that is possible and without
it otherwise.  The rest follows the documentation: CALLBACK_CHUNK_FINISHED
after each chunk, PROGRESS_STOP keeping the partial copy, PROGRESS_QUIET
going on without further calls, the flag cancelling as PROGRESS_CANCEL
does; CopyFile2 is sent its stream and chunk messages.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index d953a069ce6..17e9b34170a 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -1213,23 +1213,17 @@ static void test_CopyFileEx(void)
     ok(hfile != INVALID_HANDLE_VALUE, "failed to open destination file, error %ld\n", GetLastError());
     SetLastError(0xdeadbeef);
     retok = CopyFileExA(source, dest, copy_progress_cb, hfile, NULL, 0);
-    todo_wine
     ok(!retok, "CopyFileExA unexpectedly succeeded\n");
-    todo_wine
     ok(GetLastError() == ERROR_REQUEST_ABORTED, "expected ERROR_REQUEST_ABORTED, got %ld\n", GetLastError());
     ok(GetFileAttributesA(dest) != INVALID_FILE_ATTRIBUTES, "file was deleted\n");
 
     hfile = CreateFileA(dest, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                         NULL, OPEN_EXISTING, 0, 0);
-    todo_wine
     ok(hfile != INVALID_HANDLE_VALUE, "failed to open destination file, error %ld\n", GetLastError());
     SetLastError(0xdeadbeef);
     retok = CopyFileExA(source, dest, copy_progress_cb, hfile, NULL, 0);
-    todo_wine
     ok(!retok, "CopyFileExA unexpectedly succeeded\n");
-    todo_wine
     ok(GetLastError() == ERROR_REQUEST_ABORTED, "expected ERROR_REQUEST_ABORTED, got %ld\n", GetLastError());
-    todo_wine
     ok(GetFileAttributesA(dest) == INVALID_FILE_ATTRIBUTES, "file was not deleted\n");
 
     retok = CopyFileExA(source, NULL, copy_progress_cb, hfile, NULL, 0);
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index aa80f7b316a..01f88147e4f 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -503,25 +503,125 @@ BOOL WINAPI DECLSPEC_HOTPATCH AreFileApisANSI(void)
 /******************************************************************************
  *  copy_file
  */
-static BOOL copy_file( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDED_PARAMETERS *params )
+struct copy_progress
 {
-    DWORD flags = params ? params->dwCopyFlags : 0;
-    BOOL *cancel_ptr = params ? params->pfCancel : NULL;
-    PCOPYFILE2_PROGRESS_ROUTINE progress = params ? params->pProgressRoutine : NULL;
+    LPPROGRESS_ROUTINE           routine;   /* CopyFileEx's */
+    PCOPYFILE2_PROGRESS_ROUTINE  routine2;  /* CopyFile2's */
+    void                        *param;
+    BOOL                        *cancel;
+    BOOL                         quiet;
+    HANDLE                       source;
+    HANDLE                       dest;
+    ULONGLONG                    size;      /* of the one stream copied */
+    ULONGLONG                    done;
+    ULONGLONG                    chunk;     /* number of the chunk being copied */
+};
 
+enum copy_event
+{
+    COPY_STREAM_STARTED,
+    COPY_CHUNK_STARTED,
+    COPY_CHUNK_FINISHED,
+    COPY_STREAM_FINISHED,
+};
+
+/* tell the caller how far the copy has got, and learn whether to go on: PROGRESS_CONTINUE, PROGRESS_CANCEL
+ * or PROGRESS_STOP */
+static DWORD report_copy_progress( struct copy_progress *progress, enum copy_event event, ULONGLONG chunk_size )
+{
+    DWORD ret = PROGRESS_CONTINUE;
+
+    if (progress->cancel && *progress->cancel) return PROGRESS_CANCEL;
+    if (progress->quiet) return PROGRESS_CONTINUE;
+
+    if (progress->routine)
+    {
+        LARGE_INTEGER size, done;
+
+        /* CopyFileEx is told of a stream starting and of each chunk copied */
+        if (event != COPY_STREAM_STARTED && event != COPY_CHUNK_FINISHED) return PROGRESS_CONTINUE;
+        size.QuadPart = progress->size;
+        done.QuadPart = progress->done;
+        ret = progress->routine( size, done, size, done, 1,
+                                 event == COPY_STREAM_STARTED ? CALLBACK_STREAM_SWITCH : CALLBACK_CHUNK_FINISHED,
+                                 progress->source, progress->dest, progress->param );
+    }
+    else if (progress->routine2)
+    {
+        COPYFILE2_MESSAGE msg;
+
+        memset( &msg, 0, sizeof(msg) );
+        switch (event)
+        {
+        case COPY_STREAM_STARTED:
+            msg.Type = COPYFILE2_CALLBACK_STREAM_STARTED;
+            msg.Info.StreamStarted.dwStreamNumber = 1;
+            msg.Info.StreamStarted.hSourceFile = progress->source;
+            msg.Info.StreamStarted.hDestinationFile = progress->dest;
+            msg.Info.StreamStarted.uliStreamSize.QuadPart = progress->size;
+            msg.Info.StreamStarted.uliTotalFileSize.QuadPart = progress->size;
+            break;
+        case COPY_CHUNK_STARTED:
+            msg.Type = COPYFILE2_CALLBACK_CHUNK_STARTED;
+            msg.Info.ChunkStarted.dwStreamNumber = 1;
+            msg.Info.ChunkStarted.hSourceFile = progress->source;
+            msg.Info.ChunkStarted.hDestinationFile = progress->dest;
+            msg.Info.ChunkStarted.uliChunkNumber.QuadPart = progress->chunk;
+            msg.Info.ChunkStarted.uliChunkSize.QuadPart = chunk_size;
+            msg.Info.ChunkStarted.uliStreamSize.QuadPart = progress->size;
+            msg.Info.ChunkStarted.uliTotalFileSize.QuadPart = progress->size;
+            break;
+        case COPY_CHUNK_FINISHED:
+            msg.Type = COPYFILE2_CALLBACK_CHUNK_FINISHED;
+            msg.Info.ChunkFinished.dwStreamNumber = 1;
+            msg.Info.ChunkFinished.hSourceFile = progress->source;
+            msg.Info.ChunkFinished.hDestinationFile = progress->dest;
+            msg.Info.ChunkFinished.uliChunkNumber.QuadPart = progress->chunk;
+            msg.Info.ChunkFinished.uliChunkSize.QuadPart = chunk_size;
+            msg.Info.ChunkFinished.uliStreamSize.QuadPart = progress->size;
+            msg.Info.ChunkFinished.uliStreamBytesTransferred.QuadPart = progress->done;
+            msg.Info.ChunkFinished.uliTotalFileSize.QuadPart = progress->size;
+            msg.Info.ChunkFinished.uliTotalBytesTransferred.QuadPart = progress->done;
+            break;
+        case COPY_STREAM_FINISHED:
+            msg.Type = COPYFILE2_CALLBACK_STREAM_FINISHED;
+            msg.Info.StreamFinished.dwStreamNumber = 1;
+            msg.Info.StreamFinished.hSourceFile = progress->source;
+            msg.Info.StreamFinished.hDestinationFile = progress->dest;
+            msg.Info.StreamFinished.uliStreamSize.QuadPart = progress->size;
+            msg.Info.StreamFinished.uliStreamBytesTransferred.QuadPart = progress->done;
+            msg.Info.StreamFinished.uliTotalFileSize.QuadPart = progress->size;
+            msg.Info.StreamFinished.uliTotalBytesTransferred.QuadPart = progress->done;
+            break;
+        }
+        switch (progress->routine2( &msg, progress->param ))
+        {
+        case COPYFILE2_PROGRESS_CONTINUE: ret = PROGRESS_CONTINUE; break;
+        case COPYFILE2_PROGRESS_CANCEL:   ret = PROGRESS_CANCEL; break;
+        case COPYFILE2_PROGRESS_QUIET:    ret = PROGRESS_QUIET; break;
+        default:                          ret = PROGRESS_STOP; break;
+        }
+    }
+
+    if (ret == PROGRESS_QUIET)
+    {
+        progress->quiet = TRUE;
+        ret = PROGRESS_CONTINUE;
+    }
+    return ret;
+}
+
+static BOOL copy_file( const WCHAR *source, const WCHAR *dest, DWORD flags, struct copy_progress *progress )
+{
     static const int buffer_size = 65536;
-    HANDLE h1, h2;
+    FILE_STANDARD_INFORMATION std_info;
     FILE_BASIC_INFORMATION info;
+    DWORD count, action = PROGRESS_CONTINUE, error = ERROR_REQUEST_ABORTED;
+    BOOL ret = FALSE, can_delete = TRUE;
     IO_STATUS_BLOCK io;
-    DWORD count;
-    BOOL ret = FALSE;
+    HANDLE h1, h2;
     char *buffer;
 
-    if (cancel_ptr)
-        FIXME("pfCancel is not supported\n");
-    if (progress)
-        FIXME("PCOPYFILE2_PROGRESS_ROUTINE is not supported\n");
-
     if (!source || !dest)
     {
         SetLastError( ERROR_INVALID_PARAMETER );
@@ -550,7 +650,8 @@ static BOOL copy_file( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDE
         return FALSE;
     }
 
-    if (!set_ntstatus( NtQueryInformationFile( h1, &io, &info, sizeof(info), FileBasicInformation )))
+    if (!set_ntstatus( NtQueryInformationFile( h1, &io, &info, sizeof(info), FileBasicInformation )) ||
+        !set_ntstatus( NtQueryInformationFile( h1, &io, &std_info, sizeof(std_info), FileStandardInformation )))
     {
         WARN("GetFileInformationByHandle returned error for %s\n", debugstr_w(source));
         HeapFree( GetProcessHeap(), 0, buffer );
@@ -576,9 +677,18 @@ static BOOL copy_file( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDE
         }
     }
 
-    if ((h2 = CreateFileW( dest, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+    /* deleting the copy if it is cancelled takes DELETE, which another open of it may not share */
+    if ((h2 = CreateFileW( dest, GENERIC_WRITE | DELETE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
                            (flags & COPY_FILE_FAIL_IF_EXISTS) ? CREATE_NEW : CREATE_ALWAYS,
-                           info.FileAttributes, h1 )) == INVALID_HANDLE_VALUE)
+                           info.FileAttributes, h1 )) == INVALID_HANDLE_VALUE &&
+        (GetLastError() == ERROR_SHARING_VIOLATION || GetLastError() == ERROR_ACCESS_DENIED))
+    {
+        can_delete = FALSE;
+        h2 = CreateFileW( dest, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                          (flags & COPY_FILE_FAIL_IF_EXISTS) ? CREATE_NEW : CREATE_ALWAYS,
+                          info.FileAttributes, h1 );
+    }
+    if (h2 == INVALID_HANDLE_VALUE)
     {
         WARN("Unable to open dest %s\n", debugstr_w(dest));
         HeapFree( GetProcessHeap(), 0, buffer );
@@ -586,26 +696,56 @@ static BOOL copy_file( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDE
         return FALSE;
     }
 
-    while (ReadFile( h1, buffer, buffer_size, &count, NULL ) && count)
+    progress->source = h1;
+    progress->dest = h2;
+    progress->size = std_info.EndOfFile.QuadPart;
+    progress->done = 0;
+    progress->chunk = 0;
+    if ((action = report_copy_progress( progress, COPY_STREAM_STARTED, 0 ))) goto done;
+
+    for (;;)
     {
         char *p = buffer;
+
+        if (!ReadFile( h1, buffer, buffer_size, &count, NULL ))
+        {
+            error = GetLastError();
+            goto done;
+        }
+        if (!count) break;
+        if ((action = report_copy_progress( progress, COPY_CHUNK_STARTED, count ))) goto done;
+        progress->done += count;
         while (count != 0)
         {
             DWORD res;
-            if (!WriteFile( h2, p, count, &res, NULL ) || !res) goto done;
+            if (!WriteFile( h2, p, count, &res, NULL ) || !res)
+            {
+                error = GetLastError();
+                goto done;
+            }
             p += res;
             count -= res;
         }
+        if ((action = report_copy_progress( progress, COPY_CHUNK_FINISHED, p - buffer ))) goto done;
+        progress->chunk++;
     }
+    if ((action = report_copy_progress( progress, COPY_STREAM_FINISHED, 0 ))) goto done;
     ret = TRUE;
 done:
     /* Maintain the timestamp of source file to destination file and read-only attribute */
     info.FileAttributes &= FILE_ATTRIBUTE_READONLY;
     NtSetInformationFile( h2, &io, &info, sizeof(info), FileBasicInformation );
+    /* a cancelled copy is removed, a stopped one kept */
+    if (action == PROGRESS_CANCEL && can_delete)
+    {
+        FILE_DISPOSITION_INFORMATION disposition = { TRUE };
+        NtSetInformationFile( h2, &io, &disposition, sizeof(disposition), FileDispositionInformation );
+    }
     HeapFree( GetProcessHeap(), 0, buffer );
     CloseHandle( h1 );
     CloseHandle( h2 );
     if (ret) SetLastError( 0 );
+    else SetLastError( error );
     return ret;
 }
 
@@ -614,7 +754,16 @@ done:
  */
 HRESULT WINAPI CopyFile2( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTENDED_PARAMETERS *params )
 {
-    return copy_file(source, dest, params) ? S_OK : HRESULT_FROM_WIN32(GetLastError());
+    struct copy_progress progress = {0};
+
+    if (params)
+    {
+        progress.routine2 = params->pProgressRoutine;
+        progress.param = params->pvCallbackContext;
+        progress.cancel = params->pfCancel;
+    }
+    return copy_file( source, dest, params ? params->dwCopyFlags : 0, &progress )
+           ? S_OK : HRESULT_FROM_WIN32(GetLastError());
 }
 
 
@@ -624,20 +773,12 @@ HRESULT WINAPI CopyFile2( const WCHAR *source, const WCHAR *dest, COPYFILE2_EXTE
 BOOL WINAPI CopyFileExW( const WCHAR *source, const WCHAR *dest, LPPROGRESS_ROUTINE progress,
                          void *param, BOOL *cancel_ptr, DWORD flags )
 {
-    COPYFILE2_EXTENDED_PARAMETERS params;
-
-    if (progress)
-        FIXME("LPPROGRESS_ROUTINE is not supported\n");
-    if (cancel_ptr)
-        FIXME("cancel_ptr is not supported\n");
-
-    params.dwSize = sizeof(params);
-    params.dwCopyFlags = flags;
-    params.pProgressRoutine = NULL;
-    params.pvCallbackContext = NULL;
-    params.pfCancel = NULL;
+    struct copy_progress copy_progress = {0};
 
-    return copy_file( source, dest, &params );
+    copy_progress.routine = progress;
+    copy_progress.param = param;
+    copy_progress.cancel = cancel_ptr;
+    return copy_file( source, dest, flags, &copy_progress );
 }
 
 
