From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 00:43:22 -0400
Subject: [PATCH] rpcss: drop local COM classes after their server exits

Record the local registration process handle and prune its class object when the server has terminated, so a subsequent activation can start a fresh server.

Co-Authored-By: Claude Code <noreply@anthropic.com>
(cherry picked from commit 044f72148c3fb9f66d4f2e3a6a328312ee0fc4f1)

diff --git a/programs/rpcss/rpcss_main.c b/programs/rpcss/rpcss_main.c
index dfe5ced7c07..79630ffd00f 100644
--- a/programs/rpcss/rpcss_main.c
+++ b/programs/rpcss/rpcss_main.c
@@ -45,6 +45,7 @@ struct registered_class
     GUID clsid;
     unsigned int cookie;
     PMInterfacePointer object;
+    HANDLE server_process;
     unsigned int single_use : 1;
 };
 
@@ -56,6 +57,8 @@ HRESULT __cdecl irpcss_server_register(handle_t h, const GUID *clsid, unsigned i
 {
     struct registered_class *entry;
     static LONG next_cookie;
+    RPC_STATUS status;
+    ULONG pid;
 
     if (!(entry = calloc(1, sizeof(*entry))))
         return E_OUTOFMEMORY;
@@ -69,6 +72,15 @@ HRESULT __cdecl irpcss_server_register(handle_t h, const GUID *clsid, unsigned i
     }
     entry->object->ulCntData = object->ulCntData;
     memcpy(&entry->object->abData, object->abData, object->ulCntData);
+    if ((status = I_RpcBindingInqLocalClientPID(h, &pid)) == RPC_S_OK)
+    {
+        if (!(entry->server_process = OpenProcess(SYNCHRONIZE, FALSE, pid)))
+            WARN("Failed to open COM server process %lu, error %lu.\n", pid, GetLastError());
+    }
+    else
+    {
+        WARN("Failed to identify COM server process, status %ld.\n", status);
+    }
     *cookie = entry->cookie = InterlockedIncrement(&next_cookie);
 
     EnterCriticalSection(&registered_classes_cs);
@@ -81,6 +93,8 @@ HRESULT __cdecl irpcss_server_register(handle_t h, const GUID *clsid, unsigned i
 static void scm_revoke_class(struct registered_class *_class)
 {
     list_remove(&_class->entry);
+    if (_class->server_process)
+        CloseHandle(_class->server_process);
     free(_class->object);
     free(_class);
 }
@@ -108,28 +122,33 @@ HRESULT __cdecl irpcss_server_revoke(handle_t h, unsigned int cookie)
 HRESULT __cdecl irpcss_get_class_object(handle_t h, const GUID *clsid,
         PMInterfacePointer *object)
 {
-    struct registered_class *cur;
+    struct registered_class *cur, *next;
 
     *object = NULL;
 
     EnterCriticalSection(&registered_classes_cs);
 
-    LIST_FOR_EACH_ENTRY(cur, &registered_classes, struct registered_class, entry)
+    LIST_FOR_EACH_ENTRY_SAFE(cur, next, &registered_classes, struct registered_class, entry)
     {
-        if (!memcmp(clsid, &cur->clsid, sizeof(*clsid)))
+        if (memcmp(clsid, &cur->clsid, sizeof(*clsid)))
+            continue;
+        /* A server that exits unexpectedly cannot call CoRevokeClassObject. */
+        if (cur->server_process && WaitForSingleObject(cur->server_process, 0) == WAIT_OBJECT_0)
         {
-            *object = MIDL_user_allocate(FIELD_OFFSET(MInterfacePointer, abData[cur->object->ulCntData]));
-            if (*object)
-            {
-                (*object)->ulCntData = cur->object->ulCntData;
-                memcpy((*object)->abData, cur->object->abData, cur->object->ulCntData);
-            }
+            scm_revoke_class(cur);
+            continue;
+        }
+        *object = MIDL_user_allocate(FIELD_OFFSET(MInterfacePointer, abData[cur->object->ulCntData]));
+        if (*object)
+        {
+            (*object)->ulCntData = cur->object->ulCntData;
+            memcpy((*object)->abData, cur->object->abData, cur->object->ulCntData);
+        }
 
-            if (cur->single_use)
-                scm_revoke_class(cur);
+        if (cur->single_use)
+            scm_revoke_class(cur);
 
-            break;
-        }
+        break;
     }
 
     LeaveCriticalSection(&registered_classes_cs);
