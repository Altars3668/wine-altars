From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 18:28:10 -0400
Subject: [PATCH] iertutil: the display URI of a URI with a user name is one
 character shorter.

It leaves out the user name and password and the '@' after them, and the
string was made one character longer than what was copied into it.  The
trailing character was garbage: a Windows.Foundation.Uri of such a URI
read back with a NUL at the end of its DisplayUri.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 29a4f9a98fceda8f62297c4b64a69fd93a0fd787)

diff --git a/dlls/iertutil/uri.c b/dlls/iertutil/uri.c
index 08eff41c86c..449546ca6ba 100644
--- a/dlls/iertutil/uri.c
+++ b/dlls/iertutil/uri.c
@@ -3936,7 +3936,8 @@ static HRESULT WINAPI Uri_GetPropertyBSTR(IUri *iface, Uri_PROPERTY uriProp, BST
          * scheme types.
          */
         if(This->scheme_type != URL_SCHEME_UNKNOWN && This->userinfo_start > -1) {
-            unsigned int length = This->canon_len-This->userinfo_len;
+            /* the userinfo goes, and the '@' after it */
+            unsigned int length = This->canon_len-This->userinfo_len-1;
 
             /* Skip fragment if Uri_DISPLAY_NO_FRAGMENT is specified */
             if(dwFlags == Uri_DISPLAY_NO_FRAGMENT && This->fragment_start > -1)
@@ -3949,7 +3950,7 @@ static HRESULT WINAPI Uri_GetPropertyBSTR(IUri *iface, Uri_PROPERTY uriProp, BST
                 memcpy(*pbstrProperty, This->canon_uri, This->userinfo_start*sizeof(WCHAR));
 
                 /* Copy everything after the userinfo over. */
-                length -= This->userinfo_start+1;
+                length -= This->userinfo_start;
                 memcpy(*pbstrProperty+This->userinfo_start,
                    This->canon_uri+This->userinfo_start+This->userinfo_len+1, length*sizeof(WCHAR));
             }
diff --git a/dlls/urlmon/tests/uri.c b/dlls/urlmon/tests/uri.c
index 133c0e1cc9d..405b6d8f49d 100644
--- a/dlls/urlmon/tests/uri.c
+++ b/dlls/urlmon/tests/uri.c
@@ -8580,6 +8580,9 @@ static void test_IUri_GetPropertyBSTR(void) {
                             "Expected %s but got %s on uri_tests[%ld].str_props[%ld].\n",
                             prop.value, wine_dbgstr_w(received), i, j);
                 }
+                ok(!received || SysStringLen(received) == lstrlenW(received),
+                   "Got a string of length %u for %s on uri_tests[%ld].str_props[%ld].\n",
+                   SysStringLen(received), wine_dbgstr_w(received), i, j);
 
                 SysFreeString(received);
             }
