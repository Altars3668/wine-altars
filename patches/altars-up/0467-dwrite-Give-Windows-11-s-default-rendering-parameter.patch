From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 16:12:13 -0400
Subject: [PATCH] dwrite: Give Windows 11's default rendering parameters, and a
 monitor's own settings for CreateMonitorRenderingParams.

As measured on Windows 11 build 29671, the defaults are a gamma of 1.8, an enhanced contrast of 0.5, a grayscale
enhanced contrast of 1.0, a ClearType level of 1.0 and RGB subpixels, and CreateRenderingParams gives them as
they are.  CreateMonitorRenderingParams gives them for no monitor, fails with ERROR_INVALID_MONITOR_HANDLE for a
handle that is not one, and for a monitor takes what the ClearType tuner left in
HKCU\Software\Microsoft\Avalon.Graphics\<device name>: GammaLevel in thousandths, EnhancedContrastLevel,
GrayscaleEnhancedContrastLevel and ClearTypeLevel in hundredths, and PixelStructure.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/dwrite/main.c b/dlls/dwrite/main.c
index c8172d3f59e..c5b40ce918e 100644
--- a/dlls/dwrite/main.c
+++ b/dlls/dwrite/main.c
@@ -1136,35 +1136,96 @@ failed:
     return hr;
 }
 
-static HRESULT WINAPI dwritefactory_CreateRenderingParams(IDWriteFactory7 *iface, IDWriteRenderingParams **params)
+/* What Windows 11 gives when nothing says otherwise. */
+struct rendering_defaults
 {
-    HMONITOR monitor;
-    POINT pt;
+    float gamma;
+    float contrast;
+    float grayscale_contrast;
+    float cleartype_level;
+    DWRITE_PIXEL_GEOMETRY geometry;
+};
+
+static const struct rendering_defaults rendering_defaults = { 1.8f, 0.5f, 1.0f, 1.0f, DWRITE_PIXEL_GEOMETRY_RGB };
 
+static HRESULT create_default_renderingparams(IDWriteFactory7 *iface, const struct rendering_defaults *values,
+        IDWriteRenderingParams **params)
+{
+    IDWriteRenderingParams3 *params3;
+    HRESULT hr;
+
+    hr = IDWriteFactory7_CreateCustomRenderingParams(iface, values->gamma, values->contrast, values->grayscale_contrast,
+            values->cleartype_level, values->geometry, DWRITE_RENDERING_MODE1_DEFAULT, DWRITE_GRID_FIT_MODE_DEFAULT,
+            &params3);
+    *params = (IDWriteRenderingParams *)params3;
+    return hr;
+}
+
+static HRESULT WINAPI dwritefactory_CreateRenderingParams(IDWriteFactory7 *iface, IDWriteRenderingParams **params)
+{
     TRACE("%p, %p.\n", iface, params);
 
-    pt.x = pt.y = 0;
-    monitor = MonitorFromPoint(pt, MONITOR_DEFAULTTOPRIMARY);
-    return IDWriteFactory7_CreateMonitorRenderingParams(iface, monitor, params);
+    /* the defaults themselves, not what a monitor's settings make of them */
+    return create_default_renderingparams(iface, &rendering_defaults, params);
+}
+
+/* A monitor's own settings, as the ClearType tuner leaves them in
+ * HKCU\Software\Microsoft\Avalon.Graphics\<its device name>: the gamma in thousandths, the contrasts and the
+ * ClearType level in hundredths, and the order of its subpixels. */
+static void get_monitor_rendering_values(const WCHAR *device, struct rendering_defaults *values)
+{
+    static const WCHAR prefixW[] = L"\\\\.\\";
+    WCHAR path[64 + CCHDEVICENAME];
+    DWORD value, size;
+    HKEY key;
+
+    if (!wcsncmp(device, prefixW, wcslen(prefixW)))
+        device += wcslen(prefixW);
+    swprintf(path, ARRAY_SIZE(path), L"Software\\Microsoft\\Avalon.Graphics\\%s", device);
+    if (RegOpenKeyExW(HKEY_CURRENT_USER, path, 0, KEY_QUERY_VALUE, &key))
+        return;
+
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"GammaLevel", NULL, NULL, (BYTE *)&value, &size) && size == sizeof(value) && value)
+        values->gamma = value / 1000.0f;
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"EnhancedContrastLevel", NULL, NULL, (BYTE *)&value, &size) && size == sizeof(value))
+        values->contrast = value / 100.0f;
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"GrayscaleEnhancedContrastLevel", NULL, NULL, (BYTE *)&value, &size)
+            && size == sizeof(value))
+        values->grayscale_contrast = value / 100.0f;
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"ClearTypeLevel", NULL, NULL, (BYTE *)&value, &size) && size == sizeof(value))
+        values->cleartype_level = min(value, 100) / 100.0f;
+    size = sizeof(value);
+    if (!RegQueryValueExW(key, L"PixelStructure", NULL, NULL, (BYTE *)&value, &size) && size == sizeof(value)
+            && value <= DWRITE_PIXEL_GEOMETRY_BGR)
+        values->geometry = value;
+    RegCloseKey(key);
 }
 
 static HRESULT WINAPI dwritefactory_CreateMonitorRenderingParams(IDWriteFactory7 *iface, HMONITOR monitor,
     IDWriteRenderingParams **params)
 {
-    IDWriteRenderingParams3 *params3;
-    static int fixme_once = 0;
-    HRESULT hr;
+    struct rendering_defaults values = rendering_defaults;
+    MONITORINFOEXW info;
 
     TRACE("%p, %p, %p.\n", iface, monitor, params);
 
-    if (!fixme_once++)
-        FIXME("(%p): monitor setting ignored\n", monitor);
+    /* no monitor is the defaults; one that is not a monitor is an error */
+    if (monitor)
+    {
+        info.cbSize = sizeof(info);
+        if (!GetMonitorInfoW(monitor, (MONITORINFO *)&info))
+        {
+            *params = NULL;
+            return HRESULT_FROM_WIN32(ERROR_INVALID_MONITOR_HANDLE);
+        }
+        get_monitor_rendering_values(info.szDevice, &values);
+    }
 
-    /* FIXME: use actual per-monitor gamma factor */
-    hr = IDWriteFactory7_CreateCustomRenderingParams(iface, 2.0f, 0.0f, 1.0f, 0.0f, DWRITE_PIXEL_GEOMETRY_FLAT,
-        DWRITE_RENDERING_MODE1_DEFAULT, DWRITE_GRID_FIT_MODE_DEFAULT, &params3);
-    *params = (IDWriteRenderingParams*)params3;
-    return hr;
+    return create_default_renderingparams(iface, &values, params);
 }
 
 static HRESULT WINAPI dwritefactory_CreateCustomRenderingParams(IDWriteFactory7 *iface, FLOAT gamma,
diff --git a/dlls/dwrite/tests/font.c b/dlls/dwrite/tests/font.c
index bd5a510bbe8..673cc31065b 100644
--- a/dlls/dwrite/tests/font.c
+++ b/dlls/dwrite/tests/font.c
@@ -5879,6 +5879,56 @@ static void test_CreateRenderingParams(void)
     ok(ref == 0, "factory not released, %lu\n", ref);
 }
 
+static void test_default_rendering_params(void)
+{
+    IDWriteRenderingParams1 *params1;
+    IDWriteRenderingParams *params;
+    IDWriteFactory *factory;
+    POINT origin = { 0, 0 };
+    HRESULT hr;
+    ULONG ref;
+
+    factory = create_factory();
+
+    /* what Windows 11 gives, a monitor's settings aside */
+    hr = IDWriteFactory_CreateRenderingParams(factory, &params);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(IDWriteRenderingParams_GetGamma(params) == 1.8f, "Unexpected gamma %.8e.\n",
+            IDWriteRenderingParams_GetGamma(params));
+    ok(IDWriteRenderingParams_GetEnhancedContrast(params) == 0.5f, "Unexpected contrast %.8e.\n",
+            IDWriteRenderingParams_GetEnhancedContrast(params));
+    ok(IDWriteRenderingParams_GetClearTypeLevel(params) == 1.0f, "Unexpected ClearType level %.8e.\n",
+            IDWriteRenderingParams_GetClearTypeLevel(params));
+    ok(IDWriteRenderingParams_GetPixelGeometry(params) == DWRITE_PIXEL_GEOMETRY_RGB, "Unexpected geometry %d.\n",
+            IDWriteRenderingParams_GetPixelGeometry(params));
+    if (SUCCEEDED(IDWriteRenderingParams_QueryInterface(params, &IID_IDWriteRenderingParams1, (void **)&params1)))
+    {
+        ok(IDWriteRenderingParams1_GetGrayscaleEnhancedContrast(params1) == 1.0f, "Unexpected contrast %.8e.\n",
+                IDWriteRenderingParams1_GetGrayscaleEnhancedContrast(params1));
+        IDWriteRenderingParams1_Release(params1);
+    }
+    IDWriteRenderingParams_Release(params);
+
+    /* no monitor is the defaults as well */
+    hr = IDWriteFactory_CreateMonitorRenderingParams(factory, NULL, &params);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(IDWriteRenderingParams_GetGamma(params) == 1.8f, "Unexpected gamma %.8e.\n",
+            IDWriteRenderingParams_GetGamma(params));
+    IDWriteRenderingParams_Release(params);
+
+    hr = IDWriteFactory_CreateMonitorRenderingParams(factory, MonitorFromPoint(origin, MONITOR_DEFAULTTOPRIMARY),
+            &params);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IDWriteRenderingParams_Release(params);
+
+    /* but one that is not a monitor is not */
+    hr = IDWriteFactory_CreateMonitorRenderingParams(factory, (HMONITOR)0xdead, &params);
+    ok(hr == HRESULT_FROM_WIN32(ERROR_INVALID_MONITOR_HANDLE), "Unexpected hr %#lx.\n", hr);
+
+    ref = IDWriteFactory_Release(factory);
+    ok(ref == 0, "factory not released, %lu\n", ref);
+}
+
 static void test_CreateGlyphRunAnalysis(void)
 {
     static const DWRITE_RENDERING_MODE rendermodes[] = {
@@ -10817,6 +10867,7 @@ START_TEST(font)
     test_GetGlyphCount();
     test_GetKerningPairAdjustments();
     test_CreateRenderingParams();
+    test_default_rendering_params();
     test_CreateGlyphRunAnalysis();
     test_GetGdiCompatibleMetrics();
     test_GetPanose();
