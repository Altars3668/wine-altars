From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 02:16:52 -0400
Subject: [PATCH] d2d1: Stream a rounded rectangle with its rounds where they
 are.

A rounded rectangle streamed into a sink began above its top left
corner, went round each corner outwards instead of in, and turned each
round through 90 degrees, which swaps the radii of one that is not
circular.  A geometry group streams what is in it into the path it
fills, bounds and hit-tests through, so a group with a rounded
rectangle in it had its corners wrong.  The figure now starts at the
top left round, as Direct2D's own Simplify of the rectangle does, and
each round is a quarter of the ellipse with the rectangle's radii.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/d2d1/geometry.c b/dlls/d2d1/geometry.c
index fa2f8731bc2..36d67e6f3e8 100644
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -6068,20 +6068,21 @@ static void d2d_rounded_rectangle_geometry_stream(struct d2d_geometry *geometry,
     if (r->radiusX == 0.0f || r->radiusY == 0.0f)
         return d2d_rectangle_stream(&r->rect, transform, sink);
 
+    /* from the top left round, clockwise, each round a quarter of an ellipse with the radii */
     arcs[0].size.width = r->radiusX;
     arcs[0].size.height = r->radiusY;
-    arcs[0].rotationAngle = 90.0f;
+    arcs[0].rotationAngle = 0.0f;
     arcs[0].sweepDirection = D2D1_SWEEP_DIRECTION_CLOCKWISE;
     arcs[0].arcSize = D2D1_ARC_SIZE_SMALL;
     arcs[1] = arcs[2] = arcs[3] = arcs[0];
 
-    d2d_point_set(&points[0], r->rect.left, r->rect.top - r->radiusY);
+    d2d_point_set(&points[0], r->rect.left, r->rect.top + r->radiusY);
     d2d_point_set(&points[1], r->rect.right - r->radiusX, r->rect.top);
     d2d_point_set(&points[2], r->rect.right, r->rect.bottom - r->radiusY);
-    d2d_point_set(&points[3], r->rect.left - r->radiusX, r->rect.bottom);
+    d2d_point_set(&points[3], r->rect.left + r->radiusX, r->rect.bottom);
 
-    d2d_point_set(&arcs[0].point, r->rect.left - r->radiusX, r->rect.top);
-    d2d_point_set(&arcs[1].point, r->rect.right, r->rect.top - r->radiusY);
+    d2d_point_set(&arcs[0].point, r->rect.left + r->radiusX, r->rect.top);
+    d2d_point_set(&arcs[1].point, r->rect.right, r->rect.top + r->radiusY);
     d2d_point_set(&arcs[2].point, r->rect.right - r->radiusX, r->rect.bottom);
     d2d_point_set(&arcs[3].point, r->rect.left, r->rect.bottom - r->radiusY);
 
diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index 8f28e45bf18..2ef5d9cb9b1 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -12538,6 +12538,7 @@ static void test_colour_space(BOOL d3d11)
 static void test_geometry_group(BOOL d3d11)
 {
     ID2D1TransformedGeometry *transformed_geometry;
+    D2D1_ROUNDED_RECT rounded_rect;
     struct d2d1_test_context ctx;
     ID2D1Geometry *geometries[2];
     ID2D1GeometryGroup *group;
@@ -12545,9 +12546,9 @@ static void test_geometry_group(BOOL d3d11)
     ID2D1PathGeometry *path;
     ID2D1GeometrySink *sink;
     D2D1_POINT_2F point;
+    BOOL match, contains;
     D2D1_RECT_F rect;
     HRESULT hr;
-    BOOL match;
 
     if (!init_test_context(&ctx, d3d11))
         return;
@@ -12584,6 +12585,39 @@ static void test_geometry_group(BOOL d3d11)
     ID2D1Geometry_Release(geometries[0]);
     ID2D1Geometry_Release(geometries[1]);
 
+    /* A rounded rectangle keeps its rounds where they are, each a quarter of an ellipse with the radii. */
+    set_rect(&rounded_rect.rect, 0.0f, 0.0f, 20.0f, 10.0f);
+    rounded_rect.radiusX = 4.0f;
+    rounded_rect.radiusY = 2.0f;
+    hr = ID2D1Factory_CreateRoundedRectangleGeometry(ctx.factory, &rounded_rect,
+            (ID2D1RoundedRectangleGeometry **)&geometries[0]);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Factory_CreateGeometryGroup(ctx.factory, D2D1_FILL_MODE_ALTERNATE, geometries, 1, &group);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1GeometryGroup_GetBounds(group, NULL, &rect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    match = compare_rect(&rect, 0.0f, 0.0f, 20.0f, 10.0f, 1);
+    ok(match, "Got unexpected rectangle {%.8e, %.8e, %.8e, %.8e}.\n",
+            rect.left, rect.top, rect.right, rect.bottom);
+    set_point(&point, 18.0f, 1.0f);
+    hr = ID2D1GeometryGroup_FillContainsPoint(group, point, NULL, 0.0f, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(contains, "Got unexpected contains %d.\n", contains);
+    set_point(&point, 19.9f, 0.1f);
+    hr = ID2D1GeometryGroup_FillContainsPoint(group, point, NULL, 0.0f, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!contains, "Got unexpected contains %d.\n", contains);
+    set_point(&point, 1.0f, 9.0f);
+    hr = ID2D1GeometryGroup_FillContainsPoint(group, point, NULL, 0.0f, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(contains, "Got unexpected contains %d.\n", contains);
+    set_point(&point, 0.2f, 9.8f);
+    hr = ID2D1GeometryGroup_FillContainsPoint(group, point, NULL, 0.0f, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!contains, "Got unexpected contains %d.\n", contains);
+    ID2D1GeometryGroup_Release(group);
+    ID2D1Geometry_Release(geometries[0]);
+
     /* Empty path. */
     hr = ID2D1Factory_CreatePathGeometry(ctx.factory, &path);
     ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
