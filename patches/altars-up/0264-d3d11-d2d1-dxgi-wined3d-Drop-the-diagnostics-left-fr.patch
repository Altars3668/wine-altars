-     * and this is the only place the whole atlas is already in system memory
-     * on the CPU.  Off unless asked for: it writes ~8MB a frame. */
-    if (getenv("WINE_ALTARS_DUMP_ATLAS"))
-    {
-        static LONG dumped;
-        LONG n = InterlockedIncrement(&dumped);
-
-        if (n <= 24)
