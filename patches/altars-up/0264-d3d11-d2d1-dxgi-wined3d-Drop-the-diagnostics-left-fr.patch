     shared->holder = texture;
     if (waited_for_content && shared->bits)
-        WARN("altars-content-wait texture %p got surface %p after waiting.\n", texture, shared);
+        WARN("Texture %p got surface %p after waiting.\n", texture, shared);
     if (!shared->bits && texture != shared->owner)
-        WARN("altars-empty-acquire texture %p took surface %p with nothing in it after waiting; "
