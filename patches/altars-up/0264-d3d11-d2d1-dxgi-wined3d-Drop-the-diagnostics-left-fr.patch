-    }
 
     if (viewport_count > ARRAY_SIZE(wined3d_vp))
         return;
@@ -1413,78 +1380,6 @@ static void STDMETHODCALLTYPE d3d11_device_context_CopySubresourceRegion(ID3D11D
             src_resource, src_subresource_idx, src_box);
     d3d_shared_resource_mark_dirty(dst_resource);
 
-    if (TRACE_ON(d3d11))
-        TRACE("altars-copy dst %p at %u,%u src %p box %s.\n", dst_resource, dst_x, dst_y, src_resource,
-                src_box ? wine_dbg_sprintf("(%u,%u)-(%u,%u)", src_box->left, src_box->top,
-                        src_box->right, src_box->bottom) : "(whole)");
-
-    /* altars diagnostic: WINE_ALTARS_DUMP_BOX="l,t,r,b" dumps both sides of the
-     * copy whose source box is exactly that -- Office copies each glyph tile
-     * out of its atlas into the cache it composites from, and this is what says
-     * whether the tile was in the atlas when the copy read it. */
-    if (src_box && getenv("WINE_ALTARS_DUMP_BOX"))
-    {
-        unsigned int l, t, r, b;
-
-        if (sscanf(getenv("WINE_ALTARS_DUMP_BOX"), "%u,%u,%u,%u", &l, &t, &r, &b) == 4
-                && src_box->left == l && src_box->top == t
-                && src_box->right == r && src_box->bottom == b)
-        {
-            static LONG hits;
-            LONG n = InterlockedIncrement(&hits);
-            ID3D11Texture2D *tex;
-
-            if (n <= 4)
-            {
-                if (SUCCEEDED(ID3D11Resource_QueryInterface(src_resource, &IID_ID3D11Texture2D, (void **)&tex)))
-                {
-                    d3d_texture2d_dump(unsafe_impl_from_ID3D11Texture2D(tex), "boxsrc", n);
-                    ID3D11Texture2D_Release(tex);
-                }
-                if (SUCCEEDED(ID3D11Resource_QueryInterface(dst_resource, &IID_ID3D11Texture2D, (void **)&tex)))
-                {
-                    d3d_texture2d_dump(unsafe_impl_from_ID3D11Texture2D(tex), "boxdst", n);
-                    ID3D11Texture2D_Release(tex);
-                }
-                if (SUCCEEDED(ID3D11Resource_QueryInterface(src_resource, &IID_ID3D11Texture2D, (void **)&tex)))
-                {
-                    struct d3d_texture2d *t = unsafe_impl_from_ID3D11Texture2D(tex);
-
-                    ERR("altars-box copy #%ld: src %p %ux%u misc %#x device %p shared %p gen %u dirty %d.\n",
-                            (long)n, src_resource, t->desc.Width, t->desc.Height, t->desc.MiscFlags,
-                            t->device, t->shared, t->shared_generation, t->shared_dirty);
-                    ID3D11Texture2D_Release(tex);
-                }
-                ERR("altars-box copy #%ld: -> dst %p at %u,%u, this context %p.\n", (long)n,
-                        dst_resource, dst_x, dst_y, iface);
-            }
-        }
-    }
-
-    /* altars diagnostic: Office fills a big cache texture with 2000+ of these
-     * per start-up and composites the window out of it.  With
-     * WINE_ALTARS_DUMP_CACHE set, write that texture out every so often, which
-     * is the only way to ask whether a label that never appears on screen was
-     * in the texture the compositor sampled. */
-    if (getenv("WINE_ALTARS_DUMP_CACHE"))
-    {
-        static LONG copies;
-        LONG n = InterlockedIncrement(&copies);
-        unsigned int every = atoi(getenv("WINE_ALTARS_DUMP_CACHE"));
-        ID3D11Texture2D *tex2d;
-
-        if (every && !(n % every) && n / every <= 8
-                && SUCCEEDED(ID3D11Resource_QueryInterface(dst_resource, &IID_ID3D11Texture2D, (void **)&tex2d)))
-        {
-            struct d3d_texture2d *t = unsafe_impl_from_ID3D11Texture2D(tex2d);
-
-            if (t && t->desc.Width >= 1024 && t->desc.Height >= 1024)
-                d3d_texture2d_dump(t, "cache", n / every);
-            ID3D11Texture2D_Release(tex2d);
-        }
-    }
-
-
     if (!dst_resource || !src_resource)
         return;
 
