- * is the only one whose pixels this file already has in system memory; Office's
- * composite samples a 2048x2048 cache texture that is not shared with anybody
- * and never has a render target view, so it needed its own way out. */
-void d3d_texture2d_dump(struct d3d_texture2d *texture, const char *tag, unsigned int seq)
-{
-    ID3D11DeviceContext *context;
-    D3D11_MAPPED_SUBRESOURCE map;
-    ID3D11Texture2D *staging;
-    unsigned int y, px;
-    char path[256];
-    FILE *f;
-
-    if (FAILED(texture_get_staging(texture, D3D11_CPU_ACCESS_READ, &staging)))
-        return;
-    if (!(context = texture_context(texture)))
-        return;
-
-    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)staging,
-            (ID3D11Resource *)&texture->ID3D11Texture2D_iface);
-    if (FAILED(ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map)))
-    {
-        ID3D11DeviceContext_Release(context);
-        return;
-    }
-
-    sprintf(path, "/tmp/altars-%s-%p-%03u.ppm", tag, texture, seq);
-    if ((f = fopen(path, "wb")))
-    {
-        fprintf(f, "P6\n%u %u\n255\n", texture->desc.Width, texture->desc.Height);
-        for (y = 0; y < texture->desc.Height; ++y)
-        {
-            const unsigned char *line = (const unsigned char *)map.pData + (size_t)y * map.RowPitch;
-            for (px = 0; px < texture->desc.Width; ++px)
-                fwrite((const char[]){ line[px * 4 + 2], line[px * 4 + 1], line[px * 4] }, 1, 3, f);
-        }
-        fclose(f);
-    }
-    sprintf(path, "/tmp/altars-%s-%p-%03u.pgm", tag, texture, seq);
-    if ((f = fopen(path, "wb")))
-    {
-        fprintf(f, "P5\n%u %u\n255\n", texture->desc.Width, texture->desc.Height);
-        for (y = 0; y < texture->desc.Height; ++y)
-        {
-            const unsigned char *line = (const unsigned char *)map.pData + (size_t)y * map.RowPitch;
-            for (px = 0; px < texture->desc.Width; ++px)
-                fputc(line[px * 4 + 3], f);
-        }
-        fclose(f);
-    }
-    TRACE("altars-dump wrote %s.\n", path);
-
-    ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
-    ID3D11DeviceContext_Release(context);
-}
