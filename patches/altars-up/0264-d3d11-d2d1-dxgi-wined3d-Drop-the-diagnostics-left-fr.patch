         if (want_content && !waited_for_content)
         {
             waited_for_content = TRUE;
-            WARN("altars-content-wait texture %p waiting for surface %p to be written by its owner %p.\n",
+            WARN("Texture %p waiting for surface %p to be written by its owner %p.\n",
                     texture, shared, shared->owner);
