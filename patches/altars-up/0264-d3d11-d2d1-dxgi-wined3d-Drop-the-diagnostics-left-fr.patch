-                                line[px * 4] }, 1, 3, f);
-                }
-                fclose(f);
-                TRACE("altars-atlas dumped %s.\n", path);
-            }
-
-            /* And the alpha plane on its own.  These atlases are premultiplied
-             * BGRA: black text at full coverage is (0,0,0,255), which is
-             * indistinguishable from "nothing here" in the colour dump above
