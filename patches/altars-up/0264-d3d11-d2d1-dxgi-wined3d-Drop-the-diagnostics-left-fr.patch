From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 08:44:28 -0400
Subject: [PATCH] d3d11, d2d1, dxgi, wined3d: Drop the diagnostics left from
 the Office rendering work.

Traces tagged altars-, and the texture dumps and the outline experiment
that WINE_ALTARS_* variables switched on: they wrote textures into /tmp
and called getenv() twice on every CopySubresourceRegion().  The shared
surface warnings stay, without the tag.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 7f0e22c12b1..95d92bb45f3 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -2191,31 +2191,6 @@ static void d2d_device_context_draw_glyph_run_bitmap(struct d2d_device_context *
     transform = &context->drawing_state.transform;
     m = *transform;
     *transform = identity;
-    /* altars diagnostic: the glyph run's own destination against the clip it
-     * has to survive.  Word's Backstage rail labels go through this function
-     * with no error and never appear; the two rectangles here, printed next to
-     * the run's text (which +d2d prints immediately above), are what says
-     * whether the fill was ever inside the clip. */
-    if (TRACE_ON(d2d))
-    {
-        const D2D1_RECT_F *clip = context->clip_stack.count
-                ? &context->clip_stack.stack[context->clip_stack.count - 1] : NULL;
-
-        size_t i, set = 0;
-
-        /* How much coverage the rasteriser actually produced.  An all-zero
-         * mask fills nothing and looks identical, from every other vantage
-         * point in this function, to a fill that was dropped later. */
-        for (i = 0; i < opacity_values_size; ++i)
-            if (((const unsigned char *)opacity_values)[i]) ++set;
-
-        TRACE("Glyph run rect %s, bounds %s, transform {%.2f %.2f %.2f %.2f %.2f %.2f}, "
-                "clip %s (depth %u), brush %p, mask %ux%u, coverage %lu/%lu.\n",
-                debug_d2d_rect_f(&run_rect), wine_dbgstr_rect(&bounds),
-                m._11, m._12, m._21, m._22, m._31, m._32,
-                clip ? debug_d2d_rect_f(clip) : "none", (unsigned int)context->clip_stack.count,
-                brush, bitmap_size.width, bitmap_size.height, (unsigned long)set, (unsigned long)opacity_values_size);
-    }
     d2d_device_context_fill_geometry(context, unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)geometry),
             unsafe_impl_from_ID2D1Brush(brush), unsafe_impl_from_ID2D1Brush((ID2D1Brush *)opacity_brush));
     *transform = m;
@@ -2338,20 +2313,6 @@ static void d2d_device_context_draw_glyph_run(struct d2d_device_context *context
         return;
     }
 
-    /* altars experiment: WINE_ALTARS_GLYPH_OUTLINE=1 sends every run down the
-     * outline path instead, which fills glyph geometry directly rather than
-     * going through an A8 coverage mask and a bitmap brush.  It answers, in
-     * one run, whether the labels Word never shows are lost inside the bitmap
-     * path or somewhere past it. */
-    {
-        static int force_outline = -1;
-
-        if (force_outline < 0)
-            force_outline = !!getenv("WINE_ALTARS_GLYPH_OUTLINE");
-        if (force_outline)
-            rendering_mode = DWRITE_RENDERING_MODE_OUTLINE;
-    }
-
     if (rendering_mode == DWRITE_RENDERING_MODE_OUTLINE)
         d2d_device_context_draw_glyph_run_outline(context, baseline_origin, glyph_run, brush);
     else
