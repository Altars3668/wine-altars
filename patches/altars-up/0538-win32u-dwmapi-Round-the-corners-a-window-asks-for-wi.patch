From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 04:48:20 -0400
Subject: [PATCH] win32u, dwmapi: Round the corners a window asks for with
 DWMWA_WINDOW_CORNER_PREFERENCE.

Office's dropdowns, menus and flyouts ask the window manager for round
corners (DWMWCP_ROUND or DWMWCP_ROUNDSMALL) and draw nothing of their
own there, so under Wine they were square.  Windows 11 rounds them by
8 and 4 pixels at 96 dpi, and leaves a maximized window square.

dwmapi hands the preference to win32u, which cuts the corners out of
the window surface's shape, on top of any window region the
application set; GetWindowRgn still returns the latter.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/dwmapi/Makefile.in b/dlls/dwmapi/Makefile.in
index cf889cb148e..f837e58b439 100644
--- a/dlls/dwmapi/Makefile.in
+++ b/dlls/dwmapi/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = dwmapi.dll
-IMPORTS   = user32
+IMPORTS   = user32 win32u
 IMPORTLIB = dwmapi
 
 VER_FILEDESCRIPTION_STR = "Desktop Window Manager API"
diff --git a/dlls/dwmapi/dwmapi_main.c b/dlls/dwmapi/dwmapi_main.c
index 417a4e634e9..87d3baaa2ad 100644
--- a/dlls/dwmapi/dwmapi_main.c
+++ b/dlls/dwmapi/dwmapi_main.c
@@ -28,6 +28,7 @@
 #include "wingdi.h"
 #include "winuser.h"
 #include "dwmapi.h"
+#include "ntuser.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dwmapi);
@@ -194,6 +195,9 @@ HRESULT WINAPI DwmSetWindowAttribute(HWND hwnd, DWORD attribute, LPCVOID value,
     if (kind == ATTRIBUTE_BOOL) data = !!data;
 
     if (!SetPropW(hwnd, attribute_prop(attribute, name), ULongToHandle(data))) return E_HANDLE;
+    /* the window manager rounds the corners: the window's surface takes that shape */
+    if (attribute == DWMWA_WINDOW_CORNER_PREFERENCE)
+        NtUserCallHwndParam(hwnd, data, NtUserCallHwndParam_SetCornerPreference);
     return S_OK;
 }
 
diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
index 465fb59d030..7a1919bfd74 100644
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -71,6 +71,7 @@ typedef struct tagWND
     int                swap_interval; /* OpenGL surface swap interval */
     int                pixel_format;  /* Pixel format set by the graphics driver */
     int                clip_clients;  /* Has client surfaces that needs to be clipped out */
+    UINT               corner_preference; /* DWMWA_WINDOW_CORNER_PREFERENCE, for the surface shape */
 } WND;
 
 /* WND flags values */
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index a99f3b37cea..0133cf39933 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2109,13 +2109,40 @@ static NTSTATUS get_window_region( HWND hwnd, BOOL surface, HRGN *region, RECT *
     return status;
 }
 
+/***********************************************************************
+ *           get_corner_region
+ *
+ * The rounded corners the desktop window manager of Windows 11 gives a window that asks for
+ * them with DWMWA_WINDOW_CORNER_PREFERENCE: 8 pixels, or 4 for the small ones, at 96 dpi.  A
+ * maximized window stays square.
+ */
+static HRGN get_corner_region( WND *win, UINT dpi )
+{
+    /* in the surface, whose rect is rounded up, the window is at 0,0 */
+    int width = win->rects.visible.right - win->rects.visible.left;
+    int height = win->rects.visible.bottom - win->rects.visible.top;
+    UINT radius;
+
+    switch (win->corner_preference)
+    {
+    case 2 /* DWMWCP_ROUND */: radius = 8; break;
+    case 3 /* DWMWCP_ROUNDSMALL */: radius = 4; break;
+    default: return 0;
+    }
+    if (win->dwStyle & WS_MAXIMIZE) return 0;
+    radius = muldiv( radius, dpi, USER_DEFAULT_SCREEN_DPI );
+    /* the region leaves out the right and bottom edges */
+    return NtGdiCreateRoundRectRgn( 0, 0, width + 1, height + 1, 2 * radius, 2 * radius );
+}
+
 /***********************************************************************
  *           update_surface_region
  */
 static void update_surface_region( HWND hwnd )
 {
+    UINT dpi = round_dpi( get_dpi_for_window( hwnd ));
     WND *win = get_win_ptr( hwnd );
-    HRGN region, shape = 0;
+    HRGN region, shape = 0, corners;
     RECT visible;
 
     if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return;
@@ -2129,6 +2156,17 @@ static void update_surface_region( HWND hwnd )
         if (win->dwExStyle & WS_EX_LAYOUTRTL) NtUserMirrorRgn( hwnd, shape );
         NtGdiDeleteObjectApp( region );
     }
+    /* what the window manager rounds off comes on top of the window region; GetWindowRgn
+     * still returns the region the application set */
+    if ((corners = get_corner_region( win, dpi )))
+    {
+        if (!shape) shape = corners;
+        else
+        {
+            NtGdiCombineRgn( shape, shape, corners, RGN_AND );
+            NtGdiDeleteObjectApp( corners );
+        }
+    }
     window_surface_set_shape( win->surface, shape );
 
     if (get_window_region( hwnd, TRUE, &region, &visible )) goto done;
@@ -2146,6 +2184,24 @@ done:
     release_win_ptr( win );
 }
 
+/***********************************************************************
+ *           set_corner_preference
+ *
+ * dwmapi passes on the window's DWMWA_WINDOW_CORNER_PREFERENCE, which shapes its surface.
+ */
+static BOOL set_corner_preference( HWND hwnd, UINT preference )
+{
+    WND *win = get_win_ptr( hwnd );
+    BOOL changed;
+
+    if (!win || win == WND_DESKTOP || win == WND_OTHER_PROCESS) return FALSE;
+    changed = win->corner_preference != preference;
+    win->corner_preference = preference;
+    release_win_ptr( win );
+    if (changed) update_surface_region( hwnd );
+    return TRUE;
+}
+
 
 static RECT get_visible_rect( HWND hwnd, BOOL shaped, UINT style, UINT ex_style, const struct window_rects *rects )
 {
@@ -6719,6 +6775,9 @@ ULONG_PTR WINAPI NtUserCallHwndParam( HWND hwnd, DWORD_PTR param, DWORD code )
         return set_window_long_internal( hwnd, params->offset, params->size, params->value, FALSE, TRUE );
     }
 
+    case NtUserCallHwndParam_SetCornerPreference:
+        return set_corner_preference( hwnd, param );
+
     default:
         FIXME( "invalid code %u\n", code );
         return 0;
diff --git a/include/ntuser.h b/include/ntuser.h
index 0d99eebc04f..c1aee52228a 100644
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -1428,6 +1428,7 @@ enum
     NtUserCallHwndParam_SetRawWindowPos,
     NtUserCallHwndParam_GetPrivateData,
     NtUserCallHwndParam_SetPrivateData,
+    NtUserCallHwndParam_SetCornerPreference,
 };
 
 struct get_window_rects_params
