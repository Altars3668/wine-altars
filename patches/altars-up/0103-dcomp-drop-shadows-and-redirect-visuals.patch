diff --git a/dlls/dcomp/render.c b/dlls/dcomp/render.c
index cc3ce318388..bf4bcf3ea98 100644
--- a/dlls/dcomp/render.c
+++ b/dlls/dcomp/render.c
@@ -285,6 +285,7 @@ struct render
     struct target *target;
     ID2D1DeviceContext *context;
     ID2D1SolidColorBrush *solid;
+    unsigned int redirects;     /* redirect visuals being drawn */
 };
 
 static D2D1_COLOR_F color_f( Color color )
@@ -541,8 +542,53 @@ static void draw_nine_grid( struct render *render, const struct brush *brush, co
     FIXME( "nine-grid of a brush of kind %u not drawn.\n", source->kind );
 }
 
+/*
+ * A drop shadow falls under what the sprite draws, moved by its offset and
+ * softened by its blur radius.  Direct2D here has no blur to do that with, so
+ * the softening is a few rectangles, each larger and fainter than the last.
+ */
+static void draw_shadow( struct render *render, ICompositionShadow *iface, Vector2 size, float opacity )
+{
+    struct shadow_state shadow;
+    D2D1_COLOR_F color;
+    D2D1_RECT_F rect;
+    unsigned int i, steps;
+
+    if (!shadow_get_state( iface, &shadow ))
+    {
+        FIXME( "shadow %p is not one of ours.\n", iface );
+        return;
+    }
+    color = color_f( shadow.color );
+    opacity *= shadow.opacity;
+    if (opacity <= 0.0f || !color.a || size.X <= 0.0f || size.Y <= 0.0f) return;
+    if (!render->solid &&
+        FAILED(ID2D1DeviceContext_CreateSolidColorBrush( render->context, &color, NULL, &render->solid )))
+        return;
+    ID2D1SolidColorBrush_SetColor( render->solid, &color );
+
+    steps = shadow.blur_radius > 0.0f ? 4 : 1;
+    ID2D1SolidColorBrush_SetOpacity( render->solid, opacity / steps );
+    for (i = 0; i < steps; i++)
+    {
+        float grow = steps > 1 ? shadow.blur_radius * ((float)(steps - i) / steps - 0.5f) : 0.0f;
+
+        rect.left = shadow.offset.X - grow;
+        rect.top = shadow.offset.Y - grow;
+        rect.right = shadow.offset.X + size.X + grow;
+        rect.bottom = shadow.offset.Y + size.Y + grow;
+        if (rect.right <= rect.left || rect.bottom <= rect.top) continue;
+        ID2D1DeviceContext_FillRectangle( render->context, &rect, (ID2D1Brush *)render->solid );
+    }
+}
+
+/*
+ * Draws a visual and what is in it.  A redirect visual draws its source
+ * again, as if it were in it, where the source's own transform does not
+ * count, as on Windows.
+ */
 static void draw_visual( struct render *render, struct visual *visual, const matrix *parent, float opacity,
-                         Vector2 parent_size )
+                         Vector2 parent_size, BOOL redirected )
 {
     struct visual_state state;
     D2D1_MATRIX_3X2_F world_2d;
@@ -557,18 +603,19 @@ static void draw_visual( struct render *render, struct visual *visual, const mat
 
     size.X = state.size.X + state.relative_size.X * parent_size.X;
     size.Y = state.size.Y + state.relative_size.Y * parent_size.Y;
-    visual_transform( &state, size, parent_size, &world );
+    if (redirected) matrix_identity( &world );
+    else visual_transform( &state, size, parent_size, &world );
     matrix_multiply( &world, &world, parent );
     world_2d = matrix_to_2d( &world );
     ID2D1DeviceContext_SetTransform( render->context, &world_2d );
 
     clipped = clip_push( render->context, visual->clip, size );
 
+    if (visual->kind == VISUAL_SPRITE && visual->shadow) draw_shadow( render, visual->shadow, size, opacity );
     if (visual->kind == VISUAL_SPRITE && visual->brush)
     {
         struct brush_state brush;
 
-        if (visual->shadow) FIXME( "shadow not drawn.\n" );
         brush_get_state( visual->brush, &brush );
         switch (visual->brush->kind)
         {
@@ -579,7 +626,15 @@ static void draw_visual( struct render *render, struct visual *visual, const mat
     }
 
     LIST_FOR_EACH_ENTRY( child, &visual->children, struct visual, entry )
-        draw_visual( render, child, &world, opacity, size );
+        draw_visual( render, child, &world, opacity, size, FALSE );
+
+    /* a source that is, or holds, the redirect visual is drawn so many times over, and no more */
+    if (visual->kind == VISUAL_REDIRECT && visual->redirect_source && render->redirects < 4)
+    {
+        render->redirects++;
+        draw_visual( render, visual->redirect_source, &world, opacity, size, TRUE );
+        render->redirects--;
+    }
 
     if (clipped)
     {
@@ -641,7 +696,7 @@ HRESULT render_target( struct compositor *compositor, struct target *target )
     matrix_identity( &identity );
     size.X = client.right;
     size.Y = client.bottom;
-    draw_visual( &render, target->root, &identity, 1.0f, size );
+    draw_visual( &render, target->root, &identity, 1.0f, size, FALSE );
     hr = ID2D1DeviceContext_EndDraw( render.context, NULL, NULL );
     ID2D1DeviceContext_SetTarget( render.context, NULL );
     ID2D1Bitmap1_Release( backbuffer );
