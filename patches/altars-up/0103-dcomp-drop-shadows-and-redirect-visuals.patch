+static void test_redirect_visual(void)
+{
+    IDispatcherQueueController *queue;
+    ICompositorController *controller;
+    IRedirectVisual *redirect;
+    IContainerVisual *container;
+    ICompositor6 *compositor6;
+    ICompositor *compositor;
+    IVisual *visual, *got;
+    HRESULT hr;
+
+    queue = create_queue( DQTAT_COM_STA );
+    if (!(controller = create_controller( &compositor ))) goto done;
+    ICompositor_QueryInterface( compositor, &IID_ICompositor6, (void **)&compositor6 );
+    ICompositor_CreateContainerVisual( compositor, &container );
+    IContainerVisual_QueryInterface( container, &IID_IVisual, (void **)&visual );
+
+    hr = ICompositor6_CreateRedirectVisual( compositor6, &redirect );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( redirect, L"Windows.UI.Composition.RedirectVisual" );
+    check_interface( redirect, &IID_IContainerVisual, TRUE );
+    check_interface( redirect, &IID_IVisual, TRUE );
+    check_interface( redirect, &IID_ISpriteVisual, FALSE );
+    got = (void *)0xdeadbeef;
+    hr = IRedirectVisual_get_Source( redirect, &got );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !got, "got source %p.\n", got );
+    hr = IRedirectVisual_put_Source( redirect, visual );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IRedirectVisual_get_Source( redirect, &got );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( got == visual, "got source %p.\n", got );
+    if (got) IVisual_Release( got );
+    IRedirectVisual_Release( redirect );
+
+    hr = ICompositor6_CreateRedirectVisualWithSourceVisual( compositor6, visual, &redirect );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IRedirectVisual_get_Source( redirect, &got );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( got == visual, "got source %p.\n", got );
+    if (got) IVisual_Release( got );
+    IRedirectVisual_Release( redirect );
+
+    IVisual_Release( visual );
+    IContainerVisual_Release( container );
+    ICompositor6_Release( compositor6 );
+    ICompositor_Release( compositor );
+    ICompositorController_Release( controller );
+done:
+    if (queue) IDispatcherQueueController_Release( queue );
+}
