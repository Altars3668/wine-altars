+DEFINE_IINSPECTABLE( redirect, IRedirectVisual, struct visual, base.ICompositionObject_iface )
+
+static HRESULT WINAPI redirect_get_Source( IRedirectVisual *iface, IVisual **value )
+{
+    struct visual *visual = impl_from_IRedirectVisual( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( visual->base.compositor );
+    if ((*value = visual->redirect_source ? &visual->redirect_source->IVisual_iface : NULL)) IVisual_AddRef( *value );
+    compositor_unlock( visual->base.compositor );
+    return S_OK;
+}
+
+/* as on Windows, any visual will do, even one the redirect visual is in */
+static HRESULT WINAPI redirect_put_Source( IRedirectVisual *iface, IVisual *value )
+{
+    struct visual *visual = impl_from_IRedirectVisual( iface ), *source = value ? unsafe_impl_from_IVisual( value ) : NULL, *old;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (value && !source) return E_INVALIDARG;
+    if (source) IVisual_AddRef( &source->IVisual_iface );
+    compositor_lock( visual->base.compositor );
+    old = visual->redirect_source;
+    visual->redirect_source = source;
+    compositor_changed( visual->base.compositor );
+    compositor_unlock( visual->base.compositor );
+    if (old) IVisual_Release( &old->IVisual_iface );
+    return S_OK;
+}
