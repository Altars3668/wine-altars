+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+struct shadow
+{
+    struct object base;
+    ICompositionShadow ICompositionShadow_iface;
+    IDropShadow IDropShadow_iface;
+    IDropShadow2 IDropShadow2_iface;
+    struct shadow_state props;      /* as they were set */
+    ICompositionBrush *mask;
+    CompositionDropShadowSourcePolicy source_policy;
+};
+
+static inline struct shadow *impl_from_shadow_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct shadow, base );
+}
+
+static HRESULT shadow_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct shadow *shadow = impl_from_shadow_object( object );
+
+    if (IsEqualGUID( iid, &IID_ICompositionShadow )) *out = &shadow->ICompositionShadow_iface;
+    else if (IsEqualGUID( iid, &IID_IDropShadow )) *out = &shadow->IDropShadow_iface;
+    else if (IsEqualGUID( iid, &IID_IDropShadow2 )) *out = &shadow->IDropShadow2_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void shadow_destroy( struct object *object )
+{
+    struct shadow *shadow = impl_from_shadow_object( object );
+
+    if (shadow->mask) ICompositionBrush_Release( shadow->mask );
+    free( shadow );
+}
+
+static const struct property_desc shadow_properties[] =
+{
+    { L"BlurRadius", VALUE_SCALAR, offsetof(struct shadow_state, blur_radius) },
+    { L"Color", VALUE_COLOR, offsetof(struct shadow_state, color) },
+    { L"Offset", VALUE_VECTOR3, offsetof(struct shadow_state, offset) },
+    { L"Opacity", VALUE_SCALAR, offsetof(struct shadow_state, opacity) },
+    { NULL }
+};
+
+static BOOL shadow_get_property( struct object *object, const WCHAR *name, struct value *value )
+{
+    struct shadow *shadow = impl_from_shadow_object( object );
+    const struct property_desc *desc;
+
+    if (!(desc = property_find( shadow_properties, name ))) return FALSE;
+    return property_get( desc, &shadow->props, value );
+}
+
+static BOOL shadow_set_property( struct object *object, const WCHAR *name, const struct value *value )
+{
+    struct shadow *shadow = impl_from_shadow_object( object );
+    const struct property_desc *desc;
+
+    if (!(desc = property_find( shadow_properties, name ))) return FALSE;
+    return property_set( desc, &shadow->props, value );
+}
+
+static const struct object_ops shadow_ops =
+{
+    L"Windows.UI.Composition.DropShadow",
+    shadow_query_interface,
+    shadow_destroy,
+    NULL,
+    shadow_get_property,
+    shadow_set_property,
+};
+
+DEFINE_IINSPECTABLE( cshadow, ICompositionShadow, struct shadow, base.ICompositionObject_iface )
+
+static const struct ICompositionShadowVtbl cshadow_vtbl =
+{
+    cshadow_QueryInterface,
+    cshadow_AddRef,
+    cshadow_Release,
+    /* IInspectable methods */
+    cshadow_GetIids,
+    cshadow_GetRuntimeClassName,
+    cshadow_GetTrustLevel,
+    /* ICompositionShadow methods */
+};
+
+DEFINE_IINSPECTABLE( drop, IDropShadow, struct shadow, base.ICompositionObject_iface )
+
+static HRESULT WINAPI drop_get_BlurRadius( IDropShadow *iface, FLOAT *value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( shadow->base.compositor );
+    *value = shadow->props.blur_radius;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_put_BlurRadius( IDropShadow *iface, FLOAT value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    compositor_lock( shadow->base.compositor );
+    shadow->props.blur_radius = value;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_get_Color( IDropShadow *iface, Color *value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( shadow->base.compositor );
+    *value = shadow->props.color;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_put_Color( IDropShadow *iface, Color value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    compositor_lock( shadow->base.compositor );
+    shadow->props.color = value;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_get_Mask( IDropShadow *iface, ICompositionBrush **value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( shadow->base.compositor );
+    if ((*value = shadow->mask)) ICompositionBrush_AddRef( *value );
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_put_Mask( IDropShadow *iface, ICompositionBrush *value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+    ICompositionBrush *old;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (value) ICompositionBrush_AddRef( value );
+    compositor_lock( shadow->base.compositor );
+    old = shadow->mask;
+    shadow->mask = value;
+    compositor_changed( shadow->base.compositor );
+    compositor_unlock( shadow->base.compositor );
+    if (old) ICompositionBrush_Release( old );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_get_Offset( IDropShadow *iface, Vector3 *value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( shadow->base.compositor );
+    *value = shadow->props.offset;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_put_Offset( IDropShadow *iface, Vector3 value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    compositor_lock( shadow->base.compositor );
+    shadow->props.offset = value;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_get_Opacity( IDropShadow *iface, FLOAT *value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( shadow->base.compositor );
+    *value = shadow->props.opacity;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop_put_Opacity( IDropShadow *iface, FLOAT value )
+{
+    struct shadow *shadow = impl_from_IDropShadow( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    compositor_lock( shadow->base.compositor );
+    shadow->props.opacity = value;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static const struct IDropShadowVtbl drop_vtbl =
+{
+    drop_QueryInterface,
+    drop_AddRef,
+    drop_Release,
+    /* IInspectable methods */
+    drop_GetIids,
+    drop_GetRuntimeClassName,
+    drop_GetTrustLevel,
+    /* IDropShadow methods */
+    drop_get_BlurRadius,
+    drop_put_BlurRadius,
+    drop_get_Color,
+    drop_put_Color,
+    drop_get_Mask,
+    drop_put_Mask,
+    drop_get_Offset,
+    drop_put_Offset,
+    drop_get_Opacity,
+    drop_put_Opacity,
+};
+
+DEFINE_IINSPECTABLE( drop2, IDropShadow2, struct shadow, base.ICompositionObject_iface )
+
+static HRESULT WINAPI drop2_get_SourcePolicy( IDropShadow2 *iface, CompositionDropShadowSourcePolicy *value )
+{
+    struct shadow *shadow = impl_from_IDropShadow2( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    compositor_lock( shadow->base.compositor );
+    *value = shadow->source_policy;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static HRESULT WINAPI drop2_put_SourcePolicy( IDropShadow2 *iface, CompositionDropShadowSourcePolicy value )
+{
+    struct shadow *shadow = impl_from_IDropShadow2( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    compositor_lock( shadow->base.compositor );
+    shadow->source_policy = value;
+    compositor_unlock( shadow->base.compositor );
+    return S_OK;
+}
+
+static const struct IDropShadow2Vtbl drop2_vtbl =
+{
+    drop2_QueryInterface,
+    drop2_AddRef,
+    drop2_Release,
+    /* IInspectable methods */
+    drop2_GetIids,
+    drop2_GetRuntimeClassName,
+    drop2_GetTrustLevel,
+    /* IDropShadow2 methods */
+    drop2_get_SourcePolicy,
+    drop2_put_SourcePolicy,
+};
+
+/* what a visual's shadow comes to with its animations; FALSE for a shadow not of ours */
+BOOL shadow_get_state( ICompositionShadow *iface, struct shadow_state *state )
+{
+    const struct property_desc *desc;
+    struct shadow *shadow;
+    struct value value;
+
+    if (!iface || iface->lpVtbl != &cshadow_vtbl) return FALSE;
+    shadow = impl_from_ICompositionShadow( iface );
+    *state = shadow->props;
+    if (list_empty( &shadow->base.animations )) return TRUE;
+    for (desc = shadow_properties; desc->name; desc++)
+    {
+        property_get( desc, state, &value );
+        if (object_animate( &shadow->base, desc->name, &value, 0 )) property_set( desc, state, &value );
+    }
+    return TRUE;
+}
+
+HRESULT drop_shadow_create( struct compositor *compositor, IDropShadow **out )
+{
+    struct shadow *shadow;
+
+    if (!(shadow = calloc( 1, sizeof(*shadow) ))) return E_OUTOFMEMORY;
+    object_init( &shadow->base, &shadow_ops, compositor );
+    shadow->ICompositionShadow_iface.lpVtbl = &cshadow_vtbl;
+    shadow->IDropShadow_iface.lpVtbl = &drop_vtbl;
+    shadow->IDropShadow2_iface.lpVtbl = &drop2_vtbl;
+    /* as Windows has them */
+    shadow->props.blur_radius = 9.0f;
+    shadow->props.color.A = 255;
+    shadow->props.opacity = 1.0f;
+    *out = &shadow->IDropShadow_iface;
+    return S_OK;
+}
diff --git a/dlls/dcomp/tests/composition.c b/dlls/dcomp/tests/composition.c
index 059f3cc91c1..9641757e200 100644
--- a/dlls/dcomp/tests/composition.c
+++ b/dlls/dcomp/tests/composition.c
@@ -982,6 +982,130 @@ done:
     if (queue) IDispatcherQueueController_Release( queue );
 }
 
+static void test_drop_shadow(void)
+{
+    IDispatcherQueueController *queue;
+    ICompositorController *controller;
+    ICompositionBrush *mask = (void *)0xdeadbeef;
+    CompositionDropShadowSourcePolicy policy = -1;
+    ICompositionShadow *cshadow;
+    ICompositor2 *compositor2;
+    ISpriteVisual2 *sprite2;
+    ICompositor *compositor;
+    IDropShadow2 *shadow2;
+    ISpriteVisual *sprite;
+    IDropShadow *shadow;
+    Vector3 v3;
+    Color c;
+    FLOAT f;
+    HRESULT hr;
+
+    queue = create_queue( DQTAT_COM_STA );
+    if (!(controller = create_controller( &compositor ))) goto done;
+    ICompositor_QueryInterface( compositor, &IID_ICompositor2, (void **)&compositor2 );
+
+    hr = ICompositor2_CreateDropShadow( compositor2, &shadow );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( shadow, L"Windows.UI.Composition.DropShadow" );
+    check_interface( shadow, &IID_ICompositionShadow, TRUE );
+    check_interface( shadow, &IID_ICompositionObject, TRUE );
+    f = -1;
+    IDropShadow_get_BlurRadius( shadow, &f );
+    ok( f == 9.0f, "got blur radius %f.\n", f );
+    memset( &c, 0, sizeof(c) );
+    IDropShadow_get_Color( shadow, &c );
+    ok( c.A == 255 && !c.R && !c.G && !c.B, "got color %02x%02x%02x%02x.\n", c.A, c.R, c.G, c.B );
+    IDropShadow_get_Offset( shadow, &v3 );
+    ok( !v3.X && !v3.Y && !v3.Z, "got offset %f,%f,%f.\n", v3.X, v3.Y, v3.Z );
+    f = -1;
+    IDropShadow_get_Opacity( shadow, &f );
+    ok( f == 1.0f, "got opacity %f.\n", f );
+    hr = IDropShadow_get_Mask( shadow, &mask );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !mask, "got mask %p.\n", mask );
+    IDropShadow_QueryInterface( shadow, &IID_IDropShadow2, (void **)&shadow2 );
+    IDropShadow2_get_SourcePolicy( shadow2, &policy );
+    ok( policy == CompositionDropShadowSourcePolicy_Default, "got source policy %d.\n", policy );
+    IDropShadow2_Release( shadow2 );
+    /* nothing it is set to is refused */
+    hr = IDropShadow_put_BlurRadius( shadow, -1.0f );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDropShadow_put_Opacity( shadow, 2.0f );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IDropShadow_get_Opacity( shadow, &f );
+    ok( f == 2.0f, "got opacity %f.\n", f );
+    hr = start_scalar( compositor, shadow, L"BlurRadius", NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    ICompositor_CreateSpriteVisual( compositor, &sprite );
+    ISpriteVisual_QueryInterface( sprite, &IID_ISpriteVisual2, (void **)&sprite2 );
+    IDropShadow_QueryInterface( shadow, &IID_ICompositionShadow, (void **)&cshadow );
+    hr = ISpriteVisual2_put_Shadow( sprite2, cshadow );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionShadow_Release( cshadow );
+    ISpriteVisual2_Release( sprite2 );
+    ISpriteVisual_Release( sprite );
+    IDropShadow_Release( shadow );
+
+    ICompositor2_Release( compositor2 );
+    ICompositor_Release( compositor );
+    ICompositorController_Release( controller );
+done:
+    if (queue) IDispatcherQueueController_Release( queue );
+}
