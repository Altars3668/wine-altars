+/* retrieve the command line of a process: what its parameters in the PEB hold, where the process
+ * may have changed it, or before it has started, what its creator gave */
+DECL_HANDLER(get_process_cmdline)
+{
+    struct process *process = get_process_from_handle( req->handle, PROCESS_QUERY_LIMITED_INFORMATION );
+    int is_64bit = is_machine_64bit( native_machine );
+    unsigned short len = 0;
+    client_ptr_t buffer = 0;
+    WCHAR *cmdline = NULL;
+
+    if (!process) return;
+
+    if (process->peb)
+    {
+        /* the ProcessParameters pointer in the PEB, the CommandLine string in the parameters */
+        unsigned int params_offset = is_64bit ? 0x20 : 0x10, cmdline_offset = is_64bit ? 0x70 : 0x40;
+        unsigned int flags = 0;
+        client_ptr_t params = 0;
+        char str[16];
+
+        if (!read_process_memory( process, process->peb + params_offset, is_64bit ? 8 : 4, (char *)&params ) ||
+            !read_process_memory( process, params + 8, sizeof(flags), (char *)&flags ) ||
+            !read_process_memory( process, params + cmdline_offset, is_64bit ? 16 : 8, str ))
+            goto done;
+        memcpy( &len, str, sizeof(len) );
+        if (is_64bit) memcpy( &buffer, str + 8, 8 );
+        else { unsigned int ptr; memcpy( &ptr, str + 4, 4 ); buffer = ptr; }
+        /* until they are normalized, the strings are offsets from the parameters */
+        if (!(flags & PROCESS_PARAMS_FLAG_NORMALIZED)) buffer += params;
+        if (len && !(cmdline = mem_alloc( len ))) goto done;
+        if (len && !read_process_memory( process, buffer, len, (char *)cmdline )) goto done;
+    }
+    else if (process->startup_info && process->startup_info->data)
+    {
+        const struct startup_info_data *data = process->startup_info->data;
+
+        len = data->cmdline_len;
+        if (len && !(cmdline = memdup( (const char *)(data + 1) + data->imagepath_len + data->curdir_len +
+                                       data->dllpath_len, len ))) goto done;
+    }
+    else
+    {
+        set_error( STATUS_UNSUCCESSFUL );
+        goto done;
+    }
+
+    reply->len = len;
+    if (len <= get_reply_max_size()) set_reply_data( cmdline, len );
+    else set_error( STATUS_BUFFER_TOO_SMALL );
+
+done:
+    free( cmdline );
+    release_object( process );
+}
