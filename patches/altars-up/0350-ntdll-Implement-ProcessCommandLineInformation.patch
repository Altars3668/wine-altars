+static void test_query_process_cmdline(void)
+{
+    const WCHAR *cmdline = GetCommandLineW();
+    STARTUPINFOW si = { sizeof(si) };
+    WCHAR path[MAX_PATH], cmd[MAX_PATH + 64];
+    PROCESS_INFORMATION pi;
+    UNICODE_STRING *buffer, str;
+    NTSTATUS status;
+    HANDLE process;
+    ULONG len;
+
+    status = NtQueryInformationProcess( GetCurrentProcess(), ProcessCommandLineInformation, &str, sizeof(str), &len );
+    if (status == STATUS_INVALID_INFO_CLASS)
+    {
+        win_skip( "ProcessCommandLineInformation is not supported\n" );
+        return;
+    }
+    ok( status == STATUS_INFO_LENGTH_MISMATCH, "got %#lx.\n", status );
+    ok( len >= sizeof(str) + wcslen( cmdline ) * sizeof(WCHAR), "got %lu.\n", len );
+
+    buffer = malloc( len );
+    memset( buffer, 0xcc, len );
+    status = NtQueryInformationProcess( GetCurrentProcess(), ProcessCommandLineInformation, buffer, len, &len );
+    ok( !status, "got %#lx.\n", status );
+    ok( buffer->Length == wcslen( cmdline ) * sizeof(WCHAR), "got %u.\n", buffer->Length );
+    ok( buffer->Buffer == (WCHAR *)(buffer + 1), "got %p, %p.\n", buffer->Buffer, buffer + 1 );
+    ok( !memcmp( buffer->Buffer, cmdline, buffer->Length ), "got %s.\n",
+        wine_dbgstr_wn( buffer->Buffer, buffer->Length / sizeof(WCHAR) ));
+    free( buffer );
+
+    /* another process, which has not run yet, through a handle that may only query a little */
+    GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) );
+    swprintf( cmd, ARRAY_SIZE(cmd), L"\"%s\" info  a   command line", path );
+    if (!CreateProcessW( NULL, cmd, NULL, NULL, FALSE, CREATE_SUSPENDED, NULL, NULL, &si, &pi ))
+    {
+        ok( 0, "CreateProcess failed, error %lu.\n", GetLastError() );
+        return;
+    }
+    process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pi.dwProcessId );
+    ok( !!process, "OpenProcess failed, error %lu.\n", GetLastError() );
+    status = NtQueryInformationProcess( process, ProcessCommandLineInformation, &str, sizeof(str), &len );
+    ok( status == STATUS_INFO_LENGTH_MISMATCH, "got %#lx.\n", status );
+    ok( len >= sizeof(str) + wcslen( cmd ) * sizeof(WCHAR), "got %lu.\n", len );
+    buffer = malloc( len );
+    status = NtQueryInformationProcess( process, ProcessCommandLineInformation, buffer, len, &len );
+    ok( !status, "got %#lx.\n", status );
+    ok( buffer->Length == wcslen( cmd ) * sizeof(WCHAR), "got %u.\n", buffer->Length );
+    ok( !memcmp( buffer->Buffer, cmd, buffer->Length ), "got %s.\n",
+        wine_dbgstr_wn( buffer->Buffer, buffer->Length / sizeof(WCHAR) ));
+    free( buffer );
+    CloseHandle( process );
+
+    TerminateProcess( pi.hProcess, 0 );
+    WaitForSingleObject( pi.hProcess, INFINITE );
+    CloseHandle( pi.hProcess );
+    CloseHandle( pi.hThread );
+}
