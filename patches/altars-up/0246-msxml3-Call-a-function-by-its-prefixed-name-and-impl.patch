From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 03:32:02 -0400
Subject: [PATCH] msxml3: Call a function by its prefixed name, and implement
 ms:string-compare().

A name followed by a parenthesis in an expression was taken for a
function call only if it had no prefix: the lookahead scanned a name up
to a colon, where libxml2 scans the whole XML name, so
ms:string-compare(...) compiled as a name test and failed.  Looking up
a function in a namespace also compared its URI with the NULL URI of the
functions that have none.

ms:string-compare(x, y[, language[, options]]) is MSXML's XPath
extension, in urn:schemas-microsoft-com:xslt.  As tools/xpathextprobe
measured it on Windows 11 with MSXML 6, it answers -1, 0 or 1 as x
sorts before, with or after y: case sensitive with lowercase first,
hyphens sorting as in word sort; "i" ignores case, "u" puts uppercase
first where case alone decides, and any other option, fewer than two
arguments or more than four, or a language that is not a locale name
fails the query.  MSXML 3 has no extension functions: there the query
fails whatever the arguments.  That Windows also refused de-DE, sv-SE and fr-FR,
while it took en-US, zh-CN, en and de, is not followed: here any locale
name is taken.

Office's App-V runtime selects the opaque directories of a package's
virtual file system with
ms:string-compare(@Long, "root\VFS\Common AppData", "", "i") = 0; the
query failed, and so did every process's entry into the package.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index 8201946a64c..fb46a941d26 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -5408,6 +5408,151 @@ static void test_query_result_(const struct query_test *test, IXMLDOMNodeList *l
     }
 }
 
+/* What /r[expr = -1], = 0 and = 1 let through: -1, 0 or 1, 3 for none of them, or 2 for a query that fails. */
+static int xpath_compare_value(IXMLDOMDocument2 *doc, const WCHAR *expr)
+{
+    static const WCHAR *values[] = { L"-1", L"0", L"1" };
+    IXMLDOMNodeList *list;
+    WCHAR query[256];
+    unsigned int i;
+    int result = 3;
+    LONG len;
+    HRESULT hr;
+    BSTR str;
+
+    for (i = 0; i < ARRAY_SIZE(values); i++)
+    {
+        swprintf(query, ARRAY_SIZE(query), L"/r[%s = %s]", expr, values[i]);
+        str = SysAllocString(query);
+        list = NULL;
+        hr = IXMLDOMDocument2_selectNodes(doc, str, &list);
+        SysFreeString(str);
+        if (FAILED(hr))
+        {
+            ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+            return 2;
+        }
+        len = 0;
+        IXMLDOMNodeList_get_length(list, &len);
+        IXMLDOMNodeList_Release(list);
+        if (len) result = i - 1;
+    }
+    return result;
+}
+
+static void test_XPath_ms_functions(void)
+{
+    static const struct
+    {
+        const WCHAR *expr;
+        int result; /* -1, 0, 1, or 2 for a query that fails */
+    }
+    tests[] =
+    {
+        /* case sensitive, lowercase first, word sort */
+        { L"ms:string-compare('a', 'b')", -1 },
+        { L"ms:string-compare('b', 'a')", 1 },
+        { L"ms:string-compare('a', 'a')", 0 },
+        { L"ms:string-compare('a', 'A')", -1 },
+        { L"ms:string-compare('A', 'a')", 1 },
+        { L"ms:string-compare('a', 'B')", -1 },
+        { L"ms:string-compare('a-b', 'ab')", 1 },
+        { L"ms:string-compare('10', '9')", -1 },
+        { L"ms:string-compare(10, 9)", -1 },
+        { L"ms:string-compare('', 'a')", -1 },
+        { L"ms:string-compare('', '')", 0 },
+        { L"ms:string-compare('a ', 'a')", 1 },
+        { L"ms:string-compare(/r/@x, 'b')", 0 },
+        /* "i" ignores case, "u" puts uppercase first, nothing else is an option */
+        { L"ms:string-compare('a', 'A', '', 'i')", 0 },
+        { L"ms:string-compare('a', 'B', '', 'i')", -1 },
+        { L"ms:string-compare(/r/e, 'B', '', 'i')", 0 },
+        { L"ms:string-compare('root\\VFS\\Common AppData', 'ROOT\\vfs\\common appdata', '', 'i')", 0 },
+        { L"ms:string-compare('a', 'A', '', 'u')", 1 },
+        { L"ms:string-compare('A', 'a', '', 'u')", -1 },
+        { L"ms:string-compare('A', 'b', '', 'u')", -1 },
+        { L"ms:string-compare('ab', 'Ab', '', 'u')", 1 },
+        { L"ms:string-compare('a', 'A', '', '')", -1 },
+        { L"ms:string-compare('a', 'A', '', 'iu')", 2 },
+        { L"ms:string-compare('a', 'A', '', 'x')", 2 },
+        { L"ms:string-compare('a', 'A', '', 'I')", 2 },
+        /* a language by its name */
+        { L"ms:string-compare('a', 'b', 'en-US')", -1 },
+        { L"ms:string-compare('a', 'b', 'EN-us')", -1 },
+        { L"ms:string-compare('a', 'b', 'en')", -1 },
+        { L"ms:string-compare('a', 'A', 'en-US', 'u')", 1 },
+        { L"ms:string-compare('a', 'b', 'en_US')", 2 },
+        { L"ms:string-compare('a', 'b', 'xx-XX')", 2 },
+        /* two to four arguments */
+        { L"ms:string-compare('a')", 2 },
+        { L"ms:string-compare('a', 'b', '', 'i', 'x')", 2 },
+        /* a unary minus, as many as there are */
+        { L"-1", -1 },
+        { L"--1", 1 },
+        { L"- -1", 1 },
+        { L"-(-1)", 1 },
+        { L"1--1 - 1", 1 },
+        { L"-ms:string-compare('b', 'a')", -1 },
+    },
+    tests_30[] =
+    {
+        /* no extension functions before MSXML 4.0 */
+        { L"ms:string-compare('a', 'b')", 2 },
+        /* and a single unary minus */
+        { L"-1", -1 },
+        { L"--1", 2 },
+        { L"- -1", 2 },
+        { L"--(1)", 2 },
+        { L"-(-1)", 1 },
+        { L"-(-(1))", 1 },
+        { L"1--1 - 1", 1 },
+    };
+    IXMLDOMDocument2 *doc;
+    VARIANT_BOOL b;
+    unsigned int i;
+    HRESULT hr;
+
+    if (is_clsid_supported(&CLSID_DOMDocument60, &IID_IXMLDOMDocument2))
+    {
+        doc = create_document_version(60, &IID_IXMLDOMDocument2);
+        hr = IXMLDOMDocument2_loadXML(doc, _bstr_("<r x='b'><e>b</e></r>"), &b);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("SelectionNamespaces"),
+                _variantbstr_("xmlns:ms='urn:schemas-microsoft-com:xslt'"));
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+        for (i = 0; i < ARRAY_SIZE(tests); i++)
+        {
+            winetest_push_context("%s", wine_dbgstr_w(tests[i].expr));
+            ok(xpath_compare_value(doc, tests[i].expr) == tests[i].result, "Got unexpected result.\n");
+            winetest_pop_context();
+        }
+        IXMLDOMDocument2_Release(doc);
+    }
+
+    if (is_clsid_supported(&CLSID_DOMDocument30, &IID_IXMLDOMDocument2))
+    {
+        doc = create_document_version(30, &IID_IXMLDOMDocument2);
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("SelectionLanguage"), _variantbstr_("XPath"));
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IXMLDOMDocument2_loadXML(doc, _bstr_("<r x='b'><e>b</e></r>"), &b);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("SelectionNamespaces"),
+                _variantbstr_("xmlns:ms='urn:schemas-microsoft-com:xslt'"));
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+        for (i = 0; i < ARRAY_SIZE(tests_30); i++)
+        {
+            winetest_push_context("3.0 %s", wine_dbgstr_w(tests_30[i].expr));
+            ok(xpath_compare_value(doc, tests_30[i].expr) == tests_30[i].result, "Got unexpected result.\n");
+            winetest_pop_context();
+        }
+        IXMLDOMDocument2_Release(doc);
+    }
+
+    free_bstrs();
+}
+
 static void test_XPath(void)
 {
     static const char node_value_cmp[] =
@@ -18883,6 +19028,7 @@ START_TEST(domdoc)
     test_IXMLDOMDocument2();
     test_whitespace();
     test_XPath();
+    test_XPath_ms_functions();
     test_XSLPattern();
     test_cloneNode();
     test_xmlTypes();
diff --git a/dlls/msxml3/xpath.c b/dlls/msxml3/xpath.c
index 738318c3a37..1349075a076 100644
--- a/dlls/msxml3/xpath.c
+++ b/dlls/msxml3/xpath.c
@@ -1739,6 +1739,8 @@ static void xpath_compile_filter_expr(struct xpath_parser_context *ctxt)
  * [6] Names ::= Name (S Name)*
  *
  */
+/* An XML name, colons and all, as libxml2 scans it: the prefix of a function (ms:string-compare) is part
+ * of it, and an axis (child::) shows as "::" in it. */
 static WCHAR * xpath_scan_name(struct xpath_parser_context *ctxt)
 {
    const WCHAR *start = ctxt->cur;
@@ -1751,7 +1753,7 @@ static WCHAR * xpath_scan_name(struct xpath_parser_context *ctxt)
    {
        ++len;
    }
-   while (xml_is_ncnamechar(ctxt->cur[len]));
+   while (xml_is_ncnamechar(ctxt->cur[len]) || ctxt->cur[len] == ':');
 
    return xpath_strndup(ctxt, start, len);
 }
@@ -4985,8 +4987,11 @@ static xpath_function_ptr xpath_lookup_function(struct xpath_context *ctxt, cons
 {
     for (size_t i = 0; i < ctxt->functions.count; ++i)
     {
+        const WCHAR *entry_uri = ctxt->functions.entries[i].uri;
+
         if (wcscmp(ctxt->functions.entries[i].name, name)) continue;
-        if (uri && wcscmp(ctxt->functions.entries[i].uri, uri)) continue;
+        /* a function in a namespace is found by its namespace, and only by it */
+        if (!uri != !entry_uri || (uri && wcscmp(entry_uri, uri))) continue;
         return ctxt->functions.entries[i].func;
     }
 
@@ -7700,6 +7705,60 @@ static void xpath_register_xpath_functions(struct xpath_context *ctxt)
     xpath_register_func(ctxt, L"translate", xpath_builtin_translate);
 }
 
+/* ms:string-compare(x, y[, language[, options]]): -1, 0 or 1 as x sorts before, with or after y in the
+ * language, case sensitive with lowercase first; the options "i" ignore case, "u" put uppercase first. */
+static void xpath_ms_string_compare(struct xpath_parser_context *ctxt, int nargs)
+{
+    WCHAR *x, *y, *language = NULL, *options = NULL;
+    const WCHAR *locale = LOCALE_NAME_USER_DEFAULT;
+    bool upper_first = false;
+    DWORD flags = 0;
+    int ret;
+
+    if (nargs < 2 || nargs > 4)
+        return xpath_parser_context_set_error(ctxt, XPATH_INVALID_ARITY);
+    if (ctxt->stack.count < nargs)
+        return xpath_parser_context_set_error(ctxt, XPATH_STACK_ERROR);
+
+    if (nargs == 4) options = xpath_pop_string(ctxt);
+    if (nargs >= 3) language = xpath_pop_string(ctxt);
+    y = xpath_pop_string(ctxt);
+    x = xpath_pop_string(ctxt);
+
+    if (options && *options)
+    {
+        if (!wcscmp(options, L"i")) flags = NORM_IGNORECASE;
+        else if (!wcscmp(options, L"u")) upper_first = true;
+        else xpath_parser_context_set_error(ctxt, XPATH_INVALID_OPERAND);
+    }
+    if (language && *language)
+    {
+        /* a language is named as Windows names it, with a hyphen */
+        if (!wcschr(language, '_') && LocaleNameToLCID(language, 0)) locale = language;
+        else xpath_parser_context_set_error(ctxt, XPATH_INVALID_OPERAND);
+    }
+
+    if (!x || !y)
+        xpath_parser_context_set_error(ctxt, XPATH_INVALID_OPERAND);
+
+    if (ctxt->error == XPATH_EXPRESSION_OK)
+    {
+        ret = CompareStringEx(locale, upper_first ? NORM_IGNORECASE : flags, x, -1, y, -1, NULL, NULL, 0);
+        /* uppercase first reverses what case alone decides */
+        if (ret == CSTR_EQUAL && upper_first)
+            ret = 2 * CSTR_EQUAL - CompareStringEx(locale, 0, x, -1, y, -1, NULL, NULL, 0);
+        if (ret)
+            xpath_push_value(ctxt, xpath_new_number(ctxt, ret - CSTR_EQUAL));
+        else
+            xpath_parser_context_set_error(ctxt, XPATH_INVALID_OPERAND);
+    }
+
+    free(x);
+    free(y);
+    free(language);
+    free(options);
+}
+
 static void xpath_register_xslpattern_functions(struct xpath_context *ctxt)
 {
     xpath_register_func(ctxt, L"index", xslpattern_builtin_index);
@@ -7727,7 +7786,12 @@ struct xpath_context * xpath_create_context(bool xpath, struct domnode *node)
     ret->proximityPosition = -1;
 
     if (xpath)
+    {
         xpath_register_xpath_functions(ret);
+        /* the extension functions came with MSXML 4.0 */
+        if (ret->properties->version >= MSXML4)
+            xpath_register_func_uri(ret, L"string-compare", L"urn:schemas-microsoft-com:xslt", xpath_ms_string_compare);
+    }
     else
         xpath_register_xslpattern_functions(ret);
 
