From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 19:14:46 -0400
Subject: [PATCH] ntdll: Treat colons in file names as stream syntax, as
 Windows does.

A colon names a stream of the last element of a path only. Measured on
Windows 11 (build 29671): CreateFileW of "C:\Windows:x\y.bmp",
"file:C:\x.bmp" (which OleLoadPictureFile meets) or "win.ini:bad\name"
fails with ERROR_INVALID_NAME, where Wine looked for a folder named
"Windows:x" and failed with ERROR_PATH_NOT_FOUND; and "win.ini::$DATA",
the file's own data stream, opens the file, where Wine failed with
ERROR_FILE_NOT_FOUND. Names in the unix namespace are left alone.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit ffa8703dbe9811f81f21cf8f560a63f0078cf708)

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 515af04148c..de63b2b19e2 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -1291,7 +1291,7 @@ static void test_CreateFileA(void)
         {"c:", ERROR_SUCCESS, ERROR_PATH_NOT_FOUND, FILE_FLAG_BACKUP_SEMANTICS, FALSE }, /* device in file namespace as dir */
         {"c:\\", ERROR_PATH_NOT_FOUND, ERROR_ACCESS_DENIED, FILE_ATTRIBUTE_NORMAL, FALSE }, /* root dir w \ */
         {"c:\\", ERROR_SUCCESS, ERROR_ACCESS_DENIED, FILE_FLAG_BACKUP_SEMANTICS, FALSE }, /* root dir w \ as dir */
-        {"c:c:\\windows", ERROR_INVALID_NAME, -1, FILE_ATTRIBUTE_NORMAL, TRUE }, /* invalid path */
+        {"c:c:\\windows", ERROR_INVALID_NAME, -1, FILE_ATTRIBUTE_NORMAL, FALSE }, /* invalid path */
         {"\\\\?\\c:", ERROR_SUCCESS, ERROR_BAD_NETPATH, FILE_ATTRIBUTE_NORMAL,FALSE }, /* dev namespace drive */
         {"\\\\?\\c:\\", ERROR_PATH_NOT_FOUND, ERROR_BAD_NETPATH, FILE_ATTRIBUTE_NORMAL, FALSE }, /* dev namespace drive w \ */
         {NULL, 0, -1, 0, FALSE}
@@ -7267,6 +7267,60 @@ static void test_posix_semantics(void)
     }
 }
 
+/* colons name streams, of the last element only; "::$DATA" is a file's own data */
+static void test_stream_names(void)
+{
+    WCHAR dir[MAX_PATH], path[MAX_PATH], name[MAX_PATH];
+    HANDLE file;
+    DWORD size;
+
+    GetTempPathW(ARRAY_SIZE(dir), dir);
+    swprintf(path, ARRAY_SIZE(path), L"%swine-streams.txt", dir);
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError());
+    WriteFile(file, "data", 4, &size, NULL);
+    CloseHandle(file);
+
+    swprintf(name, ARRAY_SIZE(name), L"%s::$DATA", path);
+    file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError());
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        ok(GetFileSize(file, NULL) == 4, "got size %lu\n", GetFileSize(file, NULL));
+        CloseHandle(file);
+    }
+
+    swprintf(name, ARRAY_SIZE(name), L"%s:nostream", path);
+    SetLastError(0xdeadbeef);
+    file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ok(file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_FILE_NOT_FOUND, "got %p, error %lu\n", file,
+       GetLastError());
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+
+    swprintf(name, ARRAY_SIZE(name), L"%s:bad\\name", path);
+    SetLastError(0xdeadbeef);
+    file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ok(file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_INVALID_NAME, "got %p, error %lu\n", file,
+       GetLastError());
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+
+    dir[lstrlenW(dir) - 1] = 0;
+    swprintf(name, ARRAY_SIZE(name), L"%s:x\\wine-streams.txt", dir);
+    SetLastError(0xdeadbeef);
+    file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ok(file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_INVALID_NAME, "got %p, error %lu\n", file,
+       GetLastError());
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+
+    SetLastError(0xdeadbeef);
+    file = CreateFileW(L"file:C:\\wine-no-such.bmp", GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ok(file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_INVALID_NAME, "got %p, error %lu\n", file,
+       GetLastError());
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+
+    DeleteFileW(path);
+}
+
 START_TEST(file)
 {
     char temp_path[MAX_PATH];
@@ -7349,4 +7403,5 @@ START_TEST(file)
     test_eof();
     test_symbolic_link();
     test_posix_semantics();
+    test_stream_names();
 }
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index b9a7e244ca9..74b746b68fa 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -3672,6 +3672,7 @@ static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_
                                   UINT disposition, BOOL open_reparse, BOOL is_unix, unsigned int reparse_count )
 {
     static const WCHAR invalid_charsW[] = { INVALID_NT_CHARS, '/', 0 };
+    static const WCHAR dataW[] = {'D','A','T','A'};
     const WCHAR *name = attr->ObjectName->Buffer + nt_pos;
     unsigned int name_len = (attr->ObjectName->Length / sizeof(WCHAR)) - nt_pos;
     NTSTATUS status;
@@ -3684,6 +3685,8 @@ static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_
 
     for (ptr = name, end = name + name_len; ptr < end; ptr++)
     {
+        BOOL stream = FALSE;
+
         if (*ptr == '\\') return STATUS_OBJECT_NAME_INVALID;  /* duplicate backslash */
         if (*ptr == '.')
         {
@@ -3701,7 +3704,13 @@ static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_
             if (!*ptr) return STATUS_OBJECT_NAME_INVALID;
             if (is_unix) continue;
             if (*ptr < 32 || wcschr( invalid_charsW, *ptr )) return STATUS_OBJECT_NAME_INVALID;
+            if (*ptr == ':') stream = TRUE;
         }
+        /* a stream belongs to the last element, and "name::$DATA" is the file itself */
+        if (stream && ptr < end) return STATUS_OBJECT_NAME_INVALID;
+        if (stream && ptr - name > 7 && ptr[-7] == ':' && ptr[-6] == ':' && ptr[-5] == '$' &&
+            !wcsnicmp( ptr - 4, dataW, 4 ))
+            name_len -= 7;
     }
 
     /* try a shortcut first */
