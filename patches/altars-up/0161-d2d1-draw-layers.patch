+/* The pixels of the target a rectangle of the current space covers, as a clip keeps them. */
+static void d2d_device_context_transform_clip(struct d2d_device_context *context, const D2D1_RECT_F *rect,
+        D2D1_RECT_F *transformed_rect)
+{
+    float x_scale = context->desc.dpiX / 96.0f, y_scale = context->desc.dpiY / 96.0f;
+    D2D1_POINT_2F point;
+
+    d2d_point_transform(&point, &context->drawing_state.transform, rect->left * x_scale, rect->top * y_scale);
+    d2d_rect_set(transformed_rect, point.x, point.y, point.x, point.y);
+    d2d_point_transform(&point, &context->drawing_state.transform, rect->left * x_scale, rect->bottom * y_scale);
+    d2d_rect_expand(transformed_rect, &point);
+    d2d_point_transform(&point, &context->drawing_state.transform, rect->right * x_scale, rect->top * y_scale);
+    d2d_rect_expand(transformed_rect, &point);
+    d2d_point_transform(&point, &context->drawing_state.transform, rect->right * x_scale, rect->bottom * y_scale);
+    d2d_rect_expand(transformed_rect, &point);
+}
+
