+/* A layer pushed on a bitmap target: what is drawn goes to its bitmap until it is popped and put back. */
+struct d2d_layer_state
+{
+    struct d2d_bitmap *bitmap;
+    struct d2d_bitmap *target;
+    D2D1_LAYER_PARAMETERS1 parameters;
+    D2D1_MATRIX_3X2_F transform;
+    BOOL clipped;
+};
+
