+static void d2d_layer_state_cleanup(struct d2d_layer_state *layer)
+{
+    if (layer->bitmap)
+        ID2D1Bitmap1_Release(&layer->bitmap->ID2D1Bitmap1_iface);
+    if (layer->parameters.geometricMask)
+        ID2D1Geometry_Release(layer->parameters.geometricMask);
+    if (layer->parameters.opacityBrush)
+        ID2D1Brush_Release(layer->parameters.opacityBrush);
+}
+
+/* Layers left pushed are let go of, and what they were drawn over is the target again. */
+static void d2d_device_context_drop_layers(struct d2d_device_context *context)
+{
+    size_t i;
+
+    if (!context->layer_count)
+        return;
+    context->target.bitmap = context->layers[0].target;
+    for (i = 0; i < context->layer_count; ++i)
+        d2d_layer_state_cleanup(&context->layers[i]);
+    context->layer_count = 0;
+}
+
+/*
+ * What was drawn into a layer is put back onto what it was pushed over, through its geometric mask or, without
+ * one, its content bounds, at its opacity and through its opacity brush.  The mask is in the space the layer was
+ * pushed in, as its mask transform takes it; the layer's pixels are those of the target, one for one.
+ */
+static void d2d_device_context_composite_layer(struct d2d_device_context *context,
+        const struct d2d_layer_state *layer)
+{
+    D2D1_DRAWING_STATE_DESCRIPTION1 state = context->drawing_state;
+    const D2D1_LAYER_PARAMETERS1 *parameters = &layer->parameters;
+    D2D1_BITMAP_BRUSH_PROPERTIES1 bitmap_desc;
+    ID2D1RectangleGeometry *rectangle = NULL;
+    ID2D1Geometry *mask = parameters->geometricMask;
+    struct d2d_brush *brush, *opacity_brush;
+    D2D1_BRUSH_PROPERTIES brush_desc;
+    D2D1_MATRIX_3X2_F world;
+    D2D1_RECT_F rect;
+    HRESULT hr;
+
+    world = layer->transform;
+    if (mask)
+    {
+        world = parameters->maskTransform;
+        d2d_matrix_multiply(&world, &layer->transform);
+        if (parameters->opacityBrush && (world._11 != layer->transform._11 || world._12 != layer->transform._12
+                || world._21 != layer->transform._21 || world._22 != layer->transform._22
+                || world._31 != layer->transform._31 || world._32 != layer->transform._32))
+            FIXME("The opacity brush is mapped through the mask transform too.\n");
+    }
+    else
+    {
+        if (d2d_rect_is_bounded(&parameters->contentBounds))
+        {
+            rect = parameters->contentBounds;
+        }
+        else
+        {
+            /* all of the target */
+            d2d_rect_set(&rect, 0.0f, 0.0f, context->pixel_size.width * 96.0f / context->desc.dpiX,
+                    context->pixel_size.height * 96.0f / context->desc.dpiY);
+            world._11 = 1.0f;
+            world._12 = 0.0f;
+            world._21 = 0.0f;
+            world._22 = 1.0f;
+            world._31 = 0.0f;
+            world._32 = 0.0f;
+        }
+        if (FAILED(hr = ID2D1Factory_CreateRectangleGeometry(context->factory, &rect, &rectangle)))
+        {
+            WARN("Failed to create the bounds of a layer, hr %#lx.\n", hr);
+            return;
+        }
+        mask = (ID2D1Geometry *)rectangle;
+    }
+
+    /* a brush whose pixels land on the target's, one for one */
+    if (!d2d_matrix_invert(&brush_desc.transform, &world))
+    {
+        if (rectangle)
+            ID2D1RectangleGeometry_Release(rectangle);
+        return;
+    }
+    brush_desc.opacity = parameters->opacity;
+    bitmap_desc.extendModeX = D2D1_EXTEND_MODE_CLAMP;
+    bitmap_desc.extendModeY = D2D1_EXTEND_MODE_CLAMP;
+    bitmap_desc.interpolationMode = D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR;
+    if (FAILED(hr = d2d_bitmap_brush_create(context->factory, (ID2D1Bitmap *)&layer->bitmap->ID2D1Bitmap1_iface,
+            &bitmap_desc, &brush_desc, &brush)))
+    {
+        WARN("Failed to create a brush for a layer, hr %#lx.\n", hr);
+        if (rectangle)
+            ID2D1RectangleGeometry_Release(rectangle);
+        return;
+    }
+
+    opacity_brush = unsafe_impl_from_ID2D1Brush(parameters->opacityBrush);
+    context->drawing_state.transform = world;
+    context->drawing_state.primitiveBlend = D2D1_PRIMITIVE_BLEND_SOURCE_OVER;
+    context->drawing_state.antialiasMode = rectangle ? D2D1_ANTIALIAS_MODE_ALIASED : parameters->maskAntialiasMode;
+    d2d_device_context_fill_geometry(context, unsafe_impl_from_ID2D1Geometry(mask), brush, opacity_brush);
+    context->drawing_state = state;
+
+    ID2D1Brush_Release(&brush->ID2D1Brush_iface);
+    if (rectangle)
+        ID2D1RectangleGeometry_Release(rectangle);
+}
 
-    FIXME("iface %p, layer_parameters %p, layer %p stub!\n", iface, layer_parameters, layer);
+static void d2d_device_context_push_layer(struct d2d_device_context *context,
