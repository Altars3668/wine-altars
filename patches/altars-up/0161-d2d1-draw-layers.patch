+/* The values follow from what the documentation says layers do. */
+static void test_layer_rendering(BOOL d3d11)
+{
+    D2D1_LAYER_PARAMETERS1 parameters1;
+    D2D1_LAYER_PARAMETERS parameters;
+    ID2D1RectangleGeometry *mask;
+    struct d2d1_test_context ctx;
+    ID2D1Image *target, *current;
+    D2D1_COLOR_F red, white;
+    ID2D1SolidColorBrush *brush;
+    ID2D1DeviceContext *context;
+    D2D1_RECT_F rect;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    context = ctx.context;
+    if (!context)
+    {
+        release_test_context(&ctx);
+        return;
+    }
+
+    set_color(&red, 1.0f, 0.0f, 0.0f, 1.0f);
+    set_color(&white, 1.0f, 1.0f, 1.0f, 1.0f);
+    hr = ID2D1DeviceContext_CreateSolidColorBrush(context, &red, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_GetTarget(context, &target);
+
+    memset(&parameters, 0, sizeof(parameters));
+    set_rect(&parameters.contentBounds, -FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX);
+    parameters.maskAntialiasMode = D2D1_ANTIALIAS_MODE_PER_PRIMITIVE;
+    set_matrix_identity(&parameters.maskTransform);
+    parameters.opacity = 0.5f;
+    set_rect(&rect, 10.0f, 10.0f, 50.0f, 50.0f);
+
+    /* What is drawn in a layer is put back at its opacity; the target stays what it was. */
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, &white);
+    ID2D1RenderTarget_PushLayer(ctx.rt, &parameters, NULL);
+    ID2D1DeviceContext_GetTarget(context, &current);
+    ok(current == target, "Got unexpected target %p, expected %p.\n", current, target);
+    ID2D1Image_Release(current);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    ID2D1DeviceContext_PopLayer(context);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_effect_pixel(&ctx, 20, 20, 0xffff8080, 1);
+    check_effect_pixel(&ctx, 60, 60, 0xffffffff, 0);
+
+    /* Layers in layers: a half of a half. */
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, &white);
+    ID2D1RenderTarget_PushLayer(ctx.rt, &parameters, NULL);
+    ID2D1RenderTarget_PushLayer(ctx.rt, &parameters, NULL);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    ID2D1DeviceContext_PopLayer(context);
+    ID2D1DeviceContext_PopLayer(context);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_effect_pixel(&ctx, 20, 20, 0xffffbfbf, 1);
+
+    /* What is outside the content bounds is not kept. */
+    parameters.opacity = 1.0f;
+    set_rect(&parameters.contentBounds, 0.0f, 0.0f, 30.0f, 30.0f);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, &white);
+    ID2D1RenderTarget_PushLayer(ctx.rt, &parameters, NULL);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    ID2D1DeviceContext_PopLayer(context);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_effect_pixel(&ctx, 20, 20, 0xffff0000, 0);
+    check_effect_pixel(&ctx, 40, 40, 0xffffffff, 0);
+
+    /* Only what the geometric mask covers is put back, where the mask transform takes it. */
+    set_rect(&parameters.contentBounds, -FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX);
+    set_rect(&rect, 20.0f, 20.0f, 40.0f, 40.0f);
+    hr = ID2D1Factory_CreateRectangleGeometry(ctx.factory, &rect, &mask);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    parameters.geometricMask = (ID2D1Geometry *)mask;
+    set_rect(&rect, 0.0f, 0.0f, 60.0f, 60.0f);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, &white);
+    ID2D1RenderTarget_PushLayer(ctx.rt, &parameters, NULL);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    ID2D1DeviceContext_PopLayer(context);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_effect_pixel(&ctx, 30, 30, 0xffff0000, 0);
+    check_effect_pixel(&ctx, 10, 10, 0xffffffff, 0);
+    check_effect_pixel(&ctx, 50, 30, 0xffffffff, 0);
+    translate_matrix(&parameters.maskTransform, 20.0f, 0.0f);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, &white);
+    ID2D1RenderTarget_PushLayer(ctx.rt, &parameters, NULL);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    ID2D1DeviceContext_PopLayer(context);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_effect_pixel(&ctx, 50, 30, 0xffff0000, 0);
+    check_effect_pixel(&ctx, 30, 30, 0xffffffff, 0);
+    ID2D1RectangleGeometry_Release(mask);
+
+    /* The layers of ID2D1DeviceContext are popped by PopLayer as well. */
+    memset(&parameters1, 0, sizeof(parameters1));
+    set_rect(&parameters1.contentBounds, -FLT_MAX, -FLT_MAX, FLT_MAX, FLT_MAX);
+    parameters1.maskAntialiasMode = D2D1_ANTIALIAS_MODE_PER_PRIMITIVE;
+    set_matrix_identity(&parameters1.maskTransform);
+    parameters1.opacity = 0.5f;
+    parameters1.layerOptions = D2D1_LAYER_OPTIONS1_NONE;
+    set_rect(&rect, 10.0f, 10.0f, 50.0f, 50.0f);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, &white);
+    ID2D1DeviceContext_PushLayer(context, &parameters1, NULL);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    ID2D1DeviceContext_PopLayer(context);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_effect_pixel(&ctx, 20, 20, 0xffff8080, 1);
+
+    /* A layer left pushed is an error at EndDraw, and the target is the target again. */
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, &white);
+    ID2D1DeviceContext_PushLayer(context, &parameters1, NULL);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == D2DERR_PUSH_POP_UNBALANCED, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_BeginDraw(context);
+    ID2D1DeviceContext_Clear(context, &red);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_effect_pixel(&ctx, 60, 60, 0xffff0000, 0);
+
+    ID2D1Image_Release(target);
+    ID2D1SolidColorBrush_Release(brush);
+    release_test_context(&ctx);
+}
