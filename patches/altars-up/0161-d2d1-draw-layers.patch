     if (context->target.type == D2D_TARGET_COMMAND_LIST)
     {
-        D2D1_LAYER_PARAMETERS1 parameters;
+        d2d_command_list_push_layer(context->target.command_list, context, parameters);
+        return;
+    }
+    if (context->target.type != D2D_TARGET_BITMAP)
+        return;
 
-        memcpy(&parameters, layer_parameters, sizeof(*layer_parameters));
-        parameters.layerOptions = D2D1_LAYER_OPTIONS1_NONE;
-        d2d_command_list_push_layer(context->target.command_list, context, &parameters);
+    if (!d2d_array_reserve((void **)&context->layers, &context->layers_size, context->layer_count + 1,
+            sizeof(*context->layers)))
+    {
+        ERR("Failed to grow the layer stack.\n");
+        d2d_device_context_set_error(context, E_OUTOFMEMORY);
+        return;
     }
+    state = &context->layers[context->layer_count++];
+    memset(state, 0, sizeof(*state));
+    state->parameters = *parameters;
+    state->target = context->target.bitmap;
+    state->transform = context->drawing_state.transform;
+    if (state->parameters.geometricMask)
+        ID2D1Geometry_AddRef(state->parameters.geometricMask);
+    if (state->parameters.opacityBrush)
+        ID2D1Brush_AddRef(state->parameters.opacityBrush);
+    if (parameters->layerOptions & D2D1_LAYER_OPTIONS1_IGNORE_ALPHA)
+        FIXME("The alpha of a layer is not ignored.\n");
+
+    /* the target's pixels, with room for what is not opaque */
+    desc.pixelFormat.format = context->desc.pixelFormat.format;
+    desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    desc.dpiX = context->desc.dpiX;
+    desc.dpiY = context->desc.dpiY;
+    desc.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET;
+    desc.colorContext = NULL;
+    if (FAILED(hr = d2d_bitmap_create(context, context->pixel_size, NULL, 0, &desc, &bitmap)))
+    {
+        FIXME("Failed to create a layer, hr %#lx; what is drawn in it goes to the target.\n", hr);
+        return;
+    }
+    state->bitmap = bitmap;
+    if (parameters->layerOptions & D2D1_LAYER_OPTIONS1_INITIALIZE_FROM_BACKGROUND)
+        d2d_device_context_copy_bitmap(context, bitmap, context->target.bitmap);
+    else
+        d2d_device_context_clear_bitmap(context, bitmap);
+    context->target.bitmap = bitmap;
+
+    /* what is drawn outside the content bounds need not be kept */
+    if (d2d_rect_is_bounded(&parameters->contentBounds))
+    {
+        d2d_device_context_transform_clip(context, &parameters->contentBounds, &clip);
+        state->clipped = d2d_clip_stack_push(&context->clip_stack, &clip);
+    }
+}
+
+static void STDMETHODCALLTYPE d2d_device_context_PushLayer(ID2D1DeviceContext6 *iface,
+        const D2D1_LAYER_PARAMETERS *layer_parameters, ID2D1Layer *layer)
+{
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    D2D1_LAYER_PARAMETERS1 parameters;
+
+    TRACE("iface %p, layer_parameters %p, layer %p.\n", iface, layer_parameters, layer);
+
+    memcpy(&parameters, layer_parameters, sizeof(*layer_parameters));
+    /* initializing for ClearType is initializing from what is there */
+    parameters.layerOptions = layer_parameters->layerOptions & D2D1_LAYER_OPTIONS_INITIALIZE_FOR_CLEARTYPE
+            ? D2D1_LAYER_OPTIONS1_INITIALIZE_FROM_BACKGROUND : D2D1_LAYER_OPTIONS1_NONE;
+    d2d_device_context_push_layer(context, &parameters, layer);
 }
 
 static void STDMETHODCALLTYPE d2d_device_context_PopLayer(ID2D1DeviceContext6 *iface)
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    struct d2d_layer_state *state;
 
-    FIXME("iface %p stub!\n", iface);
+    TRACE("iface %p.\n", iface);
 
     if (!d2d_device_context_pop(context, D2D_PUSH_LAYER))
         return;
 
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
+    {
         d2d_command_list_pop_layer(context->target.command_list);
+        return;
+    }
+    if (!context->layer_count)
+        return;
+
+    state = &context->layers[--context->layer_count];
+    if (state->clipped)
+        d2d_clip_stack_pop(&context->clip_stack);
+    context->target.bitmap = state->target;
+    if (state->bitmap && SUCCEEDED(context->error.code))
+        d2d_device_context_composite_layer(context, state);
+    d2d_layer_state_cleanup(state);
 }
 
