From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:37:55 -0400
Subject: [PATCH] wbemprox: Fill in the command line of other processes in
 Win32_Process.

With ProcessCommandLineInformation, which needs only limited query
access, as Windows' provider does.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wbemprox/builtin.c b/dlls/wbemprox/builtin.c
index 7aabd5428a7..688f0b5f0c8 100644
--- a/dlls/wbemprox/builtin.c
+++ b/dlls/wbemprox/builtin.c
@@ -3751,8 +3751,26 @@ static enum fill_status fill_printer( struct table *table, const struct expr *co
 
 static WCHAR *get_cmdline( DWORD process_id )
 {
+    UNICODE_STRING *str;
+    WCHAR *ret = NULL;
+    HANDLE process;
+    ULONG len = 0;
+
     if (process_id == GetCurrentProcessId()) return wcsdup( GetCommandLineW() );
-    return NULL; /* FIXME handle different process case */
+    if (!(process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, process_id ))) return NULL;
+    NtQueryInformationProcess( process, ProcessCommandLineInformation, NULL, 0, &len );
+    if (len && (str = malloc( len )))
+    {
+        if (!NtQueryInformationProcess( process, ProcessCommandLineInformation, str, len, NULL ) &&
+            (ret = malloc( str->Length + sizeof(WCHAR) )))
+        {
+            memcpy( ret, str->Buffer, str->Length );
+            ret[str->Length / sizeof(WCHAR)] = 0;
+        }
+        free( str );
+    }
+    CloseHandle( process );
+    return ret;
 }
 
 static WCHAR *get_executablepath( DWORD process_id )
