From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 09:40:31 -0400
Subject: [PATCH] ntdll, kernelbase: Answer the leap second information as
 Windows 11 does.

SystemLeapSecondInformation takes exactly its own size and says leap
seconds are enabled, with no flags, without a FIXME; kernelbase gets
GetSystemLeapSecondInformation, which Windows 11 exports and Wine had
not (tools/prefixupdateprobe leapsecond in wine-altars, from a Claudex
run).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/kernel32.spec b/dlls/kernel32/kernel32.spec
index eda0ca999f3..688ac3e925e 100644
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -855,6 +855,7 @@
 @ stdcall GetSystemDirectoryW(ptr long)
 @ stdcall -import GetSystemFirmwareTable(long long ptr long)
 @ stdcall -import GetSystemInfo(ptr)
+@ stdcall -import GetSystemLeapSecondInformation(ptr ptr)
 @ stdcall GetSystemPowerStatus(ptr)
 @ stdcall -import GetSystemPreferredUILanguages(long ptr ptr ptr)
 @ stdcall GetSystemRegistryQuota(ptr ptr)
diff --git a/dlls/kernel32/tests/time.c b/dlls/kernel32/tests/time.c
index 08409c9bbaa..a8f53dd5432 100644
--- a/dlls/kernel32/tests/time.c
+++ b/dlls/kernel32/tests/time.c
@@ -1198,6 +1198,37 @@ static void test_processor_idle_cycle_time(void)
     ok( size == cpu_count * sizeof(ULONG64), "got %lu.\n", size );
 }
 
+static void test_GetSystemLeapSecondInformation(void)
+{
+    BOOL (WINAPI *get_leap)(BOOL *, DWORD *);
+    NTSTATUS (WINAPI *query_system)(SYSTEM_INFORMATION_CLASS, void *, ULONG, ULONG *);
+    SYSTEM_LEAP_SECOND_INFORMATION leap;
+    BOOL ret, enabled = 0xdeadbeef;
+    DWORD flags = 0xdeadbeef;
+    NTSTATUS status;
+    HMODULE module;
+
+    module = GetModuleHandleA("kernel32.dll");
+    get_leap = (void *)GetProcAddress(module, "GetSystemLeapSecondInformation");
+    if (!get_leap && (module = GetModuleHandleA("kernelbase.dll")))
+        get_leap = (void *)GetProcAddress(module, "GetSystemLeapSecondInformation");
+    if (!get_leap)
+    {
+        win_skip("GetSystemLeapSecondInformation is not available\n");
+        return;
+    }
+
+    query_system = (void *)GetProcAddress(GetModuleHandleA("ntdll.dll"), "NtQuerySystemInformation");
+    status = query_system(SystemLeapSecondInformation, &leap, sizeof(leap), NULL);
+    ok(!status, "got status %#lx\n", status);
+    SetLastError(0xdeadbeef);
+    ret = get_leap(&enabled, &flags);
+    ok(ret, "got error %lu\n", GetLastError());
+    ok(GetLastError() == 0xdeadbeef, "got error %lu\n", GetLastError());
+    ok(enabled == leap.Enabled, "got enabled %d, expected %u\n", enabled, leap.Enabled);
+    ok(flags == leap.Flags, "got flags %#lx, expected %#lx\n", flags, leap.Flags);
+}
+
 START_TEST(time)
 {
     HMODULE hKernel = GetModuleHandleA("kernel32");
@@ -1226,6 +1257,7 @@ START_TEST(time)
     test_GetDynamicTimeZoneInformation();
     test_GetSystemTimeAsFileTime();
     test_GetSystemTimePreciseAsFileTime();
+    test_GetSystemLeapSecondInformation();
     test_GetTimeZoneInformationForYear();
     test_GetTickCount();
     test_QueryUnbiasedInterruptTime();
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index f066b85a4e9..2e4423753e2 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -4499,6 +4499,26 @@ void WINAPI DECLSPEC_HOTPATCH GetLocalTime( SYSTEMTIME *systime )
 }
 
 
+/*********************************************************************
+ *	GetSystemLeapSecondInformation   (kernelbase.@)
+ */
+BOOL WINAPI DECLSPEC_HOTPATCH GetSystemLeapSecondInformation( BOOL *enabled, DWORD *flags )
+{
+    SYSTEM_LEAP_SECOND_INFORMATION leap;
+
+    if (!enabled || !flags)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!set_ntstatus( NtQuerySystemInformation( SystemLeapSecondInformation, &leap, sizeof(leap), NULL )))
+        return FALSE;
+    *enabled = leap.Enabled;
+    *flags = leap.Flags;
+    return TRUE;
+}
+
+
 /*********************************************************************
  *	GetSystemTime   (kernelbase.@)
  */
diff --git a/dlls/kernelbase/kernelbase.spec b/dlls/kernelbase/kernelbase.spec
index 2620df69b65..0276c8ab20d 100644
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -730,6 +730,7 @@
 @ stdcall GetSystemFileCacheSize(ptr ptr ptr)
 @ stdcall GetSystemFirmwareTable(long long ptr long)
 @ stdcall GetSystemInfo(ptr)
+@ stdcall GetSystemLeapSecondInformation(ptr ptr)
 # @ stub GetSystemMetadataPath
 # @ stub GetSystemMetadataPathForPackage
 # @ stub GetSystemMetadataPathForPackageFamily
diff --git a/dlls/ntdll/tests/info.c b/dlls/ntdll/tests/info.c
index 3a0c9bf7a61..18968df580f 100644
--- a/dlls/ntdll/tests/info.c
+++ b/dlls/ntdll/tests/info.c
@@ -1125,6 +1125,10 @@ static void test_query_interrupt(void)
 
 static void test_time_adjustment(void)
 {
+    static const ULONG sizes[] = {0, 1, 3, 4, 7, 8, 9, 15, 16, 32, 64};
+    union { SYSTEM_LEAP_SECOND_INFORMATION leap; BYTE bytes[64]; } buffer;
+    BYTE expected[sizeof(buffer)];
+    unsigned int i;
     SYSTEM_LEAP_SECOND_INFORMATION leap;
     SYSTEM_TIME_ADJUSTMENT_QUERY query;
     SYSTEM_TIME_ADJUSTMENT adjust;
@@ -1170,6 +1174,26 @@ static void test_time_adjustment(void)
         ok( len == sizeof(leap), "wrong len %lu\n", len );
         ok( leap.Enabled == 1, "got %u\n", leap.Enabled );
         ok( !leap.Flags, "got %lx\n", leap.Flags );
+
+        for (i = 0; i < ARRAY_SIZE(sizes); ++i)
+        {
+            memset( &buffer, 0xa5, sizeof(buffer) );
+            memset( expected, 0xa5, sizeof(expected) );
+            len = 0xdeadbeef;
+            SetLastError( 0xdeadbeef );
+            status = pNtQuerySystemInformation( SystemLeapSecondInformation, &buffer, sizes[i], &len );
+            ok( status == (sizes[i] == sizeof(leap) ? STATUS_SUCCESS : STATUS_INFO_LENGTH_MISMATCH),
+                "size %lu: got %08lx\n", sizes[i], status );
+            ok( len == sizeof(leap), "size %lu: wrong len %lu\n", sizes[i], len );
+            ok( GetLastError() == 0xdeadbeef, "size %lu: got error %lu\n", sizes[i], GetLastError() );
+            if (sizes[i] == sizeof(leap))
+            {
+                expected[0] = leap.Enabled;
+                memcpy( expected + FIELD_OFFSET(SYSTEM_LEAP_SECOND_INFORMATION, Flags), &leap.Flags,
+                        sizeof(leap.Flags) );
+            }
+            ok( !memcmp( buffer.bytes, expected, sizeof(expected) ), "size %lu: unexpected writes\n", sizes[i] );
+        }
     }
 }
 
diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
index 41809023dac..373d66131a6 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4123,9 +4123,8 @@ NTSTATUS WINAPI NtQuerySystemInformation( SYSTEM_INFORMATION_CLASS class,
         SYSTEM_LEAP_SECOND_INFORMATION *leap = info;
 
         len = sizeof(*leap);
-        if (size >= len)
+        if (size == len)
         {
-            FIXME( "SystemLeapSecondInformation - stub\n" );
             leap->Enabled = TRUE;
             leap->Flags   = 0;
         }
