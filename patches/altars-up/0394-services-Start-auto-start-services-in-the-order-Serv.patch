From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 08:25:51 -0400
Subject: [PATCH] services: Start auto-start services in the order
 ServiceGroupOrder gives their groups.

Windows starts the services of one start type group by group, in the order of the groups in
ServiceGroupOrder's List, services in a group the list does not name or in no group last, and by
tag within a group.  Only the start type and the tag were compared here, so the RPC server could
come after a third-party service that takes its time to start; a program asking for the RPC server
meanwhile is then refused with ERROR_SERVICE_DATABASE_LOCKED, as all auto-start services are started
under one lock.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/programs/services/services.c b/programs/services/services.c
index 8d7009ed32f..d6e7c737760 100644
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -291,13 +291,73 @@ static void scmdatabase_remove_service(struct scmdatabase *db, struct service_en
     service->entry.next = service->entry.prev = NULL;
 }
 
-static int __cdecl compare_service(const void *a, const void *b)
+struct autostart_order
 {
-    struct service_entry *service_a = *(struct service_entry **)a;
-    struct service_entry *service_b = *(struct service_entry **)b;
-    if (service_a->config.dwStartType != service_b->config.dwStartType)
-        return service_a->config.dwStartType - service_b->config.dwStartType;
-    return service_a->config.dwTagId - service_b->config.dwTagId;
+    struct service_entry *service;
+    unsigned int group;
+};
+
+/* where a load order group comes in ServiceGroupOrder's list; a service in no group, or in one the list
+ * does not name, comes after all the groups it names */
+static unsigned int get_group_order(const WCHAR *list, const WCHAR *group)
+{
+    unsigned int i;
+
+    if (!list || !group || !*group) return ~0u;
+    for (i = 0; *list; list += wcslen(list) + 1, i++)
+        if (!wcsicmp(list, group)) return i;
+    return ~0u;
+}
+
+static int __cdecl compare_autostart(const void *a, const void *b)
+{
+    const struct autostart_order *order_a = a, *order_b = b;
+    const QUERY_SERVICE_CONFIGW *config_a = &order_a->service->config, *config_b = &order_b->service->config;
+
+    if (config_a->dwStartType != config_b->dwStartType)
+        return config_a->dwStartType - config_b->dwStartType;
+    if (order_a->group != order_b->group)
+        return order_a->group < order_b->group ? -1 : 1;
+    return config_a->dwTagId - config_b->dwTagId;
+}
+
+/* Windows starts services by start type, then by load order group in the order ServiceGroupOrder lists the
+ * groups, services in no group last, and by tag within a group: the RPC server, in "COM Infrastructure",
+ * runs before a third-party service that may take its time to start, and that a program using COM would
+ * otherwise wait for. */
+static void sort_autostart_services(struct service_entry **services, unsigned int count)
+{
+    struct autostart_order *order;
+    WCHAR *list = NULL;
+    DWORD size, type;
+    unsigned int i;
+    HKEY key;
+
+    if (!(order = malloc(count * sizeof(*order)))) return;
+
+    if (!RegOpenKeyW(HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control\\ServiceGroupOrder", &key))
+    {
+        size = 0;
+        if (!RegQueryValueExW(key, L"List", NULL, &type, NULL, &size) && type == REG_MULTI_SZ &&
+            (list = calloc(1, size + 2 * sizeof(WCHAR))))
+            RegQueryValueExW(key, L"List", NULL, NULL, (BYTE *)list, &size);
+        RegCloseKey(key);
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        order[i].service = services[i];
+        order[i].group = get_group_order(list, services[i]->config.lpLoadOrderGroup);
+    }
+    qsort(order, count, sizeof(*order), compare_autostart);
+    for (i = 0; i < count; i++)
+    {
+        TRACE("%u: %s, group %s\n", i, debugstr_w(order[i].service->name),
+              debugstr_w(order[i].service->config.lpLoadOrderGroup));
+        services[i] = order[i].service;
+    }
+    free(order);
+    free(list);
 }
 
 static PTP_CLEANUP_GROUP delayed_autostart_cleanup;
@@ -454,7 +514,7 @@ static void scmdatabase_autostart_services(struct scmdatabase *db)
     size = i;
 
     scmdatabase_unlock(db);
-    qsort(services_list, size, sizeof(services_list[0]), compare_service);
+    sort_autostart_services(services_list, size);
     scmdatabase_lock_startup(db, INFINITE);
 
     if (lsa)
