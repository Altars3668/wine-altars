From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 13:34:53 -0400
Subject: [PATCH] winegcc: name a module after its output file when its spec's
 name has a dot of its own.

winebuild takes a module's name from its spec file and gives it an
extension only when the name has no dot, so windows.globalization.spec
named its module "windows.globalization", the name in its export
directory.  The loader asks for the builtin behind a file in system32
by that name, found no such file in the install or build directory,
and mapped the prefix's copy, as old as the prefix's last update: a
fix to any of the 33 modules with a dot in their names (32 windows.*
and twinapi.appcore) did not take effect until the prefix was updated.
On Windows, all of them name themselves with the extension
(Windows.Globalization.dll, twinapi.appcore.dll).

When the output is the spec's name plus an extension, winebuild is now
told the output's name, unless it was given one explicitly (kernel32's
KERNEL32.dll).  Every other module keeps the name it had.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 184e8e1473bccc1ff9edffc024b2fa1750181570)

diff --git a/tools/winegcc/winegcc.c b/tools/winegcc/winegcc.c
index e92397eb5fe..6d8d7818f2c 100644
--- a/tools/winegcc/winegcc.c
+++ b/tools/winegcc/winegcc.c
@@ -1070,6 +1070,35 @@ static void add_library( struct strarray lib_dirs, struct strarray *files, const
     free(fullname);
 }
 
+/* check whether the command line gave winebuild a file name of its own (-Wb,-F,KERNEL32.dll) */
+static bool winebuild_file_name_given(void)
+{
+    STRARRAY_FOR_EACH( arg, &winebuild_args )
+        if (!strncmp( arg, "-F", 2 ) || !strncmp( arg, "--filename", 10 )) return true;
+    return false;
+}
+
+/* add the spec file to the winebuild arguments */
+static void add_spec_file_args( struct strarray *spec_args, const char *spec_file, const char *output_name )
+{
+    const char *spec_name = get_basename( spec_file ), *ext = strrchr( spec_name, '.' );
+    size_t len = strlen( spec_name );
+
+    if (ext && (!strcmp( ext, ".spec" ) || !strcmp( ext, ".def" ))) len = ext - spec_name;
+
+    /* winebuild takes the module name from the spec file and gives it an extension only
+     * when it has no dot, so windows.globalization.spec would name the module
+     * "windows.globalization"; when the output is the spec's name plus an extension,
+     * the output is the module's file name, unless a name was given explicitly */
+    if (!winebuild_file_name_given() && !strncmp( output_name, spec_name, len ) && output_name[len] == '.')
+    {
+        strarray_add( spec_args, "-F" );
+        strarray_add( spec_args, output_name );
+    }
+    strarray_add( spec_args, "-E" );
+    strarray_add( spec_args, spec_file );
+}
+
 /* run winebuild to generate the .spec.o file */
 static void build_spec_obj( const char *spec_file, const char *output_file,
                             enum target_cpu cpu, struct strarray files,
@@ -1109,11 +1138,7 @@ static void build_spec_obj( const char *spec_file, const char *output_file,
         strarray_add(&spec_args, "-o");
         strarray_add(&spec_args, spec_o_name);
     }
-    if (spec_file)
-    {
-        strarray_add(&spec_args, "-E");
-        strarray_add(&spec_args, spec_file);
-    }
+    if (spec_file) add_spec_file_args( &spec_args, spec_file, output_name );
     else
     {
         strarray_add(&spec_args, "-F");
@@ -1161,11 +1186,7 @@ static void build_data_lib( const char *spec_file, const char *output_file, stru
     strarray_add(&spec_args, is_shared ? "--dll" : "--exe");
     strarray_add(&spec_args, "-o");
     strarray_add(&spec_args, output_file);
-    if (spec_file)
-    {
-        strarray_add(&spec_args, "-E");
-        strarray_add(&spec_args, spec_file);
-    }
+    if (spec_file) add_spec_file_args( &spec_args, spec_file, get_basename( output_file ));
 
     /* add resource files */
     STRARRAY_FOR_EACH( file, &files ) if (file[1] == 'r') strarray_add(&spec_args, file);
