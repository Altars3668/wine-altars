From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 16:12:13 -0400
Subject: [PATCH] netprofm: Name the cost interfaces' proxy class as Windows
 does.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/netprofm/netprofm.rgs b/dlls/netprofm/netprofm.rgs
index 71f62c769a7..fe6a4a65082 100644
--- a/dlls/netprofm/netprofm.rgs
+++ b/dlls/netprofm/netprofm.rgs
@@ -25,7 +25,7 @@ HKCR
     }
     NoRemove CLSID
     {
-        '{DCB00009-570F-4A9B-8D69-199FDBA5723B}' = s 'PSFactoryBuffer'
+        '{DCB00009-570F-4A9B-8D69-199FDBA5723B}' = s 'Network List Manager Public Proxy'
         {
             InprocServer32 = s '%MODULE%' { val ThreadingModel = s 'Both' }
         }
