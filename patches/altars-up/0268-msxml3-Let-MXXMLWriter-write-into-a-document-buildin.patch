-        HRESULT hr;
 
         hr = ISAXAttributes_getLength(attr, &length);
         if (FAILED(hr)) return hr;
@@ -1323,6 +1463,32 @@ static HRESULT WINAPI SAXContentHandler_startElement(
             if (FAILED(hr)) return hr;
 
             mxwriter_write_attribute(This, qname, qname_len, value, value_len, escape);
+
+            if (element)
+            {
+                struct domnode *attribute;
+                BSTR data;
+
+                if (FAILED(hr = domnode_create(NODE_ATTRIBUTE, qname, qname_len, NULL, 0,
+                        This->dest_node, &attribute)))
+                    return hr;
+                if (!(data = SysAllocStringLen(value, value_len)))
+                    hr = E_OUTOFMEMORY;
+                else
+                {
+                    hr = node_put_data(attribute, data);
+                    SysFreeString(data);
+                }
+                if (FAILED(hr))
+                {
+                    domnode_destroy_tree(attribute);
+                    return hr;
+                }
+                attribute->flags |= DOMNODE_PARSED_VALUE;
+                if (domnode_is_namespace_declaration(attribute))
