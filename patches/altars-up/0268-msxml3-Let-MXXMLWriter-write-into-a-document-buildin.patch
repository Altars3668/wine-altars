+++ b/dlls/msxml3/domdoc.c
@@ -1120,6 +1120,12 @@ static HRESULT WINAPI domdoc_createNode(IXMLDOMDocument3 *iface, VARIANT type, B
     if (!node)
         return E_INVALIDARG;
 
+    if (doc->node->properties->writer_locks)
+    {
+        *node = NULL;
+        return E_FAIL;
+    }
+
     if (FAILED(hr = get_node_type(&type, &node_type)))
         return hr;
 
