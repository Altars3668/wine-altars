 } mxwriter;
@@ -743,6 +749,79 @@ static inline mxwriter *impl_from_IVBSAXErrorHandler(IVBSAXErrorHandler *iface)
     return CONTAINING_RECORD(iface, mxwriter, IVBSAXErrorHandler_iface);
 }
 
+static HRESULT mxwriter_dom_add_node(mxwriter *writer, DOMNodeType type, const WCHAR *name, int name_len,
+        const WCHAR *uri, int uri_len, const WCHAR *data, int data_len, struct domnode **result)
+{
+    struct domnode *node;
+    HRESULT hr;
+    BSTR value;
+
+    if (FAILED(hr = domnode_create(type, name, name_len, uri, uri_len, writer->dest_node, &node)))
+        return hr;
+
+    if (data)
+    {
+        if (!(value = SysAllocStringLen(data, data_len)))
+            hr = E_OUTOFMEMORY;
+        else
+        {
+            hr = node_put_data(node, value);
+            SysFreeString(value);
+        }
+    }
+
+    if (SUCCEEDED(hr))
+    {
+        domnode_append_child(writer->doc_current, node);
+        if (result) *result = node;
+    }
+    else
+        domnode_destroy_tree(node);
+
+    return hr;
+}
+
+static HRESULT mxwriter_dom_add_text(mxwriter *writer, const WCHAR *chars, int count)
+{
+    UINT length = SysStringLen(writer->doc_text);
+    BSTR text;
+
+    if (!count) return S_OK;
+    if (!(text = SysAllocStringLen(NULL, length + count))) return E_OUTOFMEMORY;
+    if (length) memcpy(text, writer->doc_text, length * sizeof(WCHAR));
+    memcpy(text + length, chars, count * sizeof(WCHAR));
+    SysFreeString(writer->doc_text);
+    writer->doc_text = text;
+    return S_OK;
+}
+
+static HRESULT mxwriter_dom_flush_text(mxwriter *writer)
+{
+    HRESULT hr = S_OK;
+
+    if (writer->doc_text && writer->doc_current != writer->dest_node)
+        hr = mxwriter_dom_add_node(writer, writer->doc_text_type, NULL, 0, NULL, 0,
+                writer->doc_text, SysStringLen(writer->doc_text), NULL);
+    SysFreeString(writer->doc_text);
+    writer->doc_text = NULL;
+    return hr;
+}
+
+static void mxwriter_release_document(mxwriter *writer)
+{
+    if (writer->doc_active)
+    {
+        --writer->dest_node->properties->writer_locks;
+        writer->doc_active = false;
+    }
+    SysFreeString(writer->doc_text);
+    writer->doc_text = NULL;
+    writer->doc_current = NULL;
+    writer->dest_node = NULL;
+    if (writer->dest_doc) IXMLDOMDocument_Release(writer->dest_doc);
+    writer->dest_doc = NULL;
+}
+
 static HRESULT WINAPI mxwriter_QueryInterface(IMXWriter *iface, REFIID riid, void **obj)
 {
     mxwriter *This = impl_from_IMXWriter( iface );
@@ -836,6 +915,7 @@ static ULONG WINAPI mxwriter_Release(IMXWriter *iface)
         free_output_buffer(&This->buffer);
 
         if (This->dest) IStream_Release(This->dest);
+        mxwriter_release_document(This);
         SysFreeString(This->version);
         SysFreeString(This->encoding);
 
@@ -900,14 +980,36 @@ static HRESULT WINAPI mxwriter_put_output(IMXWriter *iface, VARIANT dest)
     {
         if (This->dest) IStream_Release(This->dest);
         This->dest = NULL;
+        mxwriter_release_document(This);
         close_output_buffer(This);
         break;
     }
     case VT_UNKNOWN:
+    case VT_DISPATCH:
     {
+        IUnknown *unknown = V_UNKNOWN(&dest);
+        struct domnode *node;
+        IXMLDOMDocument *doc;
         IStream *stream;
 
-        hr = IUnknown_QueryInterface(V_UNKNOWN(&dest), &IID_IStream, (void**)&stream);
+        if (unknown && IUnknown_QueryInterface(unknown, &IID_IXMLDOMDocument, (void **)&doc) == S_OK)
+        {
