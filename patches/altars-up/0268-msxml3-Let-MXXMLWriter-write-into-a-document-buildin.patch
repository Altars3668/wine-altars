+static void test_mxwriter_domdoc_events(void)
+{
+    ISAXContentHandler *content;
+    ISAXLexicalHandler *lexical;
+    IXMLDOMDocument *domdoc;
+    IXMLDOMElement *root;
+    ISAXAttributes *attrs;
+    IMXAttributes *mxattrs;
+    IMXWriter *writer;
+    VARIANT dest, value;
+    HRESULT hr;
+    BSTR str;
+
+    hr = CoCreateInstance(&CLSID_MXXMLWriter60, NULL, CLSCTX_INPROC_SERVER, &IID_IMXWriter, (void **)&writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMXWriter_QueryInterface(writer, &IID_ISAXContentHandler, (void **)&content);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMXWriter_QueryInterface(writer, &IID_ISAXLexicalHandler, (void **)&lexical);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = CoCreateInstance(&CLSID_DOMDocument60, NULL, CLSCTX_INPROC_SERVER, &IID_IXMLDOMDocument, (void **)&domdoc);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = CoCreateInstance(&CLSID_SAXAttributes60, NULL, CLSCTX_INPROC_SERVER, &IID_IMXAttributes, (void **)&mxattrs);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMXAttributes_addAttribute(mxattrs, _bstr_(""), _bstr_("a"), _bstr_("a"), _bstr_("CDATA"), _bstr_("1"));
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMXAttributes_QueryInterface(mxattrs, &IID_ISAXAttributes, (void **)&attrs);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    V_VT(&dest) = VT_DISPATCH;
+    V_DISPATCH(&dest) = (IDispatch *)domdoc;
+    hr = IMXWriter_put_output(writer, dest);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXContentHandler_startDocument(content);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXContentHandler_startElement(content, L"", 0, L"", 0, L"r", 1, attrs);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMDocument_get_documentElement(domdoc, &root);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (hr == S_OK)
+    {
+        VariantInit(&value);
+        hr = IXMLDOMElement_getAttribute(root, _bstr_("a"), &value);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(V_VT(&value) == VT_BSTR && !lstrcmpW(V_BSTR(&value), L"1"), "Unexpected attribute %s.\n",
+                wine_dbgstr_variant(&value));
+        VariantClear(&value);
+        IXMLDOMElement_Release(root);
+    }
+
+    hr = ISAXContentHandler_characters(content, L"<&", 2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXLexicalHandler_startCDATA(lexical);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXContentHandler_characters(content, L"<&", 2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXLexicalHandler_endCDATA(lexical);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXLexicalHandler_comment(lexical, L"note", 4);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXContentHandler_processingInstruction(content, L"p", 1, L"d", 1);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXContentHandler_ignorableWhitespace(content, L" ", 1);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXContentHandler_characters(content, L"tail", 4);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXContentHandler_endElement(content, L"", 0, L"", 0, L"r", 1);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXContentHandler_endDocument(content);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXMLDOMDocument_get_xml(domdoc, &str);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!lstrcmpW(str, L"<r a=\"1\">&lt;&amp;<![CDATA[<&]]><!--note--><?p d?> tail</r>\r\n"),
+            "Unexpected content %s.\n", wine_dbgstr_w(str));
+    SysFreeString(str);
+
+    ISAXAttributes_Release(attrs);
+    IMXAttributes_Release(mxattrs);
+    IXMLDOMDocument_Release(domdoc);
+    ISAXLexicalHandler_Release(lexical);
+    ISAXContentHandler_Release(content);
+    IMXWriter_Release(writer);
+    free_bstrs();
+}
