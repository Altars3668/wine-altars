+        This->doc_text = NULL;
+        This->doc_text_type = NODE_TEXT;
+        if (!This->doc_active)
+        {
+            ++This->dest_node->properties->writer_locks;
+            This->doc_active = true;
+        }
+        return S_OK;
+    }
     if (This->props[MXWriter_OmitXmlDecl] == VARIANT_TRUE) return S_OK;
 
     write_prolog_buffer(This);
@@ -1224,9 +1341,22 @@ static HRESULT WINAPI SAXContentHandler_startDocument(ISAXContentHandler *iface)
 static HRESULT WINAPI SAXContentHandler_endDocument(ISAXContentHandler *iface)
 {
     mxwriter *This = impl_from_ISAXContentHandler( iface );
+    HRESULT hr;
+
     TRACE("(%p)\n", This);
     This->prop_changed = FALSE;
-    return flush_output_buffer(This);
+    hr = flush_output_buffer(This);
+    if (This->dest_doc)
+    {
+        if (SUCCEEDED(hr)) hr = mxwriter_dom_flush_text(This);
+        if (This->doc_active)
+        {
+            --This->dest_node->properties->writer_locks;
+            This->doc_active = false;
+        }
+        This->doc_current = This->dest_node;
+    }
+    return hr;
 }
 
