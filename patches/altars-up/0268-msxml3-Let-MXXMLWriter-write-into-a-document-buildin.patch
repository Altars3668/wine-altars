+            }
+            close_output_buffer(This);
+            if (This->dest) IStream_Release(This->dest);
+            This->dest = NULL;
+            mxwriter_release_document(This);
+            This->dest_doc = doc;
+            This->dest_node = node;
+            This->doc_current = node;
+            break;
+        }
+
+        hr = unknown ? IUnknown_QueryInterface(unknown, &IID_IStream, (void **)&stream) : E_INVALIDARG;
         if (hr == S_OK)
         {
             /* Recreate the output buffer to make sure it's using the correct encoding. */
@@ -915,10 +1017,11 @@ static HRESULT WINAPI mxwriter_put_output(IMXWriter *iface, VARIANT dest)
 
             if (This->dest) IStream_Release(This->dest);
             This->dest = stream;
+            mxwriter_release_document(This);
             break;
         }
 
-        FIXME("unhandled interface type for VT_UNKNOWN destination\n");
+        FIXME("unhandled interface type for output destination\n");
         return E_NOTIMPL;
     }
     default:
@@ -1204,6 +1307,20 @@ static HRESULT WINAPI SAXContentHandler_startDocument(ISAXContentHandler *iface)
         This->prop_changed = FALSE;
     }
 
+    if (This->dest_doc)
