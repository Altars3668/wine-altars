     test_PrintWindow();
     test_RegisterTouchHitTestingWindow();
     test_ChangeWindowMessageFilterEx();
+    test_GetGuiResources();
     test_window_without_child_style();
     test_smresult();
     test_GetMessagePos();
diff --git a/dlls/win32u/gdiobj.c b/dlls/win32u/gdiobj.c
index e861dee167d..b228019168d 100644
--- a/dlls/win32u/gdiobj.c
+++ b/dlls/win32u/gdiobj.c
@@ -73,6 +73,21 @@ static inline struct gdi_obj_header *entry_obj( GDI_HANDLE_ENTRY *entry )
     return (struct gdi_obj_header *)(ULONG_PTR)entry->Object;
 }
 
+static pthread_mutex_t gdi_lock;
+
+/* the GDI objects this process has, stock objects not counted, as GetGuiResources counts them */
+DWORD get_gdi_object_count(void)
+{
+    GDI_HANDLE_ENTRY *entry;
+    DWORD count = 0;
+
+    pthread_mutex_lock( &gdi_lock );
+    for (entry = gdi_shared->Handles + FIRST_GDI_HANDLE; entry < next_unused; entry++)
+        if (entry->Type && !entry->StockFlag) count++;
+    pthread_mutex_unlock( &gdi_lock );
+    return count;
+}
