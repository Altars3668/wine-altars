From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 13:16:30 -0400
Subject: [PATCH] win32u: count the GDI and USER objects of a process for
 GetGuiResources.

GetGuiResources was a stub that answered 0 with
ERROR_CALL_NOT_IMPLEMENTED; Word asks it for its GDI objects.  It is
NtUserGetGuiResources now, as on Windows, which counts this process's
GDI objects in its handle table, stock objects not included, and a
process's USER objects in the session's table, or the whole session's
for GR_GLOBAL; the peaks are the most it has counted.  As
tools/procpolicyprobe measured Windows: a NULL process is
ERROR_INVALID_PARAMETER and a flag it does not know answers 0 and
leaves the last error alone.  The GDI objects of another process are
not to be seen from here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 9ddb24754503f0fc17363685862fd1382d5a7a02)

diff --git a/dlls/user32/resource.c b/dlls/user32/resource.c
index b050e1eba8c..244c11cc255 100644
--- a/dlls/user32/resource.c
+++ b/dlls/user32/resource.c
@@ -228,13 +228,5 @@ INT WINAPI DECLSPEC_HOTPATCH LoadStringA( HINSTANCE instance, UINT resource_id,
  */
 DWORD WINAPI GetGuiResources( HANDLE hProcess, DWORD uiFlags )
 {
-    static BOOL warn = TRUE;
-
-    if (warn) {
-        FIXME("(%p,%lx): stub\n",hProcess,uiFlags);
-       warn = FALSE;
-    }
-
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-    return 0;
+    return NtUserGetGuiResources( hProcess, uiFlags );
 }
diff --git a/dlls/user32/tests/win.c b/dlls/user32/tests/win.c
index 53a4beece1c..b3cfdd78ff6 100644
--- a/dlls/user32/tests/win.c
+++ b/dlls/user32/tests/win.c
@@ -14666,6 +14666,37 @@ static LRESULT WINAPI print_window_proc(HWND hwnd, UINT msg, WPARAM wparam, LPAR
     return DefWindowProcA(hwnd, msg, wparam, lparam);
 }
 
+static void test_GetGuiResources(void)
+{
+    DWORD gdi, user, gdi2, user2, peak;
+    HBRUSH brushes[10];
+    unsigned int i;
+    HWND hwnd;
+
+    gdi = GetGuiResources(GetCurrentProcess(), GR_GDIOBJECTS);
+    user = GetGuiResources(GetCurrentProcess(), GR_USEROBJECTS);
+    for (i = 0; i < ARRAY_SIZE(brushes); i++) brushes[i] = CreateSolidBrush(RGB(i, i, i));
+    hwnd = CreateWindowA("static", NULL, WS_POPUP, 0, 0, 10, 10, NULL, NULL, NULL, NULL);
+    gdi2 = GetGuiResources(GetCurrentProcess(), GR_GDIOBJECTS);
+    user2 = GetGuiResources(GetCurrentProcess(), GR_USEROBJECTS);
+    ok(gdi2 >= gdi + ARRAY_SIZE(brushes), "got %lu, then %lu\n", gdi, gdi2);
+    ok(user2 > user, "got %lu, then %lu\n", user, user2);
+    peak = GetGuiResources(GetCurrentProcess(), GR_GDIOBJECTS_PEAK);
+    ok(peak >= gdi2, "got peak %lu, count %lu\n", peak, gdi2);
+    peak = GetGuiResources(GetCurrentProcess(), GR_USEROBJECTS_PEAK);
+    ok(peak >= user2, "got peak %lu, count %lu\n", peak, user2);
+    for (i = 0; i < ARRAY_SIZE(brushes); i++) DeleteObject(brushes[i]);
+    DestroyWindow(hwnd);
+    ok(GetGuiResources(GetCurrentProcess(), GR_USEROBJECTS) < user2, "USER objects did not go\n");
+
+    SetLastError(0xdeadbeef);
+    ok(!GetGuiResources(GetCurrentProcess(), 3), "got a count\n");
+    ok(GetLastError() == 0xdeadbeef, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ok(!GetGuiResources(NULL, GR_GDIOBJECTS), "got a count\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError());
+}
+
 static void test_RegisterTouchHitTestingWindow(void)
 {
     BOOL (WINAPI *pRegisterTouchHitTestingWindow)(HWND, ULONG);
