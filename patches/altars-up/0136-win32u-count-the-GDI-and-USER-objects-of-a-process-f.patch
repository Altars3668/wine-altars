+/***********************************************************************
+ *           NtUserGetGuiResources (win32u.@)
+ *
+ * The GDI and USER objects a process has, and the most it has been seen to have.  The USER objects of every
+ * process are in the session's table; the GDI objects of another process are not to be seen from here.
+ */
+DWORD WINAPI NtUserGetGuiResources( HANDLE process, DWORD flags )
+{
+    static DWORD gdi_peak, user_peak;
+    PROCESS_BASIC_INFORMATION pbi;
+    DWORD count = 0, pid;
+    unsigned int i;
+
+    TRACE( "process %p, flags %#x\n", process, (int)flags );
+
+    /* GR_GLOBAL counts the whole session's */
+    if (process == GR_GLOBAL) pid = 0;
+    else if (!process || NtQueryInformationProcess( process, ProcessBasicInformation, &pbi, sizeof(pbi), NULL ))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return 0;
+    }
+    else pid = pbi.UniqueProcessId;
+
+    switch (flags)
+    {
+    case GR_GDIOBJECTS:
+    case GR_GDIOBJECTS_PEAK:
+        if (pid != GetCurrentProcessId())
+        {
+            FIXME( "the GDI objects of process %04x are not known\n", (int)pid );
+            return 0;
+        }
+        count = get_gdi_object_count();
+        if (count > gdi_peak) gdi_peak = count;
+        return flags == GR_GDIOBJECTS ? count : gdi_peak;
+
+    case GR_USEROBJECTS:
+    case GR_USEROBJECTS_PEAK:
+        for (i = 0; i < MAX_USER_HANDLES; i++)
+            if (shared_session->user_entries[i].type && (!pid || shared_session->user_entries[i].pid == pid)) count++;
+        if (pid != GetCurrentProcessId()) return flags == GR_USEROBJECTS ? count : 0;
+        if (count > user_peak) user_peak = count;
+        return flags == GR_USEROBJECTS ? count : user_peak;
+
+    default:
+        return 0;
+    }
+}
+
