From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 00:16:16 -0400
Subject: [PATCH] d2d1: Copy into bitmaps and clear them with a context state
 of its own.

Copying into a bitmap from memory or from another bitmap, clearing a
layer's bitmap or the coverage mask and copying a target went straight
through the immediate context, outside the state d2d1 swaps in to draw:
with the application's state active, they ran in it, and once that
state emulates ID3D10Device (Office draws with a D3D10.1 device) Windows
drops them.  Each now swaps in the state of the context the bitmap was
made with, or the context's own, and swaps the application's back.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/d2d1/bitmap.c b/dlls/d2d1/bitmap.c
index d9cc2eeb6a4..9b3249ed01a 100644
--- a/dlls/d2d1/bitmap.c
+++ b/dlls/d2d1/bitmap.c
@@ -26,6 +26,35 @@ static inline struct d2d_bitmap *impl_from_ID2D1Bitmap1(ID2D1Bitmap1 *iface)
     return CONTAINING_RECORD(iface, struct d2d_bitmap, ID2D1Bitmap1_iface);
 }
 
+/* The D3D11 calls d2d1 makes for itself go through a state of its own: the application's may emulate ID3D10Device,
+ * which drops them. */
+ID3D11DeviceContext1 *d2d_begin_d3d_calls(ID3D11Device *device, ID3DDeviceContextState *state,
+        ID3DDeviceContextState **prev)
+{
+    ID3D11DeviceContext *context;
+    ID3D11DeviceContext1 *context1 = NULL;
+
+    *prev = NULL;
+    ID3D11Device_GetImmediateContext(device, &context);
+    ID3D11DeviceContext_QueryInterface(context, &IID_ID3D11DeviceContext1, (void **)&context1);
+    ID3D11DeviceContext_Release(context);
+    if (context1 && state)
+        ID3D11DeviceContext1_SwapDeviceContextState(context1, state, prev);
+    return context1;
+}
+
+void d2d_end_d3d_calls(ID3D11DeviceContext1 *context, ID3DDeviceContextState *prev)
+{
+    if (!context)
+        return;
+    if (prev)
+    {
+        ID3D11DeviceContext1_SwapDeviceContextState(context, prev, NULL);
+        ID3DDeviceContextState_Release(prev);
+    }
+    ID3D11DeviceContext1_Release(context);
+}
+
 static HRESULT d2d_bitmap_unmap(struct d2d_bitmap *bitmap)
 {
     ID3D11DeviceContext *context;
@@ -92,6 +121,8 @@ static ULONG STDMETHODCALLTYPE d2d_bitmap_Release(ID2D1Bitmap1 *iface)
         if (bitmap->surface)
             IDXGISurface_Release(bitmap->surface);
         ID3D11Resource_Release(bitmap->resource);
+        if (bitmap->d3d_state)
+            ID3DDeviceContextState_Release(bitmap->d3d_state);
         ID2D1Factory_Release(bitmap->factory);
         free(bitmap);
     }
@@ -154,7 +185,8 @@ static HRESULT STDMETHODCALLTYPE d2d_bitmap_CopyFromBitmap(ID2D1Bitmap1 *iface,
 {
     struct d2d_bitmap *src_bitmap = unsafe_impl_from_ID2D1Bitmap(bitmap);
     struct d2d_bitmap *dst_bitmap = impl_from_ID2D1Bitmap1(iface);
-    ID3D11DeviceContext *context;
+    ID3DDeviceContextState *prev;
+    ID3D11DeviceContext1 *context;
     ID3D11Device *device;
     D3D11_BOX box;
 
@@ -172,11 +204,11 @@ static HRESULT STDMETHODCALLTYPE d2d_bitmap_CopyFromBitmap(ID2D1Bitmap1 *iface,
     }
 
     ID3D11Resource_GetDevice(dst_bitmap->resource, &device);
-    ID3D11Device_GetImmediateContext(device, &context);
-    ID3D11DeviceContext_CopySubresourceRegion(context, dst_bitmap->resource, 0,
-            dst_point ? dst_point->x : 0, dst_point ? dst_point->y : 0, 0,
-            src_bitmap->resource, 0, src_rect ? &box : NULL);
-    ID3D11DeviceContext_Release(context);
+    if ((context = d2d_begin_d3d_calls(device, dst_bitmap->d3d_state, &prev)))
+        ID3D11DeviceContext1_CopySubresourceRegion(context, dst_bitmap->resource, 0,
+                dst_point ? dst_point->x : 0, dst_point ? dst_point->y : 0, 0,
+                src_bitmap->resource, 0, src_rect ? &box : NULL);
+    d2d_end_d3d_calls(context, prev);
     ID3D11Device_Release(device);
 
     return S_OK;
@@ -221,7 +253,8 @@ static HRESULT STDMETHODCALLTYPE d2d_bitmap_CopyFromMemory(ID2D1Bitmap1 *iface,
         const D2D1_RECT_U *dst_rect, const void *src_data, UINT32 pitch)
 {
     struct d2d_bitmap *bitmap = impl_from_ID2D1Bitmap1(iface);
-    ID3D11DeviceContext *context;
+    ID3DDeviceContextState *prev;
+    ID3D11DeviceContext1 *context;
     ID3D11Device *device;
     D3D11_BOX box;
 
@@ -239,9 +272,9 @@ static HRESULT STDMETHODCALLTYPE d2d_bitmap_CopyFromMemory(ID2D1Bitmap1 *iface,
     }
 
     ID3D11Resource_GetDevice(bitmap->resource, &device);
-    ID3D11Device_GetImmediateContext(device, &context);
-    ID3D11DeviceContext_UpdateSubresource(context, bitmap->resource, 0, dst_rect ? &box : NULL, src_data, pitch, 0);
-    ID3D11DeviceContext_Release(context);
+    if ((context = d2d_begin_d3d_calls(device, bitmap->d3d_state, &prev)))
+        ID3D11DeviceContext1_UpdateSubresource(context, bitmap->resource, 0, dst_rect ? &box : NULL, src_data, pitch, 0);
+    d2d_end_d3d_calls(context, prev);
     ID3D11Device_Release(device);
 
     return S_OK;
@@ -427,6 +460,8 @@ static void d2d_bitmap_init(struct d2d_bitmap *bitmap, struct d2d_device_context
     bitmap->dpi_x = desc->dpiX;
     bitmap->dpi_y = desc->dpiY;
     bitmap->options = desc->bitmapOptions;
+    if ((bitmap->d3d_state = context->d3d_state))
+        ID3DDeviceContextState_AddRef(bitmap->d3d_state);
 
     if (d2d_device_context_is_dxgi_target(context))
         ID3D11Resource_QueryInterface(resource, &IID_IDXGISurface, (void **)&bitmap->surface);
diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index a8161d072e7..79c1bf8dd61 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -658,8 +658,12 @@ struct d2d_bitmap
     float dpi_x;
     float dpi_y;
     D2D1_BITMAP_OPTIONS options;
+    ID3DDeviceContextState *d3d_state;  /* what its copies are made with */
 };
 
+ID3D11DeviceContext1 *d2d_begin_d3d_calls(ID3D11Device *device, ID3DDeviceContextState *state,
+        ID3DDeviceContextState **prev);
+void d2d_end_d3d_calls(ID3D11DeviceContext1 *context, ID3DDeviceContextState *prev);
 HRESULT d2d_bitmap_create(struct d2d_device_context *context, D2D1_SIZE_U size, const void *src_data,
         UINT32 pitch, const D2D1_BITMAP_PROPERTIES1 *desc, struct d2d_bitmap **bitmap);
 HRESULT d2d_bitmap_create_shared(struct d2d_device_context *context, REFIID iid, void *data,
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 561985b99d7..a37aa2168de 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -1119,6 +1119,7 @@ static BOOL d2d_device_context_begin_coverage(struct d2d_device_context *context
 {
     static const float transparent[4];
     ID3D11DeviceContext1 *d3d_context;
+    ID3DDeviceContextState *prev;
     D2D1_RECT_F bounds, rect;
     D2D1_MATRIX_3X2_F m;
     RECT scissor, clear;
@@ -1177,9 +1178,9 @@ static BOOL d2d_device_context_begin_coverage(struct d2d_device_context *context
     clear.bottom = pass->bounds.bottom - pass->bounds.top;
     if (context->cs)
         EnterCriticalSection(context->cs);
-    ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
-    ID3D11DeviceContext1_ClearView(d3d_context, (ID3D11View *)context->coverage.rtv, transparent, &clear, 1);
-    ID3D11DeviceContext1_Release(d3d_context);
+    if ((d3d_context = d2d_begin_d3d_calls((ID3D11Device *)context->d3d_device, context->d3d_state, &prev)))
+        ID3D11DeviceContext1_ClearView(d3d_context, (ID3D11View *)context->coverage.rtv, transparent, &clear, 1);
+    d2d_end_d3d_calls(d3d_context, prev);
     if (context->cs)
         LeaveCriticalSection(context->cs);
     return TRUE;
@@ -2466,12 +2467,13 @@ static void d2d_device_context_clear_bitmap(struct d2d_device_context *context,
 {
     static const float transparent[4];
     ID3D11DeviceContext1 *d3d_context;
+    ID3DDeviceContextState *prev;
 
     if (context->cs)
         EnterCriticalSection(context->cs);
-    ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
-    ID3D11DeviceContext1_ClearRenderTargetView(d3d_context, bitmap->rtv, transparent);
-    ID3D11DeviceContext1_Release(d3d_context);
+    if ((d3d_context = d2d_begin_d3d_calls((ID3D11Device *)context->d3d_device, context->d3d_state, &prev)))
+        ID3D11DeviceContext1_ClearRenderTargetView(d3d_context, bitmap->rtv, transparent);
+    d2d_end_d3d_calls(d3d_context, prev);
     if (context->cs)
         LeaveCriticalSection(context->cs);
 }
@@ -2480,12 +2482,13 @@ static void d2d_device_context_copy_bitmap(struct d2d_device_context *context, s
         struct d2d_bitmap *src)
 {
     ID3D11DeviceContext1 *d3d_context;
+    ID3DDeviceContextState *prev;
 
     if (context->cs)
         EnterCriticalSection(context->cs);
-    ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
-    ID3D11DeviceContext1_CopyResource(d3d_context, dst->resource, src->resource);
-    ID3D11DeviceContext1_Release(d3d_context);
+    if ((d3d_context = d2d_begin_d3d_calls((ID3D11Device *)context->d3d_device, context->d3d_state, &prev)))
+        ID3D11DeviceContext1_CopyResource(d3d_context, dst->resource, src->resource);
+    d2d_end_d3d_calls(d3d_context, prev);
     if (context->cs)
         LeaveCriticalSection(context->cs);
 }
