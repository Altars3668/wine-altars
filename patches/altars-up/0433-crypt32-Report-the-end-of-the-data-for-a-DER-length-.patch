From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 08:51:40 -0400
Subject: [PATCH] crypt32: Report the end of the data for a DER length past it.

A short-form length one byte past the data was let through, to fail
later as corrupt, and the check of a long-form length counted none of
its length bytes, having used the counter up reading them.  Windows 11
says CRYPT_E_ASN1_EOD for a TSTInfo cut by one byte either way.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/crypt32/decode.c b/dlls/crypt32/decode.c
index 8a933cd4fcc..b175c0392f1 100644
--- a/dlls/crypt32/decode.c
+++ b/dlls/crypt32/decode.c
@@ -133,7 +133,7 @@ static BOOL CRYPT_GetLengthIndefinite(const BYTE *pbEncoded, DWORD cbEncoded,
     }
     else if (pbEncoded[1] <= 0x7f)
     {
-        if (pbEncoded[1] + 1 > cbEncoded)
+        if (pbEncoded[1] + 2 > cbEncoded)
         {
             SetLastError(CRYPT_E_ASN1_EOD);
             ret = FALSE;
@@ -165,15 +165,14 @@ static BOOL CRYPT_GetLengthIndefinite(const BYTE *pbEncoded, DWORD cbEncoded,
         }
         else
         {
-            DWORD out = 0;
+            DWORD out = 0, i;
 
-            pbEncoded += 2;
-            while (--lenLen)
+            for (i = 2; i <= lenLen; i++)
             {
                 out <<= 8;
-                out |= *pbEncoded++;
+                out |= pbEncoded[i];
             }
-            if (out + lenLen + 1 > cbEncoded)
+            if (out > cbEncoded - 1 - lenLen)
             {
                 SetLastError(CRYPT_E_ASN1_EOD);
                 ret = FALSE;
