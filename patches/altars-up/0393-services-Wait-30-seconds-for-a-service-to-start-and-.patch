From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 08:25:18 -0400
Subject: [PATCH] services: Wait 30 seconds for a service to start, and read
 ServicesPipeTimeout as a DWORD.

Windows waits 30 seconds by default for a service it starts to connect to it, and its
ServicesPipeTimeout setting, which changes that, is a DWORD in milliseconds.  Still take a string,
which is what was read here before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/programs/services/services.c b/programs/services/services.c
index db9112c873c..8d7009ed32f 100644
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -41,7 +41,7 @@ WINE_DEFAULT_DEBUG_CHANNEL(service);
 
 struct scmdatabase *active_database;
 
-DWORD service_pipe_timeout = 10000;
+DWORD service_pipe_timeout = 30000;
 DWORD service_kill_timeout = 60000;
 static DWORD default_preshutdown_timeout = 180000;
 static DWORD autostart_delay = 120000;
@@ -1299,10 +1299,15 @@ static void load_registry_parameters(void)
 
     if (RegOpenKeyW( HKEY_LOCAL_MACHINE, L"System\\CurrentControlSet\\Control", &key )) return;
 
+    /* a DWORD, as on Windows, or a string, which is what was read here before */
     count = sizeof(buffer);
-    if (!RegQueryValueExW( key, L"ServicesPipeTimeout", NULL, &type, (BYTE *)buffer, &count ) &&
-        type == REG_SZ && (val = wcstol( buffer, NULL, 10 )))
-        service_pipe_timeout = val;
+    if (!RegQueryValueExW( key, L"ServicesPipeTimeout", NULL, &type, (BYTE *)buffer, &count ))
+    {
+        if (type == REG_DWORD && count == sizeof(DWORD) && (val = *(DWORD *)buffer))
+            service_pipe_timeout = val;
+        else if (type == REG_SZ && (val = wcstol( buffer, NULL, 10 )))
+            service_pipe_timeout = val;
+    }
 
     count = sizeof(buffer);
     if (!RegQueryValueExW( key, L"WaitToKillServiceTimeout", NULL, &type, (BYTE *)buffer, &count ) &&
