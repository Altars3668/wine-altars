From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 11:41:52 -0400
Subject: [PATCH] msxml3: Report a misplaced XML declaration as Windows does.

An XML declaration may only start the document.  Anywhere else -- in
the prolog after a comment, in element content, after the root
element -- Windows reports XML_E_BADXMLDECL at its name; "<?xml?>",
with nothing after the name, is XML_E_XMLDECLSYNTAX where the name
ends; and the name in another case, as in "<?XML", XML_E_BADXMLCASE
at it (tools/msxmlmoreprobe in the wine-altars repository, MSXML 3.0
and 6.0).  Wine said XML_E_PIDECLSYNTAX after the name for all of them,
except after the root element, which the previous commit had covered
in part.  A processing instruction whose name only begins with "xml",
such as xml-stylesheet, stays fine.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/saxreader.c b/dlls/msxml3/saxreader.c
index eeacddd9d03..39473351c4e 100644
--- a/dlls/msxml3/saxreader.c
+++ b/dlls/msxml3/saxreader.c
@@ -4593,12 +4593,28 @@ static void saxreader_parse_pi(struct saxlocator *locator)
 
     /* Skip '<?' */
     saxreader_skip(locator, 2);
+    position = locator->buffer.position;
     saxreader_parse_name_strict(locator, &target);
 
     if (saxreader_is_xml_pi(target))
     {
+        /* an XML declaration where none may be, at its name, as Windows reports it; with nothing
+         * after the name, at what follows; "xml" in another case is a name of its own */
+        HRESULT code = E_SAX_BAD_XMLDECL;
+
+        if (wcscmp(target, L"xml")) code = E_SAX_BADXMLCASE;
+        else if (!saxreader_is_space(*saxreader_get_ptr(locator)))
+        {
+            code = E_SAX_XMLDECLSYNTAX;
+            position = locator->buffer.position;
+        }
         SysFreeString(target);
-        return saxreader_set_error(locator, E_SAX_PIDECLSYNTAX);
+        if (locator->status == S_OK)
+        {
+            locator->line = position.line;
+            locator->column = position.column;
+        }
+        return saxreader_set_error(locator, code);
     }
 
     saxreader_skipspaces(locator);
@@ -6458,17 +6474,6 @@ static HRESULT saxreader_parse_stream(struct saxreader *reader, ISequentialStrea
                 {
                     if (saxreader_peek(locator, L"<?", 2))
                     {
-                        const WCHAR *ptr = saxreader_get_chars(locator, 6);
-
-                        /* an XML declaration after the root element, at its name */
-                        if (locator->state == SAX_PARSER_EPILOG && !wcsncmp(ptr, L"<?xml", 5) &&
-                                (saxreader_is_space(ptr[5]) || ptr[5] == '?'))
-                        {
-                            locator->line = locator->buffer.position.line;
-                            locator->column = locator->buffer.position.column + 2;
-                            saxreader_set_error(locator, E_SAX_BAD_XMLDECL);
-                            break;
-                        }
                         saxreader_parse_pi(locator);
                         break;
                     }
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index fb7ba2a0592..6aa9478f2db 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -20200,6 +20200,11 @@ static void test_parse_error_source(void)
         { "text<a/>", 0xc00ce556, 1, 1, 0, L"text<a/>" },
         { "<a/><?xml version='1.0'?>", 0xc00ce557 /* XML_E_BADXMLDECL */, 1, 7, 6, L"<a/><?xml version='1.0'?>" },
         { "<!--c--><a/><b/>", 0xc00ce555, 1, 14, 13, L"<!--c--><a/><b/>" },
+        /* an XML declaration anywhere but at the start */
+        { "<a><?xml version='1.0'?></a>", 0xc00ce557, 1, 6, 5, L"<a><?xml version='1.0'?></a>" },
+        { "<!--c--><?xml version='1.0'?><a/>", 0xc00ce557, 1, 11, 10, L"<!--c--><?xml version='1.0'?><a/>" },
+        { "<a/><?XML version='1.0'?>", 0xc00ce576 /* XML_E_BADXMLCASE */, 1, 7, 6, L"<a/><?XML version='1.0'?>" },
+        { "<a/><?xml?>", 0xc00ce507 /* XML_E_XMLDECLSYNTAX */, 1, 10, 9, L"<a/><?xml?>" },
     };
     static const struct
     {
