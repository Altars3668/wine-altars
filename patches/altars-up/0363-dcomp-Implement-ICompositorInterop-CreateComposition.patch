+#include "private.h"
+
+#include "dxgi1_6.h"
+/* what the other interfaces of dxgi's own speak of, which is not for here */
+struct wined3d_device_parent;
+struct wined3d_resource;
+struct wined3d_texture;
+#include "initguid.h"
+#include "wine/winedxgi.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/*
+ * A surface of a swapchain made for composition shows what the swapchain
+ * presented last.  The swapchain keeps that in a texture of its device, and
+ * calls in on each present; as on Windows, what a swapchain presents is shown
+ * without a commit, so the targets are drawn again then.
+ */
+struct swapchain_surface
+{
+    struct object base;
+    ICompositionSurface ICompositionSurface_iface;
+    IDXGISwapChain1 *swapchain;
+    IWineDXGICompositionSwapChain *composition;
+    struct mirror mirror;           /* on the device a target draws with, when that is another */
+};
+
+static inline struct swapchain_surface *impl_from_swapchain_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct swapchain_surface, base );
+}
+
+static HRESULT swapchain_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct swapchain_surface *surface = impl_from_swapchain_object( object );
+
+    if (IsEqualGUID( iid, &IID_ICompositionSurface )) *out = &surface->ICompositionSurface_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void WINAPI swapchain_presented( void *context )
+{
+    struct swapchain_surface *surface = context;
+    compositor_presented( surface->base.compositor );
+}
+
+/* called with the compositor locked */
+static void swapchain_close( struct object *object )
+{
+    struct swapchain_surface *surface = impl_from_swapchain_object( object );
+
+    IWineDXGICompositionSwapChain_remove_present_callback( surface->composition, swapchain_presented, surface );
+    mirror_release( &surface->mirror );
+}
+
+static void swapchain_destroy( struct object *object )
+{
+    struct swapchain_surface *surface = impl_from_swapchain_object( object );
+
+    IWineDXGICompositionSwapChain_Release( surface->composition );
+    IDXGISwapChain1_Release( surface->swapchain );
+    free( surface );
+}
+
+static const struct object_ops swapchain_ops =
+{
+    L"Windows.UI.Composition.CompositionSurface",
+    swapchain_query_interface,
+    swapchain_destroy,
+    swapchain_close,
+};
+
+DEFINE_IINSPECTABLE( swapchain, ICompositionSurface, struct swapchain_surface, base.ICompositionObject_iface )
+
+static const struct ICompositionSurfaceVtbl swapchain_vtbl =
+{
+    swapchain_QueryInterface,
+    swapchain_AddRef,
+    swapchain_Release,
+    /* IInspectable methods */
+    swapchain_GetIids,
+    swapchain_GetRuntimeClassName,
+    swapchain_GetTrustLevel,
+    /* ICompositionSurface methods */
+};
+
+static struct swapchain_surface *unsafe_impl_from_swapchain_surface( ICompositionSurface *iface )
+{
+    if (!iface || iface->lpVtbl != &swapchain_vtbl) return NULL;
+    return impl_from_ICompositionSurface( iface );
+}
+
+HRESULT swapchain_surface_create( struct compositor *compositor, IUnknown *swapchain, ICompositionSurface **out )
+{
+    IWineDXGICompositionSwapChain *composition;
+    struct swapchain_surface *surface;
+    IDXGISwapChain1 *swapchain1;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!swapchain) return E_INVALIDARG;
+    if (FAILED(IUnknown_QueryInterface( swapchain, &IID_IDXGISwapChain1, (void **)&swapchain1 )))
+    {
+        WARN( "%p is not a swapchain.\n", swapchain );
+        return E_INVALIDARG;
+    }
+    /* only one made for composition can be shown */
+    if (FAILED(IDXGISwapChain1_QueryInterface( swapchain1, &IID_IWineDXGICompositionSwapChain, (void **)&composition )))
+    {
+        WARN( "swapchain %p is not one for composition.\n", swapchain );
+        IDXGISwapChain1_Release( swapchain1 );
+        return E_INVALIDARG;
+    }
+
+    if (!(surface = calloc( 1, sizeof(*surface) )))
+    {
+        IWineDXGICompositionSwapChain_Release( composition );
+        IDXGISwapChain1_Release( swapchain1 );
+        return E_OUTOFMEMORY;
+    }
+    object_init( &surface->base, &swapchain_ops, compositor );
+    surface->ICompositionSurface_iface.lpVtbl = &swapchain_vtbl;
+    surface->swapchain = swapchain1;
+    surface->composition = composition;
+    if (FAILED(hr = IWineDXGICompositionSwapChain_add_present_callback( composition, swapchain_presented, surface )))
+    {
+        /* closing takes away a callback it never had, which is nothing */
+        ICompositionSurface_Release( &surface->ICompositionSurface_iface );
+        return hr;
+    }
+
+    TRACE( "swapchain %p, surface %p.\n", swapchain, surface );
+    *out = &surface->ICompositionSurface_iface;
+    return S_OK;
+}
+
+/*
+ * What a swapchain surface shows, as a texture of the device a target draws
+ * with: on another device than the swapchain's, its pixels are brought over
+ * whenever it has presented since.  S_FALSE, and no texture, until the first
+ * present.  Called with the compositor locked.
+ */
+HRESULT swapchain_surface_texture( ICompositionSurface *iface, ID3D11Device *device, ID3D11Texture2D **out,
+                                   D2D1_ALPHA_MODE *alpha_mode )
+{
+    struct swapchain_surface *surface = unsafe_impl_from_swapchain_surface( iface );
+    ID3D11Texture2D *texture, *mirror;
+    DXGI_SWAP_CHAIN_DESC1 desc;
+    ID3D11Device *own;
+    IDXGISurface *presented;
+    UINT version;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!surface || surface->base.closed) return S_FALSE;
+    if (IWineDXGICompositionSwapChain_get_presented( surface->composition, &presented, &version ) != S_OK)
+        return S_FALSE;
+    hr = IDXGISurface_QueryInterface( presented, &IID_ID3D11Texture2D, (void **)&texture );
+    IDXGISurface_Release( presented );
+    if (FAILED(hr)) return hr;
+
+    /* composition shows what is presented with alpha premultiplied, or as opaque */
+    *alpha_mode = D2D1_ALPHA_MODE_IGNORE;
+    if (SUCCEEDED(IDXGISwapChain1_GetDesc1( surface->swapchain, &desc )))
+    {
+        if (desc.AlphaMode == DXGI_ALPHA_MODE_PREMULTIPLIED) *alpha_mode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+        else if (desc.AlphaMode == DXGI_ALPHA_MODE_STRAIGHT)
+        {
+            FIXME( "straight alpha drawn as premultiplied.\n" );
+            *alpha_mode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+        }
+    }
+
+    ID3D11Texture2D_GetDevice( texture, &own );
+    ID3D11Device_Release( own );
+    if (own == device)
+    {
+        *out = texture;
+        return S_OK;
+    }
+    hr = mirror_texture( &surface->mirror, texture, version, device, &mirror );
+    ID3D11Texture2D_Release( texture );
+    if (FAILED(hr)) return hr;
+    ID3D11Texture2D_AddRef( (*out = mirror) );
+    return S_OK;
+}
+
+BOOL is_swapchain_surface( ICompositionSurface *iface )
+{
+    return !!unsafe_impl_from_swapchain_surface( iface );
+}
