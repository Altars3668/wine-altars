+/*
+ * A swapchain a surface of the compositor shows has presented: the targets
+ * are drawn again, as they stand, on the compositor's thread, as Windows shows
+ * what a swapchain presents without a commit.  Called on the thread that
+ * presented, without the compositor's lock, which that thread may not take.
+ */
+void compositor_presented( struct compositor *compositor )
+{
+    boolean queued = FALSE;
+    struct work *work;
+
+    if (InterlockedCompareExchange( &compositor->frame_queued, 1, 0 )) return;
+    if (!compositor->queue || !(work = calloc( 1, sizeof(*work) )))
+    {
+        InterlockedExchange( &compositor->frame_queued, 0 );
+        return;
+    }
+    work->IDispatcherQueueHandler_iface.lpVtbl = &work_vtbl;
+    work->ref = 1;
+    work->compositor = compositor;
+    work->frame = TRUE;
+    compositor_add_ref( compositor );
+    if (FAILED(IDispatcherQueue_TryEnqueue( compositor->queue, &work->IDispatcherQueueHandler_iface, &queued )) ||
+        !queued)
+    {
+        WARN( "could not queue a frame on the dispatcher queue.\n" );
+        InterlockedExchange( &compositor->frame_queued, 0 );
+    }
+    IDispatcherQueueHandler_Release( &work->IDispatcherQueueHandler_iface );
+}
