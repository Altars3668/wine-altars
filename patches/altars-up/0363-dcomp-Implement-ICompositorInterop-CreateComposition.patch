@@ -415,7 +417,20 @@ static HRESULT WINAPI work_Invoke( IDispatcherQueueHandler *iface )
     struct commit_needed_handler *entry;
     unsigned int count = 0, i;
 
-    TRACE( "compositor %p.\n", compositor );
+    TRACE( "compositor %p, frame %d.\n", compositor, work->frame );
+
