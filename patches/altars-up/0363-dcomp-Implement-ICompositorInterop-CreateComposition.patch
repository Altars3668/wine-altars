+/*
+ * A tile's pixels as a texture of the device a target draws with, brought
+ * over from its own when that is another.  Both devices are locked by the
+ * frame that asks.
+ */
+HRESULT tile_texture( struct drawing_surface *surface, struct tile *tile, ID3D11Device *device, ID3D11Texture2D **out )
+{
+    if (surface->device->d3d_device == device)
+    {
+        *out = tile->texture;
+        return S_OK;
+    }
+    return mirror_texture( &tile->mirror, tile->texture, tile->version, device, out );
+}
