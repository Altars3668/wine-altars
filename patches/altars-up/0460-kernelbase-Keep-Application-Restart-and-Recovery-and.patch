+static void test_wer_registrations(void)
+{
+    static BYTE blocks[2][128];
+    WCHAR name[400];
+    DWORD flags;
+    HRESULT hr;
+    unsigned int i;
+
+    hr = WerRegisterFile( L"C:\\nonexistent\\wer-test.dat", WerRegFileTypeOther,
+                          WER_FILE_DELETE_WHEN_DONE | WER_FILE_ANONYMOUS_DATA );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerRegisterFile( L"c:\\NONEXISTENT\\WER-TEST.DAT", WerRegFileTypeOther, 0 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    /* the same file, in any case */
+    hr = WerUnregisterFile( L"C:\\nonexistent\\wer-test.dat" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerUnregisterFile( L"C:\\nonexistent\\wer-test.dat" );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "got %#lx\n", hr );
+    hr = WerRegisterFile( NULL, WerRegFileTypeOther, 0 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = WerRegisterFile( L"C:\\nonexistent\\wer-test.dat", 0, 0 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = WerRegisterFile( L"C:\\nonexistent\\wer-test.dat", WerRegFileTypeMax, 0 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = WerRegisterFile( L"C:\\nonexistent\\wer-test.dat", WerRegFileTypeUserDocument, 0x80 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    wcscpy( name, L"C:\\nonexistent\\" );
+    wmemset( name + 15, 'a', 300 );
+    name[315] = 0;
+    hr = WerRegisterFile( name, WerRegFileTypeOther, 0 );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE), "got %#lx\n", hr );
+
+    hr = WerRegisterMemoryBlock( blocks[0], sizeof(blocks[0]) );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerRegisterMemoryBlock( blocks[0], 64 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerUnregisterMemoryBlock( blocks[0] );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerUnregisterMemoryBlock( blocks[0] );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "got %#lx\n", hr );
+    hr = WerRegisterMemoryBlock( NULL, 128 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = WerRegisterMemoryBlock( blocks[1], 0 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = WerRegisterMemoryBlock( blocks[1], WER_MAX_MEM_BLOCK_SIZE + 1 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    hr = WerRegisterCustomMetadata( L"Key_1.a-b", L"value" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerRegisterCustomMetadata( L"Key_1.a-b", L"another value" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerUnregisterCustomMetadata( L"Key_1.a-b" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerUnregisterCustomMetadata( L"Key_1.a-b" );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "got %#lx\n", hr );
+    {
+        static const WCHAR *bad_keys[] = { L"", L"1Key", L"Key 1", L"K\x00e9y" };
+        for (i = 0; i < ARRAY_SIZE(bad_keys); i++)
+        {
+            hr = WerRegisterCustomMetadata( bad_keys[i], L"v" );
+            ok( hr == E_INVALIDARG, "%u: got %#lx\n", i, hr );
+        }
+    }
+    hr = WerRegisterCustomMetadata( L"Key", NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    wmemset( name, 'v', 127 );
+    name[127] = 0;
+    hr = WerRegisterCustomMetadata( L"Key", name );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    WerUnregisterCustomMetadata( L"Key" );
+    name[127] = 'v';
+    name[128] = 0;
+    hr = WerRegisterCustomMetadata( L"Key", name );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    /* eight keys at most */
+    for (i = 0; i < 9; i++)
+    {
+        swprintf( name, ARRAY_SIZE(name), L"Key%u", i );
+        hr = WerRegisterCustomMetadata( name, L"v" );
+        ok( hr == (i < 8 ? S_OK : HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER)), "%u: got %#lx\n", i, hr );
+    }
+    for (i = 0; i < 8; i++)
+    {
+        swprintf( name, ARRAY_SIZE(name), L"Key%u", i );
+        WerUnregisterCustomMetadata( name );
+    }
+
+    hr = WerRegisterRuntimeExceptionModule( L"C:\\nonexistent\\wer-test.dll", (void *)0x1234 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerUnregisterRuntimeExceptionModule( L"C:\\nonexistent\\wer-test.dll", (void *)0x5678 );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND), "got %#lx\n", hr );
+    hr = WerUnregisterRuntimeExceptionModule( L"C:\\nonexistent\\wer-test.dll", (void *)0x1234 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerRegisterRuntimeExceptionModule( NULL, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    flags = 0xdeadbeef;
+    hr = WerGetFlags( GetCurrentProcess(), &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !flags, "got %#lx\n", flags );
+    hr = WerSetFlags( 0x80000000 | WER_FAULT_REPORTING_FLAG_NOHEAP );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WerGetFlags( GetCurrentProcess(), &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( flags == (0x80000000 | WER_FAULT_REPORTING_FLAG_NOHEAP), "got %#lx\n", flags );
+    hr = WerGetFlags( GetCurrentProcess(), NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = WerGetFlags( NULL, &flags );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    WerSetFlags( 0 );
+}
