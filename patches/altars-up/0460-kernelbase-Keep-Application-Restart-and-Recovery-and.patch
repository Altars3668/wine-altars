+
+static void test_restart(void)
+{
+    WCHAR buffer[2048], line[1100];
+    DWORD size, flags;
+    HRESULT hr;
+
+    size = ARRAY_SIZE(buffer);
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), buffer, &size, &flags );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "got %#lx\n", hr );
+    ok( size == ARRAY_SIZE(buffer), "got size %lu\n", size );
+
+    hr = RegisterApplicationRestart( L"/restart-line", 0 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    /* without a buffer the size is all that comes back */
+    size = 0;
+    flags = 0xdeadbeef;
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), NULL, &size, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( size == 14, "got size %lu\n", size );
+    ok( !flags, "got flags %#lx\n", flags );
+
+    size = 5;
+    memset( buffer, 0xcc, sizeof(buffer) );
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), buffer, &size, &flags );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_INSUFFICIENT_BUFFER), "got %#lx\n", hr );
+    ok( size == 14, "got size %lu\n", size );
+    ok( !buffer[0], "got %#x\n", buffer[0] );
+
+    size = 14;
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), buffer, &size, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( buffer, L"/restart-line" ), "got %s\n", wine_dbgstr_w(buffer) );
+
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), buffer, NULL, &flags );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    /* the flags are kept as they are, whatever they are */
+    hr = RegisterApplicationRestart( L"/x", 0x80000000 | RESTART_NO_PATCH );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    size = ARRAY_SIZE(buffer);
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), buffer, &size, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( flags == (0x80000000 | RESTART_NO_PATCH), "got flags %#lx\n", flags );
+
+    hr = RegisterApplicationRestart( NULL, 0 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    size = ARRAY_SIZE(buffer);
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), buffer, &size, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( size == 1, "got size %lu\n", size );
+
+    wmemset( line, 'a', 1023 );
+    line[1023] = 0;
+    hr = RegisterApplicationRestart( line, 0 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    line[1023] = 'a';
+    line[1024] = 0;
+    hr = RegisterApplicationRestart( line, 0 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    size = ARRAY_SIZE(buffer);
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), buffer, &size, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( size == 1024, "got size %lu\n", size );
+
+    hr = UnregisterApplicationRestart();
+    ok( hr == S_OK, "got %#lx\n", hr );
+    size = ARRAY_SIZE(buffer);
+    hr = GetApplicationRestartSettings( GetCurrentProcess(), buffer, &size, &flags );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "got %#lx\n", hr );
+    ok( !size, "got size %lu\n", size );
+    hr = UnregisterApplicationRestart();
+    ok( hr == S_OK, "got %#lx\n", hr );
+}
+
+static void test_recovery(void)
+{
+    APPLICATION_RECOVERY_CALLBACK callback;
+    DWORD ping, flags;
+    void *param;
+    BOOL cancelled;
+    HRESULT hr;
+
+    if (!pGetApplicationRecoveryCallback)
+    {
+        win_skip( "GetApplicationRecoveryCallback is not available\n" );
+        return;
+    }
+
+    hr = pGetApplicationRecoveryCallback( GetCurrentProcess(), &callback, &param, &ping, &flags );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_NOT_FOUND), "got %#lx\n", hr );
+
+    hr = RegisterApplicationRecoveryCallback( NULL, NULL, 0, 0 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = RegisterApplicationRecoveryCallback( recovery_callback, NULL, RECOVERY_MAX_PING_INTERVAL + 1, 0 );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    hr = RegisterApplicationRecoveryCallback( recovery_callback, (void *)0x1234, 0, 0 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    callback = NULL;
+    param = NULL;
+    ping = flags = 0xdeadbeef;
+    hr = pGetApplicationRecoveryCallback( GetCurrentProcess(), &callback, &param, &ping, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( callback == recovery_callback, "got %p\n", callback );
+    ok( param == (void *)0x1234, "got %p\n", param );
+    ok( ping == RECOVERY_DEFAULT_PING_INTERVAL, "got %lu\n", ping );
+    ok( !flags, "got %#lx\n", flags );
+
+    hr = RegisterApplicationRecoveryCallback( recovery_callback, NULL, RECOVERY_MAX_PING_INTERVAL, 0x80000001 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = pGetApplicationRecoveryCallback( GetCurrentProcess(), &callback, &param, &ping, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( ping == RECOVERY_MAX_PING_INTERVAL, "got %lu\n", ping );
+    ok( flags == 0x80000001, "got %#lx\n", flags );
+
+    /* outside a recovery there is nothing to tell */
+    cancelled = 7;
+    hr = ApplicationRecoveryInProgress( &cancelled );
+    ok( hr == E_FAIL, "got %#lx\n", hr );
+    ok( !cancelled, "got %d\n", cancelled );
+    hr = ApplicationRecoveryInProgress( NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ApplicationRecoveryFinished( TRUE );
+
+    /* unregistered, the callback is still found, empty */
+    hr = pUnregisterApplicationRecoveryCallback();
+    ok( hr == S_OK, "got %#lx\n", hr );
+    callback = (void *)0xdead;
+    param = (void *)0xdead;
+    hr = pGetApplicationRecoveryCallback( GetCurrentProcess(), &callback, &param, &ping, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !callback, "got %p\n", callback );
+    ok( !param, "got %p\n", param );
+    ok( !ping, "got %lu\n", ping );
+    hr = pUnregisterApplicationRecoveryCallback();
+    ok( hr == S_OK, "got %#lx\n", hr );
+}
