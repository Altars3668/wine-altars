diff --git a/dlls/kernelbase/wer.c b/dlls/kernelbase/wer.c
new file mode 100644
index 00000000000..a512f6a3b95
--- /dev/null
+++ b/dlls/kernelbase/wer.c
@@ -0,0 +1,860 @@
+/*
+ * Application Restart and Recovery, and Windows Error Reporting registrations
+ *
+ * Copyright 2026 the Wine Altars project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "werapi.h"
+
+#include "kernelbase.h"
+#include "wine/list.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(seh);
+
+/* What the process registered, in the block the PEB's WerRegistrationData points to, laid out as Windows 11 lays it
+ * out so that another process reads the restart command line, the recovery callback and the flags from it.  The lists
+ * of files, memory blocks, metadata and runtime exception modules are the process's own. */
+struct wer_block
+{
+    LONG   length;
+    WCHAR  signature[14];
+    DWORD  restart_flags;
+    DWORD  restart_registered;
+    WCHAR  app_data_path[64];
+    WCHAR  restart_cmdline[RESTART_MAX_CMD_LINE];
+    struct
+    {
+        DWORD  length;
+        DWORD  registered;      /* ever, as Windows tells by an encoded null callback */
+        APPLICATION_RECOVERY_CALLBACK callback;
+        void  *param;
+        HANDLE started;
+        HANDLE finished;
+        HANDLE in_progress;
+        LONG   last_error;
+        BOOL   successful;
+        DWORD  ping_interval;
+        DWORD  flags;
+    } recovery;
+    void  *gather;
+    void  *metadata;
+    void  *runtime_dlls;
+    void  *dumps;
+    LONG   gather_count;
+    LONG   metadata_count;
+    LONG   dump_count;
+    LONG   flags;
+    BYTE   heap[0x40];
+    void  *reserved[2];
+};
+
+#ifdef _WIN64
+C_ASSERT( offsetof(struct wer_block, restart_flags) == 0x20 );
+C_ASSERT( offsetof(struct wer_block, restart_cmdline) == 0xa8 );
+C_ASSERT( offsetof(struct wer_block, recovery.callback) == 0x8b0 );
+C_ASSERT( offsetof(struct wer_block, recovery.ping_interval) == 0x8e0 );
+C_ASSERT( offsetof(struct wer_block, gather) == 0x8e8 );
+C_ASSERT( offsetof(struct wer_block, flags) == 0x914 );
+C_ASSERT( sizeof(struct wer_block) == 0x968 );
+#endif
+
+#define WER_MAX_GATHERS          512
+#define WER_MAX_METADATA         8
+#define WER_MAX_RUNTIME_DLLS     16
+#define WER_MAX_METADATA_KEY     64
+#define WER_MAX_METADATA_VALUE   128
+
+struct gather
+{
+    struct list entry;
+    WCHAR      *file;       /* a file, or else a memory block */
+    DWORD       type;
+    DWORD       flags;
+    const void *block;
+    DWORD       size;
+};
+
+struct metadata
+{
+    struct list entry;
+    WCHAR      *key;
+    WCHAR      *value;
+};
+
+struct runtime_dll
+{
+    struct list entry;
+    WCHAR      *path;
+    void       *context;
+};
+
+static struct list gathers = LIST_INIT( gathers );
+static struct list excluded = LIST_INIT( excluded );
+static struct list metadata_list = LIST_INIT( metadata_list );
+static struct list runtime_dlls = LIST_INIT( runtime_dlls );
+static WCHAR *app_local_dump;
+
+static CRITICAL_SECTION wer_cs;
+static CRITICAL_SECTION_DEBUG wer_cs_debug =
+{
+    0, 0, &wer_cs,
+    { &wer_cs_debug.ProcessLocksList, &wer_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": wer_cs") }
+};
+static CRITICAL_SECTION wer_cs = { &wer_cs_debug, -1, 0, 0, 0, 0 };
+
+static WCHAR *heap_strdupW( const WCHAR *str )
+{
+    SIZE_T size = (lstrlenW( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = HeapAlloc( GetProcessHeap(), 0, size );
+
+    if (ret) memcpy( ret, str, size );
+    return ret;
+}
+
+/* the block, made the first time something is registered; the lock is held */
+static struct wer_block *get_block(void)
+{
+    PEB *peb = NtCurrentTeb()->Peb;
+    struct wer_block *block = peb->WerRegistrationData;
+
+    if (block) return block;
+    if (!(block = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*block) ))) return NULL;
+    block->length = sizeof(*block);
+    memcpy( block->signature, L"PEB_SIGNATURE", sizeof(L"PEB_SIGNATURE") );
+    block->gather = &gathers;
+    block->metadata = &metadata_list;
+    block->runtime_dlls = &runtime_dlls;
+    peb->WerRegistrationData = block;
+    return block;
+}
+
+/* the block of another process, read into a copy */
+static HRESULT read_block( HANDLE process, struct wer_block *copy )
+{
+    PROCESS_BASIC_INFORMATION pbi;
+    void *remote = NULL;
+    NTSTATUS status;
+
+    if (NtQueryInformationProcess( process, ProcessBasicInformation, &pbi, sizeof(pbi), NULL ))
+        return HRESULT_FROM_WIN32( ERROR_INVALID_HANDLE );
+    status = NtReadVirtualMemory( process, (char *)pbi.PebBaseAddress + offsetof(PEB, WerRegistrationData),
+                                  &remote, sizeof(remote), NULL );
+    if (status) return HRESULT_FROM_WIN32( RtlNtStatusToDosError( status ) );
+    if (!remote) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    if ((status = NtReadVirtualMemory( process, remote, copy, sizeof(*copy), NULL )))
+        return HRESULT_FROM_WIN32( RtlNtStatusToDosError( status ) );
+    if (copy->length < sizeof(*copy) || memcmp( copy->signature, L"PEB_SIGNATURE", sizeof(L"PEB_SIGNATURE") ))
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    return S_OK;
+}
+
+static BOOL is_current_process( HANDLE process )
+{
+    return process == GetCurrentProcess() || GetProcessId( process ) == GetCurrentProcessId();
+}
+
+
+/***********************************************************************
+ *           RegisterApplicationRestart   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ RegisterApplicationRestart( const WCHAR *cmdline, DWORD flags )
+{
+    struct wer_block *block;
+    SIZE_T len = cmdline ? lstrlenW( cmdline ) : 0;
+
+    TRACE( "%s, %#lx\n", debugstr_w(cmdline), flags );
+
+    if (len >= RESTART_MAX_CMD_LINE) return E_INVALIDARG;
+    RtlEnterCriticalSection( &wer_cs );
+    if (!(block = get_block()))
+    {
+        RtlLeaveCriticalSection( &wer_cs );
+        return E_OUTOFMEMORY;
+    }
+    if (len) memcpy( block->restart_cmdline, cmdline, len * sizeof(WCHAR) );
+    block->restart_cmdline[len] = 0;
+    block->restart_flags = flags;
+    block->restart_registered = TRUE;
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+
+/***********************************************************************
+ *           UnregisterApplicationRestart   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ UnregisterApplicationRestart(void)
+{
+    struct wer_block *block;
+
+    TRACE( "\n" );
+
+    RtlEnterCriticalSection( &wer_cs );
+    if ((block = NtCurrentTeb()->Peb->WerRegistrationData))
+    {
+        /* the flags stay; the command line is cut */
+        block->restart_registered = FALSE;
+        block->restart_cmdline[0] = 0;
+    }
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+
+/***********************************************************************
+ *           GetApplicationRestartSettings   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ GetApplicationRestartSettings( HANDLE process, WCHAR *cmdline,
+                                                                      DWORD *size, DWORD *flags )
+{
+    struct wer_block copy, *block = &copy;
+    HRESULT hr = S_OK;
+    DWORD len;
+
+    TRACE( "%p, %p, %p, %p\n", process, cmdline, size, flags );
+
+    if (!size) return E_INVALIDARG;
+    if (is_current_process( process ))
+    {
+        RtlEnterCriticalSection( &wer_cs );
+        if ((block = NtCurrentTeb()->Peb->WerRegistrationData)) copy = *block;
+        else hr = HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+        RtlLeaveCriticalSection( &wer_cs );
+        block = &copy;
+    }
+    else hr = read_block( process, &copy );
+    if (FAILED(hr)) return hr;
+
+    if (!block->restart_registered)
+    {
+        *size = 0;
+        return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    }
+    block->restart_cmdline[RESTART_MAX_CMD_LINE - 1] = 0;
+    len = lstrlenW( block->restart_cmdline ) + 1;
+    /* with no buffer the size is all that is asked for */
+    if (cmdline)
+    {
+        if (*size >= len) memcpy( cmdline, block->restart_cmdline, len * sizeof(WCHAR) );
+        else
+        {
+            /* a buffer too small comes back empty */
+            if (*size) cmdline[0] = 0;
+            hr = HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+        }
+    }
+    *size = len;
+    if (flags && SUCCEEDED(hr)) *flags = block->restart_flags;
+    return hr;
+}
+
+
+/***********************************************************************
+ *           RegisterApplicationRecoveryCallback   (kernelbase.@)
+ */
+HRESULT WINAPI RegisterApplicationRecoveryCallback( APPLICATION_RECOVERY_CALLBACK callback, void *param,
+                                                    DWORD ping_interval, DWORD flags )
+{
+    struct wer_block *block;
+
+    TRACE( "%p, %p, %lu, %#lx\n", callback, param, ping_interval, flags );
+
+    if (!callback || ping_interval > RECOVERY_MAX_PING_INTERVAL) return E_INVALIDARG;
+    RtlEnterCriticalSection( &wer_cs );
+    if (!(block = get_block()))
+    {
+        RtlLeaveCriticalSection( &wer_cs );
+        return E_OUTOFMEMORY;
+    }
+    block->recovery.length = sizeof(block->recovery);
+    block->recovery.registered = TRUE;
+    block->recovery.callback = callback;
+    block->recovery.param = param;
+    block->recovery.ping_interval = ping_interval ? ping_interval : RECOVERY_DEFAULT_PING_INTERVAL;
+    block->recovery.flags = flags;
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+
+/***********************************************************************
+ *           UnregisterApplicationRecoveryCallback   (kernelbase.@)
+ */
+HRESULT WINAPI UnregisterApplicationRecoveryCallback(void)
+{
+    struct wer_block *block;
+
+    TRACE( "\n" );
+
+    RtlEnterCriticalSection( &wer_cs );
+    if ((block = NtCurrentTeb()->Peb->WerRegistrationData))
+    {
+        block->recovery.callback = NULL;
+        block->recovery.param = NULL;
+        block->recovery.ping_interval = 0;
+        block->recovery.flags = 0;
+    }
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+
+/***********************************************************************
+ *           GetApplicationRecoveryCallback   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ GetApplicationRecoveryCallback( HANDLE process,
+                                                                       APPLICATION_RECOVERY_CALLBACK *callback,
+                                                                       void **param, DWORD *ping_interval,
+                                                                       DWORD *flags )
+{
+    struct wer_block copy;
+    HRESULT hr = S_OK;
+
+    TRACE( "%p, %p, %p, %p, %p\n", process, callback, param, ping_interval, flags );
+
+    if (!callback || !param) return E_INVALIDARG;
+    if (is_current_process( process ))
+    {
+        RtlEnterCriticalSection( &wer_cs );
+        if (NtCurrentTeb()->Peb->WerRegistrationData)
+            copy = *(struct wer_block *)NtCurrentTeb()->Peb->WerRegistrationData;
+        else hr = HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+        RtlLeaveCriticalSection( &wer_cs );
+    }
+    else hr = read_block( process, &copy );
+    if (FAILED(hr)) return hr;
+
+    if (!copy.recovery.registered) return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    *callback = copy.recovery.callback;
+    *param = copy.recovery.param;
+    if (ping_interval) *ping_interval = copy.recovery.ping_interval;
+    if (flags) *flags = copy.recovery.flags;
+    return S_OK;
+}
+
+
+/* the recovery that runs when the process crashes; ApplicationRecoveryInProgress and ApplicationRecoveryFinished
+ * talk to it through the block's events */
+static BOOL in_recovery;
+
+/***********************************************************************
+ *           ApplicationRecoveryInProgress   (kernelbase.@)
+ */
+HRESULT WINAPI ApplicationRecoveryInProgress( BOOL *cancelled )
+{
+    struct wer_block *block = NtCurrentTeb()->Peb->WerRegistrationData;
+
+    TRACE( "%p\n", cancelled );
+
+    if (!cancelled) return E_INVALIDARG;
+    *cancelled = FALSE;
+    if (!in_recovery || !block || !block->recovery.in_progress) return E_FAIL;
+    SetEvent( block->recovery.in_progress );
+    return S_OK;
+}
+
+
+/***********************************************************************
+ *           ApplicationRecoveryFinished   (kernelbase.@)
+ */
+void WINAPI ApplicationRecoveryFinished( BOOL success )
+{
+    struct wer_block *block = NtCurrentTeb()->Peb->WerRegistrationData;
+
+    TRACE( "%d\n", success );
+
+    if (!in_recovery || !block || !block->recovery.finished) return;
+    block->recovery.successful = success;
+    SetEvent( block->recovery.finished );
+}
+
+static DWORD WINAPI recovery_thread( void *arg )
+{
+    struct wer_block *block = arg;
+
+    return block->recovery.callback( block->recovery.param );
+}
+
+/* the restart command line: the image path quoted and the registered arguments */
+static void restart_process( const struct wer_block *block )
+{
+    STARTUPINFOW si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR *cmdline, path[MAX_PATH];
+    DWORD len;
+
+    if (!(len = GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) )) || len == ARRAY_SIZE(path)) return;
+    if (!(cmdline = HeapAlloc( GetProcessHeap(), 0, (len + 4 + RESTART_MAX_CMD_LINE) * sizeof(WCHAR) ))) return;
+    cmdline[0] = '"';
+    memcpy( cmdline + 1, path, len * sizeof(WCHAR) );
+    cmdline[len + 1] = '"';
+    cmdline[len + 2] = ' ';
+    memcpy( cmdline + len + 3, block->restart_cmdline, (lstrlenW( block->restart_cmdline ) + 1) * sizeof(WCHAR) );
+    TRACE( "restarting %s\n", debugstr_w(cmdline) );
+    if (CreateProcessW( path, cmdline, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ))
+    {
+        CloseHandle( pi.hThread );
+        CloseHandle( pi.hProcess );
+    }
+    HeapFree( GetProcessHeap(), 0, cmdline );
+}
+
+/***********************************************************************
+ *           wer_handle_crash
+ *
+ * What Windows Error Reporting does for a process that crashed, before the debugger: run its recovery callback while
+ * it keeps telling it is in progress, and restart it if it asked to be and has run for a minute.
+ */
+void wer_handle_crash( EXCEPTION_POINTERS *epointers )
+{
+    struct wer_block *block = NtCurrentTeb()->Peb->WerRegistrationData;
+    KERNEL_USER_TIMES times;
+    LARGE_INTEGER now;
+
+    if (!block || in_recovery) return;
+    in_recovery = TRUE;
+
+    if (block->recovery.callback)
+    {
+        HANDLE thread, handles[3];
+        DWORD ret;
+
+        block->recovery.finished = CreateEventW( NULL, TRUE, FALSE, NULL );
+        block->recovery.in_progress = CreateEventW( NULL, FALSE, FALSE, NULL );
+        TRACE( "recovering through %p\n", block->recovery.callback );
+        if (block->recovery.finished && block->recovery.in_progress &&
+            (thread = CreateThread( NULL, 0, recovery_thread, block, 0, NULL )))
+        {
+            handles[0] = block->recovery.finished;
+            handles[1] = thread;
+            handles[2] = block->recovery.in_progress;
+            /* each call of ApplicationRecoveryInProgress buys another ping interval */
+            while ((ret = WaitForMultipleObjects( 3, handles, FALSE, block->recovery.ping_interval ))
+                   == WAIT_OBJECT_0 + 2);
+            TRACE( "recovery ended, %lu\n", ret );
+            CloseHandle( thread );
+        }
+    }
+
+    NtQuerySystemTime( &now );
+    if (block->restart_registered && !(block->restart_flags & RESTART_NO_CRASH) &&
+        !NtQueryInformationProcess( GetCurrentProcess(), ProcessTimes, &times, sizeof(times), NULL ) &&
+        now.QuadPart - times.CreateTime.QuadPart >= 60 * (LONGLONG)10000000)
+        restart_process( block );
+}
+
+
+/* Windows Error Reporting's registrations */
+
+static HRESULT add_gather( struct list *list, const WCHAR *file, DWORD type, DWORD flags, const void *block,
+                           DWORD size )
+{
+    struct wer_block *wer;
+    struct gather *gather;
+
+    RtlEnterCriticalSection( &wer_cs );
+    LIST_FOR_EACH_ENTRY( gather, list, struct gather, entry )
+    {
+        if (file ? (gather->file && !wcsicmp( gather->file, file )) : (!gather->file && gather->block == block))
+        {
+            /* registering again changes nothing but what it says */
+            gather->type = type;
+            gather->flags = flags;
+            gather->size = size;
+            RtlLeaveCriticalSection( &wer_cs );
+            return S_OK;
+        }
+    }
+    if (list_count( list ) >= WER_MAX_GATHERS)
+    {
+        RtlLeaveCriticalSection( &wer_cs );
+        return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+    }
+    if (!(wer = get_block()) || !(gather = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*gather) )))
+    {
+        RtlLeaveCriticalSection( &wer_cs );
+        return E_OUTOFMEMORY;
+    }
+    if (file && !(gather->file = heap_strdupW( file )))
+    {
+        HeapFree( GetProcessHeap(), 0, gather );
+        RtlLeaveCriticalSection( &wer_cs );
+        return E_OUTOFMEMORY;
+    }
+    gather->type = type;
+    gather->flags = flags;
+    gather->block = block;
+    gather->size = size;
+    list_add_tail( list, &gather->entry );
+    if (list == &gathers) wer->gather_count = list_count( list );
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+static HRESULT remove_gather( struct list *list, const WCHAR *file, const void *block )
+{
+    struct wer_block *wer = NtCurrentTeb()->Peb->WerRegistrationData;
+    struct gather *gather;
+
+    RtlEnterCriticalSection( &wer_cs );
+    LIST_FOR_EACH_ENTRY( gather, list, struct gather, entry )
+    {
+        if (file ? !(gather->file && !wcsicmp( gather->file, file )) : (gather->file || gather->block != block))
+            continue;
+        list_remove( &gather->entry );
+        if (wer && list == &gathers) wer->gather_count = list_count( list );
+        RtlLeaveCriticalSection( &wer_cs );
+        HeapFree( GetProcessHeap(), 0, gather->file );
+        HeapFree( GetProcessHeap(), 0, gather );
+        return S_OK;
+    }
+    RtlLeaveCriticalSection( &wer_cs );
+    return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+}
+
+
+/***********************************************************************
+ *         WerRegisterFile   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterFile( const WCHAR *file, WER_REGISTER_FILE_TYPE type,
+                                                        DWORD flags )
+{
+    TRACE( "(%s, %d, %#lx)\n", debugstr_w(file), type, flags );
+
+    if (!file || type <= 0 || type >= WerRegFileTypeMax) return E_INVALIDARG;
+    if (flags & ~(WER_FILE_DELETE_WHEN_DONE | WER_FILE_ANONYMOUS_DATA | WER_FILE_COMPRESSED)) return E_INVALIDARG;
+    if (lstrlenW( file ) >= MAX_PATH) return HRESULT_FROM_WIN32( ERROR_FILENAME_EXCED_RANGE );
+    return add_gather( &gathers, file, type, flags, NULL, 0 );
+}
+
+
+/***********************************************************************
+ *         WerUnregisterFile   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterFile( const WCHAR *file )
+{
+    TRACE( "(%s)\n", debugstr_w(file) );
+
+    if (!file) return E_INVALIDARG;
+    return remove_gather( &gathers, file, NULL );
+}
+
+
+/***********************************************************************
+ *         WerRegisterMemoryBlock   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterMemoryBlock( void *block, DWORD size )
+{
+    TRACE( "(%p %lu)\n", block, size );
+
+    if (!block || !size || size > WER_MAX_MEM_BLOCK_SIZE) return E_INVALIDARG;
+    return add_gather( &gathers, NULL, 0, 0, block, size );
+}
+
+
+/***********************************************************************
+ *         WerUnregisterMemoryBlock   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterMemoryBlock( void *block )
+{
+    TRACE( "(%p)\n", block );
+
+    if (!block) return E_INVALIDARG;
+    return remove_gather( &gathers, NULL, block );
+}
+
+
+/***********************************************************************
+ *         WerRegisterExcludedMemoryBlock   (kernelbase.@)
+ */
+HRESULT WINAPI WerRegisterExcludedMemoryBlock( const void *block, DWORD size )
+{
+    TRACE( "(%p %lu)\n", block, size );
+
+    if (!block || !size) return E_INVALIDARG;
+    return add_gather( &excluded, NULL, 0, 0, block, size );
+}
+
+
+/***********************************************************************
+ *         WerUnregisterExcludedMemoryBlock   (kernelbase.@)
+ */
+HRESULT WINAPI WerUnregisterExcludedMemoryBlock( const void *block )
+{
+    TRACE( "(%p)\n", block );
+
+    if (!block) return E_INVALIDARG;
+    return remove_gather( &excluded, NULL, block );
+}
+
+
+/* a key starts with a letter and goes on with letters, digits, dots, underscores and dashes, all ASCII */
+static BOOL is_valid_metadata_key( const WCHAR *key )
+{
+    const WCHAR *p;
+
+    if (!((key[0] >= 'A' && key[0] <= 'Z') || (key[0] >= 'a' && key[0] <= 'z'))) return FALSE;
+    for (p = key; *p; p++)
+        if (!((*p >= 'A' && *p <= 'Z') || (*p >= 'a' && *p <= 'z') || (*p >= '0' && *p <= '9') ||
+              *p == '.' || *p == '_' || *p == '-'))
+            return FALSE;
+    return p - key <= WER_MAX_METADATA_KEY;
+}
+
+/***********************************************************************
+ *         WerRegisterCustomMetadata  (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterCustomMetadata( const WCHAR *key, const WCHAR *value )
+{
+    struct metadata *entry;
+    struct wer_block *wer;
+    WCHAR *copy;
+
+    TRACE( "(%s, %s)\n", debugstr_w(key), debugstr_w(value) );
+
+    if (!key || !value || !is_valid_metadata_key( key ) || lstrlenW( value ) >= WER_MAX_METADATA_VALUE)
+        return E_INVALIDARG;
+    if (!(copy = heap_strdupW( value ))) return E_OUTOFMEMORY;
+
+    RtlEnterCriticalSection( &wer_cs );
+    LIST_FOR_EACH_ENTRY( entry, &metadata_list, struct metadata, entry )
+    {
+        if (wcscmp( entry->key, key )) continue;
+        HeapFree( GetProcessHeap(), 0, entry->value );
+        entry->value = copy;
+        RtlLeaveCriticalSection( &wer_cs );
+        return S_OK;
+    }
+    if (list_count( &metadata_list ) >= WER_MAX_METADATA)
+    {
+        RtlLeaveCriticalSection( &wer_cs );
+        HeapFree( GetProcessHeap(), 0, copy );
+        return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+    }
+    if (!(wer = get_block()) || !(entry = HeapAlloc( GetProcessHeap(), 0, sizeof(*entry) )))
+    {
+        RtlLeaveCriticalSection( &wer_cs );
+        HeapFree( GetProcessHeap(), 0, copy );
+        return E_OUTOFMEMORY;
+    }
+    if (!(entry->key = heap_strdupW( key )))
+    {
+        HeapFree( GetProcessHeap(), 0, entry );
+        RtlLeaveCriticalSection( &wer_cs );
+        HeapFree( GetProcessHeap(), 0, copy );
+        return E_OUTOFMEMORY;
+    }
+    entry->value = copy;
+    list_add_tail( &metadata_list, &entry->entry );
+    wer->metadata_count = list_count( &metadata_list );
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+
+/***********************************************************************
+ *         WerUnregisterCustomMetadata  (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterCustomMetadata( const WCHAR *key )
+{
+    struct wer_block *wer = NtCurrentTeb()->Peb->WerRegistrationData;
+    struct metadata *entry;
+
+    TRACE( "(%s)\n", debugstr_w(key) );
+
+    if (!key) return E_INVALIDARG;
+    RtlEnterCriticalSection( &wer_cs );
+    LIST_FOR_EACH_ENTRY( entry, &metadata_list, struct metadata, entry )
+    {
+        if (wcscmp( entry->key, key )) continue;
+        list_remove( &entry->entry );
+        if (wer) wer->metadata_count = list_count( &metadata_list );
+        RtlLeaveCriticalSection( &wer_cs );
+        HeapFree( GetProcessHeap(), 0, entry->key );
+        HeapFree( GetProcessHeap(), 0, entry->value );
+        HeapFree( GetProcessHeap(), 0, entry );
+        return S_OK;
+    }
+    RtlLeaveCriticalSection( &wer_cs );
+    return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+}
+
+
+/***********************************************************************
+ *         WerRegisterRuntimeExceptionModule   (kernelbase.@)
+ *
+ * The module's out of process callbacks are for Windows Error Reporting's own process, which Wine does not have;
+ * the registration is kept.
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerRegisterRuntimeExceptionModule( const WCHAR *dll, void *context )
+{
+    struct runtime_dll *entry;
+
+    TRACE( "(%s, %p)\n", debugstr_w(dll), context );
+
+    if (!dll) return E_INVALIDARG;
+    if (lstrlenW( dll ) >= MAX_PATH) return HRESULT_FROM_WIN32( ERROR_FILENAME_EXCED_RANGE );
+    RtlEnterCriticalSection( &wer_cs );
+    LIST_FOR_EACH_ENTRY( entry, &runtime_dlls, struct runtime_dll, entry )
+    {
+        if (entry->context == context && !wcsicmp( entry->path, dll ))
+        {
+            RtlLeaveCriticalSection( &wer_cs );
+            return S_OK;
+        }
+    }
+    if (list_count( &runtime_dlls ) >= WER_MAX_RUNTIME_DLLS)
+    {
+        RtlLeaveCriticalSection( &wer_cs );
+        return HRESULT_FROM_WIN32( ERROR_INSUFFICIENT_BUFFER );
+    }
+    if (!get_block() || !(entry = HeapAlloc( GetProcessHeap(), 0, sizeof(*entry) )))
+    {
+        RtlLeaveCriticalSection( &wer_cs );
+        return E_OUTOFMEMORY;
+    }
+    if (!(entry->path = heap_strdupW( dll )))
+    {
+        HeapFree( GetProcessHeap(), 0, entry );
+        RtlLeaveCriticalSection( &wer_cs );
+        return E_OUTOFMEMORY;
+    }
+    entry->context = context;
+    list_add_tail( &runtime_dlls, &entry->entry );
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+
+/***********************************************************************
+ *         WerUnregisterRuntimeExceptionModule   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerUnregisterRuntimeExceptionModule( const WCHAR *dll, void *context )
+{
+    struct runtime_dll *entry;
+
+    TRACE( "(%s, %p)\n", debugstr_w(dll), context );
+
+    if (!dll) return E_INVALIDARG;
+    RtlEnterCriticalSection( &wer_cs );
+    LIST_FOR_EACH_ENTRY( entry, &runtime_dlls, struct runtime_dll, entry )
+    {
+        if (entry->context != context || wcsicmp( entry->path, dll )) continue;
+        list_remove( &entry->entry );
+        RtlLeaveCriticalSection( &wer_cs );
+        HeapFree( GetProcessHeap(), 0, entry->path );
+        HeapFree( GetProcessHeap(), 0, entry );
+        return S_OK;
+    }
+    RtlLeaveCriticalSection( &wer_cs );
+    return HRESULT_FROM_WIN32( ERROR_FILE_NOT_FOUND );
+}
+
+
+/***********************************************************************
+ *         WerSetFlags   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerSetFlags( DWORD flags )
+{
+    struct wer_block *block;
+
+    TRACE( "(%#lx)\n", flags );
+
+    RtlEnterCriticalSection( &wer_cs );
+    if ((block = get_block())) block->flags = flags;
+    RtlLeaveCriticalSection( &wer_cs );
+    return block ? S_OK : E_OUTOFMEMORY;
+}
+
+
+/***********************************************************************
+ *         WerGetFlags   (kernelbase.@)
+ */
+HRESULT WINAPI /* DECLSPEC_HOTPATCH */ WerGetFlags( HANDLE process, DWORD *flags )
+{
+    struct wer_block copy;
+    HRESULT hr;
+
+    TRACE( "(%p, %p)\n", process, flags );
+
+    if (!process || !flags) return E_INVALIDARG;
+    if (is_current_process( process ))
+    {
+        RtlEnterCriticalSection( &wer_cs );
+        *flags = NtCurrentTeb()->Peb->WerRegistrationData ?
+                 ((struct wer_block *)NtCurrentTeb()->Peb->WerRegistrationData)->flags : 0;
+        RtlLeaveCriticalSection( &wer_cs );
+        return S_OK;
+    }
+    if ((hr = read_block( process, &copy )) == HRESULT_FROM_WIN32( ERROR_NOT_FOUND ))
+    {
+        *flags = 0;
+        return S_OK;
+    }
+    if (SUCCEEDED(hr)) *flags = copy.flags;
+    return hr;
+}
+
+
+/***********************************************************************
+ *         WerRegisterAppLocalDump   (kernelbase.@)
+ */
+HRESULT WINAPI WerRegisterAppLocalDump( const WCHAR *path )
+{
+    WCHAR *copy;
+
+    TRACE( "(%s)\n", debugstr_w(path) );
+
+    if (!path || lstrlenW( path ) >= MAX_PATH) return E_INVALIDARG;
+    if (!(copy = heap_strdupW( path ))) return E_OUTOFMEMORY;
+    RtlEnterCriticalSection( &wer_cs );
+    HeapFree( GetProcessHeap(), 0, app_local_dump );
+    app_local_dump = copy;
+    RtlLeaveCriticalSection( &wer_cs );
+    return S_OK;
+}
+
+
+/***********************************************************************
+ *         WerUnregisterAppLocalDump   (kernelbase.@)
+ */
+HRESULT WINAPI WerUnregisterAppLocalDump(void)
+{
+    HRESULT hr = S_OK;
+
+    TRACE( "\n" );
+
+    RtlEnterCriticalSection( &wer_cs );
+    if (app_local_dump)
+    {
+        HeapFree( GetProcessHeap(), 0, app_local_dump );
+        app_local_dump = NULL;
+    }
+    else hr = HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
+    RtlLeaveCriticalSection( &wer_cs );
+    return hr;
+}
