+/* another process's settings are read from its memory */
+static void test_other_process( const char *selfname )
+{
+    STARTUPINFOA si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    char cmdline[MAX_PATH + 64];
+    HANDLE ready, done, process;
+    WCHAR buffer[64];
+    DWORD size, flags;
+    HRESULT hr;
+
+    ready = CreateEventA( NULL, TRUE, FALSE, "wer_test_ready" );
+    done = CreateEventA( NULL, TRUE, FALSE, "wer_test_done" );
+    sprintf( cmdline, "\"%s\" wer child", selfname );
+    ok( CreateProcessA( NULL, cmdline, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi ), "CreateProcess failed\n" );
+    ok( !WaitForSingleObject( ready, 10000 ), "the child did not get ready\n" );
+
+    process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_VM_READ, FALSE, pi.dwProcessId );
+    size = ARRAY_SIZE(buffer);
+    flags = 0xdeadbeef;
+    hr = GetApplicationRestartSettings( process, buffer, &size, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( buffer, L"/child-line" ), "got %s\n", wine_dbgstr_w(buffer) );
+    ok( flags == RESTART_NO_PATCH, "got %#lx\n", flags );
+    if (pGetApplicationRecoveryCallback)
+    {
+        APPLICATION_RECOVERY_CALLBACK callback = NULL;
+        void *param = NULL;
+        DWORD ping = 0;
+
+        hr = pGetApplicationRecoveryCallback( process, &callback, &param, &ping, &flags );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( callback == recovery_callback, "got %p\n", callback );
+        ok( param == (void *)0x777, "got %p\n", param );
+        ok( ping == 2000, "got %lu\n", ping );
+    }
+    hr = WerGetFlags( process, &flags );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( flags == WER_FAULT_REPORTING_FLAG_QUEUE, "got %#lx\n", flags );
+    CloseHandle( process );
+
+    /* reading needs more than a query */
+    process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pi.dwProcessId );
+    size = ARRAY_SIZE(buffer);
+    hr = GetApplicationRestartSettings( process, buffer, &size, &flags );
+    ok( hr == E_ACCESSDENIED, "got %#lx\n", hr );
+    CloseHandle( process );
+    process = OpenProcess( PROCESS_VM_READ, FALSE, pi.dwProcessId );
+    size = ARRAY_SIZE(buffer);
+    hr = GetApplicationRestartSettings( process, buffer, &size, &flags );
+    ok( hr == HRESULT_FROM_WIN32(ERROR_INVALID_HANDLE), "got %#lx\n", hr );
+    CloseHandle( process );
+
+    SetEvent( done );
+    wait_child_process( &pi );
+    CloseHandle( pi.hProcess );
+    CloseHandle( pi.hThread );
+    CloseHandle( ready );
+    CloseHandle( done );
+}
+
+static void child(void)
+{
+    HANDLE ready = OpenEventA( EVENT_MODIFY_STATE, FALSE, "wer_test_ready" );
+    HANDLE done = OpenEventA( SYNCHRONIZE, FALSE, "wer_test_done" );
+
+    RegisterApplicationRestart( L"/child-line", RESTART_NO_PATCH );
+    RegisterApplicationRecoveryCallback( recovery_callback, (void *)0x777, 2000, 0 );
+    WerSetFlags( WER_FAULT_REPORTING_FLAG_QUEUE );
+    SetEvent( ready );
+    WaitForSingleObject( done, 30000 );
+}
+
+START_TEST(wer)
+{
+    HMODULE kernel32 = GetModuleHandleA( "kernel32.dll" );
+    char selfname[MAX_PATH], **argv;
+    int argc;
+
+    pGetApplicationRecoveryCallback = (void *)GetProcAddress( kernel32, "GetApplicationRecoveryCallback" );
+    pUnregisterApplicationRecoveryCallback = (void *)GetProcAddress( kernel32, "UnregisterApplicationRecoveryCallback" );
+
+    argc = winetest_get_mainargs( &argv );
+    if (argc >= 3 && !strcmp( argv[2], "child" ))
+    {
+        child();
+        return;
+    }
+    GetModuleFileNameA( NULL, selfname, sizeof(selfname) );
+
+    test_restart();
+    test_recovery();
+    test_wer_registrations();
+    test_other_process( selfname );
+}
