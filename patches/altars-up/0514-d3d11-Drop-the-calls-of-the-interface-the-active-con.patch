@@ -64,6 +64,19 @@ static inline BOOL d3d_device_is_d3d10_active(struct d3d_device *device)
                 || IsEqualGUID(&device->state->emulated_interface, &IID_ID3D10Device1);
 }
 
+/* While a state emulating ID3D10Device is active, the immediate context drops what it is asked to set, draw, copy
+ * or clear, and what it is asked for is what an empty state has; maps and queries still work.  It is the other way
+ * round for ID3D10Device with a D3D11 state. */
+static BOOL d3d11_device_context_dropped(struct d3d11_device_context *context)
+{
+    return context->type == D3D11_DEVICE_CONTEXT_IMMEDIATE && d3d_device_is_d3d10_active(context->device);
+}
+
+static BOOL d3d10_device_dropped(struct d3d_device *device)
+{
+    return !d3d_device_is_d3d10_active(device);
+}
