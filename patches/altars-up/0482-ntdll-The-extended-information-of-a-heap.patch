From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:01 -0400
Subject: [PATCH] ntdll: The extended information of a heap.

RtlQueryHeapInformation class 2 (HeapExtendedInformation) gives a heap
of this process its address, compatibility mode and reserved and
committed sizes at level 1, as Windows 11 does; other classes are
refused with a WARN instead of a FIXME (tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/heap.c b/dlls/ntdll/heap.c
index ee89b5a2981..294070976dc 100644
--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -2564,6 +2564,68 @@ static LONG terminate_on_corruption = TRUE;
 static LONG terminate_on_corruption;
 #endif
 
+/* HeapExtendedInformation (2): what to ask of which heap of which process, then what a heap is */
+struct heap_extended_information
+{
+    HANDLE    process;
+    ULONG_PTR heap;
+    ULONG     level;
+    void     *callback;
+    void     *context;
+    struct
+    {
+        ULONG64 address;
+        ULONG   mode;
+        ULONG64 reserve_size;
+        ULONG64 commit_size;
+        ULONG64 first_region;
+        ULONG64 version;
+    } info;
+};
+
+static NTSTATUS query_extended_information( struct heap_extended_information *ext, SIZE_T size_in,
+                                            SIZE_T *size_out )
+{
+    struct heap *heap;
+    SUBHEAP *subheap;
+    ULONG flags;
+
+    if (!ext || size_in < sizeof(*ext)) return STATUS_INVALID_PARAMETER;
+    /* the process's own heaps only */
+    if (ext->process != NtCurrentProcess() &&
+        (!ext->process || HandleToULong( ext->process ) != HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess )))
+    {
+        PROCESS_BASIC_INFORMATION pbi;
+
+        if (!ext->process || NtQueryInformationProcess( ext->process, ProcessBasicInformation, &pbi, sizeof(pbi), NULL ))
+            return STATUS_INVALID_HANDLE;
+        if (pbi.UniqueProcessId != HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess ))
+        {
+            FIXME( "heaps of another process are not supported\n" );
+            return STATUS_NOT_SUPPORTED;
+        }
+    }
+    if (ext->level != 1)
+    {
+        FIXME( "level %lu not supported\n", ext->level );
+        return STATUS_INVALID_PARAMETER;
+    }
+    if (!(heap = unsafe_heap_from_handle( (HANDLE)ext->heap, 0, &flags ))) return STATUS_INVALID_PARAMETER;
+
+    memset( &ext->info, 0, sizeof(ext->info) );
+    ext->info.address = (ULONG_PTR)heap;
+    ext->info.mode = heap->compat_info;
+    heap_lock( heap, flags );
+    LIST_FOR_EACH_ENTRY( subheap, &heap->subheap_list, SUBHEAP, entry )
+    {
+        ext->info.reserve_size += subheap_size( subheap );
+        ext->info.commit_size += (char *)subheap_commit_end( subheap ) - (char *)subheap_base( subheap );
+    }
+    heap_unlock( heap, flags );
+    if (size_out) *size_out = sizeof(*ext);
+    return STATUS_SUCCESS;
+}
+
 NTSTATUS WINAPI RtlQueryHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS info_class,
                                          void *info, SIZE_T size_in, SIZE_T *size_out )
 {
@@ -2572,7 +2634,7 @@ NTSTATUS WINAPI RtlQueryHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS i
 
     TRACE( "handle %p, info_class %u, info %p, size_in %Iu, size_out %p.\n", handle, info_class, info, size_in, size_out );
 
-    switch (info_class)
+    switch ((ULONG)info_class)
     {
     case HeapCompatibilityInformation:
         if (!(heap = unsafe_heap_from_handle( handle, 0, &flags ))) return STATUS_ACCESS_VIOLATION;
@@ -2587,9 +2649,13 @@ NTSTATUS WINAPI RtlQueryHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS i
         *(ULONG *)info = ReadNoFence( &terminate_on_corruption );
         return STATUS_SUCCESS;
 
+    case 2: /* HeapExtendedInformation */
+        return query_extended_information( info, size_in, size_out );
+
     default:
-        FIXME( "HEAP_INFORMATION_CLASS %u not implemented!\n", info_class );
-        return STATUS_INVALID_INFO_CLASS;
+        /* the others, HeapOptimizeResources among them, are only set */
+        WARN( "HEAP_INFORMATION_CLASS %u cannot be queried\n", info_class );
+        return STATUS_INVALID_PARAMETER;
     }
 }
 
