+    MEMORY_STREAM_CLONE,    /* what CloneStream() makes: RandomAccessStreamOverStream */
+    MEMORY_STREAM_INPUT,    /* GetInputStreamAt(): InputStreamOverStream */
+    MEMORY_STREAM_OUTPUT,   /* GetOutputStreamAt(): OutputStreamOverStream */
+};
