+#define check_runtime_class( a, b ) check_runtime_class_( __LINE__, (IUnknown *)a, b )
+static void check_runtime_class_( int line, IUnknown *obj, const WCHAR *expect )
+{
+    IInspectable *inspectable;
+    HSTRING name = NULL;
+    HRESULT hr;
+
+    hr = IUnknown_QueryInterface( obj, &IID_IInspectable, (void **)&inspectable );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IInspectable_GetRuntimeClassName( inspectable, &name );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    ok_(__FILE__, line)( !wcscmp( WindowsGetStringRawBuffer( name, NULL ), expect ), "got class %s.\n",
+                         debugstr_w( WindowsGetStringRawBuffer( name, NULL ) ) );
+    WindowsDeleteString( name );
+    IInspectable_Release( inspectable );
+}
