+/* The identity of each kind: the random access streams answer for all four
+ * interfaces, an input or output stream only for its own and IClosable. */
+static IInspectable *memory_stream_identity( struct memory_stream *impl )
+{
+    switch (impl->kind)
+    {
+    case MEMORY_STREAM_INPUT: return (IInspectable *)&impl->IInputStream_iface;
+    case MEMORY_STREAM_OUTPUT: return (IInspectable *)&impl->IOutputStream_iface;
+    default: return (IInspectable *)&impl->IRandomAccessStream_iface;
+    }
+}
