-    else if (IsEqualGUID( iid, &IID_IInputStream ))
+    else if (IsEqualGUID( iid, &IID_IRandomAccessStream ) && random_access)
+    {
+        *out = &impl->IRandomAccessStream_iface;
+    }
+    else if (IsEqualGUID( iid, &IID_IInputStream ) && impl->kind != MEMORY_STREAM_OUTPUT)
     {
