     size_t pos;
     BOOL closed;
 };
 
+static HRESULT memory_stream_create_kind( struct memory_data *data, enum memory_stream_kind kind, size_t pos,
+                                          struct memory_stream **out );
+
+static void memory_data_release( struct memory_data *data )
+{
+    if (InterlockedDecrement( &data->ref )) return;
+    free( data->buffer );
+    free( data );
