+++ b/dlls/windows.management.deployment/addpackageoptions.c
@@ -0,0 +1,348 @@
+/* WinRT Windows.Management.Deployment.AddPackageOptions implementation
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(deployment);
+
+/*
+ * AddPackageOptions is a bag of settings handed to PackageManager: every
+ * member is a value a caller sets and reads back, and nothing about it depends
+ * on a package ever being installed.  So the flags and the stub-package choice
+ * are implemented outright and round-trip.
+ *
+ * The collection members hand back the vectors of Uri and of family name that
+ * a caller fills in.  Those are IVector<T> over types from namespaces that are
+ * not here, and building a private vector of them here would only be a second
+ * one to get wrong, so they say which type is missing.  A caller that only
+ * sets flags -- which is what asking for this class usually means -- gets an
+ * object that works.
+ */
+
+struct add_package_options
+{
+    IAddPackageOptions IAddPackageOptions_iface;
+    LONG ref;
+
+    StubPackageOption stub_option;
+    boolean developer_mode;
+    boolean force_app_shutdown;
+    boolean force_target_app_shutdown;
+    boolean force_update_from_any_version;
+    boolean install_all_resources;
+    boolean required_content_group_only;
+    boolean retain_files_on_failure;
+    boolean stage_in_place;
+    boolean allow_unsigned;
+    boolean defer_registration;
+    IInspectable *target_volume;
+    IInspectable *external_location;
+};
+
+static inline struct add_package_options *impl_from_IAddPackageOptions( IAddPackageOptions *iface )
+{
+    return CONTAINING_RECORD( iface, struct add_package_options, IAddPackageOptions_iface );
+}
+
+static HRESULT WINAPI options_QueryInterface( IAddPackageOptions *iface, REFIID iid, void **out )
+{
+    struct add_package_options *impl = impl_from_IAddPackageOptions( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAddPackageOptions ))
+    {
+        *out = &impl->IAddPackageOptions_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI options_AddRef( IAddPackageOptions *iface )
+{
+    return InterlockedIncrement( &impl_from_IAddPackageOptions( iface )->ref );
+}
+
+static ULONG WINAPI options_Release( IAddPackageOptions *iface )
+{
+    struct add_package_options *impl = impl_from_IAddPackageOptions( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        if (impl->target_volume) IInspectable_Release( impl->target_volume );
+        if (impl->external_location) IInspectable_Release( impl->external_location );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI options_GetIids( IAddPackageOptions *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI options_GetRuntimeClassName( IAddPackageOptions *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Management_Deployment_AddPackageOptions,
+                                ARRAY_SIZE(RuntimeClass_Windows_Management_Deployment_AddPackageOptions) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI options_GetTrustLevel( IAddPackageOptions *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+#define OPTIONS_VECTOR( name, element )                                                            \
+    static HRESULT WINAPI options_get_##name( IAddPackageOptions *iface, IInspectable **value )    \
+    {                                                                                              \
+        FIXME( "iface %p, value %p: needs an IVector<" element ">.\n", iface, value );              \
+        if (value) *value = NULL;                                                                  \
+        return E_NOTIMPL;                                                                          \
+    }
+
+OPTIONS_VECTOR( DependencyPackageUris, "Windows.Foundation.Uri *" )
+OPTIONS_VECTOR( OptionalPackageFamilyNames, "HSTRING" )
+OPTIONS_VECTOR( OptionalPackageUris, "Windows.Foundation.Uri *" )
+OPTIONS_VECTOR( RelatedPackageUris, "Windows.Foundation.Uri *" )
+
+#define OPTIONS_OBJECT( name, field )                                                              \
+    static HRESULT WINAPI options_get_##name( IAddPackageOptions *iface, IInspectable **value )    \
+    {                                                                                              \
+        struct add_package_options *impl = impl_from_IAddPackageOptions( iface );                  \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        if ((*value = impl->field)) IInspectable_AddRef( *value );                                 \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI options_put_##name( IAddPackageOptions *iface, IInspectable *value )     \
+    {                                                                                              \
+        struct add_package_options *impl = impl_from_IAddPackageOptions( iface );                  \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (value) IInspectable_AddRef( value );                                                   \
+        if (impl->field) IInspectable_Release( impl->field );                                      \
+        impl->field = value;                                                                       \
+        return S_OK;                                                                               \
+    }
+
+OPTIONS_OBJECT( TargetVolume, target_volume )
+OPTIONS_OBJECT( ExternalLocationUri, external_location )
+
+static HRESULT WINAPI options_get_StubPackageOption( IAddPackageOptions *iface, StubPackageOption *value )
+{
+    struct add_package_options *impl = impl_from_IAddPackageOptions( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->stub_option;
+    return S_OK;
+}
+
+static HRESULT WINAPI options_put_StubPackageOption( IAddPackageOptions *iface, StubPackageOption value )
+{
+    struct add_package_options *impl = impl_from_IAddPackageOptions( iface );
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+
+    if (value < StubPackageOption_Default || value > StubPackageOption_UsePreference) return E_INVALIDARG;
+    impl->stub_option = value;
+    return S_OK;
+}
+
+#define OPTIONS_FLAG( name, field )                                                                \
+    static HRESULT WINAPI options_get_##name( IAddPackageOptions *iface, boolean *value )          \
+    {                                                                                              \
+        struct add_package_options *impl = impl_from_IAddPackageOptions( iface );                  \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        *value = impl->field;                                                                      \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI options_put_##name( IAddPackageOptions *iface, boolean value )           \
+    {                                                                                              \
+        struct add_package_options *impl = impl_from_IAddPackageOptions( iface );                  \
+        TRACE( "iface %p, value %d.\n", iface, value );                                            \
+        impl->field = value;                                                                       \
+        return S_OK;                                                                               \
+    }
+
+OPTIONS_FLAG( DeveloperMode, developer_mode )
+OPTIONS_FLAG( ForceAppShutdown, force_app_shutdown )
+OPTIONS_FLAG( ForceTargetAppShutdown, force_target_app_shutdown )
+OPTIONS_FLAG( ForceUpdateFromAnyVersion, force_update_from_any_version )
+OPTIONS_FLAG( InstallAllResources, install_all_resources )
+OPTIONS_FLAG( RequiredContentGroupOnly, required_content_group_only )
+OPTIONS_FLAG( RetainFilesOnFailure, retain_files_on_failure )
+OPTIONS_FLAG( StageInPlace, stage_in_place )
+OPTIONS_FLAG( AllowUnsigned, allow_unsigned )
+OPTIONS_FLAG( DeferRegistrationWhenPackagesAreInUse, defer_registration )
+
+static const struct IAddPackageOptionsVtbl options_vtbl =
+{
+    options_QueryInterface,
+    options_AddRef,
+    options_Release,
+    /* IInspectable methods */
+    options_GetIids,
+    options_GetRuntimeClassName,
+    options_GetTrustLevel,
+    /* IAddPackageOptions methods */
+    options_get_DependencyPackageUris,
+    options_get_TargetVolume,
+    options_put_TargetVolume,
+    options_get_OptionalPackageFamilyNames,
+    options_get_OptionalPackageUris,
+    options_get_RelatedPackageUris,
+    options_get_ExternalLocationUri,
+    options_put_ExternalLocationUri,
+    options_get_StubPackageOption,
+    options_put_StubPackageOption,
+    options_get_DeveloperMode,
+    options_put_DeveloperMode,
+    options_get_ForceAppShutdown,
+    options_put_ForceAppShutdown,
+    options_get_ForceTargetAppShutdown,
+    options_put_ForceTargetAppShutdown,
+    options_get_ForceUpdateFromAnyVersion,
+    options_put_ForceUpdateFromAnyVersion,
+    options_get_InstallAllResources,
+    options_put_InstallAllResources,
+    options_get_RequiredContentGroupOnly,
+    options_put_RequiredContentGroupOnly,
+    options_get_RetainFilesOnFailure,
+    options_put_RetainFilesOnFailure,
+    options_get_StageInPlace,
+    options_put_StageInPlace,
+    options_get_AllowUnsigned,
+    options_put_AllowUnsigned,
+    options_get_DeferRegistrationWhenPackagesAreInUse,
+    options_put_DeferRegistrationWhenPackagesAreInUse,
+};
+
+struct options_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    LONG ref;
+};
+
+static inline struct options_statics *statics_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct options_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct options_statics *impl = statics_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &statics_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &statics_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct add_package_options *impl;
+
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IAddPackageOptions_iface.lpVtbl = &options_vtbl;
+    impl->ref = 1;
+    impl->stub_option = StubPackageOption_Default;
+
+    *instance = (IInspectable *)&impl->IAddPackageOptions_iface;
+    return S_OK;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+static struct options_statics options_statics =
+{
+    {&factory_vtbl},
+    1,
+};
+
+IActivationFactory *add_package_options_factory = &options_statics.IActivationFactory_iface;
