+/* Every access question has the same answer while no policy is in force.  The
+ * operation is created already complete, so a caller that awaits it is not
+ * left waiting on a policy engine that does not exist. */
+static HRESULT allowed_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result )
+{
+    result->vt = VT_I4;
+    result->lVal = ProtectionPolicyEvaluationResult_Allowed;
+    return S_OK;
+}
+
+static HRESULT create_allowed_operation( struct policy_statics *impl,
+        IAsyncOperation_ProtectionPolicyEvaluationResult **operation )
+{
+    IAsyncOperation_IInspectable *inner;
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+
+    hr = async_operation_inspectable_create( &IID_IAsyncOperation_ProtectionPolicyEvaluationResult,
+                                             (IUnknown *)&impl->IActivationFactory_iface, NULL,
+                                             allowed_async, &inner );
+    if (FAILED(hr)) return hr;
+    *operation = (IAsyncOperation_ProtectionPolicyEvaluationResult *)inner;
+    return S_OK;
+}
