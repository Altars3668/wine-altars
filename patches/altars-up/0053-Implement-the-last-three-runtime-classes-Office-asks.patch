diff --git a/dlls/windows.applicationmodel.useractivities/useractivities.c b/dlls/windows.applicationmodel.useractivities/useractivities.c
new file mode 100644
index 00000000000..1cb5f3b7707
--- /dev/null
+++ b/dlls/windows.applicationmodel.useractivities/useractivities.c
@@ -0,0 +1,272 @@
+/* WinRT Windows.ApplicationModel.UserActivities.UserActivityRequestManager implementation
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(useractivities);
+
+/*
+ * UserActivityRequestManager is how an application offers to describe what the
+ * user is doing so the shell can put it in Timeline.  Nothing on this system
+ * asks: there is no Timeline and no broker to raise the request.  So the
+ * manager exists, a handler can be registered and handed back a token it can
+ * unregister with, and the event never fires -- which is exactly what happens
+ * on a Windows machine where the feature is turned off.
+ *
+ * Existing matters on its own here.  An application asks for this class to
+ * find out whether the feature is available at all, and the answer to that
+ * question is not an activation failure.
+ */
+
+struct request_manager
+{
+    IUserActivityRequestManager IUserActivityRequestManager_iface;
+    LONG ref;
+    LONG64 next_token;
+};
+
+static inline struct request_manager *impl_from_IUserActivityRequestManager(
+        IUserActivityRequestManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct request_manager, IUserActivityRequestManager_iface );
+}
+
+static HRESULT WINAPI manager_QueryInterface( IUserActivityRequestManager *iface, REFIID iid, void **out )
+{
+    struct request_manager *impl = impl_from_IUserActivityRequestManager( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IUserActivityRequestManager ))
+    {
+        *out = &impl->IUserActivityRequestManager_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI manager_AddRef( IUserActivityRequestManager *iface )
+{
+    return InterlockedIncrement( &impl_from_IUserActivityRequestManager( iface )->ref );
+}
+
+static ULONG WINAPI manager_Release( IUserActivityRequestManager *iface )
+{
+    struct request_manager *impl = impl_from_IUserActivityRequestManager( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI manager_GetIids( IUserActivityRequestManager *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI manager_GetRuntimeClassName( IUserActivityRequestManager *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_ApplicationModel_UserActivities_UserActivityRequestManager,
+                                ARRAY_SIZE(RuntimeClass_Windows_ApplicationModel_UserActivities_UserActivityRequestManager) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI manager_GetTrustLevel( IUserActivityRequestManager *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI manager_add_UserActivityRequested( IUserActivityRequestManager *iface,
+        IInspectable *handler, EventRegistrationToken *token )
+{
+    struct request_manager *impl = impl_from_IUserActivityRequestManager( iface );
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!token) return E_POINTER;
+    if (!handler) return E_INVALIDARG;
+    /* Nothing on this system raises the request, so the handler is remembered
+     * only far enough to give back a token it can unregister with. */
+    token->value = InterlockedIncrement64( &impl->next_token );
+    return S_OK;
+}
+
+static HRESULT WINAPI manager_remove_UserActivityRequested( IUserActivityRequestManager *iface,
+                                                            EventRegistrationToken token )
+{
+    TRACE( "iface %p, token %I64d.\n", iface, token.value );
+    return S_OK;
+}
+
+static const struct IUserActivityRequestManagerVtbl manager_vtbl =
+{
+    manager_QueryInterface,
+    manager_AddRef,
+    manager_Release,
+    /* IInspectable methods */
+    manager_GetIids,
+    manager_GetRuntimeClassName,
+    manager_GetTrustLevel,
+    /* IUserActivityRequestManager methods */
+    manager_add_UserActivityRequested,
+    manager_remove_UserActivityRequested,
+};
+
+struct manager_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IUserActivityRequestManagerStatics IUserActivityRequestManagerStatics_iface;
+    LONG ref;
+};
+
+static inline struct manager_statics *statics_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct manager_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct manager_statics *impl = statics_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IUserActivityRequestManagerStatics ))
+    {
+        *out = &impl->IUserActivityRequestManagerStatics_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return InterlockedIncrement( &statics_from_IActivationFactory( iface )->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return InterlockedDecrement( &statics_from_IActivationFactory( iface )->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* Reached through GetForCurrentView, not constructed. */
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE_( statics, IUserActivityRequestManagerStatics, struct manager_statics,
+                      statics_from_IUserActivityRequestManagerStatics,
+                      IUserActivityRequestManagerStatics_iface, &impl->IActivationFactory_iface )
+
+static HRESULT WINAPI statics_GetForCurrentView( IUserActivityRequestManagerStatics *iface,
+                                                 IUserActivityRequestManager **value )
+{
+    struct request_manager *impl;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IUserActivityRequestManager_iface.lpVtbl = &manager_vtbl;
+    impl->ref = 1;
+
+    *value = &impl->IUserActivityRequestManager_iface;
+    return S_OK;
+}
+
+static const struct IUserActivityRequestManagerStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable methods */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* IUserActivityRequestManagerStatics methods */
