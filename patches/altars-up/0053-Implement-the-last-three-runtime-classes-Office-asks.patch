+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(enterprisedata);
+
+/*
+ * Windows Information Protection is a policy an administrator pushes to a
+ * managed device.  No such policy is in force here and there is no channel
+ * through which one could arrive, so every question about one has the same
+ * answer it has on any unmanaged Windows machine: no identity is managed,
+ * protection is off, enforcement is at NoProtection, and access is Allowed.
+ *
+ * That is the answer, not a placeholder for one.  Saying Blocked, or failing,
+ * would have a caller withhold a file the policy never asked it to withhold.
+ * The events are registered and never fire, because nothing here changes a
+ * policy that does not exist.
+ */
+
+struct audit_info
+{
+    IProtectionPolicyAuditInfo IProtectionPolicyAuditInfo_iface;
+    LONG ref;
+    ProtectionPolicyAuditAction action;
+    HSTRING data_description;
+    HSTRING source_description;
+    HSTRING target_description;
+};
+
+static inline struct audit_info *impl_from_IProtectionPolicyAuditInfo( IProtectionPolicyAuditInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct audit_info, IProtectionPolicyAuditInfo_iface );
+}
+
+static HRESULT WINAPI audit_QueryInterface( IProtectionPolicyAuditInfo *iface, REFIID iid, void **out )
+{
+    struct audit_info *impl = impl_from_IProtectionPolicyAuditInfo( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IProtectionPolicyAuditInfo ))
+    {
+        *out = &impl->IProtectionPolicyAuditInfo_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI audit_AddRef( IProtectionPolicyAuditInfo *iface )
+{
+    return InterlockedIncrement( &impl_from_IProtectionPolicyAuditInfo( iface )->ref );
+}
+
+static ULONG WINAPI audit_Release( IProtectionPolicyAuditInfo *iface )
+{
+    struct audit_info *impl = impl_from_IProtectionPolicyAuditInfo( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->data_description );
+        WindowsDeleteString( impl->source_description );
+        WindowsDeleteString( impl->target_description );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI audit_GetIids( IProtectionPolicyAuditInfo *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI audit_GetRuntimeClassName( IProtectionPolicyAuditInfo *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Security_EnterpriseData_ProtectionPolicyAuditInfo,
+                                ARRAY_SIZE(RuntimeClass_Windows_Security_EnterpriseData_ProtectionPolicyAuditInfo) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI audit_GetTrustLevel( IProtectionPolicyAuditInfo *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI audit_put_Action( IProtectionPolicyAuditInfo *iface, ProtectionPolicyAuditAction value )
+{
+    struct audit_info *impl = impl_from_IProtectionPolicyAuditInfo( iface );
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+
+    if (value < ProtectionPolicyAuditAction_Decrypt || value > ProtectionPolicyAuditAction_Other)
+        return E_INVALIDARG;
+    impl->action = value;
+    return S_OK;
+}
+
+static HRESULT WINAPI audit_get_Action( IProtectionPolicyAuditInfo *iface, ProtectionPolicyAuditAction *value )
+{
+    struct audit_info *impl = impl_from_IProtectionPolicyAuditInfo( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->action;
+    return S_OK;
+}
+
+#define AUDIT_STRING_PROPERTY( name, field )                                                       \
+    static HRESULT WINAPI audit_put_##name( IProtectionPolicyAuditInfo *iface, HSTRING value )     \
+    {                                                                                              \
+        struct audit_info *impl = impl_from_IProtectionPolicyAuditInfo( iface );                   \
+        HSTRING copy = NULL;                                                                       \
+        HRESULT hr;                                                                                \
+        TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );                        \
+        if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;                        \
+        WindowsDeleteString( impl->field );                                                        \
+        impl->field = copy;                                                                        \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI audit_get_##name( IProtectionPolicyAuditInfo *iface, HSTRING *value )    \
+    {                                                                                              \
+        struct audit_info *impl = impl_from_IProtectionPolicyAuditInfo( iface );                   \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        return WindowsDuplicateString( impl->field, value );                                       \
+    }
+
+AUDIT_STRING_PROPERTY( DataDescription, data_description )
+AUDIT_STRING_PROPERTY( SourceDescription, source_description )
+AUDIT_STRING_PROPERTY( TargetDescription, target_description )
+
+static const struct IProtectionPolicyAuditInfoVtbl audit_vtbl =
+{
+    audit_QueryInterface,
+    audit_AddRef,
+    audit_Release,
+    /* IInspectable methods */
+    audit_GetIids,
+    audit_GetRuntimeClassName,
+    audit_GetTrustLevel,
+    /* IProtectionPolicyAuditInfo methods */
+    audit_put_Action,
+    audit_get_Action,
+    audit_put_DataDescription,
+    audit_get_DataDescription,
+    audit_put_SourceDescription,
+    audit_get_SourceDescription,
+    audit_put_TargetDescription,
+    audit_get_TargetDescription,
+};
+
+static HRESULT create_audit_info( ProtectionPolicyAuditAction action, HSTRING data, HSTRING source,
+                                  HSTRING target, IProtectionPolicyAuditInfo **out )
+{
+    struct audit_info *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IProtectionPolicyAuditInfo_iface.lpVtbl = &audit_vtbl;
+    impl->ref = 1;
+    impl->action = action;
+    if (FAILED(hr = WindowsDuplicateString( data, &impl->data_description )) ||
+        FAILED(hr = WindowsDuplicateString( source, &impl->source_description )) ||
+        FAILED(hr = WindowsDuplicateString( target, &impl->target_description )))
+    {
+        IProtectionPolicyAuditInfo_Release( &impl->IProtectionPolicyAuditInfo_iface );
+        return hr;
+    }
+
+    *out = &impl->IProtectionPolicyAuditInfo_iface;
+    return S_OK;
+}
+
+/*** ProtectionPolicyManager, the per-view object ***/
+
+struct policy_manager
+{
+    IProtectionPolicyManager IProtectionPolicyManager_iface;
+    IProtectionPolicyManager2 IProtectionPolicyManager2_iface;
+    LONG ref;
+    HSTRING identity;
+    boolean show_indicator;
+};
+
+static inline struct policy_manager *impl_from_IProtectionPolicyManager( IProtectionPolicyManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct policy_manager, IProtectionPolicyManager_iface );
+}
+
+static HRESULT WINAPI manager_QueryInterface( IProtectionPolicyManager *iface, REFIID iid, void **out )
+{
+    struct policy_manager *impl = impl_from_IProtectionPolicyManager( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IProtectionPolicyManager ))
+    {
+        *out = &impl->IProtectionPolicyManager_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IProtectionPolicyManager2 ))
+    {
+        *out = &impl->IProtectionPolicyManager2_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI manager_AddRef( IProtectionPolicyManager *iface )
+{
+    return InterlockedIncrement( &impl_from_IProtectionPolicyManager( iface )->ref );
+}
+
+static ULONG WINAPI manager_Release( IProtectionPolicyManager *iface )
+{
+    struct policy_manager *impl = impl_from_IProtectionPolicyManager( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->identity );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI manager_GetIids( IProtectionPolicyManager *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI manager_GetRuntimeClassName( IProtectionPolicyManager *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Security_EnterpriseData_ProtectionPolicyManager,
+                                ARRAY_SIZE(RuntimeClass_Windows_Security_EnterpriseData_ProtectionPolicyManager) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI manager_GetTrustLevel( IProtectionPolicyManager *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI manager_put_Identity( IProtectionPolicyManager *iface, HSTRING value )
+{
+    struct policy_manager *impl = impl_from_IProtectionPolicyManager( iface );
+    HSTRING copy = NULL;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+
+    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
+    WindowsDeleteString( impl->identity );
+    impl->identity = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI manager_get_Identity( IProtectionPolicyManager *iface, HSTRING *value )
+{
+    struct policy_manager *impl = impl_from_IProtectionPolicyManager( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl->identity, value );
+}
+
+static const struct IProtectionPolicyManagerVtbl manager_vtbl =
+{
+    manager_QueryInterface,
+    manager_AddRef,
+    manager_Release,
+    /* IInspectable methods */
+    manager_GetIids,
+    manager_GetRuntimeClassName,
+    manager_GetTrustLevel,
+    /* IProtectionPolicyManager methods */
