+/* Registering is remembered so a caller gets a token it can hand back, but
+ * nothing here changes a policy, so none of these ever fire. */
+#define POLICY_EVENT( pfx, iface_type, name )                                                      \
+    static HRESULT WINAPI pfx##_add_##name( iface_type *iface, IInspectable *handler,              \
+                                            EventRegistrationToken *token )                        \
+    {                                                                                              \
+        struct policy_statics *impl = statics_from_##iface_type( iface );                          \
+        TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );                       \
+        if (!token) return E_POINTER;                                                              \
+        token->value = InterlockedIncrement64( &impl->next_token );                                \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_remove_##name( iface_type *iface, EventRegistrationToken token )   \
+    {                                                                                              \
+        TRACE( "iface %p, token %I64d.\n", iface, token.value );                                   \
+        return S_OK;                                                                               \
+    }
+
+POLICY_EVENT( policy_statics, IProtectionPolicyManagerStatics, ProtectedAccessSuspending )
+POLICY_EVENT( policy_statics, IProtectionPolicyManagerStatics, ProtectedAccessResumed )
+POLICY_EVENT( policy_statics, IProtectionPolicyManagerStatics, ProtectedContentRevoked )
