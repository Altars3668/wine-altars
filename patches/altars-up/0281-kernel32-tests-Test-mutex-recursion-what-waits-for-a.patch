+static void test_wait_timeouts(void)
+{
+    LARGE_INTEGER timeout, start, end;
+    HANDLE signaled, nonsignaled;
+    NTSTATUS status;
+    DWORD ret, ticks;
+
+    signaled = CreateEventW( NULL, TRUE, TRUE, NULL );
+    nonsignaled = CreateEventW( NULL, TRUE, FALSE, NULL );
+
+    /* a timed wait waits (the clocks read here only move once a tick), unless the object is signaled */
+    ticks = GetTickCount();
+    ret = WaitForSingleObject( nonsignaled, 100 );
+    ticks = GetTickCount() - ticks;
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+    ok( ticks >= 50, "waited %lu ms\n", ticks );
+
+    ticks = GetTickCount();
+    ret = WaitForSingleObject( signaled, 1000 );
+    ticks = GetTickCount() - ticks;
+    ok( !ret, "got %lu\n", ret );
+    ok( ticks < 500, "waited %lu ms\n", ticks );
+
+    status = pNtWaitForSingleObject( signaled, FALSE, NULL );
+    ok( !status, "got %#lx\n", status );
+    timeout.QuadPart = MAXLONGLONG;
+    status = pNtWaitForSingleObject( signaled, FALSE, &timeout );
+    ok( !status, "got %#lx\n", status );
+
+    /* a positive timeout is an absolute system time, a negative one an interval */
+    pNtQuerySystemTime( &start );
+    timeout.QuadPart = start.QuadPart + 100 * 10000;
+    status = pNtWaitForSingleObject( nonsignaled, FALSE, &timeout );
+    pNtQuerySystemTime( &end );
+    ok( status == STATUS_TIMEOUT, "got %#lx\n", status );
+    ok( end.QuadPart - start.QuadPart >= 50 * 10000, "waited %s\n", wine_dbgstr_longlong( end.QuadPart - start.QuadPart ));
+
+    pNtQuerySystemTime( &start );
+    timeout.QuadPart = -100 * 10000;
+    status = pNtWaitForSingleObject( nonsignaled, FALSE, &timeout );
+    pNtQuerySystemTime( &end );
+    ok( status == STATUS_TIMEOUT, "got %#lx\n", status );
+    ok( end.QuadPart - start.QuadPart >= 50 * 10000, "waited %s\n", wine_dbgstr_longlong( end.QuadPart - start.QuadPart ));
+
+    /* an absolute time that has come already times out at once */
+    pNtQuerySystemTime( &start );
+    timeout.QuadPart = start.QuadPart;
+    status = pNtWaitForSingleObject( nonsignaled, FALSE, &timeout );
+    pNtQuerySystemTime( &end );
+    ok( status == STATUS_TIMEOUT, "got %#lx\n", status );
+    ok( end.QuadPart - start.QuadPart < 500 * 10000, "waited %s\n", wine_dbgstr_longlong( end.QuadPart - start.QuadPart ));
+
+    pNtQuerySystemTime( &start );
+    timeout.QuadPart = start.QuadPart - 100 * 10000;
+    status = pNtWaitForSingleObject( nonsignaled, FALSE, &timeout );
+    pNtQuerySystemTime( &end );
+    ok( status == STATUS_TIMEOUT, "got %#lx\n", status );
+    ok( end.QuadPart - start.QuadPart < 500 * 10000, "waited %s\n", wine_dbgstr_longlong( end.QuadPart - start.QuadPart ));
+
+    CloseHandle( signaled );
+    CloseHandle( nonsignaled );
+}
