+static HANDLE recursive_mutex;
+
+static DWORD WINAPI try_mutex_thread( void *param )
+{
+    DWORD expect = (DWORD)(DWORD_PTR)param, ret;
+
+    ret = WaitForSingleObject( recursive_mutex, 0 );
+    ok( ret == expect, "expected %lu, got %lu\n", expect, ret );
+    if (!ret) ReleaseMutex( recursive_mutex );
+    return 0;
+}
+
+static void run_try_mutex_thread( DWORD expect )
+{
+    HANDLE thread = CreateThread( NULL, 0, try_mutex_thread, (void *)(DWORD_PTR)expect, 0, NULL );
+    DWORD ret;
+
+    ok( !!thread, "CreateThread failed, error %lu\n", GetLastError() );
+    ret = WaitForSingleObject( thread, 2000 );
+    ok( !ret, "wait failed: %lu\n", ret );
+    CloseHandle( thread );
+}
+
+static void test_mutex_waits(void)
+{
+    HANDLE mutex2, mutexes[2];
+    DWORD ret;
+    BOOL res;
+    int i;
+
+    recursive_mutex = CreateMutexA( NULL, FALSE, NULL );
+    ok( !!recursive_mutex, "CreateMutex failed, error %lu\n", GetLastError() );
+
+    SetLastError( 0xdeadbeef );
+    res = ReleaseMutex( recursive_mutex );
+    ok( !res, "ReleaseMutex succeeded\n" );
+    ok( GetLastError() == ERROR_NOT_OWNER, "got error %lu\n", GetLastError() );
+
+    /* the owner may acquire it again and again, and has to release it as many times */
+    for (i = 0; i < 100; i++)
+    {
+        ret = WaitForSingleObject( recursive_mutex, 0 );
+        ok( !ret, "wait %d returned %lu\n", i, ret );
+    }
+    for (i = 0; i < 100; i++)
+    {
+        res = ReleaseMutex( recursive_mutex );
+        ok( res, "release %d failed, error %lu\n", i, GetLastError() );
+    }
+    SetLastError( 0xdeadbeef );
+    res = ReleaseMutex( recursive_mutex );
+    ok( !res, "ReleaseMutex succeeded\n" );
+    ok( GetLastError() == ERROR_NOT_OWNER, "got error %lu\n", GetLastError() );
+
+    run_try_mutex_thread( 0 );
+    ret = WaitForSingleObject( recursive_mutex, 0 );
+    ok( !ret, "got %lu\n", ret );
+    run_try_mutex_thread( WAIT_TIMEOUT );
+    res = ReleaseMutex( recursive_mutex );
+    ok( res, "ReleaseMutex failed, error %lu\n", GetLastError() );
+    run_try_mutex_thread( 0 );
+
+    mutex2 = CreateMutexA( NULL, TRUE, NULL );
+    ok( !!mutex2, "CreateMutex failed, error %lu\n", GetLastError() );
+    res = ReleaseMutex( mutex2 );
+    ok( res, "ReleaseMutex failed, error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    res = ReleaseMutex( mutex2 );
+    ok( !res, "ReleaseMutex succeeded\n" );
+    ok( GetLastError() == ERROR_NOT_OWNER, "got error %lu\n", GetLastError() );
+
+    /* a wait for any of them takes only the first one */
+    mutexes[0] = recursive_mutex;
+    mutexes[1] = mutex2;
+    ret = WaitForMultipleObjects( 2, mutexes, FALSE, 0 );
+    ok( !ret, "got %lu\n", ret );
+    res = ReleaseMutex( recursive_mutex );
+    ok( res, "ReleaseMutex failed, error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    res = ReleaseMutex( mutex2 );
+    ok( !res, "ReleaseMutex succeeded\n" );
+    ok( GetLastError() == ERROR_NOT_OWNER, "got error %lu\n", GetLastError() );
+
+    /* a wait for all of them takes both */
+    ret = WaitForMultipleObjects( 2, mutexes, TRUE, 0 );
+    ok( !ret, "got %lu\n", ret );
+    res = ReleaseMutex( recursive_mutex );
+    ok( res, "ReleaseMutex failed, error %lu\n", GetLastError() );
+    res = ReleaseMutex( mutex2 );
+    ok( res, "ReleaseMutex failed, error %lu\n", GetLastError() );
+
+    CloseHandle( mutex2 );
+    CloseHandle( recursive_mutex );
+}
+
+static void test_event_waits(void)
+{
+    HANDLE manual, automatic, handles[2];
+    DWORD ret;
+    BOOL res;
+    int i;
+
+    manual = CreateEventA( NULL, TRUE, FALSE, NULL );
+    ok( !!manual, "CreateEvent failed, error %lu\n", GetLastError() );
+    ret = WaitForSingleObject( manual, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+    res = SetEvent( manual );
+    ok( res, "SetEvent failed, error %lu\n", GetLastError() );
+    res = SetEvent( manual );
+    ok( res, "SetEvent failed, error %lu\n", GetLastError() );
+    /* a manual-reset event stays set */
+    for (i = 0; i < 100; i++)
+    {
+        ret = WaitForSingleObject( manual, 0 );
+        ok( !ret, "wait %d returned %lu\n", i, ret );
+    }
+    res = ResetEvent( manual );
+    ok( res, "ResetEvent failed, error %lu\n", GetLastError() );
+    res = ResetEvent( manual );
+    ok( res, "ResetEvent failed, error %lu\n", GetLastError() );
+    ret = WaitForSingleObject( manual, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    /* an auto-reset event is reset by the wait it satisfies, and setting it twice does not count */
+    automatic = CreateEventA( NULL, FALSE, TRUE, NULL );
+    ok( !!automatic, "CreateEvent failed, error %lu\n", GetLastError() );
+    ret = WaitForSingleObject( automatic, 0 );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForSingleObject( automatic, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+    res = SetEvent( automatic );
+    ok( res, "SetEvent failed, error %lu\n", GetLastError() );
+    res = SetEvent( automatic );
+    ok( res, "SetEvent failed, error %lu\n", GetLastError() );
+    ret = WaitForSingleObject( automatic, 0 );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForSingleObject( automatic, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+    SetEvent( automatic );
+    res = ResetEvent( automatic );
+    ok( res, "ResetEvent failed, error %lu\n", GetLastError() );
+    res = ResetEvent( automatic );
+    ok( res, "ResetEvent failed, error %lu\n", GetLastError() );
+    ret = WaitForSingleObject( automatic, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    handles[0] = manual;
+    handles[1] = automatic;
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    /* a wait for any of them is satisfied by the first set one, and leaves the others alone */
+    SetEvent( manual );
+    SetEvent( automatic );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForSingleObject( automatic, 0 );
+    ok( !ret, "got %lu\n", ret );
+
+    ResetEvent( manual );
+    SetEvent( automatic );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == 1, "got %lu\n", ret );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    /* a wait for all of them resets the auto-reset one only when all are set */
+    SetEvent( manual );
+    SetEvent( automatic );
+    ret = WaitForMultipleObjects( 2, handles, TRUE, 0 );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForMultipleObjects( 2, handles, TRUE, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    SetEvent( automatic );
+    ResetEvent( manual );
+    ret = WaitForMultipleObjects( 2, handles, TRUE, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+    ret = WaitForSingleObject( automatic, 0 );
+    ok( !ret, "got %lu\n", ret );
+
+    handles[0] = automatic;
+    handles[1] = manual;
+    SetEvent( manual );
+    SetEvent( automatic );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == 1, "got %lu\n", ret );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == 1, "got %lu\n", ret );
+
+    CloseHandle( manual );
+    CloseHandle( automatic );
+}
