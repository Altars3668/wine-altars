+static void test_semaphore_waits(void)
+{
+    HANDLE sem, sem2, handles[2];
+    LONG prev;
+    DWORD ret;
+    BOOL res;
+    int i;
+
+    sem = CreateSemaphoreA( NULL, 0, 5, NULL );
+    ok( !!sem, "CreateSemaphore failed, error %lu\n", GetLastError() );
+    ret = WaitForSingleObject( sem, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    res = ReleaseSemaphore( sem, 1, &prev );
+    ok( res, "ReleaseSemaphore failed, error %lu\n", GetLastError() );
+    ok( prev == 0, "got prev %ld\n", prev );
+    res = ReleaseSemaphore( sem, 1, &prev );
+    ok( res, "ReleaseSemaphore failed, error %lu\n", GetLastError() );
+    ok( prev == 1, "got prev %ld\n", prev );
+
+    /* releasing past the maximum changes nothing */
+    prev = 0xdeadbeef;
+    SetLastError( 0xdeadbeef );
+    res = ReleaseSemaphore( sem, 5, &prev );
+    ok( !res, "ReleaseSemaphore succeeded\n" );
+    ok( GetLastError() == ERROR_TOO_MANY_POSTS, "got error %lu\n", GetLastError() );
+    ok( prev == 0xdeadbeef, "got prev %ld\n", prev );
+
+    res = ReleaseSemaphore( sem, 2, &prev );
+    ok( res, "ReleaseSemaphore failed, error %lu\n", GetLastError() );
+    ok( prev == 2, "got prev %ld\n", prev );
+    res = ReleaseSemaphore( sem, 1, &prev );
+    ok( res, "ReleaseSemaphore failed, error %lu\n", GetLastError() );
+    ok( prev == 4, "got prev %ld\n", prev );
+
+    for (i = 0; i < 5; i++)
+    {
+        ret = WaitForSingleObject( sem, 0 );
+        ok( !ret, "wait %d returned %lu\n", i, ret );
+    }
+    ret = WaitForSingleObject( sem, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    sem2 = CreateSemaphoreA( NULL, 3, 5, NULL );
+    ok( !!sem2, "CreateSemaphore failed, error %lu\n", GetLastError() );
+    res = ReleaseSemaphore( sem2, 1, &prev );
+    ok( res, "ReleaseSemaphore failed, error %lu\n", GetLastError() );
+    ok( prev == 3, "got prev %ld\n", prev );
+    for (i = 0; i < 4; i++)
+    {
+        ret = WaitForSingleObject( sem2, 0 );
+        ok( !ret, "wait %d returned %lu\n", i, ret );
+    }
+    ret = WaitForSingleObject( sem2, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    handles[0] = sem;
+    handles[1] = sem2;
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    ReleaseSemaphore( sem, 1, NULL );
+    ReleaseSemaphore( sem2, 1, NULL );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == 1, "got %lu\n", ret );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    ReleaseSemaphore( sem, 1, NULL );
+    ReleaseSemaphore( sem2, 1, NULL );
+    ret = WaitForMultipleObjects( 2, handles, TRUE, 0 );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForMultipleObjects( 2, handles, FALSE, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+
+    /* a wait for all of them that fails takes nothing */
+    ReleaseSemaphore( sem, 1, NULL );
+    ret = WaitForMultipleObjects( 2, handles, TRUE, 0 );
+    ok( ret == WAIT_TIMEOUT, "got %lu\n", ret );
+    ret = WaitForSingleObject( sem, 0 );
+    ok( !ret, "got %lu\n", ret );
+
+    CloseHandle( sem );
+    CloseHandle( sem2 );
+}
