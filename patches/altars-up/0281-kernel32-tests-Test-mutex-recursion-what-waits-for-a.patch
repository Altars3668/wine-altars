+static HANDLE zigzag_events[2];
+static LONG zigzag_state, zigzag_count[2], zigzag_stop;
+
+/* the two threads hand the turn to each other through their auto-reset events */
+static DWORD CALLBACK zigzag_thread( void *arg )
+{
+    int self = (int)(INT_PTR)arg;
+
+    while (!ReadAcquire( &zigzag_stop ))
+    {
+        WaitForSingleObject( zigzag_events[self], INFINITE );
+        ok( zigzag_state == self, "thread %d: got state %ld\n", self, zigzag_state );
+        zigzag_state = !self;
+        zigzag_count[self]++;
+        SetEvent( zigzag_events[!self] );
+    }
+    return 0;
+}
+
+static void test_zigzag_event(void)
+{
+    HANDLE threads[2];
+    DWORD ret;
+
+    zigzag_state = 0;
+    zigzag_count[0] = zigzag_count[1] = 0;
+    zigzag_stop = 0;
+    zigzag_events[0] = CreateEventA( NULL, FALSE, FALSE, NULL );
+    zigzag_events[1] = CreateEventA( NULL, FALSE, FALSE, NULL );
+    threads[0] = CreateThread( NULL, 0, zigzag_thread, (void *)0, 0, NULL );
+    threads[1] = CreateThread( NULL, 0, zigzag_thread, (void *)1, 0, NULL );
+
+    SetEvent( zigzag_events[0] );
+    Sleep( 500 );
+    WriteRelease( &zigzag_stop, 1 );
+
+    /* each one finishes its turn and hands over once more, so both see the stop */
+    ret = WaitForMultipleObjects( 2, threads, TRUE, 5000 );
+    ok( !ret, "wait failed: %lu\n", ret );
+    ok( zigzag_count[0] == zigzag_count[1] || zigzag_count[0] == zigzag_count[1] + 1,
+        "counts %ld and %ld\n", zigzag_count[0], zigzag_count[1] );
+    trace( "%ld round trips\n", zigzag_count[1] );
+
+    CloseHandle( threads[0] );
+    CloseHandle( threads[1] );
+    CloseHandle( zigzag_events[0] );
+    CloseHandle( zigzag_events[1] );
+}
