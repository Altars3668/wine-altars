From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 18:15:13 -0400
Subject: [PATCH] d2d1: Draw the ColorMatrix effect.

ColorMatrix had its properties but nothing drew it, so PowerPoint's
recoloured pictures -- grayscale, brightness and contrast -- did not
appear at all.  It is now a pixel shader multiplying [r g b a 1] by the
5x4 matrix: in premultiplied mode, the default, on the straight colour,
premultiplying what comes out; in straight mode on the input as it is;
clamped to 0..1 when ClampOutput says so.  The transforms' constants go
up to 128 bytes, the matrix taking 80.

The tests follow from the documentation and were not run on Windows;
PowerPoint now shows a grayscale, brightened picture where there was
nothing.  d2d1 --effects: 6098 tests, 0 failures, on GL and Vulkan.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 86eb48ec7f7f27ecb10723e1f764f8ed5c201cdd)

diff --git a/dlls/d2d1/effect.c b/dlls/d2d1/effect.c
index f7618a969b2..7e39fc25d36 100644
--- a/dlls/d2d1/effect.c
+++ b/dlls/d2d1/effect.c
@@ -986,7 +986,7 @@ struct d2d_effect_transform
     BOOL singular;
     BOOL hard;
 
-    BYTE constants[64];
+    BYTE constants[128];
     UINT32 constants_size;
 };
 
@@ -2320,6 +2320,69 @@ static const D2D1_PROPERTY_BINDING color_matrix_bindings[] =
     { L"ClampOutput", BINDING_RW(color_matrix, clamp_output) },
 };
 
+/* {3a2c4b8e-0d6f-4c2e-9b8a-5e1d7f60a2c4} */
+static const GUID d2d_color_matrix_shader =
+        {0x3a2c4b8e, 0x0d6f, 0x4c2e, {0x9b, 0x8a, 0x5e, 0x1d, 0x7f, 0x60, 0xa2, 0xc4}};
+
+/* [r g b a 1] times the 5x4 matrix.  In premultiplied mode the matrix takes straight colours, and what comes
+ * out is premultiplied again; in straight mode it takes what it is given as it is. */
+static const char color_matrix_ps_code[] =
+    "Texture2D t0 : register(t0);\n"
+    "SamplerState s0 : register(s0);\n"
+    "\n"
+    "cbuffer constants : register(b0)\n"
+    "{\n"
+    "    float4 rows[5];\n"
+    "    uint premultiplied;\n"
+    "    uint clamped;\n"
+    "};\n"
+    "\n"
+    "float4 main(float4 position : SV_POSITION, float4 scene : SCENE_POSITION,\n"
+    "        float4 uv0 : TEXCOORD0) : SV_Target\n"
+    "{\n"
+    "    float4 c = t0.SampleLevel(s0, uv0.xy, 0.0f);\n"
+    "\n"
+    "    if (premultiplied)\n"
+    "        c.rgb = c.a ? c.rgb / c.a : 0.0f;\n"
+    "    c = c.r * rows[0] + c.g * rows[1] + c.b * rows[2] + c.a * rows[3] + rows[4];\n"
+    "    if (clamped)\n"
+    "        c = saturate(c);\n"
+    "    if (premultiplied)\n"
+    "        c.rgb *= c.a;\n"
+    "    return c;\n"
+    "}\n";
+
+static HRESULT color_matrix_init(struct d2d_effect_impl *effect)
+{
+    return d2d_effect_impl_init_single(effect, 1, &d2d_effect_transform_union_ops,
+            &d2d_color_matrix_shader, color_matrix_ps_code);
+}
+
+static HRESULT color_matrix_prepare(struct d2d_effect_impl *effect)
+{
+    const struct color_matrix_properties *props = (void *)(effect + 1);
+    struct
+    {
+        float rows[5][4];
+        UINT32 premultiplied;
+        UINT32 clamped;
+        UINT32 padding[2];
+    } constants;
+
+    memcpy(constants.rows, props->color_matrix.m, sizeof(constants.rows));
+    constants.premultiplied = props->alpha_mode != D2D1_COLORMATRIX_ALPHA_MODE_STRAIGHT;
+    constants.clamped = !!props->clamp_output;
+    memset(constants.padding, 0, sizeof(constants.padding));
+
+    return d2d_effect_transform_set_constants(effect->transforms[0], &constants, sizeof(constants));
+}
+
+static const struct d2d_effect_impl_ops color_matrix_effect_ops =
+{
+    color_matrix_init,
+    color_matrix_prepare,
+};
+
 static HRESULT __stdcall color_matrix_factory(IUnknown **effect)
 {
     static const struct color_matrix_properties properties =
@@ -2327,7 +2390,7 @@ static HRESULT __stdcall color_matrix_factory(IUnknown **effect)
         .color_matrix = { ._11 = 1.0f, ._22 = 1.0f, ._33 = 1.0f, ._44 = 1.0f },
         .alpha_mode = D2D1_COLORMATRIX_ALPHA_MODE_PREMULTIPLIED,
     };
-    return d2d_effect_create_impl(effect, NULL, &properties, sizeof(properties));
+    return d2d_effect_create_impl(effect, &color_matrix_effect_ops, &properties, sizeof(properties));
 }
 
 static const WCHAR flood_description[] =
diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index cbd9e803214..b07a3745016 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -17139,6 +17139,7 @@ static void check_effect_pixel_(unsigned int line, struct d2d1_test_context *ctx
 static void test_effect_rendering(BOOL d3d11)
 {
     D2D1_RECT_F rect, image_rect, bounds;
+    D2D1_MATRIX_5X4_F m54;
     ID2D1Effect *effect, *flood, *blur;
     ID2D1Bitmap1 *blue, *red, *white;
     struct d2d1_test_context ctx;
@@ -17341,6 +17342,54 @@ static void test_effect_rendering(BOOL d3d11)
     ID2D1Effect_Release(effect);
     ID2D1CommandList_Release(list);
 
+    /* A colour matrix, [r g b a 1] times it. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1ColorMatrix, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    memset(&m54, 0, sizeof(m54));
+    m54._13 = m54._22 = m54._31 = m54._44 = 1.0f;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMATRIX_PROP_COLOR_MATRIX, D2D1_PROPERTY_TYPE_MATRIX_5X4,
+            (const BYTE *)&m54, sizeof(m54));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)blue, FALSE);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    /* red and blue swapped */
+    check_effect_pixel(&ctx, 1, 1, 0xffff0000, 1);
+    check_effect_pixel(&ctx, 8, 8, 0x00000000, 0);
+    /* By default the matrix takes straight colours: half red plus a quarter of green comes out premultiplied. */
+    memset(&m54, 0, sizeof(m54));
+    m54._11 = m54._22 = m54._33 = m54._44 = 1.0f;
+    m54._52 = 0.25f;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMATRIX_PROP_COLOR_MATRIX, D2D1_PROPERTY_TYPE_MATRIX_5X4,
+            (const BYTE *)&m54, sizeof(m54));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)red, FALSE);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0x80802000, 1);
+    /* In straight mode it takes the premultiplied colour as it is, and gives what it makes of it. */
+    v = D2D1_COLORMATRIX_ALPHA_MODE_STRAIGHT;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMATRIX_PROP_ALPHA_MODE, D2D1_PROPERTY_TYPE_ENUM,
+            (const BYTE *)&v, sizeof(v));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0x80804000, 1);
+    /* Clamped, twice the red of half red is full red, premultiplied. */
+    v = D2D1_COLORMATRIX_ALPHA_MODE_PREMULTIPLIED;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMATRIX_PROP_ALPHA_MODE, D2D1_PROPERTY_TYPE_ENUM,
+            (const BYTE *)&v, sizeof(v));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    m54._11 = 2.0f;
+    m54._52 = 0.0f;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMATRIX_PROP_COLOR_MATRIX, D2D1_PROPERTY_TYPE_MATRIX_5X4,
+            (const BYTE *)&m54, sizeof(m54));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    v = TRUE;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COLORMATRIX_PROP_CLAMP_OUTPUT, D2D1_PROPERTY_TYPE_BOOL,
+            (const BYTE *)&v, sizeof(v));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0x80800000, 1);
+    ID2D1Effect_Release(effect);
+
     ID2D1Effect_Release(flood);
     ID2D1Bitmap1_Release(white);
     ID2D1Bitmap1_Release(red);
