+/* MSXML's extension functions, urn:schemas-microsoft-com:xslt */
+struct _xsltTransformContext;
+extern HRESULT msxsl_language(const WCHAR *language, LCID *lcid);
+extern HRESULT msxsl_string_compare(const WCHAR *x, const WCHAR *y, const WCHAR *language, const WCHAR *options,
+        int *result);
+extern WCHAR *msxsl_utc(const WCHAR *value);
+extern double msxsl_number(const WCHAR *value);
+extern WCHAR *msxsl_local_name(const WCHAR *qname);
+extern WCHAR *msxsl_qname_prefix(const WCHAR *qname);
+extern const WCHAR *msxsl_reserved_namespace(const WCHAR *prefix);
+extern HRESULT msxsl_format_date(const WCHAR *value, const WCHAR *format, const WCHAR *language, BOOL time,
+        WCHAR **out);
+extern void msxsl_register_xslt_functions(struct _xsltTransformContext *ctxt);
 extern HRESULT parse_xml_decl_body(const WCHAR *text, BSTR *version, BSTR *encoding, BSTR *standalone);
 
 extern struct dtd * parser_dtd_addref(struct dtd *dtd);
