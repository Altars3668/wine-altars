+/* What the functions answer is what MSXML 6 answers on Windows 11 (tools/msxslfuncprobe in the
+ * wine-altars tree records it).  The XPath engine (xpath.c) and the XSLT processor (libxslt,
+ * registered below) share it. */
+
+#define COBJMACROS
+
+#include <stdarg.h>
+#include <math.h>
+
+#include <libxml/xpathInternals.h>
+#include <libxslt/extensions.h>
+#include <libxslt/transform.h>
+#include <libxslt/xsltInternals.h>
+#include <libxslt/xsltutils.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winnls.h"
+#include "ole2.h"
+#include "mlang.h"
+#include "msxml6.h"
+
+#include "msxml_private.h"
+
+
+/* A language is the user's own when none is given, or a name MLang knows as it is: de and
+ * en-us are taken, de-de (which MLang only takes for de) is not. */
+HRESULT msxsl_language(const WCHAR *language, LCID *lcid)
+{
+    if (!language || !*language)
+    {
+        *lcid = LOCALE_USER_DEFAULT;
+        return S_OK;
+    }
+    return Rfc1766ToLcidW(lcid, language) == S_OK ? S_OK : E_FAIL;
+}
+
+/* ms:string-compare(x, y[, language[, options]]): -1, 0 or 1 as x sorts before, with or after y
+ * in the language, case sensitive with lowercase first; the options "i" ignore case, "u" put
+ * uppercase first. */
+HRESULT msxsl_string_compare(const WCHAR *x, const WCHAR *y, const WCHAR *language, const WCHAR *options,
+        int *result)
+{
+    WCHAR locale[LOCALE_NAME_MAX_LENGTH];
+    BOOL upper_first = FALSE;
+    DWORD flags = 0;
+    LCID lcid;
+    int ret;
+
+    if (options && *options)
+    {
+        if (!wcscmp(options, L"i")) flags = NORM_IGNORECASE;
+        else if (!wcscmp(options, L"u")) upper_first = TRUE;
+        else return E_FAIL;
+    }
+    if (FAILED(msxsl_language(language, &lcid)) || !LCIDToLocaleName(lcid, locale, ARRAY_SIZE(locale), 0))
+        return E_FAIL;
+
+    ret = CompareStringEx(locale, upper_first ? NORM_IGNORECASE : flags, x, -1, y, -1, NULL, NULL, 0);
+    /* uppercase first reverses what case alone decides */
+    if (ret == CSTR_EQUAL && upper_first)
+        ret = 2 * CSTR_EQUAL - CompareStringEx(locale, 0, x, -1, y, -1, NULL, NULL, 0);
+    if (!ret) return E_FAIL;
+    *result = ret - CSTR_EQUAL;
+    return S_OK;
+}
+
+#define XSD_YEAR   0x1
+#define XSD_MONTH  0x2
+#define XSD_DAY    0x4
+#define XSD_TIME   0x8
+
+/* an XML Schema date, time, dateTime, gYearMonth, gYear, gMonthDay, gDay or gMonth; the parts
+ * it lacks are those of 2000-01-01T00:00:00 */
+struct xsd_date
+{
+    int year, month, day, hour, minute, second, msec;
+    unsigned int parts;
+    BOOL fraction;
+    BOOL zone;
+    int zone_minutes;
+};
+
+static BOOL is_xml_space(WCHAR c)
+{
+    return c == ' ' || c == '\t' || c == '\r' || c == '\n';
+}
+
+static BOOL parse_digits(const WCHAR **p, int count, int *value)
+{
+    int i, v = 0;
+
+    for (i = 0; i < count; i++)
+    {
+        if ((*p)[i] < '0' || (*p)[i] > '9') return FALSE;
+        v = v * 10 + (*p)[i] - '0';
+    }
+    *p += count;
+    *value = v;
+    return TRUE;
+}
+
+static BOOL is_digit(WCHAR c)
+{
+    return c >= '0' && c <= '9';
+}
+
+static BOOL is_leap_year(int year)
+{
+    return !(year % 4) && (year % 100 || !(year % 400));
+}
+
+static int days_in_month(int year, int month)
+{
+    static const int days[] = { 31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31 };
+    return month == 2 && is_leap_year(year) ? 29 : days[month - 1];
+}
+
+/* days from 0001-01-01 in the proleptic Gregorian calendar */
+static LONGLONG days_from_date(int year, int month, int day)
+{
+    LONGLONG y = year - 1;
+    LONGLONG days = y * 365 + y / 4 - y / 100 + y / 400;
+    int m;
+
+    for (m = 1; m < month; m++) days += days_in_month(year, m);
+    return days + day - 1;
+}
+
+static void date_from_days(LONGLONG days, int *year, int *month, int *day)
+{
+    LONGLONG y400, y100, y4, y1;
+    int y, m;
+
+    y400 = days / 146097; days %= 146097;
+    y100 = days / 36524; if (y100 == 4) y100 = 3; days -= y100 * 36524;
+    y4 = days / 1461; days %= 1461;
+    y1 = days / 365; if (y1 == 4) y1 = 3; days -= y1 * 365;
+    y = 400 * y400 + 100 * y100 + 4 * y4 + y1 + 1;
+    for (m = 1; days >= days_in_month(y, m); m++) days -= days_in_month(y, m);
+    *year = y;
+    *month = m;
+    *day = days + 1;
+}
+
+static BOOL parse_time(const WCHAR **p, struct xsd_date *date)
+{
+    int digits = 0, value = 0;
+
+    if (!parse_digits(p, 2, &date->hour) || **p != ':') return FALSE;
+    ++*p;
+    if (!parse_digits(p, 2, &date->minute) || **p != ':') return FALSE;
+    ++*p;
+    if (!parse_digits(p, 2, &date->second)) return FALSE;
+    if (**p == '.')
+    {
+        ++*p;
+        if (!is_digit(**p)) return FALSE;
+        /* rounded to the millisecond: .9999 is a whole second more */
+        for (; is_digit(**p); ++*p)
+            if (digits < 4) value = value * 10 + **p - '0', digits++;
+        for (; digits < 4; digits++) value *= 10;
+        date->msec = (value + 5) / 10;
+        date->fraction = TRUE;
+    }
+    date->parts |= XSD_TIME;
+    return TRUE;
+}
+
+static BOOL parse_zone(const WCHAR **p, struct xsd_date *date)
+{
+    int hours, minutes, sign;
+
+    if (**p == 'Z')
+    {
+        ++*p;
+        date->zone = TRUE;
+        return TRUE;
+    }
+    if (**p != '+' && **p != '-') return TRUE;
+    sign = **p == '-' ? -1 : 1;
+    ++*p;
+    if (!parse_digits(p, 2, &hours) || **p != ':') return FALSE;
+    ++*p;
+    if (!parse_digits(p, 2, &minutes) || minutes > 59 || hours * 60 + minutes > 14 * 60) return FALSE;
+    date->zone = TRUE;
+    date->zone_minutes = sign * (hours * 60 + minutes);
+    return TRUE;
+}
+
+static BOOL parse_xsd_date(const WCHAR *str, struct xsd_date *date)
+{
+    const WCHAR *p = str, *end;
+    int year;
+
+    memset(date, 0, sizeof(*date));
+    date->year = 2000;
+    date->month = 1;
+    date->day = 1;
+
+    while (is_xml_space(*p)) p++;
+    end = p + wcslen(p);
+    while (end > p && is_xml_space(end[-1])) end--;
+
+    if (p[0] == '-' && p[1] == '-')
+    {
+        p += 2;
+        if (*p == '-')
+        {
+            p++;
+            if (!parse_digits(&p, 2, &date->day)) return FALSE;
+            date->parts = XSD_DAY;
+        }
+        else
+        {
+            if (!parse_digits(&p, 2, &date->month)) return FALSE;
+            date->parts = XSD_MONTH;
+            if (*p == '-' && is_digit(p[1]))
+            {
+                p++;
+                if (!parse_digits(&p, 2, &date->day)) return FALSE;
+                date->parts |= XSD_DAY;
+            }
+        }
+    }
+    else if (is_digit(p[0]) && is_digit(p[1]) && p[2] == ':')
+    {
+        if (!parse_time(&p, date)) return FALSE;
+    }
+    else
+    {
+        /* four digits, no more and no sign: 0001 to 9999 */
+        if (!parse_digits(&p, 4, &year) || is_digit(*p) || !year) return FALSE;
+        date->year = year;
+        date->parts = XSD_YEAR;
+        if (*p == '-' && is_digit(p[1]))
+        {
+            p++;
+            if (!parse_digits(&p, 2, &date->month)) return FALSE;
+            date->parts |= XSD_MONTH;
+            if (*p == '-' && is_digit(p[1]))
+            {
+                p++;
+                if (!parse_digits(&p, 2, &date->day)) return FALSE;
+                date->parts |= XSD_DAY;
+                if (*p == 'T')
+                {
+                    p++;
+                    if (!parse_time(&p, date)) return FALSE;
+                }
+            }
+        }
+    }
+    if (!parse_zone(&p, date) || p != end) return FALSE;
+
+    if (date->month < 1 || date->month > 12) return FALSE;
+    if (date->day < 1 || date->day > days_in_month(date->year, date->month)) return FALSE;
+    if (date->minute > 59 || date->second > 59) return FALSE;
+    if (date->hour > 24 || (date->hour == 24 && (date->minute || date->second || date->msec))) return FALSE;
+    return TRUE;
+}
+
+/* Carries 24:00:00 and a rounded-up millisecond, and moves the date to UTC when it has a time
+ * zone; a date without a time is midnight.  Fails when the year leaves 0001-9999. */
+static BOOL xsd_date_normalize(struct xsd_date *date)
+{
+    LONGLONG seconds;
+
+    seconds = days_from_date(date->year, date->month, date->day) * 86400
+            + date->hour * 3600 + date->minute * 60 + date->second - date->zone_minutes * 60;
+    if (date->msec == 1000)
+    {
+        seconds++;
+        date->msec = 0;
+    }
+    if (seconds < 0) return FALSE;
+    date->hour = seconds % 86400 / 3600;
+    date->minute = seconds % 3600 / 60;
+    date->second = seconds % 60;
+    date_from_days(seconds / 86400, &date->year, &date->month, &date->day);
+    date->zone_minutes = 0;
+    return date->year <= 9999;
+}
+
+/* ms:utc(value): the value in UTC, written without its time zone; the parts it lacks are dashes
+ * (----------T10:00:00 for a time), a fraction of a second is three digits, anything else is "". */
+WCHAR *msxsl_utc(const WCHAR *value)
+{
+    struct xsd_date date;
+    WCHAR buffer[64], *p = buffer;
+
+    if (!parse_xsd_date(value, &date) || !xsd_date_normalize(&date))
+        return wcsdup(L"");
+
+    if (date.parts & XSD_YEAR) p += swprintf(p, 5, L"%04d", date.year);
+    else if (date.parts & (XSD_MONTH | XSD_DAY | XSD_TIME)) p += swprintf(p, 5, L"----");
+    if (date.parts & XSD_MONTH) p += swprintf(p, 4, L"-%02d", date.month);
+    else if (date.parts & (XSD_DAY | XSD_TIME)) p += swprintf(p, 4, L"---");
+    if (date.parts & XSD_DAY) p += swprintf(p, 4, L"-%02d", date.day);
+    else if (date.parts & XSD_TIME) p += swprintf(p, 4, L"---");
+    if (date.parts & XSD_TIME)
+    {
+        p += swprintf(p, 10, L"T%02d:%02d:%02d", date.hour, date.minute, date.second);
+        if (date.fraction) swprintf(p, 5, L".%03d", date.msec);
+    }
+    return wcsdup(buffer);
+}
+
+/* ms:number(value): an XML Schema double; NaN when the string is not one */
+double msxsl_number(const WCHAR *value)
+{
+    const WCHAR *p = value, *start, *end;
+    WCHAR buffer[400];
+    size_t len;
+    BOOL digits = FALSE;
+
+    while (is_xml_space(*p)) p++;
+    end = p + wcslen(p);
+    while (end > p && is_xml_space(end[-1])) end--;
+    len = end - p;
+
+    if (len == 3 && !wcsncmp(p, L"INF", 3)) return INFINITY;
+    if (len == 4 && !wcsncmp(p, L"-INF", 4)) return -INFINITY;
+    if (len == 3 && !wcsncmp(p, L"NaN", 3)) return NAN;
+
+    start = p;
+    if (*p == '+' || *p == '-') p++;
+    while (is_digit(*p)) p++, digits = TRUE;
+    if (*p == '.')
+        for (p++; is_digit(*p); p++) digits = TRUE;
+    if (!digits) return NAN;
+    if (*p == 'e' || *p == 'E')
+    {
+        p++;
+        if (*p == '+' || *p == '-') p++;
+        if (!is_digit(*p)) return NAN;
+        while (is_digit(*p)) p++;
+    }
+    if (p != end || len >= ARRAY_SIZE(buffer)) return NAN;
+
+    memcpy(buffer, start, len * sizeof(WCHAR));
+    buffer[len] = 0;
+    return wcstod(buffer, NULL);
+}
+
+/* ms:local-name(qname): the local part of a qualified name, "" for anything else */
+WCHAR *msxsl_local_name(const WCHAR *qname)
+{
+    const WCHAR *colon;
+
+    if (!parser_is_valid_qualified_name(qname)) return wcsdup(L"");
+    colon = wcschr(qname, ':');
+    return wcsdup(colon ? colon + 1 : qname);
+}
+
+/* the prefix of a qualified name, NULL when it has none or is not one */
+WCHAR *msxsl_qname_prefix(const WCHAR *qname)
+{
+    const WCHAR *colon;
+    WCHAR *prefix;
+
+    if (!parser_is_valid_qualified_name(qname) || !(colon = wcschr(qname, ':'))) return NULL;
+    if (!(prefix = malloc((colon - qname + 1) * sizeof(WCHAR)))) return NULL;
+    memcpy(prefix, qname, (colon - qname) * sizeof(WCHAR));
+    prefix[colon - qname] = 0;
+    return prefix;
+}
+
+/* the namespaces ms:namespace-uri() knows whatever the node declares */
+const WCHAR *msxsl_reserved_namespace(const WCHAR *prefix)
+{
+    if (!wcscmp(prefix, L"xml")) return L"http://www.w3.org/XML/1998/namespace";
+    if (!wcscmp(prefix, L"xmlns")) return L"http://www.w3.org/2000/xmlns/";
+    return NULL;
+}
+
+/* ms:format-date(value[, format[, language]]) and ms:format-time(): the date or the time of an
+ * XML Schema value, in UTC, through GetDateFormat or GetTimeFormat; the language's own format
+ * when none is given.  A date the value lacks is 2000-01-01, a time midnight.  E_FAIL for a
+ * language MSXML refuses; *out is "" for a value it cannot read or before 1601. */
+HRESULT msxsl_format_date(const WCHAR *value, const WCHAR *format, const WCHAR *language, BOOL time,
+        WCHAR **out)
+{
+    struct xsd_date date;
+    SYSTEMTIME st = { 0 };
+    FILETIME ft;
+    WCHAR *buffer;
+    LCID lcid;
+    int len;
+
+    if (FAILED(msxsl_language(language, &lcid))) return E_FAIL;
+
+    *out = NULL;
+    if (!parse_xsd_date(value, &date) || !xsd_date_normalize(&date)
+            || (time ? !(date.parts & (XSD_TIME | XSD_DAY)) : date.year < 1601))
+        return (*out = wcsdup(L"")) ? S_OK : E_OUTOFMEMORY;
+
+    if (date.year < 1601) date.year = 2000, date.month = date.day = 1;
+    st.wYear = date.year;
+    st.wMonth = date.month;
+    st.wDay = date.day;
+    st.wHour = date.hour;
+    st.wMinute = date.minute;
+    st.wSecond = date.second;
+    /* the day of the week */
+    SystemTimeToFileTime(&st, &ft);
+    FileTimeToSystemTime(&ft, &st);
+
+    if (format && !*format) format = NULL;
+    if (time) len = GetTimeFormatW(lcid, 0, &st, format, NULL, 0);
+    else len = GetDateFormatW(lcid, format ? 0 : DATE_SHORTDATE, &st, format, NULL, 0);
+    if (!len || !(buffer = malloc(len * sizeof(WCHAR)))) return (*out = wcsdup(L"")) ? S_OK : E_OUTOFMEMORY;
+    if (time) GetTimeFormatW(lcid, 0, &st, format, buffer, len);
+    else GetDateFormatW(lcid, format ? 0 : DATE_SHORTDATE, &st, format, buffer, len);
+    *out = buffer;
+    return S_OK;
+}
+
+/* the XSLT side: libxslt calls these with the parser context of its XPath engine */
+
+static WCHAR *pop_string(xmlXPathParserContextPtr ctxt)
+{
+    xmlChar *str = xmlXPathPopString(ctxt);
+    WCHAR *ret = str ? (WCHAR *)bstr_from_xmlChar(str) : NULL;
+
+    xmlFree(str);
+    return ret;
+}
+
+/* takes a string from malloc() */
+static void push_string(xmlXPathParserContextPtr ctxt, WCHAR *str)
+{
+    xmlChar *utf8 = str ? xmlchar_from_wchar(str) : NULL;
+
+    free(str);
+    if (!utf8)
+    {
+        xmlXPathSetError(ctxt, XPATH_MEMORY_ERROR);
+        return;
+    }
+    valuePush(ctxt, xmlXPathNewString(utf8));
+    free(utf8);
+}
+
+/* a language or an option the function does not take stops the transformation */
+static void msxsl_error(xmlXPathParserContextPtr ctxt, const char *function)
+{
+    xsltTransformError(xsltXPathGetTransformContext(ctxt), NULL, NULL, "ms:%s: invalid argument\n", function);
+    xmlXPathSetError(ctxt, XPATH_INVALID_OPERAND);
+}
+
+static void xslt_string_compare(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    BSTR x, y, language = NULL, options = NULL;
+    int result;
+
+    if (nargs < 2 || nargs > 4)
+    {
+        xmlXPathSetArityError(ctxt);
+        return;
+    }
+    if (nargs == 4) options = pop_string(ctxt);
+    if (nargs >= 3) language = pop_string(ctxt);
+    y = pop_string(ctxt);
+    x = pop_string(ctxt);
+    if (x && y && SUCCEEDED(msxsl_string_compare(x, y, language, options, &result)))
+        valuePush(ctxt, xmlXPathNewFloat(result));
+    else
+        msxsl_error(ctxt, "string-compare");
+    SysFreeString(x);
+    SysFreeString(y);
+    SysFreeString(language);
+    SysFreeString(options);
+}
+
+static void xslt_utc(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    BSTR value;
+
+    CHECK_ARITY(1);
+    value = pop_string(ctxt);
+    push_string(ctxt, msxsl_utc(value ? value : L""));
+    SysFreeString(value);
+}
+
+static void xslt_number(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    BSTR value;
+
+    CHECK_ARITY(1);
+    value = pop_string(ctxt);
+    valuePush(ctxt, xmlXPathNewFloat(msxsl_number(value ? value : L"")));
+    SysFreeString(value);
+}
+
+static void xslt_local_name(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    BSTR value;
+
+    CHECK_ARITY(1);
+    value = pop_string(ctxt);
+    push_string(ctxt, msxsl_local_name(value ? value : L""));
+    SysFreeString(value);
+}
+
+static void xslt_namespace_uri(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    const WCHAR *reserved;
+    xmlNodePtr node;
+    WCHAR *prefix;
+    xmlNsPtr ns;
+    BSTR value;
+
+    CHECK_ARITY(1);
+    value = pop_string(ctxt);
+    prefix = value ? msxsl_qname_prefix(value) : NULL;
+    SysFreeString(value);
+    if (!prefix)
+    {
+        valuePush(ctxt, xmlXPathNewCString(""));
+        return;
+    }
+    if ((reserved = msxsl_reserved_namespace(prefix)))
+    {
+        push_string(ctxt, wcsdup(reserved));
+        free(prefix);
+        return;
+    }
+    /* the prefixes in scope on the node being looked at, not those of the stylesheet */
+    node = ctxt->context->node;
+    if (node && node->type == XML_ATTRIBUTE_NODE) node = node->parent;
+    if (node && node->type == XML_ELEMENT_NODE)
+    {
+        xmlChar *prefix_utf8 = xmlchar_from_wchar(prefix);
+        ns = xmlSearchNs(node->doc, node, prefix_utf8);
+        free(prefix_utf8);
+        valuePush(ctxt, xmlXPathNewString(ns ? ns->href : BAD_CAST ""));
+    }
+    else
+        valuePush(ctxt, xmlXPathNewCString(""));
+    free(prefix);
+}
+
+static void xslt_format(xmlXPathParserContextPtr ctxt, int nargs, BOOL time)
+{
+    BSTR value, format = NULL, language = NULL;
+    WCHAR *out;
+
+    if (nargs < 1 || nargs > 3)
+    {
+        xmlXPathSetArityError(ctxt);
+        return;
+    }
+    if (nargs == 3) language = pop_string(ctxt);
+    if (nargs >= 2) format = pop_string(ctxt);
+    value = pop_string(ctxt);
+    if (SUCCEEDED(msxsl_format_date(value ? value : L"", format, language, time, &out)))
+        push_string(ctxt, out);
+    else
+        msxsl_error(ctxt, time ? "format-time" : "format-date");
+    SysFreeString(value);
+    SysFreeString(format);
+    SysFreeString(language);
+}
+
+static void xslt_format_date(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    xslt_format(ctxt, nargs, FALSE);
+}
+
+static void xslt_format_time(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    xslt_format(ctxt, nargs, TRUE);
+}
+
+/* without a schema no node has a type */
+static void xslt_type_name(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    if (nargs > 1)
+    {
+        xmlXPathSetArityError(ctxt);
+        return;
+    }
+    if (nargs) xmlXPathFreeObject(valuePop(ctxt));
+    valuePush(ctxt, xmlXPathNewCString(""));
+}
+
+static void xslt_schema_info_available(xmlXPathParserContextPtr ctxt, int nargs)
+{
+    CHECK_ARITY(0);
+    valuePush(ctxt, xmlXPathNewBoolean(0));
+}
+
+/* MSXML 4.0 brought the functions; ms:type-is() needs a schema and stays unknown */
+void msxsl_register_xslt_functions(xsltTransformContextPtr ctxt)
+{
+    static const struct
+    {
+        const char *name;
+        xmlXPathFunction func;
+    }
+    functions[] =
+    {
+        { "string-compare", xslt_string_compare },
+        { "utc", xslt_utc },
+        { "number", xslt_number },
+        { "local-name", xslt_local_name },
+        { "namespace-uri", xslt_namespace_uri },
+        { "format-date", xslt_format_date },
+        { "format-time", xslt_format_time },
+        { "type-local-name", xslt_type_name },
+        { "type-namespace-uri", xslt_type_name },
+        { "schema-info-available", xslt_schema_info_available },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(functions); i++)
+        xsltRegisterExtFunction(ctxt, BAD_CAST functions[i].name, BAD_CAST "urn:schemas-microsoft-com:xslt",
+                functions[i].func);
+}
