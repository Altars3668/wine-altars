+/* UTF-8 as RFC 3629 has it: no overlong forms, surrogates or code points past U+10FFFF. */
+static BOOL check_utf8( struct utf8_check *check, const BYTE *bytes, DWORD len )
+{
+    DWORD i;
+
+    for (i = 0; i < len; i++)
+    {
+        BYTE c = bytes[i];
+
+        if (check->pending)
+        {
+            if (c < check->lower || c > check->upper) return FALSE;
+            check->pending--;
+            check->lower = 0x80;
+            check->upper = 0xbf;
+            continue;
+        }
+        if (c < 0x80) continue;
+        check->lower = 0x80;
+        check->upper = 0xbf;
+        if (c >= 0xc2 && c <= 0xdf) check->pending = 1;
+        else if (c >= 0xe0 && c <= 0xef)
+        {
+            check->pending = 2;
+            if (c == 0xe0) check->lower = 0xa0;
+            else if (c == 0xed) check->upper = 0x9f;
+        }
+        else if (c >= 0xf0 && c <= 0xf4)
+        {
+            check->pending = 3;
+            if (c == 0xf0) check->lower = 0x90;
+            else if (c == 0xf4) check->upper = 0x8f;
+        }
+        else return FALSE;
+    }
+    return TRUE;
+}
