+static BOOL server_recv_all(int c, unsigned char *buf, int len)
+{
+    int r;
+
+    while (len)
+    {
+        if ((r = recv(c, (char *)buf, len, 0)) <= 0) return FALSE;
+        buf += r;
+        len -= r;
+    }
+    return TRUE;
+}
+
+/* the frames a client sends, up to its close frame, as "opcode:payload" */
+static void server_read_websocket_frames(int c)
+{
+    unsigned char head[2], mask[4], payload[125];
+    int len, i;
+
+    websocket_frames[0] = 0;
+    for (;;)
+    {
+        if (!server_recv_all(c, head, 2)) break;
+        len = head[1] & 0x7f;
+        if (len > 125 || !server_recv_all(c, mask, 4) || !server_recv_all(c, payload, len)) break;
+        for (i = 0; i < len; i++) payload[i] ^= mask[i % 4];
+        if ((head[0] & 0x0f) == 8 && len >= 2)
+            sprintf(websocket_frames + strlen(websocket_frames), "%02x:%u:%.*s ", head[0],
+                    (payload[0] << 8) | payload[1], len - 2, payload + 2);
+        else
+            sprintf(websocket_frames + strlen(websocket_frames), "%02x:%.*s ", head[0], len, payload);
+        if ((head[0] & 0x0f) == 8) break;
+    }
+    SetEvent(websocket_event);
+}
