+/* A server breaking the protocol, or going away, ends the connection: every later call fails alike. */
+static void test_websocket_protocol(int port)
+{
+    HINTERNET session, connection, socket;
+    WINHTTP_WEB_SOCKET_BUFFER_TYPE type;
+    USHORT close_status;
+    DWORD error, count, len;
+    char buf[128];
+    int i;
+
+    if (!pWinHttpWebSocketCompleteUpgrade)
+    {
+        win_skip("WinHttpWebSocketCompleteUpgrade not supported\n");
+        return;
+    }
+
+    websocket_event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    session = WinHttpOpen(L"winetest", 0, NULL, NULL, 0);
+    ok(session != NULL, "got %lu\n", GetLastError());
+    connection = WinHttpConnect(session, L"localhost", port, 0);
+    ok(connection != NULL, "got %lu\n", GetLastError());
+
+    /* a close status no close frame may carry, a reason or a text that is not UTF-8, a fragmented ping */
+    for (i = 0; i < 7; i++)
+    {
+        if (i == 3 || i == 4 || i == 5) continue;
+        winetest_push_context("%d", i);
+        socket = upgrade_to_raw_websocket(connection, i);
+        count = 0xdeadbeef;
+        error = pWinHttpWebSocketReceive(socket, buf, sizeof(buf), &count, &type);
+        ok(error == ERROR_WINHTTP_INVALID_SERVER_RESPONSE, "got %lu\n", error);
+        ok(count == 0xdeadbeef, "got %lu\n", count);
+        error = pWinHttpWebSocketQueryCloseStatus(socket, &close_status, buf, sizeof(buf), &len);
+        ok(error == ERROR_INVALID_OPERATION, "got %lu\n", error);
+        error = pWinHttpWebSocketReceive(socket, buf, sizeof(buf), &count, &type);
+        ok(error == ERROR_WINHTTP_INVALID_SERVER_RESPONSE, "got %lu\n", error);
+        error = pWinHttpWebSocketSend(socket, WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE, (void *)"s", 1);
+        ok(error == ERROR_WINHTTP_INVALID_SERVER_RESPONSE, "got %lu\n", error);
+        error = pWinHttpWebSocketShutdown(socket, 1000, NULL, 0);
+        ok(error == ERROR_WINHTTP_INVALID_SERVER_RESPONSE, "got %lu\n", error);
+        error = pWinHttpWebSocketClose(socket, 1000, NULL, 0);
+        ok(error == ERROR_WINHTTP_INVALID_SERVER_RESPONSE, "got %lu\n", error);
+        WinHttpCloseHandle(socket);
+        ok(!WaitForSingleObject(websocket_event, 5000), "the connection was not dropped\n");
+        ok(!websocket_frames[0], "got %s\n", debugstr_a(websocket_frames));
+        winetest_pop_context();
+    }
+
+    /* a message where another had not ended */
+    socket = upgrade_to_raw_websocket(connection, 7);
+    error = pWinHttpWebSocketReceive(socket, buf, sizeof(buf), &count, &type);
+    ok(!error, "got %lu\n", error);
+    ok(type == WINHTTP_WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE, "got %u\n", type);
+    error = pWinHttpWebSocketReceive(socket, buf, sizeof(buf), &count, &type);
+    ok(error == ERROR_WINHTTP_INVALID_SERVER_RESPONSE, "got %lu\n", error);
+    error = pWinHttpWebSocketSend(socket, WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE, (void *)"s", 1);
+    ok(error == ERROR_WINHTTP_INVALID_SERVER_RESPONSE, "got %lu\n", error);
+    WinHttpCloseHandle(socket);
+    ok(!WaitForSingleObject(websocket_event, 5000), "the connection was not dropped\n");
+
+    /* a ping is answered with its data, in the course of a receive */
+    socket = upgrade_to_raw_websocket(connection, 3);
+    count = 0xdeadbeef;
+    type = 0xdeadbeef;
+    error = pWinHttpWebSocketReceive(socket, buf, sizeof(buf), &count, &type);
+    ok(!error, "got %lu\n", error);
+    ok(type == WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE, "got %u\n", type);
+    ok(count == 1 && buf[0] == 'z', "got %lu\n", count);
+    error = pWinHttpWebSocketShutdown(socket, 1000, NULL, 0);
+    ok(!error, "got %lu\n", error);
+    ok(!WaitForSingleObject(websocket_event, 5000), "the server saw no close frame\n");
+    ok(!strcmp(websocket_frames, "8a:abc 88:1000: "), "got %s\n", debugstr_a(websocket_frames));
