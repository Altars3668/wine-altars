+/* A connection the peer broke the protocol on, or that went away, is done with: every later call on
+ * the socket fails with what ended it, and one still up is dropped at once. */
+static DWORD socket_fail( struct socket *socket, DWORD ret )
+{
+    if (!ret || ret == WSAETIMEDOUT || socket->failed) return ret;
+    socket->failed = ret;
+    if (ret == ERROR_WINHTTP_INVALID_SERVER_RESPONSE) netconn_cancel_io( socket->netconn );
+    return ret;
+}
+
+/* The statuses a close frame may carry (RFC 6455 7.4); 1005 only ever stands for an empty one. */
+static BOOL is_valid_close_status( USHORT status )
+{
+    return (status >= 1000 && status <= 1003) || (status >= 1007 && status <= 1011) || status >= 3000;
+}
