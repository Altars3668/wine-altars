From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 16:38:02 -0400
Subject: [PATCH] msxml3: Implement IXMLDOMDocument3::importNode().

It was a stub returning E_NOTIMPL.  As documented for MSXML 6, the
result is a clone of the node, deep or not, owned by the importing
document and not in its tree yet, so that it can be appended there;
documents, document types, entities and notations cannot be imported
(E_FAIL).  The clone keeps the prefixes and namespaces of the node and
its attributes, as cloneNode() does, and the original stays where it
was.

The new test crashes on the stub.  It has not been run on Windows yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/domdoc.c b/dlls/msxml3/domdoc.c
index 590f3f6de08..a60285ad654 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -2041,9 +2041,25 @@ static HRESULT WINAPI domdoc_getProperty(IXMLDOMDocument3 *iface, BSTR p, VARIAN
 
 static HRESULT WINAPI domdoc_importNode(IXMLDOMDocument3 *iface, IXMLDOMNode *node, VARIANT_BOOL deep, IXMLDOMNode **clone)
 {
-    FIXME("%p, %p, %d, %p: stub\n", iface, node, deep, clone);
+    domdoc *doc = impl_from_IXMLDOMDocument3(iface);
+    struct domnode *src, *cloned;
+    HRESULT hr;
 
-    return E_NOTIMPL;
+    TRACE("%p, %p, %d, %p.\n", iface, node, deep, clone);
+
+    if (!clone)
+        return E_INVALIDARG;
+    *clone = NULL;
+    if (!node || !(src = get_node_obj(node)))
+        return E_INVALIDARG;
+
+    if (FAILED(hr = node_import_domnode(src, !!deep, doc->node, &cloned)))
+        return hr;
+
+    if (FAILED(hr = create_node(cloned, clone)))
+        domnode_destroy_tree(cloned);
+
+    return hr;
 }
 
 static const struct IXMLDOMDocument3Vtbl XMLDOMDocument3Vtbl =
diff --git a/dlls/msxml3/msxml_private.h b/dlls/msxml3/msxml_private.h
index 1a1c32248a8..1c36e839b77 100644
--- a/dlls/msxml3/msxml_private.h
+++ b/dlls/msxml3/msxml_private.h
@@ -289,6 +289,7 @@ extern struct domnode *domnode_get_previous_sibling(struct domnode *node);
 extern HRESULT domnode_get_attribute(const struct domnode *node, const WCHAR *name, struct domnode **attr);
 extern bool domnode_is_namespace_declaration(const struct domnode *node);
 extern HRESULT node_clone_domnode(struct domnode *, bool, struct domnode **);
+extern HRESULT node_import_domnode(struct domnode *, bool, struct domnode *, struct domnode **);
 extern HRESULT parse_stream(ISequentialStream *stream, bool utf16, const struct domdoc_properties *properties,
         struct domnode **tree, struct parse_error *error);
 extern void dump_doc_refcounts(struct domnode *node);
diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index e1487030224..79448003b25 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -1470,7 +1470,7 @@ void domnode_release(struct domnode *node)
 }
 
 /* TODO: needs to handle allocation failures */
-HRESULT node_clone_domnode(struct domnode *node, bool deep, struct domnode **cloned)
+static HRESULT clone_domnode(struct domnode *node, bool deep, struct domnode *owner, struct domnode **cloned)
 {
     struct domnode *object, *n, *child;
     HRESULT hr;
@@ -1478,7 +1478,7 @@ HRESULT node_clone_domnode(struct domnode *node, bool deep, struct domnode **clo
     *cloned = NULL;
 
     if (FAILED(hr = domnode_create(node->type, node->qname, SysStringLen(node->qname), node->uri, SysStringLen(node->uri),
-            node->owner, &object)))
+            owner ? owner : node->owner, &object)))
     {
         return hr;
     }
@@ -1492,14 +1492,14 @@ HRESULT node_clone_domnode(struct domnode *node, bool deep, struct domnode **clo
     {
         LIST_FOR_EACH_ENTRY(n, &node->children, struct domnode, entry)
         {
-            node_clone_domnode(n, true, &child);
+            clone_domnode(n, true, owner, &child);
             domnode_append_child(object, child);
         }
     }
 
     LIST_FOR_EACH_ENTRY(n, &node->attributes, struct domnode, entry)
     {
-        node_clone_domnode(n, true, &child);
+        clone_domnode(n, true, owner, &child);
         domnode_insert_attribute(object, child, NULL);
     }
 
@@ -1511,6 +1511,28 @@ HRESULT node_clone_domnode(struct domnode *node, bool deep, struct domnode **clo
     return hr;
 }
 
+HRESULT node_clone_domnode(struct domnode *node, bool deep, struct domnode **cloned)
+{
+    return clone_domnode(node, deep, NULL, cloned);
+}
+
+/* A clone owned by another document, not in its tree yet. */
+HRESULT node_import_domnode(struct domnode *node, bool deep, struct domnode *doc, struct domnode **cloned)
+{
+    *cloned = NULL;
+
+    switch (node->type)
+    {
+    case NODE_DOCUMENT:
+    case NODE_DOCUMENT_TYPE:
+    case NODE_ENTITY:
+    case NODE_NOTATION:
+        return E_FAIL;
+    default:
+        return clone_domnode(node, deep, doc, cloned);
+    }
+}
+
 HRESULT node_clone(struct domnode *node, VARIANT_BOOL deep, IXMLDOMNode **out)
 {
     struct domnode *cloned_node;
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index c3306e5a054..a8df5861ce1 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -6743,6 +6743,98 @@ static void test_cloneNode_prefix(void)
     free_bstrs();
 }
 
+static void test_importNode(void)
+{
+    IXMLDOMNode *node, *clone, *parent, *added;
+    IXMLDOMDocument3 *doc, *doc2;
+    IXMLDOMDocument *owner;
+    IXMLDOMElement *root, *root2;
+    VARIANT_BOOL b;
+    HRESULT hr;
+    BSTR str, str2;
+
+    doc = create_document_version(60, &IID_IXMLDOMDocument3);
+    doc2 = create_document_version(60, &IID_IXMLDOMDocument3);
+    hr = IXMLDOMDocument3_loadXML(doc, _bstr_("<r xmlns:p=\"urn:p\"><p:f p:a=\"2\"><p:g/>text</p:f></r>"), &b);
+    ok(hr == S_OK && b == VARIANT_TRUE, "Unexpected load %#lx, %d.\n", hr, b);
+    hr = IXMLDOMDocument3_loadXML(doc2, _bstr_("<t/>"), &b);
+    ok(hr == S_OK && b == VARIANT_TRUE, "Unexpected load %#lx, %d.\n", hr, b);
+    hr = IXMLDOMDocument3_get_documentElement(doc, &root);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMElement_get_firstChild(root, &node);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* a deep clone, owned by the importing document and not in its tree */
+    hr = IXMLDOMDocument3_importNode(doc2, node, VARIANT_TRUE, &clone);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMNode_get_nodeName(clone, &str);
+    ok(hr == S_OK && !wcscmp(str, L"p:f"), "Unexpected name %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    hr = IXMLDOMNode_get_namespaceURI(clone, &str);
+    ok(hr == S_OK && !wcscmp(str, L"urn:p"), "Unexpected namespace %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    parent = (void *)0xdeadbeef;
+    hr = IXMLDOMNode_get_parentNode(clone, &parent);
+    ok(hr == S_FALSE && !parent, "Unexpected parent %#lx, %p.\n", hr, parent);
+    /* the owner comes back as another object, as for any node, so compare what it holds */
+    hr = IXMLDOMNode_get_ownerDocument(clone, &owner);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMDocument_get_xml(owner, &str);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMDocument3_get_xml(doc2, &str2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!wcscmp(str, str2), "Unexpected owner document %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    SysFreeString(str2);
+    IXMLDOMDocument_Release(owner);
+    hr = IXMLDOMNode_get_xml(clone, &str);
+    ok(hr == S_OK && !wcscmp(str, L"<p:f xmlns:p=\"urn:p\" p:a=\"2\"><p:g/>text</p:f>"), "Unexpected xml %s.\n",
+            debugstr_w(str));
+    SysFreeString(str);
+
+    /* it can be added to the importing document, and the original stays where it was */
+    hr = IXMLDOMDocument3_get_documentElement(doc2, &root2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMElement_appendChild(root2, clone, &added);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IXMLDOMNode_Release(added);
+    hr = IXMLDOMElement_get_xml(root2, &str);
+    ok(hr == S_OK && !wcscmp(str, L"<t><p:f xmlns:p=\"urn:p\" p:a=\"2\"><p:g/>text</p:f></t>"), "Unexpected xml %s.\n",
+            debugstr_w(str));
+    SysFreeString(str);
+    hr = IXMLDOMElement_get_xml(root, &str);
+    ok(hr == S_OK && !wcscmp(str, L"<r xmlns:p=\"urn:p\"><p:f p:a=\"2\"><p:g/>text</p:f></r>"), "Unexpected xml %s.\n",
+            debugstr_w(str));
+    SysFreeString(str);
+    IXMLDOMNode_Release(clone);
+
+    /* a shallow one keeps the attributes, not the children */
+    hr = IXMLDOMDocument3_importNode(doc2, node, VARIANT_FALSE, &clone);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMNode_get_xml(clone, &str);
+    ok(hr == S_OK && !wcscmp(str, L"<p:f xmlns:p=\"urn:p\" p:a=\"2\"/>"), "Unexpected xml %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    IXMLDOMNode_Release(clone);
+
+    /* documents cannot be imported */
+    clone = (void *)0xdeadbeef;
+    hr = IXMLDOMDocument3_importNode(doc2, (IXMLDOMNode *)doc, VARIANT_TRUE, &clone);
+    ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+    ok(!clone, "Unexpected clone %p.\n", clone);
+
+    hr = IXMLDOMDocument3_importNode(doc2, NULL, VARIANT_TRUE, &clone);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMDocument3_importNode(doc2, node, VARIANT_TRUE, NULL);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+
+    IXMLDOMElement_Release(root2);
+    IXMLDOMNode_Release(node);
+    IXMLDOMElement_Release(root);
+    IXMLDOMDocument3_Release(doc2);
+    IXMLDOMDocument3_Release(doc);
+    free_bstrs();
+}
+
 static void test_xmlTypes(void)
 {
     IXMLDOMDocument *doc;
@@ -19733,6 +19825,8 @@ START_TEST(domdoc)
     test_XSLPattern();
     test_cloneNode();
     test_cloneNode_prefix();
+    if (is_clsid_supported(&CLSID_DOMDocument60, &IID_IXMLDOMDocument3))
+        test_importNode();
     test_xsl_script();
     test_xmlTypes();
     test_save();
