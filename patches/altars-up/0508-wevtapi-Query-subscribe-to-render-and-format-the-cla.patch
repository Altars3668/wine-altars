+EVT_HANDLE WINAPI EvtOpenChannelConfig( EVT_HANDLE session, const WCHAR *path, DWORD flags )
+{
+    struct channel_config *config;
+    WCHAR *canonical;
+
+    TRACE( "%p, %s, %#lx\n", session, debugstr_w(path), flags );
+
+    if (session && !get_object( session, OBJECT_SESSION )) return NULL;
+    if (!classic_log_exists( path, &canonical ))
+    {
+        SetLastError( ERROR_EVT_CHANNEL_NOT_FOUND );
+        return NULL;
+    }
+    if (!(config = alloc_object( OBJECT_CHANNEL_CONFIG, sizeof(*config), destroy_channel_config )))
+    {
+        free( canonical );
+        return NULL;
+    }
+    config->name = canonical;
+    return add_object( &config->obj );
+}
+
+static BOOL set_variant_string( EVT_VARIANT *value, const WCHAR *str, DWORD size, DWORD *used )
+{
+    DWORD bytes = sizeof(EVT_VARIANT) + (wcslen( str ) + 1) * sizeof(WCHAR);
+
+    *used = bytes;
+    if (size < bytes || !value)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    value->StringVal = (WCHAR *)(value + 1);
+    wcscpy( (WCHAR *)(value + 1), str );
+    value->Type = EvtVarTypeString;
+    return TRUE;
+}
