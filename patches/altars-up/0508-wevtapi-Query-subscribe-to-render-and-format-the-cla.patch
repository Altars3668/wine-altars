+BOOL WINAPI EvtGetEventInfo( EVT_HANDLE handle, EVT_EVENT_PROPERTY_ID id, DWORD size, EVT_VARIANT *buffer, DWORD *used )
+{
+    struct object *obj;
+    struct event *event;
+    DWORD bytes;
+
+    TRACE( "%p, %u, %lu, %p, %p\n", handle, id, size, buffer, used );
+
+    if (!(obj = get_object( handle, OBJECT_EVENT ))) return FALSE;
+    event = impl_from_event( obj );
+    switch (id)
+    {
+    case EvtEventPath:
+        bytes = sizeof(EVT_VARIANT) + (wcslen( event->channel ) + 1) * sizeof(WCHAR);
+        *used = bytes;
+        if (size < bytes || !buffer)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        buffer->Type = EvtVarTypeString;
+        buffer->Count = 0;
+        buffer->StringVal = (WCHAR *)(buffer + 1);
+        wcscpy( (WCHAR *)(buffer + 1), event->channel );
+        return TRUE;
+    case EvtEventQueryIDs:
+        *used = sizeof(EVT_VARIANT) + sizeof(DWORD);
+        if (size < *used || !buffer)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        buffer->Type = EvtVarTypeUInt32 | EVT_VARIANT_TYPE_ARRAY;
+        buffer->Count = 1;
+        buffer->UInt32Arr = (UINT32 *)(buffer + 1);
+        buffer->UInt32Arr[0] = 0;
+        return TRUE;
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+}
+
+BOOL WINAPI EvtGetQueryInfo( EVT_HANDLE handle, EVT_QUERY_PROPERTY_ID id, DWORD size, EVT_VARIANT *buffer, DWORD *used )
+{
+    struct object *obj;
+    struct query *query;
+    unsigned int i;
+    DWORD bytes;
+
+    TRACE( "%p, %u, %lu, %p, %p\n", handle, id, size, buffer, used );
+
+    if (!(obj = get_object( handle, OBJECT_QUERY ))) return FALSE;
+    query = impl_from_query( obj );
+    switch (id)
+    {
+    case EvtQueryNames:
+    {
+        WCHAR **names, *str;
+
+        bytes = sizeof(EVT_VARIANT) + query->source_count * sizeof(WCHAR *);
+        for (i = 0; i < query->source_count; i++) bytes += (wcslen( query->sources[i].path ) + 1) * sizeof(WCHAR);
+        *used = bytes;
+        if (size < bytes || !buffer)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        buffer->Type = EvtVarTypeString | EVT_VARIANT_TYPE_ARRAY;
+        buffer->Count = query->source_count;
+        names = (WCHAR **)(buffer + 1);
+        str = (WCHAR *)(names + query->source_count);
+        buffer->StringArr = names;
+        for (i = 0; i < query->source_count; i++)
+        {
+            names[i] = str;
+            wcscpy( str, query->sources[i].path );
+            str += wcslen( str ) + 1;
+        }
+        return TRUE;
+    }
+    case EvtQueryStatuses:
+        bytes = sizeof(EVT_VARIANT) + query->source_count * sizeof(UINT32);
+        *used = bytes;
+        if (size < bytes || !buffer)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        buffer->Type = EvtVarTypeUInt32 | EVT_VARIANT_TYPE_ARRAY;
+        buffer->Count = query->source_count;
+        buffer->UInt32Arr = (UINT32 *)(buffer + 1);
+        memset( buffer->UInt32Arr, 0, query->source_count * sizeof(UINT32) );
+        return TRUE;
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+}
