+    if (rpc->Server && rpc->Server[0] && wcsicmp( rpc->Server, L"localhost" ) && wcscmp( rpc->Server, L"." ) &&
+        (!GetComputerNameExW( ComputerNameDnsHostname, name, &size ) || wcsicmp( rpc->Server, name )))
