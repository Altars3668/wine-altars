+#include "wevtapi_private.h"
+#include "winternl.h"
+#include "sddl.h"
+#include <stdio.h>
+
+
+WCHAR *strdupW( const WCHAR *str )
+{
+    WCHAR *ret;
+
+    if (!str) return NULL;
+    if ((ret = malloc( (wcslen( str ) + 1) * sizeof(WCHAR) ))) wcscpy( ret, str );
+    return ret;
+}
+
+/* the keywords Windows gives the events of the classic logs, and their audits */
+#define KEYWORD_CLASSIC        0x0080000000000000ull
+#define KEYWORD_AUDIT_SUCCESS  0x0020000000000000ull
+#define KEYWORD_AUDIT_FAILURE  0x0010000000000000ull
+
+static WCHAR *format_number( ULONGLONG value, BOOL hex )
+{
+    WCHAR buffer[32];
+
+    swprintf( buffer, ARRAY_SIZE(buffer), hex ? L"0x%I64x" : L"%I64u", value );
+    return strdupW( buffer );
+}
+
+static WCHAR *format_system_time( DWORD seconds )
+{
+    LARGE_INTEGER time;
+    TIME_FIELDS tf;
+    WCHAR buffer[40];
+
+    RtlSecondsSince1970ToTime( seconds, &time );
+    RtlTimeToTimeFields( &time, &tf );
+    swprintf( buffer, ARRAY_SIZE(buffer), L"%04u-%02u-%02uT%02u:%02u:%02u.%07uZ", tf.Year, tf.Month, tf.Day,
+              tf.Hour, tf.Minute, tf.Second, (unsigned int)(time.QuadPart % 10000000) );
+    return strdupW( buffer );
+}
+
+BOOL parse_system_time( const WCHAR *text, FILETIME *ft )
+{
+    TIME_FIELDS tf = { 0 };
+    LARGE_INTEGER time;
+    unsigned int year, month, day, hour = 0, minute = 0, second = 0;
+    ULONGLONG fraction = 0, scale = 10000000;
+    const WCHAR *p;
+
+    if (!text || swscanf( text, L"%4u-%2u-%2u", &year, &month, &day ) != 3) return FALSE;
+    if ((p = wcschr( text, 'T' ))) swscanf( p + 1, L"%2u:%2u:%2u", &hour, &minute, &second );
+    if (p && (p = wcschr( p, '.' )))
+        for (p++; *p >= '0' && *p <= '9'; p++)
+        {
+            if (scale > 1)
+            {
+                scale /= 10;
+                fraction += (*p - '0') * scale;
+            }
+        }
+    tf.Year = year;
+    tf.Month = month;
+    tf.Day = day;
+    tf.Hour = hour;
+    tf.Minute = minute;
+    tf.Second = second;
+    if (!RtlTimeFieldsToTime( &tf, &time )) return FALSE;
+    time.QuadPart += fraction;
+    ft->dwLowDateTime = time.u.LowPart;
+    ft->dwHighDateTime = time.u.HighPart;
+    return TRUE;
+}
+
+ULONGLONG node_number( const WCHAR *text )
+{
+    if (!text) return 0;
+    while (*text == ' ') text++;
+    if (text[0] == '0' && (text[1] == 'x' || text[1] == 'X')) return wcstoull( text + 2, NULL, 16 );
+    return wcstoull( text, NULL, 10 );
+}
+
+/* whether a string is a number all through, decimal or 0x hexadecimal: "10.00." compares with 10 as a string */
+static BOOL string_number( const WCHAR *text, LONGLONG *number )
+{
+    WCHAR *end;
+
+    while (*text == ' ') text++;
+    if (!*text) return FALSE;
+    if (text[0] == '0' && (text[1] == 'x' || text[1] == 'X'))
+    {
+        if (!text[2]) return FALSE;
+        *number = wcstoull( text + 2, &end, 16 );
+    }
+    else *number = wcstoll( text, &end, 10 );
+    while (*end == ' ') end++;
+    return !*end;
+}
+
+static struct node *add_child( struct node *parent, const WCHAR *name, WCHAR *text, unsigned int type )
+{
+    struct node *node = &parent->children[parent->child_count++];
+
+    memset( node, 0, sizeof(*node) );
+    node->name = name;
+    node->text = text;
+    node->type = type;
+    return node;
+}
+
+static void add_attr( struct node *node, const WCHAR *name, WCHAR *value, unsigned int type )
+{
+    node->attr_names[node->attr_count] = name;
+    node->attr_values[node->attr_count++] = value;
+    if (node->attr_count == 1) node->attr_type = type;
+}
+
+static void free_node_contents( struct node *node )
+{
+    unsigned int i;
+
+    for (i = 0; i < node->attr_count; i++) free( node->attr_values[i] );
+    for (i = 0; i < node->child_count; i++) free_node_contents( &node->children[i] );
+    free( node->children );
+    free( node->text );
+}
+
+void free_node( struct node *root )
+{
+    if (!root) return;
+    free_node_contents( root );
+    free( root );
+}
+
+/* The tree of an event, as Windows 11 renders those of the classic logs: the System element with the provider,
+ * the event ID and its qualifiers, version, level, task (the category), opcode, the classic keyword, the time,
+ * the record number, the process, the channel, the computer and the user; then EventData, a Data element for each
+ * string and Binary for the data. */
+struct node *build_event_tree( const struct event *event )
+{
+    const EVENTLOGRECORD *rec = event->record;
+    const WCHAR *source = (const WCHAR *)(rec + 1), *computer = source + wcslen( source ) + 1;
+    const WCHAR *str = (const WCHAR *)((const BYTE *)rec + rec->StringOffset);
+    struct node *root, *system, *data, *node;
+    ULONGLONG keywords = KEYWORD_CLASSIC;
+    unsigned int level, i;
+    WCHAR *sid = NULL;
+
+    if (!(root = calloc( 1, sizeof(*root) ))) return NULL;
+    root->name = L"Event";
+    root->children = calloc( 2, sizeof(*root->children) );
+    system = add_child( root, L"System", NULL, EvtVarTypeNull );
+    data = add_child( root, L"EventData", NULL, EvtVarTypeNull );
+    system->children = calloc( 14, sizeof(*system->children) );
+    data->children = calloc( rec->NumStrings + 1, sizeof(*data->children) );
+
+    switch (rec->EventType)
+    {
+    case EVENTLOG_ERROR_TYPE:   level = 2; break;
+    case EVENTLOG_WARNING_TYPE: level = 3; break;
+    case EVENTLOG_AUDIT_SUCCESS: level = 0; keywords |= KEYWORD_AUDIT_SUCCESS; break;
+    case EVENTLOG_AUDIT_FAILURE: level = 0; keywords |= KEYWORD_AUDIT_FAILURE; break;
+    default:                    level = 4; break;
+    }
+
+    node = add_child( system, L"Provider", NULL, EvtVarTypeNull );
+    add_attr( node, L"Name", strdupW( source ), EvtVarTypeString );
+    node = add_child( system, L"EventID", format_number( rec->EventID & 0xffff, FALSE ), EvtVarTypeUInt16 );
+    add_attr( node, L"Qualifiers", format_number( rec->EventID >> 16, FALSE ), EvtVarTypeUInt16 );
+    add_child( system, L"Version", strdupW( L"0" ), EvtVarTypeByte );
+    add_child( system, L"Level", format_number( level, FALSE ), EvtVarTypeByte );
+    add_child( system, L"Task", format_number( rec->EventCategory, FALSE ), EvtVarTypeUInt16 );
+    add_child( system, L"Opcode", strdupW( L"0" ), EvtVarTypeByte );
+    add_child( system, L"Keywords", format_number( keywords, TRUE ), EvtVarTypeHexInt64 );
+    node = add_child( system, L"TimeCreated", NULL, EvtVarTypeNull );
+    add_attr( node, L"SystemTime", format_system_time( rec->TimeGenerated ), EvtVarTypeFileTime );
+    add_child( system, L"EventRecordID", format_number( rec->RecordNumber, FALSE ), EvtVarTypeUInt64 );
+    add_child( system, L"Correlation", NULL, EvtVarTypeNull );
+    node = add_child( system, L"Execution", NULL, EvtVarTypeNull );
+    add_attr( node, L"ProcessID", strdupW( L"0" ), EvtVarTypeUInt32 );
+    add_attr( node, L"ThreadID", strdupW( L"0" ), EvtVarTypeUInt32 );
+    add_child( system, L"Channel", strdupW( event->channel ), EvtVarTypeString );
+    add_child( system, L"Computer", strdupW( computer ), EvtVarTypeString );
+    node = add_child( system, L"Security", NULL, EvtVarTypeNull );
+    if (rec->UserSidLength && ConvertSidToStringSidW( (PSID)((const BYTE *)rec + rec->UserSidOffset), &sid ))
+    {
+        add_attr( node, L"UserID", strdupW( sid ), EvtVarTypeSid );
+        LocalFree( sid );
+    }
+
+    for (i = 0; i < rec->NumStrings; i++)
+    {
+        add_child( data, L"Data", strdupW( str ), EvtVarTypeString )->array_item = TRUE;
+        str += wcslen( str ) + 1;
+    }
+    if (rec->DataLength)
+    {
+        const BYTE *bytes = (const BYTE *)rec + rec->DataOffset;
+        WCHAR *hex = malloc( (rec->DataLength * 2 + 1) * sizeof(WCHAR) );
+        DWORD j;
+
+        if (hex)
+        {
+            for (j = 0; j < rec->DataLength; j++) swprintf( hex + j * 2, 3, L"%02X", bytes[j] );
+            hex[rec->DataLength * 2] = 0;
+        }
+        add_child( data, L"Binary", hex, EvtVarTypeBinary );
+    }
+    return root;
+}
+
+struct strbuf
+{
+    WCHAR *data;
+    size_t len, size;
+};
+
+static void append( struct strbuf *buf, const WCHAR *str, size_t len )
+{
+    if (buf->len + len + 1 > buf->size)
+    {
+        size_t size = max( buf->size * 2, buf->len + len + 256 );
+        WCHAR *data = realloc( buf->data, size * sizeof(WCHAR) );
+        if (!data) return;
+        buf->data = data;
+        buf->size = size;
+    }
+    memcpy( buf->data + buf->len, str, len * sizeof(WCHAR) );
+    buf->len += len;
+    buf->data[buf->len] = 0;
+}
+
+static void append_str( struct strbuf *buf, const WCHAR *str )
+{
+    append( buf, str, wcslen( str ) );
+}
+
+static void append_escaped( struct strbuf *buf, const WCHAR *str, BOOL attr )
+{
+    for (; *str; str++)
+    {
+        switch (*str)
+        {
+        case '&': append_str( buf, L"&amp;" ); break;
+        case '<': append_str( buf, L"&lt;" ); break;
+        case '>': append_str( buf, L"&gt;" ); break;
+        case '\'': if (attr) { append_str( buf, L"&apos;" ); break; } /* fall through */
+        default: append( buf, str, 1 ); break;
+        }
+    }
+}
+
+/* an element, with what is in it; one with neither text nor elements is an empty element */
+/* a string as XML text */
+WCHAR *escape_xml( const WCHAR *str )
+{
+    struct strbuf buf = { 0 };
+
+    append( &buf, L"", 0 );
+    append_escaped( &buf, str, FALSE );
+    return buf.data;
+}
+
+static void write_element( struct strbuf *buf, const struct node *node )
+{
+    unsigned int i;
+
+    append_str( buf, L"<" );
+    append_str( buf, node->name );
+    for (i = 0; i < node->attr_count; i++)
+    {
+        append_str( buf, L" " );
+        append_str( buf, node->attr_names[i] );
+        append_str( buf, L"='" );
+        append_escaped( buf, node->attr_values[i] ? node->attr_values[i] : L"", TRUE );
+        append_str( buf, L"'" );
+    }
+    if (!node->text && !node->child_count)
+    {
+        append_str( buf, L"/>" );
+        return;
+    }
+    append_str( buf, L">" );
+    if (node->text) append_escaped( buf, node->text, FALSE );
+    for (i = 0; i < node->child_count; i++) write_element( buf, &node->children[i] );
+    append_str( buf, L"</" );
+    append_str( buf, node->name );
+    append_str( buf, L">" );
+}
+
+WCHAR *write_event_xml( const struct node *tree, const WCHAR *rendering )
+{
+    struct strbuf buf = { 0 };
+    unsigned int i;
+
+    append_str( &buf, L"<Event xmlns='http://schemas.microsoft.com/win/2004/08/events/event'>" );
+    for (i = 0; i < tree->child_count; i++) write_element( &buf, &tree->children[i] );
+    if (rendering) append_str( &buf, rendering );
+    append_str( &buf, L"</Event>" );
+    return buf.data;
+}
+
+/*
+ * The XPath the event log takes: a path to the events -- "*" or Event, then System, EventData... -- with
+ * predicates of comparisons (=, !=, <, <=, >, >=) joined by "and" and "or", of paths, attributes, strings and
+ * numbers, the functions timediff() and band(), and positions, [2] or [position()=2].  not() and the rest of XPath
+ * are invalid queries, as on Windows 11.
+ *
+ * Positions are what Windows 11 makes of them.  Compared, Data[4]='Multiprocessor Free' is the fourth Data; as a
+ * test of whether there is one, only the first is looked at, so EventData[Data[1]] holds and EventData[Data[2]]
+ * never does.  Windows' answers for a position compared with != < <= > >= follow no rule there is (Data[3]>29670
+ * false and Data[3]>29671 true for the same event) and are not copied; those compare the element the position
+ * names.
+ */
+
+enum expr_type
+{
+    EXPR_PATH,
+    EXPR_STRING,
+    EXPR_NUMBER,
+    EXPR_OR,
+    EXPR_AND,
+    EXPR_COMPARE,
+    EXPR_TIMEDIFF,
+    EXPR_BAND,
+    EXPR_POSITION,
+};
+
+enum compare_op { OP_EQ, OP_NE, OP_LT, OP_LE, OP_GT, OP_GE };
+
+struct step
+{
+    WCHAR *name;                /* NULL for any element */
+    struct expr **preds;
+    unsigned int pred_count;
+    BOOL positional;            /* whether there is a position, [n] or position() */
+    BOOL has_position;
+    unsigned int position;      /* [n], 1-based; [0] is no element */
+};
+
+struct expr
+{
+    enum expr_type type;
+    enum compare_op op;
+    struct step *steps;
+    unsigned int step_count;
+    WCHAR *attr;                /* the attribute a path ends with */
+    WCHAR *string;
+    LONGLONG number;
+    struct expr *left, *right;
+    struct expr **args;         /* what "and" or "or" joins */
+    unsigned int arg_count;
+};
+
+struct xpath
+{
+    struct expr *expr;
+};
+
+struct parser
+{
+    const WCHAR *p;
+    BOOL error;
+    BOOL render_path;
+    BOOL position;              /* whether position() was seen */
+    unsigned int depth;         /* of parentheses, predicates and functions, which no query reaches */
+    unsigned int parens;
+    unsigned int preds;
+};
+
+/* How far a query may go on Windows 11: 24 parentheses within each other, 21 predicates, 23 operands joined by
+ * "and" or by "or". */
+#define MAX_DEPTH    64
+#define MAX_PARENS   24
+#define MAX_PREDS    21
+#define MAX_OPERANDS 23
+
+static void free_expr( struct expr *expr )
+{
+    unsigned int i, j;
+
+    if (!expr) return;
+    for (i = 0; i < expr->step_count; i++)
+    {
+        for (j = 0; j < expr->steps[i].pred_count; j++) free_expr( expr->steps[i].preds[j] );
+        free( expr->steps[i].preds );
+        free( expr->steps[i].name );
+    }
+    free( expr->steps );
+    free( expr->attr );
+    free( expr->string );
+    free_expr( expr->left );
+    free_expr( expr->right );
+    for (i = 0; i < expr->arg_count; i++) free_expr( expr->args[i] );
+    free( expr->args );
+    free( expr );
+}
+
+static void skip_space( struct parser *parser )
+{
+    while (*parser->p == ' ' || *parser->p == '\t' || *parser->p == '\r' || *parser->p == '\n') parser->p++;
+}
+
+static BOOL is_name_char( WCHAR c, BOOL first )
+{
+    if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || c == '_' || c > 0x7f) return TRUE;
+    return !first && ((c >= '0' && c <= '9') || c == '-' || c == '.' || c == ':');
+}
+
+static WCHAR *parse_name( struct parser *parser )
+{
+    const WCHAR *start = parser->p;
+    WCHAR *ret;
+
+    if (!is_name_char( *parser->p, TRUE )) return NULL;
+    while (is_name_char( *parser->p, FALSE )) parser->p++;
+    if (!(ret = malloc( (parser->p - start + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, start, (parser->p - start) * sizeof(WCHAR) );
+    ret[parser->p - start] = 0;
+    return ret;
+}
+
+static BOOL keyword( struct parser *parser, const WCHAR *word )
+{
+    size_t len = wcslen( word );
+
+    skip_space( parser );
+    if (wcsncmp( parser->p, word, len ) || is_name_char( parser->p[len], FALSE )) return FALSE;
+    parser->p += len;
+    return TRUE;
+}
+
+static BOOL token( struct parser *parser, WCHAR c )
+{
+    skip_space( parser );
+    if (*parser->p != c) return FALSE;
+    parser->p++;
+    return TRUE;
+}
+
+static struct expr *new_expr( enum expr_type type )
+{
+    struct expr *expr = calloc( 1, sizeof(*expr) );
+    if (expr) expr->type = type;
+    return expr;
+}
+
+static struct expr *parse_expr( struct parser *parser );
+
+/* steps, each with its predicates, and an attribute after the last one */
+static struct expr *parse_path( struct parser *parser )
+{
+    struct expr *expr = new_expr( EXPR_PATH );
+
+    if (!expr) goto error;
+    skip_space( parser );
+    for (;;)
+    {
+        struct step *step, *steps;
+
+        skip_space( parser );
+        if (*parser->p == '@')
+        {
+            parser->p++;
+            if (!(expr->attr = parse_name( parser ))) goto error;
+            break;
+        }
+        if (!(steps = realloc( expr->steps, (expr->step_count + 1) * sizeof(*steps) ))) goto error;
+        expr->steps = steps;
+        step = &expr->steps[expr->step_count++];
+        memset( step, 0, sizeof(*step) );
+        if (*parser->p == '*') parser->p++;
+        else if (!(step->name = parse_name( parser ))) goto error;
+
+        while (token( parser, '[' ))
+        {
+            struct expr **preds, *pred;
+            BOOL position = parser->position;
+
+            skip_space( parser );
+            if (*parser->p >= '0' && *parser->p <= '9')
+            {
+                if (parser->render_path) goto error;
+                step->position = wcstoul( parser->p, (WCHAR **)&parser->p, 10 );
+                step->has_position = step->positional = TRUE;
+                if (!token( parser, ']' )) goto error;
+                continue;
+            }
+            if (parser->preds >= MAX_PREDS) goto error;
+            parser->position = FALSE;
+            parser->preds++;
+            pred = parse_expr( parser );
+            parser->preds--;
+            if (parser->position) step->positional = TRUE;
+            parser->position = position;
+            if (!pred) goto error;
+            if (!(preds = realloc( step->preds, (step->pred_count + 1) * sizeof(*preds) )))
+            {
+                free_expr( pred );
+                goto error;
+            }
+            step->preds = preds;
+            step->preds[step->pred_count++] = pred;
+            if (!token( parser, ']' )) goto error;
+        }
+        skip_space( parser );
+        if (*parser->p != '/') break;
+        parser->p++;
+    }
+    return expr;
+
+error:
+    free_expr( expr );
+    parser->error = TRUE;
+    return NULL;
+}
+
+static struct expr *parse_value_inner( struct parser *parser );
+
+static struct expr *parse_value( struct parser *parser )
+{
+    struct expr *expr;
+
+    if (parser->depth >= MAX_DEPTH)
+    {
+        parser->error = TRUE;
+        return NULL;
+    }
+    parser->depth++;
+    expr = parse_value_inner( parser );
+    parser->depth--;
+    return expr;
+}
+
+static struct expr *parse_value_inner( struct parser *parser )
+{
+    struct expr *expr;
+
+    skip_space( parser );
+    if (*parser->p == '(')
+    {
+        if (parser->parens >= MAX_PARENS) goto error;
+        parser->p++;
+        parser->parens++;
+        expr = parse_expr( parser );
+        parser->parens--;
+        if (!expr || !token( parser, ')' ))
+        {
+            free_expr( expr );
+            parser->error = TRUE;
+            return NULL;
+        }
+        return expr;
+    }
+    if (*parser->p == '\'' || *parser->p == '"')
+    {
+        WCHAR quote = *parser->p++;
+        const WCHAR *end = wcschr( parser->p, quote );
+
+        if (!end || !(expr = new_expr( EXPR_STRING ))) goto error;
+        if (!(expr->string = malloc( (end - parser->p + 1) * sizeof(WCHAR) )))
+        {
+            free_expr( expr );
+            goto error;
+        }
+        memcpy( expr->string, parser->p, (end - parser->p) * sizeof(WCHAR) );
+        expr->string[end - parser->p] = 0;
+        parser->p = end + 1;
+        return expr;
+    }
+    if ((*parser->p >= '0' && *parser->p <= '9') || *parser->p == '-')
+    {
+        if (!(expr = new_expr( EXPR_NUMBER ))) goto error;
+        if (parser->p[0] == '0' && (parser->p[1] == 'x' || parser->p[1] == 'X'))
+            expr->number = wcstoull( parser->p + 2, (WCHAR **)&parser->p, 16 );
+        else
+            expr->number = wcstoll( parser->p, (WCHAR **)&parser->p, 10 );
+        return expr;
+    }
+    if (!wcsncmp( parser->p, L"timediff", 8 ))
+    {
+        const WCHAR *save = parser->p;
+
+        parser->p += 8;
+        if (token( parser, '(' ))
+        {
+            /* of a path */
+            if (!(expr = new_expr( EXPR_TIMEDIFF ))) goto error;
+            if (!(expr->left = parse_value( parser )) || expr->left->type != EXPR_PATH || !token( parser, ')' ))
+            {
+                free_expr( expr );
+                goto error;
+            }
+            return expr;
+        }
+        parser->p = save;
+    }
+    if (!wcsncmp( parser->p, L"position", 8 ) && !parser->render_path)
+    {
+        const WCHAR *save = parser->p;
+
+        parser->p += 8;
+        if (token( parser, '(' ))
+        {
+            if (!token( parser, ')' ) || !(expr = new_expr( EXPR_POSITION ))) goto error;
+            parser->position = TRUE;
+            return expr;
+        }
+        parser->p = save;
+    }
+    if (!wcsncmp( parser->p, L"band", 4 ))
+    {
+        const WCHAR *save = parser->p;
+
+        parser->p += 4;
+        if (token( parser, '(' ))
+        {
+            /* of paths and numbers, not of another band() */
+            if (!(expr = new_expr( EXPR_BAND ))) goto error;
+            if (!(expr->left = parse_value( parser )) || (expr->left->type != EXPR_PATH && expr->left->type != EXPR_NUMBER) ||
+                !token( parser, ',' ) || !(expr->right = parse_value( parser )) ||
+                (expr->right->type != EXPR_PATH && expr->right->type != EXPR_NUMBER) || !token( parser, ')' ))
+            {
+                free_expr( expr );
+                goto error;
+            }
+            return expr;
+        }
+        parser->p = save;
+    }
+    if (*parser->p == '@' || *parser->p == '*' || is_name_char( *parser->p, TRUE ))
+    {
+        /* a name followed by "(" is a function this XPath has not got */
+        const WCHAR *p = parser->p;
+        while (is_name_char( *p, FALSE )) p++;
+        while (*p == ' ') p++;
+        if (*p == '(') goto error;
+        return parse_path( parser );
+    }
+
+error:
+    parser->error = TRUE;
+    return NULL;
+}
+
+static struct expr *parse_compare( struct parser *parser )
+{
+    struct expr *left, *expr;
+    enum compare_op op;
+
+    if (!(left = parse_value( parser ))) return NULL;
+    skip_space( parser );
+    if (parser->p[0] == '=') { op = OP_EQ; parser->p += 1; }
+    else if (parser->p[0] == '!' && parser->p[1] == '=') { op = OP_NE; parser->p += 2; }
+    else if (parser->p[0] == '<' && parser->p[1] == '=') { op = OP_LE; parser->p += 2; }
+    else if (parser->p[0] == '>' && parser->p[1] == '=') { op = OP_GE; parser->p += 2; }
+    else if (parser->p[0] == '<') { op = OP_LT; parser->p += 1; }
+    else if (parser->p[0] == '>') { op = OP_GT; parser->p += 1; }
+    else return left;
+
+    if (!(expr = new_expr( EXPR_COMPARE )))
+    {
+        free_expr( left );
+        parser->error = TRUE;
+        return NULL;
+    }
+    expr->op = op;
+    expr->left = left;
+    if (!(expr->right = parse_value( parser )))
+    {
+        free_expr( expr );
+        return NULL;
+    }
+    return expr;
+}
+
+/* operands joined by "and", or by "or", as one expression */
+static struct expr *parse_joined( struct parser *parser, enum expr_type type )
+{
+    struct expr *operand, *expr, **args;
+
+    if (!(operand = type == EXPR_AND ? parse_compare( parser ) : parse_joined( parser, EXPR_AND ))) return NULL;
+    if (!keyword( parser, type == EXPR_AND ? L"and" : L"or" )) return operand;
+    if (!(expr = new_expr( type )) || !(expr->args = malloc( sizeof(*expr->args) )))
+    {
+        free( expr );
+        free_expr( operand );
+        parser->error = TRUE;
+        return NULL;
+    }
+    expr->args[expr->arg_count++] = operand;
+    do
+    {
+        if (expr->arg_count >= MAX_OPERANDS)
+        {
+            free_expr( expr );
+            parser->error = TRUE;
+            return NULL;
+        }
+        if (!(operand = type == EXPR_AND ? parse_compare( parser ) : parse_joined( parser, EXPR_AND )))
+        {
+            free_expr( expr );
+            return NULL;
+        }
+        if (!(args = realloc( expr->args, (expr->arg_count + 1) * sizeof(*args) )))
+        {
+            free_expr( operand );
+            free_expr( expr );
+            parser->error = TRUE;
+            return NULL;
+        }
+        expr->args = args;
+        expr->args[expr->arg_count++] = operand;
+    } while (keyword( parser, type == EXPR_AND ? L"and" : L"or" ));
+    return expr;
+}
+
+static struct expr *parse_expr( struct parser *parser )
+{
+    struct expr *expr;
+
+    if (parser->depth >= MAX_DEPTH)
+    {
+        parser->error = TRUE;
+        return NULL;
+    }
+    parser->depth++;
+    expr = parse_joined( parser, EXPR_OR );
+    parser->depth--;
+    return expr;
+}
+
+/* A query selects events with a path, a render context names a value with one starting at Event, with no
+ * positions; NULL for what is not XPath this takes. */
+struct xpath *parse_xpath( const WCHAR *text, BOOL render_path )
+{
+    struct parser parser = { text, FALSE, render_path, FALSE, 0, 0, 0 };
+    struct xpath *xpath;
+    struct expr *expr;
+
+    if (!text || !(expr = parse_path( &parser ))) return NULL;
+    skip_space( &parser );
+    if (parser.error || *parser.p || (render_path && (!expr->step_count || !expr->steps[0].name ||
+        wcscmp( expr->steps[0].name, L"Event" ))))
+    {
+        free_expr( expr );
+        return NULL;
+    }
+    if (!(xpath = malloc( sizeof(*xpath) )))
+    {
+        free_expr( expr );
+        return NULL;
+    }
+    xpath->expr = expr;
+    return xpath;
+}
+
+/* How a render path goes with one before it in a context: Windows 11 keeps them as one tree, where an element
+ * already there, as a path of its own or on the way to one, cannot be added again, and an attribute added again
+ * gives nothing. */
+enum path_relation render_path_relation( const struct xpath *earlier, const struct xpath *later )
+{
+    const struct expr *a = earlier->expr, *b = later->expr;
+    unsigned int i;
+
+    if (b->step_count > a->step_count) return PATH_UNRELATED;
+    for (i = 0; i < b->step_count; i++)
+    {
+        if (a->steps[i].pred_count || b->steps[i].pred_count) return PATH_UNRELATED;
+        if (!a->steps[i].name || !b->steps[i].name || wcscmp( a->steps[i].name, b->steps[i].name ))
+            return PATH_UNRELATED;
+    }
+    if (!b->attr) return PATH_CONFLICT;
+    if (b->step_count == a->step_count && a->attr && !wcscmp( a->attr, b->attr )) return PATH_SAME_ATTRIBUTE;
+    return PATH_UNRELATED;
+}
+
+void free_xpath( struct xpath *xpath )
+{
+    if (!xpath) return;
+    free_expr( xpath->expr );
+    free( xpath );
+}
+
+/* what an expression gives: elements or attributes of the tree, a string, a number, or true or false */
+struct value
+{
+    enum { VALUE_NODES, VALUE_STRING, VALUE_NUMBER, VALUE_BOOL } type;
+    const struct node *nodes[64];
+    const WCHAR *attrs[64];
+    unsigned int attr_types[64];
+    unsigned int count;
+    const WCHAR *string;
+    LONGLONG number;
+    BOOL boolean;
+    BOOL number_valid;
+};
+
+static BOOL eval( const struct expr *expr, const struct node *context, unsigned int position, struct value *value );
+static void eval_path( const struct expr *expr, const struct node *context, BOOL exists, struct value *value );
+
+/* whether the predicates hold for the element at the position; a path among them is a test of whether there is
+ * such an element */
+static BOOL eval_predicates( const struct step *step, const struct node *node, unsigned int position )
+{
+    unsigned int i;
+    struct value value;
+
+    for (i = 0; i < step->pred_count; i++)
+    {
+        if (step->preds[i]->type == EXPR_PATH) eval_path( step->preds[i], node, TRUE, &value );
+        else if (!eval( step->preds[i], node, position, &value )) return FALSE;
+        switch (value.type)
+        {
+        case VALUE_NODES: if (!value.count) return FALSE; break;
+        case VALUE_STRING: if (!value.string || !value.string[0]) return FALSE; break;
+        case VALUE_NUMBER: if (!value.number_valid || !value.number) return FALSE; break;
+        case VALUE_BOOL: if (!value.boolean) return FALSE; break;
+        }
+    }
+    return TRUE;
+}
+
+/* the elements, or attributes, a path selects; testing whether there are any, Windows looks only at the first
+ * element of a step with a position */
+static void eval_path( const struct expr *expr, const struct node *context, BOOL exists, struct value *value )
+{
+    const struct node *current[64], *next[64];
+    unsigned int count = 1, next_count, i, j, k, index, matches;
+
+    value->type = VALUE_NODES;
+    value->count = 0;
+    current[0] = context;
+    for (i = 0; i < expr->step_count; i++)
+    {
+        const struct step *step = &expr->steps[i];
+
+        next_count = 0;
+        for (j = 0; j < count; j++)
+        {
+            index = matches = 0;
+            for (k = 0; k < current[j]->child_count && next_count < ARRAY_SIZE(next); k++)
+            {
+                const struct node *child = &current[j]->children[k];
+
+                if (step->name && wcscmp( step->name, child->name )) continue;
+                if (exists && step->positional && index) break;
+                if (!eval_predicates( step, child, ++index )) continue;
+                if (step->has_position && ++matches != step->position) continue;
+                next[next_count++] = child;
+            }
+        }
+        memcpy( current, next, next_count * sizeof(*next) );
+        count = next_count;
+    }
+    for (i = 0; i < count && value->count < ARRAY_SIZE(value->nodes); i++)
+    {
+        if (expr->attr)
+        {
+            for (j = 0; j < current[i]->attr_count; j++)
+            {
+                if (wcscmp( current[i]->attr_names[j], expr->attr )) continue;
+                value->nodes[value->count] = current[i];
+                value->attrs[value->count] = current[i]->attr_values[j];
+                value->attr_types[value->count++] = j ? EvtVarTypeUInt32 : current[i]->attr_type;
+            }
+        }
+        else
+        {
+            value->nodes[value->count] = current[i];
+            value->attrs[value->count++] = NULL;
+        }
+    }
+}
+
+static const WCHAR *value_string( const struct value *value, unsigned int i )
+{
+    if (value->type == VALUE_STRING) return value->string;
+    if (value->attrs[i]) return value->attrs[i];
+    return value->nodes[i]->text ? value->nodes[i]->text : L"";
+}
+
+static BOOL eval( const struct expr *expr, const struct node *context, unsigned int position, struct value *value )
+{
+    struct value left, right;
+    unsigned int i, j;
+
+    memset( value, 0, sizeof(*value) );
+    switch (expr->type)
+    {
+    case EXPR_PATH:
+        eval_path( expr, context, FALSE, value );
+        return TRUE;
+
+    case EXPR_POSITION:
+        value->type = VALUE_NUMBER;
+        value->number = position;
+        value->number_valid = TRUE;
+        return TRUE;
+
+    case EXPR_STRING:
+        value->type = VALUE_STRING;
+        value->string = expr->string;
+        return TRUE;
+
+    case EXPR_NUMBER:
+        value->type = VALUE_NUMBER;
+        value->number = expr->number;
+        value->number_valid = TRUE;
+        return TRUE;
+
+    case EXPR_OR:
+    case EXPR_AND:
+    {
+        struct step step = { 0 };
+        BOOL r = expr->type == EXPR_AND;
+
+        /* each operand as a predicate, until one decides */
+        step.pred_count = 1;
+        for (i = 0; i < expr->arg_count && r == (expr->type == EXPR_AND); i++)
+        {
+            step.preds = &expr->args[i];
+            r = eval_predicates( &step, context, position );
+        }
+        value->type = VALUE_BOOL;
+        value->boolean = r;
+        return TRUE;
+    }
+
+    case EXPR_TIMEDIFF:
+    {
+        FILETIME ft, now;
+
+        value->type = VALUE_NUMBER;
+        if (!eval( expr->left, context, position, &left ) || left.type != VALUE_NODES || !left.count ||
+            !parse_system_time( value_string( &left, 0 ), &ft ))
+            return TRUE;
+        GetSystemTimeAsFileTime( &now );
+        value->number = ((LONGLONG)(((ULONGLONG)now.dwHighDateTime << 32) | now.dwLowDateTime) -
+                         (LONGLONG)(((ULONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime)) / 10000;
+        value->number_valid = TRUE;
+        return TRUE;
+    }
+
+    case EXPR_BAND:
+    {
+        ULONGLONG a, b;
+
+        value->type = VALUE_NUMBER;
+        if (!eval( expr->left, context, position, &left ) || !eval( expr->right, context, position, &right ))
+            return TRUE;
+        a = left.type == VALUE_NUMBER ? left.number : left.count || left.type == VALUE_STRING ?
+            node_number( value_string( &left, 0 ) ) : 0;
+        b = right.type == VALUE_NUMBER ? right.number : right.count || right.type == VALUE_STRING ?
+            node_number( value_string( &right, 0 ) ) : 0;
+        value->number = a & b;
+        value->number_valid = TRUE;
+        return TRUE;
+    }
+
+    case EXPR_COMPARE:
+    {
+        BOOL numeric, result = FALSE;
+        unsigned int left_count, right_count;
+
+        if (!eval( expr->left, context, position, &left ) || !eval( expr->right, context, position, &right ))
+            return FALSE;
+        numeric = left.type == VALUE_NUMBER || right.type == VALUE_NUMBER;
+        left_count = left.type == VALUE_NODES ? left.count : 1;
+        right_count = right.type == VALUE_NODES ? right.count : 1;
+        for (i = 0; i < left_count && !result; i++)
+        {
+            for (j = 0; j < right_count && !result; j++)
+            {
+                const WCHAR *sa = NULL, *sb = NULL;
+                WCHAR bufa[24], bufb[24];
+                LONGLONG a = 0, b = 0;
+                int cmp;
+
+                /* with a number, what is a number all through is compared as one, the rest as strings */
+                if (left.type == VALUE_NUMBER) { if (!left.number_valid) continue; a = left.number; }
+                else if (!numeric || !string_number( value_string( &left, i ), &a )) sa = value_string( &left, i );
+                if (right.type == VALUE_NUMBER) { if (!right.number_valid) continue; b = right.number; }
+                else if (!numeric || !string_number( value_string( &right, j ), &b )) sb = value_string( &right, j );
+                if (!sa && !sb) cmp = a < b ? -1 : a > b;
+                else
+                {
+                    FILETIME fa, fb;
+
+                    if (!sa)
+                    {
+                        swprintf( bufa, ARRAY_SIZE(bufa), L"%I64d", a );
+                        sa = bufa;
+                    }
+                    if (!sb)
+                    {
+                        swprintf( bufb, ARRAY_SIZE(bufb), L"%I64d", b );
+                        sb = bufb;
+                    }
+                    if (!numeric && parse_system_time( sa, &fa ) && parse_system_time( sb, &fb ))
+                        cmp = CompareFileTime( &fa, &fb );
+                    else
+                        cmp = wcsicmp( sa, sb );
+                }
+                switch (expr->op)
+                {
+                case OP_EQ: result = !cmp; break;
+                case OP_NE: result = !!cmp; break;
+                case OP_LT: result = cmp < 0; break;
+                case OP_LE: result = cmp <= 0; break;
+                case OP_GT: result = cmp > 0; break;
+                case OP_GE: result = cmp >= 0; break;
+                }
+            }
+        }
+        value->type = VALUE_BOOL;
+        value->boolean = result;
+        return TRUE;
+    }
+    }
+    return FALSE;
+}
+
+/* whether a query's path selects the event */
+BOOL match_xpath( const struct xpath *xpath, const struct node *tree )
+{
+    struct node root = { 0 };
+    struct value value;
+
+    root.name = L"";
+    root.children = (struct node *)tree;
+    root.child_count = 1;
+    if (!eval( xpath->expr, &root, 1, &value )) return FALSE;
+    return value.type == VALUE_NODES && value.count;
+}
+
+/* the element, or the attribute of it, a render path names */
+const struct node *select_xpath( const struct xpath *xpath, const struct node *tree, const WCHAR **attr,
+                                 unsigned int *attr_type )
+{
+    struct node root = { 0 };
+    struct value value;
+
+    root.name = L"";
+    root.children = (struct node *)tree;
+    root.child_count = 1;
+    *attr = NULL;
+    if (!eval( xpath->expr, &root, 1, &value ) || value.type != VALUE_NODES || !value.count) return NULL;
+    *attr = value.attrs[0];
+    *attr_type = value.attr_types[0];
+    if (xpath->expr->attr && !value.attrs[0]) return NULL;
+    return value.nodes[0];
+}
+
+/*
+ * Structured queries: <QueryList><Query Id='0' Path='...'><Select Path='...'>XPath</Select>
+ * <Suppress Path='...'>XPath</Suppress></Query>...</QueryList>.  A Select or Suppress without a path takes its
+ * query's, a query without one the path passed to EvtQuery; what a Suppress selects is left out of the events of
+ * its query's Selects of the same path.
+ */
+
+static void xml_skip_space( const WCHAR **p )
+{
+    while (**p == ' ' || **p == '\t' || **p == '\r' || **p == '\n') (*p)++;
+}
+
+static WCHAR *xml_decode( const WCHAR *start, const WCHAR *end )
+{
+    WCHAR *ret = malloc( (end - start + 1) * sizeof(WCHAR) ), *out = ret;
+
+    if (!ret) return NULL;
+    while (start < end)
+    {
+        if (*start == '&')
+        {
+            static const struct { const WCHAR *name; WCHAR c; } entities[] =
+            {
+                { L"&lt;", '<' }, { L"&gt;", '>' }, { L"&amp;", '&' }, { L"&quot;", '"' }, { L"&apos;", '\'' },
+            };
+            unsigned int i;
+
+            for (i = 0; i < ARRAY_SIZE(entities); i++)
+            {
+                size_t len = wcslen( entities[i].name );
+                if (end - start >= len && !wcsncmp( start, entities[i].name, len ))
+                {
+                    *out++ = entities[i].c;
+                    start += len;
+                    break;
+                }
+            }
+            if (i < ARRAY_SIZE(entities)) continue;
+            if (start[1] == '#')
+            {
+                const WCHAR *semi = wcschr( start, ';' );
+                if (semi && semi < end)
+                {
+                    *out++ = start[2] == 'x' ? wcstoul( start + 3, NULL, 16 ) : wcstoul( start + 2, NULL, 10 );
+                    start = semi + 1;
+                    continue;
+                }
+            }
+        }
+        *out++ = *start++;
+    }
+    *out = 0;
+    return ret;
+}
+
+/* an element's name and the value of its Path attribute; the name is NULL at a closing tag */
+static BOOL xml_tag( const WCHAR **p, WCHAR *name, size_t name_size, WCHAR **path, BOOL *closing, BOOL *empty )
+{
+    size_t len = 0;
+
+    *path = NULL;
+    *closing = *empty = FALSE;
+    xml_skip_space( p );
+    if (**p != '<') return FALSE;
+    (*p)++;
+    if (**p == '?' || **p == '!')
+    {
+        const WCHAR *end = wcschr( *p, '>' );
+        if (!end) return FALSE;
+        *p = end + 1;
+        return xml_tag( p, name, name_size, path, closing, empty );
+    }
+    if (**p == '/')
+    {
+        *closing = TRUE;
+        (*p)++;
+    }
+    while (is_name_char( **p, FALSE ) && len < name_size - 1) name[len++] = *(*p)++;
+    name[len] = 0;
+    for (;;)
+    {
+        WCHAR attr[32], quote;
+        const WCHAR *value_end;
+        size_t alen = 0;
+
+        xml_skip_space( p );
+        if (**p == '/' && (*p)[1] == '>')
+        {
+            *empty = TRUE;
+            *p += 2;
+            return TRUE;
+        }
+        if (**p == '>')
+        {
+            (*p)++;
+            return TRUE;
+        }
+        while (is_name_char( **p, FALSE ) && alen < ARRAY_SIZE(attr) - 1) attr[alen++] = *(*p)++;
+        attr[alen] = 0;
+        if (!alen) return FALSE;
+        xml_skip_space( p );
+        if (**p != '=') return FALSE;
+        (*p)++;
+        xml_skip_space( p );
+        quote = **p;
+        if (quote != '\'' && quote != '"') return FALSE;
+        (*p)++;
+        if (!(value_end = wcschr( *p, quote ))) return FALSE;
+        if (!wcscmp( attr, L"Path" ))
+        {
+            free( *path );
+            *path = xml_decode( *p, value_end );
+        }
+        *p = value_end + 1;
+    }
+}
+
+static struct query_source *add_source( struct query_source **sources, unsigned int *count, const WCHAR *path,
+                                        unsigned int first )
+{
+    struct query_source *array, *source;
+    unsigned int i;
+    BOOL file = FALSE;
+
+    if (!wcsnicmp( path, L"file://", 7 ))
+    {
+        path += 7;
+        file = TRUE;
+    }
+    for (i = first; i < *count; i++)
+        if (!wcsicmp( (*sources)[i].path, path ) && (*sources)[i].file == file) return &(*sources)[i];
+    if (!(array = realloc( *sources, (*count + 1) * sizeof(*array) ))) return NULL;
+    *sources = array;
+    source = &array[(*count)++];
+    memset( source, 0, sizeof(*source) );
+    source->path = strdupW( path );
+    source->file = file;
+    return source;
+}
+
+static BOOL add_xpath( struct xpath ***array, unsigned int *count, struct xpath *xpath )
+{
+    struct xpath **new_array = realloc( *array, (*count + 1) * sizeof(*new_array) );
+
+    if (!new_array) return FALSE;
+    *array = new_array;
+    new_array[(*count)++] = xpath;
+    return TRUE;
+}
+
+void free_query_sources( struct query_source *sources, unsigned int count )
+{
