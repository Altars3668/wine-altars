+static void test_EvtRender(void)
+{
+    static const WCHAR start[] = L"<Event xmlns='http://schemas.microsoft.com/win/2004/08/events/event'><System>"
+                                 L"<Provider Name='EventLog'/><EventID Qualifiers='32768'>6005</EventID><Version>0"
+                                 L"</Version><Level>4</Level><Task>0</Task><Opcode>0</Opcode><Keywords>"
+                                 L"0x80000000000000</Keywords><TimeCreated SystemTime='";
+    static const BYTE system_types[EvtSystemPropertyIdEND] =
+    {
+        EvtVarTypeString, EvtVarTypeNull, EvtVarTypeUInt16, EvtVarTypeUInt16, EvtVarTypeByte, EvtVarTypeUInt16,
+        EvtVarTypeByte, EvtVarTypeHexInt64, EvtVarTypeFileTime, EvtVarTypeUInt64, EvtVarTypeNull, EvtVarTypeNull,
+        EvtVarTypeUInt32, EvtVarTypeUInt32, EvtVarTypeString, EvtVarTypeString, EvtVarTypeNull, EvtVarTypeByte,
+    };
+    static const WCHAR *paths[] =
+    {
+        L"Event/System/Provider/@Name", L"Event/System/EventID", L"Event/System/Level", L"Event/System/Nothing",
+    };
+    EVT_HANDLE event, context;
+    DWORD used, count, i;
+    EVT_VARIANT *values;
+    WCHAR tiny[8], *xml;
+    BOOL ret;
+
+    if (!(event = first_event(started)))
+    {
+        skip("no EventLog started event\n");
+        return;
+    }
+
+    used = count = 0xdeadbeef;
+    SetLastError(0xdeadbeef);
+    ret = EvtRender(NULL, event, EvtRenderEventXml, sizeof(tiny), tiny, &used, &count);
+    ok(!ret, "EvtRender succeeded\n");
+    ok(GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %lu\n", GetLastError());
+    ok(used > sizeof(start), "got %lu\n", used);
+    xml = malloc(used);
+    ret = EvtRender(NULL, event, EvtRenderEventXml, used, xml, &used, &count);
+    ok(ret, "EvtRender error %lu\n", GetLastError());
+    ok(!wcsncmp(xml, start, wcslen(start)), "got %s\n", wine_dbgstr_w(xml));
+    ok(wcsstr(xml, L"<Channel>System</Channel>") != NULL, "got %s\n", wine_dbgstr_w(xml));
+    ok(wcsstr(xml, L"<Security/></System><EventData><Binary>") != NULL, "got %s\n", wine_dbgstr_w(xml));
+    ok(used == (wcslen(xml) + 1) * sizeof(WCHAR), "got %lu\n", used);
+    free(xml);
+
+    SetLastError(0xdeadbeef);
+    ret = EvtRender(NULL, event, EvtRenderEventValues, 0, NULL, &used, &count);
+    ok(!ret, "EvtRender succeeded\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "got %lu\n", GetLastError());
+
+    context = EvtCreateRenderContext(0, NULL, EvtRenderContextSystem);
+    ok(context != NULL, "EvtCreateRenderContext error %lu\n", GetLastError());
+    used = 0;
+    ret = EvtRender(context, event, EvtRenderEventValues, 0, NULL, &used, &count);
+    ok(!ret && GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %d, error %lu\n", ret, GetLastError());
+    values = malloc(used);
+    ret = EvtRender(context, event, EvtRenderEventValues, used, values, &used, &count);
+    ok(ret, "EvtRender error %lu\n", GetLastError());
+    ok(count == EvtSystemPropertyIdEND, "got %lu\n", count);
+    for (i = 0; i < count && i < EvtSystemPropertyIdEND; i++)
+        ok(values[i].Type == system_types[i], "%lu: got type %lu\n", i, values[i].Type);
+    ok(values[EvtSystemEventID].UInt16Val == 6005, "got %u\n", values[EvtSystemEventID].UInt16Val);
+    ok(values[EvtSystemQualifiers].UInt16Val == 0x8000, "got %#x\n", values[EvtSystemQualifiers].UInt16Val);
+    ok(values[EvtSystemLevel].ByteVal == 4, "got %u\n", values[EvtSystemLevel].ByteVal);
+    ok(values[EvtSystemKeywords].UInt64Val == 0x80000000000000, "got %s\n",
+       wine_dbgstr_longlong(values[EvtSystemKeywords].UInt64Val));
+    ok(!wcscmp(values[EvtSystemProviderName].StringVal, L"EventLog"), "got %s\n",
+       wine_dbgstr_w(values[EvtSystemProviderName].StringVal));
+    ok(!wcscmp(values[EvtSystemChannel].StringVal, L"System"), "got %s\n", wine_dbgstr_w(values[EvtSystemChannel].StringVal));
+    free(values);
+    EvtClose(context);
+
+    /* the values a path names, strings counted without their terminator */
+    context = EvtCreateRenderContext(ARRAY_SIZE(paths), paths, EvtRenderContextValues);
+    ok(context != NULL, "EvtCreateRenderContext error %lu\n", GetLastError());
+    used = 0;
+    EvtRender(context, event, EvtRenderEventValues, 0, NULL, &used, &count);
+    values = malloc(used);
+    ret = EvtRender(context, event, EvtRenderEventValues, used, values, &used, &count);
+    ok(ret, "EvtRender error %lu\n", GetLastError());
+    ok(count == ARRAY_SIZE(paths), "got %lu\n", count);
+    ok(values[0].Type == EvtVarTypeString && values[0].Count == 8, "got type %lu count %lu\n", values[0].Type, values[0].Count);
+    ok(values[1].Type == EvtVarTypeUInt16 && values[1].UInt16Val == 6005, "got type %lu\n", values[1].Type);
+    ok(values[2].Type == EvtVarTypeByte, "got type %lu\n", values[2].Type);
+    ok(values[3].Type == EvtVarTypeNull, "got type %lu\n", values[3].Type);
+    free(values);
+    EvtClose(context);
+
+    SetLastError(0xdeadbeef);
+    context = EvtCreateRenderContext(1, (const WCHAR *[]){ L"Event/EventData/Data[1]" }, EvtRenderContextValues);
+    ok(!context, "got a context\n");
+    ok(GetLastError() == ERROR_EVT_INVALID_QUERY, "got %lu\n", GetLastError());
+    EvtClose(event);
+
+    /* the strings of the event, each counted with its terminator */
+    if ((event = first_event(version)))
+    {
+        context = EvtCreateRenderContext(0, NULL, EvtRenderContextUser);
+        used = 0;
+        EvtRender(context, event, EvtRenderEventValues, 0, NULL, &used, &count);
+        values = malloc(used);
+        ret = EvtRender(context, event, EvtRenderEventValues, used, values, &used, &count);
+        ok(ret, "EvtRender error %lu\n", GetLastError());
+        ok(count == 5, "got %lu\n", count);
+        for (i = 0; ret && i < count; i++)
+        {
+            ok(values[i].Type == EvtVarTypeString, "%lu: got type %lu\n", i, values[i].Type);
+            ok(values[i].Count == wcslen(values[i].StringVal) + 1, "%lu: got count %lu\n", i, values[i].Count);
+        }
+        if (ret && count == 5)
+            ok(!wcscmp(values[3].StringVal, L"Multiprocessor Free") || !wcscmp(values[3].StringVal, L"Uniprocessor Free"),
+               "got %s\n", wine_dbgstr_w(values[3].StringVal));
+        free(values);
+        EvtClose(context);
+        EvtClose(event);
+    }
+}
