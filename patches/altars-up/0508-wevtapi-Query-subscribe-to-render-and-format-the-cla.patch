+/* writes the events a query selects to a file in the classic format, as advapi32 keeps logs and backups */
+BOOL WINAPI EvtExportLog( EVT_HANDLE session, const WCHAR *path, const WCHAR *text, const WCHAR *target, DWORD flags )
+{
+    static const DWORD eof_marks[4] = { 0x11111111, 0x22222222, 0x33333333, 0x44444444 };
+    DWORD header[12] = { 0x30, 0x654c664c, 1, 1, 0x30, 0x30, 1, 1, 20971520, 0, 0, 0x30 }, eof[10];
+    EVT_HANDLE query, events[16];
+    DWORD returned, done, i, first = 0, last = 0;
+    HANDLE file;
+    BOOL ret = TRUE;
+
+    TRACE( "%p, %s, %s, %s, %#lx\n", session, debugstr_w(path), debugstr_w(text), debugstr_w(target), flags );
+
+    if (!target)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(query = EvtQuery( session, path, text, (flags & EvtExportLogFilePath ? EvtQueryFilePath : EvtQueryChannelPath) |
+                            (flags & EvtExportLogTolerateQueryErrors ? EvtQueryTolerateQueryErrors : 0) )))
+        return FALSE;
+    file = CreateFileW( target, GENERIC_WRITE, 0, NULL, flags & EvtExportLogOverwrite ? CREATE_ALWAYS : CREATE_NEW,
+                        FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE)
+    {
+        EvtClose( query );
+        return FALSE;
+    }
+    SetFilePointer( file, sizeof(header), NULL, FILE_BEGIN );
+    while (ret && EvtNext( query, ARRAY_SIZE(events), events, INFINITE, 0, &returned ))
+    {
+        for (i = 0; i < returned; i++)
+        {
+            struct event *event = impl_from_event( get_object( events[i], OBJECT_EVENT ) );
+
+            if (ret && !WriteFile( file, event->record, event->record->Length, &done, NULL )) ret = FALSE;
+            if (!first) first = event->record->RecordNumber;
+            last = event->record->RecordNumber;
+            header[5] += event->record->Length;
+            EvtClose( events[i] );
+        }
+    }
+    EvtClose( query );
+    if (first)
+    {
+        header[6] = last + 1;
+        header[7] = first;
+    }
+    eof[0] = eof[9] = sizeof(eof);
+    memcpy( eof + 1, eof_marks, sizeof(eof_marks) );
+    eof[5] = header[4];
+    eof[6] = header[5];
+    eof[7] = header[6];
+    eof[8] = header[7];
+    if (ret) ret = WriteFile( file, eof, sizeof(eof), &done, NULL ) &&
+                   SetFilePointer( file, 0, NULL, FILE_BEGIN ) == 0 && WriteFile( file, header, sizeof(header), &done, NULL );
+    CloseHandle( file );
+    if (!ret) DeleteFileW( target );
+    return ret;
+}
+
+BOOL WINAPI EvtArchiveExportedLog( EVT_HANDLE session, const WCHAR *path, LCID locale, DWORD flags )
+{
+    TRACE( "%p, %s, %#lx, %#lx\n", session, debugstr_w(path), locale, flags );
+
+    /* the classic format has its messages in the message files */
+    if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) return FALSE;
+    return TRUE;
+}
