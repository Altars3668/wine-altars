+EVT_HANDLE WINAPI EvtOpenLog( EVT_HANDLE session, const WCHAR *path, DWORD flags )
+{
+    struct log *log;
+    WCHAR *canonical = NULL;
+
+    TRACE( "%p, %s, %#lx\n", session, debugstr_w(path), flags );
+
+    if (session && !get_object( session, OBJECT_SESSION )) return NULL;
+    if (!path || (flags != EvtOpenChannelPath && flags != EvtOpenFilePath))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (flags == EvtOpenChannelPath && !classic_log_exists( path, &canonical ))
+    {
+        SetLastError( ERROR_EVT_CHANNEL_NOT_FOUND );
+        return NULL;
+    }
+    if (flags == EvtOpenFilePath && GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) return NULL;
+    if (!(log = alloc_object( OBJECT_LOG, sizeof(*log), destroy_log )))
+    {
+        free( canonical );
+        return NULL;
+    }
+    log->file = flags == EvtOpenFilePath;
+    log->path = canonical ? canonical : strdupW( path );
+    SetLastError( ERROR_SUCCESS );
+    return add_object( &log->obj );
+}
+
+BOOL WINAPI EvtGetLogInfo( EVT_HANDLE handle, EVT_LOG_PROPERTY_ID id, DWORD size, EVT_VARIANT *value, DWORD *used )
+{
+    WIN32_FILE_ATTRIBUTE_DATA attrs;
+    struct object *obj;
+    struct log *log;
+    WCHAR *file;
+    HANDLE classic;
+    DWORD number = 0;
+    BOOL ret;
+
+    TRACE( "%p, %u, %lu, %p, %p\n", handle, id, size, value, used );
+
+    if (!(obj = get_object( handle, OBJECT_LOG ))) return FALSE;
+    log = impl_from_log( obj );
+    *used = sizeof(EVT_VARIANT);
+    if (size < sizeof(EVT_VARIANT) || !value)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    memset( value, 0, sizeof(*value) );
+    switch (id)
+    {
+    case EvtLogCreationTime:
+    case EvtLogLastAccessTime:
+    case EvtLogLastWriteTime:
+    case EvtLogFileSize:
+    case EvtLogAttributes:
+        file = log->file ? strdupW( log->path ) : log_file_path( log->path );
+        ret = file && GetFileAttributesExW( file, GetFileExInfoStandard, &attrs );
+        free( file );
+        if (!ret) memset( &attrs, 0, sizeof(attrs) );
+        switch (id)
+        {
+        case EvtLogCreationTime:
+            value->Type = EvtVarTypeFileTime;
+            value->FileTimeVal = ((ULONGLONG)attrs.ftCreationTime.dwHighDateTime << 32) | attrs.ftCreationTime.dwLowDateTime;
+            break;
+        case EvtLogLastAccessTime:
+            value->Type = EvtVarTypeFileTime;
+            value->FileTimeVal = ((ULONGLONG)attrs.ftLastAccessTime.dwHighDateTime << 32) | attrs.ftLastAccessTime.dwLowDateTime;
+            break;
+        case EvtLogLastWriteTime:
+            value->Type = EvtVarTypeFileTime;
+            value->FileTimeVal = ((ULONGLONG)attrs.ftLastWriteTime.dwHighDateTime << 32) | attrs.ftLastWriteTime.dwLowDateTime;
+            break;
+        case EvtLogFileSize:
+            value->Type = EvtVarTypeUInt64;
+            value->UInt64Val = ((ULONGLONG)attrs.nFileSizeHigh << 32) | attrs.nFileSizeLow;
+            break;
+        default:
+            value->Type = EvtVarTypeUInt32;
+            value->UInt32Val = attrs.dwFileAttributes;
+            break;
+        }
+        return TRUE;
+    case EvtLogNumberOfLogRecords:
+    case EvtLogOldestRecordNumber:
+        classic = log->file ? OpenBackupEventLogW( NULL, log->path ) : OpenEventLogW( NULL, log->path );
+        if (!classic) return FALSE;
+        ret = id == EvtLogNumberOfLogRecords ? GetNumberOfEventLogRecords( classic, &number )
+                                             : GetOldestEventLogRecord( classic, &number );
+        CloseEventLog( classic );
+        value->Type = EvtVarTypeUInt64;
+        value->UInt64Val = number;
+        return ret;
+    case EvtLogFull:
+        value->Type = EvtVarTypeBoolean;
+        value->BooleanVal = FALSE;
+        return TRUE;
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+}
