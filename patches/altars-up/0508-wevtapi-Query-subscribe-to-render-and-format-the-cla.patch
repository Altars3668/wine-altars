+
+BOOL parse_structured_query( const WCHAR *text, const WCHAR *default_path, struct query_source **sources,
+                             unsigned int *count )
+{
+    const WCHAR *p = text;
+    WCHAR name[32], *path, *query_path = NULL;
+    BOOL closing, empty;
+    unsigned int query_first = 0;
+    DWORD error = ERROR_EVT_INVALID_QUERY;
