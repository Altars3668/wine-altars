+        return ret;
+    }
+    case EvtRenderBookmark:
+    {
+        struct bookmark *bookmark;
+        WCHAR *xml;
+        size_t len;
+        BOOL ret;
+
+        if (!(obj = get_object( fragment, OBJECT_BOOKMARK ))) return FALSE;
+        bookmark = impl_from_bookmark( obj );
+        len = 128 + (bookmark->channel ? wcslen( bookmark->channel ) : 0);
+        if (!(xml = malloc( len * sizeof(WCHAR) ))) return FALSE;
+        if (bookmark->channel)
+            swprintf( xml, len, L"<BookmarkList>\r\n  <Bookmark Channel='%s' RecordId='%I64u' IsCurrent='true'/>\r\n"
+                      L"</BookmarkList>", bookmark->channel, bookmark->record );
+        else
+            wcscpy( xml, L"<BookmarkList>\r\n</BookmarkList>" );
+        *count = 1;
+        ret = copy_string( xml, size, buffer, used );
+        free( xml );
+        return ret;
+    }
+    case EvtRenderEventValues:
+    {
+        struct object *event_obj;
+
+        if (!context || !(obj = get_object( context, OBJECT_CONTEXT )))
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            return FALSE;
+        }
+        if (!(event_obj = get_object( fragment, OBJECT_EVENT ))) return FALSE;
+        return render_values( impl_from_context( obj ), impl_from_event( event_obj ), size, buffer, used, count );
+    }
+    }
+    SetLastError( ERROR_INVALID_PARAMETER );
+    return FALSE;
+}
+
+BOOL WINAPI EvtClose( EVT_HANDLE handle )
+{
+    struct object *obj;
+
+    TRACE( "%p\n", handle );
+
+    EnterCriticalSection( &objects_cs );
+    LIST_FOR_EACH_ENTRY( obj, &objects, struct object, entry )
+    {
+        if (obj != handle) continue;
+        list_remove( &obj->entry );
+        LeaveCriticalSection( &objects_cs );
+        destroy_object( obj );
+        return TRUE;
+    }
+    LeaveCriticalSection( &objects_cs );
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
