+BOOL WINAPI EvtClearLog( EVT_HANDLE session, const WCHAR *channel, const WCHAR *target, DWORD flags )
+{
+    WCHAR *canonical;
+    HANDLE log;
+    BOOL ret;
+
+    TRACE( "%p, %s, %s, %#lx\n", session, debugstr_w(channel), debugstr_w(target), flags );
+
+    if (session && !get_object( session, OBJECT_SESSION )) return FALSE;
+    if (!classic_log_exists( channel, &canonical ))
+    {
+        SetLastError( ERROR_EVT_CHANNEL_NOT_FOUND );
+        return FALSE;
+    }
+    log = OpenEventLogW( NULL, canonical );
+    free( canonical );
+    if (!log) return FALSE;
+    ret = ClearEventLogW( log, target );
+    CloseEventLog( log );
+    return ret;
+}
