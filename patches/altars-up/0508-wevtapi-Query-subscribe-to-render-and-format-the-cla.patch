+    BOOL ret;
+
+    channels = EvtOpenChannelEnum(NULL, 0);
+    ok(channels != NULL, "EvtOpenChannelEnum error %lu\n", GetLastError());
+    while (EvtNextChannelPath(channels, ARRAY_SIZE(name), name, &used))
+    {
+        if (!wcsicmp(name, L"Application")) application = TRUE;
+        if (!wcsicmp(name, L"System")) system = TRUE;
+    }
+    ok(GetLastError() == ERROR_NO_MORE_ITEMS, "got %lu\n", GetLastError());
+    ok(application && system, "got %d %d\n", application, system);
+    EvtClose(channels);
+
+    config = EvtOpenChannelConfig(NULL, L"Application", 0);
+    ok(config != NULL, "EvtOpenChannelConfig error %lu\n", GetLastError());
+    ret = EvtGetChannelConfigProperty(config, EvtChannelConfigEnabled, 0, sizeof(value), &value.var, &used);
+    ok(ret && value.var.Type == EvtVarTypeBoolean && value.var.BooleanVal, "got %d, type %lu\n", ret, value.var.Type);
+    ret = EvtGetChannelConfigProperty(config, EvtChannelConfigClassicEventlog, 0, sizeof(value), &value.var, &used);
+    ok(ret && value.var.Type == EvtVarTypeBoolean && value.var.BooleanVal, "got %d, type %lu\n", ret, value.var.Type);
+    ret = EvtGetChannelConfigProperty(config, EvtChannelConfigType, 0, sizeof(value), &value.var, &used);
+    ok(ret && value.var.Type == EvtVarTypeUInt32 && !value.var.UInt32Val, "got %d, type %lu\n", ret, value.var.Type);
+    ret = EvtGetChannelConfigProperty(config, EvtChannelLoggingConfigMaxSize, 0, sizeof(value), &value.var, &used);
+    ok(ret && value.var.Type == EvtVarTypeUInt64 && value.var.UInt64Val, "got %d, type %lu\n", ret, value.var.Type);
+    ret = EvtGetChannelConfigProperty(config, EvtChannelLoggingConfigRetention, 0, sizeof(value), &value.var, &used);
+    ok(ret && value.var.Type == EvtVarTypeBoolean, "got %d, type %lu\n", ret, value.var.Type);
+    ret = EvtGetChannelConfigProperty(config, EvtChannelConfigOwningPublisher, 0, sizeof(value), &value.var, &used);
+    ok(ret && value.var.Type == EvtVarTypeString && !value.var.StringVal[0], "got %d, type %lu\n", ret, value.var.Type);
+    ok(used == sizeof(EVT_VARIANT) + sizeof(WCHAR), "got %lu\n", used);
+    EvtClose(config);
+
+    SetLastError(0xdeadbeef);
+    config = EvtOpenChannelConfig(NULL, L"wine-no-such-log", 0);
+    ok(!config, "got a config\n");
+    ok(GetLastError() == ERROR_EVT_CHANNEL_NOT_FOUND, "got %lu\n", GetLastError());
+}
