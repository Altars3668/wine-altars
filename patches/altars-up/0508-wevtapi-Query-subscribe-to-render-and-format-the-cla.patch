+/* the XML tree of an event */
+struct node
+{
+    const WCHAR *name;
+    const WCHAR *attr_names[2];
+    WCHAR *attr_values[2];
+    unsigned int attr_count;
+    WCHAR *text;                /* NULL for an element with no text, which XML writes as an empty element */
+    struct node *children;
+    unsigned int child_count;
+    unsigned int type;          /* the EVT_VARIANT_TYPE of the value of the element, or of its first attribute */
+    unsigned int attr_type;
+    BOOL array_item;            /* a Data of a classic event: its strings are one array */
+};
+
+extern struct node *build_event_tree( const struct event *event );
+extern void free_node( struct node *node );
+extern WCHAR *write_event_xml( const struct node *tree, const WCHAR *rendering );
+extern WCHAR *escape_xml( const WCHAR *str );
+extern ULONGLONG node_number( const WCHAR *text );
+extern BOOL parse_system_time( const WCHAR *text, FILETIME *ft );
+
+/* a parsed XPath expression */
+struct xpath;
+
+extern struct xpath *parse_xpath( const WCHAR *text, BOOL render_path );
+extern void free_xpath( struct xpath *xpath );
+enum path_relation { PATH_UNRELATED, PATH_CONFLICT, PATH_SAME_ATTRIBUTE };
+extern enum path_relation render_path_relation( const struct xpath *earlier, const struct xpath *later );
+extern BOOL match_xpath( const struct xpath *xpath, const struct node *tree );
+extern const struct node *select_xpath( const struct xpath *xpath, const struct node *tree, const WCHAR **attr,
+                                        unsigned int *attr_type );
+
+/* what is in a structured query, or what a plain one is */
+struct query_source
+{
+    WCHAR *path;
+    BOOL file;
+    struct xpath **selects;
+    unsigned int select_count;
+    struct xpath **suppresses;
+    unsigned int suppress_count;
+};
+
+extern BOOL parse_structured_query( const WCHAR *text, const WCHAR *default_path, struct query_source **sources,
+                                    unsigned int *count );
+extern void free_query_sources( struct query_source *sources, unsigned int count );
+
+extern BOOL classic_log_exists( const WCHAR *name, WCHAR **canonical );
+extern WCHAR *strdupW( const WCHAR *str );
