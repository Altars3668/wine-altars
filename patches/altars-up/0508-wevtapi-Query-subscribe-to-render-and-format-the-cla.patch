+static void test_bookmark(void)
+{
+    EVT_HANDLE bookmark, event;
+    WCHAR xml[512], record[32];
+    DWORD used, count;
+    BOOL ret;
+
+    bookmark = EvtCreateBookmark(NULL);
+    ok(bookmark != NULL, "EvtCreateBookmark error %lu\n", GetLastError());
+    ret = EvtRender(NULL, bookmark, EvtRenderBookmark, sizeof(xml), xml, &used, &count);
+    ok(ret, "EvtRender error %lu\n", GetLastError());
+    ok(!wcsncmp(xml, L"<BookmarkList", 13), "got %s\n", wine_dbgstr_w(xml));
+    if ((event = first_event(started)))
+    {
+        EVT_HANDLE context = EvtCreateRenderContext(0, NULL, EvtRenderContextSystem);
+        EVT_VARIANT values[EvtSystemPropertyIdEND + 16];
+
+        ret = EvtUpdateBookmark(bookmark, event);
+        ok(ret, "EvtUpdateBookmark error %lu\n", GetLastError());
+        ret = EvtRender(NULL, bookmark, EvtRenderBookmark, sizeof(xml), xml, &used, &count);
+        ok(ret, "EvtRender error %lu\n", GetLastError());
+        EvtRender(context, event, EvtRenderEventValues, sizeof(values), values, &used, &count);
+        swprintf(record, ARRAY_SIZE(record), L"RecordId='%I64u'", values[EvtSystemEventRecordId].UInt64Val);
+        ok(wcsstr(xml, L"Channel='System'") && wcsstr(xml, record), "got %s\n", wine_dbgstr_w(xml));
+        EvtClose(context);
+        EvtClose(event);
+    }
+    EvtClose(bookmark);
+}
+
+static LONG delivered;
+static DWORD callback_thread;
+static HANDLE delivered_event;
+
+static DWORD WINAPI subscription_callback(EVT_SUBSCRIBE_NOTIFY_ACTION action, void *context, EVT_HANDLE event)
+{
+    ok(action == EvtSubscribeActionDeliver, "got action %u\n", action);
+    ok(context == &delivered, "got context %p\n", context);
+    ok(event != NULL, "no event\n");
+    callback_thread = GetCurrentThreadId();
+    InterlockedIncrement(&delivered);
+    SetEvent(delivered_event);
+    return 0;
+}
+
+static void test_EvtSubscribe(void)
+{
+    HANDLE signal = CreateEventW(NULL, TRUE, FALSE, NULL);
+    EVT_HANDLE subscription, events[4];
+    DWORD returned, total = 0;
+    BOOL ret;
+
+    /* the events there already are there for EvtNext at once, and do not set the signal */
+    subscription = EvtSubscribe(NULL, signal, L"System", started, NULL, NULL, NULL, EvtSubscribeStartAtOldestRecord);
+    ok(subscription != NULL, "EvtSubscribe error %lu\n", GetLastError());
+    if (!subscription) return;
+    while ((ret = EvtNext(subscription, ARRAY_SIZE(events), events, 0, 0, &returned)))
+    {
+        total += returned;
+        while (returned) EvtClose(events[--returned]);
+    }
+    ok(GetLastError() == ERROR_NO_MORE_ITEMS, "got %lu\n", GetLastError());
+    ok(total == query_count(L"System", started, EvtQueryChannelPath), "got %lu events\n", total);
+    /* asked again before more come, EvtNext does not wait for them, whatever the timeout */
+    SetLastError(0xdeadbeef);
+    ret = EvtNext(subscription, ARRAY_SIZE(events), events, INFINITE, 0, &returned);
+    ok(!ret && GetLastError() == ERROR_INVALID_OPERATION, "got %d, error %lu\n", ret, GetLastError());
+    ok(WaitForSingleObject(signal, 0) == WAIT_TIMEOUT, "signal set\n");
+    EvtClose(subscription);
+
+    /* nor does it reset the signal */
+    SetEvent(signal);
+    subscription = EvtSubscribe(NULL, signal, L"System", started, NULL, NULL, NULL, EvtSubscribeToFutureEvents);
+    ok(subscription != NULL, "EvtSubscribe error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = EvtNext(subscription, ARRAY_SIZE(events), events, 0, 0, &returned);
+    ok(!ret && GetLastError() == ERROR_NO_MORE_ITEMS, "got %d, error %lu\n", ret, GetLastError());
+    ok(!WaitForSingleObject(signal, 0), "signal reset\n");
+    EvtClose(subscription);
+
+    /* a signal or a callback, not both */
+    SetLastError(0xdeadbeef);
+    subscription = EvtSubscribe(NULL, signal, L"System", started, NULL, &delivered, subscription_callback,
+                                EvtSubscribeStartAtOldestRecord);
+    ok(!subscription && GetLastError() == ERROR_INVALID_PARAMETER, "got %p, error %lu\n", subscription, GetLastError());
+
+    /* a callback is called on a thread of the subscription's */
+    delivered_event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    subscription = EvtSubscribe(NULL, NULL, L"System", started, NULL, &delivered, subscription_callback,
+                                EvtSubscribeStartAtOldestRecord);
+    ok(subscription != NULL, "EvtSubscribe error %lu\n", GetLastError());
+    ok(!WaitForSingleObject(delivered_event, 10000), "nothing delivered\n");
+    ok(callback_thread && callback_thread != GetCurrentThreadId(), "called on thread %lx\n", callback_thread);
+    SetLastError(0xdeadbeef);
+    ret = EvtNext(subscription, ARRAY_SIZE(events), events, 0, 0, &returned);
+    ok(!ret && GetLastError() == ERROR_INVALID_HANDLE, "got %d, error %lu\n", ret, GetLastError());
+    EvtClose(subscription);
+    CloseHandle(delivered_event);
+    CloseHandle(signal);
+}
+
 START_TEST(wevtapi)
 {
     test_EvtGetChannelConfigProperty();
+    test_EvtQuery();
+    test_EvtRender();
+    test_EvtFormatMessage();
+    test_EvtGetLogInfo();
+    test_channels();
+    test_bookmark();
+    test_EvtSubscribe();
 }
