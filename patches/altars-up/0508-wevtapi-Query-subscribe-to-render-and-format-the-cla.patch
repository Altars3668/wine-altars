+static void test_EvtFormatMessage(void)
+{
+    static const WCHAR rendering[] = L"</EventData><RenderingInfo Culture='en-US'><Message>The Event log service was "
+                                     L"started.</Message><Level>Information</Level><Task>None</Task><Keywords>"
+                                     L"<Keyword>Classic</Keyword></Keywords></RenderingInfo></Event>";
+    EVT_HANDLE event, publisher;
+    WCHAR buffer[2048];
+    DWORD used;
+    BOOL ret;
+
+    if (!(event = first_event(version)))
+    {
+        skip("no EventLog version event\n");
+        return;
+    }
+    publisher = EvtOpenPublisherMetadata(NULL, L"EventLog", NULL, 0, 0);
+    ok(publisher != NULL, "EvtOpenPublisherMetadata error %lu\n", GetLastError());
+
+    /* a message, level or task with two terminators, the keywords with three */
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageEvent, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret, "EvtFormatMessage error %lu\n", GetLastError());
+    ok(used == wcslen(buffer) + 2, "got %lu for %s\n", used, wine_dbgstr_w(buffer));
+    ok(!wcsncmp(buffer, L"Microsoft (R) Windows (R) ", 26), "got %s\n", wine_dbgstr_w(buffer));
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageLevel, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret, "EvtFormatMessage error %lu\n", GetLastError());
+    ok(used == wcslen(buffer) + 2, "got %lu for %s\n", used, wine_dbgstr_w(buffer));
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageTask, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret, "EvtFormatMessage error %lu\n", GetLastError());
+    ok(used == wcslen(buffer) + 2, "got %lu for %s\n", used, wine_dbgstr_w(buffer));
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageKeyword, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret, "EvtFormatMessage error %lu\n", GetLastError());
+    ok(used == wcslen(buffer) + 3, "got %lu for %s\n", used, wine_dbgstr_w(buffer));
+
+    SetLastError(0xdeadbeef);
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageOpcode, ARRAY_SIZE(buffer), buffer, &used);
+    ok(!ret, "EvtFormatMessage succeeded\n");
+    ok(GetLastError() == ERROR_EVT_MESSAGE_ID_NOT_FOUND, "got %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = EvtFormatMessage(NULL, event, 0, 0, NULL, EvtFormatMessageEvent, ARRAY_SIZE(buffer), buffer, &used);
+    ok(!ret, "EvtFormatMessage succeeded\n");
+    ok(GetLastError() == ERROR_EVT_MESSAGE_NOT_FOUND, "got %lu\n", GetLastError());
+    EvtClose(publisher);
+    EvtClose(event);
+
+    /* in the language asked for */
+    if (!(event = first_event(started)))
+    {
+        skip("no EventLog start event\n");
+        return;
+    }
+    publisher = EvtOpenPublisherMetadata(NULL, L"EventLog", NULL, MAKELCID(0x409, SORT_DEFAULT), 0);
+    ok(publisher != NULL, "EvtOpenPublisherMetadata error %lu\n", GetLastError());
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageEvent, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret, "EvtFormatMessage error %lu\n", GetLastError());
+    ok(!wcscmp(buffer, L"The Event log service was started."), "got %s\n", wine_dbgstr_w(buffer));
+    ok(used == 36, "got %lu\n", used);
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageLevel, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret && !wcscmp(buffer, L"Information"), "got %d, %s\n", ret, wine_dbgstr_w(buffer));
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageTask, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret && !wcscmp(buffer, L"None"), "got %d, %s\n", ret, wine_dbgstr_w(buffer));
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageKeyword, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret && !wcscmp(buffer, L"Classic"), "got %d, %s\n", ret, wine_dbgstr_w(buffer));
+    /* a message by its number, without insertions */
+    ret = EvtFormatMessage(publisher, NULL, 0x80001779, 0, NULL, EvtFormatMessageId, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret, "EvtFormatMessage error %lu\n", GetLastError());
+    ok(!wcscmp(buffer, L"Microsoft (R) Windows (R) %1 %2 %3 %4."), "got %s\n", wine_dbgstr_w(buffer));
+    ok(used == wcslen(buffer) + 2, "got %lu\n", used);
+    /* the XML with what is rendered after the event's data, one terminator */
+    ret = EvtFormatMessage(publisher, event, 0, 0, NULL, EvtFormatMessageXml, ARRAY_SIZE(buffer), buffer, &used);
+    ok(ret, "EvtFormatMessage error %lu\n", GetLastError());
+    ok(used == wcslen(buffer) + 1, "got %lu\n", used);
+    ok(wcslen(buffer) > wcslen(rendering) && !wcscmp(buffer + wcslen(buffer) - wcslen(rendering), rendering),
+       "got %s\n", wine_dbgstr_w(buffer));
+    EvtClose(publisher);
+    EvtClose(event);
+
+    SetLastError(0xdeadbeef);
+    publisher = EvtOpenPublisherMetadata(NULL, L"wine-no-such-source", NULL, 0, 0);
+    ok(!publisher, "got a publisher\n");
+    ok(GetLastError() == ERROR_FILE_NOT_FOUND, "got %lu\n", GetLastError());
+}
