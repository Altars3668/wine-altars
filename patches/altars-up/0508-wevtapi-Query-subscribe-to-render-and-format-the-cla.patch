+/*
+ * Channels
+ */
+
+struct channel_enum
+{
+    struct object obj;
+    WCHAR **names;
+    unsigned int count, pos;
+};
+
+static struct channel_enum *impl_from_channel_enum( struct object *obj )
+{
+    return CONTAINING_RECORD( obj, struct channel_enum, obj );
+}
+
+static void destroy_channel_enum( struct object *obj )
+{
+    struct channel_enum *channels = impl_from_channel_enum( obj );
+    unsigned int i;
+
+    for (i = 0; i < channels->count; i++) free( channels->names[i] );
+    free( channels->names );
+}
+
+static void add_channels( struct channel_enum *channels, HKEY root, const WCHAR *path )
+{
+    WCHAR name[256];
+    DWORD i, len;
+    HKEY key;
+
+    if (RegOpenKeyExW( root, path, 0, KEY_READ, &key )) return;
+    for (i = 0; len = ARRAY_SIZE(name), !RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL ); i++)
+    {
+        WCHAR **names;
+        unsigned int j;
+
+        for (j = 0; j < channels->count; j++) if (!wcsicmp( channels->names[j], name )) break;
+        if (j < channels->count) continue;
+        if (!(names = realloc( channels->names, (channels->count + 1) * sizeof(*names) ))) break;
+        channels->names = names;
+        channels->names[channels->count++] = strdupW( name );
+    }
+    RegCloseKey( key );
+}
+
+EVT_HANDLE WINAPI EvtOpenChannelEnum( EVT_HANDLE session, DWORD flags )
+{
+    struct channel_enum *channels;
+
+    TRACE( "%p, %#lx\n", session, flags );
+
+    if (session && !get_object( session, OBJECT_SESSION )) return NULL;
+    if (!(channels = alloc_object( OBJECT_CHANNEL_ENUM, sizeof(*channels), destroy_channel_enum ))) return NULL;
+    add_channels( channels, HKEY_LOCAL_MACHINE, eventlog_key );
+    add_channels( channels, HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows\\CurrentVersion\\WINEVT\\Channels" );
+    return add_object( &channels->obj );
+}
+
+BOOL WINAPI EvtNextChannelPath( EVT_HANDLE handle, DWORD size, WCHAR *buffer, DWORD *used )
+{
+    struct channel_enum *channels;
+    struct object *obj;
+    const WCHAR *name;
+
+    TRACE( "%p, %lu, %p, %p\n", handle, size, buffer, used );
+
+    if (!(obj = get_object( handle, OBJECT_CHANNEL_ENUM ))) return FALSE;
+    channels = impl_from_channel_enum( obj );
+    if (channels->pos >= channels->count)
+    {
+        SetLastError( ERROR_NO_MORE_ITEMS );
+        return FALSE;
+    }
+    name = channels->names[channels->pos];
+    *used = wcslen( name ) + 1;
+    if (size < *used || !buffer)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    wcscpy( buffer, name );
+    channels->pos++;
+    return TRUE;
+}
+
+struct channel_config
+{
+    struct object obj;
+    WCHAR *name;
+    BOOL retention, retention_set;
+    BOOL auto_backup, auto_backup_set;
+    ULONGLONG max_size;
+    BOOL max_size_set;
+};
+
+static struct channel_config *impl_from_channel_config( struct object *obj )
+{
+    return CONTAINING_RECORD( obj, struct channel_config, obj );
+}
+
+static void destroy_channel_config( struct object *obj )
+{
+    free( impl_from_channel_config( obj )->name );
+}
+
+static DWORD channel_dword( const WCHAR *name, const WCHAR *value, DWORD def )
+{
+    WCHAR path[ARRAY_SIZE(eventlog_key) + 260];
+    DWORD data = def, size = sizeof(data), type;
+    HKEY key;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", eventlog_key, name );
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key )) return def;
+    if (RegQueryValueExW( key, value, NULL, &type, (BYTE *)&data, &size ) || type != REG_DWORD) data = def;
+    RegCloseKey( key );
+    return data;
+}
