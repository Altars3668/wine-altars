+    *count = 0;
+    if (!xml_tag( &p, name, ARRAY_SIZE(name), &path, &closing, &empty ) || closing || wcscmp( name, L"QueryList" ))
+        goto error;
+    free( path );
+    for (;;)
+    {
+        if (!xml_tag( &p, name, ARRAY_SIZE(name), &path, &closing, &empty )) goto error;
+        if (closing && !wcscmp( name, L"QueryList" )) break;
+        if (closing && !wcscmp( name, L"Query" ))
+        {
+            free( query_path );
+            query_path = NULL;
+            free( path );
+            continue;
+        }
+        if (!closing && !wcscmp( name, L"Query" ))
+        {
+            free( query_path );
+            query_path = path;
+            query_first = *count;
+            continue;
+        }
+        if (!closing && (!wcscmp( name, L"Select" ) || !wcscmp( name, L"Suppress" )))
+        {
+            BOOL select = !wcscmp( name, L"Select" );
+            const WCHAR *source_path = path ? path : query_path ? query_path : default_path;
+            const WCHAR *end = empty ? p : wcschr( p, '<' );
+            struct query_source *source;
+            struct xpath *xpath;
+            WCHAR *xpath_text;
+
+            if (!source_path)
+            {
+                free( path );
+                error = ERROR_EVT_INVALID_CHANNEL_PATH;
+                goto error;
+            }
+            if (!end || !(xpath_text = xml_decode( p, end )))
+            {
+                free( path );
+                goto error;
+            }
+            p = end;
+            xpath = parse_xpath( xpath_text, FALSE );
+            free( xpath_text );
+            if (!xpath || !(source = add_source( sources, count, source_path, query_first )))
+            {
+                free_xpath( xpath );
+                free( path );
+                goto error;
+            }
+            free( path );
+            if (!(select ? add_xpath( &source->selects, &source->select_count, xpath )
+                         : add_xpath( &source->suppresses, &source->suppress_count, xpath )))
+            {
+                free_xpath( xpath );
+                goto error;
+            }
+            if (!empty && (!xml_tag( &p, name, ARRAY_SIZE(name), &path, &closing, &empty ) || !closing))
+            {
+                free( path );
+                goto error;
+            }
+            free( path );
+            continue;
+        }
+        free( path );
+        goto error;
+    }
+    free( query_path );
+    return TRUE;
+
+error:
+    free( query_path );
+    free_query_sources( *sources, *count );
+    *sources = NULL;
+    *count = 0;
+    SetLastError( error );
+    return FALSE;
+}
