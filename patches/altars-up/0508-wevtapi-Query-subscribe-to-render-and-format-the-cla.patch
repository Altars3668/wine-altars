+/* what Windows 11 gives the Application log: a classic log, enabled, an administrative channel of its own,
+ * its file, its size and whether it keeps or overwrites its records */
+BOOL WINAPI EvtGetChannelConfigProperty( EVT_HANDLE handle, EVT_CHANNEL_CONFIG_PROPERTY_ID id, DWORD flags,
+                                         DWORD size, EVT_VARIANT *value, DWORD *used )
+{
+    static const WCHAR access[] = L"O:BAG:SYD:(A;;0x2;;;S-1-15-2-1)(A;;0x2;;;S-1-15-3-1024-3153509613-960666767-"
+                                  L"3724611135-2725662640-12138253-543910227-1950414635-4190290187)(A;;0xf0007;;;SY)"
+                                  L"(A;;0x7;;;BA)(A;;0x7;;;SO)(A;;0x3;;;IU)(A;;0x3;;;SU)(A;;0x3;;;S-1-5-3)(A;;0x3;;;S-1-5-33)"
+                                  L"(A;;0x1;;;S-1-5-32-573)";
+    struct channel_config *config;
+    struct object *obj;
+
+    TRACE( "%p, %u, %#lx, %lu, %p, %p\n", handle, id, flags, size, value, used );
+
+    if (!(obj = get_object( handle, OBJECT_CHANNEL_CONFIG ))) return FALSE;
+    config = impl_from_channel_config( obj );
+    if (!used)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    switch (id)
+    {
+    case EvtChannelConfigOwningPublisher:
+        return set_variant_string( value, L"", size, used );
+    case EvtChannelConfigAccess:
+        return set_variant_string( value, access, size, used );
+    case EvtChannelLoggingConfigLogFilePath:
+    {
+        WCHAR path[MAX_PATH + 64];
+        swprintf( path, ARRAY_SIZE(path), L"%%SystemRoot%%\\System32\\Winevt\\Logs\\%s.evt", config->name );
+        return set_variant_string( value, path, size, used );
+    }
+    default:
+        break;
+    }
+
+    *used = sizeof(EVT_VARIANT);
+    if (size < sizeof(EVT_VARIANT) || !value)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    switch (id)
+    {
+    case EvtChannelConfigEnabled:
+    case EvtChannelConfigClassicEventlog:
+        value->Type = EvtVarTypeBoolean;
+        value->BooleanVal = TRUE;
+        return TRUE;
+    case EvtChannelConfigIsolation:
+    case EvtChannelConfigType:
+        value->Type = EvtVarTypeUInt32;
+        value->UInt32Val = 0;
+        return TRUE;
+    case EvtChannelLoggingConfigRetention:
+        value->Type = EvtVarTypeBoolean;
+        value->BooleanVal = config->retention_set ? config->retention : !!channel_dword( config->name, L"Retention", 0 );
+        return TRUE;
+    case EvtChannelLoggingConfigAutoBackup:
+        value->Type = EvtVarTypeBoolean;
+        value->BooleanVal = config->auto_backup_set ? config->auto_backup
+                                                    : !!channel_dword( config->name, L"AutoBackupLogFiles", 0 );
+        return TRUE;
+    case EvtChannelLoggingConfigMaxSize:
+        value->Type = EvtVarTypeUInt64;
+        value->UInt64Val = config->max_size_set ? config->max_size : channel_dword( config->name, L"MaxSize", 20971520 );
+        return TRUE;
+    default:
+        FIXME( "property %u not supported\n", id );
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+}
+
+BOOL WINAPI EvtSetChannelConfigProperty( EVT_HANDLE handle, EVT_CHANNEL_CONFIG_PROPERTY_ID id, DWORD flags,
+                                         EVT_VARIANT *value )
+{
+    struct channel_config *config;
+    struct object *obj;
+
+    TRACE( "%p, %u, %#lx, %p\n", handle, id, flags, value );
+
+    if (!(obj = get_object( handle, OBJECT_CHANNEL_CONFIG ))) return FALSE;
+    config = impl_from_channel_config( obj );
+    if (!value)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    switch (id)
+    {
+    case EvtChannelLoggingConfigRetention:
+        config->retention = value->BooleanVal;
+        config->retention_set = TRUE;
+        return TRUE;
+    case EvtChannelLoggingConfigAutoBackup:
+        config->auto_backup = value->BooleanVal;
+        config->auto_backup_set = TRUE;
+        return TRUE;
+    case EvtChannelLoggingConfigMaxSize:
+        config->max_size = value->UInt64Val;
+        config->max_size_set = TRUE;
+        return TRUE;
+    default:
+        FIXME( "property %u not supported\n", id );
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
+}
+
+BOOL WINAPI EvtSaveChannelConfig( EVT_HANDLE handle, DWORD flags )
+{
+    WCHAR path[ARRAY_SIZE(eventlog_key) + 260];
+    struct channel_config *config;
+    struct object *obj;
+    DWORD data;
+    HKEY key;
+    LSTATUS status;
+
+    TRACE( "%p, %#lx\n", handle, flags );
+
+    if (!(obj = get_object( handle, OBJECT_CHANNEL_CONFIG ))) return FALSE;
+    config = impl_from_channel_config( obj );
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", eventlog_key, config->name );
+    if ((status = RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_SET_VALUE, &key )))
+    {
+        SetLastError( status );
+        return FALSE;
+    }
+    if (config->retention_set)
+    {
+        data = config->retention ? 0xffffffff : 0;
+        RegSetValueExW( key, L"Retention", 0, REG_DWORD, (BYTE *)&data, sizeof(data) );
+    }
+    if (config->auto_backup_set)
+    {
+        data = config->auto_backup;
+        RegSetValueExW( key, L"AutoBackupLogFiles", 0, REG_DWORD, (BYTE *)&data, sizeof(data) );
+    }
+    if (config->max_size_set)
+    {
+        data = min( config->max_size, 0xffffffff );
+        RegSetValueExW( key, L"MaxSize", 0, REG_DWORD, (BYTE *)&data, sizeof(data) );
+    }
+    RegCloseKey( key );
+    return TRUE;
+}
+
+/*
+ * Messages
+ */
+
+struct publisher
+{
+    struct object obj;
+    WCHAR *name;
+    WCHAR *event_files;         /* the message files, separated by semicolons */
+    WCHAR *category_files;
+    LCID locale;
+};
+
+static struct publisher *impl_from_publisher( struct object *obj )
+{
+    return CONTAINING_RECORD( obj, struct publisher, obj );
+}
+
+static void destroy_publisher( struct object *obj )
+{
+    struct publisher *publisher = impl_from_publisher( obj );
+
+    free( publisher->name );
+    free( publisher->event_files );
+    free( publisher->category_files );
+}
+
+static WCHAR *query_expanded( HKEY key, const WCHAR *name )
+{
+    WCHAR *value, *expanded;
+    DWORD size = 0, type, len;
+
+    if (RegQueryValueExW( key, name, NULL, &type, NULL, &size ) || (type != REG_SZ && type != REG_EXPAND_SZ)) return NULL;
+    if (!(value = malloc( size + sizeof(WCHAR) ))) return NULL;
+    if (RegQueryValueExW( key, name, NULL, &type, (BYTE *)value, &size ))
+    {
+        free( value );
+        return NULL;
+    }
+    value[size / sizeof(WCHAR)] = 0;
+    len = ExpandEnvironmentStringsW( value, NULL, 0 );
+    if ((expanded = malloc( len * sizeof(WCHAR) ))) ExpandEnvironmentStringsW( value, expanded, len );
+    free( value );
+    return expanded;
+}
+
+/* the publisher of a classic source: its key under the log it writes to */
+EVT_HANDLE WINAPI EvtOpenPublisherMetadata( EVT_HANDLE session, const WCHAR *id, const WCHAR *logfile, LCID locale,
+                                            DWORD flags )
+{
+    WCHAR name[256];
+    struct publisher *publisher;
+    HKEY key, log_key, source_key = NULL;
+    DWORD i, len;
+
+    TRACE( "%p, %s, %s, %#lx, %#lx\n", session, debugstr_w(id), debugstr_w(logfile), locale, flags );
+
+    if (session && !get_object( session, OBJECT_SESSION )) return NULL;
+    if (!id)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, eventlog_key, 0, KEY_READ, &key ))
+    {
+        for (i = 0; !source_key && (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )); i++)
+        {
+            if (RegOpenKeyExW( key, name, 0, KEY_READ, &log_key )) continue;
+            if (RegOpenKeyExW( log_key, id, 0, KEY_READ, &source_key )) source_key = NULL;
+            RegCloseKey( log_key );
+        }
+        RegCloseKey( key );
+    }
+    if (!source_key)
+    {
+        SetLastError( ERROR_FILE_NOT_FOUND );
+        return NULL;
+    }
+    if (!(publisher = alloc_object( OBJECT_PUBLISHER, sizeof(*publisher), destroy_publisher )))
+    {
+        RegCloseKey( source_key );
+        return NULL;
+    }
+    publisher->name = strdupW( id );
+    publisher->event_files = query_expanded( source_key, L"EventMessageFile" );
+    publisher->category_files = query_expanded( source_key, L"CategoryMessageFile" );
+    publisher->locale = locale;
+    RegCloseKey( source_key );
+    SetLastError( ERROR_SUCCESS );
+    return add_object( &publisher->obj );
+}
+
+/* the messages of wevtapi.mc */
+#define MSG_LEVEL_CRITICAL         1
+#define MSG_LEVEL_ERROR            2
+#define MSG_LEVEL_WARNING          3
+#define MSG_LEVEL_INFORMATION      4
+#define MSG_LEVEL_VERBOSE          5
+#define MSG_TASK_NONE              16
+#define MSG_KEYWORD_CLASSIC        32
+#define MSG_KEYWORD_AUDIT_SUCCESS  33
+#define MSG_KEYWORD_AUDIT_FAILURE  34
+
+/* the language messages are given in: the publisher's locale's, or the user's */
+static LANGID message_lang( const struct publisher *publisher )
+{
+    if (publisher && publisher->locale) return LANGIDFROMLCID( publisher->locale );
+    return GetUserDefaultUILanguage();
+}
+
+/* a message of a module in the language, or as it has it, its insertions filled in and the line end after it
+ * taken off */
+static WCHAR *format_module( HMODULE module, DWORD id, LANGID lang, const WCHAR **args )
+{
+    DWORD flags = FORMAT_MESSAGE_FROM_HMODULE | FORMAT_MESSAGE_ALLOCATE_BUFFER |
+                  (args ? FORMAT_MESSAGE_ARGUMENT_ARRAY : FORMAT_MESSAGE_IGNORE_INSERTS);
+    WCHAR *text = NULL, *message;
+    size_t len;
+
+    if (!FormatMessageW( flags, module, id, lang, (WCHAR *)&text, 0, (va_list *)args ) &&
+        (!lang || !FormatMessageW( flags, module, id, 0, (WCHAR *)&text, 0, (va_list *)args )))
+        return NULL;
+    len = wcslen( text );
+    while (len && (text[len - 1] == '\r' || text[len - 1] == '\n')) text[--len] = 0;
+    message = strdupW( text );
+    LocalFree( text );
+    return message;
+}
+
+/* a message of one of the files */
+static WCHAR *format_from_files( const WCHAR *files, DWORD id, LANGID lang, const WCHAR **args )
+{
+    WCHAR *list, *file, *next, *message = NULL;
+
+    if (!files || !(list = strdupW( files ))) return NULL;
+    for (file = list; file && !message; file = next)
+    {
+        HMODULE module;
+
+        if ((next = wcschr( file, ';' ))) *next++ = 0;
+        if (!file[0]) continue;
+        if (!(module = LoadLibraryExW( file, NULL, LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_IMAGE_RESOURCE ))) continue;
+        message = format_module( module, id, lang, args );
+        FreeLibrary( module );
+    }
+    free( list );
+    return message;
+}
+
+static WCHAR *level_name( unsigned int level, LANGID lang )
+{
+    switch (level)
+    {
+    case 1: return format_module( instance, MSG_LEVEL_CRITICAL, lang, NULL );
+    case 2: return format_module( instance, MSG_LEVEL_ERROR, lang, NULL );
+    case 3: return format_module( instance, MSG_LEVEL_WARNING, lang, NULL );
+    case 5: return format_module( instance, MSG_LEVEL_VERBOSE, lang, NULL );
+    default: return format_module( instance, MSG_LEVEL_INFORMATION, lang, NULL );
+    }
+}
+
+/* copies a message with the terminators Windows gives each kind: two after a message, a level or a task, three
+ * after the keywords */
+static BOOL copy_message( const WCHAR *message, unsigned int nuls, DWORD size, WCHAR *buffer, DWORD *used )
+{
+    DWORD len = wcslen( message );
+
+    *used = len + nuls;
+    if (size < *used || !buffer)
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    memcpy( buffer, message, len * sizeof(WCHAR) );
+    memset( buffer + len, 0, nuls * sizeof(WCHAR) );
+    return TRUE;
+}
+
+/* the insertions a message takes: the strings passed, or the event's own; one the event has not got is empty
+ * (FormatMessage would read past them otherwise) */
+#define MAX_INSERTS 100
+
+static WCHAR *event_message( struct publisher *publisher, struct event *event, DWORD count, EVT_VARIANT *values )
+{
+    const WCHAR **args, *str;
+    WCHAR *message;
+    DWORD i;
+
+    if (!(args = calloc( MAX_INSERTS, sizeof(*args) ))) return NULL;
+    for (i = 0; i < MAX_INSERTS; i++) args[i] = L"";
+    if (count && values)
+    {
+        for (i = 0; i < count && i < MAX_INSERTS; i++)
+            args[i] = values[i].Type == EvtVarTypeString && values[i].StringVal ? values[i].StringVal : L"";
+    }
+    else
+    {
+        str = (const WCHAR *)((const BYTE *)event->record + event->record->StringOffset);
+        for (i = 0; i < event->record->NumStrings && i < MAX_INSERTS; i++)
+        {
+            args[i] = str;
+            str += wcslen( str ) + 1;
+        }
+    }
+    message = format_from_files( publisher ? publisher->event_files : NULL, event->record->EventID,
+                                 message_lang( publisher ), args );
+    free( args );
+    return message;
+}
+
+static WCHAR *task_message( struct publisher *publisher, struct event *event )
+{
+    WCHAR buffer[16], *message;
+
+    if (!event->record->EventCategory) return format_module( instance, MSG_TASK_NONE, message_lang( publisher ), NULL );
+    if (publisher && (message = format_from_files( publisher->category_files, event->record->EventCategory,
+                                                   message_lang( publisher ), NULL )))
+        return message;
+    swprintf( buffer, ARRAY_SIZE(buffer), L"(%u)", event->record->EventCategory );
+    return strdupW( buffer );
+}
+
+static WCHAR *keyword_message( struct publisher *publisher, struct event *event )
+{
+    switch (event->record->EventType)
+    {
+    case EVENTLOG_AUDIT_SUCCESS: return format_module( instance, MSG_KEYWORD_AUDIT_SUCCESS, message_lang( publisher ), NULL );
+    case EVENTLOG_AUDIT_FAILURE: return format_module( instance, MSG_KEYWORD_AUDIT_FAILURE, message_lang( publisher ), NULL );
+    default: return format_module( instance, MSG_KEYWORD_CLASSIC, message_lang( publisher ), NULL );
+    }
+}
+
+static unsigned int event_level( struct event *event )
+{
+    switch (event->record->EventType)
+    {
+    case EVENTLOG_ERROR_TYPE: return 2;
+    case EVENTLOG_WARNING_TYPE: return 3;
+    default: return 4;
+    }
+}
+
+/* the rendering Windows 11 adds to the event's XML: the message, if there is one, the level, task and keywords,
+ * in the language of the culture it names */
+static WCHAR *rendering_info( struct publisher *publisher, struct event *event, DWORD count, EVT_VARIANT *values )
+{
+    WCHAR *parts[4] = { NULL }, *message, *rendering = NULL, culture[LOCALE_NAME_MAX_LENGTH];
+    unsigned int i;
+
+    if (!LCIDToLocaleName( MAKELCID( message_lang( publisher ), SORT_DEFAULT ), culture, ARRAY_SIZE(culture), 0 ))
+        wcscpy( culture, L"en-US" );
+    if (publisher && (message = event_message( publisher, event, count, values )))
+    {
+        parts[0] = escape_xml( message );
+        free( message );
+    }
+    if ((message = level_name( event_level( event ), message_lang( publisher ) )))
+    {
+        parts[1] = escape_xml( message );
+        free( message );
+    }
+    if ((message = task_message( publisher, event )))
+    {
+        parts[2] = escape_xml( message );
+        free( message );
+    }
+    if ((message = keyword_message( publisher, event )))
+    {
+        parts[3] = escape_xml( message );
+        free( message );
+    }
+    if (parts[1] && parts[2] && parts[3])
+    {
+        size_t len = 256 + wcslen( culture ) + (parts[0] ? wcslen( parts[0] ) : 0) + wcslen( parts[1] ) +
+                     wcslen( parts[2] ) + wcslen( parts[3] );
+
+        if ((rendering = malloc( len * sizeof(WCHAR) )))
+            swprintf( rendering, len, L"<RenderingInfo Culture='%s'>%s%s%s<Level>%s</Level><Task>%s</Task>"
+                      L"<Keywords><Keyword>%s</Keyword></Keywords></RenderingInfo>", culture,
+                      parts[0] ? L"<Message>" : L"", parts[0] ? parts[0] : L"", parts[0] ? L"</Message>" : L"",
+                      parts[1], parts[2], parts[3] );
+    }
+    for (i = 0; i < ARRAY_SIZE(parts); i++) free( parts[i] );
+    return rendering;
+}
+
+BOOL WINAPI EvtFormatMessage( EVT_HANDLE publisher_handle, EVT_HANDLE event_handle, DWORD id, DWORD count,
+                              EVT_VARIANT *values, DWORD flags, DWORD size, WCHAR *buffer, DWORD *used )
+{
+    struct publisher *publisher = NULL;
+    struct event *event = NULL;
+    struct object *obj;
+    WCHAR *message = NULL;
+    unsigned int nuls = 2;
+    BOOL ret;
+
+    TRACE( "%p, %p, %#lx, %lu, %p, %#lx, %lu, %p, %p\n", publisher_handle, event_handle, id, count, values, flags,
+           size, buffer, used );
+
+    if (!used)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *used = 0;
+    if (publisher_handle)
+    {
+        if (!(obj = get_object( publisher_handle, OBJECT_PUBLISHER ))) return FALSE;
+        publisher = impl_from_publisher( obj );
+    }
+    if (event_handle)
+    {
+        if (!(obj = get_object( event_handle, OBJECT_EVENT ))) return FALSE;
+        event = impl_from_event( obj );
+    }
+    if (flags != EvtFormatMessageId && !event)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    switch (flags)
+    {
+    case EvtFormatMessageEvent:
+        if (!publisher || !(message = event_message( publisher, event, count, values )))
+        {
+            SetLastError( ERROR_EVT_MESSAGE_NOT_FOUND );
+            return FALSE;
+        }
+        break;
+    case EvtFormatMessageLevel:
+        message = level_name( event_level( event ), message_lang( publisher ) );
+        break;
+    case EvtFormatMessageTask:
+        message = task_message( publisher, event );
+        break;
+    case EvtFormatMessageKeyword:
+        message = keyword_message( publisher, event );
+        nuls = 3;
+        break;
+    case EvtFormatMessageId:
+        if (!publisher || !(message = format_from_files( publisher->event_files, id, message_lang( publisher ), NULL )))
+        {
+            SetLastError( ERROR_EVT_MESSAGE_ID_NOT_FOUND );
+            return FALSE;
+        }
+        break;
+    case EvtFormatMessageXml:
+    {
+        WCHAR *rendering = rendering_info( publisher, event, count, values );
+        struct node *tree;
+
+        if (rendering && (tree = build_event_tree( event )))
+        {
+            message = write_event_xml( tree, rendering );
+            free_node( tree );
+        }
+        free( rendering );
+        nuls = 1;
+        break;
+    }
+    case EvtFormatMessageOpcode:
+    case EvtFormatMessageChannel:
+    case EvtFormatMessageProvider:
+        /* a classic event has none of these */
+        SetLastError( ERROR_EVT_MESSAGE_ID_NOT_FOUND );
+        return FALSE;
+    default:
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!message)
+    {
+        SetLastError( ERROR_OUTOFMEMORY );
+        return FALSE;
+    }
+    ret = copy_message( message, nuls, size, buffer, used );
+    free( message );
+    return ret;
+}
+
+BOOL WINAPI EvtGetPublisherMetadataProperty( EVT_HANDLE handle, EVT_PUBLISHER_METADATA_PROPERTY_ID id, DWORD flags,
+                                             DWORD size, EVT_VARIANT *value, DWORD *used )
+{
+    struct publisher *publisher;
+    struct object *obj;
+
+    TRACE( "%p, %u, %#lx, %lu, %p, %p\n", handle, id, flags, size, value, used );
+
+    if (!(obj = get_object( handle, OBJECT_PUBLISHER ))) return FALSE;
+    publisher = impl_from_publisher( obj );
+    switch (id)
+    {
+    case EvtPublisherMetadataMessageFilePath:
+    case EvtPublisherMetadataResourceFilePath:
+        return set_variant_string( value, publisher->event_files ? publisher->event_files : L"", size, used );
+    case EvtPublisherMetadataPublisherGuid:
+        *used = sizeof(EVT_VARIANT);
+        if (size < sizeof(EVT_VARIANT) || !value)
+        {
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        memset( value, 0, sizeof(*value) );
+        value->Type = EvtVarTypeNull;
+        return TRUE;
+    default:
+        FIXME( "property %u not supported\n", id );
+        SetLastError( ERROR_NOT_SUPPORTED );
+        return FALSE;
+    }
 }
diff --git a/dlls/wevtapi/tests/wevtapi.c b/dlls/wevtapi/tests/wevtapi.c
index f304ce988d1..a94e7a60d4b 100644
--- a/dlls/wevtapi/tests/wevtapi.c
+++ b/dlls/wevtapi/tests/wevtapi.c
@@ -17,9 +17,12 @@
  */
 
 #include <stdarg.h>
+#include <stdio.h>
 
 #include "windef.h"
 #include "winbase.h"
+#include "winerror.h"
+#include "winnls.h"
 #include "winevt.h"
 #include "wine/test.h"
 
@@ -66,7 +69,563 @@ static void test_EvtGetChannelConfigProperty(void)
     RegCloseKey(key);
 }
 
+static DWORD query_count(const WCHAR *path, const WCHAR *text, DWORD flags)
+{
+    EVT_HANDLE results, events[16];
+    DWORD returned, total = 0, i;
+
+    if (!(results = EvtQuery(NULL, path, text, flags))) return ~0u;
+    while (EvtNext(results, ARRAY_SIZE(events), events, INFINITE, 0, &returned))
+    {
+        total += returned;
+        for (i = 0; i < returned; i++) EvtClose(events[i]);
+    }
+    ok(GetLastError() == ERROR_NO_MORE_ITEMS, "got %lu\n", GetLastError());
+    EvtClose(results);
+    return total;
+}
+
+static EVT_HANDLE first_event(const WCHAR *text)
+{
+    EVT_HANDLE results, event = NULL;
+    DWORD returned;
+
+    results = EvtQuery(NULL, L"System", text, EvtQueryChannelPath | EvtQueryReverseDirection);
+    ok(results != NULL, "EvtQuery error %lu\n", GetLastError());
+    if (!results) return NULL;
+    if (!EvtNext(results, 1, &event, INFINITE, 0, &returned)) event = NULL;
+    EvtClose(results);
+    return event;
+}
+
+/* the event log service writes these to the System log as it starts */
+static const WCHAR started[] = L"*[System[Provider[@Name='EventLog'] and EventID=6005]]";
+static const WCHAR version[] = L"*[System[Provider[@Name='EventLog'] and EventID=6009]]";
+
+static void test_EvtQuery(void)
+{
+    static const struct
+    {
+        const WCHAR *path, *text;
+        DWORD flags, error;
+    }
+    errors[] =
+    {
+        { L"System", L"*[System[EventID=", EvtQueryChannelPath, ERROR_EVT_INVALID_QUERY },
+        { L"System", L"*[System[foo(EventID)]]", EvtQueryChannelPath, ERROR_EVT_INVALID_QUERY },
+        { L"System", L"*[System[EventID=6005 and not(Level=2)]]", EvtQueryChannelPath, ERROR_EVT_INVALID_QUERY },
+        { L"wine-no-such-log", L"*", EvtQueryChannelPath, ERROR_EVT_CHANNEL_NOT_FOUND },
+        { L"C:\\wine-no-such-file.evtx", L"*", EvtQueryFilePath, ERROR_FILE_NOT_FOUND },
+        { L"System", L"*", EvtQueryChannelPath | EvtQueryFilePath, ERROR_INVALID_PARAMETER },
+        { NULL, L"*[System[EventID=6005]]", EvtQueryChannelPath, ERROR_EVT_INVALID_CHANNEL_PATH },
+    };
+    static const WCHAR *matching[] =
+    {
+        L"*[System[EventID[@Qualifiers='32768']=6005]]",
+        L"Event/System[EventID=6005]",
+        L"*[System[EventID=6005 and TimeCreated[timediff(@SystemTime) <= 3153600000000]]]",
+        L"*[System[EventID=6005 and TimeCreated[@SystemTime>='2000-01-01T00:00:00.000Z']]]",
+        L"*[System[EventID=6005 and band(Keywords,36028797018963968)]]",
+        L"*[System[EventID=6005 and Level!=2]]",
+        L"*[System[EventID=6005 and (Level=4 or Level=2)]]",
+    };
+    static WCHAR text[1024];
+    EVT_HANDLE results, events[2];
+    DWORD returned, count, i;
+    BOOL ret;
+
+    count = query_count(L"System", started, EvtQueryChannelPath);
+    if (!count || count == ~0u)
+    {
+        skip("no EventLog events in the System log\n");
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(errors); i++)
+    {
+        SetLastError(0xdeadbeef);
+        results = EvtQuery(NULL, errors[i].path, errors[i].text, errors[i].flags);
+        ok(!results, "%lu: got a query\n", i);
+        ok(GetLastError() == errors[i].error, "%lu: got %lu\n", i, GetLastError());
+        if (results) EvtClose(results);
+    }
+    for (i = 0; i < ARRAY_SIZE(matching); i++)
+        ok(query_count(L"System", matching[i], EvtQueryChannelPath) == count, "%lu: wrong count\n", i);
+    ok(!query_count(L"System", L"*[System[EventID=6005 and TimeCreated[timediff(@SystemTime) <= 1]]]",
+                    EvtQueryChannelPath), "got events from the last millisecond\n");
+    count = query_count(L"System", version, EvtQueryChannelPath);
+    ok(query_count(L"System", L"*[System[EventID=6009] and EventData[Data='Multiprocessor Free' or "
+                   L"Data='Uniprocessor Free']]", EvtQueryChannelPath) == count, "wrong count\n");
+    /* compared, a position is the element there; tested for, only the first element is */
+    ok(query_count(L"System", L"*[System[EventID=6009] and EventData[Data[4]='Multiprocessor Free' or "
+                   L"Data[4]='Uniprocessor Free']]", EvtQueryChannelPath) == count, "wrong count\n");
+    ok(query_count(L"System", L"*[System[EventID=6009] and EventData[Data[position()=4]='Multiprocessor Free' or "
+                   L"Data[position()=4]='Uniprocessor Free']]", EvtQueryChannelPath) == count, "wrong count\n");
+    ok(query_count(L"System", L"*[System[EventID=6009] and EventData[Data[3]='']]", EvtQueryChannelPath) == count,
+       "wrong count\n");
+    ok(!query_count(L"System", L"*[System[EventID=6009] and EventData[Data[3]='Multiprocessor Free']]",
+                    EvtQueryChannelPath), "wrong count\n");
+    ok(query_count(L"System", L"*[System[EventID=6009] and EventData[Data[1]]]", EvtQueryChannelPath) == count,
+       "wrong count\n");
+    ok(query_count(L"System", L"*[System[EventID=6009] and EventData[Data[2] or Data[1]]]", EvtQueryChannelPath) == count,
+       "wrong count\n");
+    ok(!query_count(L"System", L"*[System[EventID=6009] and EventData[Data[2]]]", EvtQueryChannelPath),
+       "wrong count\n");
+    ok(!query_count(L"System", L"*[System[EventID=6009] and EventData/Data[2]]", EvtQueryChannelPath), "wrong count\n");
+    ok(!query_count(L"System", L"*[System[EventID=6009] and EventData[Data[position()>1]]]", EvtQueryChannelPath),
+       "wrong count\n");
+    ok(!query_count(L"System", L"*[System[EventID=6009] and EventData[Data[0]]]", EvtQueryChannelPath),
+       "wrong count\n");
+    /* how far a query may go: 24 parentheses, 21 predicates, 23 operands of "or" or of "and"; band() of no
+     * band() */
+    for (i = 0; i < 4; i++)
+    {
+        static const unsigned int limits[] = { 24, 21, 23, 23 };
+        unsigned int n, j;
+        WCHAR *p = text;
+
+        for (n = limits[i]; n <= limits[i] + 1; n++)
+        {
+            p = text;
+            switch (i)
+            {
+            case 0:
+                p += swprintf(p, 32, L"*[System[");
+                for (j = 0; j < n; j++) *p++ = '(';
+                p += swprintf(p, 32, L"EventID=6005");
+                for (j = 0; j < n; j++) *p++ = ')';
+                wcscpy(p, L"]]");
+                break;
+            case 1:
+                *p++ = '*';
+                for (j = 0; j < n; j++) p += swprintf(p, 32, L"[System");
+                for (j = 0; j < n; j++) *p++ = ']';
+                *p = 0;
+                break;
+            case 2:
+            case 3:
+                p += swprintf(p, 32, L"*[System[");
+                for (j = 1; j < n; j++) p += swprintf(p, 32, i == 2 ? L"EventID=%u or " : L"EventID!=%u and ", 100000 + j);
+                wcscpy(p, L"EventID=6005]]");
+                break;
+            }
+            SetLastError(0xdeadbeef);
+            results = EvtQuery(NULL, L"System", text, EvtQueryChannelPath);
+            if (n == limits[i]) ok(results != NULL, "%lu, %u: EvtQuery error %lu\n", i, n, GetLastError());
+            else ok(!results && GetLastError() == ERROR_EVT_INVALID_QUERY, "%lu, %u: got %p, error %lu\n", i, n, results,
+                    GetLastError());
+            if (results) EvtClose(results);
+        }
+    }
+    SetLastError(0xdeadbeef);
+    results = EvtQuery(NULL, L"System", L"*[System[band(band(Keywords,36028797018963968),36028797018963968)]]",
+                       EvtQueryChannelPath);
+    ok(!results && GetLastError() == ERROR_EVT_INVALID_QUERY, "got %p, error %lu\n", results, GetLastError());
+
+    /* compared with a number, "10.00." is not 10 */
+    ok(!query_count(L"System", L"*[System[EventID=6009] and EventData[Data[1]=10]]", EvtQueryChannelPath),
+       "wrong count\n");
+    ok(query_count(L"System", L"*[System[EventID=6009] and EventData[Data[5]=0]]", EvtQueryChannelPath) == count,
+       "wrong count\n");
+    ok(query_count(L"System", L"*[System[EventID=6009] and EventData[Data>1000]]", EvtQueryChannelPath) == count,
+       "wrong count\n");
+
+    /* structured queries, a Suppress leaving out what its Select took */
+    ok(query_count(NULL, L"<QueryList><Query Id='0' Path='System'><Select>*[System[EventID=6005]]</Select></Query>"
+                   L"</QueryList>", EvtQueryChannelPath) == count, "wrong count\n");
+    ok(!query_count(NULL, L"<QueryList><Query Id='0'><Select Path='System'>*[System[EventID=6005]]</Select>"
+                    L"<Suppress Path='System'>*[System[Level=4]]</Suppress></Query></QueryList>", EvtQueryChannelPath),
+       "the Suppress let events through\n");
+
+    results = EvtQuery(NULL, L"System", started, EvtQueryChannelPath);
+    SetLastError(0xdeadbeef);
+    returned = 0xdeadbeef;
+    ret = EvtNext(results, 0, events, INFINITE, 0, &returned);
+    ok(!ret, "EvtNext succeeded\n");
+    ok(GetLastError() == ERROR_NO_MORE_ITEMS, "got %lu\n", GetLastError());
+    ok(!returned, "got %lu\n", returned);
+    EvtClose(results);
+}
