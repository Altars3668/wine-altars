 }
 
+/* the certificate a client presents, from a store by its subject or thumbprint, or from the caller's callback */
+static HRESULT get_client_cert( struct channel *channel )
+{
+    const CERT_CONTEXT *cert = NULL;
+    HCERTSTORE store;
+    HRESULT hr;
+
+    if (!channel->security.cert_type || channel->security.cert) return S_OK;
+    if (channel->security.cert_type == WS_CUSTOM_CERT_CREDENTIAL_TYPE)
+    {
+        if ((hr = channel->security.get_cert( channel->security.get_cert_state, &channel->addr, NULL, &cert,
+                                              NULL )) != S_OK) return hr;
+        if (!cert) return E_INVALIDARG;
+        channel->security.cert = cert;
+        return S_OK;
+    }
+
+    if (!(store = CertOpenStore( CERT_STORE_PROV_SYSTEM_W, 0, 0, channel->security.store_location |
+                                 CERT_STORE_OPEN_EXISTING_FLAG | CERT_STORE_READONLY_FLAG,
+                                 channel->security.store_name )))
+        return HRESULT_FROM_WIN32( GetLastError() );
+    if (channel->security.cert_type == WS_SUBJECT_NAME_CERT_CREDENTIAL_TYPE)
+        cert = CertFindCertificateInStore( store, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, 0, CERT_FIND_SUBJECT_STR_W,
+                                           channel->security.cert_name, NULL );
+    else
+    {
+        BYTE hash[20];
+        CRYPT_HASH_BLOB blob = { 0, hash };
+        DWORD size = sizeof(hash);
+
+        /* the thumbprint is the hash in hexadecimal, spaces as they may be */
+        if (CryptStringToBinaryW( channel->security.cert_name, 0, CRYPT_STRING_HEX, hash, &size, NULL, NULL ))
+        {
+            blob.cbData = size;
+            cert = CertFindCertificateInStore( store, X509_ASN_ENCODING | PKCS_7_ASN_ENCODING, 0, CERT_FIND_SHA1_HASH,
+                                               &blob, NULL );
+        }
+    }
+    if (cert) hr = S_OK;
+    else if ((hr = HRESULT_FROM_WIN32( GetLastError() )) == S_OK) hr = CRYPT_E_NOT_FOUND;
+    CertCloseStore( store, 0 );
+    if (cert) channel->security.cert = cert;
+    return hr;
+}
+
 static HRESULT open_channel_http( struct channel *channel )
 {
     HINTERNET ses = NULL, con = NULL;
@@ -1071,6 +1282,15 @@ static HRESULT open_channel_http( struct channel *channel )
         goto done;
     }
 
+    if (channel->security.protocols &&
+        !WinHttpSetOption( ses, WINHTTP_OPTION_SECURE_PROTOCOLS, &channel->security.protocols,
+                           sizeof(channel->security.protocols) ))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        goto done;
+    }
+    if (!channel->security.defer_cert && (hr = get_client_cert( channel )) != S_OK) goto done;
+
     channel->u.http.session = ses;
     channel->u.http.connect = con;
 
@@ -1525,9 +1745,26 @@ static HRESULT send_sized_envelope( struct channel *channel, BYTE *data, ULONG l
 
 static HRESULT open_http_request( struct channel *channel, HINTERNET *req )
 {
-    if ((*req = WinHttpOpenRequest( channel->u.http.connect, L"POST", channel->u.http.path,
-                                    NULL, NULL, NULL, channel->u.http.flags ))) return S_OK;
-    return HRESULT_FROM_WIN32( GetLastError() );
+    HRESULT hr;
+
+    if ((hr = get_client_cert( channel )) != S_OK) return hr;
+    if (!(*req = WinHttpOpenRequest( channel->u.http.connect, L"POST", channel->u.http.path,
+                                     NULL, NULL, NULL, channel->u.http.flags )))
+        return HRESULT_FROM_WIN32( GetLastError() );
+
+    if ((channel->security.ignore_flags &&
+         !WinHttpSetOption( *req, WINHTTP_OPTION_SECURITY_FLAGS, &channel->security.ignore_flags,
+                            sizeof(channel->security.ignore_flags) )) ||
+        (channel->security.cert &&
+         !WinHttpSetOption( *req, WINHTTP_OPTION_CLIENT_CERT_CONTEXT, (void *)channel->security.cert,
+                            sizeof(CERT_CONTEXT) )))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        WinHttpCloseHandle( *req );
+        *req = NULL;
+        return hr;
+    }
+    return S_OK;
 }
 
 static HRESULT send_message_bytes( struct channel *channel, WS_MESSAGE *msg )
