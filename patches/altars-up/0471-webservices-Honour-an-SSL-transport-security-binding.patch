+static int cert_asked;
+
+static HRESULT CALLBACK get_cert( void *state, const WS_ENDPOINT_ADDRESS *address, const WS_STRING *via,
+                                  const struct _CERT_CONTEXT **cert, WS_ERROR *error )
+{
+    cert_asked++;
+    ok( !via, "via set\n" );
+    *cert = NULL;
+    return E_FAIL;
+}
+
+/* An SSL transport binding: on an HTTP channel only, with the client certificate asked for when the channel
+ * opens, but a service proxy's not before its first call. */
+static void test_ssl_binding(void)
+{
+    ULONG failures = WS_CERT_FAILURE_CN_MISMATCH | WS_CERT_FAILURE_INVALID_DATE;
+    WS_SECURITY_BINDING_PROPERTY prop = { WS_SECURITY_BINDING_PROPERTY_CERT_FAILURES_TO_IGNORE, &failures,
+                                          sizeof(failures) };
+    WS_CUSTOM_CERT_CREDENTIAL custom = { { WS_CUSTOM_CERT_CREDENTIAL_TYPE }, get_cert };
+    WS_SSL_TRANSPORT_SECURITY_BINDING ssl = { { WS_SSL_TRANSPORT_SECURITY_BINDING_TYPE, &prop, 1 } };
+    WS_SECURITY_BINDING *bindings[] = { &ssl.binding };
+    WS_SECURITY_DESCRIPTION desc = { bindings, 1 };
+    WS_HTTP_SSL_POLICY_DESCRIPTION policy;
+    WS_HTTP_SSL_BINDING_TEMPLATE templ;
+    WS_ENDPOINT_ADDRESS addr;
+    WS_SERVICE_PROXY *proxy;
+    WS_CHANNEL *channel;
+    HRESULT hr;
+
+    hr = WsCreateChannel( WS_CHANNEL_TYPE_REQUEST, WS_HTTP_CHANNEL_BINDING, NULL, 0, &desc, &channel, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    WsFreeChannel( channel );
+    hr = WsCreateChannel( WS_CHANNEL_TYPE_REQUEST, WS_TCP_CHANNEL_BINDING, NULL, 0, &desc, &channel, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    memset( &addr, 0, sizeof(addr) );
+    addr.url.chars  = (WCHAR *)L"https://localhost:1/";
+    addr.url.length = wcslen( addr.url.chars );
+    ssl.binding.propertyCount = 0;
+    ssl.localCertCredential = &custom.credential;
+    hr = WsCreateChannel( WS_CHANNEL_TYPE_REQUEST, WS_HTTP_CHANNEL_BINDING, NULL, 0, &desc, &channel, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    cert_asked = 0;
+    hr = WsOpenChannel( channel, &addr, NULL, NULL );
+    ok( hr == E_FAIL, "got %#lx\n", hr );
+    ok( cert_asked == 1, "asked %d times\n", cert_asked );
