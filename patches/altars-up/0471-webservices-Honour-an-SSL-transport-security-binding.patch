+static WCHAR *dup_ws_string( const WS_STRING *str )
+{
+    WCHAR *ret;
+
+    if (!(ret = malloc( (str->length + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, str->chars, str->length * sizeof(WCHAR) );
+    ret[str->length] = 0;
+    return ret;
+}
+
+/* SP_PROT_* flags of the client side, each TLS version and SSL 3 */
+static const struct { DWORD sp_prot; DWORD winhttp; } secure_protocols[] =
+{
+    { 0x00000020, WINHTTP_FLAG_SECURE_PROTOCOL_SSL3 },
+    { 0x00000080, WINHTTP_FLAG_SECURE_PROTOCOL_TLS1 },
+    { 0x00000200, WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_1 },
+    { 0x00000800, WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_2 },
+    { 0x00002000, WINHTTP_FLAG_SECURE_PROTOCOL_TLS1_3 },
+};
+
+/* What an SSL transport binding asks of the channel's requests: certificate failures to ignore, protocols not to
+ * use, and the certificate to present. */
+static HRESULT set_ssl_binding( struct channel *channel, const WS_SSL_TRANSPORT_SECURITY_BINDING *ssl )
+{
+    const WS_CERT_CREDENTIAL *cred = ssl->localCertCredential;
+    ULONG i, j;
+
+    channel->security.ssl = TRUE;
+    for (i = 0; i < ssl->binding.propertyCount; i++)
+    {
+        const WS_SECURITY_BINDING_PROPERTY *prop = &ssl->binding.properties[i];
+
+        switch (prop->id)
+        {
+        case WS_SECURITY_BINDING_PROPERTY_CERT_FAILURES_TO_IGNORE:
+        {
+            ULONG failures;
+
+            if (prop->valueSize != sizeof(failures) || !prop->value) return E_INVALIDARG;
+            failures = *(const ULONG *)prop->value;
+            if (failures & WS_CERT_FAILURE_CN_MISMATCH) channel->security.ignore_flags |= SECURITY_FLAG_IGNORE_CERT_CN_INVALID;
+            if (failures & WS_CERT_FAILURE_INVALID_DATE) channel->security.ignore_flags |= SECURITY_FLAG_IGNORE_CERT_DATE_INVALID;
+            if (failures & WS_CERT_FAILURE_UNTRUSTED_ROOT) channel->security.ignore_flags |= SECURITY_FLAG_IGNORE_UNKNOWN_CA;
+            if (failures & WS_CERT_FAILURE_WRONG_USAGE) channel->security.ignore_flags |= SECURITY_FLAG_IGNORE_CERT_WRONG_USAGE;
+            break;
+        }
+        case WS_SECURITY_BINDING_PROPERTY_DISABLE_CERT_REVOCATION_CHECK:
+            /* the requests do not check revocation to begin with */
+            if (prop->valueSize != sizeof(BOOL) || !prop->value) return E_INVALIDARG;
+            break;
+
+        case WS_SECURITY_BINDING_PROPERTY_DISALLOWED_SECURE_PROTOCOLS:
+        {
+            ULONG disallowed;
+
+            if (prop->valueSize != sizeof(disallowed) || !prop->value) return E_INVALIDARG;
+            disallowed = *(const ULONG *)prop->value;
+            channel->security.protocols = 0;
+            for (j = 0; j < ARRAY_SIZE(secure_protocols); j++)
+                if (!(disallowed & secure_protocols[j].sp_prot))
+                    channel->security.protocols |= secure_protocols[j].winhttp;
+            break;
+        }
+        default:
+            FIXME( "SSL binding property %u not supported\n", prop->id );
+            break;
+        }
+    }
+
+    if (!cred) return S_OK;
+    channel->security.cert_type = cred->credentialType;
+    switch (cred->credentialType)
+    {
+    case WS_SUBJECT_NAME_CERT_CREDENTIAL_TYPE:
+    {
+        const WS_SUBJECT_NAME_CERT_CREDENTIAL *subject = (const WS_SUBJECT_NAME_CERT_CREDENTIAL *)cred;
+
+        channel->security.store_location = subject->storeLocation;
+        if (!(channel->security.store_name = dup_ws_string( &subject->storeName )) ||
+            !(channel->security.cert_name = dup_ws_string( &subject->subjectName ))) return E_OUTOFMEMORY;
+        break;
+    }
+    case WS_THUMBPRINT_CERT_CREDENTIAL_TYPE:
+    {
+        const WS_THUMBPRINT_CERT_CREDENTIAL *thumbprint = (const WS_THUMBPRINT_CERT_CREDENTIAL *)cred;
+
+        channel->security.store_location = thumbprint->storeLocation;
+        if (!(channel->security.store_name = dup_ws_string( &thumbprint->storeName )) ||
+            !(channel->security.cert_name = dup_ws_string( &thumbprint->thumbprint ))) return E_OUTOFMEMORY;
+        break;
+    }
+    case WS_CUSTOM_CERT_CREDENTIAL_TYPE:
+    {
+        const WS_CUSTOM_CERT_CREDENTIAL *custom = (const WS_CUSTOM_CERT_CREDENTIAL *)cred;
+
+        if (!custom->getCertCallback) return E_INVALIDARG;
+        channel->security.get_cert = custom->getCertCallback;
+        channel->security.get_cert_state = custom->getCertCallbackState;
+        break;
+    }
+    default:
+        return E_INVALIDARG;
+    }
+    return S_OK;
+}
+
+static HRESULT set_security_description( struct channel *channel, const WS_SECURITY_DESCRIPTION *desc )
+{
+    HRESULT hr;
+    ULONG i;
+
+    for (i = 0; i < desc->securityBindingCount; i++)
+    {
+        const WS_SECURITY_BINDING *binding = desc->securityBindings[i];
+
+        switch (binding->bindingType)
+        {
+        case WS_SSL_TRANSPORT_SECURITY_BINDING_TYPE:
+            if (channel->binding != WS_HTTP_CHANNEL_BINDING) return E_INVALIDARG;
+            if ((hr = set_ssl_binding( channel, (const WS_SSL_TRANSPORT_SECURITY_BINDING *)binding )) != S_OK)
+                return hr;
+            break;
+
+        default:
+            FIXME( "security binding type %u not supported\n", binding->bindingType );
+            break;
+        }
+    }
+    /* what they say is about message security, or about what the transport does anyway */
+    for (i = 0; i < desc->propertyCount; i++) TRACE( "security property %u\n", desc->properties[i].id );
+    return S_OK;
+}
+
+/* a service proxy's channel finds its client certificate for the first call, not when it opens */
+void channel_defer_client_cert( WS_CHANNEL *handle )
+{
+    struct channel *channel = (struct channel *)handle;
+
+    EnterCriticalSection( &channel->cs );
+    if (channel->magic == CHANNEL_MAGIC) channel->security.defer_cert = TRUE;
+    LeaveCriticalSection( &channel->cs );
+}
+
