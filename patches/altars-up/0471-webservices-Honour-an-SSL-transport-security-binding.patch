+/* Properties of the description and of the template together; one given in both is an error, as with channel
+ * properties. */
+static HRESULT merge_props( const void *desc_props, ULONG desc_count, const void *value_props, ULONG value_count,
+                            ULONG prop_size, void **ret, ULONG *ret_count )
+{
+    const BYTE *desc_ptr = desc_props, *value_ptr = value_props;
+    BYTE *props;
+    ULONG i, j;
+
+    *ret_count = 0;
+    if (!(props = malloc( max( desc_count + value_count, 1 ) * prop_size ))) return E_OUTOFMEMORY;
+    for (i = 0; i < desc_count; i++) memcpy( props + (*ret_count)++ * prop_size, desc_ptr + i * prop_size, prop_size );
+    for (i = 0; i < value_count; i++)
+    {
+        /* each property begins with its id */
+        for (j = 0; j < desc_count; j++)
+        {
+            if (*(const ULONG *)(desc_ptr + j * prop_size) == *(const ULONG *)(value_ptr + i * prop_size))
+            {
+                free( props );
+                return E_INVALIDARG;
+            }
+        }
+        memcpy( props + (*ret_count)++ * prop_size, value_ptr + i * prop_size, prop_size );
+    }
+    *ret = props;
+    return S_OK;
+}
+
