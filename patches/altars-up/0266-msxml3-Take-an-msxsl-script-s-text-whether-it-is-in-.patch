From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 09:25:34 -0400
Subject: [PATCH] msxml3: Take an msxsl:script's text whether it is in a CDATA
 section or not.

Scripts were only bound when the element's first child was a CDATA
section, so a script written as plain text was never registered and a
call to its function failed the transformation.  MSXML runs both.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 0abb760ad5a..660af29684c 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -3078,7 +3078,7 @@ static void node_transform_bind_scripts(xsltTransformContextPtr ctxt, IXMLDOMDoc
         xmlDocPtr sheet, struct xsl_scripts *scripts)
 {
     IActiveScriptSite *script_site;
-    xmlNodePtr root, child, node;
+    xmlNodePtr root, node;
     DWORD supported, enabled = 0;
     IObjectSafety *object_safety;
     xmlNsPtr ns;
@@ -3098,12 +3098,11 @@ static void node_transform_bind_scripts(xsltTransformContextPtr ctxt, IXMLDOMDoc
                 && xmlStrEqual(node->ns->prefix, BAD_CAST "msxsl")
                 && xmlStrEqual(node->ns->href, BAD_CAST "urn:schemas-microsoft-com:xslt"))
         {
-             child = node->children;
-
-             if (child && child->type == XML_CDATA_SECTION_NODE)
+             /* the script is the element's text, whether in CDATA sections or not */
+             if (node->children)
              {
                  IActiveScript *active_script;
-                 xmlChar *language, *prefix;
+                 xmlChar *language, *prefix, *content;
                  IActiveScriptParse *parser;
                  TYPEATTR *typeattr;
                  BSTR text, progid;
@@ -3150,7 +3149,9 @@ static void node_transform_bind_scripts(xsltTransformContextPtr ctxt, IXMLDOMDoc
                  IActiveScriptParse_InitNew(parser);
                  IActiveScript_SetScriptState(active_script, SCRIPTSTATE_STARTED);
 
-                 text = bstr_from_xmlChar(child->content);
+                 content = xmlNodeGetContent(node);
+                 text = bstr_from_xmlChar(content);
+                 xmlFree(content);
                  hr = IActiveScriptParse_ParseScriptText(parser, text, NULL, NULL, NULL, 0, 0, 0, NULL, NULL);
                  IActiveScriptParse_Release(parser);
                  SysFreeString(text);
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index b62c5c67635..09db82d3fac 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -6589,6 +6589,50 @@ static void test_cloneNode(void )
     free_bstrs();
 }
 
+static void test_xsl_script(void)
+{
+    static const char *stylesheets[] =
+    {
+        "<xsl:stylesheet version='1.0' xmlns:xsl='http://www.w3.org/1999/XSL/Transform'"
+        " xmlns:msxsl='urn:schemas-microsoft-com:xslt' xmlns:u='urn:user'>"
+        "<msxsl:script language='JScript' implements-prefix='u'>function f() { return 'scripted'; }</msxsl:script>"
+        "<xsl:output method='text'/><xsl:template match='/'>[<xsl:value-of select='u:f()'/>]</xsl:template>"
+        "</xsl:stylesheet>",
+        "<xsl:stylesheet version='1.0' xmlns:xsl='http://www.w3.org/1999/XSL/Transform'"
+        " xmlns:msxsl='urn:schemas-microsoft-com:xslt' xmlns:u='urn:user'>"
+        "<msxsl:script language='JScript' implements-prefix='u'><![CDATA[function f() { return 'scripted'; }]]>"
+        "</msxsl:script>"
+        "<xsl:output method='text'/><xsl:template match='/'>[<xsl:value-of select='u:f()'/>]</xsl:template>"
+        "</xsl:stylesheet>",
+    };
+    IXMLDOMDocument *doc, *style;
+    VARIANT_BOOL b;
+    unsigned int i;
+    HRESULT hr;
+    BSTR str;
+
+    doc = create_document(&IID_IXMLDOMDocument);
+    hr = IXMLDOMDocument_loadXML(doc, _bstr_("<r/>"), &b);
+    ok(hr == S_OK && b == VARIANT_TRUE, "Unexpected load %#lx, %d.\n", hr, b);
+
+    /* the script is the element's text, in a CDATA section or not */
+    for (i = 0; i < ARRAY_SIZE(stylesheets); ++i)
+    {
+        style = create_document(&IID_IXMLDOMDocument);
+        hr = IXMLDOMDocument_loadXML(style, _bstr_(stylesheets[i]), &b);
+        ok(hr == S_OK && b == VARIANT_TRUE, "%u: unexpected load %#lx, %d.\n", i, hr, b);
+        str = NULL;
+        hr = IXMLDOMDocument_transformNode(doc, (IXMLDOMNode *)style, &str);
+        ok(hr == S_OK, "%u: unexpected hr %#lx.\n", i, hr);
+        ok(str && !wcscmp(str, L"[scripted]"), "%u: unexpected result %s.\n", i, debugstr_w(str));
+        SysFreeString(str);
+        IXMLDOMDocument_Release(style);
+    }
+
+    IXMLDOMDocument_Release(doc);
+    free_bstrs();
+}
+
 static void test_cloneNode_prefix(void)
 {
     IXMLDOMNode *node, *clone, *attr;
@@ -19626,6 +19670,7 @@ START_TEST(domdoc)
     test_XSLPattern();
     test_cloneNode();
     test_cloneNode_prefix();
+    test_xsl_script();
     test_xmlTypes();
     test_save();
     test_testTransforms();
