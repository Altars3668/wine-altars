From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 02:31:51 -0400
Subject: [PATCH] ntdll: Answer a directory before a name collision when
 creating a file.

CreateFile(CREATE_NEW) on an existing directory fails with
ERROR_ACCESS_DENIED on Windows: the file options exclude a directory,
and that is found before the name being taken.  Wine answered
ERROR_FILE_EXISTS from the lookup, which checks the collision first.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 79310f4e72d..6fd41ac0e97 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -4731,8 +4731,6 @@ static void test_CreateFile(void)
             ok(GetLastError() == ERROR_INVALID_PARAMETER, "%ld: expected ERROR_INVALID_PARAMETER, got %ld\n", i, GetLastError());
         else
         {
-            /* FIXME: remove once Wine is fixed */
-            todo_wine_if (i == 1)
             ok(GetLastError() == ERROR_ACCESS_DENIED, "%ld: expected ERROR_ACCESS_DENIED, got %ld\n", i, GetLastError());
         }
 
@@ -4743,8 +4741,6 @@ static void test_CreateFile(void)
             ok(GetLastError() == ERROR_INVALID_PARAMETER, "%ld: expected ERROR_INVALID_PARAMETER, got %ld\n", i, GetLastError());
         else
         {
-            /* FIXME: remove once Wine is fixed */
-            todo_wine_if (i == 1)
             ok(GetLastError() == ERROR_ACCESS_DENIED, "%ld: expected ERROR_ACCESS_DENIED, got %ld\n", i, GetLastError());
         }
     }
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index a004b3d362a..b7f0c8d45d5 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4846,6 +4846,23 @@ NTSTATUS WINAPI NtCreateFile( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBU
     else status = get_nt_and_unix_names( &new_attr, &nt_name, &unix_name, disposition,
                                          options & FILE_OPEN_REPARSE_POINT );
 
+    /* a directory where a file is to be created is that before it is a name already taken */
+    if (status == STATUS_OBJECT_NAME_COLLISION && (options & FILE_NON_DIRECTORY_FILE))
+    {
+        OBJECT_ATTRIBUTES dir_attr = *attr;
+        UNICODE_STRING dir_nt_name;
+        char *dir_unix_name;
+        struct stat st;
+
+        if (!get_nt_and_unix_names( &dir_attr, &dir_nt_name, &dir_unix_name, FILE_OPEN,
+                                    options & FILE_OPEN_REPARSE_POINT ))
+        {
+            if (!stat( dir_unix_name, &st ) && S_ISDIR( st.st_mode )) status = STATUS_FILE_IS_A_DIRECTORY;
+        }
+        free( dir_unix_name );
+        free( dir_nt_name.Buffer );
+    }
+
     if (status == STATUS_BAD_DEVICE_TYPE)
     {
         status = server_open_file_object( handle, access, &new_attr, sharing, options );
