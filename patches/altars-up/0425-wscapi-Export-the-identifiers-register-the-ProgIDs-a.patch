From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 07:14:12 -0400
Subject: [PATCH] wscapi: Export the identifiers, register the ProgIDs, and
 answer as Windows 11 does.

Windows's wscapi.dll exports CLSID_WSCProductList, CLSID_WSCDefaultProduct,
IID_IWSCProductList, IID_IWSCDefaultProduct, IID_IWscProduct and
LIBID_wscAPILib as data, which a program linked with wscapi.lib imports, and
registers wscAPI.WSCProductList(.1).  Measured on build 29671: Item before
Initialize is E_INVALIDARG; Defender's settings need no action and its days
until expiry are ~0u.  A script gets an object, and then 0x8002801D,
TYPE_E_LIBNOTREGISTERED, from every call: the type library in that DLL says
version 2.0 and is registered as 1.0.  Wine answers IDispatch the same way.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wscapi/classes.idl b/dlls/wscapi/classes.idl
index ac04fb1faf1..9d3fb9bae82 100644
--- a/dlls/wscapi/classes.idl
+++ b/dlls/wscapi/classes.idl
@@ -20,8 +20,12 @@
 
 #pragma makedep register
 
+/* Windows registers it apartment-threaded, with proxies for its interfaces; without those, Wine has it live in
+ * whichever apartment creates it, as wbemprox's multithreaded one does. */
 [
     helpstring("WSCProductList Class"),
+    progid("wscAPI.WSCProductList.1"),
+    vi_progid("wscAPI.WSCProductList"),
     threading(both),
     uuid(17072f7b-9abe-4a74-a261-1eb76b55107a)
 ]
diff --git a/dlls/wscapi/main.c b/dlls/wscapi/main.c
index b5157f134b3..b87eb329c43 100644
--- a/dlls/wscapi/main.c
+++ b/dlls/wscapi/main.c
@@ -293,6 +293,8 @@ static ULONG WINAPI product_Release( IWscProduct3 *iface )
     return refcount;
 }
 
+/* Scripts get nowhere on Windows 11 either: the type library in its wscapi.dll says version 2.0 and is registered
+ * as 1.0, so every call through IDispatch fails with TYPE_E_LIBNOTREGISTERED.  Wine answers the same. */
 static HRESULT WINAPI product_GetTypeInfoCount( IWscProduct3 *iface, UINT *count )
 {
     TRACE( "%p, %p\n", iface, count );
@@ -302,23 +304,23 @@ static HRESULT WINAPI product_GetTypeInfoCount( IWscProduct3 *iface, UINT *count
 
 static HRESULT WINAPI product_GetTypeInfo( IWscProduct3 *iface, UINT index, LCID lcid, ITypeInfo **info )
 {
-    FIXME( "%p, %u, %#lx, %p stub\n", iface, index, lcid, info );
-    return E_NOTIMPL;
+    TRACE( "%p, %u, %#lx, %p\n", iface, index, lcid, info );
+    return TYPE_E_LIBNOTREGISTERED;
 }
 
 static HRESULT WINAPI product_GetIDsOfNames( IWscProduct3 *iface, REFIID iid, LPOLESTR *names, UINT count,
                                              LCID lcid, DISPID *ids )
 {
-    FIXME( "%p, %s, %p, %u, %#lx, %p stub\n", iface, debugstr_guid(iid), names, count, lcid, ids );
-    return E_NOTIMPL;
+    TRACE( "%p, %s, %p, %u, %#lx, %p\n", iface, debugstr_guid(iid), names, count, lcid, ids );
+    return TYPE_E_LIBNOTREGISTERED;
 }
 
 static HRESULT WINAPI product_Invoke( IWscProduct3 *iface, DISPID id, REFIID iid, LCID lcid, WORD flags,
                                      DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
 {
-    FIXME( "%p, %ld, %s, %#lx, %#x, %p, %p, %p, %p stub\n", iface, id, debugstr_guid(iid), lcid, flags,
+    TRACE( "%p, %ld, %s, %#lx, %#x, %p, %p, %p, %p\n", iface, id, debugstr_guid(iid), lcid, flags,
            params, result, excep, arg_err );
-    return E_NOTIMPL;
+    return TYPE_E_LIBNOTREGISTERED;
 }
 
 static HRESULT WINAPI product_get_ProductName( IWscProduct3 *iface, BSTR *val )
@@ -435,12 +437,16 @@ static HRESULT WINAPI product_get_AntivirusScanSubstatus( IWscProduct3 *iface, W
     return S_OK;
 }
 
+/* settings that need nothing done while it runs, as Windows 11 says of its Defender */
 static HRESULT WINAPI product_get_AntivirusSettingsSubstatus( IWscProduct3 *iface, WSC_SECURITY_PRODUCT_SUBSTATUS *status )
 {
+    struct product *product = impl_from_IWscProduct3( iface );
+
     TRACE( "%p, %p\n", iface, status );
 
     if (!status) return E_POINTER;
-    *status = WSC_SECURITY_PRODUCT_SUBSTATUS_NOT_SET;
+    *status = product->params.state == ANTIVIRUS_RUNNING ? WSC_SECURITY_PRODUCT_SUBSTATUS_NO_ACTION
+                                                         : WSC_SECURITY_PRODUCT_SUBSTATUS_ACTION_NEEDED;
     return S_OK;
 }
 
@@ -485,10 +491,14 @@ static HRESULT WINAPI product_get_FirewallPublicProfileSubstatus( IWscProduct3 *
     return firewall_substatus( status );
 }
 
+/* no subscription runs out: Windows 11 says ~0u for its Defender */
 static HRESULT WINAPI product_get_AntivirusDaysUntilExpired( IWscProduct3 *iface, DWORD *days )
 {
-    FIXME( "%p, %p stub\n", iface, days );
-    return E_NOTIMPL;
+    TRACE( "%p, %p\n", iface, days );
+
+    if (!days) return E_POINTER;
+    *days = ~0u;
+    return S_OK;
 }
 
 static const IWscProduct3Vtbl product_vtbl =
@@ -571,23 +581,23 @@ static HRESULT WINAPI product_list_GetTypeInfoCount( IWSCProductList *iface, UIN
 
 static HRESULT WINAPI product_list_GetTypeInfo( IWSCProductList *iface, UINT index, LCID lcid, ITypeInfo **info )
 {
-    FIXME( "%p, %u, %#lx, %p stub\n", iface, index, lcid, info );
-    return E_NOTIMPL;
+    TRACE( "%p, %u, %#lx, %p\n", iface, index, lcid, info );
+    return TYPE_E_LIBNOTREGISTERED;
 }
 
 static HRESULT WINAPI product_list_GetIDsOfNames( IWSCProductList *iface, REFIID iid, LPOLESTR *names, UINT count,
                                                   LCID lcid, DISPID *ids )
 {
-    FIXME( "%p, %s, %p, %u, %#lx, %p stub\n", iface, debugstr_guid(iid), names, count, lcid, ids );
-    return E_NOTIMPL;
+    TRACE( "%p, %s, %p, %u, %#lx, %p\n", iface, debugstr_guid(iid), names, count, lcid, ids );
+    return TYPE_E_LIBNOTREGISTERED;
 }
 
 static HRESULT WINAPI product_list_Invoke( IWSCProductList *iface, DISPID id, REFIID iid, LCID lcid, WORD flags,
                                           DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
 {
-    FIXME( "%p, %ld, %s, %#lx, %#x, %p, %p, %p, %p stub\n", iface, id, debugstr_guid(iid), lcid, flags,
+    TRACE( "%p, %ld, %s, %#lx, %#x, %p, %p, %p, %p\n", iface, id, debugstr_guid(iid), lcid, flags,
            params, result, excep, arg_err );
-    return E_NOTIMPL;
+    return TYPE_E_LIBNOTREGISTERED;
 }
 
 /* the products of one kind: an antivirus, a firewall or an antispyware product */
@@ -631,7 +641,6 @@ static HRESULT WINAPI product_list_get_Item( IWSCProductList *iface, ULONG index
     TRACE( "%p, %lu, %p\n", iface, index, val );
 
     if (!val) return E_POINTER;
-    if (!list->provider) return OLE_E_BLANK;
     if (index >= list->count) return E_INVALIDARG;
 
     if (!(product = calloc( 1, sizeof(*product) ))) return E_OUTOFMEMORY;
diff --git a/dlls/wscapi/tests/wscapi.c b/dlls/wscapi/tests/wscapi.c
index a6997d48f8a..7fd889f6ac2 100644
--- a/dlls/wscapi/tests/wscapi.c
+++ b/dlls/wscapi/tests/wscapi.c
@@ -154,7 +154,8 @@ static void test_product_list(ULONG provider)
     ok( count == 0xdeadbeef, "got count %ld\n", count );
     product = (IWscProduct *)0xdeadbeef;
     hr = IWSCProductList_get_Item( list, 0, &product );
-    trace( "item before initializing: %#lx, %p\n", hr, product );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( product == (IWscProduct *)0xdeadbeef, "got %p\n", product );
 
     hr = IWSCProductList_Initialize( list, provider );
     ok( hr == S_OK, "provider %#lx: got %#lx\n", provider, hr );
@@ -229,6 +230,59 @@ static void test_product_list(ULONG provider)
     IWSCProductList_Release( list );
 }
 
+/* the identifiers a program linked with wscapi.lib takes from the DLL itself */
+static void test_exports(void)
+{
+    static const struct
+    {
+        const char *name;
+        const GUID *guid;
+    }
+    exports[] =
+    {
+        { "CLSID_WSCDefaultProduct", &CLSID_WSCDefaultProduct },
+        { "CLSID_WSCProductList",    &CLSID_WSCProductList },
+        { "IID_IWSCDefaultProduct",  &IID_IWSCDefaultProduct },
+        { "IID_IWSCProductList",     &IID_IWSCProductList },
+        { "IID_IWscProduct",         &IID_IWscProduct },
+        { "LIBID_wscAPILib",         &LIBID_wscAPILib },
+    };
+    HMODULE module = GetModuleHandleA( "wscapi.dll" );
+    const GUID *guid;
+    unsigned int i;
+    CLSID clsid;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(exports); i++)
+    {
+        guid = (const GUID *)GetProcAddress( module, exports[i].name );
+        ok( guid && IsEqualGUID( guid, exports[i].guid ), "%s: got %s\n", exports[i].name,
+            guid ? wine_dbgstr_guid( guid ) : "nothing" );
+    }
+
+    hr = CLSIDFromProgID( L"wscAPI.WSCProductList", &clsid );
+    ok( hr == S_OK && IsEqualCLSID( &clsid, &CLSID_WSCProductList ), "got %#lx, %s\n", hr, wine_dbgstr_guid( &clsid ) );
+    hr = CLSIDFromProgID( L"wscAPI.WSCProductList.1", &clsid );
+    ok( hr == S_OK && IsEqualCLSID( &clsid, &CLSID_WSCProductList ), "got %#lx, %s\n", hr, wine_dbgstr_guid( &clsid ) );
+}
+
+/* Windows's own type library says version 2.0 and is registered as 1.0, so scripts get nowhere */
+static void test_dispatch(void)
+{
+    IWSCProductList *list;
+    OLECHAR *name = (OLECHAR *)L"Count";
+    DISPID id;
+    HRESULT hr;
+
+    hr = CoCreateInstance( &CLSID_WSCProductList, NULL, CLSCTX_INPROC_SERVER, &IID_IWSCProductList, (void **)&list );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (FAILED(hr)) return;
+    id = 0xdeadbeef;
+    hr = IWSCProductList_GetIDsOfNames( list, &IID_NULL, &name, 1, LOCALE_NEUTRAL, &id );
+    ok( hr == TYPE_E_LIBNOTREGISTERED, "got %#lx\n", hr );
+    IWSCProductList_Release( list );
+}
+
 static void test_product_list_initialize(void)
 {
     IWSCProductList *list;
@@ -254,6 +308,8 @@ START_TEST(wscapi)
 
     test_WscGetSecurityProviderHealth();
     test_WscRegisterForChanges();
+    test_exports();
+    test_dispatch();
     test_product_list( WSC_SECURITY_PROVIDER_ANTIVIRUS );
     test_product_list( WSC_SECURITY_PROVIDER_ANTISPYWARE );
     test_product_list( WSC_SECURITY_PROVIDER_FIREWALL );
