From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 01:26:12 -0400
Subject: [PATCH] ntdll: Check the buffer given to NtSetInformationFile as
 Windows does.

A buffer shorter than the information class needs gets
STATUS_INFO_LENGTH_MISMATCH, which the disposition test and the kernel32
SetFileInformationByHandle tests expect and [MS-FSA] 2.1.5.15 gives for
every class; Wine answered STATUS_INVALID_PARAMETER_3, and read a
mailslot's timeout from a buffer of any size.

A rename takes a name of whole characters that fits in the buffer,
failing with STATUS_INVALID_PARAMETER otherwise ([MS-FSA] 2.1.5.15.12),
and a link's name has to fit too; both were read past the end of the
buffer.  The wow64 thunk copied the name before any such check, into a
64-bit buffer one byte short of an odd length.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 91d7af0b486..167e1be4b20 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -6171,12 +6171,10 @@ static void test_SetFileInformationByHandle(void)
     /* test FileDispositionInfo, additional details already covered by ntdll tests */
     SetLastError(0xdeadbeef);
     ret = pSetFileInformationByHandle(file, FileDispositionInfo, &dispinfo, 0);
-    todo_wine
     ok(!ret && GetLastError() == ERROR_BAD_LENGTH, "got %d, error %ld\n", ret, GetLastError());
 
     SetLastError(0xdeadbeef);
     ret = pSetFileInformationByHandle(file, FileBasicInfo, &basicinfo, 0);
-    todo_wine
     ok(!ret && GetLastError() == ERROR_BAD_LENGTH, "got %d, error %ld\n", ret, GetLastError());
 
     memset(&basicinfo, 0, sizeof(basicinfo));
diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 3c069d95b18..9f00ae8e8ec 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -1766,6 +1766,7 @@ static void test_file_rename_information(FILE_INFORMATION_CLASS class)
     UNICODE_STRING name_str;
     HANDLE handle, handle2;
     IO_STATUS_BLOCK io;
+    ULONG name_len;
     NTSTATUS res;
 
     GetTempPathW( MAX_PATH, tmp_path );
@@ -1789,6 +1790,23 @@ static void test_file_rename_information(FILE_INFORMATION_CLASS class)
     memcpy( fri->FileName, name_str.Buffer, name_str.Length );
     pRtlFreeUnicodeString( &name_str );
 
+    /* the name is whole characters, all of them in the buffer */
+    name_len = fri->FileNameLength;
+    res = pNtSetInformationFile( handle, &io, fri, offsetof( FILE_RENAME_INFORMATION, FileName ) + name_len - 1, class );
+    if (class == FileRenameInformation || (res != STATUS_NOT_IMPLEMENTED && res != STATUS_INVALID_INFO_CLASS))
+    {
+        ok( res == STATUS_INVALID_PARAMETER, "got %#lx\n", res );
+        fri->FileNameLength = name_len - 1;
+        res = pNtSetInformationFile( handle, &io, fri, sizeof(FILE_RENAME_INFORMATION) + name_len, class );
+        ok( res == STATUS_INVALID_PARAMETER, "got %#lx\n", res );
+        fri->FileNameLength = 0;
+        res = pNtSetInformationFile( handle, &io, fri, sizeof(FILE_RENAME_INFORMATION), class );
+        ok( res == STATUS_INVALID_PARAMETER, "got %#lx\n", res );
+        fri->FileNameLength = name_len;
+        res = pNtSetInformationFile( handle, &io, fri, offsetof( FILE_RENAME_INFORMATION, FileName ), class );
+        ok( res == STATUS_INFO_LENGTH_MISMATCH, "got %#lx\n", res );
+    }
+
     io.Status = 0xdeadbeef;
     res = pNtSetInformationFile( handle, &io, fri, sizeof(FILE_RENAME_INFORMATION) + fri->FileNameLength, class );
 
@@ -3440,7 +3458,6 @@ static void test_file_disposition_information(void)
     handle = CreateFileA( buffer, GENERIC_WRITE | DELETE, 0, NULL, CREATE_ALWAYS, 0, 0 );
     ok( handle != INVALID_HANDLE_VALUE, "failed to create temp file\n" );
     res = pNtSetInformationFile( handle, &io, &fdi, 0, FileDispositionInformation );
-    todo_wine
     ok( res == STATUS_INFO_LENGTH_MISMATCH, "expected STATUS_INFO_LENGTH_MISMATCH, got %lx\n", res );
     fdi2 = 0x100;
     res = pNtSetInformationFile( handle, &io, &fdi2, sizeof(fdi2), FileDispositionInformation );
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 85074fcd52f..9b50672e2ba 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5382,7 +5382,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             if (needs_close) close( fd );
             free( unix_name );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FilePositionInformation:
@@ -5398,7 +5398,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
 
             if (needs_close) close( fd );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileEndOfFileInformation:
@@ -5414,7 +5414,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FilePipeInformation:
@@ -5437,10 +5437,11 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileMailslotSetInformation:
+        if (len >= sizeof(FILE_MAILSLOT_SET_INFORMATION))
         {
             FILE_MAILSLOT_SET_INFORMATION *info = ptr;
 
@@ -5453,6 +5454,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileCompletionInformation:
@@ -5469,7 +5471,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileIoCompletionNotificationInformation:
@@ -5534,7 +5536,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             if (needs_close) close( fd );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileDispositionInformation:
@@ -5550,7 +5552,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileDispositionInformationEx:
@@ -5569,7 +5571,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             }
             SERVER_END_REQ;
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileRenameInformation:
@@ -5582,6 +5584,14 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             OBJECT_ATTRIBUTES attr;
             char *unix_name;
 
+            /* the new name is whole characters, all of them in the buffer */
+            if (!info->FileNameLength || (info->FileNameLength & 1) ||
+                info->FileNameLength > len - offsetof( FILE_RENAME_INFORMATION, FileName ))
+            {
+                status = STATUS_INVALID_PARAMETER;
+                break;
+            }
+
             if (class == FileRenameInformation)
                 flags = info->ReplaceIfExists ? FILE_RENAME_REPLACE_IF_EXISTS : 0;
             else
@@ -5614,7 +5624,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             free( unix_name );
             free( nt_name.Buffer );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileLinkInformation:
@@ -5627,6 +5637,12 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             OBJECT_ATTRIBUTES attr;
             char *unix_name;
 
+            if (info->FileNameLength > len - offsetof( FILE_LINK_INFORMATION, FileName ))
+            {
+                status = STATUS_INVALID_PARAMETER;
+                break;
+            }
+
             if (class == FileLinkInformation)
                 flags = info->ReplaceIfExists ? FILE_LINK_REPLACE_IF_EXISTS : 0;
             else
@@ -5659,7 +5675,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             free( unix_name );
             free( nt_name.Buffer );
         }
-        else status = STATUS_INVALID_PARAMETER_3;
+        else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     default:
diff --git a/dlls/wow64/file.c b/dlls/wow64/file.c
index 3033ff20c19..5d8eec0bccf 100644
--- a/dlls/wow64/file.c
+++ b/dlls/wow64/file.c
@@ -829,11 +829,13 @@ NTSTATUS WINAPI wow64_NtSetInformationFile( UINT *args )
             FILE_RENAME_INFORMATION *info;
             ULONG size;
 
+            if (info32->FileNameLength > len - offsetof( FILE_RENAME_INFORMATION32, FileName ))
+                return STATUS_INVALID_PARAMETER;
             name.Buffer = info32->FileName;
             name.Length = info32->FileNameLength;
             InitializeObjectAttributes( &attr, &name, 0, LongToHandle( info32->RootDirectory ), 0 );
             get_file_redirect( &attr );
-            size = offsetof( FILE_RENAME_INFORMATION, FileName[name.Length/sizeof(WCHAR)] );
+            size = max( sizeof(*info), offsetof( FILE_RENAME_INFORMATION, FileName ) + name.Length );
             info = Wow64AllocateTemp( size );
             info->Flags           = info32->Flags;
             info->RootDirectory   = attr.RootDirectory;
@@ -841,7 +843,7 @@ NTSTATUS WINAPI wow64_NtSetInformationFile( UINT *args )
             memcpy( info->FileName, name.Buffer, info->FileNameLength );
             status = NtSetInformationFile( handle, iosb_32to64( &io, io32 ), info, size, class );
         }
-        else return STATUS_INVALID_PARAMETER_3;
+        else return STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     case FileCompletionInformation:   /* FILE_COMPLETION_INFORMATION */
@@ -854,7 +856,7 @@ NTSTATUS WINAPI wow64_NtSetInformationFile( UINT *args )
             info.CompletionKey  = info32->CompletionKey;
             status = NtSetInformationFile( handle, iosb_32to64( &io, io32 ), &info, sizeof(info), class );
         }
-        else return STATUS_INVALID_PARAMETER_3;
+        else return STATUS_INFO_LENGTH_MISMATCH;
         break;
 
     default:
