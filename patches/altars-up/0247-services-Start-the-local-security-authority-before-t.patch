From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 04:09:16 -0400
Subject: [PATCH] services: Start the local security authority before the
 services that start with the system.

Security packages are now listed, and LSA mode calls made, by lsass.exe,
the SamSs service, which a process starts the first time it needs it.
Starting it waits for the service control manager's startup lock, which
the control manager holds while it starts the services that start with
the system; a service that used SSPI as it started, as the Click-to-Run
service does, waited three seconds, failed with
ERROR_SERVICE_DATABASE_LOCKED, and was left without Negotiate, Kerberos
and NTLM for good.  Its App-V subsystem then failed to register the
interface every Office process calls as it starts, and no Office
application started.

On Windows, wininit starts lsass.exe before the service control manager
starts any service; the local security authority is now started first
here too.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/programs/services/services.c b/programs/services/services.c
index 988e8ba56f4..b9d2a77df3a 100644
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -411,7 +411,7 @@ static void scmdatabase_autostart_services(struct scmdatabase *db)
     unsigned int i = 0;
     unsigned int size = 32;
     unsigned int delayed_cnt = 0;
-    struct service_entry *service;
+    struct service_entry *service, *lsa;
     HDEVINFO set;
 
     services_list = malloc(size * sizeof(services_list[0]));
@@ -423,8 +423,17 @@ static void scmdatabase_autostart_services(struct scmdatabase *db)
 
     scmdatabase_lock(db);
 
+    /* The local security authority runs before any service does: on Windows, wininit starts lsass.exe before the
+     * service control manager starts services, and a service may call on it, through SSPI, as it starts, when
+     * starting it on demand would wait for the services being started. */
+    if ((lsa = scmdatabase_find_service(db, L"SamSs")) && lsa->config.dwStartType != SERVICE_DISABLED)
+        grab_service(lsa);
+    else
+        lsa = NULL;
+
     LIST_FOR_EACH_ENTRY(service, &db->services, struct service_entry, entry)
     {
+        if (service == lsa) continue;
         if (service->config.dwStartType == SERVICE_BOOT_START ||
             service->config.dwStartType == SERVICE_SYSTEM_START ||
             service->config.dwStartType == SERVICE_AUTO_START ||
@@ -448,6 +457,14 @@ static void scmdatabase_autostart_services(struct scmdatabase *db)
     qsort(services_list, size, sizeof(services_list[0]), compare_service);
     scmdatabase_lock_startup(db, INFINITE);
 
+    if (lsa)
+    {
+        DWORD err = service_start(lsa, 0, NULL);
+        if (err != ERROR_SUCCESS && err != ERROR_SERVICE_ALREADY_RUNNING)
+            WINE_FIXME("%s failed to start: %ld\n", wine_dbgstr_w(lsa->name), err);
+        release_service(lsa);
+    }
+
     for (i = 0; i < size; i++)
     {
         DWORD err;
