From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 22:01:05 -0400
Subject: [PATCH] vkd3d-shader/hlsl: Parse the "sample" interpolation modifier.

"sample float2 v : TEXCOORD" was refused with "Unknown modifier", so a
shader could not ask for an input interpolated at the sample.  It is now
a modifier, mapped to the linear-sample interpolation modes.  It is only
taken for one when it is followed by a name, as before a type; elsewhere
"sample" stays a name.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 0eea94d60a3f16b2c721d1fca3f0914782cbee93)

diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl.c b/libs/vkd3d/libs/vkd3d-shader/hlsl.c
index ac2b569ccfe..48d57c8b75c 100644
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl.c
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl.c
@@ -3575,6 +3575,8 @@ struct vkd3d_string_buffer *hlsl_modifiers_to_string(struct hlsl_ctx *ctx, uint3
         vkd3d_string_buffer_printf(string, "centroid ");
     if (modifiers & HLSL_STORAGE_NOPERSPECTIVE)
         vkd3d_string_buffer_printf(string, "noperspective ");
+    if (modifiers & HLSL_STORAGE_SAMPLE)
+        vkd3d_string_buffer_printf(string, "sample ");
     if (modifiers & HLSL_MODIFIER_PRECISE)
         vkd3d_string_buffer_printf(string, "precise ");
     if (modifiers & HLSL_STORAGE_SHARED)
diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl.h b/libs/vkd3d/libs/vkd3d-shader/hlsl.h
index 7d7a626e6ce..20f2eb28cc5 100644
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl.h
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl.h
@@ -432,13 +432,14 @@ struct hlsl_attribute
 #define HLSL_PRIMITIVE_TRIANGLE          0x01000000
 #define HLSL_PRIMITIVE_LINEADJ           0x02000000
 #define HLSL_PRIMITIVE_TRIANGLEADJ       0x04000000
+#define HLSL_STORAGE_SAMPLE              0x08000000
 
 #define HLSL_TYPE_MODIFIERS_MASK     (HLSL_MODIFIER_PRECISE | HLSL_MODIFIER_VOLATILE | \
                                       HLSL_MODIFIER_CONST | HLSL_MODIFIER_ROW_MAJOR | \
                                       HLSL_MODIFIER_COLUMN_MAJOR | HLSL_MODIFIER_UNORM | HLSL_MODIFIER_SNORM)
 
 #define HLSL_INTERPOLATION_MODIFIERS_MASK (HLSL_STORAGE_NOINTERPOLATION | HLSL_STORAGE_CENTROID | \
-                                           HLSL_STORAGE_NOPERSPECTIVE | HLSL_STORAGE_LINEAR)
+                                           HLSL_STORAGE_NOPERSPECTIVE | HLSL_STORAGE_LINEAR | HLSL_STORAGE_SAMPLE)
 
 #define HLSL_MODIFIERS_MAJORITY_MASK (HLSL_MODIFIER_ROW_MAJOR | HLSL_MODIFIER_COLUMN_MAJOR)
 
diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl.l b/libs/vkd3d/libs/vkd3d-shader/hlsl.l
index 85f0d89aa86..9d466c189bc 100644
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl.l
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl.l
@@ -112,6 +112,8 @@ LineStream              {return KW_LINESTREAM;          }
 line                    {return KW_LINE;                }
 lineadj                 {return KW_LINEADJ;             }
 linear                  {return KW_LINEAR;              }
+    /* "sample" is only a modifier before a type, and remains a name elsewhere. */
+sample/[ \t\r\n]+[A-Za-z_] {return KW_SAMPLE;             }
 matrix                  {return KW_MATRIX;              }
 namespace               {return KW_NAMESPACE;           }
 nointerpolation         {return KW_NOINTERPOLATION;     }
diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl.y b/libs/vkd3d/libs/vkd3d-shader/hlsl.y
index 0f9a5ac89fb..42d8ccd9798 100644
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl.y
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl.y
@@ -7117,6 +7117,7 @@ static void validate_uav_type(struct hlsl_ctx *ctx, enum hlsl_sampler_dim dim,
 %token KW_NAMESPACE
 %token KW_NOINTERPOLATION
 %token KW_NOPERSPECTIVE
+%token KW_SAMPLE
 %token KW_NULL
 %token KW_OUT
 %token KW_OUTPUTPATCH
@@ -9075,6 +9076,10 @@ var_modifiers:
         {
             $$ = add_modifiers(ctx, $2, HLSL_STORAGE_NOPERSPECTIVE, &@1);
         }
+    | KW_SAMPLE var_modifiers
+        {
+            $$ = add_modifiers(ctx, $2, HLSL_STORAGE_SAMPLE, &@1);
+        }
     | KW_SHARED var_modifiers
         {
             $$ = add_modifiers(ctx, $2, HLSL_STORAGE_SHARED, &@1);
diff --git a/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c b/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
index a58f6051b69..63b39f66d99 100644
--- a/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
+++ b/libs/vkd3d/libs/vkd3d-shader/hlsl_codegen.c
@@ -8208,6 +8208,8 @@ static enum vkd3d_shader_interpolation_mode get_interpolation_mode(const struct
     }
     modes[] =
     {
+        {HLSL_STORAGE_SAMPLE | HLSL_STORAGE_NOPERSPECTIVE, VKD3DSIM_LINEAR_NOPERSPECTIVE_SAMPLE},
+        {HLSL_STORAGE_SAMPLE, VKD3DSIM_LINEAR_SAMPLE},
         {HLSL_STORAGE_CENTROID | HLSL_STORAGE_NOPERSPECTIVE, VKD3DSIM_LINEAR_NOPERSPECTIVE_CENTROID},
         {HLSL_STORAGE_NOPERSPECTIVE, VKD3DSIM_LINEAR_NOPERSPECTIVE},
         {HLSL_STORAGE_CENTROID, VKD3DSIM_LINEAR_CENTROID},
