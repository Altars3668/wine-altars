+    ok( !new_element, "40 was not there\n" );
+    ok( avl_compare_calls == 3, "got %d compares\n", avl_compare_calls );
+    ok( *(int *)data == 40 && avl_links( data )->Parent->RightChild == avl_links( data ), "got %p\n", data );
+    ok( !pRtlIsGenericTableEmptyAvl( &table ), "empty\n" );
+    ok( pRtlNumberGenericTableElementsAvl( &table ) == 20, "got %lu\n", pRtlNumberGenericTableElementsAvl( &table ) );
+
+    for (value = 0; value <= 100; value++)
+    {
+        data = pRtlLookupElementGenericTableAvl( &table, &value );
+        if (data) ok( *(int *)data == value, "looked up %d, got %d\n", value, *(int *)data );
+        else ok( value % 5 || value == 0 || value == 15 || value == 55 || value == 65 || value == 75 || value == 85
+                 || value == 100, "%d not found\n", value );
+    }
+    ok( !table.OrderedPointer && !table.RestartKey, "lookups moved the cursors\n" );
+
+    /* enumerating keeps its place in RestartKey, and stays at the last element */
+    data = pRtlEnumerateGenericTableAvl( &table, FALSE );
+    ok( data && *(int *)data == 1, "without a key, got %p\n", data );
+    for (i = 0, data = pRtlEnumerateGenericTableAvl( &table, TRUE ); data;
+         data = pRtlEnumerateGenericTableAvl( &table, FALSE ), i++)
+    {
+        ok( i < ARRAY_SIZE(sorted) && *(int *)data == sorted[i], "%u: got %d\n", i, *(int *)data );
+        ok( table.RestartKey == avl_links( data ), "%u: got restart key %p\n", i, table.RestartKey );
+    }
+    ok( i == ARRAY_SIZE(sorted), "got %u elements\n", i );
+    ok( avl_value( table.RestartKey ) == 99, "got restart key %d\n", avl_value( table.RestartKey ) );
+    ok( !pRtlEnumerateGenericTableAvl( &table, FALSE ), "enumerated past the end\n" );
+    for (i = 0, restart = NULL; (data = pRtlEnumerateGenericTableWithoutSplayingAvl( &table, &restart )); i++)
+    {
+        ok( i < ARRAY_SIZE(sorted) && *(int *)data == sorted[i], "%u: got %d\n", i, *(int *)data );
+        ok( restart == avl_links( data ), "%u: got restart key %p\n", i, restart );
+    }
+    ok( i == ARRAY_SIZE(sorted), "got %u elements\n", i );
+    ok( avl_value( restart ) == 99, "got restart key %d\n", avl_value( restart ) );
+
+    /* elements by index, in order, remembering the last one */
+    for (i = 0; i < ARRAY_SIZE(sorted); i++)
+    {
+        data = pRtlGetElementGenericTableAvl( &table, i );
+        ok( data && *(int *)data == sorted[i], "%u: got %p\n", i, data );
+        ok( table.OrderedPointer == avl_links( data ) && table.WhichOrderedElement == i, "%u: got %p %lu\n", i,
+            table.OrderedPointer, table.WhichOrderedElement );
+    }
+    ok( !pRtlGetElementGenericTableAvl( &table, 20 ), "got element 20\n" );
+    ok( !pRtlGetElementGenericTableAvl( &table, ~0u ), "got element ~0\n" );
+    ok( table.WhichOrderedElement == 19, "got %lu\n", table.WhichOrderedElement );
+    data = pRtlGetElementGenericTableAvl( &table, 5 );
+    ok( *(int *)data == 30 && table.WhichOrderedElement == 5, "got %d %lu\n", *(int *)data, table.WhichOrderedElement );
+    data = pRtlGetElementGenericTableAvl( &table, 16 );
+    ok( *(int *)data == 80 && table.WhichOrderedElement == 16, "got %d %lu\n", *(int *)data, table.WhichOrderedElement );
+
+    /* the next or the previous element takes a deleted one's place, from the deeper side; a deleted restart key
+     * becomes the previous element, and the element cursor goes */
+    for (i = 0; i < ARRAY_SIZE(deletes); i++)
+    {
+        BOOLEAN ret;
+
+        winetest_push_context( "delete %d", deletes[i].value );
+        pRtlGetElementGenericTableAvl( &table, 3 );
+        avl_frees = 0;
+        value = deletes[i].value;
+        avl_buffer = &value;
+        avl_compare_misordered = 0;
+        ret = pRtlDeleteElementGenericTableAvl( &table, &value );
+        avl_buffer = NULL;
+        ok( ret == deletes[i].found, "got %d\n", ret );
+        ok( !avl_compare_misordered, "the buffer was not the first to compare\n" );
+        ok( avl_frees == ret, "got %d frees\n", avl_frees );
+        ok( !strcmp( avl_tree( &table ), deletes[i].tree ), "got %s\n", avl_tree( &table ) );
+        ok( table.DepthOfTree == deletes[i].depth, "got depth %lu\n", table.DepthOfTree );
+        ok( table.BalancedRoot.Balance == deletes[i].root_balance, "got balance %d\n", table.BalancedRoot.Balance );
+        ok( ret ? !table.OrderedPointer && !table.WhichOrderedElement : table.WhichOrderedElement == 3,
+            "got cursor %p %lu\n", table.OrderedPointer, table.WhichOrderedElement );
+        winetest_pop_context();
+    }
+    ok( table.DeleteCount == 10, "got %lu deletes\n", table.DeleteCount );
+    ok( avl_value( table.RestartKey ) == 90, "got restart key %d\n", avl_value( table.RestartKey ) );
+    while ((data = pRtlGetElementGenericTableAvl( &table, 0 )))
+    {
+        value = *(int *)data;
+        ok( pRtlDeleteElementGenericTableAvl( &table, &value ), "%d not deleted\n", value );
+    }
+    ok( !table.BalancedRoot.RightChild && !table.DepthOfTree && table.BalancedRoot.Balance == -1, "got %p %lu %d\n",
+        table.BalancedRoot.RightChild, table.DepthOfTree, table.BalancedRoot.Balance );
+    ok( !table.RestartKey && table.DeleteCount == 20, "got %p %lu\n", table.RestartKey, table.DeleteCount );
+    ok( pRtlIsGenericTableEmptyAvl( &table ), "not empty\n" );
+
+    /* an insert, even of a value that is there, loses the cursor, unless the allocation fails */
+    avl_init( &table );
+    for (i = 1; i <= 9; i++) avl_insert( &table, i * 10 );
+    pRtlGetElementGenericTableAvl( &table, 3 );
+    value = 30;
+    pRtlInsertElementGenericTableAvl( &table, &value, sizeof(value), NULL );
+    ok( !table.OrderedPointer && !table.WhichOrderedElement, "got cursor %lu\n", table.WhichOrderedElement );
+    pRtlGetElementGenericTableAvl( &table, 3 );
+    avl_refuse = 1;
+    value = 35;
+    new_element = 0xcc;
+    data = pRtlInsertElementGenericTableAvl( &table, &value, sizeof(value), &new_element );
+    avl_refuse = 0;
+    ok( !data && !new_element, "got %p %d\n", data, new_element );
+    ok( table.WhichOrderedElement == 3, "got cursor %lu\n", table.WhichOrderedElement );
+    ok( table.NumberGenericTableElements == 9, "got %lu elements\n", table.NumberGenericTableElements );
+    value = 5;
+    data = pRtlInsertElementGenericTableAvl( &table, &value, 100, &new_element );
+    ok( new_element && avl_last_size == 100 + sizeof(RTL_BALANCED_LINKS), "allocated %ld\n", avl_last_size );
+    ok( !table.OrderedPointer && !table.WhichOrderedElement, "got cursor %lu\n", table.WhichOrderedElement );
+
+    /* deleting the restart key of an enumeration */
+    pRtlEnumerateGenericTableAvl( &table, TRUE );
+    pRtlEnumerateGenericTableAvl( &table, FALSE );
+    data = pRtlEnumerateGenericTableAvl( &table, FALSE );
+    ok( *(int *)data == 20, "got %d\n", *(int *)data );
+    value = 20;
+    pRtlDeleteElementGenericTableAvl( &table, &value );
+    ok( avl_value( table.RestartKey ) == 10, "got restart key %d\n", avl_value( table.RestartKey ) );
+    data = pRtlEnumerateGenericTableAvl( &table, FALSE );
+    ok( *(int *)data == 30, "got %d\n", *(int *)data );
+    value = 5;
+    pRtlDeleteElementGenericTableAvl( &table, &value );
+    value = 10;
+    pRtlDeleteElementGenericTableAvl( &table, &value );
+    ok( avl_value( table.RestartKey ) == 30, "got restart key %d\n", avl_value( table.RestartKey ) );
+    pRtlEnumerateGenericTableAvl( &table, TRUE );
+    value = 30;
+    pRtlDeleteElementGenericTableAvl( &table, &value );
+    ok( !table.RestartKey, "got restart key %d\n", avl_value( table.RestartKey ) );
+    while ((data = pRtlEnumerateGenericTableAvl( &table, TRUE ))) pRtlDeleteElementGenericTableAvl( &table, data );
+
+    /* the full lookup gives the node or the parent to insert under */
+    if (pRtlLookupElementGenericTableFullAvl && pRtlInsertElementGenericTableFullAvl)
+    {
+        static const struct { int value; int node; TABLE_SEARCH_RESULT result; } lookups[] =
+        {
+            { 5, 10, TableInsertAsLeft }, { 10, 10, TableFoundNode }, { 15, 10, TableInsertAsRight },
+            { 40, 40, TableFoundNode }, { 45, 50, TableInsertAsLeft }, { 75, 70, TableInsertAsRight },
+        };
+
+        avl_init( &table );
+        value = 5;
+        restart = (void *)0xdeadbeef;
+        result = 0xcc;
+        data = pRtlLookupElementGenericTableFullAvl( &table, &value, &restart, &result );
+        ok( !data && result == TableEmptyTree && restart == (void *)0xdeadbeef, "got %p %d %p\n", data, result, restart );
+        new_element = FALSE;
+        data = pRtlInsertElementGenericTableFullAvl( &table, &value, sizeof(value), &new_element, restart, result );
+        ok( new_element && *(int *)data == 5, "got %d\n", new_element );
+        ok( !strcmp( avl_tree( &table ), "5+0" ) && table.DepthOfTree == 1, "got %s\n", avl_tree( &table ) );
+        pRtlDeleteElementGenericTableAvl( &table, &value );
+
+        for (i = 0; i < 7; i++) avl_insert( &table, (int[]){ 40, 20, 60, 10, 30, 50, 70 }[i] );
+        for (i = 0; i < ARRAY_SIZE(lookups); i++)
+        {
+            value = lookups[i].value;
+            avl_buffer = &value;
+            avl_compare_misordered = 0;
+            data = pRtlLookupElementGenericTableFullAvl( &table, &value, (void **)&node, &result );
+            avl_buffer = NULL;
+            ok( result == lookups[i].result, "%d: got %d\n", value, result );
+            ok( avl_value( node ) == lookups[i].node, "%d: got %d\n", value, avl_value( node ) );
+            ok( result == TableFoundNode ? data == node + 1 : !data, "%d: got %p\n", value, data );
+            ok( !avl_compare_misordered, "the buffer was not the first to compare\n" );
+        }
+        value = 45;
+        pRtlLookupElementGenericTableFullAvl( &table, &value, (void **)&node, &result );
+        avl_compare_calls = 0;
+        data = pRtlInsertElementGenericTableFullAvl( &table, &value, sizeof(value), &new_element, node, result );
+        ok( new_element && *(int *)data == 45 && !avl_compare_calls, "got %d %d\n", new_element, avl_compare_calls );
+        ok( !strcmp( avl_tree( &table ), "40+1(20+0(10+0 30+0) 60-1(50-1(45+0 .) 70+0))" ), "got %s\n",
+            avl_tree( &table ) );
+        ok( table.DepthOfTree == 4 && !table.BalancedRoot.Balance, "got %lu %d\n", table.DepthOfTree,
+            table.BalancedRoot.Balance );
+        value = 20;
+        pRtlLookupElementGenericTableFullAvl( &table, &value, (void **)&node, &result );
+        pRtlGetElementGenericTableAvl( &table, 3 );
+        avl_allocations = 0;
+        data = pRtlInsertElementGenericTableFullAvl( &table, &value, sizeof(value), &new_element, node, result );
+        ok( !new_element && data == node + 1 && !avl_allocations, "got %d %d\n", new_element, avl_allocations );
+        ok( !table.OrderedPointer, "kept the cursor\n" );
+
+        if (pRtlDeleteElementGenericTableAvlEx)
+        {
+            value = 40;
+            pRtlLookupElementGenericTableFullAvl( &table, &value, (void **)&node, &result );
+            avl_compare_calls = avl_frees = 0;
+            pRtlDeleteElementGenericTableAvlEx( &table, node );
+            ok( !avl_compare_calls && avl_frees == 1 && avl_last_free == node, "got %d %d\n", avl_compare_calls,
+                avl_frees );
+            ok( !strcmp( avl_tree( &table ), "45+0(20+0(10+0 30+0) 60+0(50+0 70+0))" ), "got %s\n",
+                avl_tree( &table ) );
+            ok( table.DeleteCount == 2 && table.DepthOfTree == 3, "got %lu %lu\n", table.DeleteCount,
+                table.DepthOfTree );
+        }
+        else win_skip( "RtlDeleteElementGenericTableAvlEx is not available\n" );
+        while ((data = pRtlEnumerateGenericTableAvl( &table, TRUE ))) pRtlDeleteElementGenericTableAvl( &table, data );
+    }
+    else win_skip( "the full AVL functions are not available\n" );
+
+    /* the first of the elements the compare routine finds equal */
+    if (pRtlLookupFirstMatchingElementGenericTableAvl)
+    {
+        static const struct { int value, first, compares; } matches[] =
+        {
+            { 0, 5, 4 }, { 10, 11, 4 }, { 20, 21, 5 }, { 30, 31, 4 }, { 40, 40, 5 }, { 50, 0, 4 },
+        };
+
+        avl_init( &table );
+        for (i = 0; i < 10; i++) avl_insert( &table, (int[]){ 11, 25, 21, 29, 23, 31, 5, 27, 22, 40 }[i] );
+        ok( !strcmp( avl_tree( &table ), "25+0(21+0(11-1(5+0 .) 23-1(22+0 .)) 29+1(27+0 31+1(. 40+0)))" ),
+            "got %s\n", avl_tree( &table ) );
+        avl_compare_by_tens = 1;
+        for (i = 0; i < ARRAY_SIZE(matches); i++)
+        {
+            value = matches[i].value;
+            restart = (void *)0xdeadbeef;
+            avl_compare_calls = 0;
+            data = pRtlLookupFirstMatchingElementGenericTableAvl( &table, &value, &restart );
+            if (matches[i].first)
+            {
+                ok( data && *(int *)data == matches[i].first, "%d: got %p\n", value, data );
+                ok( restart == avl_links( data ), "%d: got restart key %p\n", value, restart );
+            }
+            else ok( !data && !restart, "%d: got %p %p\n", value, data, restart );
+            ok( avl_compare_calls == matches[i].compares, "%d: got %d compares\n", value, avl_compare_calls );
+        }
+        value = 20;
+        restart = NULL;
+        pRtlLookupFirstMatchingElementGenericTableAvl( &table, &value, &restart );
+        data = pRtlEnumerateGenericTableWithoutSplayingAvl( &table, &restart );
+        ok( *(int *)data == 22, "got %d\n", *(int *)data );
+        avl_compare_by_tens = 0;
+        while ((data = pRtlEnumerateGenericTableAvl( &table, TRUE ))) pRtlDeleteElementGenericTableAvl( &table, data );
+    }
+    else win_skip( "RtlLookupFirstMatchingElementGenericTableAvl is not available\n" );
+}
