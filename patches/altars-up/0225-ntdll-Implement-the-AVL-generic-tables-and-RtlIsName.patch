+/* what the AVL table asked its routines for */
+static int avl_compare_calls, avl_compare_by_tens, avl_compare_misordered, avl_allocations, avl_frees, avl_refuse;
+static LONG avl_last_size;
+static void *avl_buffer, *avl_last_allocation, *avl_last_free;
+
+static RTL_GENERIC_COMPARE_RESULTS WINAPI avl_compare( RTL_AVL_TABLE *table, void *first, void *second )
+{
+    int a = *(int *)first, b = *(int *)second;
+
+    avl_compare_calls++;
+    if (avl_buffer && first != avl_buffer) avl_compare_misordered++;
+    if (avl_compare_by_tens)
+    {
+        a /= 10;
+        b /= 10;
+    }
+    if (a < b) return GenericLessThan;
+    if (a > b) return GenericGreaterThan;
+    return GenericEqual;
+}
+
+static void * WINAPI avl_allocate( RTL_AVL_TABLE *table, LONG size )
+{
+    if (avl_refuse) return NULL;
+    avl_allocations++;
+    avl_last_size = size;
+    return avl_last_allocation = malloc( size );
+}
+
+static void WINAPI avl_free( RTL_AVL_TABLE *table, void *ptr )
+{
+    avl_frees++;
+    avl_last_free = ptr;
+    free( ptr );
+}
+
+static int avl_value( RTL_BALANCED_LINKS *links )
+{
+    return *(int *)(links + 1);
+}
+
+/* the tree as value, a ! for a wrong parent, balance, and the children in brackets, a dot for none */
+static void avl_shape( RTL_BALANCED_LINKS *links, RTL_BALANCED_LINKS *parent, char *out )
+{
+    if (!links)
+    {
+        strcat( out, "." );
+        return;
+    }
+    sprintf( out + strlen( out ), "%d%s%+d", avl_value( links ), links->Parent == parent ? "" : "!", links->Balance );
+    if (!links->LeftChild && !links->RightChild) return;
+    strcat( out, "(" );
+    avl_shape( links->LeftChild, links, out );
+    strcat( out, " " );
+    avl_shape( links->RightChild, links, out );
+    strcat( out, ")" );
+}
+
+static const char *avl_tree( RTL_AVL_TABLE *table )
+{
+    static char buffer[1024];
+
+    buffer[0] = 0;
+    avl_shape( table->BalancedRoot.RightChild, &table->BalancedRoot, buffer );
+    return buffer;
+}
+
+static RTL_BALANCED_LINKS *avl_links( void *data )
+{
+    return (RTL_BALANCED_LINKS *)data - 1;
+}
+
+static void avl_init( RTL_AVL_TABLE *table )
+{
+    memset( table, 0xcc, sizeof(*table) );
+    pRtlInitializeGenericTableAvl( table, avl_compare, avl_allocate, avl_free, (void *)0xdeadbeef );
+}
+
+static void *avl_insert( RTL_AVL_TABLE *table, int value )
+{
+    BOOLEAN new_element;
+    void *data;
+
+    avl_buffer = &value;
+    data = pRtlInsertElementGenericTableAvl( table, &value, sizeof(value), &new_element );
+    avl_buffer = NULL;
+    ok( new_element, "%d was there\n", value );
+    return data;
+}
