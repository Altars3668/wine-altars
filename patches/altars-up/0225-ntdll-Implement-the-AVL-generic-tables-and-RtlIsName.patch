-void WINAPI RtlInsertElementGenericTableAvl(PRTL_AVL_TABLE table, void *buffer, ULONG size, BOOL *element)
+void * WINAPI RtlInsertElementGenericTableAvl( RTL_AVL_TABLE *table, void *buffer, ULONG size, BOOLEAN *new_element )
+{
+    RTL_BALANCED_LINKS *links = NULL;
+    TABLE_SEARCH_RESULT result;
+
