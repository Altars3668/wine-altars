+/******************************************************************************
+ *           RtlEnumerateGenericTableLikeADirectory  (NTDLL.@)
+ *
+ * Continues from the restart key unless an element was deleted since, and otherwise from the buffer's place: its
+ * element, or the next one after it with next set, or the first one after where it would be.  The first element the
+ * match function takes is returned; any status but STATUS_NO_MATCH from it ends the enumeration there.
+ */
+void * WINAPI RtlEnumerateGenericTableLikeADirectory( RTL_AVL_TABLE *table, PRTL_AVL_MATCH_FUNCTION match,
+                                                      void *match_data, ULONG next, void **restart_key,
+                                                      ULONG *delete_count, void *buffer )
+{
+    RTL_BALANCED_LINKS *links;
+    NTSTATUS status;
+
+    TRACE( "%p %p %p %lu %p %p %p\n", table, match, match_data, next, restart_key, delete_count, buffer );
+
+    if (!table->NumberGenericTableElements)
+    {
+        *restart_key = NULL;
+        return NULL;
+    }
+    if ((links = *restart_key) && *delete_count == table->DeleteCount)
+    {
+        if (next) links = avl_successor( links );
+    }
+    else
+    {
+        switch (avl_find( table, buffer, &links ))
+        {
+        case TableFoundNode:
+            if (next) links = avl_successor( links );
+            break;
+        case TableInsertAsRight:
+            links = avl_successor( links );
+            break;
+        default:
+            break;
+        }
+    }
+
+    for (; links; links = avl_successor( links ))
+    {
+        status = match ? match( table, avl_data( links ), match_data ) : STATUS_SUCCESS;
+        if (status == STATUS_NO_MATCH) continue;
+        *restart_key = links;
+        *delete_count = table->DeleteCount;
+        return status == STATUS_SUCCESS ? avl_data( links ) : NULL;
+    }
     return NULL;
 }
 
+/******************************************************************************
+ *           RtlGetElementGenericTableAvl  (NTDLL.@)
+ *
+ * The element with that index in order, found from whichever is nearest of the first element, the last one and the
+ * last one found this way.
+ */
+void * WINAPI RtlGetElementGenericTableAvl( RTL_AVL_TABLE *table, ULONG index )
+{
+    ULONG count = table->NumberGenericTableElements, current, distance;
+    RTL_BALANCED_LINKS *links;
+
+    TRACE( "%p %lu\n", table, index );
+
+    if (index >= count) return NULL;
+
+    if (index <= count - 1 - index)
+    {
+        for (links = table->BalancedRoot.RightChild; links->LeftChild; links = links->LeftChild) ;
+        current = 0;
+        distance = index;
+    }
+    else
+    {
+        for (links = table->BalancedRoot.RightChild; links->RightChild; links = links->RightChild) ;
+        current = count - 1;
+        distance = count - 1 - index;
+    }
+    if (table->OrderedPointer)
+    {
+        ULONG ordered = table->WhichOrderedElement;
+        if ((ordered > index ? ordered - index : index - ordered) < distance)
+        {
+            links = table->OrderedPointer;
+            current = ordered;
+        }
+    }
+    for (; current < index; current++) links = avl_successor( links );
+    for (; current > index; current--) links = avl_predecessor( links );
+
+    table->OrderedPointer = links;
+    table->WhichOrderedElement = index;
+    return avl_data( links );
+}
