diff --git a/dlls/ntdll/path.c b/dlls/ntdll/path.c
index aaa1585bd13..a098b165add 100644
--- a/dlls/ntdll/path.c
+++ b/dlls/ntdll/path.c
@@ -869,6 +869,178 @@ BOOLEAN WINAPI RtlDoesFileExists_U(LPCWSTR file_name)
 }
 
 
+/* whether a name has a wildcard in its last component */
+static BOOL has_wildcards( const WCHAR *name, USHORT length )
+{
+    const WCHAR *p;
+
+    for (p = name + length / sizeof(WCHAR); p-- > name && *p != '\\';)
+        if (*p == '*' || *p == '?' || *p == '<' || *p == '>' || *p == '"') return TRUE;
+    return FALSE;
+}
+
+static inline WCHAR upcase_name_char( WCHAR ch, const WCHAR *table )
+{
+    return table ? table[ch] : RtlUpcaseUnicodeChar( ch );
+}
+
+/******************************************************************
+ *             RtlIsNameInExpression   (NTDLL.@)
+ *
+ * Matches a name against an expression with the wildcards of NtQueryDirectoryFile: * and ?, and the DOS ones,
+ * < for anything up to the last period, > for any character except that a period or the end of the name also ends
+ * a run of them, and " for a period or the end of the name.  To ignore case the expression has to be in upper
+ * case; the name is upcased with the table, or RtlUpcaseUnicodeChar() without one.
+ *
+ * This keeps the set of places in the expression that match the name so far, each place a state: the byte
+ * offset times two, plus three past a * or < that is done matching.  A set is in increasing order and never holds
+ * more than two states for each character of the expression and the final one.
+ */
+BOOLEAN WINAPI RtlIsNameInExpression( UNICODE_STRING *expression, UNICODE_STRING *name, BOOLEAN ignore_case,
+                                      WCHAR *upcase_table )
+{
+    USHORT local[2][34], *prev = local[0], *next = local[1], *buffer = NULL, *tmp;
+    USHORT name_offset = 0, expr_offset, step, state, max_state, offset;
+    ULONG count, dest, src, prev_dest, size;
+    BOOLEAN name_finished = FALSE, ret;
+    WCHAR ch = 0, expr_ch;
+
+    TRACE( "%s %s %d %p\n", debugstr_us(expression), debugstr_us(name), ignore_case, upcase_table );
+
+    if (!name->Length || !expression->Length) return !name->Length && !expression->Length;
+    if (expression->Length == sizeof(WCHAR) && expression->Buffer[0] == '*') return TRUE;
+
+    /* *X, with no other wildcard, needs no states: the name ends with X */
+    if (expression->Buffer[0] == '*' && !has_wildcards( expression->Buffer + 1, expression->Length - sizeof(WCHAR) ))
+    {
+        USHORT tail = expression->Length - sizeof(WCHAR), start, i;
+
+        if (name->Length < tail) return FALSE;
+        start = (name->Length - tail) / sizeof(WCHAR);
+        if (!ignore_case) return !memcmp( expression->Buffer + 1, name->Buffer + start, tail );
+        for (i = 0; i < tail / sizeof(WCHAR); i++)
+            if (upcase_name_char( name->Buffer[start + i], upcase_table ) != expression->Buffer[1 + i]) return FALSE;
+        return TRUE;
+    }
+
+    size = expression->Length / sizeof(WCHAR) * 2 + 4;
+    if (size > ARRAY_SIZE(local[0]))
+    {
+        if (!(buffer = RtlAllocateHeap( GetProcessHeap(), 0, 2 * size * sizeof(*buffer) ))) return FALSE;
+        prev = buffer;
+        next = buffer + size;
+    }
+
+    max_state = expression->Length * 2;
+    prev[0] = 0;
+    count = 1;
+
+    while (!name_finished)
+    {
+        if (name_offset < name->Length)
+        {
+            ch = name->Buffer[name_offset / sizeof(WCHAR)];
+            name_offset += sizeof(WCHAR);
+        }
+        else
+        {
+            /* one more round after the name, for what can match nothing at its end */
+            name_finished = TRUE;
+            if (prev[count - 1] == max_state) break;
+        }
+
+        src = dest = prev_dest = 0;
+        while (src < count)
+        {
+            expr_offset = (prev[src++] + 1) / 2;
+            step = 0;
+
+            /* what can match nothing continues, what needs this character stops */
+            for (;;)
+            {
+                if (expr_offset >= expression->Length) break;
+                expr_offset += step;
+                step = sizeof(WCHAR);
+                state = expr_offset * 2;
+                if (expr_offset >= expression->Length)
+                {
+                    if (expr_offset == expression->Length) next[dest++] = max_state;
+                    break;
+                }
+                expr_ch = expression->Buffer[expr_offset / sizeof(WCHAR)];
+
+                if (expr_ch == '*')
+                {
+                    next[dest++] = state;
+                    next[dest++] = state + 3;
+                    continue;
+                }
+                if (expr_ch == '<')
+                {
+                    BOOL eat_dot = FALSE;
+
+                    /* a period is taken unless it is the last one */
+                    if (!name_finished && ch == '.')
+                    {
+                        for (offset = name_offset; offset < name->Length; offset += sizeof(WCHAR))
+                            if (name->Buffer[offset / sizeof(WCHAR)] == '.')
+                            {
+                                eat_dot = TRUE;
+                                break;
+                            }
+                    }
+                    if (name_finished || ch != '.' || eat_dot) next[dest++] = state;
+                    next[dest++] = state + 3;
+                    continue;
+                }
+
+                state += 2 * sizeof(WCHAR);
+                if (expr_ch == '>')
+                {
+                    if (name_finished || ch == '.') continue;
+                    next[dest++] = state;
+                    break;
+                }
+                if (expr_ch == '"')
+                {
+                    if (name_finished) continue;
+                    if (ch == '.')
+                    {
+                        next[dest++] = state;
+                        break;
+                    }
+                }
+                if (name_finished) break;
+                if (expr_ch == '?' || expr_ch == (ignore_case ? upcase_name_char( ch, upcase_table ) : ch))
+                    next[dest++] = state;
+                break;
+            }
+
+            /* skip the states just reached from an earlier one */
+            if (src < count && prev_dest < dest)
+            {
+                for (; prev_dest < dest; prev_dest++)
+                    while (src < count && prev[src] < next[prev_dest]) src++;
+            }
+        }
+
+        if (!dest)
+        {
+            RtlFreeHeap( GetProcessHeap(), 0, buffer );
+            return FALSE;
+        }
+        tmp = prev;
+        prev = next;
+        next = tmp;
+        count = dest;
+    }
+
+    ret = prev[count - 1] == max_state;
+    RtlFreeHeap( GetProcessHeap(), 0, buffer );
+    return ret;
+}
+
+
