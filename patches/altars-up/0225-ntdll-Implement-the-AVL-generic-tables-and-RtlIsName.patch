  *
diff --git a/dlls/ntdll/rtl.c b/dlls/ntdll/rtl.c
index 04231658c1e..6fe65fa78aa 100644
--- a/dlls/ntdll/rtl.c
+++ b/dlls/ntdll/rtl.c
@@ -1573,53 +1573,493 @@ void WINAPI RtlRbRemoveNode( RTL_RB_TREE *tree, RTL_BALANCED_NODE *node )
     if (tree->root) tree->root->Red = 0;
 }
 
+/* An AVL table hangs its tree off the right of BalancedRoot, whose Parent points to itself and whose Balance stops
+ * the rebalancing walks at the top.  Each element is its RTL_BALANCED_LINKS followed by the caller's data. */
+
+static inline void *avl_data( RTL_BALANCED_LINKS *links )
+{
+    return links + 1;
+}
+
+static RTL_BALANCED_LINKS *avl_successor( RTL_BALANCED_LINKS *links )
+{
+    RTL_BALANCED_LINKS *child;
+
+    if ((child = links->RightChild))
+    {
+        while (child->LeftChild) child = child->LeftChild;
+        return child;
+    }
+    while (links == links->Parent->RightChild) links = links->Parent;
+    /* the root is the right child of BalancedRoot, where this stops */
+    if (links == links->Parent->LeftChild) return links->Parent;
+    return NULL;
+}
+
+static RTL_BALANCED_LINKS *avl_predecessor( RTL_BALANCED_LINKS *links )
+{
+    RTL_BALANCED_LINKS *child;
+
+    if ((child = links->LeftChild))
+    {
+        while (child->RightChild) child = child->RightChild;
+        return child;
+    }
+    while (links == links->Parent->LeftChild) links = links->Parent;
+    /* a right child comes after its parent, unless that is BalancedRoot */
+    if (links->Parent != links->Parent->Parent) return links->Parent;
+    return NULL;
+}
+
+/* finds the element comparing equal to the buffer, or the one it would be inserted under */
+static TABLE_SEARCH_RESULT avl_find( RTL_AVL_TABLE *table, void *buffer, RTL_BALANCED_LINKS **node_or_parent )
+{
+    RTL_BALANCED_LINKS *links = table->BalancedRoot.RightChild, *child;
+
+    if (!links) return TableEmptyTree;
+    for (;;)
+    {
+        switch (table->CompareRoutine( table, buffer, avl_data( links ) ))
+        {
+        case GenericLessThan:
+            if (!(child = links->LeftChild))
+            {
+                *node_or_parent = links;
+                return TableInsertAsLeft;
+            }
+            break;
+        case GenericGreaterThan:
+            if (!(child = links->RightChild))
+            {
+                *node_or_parent = links;
+                return TableInsertAsRight;
+            }
+            break;
+        default:
+            *node_or_parent = links;
+            return TableFoundNode;
+        }
+        links = child;
+    }
+}
+
+/* puts a node where its parent was, the parent becoming its child */
+static void avl_promote( RTL_BALANCED_LINKS *links )
+{
+    RTL_BALANCED_LINKS *parent = links->Parent, *grandparent = parent->Parent;
+
+    if (links == parent->LeftChild)
+    {
+        if ((parent->LeftChild = links->RightChild)) parent->LeftChild->Parent = parent;
+        links->RightChild = parent;
+    }
+    else
+    {
+        if ((parent->RightChild = links->LeftChild)) parent->RightChild->Parent = parent;
+        links->LeftChild = parent;
+    }
+    parent->Parent = links;
+    links->Parent = grandparent;
+    if (parent == grandparent->LeftChild) grandparent->LeftChild = links;
+    else grandparent->RightChild = links;
+}
+
+/* rotates a subtree two levels deeper on the side of its balance; returns whether it kept its height, which only
+ * happens after a delete, when the child on that side is balanced */
+static BOOL avl_rebalance( RTL_BALANCED_LINKS *links )
+{
+    CHAR side = links->Balance;
+    RTL_BALANCED_LINKS *child = side < 0 ? links->LeftChild : links->RightChild, *grandchild;
+
+    if (child->Balance == side)
+    {
+        avl_promote( child );
+        links->Balance = child->Balance = 0;
+        return FALSE;
+    }
+    if (!child->Balance)
+    {
+        avl_promote( child );
+        child->Balance = -side;
+        return TRUE;
+    }
+    grandchild = side < 0 ? child->RightChild : child->LeftChild;
+    avl_promote( grandchild );
+    avl_promote( grandchild );
+    links->Balance = grandchild->Balance == side ? -side : 0;
+    child->Balance = grandchild->Balance == -side ? side : 0;
+    grandchild->Balance = 0;
+    return FALSE;
+}
+
+static void avl_insert( RTL_AVL_TABLE *table, RTL_BALANCED_LINKS *links, RTL_BALANCED_LINKS *parent,
+                        TABLE_SEARCH_RESULT result )
+{
+    CHAR side;
+
+    table->NumberGenericTableElements++;
+    if (result == TableEmptyTree)
+    {
+        table->BalancedRoot.RightChild = links;
+        links->Parent = &table->BalancedRoot;
+        table->DepthOfTree = 1;
+        return;
+    }
+    if (result == TableInsertAsLeft) parent->LeftChild = links;
+    else parent->RightChild = links;
+    links->Parent = parent;
+
+    /* up while the subtrees grow; BalancedRoot, reached from the right, stops this with the tree one deeper */
+    table->BalancedRoot.Balance = -1;
+    for (;;)
+    {
+        side = links == links->Parent->LeftChild ? -1 : 1;
+        links = links->Parent;
+        if (!links->Balance) links->Balance = side;
+        else if (links->Balance != side)
+        {
+            links->Balance = 0;
+            if (links == &table->BalancedRoot) table->DepthOfTree++;
+            return;
+        }
+        else
+        {
+            avl_rebalance( links );
+            return;
+        }
+    }
+}
+
+static void avl_delete( RTL_AVL_TABLE *table, RTL_BALANCED_LINKS *links )
+{
+    RTL_BALANCED_LINKS *victim, *parent, *child;
+    CHAR side;
+
+    /* a node with two children gives its place to the next or the previous one, from its deeper side */
+    if (!links->LeftChild || !links->RightChild) victim = links;
+    else if (links->Balance >= 0) for (victim = links->RightChild; victim->LeftChild; victim = victim->LeftChild) ;
+    else for (victim = links->LeftChild; victim->RightChild; victim = victim->RightChild) ;
+
+    parent = victim->Parent;
+    child = victim->LeftChild ? victim->LeftChild : victim->RightChild;
+    if (victim == parent->LeftChild)
+    {
+        parent->LeftChild = child;
+        side = -1;
+    }
+    else
+    {
+        parent->RightChild = child;
+        side = 1;
+    }
+    if (child) child->Parent = parent;
+
+    /* up while the subtrees shrink; BalancedRoot, reached from the right, stops this with the tree one shallower */
+    table->BalancedRoot.Balance = 0;
+    for (;;)
+    {
+        if (parent->Balance == side) parent->Balance = 0;
+        else if (!parent->Balance)
+        {
+            parent->Balance = -side;
+            if (parent == &table->BalancedRoot) table->DepthOfTree--;
+            break;
+        }
+        else
+        {
+            if (avl_rebalance( parent )) break;
+            parent = parent->Parent;
+        }
+        side = parent == parent->Parent->LeftChild ? -1 : 1;
+        parent = parent->Parent;
+    }
+
+    if (victim != links)
+    {
+        *victim = *links;
+        if (links == links->Parent->LeftChild) links->Parent->LeftChild = victim;
+        else links->Parent->RightChild = victim;
+        if (victim->LeftChild) victim->LeftChild->Parent = victim;
+        if (victim->RightChild) victim->RightChild->Parent = victim;
+    }
+    table->NumberGenericTableElements--;
+}
+
 /***********************************************************************
  *           RtlInitializeGenericTableAvl  (NTDLL.@)
  */
-void WINAPI RtlInitializeGenericTableAvl(PRTL_AVL_TABLE table, PRTL_AVL_COMPARE_ROUTINE compare,
-                                         PRTL_AVL_ALLOCATE_ROUTINE allocate, PRTL_AVL_FREE_ROUTINE free, void *context)
+void WINAPI RtlInitializeGenericTableAvl( RTL_AVL_TABLE *table, PRTL_AVL_COMPARE_ROUTINE compare,
+                                          PRTL_AVL_ALLOCATE_ROUTINE allocate, PRTL_AVL_FREE_ROUTINE free, void *context )
 {
-    FIXME("%p %p %p %p %p: stub\n", table, compare, allocate, free, context);
+    TRACE( "%p %p %p %p %p\n", table, compare, allocate, free, context );
+
+    memset( table, 0, sizeof(*table) );
+    table->BalancedRoot.Parent = &table->BalancedRoot;
+    table->CompareRoutine = compare;
+    table->AllocateRoutine = allocate;
+    table->FreeRoutine = free;
+    table->TableContext = context;
+}
+
+/***********************************************************************
+ *           RtlIsGenericTableEmptyAvl  (NTDLL.@)
+ */
+BOOLEAN WINAPI RtlIsGenericTableEmptyAvl( RTL_AVL_TABLE *table )
+{
+    TRACE( "%p\n", table );
+    return !table->NumberGenericTableElements;
 }
 
