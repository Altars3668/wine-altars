+static NTSTATUS WINAPI avl_match( RTL_AVL_TABLE *table, void *data, void *match_data )
+{
+    int value = *(int *)data;
+
+    switch ((ULONG_PTR)match_data)
+    {
+    case 1: return value % 20 ? STATUS_NO_MATCH : STATUS_SUCCESS;
+    case 2: return value == 50 ? STATUS_NO_MORE_MATCHES : STATUS_NO_MATCH;
+    case 3: return value == 30 ? STATUS_INVALID_PARAMETER : STATUS_SUCCESS;
+    case 4: return value == 30 ? STATUS_MORE_ENTRIES : STATUS_NO_MATCH;
+    default: return value == 30 ? STATUS_BUFFER_OVERFLOW : STATUS_NO_MATCH;
+    }
+}
