+/***********************************************************************
+ *           RtlLookupElementGenericTableFullAvl  (NTDLL.@)
+ */
+void * WINAPI RtlLookupElementGenericTableFullAvl( RTL_AVL_TABLE *table, void *buffer, void **node_or_parent,
+                                                   TABLE_SEARCH_RESULT *result )
+{
+    TRACE( "%p %p %p %p\n", table, buffer, node_or_parent, result );
+
+    *result = avl_find( table, buffer, (RTL_BALANCED_LINKS **)node_or_parent );
+    return *result == TableFoundNode ? avl_data( *node_or_parent ) : NULL;
 }
 
 /******************************************************************************
- *  RtlNumberGenericTableElementsAvl  (NTDLL.@)
+ *           RtlLookupElementGenericTableAvl  (NTDLL.@)
+ */
+void * WINAPI RtlLookupElementGenericTableAvl( RTL_AVL_TABLE *table, void *buffer )
+{
+    RTL_BALANCED_LINKS *links;
+
+    TRACE( "%p %p\n", table, buffer );
+
+    if (avl_find( table, buffer, &links ) != TableFoundNode) return NULL;
+    return avl_data( links );
+}
+
+/***********************************************************************
+ *           RtlLookupFirstMatchingElementGenericTableAvl  (NTDLL.@)
+ *
+ * The first element in order of those the compare routine finds equal to the buffer.
  */
-ULONG WINAPI RtlNumberGenericTableElementsAvl(RTL_AVL_TABLE *table)
+void * WINAPI RtlLookupFirstMatchingElementGenericTableAvl( RTL_AVL_TABLE *table, void *buffer, void **restart_key )
 {
-    FIXME("(%p) stub!\n", table);
-    return 0;
+    RTL_BALANCED_LINKS *links, *prev;
+
+    TRACE( "%p %p %p\n", table, buffer, restart_key );
+
+    *restart_key = NULL;
+    if (avl_find( table, buffer, &links ) != TableFoundNode) return NULL;
+    while ((prev = avl_predecessor( links )) &&
+           table->CompareRoutine( table, buffer, avl_data( prev ) ) == GenericEqual)
+        links = prev;
+    *restart_key = links;
+    return avl_data( links );
+}
+
+/***********************************************************************
+ *           RtlInsertElementGenericTableFullAvl  (NTDLL.@)
+ */
+void * WINAPI RtlInsertElementGenericTableFullAvl( RTL_AVL_TABLE *table, void *buffer, ULONG size,
+                                                   BOOLEAN *new_element, void *node_or_parent,
+                                                   TABLE_SEARCH_RESULT result )
+{
+    RTL_BALANCED_LINKS *links = node_or_parent;
+
+    TRACE( "%p %p %lu %p %p %d\n", table, buffer, size, new_element, node_or_parent, result );
+
+    if (result != TableFoundNode)
+    {
+        if (!(links = table->AllocateRoutine( table, size + sizeof(*links) )))
+        {
+            if (new_element) *new_element = FALSE;
+            return NULL;
+        }
+        memset( links, 0, sizeof(*links) );
+        memcpy( avl_data( links ), buffer, size );
+        avl_insert( table, links, node_or_parent, result );
+    }
+    table->OrderedPointer = NULL;
+    table->WhichOrderedElement = 0;
+    if (new_element) *new_element = result != TableFoundNode;
+    return avl_data( links );
 }
 
