+static void test_RtlEnumerateGenericTableLikeADirectory(void)
+{
+    static const struct
+    {
+        int value;
+        ULONG next;
+        int restart;   /* -1 for none */
+        ULONG deletes;
+        ULONG_PTR match;
+        int ret, restart_after;
+        ULONG deletes_after;
+    }
+    tests[] =
+    {
+        /* from the buffer: its element, or the next one with next set, or the first one after it */
+        { 0, 0, -1, 0, 0, 10, 10, 0 },
+        { 0, 1, -1, 0, 0, 10, 10, 0 },
+        { 25, 0, -1, 0, 0, 30, 30, 0 },
+        { 25, 1, -1, 0, 0, 30, 30, 0 },
+        { 50, 0, -1, 0, 0, 50, 50, 0 },
+        { 50, 1, -1, 0, 0, 60, 60, 0 },
+        { 75, 1, -1, 0, 0, 80, 80, 0 },
+        { 100, 0, -1, 0, 0, 0, -1, 0 },
+        /* from the restart key, whatever the buffer, if nothing was deleted since */
+        { 30, 1, 30, 0, 0, 40, 40, 0 },
+        { 30, 0, 50, 0, 0, 50, 50, 0 },
+        { 99, 1, 60, 0, 0, 70, 70, 0 },
+        { 99, 1, 90, 0, 0, 0, 90, 0 },
+        { 40, 1, 60, 5, 0, 50, 50, 0 },
+        { 1000, 0, 90, 5, 0, 0, 90, 5 },
+        /* the match function passes, skips or ends */
+        { 10, 0, -1, 0, 1, 20, 20, 0 },
+        { 10, 1, 20, 0, 1, 40, 40, 0 },
+        { 10, 1, 80, 0, 1, 0, 80, 0 },
+        { 10, 0, -1, 7, 2, 0, 50, 0 },
+        { 10, 0, -1, 7, 3, 10, 10, 0 },
+        { 10, 1, 20, 0, 3, 0, 30, 0 },
+        { 10, 0, -1, 7, 4, 0, 30, 0 },
+        { 10, 0, -1, 7, 5, 0, 30, 0 },
+    };
+    RTL_BALANCED_LINKS *nodes[10] = { 0 };
+    RTL_AVL_TABLE table;
+    void *data, *restart;
+    ULONG deletes;
+    unsigned int i;
+    int value;
+
+    if (!pRtlEnumerateGenericTableLikeADirectory || !pRtlInitializeGenericTableAvl)
+    {
+        win_skip( "RtlEnumerateGenericTableLikeADirectory is not available\n" );
+        return;
+    }
+
+    avl_init( &table );
+    value = 0;
+    restart = &table;
+    deletes = 0;
+    data = pRtlEnumerateGenericTableLikeADirectory( &table, NULL, NULL, FALSE, &restart, &deletes, &value );
+    ok( !data && !restart && !deletes, "got %p %p %lu\n", data, restart, deletes );
+    for (i = 1; i <= 9; i++) nodes[i] = avl_links( avl_insert( &table, i * 10 ) );
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context( "%u", i );
+        value = tests[i].value;
+        restart = tests[i].restart == -1 ? NULL : nodes[tests[i].restart / 10];
+        deletes = tests[i].deletes;
+        data = pRtlEnumerateGenericTableLikeADirectory( &table, tests[i].match ? avl_match : NULL,
+                                                        (void *)tests[i].match, tests[i].next, &restart, &deletes,
+                                                        &value );
+        if (tests[i].ret) ok( data && *(int *)data == tests[i].ret, "got %p\n", data );
+        else ok( !data, "got %d\n", *(int *)data );
+        if (tests[i].restart_after == -1) ok( !restart, "got restart key %p\n", restart );
+        else ok( restart == nodes[tests[i].restart_after / 10], "got restart key %p\n", restart );
+        ok( deletes == tests[i].deletes_after, "got %lu deletes\n", deletes );
+        winetest_pop_context();
+    }
+
+    /* after a delete, the restart key is not used */
+    value = 70;
+    pRtlDeleteElementGenericTableAvl( &table, &value );
+    value = 40;
+    restart = nodes[4];
+    deletes = 0;
+    avl_compare_calls = 0;
+    data = pRtlEnumerateGenericTableLikeADirectory( &table, NULL, NULL, TRUE, &restart, &deletes, &value );
+    ok( data && *(int *)data == 50, "got %p\n", data );
+    ok( restart == nodes[5] && deletes == 1 && avl_compare_calls, "got %p %lu %d\n", restart, deletes,
+        avl_compare_calls );
+    avl_compare_calls = 0;
+    data = pRtlEnumerateGenericTableLikeADirectory( &table, NULL, NULL, TRUE, &restart, &deletes, &value );
+    ok( data && *(int *)data == 60 && !avl_compare_calls, "got %p %d\n", data, avl_compare_calls );
+    ok( !table.OrderedPointer && table.RestartKey != nodes[6], "moved the table's cursors\n" );
+
+    while ((data = pRtlEnumerateGenericTableAvl( &table, TRUE ))) pRtlDeleteElementGenericTableAvl( &table, data );
+    value = 0;
+    restart = &table;
+    deletes = 0;
+    data = pRtlEnumerateGenericTableLikeADirectory( &table, NULL, NULL, FALSE, &restart, &deletes, &value );
+    ok( !data && !restart && !deletes, "got %p %p %lu\n", data, restart, deletes );
+}
