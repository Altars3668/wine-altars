+    geometries[1] = ellipse_geometry;
+    hr = ID2D1Factory_CreateGeometryGroup(ctx.factory, D2D1_FILL_MODE_ALTERNATE, geometries, 2,
+            (ID2D1GeometryGroup **)&group);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    geometry_sink_init(&sink);
+    hr = ID2D1Geometry_Simplify(group, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_CUBICS_AND_LINES, NULL,
+            D2D1_DEFAULT_FLATTENING_TOLERANCE, (ID2D1SimplifiedGeometrySink *)&sink.ID2D1GeometrySink_iface);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    geometry_sink_check(&sink, D2D1_FILL_MODE_ALTERNATE, 2, &expected_figures[0], 1);
+    ok(sink.segment_flags == D2D1_PATH_SEGMENT_NONE, "Got unexpected flags %#lx.\n", sink.segment_flags);
+    geometry_sink_cleanup(&sink);
+    ID2D1Geometry_Release(group);
+
+    geometries[0] = square;
+    hr = ID2D1Factory_CreateGeometryGroup(ctx.factory, D2D1_FILL_MODE_WINDING, geometries, 2,
+            (ID2D1GeometryGroup **)&group);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Geometry_ComputeLength(group, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &length);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(compare_float(length, 102.5969f, 16), "Got unexpected length %.8e.\n", length);
+    check_point_at_length(group, NULL, 40.0f, -10.0f, 0.0f, 0.0f, -1.0f);
+    check_point_at_length(group, NULL, 45.0f, -8.650105f, -4.729044f, 0.5302292f, -0.8478543f);
+    ID2D1Geometry_Release(group);
+
+    /* A curve, a quadratic one, an arc, a line. */
+    hr = ID2D1Factory_CreatePathGeometry(ctx.factory, &path);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1PathGeometry_Open(path, &path_sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_point(&point, 0.0f, 0.0f);
+    ID2D1GeometrySink_BeginFigure(path_sink, point, D2D1_FIGURE_BEGIN_HOLLOW);
+    ID2D1GeometrySink_AddBezier(path_sink, &bezier);
+    ID2D1GeometrySink_AddQuadraticBezier(path_sink, &quadratic);
+    ID2D1GeometrySink_AddArc(path_sink, &arc);
+    set_point(&point, 30.0f, 10.0f);
+    ID2D1GeometrySink_AddLine(path_sink, point);
+    ID2D1GeometrySink_EndFigure(path_sink, D2D1_FIGURE_END_OPEN);
+    hr = ID2D1GeometrySink_Close(path_sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1GeometrySink_Release(path_sink);
+    hr = ID2D1PathGeometry_ComputeLength(path, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &length);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(compare_float(length, 50.53018f, 16), "Got unexpected length %.8e.\n", length);
+    check_point_at_length((ID2D1Geometry *)path, NULL, 0.0f, 0.0f, 0.0f, 0.1961161f, 0.9805807f);
