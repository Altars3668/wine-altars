+    ID2D1PathGeometry_Release(path);
+
+    /* A pentagram: its five points filled alternately, the whole of it winding. */
+    path = create_polygons(ctx.factory, D2D1_FILL_MODE_ALTERNATE, pentagram, &five, 1);
+    geometry_sink_init(&sink);
+    hr = ID2D1PathGeometry_Outline(path, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE,
