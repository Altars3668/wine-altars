+    ID2D1PathGeometry_Release(path);
+
+    ID2D1Geometry_Release(rounded);
+    ID2D1Geometry_Release(ellipse_geometry);
+    ID2D1Geometry_Release(square);
+    release_test_context(&ctx);
+}
+
+static ID2D1PathGeometry *create_widened(ID2D1Factory *factory, ID2D1Geometry *geometry, float width,
+        ID2D1StrokeStyle *style)
+{
+    ID2D1GeometrySink *sink;
+    ID2D1PathGeometry *path;
+    HRESULT hr;
+
+    hr = ID2D1Factory_CreatePathGeometry(factory, &path);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1PathGeometry_Open(path, &sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1Geometry_Widen(geometry, width, style, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE,
+            (ID2D1SimplifiedGeometrySink *)sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1GeometrySink_Close(sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1GeometrySink_Release(sink);
+    return path;
+}
