+
+#include "d2d1_private.h"
+#include <float.h>
+
+WINE_DEFAULT_DEBUG_CHANNEL(d2d);
+
+/*
+ * The figures of a geometry flattened into polylines, as Simplify would hand them out.  A segment that is
+ * part of a Bézier curve remembers which curve and where on it it runs, so the curve can be put back.
+ */
+
+struct d2d_flattener
+{
+    ID2D1SimplifiedGeometrySink ID2D1SimplifiedGeometrySink_iface;
+    struct d2d_polylines *polylines;
+    float tolerance;
+    D2D1_PATH_SEGMENT flags;
+    HRESULT hr;
+};
+
+static inline struct d2d_flattener *impl_from_ID2D1SimplifiedGeometrySink(ID2D1SimplifiedGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_flattener, ID2D1SimplifiedGeometrySink_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_flattener_QueryInterface(ID2D1SimplifiedGeometrySink *iface,
+        REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1SimplifiedGeometrySink) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_flattener_AddRef(ID2D1SimplifiedGeometrySink *iface)
+{
+    return 2;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_flattener_Release(ID2D1SimplifiedGeometrySink *iface)
+{
+    return 1;
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_SetFillMode(ID2D1SimplifiedGeometrySink *iface, D2D1_FILL_MODE mode)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+
+    flattener->polylines->fill_mode = mode;
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_SetSegmentFlags(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_PATH_SEGMENT flags)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+
+    flattener->flags = flags;
+}
+
+static void d2d_flattener_add_point(struct d2d_flattener *flattener, D2D1_POINT_2F point, int curve,
+        float t0, float t1)
+{
+    struct d2d_polylines *polylines = flattener->polylines;
+    struct d2d_polyline *line;
+
+    if (FAILED(flattener->hr) || !polylines->count)
+        return;
+    line = &polylines->lines[polylines->count - 1];
+    if (!d2d_array_reserve((void **)&line->points, &line->size, line->count + 1, sizeof(*line->points))
+            || !d2d_array_reserve((void **)&line->sources, &line->sources_size, line->count + 1,
+            sizeof(*line->sources)))
+    {
+        flattener->hr = E_OUTOFMEMORY;
+        return;
+    }
+    line->points[line->count] = point;
+    line->sources[line->count].curve = curve;
+    line->sources[line->count].t0 = t0;
+    line->sources[line->count].t1 = t1;
+    line->sources[line->count].round_join = !!(flattener->flags & D2D1_PATH_SEGMENT_FORCE_ROUND_LINE_JOIN);
+    ++line->count;
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_BeginFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_POINT_2F start, D2D1_FIGURE_BEGIN begin)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+    struct d2d_polylines *polylines = flattener->polylines;
+
+    if (FAILED(flattener->hr))
+        return;
+    if (!d2d_array_reserve((void **)&polylines->lines, &polylines->size, polylines->count + 1,
+            sizeof(*polylines->lines)))
+    {
+        flattener->hr = E_OUTOFMEMORY;
+        return;
+    }
+    memset(&polylines->lines[polylines->count], 0, sizeof(*polylines->lines));
+    polylines->lines[polylines->count++].filled = begin == D2D1_FIGURE_BEGIN_FILLED;
+    /* what arrives at the first point is the segment closing the figure, which is straight */
+    d2d_flattener_add_point(flattener, start, -1, 0.0f, 0.0f);
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_AddLines(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT32 count)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        d2d_flattener_add_point(flattener, points[i], -1, 0.0f, 0.0f);
+}
+
+/* Halfway, the way d2d_point_lerp() has it, so that the points come out as Simplify's do. */
+static D2D1_POINT_2F d2d_flattener_mid(D2D1_POINT_2F a, D2D1_POINT_2F b)
+{
+    D2D1_POINT_2F p = {a.x * 0.5f + b.x * 0.5f, a.y * 0.5f + b.y * 0.5f};
+
+    return p;
+}
+
+/* As d2d_geometry_flatten_cubic(). */
+static void d2d_flattener_add_bezier(struct d2d_flattener *flattener, int curve, D2D1_POINT_2F p0,
+        const D2D1_BEZIER_SEGMENT *b, float t0, float t1, unsigned int depth)
+{
+    D2D1_BEZIER_SEGMENT b0, b1;
+    D2D1_POINT_2F q;
+
+    if (d2d_bezier_is_flat(&p0, b, flattener->tolerance) || depth >= D2D_FLATTEN_DEPTH_MAX)
+    {
+        d2d_flattener_add_point(flattener, b->point3, curve, t0, t1);
+        return;
+    }
+
+    q = d2d_flattener_mid(b->point1, b->point2);
+    b1.point3 = b->point3;
+    b1.point2 = d2d_flattener_mid(b1.point3, b->point2);
+    b1.point1 = d2d_flattener_mid(b1.point2, q);
+    b0.point1 = d2d_flattener_mid(p0, b->point1);
+    b0.point2 = d2d_flattener_mid(b0.point1, q);
+    b0.point3 = d2d_flattener_mid(b0.point2, b1.point1);
+
+    d2d_flattener_add_bezier(flattener, curve, p0, &b0, t0, (t0 + t1) * 0.5f, depth + 1);
+    d2d_flattener_add_bezier(flattener, curve, b0.point3, &b1, (t0 + t1) * 0.5f, t1, depth + 1);
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_AddBeziers(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *beziers, UINT32 count)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+    struct d2d_polylines *polylines = flattener->polylines;
+    const struct d2d_polyline *line;
+    struct d2d_curve *curve;
+    D2D1_POINT_2F p0;
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(flattener->hr) || !polylines->count)
+            return;
+        line = &polylines->lines[polylines->count - 1];
+        p0 = line->points[line->count - 1];
+        if (!d2d_array_reserve((void **)&polylines->curves, &polylines->curves_size, polylines->curve_count + 1,
+                sizeof(*polylines->curves)))
+        {
+            flattener->hr = E_OUTOFMEMORY;
+            return;
+        }
+        curve = &polylines->curves[polylines->curve_count];
+        curve->p0 = p0;
+        curve->b = beziers[i];
+        d2d_flattener_add_bezier(flattener, polylines->curve_count++, p0, &beziers[i], 0.0f, 1.0f, 0);
+    }
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_EndFigure(ID2D1SimplifiedGeometrySink *iface, D2D1_FIGURE_END end)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+    struct d2d_polylines *polylines = flattener->polylines;
+
+    if (polylines->count)
+        polylines->lines[polylines->count - 1].closed = end == D2D1_FIGURE_END_CLOSED;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_flattener_Close(ID2D1SimplifiedGeometrySink *iface)
+{
+    return S_OK;
+}
+
+static const struct ID2D1SimplifiedGeometrySinkVtbl d2d_flattener_vtbl =
+{
+    d2d_flattener_QueryInterface,
+    d2d_flattener_AddRef,
+    d2d_flattener_Release,
+    d2d_flattener_SetFillMode,
+    d2d_flattener_SetSegmentFlags,
+    d2d_flattener_BeginFigure,
+    d2d_flattener_AddLines,
+    d2d_flattener_AddBeziers,
+    d2d_flattener_EndFigure,
+    d2d_flattener_Close,
+};
+
+void d2d_polylines_cleanup(struct d2d_polylines *polylines)
+{
+    size_t i;
+
+    for (i = 0; i < polylines->count; ++i)
+    {
+        free(polylines->lines[i].points);
+        free(polylines->lines[i].sources);
+    }
+    free(polylines->lines);
+    free(polylines->curves);
+    memset(polylines, 0, sizeof(*polylines));
+}
+
+/* The figures of a geometry as polylines, transformed, within tolerance of it. */
+HRESULT d2d_geometry_flatten(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        struct d2d_polylines *polylines)
+{
+    struct d2d_flattener flattener = {{&d2d_flattener_vtbl}, polylines, tolerance, D2D1_PATH_SEGMENT_NONE, S_OK};
+    HRESULT hr;
+
+    memset(polylines, 0, sizeof(*polylines));
+    polylines->fill_mode = D2D1_FILL_MODE_ALTERNATE;
+    if (!(tolerance > 0.0f))
+        flattener.tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+    if (FAILED(hr = ID2D1Geometry_Simplify(geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_CUBICS_AND_LINES, transform,
+            flattener.tolerance, &flattener.ID2D1SimplifiedGeometrySink_iface)) || FAILED(hr = flattener.hr))
+        d2d_polylines_cleanup(polylines);
+    return hr;
+}
+
+/*
+ * Two filled areas laid over each other.
+ *
+ * The edges of both are cut where they meet: where they cross, where one ends on another, where they run
+ * along each other.  Ends of pieces nearer each other than a few units in the last place of a float are one
+ * vertex.  Which of the two fills either side of a piece is what its fill mode makes of its winding number
+ * just off the piece.  What the two combine into is bounded by the pieces with it on one side and not the
+ * other; turned to have it on their left, they are followed round into figures that touch but do not cross,
+ * and the runs of pieces along one curve are put back together into a part of it.  Everything is worked out
+ * in doubles.
+ */
+
+struct d2d_bool_point
+{
+    double x, y;
+};
+
+struct d2d_bool_edge
+{
+    struct d2d_bool_point p0, p1;
+    unsigned int source;
+    /* the curve it is part of, and where on it its ends are */
+    int curve;
+    double t0, t1;
+};
+
+struct d2d_bool_split
+{
+    double s;
+    struct d2d_bool_point p;
+};
+
+struct d2d_bool_splits
+{
+    struct d2d_bool_split *splits;
+    size_t size, count;
+};
+
+struct d2d_bool_piece
+{
+    size_t v0, v1;
+    int curve;
+    double t0, t1;
+    /* whether each of the two fills the left of it, and the right */
+    BOOL filled[2][2];
+};
+
+struct d2d_bool_path
+{
+    size_t from, to;
+    int curve;
+    double t_from, t_to;
+    BOOL used;
+};
+
+struct d2d_arrangement
+{
+    struct d2d_bool_edge *edges;
+    size_t edges_size, edge_count;
+    struct d2d_curve *curves;
+    size_t curves_size, curve_count;
+    D2D1_FILL_MODE fill_modes[2];
+    double eps;
+    /* whether an edge of either came within eps of one of the other */
+    BOOL touching;
+
+    /* the edges spanning each band across, to find winding numbers by */
+    double band_top, band_height;
+    size_t band_count;
+    size_t *band_starts, *band_edges;
+
+    struct d2d_bool_point *vertices;
+    size_t vertex_count;
+    struct d2d_bool_piece *pieces;
+    size_t pieces_size, piece_count;
+};
+
+static struct d2d_bool_point d2d_bool_point(double x, double y)
+{
+    struct d2d_bool_point p = {x, y};
+    return p;
+}
+
+static struct d2d_bool_point d2d_bool_lerp(struct d2d_bool_point a, struct d2d_bool_point b, double t)
+{
+    return d2d_bool_point(a.x + (b.x - a.x) * t, a.y + (b.y - a.y) * t);
+}
+
+static double d2d_bool_cross(struct d2d_bool_point o, struct d2d_bool_point a, struct d2d_bool_point b)
+{
+    return (a.x - o.x) * (b.y - o.y) - (a.y - o.y) * (b.x - o.x);
+}
+
+static D2D1_POINT_2F d2d_bool_point_2f(struct d2d_bool_point p)
+{
+    D2D1_POINT_2F q = {p.x, p.y};
+    return q;
+}
+
+static void d2d_arrangement_cleanup(struct d2d_arrangement *arrangement)
+{
+    free(arrangement->edges);
+    free(arrangement->curves);
+    free(arrangement->band_starts);
+    free(arrangement->band_edges);
+    free(arrangement->vertices);
+    free(arrangement->pieces);
+    memset(arrangement, 0, sizeof(*arrangement));
+}
+
+/* Hollow figures fill nothing; the others are closed, whether or not they say so. */
+static HRESULT d2d_arrangement_add(struct d2d_arrangement *arrangement, const struct d2d_polylines *polylines,
+        unsigned int source)
+{
+    int curve_base = arrangement->curve_count;
+    const struct d2d_segment_source *segment;
+    const struct d2d_polyline *line;
+    struct d2d_bool_edge *edge;
+    size_t i, j, next;
+
+    arrangement->fill_modes[source] = polylines->fill_mode;
+    if (polylines->curve_count)
+    {
+        if (!d2d_array_reserve((void **)&arrangement->curves, &arrangement->curves_size,
+                arrangement->curve_count + polylines->curve_count, sizeof(*arrangement->curves)))
+            return E_OUTOFMEMORY;
+        memcpy(&arrangement->curves[arrangement->curve_count], polylines->curves,
+                polylines->curve_count * sizeof(*polylines->curves));
+        arrangement->curve_count += polylines->curve_count;
+    }
+
+    for (i = 0; i < polylines->count; ++i)
+    {
+        line = &polylines->lines[i];
+        if (!line->filled || line->count < 2)
+            continue;
+        for (j = 0; j < line->count; ++j)
+        {
+            next = j + 1 < line->count ? j + 1 : 0;
+            if (line->points[j].x == line->points[next].x && line->points[j].y == line->points[next].y)
+                continue;
+            if (!d2d_array_reserve((void **)&arrangement->edges, &arrangement->edges_size,
+                    arrangement->edge_count + 1, sizeof(*arrangement->edges)))
+                return E_OUTOFMEMORY;
+            edge = &arrangement->edges[arrangement->edge_count++];
+            edge->p0 = d2d_bool_point(line->points[j].x, line->points[j].y);
+            edge->p1 = d2d_bool_point(line->points[next].x, line->points[next].y);
+            edge->source = source;
+            segment = &line->sources[next];
+            if (segment->curve >= 0)
+            {
+                edge->curve = curve_base + segment->curve;
+                edge->t0 = segment->t0;
+                edge->t1 = segment->t1;
+            }
+            else
+            {
+                edge->curve = -1;
+                edge->t0 = edge->t1 = 0.0;
+            }
+        }
+    }
+
+    return S_OK;
+}
+
+static double d2d_bool_edge_min_y(const struct d2d_bool_edge *edge)
+{
+    return min(edge->p0.y, edge->p1.y);
+}
+
+static double d2d_bool_edge_max_y(const struct d2d_bool_edge *edge)
+{
+    return max(edge->p0.y, edge->p1.y);
+}
+
+static size_t d2d_arrangement_band(const struct d2d_arrangement *arrangement, double y)
+{
+    double offset = (y - arrangement->band_top) / arrangement->band_height;
+
+    if (!(offset > 0.0))
+        return 0;
+    return min((size_t)offset, arrangement->band_count - 1);
+}
+
+static HRESULT d2d_arrangement_build_bands(struct d2d_arrangement *arrangement)
+{
+    double top = DBL_MAX, bottom = -DBL_MAX;
+    size_t i, b, last, *fill;
+
+    for (i = 0; i < arrangement->edge_count; ++i)
+    {
+        top = min(top, d2d_bool_edge_min_y(&arrangement->edges[i]));
+        bottom = max(bottom, d2d_bool_edge_max_y(&arrangement->edges[i]));
+    }
+    arrangement->band_count = max(min((size_t)sqrt((double)arrangement->edge_count), 4096), 1);
+    arrangement->band_top = top;
+    arrangement->band_height = (bottom - top) / arrangement->band_count;
+    if (!(arrangement->band_height > 0.0))
+    {
+        arrangement->band_count = 1;
+        arrangement->band_height = 1.0;
+    }
+
+    if (!(arrangement->band_starts = calloc(arrangement->band_count + 1, sizeof(*arrangement->band_starts))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < arrangement->edge_count; ++i)
+    {
+        last = d2d_arrangement_band(arrangement, d2d_bool_edge_max_y(&arrangement->edges[i]));
+        for (b = d2d_arrangement_band(arrangement, d2d_bool_edge_min_y(&arrangement->edges[i])); b <= last; ++b)
+            ++arrangement->band_starts[b + 1];
+    }
+    for (b = 0; b < arrangement->band_count; ++b)
+        arrangement->band_starts[b + 1] += arrangement->band_starts[b];
+
+    if (!(fill = calloc(arrangement->band_count, sizeof(*fill))))
+        return E_OUTOFMEMORY;
+    if (!(arrangement->band_edges = malloc(max(arrangement->band_starts[arrangement->band_count], 1)
+            * sizeof(*arrangement->band_edges))))
+    {
+        free(fill);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < arrangement->edge_count; ++i)
+    {
+        last = d2d_arrangement_band(arrangement, d2d_bool_edge_max_y(&arrangement->edges[i]));
+        for (b = d2d_arrangement_band(arrangement, d2d_bool_edge_min_y(&arrangement->edges[i])); b <= last; ++b)
+            arrangement->band_edges[arrangement->band_starts[b] + fill[b]++] = i;
+    }
+    free(fill);
+    return S_OK;
+}
+
+/* The winding number of each of the two at a point, counted along a ray to the right. */
+static void d2d_arrangement_windings(const struct d2d_arrangement *arrangement, struct d2d_bool_point p,
+        int windings[2])
+{
+    const struct d2d_bool_edge *edge;
+    size_t band, i;
+
+    windings[0] = windings[1] = 0;
+    band = d2d_arrangement_band(arrangement, p.y);
+    for (i = arrangement->band_starts[band]; i < arrangement->band_starts[band + 1]; ++i)
+    {
+        edge = &arrangement->edges[arrangement->band_edges[i]];
+        if (edge->p0.y <= p.y)
+        {
+            if (edge->p1.y > p.y && d2d_bool_cross(edge->p0, edge->p1, p) > 0.0)
+                ++windings[edge->source];
+        }
+        else if (edge->p1.y <= p.y && d2d_bool_cross(edge->p0, edge->p1, p) < 0.0)
+        {
+            --windings[edge->source];
+        }
+    }
+}
+
+static BOOL d2d_bool_filled(int winding, D2D1_FILL_MODE fill_mode)
+{
+    return fill_mode == D2D1_FILL_MODE_WINDING ? !!winding : winding & 1;
+}
+
+static BOOL d2d_bool_combined(const BOOL filled[2], D2D1_COMBINE_MODE mode)
+{
+    switch (mode)
+    {
+        case D2D1_COMBINE_MODE_UNION: return filled[0] || filled[1];
+        case D2D1_COMBINE_MODE_INTERSECT: return filled[0] && filled[1];
+        case D2D1_COMBINE_MODE_XOR: return filled[0] != filled[1];
+        case D2D1_COMBINE_MODE_EXCLUDE: return filled[0] && !filled[1];
+        default: return filled[0];
+    }
+}
+
+static HRESULT d2d_bool_add_split(struct d2d_bool_splits *splits, double s, struct d2d_bool_point p)
+{
+    if (!(s > 0.0 && s < 1.0))
+        return S_OK;
+    if (!d2d_array_reserve((void **)&splits->splits, &splits->size, splits->count + 1, sizeof(*splits->splits)))
+        return E_OUTOFMEMORY;
+    splits->splits[splits->count].s = s;
+    splits->splits[splits->count].p = p;
+    ++splits->count;
+    return S_OK;
+}
+
+/* The edge cut where the point lies on it, if it does. */
+static HRESULT d2d_bool_split_at(const struct d2d_arrangement *arrangement, const struct d2d_bool_edge *edge,
+        struct d2d_bool_splits *splits, struct d2d_bool_point q, BOOL *touching)
+{
+    double dx = edge->p1.x - edge->p0.x, dy = edge->p1.y - edge->p0.y, len2, s;
+
+    len2 = dx * dx + dy * dy;
+    s = ((q.x - edge->p0.x) * dx + (q.y - edge->p0.y) * dy) / len2;
+    if (!(s > 0.0 && s < 1.0))
+        return S_OK;
+    if (fabs(d2d_bool_cross(edge->p0, edge->p1, q)) > arrangement->eps * sqrt(len2))
+        return S_OK;
+    *touching = TRUE;
+    return d2d_bool_add_split(splits, s, q);
+}
+
+static BOOL d2d_bool_near(const struct d2d_arrangement *arrangement, struct d2d_bool_point p,
+        struct d2d_bool_point q)
+{
+    return fabs(p.x - q.x) <= arrangement->eps && fabs(p.y - q.y) <= arrangement->eps;
+}
+
+static HRESULT d2d_bool_intersect(struct d2d_arrangement *arrangement, size_t i, size_t j,
+        struct d2d_bool_splits *splits)
+{
+    const struct d2d_bool_edge *e = &arrangement->edges[i], *f = &arrangement->edges[j];
+    double denom, s, u, len1, len2;
+    struct d2d_bool_point d1, d2;
+    BOOL touching = FALSE;
+    HRESULT hr;
+
+    if (FAILED(hr = d2d_bool_split_at(arrangement, e, &splits[i], f->p0, &touching))
+            || FAILED(hr = d2d_bool_split_at(arrangement, e, &splits[i], f->p1, &touching))
+            || FAILED(hr = d2d_bool_split_at(arrangement, f, &splits[j], e->p0, &touching))
+            || FAILED(hr = d2d_bool_split_at(arrangement, f, &splits[j], e->p1, &touching)))
+        return hr;
+    if (d2d_bool_near(arrangement, e->p0, f->p0) || d2d_bool_near(arrangement, e->p0, f->p1)
+            || d2d_bool_near(arrangement, e->p1, f->p0) || d2d_bool_near(arrangement, e->p1, f->p1))
+        touching = TRUE;
+
+    d1 = d2d_bool_point(e->p1.x - e->p0.x, e->p1.y - e->p0.y);
+    d2 = d2d_bool_point(f->p1.x - f->p0.x, f->p1.y - f->p0.y);
+    len1 = sqrt(d1.x * d1.x + d1.y * d1.y);
+    len2 = sqrt(d2.x * d2.x + d2.y * d2.y);
+    denom = d1.x * d2.y - d1.y * d2.x;
+    if (fabs(denom) > 1e-12 * len1 * len2)
+    {
+        s = ((f->p0.x - e->p0.x) * d2.y - (f->p0.y - e->p0.y) * d2.x) / denom;
+        u = ((f->p0.x - e->p0.x) * d1.y - (f->p0.y - e->p0.y) * d1.x) / denom;
+        /* a crossing near an end is that end lying on the other edge, found above */
+        if (s * len1 > arrangement->eps && (1.0 - s) * len1 > arrangement->eps
+                && u * len2 > arrangement->eps && (1.0 - u) * len2 > arrangement->eps)
+        {
+            struct d2d_bool_point p = d2d_bool_lerp(e->p0, e->p1, s);
+
+            touching = TRUE;
+            if (FAILED(hr = d2d_bool_add_split(&splits[i], s, p))
+                    || FAILED(hr = d2d_bool_add_split(&splits[j], u, p)))
+                return hr;
+        }
+    }
+
+    if (touching && e->source != f->source)
+        arrangement->touching = TRUE;
+    return S_OK;
+}
+
+/* What is sorted carries what it is sorted by: geometries are worked on in more than one thread at once. */
+struct d2d_bool_key
+{
+    double x, y;
+    size_t index;
+};
+
+static int __cdecl d2d_bool_key_order(const void *a, const void *b)
+{
+    const struct d2d_bool_key *p = a, *q = b;
+
+    if (p->x != q->x)
+        return p->x < q->x ? -1 : 1;
+    if (p->y != q->y)
+        return p->y < q->y ? -1 : 1;
+    return p->index < q->index ? -1 : p->index > q->index ? 1 : 0;
+}
+
+static int __cdecl d2d_bool_split_order(const void *a, const void *b)
+{
+    double s = ((const struct d2d_bool_split *)a)->s, t = ((const struct d2d_bool_split *)b)->s;
+
+    return s < t ? -1 : s > t ? 1 : 0;
+}
+
+
+static int __cdecl d2d_bool_piece_order(const void *a, const void *b)
+{
+    const struct d2d_bool_piece *p = a, *q = b;
+    size_t p_lo = min(p->v0, p->v1), p_hi = max(p->v0, p->v1);
+    size_t q_lo = min(q->v0, q->v1), q_hi = max(q->v0, q->v1);
+
+    if (p_lo != q_lo)
+        return p_lo < q_lo ? -1 : 1;
+    if (p_hi != q_hi)
+        return p_hi < q_hi ? -1 : 1;
+    return 0;
+}
+
+static size_t d2d_bool_find(size_t *parent, size_t i)
+{
+    while (parent[i] != i)
+        i = parent[i] = parent[parent[i]];
+    return i;
+}
+
+/* Every edge cut where it meets another, into pieces between points. */
+static HRESULT d2d_arrangement_cut(struct d2d_arrangement *arrangement, struct d2d_bool_point **points,
+        size_t *point_count)
+{
+    size_t i, j, e, f, points_size = 0;
+    const struct d2d_bool_edge *edge, *other;
+    struct d2d_bool_splits *splits;
+    struct d2d_bool_key *order;
+    struct d2d_bool_piece *piece;
+    HRESULT hr = S_OK;
+    double x_end, s0, s1;
+
+    *points = NULL;
+    *point_count = 0;
+    if (!(splits = calloc(arrangement->edge_count, sizeof(*splits))))
+        return E_OUTOFMEMORY;
+    if (!(order = malloc(arrangement->edge_count * sizeof(*order))))
+    {
+        free(splits);
+        return E_OUTOFMEMORY;
+    }
+
+    for (i = 0; i < arrangement->edge_count; ++i)
+    {
+        order[i].x = min(arrangement->edges[i].p0.x, arrangement->edges[i].p1.x);
+        order[i].y = 0.0;
+        order[i].index = i;
+    }
+    qsort(order, arrangement->edge_count, sizeof(*order), d2d_bool_key_order);
+    for (i = 0; i < arrangement->edge_count && SUCCEEDED(hr); ++i)
+    {
+        edge = &arrangement->edges[e = order[i].index];
+        x_end = max(edge->p0.x, edge->p1.x) + arrangement->eps;
+        for (j = i + 1; j < arrangement->edge_count; ++j)
+        {
+            other = &arrangement->edges[f = order[j].index];
+            if (min(other->p0.x, other->p1.x) > x_end)
+                break;
+            if (d2d_bool_edge_min_y(other) > d2d_bool_edge_max_y(edge) + arrangement->eps
+                    || d2d_bool_edge_min_y(edge) > d2d_bool_edge_max_y(other) + arrangement->eps)
+                continue;
+            if (FAILED(hr = d2d_bool_intersect(arrangement, e, f, splits)))
+                break;
+        }
+    }
+    free(order);
+
+    for (i = 0; i < arrangement->edge_count && SUCCEEDED(hr); ++i)
+    {
+        edge = &arrangement->edges[i];
+        qsort(splits[i].splits, splits[i].count, sizeof(*splits[i].splits), d2d_bool_split_order);
+        if (!d2d_array_reserve((void **)points, &points_size, *point_count + splits[i].count + 2, sizeof(**points))
+                || !d2d_array_reserve((void **)&arrangement->pieces, &arrangement->pieces_size,
+                arrangement->piece_count + splits[i].count + 1, sizeof(*arrangement->pieces)))
+        {
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        (*points)[(*point_count)++] = edge->p0;
+        for (j = 0; j <= splits[i].count; ++j)
+        {
+            s0 = j ? splits[i].splits[j - 1].s : 0.0;
+            s1 = j < splits[i].count ? splits[i].splits[j].s : 1.0;
+            (*points)[(*point_count)++] = j < splits[i].count ? splits[i].splits[j].p : edge->p1;
+            piece = &arrangement->pieces[arrangement->piece_count++];
+            piece->v0 = *point_count - 2;
+            piece->v1 = *point_count - 1;
+            piece->curve = edge->curve;
+            piece->t0 = edge->t0 + s0 * (edge->t1 - edge->t0);
+            piece->t1 = edge->t0 + s1 * (edge->t1 - edge->t0);
+        }
+    }
+
+    for (i = 0; i < arrangement->edge_count; ++i)
+        free(splits[i].splits);
+    free(splits);
+    return hr;
+}
+
+/* Points nearer each other than eps are one vertex, where the lowest of them is. */
+static HRESULT d2d_arrangement_merge(struct d2d_arrangement *arrangement, const struct d2d_bool_point *points,
+        size_t point_count)
+{
+    size_t i, j, a, b, ra, rb, *parent, *rank, *vertex;
+    struct d2d_bool_key *order;
+    HRESULT hr = S_OK;
+
+    parent = malloc(point_count * sizeof(*parent));
+    rank = malloc(point_count * sizeof(*rank));
+    order = malloc(point_count * sizeof(*order));
+    vertex = malloc(point_count * sizeof(*vertex));
+    if (!parent || !rank || !order || !vertex)
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+
+    for (i = 0; i < point_count; ++i)
+    {
+        parent[i] = i;
+        order[i].x = points[i].x;
+        order[i].y = points[i].y;
+        order[i].index = i;
+    }
+    qsort(order, point_count, sizeof(*order), d2d_bool_key_order);
+    for (i = 0; i < point_count; ++i)
+        rank[order[i].index] = i;
+    for (i = 0; i < point_count; ++i)
+    {
+        a = order[i].index;
+        for (j = i + 1; j < point_count; ++j)
+        {
+            b = order[j].index;
+            if (points[b].x - points[a].x > arrangement->eps)
+                break;
+            if (fabs(points[b].y - points[a].y) > arrangement->eps)
+                continue;
+            /* the root is the point sorted first */
+            if ((ra = d2d_bool_find(parent, a)) != (rb = d2d_bool_find(parent, b)))
+            {
+                if (rank[ra] < rank[rb])
+                    parent[rb] = ra;
+                else
+                    parent[ra] = rb;
+            }
+        }
+    }
+
+    arrangement->vertex_count = 0;
+    for (i = 0; i < point_count; ++i)
+    {
+        a = order[i].index;
+        if (d2d_bool_find(parent, a) == a)
+            vertex[a] = arrangement->vertex_count++;
+    }
+    if (!(arrangement->vertices = malloc(max(arrangement->vertex_count, 1) * sizeof(*arrangement->vertices))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    for (i = 0; i < point_count; ++i)
+    {
+        if (d2d_bool_find(parent, i) == i)
+            arrangement->vertices[vertex[i]] = points[i];
+    }
+    for (i = 0; i < arrangement->piece_count; ++i)
+    {
+        arrangement->pieces[i].v0 = vertex[d2d_bool_find(parent, arrangement->pieces[i].v0)];
+        arrangement->pieces[i].v1 = vertex[d2d_bool_find(parent, arrangement->pieces[i].v1)];
+    }
+
+done:
+    free(parent);
+    free(rank);
+    free(order);
+    free(vertex);
+    return hr;
+}
+
+/* Each piece once, however many edges run along it, knowing which of the two fill either side of it. */
+static void d2d_arrangement_classify(struct d2d_arrangement *arrangement)
+{
+    struct d2d_bool_point p0, p1, m, side;
+    struct d2d_bool_piece *piece;
+    double len, delta;
+    int windings[2];
+    size_t i, j;
+
+    for (i = 0, j = 0; i < arrangement->piece_count; ++i)
+    {
+        if (arrangement->pieces[i].v0 != arrangement->pieces[i].v1)
+            arrangement->pieces[j++] = arrangement->pieces[i];
+    }
+    arrangement->piece_count = j;
+    qsort(arrangement->pieces, arrangement->piece_count, sizeof(*arrangement->pieces), d2d_bool_piece_order);
+    for (i = 0, j = 0; i < arrangement->piece_count; ++i)
+    {
+        if (!j || d2d_bool_piece_order(&arrangement->pieces[i], &arrangement->pieces[j - 1]))
+            arrangement->pieces[j++] = arrangement->pieces[i];
+    }
+    arrangement->piece_count = j;
+
+    delta = 4.0 * arrangement->eps;
+    for (i = 0; i < arrangement->piece_count; ++i)
+    {
+        piece = &arrangement->pieces[i];
+        p0 = arrangement->vertices[piece->v0];
+        p1 = arrangement->vertices[piece->v1];
+        len = sqrt((p1.x - p0.x) * (p1.x - p0.x) + (p1.y - p0.y) * (p1.y - p0.y));
+        m = d2d_bool_lerp(p0, p1, 0.5);
+
+        side = d2d_bool_point(m.x - (p1.y - p0.y) / len * delta, m.y + (p1.x - p0.x) / len * delta);
+        d2d_arrangement_windings(arrangement, side, windings);
+        piece->filled[0][0] = d2d_bool_filled(windings[0], arrangement->fill_modes[0]);
+        piece->filled[0][1] = d2d_bool_filled(windings[1], arrangement->fill_modes[1]);
+
+        side = d2d_bool_point(m.x + (p1.y - p0.y) / len * delta, m.y - (p1.x - p0.x) / len * delta);
+        d2d_arrangement_windings(arrangement, side, windings);
+        piece->filled[1][0] = d2d_bool_filled(windings[0], arrangement->fill_modes[0]);
+        piece->filled[1][1] = d2d_bool_filled(windings[1], arrangement->fill_modes[1]);
+    }
+}
+
+/* The two laid over each other; b may be NULL. */
+static HRESULT d2d_arrangement_init(struct d2d_arrangement *arrangement, const struct d2d_polylines *a,
+        const struct d2d_polylines *b)
+{
+    double extent = 0.0, magnitude = 0.0;
+    const struct d2d_bool_edge *edge;
+    struct d2d_bool_point *points;
+    size_t i, point_count;
+    HRESULT hr;
+
+    memset(arrangement, 0, sizeof(*arrangement));
+    arrangement->fill_modes[1] = D2D1_FILL_MODE_ALTERNATE;
+    if (FAILED(hr = d2d_arrangement_add(arrangement, a, 0))
+            || (b && FAILED(hr = d2d_arrangement_add(arrangement, b, 1))))
+        goto fail;
+    if (!arrangement->edge_count)
+        return S_OK;
+
+    for (i = 0; i < arrangement->edge_count; ++i)
+    {
+        edge = &arrangement->edges[i];
+        magnitude = max(magnitude, max(max(fabs(edge->p0.x), fabs(edge->p0.y)),
+                max(fabs(edge->p1.x), fabs(edge->p1.y))));
+        extent = max(extent, max(fabs(edge->p1.x - edge->p0.x), fabs(edge->p1.y - edge->p0.y)));
+    }
+    arrangement->eps = max(max(magnitude, extent), 1e-3) * 2e-6;
+
+    hr = d2d_arrangement_cut(arrangement, &points, &point_count);
+    if (SUCCEEDED(hr))
+        hr = d2d_arrangement_merge(arrangement, points, point_count);
+    free(points);
+    if (FAILED(hr) || FAILED(hr = d2d_arrangement_build_bands(arrangement)))
+        goto fail;
+    d2d_arrangement_classify(arrangement);
+    return S_OK;
+
+fail:
+    d2d_arrangement_cleanup(arrangement);
+    return hr;
+}
+
+static BOOL d2d_arrangement_boundary(const struct d2d_bool_piece *piece, D2D1_COMBINE_MODE mode, BOOL *left)
+{
+    *left = d2d_bool_combined(piece->filled[0], mode);
+    return *left != d2d_bool_combined(piece->filled[1], mode);
+}
+
+/* The area of what the two combine into. */
+static double d2d_arrangement_area(const struct d2d_arrangement *arrangement, D2D1_COMBINE_MODE mode)
+{
+    const struct d2d_bool_piece *piece;
+    struct d2d_bool_point p0, p1;
+    double area = 0.0;
+    BOOL left;
+    size_t i;
+
+    for (i = 0; i < arrangement->piece_count; ++i)
+    {
+        piece = &arrangement->pieces[i];
+        if (!d2d_arrangement_boundary(piece, mode, &left))
+            continue;
+        p0 = arrangement->vertices[left ? piece->v0 : piece->v1];
+        p1 = arrangement->vertices[left ? piece->v1 : piece->v0];
+        area += p0.x * p1.y - p1.x * p0.y;
+    }
+    return area / 2.0;
+}
+
+struct d2d_contours
+{
+    struct d2d_bool_path *paths;
+    size_t paths_size, path_count;
+    /* the paths of one figure after another */
+    size_t *order;
+    size_t order_count;
+    size_t *starts;
+    size_t starts_size, count;
+};
+
+static void d2d_contours_cleanup(struct d2d_contours *contours)
+{
+    free(contours->paths);
+    free(contours->order);
+    free(contours->starts);
+    memset(contours, 0, sizeof(*contours));
+}
+
+static size_t d2d_contour_length(const struct d2d_contours *contours, size_t i)
+{
+    return (i + 1 < contours->count ? contours->starts[i + 1] : contours->order_count) - contours->starts[i];
+}
+
+/* The boundary of what the two combine into, followed round into figures. */
+static HRESULT d2d_arrangement_trace(const struct d2d_arrangement *arrangement, D2D1_COMBINE_MODE mode,
+        struct d2d_contours *contours)
+{
+    size_t i, j, k, start, *first = NULL, *next = NULL;
+    const struct d2d_bool_piece *piece;
+    struct d2d_bool_point back, out, v;
+    struct d2d_bool_path *path;
+    double best, angle;
+    size_t best_path;
+    BOOL left;
+
+    memset(contours, 0, sizeof(*contours));
+    for (i = 0; i < arrangement->piece_count; ++i)
+    {
+        piece = &arrangement->pieces[i];
+        if (!d2d_arrangement_boundary(piece, mode, &left))
+            continue;
+        if (!d2d_array_reserve((void **)&contours->paths, &contours->paths_size, contours->path_count + 1,
+                sizeof(*contours->paths)))
+            goto oom;
+        path = &contours->paths[contours->path_count++];
+        path->from = left ? piece->v0 : piece->v1;
+        path->to = left ? piece->v1 : piece->v0;
+        path->curve = piece->curve;
+        path->t_from = left ? piece->t0 : piece->t1;
+        path->t_to = left ? piece->t1 : piece->t0;
+        path->used = FALSE;
+    }
+    if (!contours->path_count)
+        return S_OK;
+
+    if (!(first = malloc(arrangement->vertex_count * sizeof(*first)))
+            || !(next = malloc(contours->path_count * sizeof(*next)))
+            || !(contours->order = malloc(contours->path_count * sizeof(*contours->order))))
+        goto oom;
+    for (i = 0; i < arrangement->vertex_count; ++i)
+        first[i] = SIZE_MAX;
+    for (i = contours->path_count; i--;)
+    {
+        next[i] = first[contours->paths[i].from];
+        first[contours->paths[i].from] = i;
+    }
+
+    /* at each vertex, the way on nearest clockwise from the way back, which keeps figures that touch apart */
+    for (i = 0; i < contours->path_count; ++i)
+    {
+        if (contours->paths[i].used)
+            continue;
+        if (!d2d_array_reserve((void **)&contours->starts, &contours->starts_size, contours->count + 1,
+                sizeof(*contours->starts)))
+            goto oom;
+        contours->starts[contours->count++] = contours->order_count;
+        start = contours->paths[i].from;
+        for (k = i;;)
+        {
+            contours->paths[k].used = TRUE;
+            contours->order[contours->order_count++] = k;
+            if (contours->paths[k].to == start)
+                break;
+
+            v = arrangement->vertices[contours->paths[k].to];
+            back = arrangement->vertices[contours->paths[k].from];
+            back = d2d_bool_point(back.x - v.x, back.y - v.y);
+            best = DBL_MAX;
+            best_path = SIZE_MAX;
+            for (j = first[contours->paths[k].to]; j != SIZE_MAX; j = next[j])
+            {
+                if (contours->paths[j].used)
+                    continue;
+                out = arrangement->vertices[contours->paths[j].to];
+                out = d2d_bool_point(out.x - v.x, out.y - v.y);
+                angle = atan2(-(back.x * out.y - back.y * out.x), back.x * out.x + back.y * out.y);
+                if (angle <= 0.0)
+                    angle += 2.0 * M_PI;
+                if (angle < best)
+                {
+                    best = angle;
+                    best_path = j;
+                }
+            }
+            if (best_path == SIZE_MAX)
+            {
+                WARN("Boundary does not close at vertex %Iu.\n", contours->paths[k].to);
+                break;
+            }
+            k = best_path;
+        }
+    }
+
+    free(first);
+    free(next);
+    return S_OK;
+
+oom:
+    free(first);
+    free(next);
+    d2d_contours_cleanup(contours);
+    return E_OUTOFMEMORY;
+}
+
+/* The control points of the part of a curve between two places on it, in the order given. */
+static void d2d_curve_part(const struct d2d_curve *curve, double t0, double t1, D2D1_POINT_2F *c1, D2D1_POINT_2F *c2)
+{
+    struct d2d_bool_point p0, p1, p2, p3, a0, a1, a2, b0, b1, d0, d1, e0;
+    double lo = min(t0, t1), hi = max(t0, t1), s;
+
+    p0 = d2d_bool_point(curve->p0.x, curve->p0.y);
+    p1 = d2d_bool_point(curve->b.point1.x, curve->b.point1.y);
+    p2 = d2d_bool_point(curve->b.point2.x, curve->b.point2.y);
+    p3 = d2d_bool_point(curve->b.point3.x, curve->b.point3.y);
+
+    /* the part from lo on... */
+    a0 = d2d_bool_lerp(p0, p1, lo);
+    a1 = d2d_bool_lerp(p1, p2, lo);
+    a2 = d2d_bool_lerp(p2, p3, lo);
+    b0 = d2d_bool_lerp(a0, a1, lo);
+    b1 = d2d_bool_lerp(a1, a2, lo);
+    p0 = d2d_bool_lerp(b0, b1, lo);
+    p1 = b1;
+    p2 = a2;
+
+    /* ...and of that, the part up to hi */
+    s = lo < 1.0 ? (hi - lo) / (1.0 - lo) : 0.0;
+    d0 = d2d_bool_lerp(p0, p1, s);
+    d1 = d2d_bool_lerp(p1, p2, s);
+    e0 = d2d_bool_lerp(d0, d1, s);
+
+    *c1 = d2d_bool_point_2f(t0 <= t1 ? d0 : e0);
+    *c2 = d2d_bool_point_2f(t0 <= t1 ? e0 : d0);
+}
+
+struct d2d_figure_start
+{
+    size_t contour, offset;
+    struct d2d_bool_point p;
+};
+
+static int __cdecl d2d_figure_start_order(const void *a, const void *b)
+{
+    const struct d2d_figure_start *s = a, *t = b;
+
+    /* the last to begin first */
+    if (s->p.y != t->p.y)
+        return s->p.y > t->p.y ? -1 : 1;
+    if (s->p.x != t->p.x)
+        return s->p.x > t->p.x ? -1 : 1;
+    return 0;
+}
+
+static const struct d2d_bool_path *d2d_contour_path(const struct d2d_contours *contours,
+        const struct d2d_figure_start *start, size_t i)
+{
+    size_t length = d2d_contour_length(contours, start->contour);
+
+    return &contours->paths[contours->order[contours->starts[start->contour] + (start->offset + i) % length]];
+}
+
+/*
+ * The figures as Windows hands them out: the fill mode first, then each figure from its topmost vertex, the
+ * leftmost if more than one, the figures that begin lowest down first; a segment to each point, the last
+ * one back to the start.
+ */
+static HRESULT d2d_arrangement_write(const struct d2d_arrangement *arrangement, D2D1_COMBINE_MODE mode,
+        ID2D1SimplifiedGeometrySink *sink)
+{
+    const struct d2d_bool_path *path, *next;
+    struct d2d_figure_start *starts;
+    struct d2d_contours contours;
+    D2D1_BEZIER_SEGMENT bezier;
+    size_t i, j, k, n, last;
+    struct d2d_bool_point p;
+    D2D1_POINT_2F point;
+    double t_end;
+    HRESULT hr;
+
+    ID2D1SimplifiedGeometrySink_SetFillMode(sink, D2D1_FILL_MODE_ALTERNATE);
+    if (FAILED(hr = d2d_arrangement_trace(arrangement, mode, &contours)))
+        return hr;
+    if (!contours.count)
+        return S_OK;
+    if (!(starts = calloc(contours.count, sizeof(*starts))))
+    {
+        d2d_contours_cleanup(&contours);
+        return E_OUTOFMEMORY;
+    }
+
+    for (i = 0; i < contours.count; ++i)
+    {
+        starts[i].contour = i;
+        n = d2d_contour_length(&contours, i);
+        for (j = 0; j < n; ++j)
+        {
+            p = arrangement->vertices[contours.paths[contours.order[contours.starts[i] + j]].from];
+            if (!j || p.y < starts[i].p.y || (p.y == starts[i].p.y && p.x < starts[i].p.x))
+            {
+                starts[i].offset = j;
+                starts[i].p = p;
+            }
+        }
+    }
+    qsort(starts, contours.count, sizeof(*starts), d2d_figure_start_order);
+
+    for (i = 0; i < contours.count; ++i)
+    {
+        n = d2d_contour_length(&contours, starts[i].contour);
+        ID2D1SimplifiedGeometrySink_BeginFigure(sink, d2d_bool_point_2f(starts[i].p), D2D1_FIGURE_BEGIN_FILLED);
+        for (j = 0; j < n; j = last + 1)
+        {
+            path = d2d_contour_path(&contours, &starts[i], j);
+            last = j;
+            if (path->curve < 0 || path->t_from == path->t_to)
+            {
+                point = d2d_bool_point_2f(arrangement->vertices[path->to]);
+                ID2D1SimplifiedGeometrySink_AddLines(sink, &point, 1);
+                continue;
+            }
+
+            /* as far as it runs on along the same curve */
+            t_end = path->t_to;
+            for (k = j + 1; k < n; ++k)
+            {
+                next = d2d_contour_path(&contours, &starts[i], k);
+                if (next->curve != path->curve || fabs(next->t_from - t_end) > 1e-9
+                        || (next->t_to > next->t_from) != (path->t_to > path->t_from))
+                    break;
+                t_end = next->t_to;
+                last = k;
+            }
+            d2d_curve_part(&arrangement->curves[path->curve], path->t_from, t_end, &bezier.point1, &bezier.point2);
+            bezier.point3 = d2d_bool_point_2f(arrangement->vertices[d2d_contour_path(&contours, &starts[i], last)->to]);
+            ID2D1SimplifiedGeometrySink_AddBeziers(sink, &bezier, 1);
+        }
+        ID2D1SimplifiedGeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+    }
+
+    free(starts);
+    d2d_contours_cleanup(&contours);
+    return S_OK;
+}
+
+static HRESULT d2d_geometry_arrange(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform,
+        ID2D1Geometry *input, const D2D1_MATRIX_3X2_F *input_transform, float tolerance,
+        struct d2d_arrangement *arrangement)
+{
+    struct d2d_polylines a, b;
+    HRESULT hr;
+
+    if (FAILED(hr = d2d_geometry_flatten(geometry, transform, tolerance, &a)))
+        return hr;
+    if (input && FAILED(hr = d2d_geometry_flatten(input, input_transform, tolerance, &b)))
+    {
+        d2d_polylines_cleanup(&a);
+        return hr;
+    }
+    hr = d2d_arrangement_init(arrangement, &a, input ? &b : NULL);
+    if (input)
+        d2d_polylines_cleanup(&b);
+    d2d_polylines_cleanup(&a);
+    return hr;
+}
+
+/* This geometry as it is combined with the input one transformed; lines and parts of the curves they had. */
+HRESULT d2d_geometry_combine(ID2D1Geometry *geometry, ID2D1Geometry *input, D2D1_COMBINE_MODE mode,
+        const D2D1_MATRIX_3X2_F *input_transform, float tolerance, ID2D1SimplifiedGeometrySink *sink)
+{
+    struct d2d_arrangement arrangement;
+    HRESULT hr;
+
+    if ((unsigned int)mode > D2D1_COMBINE_MODE_EXCLUDE)
+        return E_INVALIDARG;
+    if (FAILED(hr = d2d_geometry_arrange(geometry, NULL, input, input_transform, tolerance, &arrangement)))
+        return hr;
+    hr = d2d_arrangement_write(&arrangement, mode, sink);
+    d2d_arrangement_cleanup(&arrangement);
+    return hr;
+}
+
+/* What a geometry fills, as figures that do not cross, holes turning the other way. */
+HRESULT d2d_geometry_outline(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        ID2D1SimplifiedGeometrySink *sink)
+{
+    struct d2d_arrangement arrangement;
+    HRESULT hr;
+
+    if (FAILED(hr = d2d_geometry_arrange(geometry, transform, NULL, NULL, tolerance, &arrangement)))
+        return hr;
+    hr = d2d_arrangement_write(&arrangement, D2D1_COMBINE_MODE_UNION, sink);
+    d2d_arrangement_cleanup(&arrangement);
+    return hr;
+}
+
+/* Two are disjoint only if they do not even touch; one is contained in the other it covers entirely. */
+HRESULT d2d_geometry_compare(ID2D1Geometry *geometry, ID2D1Geometry *input, const D2D1_MATRIX_3X2_F *input_transform,
+        float tolerance, D2D1_GEOMETRY_RELATION *relation)
+{
+    struct d2d_arrangement arrangement;
+    double shared, only_a, only_b, eps;
+    HRESULT hr;
+
+    if (FAILED(hr = d2d_geometry_arrange(geometry, NULL, input, input_transform, tolerance, &arrangement)))
+        return hr;
+
+    shared = d2d_arrangement_area(&arrangement, D2D1_COMBINE_MODE_INTERSECT);
+    only_a = d2d_arrangement_area(&arrangement, D2D1_COMBINE_MODE_EXCLUDE);
+    only_b = d2d_arrangement_area(&arrangement, D2D1_COMBINE_MODE_XOR) - only_a;
+    eps = arrangement.eps * arrangement.eps;
+    if (shared <= eps)
+        *relation = arrangement.touching ? D2D1_GEOMETRY_RELATION_OVERLAP : D2D1_GEOMETRY_RELATION_DISJOINT;
+    else if (only_a <= eps)
+        *relation = D2D1_GEOMETRY_RELATION_IS_CONTAINED;
+    else if (only_b <= eps)
+        *relation = D2D1_GEOMETRY_RELATION_CONTAINS;
+    else
+        *relation = D2D1_GEOMETRY_RELATION_OVERLAP;
+
+    d2d_arrangement_cleanup(&arrangement);
+    return S_OK;
+}
+
+static double d2d_segment_distance(D2D1_POINT_2F p, D2D1_POINT_2F a, D2D1_POINT_2F b)
+{
+    double dx = b.x - a.x, dy = b.y - a.y, len2 = dx * dx + dy * dy, s = 0.0, x, y;
+
+    if (len2 > 0.0)
+        s = min(max(((p.x - a.x) * dx + (p.y - a.y) * dy) / len2, 0.0), 1.0);
+    x = a.x + s * dx - p.x;
+    y = a.y + s * dy - p.y;
+    return sqrt(x * x + y * y);
+}
+
+/* Whether a point is filled, or nearer the edge of what is than the tolerance. */
+HRESULT d2d_geometry_fill_contains_point(ID2D1Geometry *geometry, D2D1_POINT_2F point,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, BOOL *contains)
+{
+    struct d2d_bool_point p = {point.x, point.y}, p0, p1;
+    const struct d2d_polyline *line;
+    struct d2d_polylines polylines;
+    double distance = DBL_MAX;
+    int winding = 0;
+    size_t i, j;
+    HRESULT hr;
+
+    if (!(tolerance > 0.0f))
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+    /* finely enough that how near the edge the point is comes out right */
+    if (FAILED(hr = d2d_geometry_flatten(geometry, transform, tolerance / 16.0f, &polylines)))
+        return hr;
+    for (i = 0; i < polylines.count; ++i)
+    {
+        line = &polylines.lines[i];
+        if (!line->filled || line->count < 3)
+            continue;
+        for (j = 0; j < line->count; ++j)
+        {
+            p0 = d2d_bool_point(line->points[j].x, line->points[j].y);
+            p1 = d2d_bool_point(line->points[(j + 1) % line->count].x, line->points[(j + 1) % line->count].y);
+            if (p0.y <= p.y)
+            {
+                if (p1.y > p.y && d2d_bool_cross(p0, p1, p) > 0.0)
+                    ++winding;
+            }
+            else if (p1.y <= p.y && d2d_bool_cross(p0, p1, p) < 0.0)
+            {
+                --winding;
+            }
+            distance = min(distance, d2d_segment_distance(point, line->points[j], line->points[(j + 1) % line->count]));
+        }
+    }
+    *contains = d2d_bool_filled(winding, polylines.fill_mode) || distance < tolerance;
+    d2d_polylines_cleanup(&polylines);
+    return S_OK;
+}
+
+/* The area a geometry fills, overlaps counted once, in doubles. */
+HRESULT d2d_geometry_compute_area(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        float *area)
+{
+    struct d2d_arrangement arrangement;
+    HRESULT hr;
+
+    if (FAILED(hr = d2d_geometry_arrange(geometry, transform, NULL, NULL, tolerance, &arrangement)))
+        return hr;
+    *area = d2d_arrangement_area(&arrangement, D2D1_COMBINE_MODE_UNION);
+    d2d_arrangement_cleanup(&arrangement);
+    return S_OK;
+}
+
+/*
+ * Lengths along a geometry: along its figures one after another, flattened as Windows flattens them, closed
+ * figures with their closing segment.  A point at a length is on the flattened figure.  The tangent there, on a
+ * curve, is what Windows makes of the curve's own at the two ends of the segment the point is on: the two are
+ * weighted, and taken as far towards the far end as the point is along the segment.  Each is weighted by how
+ * much of the curve the segment arriving at that end covers, and an end of the curve itself by an eighteenth;
+ * measured on curves cut into one to thirty-two segments, and on segments of different sizes meeting, to the
+ * last digit.
+ */
+
+static void d2d_curve_derivative(const struct d2d_curve *curve, double t, double *x, double *y)
+{
+    double mt = 1.0 - t;
+
+    *x = 3.0 * mt * mt * (curve->b.point1.x - curve->p0.x) + 6.0 * mt * t * (curve->b.point2.x - curve->b.point1.x)
+            + 3.0 * t * t * (curve->b.point3.x - curve->b.point2.x);
+    *y = 3.0 * mt * mt * (curve->b.point1.y - curve->p0.y) + 6.0 * mt * t * (curve->b.point2.y - curve->b.point1.y)
+            + 3.0 * t * t * (curve->b.point3.y - curve->b.point2.y);
+}
+
+/* The segment arriving at points[i] of a line, or the closing one for i == count. */
+static BOOL d2d_polyline_segment(const struct d2d_polyline *line, size_t i, D2D1_POINT_2F *p0, D2D1_POINT_2F *p1,
+        const struct d2d_segment_source **source)
+{
+    static const struct d2d_segment_source straight = {-1, 0.0f, 0.0f};
+
+    if (i < line->count)
+    {
+        *p0 = line->points[i - 1];
+        *p1 = line->points[i];
+        *source = &line->sources[i];
+        return TRUE;
+    }
+    if (i > line->count || !line->closed || line->count < 2)
+        return FALSE;
+    *p0 = line->points[line->count - 1];
+    *p1 = line->points[0];
+    *source = &straight;
+    return TRUE;
+}
+
+static double d2d_segment_length(D2D1_POINT_2F p0, D2D1_POINT_2F p1)
+{
+    return sqrt(((double)p1.x - p0.x) * ((double)p1.x - p0.x) + ((double)p1.y - p0.y) * ((double)p1.y - p0.y));
+}
+
+HRESULT d2d_geometry_compute_length(ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform, float tolerance,
+        float *length)
+{
+    const struct d2d_segment_source *source;
+    struct d2d_polylines polylines;
+    D2D1_POINT_2F p0, p1;
+    double total = 0.0;
+    size_t i, j;
+    HRESULT hr;
+
+    if (FAILED(hr = d2d_geometry_flatten(geometry, transform, tolerance, &polylines)))
+        return hr;
+    for (i = 0; i < polylines.count; ++i)
+    {
+        for (j = 1; d2d_polyline_segment(&polylines.lines[i], j, &p0, &p1, &source); ++j)
+            total += d2d_segment_length(p0, p1);
+    }
+    *length = total;
+    d2d_polylines_cleanup(&polylines);
+    return S_OK;
+}
+
+HRESULT d2d_geometry_compute_point_at_length(ID2D1Geometry *geometry, float length,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_2F *point, D2D1_POINT_2F *tangent)
+{
+    const struct d2d_segment_source *source, *found_source = NULL, *previous, *found_previous = NULL;
+    D2D1_POINT_2F p0, p1, found0 = {0}, found1 = {0};
+    double total = 0.0, s = 0.0, x0, y0, x1, y1, w0, w1, x, y, len;
+    struct d2d_polylines polylines;
+    size_t i, j;
+    HRESULT hr;
+
+    if (FAILED(hr = d2d_geometry_flatten(geometry, transform, tolerance, &polylines)))
+        return hr;
+
+    /* the first segment ending further on than the length, or else the last */
+    for (i = 0; i < polylines.count; ++i)
+    {
+        for (j = 1, previous = NULL; d2d_polyline_segment(&polylines.lines[i], j, &p0, &p1, &source);
+                previous = source, ++j)
+        {
+            if (!(len = d2d_segment_length(p0, p1)))
+                continue;
+            found0 = p0;
+            found1 = p1;
+            found_source = source;
+            found_previous = previous;
+            s = (length - total) / len;
+            total += len;
+            if (total > length)
+                goto found;
+        }
+    }
+
+found:
+    if (!found_source)
+    {
+        /* nothing to be along */
+        if (point)
+            point->x = point->y = -NAN;
+        if (tangent)
+            tangent->x = tangent->y = -NAN;
+        d2d_polylines_cleanup(&polylines);
+        return S_OK;
+    }
+
+    s = min(max(s, 0.0), 1.0);
+    if (point)
+    {
+        point->x = found0.x + s * ((double)found1.x - found0.x);
+        point->y = found0.y + s * ((double)found1.y - found0.y);
+    }
+    if (tangent)
+    {
+        if (found_source->curve < 0)
+        {
+            x = (double)found1.x - found0.x;
+            y = (double)found1.y - found0.y;
+        }
+        else
+        {
+            const struct d2d_curve *curve = &polylines.curves[found_source->curve];
+            double t0 = found_source->t0, t1 = found_source->t1;
+
+            d2d_curve_derivative(curve, t0, &x0, &y0);
+            d2d_curve_derivative(curve, t1, &x1, &y1);
+            if (t0 == 0.0f || t0 == 1.0f || !found_previous || found_previous->curve != found_source->curve)
+                w0 = 1.0 / 18.0;
+            else
+                w0 = fabs(found_previous->t1 - found_previous->t0);
+            w1 = t1 == 0.0f || t1 == 1.0f ? 1.0 / 18.0 : fabs(t1 - t0);
+            x = (1.0 - s) * w0 * x0 + s * w1 * x1;
+            y = (1.0 - s) * w0 * y0 + s * w1 * y1;
+        }
+        len = sqrt(x * x + y * y);
+        tangent->x = x / len;
+        tangent->y = y / len;
+    }
+
+    d2d_polylines_cleanup(&polylines);
+    return S_OK;
+}
+
+/*
+ * What a stroke covers.  It is laid out as pieces, each convex: every segment a rectangle as wide as the stroke,
+ * every join the wedge the style gives it on the outside of the turn, the caps that are not the stroke drawn
+ * further.  Round joins and caps are arcs drawn as curves, as Windows draws them, and flattened; the pieces
+ * remember the curves, so that where they come out on the edge of the stroke they are put back.  The pieces are
+ * worked out where the geometry is and transformed after, so that the transform widens the stroke as well.
+ */
+
+struct d2d_stroke_pieces
+{
+    struct d2d_polylines polylines;
+    const D2D1_MATRIX_3X2_F *transform;
+    /* whether the segments' own pieces are wanted, or only the joins and caps */
+    BOOL segments;
+    /* the bounds of the curves round joins and caps are drawn with, which their pieces only come near */
+    D2D1_RECT_F curve_bounds;
+    HRESULT hr;
+};
+
+/* Points, and what the segment arriving at each is part of; the curves are those of the pieces. */
+struct d2d_points
+{
+    D2D1_POINT_2F *points;
+    size_t size, count;
+    struct d2d_segment_source *sources;
+    size_t sources_size;
+    BOOL out_of_memory;
+};
+
+static void d2d_points_cleanup(struct d2d_points *points)
+{
+    free(points->points);
+    free(points->sources);
+}
+
+static void d2d_points_add_source(struct d2d_points *points, D2D1_POINT_2F p, int curve, float t0, float t1)
+{
+    if (!d2d_array_reserve((void **)&points->points, &points->size, points->count + 1, sizeof(*points->points))
+            || !d2d_array_reserve((void **)&points->sources, &points->sources_size, points->count + 1,
+            sizeof(*points->sources)))
+    {
+        points->out_of_memory = TRUE;
+        return;
+    }
+    points->points[points->count] = p;
+    points->sources[points->count].curve = curve;
+    points->sources[points->count].t0 = t0;
+    points->sources[points->count].t1 = t1;
+    points->sources[points->count].round_join = FALSE;
+    ++points->count;
+}
+
+static void d2d_points_add(struct d2d_points *points, D2D1_POINT_2F p)
+{
+    d2d_points_add_source(points, p, -1, 0.0f, 0.0f);
+}
+
+/* A convex piece, closed, turned the way filled figures turn, so that where pieces overlap they add up. */
+static void d2d_stroke_pieces_add(struct d2d_stroke_pieces *pieces, const struct d2d_points *points)
+{
+    struct d2d_polylines *polylines = &pieces->polylines;
+    struct d2d_segment_source source;
+    size_t i, count = points->count;
+    struct d2d_polyline *line;
+    double area = 0.0;
+
+    if (points->out_of_memory)
+        pieces->hr = E_OUTOFMEMORY;
+    if (FAILED(pieces->hr) || count < 3)
+        return;
+    if (!d2d_array_reserve((void **)&polylines->lines, &polylines->size, polylines->count + 1,
+            sizeof(*polylines->lines)))
+    {
+        pieces->hr = E_OUTOFMEMORY;
+        return;
+    }
+    line = &polylines->lines[polylines->count];
+    memset(line, 0, sizeof(*line));
+    if (!(line->points = malloc(count * sizeof(*line->points)))
+            || !(line->sources = malloc(count * sizeof(*line->sources))))
+    {
+        free(line->points);
+        pieces->hr = E_OUTOFMEMORY;
+        return;
+    }
+    ++polylines->count;
+    line->size = line->sources_size = line->count = count;
+    line->closed = line->filled = TRUE;
+    for (i = 0; i < count; ++i)
+    {
+        line->points[i] = points->points[i];
+        if (pieces->transform)
+            d2d_point_transform(&line->points[i], pieces->transform, points->points[i].x, points->points[i].y);
+    }
+    for (i = 0; i < count; ++i)
+        area += (double)line->points[i].x * line->points[(i + 1) % count].y
+                - (double)line->points[(i + 1) % count].x * line->points[i].y;
+    if (area >= 0.0)
+    {
+        memcpy(line->sources, points->sources, count * sizeof(*line->sources));
+        return;
+    }
+
+    /* The other way round: point j is point count - j, and the segment arriving at it the one that left it,
+     * going the other way. */
+    for (i = 1; i < count / 2 + (count & 1); ++i)
+    {
+        D2D1_POINT_2F p = line->points[i];
+
+        line->points[i] = line->points[count - i];
+        line->points[count - i] = p;
+    }
+    for (i = 0; i < count; ++i)
+    {
+        source = points->sources[(count - i + 1) % count];
+        line->sources[i].curve = source.curve;
+        line->sources[i].t0 = source.t1;
+        line->sources[i].t1 = source.t0;
+        line->sources[i].round_join = FALSE;
+    }
+}
+
+static D2D1_POINT_2F d2d_point_offset(D2D1_POINT_2F p, double x, double y, double scale)
+{
+    D2D1_POINT_2F r = {p.x + x * scale, p.y + y * scale};
+
+    return r;
+}
+
+static void d2d_stroke_pieces_segment(struct d2d_stroke_pieces *pieces, D2D1_POINT_2F p, D2D1_POINT_2F q, float h)
+{
+    double dx = (double)q.x - p.x, dy = (double)q.y - p.y, len = sqrt(dx * dx + dy * dy);
+    struct d2d_points points = {0};
+
+    if (!(len > 0.0) || !pieces->segments)
+        return;
+    d2d_points_add(&points, d2d_point_offset(p, -dy / len, dx / len, h));
+    d2d_points_add(&points, d2d_point_offset(q, -dy / len, dx / len, h));
+    d2d_points_add(&points, d2d_point_offset(q, dy / len, -dx / len, h));
+    d2d_points_add(&points, d2d_point_offset(p, dy / len, -dx / len, h));
+    d2d_stroke_pieces_add(pieces, &points);
+    d2d_points_cleanup(&points);
+}
+
+/* The points a curve is flattened to after its start, as d2d_flattener_add_bezier() gives them. */
+static void d2d_points_add_bezier(struct d2d_points *points, D2D1_POINT_2F p0, const D2D1_BEZIER_SEGMENT *b,
+        float tolerance, int curve, float t0, float t1, unsigned int depth)
+{
+    D2D1_BEZIER_SEGMENT b0, b1;
+    D2D1_POINT_2F q;
+
+    if (d2d_bezier_is_flat(&p0, b, tolerance) || depth >= D2D_FLATTEN_DEPTH_MAX)
+    {
+        d2d_points_add_source(points, b->point3, curve, t0, t1);
+        return;
+    }
+    q = d2d_flattener_mid(b->point1, b->point2);
+    b1.point3 = b->point3;
+    b1.point2 = d2d_flattener_mid(b1.point3, b->point2);
+    b1.point1 = d2d_flattener_mid(b1.point2, q);
+    b0.point1 = d2d_flattener_mid(p0, b->point1);
+    b0.point2 = d2d_flattener_mid(b0.point1, q);
+    b0.point3 = d2d_flattener_mid(b0.point2, b1.point1);
+    d2d_points_add_bezier(points, p0, &b0, tolerance, curve, t0, (t0 + t1) * 0.5f, depth + 1);
+    d2d_points_add_bezier(points, b0.point3, &b1, tolerance, curve, (t0 + t1) * 0.5f, t1, depth + 1);
+}
+
+/* Where a cubic Bézier is furthest across or down: its ends, and where it turns back. */
+static void d2d_bezier_bounds(D2D1_POINT_2F p0, const D2D1_BEZIER_SEGMENT *b, D2D1_RECT_F *bounds)
+{
+    const double x[4] = {p0.x, b->point1.x, b->point2.x, b->point3.x}, y[4] = {p0.y, b->point1.y, b->point2.y, b->point3.y};
+    const double *c[2] = {x, y};
+    double a, e, d, t[3], mt, v;
+    unsigned int axis, i, n;
+
+    for (axis = 0; axis < 2; ++axis)
+    {
+        a = (c[axis][1] - c[axis][0]) - 2.0 * (c[axis][2] - c[axis][1]) + (c[axis][3] - c[axis][2]);
+        e = 2.0 * ((c[axis][2] - c[axis][1]) - (c[axis][1] - c[axis][0]));
+        d = c[axis][1] - c[axis][0];
+        n = 0;
+        t[n++] = 1.0;
+        if (fabs(a) <= 1e-12 * (fabs(e) + fabs(d)))
+        {
+            if (e != 0.0)
+                t[n++] = -d / e;
+        }
+        else if (e * e - 4.0 * a * d >= 0.0)
+        {
+            t[n++] = (-e + sqrt(e * e - 4.0 * a * d)) / (2.0 * a);
+            t[n++] = (-e - sqrt(e * e - 4.0 * a * d)) / (2.0 * a);
+        }
+        for (i = 0; i < n; ++i)
+        {
+            if (!(t[i] > 0.0 && t[i] <= 1.0))
+                continue;
+            mt = 1.0 - t[i];
+            v = mt * mt * mt * c[axis][0] + 3.0 * mt * mt * t[i] * c[axis][1] + 3.0 * mt * t[i] * t[i] * c[axis][2]
+                    + t[i] * t[i] * t[i] * c[axis][3];
+            if (!axis)
+            {
+                bounds->left = min(bounds->left, v);
+                bounds->right = max(bounds->right, v);
+            }
+            else
+            {
+                bounds->top = min(bounds->top, v);
+                bounds->bottom = max(bounds->bottom, v);
+            }
+        }
+    }
+}
+
+/* An arc of radius h about v from angle a0 on by sweep, drawn as a path draws its arcs: halved until no part is more
+ * than a quarter of the circle, each part a curve, the curves flattened. */
+static void d2d_points_add_arc(struct d2d_points *points, struct d2d_stroke_pieces *pieces, D2D1_POINT_2F v,
+        double h, double a0, double sweep, float tolerance)
+{
+    struct d2d_polylines *polylines = &pieces->polylines;
+    D2D1_BEZIER_SEGMENT bezier;
+    struct d2d_curve *curve;
+    unsigned int i, n;
+    double k, a, b;
+    D2D1_POINT_2F p;
+
+    for (n = 1; n < 4 && fabs(sweep) / n > M_PI / 2.0 + 1e-9; n *= 2)
+        ;
+    k = 4.0 / 3.0 * tan(sweep / n / 4.0);
+    p = d2d_point_offset(v, cos(a0), sin(a0), h);
+    for (i = 0; i < n; ++i)
+    {
+        a = a0 + sweep * i / n;
+        b = a + sweep / n;
+        bezier.point1 = d2d_point_offset(v, cos(a) - k * sin(a), sin(a) + k * cos(a), h);
+        bezier.point2 = d2d_point_offset(v, cos(b) + k * sin(b), sin(b) - k * cos(b), h);
+        bezier.point3 = d2d_point_offset(v, cos(b), sin(b), h);
+
+        /* the curve as it comes out, to put it back, and its bounds */
+        if (!d2d_array_reserve((void **)&polylines->curves, &polylines->curves_size, polylines->curve_count + 1,
+                sizeof(*polylines->curves)))
+        {
+            pieces->hr = E_OUTOFMEMORY;
+            return;
+        }
+        curve = &polylines->curves[polylines->curve_count];
+        curve->p0 = p;
+        curve->b = bezier;
+        if (pieces->transform)
+        {
+            d2d_point_transform(&curve->p0, pieces->transform, curve->p0.x, curve->p0.y);
+            d2d_point_transform(&curve->b.point1, pieces->transform, curve->b.point1.x, curve->b.point1.y);
+            d2d_point_transform(&curve->b.point2, pieces->transform, curve->b.point2.x, curve->b.point2.y);
+            d2d_point_transform(&curve->b.point3, pieces->transform, curve->b.point3.x, curve->b.point3.y);
+        }
+        d2d_bezier_bounds(curve->p0, &curve->b, &pieces->curve_bounds);
+
+        d2d_points_add_bezier(points, p, &bezier, tolerance, polylines->curve_count++, 0.0f, 1.0f, 0);
+        p = bezier.point3;
+    }
+}
+
+/* The join at v of a segment going along d0 and one going along d1, both of unit length. */
+static void d2d_stroke_pieces_join(struct d2d_stroke_pieces *pieces, D2D1_POINT_2F v, const double d0[2],
+        const double d1[2], float h, const D2D1_STROKE_STYLE_PROPERTIES1 *desc, float tolerance)
+{
+    double cross = d0[0] * d1[1] - d0[1] * d1[0], dot = d0[0] * d1[0] + d0[1] * d1[1];
+    double n0[2], n1[2], m[2], len, cos_half, limit, t, a0, sweep;
+    struct d2d_points points = {0};
+    D2D1_POINT_2F p;
+    double side;
+
+    /* Straight on there is nothing to join.  Straight back there is no outside, but a round join rounds the
+     * front, and a mitre, cut off at its limit, reaches straight ahead. */
+    if (fabs(cross) <= 1e-9 && (dot > 0.0 || desc->lineJoin == D2D1_LINE_JOIN_BEVEL
+            || desc->lineJoin == D2D1_LINE_JOIN_MITER_OR_BEVEL))
+        return;
+    /* the normals on the outside of the turn */
+    side = cross > 0.0 ? -1.0 : 1.0;
+    n0[0] = -d0[1] * side;
+    n0[1] = d0[0] * side;
+    n1[0] = -d1[1] * side;
+    n1[1] = d1[0] * side;
+
+    d2d_points_add(&points, v);
+    d2d_points_add(&points, d2d_point_offset(v, n0[0], n0[1], h));
+    switch (desc->lineJoin)
+    {
+        case D2D1_LINE_JOIN_ROUND:
+            a0 = atan2(n0[1], n0[0]);
+            sweep = atan2(n0[0] * n1[1] - n0[1] * n1[0], n0[0] * n1[0] + n0[1] * n1[1]);
+            /* straight back: round the front */
+            if (fabs(cross) <= 1e-9)
+                sweep = -side * M_PI;
+            /* the arc ends where the join does */
+            d2d_points_add_arc(&points, pieces, v, h, a0, sweep, tolerance);
+            d2d_stroke_pieces_add(pieces, &points);
+            d2d_points_cleanup(&points);
+            return;
+
+        case D2D1_LINE_JOIN_MITER:
+        case D2D1_LINE_JOIN_MITER_OR_BEVEL:
+            m[0] = n0[0] + n1[0];
+            m[1] = n0[1] + n1[1];
+            if ((len = sqrt(m[0] * m[0] + m[1] * m[1])) > 1e-9)
+            {
+                m[0] /= len;
+                m[1] /= len;
+                cos_half = m[0] * n0[0] + m[1] * n0[1];
+            }
+            else
+            {
+                m[0] = d0[0];
+                m[1] = d0[1];
+                cos_half = 0.0;
+            }
+            /* how far out the mitre reaches, in half widths of the stroke, is limited to at least one */
+            limit = max(desc->miterLimit, 1.0f);
+            if (cos_half > 0.0 && 1.0 / cos_half <= limit)
+            {
+                d2d_points_add(&points, d2d_point_offset(v, m[0], m[1], h / cos_half));
+            }
+            else if (desc->lineJoin == D2D1_LINE_JOIN_MITER)
+            {
+                /* cut off square to the mitre, as far out as the limit */
+                t = h * (limit - cos_half) / (d0[0] * m[0] + d0[1] * m[1]);
+                p = d2d_point_offset(v, n0[0], n0[1], h);
+                d2d_points_add(&points, d2d_point_offset(p, d0[0], d0[1], t));
+                p = d2d_point_offset(v, n1[0], n1[1], h);
+                d2d_points_add(&points, d2d_point_offset(p, -d1[0], -d1[1], t));
+            }
+            break;
+
+        default:
+            break;
+    }
+    d2d_points_add(&points, d2d_point_offset(v, n1[0], n1[1], h));
+    d2d_stroke_pieces_add(pieces, &points);
+    d2d_points_cleanup(&points);
+}
+
+static void d2d_stroke_pieces_line(struct d2d_stroke_pieces *pieces, const struct d2d_polyline *line, float h,
+        const D2D1_STROKE_STYLE_PROPERTIES1 *desc, float tolerance)
+{
+    double d0[2], d1[2], len;
+    D2D1_POINT_2F *points;
+    size_t i, count = 0;
+
+    if (!(points = malloc(max(line->count, 1) * sizeof(*points))))
+    {
+        pieces->hr = E_OUTOFMEMORY;
+        return;
+    }
+    for (i = 0; i < line->count; ++i)
+    {
+        if (count && points[count - 1].x == line->points[i].x && points[count - 1].y == line->points[i].y)
+            continue;
+        points[count++] = line->points[i];
+    }
+    if (line->closed && count > 1 && points[0].x == points[count - 1].x && points[0].y == points[count - 1].y)
+        --count;
+
+    for (i = 0; i + 1 < count; ++i)
+        d2d_stroke_pieces_segment(pieces, points[i], points[i + 1], h);
+    if (line->closed && count > 2)
+        d2d_stroke_pieces_segment(pieces, points[count - 1], points[0], h);
+
+    for (i = line->closed ? 0 : 1; count > 2 && i < (line->closed ? count : count - 1); ++i)
+    {
+        const D2D1_POINT_2F *p = &points[(i + count - 1) % count], *v = &points[i], *q = &points[(i + 1) % count];
+
+        len = sqrt(((double)v->x - p->x) * ((double)v->x - p->x) + ((double)v->y - p->y) * ((double)v->y - p->y));
+        d0[0] = (v->x - (double)p->x) / len;
+        d0[1] = (v->y - (double)p->y) / len;
+        len = sqrt(((double)q->x - v->x) * ((double)q->x - v->x) + ((double)q->y - v->y) * ((double)q->y - v->y));
+        d1[0] = (q->x - (double)v->x) / len;
+        d1[1] = (q->y - (double)v->y) / len;
+        d2d_stroke_pieces_join(pieces, *v, d0, d1, h, desc, tolerance);
+    }
+    free(points);
+}
+
+/* A cap that is not the stroke drawn further, at p facing along d. */
+static void d2d_stroke_pieces_cap(struct d2d_stroke_pieces *pieces, D2D1_POINT_2F p, const double d[2], float h,
+        D2D1_CAP_STYLE cap, float tolerance)
+{
+    struct d2d_points points = {0};
+    D2D1_POINT_2F q;
+
+    switch (cap)
+    {
+        case D2D1_CAP_STYLE_SQUARE:
+            d2d_points_add(&points, d2d_point_offset(p, -d[1], d[0], h));
+            q = d2d_point_offset(p, d[0], d[1], h);
+            d2d_points_add(&points, d2d_point_offset(q, -d[1], d[0], h));
+            d2d_points_add(&points, d2d_point_offset(q, d[1], -d[0], h));
+            d2d_points_add(&points, d2d_point_offset(p, d[1], -d[0], h));
+            break;
+
+        case D2D1_CAP_STYLE_ROUND:
+            d2d_points_add(&points, d2d_point_offset(p, -d[1], d[0], h));
+            d2d_points_add_arc(&points, pieces, p, h, atan2(d[0], -d[1]), -M_PI, tolerance);
+            break;
+
+        case D2D1_CAP_STYLE_TRIANGLE:
+            d2d_points_add(&points, d2d_point_offset(p, -d[1], d[0], h));
+            d2d_points_add(&points, d2d_point_offset(p, d[0], d[1], h));
+            d2d_points_add(&points, d2d_point_offset(p, d[1], -d[0], h));
+            break;
+
+        default:
+            return;
+    }
+    d2d_stroke_pieces_add(pieces, &points);
+    d2d_points_cleanup(&points);
+}
+
+static BOOL d2d_unit_direction(D2D1_POINT_2F p, D2D1_POINT_2F q, double d[2])
+{
+    double len = sqrt(((double)q.x - p.x) * ((double)q.x - p.x) + ((double)q.y - p.y) * ((double)q.y - p.y));
+
+    if (!(len > 0.0))
+        return FALSE;
+    d[0] = (q.x - (double)p.x) / len;
+    d[1] = (q.y - (double)p.y) / len;
+    return TRUE;
+}
+
+/*
+ * A figure stroked without dashes.  Where the segments are of one curve, flattened, they are joined round, as
+ * Windows joins what it flattens, and so are segments marked to be joined round to the one before, as all of an
+ * ellipse's are; an open figure has its caps.
+ */
+static void d2d_stroke_pieces_solid(struct d2d_stroke_pieces *pieces, const struct d2d_polyline *line, float h,
+        const D2D1_STROKE_STYLE_PROPERTIES1 *desc, float tolerance)
+{
+    const struct d2d_segment_source *in, *out;
+    D2D1_STROKE_STYLE_PROPERTIES1 round;
+    static const double ahead[2] = {1.0, 0.0};
+    double d0[2], d1[2], back[2];
+    size_t *kept, count = 0, i, k;
+
+    if (!line->count)
+        return;
+    if (!(kept = malloc(line->count * sizeof(*kept))))
+    {
+        pieces->hr = E_OUTOFMEMORY;
+        return;
+    }
+    for (i = 0; i < line->count; ++i)
+    {
+        if (count && line->points[kept[count - 1]].x == line->points[i].x
+                && line->points[kept[count - 1]].y == line->points[i].y)
+            continue;
+        kept[count++] = i;
+    }
+    if (line->closed && count > 1 && line->points[kept[0]].x == line->points[kept[count - 1]].x
+            && line->points[kept[0]].y == line->points[kept[count - 1]].y)
+        --count;
+
+    for (k = 0; k + 1 < count; ++k)
+        d2d_stroke_pieces_segment(pieces, line->points[kept[k]], line->points[kept[k + 1]], h);
+    if (line->closed && count > 2)
+        d2d_stroke_pieces_segment(pieces, line->points[kept[count - 1]], line->points[kept[0]], h);
+
+    round = *desc;
+    round.lineJoin = D2D1_LINE_JOIN_ROUND;
+    for (k = line->closed ? 0 : 1; count > 2 && k < (line->closed ? count : count - 1); ++k)
+    {
+        const D2D1_POINT_2F *p = &line->points[kept[(k + count - 1) % count]], *v = &line->points[kept[k]];
+        const D2D1_POINT_2F *q = &line->points[kept[(k + 1) % count]];
+
+        d2d_unit_direction(*p, *v, d0);
+        d2d_unit_direction(*v, *q, d1);
+        /* the segments arriving at v and leaving it */
+        in = &line->sources[kept[k]];
+        out = k + 1 < count ? &line->sources[kept[k + 1]] : &line->sources[0];
+        d2d_stroke_pieces_join(pieces, *v, d0, d1, h,
+                (in->curve >= 0 && in->curve == out->curve) || out->round_join ? &round : desc, tolerance);
+    }
+
+    if (line->closed && count > 2)
+    {
+        free(kept);
+        return;
+    }
+    /* a point is stroked across */
+    if (count < 2 || !d2d_unit_direction(line->points[kept[0]], line->points[kept[1]], d0))
+        memcpy(d0, ahead, sizeof(d0));
+    if (count < 2 || !d2d_unit_direction(line->points[kept[count - 2]], line->points[kept[count - 1]], d1))
+        memcpy(d1, d0, sizeof(d1));
+    back[0] = -d0[0];
+    back[1] = -d0[1];
+    d2d_stroke_pieces_cap(pieces, line->points[kept[0]], back, h, desc->startCap, tolerance);
+    d2d_stroke_pieces_cap(pieces, line->points[kept[count - 1]], d1, h, desc->endCap, tolerance);
+    free(kept);
+}
+
+static HRESULT d2d_geometry_stroke_pieces(ID2D1Geometry *geometry, float width, ID2D1StrokeStyle *stroke_style,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, BOOL segments, struct d2d_stroke_pieces *pieces)
+{
+    struct d2d_stroke_style default_style, *style = NULL;
+    ID2D1PathGeometry *stroke = NULL, *caps = NULL;
+    struct d2d_polylines lines;
+    ID2D1Factory *factory;
+    float scale;
+    HRESULT hr;
+    size_t i;
+
+    memset(pieces, 0, sizeof(*pieces));
+    pieces->polylines.fill_mode = D2D1_FILL_MODE_WINDING;
+    pieces->transform = transform;
+    pieces->segments = segments;
+    pieces->curve_bounds.left = pieces->curve_bounds.top = FLT_MAX;
+    pieces->curve_bounds.right = pieces->curve_bounds.bottom = -FLT_MAX;
+    if (!(tolerance > 0.0f))
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+    /* as finely where the geometry is as the tolerance asks for where it goes */
+    if (transform && (scale = sqrtf(fabsf(transform->_11 * transform->_22 - transform->_12 * transform->_21))) > 0.0f)
+        tolerance /= scale;
+    if (stroke_style)
+        style = unsafe_impl_from_ID2D1StrokeStyle(stroke_style);
+    if (!style)
+    {
+        /* what a stroke without a style is: flat ends, mitred joins */
+        memset(&default_style, 0, sizeof(default_style));
+        default_style.desc.lineJoin = D2D1_LINE_JOIN_MITER;
+        default_style.desc.miterLimit = 10.0f;
+        style = &default_style;
+    }
+
+    if (!style->dash_count)
+    {
+        if (SUCCEEDED(hr = d2d_geometry_flatten(geometry, NULL, tolerance, &lines)))
+        {
+            for (i = 0; i < lines.count; ++i)
+                d2d_stroke_pieces_solid(pieces, &lines.lines[i], width / 2.0f, &style->desc, tolerance);
+            d2d_polylines_cleanup(&lines);
+        }
+        if (SUCCEEDED(hr))
+            hr = pieces->hr;
+        if (FAILED(hr))
+            d2d_polylines_cleanup(&pieces->polylines);
+        return hr;
+    }
+
+    /* dashes cut the figures where they go; their caps come with them */
+    ID2D1Geometry_GetFactory(geometry, &factory);
+    hr = d2d_stroke_style_apply(style, factory, geometry, width, tolerance, &stroke, &caps);
+    ID2D1Factory_Release(factory);
+    if (FAILED(hr))
+        return hr;
+
+    if (stroke && SUCCEEDED(hr = d2d_geometry_flatten((ID2D1Geometry *)stroke, NULL, tolerance, &lines)))
+    {
+        for (i = 0; i < lines.count; ++i)
+            d2d_stroke_pieces_line(pieces, &lines.lines[i], width / 2.0f, &style->desc, tolerance);
+        d2d_polylines_cleanup(&lines);
+    }
+    if (SUCCEEDED(hr) && caps && SUCCEEDED(hr = d2d_geometry_flatten((ID2D1Geometry *)caps, NULL, tolerance, &lines)))
+    {
+        struct d2d_points points;
+        size_t curve_base = pieces->polylines.curve_count, j;
+
+        /* the caps are circles and triangles; the circles' curves are the pieces' too */
+        if (lines.curve_count && !d2d_array_reserve((void **)&pieces->polylines.curves,
+                &pieces->polylines.curves_size, curve_base + lines.curve_count, sizeof(*pieces->polylines.curves)))
+            pieces->hr = E_OUTOFMEMORY;
+        for (i = 0; SUCCEEDED(pieces->hr) && i < lines.curve_count; ++i)
+        {
+            struct d2d_curve *curve = &pieces->polylines.curves[pieces->polylines.curve_count++];
+
+            *curve = lines.curves[i];
+            if (transform)
+            {
+                d2d_point_transform(&curve->p0, transform, curve->p0.x, curve->p0.y);
+                d2d_point_transform(&curve->b.point1, transform, curve->b.point1.x, curve->b.point1.y);
+                d2d_point_transform(&curve->b.point2, transform, curve->b.point2.x, curve->b.point2.y);
+                d2d_point_transform(&curve->b.point3, transform, curve->b.point3.x, curve->b.point3.y);
+            }
+            d2d_bezier_bounds(curve->p0, &curve->b, &pieces->curve_bounds);
+        }
+        for (i = 0; SUCCEEDED(pieces->hr) && i < lines.count; ++i)
+        {
+            memset(&points, 0, sizeof(points));
+            for (j = 0; j < lines.lines[i].count; ++j)
+            {
+                const struct d2d_segment_source *source = &lines.lines[i].sources[j];
+
+                d2d_points_add_source(&points, lines.lines[i].points[j],
+                        source->curve >= 0 ? curve_base + source->curve : -1, source->t0, source->t1);
+            }
+            d2d_stroke_pieces_add(pieces, &points);
+            d2d_points_cleanup(&points);
+        }
+        d2d_polylines_cleanup(&lines);
+    }
+    if (stroke)
+        ID2D1PathGeometry_Release(stroke);
+    if (caps)
+        ID2D1PathGeometry_Release(caps);
+
+    if (SUCCEEDED(hr))
+        hr = pieces->hr;
+    if (FAILED(hr))
+        d2d_polylines_cleanup(&pieces->polylines);
+    return hr;
+}
+
+/* What a stroke covers, as figures that do not cross: the pieces of it put together. */
+HRESULT d2d_geometry_widen(ID2D1Geometry *geometry, float width, ID2D1StrokeStyle *stroke_style,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, ID2D1SimplifiedGeometrySink *sink)
+{
+    struct d2d_arrangement arrangement;
+    struct d2d_stroke_pieces pieces;
+    HRESULT hr;
+
+    if (FAILED(hr = d2d_geometry_stroke_pieces(geometry, width, stroke_style, transform, tolerance, TRUE, &pieces)))
+        return hr;
+    if (SUCCEEDED(hr = d2d_arrangement_init(&arrangement, &pieces.polylines, NULL)))
+    {
+        hr = d2d_arrangement_write(&arrangement, D2D1_COMBINE_MODE_UNION, sink);
+        d2d_arrangement_cleanup(&arrangement);
+    }
+    d2d_polylines_cleanup(&pieces.polylines);
+    return hr;
+}
+
+/* The bounds of what a stroke covers are those of its pieces. */
+HRESULT d2d_geometry_get_widened_bounds(ID2D1Geometry *geometry, float width, ID2D1StrokeStyle *stroke_style,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_RECT_F *bounds)
+{
+    struct d2d_stroke_pieces pieces;
+    const struct d2d_polyline *line;
+    HRESULT hr;
+    size_t i, j;
+
+    if (FAILED(hr = d2d_geometry_stroke_pieces(geometry, width, stroke_style, transform, tolerance, TRUE, &pieces)))
+        return hr;
+    *bounds = pieces.curve_bounds;
+    for (i = 0; i < pieces.polylines.count; ++i)
+    {
+        line = &pieces.polylines.lines[i];
+        for (j = 0; j < line->count; ++j)
+        {
+            bounds->left = min(bounds->left, line->points[j].x);
+            bounds->top = min(bounds->top, line->points[j].y);
+            bounds->right = max(bounds->right, line->points[j].x);
+            bounds->bottom = max(bounds->bottom, line->points[j].y);
+        }
+    }
+    /* nothing stroked has the bounds of nothing */
+    if (bounds->left > bounds->right)
+    {
+        bounds->left = bounds->top = INFINITY;
+        bounds->right = bounds->bottom = FLT_MAX;
+    }
+    d2d_polylines_cleanup(&pieces.polylines);
+    return S_OK;
+}
+
+/* Whether a point is in a stroke, or nearer its edge than the tolerance: in one of its pieces, or near one; only
+ * the pieces of joins and caps, if segments is FALSE. */
+HRESULT d2d_geometry_stroke_contains_styled_point(ID2D1Geometry *geometry, D2D1_POINT_2F point, float width,
+        ID2D1StrokeStyle *stroke_style, const D2D1_MATRIX_3X2_F *transform, float tolerance, BOOL segments,
+        BOOL *contains)
+{
+    struct d2d_bool_point p = {point.x, point.y}, p0, p1;
+    struct d2d_stroke_pieces pieces;
+    const struct d2d_polyline *line;
+    int winding;
+    size_t i, j;
+    HRESULT hr;
+
+    if (!(tolerance > 0.0f))
+        tolerance = D2D1_DEFAULT_FLATTENING_TOLERANCE;
+    if (FAILED(hr = d2d_geometry_stroke_pieces(geometry, width, stroke_style, transform, tolerance / 16.0f,
+            segments, &pieces)))
+        return hr;
+    *contains = FALSE;
+    for (i = 0; i < pieces.polylines.count && !*contains; ++i)
+    {
+        line = &pieces.polylines.lines[i];
+        for (j = 0, winding = 0; j < line->count; ++j)
+        {
+            p0 = d2d_bool_point(line->points[j].x, line->points[j].y);
+            p1 = d2d_bool_point(line->points[(j + 1) % line->count].x, line->points[(j + 1) % line->count].y);
+            if (p0.y <= p.y)
+            {
+                if (p1.y > p.y && d2d_bool_cross(p0, p1, p) > 0.0)
+                    ++winding;
+            }
+            else if (p1.y <= p.y && d2d_bool_cross(p0, p1, p) < 0.0)
+            {
+                --winding;
+            }
+            if (d2d_segment_distance(point, line->points[j], line->points[(j + 1) % line->count]) < tolerance)
+                *contains = TRUE;
+        }
+        if (winding)
+            *contains = TRUE;
+    }
+    d2d_polylines_cleanup(&pieces.polylines);
+    return S_OK;
+}
