+BOOL d2d_bezier_is_flat(const D2D1_POINT_2F *p0, const D2D1_BEZIER_SEGMENT *b, float tolerance)
+{
+    D2D1_POINT_2F q;
+
+    d2d_point_lerp(&q, p0, &b->point3, 1.0f / 3.0f);
+    if (!(fabsf(b->point1.x - q.x) < tolerance && fabsf(b->point1.y - q.y) < tolerance))
+        return FALSE;
+    d2d_point_lerp(&q, p0, &b->point3, 2.0f / 3.0f);
+    return fabsf(b->point2.x - q.x) < tolerance && fabsf(b->point2.y - q.y) < tolerance;
 }
 
