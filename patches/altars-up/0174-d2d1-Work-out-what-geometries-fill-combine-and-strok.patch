+        ID2D1GeometrySink_AddQuadraticBezier(path_sink, &quadratics[0]);
+        ID2D1GeometrySink_AddBeziers(path_sink, cubics, ARRAY_SIZE(cubics));
+        ID2D1GeometrySink_EndFigure(path_sink, D2D1_FIGURE_END_OPEN);
+        hr = ID2D1GeometrySink_Close(path_sink);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ID2D1GeometrySink_Release(path_sink);
+        hr = ID2D1PathGeometry_Stream(path, &sink.ID2D1GeometrySink_iface);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        geometry_sink_check(&sink, D2D1_FILL_MODE_WINDING, 2, expected_figures, 0);
+        geometry_sink_cleanup(&sink);
+        ID2D1PathGeometry_Release(path);
+    }
+
+    release_test_context(&ctx);
+}
