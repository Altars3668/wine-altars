+/* The point the segments of a figure have come to. */
+static D2D1_POINT_2F d2d_figure_get_end_point(struct d2d_figure *figure)
+{
+    const struct d2d_segment *segment = d2d_figure_get_current_segment(figure);
+    const void *data;
+
+    if (!segment)
+        return figure->vertices[0];
+    data = segment + 1;
+    switch (segment->type)
+    {
+        case D2D_SEGMENT_TYPE_BEZIERS:
+            return ((const D2D1_BEZIER_SEGMENT *)data)[segment->count - 1].point3;
+        case D2D_SEGMENT_TYPE_QUADRATIC_BEZIERS:
+            return ((const D2D1_QUADRATIC_BEZIER_SEGMENT *)data)[segment->count - 1].point2;
+        case D2D_SEGMENT_TYPE_LINES:
+            return ((const D2D1_POINT_2F *)data)[segment->count - 1];
+        default:
+            return ((const D2D1_ARC_SEGMENT *)data)[segment->count - 1].point;
+    }
+}
