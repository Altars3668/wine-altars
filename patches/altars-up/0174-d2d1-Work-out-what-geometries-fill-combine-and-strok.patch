+    hr = ID2D1GeometryGroup_FillContainsPoint(group, point, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(contains, "Got unexpected contains %#x.\n", contains);
+    set_point(&point, 7.0f, 7.0f);
+    contains = TRUE;
+    hr = ID2D1GeometryGroup_FillContainsPoint(group, point, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!contains, "Got unexpected contains %#x.\n", contains);
+    ID2D1GeometryGroup_Release(group);
+
+    /* The ellipse covers its inside, and its stroke lies along its edge. */
+    set_point(&point, 7.0f, 7.0f);
+    contains = FALSE;
+    hr = ID2D1Geometry_FillContainsPoint(ellipse_geometry, point, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(contains, "Got unexpected contains %#x.\n", contains);
+    contains = FALSE;
+    hr = ID2D1Geometry_StrokeContainsPoint(ellipse_geometry, point, 2.0f, NULL, NULL,
+            D2D1_DEFAULT_FLATTENING_TOLERANCE, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(contains, "Got unexpected contains %#x.\n", contains);
+    set_point(&point, 2.0f, 2.0f);
+    contains = TRUE;
+    hr = ID2D1Geometry_StrokeContainsPoint(ellipse_geometry, point, 2.0f, NULL, NULL,
+            D2D1_DEFAULT_FLATTENING_TOLERANCE, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!contains, "Got unexpected contains %#x.\n", contains);
+    set_point(&point, 12.0f, 2.0f);
+    contains = TRUE;
+    hr = ID2D1Geometry_FillContainsPoint(ellipse_geometry, point, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &contains);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!contains, "Got unexpected contains %#x.\n", contains);
+
+    ID2D1Geometry_Release(ellipse_geometry);
+    ID2D1Geometry_Release(squares[1]);
+    ID2D1Geometry_Release(squares[0]);
+    release_test_context(&ctx);
+}
