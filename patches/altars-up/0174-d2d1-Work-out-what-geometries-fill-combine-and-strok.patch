+/* A path of filled, closed figures, their points one after the other; counts gives how many each has. */
+static ID2D1PathGeometry *create_polygons(ID2D1Factory *factory, D2D1_FILL_MODE fill_mode,
+        const D2D1_POINT_2F *points, const unsigned int *counts, unsigned int figure_count)
+{
+    ID2D1GeometrySink *sink;
+    ID2D1PathGeometry *path;
+    unsigned int i;
+    HRESULT hr;
+
+    hr = ID2D1Factory_CreatePathGeometry(factory, &path);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1PathGeometry_Open(path, &sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1GeometrySink_SetFillMode(sink, fill_mode);
+    for (i = 0; i < figure_count; ++i)
+    {
+        ID2D1GeometrySink_BeginFigure(sink, points[0], D2D1_FIGURE_BEGIN_FILLED);
+        ID2D1GeometrySink_AddLines(sink, points + 1, counts[i] - 1);
+        ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+        points += counts[i];
+    }
+    hr = ID2D1GeometrySink_Close(sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1GeometrySink_Release(sink);
+
+    return path;
+}
