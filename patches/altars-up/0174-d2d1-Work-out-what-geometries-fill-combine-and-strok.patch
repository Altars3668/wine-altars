+static ID2D1PathGeometry *create_polyline(ID2D1Factory *factory, const D2D1_POINT_2F *points,
+        unsigned int count);
+
+/* Windows works along a geometry in floats, so a point it gives is only near where it should be. */
+static BOOL compare_point_near(const D2D1_POINT_2F *point, float x, float y)
+{
+    return fabsf(point->x - x) < 1e-4f && fabsf(point->y - y) < 1e-4f;
+}
+
+static void check_point_at_length_(unsigned int line, ID2D1Geometry *geometry, const D2D1_MATRIX_3X2_F *transform,
+        float length, float x, float y, float tx, float ty)
+{
+    D2D1_POINT_2F point = {-99.0f, -99.0f}, tangent = {-99.0f, -99.0f};
+    HRESULT hr;
+
+    hr = ID2D1Geometry_ComputePointAtLength(geometry, length, transform, D2D1_DEFAULT_FLATTENING_TOLERANCE,
+            &point, &tangent);
+    ok_(__FILE__, line)(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(compare_point_near(&point, x, y), "At %.8e got point {%.8e, %.8e}.\n",
+            length, point.x, point.y);
+    ok_(__FILE__, line)(compare_point_near(&tangent, tx, ty), "At %.8e got tangent {%.8e, %.8e}.\n",
+            length, tangent.x, tangent.y);
+}
+#define check_point_at_length(a, b, c, d, e, f, g) check_point_at_length_(__LINE__, a, b, c, d, e, f, g)
+
