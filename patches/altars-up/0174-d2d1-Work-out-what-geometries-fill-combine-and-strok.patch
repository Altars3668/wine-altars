+    /* The curve is halved until it is flat enough: until both control points are nearer than the tolerance, across
+     * or down, to where they would be if the curve were the line between its ends.  This is what Windows does; the
+     * areas and lengths worked out on what it gives match to the last digit.
      *
-     * p1' = (p0 + p2) / 2
-     * p2' = (p1 + p3) / 2
-     *   d = ‖p1 - p1'‖₁ + ‖p2 - p2'‖₁ */
-    d2d_point_lerp(&q, p0, &b->point2, 0.5f);
-    d2d_point_subtract(&q, &b->point1, &q);
-    d = fabsf(q.x) + fabsf(q.y);
-    d2d_point_lerp(&q, &b->point1, &b->point3, 0.5f);
