+/* The corners of a rounded rectangle are the quarters of ellipses, from the one at the top left round clockwise;
+ * the sides between them are lines. */
+static void d2d_rounded_rect_to_segments(const D2D1_ROUNDED_RECT *r, D2D1_POINT_2F *start_point,
+        D2D1_BEZIER_SEGMENT *segments, D2D1_POINT_2F *lines)
+{
+    D2D1_ELLIPSE ellipse;
+
+    ellipse.radiusX = r->radiusX;
+    ellipse.radiusY = r->radiusY;
+    d2d_point_set(start_point, r->rect.left, r->rect.top + r->radiusY);
+    d2d_point_set(&ellipse.point, r->rect.left + r->radiusX, r->rect.top + r->radiusY);
+    d2d_ellipse_quarter(&ellipse, 0, &segments[0]);
+    d2d_point_set(&lines[0], r->rect.right - r->radiusX, r->rect.top);
+    d2d_point_set(&ellipse.point, r->rect.right - r->radiusX, r->rect.top + r->radiusY);
+    d2d_ellipse_quarter(&ellipse, 1, &segments[1]);
+    d2d_point_set(&lines[1], r->rect.right, r->rect.bottom - r->radiusY);
+    d2d_point_set(&ellipse.point, r->rect.right - r->radiusX, r->rect.bottom - r->radiusY);
+    d2d_ellipse_quarter(&ellipse, 2, &segments[2]);
+    d2d_point_set(&lines[2], r->rect.left + r->radiusX, r->rect.bottom);
+    d2d_point_set(&ellipse.point, r->rect.left + r->radiusX, r->rect.bottom - r->radiusY);
+    d2d_ellipse_quarter(&ellipse, 3, &segments[3]);
+}
