+static void d2d_simplify_rounded(ID2D1SimplifiedGeometrySink *sink, D2D1_GEOMETRY_SIMPLIFICATION_OPTION option,
+        const D2D1_MATRIX_3X2_F *transform, float tolerance, D2D1_POINT_2F start,
