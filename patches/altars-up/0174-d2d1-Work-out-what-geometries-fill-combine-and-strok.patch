+/* The bounds of an ellipse or a rounded rectangle are those of the curves it is drawn with. */
+static void d2d_rounded_bounds(const D2D1_MATRIX_3X2_F *transform, D2D1_POINT_2F start,
+        const D2D1_BEZIER_SEGMENT *curves, const D2D1_POINT_2F *lines, D2D1_RECT_F *bounds)
+{
+    D2D1_RECT_F curve_bounds;
+    D2D1_BEZIER_SEGMENT b;
+    D2D1_POINT_2F p, q;
+    unsigned int i;
+
+    if (transform)
+        d2d_point_transform(&start, transform, start.x, start.y);
+    bounds->left = bounds->right = start.x;
+    bounds->top = bounds->bottom = start.y;
+    for (i = 0, p = start; i < 4; ++i)
+    {
+        b = curves[i];
+        if (transform)
