+/* A quarter of an ellipse as a cubic Bézier: the first from its left round to its top, the others on round
+ * clockwise.  The Bézier's middle is on the ellipse, its ends are, and so are the tangents there.  Worked out in
+ * doubles, so that the control points come out as those Windows hands out do. */
+#define D2D_KAPPA (4.0 * (M_SQRT2 - 1.0) / 3.0)
+static void d2d_ellipse_quarter(const D2D1_ELLIPSE *ellipse, unsigned int quarter, D2D1_BEZIER_SEGMENT *segment)
+{
+    static const double unit[4][3][2] =
+    {
+        {{-1.0, -D2D_KAPPA}, {-D2D_KAPPA, -1.0}, { 0.0, -1.0}},
+        {{ D2D_KAPPA, -1.0}, { 1.0, -D2D_KAPPA}, { 1.0,  0.0}},
+        {{ 1.0,  D2D_KAPPA}, { D2D_KAPPA,  1.0}, { 0.0,  1.0}},
+        {{-D2D_KAPPA,  1.0}, {-1.0,  D2D_KAPPA}, {-1.0,  0.0}},
+    };
+    D2D1_POINT_2F *points[3] = {&segment->point1, &segment->point2, &segment->point3};
+    unsigned int i;
+
+    for (i = 0; i < 3; ++i)
+    {
+        points[i]->x = ellipse->point.x + (double)ellipse->radiusX * unit[quarter][i][0];
+        points[i]->y = ellipse->point.y + (double)ellipse->radiusY * unit[quarter][i][1];
+    }
+}
+#undef D2D_KAPPA
