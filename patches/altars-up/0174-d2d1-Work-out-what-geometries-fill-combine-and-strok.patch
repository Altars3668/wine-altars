+/* The bounds of a cubic Bézier: its ends, and where it turns back across or down. */
+static void d2d_rect_get_cubic_bezier_bounds(D2D_RECT_F *bounds, const D2D1_POINT_2F *p0,
+        const D2D1_POINT_2F *p1, const D2D1_POINT_2F *p2, const D2D1_POINT_2F *p3)
+{
+    const double x[4] = {p0->x, p1->x, p2->x, p3->x}, y[4] = {p0->y, p1->y, p2->y, p3->y};
+    const double *c[2] = {x, y};
+    double a, b, d, t[2], mt;
+    unsigned int axis, i, n;
+    D2D1_POINT_2F p;
+
+    bounds->left = p0->x;
+    bounds->top = p0->y;
+    bounds->right = p0->x;
+    bounds->bottom = p0->y;
+    d2d_rect_expand(bounds, p3);
+
+    for (axis = 0; axis < 2; ++axis)
+    {
+        /* f'(t) / 3 = (1 - t)²(P₁ - P₀) + 2(1 - t)t(P₂ - P₁) + t²(P₃ - P₂) = at² + bt + d */
+        a = (c[axis][1] - c[axis][0]) - 2.0 * (c[axis][2] - c[axis][1]) + (c[axis][3] - c[axis][2]);
+        b = 2.0 * ((c[axis][2] - c[axis][1]) - (c[axis][1] - c[axis][0]));
+        d = c[axis][1] - c[axis][0];
+        n = 0;
+        if (fabs(a) <= 1e-12 * (fabs(b) + fabs(d)))
+        {
+            if (b != 0.0)
+                t[n++] = -d / b;
+        }
+        else if (b * b - 4.0 * a * d >= 0.0)
+        {
+            t[n++] = (-b + sqrt(b * b - 4.0 * a * d)) / (2.0 * a);
+            t[n++] = (-b - sqrt(b * b - 4.0 * a * d)) / (2.0 * a);
+        }
+        for (i = 0; i < n; ++i)
+        {
+            if (!(t[i] > 0.0 && t[i] < 1.0))
+                continue;
+            mt = 1.0 - t[i];
+            p.x = mt * mt * mt * x[0] + 3.0 * mt * mt * t[i] * x[1] + 3.0 * mt * t[i] * t[i] * x[2]
+                    + t[i] * t[i] * t[i] * x[3];
+            p.y = mt * mt * mt * y[0] + 3.0 * mt * mt * t[i] * y[1] + 3.0 * mt * t[i] * t[i] * y[2]
+                    + t[i] * t[i] * t[i] * y[3];
+            d2d_rect_expand(bounds, &p);
+        }
+    }
+}
