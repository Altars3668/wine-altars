+    check_point_at_length((ID2D1Geometry *)path, NULL, 12.0f, 9.422176f, 1.40281f, 0.5340283f, -0.8454667f);
+    ID2D1PathGeometry_Release(path);
+
+    /* An open figure is not closed to measure it, and hollow ones count. */
+    path = create_polyline(ctx.factory, polyline, ARRAY_SIZE(polyline));
+    hr = ID2D1PathGeometry_ComputeLength(path, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &length);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(compare_float(length, 20.0f, 0), "Got unexpected length %.8e.\n", length);
+    check_point_at_length((ID2D1Geometry *)path, NULL, 10.0f, 10.0f, 0.0f, 0.0f, 1.0f);
+    check_point_at_length((ID2D1Geometry *)path, NULL, 25.0f, 10.0f, 10.0f, 0.0f, 1.0f);
+    ID2D1PathGeometry_Release(path);
+
+    /* Nothing to be along. */
+    hr = ID2D1Factory_CreatePathGeometry(ctx.factory, &path);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1PathGeometry_Open(path, &path_sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1GeometrySink_Close(path_sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1GeometrySink_Release(path_sink);
+    length = -1.0f;
+    hr = ID2D1PathGeometry_ComputeLength(path, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &length);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(!length, "Got unexpected length %.8e.\n", length);
+    point.x = point.y = tangent.x = tangent.y = 0.0f;
+    hr = ID2D1PathGeometry_ComputePointAtLength(path, 0.0f, NULL, D2D1_DEFAULT_FLATTENING_TOLERANCE, &point, &tangent);
