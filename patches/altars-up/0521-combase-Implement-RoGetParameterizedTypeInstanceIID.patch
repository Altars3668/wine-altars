+static HRESULT WINAPI locator_Locate(IRoMetaDataLocator *iface, const WCHAR *name, IRoSimpleMetaDataBuilder *builder)
+{
+    static const WCHAR *map_default[] = { L"Windows.Foundation.Collections.IMap`2", L"String", L"Object" };
+    static const WCHAR *point_fields[] = { L"Single", L"Single" };
+    static const WCHAR *nested_fields[] = { L"Windows.Foundation.Point", L"Windows.Foundation.AsyncStatus", L"String" };
+    static const WCHAR *vector_fields[] = { L"Windows.Foundation.Collections.IVector`1", L"String" };
+    static const GUID group_iid = {0x00000000, 0x1111, 0x2222, {0x33, 0x33, 0x44, 0x44, 0x55, 0x55, 0x66, 0x66}};
+    static const GUID uri_iid = {0x9e365e57, 0x48b2, 0x4160, {0x95, 0x6f, 0xc7, 0x38, 0x51, 0x20, 0xbb, 0xfc}};
+    char buffer[128];
+    HRESULT hr;
+
+    sprintf(buffer, "%s%s", *locate_calls ? "," : "", wine_dbgstr_w(name));
+    strcat(locate_calls, buffer);
+
+    if (!wcscmp(name, L"Windows.Foundation.Collections.IVector`1"))
+    {
+        hr = IRoSimpleMetaDataBuilder_SetParameterizedInterface(builder,
+                guid_from_string("913337e9-11a1-4345-a3a2-4e7f956e222d"), 1);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        if (locate_twice)
+        {
+            hr = IRoSimpleMetaDataBuilder_SetWinRtInterface(builder, group_iid);
+            ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+            return S_OK;
+        }
+        return hr;
+    }
+    if (!wcscmp(name, L"Windows.Foundation.Collections.IIterable`1"))
+        return IRoSimpleMetaDataBuilder_SetParameterizedInterface(builder,
+                guid_from_string("faa585ea-6214-4217-afda-7f46de5869b3"), 1);
+    if (!wcscmp(name, L"Windows.Foundation.Collections.IMap`2"))
+        return IRoSimpleMetaDataBuilder_SetParameterizedInterface(builder,
+                guid_from_string("3c2925fe-8519-45c1-aa79-197b6718c1c1"), 2);
+    if (!wcscmp(name, L"Windows.Foundation.Collections.IKeyValuePair`2"))
+        return IRoSimpleMetaDataBuilder_SetParameterizedInterface(builder,
+                guid_from_string("02b51929-c1c4-4a7e-8940-0312b5c18500"), 2);
+    if (!wcscmp(name, L"Windows.Foundation.IReference`1"))
+        return IRoSimpleMetaDataBuilder_SetParameterizedInterface(builder,
+                guid_from_string("61c17706-2d65-11e0-9ae8-d48564015472"), 1);
+    if (!wcscmp(name, L"Windows.Foundation.AsyncOperationCompletedHandler`1"))
+        return IRoSimpleMetaDataBuilder_SetParameterizedDelegate(builder,
+                guid_from_string("fcdcf02c-e5d8-4478-915a-4d90b74b83a5"), 1);
+    if (!wcscmp(name, L"Windows.Foundation.IAsyncAction"))
+        return IRoSimpleMetaDataBuilder_SetWinRtInterface(builder, guid_from_string("5a648006-843a-4da9-865b-9d26e5dfad7b"));
+    if (!wcscmp(name, L"Windows.Foundation.AsyncActionCompletedHandler"))
+        return IRoSimpleMetaDataBuilder_SetDelegate(builder, guid_from_string("a4ed5c81-76c9-40bd-8be6-b1d90fb20ae7"));
+    if (!wcscmp(name, L"Windows.Foundation.Uri"))
+        return IRoSimpleMetaDataBuilder_SetRuntimeClassSimpleDefault(builder, name,
+                L"Windows.Foundation.IUriRuntimeClass", &uri_iid);
+    if (!wcscmp(name, L"Test.ClassNoIid"))
+        return IRoSimpleMetaDataBuilder_SetRuntimeClassSimpleDefault(builder, name, L"Windows.Foundation.IAsyncAction", NULL);
+    if (!wcscmp(name, L"Windows.Foundation.Collections.PropertySet"))
+        return IRoSimpleMetaDataBuilder_SetRuntimeClassParameterizedDefault(builder, name, 3, map_default);
+    if (!wcscmp(name, L"Test.Group"))
+        return IRoSimpleMetaDataBuilder_SetInterfaceGroupSimpleDefault(builder, name, L"Windows.Foundation.IAsyncAction", &group_iid);
+    if (!wcscmp(name, L"Test.PGroup"))
+        return IRoSimpleMetaDataBuilder_SetInterfaceGroupParameterizedDefault(builder, name, 3, map_default);
+    if (!wcscmp(name, L"Windows.Foundation.Point"))
+        return IRoSimpleMetaDataBuilder_SetStruct(builder, name, 2, point_fields);
+    if (!wcscmp(name, L"Test.Nested"))
+        return IRoSimpleMetaDataBuilder_SetStruct(builder, name, 3, nested_fields);
+    if (!wcscmp(name, L"Test.BadStruct"))
+        return IRoSimpleMetaDataBuilder_SetStruct(builder, name, 2, vector_fields);
+    if (!wcscmp(name, L"Test.EmptyStruct"))
+        return IRoSimpleMetaDataBuilder_SetStruct(builder, name, 0, NULL);
+    if (!wcscmp(name, L"Windows.Foundation.AsyncStatus"))
+        return IRoSimpleMetaDataBuilder_SetEnum(builder, name, L"Int32");
+    if (!wcscmp(name, L"Test.Flags"))
+        return IRoSimpleMetaDataBuilder_SetEnum(builder, name, L"UInt32");
+    if (!wcscmp(name, L"Test.Failing"))
+        return E_FAIL;
+    return 0x80073d54;
+}
