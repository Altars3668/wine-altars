+
+WINE_DEFAULT_DEBUG_CHANNEL(combase);
+
+/* A type instance's IID is the name-based (SHA-1) UUID of its signature, as the Windows Runtime
+ * type system describes it, in this namespace; the locator describes each name that is not a
+ * fundamental type. */
+static const BYTE pinterface_namespace[] =
+{
+    0x11, 0xf4, 0x7a, 0xd5, 0x7b, 0x73, 0x42, 0xc0, 0xab, 0xae, 0x87, 0x8b, 0x1e, 0x16, 0xad, 0xee
+};
+
+static const struct
+{
+    const WCHAR *name;
+    const char *signature;
+}
+fundamental_types[] =
+{
+    { L"Boolean", "b1" },
+    { L"UInt8",   "u1" },
+    { L"Int16",   "i2" },
+    { L"UInt16",  "u2" },
+    { L"Int32",   "i4" },
+    { L"UInt32",  "u4" },
+    { L"Int64",   "i8" },
+    { L"UInt64",  "u8" },
+    { L"Single",  "f4" },
+    { L"Double",  "f8" },
+    { L"Char16",  "c2" },
+    { L"String",  "string" },
+    { L"Guid",    "g16" },
+    { L"Object",  "cinterface(IInspectable)" },
+};
+
+enum type_kind
+{
+    TYPE_NONE,
+    TYPE_INTERFACE,
+    TYPE_DELEGATE,
+    TYPE_PARAMETERIZED,
+    TYPE_GROUP,
+    TYPE_CLASS,
+    TYPE_STRUCT,
+    TYPE_ENUM,
+};
+
+/* what the locator said about one name */
+struct type_builder
+{
+    IRoSimpleMetaDataBuilder IRoSimpleMetaDataBuilder_iface;
+    enum type_kind kind;
+    GUID iid;
+    BOOL has_iid;
+    WCHAR *name;
+    /* the arguments of a parameterized type */
+    UINT32 arg_count;
+    /* the default interface of a class or group by name, the fields of a struct, the base type of an enum */
+    WCHAR **elements;
+    UINT32 count;
+};
+
+static inline struct type_builder *impl_from_IRoSimpleMetaDataBuilder(IRoSimpleMetaDataBuilder *iface)
+{
+    return CONTAINING_RECORD(iface, struct type_builder, IRoSimpleMetaDataBuilder_iface);
+}
+
+static HRESULT builder_set_names(struct type_builder *builder, enum type_kind kind, const WCHAR *name,
+                                 UINT32 count, const WCHAR **elements)
+{
+    WCHAR *copy, **copies = NULL;
+    UINT32 i;
+
+    if (builder->kind != TYPE_NONE) return E_INVALIDARG;
+    if (!name || (count && !elements)) return E_INVALIDARG;
+    for (i = 0; i < count; i++) if (!elements[i]) return E_INVALIDARG;
+
+    if (!(copy = wcsdup(name))) return E_OUTOFMEMORY;
+    if (count && !(copies = calloc(count, sizeof(*copies))))
+    {
+        free(copy);
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if ((copies[i] = wcsdup(elements[i]))) continue;
+        while (i) free(copies[--i]);
+        free(copies);
+        free(copy);
+        return E_OUTOFMEMORY;
+    }
+    builder->kind = kind;
+    builder->name = copy;
+    builder->elements = copies;
+    builder->count = count;
+    return S_OK;
+}
+
+static HRESULT builder_set_iid(struct type_builder *builder, enum type_kind kind, const GUID *iid, UINT32 arg_count)
+{
+    if (builder->kind != TYPE_NONE) return E_INVALIDARG;
+    builder->kind = kind;
+    builder->iid = *iid;
+    builder->has_iid = TRUE;
+    builder->arg_count = arg_count;
+    return S_OK;
+}
+
+static HRESULT builder_set_default(struct type_builder *builder, enum type_kind kind, const WCHAR *name,
+                                   const WCHAR *default_name, const GUID *default_iid)
+{
+    HRESULT hr;
+
+    if (default_iid)
+    {
+        if (FAILED(hr = builder_set_names(builder, kind, name, 0, NULL))) return hr;
+        builder->iid = *default_iid;
+        builder->has_iid = TRUE;
+        return S_OK;
+    }
+    if (!default_name) return E_INVALIDARG;
+    return builder_set_names(builder, kind, name, 1, &default_name);
+}
+
+static HRESULT WINAPI builder_SetWinRtInterface(IRoSimpleMetaDataBuilder *iface, GUID iid)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s.\n", iface, debugstr_guid(&iid));
+
+    return builder_set_iid(builder, TYPE_INTERFACE, &iid, 0);
+}
+
+static HRESULT WINAPI builder_SetDelegate(IRoSimpleMetaDataBuilder *iface, GUID iid)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s.\n", iface, debugstr_guid(&iid));
+
+    return builder_set_iid(builder, TYPE_DELEGATE, &iid, 0);
+}
+
+static HRESULT WINAPI builder_SetInterfaceGroupSimpleDefault(IRoSimpleMetaDataBuilder *iface, const WCHAR *name,
+                                                             const WCHAR *default_name, const GUID *default_iid)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s, %s, %s.\n", iface, debugstr_w(name), debugstr_w(default_name), debugstr_guid(default_iid));
+
+    return builder_set_default(builder, TYPE_GROUP, name, default_name, default_iid);
+}
+
+static HRESULT WINAPI builder_SetInterfaceGroupParameterizedDefault(IRoSimpleMetaDataBuilder *iface,
+                                                                    const WCHAR *name, UINT32 count,
+                                                                    const WCHAR **elements)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s, %u, %p.\n", iface, debugstr_w(name), count, elements);
+
+    return builder_set_names(builder, TYPE_GROUP, name, count, elements);
+}
+
+static HRESULT WINAPI builder_SetRuntimeClassSimpleDefault(IRoSimpleMetaDataBuilder *iface, const WCHAR *name,
+                                                           const WCHAR *default_name, const GUID *default_iid)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s, %s, %s.\n", iface, debugstr_w(name), debugstr_w(default_name), debugstr_guid(default_iid));
+
+    return builder_set_default(builder, TYPE_CLASS, name, default_name, default_iid);
+}
+
+static HRESULT WINAPI builder_SetRuntimeClassParameterizedDefault(IRoSimpleMetaDataBuilder *iface,
+                                                                  const WCHAR *name, UINT32 count,
+                                                                  const WCHAR **elements)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s, %u, %p.\n", iface, debugstr_w(name), count, elements);
+
+    return builder_set_names(builder, TYPE_CLASS, name, count, elements);
+}
+
+static HRESULT WINAPI builder_SetStruct(IRoSimpleMetaDataBuilder *iface, const WCHAR *name, UINT32 count,
+                                        const WCHAR **fields)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s, %u, %p.\n", iface, debugstr_w(name), count, fields);
+
+    return builder_set_names(builder, TYPE_STRUCT, name, count, fields);
+}
+
+static HRESULT WINAPI builder_SetEnum(IRoSimpleMetaDataBuilder *iface, const WCHAR *name, const WCHAR *base_type)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s, %s.\n", iface, debugstr_w(name), debugstr_w(base_type));
+
+    if (!base_type) return E_INVALIDARG;
+    return builder_set_names(builder, TYPE_ENUM, name, 1, &base_type);
+}
+
+static HRESULT WINAPI builder_SetParameterizedInterface(IRoSimpleMetaDataBuilder *iface, GUID iid, UINT32 count)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s, %u.\n", iface, debugstr_guid(&iid), count);
+
+    return builder_set_iid(builder, TYPE_PARAMETERIZED, &iid, count);
+}
+
+static HRESULT WINAPI builder_SetParameterizedDelegate(IRoSimpleMetaDataBuilder *iface, GUID iid, UINT32 count)
+{
+    struct type_builder *builder = impl_from_IRoSimpleMetaDataBuilder(iface);
+
+    TRACE("%p, %s, %u.\n", iface, debugstr_guid(&iid), count);
+
+    return builder_set_iid(builder, TYPE_PARAMETERIZED, &iid, count);
+}
+
+static const IRoSimpleMetaDataBuilderVtbl builder_vtbl =
+{
+    builder_SetWinRtInterface,
+    builder_SetDelegate,
+    builder_SetInterfaceGroupSimpleDefault,
+    builder_SetInterfaceGroupParameterizedDefault,
+    builder_SetRuntimeClassSimpleDefault,
+    builder_SetRuntimeClassParameterizedDefault,
+    builder_SetStruct,
+    builder_SetEnum,
+    builder_SetParameterizedInterface,
+    builder_SetParameterizedDelegate,
+};
+
+static void builder_cleanup(struct type_builder *builder)
+{
+    UINT32 i;
+
+    for (i = 0; i < builder->count; i++) free(builder->elements[i]);
+    free(builder->elements);
+    free(builder->name);
+}
+
+struct signature
+{
+    IRoMetaDataLocator *locator;
+    unsigned int depth;
+    char *data;
+    size_t len, size;
+};
+
+static HRESULT append(struct signature *sig, const char *str, size_t len)
+{
+    if (sig->len + len + 1 > sig->size)
+    {
+        size_t size = max(max(sig->size * 2, sig->len + len + 1), 64);
+        char *data;
+
+        if (!(data = realloc(sig->data, size))) return E_OUTOFMEMORY;
+        sig->data = data;
+        sig->size = size;
+    }
+    memcpy(sig->data + sig->len, str, len);
+    sig->len += len;
+    sig->data[sig->len] = 0;
+    return S_OK;
+}
+
+static HRESULT append_str(struct signature *sig, const char *str)
+{
+    return append(sig, str, strlen(str));
+}
+
+static HRESULT append_name(struct signature *sig, const WCHAR *name)
+{
+    char buffer[256], *str = buffer;
+    int len;
+    HRESULT hr;
+
+    len = WideCharToMultiByte(CP_UTF8, 0, name, -1, NULL, 0, NULL, NULL);
+    if (len > sizeof(buffer) && !(str = malloc(len))) return E_OUTOFMEMORY;
+    WideCharToMultiByte(CP_UTF8, 0, name, -1, str, len, NULL, NULL);
+    hr = append(sig, str, len - 1);
+    if (str != buffer) free(str);
+    return hr;
+}
+
+static HRESULT append_guid(struct signature *sig, const GUID *guid)
+{
+    char str[39];
+
+    sprintf(str, "{%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}", guid->Data1, guid->Data2, guid->Data3,
+            guid->Data4[0], guid->Data4[1], guid->Data4[2], guid->Data4[3], guid->Data4[4], guid->Data4[5],
+            guid->Data4[6], guid->Data4[7]);
+    return append_str(sig, str);
+}
+
+static HRESULT append_type(struct signature *sig, UINT32 count, const WCHAR *const *elements, UINT32 *pos);
+
+/* elements that make up one type, as a whole */
+static HRESULT append_whole_type(struct signature *sig, UINT32 count, const WCHAR *const *elements)
+{
+    UINT32 pos = 0;
+    HRESULT hr;
+
+    if (!count) return E_UNEXPECTED;
+    if (FAILED(hr = append_type(sig, count, elements, &pos))) return hr;
+    return pos == count ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT append_located_type(struct signature *sig, struct type_builder *builder, UINT32 count,
+                                   const WCHAR *const *elements, UINT32 *pos)
+{
+    static const char *const prefixes[] = { NULL, NULL, "delegate(", "pinterface(", "ig(", "rc(", "struct(", "enum(" };
+    HRESULT hr;
+    UINT32 i;
+
+    if (builder->kind == TYPE_NONE) return E_UNEXPECTED;
+    if (prefixes[builder->kind] && FAILED(hr = append_str(sig, prefixes[builder->kind]))) return hr;
+
+    switch (builder->kind)
+    {
+    case TYPE_INTERFACE:
+        return append_guid(sig, &builder->iid);
+
+    case TYPE_DELEGATE:
+        if (FAILED(hr = append_guid(sig, &builder->iid))) return hr;
+        break;
+
+    case TYPE_PARAMETERIZED:
+        if (FAILED(hr = append_guid(sig, &builder->iid))) return hr;
+        for (i = 0; i < builder->arg_count; i++)
+        {
+            if (FAILED(hr = append_str(sig, ";"))) return hr;
+            if (FAILED(hr = append_type(sig, count, elements, pos))) return hr;
+        }
+        break;
+
+    case TYPE_GROUP:
+    case TYPE_CLASS:
+    case TYPE_ENUM:
+        if (FAILED(hr = append_name(sig, builder->name))) return hr;
+        if (FAILED(hr = append_str(sig, ";"))) return hr;
+        if (builder->has_iid) hr = append_guid(sig, &builder->iid);
+        else hr = append_whole_type(sig, builder->count, (const WCHAR *const *)builder->elements);
+        if (FAILED(hr)) return hr;
+        break;
+
+    case TYPE_STRUCT:
+        if (FAILED(hr = append_name(sig, builder->name))) return hr;
+        /* the fields' types follow one another, each with the arguments it takes */
+        if (!builder->count) return E_UNEXPECTED;
+        for (i = 0; i < builder->count;)
+        {
+            if (FAILED(hr = append_str(sig, ";"))) return hr;
+            if (FAILED(hr = append_type(sig, builder->count, (const WCHAR *const *)builder->elements, &i)))
+                return hr;
+        }
+        break;
+
+    case TYPE_NONE:
+        break;
+    }
+    return append_str(sig, ")");
+}
+
+/* the type at elements[*pos], with its arguments */
+static HRESULT append_type(struct signature *sig, UINT32 count, const WCHAR *const *elements, UINT32 *pos)
+{
+    struct type_builder builder = {{&builder_vtbl}};
+    const WCHAR *name;
+    HRESULT hr;
+    UINT32 i;
+
+    if (*pos >= count) return E_INVALIDARG;
+    if (!(name = elements[(*pos)++])) return E_INVALIDARG;
+
+    for (i = 0; i < ARRAY_SIZE(fundamental_types); i++)
+        if (!wcscmp(name, fundamental_types[i].name)) return append_str(sig, fundamental_types[i].signature);
+
+    if (sig->depth >= 64) return E_UNEXPECTED;
+    hr = IRoMetaDataLocator_Locate(sig->locator, name, &builder.IRoSimpleMetaDataBuilder_iface);
+    TRACE("locator answers %#lx for %s.\n", hr, debugstr_w(name));
+    if (SUCCEEDED(hr))
+    {
+        sig->depth++;
+        hr = append_located_type(sig, &builder, count, elements, pos);
+        sig->depth--;
+    }
+    builder_cleanup(&builder);
+    return hr;
+}
+
+static HRESULT signature_iid(const struct signature *sig, GUID *iid)
+{
+    BYTE *data, hash[20];
+    NTSTATUS status;
+
+    if (!(data = malloc(sizeof(pinterface_namespace) + sig->len))) return E_OUTOFMEMORY;
+    memcpy(data, pinterface_namespace, sizeof(pinterface_namespace));
+    memcpy(data + sizeof(pinterface_namespace), sig->data, sig->len);
+    status = BCryptHash(BCRYPT_SHA1_ALG_HANDLE, NULL, 0, data, sizeof(pinterface_namespace) + sig->len,
+                        hash, sizeof(hash));
+    free(data);
+    if (status) return HRESULT_FROM_NT(status);
+
+    /* a version 5 UUID, from the hash in network order */
+    iid->Data1 = (DWORD)hash[0] << 24 | hash[1] << 16 | hash[2] << 8 | hash[3];
+    iid->Data2 = hash[4] << 8 | hash[5];
+    iid->Data3 = ((hash[6] << 8 | hash[7]) & 0x0fff) | 0x5000;
+    iid->Data4[0] = (hash[8] & 0x3f) | 0x80;
+    memcpy(iid->Data4 + 1, hash + 9, 7);
+    return S_OK;
+}
+
+/***********************************************************************
+ *      RoGetParameterizedTypeInstanceIID (combase.@)
+ */
+HRESULT WINAPI RoGetParameterizedTypeInstanceIID(UINT32 name_element_count, const WCHAR **name_elements,
+                                                 const IRoMetaDataLocator *meta_data_locator, GUID *iid,
+                                                 ROPARAMIIDHANDLE *hiid)
+{
+    struct signature sig = { (IRoMetaDataLocator *)meta_data_locator };
+    HRESULT hr;
+
+    TRACE("%u, %p, %p, %p, %p.\n", name_element_count, name_elements, meta_data_locator, iid, hiid);
+
+    if (hiid) *hiid = NULL;
+    if (!iid) return E_INVALIDARG;
+    *iid = GUID_NULL;
+    if (!meta_data_locator || (name_element_count && !name_elements)) return E_INVALIDARG;
+
+    if (SUCCEEDED(hr = append_whole_type(&sig, name_element_count, name_elements)) &&
+        FAILED(hr = signature_iid(&sig, iid)))
+        *iid = GUID_NULL;
+    TRACE("signature %s, iid %s.\n", debugstr_a(sig.data), debugstr_guid(iid));
+
+    /* Windows hands out the signature it got to even when the type is wrong */
+    if (hiid)
+    {
+        if (!sig.data && FAILED(append(&sig, "", 0)))
+        {
+            *iid = GUID_NULL;
+            return E_OUTOFMEMORY;
+        }
+        *hiid = sig.data;
+    }
+    else free(sig.data);
+    return hr;
+}
+
+/***********************************************************************
+ *      RoParameterizedTypeExtraGetTypeSignature (combase.@)
+ */
+const char * WINAPI RoParameterizedTypeExtraGetTypeSignature(ROPARAMIIDHANDLE extra)
+{
+    TRACE("%p.\n", extra);
+
+    return extra;
+}
+
+/***********************************************************************
+ *      RoFreeParameterizedTypeExtra (combase.@)
+ */
+void WINAPI RoFreeParameterizedTypeExtra(ROPARAMIIDHANDLE extra)
+{
+    TRACE("%p.\n", extra);
+
+    free(extra);
+}
