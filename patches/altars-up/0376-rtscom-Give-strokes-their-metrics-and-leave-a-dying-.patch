From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 09:51:30 -0400
Subject: [PATCH] rtscom: Give strokes their metrics, and leave a dying stylus
 alone.

The stroke builder passes the packet properties it is given on to the
stroke as its metrics.  The mouse hook took a reference to every enabled
stylus in the list while it held the list's lock, also to one whose last
reference was being released on another thread before it left the list,
which it then used after it was freed; it now takes a reference only
while the count is not zero.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/rtscom/rtscom_main.c b/dlls/rtscom/rtscom_main.c
index 04d81728687..5dd575441ab 100644
--- a/dlls/rtscom/rtscom_main.c
+++ b/dlls/rtscom/rtscom_main.c
@@ -396,6 +396,20 @@ static void handle_mouse( struct rtstylus *This, UINT msg, POINT pt )
     dispatch_event( This, &event, sizeof(event) );
 }
 
+/* a stylus whose last reference is going may still be in the list for a moment; it is left alone */
+static BOOL addref_if_alive( struct rtstylus *This )
+{
+    LONG ref = ReadNoFence( &This->ref );
+
+    while (ref)
+    {
+        LONG prev = InterlockedCompareExchange( &This->ref, ref + 1, ref );
+        if (prev == ref) return TRUE;
+        ref = prev;
+    }
+    return FALSE;
+}
+
 static LRESULT CALLBACK mouse_hook( int code, WPARAM wparam, LPARAM lparam )
 {
     MOUSEHOOKSTRUCT *info = (MOUSEHOOKSTRUCT *)lparam;
@@ -413,8 +427,7 @@ static LRESULT CALLBACK mouse_hook( int code, WPARAM wparam, LPARAM lparam )
         if (code != HC_ACTION || !This->use_mouse) continue;
         if (info->hwnd != This->hwnd && !IsChild( This->hwnd, info->hwnd ) && !This->down) continue;
         if (count == ARRAY_SIZE(targets)) break;
-        IRealTimeStylus_AddRef( &This->IRealTimeStylus_iface );
-        targets[count++] = This;
+        if (addref_if_alive( This )) targets[count++] = This;
     }
     LeaveCriticalSection( &styluses_cs );
 
@@ -1458,6 +1471,17 @@ static HRESULT create_ink_stroke( struct stroke_builder *This, ULONG count, cons
     }
     if (SUCCEEDED(hr))
         hr = IInkDisp_CreateStroke( ink, data, description, stroke );
+    if (SUCCEEDED(hr))
+    {
+        IWineInkStroke *wine_stroke;
+
+        /* the stroke keeps what the tablet said of each property */
+        if (SUCCEEDED(IInkStrokeDisp_QueryInterface( *stroke, &IID_IWineInkStroke, (void **)&wine_stroke )))
+        {
+            IWineInkStroke_SetPropertyMetrics( wine_stroke, property_count, properties );
+            IWineInkStroke_Release( wine_stroke );
+        }
+    }
 
     VariantClear( &description );
     VariantClear( &data );
diff --git a/dlls/rtscom/tests/rtscom.c b/dlls/rtscom/tests/rtscom.c
index 259464fa5ba..85dbb7513a4 100644
--- a/dlls/rtscom/tests/rtscom.c
+++ b/dlls/rtscom/tests/rtscom.c
@@ -270,7 +270,8 @@ static void test_realtime_stylus(void)
 static void test_stroke_builder(void)
 {
     static const LONG packets[] = {100, 200, 300, 400, 500, 600};
-    PACKET_PROPERTY properties[2] = {{GUID_X}, {GUID_Y}};
+    PACKET_PROPERTY properties[2] = {{GUID_X, {0, 50000, PROPERTY_UNITS_CENTIMETERS, 1000.0f}},
+                                     {GUID_Y, {0, 30000, PROPERTY_UNITS_CENTIMETERS, 1000.0f}}};
     IInkStrokeDisp *stroke, *ended;
     IStrokeBuilder *builder;
     IInkStrokes *strokes;
@@ -308,6 +309,18 @@ static void test_stroke_builder(void)
     ok(hr == S_OK, "Got hr %#lx.\n", hr);
     hr = IInkStrokeDisp_get_PacketCount(stroke, &count);
     ok(hr == S_OK && count == 3, "Got hr %#lx, count %ld.\n", hr, count);
+    {
+        BSTR name = SysAllocString(L"{598A6A8F-52C0-4BA0-93AF-AF357411A561}");
+        TabletPropertyMetricUnit units;
+        float resolution;
+        LONG minimum, maximum;
+
+        /* the stroke keeps what the packets' properties said */
+        hr = IInkStrokeDisp_GetPacketDescriptionPropertyMetrics(stroke, name, &minimum, &maximum, &units, &resolution);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        ok(maximum == 50000, "Got maximum %ld.\n", maximum);
+        SysFreeString(name);
+    }
     IInkStrokeDisp_Release(stroke);
 
     stroke = NULL;
