+    NULL, /* ApplyControlToken */
+    credssp_QueryContextAttributesW,
+    NULL, /* ImpersonateSecurityContext */
+    NULL, /* RevertSecurityContext */
+    NULL, /* MakeSignature */
+    NULL, /* VerifySignature */
+    FreeContextBuffer,
+    NULL, /* QuerySecurityPackageInfoW */
+    NULL, /* Reserved3 */
+    NULL, /* Reserved4 */
+    NULL, /* ExportSecurityContext */
+    NULL, /* ImportSecurityContextW */
+    NULL, /* AddCredentialsW */
+    NULL, /* Reserved8 */
+    NULL, /* QuerySecurityContextToken */
+    credssp_EncryptMessage,
+    credssp_DecryptMessage,
+    NULL, /* SetContextAttributesW */
+};
+
+void SECUR32_initCredSSPSP(void)
+{
+    /*
+     * Delegation is the point of this package, not an extra: callers check for
+     * it before deciding the package can carry credentials to a server, and
+     * one that does not claim it is passed over even when present. The rest
+     * describe what the exchange provides -- mutual authentication, a stream
+     * of protected messages -- and are what a caller uses to decide whether it
+     * can rely on the connection afterwards.
+     */
+    static const LONG caps =
+        SECPKG_FLAG_INTEGRITY |
+        SECPKG_FLAG_PRIVACY |
+        SECPKG_FLAG_CONNECTION |
+        SECPKG_FLAG_MULTI_REQUIRED |
+        SECPKG_FLAG_EXTENDED_ERROR |
+        SECPKG_FLAG_IMPERSONATION |
+        SECPKG_FLAG_ACCEPT_WIN32_NAME |
+        SECPKG_FLAG_DELEGATION |
+        SECPKG_FLAG_MUTUAL_AUTH |
+        SECPKG_FLAG_LOGON |
+        SECPKG_FLAG_STREAM;
+    static const short version = 1;
+    SecPkgInfoW info[] = {
+        { caps, version, RPC_C_AUTHN_GSS_NEGOTIATE, CREDSSP_MAX_TOKEN,
+          (SEC_WCHAR *)L"CREDSSP", (SEC_WCHAR *)L"Microsoft CredSSP Security Provider" },
+    };
+    SecureProvider *provider;
+
+    provider = SECUR32_addProvider( &credsspTableA, &credsspTableW, NULL );
+    if (!provider)
+    {
+        ERR( "Failed to add the CredSSP provider.\n" );
+        return;
+    }
+
+    SECUR32_addPackages( provider, ARRAY_SIZE(info), NULL, info );
+}
