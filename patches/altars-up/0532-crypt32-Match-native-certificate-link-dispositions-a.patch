From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 4 Oct 2026 03:38:48 -0400
Subject: [PATCH] crypt32: Match native certificate link dispositions and
 properties.

Reject the inherit-properties dispositions for links, leave an existing
link's properties untouched for USE_EXISTING, and clear missing property
lengths. Keep ordinary copied-context inheritance unchanged. Add a pure
memory-store regression mode validated on Windows 11.

Co-Authored-By: Claude Code <noreply@anthropic.com>

diff --git a/dlls/crypt32/cert.c b/dlls/crypt32/cert.c
index aaba2067cde..3126710c094 100644
--- a/dlls/crypt32/cert.c
+++ b/dlls/crypt32/cert.c
@@ -172,6 +172,12 @@ static BOOL add_cert_to_store(WINECRYPT_CERTSTORE *store, const CERT_CONTEXT *ce
     BOOL ret = TRUE, inherit_props = FALSE;
     context_t *new_context = NULL;
 
+    if (use_link && (add_disposition == CERT_STORE_ADD_REPLACE_EXISTING_INHERIT_PROPERTIES ||
+                     add_disposition == CERT_STORE_ADD_NEWER_INHERIT_PROPERTIES))
+    {
+        SetLastError( E_INVALIDARG );
+        return FALSE;
+    }
     switch (add_disposition)
     {
     case CERT_STORE_ADD_ALWAYS:
@@ -219,17 +225,13 @@ static BOOL add_cert_to_store(WINECRYPT_CERTSTORE *store, const CERT_CONTEXT *ce
     case CERT_STORE_ADD_REPLACE_EXISTING:
         break;
     case CERT_STORE_ADD_REPLACE_EXISTING_INHERIT_PROPERTIES:
-        if (use_link)
-            FIXME("CERT_STORE_ADD_REPLACE_EXISTING_INHERIT_PROPERTIES: semi-stub for links\n");
         if (existing)
             inherit_props = TRUE;
         break;
     case CERT_STORE_ADD_USE_EXISTING:
-        if(use_link)
-            FIXME("CERT_STORE_ADD_USE_EXISTING: semi-stub for links\n");
         if (existing)
         {
-            Context_CopyProperties(existing, cert);
+            if (!use_link) Context_CopyProperties(existing, cert);
             if (ret_context)
                 *ret_context = existing;
             else
@@ -307,12 +309,9 @@ BOOL WINAPI CertAddCertificateLinkToStore(HCERTSTORE hCertStore,
  PCCERT_CONTEXT pCertContext, DWORD dwAddDisposition,
  PCCERT_CONTEXT *ppCertContext)
 {
-    static int calls;
     WINECRYPT_CERTSTORE *store = (WINECRYPT_CERTSTORE*)hCertStore;
 
-    if (!(calls++))
-        FIXME("(%p, %p, %08lx, %p): semi-stub\n", hCertStore, pCertContext,
-         dwAddDisposition, ppCertContext);
+    TRACE("(%p, %p, %08lx, %p)\n", hCertStore, pCertContext, dwAddDisposition, ppCertContext);
     if (store->dwMagic != WINE_CRYPTCERTSTORE_MAGIC)
         return FALSE;
     if (store->type == StoreTypeCollection)
@@ -617,6 +616,7 @@ static BOOL CertContext_GetProperty(cert_t *cert, DWORD dwPropId,
             break;
         }
         default:
+            *pcbData = 0;
             SetLastError(CRYPT_E_NOT_FOUND);
         }
     }
diff --git a/dlls/crypt32/tests/store.c b/dlls/crypt32/tests/store.c
index c574873d28d..791664376cc 100644
--- a/dlls/crypt32/tests/store.c
+++ b/dlls/crypt32/tests/store.c
@@ -2808,6 +2808,85 @@ static void testAddCertificateLink(void)
     delete_test_key();
 }
 
+static void test_link_dispositions(void)
+{
+    static const DWORD dispositions[] = { CERT_STORE_ADD_NEW, CERT_STORE_ADD_USE_EXISTING,
+        CERT_STORE_ADD_REPLACE_EXISTING, CERT_STORE_ADD_ALWAYS,
+        CERT_STORE_ADD_REPLACE_EXISTING_INHERIT_PROPERTIES, CERT_STORE_ADD_NEWER,
+        CERT_STORE_ADD_NEWER_INHERIT_PROPERTIES };
+    HCERTSTORE store;
+    PCCERT_CONTEXT source, incoming, old, linked;
+    CRYPT_DATA_BLOB data;
+    WCHAR buffer[32];
+    DWORD size, error;
+    BOOL ret;
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(dispositions); i++)
+    {
+        store = CertOpenStore( CERT_STORE_PROV_MEMORY, 0, 0, CERT_STORE_CREATE_NEW_FLAG, NULL );
+        source = CertCreateCertificateContext( X509_ASN_ENCODING, bigCert, sizeof(bigCert) );
+        incoming = CertCreateCertificateContext( X509_ASN_ENCODING, bigCert, sizeof(bigCert) );
+        ok( store && source && incoming, "setup failed\n" );
+        if (!store || !source || !incoming)
+        {
+            CertFreeCertificateContext( source );
+            CertFreeCertificateContext( incoming );
+            if (store) CertCloseStore( store, 0 );
+            continue;
+        }
+        data.pbData = (BYTE *)L"alpha";
+        data.cbData = sizeof(L"alpha");
+        ret = CertSetCertificateContextProperty( source, CERT_FRIENDLY_NAME_PROP_ID, 0, &data );
+        ok( ret, "got %lu\n", GetLastError() );
+        ret = CertAddCertificateLinkToStore( store, source, CERT_STORE_ADD_ALWAYS, &old );
+        ok( ret, "got %lu\n", GetLastError() );
+        if (!ret)
+        {
+            CertFreeCertificateContext( source );
+            CertFreeCertificateContext( incoming );
+            CertCloseStore( store, 0 );
+            continue;
+        }
+        data.pbData = (BYTE *)L"beta";
+        data.cbData = sizeof(L"beta");
+        ret = CertSetCertificateContextProperty( incoming, CERT_DESCRIPTION_PROP_ID, 0, &data );
+        ok( ret, "got %lu\n", GetLastError() );
+        linked = NULL;
+        ret = CertAddCertificateLinkToStore( store, incoming, dispositions[i], &linked );
+        error = GetLastError();
+        if (i == 0 || i >= 4)
+        {
+            ok( !ret, "disposition %lu succeeded\n", dispositions[i] );
+            ok( error == ((i == 0 || i == 5) ? CRYPT_E_EXISTS : E_INVALIDARG),
+                "disposition %lu got %#lx\n", dispositions[i], error );
+        }
+        else
+        {
+            ok( ret, "disposition %lu got %#lx\n", dispositions[i], error );
+            if (ret)
+            {
+                ok( (linked == old) == (i == 1), "unexpected existing context\n" );
+                size = sizeof(buffer);
+                ret = CertGetCertificateContextProperty( linked, CERT_DESCRIPTION_PROP_ID, buffer, &size );
+                ok( ret == (i != 1), "description was copied to an existing link\n" );
+                if (i == 1) ok( !size, "got size %lu\n", size );
+                ret = CertSetCertificateContextProperty( linked, CERT_FRIENDLY_NAME_PROP_ID, 0, &data );
+                ok( ret, "got %lu\n", GetLastError() );
+                size = sizeof(buffer);
+                ret = CertGetCertificateContextProperty( incoming, CERT_FRIENDLY_NAME_PROP_ID, buffer, &size );
+                ok( ret == (i != 1), "unexpected property sharing\n" );
+                if (i == 1) ok( !size, "got size %lu\n", size );
+                CertFreeCertificateContext( linked );
+            }
+        }
+        CertFreeCertificateContext( old );
+        CertCloseStore( store, 0 );
+        CertFreeCertificateContext( source );
+        CertFreeCertificateContext( incoming );
+    }
+}
+
 static DWORD countCertsInStore(HCERTSTORE store)
 {
     PCCERT_CONTEXT cert = NULL;
@@ -3863,6 +3942,15 @@ static void test_CryptQueryObject(void)
 
 START_TEST(store)
 {
+    char **argv;
+    int argc = winetest_get_mainargs( &argv );
+
+    if (argc > 2 && !strcmp( argv[2], "links" ))
+    {
+        test_link_dispositions();
+        return;
+    }
+    test_link_dispositions();
     /* various combinations of CertOpenStore */
     testMemStore();
     testCollectionStore();
