+/***********************************************************************
+ *           get_alternate_name_info
+ *
+ * The short name of a file (FileAlternateNameInformation): the one it was given, the name itself if it is a
+ * short one, or one made from it.
+ */
+static NTSTATUS get_alternate_name_info( HANDLE handle, int fd, FILE_NAME_INFORMATION *info, LONG *name_len )
+{
+    WCHAR long_nameW[MAX_DIR_ENTRY_LEN + 1], short_nameW[13];
+    unsigned int status;
+    char *unix_name, *base;
+    int len, short_len, i;
+
+    if (get_given_short_name( fd, NULL, short_nameW )) short_len = wcslen( short_nameW );
+    else
+    {
+        if ((status = server_get_unix_name( handle, &unix_name ))) return status;
+        base = strrchr( unix_name, '/' );
+        base = base ? base + 1 : unix_name;
+        len = ntdll_umbstowcs( base, strlen(base), long_nameW, MAX_DIR_ENTRY_LEN );
+        free( unix_name );
+        if (!len) short_len = 0;
+        else if (is_legal_8dot3_name( long_nameW, len ))
+        {
+            memcpy( short_nameW, long_nameW, len * sizeof(WCHAR) );
+            short_len = len;
+        }
+        else short_len = hash_short_file_name( long_nameW, len, short_nameW );
+        for (i = 0; i < short_len; i++) short_nameW[i] = towupper( short_nameW[i] );
+    }
+    if (!short_len)
+    {
+        *name_len = 0;
+        return STATUS_OBJECT_NAME_NOT_FOUND;
+    }
+
+    info->FileNameLength = short_len * sizeof(WCHAR);
+    if (*name_len < info->FileNameLength)
+    {
+        memcpy( info->FileName, short_nameW, *name_len & ~1 );
+        *name_len &= ~1;
+        return STATUS_BUFFER_OVERFLOW;
+    }
+    memcpy( info->FileName, short_nameW, info->FileNameLength );
+    *name_len = info->FileNameLength;
+    return STATUS_SUCCESS;
+}
