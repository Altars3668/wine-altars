From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:46:41 -0400
Subject: [PATCH] ntdll, kernelbase: Give files the short names
 SetFileShortName gives them.

SetFileShortNameW refused every caller with ERROR_PRIVILEGE_NOT_HELD.
On Windows 11 it enables the restore privilege for the call
(RtlAcquirePrivilege), so one who holds it succeeds; it wants a handle
that may delete the file, an 8.3 name that no other file in the
directory has long or short (ERROR_ALREADY_EXISTS), takes it in upper
case, and an empty one takes the short name away (tools/startupgapsprobe
misc, misc4).

The name is kept in an extended attribute of the file, and the
directory is marked as holding such a file, so that listing it and
looking a short name up in it read the attributes there only; a file
given a short name has that one and no other.  FileAlternateNameInformation
gives a file's short name, the name itself when it is an 8.3 one, and
STATUS_OBJECT_NAME_NOT_FOUND when it was taken away; GetShortPathName
keeps a part that is an 8.3 name already, whatever other short name the
file has.  A wrong class or size for NtQueryInformationFile leaves the
I/O status block as it was, as on Windows.

RtlAcquirePrivilege enables privileges in a token of the thread's own (a
copy of the process's when it impersonates nobody), or in the process's;
RtlReleasePrivilege puts them back.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 38ef5a355d1..0991c1ee488 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -5918,6 +5918,101 @@ static void test_GetFinalPathNameByHandleA(void)
     CloseHandle(file);
 }
 
+/* short names set as Windows 11 sets them; the restore privilege is enabled for the call */
+static void test_SetFileShortNameW(void)
+{
+    WCHAR temp[MAX_PATH], dir[MAX_PATH], name[MAX_PATH], other[MAX_PATH], short8[MAX_PATH], path[MAX_PATH];
+    WIN32_FIND_DATAW data;
+    HANDLE file, find;
+    DWORD len;
+    BOOL ret;
+
+    GetTempPathW( ARRAY_SIZE(temp), temp );
+    swprintf( dir, ARRAY_SIZE(dir), L"%ssfn-test-%lu", temp, GetCurrentProcessId() );
+    ret = CreateDirectoryW( dir, NULL );
+    ok( ret, "got error %lu\n", GetLastError() );
+    swprintf( name, ARRAY_SIZE(name), L"%s\\sfn-test-long-file-name.txt", dir );
+    swprintf( other, ARRAY_SIZE(other), L"%s\\sfn-test-other-long-name.txt", dir );
+    swprintf( short8, ARRAY_SIZE(short8), L"%s\\SFN4.TXT", dir );
+    CloseHandle( CreateFileW( other, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL ));
+    CloseHandle( CreateFileW( short8, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL ));
+
+    file = CreateFileW( name, GENERIC_ALL, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = SetFileShortNameW( file, L"sfna~1.txt" );
+    if (!ret && GetLastError() == ERROR_PRIVILEGE_NOT_HELD)
+    {
+        skip( "the restore privilege is not held\n" );
+        CloseHandle( file );
+        goto done;
+    }
+    ok( ret, "got error %lu\n", GetLastError() );
+
+    find = FindFirstFileW( name, &data );
+    ok( find != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError() );
+    ok( !wcscmp( data.cAlternateFileName, L"SFNA~1.TXT" ), "got %s\n", debugstr_w(data.cAlternateFileName) );
+    FindClose( find );
+    len = GetShortPathNameW( name, path, ARRAY_SIZE(path) );
+    ok( len && !wcscmp( wcsrchr( path, '\\' ) + 1, L"SFNA~1.TXT" ), "got %s\n", debugstr_w(path) );
+
+    SetLastError( 0xdeadbeef );
+    ret = SetFileShortNameW( file, NULL );
+    ok( !ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = SetFileShortNameW( file, L"SFNEXTRA9.TXT" );
+    ok( !ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = SetFileShortNameW( file, L"SFN+E.TXT" );
+    ok( !ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = SetFileShortNameW( file, L"SFN4.TXT" );
+    ok( !ret && GetLastError() == ERROR_ALREADY_EXISTS, "got %d, error %lu\n", ret, GetLastError() );
+    CloseHandle( file );
+
+    /* it takes a handle that may delete the file */
+    file = CreateFileW( name, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    SetLastError( 0xdeadbeef );
+    ret = SetFileShortNameW( file, L"SFNB~1.TXT" );
+    ok( !ret && GetLastError() == ERROR_ACCESS_DENIED, "got %d, error %lu\n", ret, GetLastError() );
+    CloseHandle( file );
+
+    /* the file opens by its short name; once taken away, it has none */
+    swprintf( path, ARRAY_SIZE(path), L"%s\\SFNA~1.TXT", dir );
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError() );
+    CloseHandle( file );
+    file = CreateFileW( name, DELETE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    ret = SetFileShortNameW( file, L"" );
+    ok( ret, "got error %lu\n", GetLastError() );
+    CloseHandle( file );
+    find = FindFirstFileW( name, &data );
+    ok( find != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError() );
+    ok( !data.cAlternateFileName[0], "got %s\n", debugstr_w(data.cAlternateFileName) );
+    FindClose( find );
+    SetLastError( 0xdeadbeef );
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    ok( file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_FILE_NOT_FOUND, "got error %lu\n", GetLastError() );
+
+    /* a file with an 8.3 name keeps it in a short path, whatever short name it is given */
+    file = CreateFileW( short8, DELETE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    ret = SetFileShortNameW( file, L"SFN4X.TXT" );
+    ok( ret, "got error %lu\n", GetLastError() );
+    CloseHandle( file );
+    len = GetShortPathNameW( short8, path, ARRAY_SIZE(path) );
+    ok( len && !wcscmp( wcsrchr( path, '\\' ) + 1, L"SFN4.TXT" ), "got %s\n", debugstr_w(path) );
+
+done:
+    DeleteFileW( name );
+    DeleteFileW( other );
+    DeleteFileW( short8 );
+    RemoveDirectoryW( dir );
+}
+
 static void test_GetFinalPathNameByHandleW(void)
 {
     static WCHAR prefix[] = {'G','e','t','F','i','n','a','l','P','a','t','h',
@@ -7539,6 +7634,7 @@ START_TEST(file)
     test_file_access();
     test_GetFinalPathNameByHandleA();
     test_GetFinalPathNameByHandleW();
+    test_SetFileShortNameW();
     test_SetFileInformationByHandle();
     test_SetFileRenameInfo();
     test_GetFileAttributesExW();
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 83c5c3c115e..f066b85a4e9 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -1659,16 +1659,39 @@ HANDLE WINAPI DECLSPEC_HOTPATCH FindFirstFileW( const WCHAR *filename, WIN32_FIN
 /******************************************************************************
  *     SetFileShortNameW   (kernelbase.@)
  *
- * Wine's filesystems carry no 8.3 alias to set. On Windows this needs
- * SE_RESTORE_NAME and fails for an ordinary caller too, so refuse the same way
- * rather than claiming success: a caller that checks gets a truthful answer,
- * and one that only delay-imports the symbol gets to keep running.
+ * The restore privilege is enabled for the call, as Windows 11 does: one who holds it need not have it
+ * enabled, one who does not hold it gets ERROR_PRIVILEGE_NOT_HELD.
  */
 BOOL WINAPI SetFileShortNameW( HANDLE handle, const WCHAR *short_name )
 {
-    FIXME( "(%p, %s): stub\n", handle, debugstr_w(short_name) );
-    SetLastError( ERROR_PRIVILEGE_NOT_HELD );
-    return FALSE;
+    ULONG privilege = SE_RESTORE_PRIVILEGE, size;
+    FILE_NAME_INFORMATION *info;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    void *state;
+
+    TRACE( "(%p, %s)\n", handle, debugstr_w(short_name) );
+
+    if (!short_name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    size = max( sizeof(*info), offsetof( FILE_NAME_INFORMATION, FileName[wcslen( short_name )] ));
+    if (!(info = HeapAlloc( GetProcessHeap(), 0, size )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    info->FileNameLength = wcslen( short_name ) * sizeof(WCHAR);
+    memcpy( info->FileName, short_name, info->FileNameLength );
+    if (!(status = RtlAcquirePrivilege( &privilege, 1, 0, &state )))
+    {
+        status = NtSetInformationFile( handle, &io, info, size, FileShortNameInformation );
+        RtlReleasePrivilege( state );
+    }
+    HeapFree( GetProcessHeap(), 0, info );
+    return set_ntstatus( status );
 }
 
 
@@ -2482,6 +2505,16 @@ too_long:
 }
 
 
+/* whether a file name is a legal short (8.3) name */
+static BOOL is_short_name( const WCHAR *name )
+{
+    UNICODE_STRING str;
+    BOOLEAN spaces;
+
+    RtlInitUnicodeString( &str, name );
+    return RtlIsNameLegalDOS8Dot3( &str, NULL, &spaces ) && !spaces;
+}
+
 /***********************************************************************
  *	GetShortPathNameW   (kernelbase.@)
  */
@@ -2584,7 +2617,9 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetShortPathNameW( LPCWSTR longpath, LPWSTR short
             tmpshortpath = new_buf;
         }
 
-        lstrcpyW( tmpshortpath + sp, wfd.cAlternateFileName[0] ? wfd.cAlternateFileName : wfd.cFileName );
+        /* a part that is a short name already stays as it is, whatever other short name the file has */
+        if (!is_short_name( tmpshortpath + sp ))
+            lstrcpyW( tmpshortpath + sp, wfd.cAlternateFileName[0] ? wfd.cAlternateFileName : wfd.cFileName );
         sp += lstrlenW( tmpshortpath + sp );
         lp += tmplen;
     }
