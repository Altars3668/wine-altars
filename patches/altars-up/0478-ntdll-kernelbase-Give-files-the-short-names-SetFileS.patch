diff --git a/dlls/ntdll/sec.c b/dlls/ntdll/sec.c
index bc782825b21..735c3510bb9 100644
--- a/dlls/ntdll/sec.c
+++ b/dlls/ntdll/sec.c
@@ -2236,6 +2236,117 @@ void WINAPI RtlCopyLuidAndAttributesArray( ULONG count, const LUID_AND_ATTRIBUTE
  *	misc
  */
 
+/* what RtlAcquirePrivilege changed, for RtlReleasePrivilege to put back */
+struct acquired_privileges
+{
+    HANDLE            token;             /* the token whose privileges were enabled */
+    HANDLE            old_impersonation; /* the thread's token before, when a copy is set for it */
+    BOOL              copy;              /* the token is a copy of the process's set for the thread */
+    TOKEN_PRIVILEGES *old;               /* the privileges as they were */
+};
+
+/******************************************************************************
+ *  RtlReleasePrivilege		[NTDLL.@]
+ */
+void WINAPI RtlReleasePrivilege( void *ptr )
+{
+    struct acquired_privileges *state = ptr;
+
+    TRACE( "%p\n", ptr );
+
+    if (state->copy)
+    {
+        NtSetInformationThread( GetCurrentThread(), ThreadImpersonationToken, &state->old_impersonation,
+                                sizeof(HANDLE) );
+        if (state->old_impersonation) NtClose( state->old_impersonation );
+    }
+    else if (state->old) NtAdjustPrivilegesToken( state->token, FALSE, state->old, 0, NULL, NULL );
+    if (state->token) NtClose( state->token );
+    RtlFreeHeap( GetProcessHeap(), 0, state->old );
+    RtlFreeHeap( GetProcessHeap(), 0, state );
+}
+
+/******************************************************************************
+ *  RtlAcquirePrivilege		[NTDLL.@]
+ *
+ * Enables privileges for what the thread does next: in a token of the thread's own, a copy of the process's
+ * when it impersonates nobody (or when asked to revert to it), or in the process's token if asked to.
+ */
+NTSTATUS WINAPI RtlAcquirePrivilege( ULONG *privs, ULONG count, ULONG flags, void **ret )
+{
+    struct acquired_privileges *state;
+    TOKEN_PRIVILEGES *new = NULL;
+    ULONG i, size = offsetof( TOKEN_PRIVILEGES, Privileges[count] ), len;
+    NTSTATUS status;
+
+    TRACE( "%p, %lu, %#lx, %p\n", privs, count, flags, ret );
+
+    if (flags & ~(RTL_ACQUIRE_PRIVILEGE_REVERT | RTL_ACQUIRE_PRIVILEGE_PROCESS)) return STATUS_INVALID_PARAMETER;
+    if (!(state = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*state) ))) return STATUS_NO_MEMORY;
+
+    if (flags & RTL_ACQUIRE_PRIVILEGE_PROCESS)
+        status = NtOpenProcessToken( GetCurrentProcess(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, &state->token );
+    else
+    {
+        status = STATUS_NO_TOKEN;
+        if (!(flags & RTL_ACQUIRE_PRIVILEGE_REVERT))
+            status = NtOpenThreadToken( GetCurrentThread(), TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY, TRUE,
+                                        &state->token );
+        if (status == STATUS_NO_TOKEN)
+        {
+            SECURITY_QUALITY_OF_SERVICE qos = { sizeof(qos), SecurityImpersonation, SECURITY_STATIC_TRACKING, FALSE };
+            OBJECT_ATTRIBUTES attr;
+            HANDLE process_token;
+
+            if (flags & RTL_ACQUIRE_PRIVILEGE_REVERT)
+                NtOpenThreadToken( GetCurrentThread(), TOKEN_IMPERSONATE, TRUE, &state->old_impersonation );
+            InitializeObjectAttributes( &attr, NULL, 0, NULL, NULL );
+            attr.SecurityQualityOfService = &qos;
+            if (!(status = NtOpenProcessToken( GetCurrentProcess(), TOKEN_DUPLICATE, &process_token )))
+            {
+                status = NtDuplicateToken( process_token, TOKEN_ADJUST_PRIVILEGES | TOKEN_QUERY | TOKEN_IMPERSONATE,
+                                           &attr, FALSE, TokenImpersonation, &state->token );
+                NtClose( process_token );
+            }
+            if (!status) status = NtSetInformationThread( GetCurrentThread(), ThreadImpersonationToken,
+                                                          &state->token, sizeof(HANDLE) );
+            if (!status) state->copy = TRUE;
+        }
+    }
+    if (status) goto failed;
+
+    if (!(new = RtlAllocateHeap( GetProcessHeap(), 0, size )) ||
+        !(state->old = RtlAllocateHeap( GetProcessHeap(), 0, size )))
+    {
+        status = STATUS_NO_MEMORY;
+        goto failed;
+    }
+    new->PrivilegeCount = count;
+    for (i = 0; i < count; i++)
+    {
+        new->Privileges[i].Luid.LowPart = privs[i];
+        new->Privileges[i].Luid.HighPart = 0;
+        new->Privileges[i].Attributes = SE_PRIVILEGE_ENABLED;
+    }
+    status = NtAdjustPrivilegesToken( state->token, FALSE, new, size, state->old, &len );
+    if (status == STATUS_NOT_ALL_ASSIGNED) status = STATUS_PRIVILEGE_NOT_HELD;
+    if (status) goto failed;
+
+    RtlFreeHeap( GetProcessHeap(), 0, new );
+    *ret = state;
+    return STATUS_SUCCESS;
+
+failed:
+    RtlFreeHeap( GetProcessHeap(), 0, new );
+    if (status == STATUS_PRIVILEGE_NOT_HELD && !state->copy && state->old)
+        NtAdjustPrivilegesToken( state->token, FALSE, state->old, 0, NULL, NULL );
+    RtlFreeHeap( GetProcessHeap(), 0, state->old );
+    state->old = NULL;
+    if (state->copy || state->token) RtlReleasePrivilege( state );
+    else RtlFreeHeap( GetProcessHeap(), 0, state );
+    return status;
+}
+
 /******************************************************************************
  *  RtlAdjustPrivilege		[NTDLL.@]
  *
