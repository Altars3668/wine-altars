+
+/***********************************************************************
+ *           set_short_name
+ *
+ * Give a file a short name (FileShortNameInformation), or take it away with an empty one: it needs the
+ * restore privilege, and a handle that may delete the file; the name is an 8.3 one that no other file in
+ * the directory has, long or short.  It is kept in an extended attribute of the file, and the directory is
+ * marked as holding such files, so that only those are read for it.
+ */
+static NTSTATUS set_short_name( HANDLE handle, const WCHAR *name, int length )
+{
+    PRIVILEGE_SET privs = { 1, PRIVILEGE_SET_ALL_NECESSARY };
+    OBJECT_BASIC_INFORMATION basic;
+    char short_name[13], *unix_name = NULL, *dir_name = NULL, *slash;
+    WCHAR upper[13];
+    BOOLEAN held = FALSE;
+    unsigned int status;
+    int fd, needs_close, dir_fd, i;
+    struct stat st, other;
+    HANDLE token;
+
+    privs.Privilege[0].Luid.LowPart = SE_RESTORE_PRIVILEGE;
+    if (NtOpenThreadToken( NtCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        NtOpenProcessToken( NtCurrentProcess(), TOKEN_QUERY, &token ))
+        return STATUS_PRIVILEGE_NOT_HELD;
+    NtPrivilegeCheck( token, &privs, &held );
+    NtClose( token );
+    if (!held) return STATUS_PRIVILEGE_NOT_HELD;
+
+    /* the handle must be one that may delete the file, which the fd cache does not keep */
+    if ((status = NtQueryObject( handle, ObjectBasicInformation, &basic, sizeof(basic), NULL ))) return status;
+    if (!(basic.GrantedAccess & DELETE)) return STATUS_ACCESS_DENIED;
+    if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL ))) return status;
+
+    if (length > 12 || (length && !is_legal_8dot3_name( name, length )))
+    {
+        status = STATUS_INVALID_PARAMETER;
+        goto done;
+    }
+    for (i = 0; i < length; i++)
+    {
+        upper[i] = towupper( name[i] );
+        short_name[i] = upper[i];
+    }
+
+    if ((status = server_get_unix_name( handle, &unix_name ))) goto done;
+    if (!(slash = strrchr( unix_name, '/' )) || slash == unix_name)
+    {
+        status = STATUS_ACCESS_DENIED;  /* not for a root */
+        goto done;
+    }
+
+    /* no other file in the directory may have the name, long or short */
+    if (!(dir_name = malloc( (slash - unix_name) + MAX_DIR_ENTRY_LEN * 3 + 3 )))
+    {
+        status = STATUS_NO_MEMORY;
+        goto done;
+    }
+    memcpy( dir_name, unix_name, slash - unix_name );
+    dir_name[slash - unix_name] = 0;
+    if (length && !find_file_in_dir( AT_FDCWD, dir_name, slash - unix_name, upper, length, FALSE ) &&
+        !stat( dir_name, &other ) && !fstat( fd, &st ) && (other.st_dev != st.st_dev || other.st_ino != st.st_ino))
+    {
+        status = STATUS_OBJECT_NAME_COLLISION;
+        goto done;
+    }
+    dir_name[slash - unix_name] = 0;
+
+    if (xattr_fset( fd, XATTR_SHORT_NAME, short_name, length ) == -1)
+    {
+        status = errno_to_status( errno );
+        goto done;
+    }
+    if ((dir_fd = open( dir_name, O_RDONLY | O_DIRECTORY )) != -1)
+    {
+        if (xattr_fset( dir_fd, XATTR_SHORT_NAMES, "1", 1 ) == -1) status = errno_to_status( errno );
+        close( dir_fd );
+    }
+    else status = errno_to_status( errno );
+
+done:
+    free( dir_name );
+    free( unix_name );
+    if (needs_close) close( fd );
+    return status;
+}
