+/***********************************************************************
+ *           get_given_short_name
+ *
+ * The short name SetFileShortName gave a file, from an open file or from its name relative to the current
+ * directory: TRUE with it, upper case and empty if it was taken away.
+ */
+static BOOL get_given_short_name( int fd, const char *name, WCHAR *short_name )
+{
+    char buffer[13];
+    int i, len;
+
+    if (fd != -1) len = xattr_fget( fd, XATTR_SHORT_NAME, buffer, sizeof(buffer) - 1 );
+    else len = xattr_get( name, XATTR_SHORT_NAME, buffer, sizeof(buffer) - 1 );
+    if (len < 0) return FALSE;
+    for (i = 0; i < len; i++) short_name[i] = towupper( (unsigned char)buffer[i] );
+    short_name[len] = 0;
+    return TRUE;
+}
+
+
