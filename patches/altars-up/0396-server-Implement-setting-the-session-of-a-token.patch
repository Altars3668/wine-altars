From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:08:04 -0400
Subject: [PATCH] server: Implement setting the session of a token.

NtSetInformationToken(TokenSessionId) was a stub that claimed success and changed nothing.  As on
Windows, it needs TOKEN_ADJUST_DEFAULT and TOKEN_ADJUST_SESSIONID on the handle and SeTcbPrivilege
enabled in the caller, and a process created with the token then runs in that session.  That is how
a process of one session starts one in another: services.exe in session 0, say, for a service, or
a service for the user's session with the token WTSQueryUserToken gives it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/advapi32/tests/security.c b/dlls/advapi32/tests/security.c
index 28dd6c8d643..af1b833e5f0 100644
--- a/dlls/advapi32/tests/security.c
+++ b/dlls/advapi32/tests/security.c
@@ -8733,6 +8733,128 @@ static void test_window_security(void)
     LocalFree(sd);
 }
 
+static void test_token_session_child(DWORD session)
+{
+    DWORD id = 0xdeadbeef, size;
+    HANDLE token;
+    BOOL ret;
+
+    ret = ProcessIdToSessionId(GetCurrentProcessId(), &id);
+    ok(ret, "got error %lu\n", GetLastError());
+    ok(id == session, "got session %lu, expected %lu\n", id, session);
+    ok(NtCurrentTeb()->Peb->SessionId == session, "got PEB session %lu\n", NtCurrentTeb()->Peb->SessionId);
+
+    ret = OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token);
+    ok(ret, "got error %lu\n", GetLastError());
+    id = 0xdeadbeef;
+    ret = GetTokenInformation(token, TokenSessionId, &id, sizeof(id), &size);
+    ok(ret, "got error %lu\n", GetLastError());
+    ok(id == session, "got token session %lu, expected %lu\n", id, session);
+    CloseHandle(token);
+}
+
+static void test_token_session_id(void)
+{
+    DWORD session, process_session, id, size, prev_size;
+    char cmdline[MAX_PATH + 32];
+    TOKEN_PRIVILEGES privs, prev;
+    STARTUPINFOA si = {sizeof(si)};
+    PROCESS_INFORMATION pi;
+    HANDLE token, token2;
+    BOOL ret;
+
+    ret = ProcessIdToSessionId(GetCurrentProcessId(), &process_session);
+    ok(ret, "got error %lu\n", GetLastError());
+
+    ret = OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_DUPLICATE | TOKEN_ADJUST_PRIVILEGES, &token);
+    ok(ret, "got error %lu\n", GetLastError());
+    id = 0xdeadbeef;
+    ret = GetTokenInformation(token, TokenSessionId, &id, sizeof(id), &size);
+    ok(ret, "got error %lu\n", GetLastError());
+    ok(id == process_session, "got session %lu, expected %lu\n", id, process_session);
+    ok(size == sizeof(id), "got size %lu\n", size);
+
+    /* the handle needs both TOKEN_ADJUST_DEFAULT and TOKEN_ADJUST_SESSIONID */
+    session = process_session;
+    ret = DuplicateTokenEx(token, TOKEN_QUERY | TOKEN_ADJUST_DEFAULT, NULL, SecurityImpersonation, TokenPrimary, &token2);
+    ok(ret, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = SetTokenInformation(token2, TokenSessionId, &session, sizeof(session));
+    ok(!ret, "expected failure\n");
+    ok(GetLastError() == ERROR_ACCESS_DENIED, "got error %lu\n", GetLastError());
+    CloseHandle(token2);
+
+    ret = DuplicateTokenEx(token, TOKEN_QUERY | TOKEN_ADJUST_SESSIONID, NULL, SecurityImpersonation, TokenPrimary, &token2);
+    ok(ret, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = SetTokenInformation(token2, TokenSessionId, &session, sizeof(session));
+    ok(!ret, "expected failure\n");
+    ok(GetLastError() == ERROR_ACCESS_DENIED, "got error %lu\n", GetLastError());
+    CloseHandle(token2);
+
+    ret = DuplicateTokenEx(token, TOKEN_QUERY | TOKEN_ADJUST_DEFAULT | TOKEN_ADJUST_SESSIONID | TOKEN_ASSIGN_PRIMARY,
+                           NULL, SecurityImpersonation, TokenPrimary, &token2);
+    ok(ret, "got error %lu\n", GetLastError());
+
+    SetLastError(0xdeadbeef);
+    ret = SetTokenInformation(token2, TokenSessionId, &session, sizeof(session) - 1);
+    ok(!ret, "expected failure\n");
+    ok(GetLastError() == ERROR_BAD_LENGTH, "got error %lu\n", GetLastError());
+
+    /* and the caller needs SeTcbPrivilege, enabled */
+    SetLastError(0xdeadbeef);
+    ret = SetTokenInformation(token2, TokenSessionId, &session, sizeof(session));
+    ok(!ret, "expected failure\n");
+    ok(GetLastError() == ERROR_PRIVILEGE_NOT_HELD, "got error %lu\n", GetLastError());
+
+    /* which only a token that holds it can enable: SYSTEM's on Windows, and every one in Wine */
+    privs.PrivilegeCount = 1;
+    ret = LookupPrivilegeValueA(NULL, "SeTcbPrivilege", &privs.Privileges[0].Luid);
+    ok(ret, "got error %lu\n", GetLastError());
+    privs.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+    ret = AdjustTokenPrivileges(token, FALSE, &privs, sizeof(prev), &prev, &prev_size);
+    ok(ret, "got error %lu\n", GetLastError());
+    if (GetLastError() == ERROR_NOT_ALL_ASSIGNED)
+    {
+        skip("SeTcbPrivilege is not held.\n");
+        CloseHandle(token2);
+        CloseHandle(token);
+        return;
+    }
+
+    session = process_session ? 0 : 1;
+    ret = SetTokenInformation(token2, TokenSessionId, &session, sizeof(session));
+    ok(ret, "got error %lu\n", GetLastError());
+    id = 0xdeadbeef;
+    ret = GetTokenInformation(token2, TokenSessionId, &id, sizeof(id), &size);
+    ok(ret, "got error %lu\n", GetLastError());
+    ok(id == session, "got session %lu, expected %lu\n", id, session);
+    /* not the token it was duplicated from */
+    id = 0xdeadbeef;
+    ret = GetTokenInformation(token, TokenSessionId, &id, sizeof(id), &size);
+    ok(ret, "got error %lu\n", GetLastError());
+    ok(id == process_session, "got session %lu, expected %lu\n", id, process_session);
+
+    ret = AdjustTokenPrivileges(token, FALSE, &prev, 0, NULL, NULL);
+    ok(ret, "got error %lu\n", GetLastError());
+
+    /* a process started with it runs in that session */
+    sprintf(cmdline, "%s security session %lu", myARGV[0], session);
+    ret = CreateProcessAsUserA(token2, NULL, cmdline, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi);
+    ok(ret, "got error %lu\n", GetLastError());
+    if (ret)
+    {
+        ret = ProcessIdToSessionId(pi.dwProcessId, &id);
+        ok(ret, "got error %lu\n", GetLastError());
+        ok(id == session, "got session %lu, expected %lu\n", id, session);
+        wait_child_process(&pi);
+        CloseHandle(pi.hThread);
+    }
+
+    CloseHandle(token2);
+    CloseHandle(token);
+}
+
 START_TEST(security)
 {
     init();
@@ -8748,6 +8870,8 @@ START_TEST(security)
             test_duplicate_handle_access_child();
         else if (!strcmp(myARGV[2], "restricted"))
             test_create_process_token_child();
+        else if (!strcmp(myARGV[2], "session") && myARGC >= 4)
+            test_token_session_child(atoi(myARGV[3]));
         return;
     }
     test_kernel_objects_security();
@@ -8797,6 +8921,7 @@ START_TEST(security)
     test_BuildSecurityDescriptorW();
     test_duplicate_handle_access();
     test_create_process_token();
+    test_token_session_id();
     test_pseudo_handle_security();
     test_duplicate_token();
     test_GetKernelObjectSecurity();
diff --git a/dlls/ntdll/unix/security.c b/dlls/ntdll/unix/security.c
