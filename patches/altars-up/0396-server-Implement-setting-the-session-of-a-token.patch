+/* move a token to another session, which takes SeTcbPrivilege as on Windows: a process created with it runs
+ * in that session */
+DECL_HANDLER(set_token_session)
+{
+    struct token *token;
+
+    if (!(token = (struct token *)get_handle_obj( current->process, req->handle,
+                                                 TOKEN_ADJUST_DEFAULT | TOKEN_ADJUST_SESSIONID, &token_ops )))
+        return;
+
+    if (thread_single_check_privilege( current, SeTcbPrivilege ))
+        token->session_id = req->session_id;
+    else
+        set_error( STATUS_PRIVILEGE_NOT_HELD );
+    release_object( token );
+}
+
 DECL_HANDLER(create_linked_token)
 {
     struct token *token, *linked;
