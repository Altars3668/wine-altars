From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:18 -0400
Subject: [PATCH] loader: The license values Windows 11 has for the product,
 processors, containers and genuine status.

Kernel-ProductInfo as RtlGetProductInfo answers, Kernel-RegisteredProcessors,
Microsoft-Windows-Container-License-Mode 0 and Security-SPP-GenuineLocalStatus 1,
which Word asks for at startup (tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index e23091223da..2cfd1658208 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -1227,6 +1227,11 @@ HKLM,Software\Wow6432Node\Registered Applications,"SymbolicLinkValue",0x60000,"\
 HKLM,Software\Wine\LicenseInformation,"Kernel-MUI-Language-Allowed",,"EMPTY"
 HKLM,Software\Wine\LicenseInformation,"Kernel-MUI-Language-Disallowed",,"EMPTY"
 HKLM,Software\Wine\LicenseInformation,"Kernel-MUI-Number-Allowed",0x10001,1000
+; as Windows 11 has them, the product the one RtlGetProductInfo gives
+HKLM,Software\Wine\LicenseInformation,"Kernel-ProductInfo",0x10001,0x0000001c
+HKLM,Software\Wine\LicenseInformation,"Kernel-RegisteredProcessors",0x10001,4
+HKLM,Software\Wine\LicenseInformation,"Microsoft-Windows-Container-License-Mode",0x10001,0
+HKLM,Software\Wine\LicenseInformation,"Security-SPP-GenuineLocalStatus",0x10001,1
 HKLM,Software\Wine\LicenseInformation,"Shell-InBoxGames-FreeCell-EnableGame",0x10001,0x00000001
 HKLM,Software\Wine\LicenseInformation,"Shell-InBoxGames-Hearts-EnableGame",0x10001,0x00000001
 HKLM,Software\Wine\LicenseInformation,"Shell-InBoxGames-Minesweeper-EnableGame",0x10001,0x00000001
