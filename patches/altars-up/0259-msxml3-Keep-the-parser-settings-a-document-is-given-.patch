     {
         return set_feature_value(reader, feature, value);
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index bc3c1c15f41..a1576e92d43 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -14889,6 +14889,202 @@ static void test_max_element_depth_values(void)
     }
 }
 
+static void test_undeclared_prefix(void)
+{
+    static const char *sources[] =
+    {
+        "<appv:Extensions><appv:Extension/></appv:Extensions>",
+        "<Package appv:PackageId=\"x\"><Identity/></Package>",
+    };
+    static const struct
+    {
+        const GUID *clsid;
+        const char *name;
+    }
+    documents[] =
+    {
+        { &_create(CLSID_DOMDocument30) },
+        { &_create(CLSID_DOMDocument60) },
+    };
+    IXMLDOMParseError *parse_error;
+    IXMLDOMDocument2 *doc;
+    VARIANT_BOOL loaded;
+    unsigned int i, j;
+    LONG code;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(documents); ++i)
+    {
+        doc = _create_object(documents[i].clsid, documents[i].name, &IID_IXMLDOMDocument2, __LINE__);
+
+        for (j = 0; j < ARRAY_SIZE(sources); ++j)
+        {
+            winetest_push_context("%s, %u", documents[i].name, j);
+            loaded = VARIANT_TRUE;
+            hr = IXMLDOMDocument2_loadXML(doc, _bstr_(sources[j]), &loaded);
+            ok(hr == S_FALSE && loaded == VARIANT_FALSE, "Unexpected load %#lx, %d.\n", hr, loaded);
+            hr = IXMLDOMDocument2_get_parseError(doc, &parse_error);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            hr = IXMLDOMParseError_get_errorCode(parse_error, &code);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            ok(code == 0xc00ce01d, "Unexpected error code %#lx.\n", code);
+            IXMLDOMParseError_Release(parse_error);
+            winetest_pop_context();
+        }
+
+        IXMLDOMDocument2_Release(doc);
+    }
+    free_bstrs();
+}
+
+static void check_load_error(IXMLDOMDocument2 *doc, const char *xml, LONG expect, int line)
+{
+    IXMLDOMParseError *error;
+    VARIANT_BOOL b = VARIANT_TRUE;
+    LONG code = 0;
+    HRESULT hr;
+
+    hr = IXMLDOMDocument2_loadXML(doc, _bstr_(xml), &b);
+    ok_(__FILE__, line)(hr == (expect ? S_FALSE : S_OK), "got hr %#lx\n", hr);
+    ok_(__FILE__, line)(b == (expect ? VARIANT_FALSE : VARIANT_TRUE), "got %d\n", b);
+    hr = IXMLDOMDocument2_get_parseError(doc, &error);
+    ok_(__FILE__, line)(hr == S_OK, "got hr %#lx\n", hr);
+    IXMLDOMParseError_get_errorCode(error, &code);
+    ok_(__FILE__, line)(code == expect, "got error %#lx\n", code);
+    IXMLDOMParseError_Release(error);
+}
+
+static void test_parser_properties(void)
+{
+    static const struct
+    {
+        const char *name;
+        VARTYPE vt;
+        LONG value3, value6;    /* HRESULTs where the property is not there */
+    }
+    properties[] =
+    {
+        { "ProhibitDTD", VT_BOOL, VARIANT_FALSE, VARIANT_TRUE },
+        { "MaxElementDepth", VT_I4, 5000, 256 },
+        { "MaxXMLSize", VT_I4, 0, 0 },
+        { "AllowXsltScript", VT_BOOL, VARIANT_TRUE, VARIANT_FALSE },
+        { "AllowDocumentFunction", VT_BOOL, VARIANT_TRUE, VARIANT_FALSE },
+        { "ResolveExternals", VT_BOOL, E_FAIL, VARIANT_FALSE },
+        { "NewParser", VT_BOOL, E_FAIL, VARIANT_FALSE },
+        { "NormalizeAttributeValues", VT_BOOL, E_FAIL, VARIANT_FALSE },
+        { "UseInlineSchema", VT_BOOL, E_FAIL, VARIANT_FALSE },
+    };
+    IXMLDOMDocument2 *doc;
+    unsigned int i;
+    int version;
+    VARIANT var;
+    HRESULT hr;
+
+    for (version = 3; version <= 6; version += 3)
+    {
+        if (!is_clsid_supported(version == 3 ? &CLSID_DOMDocument30 : &CLSID_DOMDocument60, &IID_IXMLDOMDocument2))
+            continue;
+        winetest_push_context("version %d", version);
+        doc = version == 3 ? create_document_version(30, &IID_IXMLDOMDocument2)
+                           : create_document_version(60, &IID_IXMLDOMDocument2);
+        IXMLDOMDocument2_put_async(doc, VARIANT_FALSE);
+
+        for (i = 0; i < ARRAY_SIZE(properties); i++)
+        {
+            LONG expect = version == 3 ? properties[i].value3 : properties[i].value6;
+
+            winetest_push_context("%s", properties[i].name);
+            V_VT(&var) = VT_EMPTY;
+            hr = IXMLDOMDocument2_getProperty(doc, _bstr_(properties[i].name), &var);
+            if (expect == E_FAIL)
+                ok(hr == E_FAIL, "got hr %#lx\n", hr);
+            else
+            {
+                ok(hr == S_OK, "got hr %#lx\n", hr);
+                ok(V_VT(&var) == properties[i].vt, "got vt %d\n", V_VT(&var));
+                ok((properties[i].vt == VT_BOOL ? V_BOOL(&var) : V_I4(&var)) == expect, "got %ld\n",
+                   properties[i].vt == VT_BOOL ? V_BOOL(&var) : V_I4(&var));
+            }
+            winetest_pop_context();
+        }
+
+        /* a document type declaration, where one is prohibited, whether or not it declares anything */
+        V_VT(&var) = VT_I4;
+        V_I4(&var) = 1;
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("ProhibitDTD"), var);
+        ok(hr == S_OK, "got hr %#lx\n", hr);
+        V_VT(&var) = VT_EMPTY;
+        hr = IXMLDOMDocument2_getProperty(doc, _bstr_("ProhibitDTD"), &var);
+        ok(hr == S_OK, "got hr %#lx\n", hr);
+        ok(V_VT(&var) == VT_BOOL && V_BOOL(&var) == VARIANT_TRUE, "got vt %d value %d\n", V_VT(&var), V_BOOL(&var));
+        check_load_error(doc, "<!DOCTYPE a [<!ELEMENT a (#PCDATA)>]><a>x</a>", version == 3 ? 0xc00ce556 : 0xc00ce584,
+                         __LINE__);
+        check_load_error(doc, "<!DOCTYPE a><a>x</a>", version == 3 ? 0xc00ce556 : 0xc00ce584, __LINE__);
+        check_load_error(doc, "<a>x</a>", 0, __LINE__);
+        V_VT(&var) = VT_BOOL;
+        V_BOOL(&var) = VARIANT_FALSE;
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("ProhibitDTD"), var);
+        ok(hr == S_OK, "got hr %#lx\n", hr);
+        check_load_error(doc, "<!DOCTYPE a [<!ELEMENT a (#PCDATA)>]><a>x</a>", 0, __LINE__);
+
+        /* elements nested deeper than allowed */
+        V_VT(&var) = VT_BSTR;
+        V_BSTR(&var) = _bstr_("3");
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("MaxElementDepth"), var);
+        ok(hr == S_OK, "got hr %#lx\n", hr);
+        V_VT(&var) = VT_EMPTY;
+        hr = IXMLDOMDocument2_getProperty(doc, _bstr_("MaxElementDepth"), &var);
+        ok(hr == S_OK, "got hr %#lx\n", hr);
+        ok(V_VT(&var) == VT_I4 && V_I4(&var) == 3, "got vt %d value %ld\n", V_VT(&var), V_I4(&var));
+        check_load_error(doc, "<a><b><c/></b></a>", 0, __LINE__);
+        check_load_error(doc, "<a><b><c><d/></c></b></a>", version == 3 ? E_ABORT : 0xc00ce586, __LINE__);
+        V_VT(&var) = VT_I4;
+        V_I4(&var) = -1;
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("MaxElementDepth"), var);
+        ok(hr == E_INVALIDARG, "got hr %#lx\n", hr);
+        V_I4(&var) = 0;
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("MaxElementDepth"), var);
+        ok(hr == S_OK, "got hr %#lx\n", hr);
+        check_load_error(doc, "<a><b><c><d/></c></b></a>", 0, __LINE__);
+
+        /* MSXML 3 cannot set what it does not answer; last, as NewParser changes the parse errors */
+        for (i = 0; i < ARRAY_SIZE(properties); i++)
+        {
+            if (properties[i].vt != VT_BOOL || !strcmp(properties[i].name, "ProhibitDTD")) continue;
+            winetest_push_context("%s", properties[i].name);
+            V_VT(&var) = VT_BOOL;
+            V_BOOL(&var) = VARIANT_TRUE;
+            hr = IXMLDOMDocument2_setProperty(doc, _bstr_(properties[i].name), var);
+            ok(hr == (version == 3 && properties[i].value3 == E_FAIL ? E_FAIL : S_OK), "got hr %#lx\n", hr);
+            if (hr == S_OK)
+            {
+                V_VT(&var) = VT_EMPTY;
+                hr = IXMLDOMDocument2_getProperty(doc, _bstr_(properties[i].name), &var);
+                ok(hr == S_OK, "got hr %#lx\n", hr);
+                ok(V_VT(&var) == VT_BOOL && V_BOOL(&var) == VARIANT_TRUE, "got vt %d value %d\n",
+                        V_VT(&var), V_BOOL(&var));
+            }
+            winetest_pop_context();
+        }
+        V_VT(&var) = VT_I4;
+        V_I4(&var) = 5;
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("MaxXMLSize"), var);
+        ok(hr == S_OK, "got hr %#lx\n", hr);
+        V_VT(&var) = VT_EMPTY;
+        hr = IXMLDOMDocument2_getProperty(doc, _bstr_("MaxXMLSize"), &var);
+        ok(hr == S_OK, "got hr %#lx\n", hr);
+        ok(V_VT(&var) == VT_I4 && V_I4(&var) == 5, "got vt %d value %ld\n", V_VT(&var), V_I4(&var));
+        V_VT(&var) = VT_I4;
+        V_I4(&var) = -1;
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("MaxXMLSize"), var);
+        ok(hr == E_INVALIDARG, "got hr %#lx\n", hr);
+
+        IXMLDOMDocument2_Release(doc);
+        winetest_pop_context();
+    }
+    free_bstrs();
+}
+
 typedef struct _namespace_as_attribute_t {
     const GUID *guid;
     const char *clsid;
@@ -19334,6 +19530,8 @@ START_TEST(domdoc)
     test_xsltemplate();
     test_xsltext();
     test_max_element_depth_values();
+    test_parser_properties();
+    test_undeclared_prefix();
     test_get_parentNode();
     test_put_text();
     test_removeAttributeNode();
