From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 08:20:35 -0400
Subject: [PATCH] msxml3: Keep the parser settings a document is given, as
 MSXML does.

Word sets these on its documents.  Measured on Windows 11 with
tools/msxmlpropprobe:

- MSXML 3 allows XSLT script and document() by default, MSXML 6
  neither.  MaxXMLSize is 0 for both; setting a negative one is
  E_INVALIDARG.  ResolveExternals, NewParser, NormalizeAttributeValues
  and UseInlineSchema are off in MSXML 6, and MSXML 3 has none of them:
  setting or reading one is E_FAIL.
- A document type declaration where one is prohibited fails the load
  with 0xc00ce556 in MSXML 3 and 0xc00ce584 in MSXML 6.

The settings are handed back as Windows hands them; the ones other than
ProhibitDTD, MaxElementDepth and NormalizeAttributeValues are not acted
on yet, which a FIXME says.

A prefix nobody declared fails the load with 0xc00ce01d in both
versions, on an element as on an attribute.  The test says so because
the older libxml2-based tree kept such prefixes, which Windows does not.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/domdoc.c b/dlls/msxml3/domdoc.c
index 5a78074b815..af765d60ceb 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -1847,15 +1847,35 @@ static HRESULT WINAPI domdoc_setProperty(IXMLDOMDocument3 *iface, BSTR p, VARIAN
             return S_OK;
         }
     }
-    else if (wcsicmp(p, L"NewParser") == 0 ||
-             wcsicmp(p, L"ResolveExternals") == 0 ||
-             wcsicmp(p, L"AllowXsltScript") == 0 ||
-             wcsicmp(p, L"AllowDocumentFunction") == 0 ||
-             wcsicmp(p, L"UseInlineSchema") == 0 ||
-             wcscmp(p, L"MaxXMLSize") == 0)
-    {
-        /* Ignore */
-        FIXME("Ignoring property %s, value %s\n", debugstr_w(p), debugstr_variant(&value));
+    else if (!wcsicmp(p, L"NewParser") || !wcsicmp(p, L"ResolveExternals") ||
+             !wcsicmp(p, L"AllowXsltScript") || !wcsicmp(p, L"AllowDocumentFunction") ||
+             !wcsicmp(p, L"UseInlineSchema"))
+    {
+        bool *flag;
+
+        if (properties->version < MSXML6 && (!wcsicmp(p, L"NewParser") || !wcsicmp(p, L"ResolveExternals") ||
+                !wcsicmp(p, L"UseInlineSchema")))
+            return E_FAIL;
+
+        if (FAILED(hr = variant_get_bool_property(&value, &b))) return hr;
+        if (!wcsicmp(p, L"NewParser")) flag = &properties->new_parser;
+        else if (!wcsicmp(p, L"ResolveExternals")) flag = &properties->resolve_externals;
+        else if (!wcsicmp(p, L"AllowXsltScript")) flag = &properties->allow_xslt_script;
+        else if (!wcsicmp(p, L"AllowDocumentFunction")) flag = &properties->allow_document_function;
+        else flag = &properties->use_inline_schema;
+        *flag = b == VARIANT_TRUE;
+        FIXME("%s is kept, but not enforced.\n", debugstr_w(p));
+        return S_OK;
+    }
+
+    if (!wcscmp(p, L"MaxXMLSize"))
+    {
+        int size;
+
+        if (FAILED(hr = variant_get_int_property(&value, &size))) return hr;
+        if (size < 0) return E_INVALIDARG;
+        properties->max_xml_size = size;
+        if (size) FIXME("MaxXMLSize is kept, but not enforced.\n");
         return S_OK;
     }
 
@@ -1948,13 +1968,33 @@ static HRESULT WINAPI domdoc_getProperty(IXMLDOMDocument3 *iface, BSTR p, VARIAN
         return S_OK;
     }
 
-    if (!wcscmp(p, L"NormalizeAttributeValues"))
+    if (!wcscmp(p, L"MaxXMLSize"))
     {
-        if (properties->version < MSXML6)
+        V_VT(var) = VT_I4;
+        V_I4(var) = properties->max_xml_size;
+        return S_OK;
+    }
+
+    if (!wcsicmp(p, L"AllowXsltScript") || !wcsicmp(p, L"AllowDocumentFunction") ||
+        !wcsicmp(p, L"ResolveExternals") || !wcsicmp(p, L"NewParser") ||
+        !wcsicmp(p, L"UseInlineSchema") || !wcscmp(p, L"NormalizeAttributeValues"))
+    {
+        bool flag;
+
+        if (properties->version < MSXML6 &&
+            (!wcsicmp(p, L"ResolveExternals") || !wcsicmp(p, L"NewParser") ||
+             !wcsicmp(p, L"UseInlineSchema") || !wcscmp(p, L"NormalizeAttributeValues")))
             return E_FAIL;
 
+        if (!wcsicmp(p, L"AllowXsltScript")) flag = properties->allow_xslt_script;
+        else if (!wcsicmp(p, L"AllowDocumentFunction")) flag = properties->allow_document_function;
+        else if (!wcsicmp(p, L"ResolveExternals")) flag = properties->resolve_externals;
+        else if (!wcsicmp(p, L"NewParser")) flag = properties->new_parser;
+        else if (!wcsicmp(p, L"UseInlineSchema")) flag = properties->use_inline_schema;
+        else flag = properties->normalize_attribute_values;
+
         V_VT(var) = VT_BOOL;
-        V_BOOL(var) = properties->normalize_attribute_values ? VARIANT_TRUE : VARIANT_FALSE;
+        V_BOOL(var) = flag ? VARIANT_TRUE : VARIANT_FALSE;
         return S_OK;
     }
 
diff --git a/dlls/msxml3/msxml_private.h b/dlls/msxml3/msxml_private.h
index af40d2bf039..b7348e1ffef 100644
--- a/dlls/msxml3/msxml_private.h
