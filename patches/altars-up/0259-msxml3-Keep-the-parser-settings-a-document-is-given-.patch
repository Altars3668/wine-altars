+    E_DOM_PROHIBIT_DTD = 0xc00ce584,
     E_DOM_MAX_ELEMENT_DEPTH = 0xc00ce586,
 
     E_SAX_PROHIBIT_DTD = 0xc00cee4e,
@@ -215,7 +216,13 @@ struct domdoc_properties
     bool XPath;
     bool prohibit_dtd;
     bool normalize_attribute_values;
+    bool allow_xslt_script;
+    bool allow_document_function;
+    bool resolve_externals;
