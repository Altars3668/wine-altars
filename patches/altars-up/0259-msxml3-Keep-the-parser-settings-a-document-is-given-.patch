     }
 
     if (!(locator->dtd = saxreader_new_dtd(locator)))
@@ -6973,6 +6976,7 @@ static HRESULT WINAPI isaxxmlreader_putFeature(ISAXXMLReader *iface, const WCHAR
          feature == NamespacePrefixes ||
          feature == NormalizeLineBreaks ||
