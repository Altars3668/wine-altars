     IUri *uri;
 };
 
diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index afe771ab909..709f3a7a60f 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -1317,6 +1317,8 @@ struct domdoc_properties *domdoc_create_properties(MSXML_VERSION version)
     properties->XPath = (version == MSXML4 || version == MSXML6);
     properties->prohibit_dtd = version == MSXML6;
     properties->normalize_attribute_values = false;
+    properties->allow_xslt_script = version != MSXML6;
+    properties->allow_document_function = version != MSXML6;
     properties->max_element_depth = version > MSXML3 ? 256 : 5000;
 
     return properties;
@@ -1345,6 +1347,12 @@ static struct domdoc_properties* domdoc_properties_clone(struct domdoc_propertie
         pcopy->validating = properties->validating;
         pcopy->prohibit_dtd = properties->prohibit_dtd;
         pcopy->normalize_attribute_values = properties->normalize_attribute_values;
+        pcopy->allow_xslt_script = properties->allow_xslt_script;
+        pcopy->allow_document_function = properties->allow_document_function;
+        pcopy->resolve_externals = properties->resolve_externals;
+        pcopy->new_parser = properties->new_parser;
+        pcopy->use_inline_schema = properties->use_inline_schema;
+        pcopy->max_xml_size = properties->max_xml_size;
         pcopy->schemaCache = properties->schemaCache;
         if (pcopy->schemaCache)
             IXMLDOMSchemaCollection2_AddRef(pcopy->schemaCache);
@@ -4432,6 +4440,8 @@ static HRESULT parse_context_init(struct parse_context *c, const struct domdoc_p
     V_I4(&v) = 0;
     ISAXXMLReader_putProperty(c->reader, L"max-element-depth", v);
     ISAXXMLReader_putFeature(c->reader, L"prohibit-dtd", properties->prohibit_dtd ? VARIANT_TRUE : VARIANT_FALSE);
+    if (properties->version == MSXML6)
+        ISAXXMLReader_putFeature(c->reader, L"http://winehq.org/sax/features/dom-version6", VARIANT_TRUE);
     ISAXXMLReader_putFeature(c->reader, L"normalize-attribute-values", VARIANT_FALSE);
 
     domnode_create(NODE_DOCUMENT, NULL, 0, NULL, 0, NULL, &c->root);
diff --git a/dlls/msxml3/saxreader.c b/dlls/msxml3/saxreader.c
index d59441af57d..b33b48e5c2e 100644
--- a/dlls/msxml3/saxreader.c
+++ b/dlls/msxml3/saxreader.c
@@ -314,6 +314,7 @@ enum saxreader_feature
     LexicalHandlerParEntities    = 0x00004000,
     NormalizeLineBreaks          = 0x00008000,
     NormalizeAttributeValues     = 0x00010000,
+    DOMVersion6                  = 0x00020000,
     FeatureForceDWord            = 0xffffffff,
 };
 
@@ -325,6 +326,7 @@ struct saxreader_feature_pair
 
 static const struct saxreader_feature_pair saxreader_feature_map[] = {
     { ExhaustiveErrors, L"exhaustive-errors" },
+    { DOMVersion6, L"http://winehq.org/sax/features/dom-version6" },
     { ExternalGeneralEntities, L"http://xml.org/sax/features/external-general-entities" },
     { ExternalParameterEntities, L"http://xml.org/sax/features/external-parameter-entities" },
     { LexicalHandlerParEntities, L"http://xml.org/sax/features/lexical-handler/parameter-entities" },
@@ -6014,7 +6016,8 @@ static void saxreader_parse_doctype(struct saxlocator *locator)
         saxreader_skipspaces(locator);
         locator->line = locator->buffer.position.line;
