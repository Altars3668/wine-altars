From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 06:37:23 -0400
Subject: [PATCH] windows.ui: Read the scrollbar and transparency settings of
 the user.

UISettings.AutoHideScrollBars is the opposite of "Always show
scrollbars" in the Settings app, HKCU\Control Panel\Accessibility
DynamicScrollbars, and AdvancedEffectsEnabled is "Transparency
effects", EnableTransparency under Themes\Personalize.  Both are on
when the value is missing, as on a fresh Windows 11 (build 29671),
where DynamicScrollbars does not exist and the test passes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/windows.ui/tests/uisettings.c b/dlls/windows.ui/tests/uisettings.c
index 9614c179dd3..9dc2a09e8c7 100644
--- a/dlls/windows.ui/tests/uisettings.c
+++ b/dlls/windows.ui/tests/uisettings.c
@@ -276,6 +276,63 @@ static void test_AnimationsEnabled( IUISettings *uisettings )
     ok( enabled == client_area_animation, "Expected %d, got %d.\n", client_area_animation, enabled );
 }
 
+static BOOL set_dynamic_scrollbars( const DWORD *value )
+{
+    HKEY hkey;
+    LSTATUS ret;
+
+    ret = RegCreateKeyExW( HKEY_CURRENT_USER, L"Control Panel\\Accessibility", 0, NULL, 0, KEY_SET_VALUE, NULL, &hkey, NULL );
+    if (ret) return FALSE;
+    if (value) ret = RegSetValueExW( hkey, L"DynamicScrollbars", 0, REG_DWORD, (const BYTE *)value, sizeof(*value) );
+    else ret = RegDeleteValueW( hkey, L"DynamicScrollbars" );
+    RegCloseKey( hkey );
+    return !ret || ret == ERROR_FILE_NOT_FOUND;
+}
+
+static void test_AutoHideScrollBars( IUISettings *uisettings )
+{
+    static const DWORD always_show = 0, auto_hide = 1;
+    DWORD old, type, len = sizeof(old);
+    IUISettings5 *uisettings5;
+    BOOL had_value;
+    boolean value;
+    HRESULT hr;
+    HKEY hkey;
+
+    hr = IUISettings_QueryInterface( uisettings, &IID_IUISettings5, (void **)&uisettings5 );
+    ok( hr == S_OK || broken( hr == E_NOINTERFACE ), "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+
+    had_value = !RegOpenKeyExW( HKEY_CURRENT_USER, L"Control Panel\\Accessibility", 0, KEY_QUERY_VALUE, &hkey );
+    if (had_value)
+    {
+        had_value = !RegQueryValueExW( hkey, L"DynamicScrollbars", NULL, &type, (BYTE *)&old, &len ) && type == REG_DWORD;
+        RegCloseKey( hkey );
+    }
+
+    hr = IUISettings5_get_AutoHideScrollBars( uisettings5, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( value == (had_value ? !!old : TRUE), "got %d.\n", value );
+
+    if (!set_dynamic_scrollbars( &always_show ))
+    {
+        skip( "cannot change the scrollbar setting.\n" );
+        IUISettings5_Release( uisettings5 );
+        return;
+    }
+    hr = IUISettings5_get_AutoHideScrollBars( uisettings5, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( value == FALSE, "got %d.\n", value );
+
+    set_dynamic_scrollbars( &auto_hide );
+    hr = IUISettings5_get_AutoHideScrollBars( uisettings5, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( value == TRUE, "got %d.\n", value );
+
+    set_dynamic_scrollbars( had_value ? &old : NULL );
+    IUISettings5_Release( uisettings5 );
+}
+
 static void test_UISettings(void)
 {
     static const WCHAR *uisettings_name = L"Windows.UI.ViewManagement.UISettings";
@@ -341,6 +398,7 @@ static void test_UISettings(void)
     IUISettings2_Release( uisettings2 );
 
     test_AnimationsEnabled( uisettings );
+    test_AutoHideScrollBars( uisettings );
     test_AccentColor( uisettings3 );
 
     default_theme = get_app_theme();
diff --git a/dlls/windows.ui/uisettings.c b/dlls/windows.ui/uisettings.c
index ce967678c6b..6751922d385 100644
--- a/dlls/windows.ui/uisettings.c
+++ b/dlls/windows.ui/uisettings.c
@@ -315,20 +315,24 @@ static const struct IUISettings2Vtbl uisettings2_vtbl =
 
 DEFINE_IINSPECTABLE( uisettings3, IUISettings3, struct uisettings, IUISettings_iface );
 
-static DWORD get_app_theme(void)
+/* a setting of the user's, as the Settings app keeps it */
+static DWORD get_user_setting( const WCHAR *subkey, const WCHAR *name, DWORD default_value )
 {
-    static const WCHAR *subkey = L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize";
-    static const WCHAR *name = L"AppsUseLightTheme";
-    static const HKEY root = HKEY_CURRENT_USER;
     DWORD ret = 0, len = sizeof(ret), type;
     HKEY hkey;
 
-    if (RegOpenKeyExW( root, subkey, 0, KEY_QUERY_VALUE, &hkey )) return 1;
-    if (RegQueryValueExW( hkey, name, NULL, &type, (BYTE *)&ret, &len ) || type != REG_DWORD) ret = 1;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, subkey, 0, KEY_QUERY_VALUE, &hkey )) return default_value;
+    if (RegQueryValueExW( hkey, name, NULL, &type, (BYTE *)&ret, &len ) || type != REG_DWORD) ret = default_value;
     RegCloseKey( hkey );
     return ret;
 }
 
+static DWORD get_app_theme(void)
+{
+    return get_user_setting( L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                             L"AppsUseLightTheme", 1 );
+}
+
 static DWORD initialize_accent_palette( HKEY hkey, DWORD offset )
 {
     DWORD palette[7] = { 0x00ffd8a6, 0x00edb976, 0x00e39c42, 0x00d77800, 0x009e5a00, 0x00754200, 0x00422600 };
@@ -447,10 +451,13 @@ static const struct IUISettings3Vtbl uisettings3_vtbl =
 
 DEFINE_IINSPECTABLE( uisettings4, IUISettings4, struct uisettings, IUISettings_iface );
 
+/* "Transparency effects" in the Settings app */
 static HRESULT WINAPI uisettings4_get_AdvancedEffectsEnabled( IUISettings4 *iface, boolean *value )
 {
-    FIXME( "iface %p, value %p stub!.\n", iface, value );
-    *value = TRUE;
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    *value = !!get_user_setting( L"Software\\Microsoft\\Windows\\CurrentVersion\\Themes\\Personalize",
+                                 L"EnableTransparency", 1 );
     return S_OK;
 }
 
@@ -484,10 +491,12 @@ static const struct IUISettings4Vtbl uisettings4_vtbl =
 
 DEFINE_IINSPECTABLE( uisettings5, IUISettings5, struct uisettings, IUISettings_iface );
 
+/* the opposite of "Always show scrollbars" in the Settings app */
 static HRESULT WINAPI uisettings5_get_AutoHideScrollBars( IUISettings5 *iface, boolean *value )
 {
-    FIXME( "iface %p, value %p stub!.\n", iface, value );
-    *value = FALSE;
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    *value = !!get_user_setting( L"Control Panel\\Accessibility", L"DynamicScrollbars", 1 );
     return S_OK;
 }
 
