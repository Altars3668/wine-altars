From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 00:34:32 -0400
Subject: [PATCH] kernelbase: Refuse to truncate a file opened without
 GENERIC_WRITE.

CreateFile(TRUNCATE_EXISTING) takes the GENERIC_WRITE bit itself; with GENERIC_READ, no access, or
FILE_WRITE_DATA alone it fails with ERROR_INVALID_PARAMETER.  The three todos of test_CreateFile and
the one of truncating a directory pass.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 393a47ded47..91d7af0b486 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -4736,11 +4736,7 @@ static void test_CreateFile(void)
         hfile = CreateFileA(temp_path, GENERIC_READ, 0, NULL, i, 0, 0);
         ok(hfile == INVALID_HANDLE_VALUE, "CreateFile should fail\n");
         if (i == 0 || i == 5)
-        {
-            /* FIXME: remove once Wine is fixed */
-            todo_wine_if (i == 5)
             ok(GetLastError() == ERROR_INVALID_PARAMETER, "%ld: expected ERROR_INVALID_PARAMETER, got %ld\n", i, GetLastError());
-        }
         else
         {
             /* FIXME: remove once Wine is fixed */
@@ -4791,21 +4787,8 @@ static void test_CreateFile(void)
         }
         else
         {
-            /* FIXME: remove the condition below once Wine is fixed */
-            if (td[i].disposition == TRUNCATE_EXISTING && !(td[i].access & GENERIC_WRITE))
-            {
-                todo_wine
-                {
-                ok(hfile == INVALID_HANDLE_VALUE, "%ld: CreateFile should fail\n", i);
-                ok(GetLastError() == td[i].error, "%ld: expected %ld, got %ld\n", i, td[i].error, GetLastError());
-                }
-                CloseHandle(hfile);
-            }
-            else
-            {
             ok(hfile == INVALID_HANDLE_VALUE, "%ld: CreateFile should fail\n", i);
             ok(GetLastError() == td[i].error, "%ld: expected %ld, got %ld\n", i, td[i].error, GetLastError());
-            }
         }
 
         if (td[i].clean_up) DeleteFileA(file_name);
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index a559bab9681..e21f6909f56 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -848,6 +848,13 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFileW( LPCWSTR filename, DWORD access, DWO
         return INVALID_HANDLE_VALUE;
     }
 
+    /* truncating takes the GENERIC_WRITE bit itself, not the rights it maps to */
+    if (creation == TRUNCATE_EXISTING && !(access & GENERIC_WRITE))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return INVALID_HANDLE_VALUE;
+    }
+
     if (!RtlDosPathNameToNtPathName_U( filename, &nameW, NULL, NULL ))
     {
         SetLastError( ERROR_PATH_NOT_FOUND );
