-static HRESULT sink_writer_encode_sample(struct sink_writer *writer, struct stream *stream, IMFSample *sample)
+static HRESULT sink_writer_process_available_samples(struct sink_writer *writer, struct stream *stream)
 {
-    struct pending_item *item;
+    HRESULT hr = S_OK;
 
-    /* FIXME: call the encoder, queue its output */
+    while (stream->stats.dwNumOutstandingSinkSampleRequests && !list_empty(&stream->queue))
+    {
+        struct pending_item *item = LIST_ENTRY(list_head(&stream->queue), struct pending_item, entry);
+
+        if (!item->sample || FAILED(hr = sink_writer_process_sample(writer, stream))) break;
+    }
+    return hr;
+}
+
+static HRESULT sink_writer_queue_sample(struct stream *stream, IMFSample *sample)
+{
+    struct pending_item *item;
 
     if (!(item = calloc(1, sizeof(*item))))
         return E_OUTOFMEMORY;
 
-    item->sample = sample;
-    IMFSample_AddRef(item->sample);
+    IMFSample_AddRef((item->sample = sample));
     list_add_tail(&stream->queue, &item->entry);
+    return S_OK;
+}
+
+static HRESULT sink_writer_pull_transform(struct sink_writer *writer, struct stream *stream,
+        IMFTransform *transform, IMFTransform *next);
+
+static HRESULT sink_writer_push_transform(struct sink_writer *writer, struct stream *stream,
+        IMFTransform *transform, IMFTransform *next, IMFSample *sample)
+{
+    HRESULT hr;
+
+    do
+    {
+        if (SUCCEEDED(hr = IMFTransform_ProcessInput(transform, 0, sample, 0)))
+            break;
+        if (hr != MF_E_NOTACCEPTING)
+            return hr;
+        if (FAILED(hr = sink_writer_pull_transform(writer, stream, transform, next)))
+            return hr;
+    } while (1);
+
+    hr = sink_writer_pull_transform(writer, stream, transform, next);
+    return hr == MF_E_TRANSFORM_NEED_MORE_INPUT ? S_OK : hr;
+}
+
+static HRESULT sink_writer_update_transform_type(struct stream *stream, IMFTransform *transform, IMFTransform *next)
+{
+    IMFMediaType *current, *type;
+    GUID desired, subtype;
+    DWORD i = 0;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFTransform_GetOutputCurrentType(transform, 0, &current)))
+        return hr;
+    hr = IMFMediaType_GetGUID(current, &MF_MT_SUBTYPE, &desired);
+    IMFMediaType_Release(current);
+    if (FAILED(hr)) return hr;
+
+    while (SUCCEEDED(hr = IMFTransform_GetOutputAvailableType(transform, 0, i++, &type)))
+    {
+        if (SUCCEEDED(IMFMediaType_GetGUID(type, &MF_MT_SUBTYPE, &subtype))
+                && IsEqualGUID(&subtype, &desired)
+                && SUCCEEDED(hr = IMFTransform_SetOutputType(transform, 0, type, 0)))
+        {
+            if (next)
+                hr = IMFTransform_SetInputType(next, 0, type, 0);
+            else
+            {
+                IMFMediaTypeHandler *handler;
+
+                if (SUCCEEDED(hr = IMFStreamSink_GetMediaTypeHandler(stream->stream_sink, &handler)))
+                {
+                    hr = IMFMediaTypeHandler_SetCurrentMediaType(handler, type);
+                    IMFMediaTypeHandler_Release(handler);
+                }
+            }
+            IMFMediaType_Release(type);
+            return hr;
+        }
+        IMFMediaType_Release(type);
+    }
+    return hr;
+}
+
+static HRESULT sink_writer_pull_transform(struct sink_writer *writer, struct stream *stream,
+        IMFTransform *transform, IMFTransform *next)
+{
+    MFT_OUTPUT_STREAM_INFO info;
+    HRESULT hr;
+
+    if (FAILED(hr = IMFTransform_GetOutputStreamInfo(transform, 0, &info)))
+        return hr;
+
+    for (;;)
+    {
+        MFT_OUTPUT_DATA_BUFFER output = {0};
+        IMFMediaBuffer *buffer;
+        BOOL stream_change, have_sample;
+        DWORD status;
+
+        if (!(info.dwFlags & (MFT_OUTPUT_STREAM_PROVIDES_SAMPLES | MFT_OUTPUT_STREAM_CAN_PROVIDE_SAMPLES)))
+        {
+            if (FAILED(hr = MFCreateSample(&output.pSample))) return hr;
+            if (FAILED(hr = MFCreateAlignedMemoryBuffer(info.cbSize, info.cbAlignment, &buffer)))
+            {
+                IMFSample_Release(output.pSample);
+                return hr;
+            }
+            hr = IMFSample_AddBuffer(output.pSample, buffer);
+            IMFMediaBuffer_Release(buffer);
+            if (FAILED(hr))
+            {
+                IMFSample_Release(output.pSample);
+                return hr;
+            }
+        }
+
+        hr = IMFTransform_ProcessOutput(transform, 0, 1, &output, &status);
+        stream_change = hr == MF_E_TRANSFORM_STREAM_CHANGE;
+        have_sample = SUCCEEDED(hr) && !!output.pSample;
+        if (stream_change)
+        {
+            if (SUCCEEDED(hr = sink_writer_update_transform_type(stream, transform, next)))
+                hr = IMFTransform_GetOutputStreamInfo(transform, 0, &info);
+        }
+        else if (SUCCEEDED(hr) && output.pSample)
+        {
+            if (next)
+                hr = sink_writer_push_transform(writer, stream, next, NULL, output.pSample);
+            else
+                hr = sink_writer_queue_sample(stream, output.pSample);
+        }
+
+        if (output.pSample)
+            IMFSample_Release(output.pSample);
+        if (output.pEvents)
+            IMFCollection_Release(output.pEvents);
+
+        if (hr == MF_E_TRANSFORM_NEED_MORE_INPUT || FAILED(hr))
+            return hr;
+        if (!have_sample && !stream_change)
+            return S_OK;
+    }
+}
+
+static HRESULT sink_writer_encode_sample(struct sink_writer *writer, struct stream *stream, IMFSample *sample)
+{
+    if (stream->converter)
+        return sink_writer_push_transform(writer, stream, stream->converter, stream->encoder, sample);
+    if (stream->encoder)
+        return sink_writer_push_transform(writer, stream, stream->encoder, NULL, sample);
+    return sink_writer_queue_sample(stream, sample);
+}
 
+static HRESULT sink_writer_drain_transform(struct sink_writer *writer, struct stream *stream,
+        IMFTransform *transform, IMFTransform *next, BOOL restart)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = IMFTransform_ProcessMessage(transform, MFT_MESSAGE_NOTIFY_END_OF_STREAM, 0))
+            || FAILED(hr = IMFTransform_ProcessMessage(transform, MFT_MESSAGE_COMMAND_DRAIN, 0)))
+        return hr;
+    hr = sink_writer_pull_transform(writer, stream, transform, next);
+    if (hr != MF_E_TRANSFORM_NEED_MORE_INPUT && FAILED(hr)) return hr;
+    if (restart)
+        return IMFTransform_ProcessMessage(transform, MFT_MESSAGE_NOTIFY_START_OF_STREAM, 0);
+    return S_OK;
+}
+
+static HRESULT sink_writer_drain_stream(struct sink_writer *writer, struct stream *stream, BOOL restart)
+{
+    HRESULT hr;
+
+    if (stream->converter && FAILED(hr = sink_writer_drain_transform(writer, stream,
+            stream->converter, stream->encoder, restart)))
+        return hr;
+    if (stream->encoder && FAILED(hr = sink_writer_drain_transform(writer, stream,
+            stream->encoder, NULL, restart)))
+        return hr;
     return S_OK;
 }
 
@@ -747,7 +949,7 @@ static HRESULT sink_writer_write_sample(struct sink_writer *writer, struct strea
     if (FAILED(hr = sink_writer_encode_sample(writer, stream, sample))) return hr;
 
     if (stream->stats.dwNumOutstandingSinkSampleRequests)
-        hr = sink_writer_process_sample(writer, stream);
+        hr = sink_writer_process_available_samples(writer, stream);
 
     return hr;
 }
@@ -900,11 +1102,134 @@ static HRESULT WINAPI sink_writer_Flush(IMFSinkWriterEx *iface, DWORD index)
     return hr;
 }
 
+static HRESULT sink_writer_finalize_streams(struct sink_writer *writer)
+{
+    struct stream *stream;
+    unsigned int i;
+    BOOL pending;
+    HRESULT hr;
+
+    EnterCriticalSection(&writer->cs);
+    for (i = 0; i < writer->streams.count; ++i)
+    {
+        stream = &writer->streams.items[i];
+        if (FAILED(hr = sink_writer_drain_stream(writer, stream, FALSE))
+                || FAILED(hr = sink_writer_process_available_samples(writer, stream)))
+            goto done;
+    }
+    LeaveCriticalSection(&writer->cs);
+
+    for (;;)
+    {
+        EnterCriticalSection(&writer->cs);
+        hr = writer->status;
+        pending = FALSE;
+        if (SUCCEEDED(hr))
+        {
+            for (i = 0; i < writer->streams.count; ++i)
+            {
+                stream = &writer->streams.items[i];
+                if (!list_empty(&stream->queue) || !stream->stats.dwNumOutstandingSinkSampleRequests)
+                {
+                    pending = TRUE;
+                    break;
+                }
+            }
+        }
+        LeaveCriticalSection(&writer->cs);
+        if (FAILED(hr) || !pending) break;
+        WaitForSingleObject(writer->queue_event, INFINITE);
+    }
+    if (FAILED(hr)) return hr;
+
+    for (i = 0; i < writer->streams.count; ++i)
+    {
+        stream = &writer->streams.items[i];
+        if (FAILED(hr = sink_writer_place_marker(writer, stream, MFSTREAMSINK_MARKER_ENDOFSEGMENT, 0, NULL)))
+            return hr;
+    }
+    return S_OK;
+
+done:
+    writer->status = hr;
+    LeaveCriticalSection(&writer->cs);
+    return hr;
+}
+
+static HRESULT sink_writer_do_finalize(struct sink_writer *writer)
+{
+    IMFFinalizableMediaSink *finalizable;
+    HRESULT hr, cleanup_hr;
+
+    hr = sink_writer_finalize_streams(writer);
+    if (SUCCEEDED(hr) && SUCCEEDED(cleanup_hr = IMFMediaSink_QueryInterface(writer->sink,
+            &IID_IMFFinalizableMediaSink, (void **)&finalizable)))
+    {
+        ResetEvent(writer->finalize_event);
+        if (SUCCEEDED(hr = IMFFinalizableMediaSink_BeginFinalize(finalizable, &writer->finalize_callback, NULL)))
+        {
+            WaitForSingleObject(writer->finalize_event, INFINITE);
+            hr = writer->finalize_status;
+        }
+        IMFFinalizableMediaSink_Release(finalizable);
+    }
+    else if (SUCCEEDED(hr) && cleanup_hr != E_NOINTERFACE)
+        hr = cleanup_hr;
+
+    if (writer->clock)
+        IMFPresentationClock_Stop(writer->clock);
+    EnterCriticalSection(&writer->cs);
+    writer->state = SINK_WRITER_STATE_FINALIZED;
+    LeaveCriticalSection(&writer->cs);
+    cleanup_hr = IMFMediaSink_Shutdown(writer->sink);
+    if (SUCCEEDED(hr)) hr = cleanup_hr;
+    return hr;
+}
+
+static DWORD WINAPI sink_writer_finalize_thread(void *context)
+{
+    struct sink_writer *writer = context;
+    HRESULT hr = sink_writer_do_finalize(writer);
+
+    IMFSinkWriterCallback_OnFinalize(writer->callback, hr);
+    IMFSinkWriterEx_Release(&writer->IMFSinkWriterEx_iface);
+    return 0;
+}
+
 static HRESULT WINAPI sink_writer_Finalize(IMFSinkWriterEx *iface)
 {
-    FIXME("%p.\n", iface);
+    struct sink_writer *writer = impl_from_IMFSinkWriterEx(iface);
+    HRESULT hr = S_OK;
 
-    return E_NOTIMPL;
+    TRACE("%p.\n", iface);
+
+    EnterCriticalSection(&writer->cs);
+    if (writer->state != SINK_WRITER_STATE_WRITING)
+        hr = MF_E_INVALIDREQUEST;
+    else
+        writer->state = SINK_WRITER_STATE_FINALIZING;
+    LeaveCriticalSection(&writer->cs);
+    if (hr == MF_E_INVALIDREQUEST) return hr;
+
+    if (writer->callback)
+    {
+        HANDLE thread;
+
+        IMFSinkWriterEx_AddRef(iface);
+        if ((thread = CreateThread(NULL, 0, sink_writer_finalize_thread, writer, 0, NULL)))
+        {
+            CloseHandle(thread);
+            return S_OK;
+        }
+        hr = HRESULT_FROM_WIN32(GetLastError());
+        IMFSinkWriterEx_Release(iface);
+        EnterCriticalSection(&writer->cs);
+        writer->state = SINK_WRITER_STATE_WRITING;
+        LeaveCriticalSection(&writer->cs);
+        return hr;
+    }
+
+    return sink_writer_do_finalize(writer);
 }
 
 static HRESULT sink_writer_get_service(void *object, REFGUID service, REFIID riid, void **ret)
@@ -935,12 +1260,17 @@ static HRESULT WINAPI sink_writer_GetServiceForStream(IMFSinkWriterEx *iface, DW
 
     TRACE("%p, %lu, %s, %s, %p.\n", iface, index, debugstr_guid(service), debugstr_guid(riid), object);
 
+    if (!object) return E_POINTER;
+    *object = NULL;
     EnterCriticalSection(&writer->cs);
 
-    if (index == MF_SINK_WRITER_MEDIASINK)
+    if (index == MF_SINK_WRITER_MEDIASINK && writer->state == SINK_WRITER_STATE_INITIAL)
+        hr = MF_E_UNSUPPORTED_SERVICE;
+    else if (index == MF_SINK_WRITER_MEDIASINK)
         hr = sink_writer_get_service(writer->sink, service, riid, object);
     else if ((stream = sink_writer_get_stream(writer, index)))
     {
+        hr = MF_E_UNSUPPORTED_SERVICE;
         if (stream->encoder)
             hr = sink_writer_get_service(stream->encoder, service, riid, object);
         else if (stream->converter)
@@ -948,6 +1278,8 @@ static HRESULT WINAPI sink_writer_GetServiceForStream(IMFSinkWriterEx *iface, DW
 
         if (FAILED(hr))
             hr = sink_writer_get_service(stream->stream_sink, service, riid, object);
+        if (hr == E_NOINTERFACE)
+            hr = MF_E_UNSUPPORTED_SERVICE;
     }
     else
         hr = MF_E_INVALIDSTREAMNUMBER;
@@ -1088,6 +1420,43 @@ static HRESULT WINAPI sink_writer_callback_GetParameters(IMFAsyncCallback *iface
     return E_NOTIMPL;
 }
 
+static ULONG WINAPI sink_writer_finalize_callback_AddRef(IMFAsyncCallback *iface)
+{
+    struct sink_writer *writer = impl_from_finalize_callback_IMFAsyncCallback(iface);
+    return IMFSinkWriterEx_AddRef(&writer->IMFSinkWriterEx_iface);
+}
+
+static ULONG WINAPI sink_writer_finalize_callback_Release(IMFAsyncCallback *iface)
+{
+    struct sink_writer *writer = impl_from_finalize_callback_IMFAsyncCallback(iface);
+    return IMFSinkWriterEx_Release(&writer->IMFSinkWriterEx_iface);
+}
+
+static HRESULT WINAPI sink_writer_finalize_callback_Invoke(IMFAsyncCallback *iface, IMFAsyncResult *result)
+{
+    struct sink_writer *writer = impl_from_finalize_callback_IMFAsyncCallback(iface);
+    IMFFinalizableMediaSink *sink;
+    HRESULT hr;
+
+    if (SUCCEEDED(hr = IMFMediaSink_QueryInterface(writer->sink, &IID_IMFFinalizableMediaSink, (void **)&sink)))
+    {
+        hr = IMFFinalizableMediaSink_EndFinalize(sink, result);
+        IMFFinalizableMediaSink_Release(sink);
+    }
+    writer->finalize_status = hr;
+    SetEvent(writer->finalize_event);
+    return S_OK;
+}
+
+static const IMFAsyncCallbackVtbl sink_writer_finalize_callback_vtbl =
+{
+    sink_writer_callback_QueryInterface,
+    sink_writer_finalize_callback_AddRef,
+    sink_writer_finalize_callback_Release,
+    sink_writer_callback_GetParameters,
+    sink_writer_finalize_callback_Invoke,
+};
+
 static struct stream *sink_writer_get_stream_for_stream_sink(struct sink_writer *writer,
         IMFStreamSink *stream_sink, DWORD *index)
 {
