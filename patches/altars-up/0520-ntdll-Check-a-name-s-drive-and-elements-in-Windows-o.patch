+/* nothing after a drive that is not there is looked at */
+static void test_nt_names_missing_drive(void)
+{
+    static const WCHAR *const names[] =
+    {
+        L"\\??\\%c:\\windows\\system32\\kernel32.dll", L"\\??\\%c:\\windows:x\\kernel32.dll",
+        L"\\??\\%c:\\windows\\\\kernel32.dll", L"\\??\\%c:\\.\\kernel32.dll", L"\\??\\%c:\\windows\\..\\kernel32.dll",
+        L"\\??\\%c:\\sys*\\kernel32.dll", L"\\??\\%c:\\sys*",
+    };
+    WCHAR drive[3] = L"Q:", target[MAX_PATH], path[MAX_PATH];
+    DWORD drives = GetLogicalDrives();
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING nameW;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    HANDLE handle;
+    unsigned int i;
+
+    for (; drive[0] <= 'Y'; drive[0]++)
+        if (!(drives & (1 << (drive[0] - 'A'))) && !QueryDosDeviceW( drive, target, ARRAY_SIZE(target) )) break;
+    if (drive[0] > 'Y')
+    {
+        skip( "no drive letter is free\n" );
+        return;
+    }
+
+    InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, 0, NULL );
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        swprintf( path, ARRAY_SIZE(path), names[i], drive[0] );
+        RtlInitUnicodeString( &nameW, path );
+        status = pNtOpenFile( &handle, FILE_GENERIC_READ, &attr, &io, FILE_SHARE_READ,
+                              FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE );
+        ok( status == STATUS_OBJECT_PATH_NOT_FOUND, "got %lx for %s\n", status, debugstr_w(path) );
+        if (!status) NtClose( handle );
+    }
+
+    swprintf( path, ARRAY_SIZE(path), L"\\??\\%c:", drive[0] );
+    RtlInitUnicodeString( &nameW, path );
+    status = pNtOpenFile( &handle, FILE_GENERIC_READ, &attr, &io, FILE_SHARE_READ, FILE_SYNCHRONOUS_IO_NONALERT );
+    ok( status == STATUS_OBJECT_NAME_NOT_FOUND, "got %lx for %s\n", status, debugstr_w(path) );
+    if (!status) NtClose( handle );
+
+    /* "::" is a drive letter too */
+    RtlInitUnicodeString( &nameW, L"\\??\\::\\C:\\windows\\system32\\kernel32.dll" );
+    status = pNtOpenFile( &handle, FILE_GENERIC_READ, &attr, &io, FILE_SHARE_READ,
+                          FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE );
+    ok( status == STATUS_OBJECT_PATH_NOT_FOUND, "got %lx\n", status );
+    if (!status) NtClose( handle );
+}
+
 static void test_RtlSetCurrentDirectory_U(void)
 {
     CURDIR *cd = &NtCurrentTeb()->Peb->ProcessParameters->CurrentDirectory;
@@ -837,4 +896,5 @@ START_TEST(path)
     test_RtlGetFullPathName_U();
     test_RtlDosPathNameToNtPathName_U();
     test_nt_names();
+    test_nt_names_missing_drive();
 }
