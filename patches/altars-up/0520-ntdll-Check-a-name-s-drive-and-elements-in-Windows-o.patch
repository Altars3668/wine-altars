@@ -7479,6 +7479,36 @@ static void test_stream_names(void)
        GetLastError());
     if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
 
+    /* "::x" is "x" on the drive ":", which is not there; ":x" is relative, with a colon on the way */
+    GetWindowsDirectoryW(windir, ARRAY_SIZE(windir));
+    swprintf(name, ARRAY_SIZE(name), L"::%s\\win.ini", windir);
+    SetLastError(0xdeadbeef);
+    file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ok(file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_PATH_NOT_FOUND, "got %p, error %lu\n", file,
+       GetLastError());
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+
+    swprintf(name, ARRAY_SIZE(name), L":%s\\win.ini", windir);
+    SetLastError(0xdeadbeef);
+    file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    ok(file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_INVALID_NAME, "got %p, error %lu\n", file,
+       GetLastError());
+    if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+
+    /* nothing after a drive that is not there is looked at */
+    drives = GetLogicalDrives();
+    for (drive[0] = 'Q'; drive[0] <= 'Y'; drive[0]++)
+        if (!(drives & (1 << (drive[0] - 'A'))) && !QueryDosDeviceW(drive, name, ARRAY_SIZE(name))) break;
+    if (drive[0] <= 'Y')
+    {
+        swprintf(name, ARRAY_SIZE(name), L"%c:\\windows:x\\win.ini", drive[0]);
+        SetLastError(0xdeadbeef);
+        file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+        ok(file == INVALID_HANDLE_VALUE && GetLastError() == ERROR_PATH_NOT_FOUND, "got %p, error %lu\n", file,
+           GetLastError());
+        if (file != INVALID_HANDLE_VALUE) CloseHandle(file);
+    }
+
     DeleteFileW(path);
 }
 
