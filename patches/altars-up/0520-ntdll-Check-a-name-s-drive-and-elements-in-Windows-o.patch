+    /* check syntax of individual components: an empty one, or a stream on the way, fails at once;
+     * the first other invalid one only when the lookup gets to it, as a missing directory comes first */
 
     for (ptr = name, end = name + name_len; ptr < end; ptr++)
     {
+        const WCHAR *element = ptr;
         BOOL stream = FALSE;
 
         if (*ptr == '\\') return STATUS_OBJECT_NAME_INVALID;  /* duplicate backslash */
-        if (*ptr == '.')
+        if (*ptr == '.' && (ptr + 1 == end || ptr[1] == '\\' ||  /* "." element */
+                            (ptr[1] == '.' && (ptr + 2 == end || ptr[2] == '\\'))))  /* ".." element */
         {
-            if (ptr + 1 == end) return STATUS_OBJECT_NAME_INVALID;  /* "." element */
-            if (ptr[1] == '\\') return STATUS_OBJECT_NAME_INVALID;  /* "." element */
-            if (ptr[1] == '.')
-            {
-                if (ptr + 2 == end) return STATUS_OBJECT_NAME_INVALID;  /* ".." element */
-                if (ptr[2] == '\\') return STATUS_OBJECT_NAME_INVALID;  /* ".." element */
-            }
+            if (is_unix) return STATUS_OBJECT_NAME_INVALID;
+            if (!invalid) invalid = element;
         }
         /* check for invalid characters (all chars except 0 are valid for unix) */
         for ( ; ptr < end && *ptr != '\\'; ptr++)
         {
             if (!*ptr) return STATUS_OBJECT_NAME_INVALID;
             if (is_unix) continue;
-            if (*ptr < 32 || wcschr( invalid_charsW, *ptr )) return STATUS_OBJECT_NAME_INVALID;
+            if ((*ptr < 32 || wcschr( invalid_charsW, *ptr )) && !invalid) invalid = element;
             if (*ptr == ':') stream = TRUE;
         }
         /* a stream belongs to the last element, and "name::$DATA" is the file itself */
@@ -4065,7 +4063,7 @@ static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_
 
     unix_name[pos] = '/';
     ret = ntdll_wcstoumbs( name, name_len, unix_name + pos + 1, unix_len - pos - 1, TRUE );
-    if (ret >= 0 && ret < unix_len - pos - 1)
+    if (!invalid && ret >= 0 && ret < unix_len - pos - 1)
     {
         char *p;
         unix_name[pos + 1 + ret] = 0;
@@ -4095,6 +4093,13 @@ static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_
         if (next < name + name_len) next++;
         name_len -= next - name;
 
+        if (name == invalid)
+        {
+            /* "." names nothing on the way down; the others are not names at all */
+            if (name_len && end - name == 1 && name[0] == '.') return STATUS_OBJECT_PATH_NOT_FOUND;
+            return STATUS_OBJECT_NAME_INVALID;
+        }
+
         /* grow the buffer if needed */
 
         if (unix_len - pos < MAX_DIR_ENTRY_LEN + 3)
@@ -4179,6 +4184,25 @@ static NTSTATUS lookup_unix_name( int root_fd, OBJECT_ATTRIBUTES *attr, UNICODE_
 }
 
 
+/* whether the DOS drive "x:" is defined; the lookup does not check it for names it finds */
+static BOOL dos_drive_exists( const WCHAR *drive )
+{
+    struct stat st;
+    char *path;
+    int len, ret;
+
+    if (!(path = malloc( strlen( config_dir ) + sizeof("/dosdevices/") + 2 * 3 ))) return TRUE;
+    strcpy( path, config_dir );
+    strcat( path, "/dosdevices/" );
+    len = strlen( path );
+    ret = ntdll_wcstoumbs( drive, 2, path + len, 2 * 3, TRUE );
+    path[len + max( ret, 0 )] = 0;
+    ret = ret > 0 && (lstat( path, &st ) != -1 || errno != ENOENT);
+    free( path );
+    return ret;
+}
+
+
 /******************************************************************************
  *           nt_to_unix_file_name_no_root
  */
@@ -4196,7 +4220,7 @@ static NTSTATUS nt_to_unix_file_name_no_root( OBJECT_ATTRIBUTES *attr, UNICODE_S
     char *unix_name;
     int pos, ret, name_len, unix_len, prefix_len;
     WCHAR prefix[MAX_DIR_ENTRY_LEN + 1];
-    BOOLEAN is_unix = FALSE;
+    BOOLEAN is_unix = FALSE, drive;
 
     name     = attr->ObjectName->Buffer;
     name_len = attr->ObjectName->Length / sizeof(WCHAR);
@@ -4260,7 +4284,7 @@ static NTSTATUS nt_to_unix_file_name_no_root( OBJECT_ATTRIBUTES *attr, UNICODE_S
         return STATUS_OBJECT_PATH_NOT_FOUND;
     }
 
-    if (prefix_len != 2 || prefix[1] != ':')
+    if (!(drive = prefix_len == 2 && prefix[1] == ':'))
     {
         unix_name[pos] = 0;
         if (lstat( unix_name, &st ) == -1 && errno == ENOENT)
@@ -4280,6 +4304,9 @@ static NTSTATUS nt_to_unix_file_name_no_root( OBJECT_ATTRIBUTES *attr, UNICODE_S
 
     status = lookup_unix_name( AT_FDCWD, attr, nt_name, nt_pos, &unix_name, unix_len,
                                pos, disposition, open_reparse, is_unix, reparse_count );
+    /* nothing after a drive that does not exist is looked at */
+    if (drive && status != STATUS_SUCCESS && !dos_drive_exists( prefix ))
+        status = STATUS_OBJECT_PATH_NOT_FOUND;
     if (status == STATUS_SUCCESS || status == STATUS_NO_SUCH_FILE)
     {
         *unix_name_ret = unix_name;
