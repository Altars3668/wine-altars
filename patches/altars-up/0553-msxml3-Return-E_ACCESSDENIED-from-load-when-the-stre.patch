From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 10:35:08 -0400
Subject: [PATCH] msxml3: Return E_ACCESSDENIED from load() when the stream
 denies access.

A stream whose Read fails leaves an empty document and its failure as
parseError's code, and load() answers S_FALSE: so on Windows for E_FAIL,
STG_E_ACCESSDENIED, E_OUTOFMEMORY, E_ABORT and E_INVALIDARG, in MSXML 3.0
and 6.0 alike (tools/msxmlmoreprobe in the wine-altars repository).
E_ACCESSDENIED is the exception, which load() returns as it is.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/domdoc.c b/dlls/msxml3/domdoc.c
index a2478bec9ee..393512bc63b 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -1393,7 +1393,9 @@ static HRESULT WINAPI domdoc_load(IXMLDOMDocument3 *iface, VARIANT source, VARIA
                 *result = VARIANT_TRUE;
                 return hr;
             }
-            /* what failed leaves an empty document, and the error to parseError */
+            /* what failed leaves an empty document, and the error to parseError; a stream that
+             * denies access is the one failure load() returns as it is, as on Windows */
+            if (hr == E_ACCESSDENIED) return hr;
             break;
         }
         else if (IUnknown_QueryInterface(V_UNKNOWN(&source), &IID_IPersistStream, (void **)&unk) == S_OK)
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index f77e488d80d..a5d63193f43 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -20172,6 +20172,47 @@ static void test_parse_error_source(void)
     }
 }
 
+/* a stream that fails: its failure is the error, and load() answers S_FALSE, except for
+ * E_ACCESSDENIED, which it returns */
+static void test_load_failing_stream(void)
+{
+    static const HRESULT failures[] = { E_FAIL, STG_E_ACCESSDENIED, E_OUTOFMEMORY, E_ABORT, E_INVALIDARG, E_ACCESSDENIED };
+    static const struct
+    {
+        const GUID *clsid;
+        const char *name;
+    }
+    documents[] =
+    {
+        { &_create(CLSID_DOMDocument30) },
+        { &_create(CLSID_DOMDocument60) },
+    };
+    struct read_stream stream = { { &read_stream_vtbl } };
+    IXMLDOMDocument2 *doc;
+    VARIANT_BOOL loaded;
+    unsigned int i, j;
+    HRESULT hr;
+    VARIANT v;
+
+    for (i = 0; i < ARRAY_SIZE(documents); i++)
+    for (j = 0; j < ARRAY_SIZE(failures); j++)
+    {
+        winetest_push_context("%s, %#lx", documents[i].name, failures[j]);
+        doc = _create_object(documents[i].clsid, documents[i].name, &IID_IXMLDOMDocument2, __LINE__);
+        stream.result = failures[j];
+        stream.given = FALSE;
+        V_VT(&v) = VT_UNKNOWN;
+        V_UNKNOWN(&v) = (IUnknown *)&stream.IStream_iface;
+        loaded = VARIANT_TRUE;
+        hr = IXMLDOMDocument2_load(doc, v, &loaded);
+        ok(hr == (failures[j] == E_ACCESSDENIED ? E_ACCESSDENIED : S_FALSE), "Unexpected hr %#lx.\n", hr);
+        ok(loaded == VARIANT_FALSE, "Unexpected result %d.\n", loaded);
+        check_parse_error_code((IXMLDOMDocument *)doc, failures[j]);
+        IXMLDOMDocument2_Release(doc);
+        winetest_pop_context();
+    }
+}
+
 START_TEST(domdoc)
 {
     HRESULT hr;
@@ -20309,6 +20350,7 @@ START_TEST(domdoc)
     test_document_stream();
     test_load_from_document_stream();
     test_parse_error_source();
+    test_load_failing_stream();
 
     if (is_clsid_supported(&CLSID_MXNamespaceManager40, &IID_IMXNamespaceManager))
     {
