+static void test_effective_power_mode(void)
+{
+    void *handle, *handle2;
+    HRESULT hr;
+    ULONG version;
+    DWORD ret;
+
+    if (!pPowerRegisterForEffectivePowerModeNotifications)
+    {
+        win_skip( "PowerRegisterForEffectivePowerModeNotifications is not available\n" );
+        return;
+    }
+
+    /* the current mode is told soon after, from another thread */
+    for (version = 0; version <= EFFECTIVE_POWER_MODE_V2; version++)
+    {
+        winetest_push_context( "version %lu", version );
+        memset( &called, 0, sizeof(called) );
+        handle = (void *)0xdeadbeef;
+        hr = pPowerRegisterForEffectivePowerModeNotifications( version, mode_callback, (void *)0x5678, &handle );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( handle && handle != (void *)0xdeadbeef, "got %p\n", handle );
+        ret = WaitForSingleObject( called_event, 5000 );
+        ok( !ret, "not called\n" );
+        ok( called.count == 1, "called %ld times\n", called.count );
+        ok( called.other_thread, "called on the thread that registered\n" );
+        ok( called.context == (void *)0x5678, "got context %p\n", called.context );
+        ok( called.mode >= EffectivePowerModeBatterySaver && called.mode <= EffectivePowerModeMixedReality,
+            "got mode %d\n", called.mode );
+        hr = pPowerUnregisterFromEffectivePowerModeNotifications( handle );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        winetest_pop_context();
+    }
+
+    handle = (void *)0xdeadbeef;
+    hr = pPowerRegisterForEffectivePowerModeNotifications( 3, mode_callback, NULL, &handle );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( handle == (void *)0xdeadbeef, "got %p\n", handle );
+    hr = pPowerRegisterForEffectivePowerModeNotifications( EFFECTIVE_POWER_MODE_V1, NULL, NULL, &handle );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( handle == (void *)0xdeadbeef, "got %p\n", handle );
+
+    memset( &called, 0, sizeof(called) );
+    hr = pPowerRegisterForEffectivePowerModeNotifications( EFFECTIVE_POWER_MODE_V1, mode_callback, NULL, &handle );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = pPowerRegisterForEffectivePowerModeNotifications( EFFECTIVE_POWER_MODE_V1, mode_callback, NULL, &handle2 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( handle != handle2, "got the same handle\n" );
+    while (called.count < 2 && !WaitForSingleObject( called_event, 5000 ));
+    ok( called.count == 2, "called %ld times\n", called.count );
+    hr = pPowerUnregisterFromEffectivePowerModeNotifications( handle );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = pPowerUnregisterFromEffectivePowerModeNotifications( handle2 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = pPowerUnregisterFromEffectivePowerModeNotifications( NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+}
