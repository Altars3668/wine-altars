+static HRESULT (WINAPI *pPowerRegisterForEffectivePowerModeNotifications)(ULONG, EFFECTIVE_POWER_MODE_CALLBACK *,
+                                                                           void *, void **);
+static HRESULT (WINAPI *pPowerUnregisterFromEffectivePowerModeNotifications)(void *);
+
+static const GUID unknown = {0x12345678, 0x1234, 0x1234, {1, 2, 3, 4, 5, 6, 7, 8}};
