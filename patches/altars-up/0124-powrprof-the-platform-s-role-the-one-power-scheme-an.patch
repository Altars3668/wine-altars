+START_TEST(powrprof)
+{
+    HMODULE module = GetModuleHandleA( "powrprof.dll" );
+
+    pPowerDeterminePlatformRoleEx = (void *)GetProcAddress( module, "PowerDeterminePlatformRoleEx" );
+    pPowerRegisterForEffectivePowerModeNotifications =
+        (void *)GetProcAddress( module, "PowerRegisterForEffectivePowerModeNotifications" );
+    pPowerUnregisterFromEffectivePowerModeNotifications =
+        (void *)GetProcAddress( module, "PowerUnregisterFromEffectivePowerModeNotifications" );
+
+    main_thread = GetCurrentThreadId();
+    called_event = CreateEventW( NULL, FALSE, FALSE, NULL );
+
+    test_platform_role();
+    test_schemes();
+    test_setting_notification();
+    test_suspend_resume_notification();
+    test_effective_power_mode();
+
+    CloseHandle( called_event );
+}
