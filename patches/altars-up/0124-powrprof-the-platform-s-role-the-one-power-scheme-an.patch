+        return;
+    }
+    role2 = pPowerDeterminePlatformRoleEx( POWER_PLATFORM_ROLE_V1 );
+    ok( role2 == role, "got %d, %d\n", role2, role );
+    role = pPowerDeterminePlatformRoleEx( POWER_PLATFORM_ROLE_V2 );
+    ok( role > PlatformRoleUnspecified && role < PlatformRoleMaximum, "got %d\n", role );
+    /* a slate is a mobile computer to the first version */
+    ok( role == role2 || (role == PlatformRoleSlate && role2 == PlatformRoleMobile), "got %d, %d\n", role, role2 );
+    role2 = pPowerDeterminePlatformRoleEx( 3 );
+    ok( role2 == role, "got %d, %d\n", role2, role );
+}
