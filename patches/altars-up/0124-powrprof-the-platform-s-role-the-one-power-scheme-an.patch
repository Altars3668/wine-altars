+static void test_schemes(void)
+{
+    WCHAR name[256];
+    GUID *active, scheme;
+    DWORD ret, size, size2;
+    ULONG i;
+
+    active = (GUID *)0xdeadbeef;
+    ret = PowerGetActiveScheme( NULL, &active );
+    ok( !ret, "got %lu\n", ret );
+
+    for (i = 0; ; i++)
+    {
+        size = sizeof(scheme);
+        ret = PowerEnumerate( NULL, NULL, NULL, ACCESS_SCHEME, i, (UCHAR *)&scheme, &size );
+        if (ret) break;
+        ok( size == sizeof(scheme), "got size %lu\n", size );
+        if (IsEqualGUID( &scheme, active )) break;
+    }
+    ok( !ret, "the active scheme %s is not one there is, got %lu\n", debugstr_guid( active ), ret );
+    for (i = 0; ; i++)
+    {
+        size = sizeof(scheme);
+        if ((ret = PowerEnumerate( NULL, NULL, NULL, ACCESS_SCHEME, i, (UCHAR *)&scheme, &size ))) break;
+    }
+    ok( ret == ERROR_NO_MORE_ITEMS, "got %lu\n", ret );
+    ok( i, "no schemes\n" );
+
+    size = 0xdead;
+    ret = PowerEnumerate( NULL, NULL, NULL, ACCESS_SCHEME, 0, NULL, &size );
+    ok( ret == ERROR_MORE_DATA, "got %lu\n", ret );
+    ok( size == sizeof(GUID), "got size %lu\n", size );
+    size = 4;
+    ret = PowerEnumerate( NULL, NULL, NULL, ACCESS_SCHEME, 0, (UCHAR *)&scheme, &size );
+    ok( ret == ERROR_MORE_DATA, "got %lu\n", ret );
+    ok( size == sizeof(GUID), "got size %lu\n", size );
+
+    /* the size asked for without a buffer may be that of the name as it is stored, not of the name */
+    size = 0xdead;
+    ret = PowerReadFriendlyName( NULL, active, NULL, NULL, NULL, &size );
+    ok( !ret, "got %lu\n", ret );
+    ok( size > sizeof(WCHAR) && size <= sizeof(name), "got size %lu\n", size );
+    memset( name, 0xcc, sizeof(name) );
+    size2 = sizeof(name);
+    ret = PowerReadFriendlyName( NULL, active, NULL, NULL, (UCHAR *)name, &size2 );
+    ok( !ret, "got %lu\n", ret );
+    ok( size2 == (wcslen( name ) + 1) * sizeof(WCHAR), "got size %lu for %s\n", size2, debugstr_w( name ));
+    ok( size2 <= size, "got size %lu, %lu\n", size2, size );
+    ok( name[0], "got an empty name\n" );
+    size = 2;
+    ret = PowerReadFriendlyName( NULL, active, NULL, NULL, (UCHAR *)name, &size );
+    ok( ret == ERROR_MORE_DATA, "got %lu\n", ret );
+    ok( size == size2, "got size %lu, %lu\n", size, size2 );
+
+    size = sizeof(name);
+    ret = PowerReadFriendlyName( NULL, &null_guid, NULL, NULL, (UCHAR *)name, &size );
+    ok( ret == ERROR_FILE_NOT_FOUND, "got %lu\n", ret );
+    ok( size == sizeof(name), "got size %lu\n", size );
+    ret = PowerReadFriendlyName( NULL, &unknown, NULL, NULL, (UCHAR *)name, &size );
+    ok( ret == ERROR_FILE_NOT_FOUND, "got %lu\n", ret );
+
+    LocalFree( active );
+}
