+static DWORD main_thread;
+static HANDLE called_event;
+static struct
+{
+    LONG count;
+    BOOL other_thread;
+    void *context;
+    ULONG type;
+    GUID setting;
+    DWORD size;
+    int mode;
+} called;
+
+static ULONG CALLBACK notify_callback( void *context, ULONG type, void *setting )
+{
+    called.context = context;
+    called.type = type;
+    called.other_thread = GetCurrentThreadId() != main_thread;
+    if (type == PBT_POWERSETTINGCHANGE)
+    {
+        called.setting = ((POWERBROADCAST_SETTING *)setting)->PowerSetting;
+        called.size = ((POWERBROADCAST_SETTING *)setting)->DataLength;
+    }
+    InterlockedIncrement( &called.count );
+    SetEvent( called_event );
+    return 0;
+}
+
+static void WINAPI mode_callback( EFFECTIVE_POWER_MODE mode, void *context )
+{
+    called.mode = mode;
+    called.context = context;
+    called.other_thread = GetCurrentThreadId() != main_thread;
+    InterlockedIncrement( &called.count );
+    SetEvent( called_event );
+}
