+static void test_setting_notification(void)
+{
+    DEVICE_NOTIFY_SUBSCRIBE_PARAMETERS params = { notify_callback, (void *)0x1234 };
+    HPOWERNOTIFY handle;
+    DWORD ret;
+
+    /* the current value is told soon after, from another thread */
+    memset( &called, 0, sizeof(called) );
+    handle = (HPOWERNOTIFY)0xdeadbeef;
+    ret = PowerSettingRegisterNotification( &GUID_ACDC_POWER_SOURCE, DEVICE_NOTIFY_CALLBACK, &params, &handle );
+    ok( !ret, "got %lu\n", ret );
+    ok( handle && handle != (HPOWERNOTIFY)0xdeadbeef, "got %p\n", handle );
+    ret = WaitForSingleObject( called_event, 5000 );
+    ok( !ret, "not called\n" );
+    ok( called.count == 1, "called %ld times\n", called.count );
+    ok( called.other_thread, "called on the thread that registered\n" );
+    ok( called.context == (void *)0x1234, "got context %p\n", called.context );
+    ok( called.type == PBT_POWERSETTINGCHANGE, "got type %#lx\n", called.type );
+    ok( IsEqualGUID( &called.setting, &GUID_ACDC_POWER_SOURCE ), "got %s\n", debugstr_guid( &called.setting ));
+    ok( called.size == sizeof(DWORD), "got size %lu\n", called.size );
+    ret = PowerSettingUnregisterNotification( handle );
+    ok( !ret, "got %lu\n", ret );
+
+    /* only callbacks */
+    handle = (HPOWERNOTIFY)0xdeadbeef;
+    ret = PowerSettingRegisterNotification( &GUID_ACDC_POWER_SOURCE, DEVICE_NOTIFY_WINDOW_HANDLE, GetDesktopWindow(),
+                                            &handle );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    ok( handle == (HPOWERNOTIFY)0xdeadbeef, "got %p\n", handle );
+    ret = PowerSettingRegisterNotification( &GUID_ACDC_POWER_SOURCE, 7, &params, &handle );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    ok( handle == (HPOWERNOTIFY)0xdeadbeef, "got %p\n", handle );
+    ret = PowerSettingUnregisterNotification( NULL );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+
+    /* nothing is told of settings there are none of */
+    memset( &called, 0, sizeof(called) );
+    ret = PowerSettingRegisterNotification( &unknown, DEVICE_NOTIFY_CALLBACK, &params, &handle );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForSingleObject( called_event, 500 );
+    ok( ret == WAIT_TIMEOUT, "called\n" );
+    ret = PowerSettingUnregisterNotification( handle );
+    ok( !ret, "got %lu\n", ret );
+}
+
+static void test_suspend_resume_notification(void)
+{
+    DEVICE_NOTIFY_SUBSCRIBE_PARAMETERS params = { notify_callback, (void *)0x1234 };
+    HPOWERNOTIFY handle;
+    DWORD ret;
+
+    handle = (HPOWERNOTIFY)0xdeadbeef;
+    ret = PowerRegisterSuspendResumeNotification( DEVICE_NOTIFY_CALLBACK, &params, &handle );
+    ok( !ret, "got %lu\n", ret );
+    ok( handle && handle != (HPOWERNOTIFY)0xdeadbeef, "got %p\n", handle );
+    ret = PowerUnregisterSuspendResumeNotification( handle );
+    ok( !ret, "got %lu\n", ret );
+
+    handle = (HPOWERNOTIFY)0xdeadbeef;
+    ret = PowerRegisterSuspendResumeNotification( DEVICE_NOTIFY_WINDOW_HANDLE, GetDesktopWindow(), &handle );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    ok( handle == (HPOWERNOTIFY)0xdeadbeef, "got %p\n", handle );
+    ret = PowerRegisterSuspendResumeNotification( 7, &params, &handle );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    ok( handle == (HPOWERNOTIFY)0xdeadbeef, "got %p\n", handle );
+    ret = PowerUnregisterSuspendResumeNotification( NULL );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+}
