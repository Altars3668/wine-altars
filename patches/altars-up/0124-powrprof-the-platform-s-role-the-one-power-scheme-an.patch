+/*
+ * What the machine is, as its firmware describes its enclosure: Windows asks the ACPI tables for the power
+ * profile the maker set, of which the SMBIOS chassis type is the part there is here.
+ */
+#define RSMB (('R' << 24) | ('S' << 16) | ('M' << 8) | 'B')
+
+static POWER_PLATFORM_ROLE platform_role( ULONG version )
+{
+    struct smbios_header { BYTE type; BYTE length; WORD handle; };
+    struct raw_smbios { BYTE calling_method, major, minor, dmi_revision; DWORD length; BYTE data[1]; } *raw;
+    POWER_PLATFORM_ROLE role = PlatformRoleDesktop;
+    const BYTE *ptr, *end;
+    UINT size;
+
+    if (!(size = GetSystemFirmwareTable( RSMB, 0, NULL, 0 ))) return role;
+    if (!(raw = malloc( size ))) return role;
+    if (GetSystemFirmwareTable( RSMB, 0, raw, size ) != size || raw->length > size - offsetof(struct raw_smbios, data))
+    {
+        free( raw );
+        return role;
+    }
+
+    for (ptr = raw->data, end = raw->data + raw->length; ptr + sizeof(struct smbios_header) <= end;)
+    {
+        const struct smbios_header *hdr = (const struct smbios_header *)ptr;
+
+        if (hdr->type == 127 || hdr->length < sizeof(*hdr)) break;
+        if (hdr->type == 3 && hdr->length > 5)
+        {
+            switch (ptr[5] & 0x7f)
+            {
+            case 8:  /* portable */
+            case 9:  /* laptop */
+            case 10: /* notebook */
+            case 11: /* hand held */
+            case 14: /* sub notebook */
+            case 31: /* convertible */
+                role = PlatformRoleMobile;
+                break;
+            case 30: /* tablet */
+            case 32: /* detachable */
+                role = version >= POWER_PLATFORM_ROLE_V2 ? PlatformRoleSlate : PlatformRoleMobile;
+                break;
+            case 17: /* main server chassis */
+            case 23: /* rack mount chassis */
+            case 28: /* blade */
+            case 29: /* blade enclosure */
+                role = PlatformRoleEnterpriseServer;
+                break;
+            case 34: /* embedded PC */
+                role = PlatformRoleAppliancePC;
+                break;
+            }
+            break;
+        }
+        /* the strings that follow end with two nuls */
+        for (ptr += hdr->length; ptr + 1 < end && (ptr[0] || ptr[1]); ptr++);
+        ptr += 2;
+    }
+    free( raw );
+    return role;
 }
 
