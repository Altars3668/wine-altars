+/* Windows tells a callback the effective power mode soon after it is registered, from another thread, and again
+ * when the mode changes; with one balanced scheme and no energy saver it does not. */
+struct power_mode_notify
+{
+    struct list entry;
+    LONG refcount;
+    EFFECTIVE_POWER_MODE_CALLBACK *callback;
+    void *context;
+    DWORD thread;           /* the thread calling the callback, while one is */
+    BOOL removed;
+};
+
+static struct list power_mode_notifies = LIST_INIT(power_mode_notifies);
+static CONDITION_VARIABLE power_mode_told = CONDITION_VARIABLE_INIT;
+static CRITICAL_SECTION power_mode_section;
+static CRITICAL_SECTION_DEBUG power_mode_section_debug =
+{
+    0, 0, &power_mode_section,
+    { &power_mode_section_debug.ProcessLocksList, &power_mode_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": power_mode_section") }
+};
+static CRITICAL_SECTION power_mode_section = { &power_mode_section_debug, -1, 0, 0, 0, 0 };
+
+static void power_mode_notify_release(struct power_mode_notify *notify)
+{
+    if (!InterlockedDecrement(&notify->refcount)) free(notify);
+}
+
+static void CALLBACK power_mode_notify_first(TP_CALLBACK_INSTANCE *instance, void *context)
+{
+    struct power_mode_notify *notify = context;
+
+    EnterCriticalSection(&power_mode_section);
+    if (notify->removed)
+    {
+        LeaveCriticalSection(&power_mode_section);
+        power_mode_notify_release(notify);
+        return;
+    }
+    notify->thread = GetCurrentThreadId();
+    LeaveCriticalSection(&power_mode_section);
+
+    notify->callback(EffectivePowerModeBalanced, notify->context);
+
+    EnterCriticalSection(&power_mode_section);
+    notify->thread = 0;
+    WakeAllConditionVariable(&power_mode_told);
+    LeaveCriticalSection(&power_mode_section);
+    power_mode_notify_release(notify);
+}
+
 HRESULT WINAPI PowerRegisterForEffectivePowerModeNotifications(ULONG version, EFFECTIVE_POWER_MODE_CALLBACK *callback, void *context, void **handle)
 {
-    FIXME("(%lu,%p,%p,%p) stub!\n", version, callback, context, handle);
-    return E_NOTIMPL;
+    struct power_mode_notify *notify;
+
+    TRACE("(%lu,%p,%p,%p)\n", version, callback, context, handle);
+
+    if (version > EFFECTIVE_POWER_MODE_V2 || !callback || !handle) return E_INVALIDARG;
+    if (!(notify = calloc(1, sizeof(*notify)))) return E_OUTOFMEMORY;
+    notify->refcount = 2;
+    notify->callback = callback;
+    notify->context = context;
+
+    EnterCriticalSection(&power_mode_section);
+    list_add_tail(&power_mode_notifies, &notify->entry);
+    LeaveCriticalSection(&power_mode_section);
+    if (!TrySubmitThreadpoolCallback(power_mode_notify_first, notify, NULL)) power_mode_notify_release(notify);
+    *handle = notify;
+    return S_OK;
+}
+
+HRESULT WINAPI PowerUnregisterFromEffectivePowerModeNotifications(void *handle)
+{
+    struct power_mode_notify *notify;
+    DWORD thread = GetCurrentThreadId();
+
+    TRACE("(%p)\n", handle);
+
+    if (!handle) return E_INVALIDARG;
+    EnterCriticalSection(&power_mode_section);
+    LIST_FOR_EACH_ENTRY(notify, &power_mode_notifies, struct power_mode_notify, entry)
+        if (notify == handle) break;
+    if (&notify->entry == &power_mode_notifies)
+    {
+        LeaveCriticalSection(&power_mode_section);
+        return E_INVALIDARG;
+    }
+    list_remove(&notify->entry);
+    notify->removed = TRUE;
+    /* no call is made after this returns */
+    while (notify->thread && notify->thread != thread)
+        SleepConditionVariableCS(&power_mode_told, &power_mode_section, INFINITE);
+    LeaveCriticalSection(&power_mode_section);
+    power_mode_notify_release(notify);
+    return S_OK;
 }
 
