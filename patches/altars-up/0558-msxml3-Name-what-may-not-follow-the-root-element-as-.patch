From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 11:18:43 -0400
Subject: [PATCH] msxml3: Name what may not follow the root element as Windows
 does.

After the root element only spaces, comments and processing instructions
may come.  For anything else Windows names what it found, at the point
in it where it stops (tools/msxmlmoreprobe in the wine-altars
repository, MSXML 3.0 and 6.0 alike): an end tag is
XML_E_UNEXPECTEDENDTAG at its name, a DOCTYPE
XML_E_DOCTYPE_OUTSIDE_PROLOG at the name it declares, "]]>"
XML_E_INVALID_CDATACLOSINGTAG, a "<" that ends the input
XML_E_UNCLOSEDDECL, an XML declaration XML_E_BADXMLDECL at its name, a
character text may not hold XML_E_BADCHARDATA; references and CDATA
sections are XML_E_INVALIDATROOTLEVEL after their "&", "&#" or
"<![CDATA[", other text at its start.  Wine said
XML_E_INVALIDATROOTLEVEL at the first character for all of them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/msxml_private.h b/dlls/msxml3/msxml_private.h
index 488aed9a936..7fa5f13fb64 100644
--- a/dlls/msxml3/msxml_private.h
+++ b/dlls/msxml3/msxml_private.h
@@ -76,6 +76,7 @@ enum error_codes
     E_SAX_UNCLOSEDPI = 0xc00ce55d,
     E_SAX_UNCLOSEDSTARTTAG = 0xc00ce55e,
     E_SAX_UNCLOSEDENDTAG = 0xc00ce55f,
+    E_SAX_UNCLOSEDDECL = 0xc00ce562,
     E_SAX_UNCLOSEDCDATA = 0xc00ce564,
     E_SAX_BADDECLNAME = 0xc00ce565,
     E_SAX_RESERVEDNAMESPACE = 0xc00ce568,
@@ -87,6 +88,7 @@ enum error_codes
     E_SAX_INVALID_TYPE = 0xc00ce572,
     E_SAX_BADXMLCASE = 0xc00ce576,
     E_SAX_INVALID_STANDALONE = 0xc00ce579,
+    E_SAX_DOCTYPE_OUTSIDE_PROLOG = 0xc00ce57e,
     E_SAX_INVALID_VERSION = 0xc00ce57f,
     E_DOM_PROHIBIT_DTD = 0xc00ce584,
     E_DOM_MAX_ELEMENT_DEPTH = 0xc00ce586,
diff --git a/dlls/msxml3/saxreader.c b/dlls/msxml3/saxreader.c
index 9b1017d6e29..eeacddd9d03 100644
--- a/dlls/msxml3/saxreader.c
+++ b/dlls/msxml3/saxreader.c
@@ -6358,6 +6358,59 @@ static void saxreader_detect_encoding(struct saxlocator *locator, bool force_utf
     }
 }
 
+/* the next characters, at least count of them where the input has them */
+static const WCHAR *saxreader_get_chars(struct saxlocator *locator, size_t count)
+{
+    struct encoded_buffer *buffer = &locator->buffer.utf16;
+    size_t written;
+
+    do
+    {
+        written = buffer->written;
+        if (buffer->written / sizeof(WCHAR) - buffer->cur >= count) break;
+        saxreader_more(locator);
+    } while (buffer->written != written && locator->status == S_OK);
+    return (const WCHAR *)buffer->data + buffer->cur;
+}
+
+/* what may not follow the root element: Windows names it, where in it it stops reading */
+static void saxreader_epilog_error(struct saxlocator *locator, const WCHAR *ptr)
+{
+    HRESULT code = E_SAX_INVALIDATROOTLEVEL;
+    int offset = 0;
+
+    if (ptr[0] == '<')
+    {
+        if (!ptr[1]) code = E_SAX_UNCLOSEDDECL;
+        else if (ptr[1] == '/')
+        {
+            code = E_SAX_UNEXPECTEDENDTAG;
+            offset = 2;
+        }
+        else if (!wcsncmp(ptr, L"<!DOCTYPE", 9))
+        {
+            code = E_SAX_DOCTYPE_OUTSIDE_PROLOG;
+            for (offset = 9; ptr[offset] == ' ' || ptr[offset] == '\t'; offset++);
+        }
+        else if (!wcsncmp(ptr, L"<![CDATA[", 9)) offset = 9;
+        else if (ptr[1] != '!' && ptr[1] != '?')
+        {
+            /* another element: a second root, at its name */
+            code = E_SAX_MULTIPLEROOTS;
+            offset = 1;
+        }
+    }
+    else if (ptr[0] == '&') offset = ptr[1] == '#' ? 2 : 1;
+    else if (!wcsncmp(ptr, L"]]>", 3)) code = E_SAX_INVALID_CDATACLOSINGTAG;
+    else if ((ptr[0] < 0x20 && ptr[0] != '\t' && ptr[0] != '\n' && ptr[0] != '\r') ||
+            ptr[0] == 0xfffe || ptr[0] == 0xffff)
+        code = E_SAX_BADCHARDATA;
+
+    locator->line = locator->buffer.position.line;
+    locator->column = locator->buffer.position.column + offset;
+    saxreader_set_error(locator, code);
+}
+
 static HRESULT saxreader_parse_stream(struct saxreader *reader, ISequentialStream *stream,
         bool force_utf16, bool string_input, bool vbInterface)
 {
@@ -6405,6 +6458,17 @@ static HRESULT saxreader_parse_stream(struct saxreader *reader, ISequentialStrea
                 {
                     if (saxreader_peek(locator, L"<?", 2))
                     {
+                        const WCHAR *ptr = saxreader_get_chars(locator, 6);
+
+                        /* an XML declaration after the root element, at its name */
+                        if (locator->state == SAX_PARSER_EPILOG && !wcsncmp(ptr, L"<?xml", 5) &&
+                                (saxreader_is_space(ptr[5]) || ptr[5] == '?'))
+                        {
+                            locator->line = locator->buffer.position.line;
+                            locator->column = locator->buffer.position.column + 2;
+                            saxreader_set_error(locator, E_SAX_BAD_XMLDECL);
+                            break;
+                        }
                         saxreader_parse_pi(locator);
                         break;
                     }
@@ -6425,23 +6489,11 @@ static HRESULT saxreader_parse_stream(struct saxreader *reader, ISequentialStrea
 
                 if (locator->state == SAX_PARSER_EPILOG)
                 {
-                    const WCHAR *ptr = saxreader_get_ptr(locator);
+                    const WCHAR *ptr = saxreader_get_chars(locator, 9);
 
                     if (locator->buffer.utf16.cur * sizeof(WCHAR) < locator->buffer.utf16.written && *ptr)
                     {
-                        /* another element is a second root; anything else is out of place */
-                        if (ptr[0] == '<' && ptr[1] && !wcschr(L"/!?", ptr[1]))
-                        {
-                            locator->line = locator->buffer.position.line;
-                            locator->column = locator->buffer.position.column + 1;
-                            saxreader_set_error(locator, E_SAX_MULTIPLEROOTS);
-                        }
-                        else
-                        {
-                            locator->line = locator->buffer.position.line;
-                            locator->column = locator->buffer.position.column;
-                            saxreader_set_error(locator, E_SAX_INVALIDATROOTLEVEL);
-                        }
+                        saxreader_epilog_error(locator, ptr);
                         break;
                     }
                     locator->state = SAX_PARSER_EOF;
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index 0e7fcdca3cd..ae48396231a 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -20186,6 +20186,20 @@ static void test_parse_error_source(void)
         { "<a b='<'/>", 0xc00ce506 /* XML_E_BADCHARINSTRING */, 1, 7, 6, L"<a b='<'/>" },
         { "<a b=1/>", 0xc00ce502 /* XML_E_MISSINGQUOTE */, 1, 6, 5, L"<a b=1/>" },
         { "<a>\n  <b>\n</a>", 0xc00ce56d, 3, 3, 12, L"</a>" },
+        /* what may not follow the root element, at the place in it Windows stops */
+        { "<a/>text", 0xc00ce556, 1, 5, 4, L"<a/>text" },
+        { "<a/></b>", 0xc00ce552 /* XML_E_UNEXPECTEDENDTAG */, 1, 7, 6, L"<a/></b>" },
+        { "<a/>&amp;", 0xc00ce556, 1, 6, 5, L"<a/>&amp;" },
+        { "<a/>&#65;", 0xc00ce556, 1, 7, 6, L"<a/>&#65;" },
+        { "<a/><!DOCTYPE a>", 0xc00ce57e /* XML_E_DOCTYPE_OUTSIDE_PROLOG */, 1, 15, 14, L"<a/><!DOCTYPE a>" },
+        { "<a/>]]>", 0xc00ce55c /* XML_E_INVALID_CDATACLOSINGTAG */, 1, 5, 4, L"<a/>]]>" },
+        { "<a/><![CDATA[x]]>", 0xc00ce556, 1, 14, 13, L"<a/><![CDATA[x]]>" },
+        { "<a/><", 0xc00ce562 /* XML_E_UNCLOSEDDECL */, 1, 5, 4, L"<a/><" },
+        { "<a/>\n<b/>", 0xc00ce555, 2, 2, 6, L"<b/>" },
+        { "<a/>\x01", 0xc00ce508, 1, 5, 4, L"<a/>\x01" },
+        { "text<a/>", 0xc00ce556, 1, 1, 0, L"text<a/>" },
+        { "<a/><?xml version='1.0'?>", 0xc00ce557 /* XML_E_BADXMLDECL */, 1, 7, 6, L"<a/><?xml version='1.0'?>" },
+        { "<!--c--><a/><b/>", 0xc00ce555, 1, 14, 13, L"<!--c--><a/><b/>" },
     };
     static const struct
     {
@@ -20234,6 +20248,7 @@ static void test_parse_error_source(void)
         SysFreeString(src);
         IXMLDOMParseError_Release(error);
         IXMLDOMDocument2_Release(doc);
+        free_bstrs();
         winetest_pop_context();
     }
 }
