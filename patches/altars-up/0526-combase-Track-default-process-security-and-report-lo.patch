From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 15:40:18 -0400
Subject: [PATCH] combase: Track default process security and report local
 proxy blankets.

Match the measured initialization order, parameter errors and local
proxy settings. Standard marshaling fixes the implicit process defaults,
and a later CoInitializeSecurity returns RPC_E_TOO_LATE.

This covers Office's default authentication/NULL descriptor path;
custom authentication services and descriptor enforcement remain
explicitly unsupported rather than being claimed as implemented.

Co-Authored-By: Claude Code <noreply@anthropic.com>

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index 5b2b0b0495e..19fe8c2085b 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -50,6 +50,28 @@ static LONG com_lockcount;
 
 static LONG com_server_process_refcount;
 
+static CRITICAL_SECTION security_cs;
+static CRITICAL_SECTION_DEBUG security_cs_debug =
+{
+    0, 0, &security_cs,
+    { &security_cs_debug.ProcessLocksList, &security_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": security_cs") }
+};
+static CRITICAL_SECTION security_cs = { &security_cs_debug, -1, 0, 0, 0, 0 };
+static BOOL security_initialized;
+static struct security_settings security_settings =
+{
+    RPC_C_AUTHN_LEVEL_CONNECT, RPC_C_IMP_LEVEL_IDENTIFY, EOAC_NONE,
+};
+
+void com_get_security_settings(struct security_settings *settings)
+{
+    EnterCriticalSection(&security_cs);
+    security_initialized = TRUE;
+    if (settings) *settings = security_settings;
+    LeaveCriticalSection(&security_cs);
+}
+
 struct comclassredirect_data
 {
     ULONG size;
@@ -1167,10 +1189,47 @@ HRESULT WINAPI CoInitializeSecurity(PSECURITY_DESCRIPTOR sd, LONG cAuthSvc,
         SOLE_AUTHENTICATION_SERVICE *asAuthSvc, void *reserved1, DWORD authn_level,
         DWORD imp_level, void *reserved2, DWORD capabilities, void *reserved3)
 {
-    FIXME("%p, %ld, %p, %p, %ld, %ld, %p, %ld, %p stub\n", sd, cAuthSvc, asAuthSvc, reserved1, authn_level,
+    const DWORD valid_capabilities = EOAC_MUTUAL_AUTH | EOAC_SECURE_REFS | EOAC_ACCESS_CONTROL | EOAC_APPID |
+            EOAC_DYNAMIC | EOAC_STATIC_CLOAKING | EOAC_DYNAMIC_CLOAKING | EOAC_ANY_AUTHORITY | EOAC_MAKE_FULLSIC |
+            EOAC_REQUIRE_FULLSIC | EOAC_AUTO_IMPERSONATE | EOAC_DEFAULT | EOAC_DISABLE_AAA | EOAC_NO_CUSTOM_MARSHAL;
+    DWORD error = GetLastError();
+    HRESULT hr = S_OK;
+
+    TRACE("%p, %ld, %p, %p, %lu, %lu, %p, %#lx, %p.\n", sd, cAuthSvc, asAuthSvc, reserved1, authn_level,
             imp_level, reserved2, capabilities, reserved3);
 
-    return S_OK;
+    if (!InternalIsProcessInitialized())
+    {
+        SetLastError(ERROR_SUCCESS);
+        return CO_E_NOTINITIALIZED;
+    }
+
+    EnterCriticalSection(&security_cs);
+    if (security_initialized)
+    {
+        hr = RPC_E_TOO_LATE;
+        SetLastError(error);
+    }
+    else if (authn_level > RPC_C_AUTHN_LEVEL_PKT_PRIVACY || imp_level > RPC_C_IMP_LEVEL_DELEGATE ||
+            (capabilities & ~valid_capabilities) ||
+            ((capabilities & EOAC_STATIC_CLOAKING) && (capabilities & EOAC_DYNAMIC_CLOAKING)) ||
+            cAuthSvc < -1 || (cAuthSvc > 0 && !asAuthSvc) || reserved1 || reserved3)
+    {
+        hr = E_INVALIDARG;
+        SetLastError(ERROR_NO_TOKEN);
+    }
+    else
+    {
+        if (sd || cAuthSvc > 0 || reserved2)
+            FIXME("Security descriptor and authentication services are not supported yet.\n");
+        security_settings.authn_level = authn_level ? authn_level : RPC_C_AUTHN_LEVEL_CONNECT;
+        security_settings.imp_level = imp_level ? imp_level : RPC_C_IMP_LEVEL_IDENTIFY;
+        security_settings.capabilities = capabilities;
+        security_initialized = TRUE;
+        SetLastError(ERROR_SUCCESS);
+    }
+    LeaveCriticalSection(&security_cs);
+    return hr;
 }
 
 /***********************************************************************
