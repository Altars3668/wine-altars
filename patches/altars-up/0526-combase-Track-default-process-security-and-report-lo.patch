new file mode 100644
index 00000000000..21bcb561714
--- /dev/null
+++ b/dlls/combase/tests/security.c
@@ -0,0 +1,243 @@
+/*
+ * COM process security tests
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+#define CONST_VTABLE
+#include "objbase.h"
+#include "wine/test.h"
+
+static LONG factory_refs;
+
+static HRESULT WINAPI factory_QueryInterface(IClassFactory *iface, REFIID iid, void **obj)
+{
+    *obj = NULL;
+    if (!IsEqualIID(iid, &IID_IUnknown) && !IsEqualIID(iid, &IID_IClassFactory)) return E_NOINTERFACE;
+    *obj = iface;
+    IClassFactory_AddRef(iface);
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef(IClassFactory *iface)
+{
+    return InterlockedIncrement(&factory_refs);
+}
+
+static ULONG WINAPI factory_Release(IClassFactory *iface)
+{
+    return InterlockedDecrement(&factory_refs);
+}
+
+static HRESULT WINAPI factory_CreateInstance(IClassFactory *iface, IUnknown *outer, REFIID iid, void **obj)
+{
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static HRESULT WINAPI factory_LockServer(IClassFactory *iface, BOOL lock)
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_CreateInstance,
+    factory_LockServer,
+};
+
+static IClassFactory factory = { &factory_vtbl };
+
+struct proxy_params
+{
+    IStream *stream;
+    DWORD imp_level;
+};
+
+static DWORD WINAPI test_proxy(void *arg)
+{
+    struct proxy_params *params = arg;
+    DWORD authn, authz, authn_level, imp_level, capabilities;
+    RPC_AUTH_IDENTITY_HANDLE identity;
+    IClientSecurity *security;
+    IClassFactory *proxy;
+    OLECHAR *principal;
+    void *obj;
+    HRESULT hr;
+
+    hr = CoInitializeEx(NULL, COINIT_MULTITHREADED);
+    ok(hr == S_OK, "Got %#lx.\n", hr);
+    if (FAILED(hr)) return 0;
+
+    hr = CoGetInterfaceAndReleaseStream(params->stream, &IID_IClassFactory, (void **)&proxy);
+    params->stream = NULL;
+    ok(hr == S_OK, "Got %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IClassFactory_QueryInterface(proxy, &IID_IClientSecurity, (void **)&security);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+        if (SUCCEEDED(hr)) IClientSecurity_Release(security);
+
+        authn = authz = authn_level = imp_level = capabilities = 0xdeadbeef;
+        principal = (void *)0xdeadbeef;
+        identity = (void *)0xdeadbeef;
+        hr = CoQueryProxyBlanket((IUnknown *)proxy, &authn, &authz, &principal,
+                &authn_level, &imp_level, &identity, &capabilities);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+        ok(authn == RPC_C_AUTHN_WINNT, "Got authn %lu.\n", authn);
+        ok(authz == RPC_C_AUTHZ_NONE, "Got authz %lu.\n", authz);
+        ok(authn_level == RPC_C_AUTHN_LEVEL_PKT_PRIVACY, "Got authn level %lu.\n", authn_level);
+        ok(imp_level == params->imp_level, "Got imp level %lu, expected %lu.\n", imp_level, params->imp_level);
+        ok(!principal || !*principal, "Got principal %p.\n", principal);
+        ok(!identity, "Got identity %p.\n", identity);
+        ok(capabilities == EOAC_NONE, "Got capabilities %#lx.\n", capabilities);
+        if (SUCCEEDED(hr)) CoTaskMemFree(principal);
+
+        hr = IClassFactory_CreateInstance(proxy, NULL, &IID_IUnknown, &obj);
+        ok(hr == E_NOINTERFACE, "Got %#lx.\n", hr);
+        IClassFactory_Release(proxy);
+    }
+    CoUninitialize();
+    return 0;
+}
+
+static void test_security(const char *name)
+{
+    DWORD authn_level = RPC_C_AUTHN_LEVEL_DEFAULT, imp_level = RPC_C_IMP_LEVEL_IMPERSONATE;
+    DWORD capabilities = EOAC_NONE, index;
+    struct proxy_params params = {0};
+    HANDLE thread;
+    HRESULT hr, expected = S_OK;
+    BOOL before = !strcmp(name, "before"), marshal_first = !strcmp(name, "marshal_first");
+
+    factory_refs = 1;
+    params.imp_level = RPC_C_IMP_LEVEL_IMPERSONATE;
+    if (before)
+    {
+        SetLastError(0xdeadbeef);
+        hr = CoInitializeSecurity(NULL, -1, NULL, NULL, authn_level, imp_level, NULL, capabilities, NULL);
+        ok(hr == CO_E_NOTINITIALIZED, "Got %#lx.\n", hr);
+        ok(!GetLastError(), "Got error %lu.\n", GetLastError());
+        params.imp_level = RPC_C_IMP_LEVEL_IDENTIFY;
+    }
+
+    hr = CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    ok(hr == S_OK, "Got %#lx.\n", hr);
+    if (FAILED(hr)) return;
+
+    if (marshal_first)
+    {
+        hr = CoMarshalInterThreadInterfaceInStream(&IID_IClassFactory, (IUnknown *)&factory, &params.stream);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+        expected = RPC_E_TOO_LATE;
+        params.imp_level = RPC_C_IMP_LEVEL_IDENTIFY;
+    }
+    if (!strcmp(name, "bad_authn"))
+    {
+        authn_level = 0x7fffffff;
+        expected = E_INVALIDARG;
+        params.imp_level = RPC_C_IMP_LEVEL_IDENTIFY;
+    }
+    if (!strcmp(name, "bad_capabilities"))
+    {
+        capabilities = 0x80000000;
+        expected = E_INVALIDARG;
+        params.imp_level = RPC_C_IMP_LEVEL_IDENTIFY;
+    }
+    if (!strcmp(name, "explicit"))
+    {
+        authn_level = RPC_C_AUTHN_LEVEL_PKT_PRIVACY;
+        imp_level = params.imp_level = RPC_C_IMP_LEVEL_IDENTIFY;
+    }
+    if (!before)
+    {
+        SetLastError(0xdeadbeef);
+        hr = CoInitializeSecurity(NULL, -1, NULL, NULL, authn_level, imp_level, NULL, capabilities, NULL);
+        ok(hr == expected, "Got %#lx, expected %#lx.\n", hr, expected);
+        ok(GetLastError() == (expected == S_OK ? 0 : expected == E_INVALIDARG ? ERROR_NO_TOKEN : 0xdeadbeef),
+                "Got error %lu.\n", GetLastError());
+    }
+    if (!strcmp(name, "second"))
+    {
+        SetLastError(0xdeadbeef);
+        hr = CoInitializeSecurity(NULL, -1, NULL, NULL, authn_level, imp_level, NULL, capabilities, NULL);
+        ok(hr == RPC_E_TOO_LATE, "Got %#lx.\n", hr);
+        ok(GetLastError() == 0xdeadbeef, "Got error %lu.\n", GetLastError());
+    }
+
+    if (!params.stream)
+    {
+        hr = CoMarshalInterThreadInterfaceInStream(&IID_IClassFactory, (IUnknown *)&factory, &params.stream);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+    }
+    if (params.stream)
+    {
+        thread = CreateThread(NULL, 0, test_proxy, &params, 0, NULL);
+        ok(!!thread, "Got error %lu.\n", GetLastError());
+        if (thread)
+        {
+            hr = CoWaitForMultipleHandles(0, 10000, 1, &thread, &index);
+            ok(hr == S_OK, "Got %#lx.\n", hr);
+            if (FAILED(hr)) ExitProcess(1);
+            CloseHandle(thread);
+        }
+        if (params.stream)
+        {
+            static const LARGE_INTEGER zero;
+            IStream_Seek(params.stream, zero, STREAM_SEEK_SET, NULL);
+            CoReleaseMarshalData(params.stream);
+            IStream_Release(params.stream);
+        }
+    }
+    ok(factory_refs == 1, "Got refs %ld.\n", factory_refs);
+    CoUninitialize();
+}
+
+START_TEST(security)
+{
+    static const char *const cases[] =
+    {
+        "office", "second", "before", "marshal_first", "bad_authn", "bad_capabilities", "explicit",
+    };
+    STARTUPINFOA startup = {sizeof(startup)};
+    PROCESS_INFORMATION process;
+    char **argv, command[MAX_PATH * 2];
+    unsigned int i;
+    int argc;
+    BOOL ret;
+
+    argc = winetest_get_mainargs(&argv);
+    if (argc == 3)
+    {
+        test_security(argv[2]);
+        return;
+    }
+    for (i = 0; i < ARRAY_SIZE(cases); ++i)
+    {
+        winetest_push_context("%s", cases[i]);
+        sprintf(command, "\"%s\" security %s", argv[0], cases[i]);
+        ret = CreateProcessA(NULL, command, NULL, NULL, FALSE, 0, NULL, NULL, &startup, &process);
+        ok(ret, "Got error %lu.\n", GetLastError());
+        if (ret)
+        {
+            wait_child_process(&process);
+        }
+        winetest_pop_context();
+    }
+}
