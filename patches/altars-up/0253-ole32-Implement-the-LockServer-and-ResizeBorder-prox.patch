From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 07:29:35 -0400
Subject: [PATCH] ole32: Implement the LockServer and ResizeBorder proxies and
 stubs.

Both returned E_NOTIMPL.  Measured on Windows 11: a proxy's
IClassFactory::LockServer answers S_OK without asking the object, and
IOleInPlaceActiveObject::ResizeBorder goes through RemoteResizeBorder,
sending the window as IOleInPlaceFrame when it is the frame, so a window
that is no frame fails with E_NOINTERFACE before the call.  A container
calls ResizeBorder on the object it has activated in place, which for
Word and Excel is in another process, whenever its frame is resized.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ole32/tests/marshal.c b/dlls/ole32/tests/marshal.c
index 0317611b8b7..ac33d9505e9 100644
--- a/dlls/ole32/tests/marshal.c
+++ b/dlls/ole32/tests/marshal.c
@@ -3924,6 +3924,262 @@ static void test_input_sync_calls(void)
     CloseHandle(input_sync.done);
 }
 
+/* methods whose proxies do more than forward the call ([call_as] in the IDL) */
+
+static LONG lockserver_calls;
+
+static HRESULT WINAPI CallAs_LockServer(IClassFactory *iface, BOOL lock)
+{
+    InterlockedIncrement(&lockserver_calls);
+    return E_UNEXPECTED;
+}
+
+static const IClassFactoryVtbl CallAsClassFactoryVtbl =
+{
+    Test_IClassFactory_QueryInterface,
+    Test_IClassFactory_AddRef,
+    Test_IClassFactory_Release,
+    Test_IClassFactory_CreateInstance,
+    CallAs_LockServer
+};
+
+static IClassFactory CallAs_ClassFactory = { &CallAsClassFactoryVtbl };
+
+static struct
+{
+    LONG calls;
+    RECT rect;
+    BOOL frame, window;
+    HRESULT frame_qi, uiwindow_qi;
+} resize_border;
+
+static HRESULT WINAPI CallAs_ResizeBorder(IOleInPlaceActiveObject *iface, const RECT *border,
+                                          IOleInPlaceUIWindow *window, BOOL frame)
+{
+    IUnknown *unk;
+
+    InterlockedIncrement(&resize_border.calls);
+    SetRect(&resize_border.rect, -1, -1, -1, -1);
+    if (border) resize_border.rect = *border;
+    resize_border.frame = frame;
+    resize_border.window = window != NULL;
+    resize_border.frame_qi = resize_border.uiwindow_qi = E_POINTER;
+    if (window)
+    {
+        resize_border.frame_qi = IOleInPlaceUIWindow_QueryInterface(window, &IID_IOleInPlaceFrame, (void **)&unk);
+        if (SUCCEEDED(resize_border.frame_qi)) IUnknown_Release(unk);
+        resize_border.uiwindow_qi = IOleInPlaceUIWindow_QueryInterface(window, &IID_IOleInPlaceUIWindow, (void **)&unk);
+        if (SUCCEEDED(resize_border.uiwindow_qi)) IUnknown_Release(unk);
+    }
+    return S_FALSE;
+}
+
+static const IOleInPlaceActiveObjectVtbl CallAsActiveObjectVtbl =
+{
+    InputSync_QueryInterface,
+    InputSync_AddRef,
+    InputSync_Release,
+    InputSync_GetWindow,
+    InputSync_ContextSensitiveHelp,
+    InputSync_TranslateAccelerator,
+    InputSync_OnFrameWindowActivate,
+    InputSync_OnDocWindowActivate,
+    CallAs_ResizeBorder,
+    InputSync_EnableModeless,
+};
+
+static IOleInPlaceActiveObject CallAs_ActiveObject = { &CallAsActiveObjectVtbl };
+
+/* a frame, or only a user interface window */
+struct callas_window
+{
+    IOleInPlaceFrame IOleInPlaceFrame_iface;
+    BOOL frame;
+};
+
+static HRESULT WINAPI CallAsWindow_QueryInterface(IOleInPlaceFrame *iface, REFIID riid, void **obj)
+{
+    struct callas_window *window = CONTAINING_RECORD(iface, struct callas_window, IOleInPlaceFrame_iface);
+
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IOleWindow) || IsEqualIID(riid, &IID_IOleInPlaceUIWindow)
+            || (window->frame && IsEqualIID(riid, &IID_IOleInPlaceFrame)))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI CallAsWindow_AddRef(IOleInPlaceFrame *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI CallAsWindow_Release(IOleInPlaceFrame *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI CallAsWindow_GetWindow(IOleInPlaceFrame *iface, HWND *hwnd)
+{
+    *hwnd = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_ContextSensitiveHelp(IOleInPlaceFrame *iface, BOOL enter)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_GetBorder(IOleInPlaceFrame *iface, RECT *border)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_RequestBorderSpace(IOleInPlaceFrame *iface, const BORDERWIDTHS *widths)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_SetBorderSpace(IOleInPlaceFrame *iface, const BORDERWIDTHS *widths)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_SetActiveObject(IOleInPlaceFrame *iface, IOleInPlaceActiveObject *object,
+                                                   const WCHAR *name)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_InsertMenus(IOleInPlaceFrame *iface, HMENU menu, OLEMENUGROUPWIDTHS *widths)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_SetMenu(IOleInPlaceFrame *iface, HMENU menu, HOLEMENU olemenu, HWND hwnd)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_RemoveMenus(IOleInPlaceFrame *iface, HMENU menu)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_SetStatusText(IOleInPlaceFrame *iface, const WCHAR *text)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_EnableModeless(IOleInPlaceFrame *iface, BOOL enable)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI CallAsWindow_TranslateAccelerator(IOleInPlaceFrame *iface, MSG *msg, WORD id)
+{
+    return E_NOTIMPL;
+}
+
+static const IOleInPlaceFrameVtbl CallAsWindowVtbl =
+{
+    CallAsWindow_QueryInterface,
+    CallAsWindow_AddRef,
+    CallAsWindow_Release,
+    CallAsWindow_GetWindow,
+    CallAsWindow_ContextSensitiveHelp,
+    CallAsWindow_GetBorder,
+    CallAsWindow_RequestBorderSpace,
+    CallAsWindow_SetBorderSpace,
+    CallAsWindow_SetActiveObject,
+    CallAsWindow_InsertMenus,
+    CallAsWindow_SetMenu,
+    CallAsWindow_RemoveMenus,
+    CallAsWindow_SetStatusText,
+    CallAsWindow_EnableModeless,
+    CallAsWindow_TranslateAccelerator,
+};
+
+static struct callas_window frame = { { &CallAsWindowVtbl }, TRUE }, uiwindow = { { &CallAsWindowVtbl }, FALSE };
+
+static void test_call_as_methods(void)
+{
+    IOleInPlaceActiveObject *active;
+    RECT rect = { 1, 2, 3, 4 };
+    IClassFactory *factory;
+    IStream *stream;
+    HANDLE thread;
+    HRESULT hr;
+    DWORD tid;
+
+    cLocks = 0;
+    external_connections = 0;
+
+    hr = CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    ok_ole_success(hr, CreateStreamOnHGlobal);
+    tid = start_host_object(stream, &IID_IClassFactory, (IUnknown *)&CallAs_ClassFactory, MSHLFLAGS_NORMAL, &thread);
+    IStream_Seek(stream, ullZero, STREAM_SEEK_SET, NULL);
+    hr = CoUnmarshalInterface(stream, &IID_IClassFactory, (void **)&factory);
+    ok_ole_success(hr, CoUnmarshalInterface);
+    IStream_Release(stream);
+
+    /* the proxy answers LockServer itself */
+    lockserver_calls = 0;
+    hr = IClassFactory_LockServer(factory, TRUE);
+    ok(hr == S_OK, "LockServer(TRUE) returned %#lx.\n", hr);
+    hr = IClassFactory_LockServer(factory, FALSE);
+    ok(hr == S_OK, "LockServer(FALSE) returned %#lx.\n", hr);
+    ok(!lockserver_calls, "object called %ld times.\n", lockserver_calls);
+
+    IClassFactory_Release(factory);
+    end_host_object(tid, thread);
+    ok_no_locks();
+
+    hr = CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    ok_ole_success(hr, CreateStreamOnHGlobal);
+    tid = start_host_object(stream, &IID_IOleInPlaceActiveObject, (IUnknown *)&CallAs_ActiveObject, MSHLFLAGS_NORMAL,
+                            &thread);
+    IStream_Seek(stream, ullZero, STREAM_SEEK_SET, NULL);
+    hr = CoUnmarshalInterface(stream, &IID_IOleInPlaceActiveObject, (void **)&active);
+    ok_ole_success(hr, CoUnmarshalInterface);
+    IStream_Release(stream);
+
+    /* a frame goes as IOleInPlaceFrame, and the object cannot call out to ask for more */
+    memset(&resize_border, 0, sizeof(resize_border));
+    hr = IOleInPlaceActiveObject_ResizeBorder(active, &rect, (IOleInPlaceUIWindow *)&frame.IOleInPlaceFrame_iface, TRUE);
+    ok(hr == S_FALSE, "ResizeBorder returned %#lx.\n", hr);
+    ok(resize_border.calls == 1, "object called %ld times.\n", resize_border.calls);
+    ok(EqualRect(&resize_border.rect, &rect), "got %s.\n", wine_dbgstr_rect(&resize_border.rect));
+    ok(resize_border.frame && resize_border.window, "got frame %d, window %d.\n", resize_border.frame, resize_border.window);
+    ok(resize_border.frame_qi == S_OK, "IOleInPlaceFrame: %#lx.\n", resize_border.frame_qi);
+    todo_wine ok(resize_border.uiwindow_qi == RPC_E_CANTCALLOUT_ININPUTSYNCCALL, "IOleInPlaceUIWindow: %#lx.\n",
+       resize_border.uiwindow_qi);
+    memset(&resize_border, 0, sizeof(resize_border));
+    hr = IOleInPlaceActiveObject_ResizeBorder(active, &rect, (IOleInPlaceUIWindow *)&uiwindow.IOleInPlaceFrame_iface, FALSE);
+    ok(hr == S_FALSE, "ResizeBorder returned %#lx.\n", hr);
+    ok(resize_border.calls == 1, "object called %ld times.\n", resize_border.calls);
+    ok(!resize_border.frame && resize_border.window, "got frame %d, window %d.\n", resize_border.frame,
+       resize_border.window);
+    todo_wine ok(resize_border.frame_qi == RPC_E_CANTCALLOUT_ININPUTSYNCCALL, "IOleInPlaceFrame: %#lx.\n",
+       resize_border.frame_qi);
+    ok(resize_border.uiwindow_qi == S_OK, "IOleInPlaceUIWindow: %#lx.\n", resize_border.uiwindow_qi);
+    /* a window that is no frame cannot go as one */
+    memset(&resize_border, 0, sizeof(resize_border));
+    hr = IOleInPlaceActiveObject_ResizeBorder(active, &rect, (IOleInPlaceUIWindow *)&uiwindow.IOleInPlaceFrame_iface, TRUE);
+    ok(hr == E_NOINTERFACE, "ResizeBorder returned %#lx.\n", hr);
+    ok(!resize_border.calls, "object called %ld times.\n", resize_border.calls);
+    memset(&resize_border, 0, sizeof(resize_border));
+    hr = IOleInPlaceActiveObject_ResizeBorder(active, &rect, NULL, FALSE);
+    ok(hr == S_FALSE, "ResizeBorder returned %#lx.\n", hr);
+    ok(resize_border.calls == 1 && !resize_border.window, "object called %ld times, window %d.\n", resize_border.calls,
+       resize_border.window);
+
+    IOleInPlaceActiveObject_Release(active);
+    end_host_object(tid, thread);
+}
+
 static void test_WM_QUIT_handling(void)
 {
     MSG msg;
@@ -5437,6 +5693,7 @@ START_TEST(marshal)
     test_message_reentrancy();
     test_call_from_message();
     test_input_sync_calls();
+    test_call_as_methods();
     test_WM_QUIT_handling();
     test_freethreadedmarshaler();
     test_inproc_handler();
diff --git a/dlls/ole32/usrmarshal.c b/dlls/ole32/usrmarshal.c
index c3af05c9cd5..907964a87a7 100644
--- a/dlls/ole32/usrmarshal.c
+++ b/dlls/ole32/usrmarshal.c
@@ -1281,16 +1281,17 @@ HRESULT CALLBACK IClassFactory_LockServer_Proxy(
     IClassFactory* This,
     BOOL fLock)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("(%d)\n", fLock);
+    /* the object is not asked */
+    return S_OK;
 }
 
 HRESULT __RPC_STUB IClassFactory_LockServer_Stub(
     IClassFactory* This,
     BOOL fLock)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("(%d)\n", fLock);
+    return IClassFactory_LockServer(This, fLock);
 }
 
 /* call_as/local stubs for objidl.idl */
@@ -2032,8 +2033,10 @@ HRESULT CALLBACK IOleInPlaceActiveObject_ResizeBorder_Proxy(
     IOleInPlaceUIWindow *pUIWindow,
     BOOL fFrameWindow)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("(%p, %p, %d)\n", prcBorder, pUIWindow, fFrameWindow);
+    /* a frame goes as one, and must be one */
+    return IOleInPlaceActiveObject_RemoteResizeBorder_Proxy(This, prcBorder,
+            fFrameWindow ? &IID_IOleInPlaceFrame : &IID_IOleInPlaceUIWindow, pUIWindow, fFrameWindow);
 }
 
 HRESULT __RPC_STUB IOleInPlaceActiveObject_ResizeBorder_Stub(
@@ -2043,8 +2046,8 @@ HRESULT __RPC_STUB IOleInPlaceActiveObject_ResizeBorder_Stub(
     IOleInPlaceUIWindow *pUIWindow,
     BOOL fFrameWindow)
 {
-    FIXME(":stub\n");
-    return E_NOTIMPL;
+    TRACE("(%p, %s, %p, %d)\n", prcBorder, debugstr_guid(riid), pUIWindow, fFrameWindow);
+    return IOleInPlaceActiveObject_ResizeBorder(This, prcBorder, pUIWindow, fFrameWindow);
 }
 
 HRESULT CALLBACK IOleCache2_UpdateCache_Proxy(
