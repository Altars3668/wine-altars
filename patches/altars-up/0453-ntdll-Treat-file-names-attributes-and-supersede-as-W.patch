+/* when a file is one to back up: the archive attribute that a new file has comes back once the file is
+ * written to, made larger or smaller, renamed or written over, not when it is only opened or read; a directory
+ * has it only when asked for */
+static void test_archive_attribute(void)
+{
+    char temp[MAX_PATH], path[MAX_PATH], path2[MAX_PATH], dir[MAX_PATH], buffer[4];
+    DWORD count;
+    HANDLE file;
+    BOOL ret;
+
+    GetTempPathA( sizeof(temp), temp );
+    sprintf( path, "%sarchive.tmp", temp );
+    sprintf( path2, "%sarchive2.tmp", temp );
+    sprintf( dir, "%sarchive.dir", temp );
+
+    file = CreateFileA( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "failed to create %s, error %lu\n", path, GetLastError() );
+    WriteFile( file, "data", 4, &count, NULL );
+    CloseHandle( file );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_ARCHIVE, "got %#lx\n", GetFileAttributesA( path ) );
+
+    SetFileAttributesA( path, FILE_ATTRIBUTE_NORMAL );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_NORMAL, "got %#lx\n", GetFileAttributesA( path ) );
+    SetFileAttributesA( path, FILE_ATTRIBUTE_TEMPORARY );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_TEMPORARY, "got %#lx\n", GetFileAttributesA( path ) );
+    SetFileAttributesA( path, FILE_ATTRIBUTE_HIDDEN );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_HIDDEN, "got %#lx\n", GetFileAttributesA( path ) );
+    /* a hidden file made read-only is hidden no more, and a read-only one can be made hidden */
+    SetFileAttributesA( path, FILE_ATTRIBUTE_READONLY );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_READONLY, "got %#lx\n", GetFileAttributesA( path ) );
+    SetFileAttributesA( path, FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_HIDDEN );
+    ok( GetFileAttributesA( path ) == (FILE_ATTRIBUTE_READONLY | FILE_ATTRIBUTE_HIDDEN), "got %#lx\n",
+        GetFileAttributesA( path ) );
+    SetFileAttributesA( path, 0 );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_NORMAL, "got %#lx\n", GetFileAttributesA( path ) );
+
+    file = CreateFileA( path, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "failed to open %s, error %lu\n", path, GetLastError() );
+    ReadFile( file, buffer, sizeof(buffer), &count, NULL );
+    CloseHandle( file );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_NORMAL, "got %#lx\n", GetFileAttributesA( path ) );
+
+    file = CreateFileA( path, GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL );
+    WriteFile( file, "x", 1, &count, NULL );
+    /* Windows says so once the file is flushed or closed */
+    todo_wine ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_NORMAL, "got %#lx\n", GetFileAttributesA( path ) );
+    CloseHandle( file );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_ARCHIVE, "got %#lx\n", GetFileAttributesA( path ) );
+
+    SetFileAttributesA( path, FILE_ATTRIBUTE_NORMAL );
+    file = CreateFileA( path, GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, NULL );
+    SetFilePointer( file, 100, NULL, FILE_BEGIN );
+    ret = SetEndOfFile( file );
+    ok( ret, "SetEndOfFile failed, error %lu\n", GetLastError() );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_ARCHIVE, "got %#lx\n", GetFileAttributesA( path ) );
+    CloseHandle( file );
+
+    SetFileAttributesA( path, FILE_ATTRIBUTE_NORMAL );
+    ret = MoveFileA( path, path2 );
+    ok( ret, "MoveFile failed, error %lu\n", GetLastError() );
+    ok( GetFileAttributesA( path2 ) == FILE_ATTRIBUTE_ARCHIVE, "got %#lx\n", GetFileAttributesA( path2 ) );
+
+    /* a copy is a new file, the original stays as it was */
+    SetFileAttributesA( path2, FILE_ATTRIBUTE_HIDDEN );
+    ret = CopyFileA( path2, path, FALSE );
+    ok( ret, "CopyFile failed, error %lu\n", GetLastError() );
+    ok( GetFileAttributesA( path ) == (FILE_ATTRIBUTE_HIDDEN | FILE_ATTRIBUTE_ARCHIVE), "got %#lx\n",
+        GetFileAttributesA( path ) );
+    ok( GetFileAttributesA( path2 ) == FILE_ATTRIBUTE_HIDDEN, "got %#lx\n", GetFileAttributesA( path2 ) );
+
+    SetFileAttributesA( path, FILE_ATTRIBUTE_NORMAL );
+    file = CreateFileA( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    CloseHandle( file );
+    ok( GetFileAttributesA( path ) == FILE_ATTRIBUTE_ARCHIVE, "got %#lx\n", GetFileAttributesA( path ) );
+
+    ret = CreateDirectoryA( dir, NULL );
+    ok( ret, "CreateDirectory failed, error %lu\n", GetLastError() );
+    ok( GetFileAttributesA( dir ) == FILE_ATTRIBUTE_DIRECTORY, "got %#lx\n", GetFileAttributesA( dir ) );
+    SetFileAttributesA( dir, FILE_ATTRIBUTE_ARCHIVE );
+    ok( GetFileAttributesA( dir ) == (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_ARCHIVE), "got %#lx\n",
+        GetFileAttributesA( dir ) );
+    SetFileAttributesA( dir, FILE_ATTRIBUTE_NORMAL );
+    ok( GetFileAttributesA( dir ) == FILE_ATTRIBUTE_DIRECTORY, "got %#lx\n", GetFileAttributesA( dir ) );
+
+    RemoveDirectoryA( dir );
+    SetFileAttributesA( path2, FILE_ATTRIBUTE_NORMAL );
+    DeleteFileA( path );
+    DeleteFileA( path2 );
+}
