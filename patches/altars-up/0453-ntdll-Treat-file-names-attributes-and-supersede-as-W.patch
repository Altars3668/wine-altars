+
+    /* a file's name with a backslash after it is not a directory's, whatever is asked for */
+    path[wcslen( path ) - 1] = 0;
+    handle = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    ok( handle != INVALID_HANDLE_VALUE, "failed to create %s, error %lu\n", debugstr_w(path), GetLastError() );
+    WriteFile( handle, "data", 4, &ret, NULL );
+    CloseHandle( handle );
+    wcscat( path, L"\\" );
+    pRtlDosPathNameToNtPathName_U( path, &nameW, NULL, NULL );
+    for (i = 0; i < ARRAY_SIZE(trailing); i++)
+    {
+        status = pNtCreateFile( &handle, GENERIC_READ, &attr, &io, NULL, 0, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                trailing[i].disposition, trailing[i].options, NULL, 0 );
+        ok( status == trailing[i].status || broken(trailing[i].status == STATUS_NOT_A_DIRECTORY &&
+            (status == STATUS_OBJECT_NAME_INVALID || status == STATUS_OBJECT_NAME_COLLISION)) /* before Windows 11 */,
+            "%lu: got %#lx\n", i, status );
+        if (!status) CloseHandle( handle );
+    }
+    status = pNtQueryAttributesFile( &attr, &info );
+    ok( status == STATUS_NOT_A_DIRECTORY || broken(status == STATUS_OBJECT_NAME_INVALID) /* before Windows 11 */,
+        "got %#lx\n", status );
+    pRtlFreeUnicodeString( &nameW );
+    path[wcslen( path ) - 1] = 0;
+
+    /* a file superseded is replaced, with no write access asked for and read-only or not */
+    pRtlDosPathNameToNtPathName_U( path, &nameW, NULL, NULL );
+    for (i = 0; i < 2; i++)
+    {
+        handle = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+        WriteFile( handle, "data", 4, &ret, NULL );
+        CloseHandle( handle );
+        if (i) SetFileAttributesW( path, FILE_ATTRIBUTE_READONLY );
+        status = pNtCreateFile( &handle, GENERIC_READ, &attr, &io, NULL, 0, FILE_SHARE_READ | FILE_SHARE_WRITE,
+                                FILE_SUPERSEDE, 0, NULL, 0 );
+        ok( !status, "%lu: got %#lx\n", i, status );
+        ok( io.Information == FILE_SUPERSEDED, "%lu: got %#Ix\n", i, io.Information );
+        CloseHandle( handle );
+        handle = CreateFileW( path, 0, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING, 0, NULL );
+        ok( GetFileSize( handle, NULL ) == 0, "%lu: got size %lu\n", i, GetFileSize( handle, NULL ) );
+        CloseHandle( handle );
+        ok( GetFileAttributesW( path ) == FILE_ATTRIBUTE_ARCHIVE, "%lu: got attributes %#lx\n",
+            i, GetFileAttributesW( path ) );
+    }
+    pRtlFreeUnicodeString( &nameW );
+    SetFileAttributesW( path, FILE_ATTRIBUTE_NORMAL );
+    DeleteFileW( path );
 }
 
