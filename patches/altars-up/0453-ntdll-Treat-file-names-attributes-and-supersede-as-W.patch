+/* empty a file superseded with no write access asked for: it is replaced all the same, read-only or
+ * not (its mode says which), and takes the attributes it is given afterwards */
+static int truncate_superseded( int unix_fd, const char *name, mode_t mode )
+{
+    int fd, ret = 0;
+
+    if (!(mode & S_IWUSR) && fchmod( unix_fd, mode | S_IWUSR ) == -1)
+    {
+        file_set_error();
+        return 0;
+    }
+    if ((fd = open( name, O_WRONLY | O_NONBLOCK )) != -1)
+    {
+        if (!(ret = !ftruncate( fd, 0 ))) file_set_error();
+        close( fd );
+    }
+    else file_set_error();
+    if (!(mode & S_IWUSR)) fchmod( unix_fd, mode );
+    return ret;
+}
