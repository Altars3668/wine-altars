+/* a file's name comes back in the case it has on disk, whatever case it was opened by */
+static void test_file_name_case(void)
+{
+    static const WCHAR name[] = L"MixedCase.Tmp";
+    const unsigned int name_len = ARRAY_SIZE(name) - 1;
+    char buffer[sizeof(OBJECT_NAME_INFORMATION) + MAX_PATH * sizeof(WCHAR)];
+    FILE_NAME_INFORMATION *info = (FILE_NAME_INFORMATION *)buffer;
+    OBJECT_NAME_INFORMATION *object = (OBJECT_NAME_INFORMATION *)buffer;
+    WCHAR temp[MAX_PATH], path[MAX_PATH], upper[MAX_PATH], result[MAX_PATH];
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    HANDLE file;
+    ULONG len;
+
+    GetTempPathW( ARRAY_SIZE(temp), temp );
+    swprintf( path, ARRAY_SIZE(path), L"%s%s", temp, name );
+    file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "failed to create %s, error %lu\n", debugstr_w(path), GetLastError() );
+    CloseHandle( file );
+
+    wcscpy( upper, path );
+    CharUpperW( upper + wcslen( temp ) );
+    file = CreateFileW( upper, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "failed to open %s, error %lu\n", debugstr_w(upper), GetLastError() );
+
+    status = pNtQueryInformationFile( file, &io, info, sizeof(buffer), FileNameInformation );
+    ok( !status, "got %#lx\n", status );
+    len = info->FileNameLength / sizeof(WCHAR);
+    ok( len >= name_len && !memcmp( info->FileName + len - name_len, name, name_len * sizeof(WCHAR) ),
+        "got %s\n", debugstr_wn( info->FileName, len ) );
+
+    status = NtQueryObject( file, ObjectNameInformation, object, sizeof(buffer), &len );
+    ok( !status, "got %#lx\n", status );
+    len = object->Name.Length / sizeof(WCHAR);
+    ok( len >= name_len && !memcmp( object->Name.Buffer + len - name_len, name, name_len * sizeof(WCHAR) ),
+        "got %s\n", debugstr_wn( object->Name.Buffer, len ) );
+
+    len = GetFinalPathNameByHandleW( file, result, ARRAY_SIZE(result), FILE_NAME_OPENED );
+    ok( len >= name_len && !wcscmp( result + len - name_len, name ), "got %s\n", debugstr_w(result) );
+    len = GetFinalPathNameByHandleW( file, result, ARRAY_SIZE(result), FILE_NAME_NORMALIZED );
+    ok( len >= name_len && !wcscmp( result + len - name_len, name ), "got %s\n", debugstr_w(result) );
+
+    CloseHandle( file );
+    DeleteFileW( path );
+}
