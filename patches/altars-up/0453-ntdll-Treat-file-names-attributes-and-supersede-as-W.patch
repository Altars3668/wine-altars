+/* the name a file is opened by goes back to the program as the file system has it: each element in the case
+ * it has on disk, a short name in capitals as it is stored, and the drive letter in capitals; helper for
+ * NtCreateFile, which gives the server the name.  A module's name keeps the case it was asked for, so the
+ * name the loader looks up is left alone. */
+static void set_name_case( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *nt_name, const char *unix_name )
+{
+    static const WCHAR prefixW[] = {'\\','?','?','\\'};
+    UNICODE_STRING *name = attr->ObjectName;
+    unsigned int len = name->Length / sizeof(WCHAR), first = 0;
+    WCHAR comp[MAX_DIR_ENTRY_LEN + 1], *buffer, *start, *end, *p;
+    const char *unix_start, *unix_end;
+    int ret;
+
+    if (!attr->RootDirectory)
+    {
+        /* only the names of drives, \??\X: */
+        if (len < 6 || memcmp( name->Buffer, prefixW, sizeof(prefixW) ) || name->Buffer[5] != ':') return;
+        first = 6;
+    }
+    if (name != nt_name)  /* not already redirected, make a copy */
+    {
+        if (!(buffer = malloc( name->Length ))) return;
+        memcpy( buffer, name->Buffer, name->Length );
+        nt_name->Buffer = buffer;
+        nt_name->Length = nt_name->MaximumLength = name->Length;
+        attr->ObjectName = name = nt_name;
+    }
+    buffer = name->Buffer;
+    if (first) buffer[4] = ntdll_towupper( buffer[4] );
+
+    /* the elements of the two names are the same from the end */
+    end = buffer + len;
+    unix_end = unix_name + strlen( unix_name );
+    for (;;)
+    {
+        while (end > buffer + first && end[-1] == '\\') end--;
+        while (unix_end > unix_name && unix_end[-1] == '/') unix_end--;
+        if (end == buffer + first) break;
+        for (start = end; start > buffer + first && start[-1] != '\\'; start--) ;
+        for (unix_start = unix_end; unix_start > unix_name && unix_start[-1] != '/'; unix_start--) ;
+        if (unix_start == unix_name) break;
+
+        ret = ntdll_umbstowcs( unix_start, unix_end - unix_start, comp, MAX_DIR_ENTRY_LEN );
+        if (ret > 0 && comp[ret - 1] == '?') ret--;  /* stored as a reparse point */
+        if (ret == end - start && !wcsnicmp( comp, start, ret )) memcpy( start, comp, ret * sizeof(WCHAR) );
+        else
+        {
+            for (p = start; p < end; p++) if (*p == '~') break;
+            if (p < end) for (p = start; p < end; p++) *p = ntdll_towupper( *p );
+        }
+        end = start;
+        unix_end = unix_start;
+    }
