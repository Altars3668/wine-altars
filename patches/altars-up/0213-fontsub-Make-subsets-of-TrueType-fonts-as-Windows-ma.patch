+    GetGlyphIndicesW( hdc, L"A", 1, &a, 0 );
+    GetGlyphIndicesW( hdc, L"H", 1, &h, 0 );
+    table = find_table( font, size, "maxp", &table_len );
+    glyph_count = be16( table + 4 );
+
+    /* the outlines are on even offsets and short ones do */
+    keep[0] = h;
+    package = NULL;
+    ret = CreateFontPackage( font, size, &package, &package_size, &written, TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST,
+                             0, TTFCFP_SUBSET, 0, TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, keep, 1, alloc_proc,
