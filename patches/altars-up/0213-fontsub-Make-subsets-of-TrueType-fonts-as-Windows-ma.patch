+/* a cmap mapping 'H' to the glyph, for Windows in format 4 and in format 12 */
+static const BYTE cmap_template[] =
+{
+    0x00, 0x00, 0x00, 0x02,
+    0x00, 0x03, 0x00, 0x01, 0x00, 0x00, 0x00, 0x14,
+    0x00, 0x03, 0x00, 0x0a, 0x00, 0x00, 0x00, 0x34,
+    /* format 4: 'H', then the last segment */
+    0x00, 0x04, 0x00, 0x20, 0x00, 0x00, 0x00, 0x04, 0x00, 0x04, 0x00, 0x01, 0x00, 0x00,
+    0x00, 0x48, 0xff, 0xff, 0x00, 0x00, 0x00, 0x48, 0xff, 0xff, 0x00, 0x00, 0x00, 0x01, 0x00, 0x00, 0x00, 0x00,
+    /* format 12: 'H' */
+    0x00, 0x0c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x1c, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x01,
+    0x00, 0x00, 0x00, 0x48, 0x00, 0x00, 0x00, 0x48, 0x00, 0x00, 0x00, 0x00,
+};
+
+static const BYTE *make_cmap( WORD glyph )
+{
+    static BYTE cmap[sizeof(cmap_template)];
+
+    memcpy( cmap, cmap_template, sizeof(cmap) );
+    put_be16( cmap + 20 + 24, glyph - 'H' );
+    put_be32( cmap + 52 + 24, glyph );
+    return cmap;
+}
