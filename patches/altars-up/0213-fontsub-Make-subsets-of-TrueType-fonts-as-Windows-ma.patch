+static const BYTE *find_subtable( const BYTE *font, ULONG size, unsigned int platform, unsigned int encoding, ULONG *length )
+{
+    const BYTE *cmap;
+    ULONG cmap_len;
+    unsigned int i;
+
+    if (!(cmap = find_table( font, size, "cmap", &cmap_len ))) return NULL;
+    for (i = 0; i < be16( cmap + 2 ); i++)
+    {
+        const BYTE *record = cmap + 4 + i * 8, *sub = cmap + be32( record + 4 );
+
+        if (be16( record ) != platform || be16( record + 2 ) != encoding) continue;
+        *length = be16( sub ) >= 8 ? be32( sub + (be16( sub ) == 14 ? 2 : 4)) : be16( sub + 2 );
+        return sub;
+    }
+    return NULL;
+}
+
+/* a cmap of format 4 subtables mapping 'A' to 'Z' to the glyphs from that of 'A' on through an array of glyphs, for the
+ * Unicode and the Microsoft platforms, sharing one subtable or each with its own; and one with a format 14 subtable */
+static BYTE *make_letters_cmap( WORD a, BOOL shared, BOOL variations, ULONG *length )
+{
+    static const BYTE format14[] =
+    {
+        0x00, 0x0e, 0x00, 0x00, 0x00, 0x23, 0x00, 0x00, 0x00, 0x01,
+        0x00, 0xfe, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x15,
+        0x00, 0x00, 0x00, 0x02, 0x00, 0x00, 0x48, 0x00, 0x00, 0x00, 0x00, 0x5a, 0x00, 0x00,
+    };
+    BYTE *cmap = calloc( 1, 512 ), *format4;
+    unsigned int records = variations ? 3 : 2, at = 4 + records * 8, i = 0, k;
+
+    put_be16( cmap + 2, records );
+    if (variations)
+    {
+        put_be16( cmap + 4, 0 );
+        put_be16( cmap + 6, 5 );
+        put_be32( cmap + 8, at );
+        memcpy( cmap + at, format14, sizeof(format14) );
+        put_be16( cmap + at + 28, a + 'H' - 'A' );
+        put_be16( cmap + at + 33, a + 'Z' - 'A' );
+        at += sizeof(format14) + 1;
+        i++;
+    }
+    put_be16( cmap + 4 + i * 8, 0 );
+    put_be16( cmap + 6 + i * 8, 3 );
+    put_be32( cmap + 8 + i * 8, at );
+    put_be16( cmap + 12 + i * 8, 3 );
+    put_be16( cmap + 14 + i * 8, 1 );
+    put_be32( cmap + 16 + i * 8, shared ? at : at + 84 );
+    format4 = cmap + at;
+    put_be16( format4, 4 );
+    put_be16( format4 + 2, 84 );
+    put_be16( format4 + 6, 4 );
+    put_be16( format4 + 8, 4 );
+    put_be16( format4 + 10, 1 );
+    put_be16( format4 + 14, 'Z' );
+    put_be16( format4 + 16, 0xffff );
+    put_be16( format4 + 20, 'A' );
+    put_be16( format4 + 22, 0xffff );
+    put_be16( format4 + 26, 1 );
+    put_be16( format4 + 28, 4 );
+    for (k = 0; k < 26; k++) put_be16( format4 + 32 + k * 2, a + k );
+    at += 84;
+    if (!shared)
+    {
+        memcpy( cmap + at, format4, 84 );
+        at += 84;
+    }
+    *length = at;
+    return cmap;
+}
+
+/* a name table of strings of the Microsoft platform in English */
+static BYTE *make_name( const WCHAR *const *strings, unsigned int count, ULONG *length )
+{
+    unsigned int i, j, header = 6 + count * 12, at = header;
+    BYTE *name = calloc( 1, 4096 );
+
+    put_be16( name + 2, count );
+    put_be16( name + 4, header );
+    for (i = 0; i < count; i++)
+    {
+        BYTE *record = name + 6 + i * 12;
+
+        put_be16( record, 3 );
+        put_be16( record + 2, 1 );
+        put_be16( record + 4, 0x409 );
+        put_be16( record + 6, i );
+        put_be16( record + 8, lstrlenW( strings[i] ) * 2 );
+        put_be16( record + 10, at - header );
+        for (j = 0; strings[i][j]; j++, at += 2) put_be16( name + at, strings[i][j] );
+    }
+    *length = at;
+    return name;
+}
