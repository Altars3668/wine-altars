+#include <stdarg.h>
+#include <stdlib.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "fontsub.h"
+
+#include "wine/test.h"
+
+static void *__cdecl alloc_proc( size_t size ) { return malloc( size ); }
+static void *__cdecl realloc_proc( void *ptr, size_t size ) { return realloc( ptr, size ); }
+static void __cdecl free_proc( void *ptr ) { free( ptr ); }
+
+static unsigned int be16( const BYTE *p ) { return (p[0] << 8) | p[1]; }
+static unsigned int be32( const BYTE *p ) { return ((unsigned int)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3]; }
+
+static const BYTE *find_table( const BYTE *font, ULONG size, const char *tag, ULONG *length )
+{
+    unsigned int i, count;
+
+    if (size < 12) return NULL;
+    count = be16( font + 4 );
+    for (i = 0; i < count && 12 + i * 16 + 16 <= size; i++)
+    {
+        const BYTE *entry = font + 12 + i * 16;
+
+        if (memcmp( entry, tag, 4 )) continue;
+        if (be32( entry + 8 ) > size || size - be32( entry + 8 ) < be32( entry + 12 )) return NULL;
+        *length = be32( entry + 12 );
+        return font + be32( entry + 8 );
+    }
+    return NULL;
+}
+
+static ULONG glyph_length( const BYTE *font, ULONG size, unsigned int glyph, const BYTE **data )
+{
+    const BYTE *head, *loca, *glyf;
+    ULONG head_len, loca_len, glyf_len, start, end;
+
+    head = find_table( font, size, "head", &head_len );
+    loca = find_table( font, size, "loca", &loca_len );
+    glyf = find_table( font, size, "glyf", &glyf_len );
+    if (!head || !loca || !glyf) return ~0u;
+    if (be16( head + 50 ))
+    {
+        start = be32( loca + glyph * 4 );
+        end = be32( loca + glyph * 4 + 4 );
+    }
+    else
+    {
+        start = be16( loca + glyph * 2 ) * 2;
+        end = be16( loca + glyph * 2 + 2 ) * 2;
+    }
+    *data = glyf + start;
+    return end - start;
+}
+
+static unsigned int advance_width( const BYTE *font, ULONG size, unsigned int glyph )
+{
+    const BYTE *hhea, *hmtx;
+    ULONG hhea_len, hmtx_len;
+    unsigned int count;
+
+    hhea = find_table( font, size, "hhea", &hhea_len );
+    hmtx = find_table( font, size, "hmtx", &hmtx_len );
+    count = be16( hhea + 34 );
+    return be16( hmtx + (glyph < count ? glyph : count - 1) * 4 );
+}
+
+/* the glyph a format 4 subtable of the Windows Unicode cmap gives a character */
+static int map_char( const BYTE *font, ULONG size, WCHAR ch )
+{
+    const BYTE *cmap, *sub = NULL;
+    ULONG cmap_len;
+    unsigned int i, count, segs;
+
+    if (!(cmap = find_table( font, size, "cmap", &cmap_len ))) return -1;
+    count = be16( cmap + 2 );
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *record = cmap + 4 + i * 8;
+        if (be16( record ) == 3 && be16( record + 2 ) == 1 && be16( cmap + be32( record + 4 )) == 4)
+            sub = cmap + be32( record + 4 );
+    }
+    if (!sub) return -1;
+    segs = be16( sub + 6 ) / 2;
+    for (i = 0; i < segs; i++)
+    {
+        unsigned int end = be16( sub + 14 + i * 2 ), start = be16( sub + 16 + segs * 2 + i * 2 );
+        unsigned int delta = be16( sub + 16 + segs * 4 + i * 2 ), range = be16( sub + 16 + segs * 6 + i * 2 ), glyph;
+
+        if (ch > end) continue;
+        if (ch < start) return 0;
+        if (!range) return (ch + delta) & 0xffff;
+        glyph = be16( sub + 16 + segs * 6 + i * 2 + range + (ch - start) * 2 );
+        return glyph ? (glyph + delta) & 0xffff : 0;
+    }
+    return 0;
+}
+
+static BOOL checksums_valid( const BYTE *font, ULONG size )
+{
+    unsigned int i, j, count = be16( font + 4 ), total = 0;
+
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *entry = font + 12 + i * 16;
+        unsigned int offset = be32( entry + 8 ), length = be32( entry + 12 ), sum = 0;
+
+        if (offset % 4) return FALSE;
+        for (j = 0; j < (length + 3) / 4; j++)
+        {
+            BYTE word[4] = {0};
+
+            if (!memcmp( entry, "head", 4 ) && j == 2) continue;
+            memcpy( word, font + offset + j * 4, min( 4, length - j * 4 ));
+            sum += be32( word );
+        }
+        if (sum != be32( entry + 4 )) return FALSE;
+    }
+    for (i = 0; i < size / 4; i++) total += be32( font + i * 4 );
+    return total == 0xb1b0afba;
+}
+
+static void put_be16( BYTE *p, unsigned int value ) { p[0] = value >> 8; p[1] = value; }
+static void put_be32( BYTE *p, unsigned int value ) { put_be16( p, value >> 16 ); put_be16( p + 2, value ); }
+
+static BOOL has_tag( const char *tags, const BYTE *tag )
+{
+    if (!tags) return TRUE;
+    for (; *tags; tags += 4) if (!memcmp( tags, tag, 4 )) return TRUE;
+    return FALSE;
+}
+
+/* a font of the tables of another that are in the list of tags (all without one), with one table replaced when one is
+ * given */
+static BYTE *make_font( const BYTE *font, const char *tags, const char *tag, const BYTE *table, ULONG table_len,
+                        ULONG *made_size )
+{
+    unsigned int i, j, count = be16( font + 4 ), made_count = 0;
+    ULONG offset, length;
+    BYTE *made;
+
+    for (i = 0, offset = 0; i < count; i++)
+    {
+        const BYTE *entry = font + 12 + i * 16;
+
+        if (!has_tag( tags, entry )) continue;
+        made_count++;
+        offset += (be32( entry + 12 ) + 3) & ~3;
+    }
+    if (table) offset += (table_len + 3) & ~3;
+    offset += 12 + made_count * 16;
+    if (!(made = calloc( 1, offset ))) return NULL;
+    *made_size = offset;
+    put_be32( made, 0x00010000 );
+    put_be16( made + 4, made_count );
+    offset = 12 + made_count * 16;
+    for (i = 0, j = 0; i < count; i++)
+    {
+        const BYTE *entry = font + 12 + i * 16, *data = font + be32( entry + 8 );
+        BYTE *made_entry = made + 12 + j * 16;
+        unsigned int k, sum = 0;
+
+        if (!has_tag( tags, entry )) continue;
+        length = be32( entry + 12 );
+        if (table && !memcmp( entry, tag, 4 ))
+        {
+            data = table;
+            length = table_len;
+        }
+        memcpy( made + offset, data, length );
+        for (k = 0; k < (length + 3) / 4; k++) sum += be32( made + offset + k * 4 );
+        memcpy( made_entry, entry, 4 );
+        put_be32( made_entry + 4, sum );
+        put_be32( made_entry + 8, offset );
+        put_be32( made_entry + 12, length );
+        offset += (length + 3) & ~3;
+        j++;
+    }
+    return made;
+}
