 WINE_DEFAULT_DEBUG_CHANNEL(fontsub);
 
+/* A subset keeps the glyph indices of the font: the glyphs it does not keep lose their outlines and metrics, and the
+ * character maps lose the characters that map to them, but every other table stays as it is.  What it keeps besides
+ * the glyphs asked for is what Windows keeps: the first three glyphs, the justification extenders, the glyphs of a few
+ * characters when a list is given, the components of composite glyphs and every glyph a substitution can make. */
+
+#define TAG(a, b, c, d) (((UINT32)(a) << 24) | ((UINT32)(b) << 16) | ((UINT32)(c) << 8) | (UINT32)(d))
+
+static inline UINT16 get_be16( const BYTE *p ) { return (p[0] << 8) | p[1]; }
+static inline UINT32 get_be24( const BYTE *p ) { return (p[0] << 16) | (p[1] << 8) | p[2]; }
+static inline UINT32 get_be32( const BYTE *p ) { return ((UINT32)p[0] << 24) | (p[1] << 16) | (p[2] << 8) | p[3]; }
+static inline void put_be16( BYTE *p, UINT16 v ) { p[0] = v >> 8; p[1] = v; }
+static inline void put_be24( BYTE *p, UINT32 v ) { p[0] = v >> 16; p[1] = v >> 8; p[2] = v; }
+static inline void put_be32( BYTE *p, UINT32 v ) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }
+
+struct table
+{
+    UINT32 tag;
+    const BYTE *data;
+    UINT32 len;
+};
+
+struct font
+{
+    struct table *tables;
+    unsigned int count;
+};
+
+static const struct table *find_table( const struct font *font, UINT32 tag )
+{
+    unsigned int i;
+
+    for (i = 0; i < font->count; i++) if (font->tables[i].tag == tag) return &font->tables[i];
+    return NULL;
+}
+
+/* the tables of the face at offset, leaving out any that do not lie within the data */
+static ULONG read_font( const BYTE *data, ULONG len, ULONG offset, struct font *font )
+{
+    UINT32 version;
+    unsigned int i, count;
+
+    if (offset > len || len - offset < 12) return ERR_NO_GLYPHS;
+    version = get_be32( data + offset );
+    if (version != 0x00010000 && version != TAG('t','r','u','e')) return ERR_NO_GLYPHS;
+    count = get_be16( data + offset + 4 );
+    if (len - offset - 12 < count * 16) return ERR_NO_GLYPHS;
+    if (!(font->tables = calloc( count, sizeof(*font->tables) ))) return ERR_MEM;
+    font->count = 0;
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *record = data + offset + 12 + i * 16;
+        UINT32 table_offset = get_be32( record + 8 ), table_len = get_be32( record + 12 );
+
+        if (table_offset > len || len - table_offset < table_len) continue;
+        font->tables[font->count].tag = get_be32( record );
+        font->tables[font->count].data = data + table_offset;
+        font->tables[font->count].len = table_len;
+        font->count++;
+    }
+    return NO_ERROR;
+}
+
+struct glyphs
+{
+    BYTE *bits;
+    unsigned int count;
+    BOOL changed;
+};
+
+static BOOL is_kept( const struct glyphs *glyphs, unsigned int glyph )
+{
+    return glyph < glyphs->count && (glyphs->bits[glyph / 8] & (1 << (glyph % 8)));
+}
+
+static void keep_glyph( struct glyphs *glyphs, unsigned int glyph )
+{
+    if (glyph >= glyphs->count || is_kept( glyphs, glyph )) return;
+    glyphs->bits[glyph / 8] |= 1 << (glyph % 8);
+    glyphs->changed = TRUE;
+}
+
+/* the offset and length of a glyph's outline in glyf */
+static BOOL get_glyph_span( const struct table *loca, BOOL long_loca, const struct table *glyf, unsigned int glyph,
+                            UINT32 *start, UINT32 *length )
+{
+    UINT32 end;
+
+    if (long_loca)
+    {
+        if ((glyph + 2) * 4 > loca->len) return FALSE;
+        *start = get_be32( loca->data + glyph * 4 );
+        end = get_be32( loca->data + glyph * 4 + 4 );
+    }
+    else
+    {
+        if ((glyph + 2) * 2 > loca->len) return FALSE;
+        *start = get_be16( loca->data + glyph * 2 ) * 2;
+        end = get_be16( loca->data + glyph * 2 + 2 ) * 2;
+    }
+    if (end < *start || end > glyf->len) return FALSE;
+    *length = end - *start;
+    return TRUE;
+}
+
+/* the glyphs composite glyphs are made of */
+static void keep_components( struct glyphs *glyphs, const struct table *loca, BOOL long_loca, const struct table *glyf )
+{
+    unsigned int glyph;
+
+    for (glyph = 0; glyph < glyphs->count; glyph++)
+    {
+        const BYTE *p, *end;
+        UINT32 start, length;
+        UINT16 flags;
+
+        if (!is_kept( glyphs, glyph )) continue;
+        if (!get_glyph_span( loca, long_loca, glyf, glyph, &start, &length ) || length < 10) continue;
+        p = glyf->data + start;
+        end = p + length;
+        if ((INT16)get_be16( p ) >= 0) continue;
+        p += 10;
+        do
+        {
+            if (end - p < 4) break;
+            flags = get_be16( p );
+            keep_glyph( glyphs, get_be16( p + 2 ));
+            p += 4 + ((flags & 0x0001) ? 4 : 2);                   /* ARG_1_AND_2_ARE_WORDS */
+            if (flags & 0x0008) p += 2;                            /* WE_HAVE_A_SCALE */
+            else if (flags & 0x0040) p += 4;                       /* WE_HAVE_AN_X_AND_Y_SCALE */
+            else if (flags & 0x0080) p += 8;                       /* WE_HAVE_A_TWO_BY_TWO */
+        } while (flags & 0x0020);                                  /* MORE_COMPONENTS */
+    }
+}
+
+/* calls back for each glyph of an OpenType coverage table, with its coverage index */
+static void enum_coverage( const BYTE *table, UINT32 len, UINT32 offset,
+                           void (*callback)( unsigned int glyph, unsigned int index, void *context ), void *context )
+{
+    const BYTE *coverage = table + offset;
+    unsigned int i, count, index = 0;
+
+    if (offset > len || len - offset < 4) return;
+    count = get_be16( coverage + 2 );
+    if (get_be16( coverage ) == 1)
+    {
+        if (len - offset - 4 < count * 2) return;
+        for (i = 0; i < count; i++) callback( get_be16( coverage + 4 + i * 2 ), i, context );
+    }
+    else if (get_be16( coverage ) == 2)
+    {
+        if (len - offset - 4 < count * 6) return;
+        for (i = 0; i < count; i++)
+        {
+            const BYTE *range = coverage + 4 + i * 6;
+            unsigned int glyph, first = get_be16( range ), last = get_be16( range + 2 );
+
+            index = get_be16( range + 4 );
+            for (glyph = first; glyph <= last; glyph++) callback( glyph, index++, context );
+        }
+    }
+}
+
+struct substitution
+{
+    struct glyphs *glyphs;
+    const BYTE *table;     /* the GSUB table */
+    UINT32 len;
+    UINT32 subtable;       /* the offset of the subtable in it */
+    UINT16 type;
+};
+
+static BOOL in_table( const struct substitution *sub, UINT32 offset, UINT32 size )
+{
+    return offset <= sub->len && sub->len - offset >= size;
+}
+
+static void substitute_glyph( unsigned int glyph, unsigned int index, void *context )
+{
+    const struct substitution *sub = context;
+    const BYTE *st = sub->table + sub->subtable;
+    UINT32 offset, count, i;
+
+    if (!is_kept( sub->glyphs, glyph )) return;
+    switch (sub->type)
+    {
+    case 1:  /* single */
+        if (get_be16( st ) == 1)
+            keep_glyph( sub->glyphs, (glyph + get_be16( st + 4 )) & 0xffff );
+        else if (in_table( sub, sub->subtable + 6 + index * 2, 2 ) && index < get_be16( st + 4 ))
+            keep_glyph( sub->glyphs, get_be16( st + 6 + index * 2 ));
+        break;
+    case 2:  /* multiple */
+    case 3:  /* alternate */
+        if (index >= get_be16( st + 4 ) || !in_table( sub, sub->subtable + 6 + index * 2, 2 )) break;
+        offset = sub->subtable + get_be16( st + 6 + index * 2 );
+        if (!in_table( sub, offset, 2 )) break;
+        count = get_be16( sub->table + offset );
+        if (!in_table( sub, offset + 2, count * 2 )) break;
+        for (i = 0; i < count; i++) keep_glyph( sub->glyphs, get_be16( sub->table + offset + 2 + i * 2 ));
+        break;
+    case 4:  /* ligature: the ligature is kept when all its components are */
+        if (index >= get_be16( st + 4 ) || !in_table( sub, sub->subtable + 6 + index * 2, 2 )) break;
+        offset = sub->subtable + get_be16( st + 6 + index * 2 );
+        if (!in_table( sub, offset, 2 )) break;
+        count = get_be16( sub->table + offset );
+        for (i = 0; i < count; i++)
+        {
+            UINT32 ligature, components, j;
+
+            if (!in_table( sub, offset + 2 + i * 2, 2 )) break;
+            ligature = offset + get_be16( sub->table + offset + 2 + i * 2 );
+            if (!in_table( sub, ligature, 4 )) continue;
+            components = get_be16( sub->table + ligature + 2 );
+            if (!components || !in_table( sub, ligature + 4, (components - 1) * 2 )) continue;
+            for (j = 1; j < components; j++)
+                if (!is_kept( sub->glyphs, get_be16( sub->table + ligature + 4 + (j - 1) * 2 ))) break;
+            if (j == components) keep_glyph( sub->glyphs, get_be16( sub->table + ligature ));
+        }
+        break;
+    case 8:  /* reverse chaining contextual single */
+    {
+        UINT32 backtrack, lookahead, p = sub->subtable + 4;
+
+        if (!in_table( sub, p, 2 )) break;
+        backtrack = get_be16( sub->table + p );
+        p += 2 + backtrack * 2;
+        if (!in_table( sub, p, 2 )) break;
+        lookahead = get_be16( sub->table + p );
+        p += 2 + lookahead * 2;
+        if (!in_table( sub, p, 2 ) || index >= get_be16( sub->table + p )) break;
+        if (in_table( sub, p + 2 + index * 2, 2 )) keep_glyph( sub->glyphs, get_be16( sub->table + p + 2 + index * 2 ));
+        break;
+    }
+    }
+}
+
+/* every glyph a substitution of any lookup can turn the kept glyphs into; the contextual lookups only apply other
+ * lookups, which are all gone through anyway */
+static void keep_substitutions( struct glyphs *glyphs, const struct table *gsub )
+{
+    struct substitution sub = { glyphs, gsub ? gsub->data : NULL, gsub ? gsub->len : 0 };
+    UINT32 lookups;
+    unsigned int i, j, count;
+
+    if (!gsub || gsub->len < 10) return;
+    lookups = get_be16( gsub->data + 8 );
+    if (!in_table( &sub, lookups, 2 )) return;
+    count = get_be16( gsub->data + lookups );
+    for (i = 0; i < count; i++)
+    {
+        UINT32 lookup, subtables;
+        UINT16 type;
+
+        if (!in_table( &sub, lookups + 2 + i * 2, 2 )) break;
+        lookup = lookups + get_be16( gsub->data + lookups + 2 + i * 2 );
+        if (!in_table( &sub, lookup, 6 )) continue;
+        type = get_be16( gsub->data + lookup );
+        subtables = get_be16( gsub->data + lookup + 4 );
+        for (j = 0; j < subtables; j++)
+        {
+            if (!in_table( &sub, lookup + 6 + j * 2, 2 )) break;
+            sub.subtable = lookup + get_be16( gsub->data + lookup + 6 + j * 2 );
+            sub.type = type;
+            if (type == 7)  /* extension */
+            {
+                if (!in_table( &sub, sub.subtable, 8 )) continue;
+                sub.type = get_be16( gsub->data + sub.subtable + 2 );
+                sub.subtable += get_be32( gsub->data + sub.subtable + 4 );
+            }
+            if (!in_table( &sub, sub.subtable, 6 )) continue;
+            if (sub.type < 1 || (sub.type > 4 && sub.type != 8)) continue;
+            enum_coverage( gsub->data, gsub->len, sub.subtable + get_be16( gsub->data + sub.subtable + 2 ),
+                           substitute_glyph, &sub );
+        }
+    }
+}
+
+/* the glyphs of the layers of kept color glyphs */
+static void keep_color_layers( struct glyphs *glyphs, const struct table *colr )
+{
+    UINT32 bases, layers;
+    unsigned int i, j, count, layer_count;
+
+    if (!colr || colr->len < 14 || get_be16( colr->data )) return;
+    count = get_be16( colr->data + 2 );
+    bases = get_be32( colr->data + 4 );
+    layers = get_be32( colr->data + 8 );
+    layer_count = get_be16( colr->data + 12 );
+    if (bases > colr->len || colr->len - bases < count * 6 || layers > colr->len || colr->len - layers < layer_count * 4)
+        return;
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *base = colr->data + bases + i * 6;
+        unsigned int first = get_be16( base + 2 ), number = get_be16( base + 4 );
+
+        if (!is_kept( glyphs, get_be16( base ))) continue;
+        for (j = first; j < first + number && j < layer_count; j++) keep_glyph( glyphs, get_be16( colr->data + layers + j * 4 ));
+    }
+}
+
+/* the extender glyphs of the justification table, which Windows keeps whatever the text */
+static void keep_extenders( struct glyphs *glyphs, const struct table *jstf )
+{
+    unsigned int i, j, count;
+
+    if (!jstf || jstf->len < 6) return;
+    count = get_be16( jstf->data + 4 );
+    for (i = 0; i < count && 6 + i * 6 + 6 <= jstf->len; i++)
+    {
+        UINT32 script = get_be16( jstf->data + 6 + i * 6 + 4 ), extenders, glyph_count;
+
+        if (script + 2 > jstf->len || !get_be16( jstf->data + script )) continue;
+        extenders = script + get_be16( jstf->data + script );
+        if (extenders + 2 > jstf->len) continue;
+        glyph_count = get_be16( jstf->data + extenders );
+        for (j = 0; j < glyph_count && extenders + 2 + j * 2 + 2 <= jstf->len; j++)
+            keep_glyph( glyphs, get_be16( jstf->data + extenders + 2 + j * 2 ));
+    }
+}
+
+/* the mappings of a cmap subtable */
+static BOOL enum_cmap( const BYTE *sub, UINT32 avail, BOOL (*callback)( UINT32 ch, UINT32 glyph, void *context ),
+                       void *context )
+{
+    UINT32 i, j, count;
+
+    if (avail < 4) return FALSE;
+    switch (get_be16( sub ))
+    {
+    case 0:
+        if (avail < 262) return FALSE;
+        for (i = 0; i < 256; i++) if (sub[6 + i] && !callback( i, sub[6 + i], context )) return TRUE;
+        return TRUE;
+    case 4:
+    {
+        UINT32 segs, length = get_be16( sub + 2 );
+
+        if (avail < 14 || length > avail) length = avail;
+        segs = get_be16( sub + 6 ) / 2;
+        if (length < 16 + segs * 8) return FALSE;
+        for (i = 0; i < segs; i++)
+        {
+            UINT32 end = get_be16( sub + 14 + i * 2 ), start = get_be16( sub + 16 + segs * 2 + i * 2 );
+            UINT16 delta = get_be16( sub + 16 + segs * 4 + i * 2 );
+            UINT32 range = 16 + segs * 6 + i * 2, range_offset = get_be16( sub + range );
+
+            for (j = start; j <= end && j != 0xffff; j++)
+            {
+                UINT32 glyph;
+
+                if (!range_offset) glyph = (j + delta) & 0xffff;
+                else
+                {
+                    UINT32 at = range + range_offset + (j - start) * 2;
+
+                    if (at + 2 > length) break;
+                    glyph = get_be16( sub + at );
+                    if (glyph) glyph = (glyph + delta) & 0xffff;
+                }
+                if (glyph && !callback( j, glyph, context )) return TRUE;
+            }
+        }
+        return TRUE;
+    }
+    case 6:
+    {
+        UINT32 first = get_be16( sub + 6 );
+
+        if (avail < 10) return FALSE;
+        count = get_be16( sub + 8 );
+        if (avail < 10 + count * 2) return FALSE;
+        for (i = 0; i < count; i++)
+        {
+            UINT32 glyph = get_be16( sub + 10 + i * 2 );
+            if (glyph && !callback( first + i, glyph, context )) return TRUE;
+        }
+        return TRUE;
+    }
+    case 12:
+    case 13:
+        if (avail < 16) return FALSE;
+        count = get_be32( sub + 12 );
+        if ((avail - 16) / 12 < count) return FALSE;
+        for (i = 0; i < count; i++)
+        {
+            const BYTE *group = sub + 16 + i * 12;
+            UINT32 start = get_be32( group ), end = get_be32( group + 4 ), glyph = get_be32( group + 8 );
+
+            if (end < start || end > 0x10ffff) continue;
+            for (j = start; j <= end; j++)
+            {
+                UINT32 mapped = get_be16( sub ) == 12 ? glyph + j - start : glyph;
+
+                /* as in the other formats, glyph 0 maps nothing */
+                if (mapped && !callback( j, mapped, context )) return TRUE;
+            }
+        }
+        return TRUE;
+    }
+    return FALSE;
+}
+
+struct lookup
+{
+    UINT32 ch;
+    UINT32 glyph;
+};
+
+static BOOL find_char( UINT32 ch, UINT32 glyph, void *context )
+{
+    struct lookup *lookup = context;
+
+    if (ch != lookup->ch) return TRUE;
+    lookup->glyph = glyph;
+    return FALSE;
+}
+
+/* the cmap subtable characters are looked up in: the one of the platform and encoding asked for, any of the
+ * platform's for TTFCFP_DONT_CARE, the one with the widest coverage first */
+static const BYTE *find_cmap( const struct table *cmap, UINT16 platform, UINT16 encoding, UINT32 *avail )
+{
+    static const UINT16 formats[] = { 12, 4, 6, 0 };
+    unsigned int i, f, count;
+
+    if (!cmap || cmap->len < 4) return NULL;
+    count = get_be16( cmap->data + 2 );
+    for (f = 0; f < ARRAY_SIZE(formats); f++)
+    {
+        for (i = 0; i < count && 4 + i * 8 + 8 <= cmap->len; i++)
+        {
+            const BYTE *record = cmap->data + 4 + i * 8;
+            UINT32 offset = get_be32( record + 4 );
+
+            if (get_be16( record ) != platform) continue;
+            if (encoding != TTFCFP_DONT_CARE && get_be16( record + 2 ) != encoding) continue;
+            if (offset + 4 > cmap->len || get_be16( cmap->data + offset ) != formats[f]) continue;
+            *avail = cmap->len - offset;
+            return cmap->data + offset;
+        }
+    }
+    return NULL;
+}
+
+static UINT32 map_char( const BYTE *sub, UINT32 avail, BOOL symbol, UINT32 ch )
+{
+    struct lookup lookup = { ch, 0 };
+
+    if (!sub) return 0;
+    enum_cmap( sub, avail, find_char, &lookup );
+    if (!lookup.glyph && symbol && ch < 0x100)
+    {
+        lookup.ch = ch | 0xf000;
+        enum_cmap( sub, avail, find_char, &lookup );
+    }
+    return lookup.glyph;
+}
+
+/* a growing buffer for a table */
+struct buffer
+{
+    BYTE *data;
+    UINT32 len;
+    UINT32 size;
+    BOOL failed;
+};
+
+static BYTE *buffer_grow( struct buffer *buffer, UINT32 len )
+{
+    BYTE *p;
+
+    if (buffer->failed) return NULL;
+    if (buffer->size - buffer->len < len)
+    {
+        UINT32 size = max( buffer->size * 2, buffer->len + len );
+        BYTE *data = realloc( buffer->data, size );
+
+        if (!data)
+        {
+            buffer->failed = TRUE;
+            return NULL;
+        }
+        buffer->data = data;
+        buffer->size = size;
+    }
+    p = buffer->data + buffer->len;
+    memset( p, 0, len );
+    buffer->len += len;
+    return p;
+}
+
+static void buffer_add( struct buffer *buffer, const void *data, UINT32 len )
+{
+    BYTE *p = buffer_grow( buffer, len );
+    if (p) memcpy( p, data, len );
+}
+
+static void buffer_add16( struct buffer *buffer, UINT16 value )
+{
+    BYTE *p = buffer_grow( buffer, 2 );
+    if (p) put_be16( p, value );
+}
+
+static void buffer_add32( struct buffer *buffer, UINT32 value )
+{
+    BYTE *p = buffer_grow( buffer, 4 );
+    if (p) put_be32( p, value );
+}
+
+struct mapping
+{
+    UINT32 ch;
+    UINT32 glyph;
+};
+
+struct mappings
+{
+    struct mapping *items;
+    UINT32 count;
+    UINT32 size;
+    const struct glyphs *glyphs;
+    BOOL failed;
+};
+
+static BOOL add_kept_mapping( UINT32 ch, UINT32 glyph, void *context )
+{
+    struct mappings *mappings = context;
+
+    if (!is_kept( mappings->glyphs, glyph )) return TRUE;
+    if (mappings->count == mappings->size)
+    {
+        UINT32 size = max( 64, mappings->size * 2 );
+        struct mapping *items = realloc( mappings->items, size * sizeof(*items) );
+
+        if (!items)
+        {
+            mappings->failed = TRUE;
+            return FALSE;
+        }
+        mappings->items = items;
+        mappings->size = size;
+    }
+    mappings->items[mappings->count].ch = ch;
+    mappings->items[mappings->count].glyph = glyph;
+    mappings->count++;
+    return TRUE;
+}
+
+static int compare_mappings( const void *a, const void *b )
+{
+    const struct mapping *x = a, *y = b;
+    return x->ch < y->ch ? -1 : x->ch > y->ch;
+}
+
+struct segment
+{
+    UINT32 start;
+    UINT32 end;
+    UINT32 first;     /* the index of its first mapping */
+    UINT16 delta;
+    BOOL constant;    /* whether the delta maps all of it, or it needs entries of the glyph array */
+};
+
+static void write_cmap_format4( struct buffer *out, const struct mappings *mappings, UINT16 language )
+{
+    UINT32 begin = out->len, bmp = 0, count = 0, entries = 0, search = 1, selector = 0, i, j;
+    struct segment *segments;
+    BYTE *header;
+
+    while (bmp < mappings->count && mappings->items[bmp].ch < 0xffff) bmp++;
+    if (!(segments = calloc( bmp + 2, sizeof(*segments) )))
+    {
+        out->failed = TRUE;
+        return;
+    }
+    /* a segment is a run of consecutive characters: with a constant delta it needs no glyph array */
+    for (i = 0; i < bmp; i = j)
+    {
+        struct segment *segment = &segments[count++];
+
+        segment->start = mappings->items[i].ch;
+        segment->first = i;
+        segment->delta = (mappings->items[i].glyph - mappings->items[i].ch) & 0xffff;
+        segment->constant = TRUE;
+        for (j = i + 1; j < bmp && mappings->items[j].ch == mappings->items[j - 1].ch + 1; j++)
+            if (((mappings->items[j].glyph - mappings->items[j].ch) & 0xffff) != segment->delta) segment->constant = FALSE;
+        segment->end = mappings->items[j - 1].ch;
+    }
+    if (!count)
+    {
+        /* a subtable that maps nothing still has a segment besides the last one, as Windows writes it */
+        segments[count].start = segments[count].end = 0;
+        segments[count].constant = TRUE;
+        count++;
+    }
+    segments[count].start = segments[count].end = 0xffff;
+    segments[count].delta = 1;
+    segments[count].constant = TRUE;
+    count++;
+    while (search * 2 <= count) { search *= 2; selector++; }
+
+    if ((header = buffer_grow( out, 14 )))
+    {
+        put_be16( header, 4 );
+        put_be16( header + 4, language );
+        put_be16( header + 6, count * 2 );
+        put_be16( header + 8, search * 2 );
+        put_be16( header + 10, selector );
+        put_be16( header + 12, count * 2 - search * 2 );
+    }
+    for (i = 0; i < count; i++) buffer_add16( out, segments[i].end );
+    buffer_add16( out, 0 );
+    for (i = 0; i < count; i++) buffer_add16( out, segments[i].start );
+    for (i = 0; i < count; i++) buffer_add16( out, segments[i].constant ? segments[i].delta : 0 );
+    for (i = 0; i < count; i++)
+    {
+        if (segments[i].constant) buffer_add16( out, 0 );
+        else
+        {
+            /* from this range offset to the segment's entries of the glyph array that follows the offsets */
+            buffer_add16( out, (count - i + entries) * 2 );
+            entries += segments[i].end - segments[i].start + 1;
+        }
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (segments[i].constant) continue;
+        for (j = 0; j <= segments[i].end - segments[i].start; j++)
+            buffer_add16( out, mappings->items[segments[i].first + j].glyph );
+    }
+    free( segments );
+    if (out->failed) return;
+    if (out->len - begin > 0xffff)
+    {
+        /* too big for its length field: the caller keeps the old subtable */
+        out->len = begin;
+        return;
+    }
+    put_be16( out->data + begin + 2, out->len - begin );
+}
+
+static void write_cmap_format12( struct buffer *out, const struct mappings *mappings, UINT32 language, UINT16 format )
+{
+    UINT32 start = out->len, i, j, groups = 0;
+    BYTE *header;
+
+    if (!(header = buffer_grow( out, 16 ))) return;
+    put_be16( header, format );
+    put_be32( header + 8, language );
+    for (i = 0; i < mappings->count; i = j)
+    {
+        for (j = i + 1; j < mappings->count && mappings->items[j].ch == mappings->items[j - 1].ch + 1 &&
+             mappings->items[j].glyph == (format == 12 ? mappings->items[j - 1].glyph + 1 : mappings->items[i].glyph); j++) ;
+        buffer_add32( out, mappings->items[i].ch );
+        buffer_add32( out, mappings->items[j - 1].ch );
+        buffer_add32( out, mappings->items[i].glyph );
+        groups++;
+    }
+    if (!groups)
+    {
+        /* like format 4, one that maps nothing maps character 0 to glyph 0 */
+        buffer_add32( out, 0 );
+        buffer_add32( out, 0 );
+        buffer_add32( out, 0 );
+        groups++;
+    }
+    if (out->failed) return;
+    put_be32( out->data + start + 4, out->len - start );
+    put_be32( out->data + start + 12, groups );
+}
+
+/* a subtable of the new cmap from one of the old, with only the characters of kept glyphs; FALSE to leave it out */
+static BOOL write_cmap_subtable( struct buffer *out, const BYTE *sub, UINT32 avail, const struct glyphs *glyphs )
+{
+    struct mappings mappings = { NULL, 0, 0, glyphs };
+    UINT16 format = get_be16( sub );
+    UINT32 i;
+
+    if (!enum_cmap( sub, avail, add_kept_mapping, &mappings ) || mappings.failed)
+    {
+        if (!mappings.failed) FIXME( "cmap subtable format %u left out\n", format );
+        free( mappings.items );
+        return FALSE;
+    }
+    qsort( mappings.items, mappings.count, sizeof(*mappings.items), compare_mappings );
+
+    switch (format)
+    {
+    case 0:
+    {
+        BYTE *p = buffer_grow( out, 262 );
+
+        if (p)
+        {
+            put_be16( p, 0 );
+            put_be16( p + 2, 262 );
+            put_be16( p + 4, get_be16( sub + 4 ));
+            for (i = 0; i < mappings.count; i++) if (mappings.items[i].ch < 256) p[6 + mappings.items[i].ch] = mappings.items[i].glyph;
+        }
+        break;
+    }
+    case 6:
+    {
+        /* from the first to the last code whose glyph is kept, glyph 0 among them */
+        UINT32 old_first = get_be16( sub + 6 ), old_count = get_be16( sub + 8 ), first = 0, count = 0, code;
+        BYTE *p;
+
+        for (code = 0; code < old_count && 10 + code * 2 + 2 <= avail; code++)
+        {
+            if (!is_kept( glyphs, get_be16( sub + 10 + code * 2 ))) continue;
+            if (!count) first = old_first + code;
+            count = old_first + code - first + 1;
+        }
+        p = buffer_grow( out, 10 + count * 2 );
+
+        if (p)
+        {
+            put_be16( p, 6 );
+            put_be16( p + 2, 10 + count * 2 );
+            put_be16( p + 4, get_be16( sub + 4 ));
+            put_be16( p + 6, first );
+            put_be16( p + 8, count );
+            for (i = 0; i < mappings.count; i++)
+                if (mappings.items[i].ch >= first && mappings.items[i].ch - first < count)
+                    put_be16( p + 10 + (mappings.items[i].ch - first) * 2, mappings.items[i].glyph );
+        }
+        break;
+    }
+    case 4:
+    {
+        UINT32 at = out->len, length = min( get_be16( sub + 2 ), avail );
+
+        write_cmap_format4( out, &mappings, get_be16( sub + 4 ));
+        if (!out->failed && out->len == at)
+        {
+            WARN( "%u characters too many for a format 4 subtable, keeping the old one\n", mappings.count );
+            buffer_add( out, sub, length );
+        }
+        break;
+    }
+    default:  /* 12 and 13 */
+        write_cmap_format12( out, &mappings, get_be32( sub + 8 ), format );
+        break;
+    }
+    free( mappings.items );
+    return !out->failed;
+}
+
+/* the first and the last character a cmap subtable maps */
+static BOOL find_char_range( UINT32 ch, UINT32 glyph, void *context )
+{
+    UINT32 *range = context;
+
+    if (!glyph) return TRUE;
+    if (ch < range[0]) range[0] = ch;
+    if (ch > range[1]) range[1] = ch;
+    return TRUE;
+}
+
+/* the length a cmap subtable says it has, 0 when it says nothing sensible */
+static UINT32 cmap_subtable_length( const BYTE *sub, UINT32 avail )
+{
+    UINT32 format, length;
+
+    if (avail < 4) return 0;
+    format = get_be16( sub );
+    if (format == 14) length = avail >= 6 ? get_be32( sub + 2 ) : 0;
+    else if (format >= 8) length = avail >= 8 ? get_be32( sub + 4 ) : 0;
+    else length = get_be16( sub + 2 );
+    return length <= avail ? length : 0;
+}
+
+/* the new cmap: its subtables with the characters of kept glyphs, in the order and sharing of the old ones and
+ * padded to two bytes only, as Windows writes them.  Format 14 and a subtable that would grow stay as they were.  range gets
+ * the first and the last character that the rebuilt subtables of formats 4, 6, 12 and 13 map, and ms_rebuilt whether
+ * a subtable of the Microsoft platform was rebuilt, not only shared with one before it. */
+static void write_cmap( struct buffer *out, const struct table *cmap, const struct glyphs *glyphs, UINT32 range[2],
+                        BOOL *ms_rebuilt )
+{
+    UINT32 *offsets, count, kept = 0, i, j;
+    BOOL unicode_met = FALSE;
+    BYTE *header;
+
+    *ms_rebuilt = FALSE;
+    count = get_be16( cmap->data + 2 );
+    if (cmap->len < 4 + count * 8) count = (cmap->len - 4) / 8;
+    if (!(offsets = calloc( count, sizeof(*offsets) ))) { out->failed = TRUE; return; }
+    if (!(header = buffer_grow( out, 4 + count * 8 ))) { free( offsets ); return; }
+    put_be16( header, get_be16( cmap->data ));
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *record = cmap->data + 4 + i * 8, *sub;
+        UINT32 offset = get_be32( record + 4 ), old_length;
+
+        offsets[i] = 0;
+        if (offset >= cmap->len) continue;
+        /* subtables shared by several encodings stay shared */
+        for (j = 0; j < i; j++)
+            if (get_be32( cmap->data + 4 + j * 8 + 4 ) == offset) break;
+        if (j < i)
+        {
+            if (!(offsets[i] = offsets[j])) continue;
+        }
+        else
+        {
+            UINT32 at, format;
+
+            /* subtables start on even offsets */
+            if (out->len % 2) buffer_grow( out, 1 );
+            at = out->len;
+            sub = cmap->data + offset;
+            format = get_be16( sub );
+            old_length = cmap_subtable_length( sub, cmap->len - offset );
+            if (format == 14)
+            {
+                /* variation sequences stay as they are */
+                if (!old_length) continue;
+                buffer_add( out, sub, old_length );
+            }
+            else if (!write_cmap_subtable( out, sub, cmap->len - offset, glyphs ))
+            {
+                out->len = at;
+                continue;
+            }
+            else if (old_length && out->len - at > old_length)
+            {
+                out->len = at;
+                buffer_add( out, sub, old_length );
+            }
+            else if (format == 4 || format == 6 || format == 12 || format == 13)
+            {
+                /* a Macintosh subtable before any Unicode one does not count */
+                if (get_be16( record ) != 1 || unicode_met)
+                    enum_cmap( out->data + at, out->len - at, find_char_range, range );
+                if (get_be16( record ) == 3) *ms_rebuilt = TRUE;
+            }
+            offsets[i] = at;
+        }
+        if (get_be16( record ) != 1) unicode_met = TRUE;
+        if (out->failed) break;
+        put_be16( out->data + 4 + kept * 8, get_be16( record ));
+        put_be16( out->data + 4 + kept * 8 + 2, get_be16( record + 2 ));
+        put_be32( out->data + 4 + kept * 8 + 4, offsets[i] );
+        kept++;
+    }
+    if (!out->failed)
+    {
+        /* the records of subtables left out go; move the subtables up to follow the kept records */
+        UINT32 gap = (count - kept) * 8;
+
+        put_be16( out->data + 2, kept );
+        if (gap)
+        {
+            memmove( out->data + 4 + kept * 8, out->data + 4 + count * 8, out->len - 4 - count * 8 );
+            out->len -= gap;
+            for (i = 0; i < kept; i++) put_be32( out->data + 4 + i * 8 + 4, get_be32( out->data + 4 + i * 8 + 4 ) - gap );
+        }
+    }
+    free( offsets );
+}
+
+/* hmtx or vmtx: when fewer long metrics will do, the kept glyphs keep theirs and the others get none; Windows leaves
+ * the table as it is when as many are needed */
+static void write_metrics( struct buffer *out, const struct table *metrics, UINT32 long_count, UINT32 new_long_count,
+                           const struct glyphs *glyphs )
+{
+    UINT32 glyph;
+
+    if (new_long_count == long_count)
+    {
+        buffer_add( out, metrics->data, metrics->len );
+        return;
+    }
+
+    for (glyph = 0; glyph < glyphs->count; glyph++)
+    {
+        UINT16 advance = 0, bearing = 0;
+
+        if (is_kept( glyphs, glyph ))
+        {
+            UINT32 at = glyph < long_count ? glyph * 4 : long_count * 4 + (glyph - long_count) * 2;
+
+            if (long_count && glyph >= long_count && long_count * 4 <= metrics->len)
+                advance = get_be16( metrics->data + (long_count - 1) * 4 );
+            else if (glyph < long_count && at + 4 <= metrics->len)
+                advance = get_be16( metrics->data + at );
+            bearing = at + (glyph < long_count ? 4 : 2) <= metrics->len ?
+                      get_be16( metrics->data + at + (glyph < long_count ? 2 : 0)) : 0;
+        }
+        if (glyph < new_long_count) buffer_add16( out, advance );
+        buffer_add16( out, bearing );
+    }
+}
+
+/* keeps the kerning pairs of kept glyphs in the Microsoft kern table, and the subtables that keep some */
+static void write_kern( struct buffer *out, const struct table *kern, const struct glyphs *glyphs )
+{
+    UINT32 offset = 4, count, i, subtables = 0;
+
+    if (kern->len < 4 || get_be16( kern->data ))
+    {
+        buffer_add( out, kern->data, kern->len );
+        return;
+    }
+    count = get_be16( kern->data + 2 );
+    buffer_add( out, kern->data, 4 );
+    for (i = 0; i < count && offset + 6 <= kern->len; i++)
+    {
+        const BYTE *sub = kern->data + offset;
+        UINT32 length = get_be16( sub + 2 ), pairs, kept = 0, start = out->len, j, search = 1, selector = 0;
+
+        if ((get_be16( sub + 4 ) >> 8) || offset + 14 > kern->len)
+        {
+            if (offset + length > kern->len) length = kern->len - offset;
+            buffer_add( out, sub, length );
+            offset += max( length, 6 );
+            subtables++;
+            continue;
+        }
+        pairs = get_be16( sub + 6 );
+        if ((kern->len - offset - 14) / 6 < pairs) pairs = (kern->len - offset - 14) / 6;
+        buffer_add( out, sub, 14 );
+        for (j = 0; j < pairs; j++)
+        {
+            const BYTE *pair = sub + 14 + j * 6;
+            if (!is_kept( glyphs, get_be16( pair )) || !is_kept( glyphs, get_be16( pair + 2 ))) continue;
+            buffer_add( out, pair, 6 );
+            kept++;
+        }
+        if (out->failed) return;
+        /* the length of a big subtable does not fit its field; the pairs count is what is read */
+        offset += max( length, 14 + pairs * 6 );
+        if (!kept)
+        {
+            out->len = start;
+            continue;
+        }
+        subtables++;
+        while (search * 2 <= kept) { search *= 2; selector++; }
+        put_be16( out->data + start + 2, 14 + kept * 6 );
+        put_be16( out->data + start + 6, kept );
+        put_be16( out->data + start + 8, kept ? search * 6 : 0 );
+        put_be16( out->data + start + 10, kept ? selector : 0 );
+        put_be16( out->data + start + 12, kept ? kept * 6 - search * 6 : 0 );
+    }
+    if (out->failed) return;
+    put_be16( out->data + 2, subtables );
+    /* no pairs left, no table */
+    if (!subtables) out->len = 0;
+}
+
+/* an index subtable of the new EBLC (or CBLC) that has its bitmaps in the new EBDT (or CBDT) */
+struct bitmap_subtable
+{
+    UINT32 (*pieces)[2];  /* the old bitmaps it has, as below */
+    UINT32 count;
+    UINT32 new_image;     /* where they are in the new table */
+};
+
+/* the bitmaps of a new index subtable, in pieces of the old EBDT */
+struct bitmap_pieces
+{
+    UINT32 (*items)[2];
+    UINT32 count;
+    UINT32 total;
+};
+
+static BOOL add_piece( struct bitmap_pieces *pieces, UINT32 offset, UINT32 len, const struct table *ebdt )
+{
+    if (offset > ebdt->len || ebdt->len - offset < len) return FALSE;
+    pieces->items[pieces->count][0] = offset;
+    pieces->items[pieces->count][1] = len;
+    pieces->count++;
+    pieces->total += len;
+    return TRUE;
+}
+
+/* the new index subtable for the kept glyphs of an old one, with the pieces of its bitmaps; 0 when it has none of
+ * them, ~0u when the old one is not right */
+static UINT32 make_bitmap_subtable( struct buffer *out, struct bitmap_pieces *pieces, const struct table *eblc,
+                                    UINT32 sub, UINT32 first, UINT32 last, const struct table *ebdt,
+                                    const struct glyphs *glyphs, UINT32 *new_first, UINT32 *new_last )
+{
+    UINT32 format, image, i, n = last - first + 1, count = 0, low = ~0u, high = 0, glyph, width, at, next;
+    const BYTE *old = eblc->data + sub;
+
+    if (last < first || sub > eblc->len || eblc->len - sub < 8) return ~0u;
+    format = get_be16( old );
+    image = get_be32( old + 4 );
+    pieces->count = pieces->total = 0;
+    if (!(pieces->items = malloc( (n + 1) * sizeof(*pieces->items) ))) return ~0u;
+    switch (format)
+    {
+    case 1:
+    case 3:
+        /* both become format 3, from the first kept glyph to the last, the others there empty */
+        width = format == 1 ? 4 : 2;
+        if ((eblc->len - sub - 8) / width < n + 1) return ~0u;
+        for (i = 0; i < n; i++) if (is_kept( glyphs, first + i )) { low = min( low, i ); high = i; }
+        if (low == ~0u) return 0;
+        buffer_add16( out, 3 );
+        buffer_add16( out, get_be16( old + 2 ));
+        buffer_add32( out, 0 );
+        for (i = low; i <= high + 1; i++)
+        {
+            buffer_add16( out, pieces->total );
+            if (i > high || !is_kept( glyphs, first + i )) continue;
+            at = width == 4 ? get_be32( old + 8 + i * 4 ) : get_be16( old + 8 + i * 2 );
+            next = width == 4 ? get_be32( old + 12 + i * 4 ) : get_be16( old + 10 + i * 2 );
+            if (next < at || (next > at && !add_piece( pieces, image + at, next - at, ebdt ))) return ~0u;
+        }
+        if ((high - low) % 2) buffer_add16( out, 0 );
+        *new_first = first + low;
+        *new_last = first + high;
+        break;
+
+    case 2:
+    {
+        /* a run of glyphs of one size stays one while the kept glyphs follow each other, else it becomes a list */
+        UINT32 image_size, gaps = 0;
+
+        if (eblc->len - sub < 20) return ~0u;
+        image_size = get_be32( old + 8 );
+        for (i = 0; i < n; i++)
+        {
+            if (!is_kept( glyphs, first + i )) continue;
+            if (count && i != high + 1) gaps++;
+            if (!count++) low = i;
+            high = i;
+            if (!add_piece( pieces, image + i * image_size, image_size, ebdt )) return ~0u;
+        }
+        if (!count) return 0;
+        buffer_add16( out, gaps ? 5 : 2 );
+        buffer_add16( out, get_be16( old + 2 ));
+        buffer_add32( out, 0 );
+        buffer_add( out, old + 8, 12 );
+        if (gaps)
+        {
+            buffer_add32( out, count );
+            for (i = low; i <= high; i++) if (is_kept( glyphs, first + i )) buffer_add16( out, first + i );
+            if (count % 2) buffer_add16( out, 0 );
+        }
+        *new_first = first + low;
+        *new_last = first + high;
+        break;
+    }
+
+    case 4:
+    case 5:
+    {
+        /* lists of glyphs keep the kept ones */
+        UINT32 listed, image_size = 0, entry = format == 4 ? 4 : 2, list = format == 4 ? 12 : 24;
+
+        if (eblc->len - sub < list) return ~0u;
+        listed = get_be32( old + list - 4 );
+        if ((eblc->len - sub - list) / entry < listed + (format == 4)) return ~0u;
+        if (format == 5) image_size = get_be32( old + 8 );
+        free( pieces->items );
+        if (!(pieces->items = malloc( (listed + 1) * sizeof(*pieces->items) ))) return ~0u;
+        for (i = 0; i < listed; i++) if (is_kept( glyphs, get_be16( old + list + i * entry ))) count++;
+        if (!count) return 0;
+        buffer_add16( out, format );
+        buffer_add16( out, get_be16( old + 2 ));
+        buffer_add32( out, 0 );
+        if (format == 5) buffer_add( out, old + 8, 12 );
+        buffer_add32( out, count );
+        for (i = 0; i < listed; i++)
+        {
+            glyph = get_be16( old + list + i * entry );
+            if (!is_kept( glyphs, glyph )) continue;
+            if (low == ~0u) low = glyph;
+            high = glyph;
+            if (format == 5)
+            {
+                buffer_add16( out, glyph );
+                if (!add_piece( pieces, image + i * image_size, image_size, ebdt )) return ~0u;
+                continue;
+            }
+            at = get_be16( old + list + i * 4 + 2 );
+            next = get_be16( old + list + i * 4 + 6 );
+            buffer_add16( out, glyph );
+            buffer_add16( out, pieces->total );
+            if (next < at || !add_piece( pieces, image + at, next - at, ebdt )) return ~0u;
+        }
+        if (format == 4)
+        {
+            buffer_add16( out, 0 );
+            buffer_add16( out, pieces->total );
+        }
+        else if (count % 2) buffer_add16( out, 0 );
+        *new_first = low;
+        *new_last = high;
+        break;
+    }
+
+    default:
+        return ~0u;
+    }
+    return out->failed ? ~0u : out->len;
+}
+
+/* the bitmaps of kept glyphs, as Windows keeps them: each size keeps the index subtables that have kept glyphs, in
+ * their order and cut to them, formats 1 and 3 as format 3 and a run of glyphs of one size (format 2) as a list
+ * (format 5) unless the kept ones follow each other; EBDT (or CBDT) gets their bitmaps in that order, once for sizes
+ * that share them.  A size goes when it keeps no glyph, and also, when bitmaps are too many for the two-byte offsets
+ * of format 3 or 4, with what was written for it up to there; without sizes both tables go. */
+static BOOL write_bitmaps( struct buffer *eblc_out, struct buffer *ebdt_out, const struct table *eblc,
+                           const struct table *ebdt, const struct glyphs *glyphs )
+{
+    struct buffer sizes_out = {0}, arrays = {0}, entries = {0}, subtables = {0}, sub = {0};
+    struct bitmap_subtable *written = NULL;
+    struct bitmap_pieces pieces = {0};
+    UINT32 sizes, kept_sizes = 0, written_count = 0, i, j, k;
+    BOOL ret = FALSE;
+
+    if (eblc->len < 8 || ebdt->len < 4) return FALSE;
+    sizes = get_be32( eblc->data + 4 );
+    if ((eblc->len - 8) / 48 < sizes) return FALSE;
+    buffer_add( ebdt_out, ebdt->data, 4 );
+    for (i = 0; i < sizes; i++)
+    {
+        const BYTE *size = eblc->data + 8 + i * 48;
+        UINT32 array = get_be32( size ), count = get_be32( size + 8 ), start = get_be16( size + 40 );
+        UINT32 end = get_be16( size + 42 ), low = ~0u, high = 0, new_count = 0, glyph;
+        BOOL too_many = FALSE;
+        BYTE *record;
+
+        if (array > eblc->len || (eblc->len - array) / 8 < count) goto done;
+        for (glyph = start; glyph <= end && glyph < glyphs->count; glyph++)
+        {
+            if (!is_kept( glyphs, glyph )) continue;
+            if (low == ~0u) low = glyph;
+            high = glyph;
+        }
+        if (low == ~0u) continue;
+        entries.len = subtables.len = 0;
+        for (j = 0; j < count && !too_many; j++)
+        {
+            const BYTE *entry = eblc->data + array + j * 8;
+            UINT32 first, last;
+
+            sub.len = 0;
+            k = make_bitmap_subtable( &sub, &pieces, eblc, array + get_be32( entry + 4 ), get_be16( entry ),
+                                      get_be16( entry + 2 ), ebdt, glyphs, &first, &last );
+            if (k == ~0u) goto done;
+            if (!k)
+            {
+                free( pieces.items );
+                pieces.items = NULL;
+                continue;
+            }
+            /* bitmaps shared between sizes stay shared */
+            for (k = 0; k < written_count; k++)
+                if (written[k].count == pieces.count &&
+                    !memcmp( written[k].pieces, pieces.items, pieces.count * sizeof(*pieces.items) )) break;
+            if (k < written_count) put_be32( sub.data + 4, written[k].new_image );
+            else
+            {
+                struct bitmap_subtable *grown;
+
+                put_be32( sub.data + 4, ebdt_out->len );
+                for (k = 0; k < pieces.count; k++) buffer_add( ebdt_out, ebdt->data + pieces.items[k][0], pieces.items[k][1] );
+                if (!(grown = realloc( written, (written_count + 1) * sizeof(*written) ))) goto done;
+                written = grown;
+                written[written_count].pieces = pieces.items;
+                written[written_count].count = pieces.count;
+                written[written_count].new_image = get_be32( sub.data + 4 );
+                written_count++;
+                pieces.items = NULL;
+            }
+            if (pieces.total > 0xffff && (get_be16( sub.data ) == 3 || get_be16( sub.data ) == 4)) too_many = TRUE;
+            free( pieces.items );
+            pieces.items = NULL;
+            buffer_add16( &entries, first );
+            buffer_add16( &entries, last );
+            buffer_add32( &entries, subtables.len );
+            buffer_add( &subtables, sub.data, sub.len );
+            new_count++;
+        }
+        if (too_many || !new_count) continue;
+        /* the array of the size, then its subtables */
+        for (j = 0; j < new_count; j++) put_be32( entries.data + j * 8 + 4, get_be32( entries.data + j * 8 + 4 ) + new_count * 8 );
+        if ((record = buffer_grow( &sizes_out, 48 )))
+        {
+            memcpy( record, size, 48 );
+            put_be32( record, arrays.len );
+            put_be32( record + 4, entries.len + subtables.len );
+            put_be32( record + 8, new_count );
+            put_be16( record + 40, low );
+            put_be16( record + 42, high );
+        }
+        buffer_add( &arrays, entries.data, entries.len );
+        buffer_add( &arrays, subtables.data, subtables.len );
+        kept_sizes++;
+    }
+    if (sizes_out.failed || arrays.failed || entries.failed || subtables.failed || sub.failed) goto done;
+    if (kept_sizes)
+    {
+        buffer_add( eblc_out, eblc->data, 4 );
+        buffer_add32( eblc_out, kept_sizes );
+        for (i = 0; i < kept_sizes; i++)
+            put_be32( sizes_out.data + i * 48, get_be32( sizes_out.data + i * 48 ) + 8 + kept_sizes * 48 );
+        buffer_add( eblc_out, sizes_out.data, sizes_out.len );
+        buffer_add( eblc_out, arrays.data, arrays.len );
+    }
+    else ebdt_out->len = 0;
+    ret = !eblc_out->failed && !ebdt_out->failed;
+
+done:
+    for (i = 0; i < written_count; i++) free( written[i].pieces );
+    free( written );
+    free( pieces.items );
+    free( sizes_out.data );
+    free( arrays.data );
+    free( entries.data );
+    free( subtables.data );
+    free( sub.data );
+    return ret;
+}
+
+static UINT32 checksum( const BYTE *data, UINT32 len )
+{
+    UINT32 sum = 0, i;
+    BYTE last[4] = {0};
+
+    for (i = 0; i + 4 <= len; i += 4) sum += get_be32( data + i );
+    if (i < len)
+    {
+        memcpy( last, data + i, len - i );
+        sum += get_be32( last );
+    }
+    return sum;
+}
+
+struct new_table
+{
+    UINT32 tag;
+    const BYTE *data;
+    UINT32 len;
+    UINT32 place;   /* where it goes among the tables with no place of their own */
+};
+
+static int compare_tags( const void *a, const void *b )
+{
+    const struct new_table *x = a, *y = b;
+    return x->tag < y->tag ? -1 : x->tag > y->tag;
+}
+
+/* where Windows puts a table in the file, ~0u for those it puts after all of these */
+static unsigned int table_rank( UINT32 tag )
+{
+    static const UINT32 order[] =
+    {
+        TAG('h','e','a','d'), TAG('h','h','e','a'), TAG('m','a','x','p'), TAG('O','S','/','2'), TAG('h','m','t','x'),
+        TAG('L','T','S','H'), TAG('V','D','M','X'), TAG('h','d','m','x'), TAG('c','m','a','p'), TAG('f','p','g','m'),
+        TAG('p','r','e','p'), TAG('c','v','t',' '), TAG('g','l','y','f'), TAG('l','o','c','a'), TAG('k','e','r','n'),
+        TAG('n','a','m','e'), TAG('p','o','s','t'), TAG('g','a','s','p'), TAG('P','C','L','T'), TAG('v','h','e','a'),
+        TAG('v','m','t','x'), TAG('E','B','L','C'), TAG('E','B','D','T'),
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(order); i++) if (order[i] == tag) return i;
+    return ~0u;
+}
+
+static BOOL goes_before( const struct new_table *a, const struct new_table *b )
+{
+    unsigned int rank_a = table_rank( a->tag ), rank_b = table_rank( b->tag );
+
+    return rank_a < rank_b || (rank_a == rank_b && a->place < b->place);
+}
+
+static ULONG write_font( struct new_table *tables, unsigned int count, unsigned char **dest, ULONG *dest_len,
+                         ULONG *written, CFP_REALLOCPROC reallocproc )
+{
+    unsigned int i, search = 1, selector = 0, *order;
+    UINT32 size = 12 + count * 16, offset, head_at = 0;
+    BYTE *font;
+
+    /* Windows puts the others in an order not understood; the old directory's, with its first moved to the end when
+     * it ends with a table of the list above, is its order for the most of the fonts measured */
+    for (i = 0; i < count; i++) tables[i].place = i;
+    if (count > 1 && table_rank( tables[0].tag ) == ~0u && table_rank( tables[count - 1].tag ) != ~0u)
+        tables[0].place = count;
+    qsort( tables, count, sizeof(*tables), compare_tags );
+    if (!(order = malloc( count * sizeof(*order) ))) return ERR_MEM;
+    for (i = 0; i < count; i++)
+    {
+        unsigned int j = i;
+
+        while (j > 0 && goes_before( &tables[i], &tables[order[j - 1]] ))
+        {
+            order[j] = order[j - 1];
+            j--;
+        }
+        order[j] = i;
+        size += (tables[i].len + 3) & ~3;
+    }
+    if (!(font = reallocproc( NULL, size )))
+    {
+        free( order );
+        return ERR_MEM;
+    }
+    memset( font, 0, size );
+    while (search * 2 <= count) { search *= 2; selector++; }
+    put_be32( font, 0x00010000 );
+    put_be16( font + 4, count );
+    put_be16( font + 6, search * 16 );
+    put_be16( font + 8, selector );
+    put_be16( font + 10, count * 16 - search * 16 );
+    offset = 12 + count * 16;
+    for (i = 0; i < count; i++)
+    {
+        const struct new_table *table = &tables[order[i]];
+        BYTE *record = font + 12 + order[i] * 16;
+
+        memcpy( font + offset, table->data, table->len );
+        if (table->tag == TAG('h','e','a','d'))
+        {
+            head_at = offset;
+            if (table->len >= 12) put_be32( font + offset + 8, 0 );
+        }
+        put_be32( record, table->tag );
+        put_be32( record + 4, checksum( font + offset, table->len ));
+        put_be32( record + 8, offset );
+        put_be32( record + 12, table->len );
+        offset += (table->len + 3) & ~3;
+    }
+    if (head_at) put_be32( font + head_at + 8, 0xb1b0afba - checksum( font, size ));
+    free( order );
+    *dest = font;
+    *dest_len = size;
+    *written = size;
+    return NO_ERROR;
+}
+
+struct name_string
+{
+    const BYTE *data;
+    UINT32 length;
+    UINT32 offset;   /* where it is in the new storage, ~0u until it is there */
+};
+
+static const BYTE *find_bytes( const BYTE *haystack, UINT32 haystack_len, const BYTE *needle, UINT32 needle_len )
+{
+    UINT32 i;
+
+    if (!needle_len) return haystack;
+    for (i = 0; i + needle_len <= haystack_len; i++)
+        if (!memcmp( haystack + i, needle, needle_len )) return haystack + i;
+    return NULL;
+}
+
+/* where a string already is in one of the strings placed so far, ~0u if nowhere */
+static UINT32 find_placed( const struct name_string *strings, UINT32 count, const BYTE *data, UINT32 length )
+{
+    const BYTE *found;
+    UINT32 i;
+
+    for (i = 0; i < count; i++)
+    {
+        if (strings[i].offset == ~0u) continue;
+        if ((found = find_bytes( strings[i].data, strings[i].length, data, length )))
+            return strings[i].offset + (found - strings[i].data);
+    }
+    return ~0u;
+}
+
+/* the name table with its strings packed as Windows packs them: in the order of the records, each inside the longest
+ * other string holding it, placed first when it is not yet, or else where the same bytes already are */
+static BOOL write_name( struct buffer *out, const struct table *name )
+{
+    UINT32 count, storage, header, i, j;
+    struct name_string *strings;
+    BYTE *p;
+
+    if (name->len < 6 || get_be16( name->data )) return FALSE;  /* format 1 has language tags; leave it */
+    count = get_be16( name->data + 2 );
+    storage = get_be16( name->data + 4 );
+    header = 6 + count * 12;
+    if (name->len < header || storage < header || storage > name->len) return FALSE;
+    if (!(strings = calloc( count, sizeof(*strings) ))) return FALSE;
+    for (i = 0; i < count; i++)
+    {
+        const BYTE *record = name->data + 6 + i * 12;
+        UINT32 offset = get_be16( record + 10 );
+
+        strings[i].length = get_be16( record + 8 );
+        strings[i].data = name->data + storage + offset;
+        strings[i].offset = ~0u;
+        if (storage + offset + strings[i].length > name->len)
+        {
+            free( strings );
+            return FALSE;
+        }
+    }
+    if (!(p = buffer_grow( out, header )))
+    {
+        free( strings );
+        return FALSE;
+    }
+    memcpy( p, name->data, header );
+    put_be16( out->data + 4, header );
+    for (i = 0; i < count; i++)
+    {
+        UINT32 at, container = ~0u;
+
+        /* inside the longest other string that holds it, placed first if it is not yet */
+        for (j = 0; j < count && strings[i].length; j++)
+        {
+            if (j == i || strings[j].length <= strings[i].length) continue;
+            if (!find_bytes( strings[j].data, strings[j].length, strings[i].data, strings[i].length )) continue;
+            if (container == ~0u || strings[j].length > strings[container].length) container = j;
+        }
+        if (!strings[i].length) at = 0;
+        else if (container != ~0u)
+        {
+            if ((at = find_placed( strings, count, strings[container].data, strings[container].length )) == ~0u)
+            {
+                at = strings[container].offset = out->len - header;
+                buffer_add( out, strings[container].data, strings[container].length );
+            }
+            at += find_bytes( strings[container].data, strings[container].length, strings[i].data,
+                              strings[i].length ) - strings[container].data;
+        }
+        /* else where the same bytes already are */
+        else if ((at = find_placed( strings, count, strings[i].data, strings[i].length )) == ~0u)
+        {
+            at = out->len - header;
+            buffer_add( out, strings[i].data, strings[i].length );
+        }
+        if (out->failed) break;
+        if (strings[i].offset == ~0u && at + strings[i].length <= out->len - header &&
+            !memcmp( out->data + header + at, strings[i].data, strings[i].length ))
+            strings[i].offset = at;
+        put_be16( out->data + 6 + i * 12 + 10, at );
+    }
+    free( strings );
+    return !out->failed;
+}
+
+struct outline_size
+{
+    UINT32 points;
+    UINT32 contours;
+};
+
+/* the points and contours of a glyph with its components, how deep they go, and the largest instructions */
+static struct outline_size measure_glyph( const struct table *loca, BOOL long_loca, const struct table *glyf,
+                                          unsigned int glyph, unsigned int level, UINT32 *depth, UINT32 *instructions )
+{
+    struct outline_size size = {0};
+    const BYTE *p, *end;
+    UINT32 start, length;
+    INT16 contours;
+    UINT16 flags = 0;
+
+    if (level > 16 || !get_glyph_span( loca, long_loca, glyf, glyph, &start, &length ) || length < 10) return size;
+    p = glyf->data + start;
+    end = p + length;
+    contours = get_be16( p );
+    if (contours >= 0)
+    {
+        if (length < 12 + contours * 2) return size;
+        size.contours = contours;
+        if (contours) size.points = get_be16( p + 10 + (contours - 1) * 2 ) + 1;
+        *instructions = max( *instructions, get_be16( p + 10 + contours * 2 ));
+        return size;
+    }
+    *depth = max( *depth, level + 1 );
+    p += 10;
+    do
+    {
+        struct outline_size component;
+
+        if (end - p < 4) break;
+        flags = get_be16( p );
+        component = measure_glyph( loca, long_loca, glyf, get_be16( p + 2 ), level + 1, depth, instructions );
+        size.points += component.points;
+        size.contours += component.contours;
+        p += 4 + ((flags & 0x0001) ? 4 : 2);
+        if (flags & 0x0008) p += 2;
+        else if (flags & 0x0040) p += 4;
+        else if (flags & 0x0080) p += 8;
+    } while (flags & 0x0020);
+    if ((flags & 0x0100) && end - p >= 2) *instructions = max( *instructions, get_be16( p ));  /* WE_HAVE_INSTRUCTIONS */
+    return size;
+}
+
+/* maxp's maximums, for the kept glyphs as Windows counts them: the instructions of fpgm and prep count too */
+static void update_maxp( BYTE *maxp, UINT32 len, const struct font *font, const struct table *loca, BOOL long_loca,
+                         const struct table *glyf, const struct glyphs *glyphs )
+{
+    UINT32 points = 0, contours = 0, composite_points = 0, composite_contours = 0, elements = 0, depth = 0;
+    UINT32 instructions = 0, glyph;
+    const struct table *table;
+
+    if (len < 32 || get_be32( maxp ) != 0x00010000) return;
+    for (glyph = 0; glyph < glyphs->count; glyph++)
+    {
+        struct outline_size size;
+        UINT32 start, length, glyph_depth = 0;
+
+        if (!is_kept( glyphs, glyph ) || !get_glyph_span( loca, long_loca, glyf, glyph, &start, &length ) || length < 10)
+            continue;
+        size = measure_glyph( loca, long_loca, glyf, glyph, 0, &glyph_depth, &instructions );
+        if ((INT16)get_be16( glyf->data + start ) >= 0)
+        {
+            points = max( points, size.points );
+            contours = max( contours, size.contours );
+        }
+        else
+        {
+            const BYTE *p = glyf->data + start + 10, *end = glyf->data + start + length;
+            UINT16 flags;
+            UINT32 count = 0;
+
+            composite_points = max( composite_points, size.points );
+            composite_contours = max( composite_contours, size.contours );
+            depth = max( depth, glyph_depth );
+            do
+            {
+                if (end - p < 4) break;
+                flags = get_be16( p );
+                count++;
+                p += 4 + ((flags & 0x0001) ? 4 : 2);
+                if (flags & 0x0008) p += 2;
+                else if (flags & 0x0040) p += 4;
+                else if (flags & 0x0080) p += 8;
+            } while (flags & 0x0020);
+            elements = max( elements, count );
+        }
+    }
+    if ((table = find_table( font, TAG('f','p','g','m') ))) instructions = max( instructions, table->len );
+    if ((table = find_table( font, TAG('p','r','e','p') ))) instructions = max( instructions, table->len );
+    put_be16( maxp + 6, points );
+    put_be16( maxp + 8, contours );
+    put_be16( maxp + 10, composite_points );
+    put_be16( maxp + 12, composite_contours );
+    put_be16( maxp + 26, min( instructions, 0xffff ));
+    put_be16( maxp + 28, elements );
+    put_be16( maxp + 30, depth );
+}
+
+static ULONG make_subset( const struct font *font, const unsigned short *keep_list, unsigned short keep_len,
+                          BOOL glyph_list, UINT16 platform, UINT16 encoding, unsigned char **dest, ULONG *dest_len,
+                          ULONG *written, CFP_REALLOCPROC reallocproc )
+{
+    static const UINT16 always_chars[] = { 0x22, 0x4d, 0x64, 0x72 };
+    const struct table *head, *maxp, *loca, *glyf, *hhea, *hmtx, *vhea, *vmtx, *cmap, *eblc, *ebdt;
+    struct buffer new_glyf = {0}, new_loca = {0}, new_hmtx = {0}, new_vmtx = {0}, new_cmap = {0}, new_kern = {0};
+    struct buffer new_eblc = {0}, new_ebdt = {0}, new_name = {0};
+    BYTE new_head[54], new_hhea[36], new_vhea[36], new_post[32], *new_os2 = NULL, *new_maxp = NULL;
+    BYTE *new_ltsh = NULL, *new_hdmx = NULL;
+    struct new_table *tables;
+    struct glyphs glyphs = {0};
+    unsigned int i, count = 0, last = 0;
+    UINT32 h_long, v_long = 0, new_h_long, new_v_long = 0, range[2] = { ~0u, 0 };
+    BOOL long_loca, short_loca, symbol, ms_rebuilt;
+    const BYTE *sub;
+    UINT32 avail;
+    ULONG ret = NO_ERROR;
+
+    /* without maxp a font has no glyphs, which Windows finds out first */
+    if (!(maxp = find_table( font, TAG('m','a','x','p') )) || maxp->len < 6 || !get_be16( maxp->data + 4 ))
+        return ERR_NO_GLYPHS;
+    if (!(head = find_table( font, TAG('h','e','a','d') ))) return ERR_MISSING_HEAD;
+    if (!(loca = find_table( font, TAG('l','o','c','a') ))) return ERR_MISSING_LOCA;
+    if (!(glyf = find_table( font, TAG('g','l','y','f') ))) return ERR_MISSING_GLYF;
+    if (!(hhea = find_table( font, TAG('h','h','e','a') ))) return ERR_MISSING_HHEA;
+    if (!(hmtx = find_table( font, TAG('h','m','t','x') ))) return ERR_MISSING_HMTX;
+    if (!(cmap = find_table( font, TAG('c','m','a','p') ))) return ERR_MISSING_CMAP;
+    if (head->len < 54) return ERR_INVALID_HEAD;
+    if (hhea->len < 36) return ERR_INVALID_HHEA;
+    if (cmap->len < 4) return ERR_INVALID_CMAP;
+    long_loca = get_be16( head->data + 50 ) != 0;
+    glyphs.count = get_be16( maxp->data + 4 );
+    if (loca->len < (glyphs.count + 1) * (long_loca ? 4 : 2)) return ERR_INVALID_LOCA;
+    h_long = get_be16( hhea->data + 34 );
+    if (!h_long || h_long > glyphs.count || hmtx->len < h_long * 4) return ERR_INVALID_HMTX;
+    vhea = find_table( font, TAG('v','h','e','a') );
+    vmtx = find_table( font, TAG('v','m','t','x') );
+    if (vhea && vmtx && vhea->len >= 36)
+    {
+        v_long = get_be16( vhea->data + 34 );
+        if (!v_long || v_long > glyphs.count || vmtx->len < v_long * 4) vhea = vmtx = NULL;
+    }
+    else vhea = vmtx = NULL;
+
+    if (!(glyphs.bits = calloc( (glyphs.count + 7) / 8 + 1, 1 ))) return ERR_MEM;
+    for (i = 0; i < 3; i++) keep_glyph( &glyphs, i );
+    keep_extenders( &glyphs, find_table( font, TAG('J','S','T','F') ));
+    symbol = platform == TTFCFP_MS_PLATFORMID && (encoding == TTFCFP_SYMBOL_CHAR_SET ||
+             (encoding == TTFCFP_DONT_CARE && !find_cmap( cmap, 3, 1, &avail ) && !find_cmap( cmap, 3, 10, &avail ) &&
+              find_cmap( cmap, 3, 0, &avail )));
+    sub = find_cmap( cmap, platform, encoding, &avail );
+    if (keep_list)
+    {
+        for (i = 0; i < ARRAY_SIZE(always_chars); i++) keep_glyph( &glyphs, map_char( sub, avail, symbol, always_chars[i] ));
+        for (i = 0; i < keep_len; i++)
+            keep_glyph( &glyphs, glyph_list ? keep_list[i] : map_char( sub, avail, symbol, keep_list[i] ));
+    }
+    do
+    {
+        glyphs.changed = FALSE;
+        keep_components( &glyphs, loca, long_loca, glyf );
+        keep_substitutions( &glyphs, find_table( font, TAG('G','S','U','B') ));
+        keep_color_layers( &glyphs, find_table( font, TAG('C','O','L','R') ));
+    } while (glyphs.changed);
+    for (i = 0; i < glyphs.count; i++) if (is_kept( &glyphs, i )) last = i;
+
+    /* the outlines, each padded to two bytes as Windows writes them, with short offsets when they fit */
+    for (i = 0; i < glyphs.count; i++)
+    {
+        UINT32 start, length;
+
+        if (!is_kept( &glyphs, i ) || !get_glyph_span( loca, long_loca, glyf, i, &start, &length )) continue;
+        new_glyf.len += (length + 1) & ~1;
+    }
+    short_loca = new_glyf.len < 0x20000;
+    new_glyf.len = 0;
+    for (i = 0; i <= glyphs.count; i++)
+    {
+        UINT32 start, length;
+
+        if (short_loca) buffer_add16( &new_loca, new_glyf.len / 2 );
+        else buffer_add32( &new_loca, new_glyf.len );
+        if (i == glyphs.count) break;
+        if (!is_kept( &glyphs, i ) || !get_glyph_span( loca, long_loca, glyf, i, &start, &length )) continue;
+        buffer_add( &new_glyf, glyf->data + start, length );
+        if (length % 2) buffer_grow( &new_glyf, 1 );
+    }
+
+    /* metrics: the glyphs past the last kept one but one share the metrics of that one, which are none */
+    new_h_long = min( h_long, last + 2 );
+    write_metrics( &new_hmtx, hmtx, h_long, new_h_long, &glyphs );
+    memcpy( new_hhea, hhea->data, 36 );
+    put_be16( new_hhea + 34, new_h_long );
+    if (vhea)
+    {
+        new_v_long = min( v_long, last + 2 );
+        write_metrics( &new_vmtx, vmtx, v_long, new_v_long, &glyphs );
+        memcpy( new_vhea, vhea->data, 36 );
+        put_be16( new_vhea + 34, new_v_long );
+    }
+
+    write_cmap( &new_cmap, cmap, &glyphs, range, &ms_rebuilt );
+
+    memcpy( new_head, head->data, 54 );
+    put_be16( new_head + 50, short_loca ? 0 : 1 );
+
+    if (!(tables = calloc( font->count + 2, sizeof(*tables) )))
+    {
+        ret = ERR_MEM;
+        goto done;
+    }
+    eblc = find_table( font, TAG('E','B','L','C') );
+    ebdt = find_table( font, TAG('E','B','D','T') );
+    if (!eblc || !ebdt)
+    {
+        eblc = find_table( font, TAG('C','B','L','C') );
+        ebdt = find_table( font, TAG('C','B','D','T') );
+    }
+    if (eblc && ebdt && !write_bitmaps( &new_eblc, &new_ebdt, eblc, ebdt, &glyphs ))
+    {
+        WARN( "bitmaps left as they are\n" );
+        free( new_eblc.data );
+        free( new_ebdt.data );
+        memset( &new_eblc, 0, sizeof(new_eblc) );
+        memset( &new_ebdt, 0, sizeof(new_ebdt) );
+        eblc = ebdt = NULL;
+    }
+
+    for (i = 0; i < font->count; i++)
+    {
+        const struct table *table = &font->tables[i];
+        struct new_table *new = &tables[count];
+
+        new->tag = table->tag;
+        new->data = table->data;
+        new->len = table->len;
+        switch (table->tag)
+        {
+        case TAG('h','e','a','d'): new->data = new_head; new->len = 54; break;
+        case TAG('h','h','e','a'): new->data = new_hhea; new->len = 36; break;
+        case TAG('h','m','t','x'): new->data = new_hmtx.data; new->len = new_hmtx.len; break;
+        case TAG('g','l','y','f'): new->data = new_glyf.data; new->len = new_glyf.len; break;
+        case TAG('l','o','c','a'): new->data = new_loca.data; new->len = new_loca.len; break;
+        case TAG('c','m','a','p'): new->data = new_cmap.data; new->len = new_cmap.len; break;
+        case TAG('v','h','e','a'): if (vhea) { new->data = new_vhea; new->len = 36; } break;
+        case TAG('v','m','t','x'): if (vhea) { new->data = new_vmtx.data; new->len = new_vmtx.len; } break;
+        case TAG('p','o','s','t'):
+            /* the glyph names go */
+            if (table->len >= 32)
+            {
+                memcpy( new_post, table->data, 32 );
+                put_be32( new_post, 0x00030000 );
+                new->data = new_post;
+                new->len = 32;
+            }
+            break;
+        case TAG('L','T','S','H'):
+            /* the glyphs that go have no threshold */
+            if (table->len >= 4 && (new_ltsh = malloc( table->len )))
+            {
+                UINT32 count = min( get_be16( table->data + 2 ), min( table->len - 4, glyphs.count )), g;
+
+                memcpy( new_ltsh, table->data, table->len );
+                for (g = 0; g < count; g++) if (!is_kept( &glyphs, g )) new_ltsh[4 + g] = 0;
+                new->data = new_ltsh;
+            }
+            break;
+        case TAG('h','d','m','x'):
+            /* nor widths, and the widest of a size is the widest kept glyph */
+            if (table->len >= 8 && (new_hdmx = malloc( table->len )))
+            {
+                UINT32 records = get_be16( table->data + 2 ), size = get_be32( table->data + 4 ), r, g;
+                UINT32 count = min( glyphs.count, size >= 2 ? size - 2 : 0 );
+
+                memcpy( new_hdmx, table->data, table->len );
+                for (r = 0; r < records && size && (table->len - 8) / size > r; r++)
+                {
+                    BYTE *record = new_hdmx + 8 + r * size, widest = 0;
+
+                    for (g = 0; g < count; g++)
+                    {
+                        if (!is_kept( &glyphs, g )) record[2 + g] = 0;
+                        widest = max( widest, record[2 + g] );
+                    }
+                    record[1] = widest;
+                }
+                new->data = new_hdmx;
+            }
+            break;
+        case TAG('k','e','r','n'):
+            write_kern( &new_kern, table, &glyphs );
+            if (!new_kern.len && !new_kern.failed) continue;
+            new->data = new_kern.data;
+            new->len = new_kern.len;
+            break;
+        case TAG('E','B','L','C'):
+        case TAG('C','B','L','C'):
+            if (table != eblc) break;
+            /* no bitmaps left, no tables */
+            if (!new_eblc.len) continue;
+            new->data = new_eblc.data;
+            new->len = new_eblc.len;
+            break;
+        case TAG('E','B','D','T'):
+        case TAG('C','B','D','T'):
+            if (table != ebdt) break;
+            if (!new_ebdt.len) continue;
+            new->data = new_ebdt.data;
+            new->len = new_ebdt.len;
+            break;
+        case TAG('n','a','m','e'):
+            if (write_name( &new_name, table ))
+            {
+                new->data = new_name.data;
+                new->len = new_name.len;
+            }
+            else new_name.failed = FALSE;
+            break;
+        case TAG('m','a','x','p'):
+            if ((new_maxp = malloc( table->len )))
+            {
+                memcpy( new_maxp, table->data, table->len );
+                update_maxp( new_maxp, table->len, font, loca, long_loca, glyf, &glyphs );
+                new->data = new_maxp;
+            }
+            break;
+        case TAG('O','S','/','2'):
+            /* Windows gives the new range of characters only when it rebuilt a subtable of the Microsoft platform
+             * of its own, not one it shares with the subtable of another platform before it */
+            if (!ms_rebuilt || range[0] == ~0u) break;
+            if (table->len >= 68 && (new_os2 = malloc( table->len )))
+            {
+                memcpy( new_os2, table->data, table->len );
+                put_be16( new_os2 + 64, min( range[0], 0xffff ));
+                put_be16( new_os2 + 66, min( range[1], 0xffff ));
+                new->data = new_os2;
+                new->len = table->len;
+            }
+            break;
+        }
+        count++;
+    }
+
+    if (new_glyf.failed || new_loca.failed || new_hmtx.failed || new_vmtx.failed || new_cmap.failed || new_kern.failed ||
+        new_eblc.failed || new_ebdt.failed)
+        ret = ERR_MEM;
+    else
+        ret = write_font( tables, count, dest, dest_len, written, reallocproc );
+    free( tables );
+
+done:
+    free( new_ltsh );
+    free( new_hdmx );
+    free( glyphs.bits );
+    free( new_glyf.data );
+    free( new_loca.data );
+    free( new_hmtx.data );
+    free( new_vmtx.data );
+    free( new_cmap.data );
+    free( new_kern.data );
+    free( new_eblc.data );
+    free( new_ebdt.data );
+    free( new_name.data );
+    free( new_os2 );
+    free( new_maxp );
+    return ret;
+}
+
 ULONG __cdecl CreateFontPackage(const unsigned char *src, const ULONG src_len, unsigned char **dest,
     ULONG *dest_len, ULONG *written, const unsigned short flags, const unsigned short face_index,
     const unsigned short format, const unsigned short lang, const unsigned short platform, const unsigned short encoding,
     const unsigned short *keep_list, const unsigned short keep_len, CFP_ALLOCPROC allocproc,
     CFP_REALLOCPROC reallocproc, CFP_FREEPROC freeproc, void *reserved)
 {
-    FIXME("(%p %lu %p %p %p %#x %u %u %u %u %u %p %u %p %p %p %p): stub\n", src, src_len, dest, dest_len,
+    struct font font = {0};
+    ULONG offset = 0, ret;
+
+    TRACE("(%p %lu %p %p %p %#x %u %u %u %u %u %p %u %p %p %p %p)\n", src, src_len, dest, dest_len,
         written, flags, face_index, format, lang, platform, encoding, keep_list, keep_len, allocproc,
         reallocproc, freeproc, reserved);
 
+    if (!src) return ERR_PARAMETER0;
+    if (!src_len) return ERR_PARAMETER1;
+    if (!dest) return ERR_PARAMETER2;
+    if (!dest_len) return ERR_PARAMETER3;
+    if (!written) return ERR_PARAMETER4;
+    if (format > TTFCFP_DELTA) return ERR_PARAMETER7;
+    if (!reallocproc) return ERR_PARAMETER14;
+
+    if (flags & TTFCFP_FLAGS_TTC)
+    {
+        if (src_len < 16 || get_be32( src ) != TAG('t','t','c','f') || face_index >= get_be32( src + 8 ) ||
+            (src_len - 12) / 4 <= face_index)
+            return ERR_PARAMETER6;
+        offset = get_be32( src + 12 + face_index * 4 );
+    }
+
+    /* without TTFCFP_FLAGS_SUBSET there is nothing to do, and nothing is written: compressing is not done here */
+    if (!(flags & TTFCFP_FLAGS_SUBSET)) return NO_ERROR;
     if (format != TTFCFP_SUBSET)
+    {
+        FIXME("format %u not supported\n", format);
         return ERR_GENERIC;
+    }
 
-    *dest = allocproc(src_len);
-    if (!*dest)
-        return ERR_MEM;
+    if (lang != TTFCFP_LANG_KEEP_ALL) FIXME("language %#x kept as all of them\n", lang);
+    if ((ret = read_font( src, src_len, offset, &font ))) return ret;
+    ret = make_subset( &font, keep_list, keep_len, (flags & TTFCFP_FLAGS_GLYPHLIST) != 0, platform, encoding,
+                       dest, dest_len, written, reallocproc );
+    free( font.tables );
+    TRACE("returning %lu, %lu bytes from %lu\n", ret, *written, src_len);
+    return ret;
+}
+
+ULONG __cdecl MergeFontPackage(const unsigned char *merge, const ULONG merge_len, const unsigned char *package,
+    const ULONG package_len, unsigned char **dest, ULONG *dest_len, ULONG *written, const unsigned short mode,
+    CFP_ALLOCPROC allocproc, CFP_REALLOCPROC reallocproc, CFP_FREEPROC freeproc, void *reserved)
+{
+    struct font font = {0};
+    BOOL delta;
+    ULONG ret;
+
+    TRACE("(%p %lu %p %lu %p %p %p %u %p %p %p %p)\n", merge, merge_len, package, package_len, dest, dest_len,
+        written, mode, allocproc, reallocproc, freeproc, reserved);
 
-    memcpy(*dest, src, src_len);
-    *dest_len = src_len;
-    *written = src_len;
+    if (!package) return ERR_PARAMETER2;
+    if (!package_len) return ERR_PARAMETER3;
+    if (!dest) return ERR_PARAMETER4;
+    if (!dest_len) return ERR_PARAMETER5;
+    if (!written) return ERR_PARAMETER6;
+    if (mode > TTFMFP_DELTA) return ERR_PARAMETER7;
+    if (!reallocproc) return ERR_PARAMETER9;
+    *written = 0;
+
+    if ((ret = read_font( package, package_len, 0, &font ))) return ret;
+    /* the packages of the other formats carry the glyph indices of the font they come from */
+    delta = find_table( &font, TAG('d','t','t','f') ) != NULL;
+    free( font.tables );
+    if (mode != TTFMFP_SUBSET)
+    {
+        FIXME("mode %u not supported\n", mode);
+        return ERR_GENERIC;
+    }
+    if (delta) return ERR_FORMAT;
 
+    /* a working font is copied as it is */
+    if (!(*dest = reallocproc( NULL, package_len ))) return ERR_MEM;
+    memcpy( *dest, package, package_len );
+    *dest_len = package_len;
+    *written = package_len;
     return NO_ERROR;
 }
