+
+    /* the metrics stay as they are when the last glyph is kept */
+    keep[1] = glyph_count - 1;
+    package = NULL;
+    ret = CreateFontPackage( font, size, &package, &package_size, &written, TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST,
+                             0, TTFCFP_SUBSET, 0, TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, keep, 2, alloc_proc,
+                             realloc_proc, free_proc, NULL );
+    ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+    if (!ret)
+    {
+        table = find_table( package, written, "hmtx", &table_len );
+        orig = find_table( font, size, "hmtx", &orig_len );
+        ok( table && table_len == orig_len && !memcmp( table, orig, orig_len ), "hmtx changed, %lu bytes\n", table_len );
+        free( package );
+    }
+
+    /* OS/2 gets the new range of characters only when a subtable of the Microsoft platform is rebuilt on its own */
+    for (i = 0; i < 2; i++)
+    {
+        winetest_push_context( i ? "shared" : "own" );
+        cmap = make_letters_cmap( a, i, FALSE, &cmap_len );
+        made = make_font( font, NULL, "cmap", cmap, cmap_len, &made_size );
+        package = NULL;
+        ret = CreateFontPackage( made, made_size, &package, &package_size, &written,
+                                 TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST, 0, TTFCFP_SUBSET, 0,
+                                 TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, keep, 1, alloc_proc, realloc_proc, free_proc,
+                                 NULL );
+        ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+        if (!ret)
+        {
+            table = find_table( package, written, "OS/2", &table_len );
+            orig = find_table( made, made_size, "OS/2", &orig_len );
+            sub = find_subtable( package, written, 3, 1, &sub_len );
+            ok( sub && be16( sub ) == 4, "no format 4 subtable\n" );
+            if (table && orig && sub)
+            {
+                segs = be16( sub + 6 ) / 2;
+                low = be16( sub + 16 + segs * 2 );
+                high = be16( sub + 14 + (segs >= 2 ? segs - 2 : 0) * 2 );
+                if (i) ok( be16( table + 64 ) == be16( orig + 64 ) && be16( table + 66 ) == be16( orig + 66 ),
+                           "got %04x-%04x, the font has %04x-%04x\n", be16( table + 64 ), be16( table + 66 ),
+                           be16( orig + 64 ), be16( orig + 66 ));
+                else ok( be16( table + 64 ) == low && be16( table + 66 ) == high, "got %04x-%04x, the cmap %04x-%04x\n",
+                         be16( table + 64 ), be16( table + 66 ), low, high );
+            }
+            free( package );
+        }
+        free( made );
+        free( cmap );
+        winetest_pop_context();
+    }
+
+    /* variation sequences stay as they are, the one of a glyph that goes too */
+    cmap = make_letters_cmap( a, TRUE, TRUE, &cmap_len );
+    made = make_font( font, NULL, "cmap", cmap, cmap_len, &made_size );
+    package = NULL;
+    ret = CreateFontPackage( made, made_size, &package, &package_size, &written, TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST,
+                             0, TTFCFP_SUBSET, 0, TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, keep, 1, alloc_proc,
+                             realloc_proc, free_proc, NULL );
+    ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+    if (!ret)
+    {
+        sub = find_subtable( package, written, 0, 5, &sub_len );
+        orig = find_subtable( made, made_size, 0, 5, &orig_len );
+        ok( sub && sub_len == orig_len && !memcmp( sub, orig, orig_len ), "the variations changed\n" );
+        free( package );
+    }
+    free( made );
+    free( cmap );
+
+    /* a string goes inside the longest one holding it, not the first */
+    cmap = make_name( strings, ARRAY_SIZE(strings), &cmap_len );
+    made = make_font( font, NULL, "name", cmap, cmap_len, &made_size );
+    package = NULL;
+    ret = CreateFontPackage( made, made_size, &package, &package_size, &written, TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST,
+                             0, TTFCFP_SUBSET, 0, TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, keep, 1, alloc_proc,
+                             realloc_proc, free_proc, NULL );
+    ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+    if (!ret)
+    {
+        table = find_table( package, written, "name", &table_len );
+        ok( table && be16( table + 2 ) == 3, "got %u records\n", table ? be16( table + 2 ) : 0 );
+        if (table && be16( table + 2 ) == 3)
+        {
+            ok( !be16( table + 6 + 10 ), "the first string is at %u\n", be16( table + 6 + 10 ));
+            ok( be16( table + 6 + 2 * 12 + 10 ) == 42, "the third string is at %u\n", be16( table + 6 + 2 * 12 + 10 ));
+            ok( be16( table + 6 + 12 + 10 ) == 42 + 24, "the second string is at %u\n", be16( table + 6 + 12 + 10 ));
+            ok( table_len == 6 + 3 * 12 + 42 + 76, "got %lu bytes\n", table_len );
+        }
+        free( package );
+    }
+    free( made );
+    free( cmap );
+}
+
+START_TEST(fontsub)
+{
+    LOGFONTA lf = {0};
+    HFONT font, old;
+    BYTE *data;
+    DWORD size;
+    HDC hdc;
+
+    hdc = CreateCompatibleDC( 0 );
+    lf.lfHeight = -20;
+    strcpy( lf.lfFaceName, "Tahoma" );
+    font = CreateFontIndirectA( &lf );
+    old = SelectObject( hdc, font );
+    size = GetFontData( hdc, 0, 0, NULL, 0 );
+    if (size == GDI_ERROR || !size)
+    {
+        skip( "no data for Tahoma\n" );
+        SelectObject( hdc, old );
+        DeleteObject( font );
+        DeleteDC( hdc );
+        return;
+    }
+    data = malloc( size );
+    GetFontData( hdc, 0, 0, data, size );
+
+    test_parameters( data, size );
+    test_subset( hdc, data, size );
+    test_tables( hdc, data, size );
+
+    free( data );
+    SelectObject( hdc, old );
+    DeleteObject( font );
+    DeleteDC( hdc );
+}
