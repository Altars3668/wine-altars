+    ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+    if (!ret)
+    {
+        table = find_table( package, written, "head", &table_len );
+        ok( table && !be16( table + 50 ), "got loca format %u\n", table ? be16( table + 50 ) : 0 );
+        table = find_table( package, written, "glyf", &table_len );
+        ok( table && !(table_len % 2), "glyf is %lu bytes\n", table_len );
+        free( package );
