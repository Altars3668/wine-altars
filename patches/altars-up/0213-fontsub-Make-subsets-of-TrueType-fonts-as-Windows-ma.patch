+static void test_subset( HDC hdc, const BYTE *font, ULONG size )
+{
+    static const WCHAR text[] = L"Hello";
+    const BYTE *orig_data, *data, *table;
+    unsigned char *package, *subset;
+    unsigned short keep[8];
+    ULONG package_size, written, ret, length, orig_len, table_len, made_size;
+    const BYTE *cmap;
+    BYTE *made;
+    WORD glyphs[8], z, m;
+    unsigned int i, glyph_count;
+
+    GetGlyphIndicesW( hdc, text, 5, glyphs, 0 );
+    GetGlyphIndicesW( hdc, L"Z", 1, &z, 0 );
+    GetGlyphIndicesW( hdc, L"M", 1, &m, 0 );
+    for (i = 0; i < 5; i++) keep[i] = glyphs[i];
+
+    package = NULL;
+    package_size = written = 0;
+    ret = CreateFontPackage( font, size, &package, &package_size, &written, TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST,
+                             0, TTFCFP_SUBSET, TTFCFP_LANG_KEEP_ALL, TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, keep, 5,
+                             alloc_proc, realloc_proc, free_proc, NULL );
+    ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+    if (ret) return;
+    subset = package;
+    ok( written > 12 && written <= package_size, "wrote %lu bytes of %lu\n", written, package_size );
+    ok( written < size, "the subset is %lu bytes, the font %lu\n", written, size );
+    ok( be32( subset ) == 0x00010000, "got version %#x\n", be32( subset ));
+    ok( checksums_valid( subset, written ), "the checksums are wrong\n" );
+
+    /* the glyphs keep their indices */
+    table = find_table( subset, written, "maxp", &table_len );
+    ok( table != NULL, "no maxp\n" );
+    glyph_count = be16( table + 4 );
+    table = find_table( font, size, "maxp", &table_len );
+    ok( glyph_count == be16( table + 4 ), "got %u glyphs, the font has %u\n", glyph_count, be16( table + 4 ));
+
+    for (i = 0; i < 5; i++)
+    {
+        winetest_push_context( "glyph %u", glyphs[i] );
+        orig_len = glyph_length( font, size, glyphs[i], &orig_data );
+        length = glyph_length( subset, written, glyphs[i], &data );
+        ok( length == orig_len && !memcmp( data, orig_data, length ), "the outline changed, %lu bytes, %lu before\n",
+            length, orig_len );
+        ok( advance_width( subset, written, glyphs[i] ) == advance_width( font, size, glyphs[i] ), "the advance changed\n" );
+        ok( map_char( subset, written, text[i] ) == glyphs[i], "U+%04x maps to %d\n", text[i],
+            map_char( subset, written, text[i] ));
+        winetest_pop_context();
+    }
+    /* the others lose their outlines, metrics and characters */
+    length = glyph_length( subset, written, z, &data );
+    ok( !length, "Z has %lu bytes\n", length );
+    ok( !advance_width( subset, written, z ), "Z is %u wide\n", advance_width( subset, written, z ));
+    ok( map_char( subset, written, 'Z' ) == 0, "Z maps to %d\n", map_char( subset, written, 'Z' ));
+    /* but some are kept whenever a list is given */
+    length = glyph_length( subset, written, m, &data );
+    ok( length && length == glyph_length( font, size, m, &orig_data ), "M has %lu bytes\n", length );
+    ok( map_char( subset, written, 'M' ) == m, "M maps to %d\n", map_char( subset, written, 'M' ));
+
+    /* the glyph names go */
+    table = find_table( subset, written, "post", &table_len );
+    ok( table && table_len == 32 && be32( table ) == 0x00030000, "got post %#x, %lu bytes\n", table ? be32( table ) : 0,
+        table_len );
+    /* the metrics of the glyphs past the last kept one but one are the same as that one's */
+    table = find_table( subset, written, "hhea", &table_len );
+    ok( be16( table + 34 ) <= glyph_count, "got %u metrics\n", be16( table + 34 ));
+    free( package );
+
+    /* the same from the characters */
+    for (i = 0; i < 5; i++) keep[i] = text[i];
+    package = NULL;
+    ret = CreateFontPackage( font, size, &package, &package_size, &written, TTFCFP_FLAGS_SUBSET, 0, TTFCFP_SUBSET,
+                             TTFCFP_LANG_KEEP_ALL, TTFCFP_MS_PLATFORMID, TTFCFP_UNICODE_CHAR_SET, keep, 5, alloc_proc,
+                             realloc_proc, free_proc, NULL );
+    ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+    if (!ret)
+    {
+        for (i = 0; i < 5; i++)
+        {
+            length = glyph_length( package, written, glyphs[i], &data );
+            ok( length == glyph_length( font, size, glyphs[i], &orig_data ), "glyph %u has %lu bytes\n", glyphs[i], length );
+        }
+        ok( !glyph_length( package, written, z, &data ), "Z has an outline\n" );
+        free( package );
+    }
+
+    /* no list: only the glyphs kept whatever the text */
+    package = NULL;
+    ret = CreateFontPackage( font, size, &package, &package_size, &written, TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST,
+                             0, TTFCFP_SUBSET, TTFCFP_LANG_KEEP_ALL, TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, NULL, 3,
+                             alloc_proc, realloc_proc, free_proc, NULL );
+    ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+    if (!ret)
+    {
+        ok( checksums_valid( package, written ), "the checksums are wrong\n" );
+        ok( !glyph_length( package, written, m, &data ), "M has an outline\n" );
+        ok( !glyph_length( package, written, glyphs[0], &data ), "H has an outline\n" );
+        free( package );
+    }
+
+    /* a subtable that is left mapping nothing maps character 0 to glyph 0, in format 4 and in format 12 */
+    cmap = make_cmap( glyphs[0] );
+    made = make_font( font, NULL, "cmap", cmap, sizeof(cmap_template), &made_size );
+    package = NULL;
+    ret = CreateFontPackage( made, made_size, &package, &package_size, &written,
+                             TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST, 0, TTFCFP_SUBSET, TTFCFP_LANG_KEEP_ALL,
+                             TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, NULL, 3, alloc_proc, realloc_proc, free_proc, NULL );
+    ok( !ret, "CreateFontPackage failed, %lu\n", ret );
+    if (!ret)
+    {
+        table = find_table( package, written, "cmap", &table_len );
+        ok( table && be16( table + 2 ) == 2, "got %u subtables\n", table ? be16( table + 2 ) : 0 );
+        if (table && be16( table + 2 ) == 2)
+        {
+            const BYTE *format4 = table + be32( table + 8 ), *format12 = table + be32( table + 16 );
+
+            ok( be16( format4 ) == 4 && be16( format4 + 2 ) == 32 && be16( format4 + 6 ) == 4, "got format %u, %u bytes, "
+                "%u segments\n", be16( format4 ), be16( format4 + 2 ), be16( format4 + 6 ) / 2 );
+            ok( !be16( format4 + 14 ) && !be16( format4 + 20 ) && !be16( format4 + 24 ), "got %04x-%04x delta %u\n",
+                be16( format4 + 20 ), be16( format4 + 14 ), be16( format4 + 24 ));
+            ok( be16( format12 ) == 12 && be32( format12 + 4 ) == 28 && be32( format12 + 12 ) == 1,
+                "got format %u, %u bytes, %u groups\n", be16( format12 ), be32( format12 + 4 ), be32( format12 + 12 ));
+            ok( !be32( format12 + 16 ) && !be32( format12 + 20 ) && !be32( format12 + 24 ), "got %x-%x glyph %u\n",
+                be32( format12 + 16 ), be32( format12 + 20 ), be32( format12 + 24 ));
+        }
+        free( package );
+    }
+    free( made );
+
+    /* MergeFontPackage copies a working font as it is */
+    package = NULL;
+    ret = CreateFontPackage( font, size, &package, &package_size, &written, TTFCFP_FLAGS_SUBSET | TTFCFP_FLAGS_GLYPHLIST,
+                             0, TTFCFP_SUBSET, TTFCFP_LANG_KEEP_ALL, TTFCFP_MS_PLATFORMID, TTFCFP_DONT_CARE, keep, 5,
+                             alloc_proc, realloc_proc, free_proc, NULL );
+    if (!ret)
+    {
+        unsigned char *merged = NULL;
+        ULONG merged_size = 0, merged_written = 0;
+
+        ret = MergeFontPackage( NULL, 0, package, written, &merged, &merged_size, &merged_written, TTFMFP_SUBSET,
+                                alloc_proc, realloc_proc, free_proc, NULL );
+        ok( !ret, "MergeFontPackage failed, %lu\n", ret );
+        ok( merged_written == written && merged && !memcmp( merged, package, written ), "the font changed\n" );
+        free( merged );
+        free( package );
+    }
+}
