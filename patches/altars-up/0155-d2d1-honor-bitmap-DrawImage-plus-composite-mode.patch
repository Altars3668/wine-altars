From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 06:30:38 -0400
Subject: [PATCH] d2d1: honor bitmap DrawImage plus composite mode

Select additive or source-over GPU blending for bitmap images independently of the primitive blend setting, with pixel and state-restoration tests.

Co-Authored-By: Claude Code <noreply@anthropic.com>
(cherry picked from commit e90372853771bcca3a2437aba3dc91e6693f1edf)

diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 9687eb0cdc4..57c4b414733 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -3260,12 +3260,19 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawImage(ID2D1DeviceContext6 *
         return;
     }
 
-    if (composite_mode != D2D1_COMPOSITE_MODE_SOURCE_OVER)
+    if (composite_mode != D2D1_COMPOSITE_MODE_SOURCE_OVER && composite_mode != D2D1_COMPOSITE_MODE_PLUS)
         FIXME("Unhandled composite mode %#x.\n", composite_mode);
 
     if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Bitmap, (void **)&bitmap)))
     {
+        D2D1_PRIMITIVE_BLEND previous_blend = context->drawing_state.primitiveBlend;
+
+        if (composite_mode == D2D1_COMPOSITE_MODE_SOURCE_OVER)
+            context->drawing_state.primitiveBlend = D2D1_PRIMITIVE_BLEND_SOURCE_OVER;
+        else if (composite_mode == D2D1_COMPOSITE_MODE_PLUS)
+            context->drawing_state.primitiveBlend = D2D1_PRIMITIVE_BLEND_ADD;
         d2d_device_context_draw_bitmap(context, bitmap, NULL, 1.0f, interpolation_mode, image_rect, target_offset, NULL);
+        context->drawing_state.primitiveBlend = previous_blend;
 
         ID2D1Bitmap_Release(bitmap);
         return;
diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index 209c4625701..70b6554a15a 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -18515,9 +18515,13 @@ static void test_primitive_blend_add(BOOL d3d11)
     struct d2d1_test_context ctx;
     struct resource_readback rb;
     ID2D1SolidColorBrush *red, *blue;
+    D2D1_BITMAP_PROPERTIES bitmap_desc;
+    D2D1_SIZE_U bitmap_size = {4, 4};
+    ID2D1Bitmap *bitmap = NULL;
     D2D1_COLOR_F color;
     D2D1_RECT_F rect;
-    DWORD pixel;
+    DWORD bitmap_data[16], pixel;
+    unsigned int i;
     HRESULT hr;
 
     if (!init_test_context(&ctx, d3d11)) return;
@@ -18555,6 +18559,44 @@ static void test_primitive_blend_add(BOOL d3d11)
     ok(compare_colour(pixel, 0xc0400080, 3), "Source-over blend produced %#lx.\n", pixel);
     release_resource_readback(&rb);
 
+    for (i = 0; i < ARRAY_SIZE(bitmap_data); ++i) bitmap_data[i] = 0x80000080;
+    bitmap_desc.pixelFormat = ID2D1RenderTarget_GetPixelFormat(ctx.rt);
+    bitmap_desc.dpiX = bitmap_desc.dpiY = 96.0f;
+    hr = ID2D1RenderTarget_CreateBitmap(ctx.rt, bitmap_size, bitmap_data, 4 * sizeof(DWORD),
+            &bitmap_desc, &bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    if (bitmap)
+    {
+        ID2D1DeviceContext_BeginDraw(ctx.context);
+        ID2D1DeviceContext_Clear(ctx.context, &color);
+        ID2D1DeviceContext_FillRectangle(ctx.context, &rect, (ID2D1Brush *)red);
+        ID2D1DeviceContext_DrawImage(ctx.context, (ID2D1Image *)bitmap, NULL, NULL,
+                D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR, D2D1_COMPOSITE_MODE_PLUS);
+        hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        get_surface_readback(&ctx, &rb);
+        pixel = get_readback_colour(&rb, 1, 1);
+        ok(compare_colour(pixel, 0xff800080, 3), "Plus composite produced %#lx.\n", pixel);
+        release_resource_readback(&rb);
+
+        ID2D1DeviceContext_SetPrimitiveBlend(ctx.context, D2D1_PRIMITIVE_BLEND_ADD);
+        ID2D1DeviceContext_BeginDraw(ctx.context);
+        ID2D1DeviceContext_Clear(ctx.context, &color);
+        ID2D1DeviceContext_FillRectangle(ctx.context, &rect, (ID2D1Brush *)red);
+        ID2D1DeviceContext_DrawImage(ctx.context, (ID2D1Image *)bitmap, NULL, NULL,
+                D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+        hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        get_surface_readback(&ctx, &rb);
+        pixel = get_readback_colour(&rb, 1, 1);
+        ok(compare_colour(pixel, 0xc0400080, 3), "Source-over composite produced %#lx.\n", pixel);
+        release_resource_readback(&rb);
+        ok(ID2D1DeviceContext_GetPrimitiveBlend(ctx.context) == D2D1_PRIMITIVE_BLEND_ADD,
+                "DrawImage changed the primitive blend setting.\n");
+        ID2D1DeviceContext_SetPrimitiveBlend(ctx.context, D2D1_PRIMITIVE_BLEND_SOURCE_OVER);
+        ID2D1Bitmap_Release(bitmap);
+    }
+
     ID2D1SolidColorBrush_Release(blue);
     ID2D1SolidColorBrush_Release(red);
     release_test_context(&ctx);
