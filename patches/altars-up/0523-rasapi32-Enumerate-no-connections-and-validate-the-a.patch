From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 09:40:31 -0400
Subject: [PATCH] rasapi32: Enumerate no connections and validate the arguments
 as Windows does.

There are no RAS connections, which is no reason for a FIXME.  Windows
11 checks the buffer length and the structure size, which may be that
of any RAS version from 4.00 to 6.00, and answers with a needed size;
connection notifications for all connections are accepted for a real
event (tools/prefixupdateprobe ras in wine-altars, from a Claudex run).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/rasapi32/rasapi.c b/dlls/rasapi32/rasapi.c
index a7f3baf4953..047cc0e90c2 100644
--- a/dlls/rasapi32/rasapi.c
+++ b/dlls/rasapi32/rasapi.c
@@ -22,22 +22,31 @@
 
 #include "windef.h"
 #include "winbase.h"
+#include "winternl.h"
 #include "ras.h"
 #include "raserror.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(ras);
 
+/* the sizes of the structure for the RAS versions an application may be built for: 4.00, 4.01, 5.00, 5.01, 6.00 */
+#define RASCONN_SIZE_VALID(type, size) \
+    ((size) == ((FIELD_OFFSET(type, szPhonebook) + 3) & ~3) || (size) == FIELD_OFFSET(type, guidEntry) || \
+     (size) == FIELD_OFFSET(type, dwFlags) || (size) == FIELD_OFFSET(type, guidCorrelationId) || (size) == sizeof(type))
+
 DWORD WINAPI RasConnectionNotificationA(HRASCONN hrasconn, HANDLE hEvent, DWORD dwFlags)
 {
-    FIXME("(%p,%p,0x%08lx),stub!\n",hrasconn,hEvent,dwFlags);
-    return 1;
+    return RasConnectionNotificationW(hrasconn, hEvent, dwFlags);
 }
 
 DWORD WINAPI RasConnectionNotificationW(HRASCONN hrasconn, HANDLE hEvent, DWORD dwFlags)
 {
-    FIXME("(%p,%p,0x%08lx),stub!\n",hrasconn,hEvent,dwFlags);
-    return 1;
+    EVENT_BASIC_INFORMATION info;
+
+    TRACE("(%p,%p,0x%08lx)\n", hrasconn, hEvent, dwFlags);
+    if (NtQueryEvent(hEvent, EventBasicInformation, &info, sizeof(info), NULL)) return E_INVALIDARG;
+    if (hrasconn != (HRASCONN)INVALID_HANDLE_VALUE) return ERROR_INVALID_HANDLE;
+    return ERROR_SUCCESS;
 }
 
 DWORD WINAPI RasCreatePhonebookEntryA(HWND hwnd, LPCSTR lpszPhonebook)
@@ -99,27 +108,39 @@ DWORD WINAPI RasEditPhonebookEntryW(HWND hwnd, LPCWSTR lpszPhonebook, LPCWSTR lp
 /**************************************************************************
  *                 RasEnumConnectionsA			[RASAPI32.544]
  */
-DWORD WINAPI RasEnumConnectionsA( LPRASCONNA rca, LPDWORD lpcb, LPDWORD lpcConnections) {
-	/* Remote Access Service stuff is done by underlying OS anyway */
-	FIXME("(%p,%p,%p),stub!\n",rca,lpcb,lpcConnections);
-	FIXME("RAS support is not implemented! Configure program to use LAN connection/winsock instead!\n");
-	*lpcb = 0; /* size of buffer needed to enumerate connections */
-	*lpcConnections = 0; /* no RAS connections available */
-
-	return 0;
+DWORD WINAPI RasEnumConnectionsA( LPRASCONNA rca, LPDWORD lpcb, LPDWORD lpcConnections )
+{
+    TRACE("(%p,%p,%p)\n", rca, lpcb, lpcConnections);
+    if (!rca || !lpcb || !lpcConnections) return ERROR_INVALID_PARAMETER;
+    if (*lpcb < sizeof(DWORD) || !RASCONN_SIZE_VALID(RASCONNA, rca->dwSize)) return ERROR_INVALID_SIZE;
+    if (*lpcb < rca->dwSize)
+    {
+        *lpcb = rca->dwSize;
+        return ERROR_BUFFER_TOO_SMALL;
+    }
+    *lpcb = 0;
+    *lpcConnections = 0;
+    SetLastError(ERROR_SUCCESS);
+    return ERROR_SUCCESS;
 }
 
 /**************************************************************************
  *                 RasEnumConnectionsW			[RASAPI32.545]
  */
-DWORD WINAPI RasEnumConnectionsW( LPRASCONNW rcw, LPDWORD lpcb, LPDWORD lpcConnections) {
-	/* Remote Access Service stuff is done by underlying OS anyway */
-	FIXME("(%p,%p,%p),stub!\n",rcw,lpcb,lpcConnections);
-	FIXME("RAS support is not implemented! Configure program to use LAN connection/winsock instead!\n");
-	*lpcb = 0; /* size of buffer needed to enumerate connections */
-	*lpcConnections = 0; /* no RAS connections available */
-
-	return 0;
+DWORD WINAPI RasEnumConnectionsW( LPRASCONNW rcw, LPDWORD lpcb, LPDWORD lpcConnections )
+{
+    TRACE("(%p,%p,%p)\n", rcw, lpcb, lpcConnections);
+    if (!rcw || !lpcb || !lpcConnections) return ERROR_INVALID_PARAMETER;
+    if (*lpcb < sizeof(DWORD) || !RASCONN_SIZE_VALID(RASCONNW, rcw->dwSize)) return ERROR_INVALID_SIZE;
+    if (*lpcb < rcw->dwSize)
+    {
+        *lpcb = rcw->dwSize;
+        return ERROR_BUFFER_TOO_SMALL;
+    }
+    *lpcb = 0;
+    *lpcConnections = 0;
+    SetLastError(ERROR_SUCCESS);
+    return ERROR_SUCCESS;
 }
 
 /**************************************************************************
diff --git a/dlls/rasapi32/tests/rasapi.c b/dlls/rasapi32/tests/rasapi.c
index 167b5a3828d..6ec7a16d738 100644
--- a/dlls/rasapi32/tests/rasapi.c
+++ b/dlls/rasapi32/tests/rasapi.c
@@ -28,6 +28,10 @@
 
 static HMODULE hmodule;
 static DWORD (WINAPI *pRasEnumDevicesA)(LPRASDEVINFOA, LPDWORD, LPDWORD);
+static DWORD (WINAPI *pRasEnumConnectionsA)(LPRASCONNA, LPDWORD, LPDWORD);
+static DWORD (WINAPI *pRasEnumConnectionsW)(LPRASCONNW, LPDWORD, LPDWORD);
+static DWORD (WINAPI *pRasConnectionNotificationA)(HRASCONN, HANDLE, DWORD);
+static DWORD (WINAPI *pRasConnectionNotificationW)(HRASCONN, HANDLE, DWORD);
 
 #define RASAPI32_GET_PROC(func) \
     p ## func = (void*)GetProcAddress(hmodule, #func); \
@@ -39,6 +43,10 @@ static void InitFunctionPtrs(void)
     hmodule = LoadLibraryA("rasapi32.dll");
 
     RASAPI32_GET_PROC(RasEnumDevicesA)
+    RASAPI32_GET_PROC(RasEnumConnectionsA)
+    RASAPI32_GET_PROC(RasEnumConnectionsW)
+    RASAPI32_GET_PROC(RasConnectionNotificationA)
+    RASAPI32_GET_PROC(RasConnectionNotificationW)
 }
 
 static void test_rasenum(void)
@@ -176,11 +184,153 @@ static void test_rasenum(void)
     HeapFree(GetProcessHeap(), 0, rasDevInfo);
 }
 
+static void test_enum_connections(BOOL unicode)
+{
+    DWORD struct_size = unicode ? sizeof(RASCONNW) : sizeof(RASCONNA);
+    DWORD lengths[] = {0, 1, struct_size - 1, struct_size, struct_size + 1, 2 * struct_size, 65536};
+    DWORD invalid_sizes[] = {0, struct_size - 1, struct_size + 1};
+    /* older versions of the structure */
+    DWORD old_sizes[] =
+    {
+        unicode ? (FIELD_OFFSET(RASCONNW, szPhonebook) + 3) & ~3 : (FIELD_OFFSET(RASCONNA, szPhonebook) + 3) & ~3,
+        unicode ? FIELD_OFFSET(RASCONNW, guidEntry) : FIELD_OFFSET(RASCONNA, guidEntry),
+        unicode ? FIELD_OFFSET(RASCONNW, dwFlags) : FIELD_OFFSET(RASCONNA, dwFlags),
+        unicode ? FIELD_OFFSET(RASCONNW, guidCorrelationId) : FIELD_OFFSET(RASCONNA, guidCorrelationId),
+    };
+    DWORD size, count, result, expected, i;
+    BYTE *buffer;
+
+    if ((unicode && !pRasEnumConnectionsW) || (!unicode && !pRasEnumConnectionsA))
+    {
+        win_skip("RasEnumConnections%c is not available\n", unicode ? 'W' : 'A');
+        return;
+    }
+
+    buffer = HeapAlloc(GetProcessHeap(), 0, 65536);
+    ok(!!buffer, "allocation failed\n");
+    if (!buffer) return;
+    memset(buffer, 0xa5, 65536);
+    *(DWORD *)buffer = struct_size;
+    size = 65536;
+    count = 0xdeadbeef;
+    result = unicode ? pRasEnumConnectionsW((void *)buffer, &size, &count)
+                     : pRasEnumConnectionsA((void *)buffer, &size, &count);
+    if (result == ERROR_RASMAN_CANNOT_INITIALIZE || result == ERROR_STATE_MACHINES_NOT_STARTED ||
+        result == ERROR_SERVICE_DISABLED)
+    {
+        win_skip("RAS configuration problem, error %lu\n", result);
+        goto done;
+    }
+    ok(!result, "got error %lu\n", result);
+    if (result) goto done;
+    if (count)
+    {
+        skip("RAS connections are present; skipping empty enumeration tests\n");
+        goto done;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(lengths); ++i)
+    {
+        memset(buffer, 0xa5, 65536);
+        *(DWORD *)buffer = struct_size;
+        size = lengths[i];
+        count = 0xdeadbeef;
+        SetLastError(0xdeadbeef);
+        result = unicode ? pRasEnumConnectionsW((void *)buffer, &size, &count)
+                         : pRasEnumConnectionsA((void *)buffer, &size, &count);
+        expected = lengths[i] < sizeof(DWORD) ? ERROR_INVALID_SIZE :
+                   lengths[i] < struct_size ? ERROR_BUFFER_TOO_SMALL : ERROR_SUCCESS;
+        ok(result == expected, "%c length %lu: got error %lu, expected %lu\n",
+           unicode ? 'W' : 'A', lengths[i], result, expected);
+        expected = lengths[i] < sizeof(DWORD) ? lengths[i] : lengths[i] < struct_size ? struct_size : 0;
+        ok(size == expected, "length %lu: got size %lu, expected %lu\n", lengths[i], size, expected);
+        ok(count == (result ? 0xdeadbeef : 0), "length %lu: got count %lu\n", lengths[i], count);
+        ok(*(DWORD *)buffer == struct_size, "structure size changed\n");
+        ok(GetLastError() == (result ? 0xdeadbeef : ERROR_SUCCESS),
+           "length %lu: got last error %lu\n", lengths[i], GetLastError());
+    }
+
+    for (i = 0; i < ARRAY_SIZE(invalid_sizes); ++i)
+    {
+        *(DWORD *)buffer = invalid_sizes[i];
+        size = 65536;
+        count = 0xdeadbeef;
+        SetLastError(0xdeadbeef);
+        result = unicode ? pRasEnumConnectionsW((void *)buffer, &size, &count)
+                         : pRasEnumConnectionsA((void *)buffer, &size, &count);
+        ok(result == ERROR_INVALID_SIZE, "structure size %lu: got error %lu\n", invalid_sizes[i], result);
+        ok(size == 65536, "got size %lu\n", size);
+        ok(count == 0xdeadbeef, "got count %lu\n", count);
+        ok(GetLastError() == 0xdeadbeef, "got last error %lu\n", GetLastError());
+    }
+
+    for (i = 0; i < ARRAY_SIZE(old_sizes); ++i)
+    {
+        *(DWORD *)buffer = old_sizes[i];
+        size = 65536;
+        count = 0xdeadbeef;
+        result = unicode ? pRasEnumConnectionsW((void *)buffer, &size, &count)
+                         : pRasEnumConnectionsA((void *)buffer, &size, &count);
+        ok(!result, "structure size %lu: got error %lu\n", old_sizes[i], result);
+        ok(!count, "structure size %lu: got count %lu\n", old_sizes[i], count);
+    }
+
+done:
+    HeapFree(GetProcessHeap(), 0, buffer);
+}
+
+static void test_connection_notification(BOOL unicode)
+{
+    static const DWORD flags[] = {0, RASCN_Connection, RASCN_Disconnection,
+        RASCN_Connection | RASCN_Disconnection, RASCN_BandwidthAdded, RASCN_BandwidthRemoved,
+        15, 0x80000000};
+    DWORD (WINAPI *notify)(HRASCONN, HANDLE, DWORD);
+    DWORD result, i;
+    HANDLE event;
+
+    notify = unicode ? pRasConnectionNotificationW : pRasConnectionNotificationA;
+    if (!notify)
+    {
+        win_skip("RasConnectionNotification%c is not available\n", unicode ? 'W' : 'A');
+        return;
+    }
+    event = CreateEventW(NULL, TRUE, FALSE, NULL);
+    ok(!!event, "got error %lu\n", GetLastError());
+    if (!event) return;
+    result = notify((HRASCONN)INVALID_HANDLE_VALUE, event, RASCN_Connection);
+    if (result == ERROR_RASMAN_CANNOT_INITIALIZE || result == ERROR_STATE_MACHINES_NOT_STARTED ||
+        result == ERROR_SERVICE_DISABLED)
+    {
+        win_skip("RAS configuration problem, error %lu\n", result);
+        CloseHandle(event);
+        return;
+    }
+    ok(!result, "got error %lu\n", result);
+    for (i = 0; i < ARRAY_SIZE(flags); ++i)
+    {
+        SetLastError(0xdeadbeef);
+        result = notify((HRASCONN)INVALID_HANDLE_VALUE, event, flags[i]);
+        ok(!result, "%c flags %#lx: got error %lu\n", unicode ? 'W' : 'A', flags[i], result);
+        ok(GetLastError() == 0xdeadbeef, "got last error %lu\n", GetLastError());
+        result = WaitForSingleObject(event, 0);
+        ok(result == WAIT_TIMEOUT, "event was signaled, got %lu\n", result);
+    }
+    SetLastError(0xdeadbeef);
+    result = notify((HRASCONN)INVALID_HANDLE_VALUE, INVALID_HANDLE_VALUE, RASCN_Connection);
+    ok(result == E_INVALIDARG, "got error %#lx\n", result);
+    ok(GetLastError() == 0xdeadbeef, "got last error %lu\n", GetLastError());
+    CloseHandle(event);
+}
+
 START_TEST(rasapi)
 {
     InitFunctionPtrs();
 
     test_rasenum();
+    test_enum_connections(FALSE);
+    test_enum_connections(TRUE);
+    test_connection_notification(FALSE);
+    test_connection_notification(TRUE);
 
     FreeLibrary(hmodule);
 }
diff --git a/include/ras.h b/include/ras.h
