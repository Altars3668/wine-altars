     while (i < count)
     {
@@ -2969,6 +2975,7 @@ NTSTATUS WINAPI NtQueryIoCompletion( HANDLE handle, IO_COMPLETION_INFORMATION_CL
         if (ret_len) *ret_len = sizeof(*info);
         if (len == sizeof(*info))
         {
