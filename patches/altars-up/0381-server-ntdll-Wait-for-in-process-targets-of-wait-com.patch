     return ret;
 }
 
+static void flush_packet_watches(void);
+
 /***********************************************************************
  *             NtRemoveIoCompletion (NTDLL.@)
  */
@@ -2847,6 +2850,8 @@ NTSTATUS WINAPI NtRemoveIoCompletion( HANDLE handle, ULONG_PTR *key, ULONG_PTR *
 
     TRACE( "(%p, %p, %p, %p, %p)\n", handle, key, value, io, timeout );
 
