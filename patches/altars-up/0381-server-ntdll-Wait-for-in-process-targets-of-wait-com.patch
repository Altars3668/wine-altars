+/* satisfy a wait for an in-process sync that does not block; returns whether it was signaled */
+int acquire_inproc_sync( struct object *obj )
+{
+    struct inproc_sync *sync = (struct inproc_sync *)obj;
+    struct ntsync_wait_args args = {0};
+    int fd = sync->fd;
