From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 15:12:58 -0400
Subject: [PATCH] server, ntdll: Wait for in-process targets of wait completion
 packets in a helper thread.

With in-process synchronization (ntsync) the clients signal events and
semaphores in the kernel, and the server sets its own internal syncs
without wake_up(), so a wait completion packet associated with any of
them never completed: ntdll's file tests failed 81 times with
/dev/ntsync loaded.

The server now satisfies a packet's wait for an in-process sync with a
wait that does not block, and wakes the packets of a sync it signals
itself.  An event or semaphore is signaled by the clients, so the
process that associates the packet runs a packet watch: a thread outside
the Windows threads that waits for the targets with NTSYNC_IOC_WAIT_ANY
and reports the one it acquired on a socket the server polls.  The server
gives the signal back when no packet waits for that target any more, and
tells the thread on the same socket to let go of the targets of packets
that were cancelled or closed.  An association returns once the thread
waits for the target, and a cancel or a look at a completion port that
must not block first waits until the watches have reported what was
signaled, so the port shows it as it would on Windows.

Office ships the Windows App SDK's CoreMessagingXP.dll, which imports
NtAssociateWaitCompletionPacket.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 5428b1d2dfb..e10c5bdf346 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -8637,6 +8637,76 @@ static void test_cancel_wait_completion_packet(void)
     ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
 }
 
+static void test_many_wait_completion_packets(void)
+{
+    FILE_IO_COMPLETION_INFORMATION info[100];
+    HANDLE completion, packets[100], events[100];
+    LARGE_INTEGER timeout = {{0}};
+    ULONG count, i;
+    BOOLEAN signaled;
+    NTSTATUS status;
+
+    if (!pNtCreateWaitCompletionPacket)
+    {
+        win_skip("NtCreateWaitCompletionPacket is unavailable.\n");
+        return;
+    }
+
+    status = pNtCreateIoCompletion(&completion, IO_COMPLETION_ALL_ACCESS, NULL, 0);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+
+    /* more packets waiting at once than a single wait can take */
+    for (i = 0; i < ARRAY_SIZE(packets); i++)
+    {
+        status = pNtCreateEvent(&events[i], GENERIC_ALL, NULL, SynchronizationEvent, 0);
+        ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+        status = pNtCreateWaitCompletionPacket(&packets[i], GENERIC_ALL, NULL);
+        ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+        status = pNtAssociateWaitCompletionPacket(packets[i], completion, events[i], (void *)(ULONG_PTR)(i + 1),
+                                                  NULL, STATUS_SUCCESS, i, &signaled);
+        ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+        ok(signaled == FALSE, "Got unexpected signaled %d.\n", signaled);
+    }
+    count = get_pending_msgs(completion);
+    ok(!count, "Got unexpected completion count %lu.\n", count);
+
+    for (i = 0; i < ARRAY_SIZE(packets); i += 2) pNtSetEvent(events[i], NULL);
+    count = get_pending_msgs(completion);
+    ok(count == ARRAY_SIZE(packets) / 2, "Got unexpected completion count %lu.\n", count);
+    for (i = 0; i < ARRAY_SIZE(packets); i += 2)
+        ok(!is_signaled(events[i]), "Expected event %lu not signaled.\n", i);
+
+    memset(info, 0, sizeof(info));
+    status = pNtRemoveIoCompletionEx(completion, info, ARRAY_SIZE(info), &count, &timeout, FALSE);
+    ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    ok(count == ARRAY_SIZE(packets) / 2, "Got unexpected count %lu.\n", count);
+    for (i = 0; i < count; i++)
+    {
+        ok(info[i].CompletionKey % 2 == 1, "Got unexpected completion key %Id.\n", info[i].CompletionKey);
+        ok(info[i].IoStatusBlock.Information == info[i].CompletionKey - 1,
+           "Got unexpected information %Id for key %Id.\n", info[i].IoStatusBlock.Information, info[i].CompletionKey);
+    }
+
+    /* the others stop waiting before their events are set */
+    for (i = 1; i < ARRAY_SIZE(packets); i += 2)
+    {
+        status = pNtCancelWaitCompletionPacket(packets[i], FALSE);
+        ok(status == STATUS_SUCCESS, "Got unexpected status %#lx.\n", status);
+    }
+    for (i = 1; i < ARRAY_SIZE(packets); i += 2) pNtSetEvent(events[i], NULL);
+    count = get_pending_msgs(completion);
+    ok(!count, "Got unexpected completion count %lu.\n", count);
+    for (i = 1; i < ARRAY_SIZE(packets); i += 2)
+        ok(is_signaled(events[i]), "Expected event %lu signaled.\n", i);
+
+    for (i = 0; i < ARRAY_SIZE(packets); i++)
+    {
+        pNtClose(packets[i]);
+        pNtClose(events[i]);
+    }
+    pNtClose(completion);
+}
+
 START_TEST(file)
 {
     HMODULE hkernel32 = GetModuleHandleA("kernel32.dll");
@@ -8735,4 +8805,5 @@ START_TEST(file)
     test_create_wait_completion_packet();
     test_associate_wait_completion_packet();
     test_cancel_wait_completion_packet();
+    test_many_wait_completion_packets();
 }
