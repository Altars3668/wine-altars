             SERVER_START_REQ( query_completion )
             {
                 req->handle = wine_server_obj_handle( handle );
@@ -3702,6 +3709,300 @@ NTSTATUS WINAPI NtCreateTransaction( HANDLE *handle, ACCESS_MASK mask, OBJECT_AT
     return STATUS_SUCCESS;
 }
 
+/* A wait completion packet whose target is an event or semaphore signaled in-process is not seen
+ * signaled by the server, so a packet watch of the process that associated it waits for the target:
+ * a thread that reports each target it acquired on a socket to the server, and lets go of the ones the
+ * server tells it to on the same socket (see server/completion.c). */
+
+#ifdef NTSYNC_IOC_EVENT_READ
+
+#define PACKET_WATCH_RELEASED 0x80000000  /* reported for a target let go of without acquiring it */
+
+struct packet_watch
+{
+    struct list  entry;
+    unsigned int id;                                /* the server's id of the watch */
+    int          socket;                            /* to and from the server */
+    int          alert;                             /* event set when there is news for the thread */
+    BOOL         dead;                              /* the thread has stopped */
+    unsigned int gen;                               /* bumped for news the thread has to take in */
+    unsigned int armed;                             /* the gen the thread last started waiting at */
+    unsigned int quiet;                             /* the last gen at which no target was signaled */
+    unsigned int count;                             /* targets waited for */
+    unsigned int reserved;                          /* room taken by associations in progress */
+    unsigned int ids[NTSYNC_MAX_WAIT_COUNT];        /* the targets' ids */
+    int          fds[NTSYNC_MAX_WAIT_COUNT];        /* and their fds */
+    unsigned int dropped[NTSYNC_MAX_WAIT_COUNT];    /* ids let go of before they were added */
+    unsigned int next_dropped;
+};
+
+static struct list packet_watches = LIST_INIT( packet_watches );
+static pthread_mutex_t packet_watch_mutex = PTHREAD_MUTEX_INITIALIZER;
+static pthread_cond_t packet_watch_cond = PTHREAD_COND_INITIALIZER;  /* a thread started waiting */
+static LONG watched_target_count;
+
+/* packet_watch_mutex must be held */
+static BOOL remove_watched_target( struct packet_watch *watch, unsigned int id )
+{
+    unsigned int i;
+
+    for (i = 0; i < watch->count; i++)
+    {
+        if (watch->ids[i] != id) continue;
+        close( watch->fds[i] );
+        InterlockedDecrement( &watched_target_count );
+        watch->count--;
+        watch->ids[i] = watch->ids[watch->count];
+        watch->fds[i] = watch->fds[watch->count];
+        return TRUE;
+    }
+    return FALSE;
+}
+
+static void *packet_watch_thread( void *arg )
+{
+    struct packet_watch *watch = arg;
+    unsigned int ids[NTSYNC_MAX_WAIT_COUNT], count, report, gen;
+    int fds[NTSYNC_MAX_WAIT_COUNT];
+    BOOL check;
+
+    for (;;)
+    {
+        struct ntsync_wait_args args = {0};
+
+        pthread_mutex_lock( &packet_watch_mutex );
+        count = watch->count;
+        memcpy( ids, watch->ids, count * sizeof(ids[0]) );
+        memcpy( fds, watch->fds, count * sizeof(fds[0]) );
+        gen = watch->armed = watch->gen;
+        check = watch->quiet != gen;
+        pthread_cond_broadcast( &packet_watch_cond );
+        pthread_mutex_unlock( &packet_watch_mutex );
+
+        /* after news, look without blocking first: a wait that times out shows that every target
+         * signaled before it has been reported, which is what a flush waits for */
+        args.timeout = check ? 0 : ~(__u64)0;
+        args.objs = (uintptr_t)fds;
+        args.count = count;
+        args.owner = ~0u;  /* only mutexes care, and they are never targets */
+        args.alert = watch->alert;
+        if (ioctl( inproc_device_fd, NTSYNC_IOC_WAIT_ANY, &args ) < 0)
+        {
+            if (errno == EINTR) continue;
+            if (errno == ETIMEDOUT)
+            {
+                pthread_mutex_lock( &packet_watch_mutex );
+                watch->quiet = gen;
+                pthread_cond_broadcast( &packet_watch_cond );
+                pthread_mutex_unlock( &packet_watch_mutex );
+                continue;
+            }
+            /* not a Windows thread: no debug channels here */
+            fprintf( stderr, "wine: waiting for wait completion packet targets failed, errno %d\n", errno );
+            pthread_mutex_lock( &packet_watch_mutex );
+            watch->dead = TRUE;
+            pthread_cond_broadcast( &packet_watch_cond );
+            pthread_mutex_unlock( &packet_watch_mutex );
+            return NULL;
+        }
+
+        if (args.index < count)
+        {
+            report = ids[args.index];
+            send( watch->socket, &report, sizeof(report), MSG_NOSIGNAL );
+            pthread_mutex_lock( &packet_watch_mutex );
+            remove_watched_target( watch, report );
+            pthread_mutex_unlock( &packet_watch_mutex );
+            continue;
+        }
+
+        /* the alert: targets to let go of, or new ones to wait for */
+        while (recv( watch->socket, &report, sizeof(report), MSG_DONTWAIT ) == sizeof(report))
+        {
+            pthread_mutex_lock( &packet_watch_mutex );
+            if (!remove_watched_target( watch, report ))
+            {
+                /* not added yet: the association adding it drops it */
+                watch->dropped[watch->next_dropped++ % ARRAY_SIZE(watch->dropped)] = report;
+            }
+            pthread_mutex_unlock( &packet_watch_mutex );
+            report |= PACKET_WATCH_RELEASED;
+            send( watch->socket, &report, sizeof(report), MSG_NOSIGNAL );
+        }
+    }
+}
+
+/* packet_watch_mutex must be held */
+static struct packet_watch *create_packet_watch(void)
+{
+    struct packet_watch *watch;
+    obj_handle_t key;
+    sigset_t sigset, all;
+    pthread_t thread;
+    unsigned int id;
+    NTSTATUS status;
+    int socket, alert;
+
+    /* the server sends the socket and the alert event's fd along with the reply */
+    server_enter_uninterrupted_section( &fd_cache_mutex, &sigset );
+    SERVER_START_REQ( create_completion_packet_watch )
+    {
+        status = wine_server_call( req );
+        id = reply->watch;
+    }
+    SERVER_END_REQ;
+    if (!status)
+    {
+        socket = wine_server_receive_fd( &key );
+        assert( key == id );
+        alert = wine_server_receive_fd( &key );
+        assert( key == id );
+    }
+    server_leave_uninterrupted_section( &fd_cache_mutex, &sigset );
+    if (status) return NULL;
+
+    if (!(watch = calloc( 1, sizeof(*watch) )))
+    {
+        close( socket );  /* the server lets go of the watch when its end hangs up */
+        close( alert );
+        return NULL;
+    }
+    watch->id = id;
+    watch->socket = socket;
+    watch->alert = alert;
+
+    /* no signals for the thread, it is not a Windows thread */
+    sigfillset( &all );
+    pthread_sigmask( SIG_SETMASK, &all, &sigset );
+    status = pthread_create( &thread, NULL, packet_watch_thread, watch );
+    pthread_sigmask( SIG_SETMASK, &sigset, NULL );
+    if (status)
+    {
+        close( socket );
+        close( alert );
+        free( watch );
+        return NULL;
+    }
+    pthread_detach( thread );
+    list_add_tail( &packet_watches, &watch->entry );
+    return watch;
+}
+
+/* take room for a target in a watch, or NULL */
+static struct packet_watch *reserve_packet_watch(void)
+{
+    struct packet_watch *watch;
+    sigset_t sigset;
+
+    server_enter_uninterrupted_section( &packet_watch_mutex, &sigset );
+    LIST_FOR_EACH_ENTRY( watch, &packet_watches, struct packet_watch, entry )
+        if (!watch->dead && watch->count + watch->reserved < NTSYNC_MAX_WAIT_COUNT) goto done;
+    watch = create_packet_watch();
+done:
+    if (watch) watch->reserved++;
+    server_leave_uninterrupted_section( &packet_watch_mutex, &sigset );
+    return watch;
+}
+
+/* give the thread news; packet_watch_mutex must be held */
+static unsigned int alert_packet_watch( struct packet_watch *watch )
+{
+    unsigned int gen = ++watch->gen;
+    __u32 prev;
+
+    ioctl( watch->alert, NTSYNC_IOC_EVENT_SET, &prev );
+    return gen;
+}
+
+/* before a look at a completion port that must not wait: the watches have reported every target
+ * signaled so far (and the server reads their reports before it answers) */
+static void flush_packet_watches(void)
+{
+    struct packet_watch *watch;
+    unsigned int gen;
+    sigset_t sigset;
+
+    if (!ReadNoFence( &watched_target_count )) return;
+
+    server_enter_uninterrupted_section( &packet_watch_mutex, &sigset );
+    LIST_FOR_EACH_ENTRY( watch, &packet_watches, struct packet_watch, entry )
+    {
+        if (!watch->count || watch->dead) continue;
+        gen = alert_packet_watch( watch );
+        while (!watch->dead && (int)(watch->quiet - gen) < 0)
+            pthread_cond_wait( &packet_watch_cond, &packet_watch_mutex );
+    }
+    server_leave_uninterrupted_section( &packet_watch_mutex, &sigset );
+}
+
+/* give the target the server wants waited for (id != 0) to the watch, and the reserved room back;
+ * the association only returns once the thread waits for the target, as it waits from then on */
+static void watch_packet_target( struct packet_watch *watch, unsigned int id, HANDLE target )
+{
+    struct inproc_sync stack, *sync;
+    unsigned int i, report, gen;
+    sigset_t sigset;
+    int fd = -1;
+
+    if (id && !get_inproc_sync( target, INPROC_SYNC_UNKNOWN, 0, &stack, &sync ))
+    {
+        fd = fcntl( sync->fd, F_DUPFD_CLOEXEC, 0 );
+        release_inproc_sync( sync );
+    }
+
+    server_enter_uninterrupted_section( &packet_watch_mutex, &sigset );
+    watch->reserved--;
+    for (i = 0; id && i < ARRAY_SIZE(watch->dropped); i++)
+    {
+        if (watch->dropped[i] != id) continue;
+        watch->dropped[i] = 0;
+        id = 0;  /* let go of already */
+    }
+    if (id && fd != -1)
+    {
+        watch->ids[watch->count] = id;
+        watch->fds[watch->count] = fd;
+        watch->count++;
+        InterlockedIncrement( &watched_target_count );
+        fd = -1;
+        /* the thread waits for the target from here on */
+        gen = alert_packet_watch( watch );
+        while (!watch->dead && (int)(watch->armed - gen) < 0)
+            pthread_cond_wait( &packet_watch_cond, &packet_watch_mutex );
+    }
+    else if (id)
+    {
+        /* the target has gone: it cannot be waited for, so the server can forget it */
+        report = id | PACKET_WATCH_RELEASED;
+        send( watch->socket, &report, sizeof(report), MSG_NOSIGNAL );
+    }
+    server_leave_uninterrupted_section( &packet_watch_mutex, &sigset );
+
+    if (fd != -1) close( fd );
+}
+
+#else /* NTSYNC_IOC_EVENT_READ */
+
+struct packet_watch
+{
+    unsigned int id;
+};
+
+static struct packet_watch *reserve_packet_watch(void)
+{
+    return NULL;
+}
+
+static void flush_packet_watches(void)
+{
+}
+
+static void watch_packet_target( struct packet_watch *watch, unsigned int id, HANDLE target )
+{
+}
+
+#endif /* NTSYNC_IOC_EVENT_READ */
+
 /***********************************************************************
  *           NtAssociateWaitCompletionPacket (NTDLL.@)
  */
@@ -3709,11 +4010,16 @@ NTSTATUS WINAPI NtAssociateWaitCompletionPacket( HANDLE packet, HANDLE completio
         void *key_context, void *apc_context, NTSTATUS status, ULONG_PTR information,
         BOOLEAN *already_signaled )
 {
+    struct packet_watch *watch = NULL;
+    unsigned int watch_id = 0;
     NTSTATUS ret;
 
     TRACE( "%p, %p, %p, %p, %p, %#x, %ld, %p\n", packet, completion, target, key_context,
            apc_context, (int)status, information, already_signaled );
 
+    /* in-process synchronization: have room ready in a watch, in case the target needs it */
+    if (inproc_device_fd >= 0 && !(watch = reserve_packet_watch())) return STATUS_INSUFFICIENT_RESOURCES;
+
     SERVER_START_REQ( associate_completion_packet )
     {
         req->packet = wine_server_obj_handle( packet );
@@ -3723,10 +4029,16 @@ NTSTATUS WINAPI NtAssociateWaitCompletionPacket( HANDLE packet, HANDLE completio
         req->cvalue = wine_server_client_ptr( apc_context );
         req->information = information;
         req->status = status;
-        if (!(ret = wine_server_call( req )) && already_signaled)
-            *already_signaled = reply->already_signaled;
+        req->watch = watch ? watch->id : 0;
+        if (!(ret = wine_server_call( req )))
+        {
+            if (already_signaled) *already_signaled = reply->already_signaled;
+            watch_id = reply->watch_id;
+        }
     }
     SERVER_END_REQ;
+
+    if (watch) watch_packet_target( watch, watch_id, target );
     return ret;
 }
 
@@ -3739,6 +4051,9 @@ NTSTATUS WINAPI NtCancelWaitCompletionPacket( HANDLE packet, BOOLEAN remove_sign
 
     TRACE( "%p, %d\n", packet, remove_signaled );
 
+    /* a watched target acquired so far signals the packet first, and one signaled after the cancel
+     * is not taken by the watch any more */
+    flush_packet_watches();
     SERVER_START_REQ( cancel_completion_packet )
     {
         req->packet = wine_server_obj_handle( packet );
@@ -3746,6 +4061,7 @@ NTSTATUS WINAPI NtCancelWaitCompletionPacket( HANDLE packet, BOOLEAN remove_sign
         status = wine_server_call( req );
     }
     SERVER_END_REQ;
+    flush_packet_watches();
     return status;
 }
 
diff --git a/include/wine/server_protocol.h b/include/wine/server_protocol.h
index 922ea8b3a67..e4d7e861671 100644
--- a/include/wine/server_protocol.h
+++ b/include/wine/server_protocol.h
@@ -5714,12 +5714,30 @@ struct associate_completion_packet_request
     apc_param_t   cvalue;
     apc_param_t   information;
     unsigned int  status;
-    char __pad_52[4];
+    unsigned int  watch;
 };
 struct associate_completion_packet_reply
 {
     struct reply_header __header;
     int           already_signaled;
+    unsigned int  watch_id;
+};
+
+
+/* Create a packet watch: a helper thread of the client that waits for the targets of wait completion
+ * packets which the clients signal in-process, where the server cannot see it.  It reports a target it
+ * acquired by writing its id on the socket sent to it (or the id | 0x80000000 for a target it let go of
+ * when told to), and the server tells it to let go of targets by writing their ids there and setting
+ * the alert event sent after the socket. */
+struct create_completion_packet_watch_request
+{
+    struct request_header __header;
+    char __pad_12[4];
+};
+struct create_completion_packet_watch_reply
+{
+    struct reply_header __header;
+    unsigned int  watch;
     char __pad_12[4];
 };
 
@@ -6614,6 +6632,7 @@ enum request
     REQ_set_completion_info,
     REQ_create_completion_packet,
     REQ_associate_completion_packet,
+    REQ_create_completion_packet_watch,
     REQ_cancel_completion_packet,
     REQ_add_fd_completion,
     REQ_set_fd_completion_mode,
@@ -6934,6 +6953,7 @@ union generic_request
     struct set_completion_info_request set_completion_info_request;
     struct create_completion_packet_request create_completion_packet_request;
     struct associate_completion_packet_request associate_completion_packet_request;
+    struct create_completion_packet_watch_request create_completion_packet_watch_request;
     struct cancel_completion_packet_request cancel_completion_packet_request;
     struct add_fd_completion_request add_fd_completion_request;
     struct set_fd_completion_mode_request set_fd_completion_mode_request;
@@ -7252,6 +7272,7 @@ union generic_reply
     struct set_completion_info_reply set_completion_info_reply;
     struct create_completion_packet_reply create_completion_packet_reply;
     struct associate_completion_packet_reply associate_completion_packet_reply;
+    struct create_completion_packet_watch_reply create_completion_packet_watch_reply;
     struct cancel_completion_packet_reply cancel_completion_packet_reply;
     struct add_fd_completion_reply add_fd_completion_reply;
     struct set_fd_completion_mode_reply set_fd_completion_mode_reply;
@@ -7292,6 +7313,6 @@ union generic_reply
     struct alpc_create_port_reply alpc_create_port_reply;
 };
 
-#define SERVER_PROTOCOL_VERSION 969
+#define SERVER_PROTOCOL_VERSION 970
 
 #endif /* __WINE_WINE_SERVER_PROTOCOL_H */
diff --git a/server/completion.c b/server/completion.c
index 941df9f5716..f6e7259f131 100644
--- a/server/completion.c
+++ b/server/completion.c
@@ -23,8 +23,13 @@
 
 #include "config.h"
 
+#include <errno.h>
+#include <fcntl.h>
+#include <poll.h>
 #include <stdarg.h>
 #include <stdio.h>
+#include <sys/socket.h>
+#include <unistd.h>
 
 #include "ntstatus.h"
 #include "windef.h"
@@ -33,7 +38,9 @@
 #include "object.h"
