+DECL_HANDLER(create_completion_packet_watch)
+{
+    struct packet_watch *watch;
+    int fds[2];
+
+    if (get_inproc_device_fd() < 0)
+    {
+        set_error( STATUS_NOT_SUPPORTED );
+        return;
+    }
+    if (socketpair( AF_UNIX, SOCK_DGRAM, 0, fds ))
+    {
+        file_set_error();
+        return;
+    }
+    fcntl( fds[0], F_SETFL, O_NONBLOCK );  /* the client's end blocks: its thread reports can wait for room */
+
+    if (!(watch = alloc_object( &packet_watch_ops )))
+    {
+        close( fds[0] );
+        close( fds[1] );
+        return;
+    }
+    watch->process = (struct process *)grab_object( current->process );
+    watch->alert = NULL;
+    list_init( &watch->targets );
+    if (!(++last_watch_id)) last_watch_id = 1;
+    watch->id = last_watch_id;
+    if (!(watch->fd = create_anonymous_fd( &packet_watch_fd_ops, fds[0], &watch->obj, 0 ))
+        || !(watch->alert = create_inproc_internal_sync( 0, 0 )))
+    {
+        close( fds[1] );
+        release_object( watch );
+        return;
