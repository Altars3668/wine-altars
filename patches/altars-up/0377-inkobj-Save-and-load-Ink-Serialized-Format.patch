+static VARIANT byte_array(const BYTE *values, unsigned int count)
+{
+    SAFEARRAY *array = SafeArrayCreateVector(VT_UI1, 0, count);
+    BYTE *bytes;
+    VARIANT v;
+
+    SafeArrayAccessData(array, (void **)&bytes);
+    memcpy(bytes, values, count);
+    SafeArrayUnaccessData(array);
+    V_VT(&v) = VT_ARRAY | VT_UI1;
+    V_ARRAY(&v) = array;
+    return v;
+}
+
+static void add_property(IInkExtendedProperties *props, const WCHAR *guid, VARIANT value)
+{
+    IInkExtendedProperty *property;
+    BSTR str = SysAllocString(guid);
+    HRESULT hr = IInkExtendedProperties_Add(props, str, value, &property);
+    ok(hr == S_OK, "Add property returned %#lx.\n", hr);
+    if (hr == S_OK) IInkExtendedProperty_Release(property);
+    SysFreeString(str);
+}
+
+static void check_property(IInkExtendedProperties *props, const WCHAR *guid, const VARIANT *expected)
+{
+    VARIANT id, value;
+    IInkExtendedProperty *property;
+    BYTE *a, *b;
+    LONG count;
+    HRESULT hr;
+
+    V_VT(&id) = VT_BSTR;
+    V_BSTR(&id) = SysAllocString(guid);
+    hr = IInkExtendedProperties_Item(props, id, &property);
+    ok(hr == S_OK, "Property %s: %#lx.\n", wine_dbgstr_w(guid), hr);
+    VariantClear(&id);
+    if (FAILED(hr)) return;
+    hr = IInkExtendedProperty_get_Data(property, &value);
+    ok(hr == S_OK && V_VT(&value) == V_VT(expected), "Property type %#x, hr %#lx.\n", V_VT(&value), hr);
+    if (SUCCEEDED(hr))
+    {
+        if (V_VT(expected) == VT_I4)
+            ok(V_I4(&value) == V_I4(expected), "Got %ld.\n", V_I4(&value));
+        else if (V_VT(expected) == VT_R8)
+            ok(V_R8(&value) == V_R8(expected), "Got %f.\n", V_R8(&value));
+        else if (V_VT(expected) == VT_BSTR)
+            ok(!wcscmp(V_BSTR(&value), V_BSTR(expected)), "Got %s.\n", wine_dbgstr_w(V_BSTR(&value)));
+        else if (V_VT(expected) == (VT_ARRAY | VT_UI1))
+        {
+            count = V_ARRAY(expected)->rgsabound[0].cElements;
+            ok(V_ARRAY(&value)->rgsabound[0].cElements == count, "Got %lu bytes.\n",
+                    V_ARRAY(&value)->rgsabound[0].cElements);
+            SafeArrayAccessData(V_ARRAY(&value), (void **)&a);
+            SafeArrayAccessData(V_ARRAY(expected), (void **)&b);
+            ok(!memcmp(a, b, count), "Byte property changed.\n");
+            SafeArrayUnaccessData(V_ARRAY(expected));
+            SafeArrayUnaccessData(V_ARRAY(&value));
+        }
+        VariantClear(&value);
+    }
+    IInkExtendedProperty_Release(property);
+}
