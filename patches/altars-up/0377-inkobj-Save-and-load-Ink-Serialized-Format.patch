+static void test_isf_types(void)
+{
+    static const VARTYPE types[] = {VT_I1, VT_UI1, VT_I2, VT_UI2, VT_I4, VT_UI4, VT_I8, VT_UI8,
+            VT_R4, VT_R8, VT_DATE, VT_BOOL, VT_BSTR};
+    static const BYTE raw[] = {0x91,0x02,0x03,0x04,0x05,0x06,0x07,0x08};
+    IInkDisp *ink, *loaded;
+    IInkExtendedProperties *properties;
+    IInkExtendedProperty *property;
+    VARIANT input, output, saved, key;
+    WCHAR guid[39];
+    BSTR name, *strings, first, second;
+    BYTE *items;
+    ULONG length;
+    HRESULT hr;
+    unsigned int i, array_type;
+
+    for (i = 0; i < ARRAY_SIZE(types); i++)
+        for (array_type = 0; array_type < 2; array_type++)
+        {
+            if (!(ink = create(&CLSID_InkDisp, &IID_IInkDisp))) return;
+            if (!(loaded = create(&CLSID_InkDisp, &IID_IInkDisp))) { IInkDisp_Release(ink); return; }
+            swprintf(guid, ARRAY_SIZE(guid), L"{0C17FA69-A143-4565-ACDE-6B2824B4%04X}", i * 2 + array_type);
+            name = SysAllocString(guid);
+            VariantInit(&input);
+            V_VT(&input) = types[i] | (array_type ? VT_ARRAY : 0);
+            length = types[i] == VT_I1 || types[i] == VT_UI1 ? 1 :
+                    (types[i] == VT_I2 || types[i] == VT_UI2 || types[i] == VT_BOOL ? 2 :
+                    (types[i] == VT_I4 || types[i] == VT_UI4 || types[i] == VT_R4 ? 4 : 8));
+            if (types[i] == VT_BSTR)
+            {
+                if (array_type)
+                {
+                    V_ARRAY(&input) = SafeArrayCreateVector(VT_BSTR, 0, 2);
+                    SafeArrayAccessData(V_ARRAY(&input), (void **)&strings);
+                    strings[0] = SysAllocString(L"first");
+                    strings[1] = SysAllocString(L"second");
+                    SafeArrayUnaccessData(V_ARRAY(&input));
+                }
+                else V_BSTR(&input) = SysAllocString(L"one value");
+            }
+            else if (array_type)
+            {
+                V_ARRAY(&input) = SafeArrayCreateVector(types[i], 0, 2);
+                SafeArrayAccessData(V_ARRAY(&input), (void **)&items);
+                memcpy(items, raw, length);
+                memcpy(items + length, raw, length);
+                SafeArrayUnaccessData(V_ARRAY(&input));
+            }
+            else memcpy(&V_I8(&input), raw, length);
+            IInkDisp_get_ExtendedProperties(ink, &properties);
+            hr = IInkExtendedProperties_Add(properties, name, input, &property);
+            ok(hr == S_OK, "Type %#x Add: %#lx.\n", V_VT(&input), hr);
+            if (SUCCEEDED(hr)) IInkExtendedProperty_Release(property);
+            IInkExtendedProperties_Release(properties);
+            hr = IInkDisp_Save(ink, IPF_InkSerializeFormat, IPCM_Default, &saved);
+            ok(hr == S_OK, "Type %#x Save: %#lx.\n", V_VT(&input), hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IInkDisp_Load(loaded, saved);
+                ok(hr == S_OK, "Type %#x Load: %#lx.\n", V_VT(&input), hr);
+                VariantClear(&saved);
+                if (SUCCEEDED(hr))
+                {
+                    IInkDisp_get_ExtendedProperties(loaded, &properties);
+                    V_VT(&key) = VT_BSTR;
+                    V_BSTR(&key) = name;
+                    hr = IInkExtendedProperties_Item(properties, key, &property);
+                    ok(hr == S_OK, "Type %#x Item: %#lx.\n", V_VT(&input), hr);
+                    if (SUCCEEDED(hr))
+                    {
+                        hr = IInkExtendedProperty_get_Data(property, &output);
+                        ok(hr == S_OK && V_VT(&output) == V_VT(&input), "Type %#x roundtrip type %#x.\n",
+                                V_VT(&input), V_VT(&output));
+                        if (SUCCEEDED(hr) && V_VT(&output) == V_VT(&input))
+                        {
+                            if (types[i] == VT_BSTR)
+                            {
+                                if (array_type)
+                                {
+                                    LONG zero = 0, one = 1;
+                                    SafeArrayGetElement(V_ARRAY(&output), &zero, &first);
+                                    SafeArrayGetElement(V_ARRAY(&output), &one, &second);
+                                    ok(!wcscmp(first, L"first") && !wcscmp(second, L"second"),
+                                            "BSTR array values changed.\n");
+                                    SysFreeString(first);
+                                    SysFreeString(second);
+                                }
+                                else ok(!wcscmp(V_BSTR(&output), V_BSTR(&input)), "BSTR changed.\n");
+                            }
+                            else if (array_type)
+                            {
+                                BYTE *got, *want;
+                                SafeArrayAccessData(V_ARRAY(&output), (void **)&got);
+                                SafeArrayAccessData(V_ARRAY(&input), (void **)&want);
+                                ok(V_ARRAY(&output)->rgsabound[0].cElements == 2 &&
+                                        !memcmp(got, want, length * 2), "Type %#x array changed.\n", types[i]);
+                                SafeArrayUnaccessData(V_ARRAY(&input));
+                                SafeArrayUnaccessData(V_ARRAY(&output));
+                            }
+                            else ok(!memcmp(&V_I8(&output), &V_I8(&input), length),
+                                    "Type %#x scalar changed.\n", types[i]);
+                        }
+                        if (SUCCEEDED(hr)) VariantClear(&output);
+                        IInkExtendedProperty_Release(property);
+                    }
+                    IInkExtendedProperties_Release(properties);
+                }
+            }
+            VariantClear(&input);
+            SysFreeString(name);
+            IInkDisp_Release(loaded);
+            IInkDisp_Release(ink);
+        }
+}
