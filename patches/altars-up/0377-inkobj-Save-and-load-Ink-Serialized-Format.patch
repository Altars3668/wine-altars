+/* 将 Base64 字符转换为数值。 */
+static int isf_base64_digit(BYTE c)
+{
+    if (c >= 'A' && c <= 'Z')
+        return c - 'A';
+    if (c >= 'a' && c <= 'z')
+        return c - 'a' + 26;
+    if (c >= '0' && c <= '9')
+        return c - '0' + 52;
+    if (c == '+')
+        return 62;
+    if (c == '/')
+        return 63;
+    return -1;
+}
+
+/* 解码 Base64 包装的墨迹数据。 */
+static HRESULT ink_decode_base64(const BYTE *input, SIZE_T length, BYTE **out, SIZE_T *size)
+{
+    BYTE *bytes;
+    unsigned int bits = 0;
+    unsigned int value = 0;
+    unsigned int padding = 0;
+    SIZE_T i;
+    SIZE_T n = 0;
+    int digit;
+
+    if (length && !input[length - 1])
+        --length;
+    if (!(bytes = malloc(max((SIZE_T)1, length))))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < length; ++i)
+    {
+        if (input[i] == '=')
+        {
+            ++padding;
+            continue;
+        }
+        if ((digit = isf_base64_digit(input[i])) < 0 || padding)
+        {
+            free(bytes);
+            return E_INVALIDARG;
+        }
+        value = value << 6 | digit;
+        bits += 6;
+        if (bits >= 8)
+        {
+            bits -= 8;
+            bytes[n++] = value >> bits;
+            value &= (1u << bits) - 1;
+        }
+    }
+    if (padding > 2 || (padding && (length & 3)) || bits != (padding ? (padding == 1 ? 2 : 4) : 0) || value)
+    {
+        free(bytes);
+        return E_INVALIDARG;
+    }
+    *out = bytes;
+    *size = n;
+    return S_OK;
+}
+
+/* 读取 GIF 注释中的墨迹数据。 */
+static HRESULT ink_gif_comment(const BYTE *gif, SIZE_T length, BYTE **out, SIZE_T *size)
+{
+    BYTE *result = NULL;
+    BYTE *p;
+    SIZE_T pos = 13;
+    SIZE_T total = 0;
+    SIZE_T table, n;
+    BYTE flags;
+    BOOL finished = FALSE;
+
+    if (length < pos || (memcmp(gif, "GIF87a", 6) && memcmp(gif, "GIF89a", 6)))
+        return E_INVALIDARG;
+    flags = gif[10];
+    if (flags & 0x80)
+    {
+        table = 3u << ((flags & 7) + 1);
+        if (table > length - pos)
+            return E_INVALIDARG;
+        pos += table;
+    }
+    while (pos < length)
+    {
+        flags = gif[pos++];
+        if (flags == 0x3b)
+        {
+            finished = TRUE;
+            break;
+        }
+        if (flags == 0x2c)
+        {
+            if (length - pos < 9)
+                break;
+            flags = gif[pos + 8];
+            pos += 9;
+            if (flags & 0x80)
+            {
+                table = 3u << ((flags & 7) + 1);
+                if (table > length - pos)
+                    break;
+                pos += table;
+            }
+            if (pos == length)
+                break;
+            ++pos;
+            flags = 0;
+        }
+        else if (flags == 0x21)
+        {
+            if (pos == length)
+                break;
+            flags = gif[pos++];
+        }
+        else
+            break;
+        do
+        {
+            if (pos == length)
+                goto invalid;
+            n = gif[pos++];
+            if (n > length - pos || n > SIZE_MAX - total)
+                goto invalid;
+            if (flags == 0xfe && n)
+            {
+                if (!(p = realloc(result, total + n)))
+                {
+                    free(result);
+                    return E_OUTOFMEMORY;
+                }
+                result = p;
+                memcpy(result + total, gif + pos, n);
+                total += n;
+            }
+            pos += n;
+        }
+        while (n);
+    }
+    if (!finished || !total)
+        goto invalid;
+    *out = result;
+    *size = total;
+    return S_OK;
+invalid:
+    free(result);
+    return E_INVALIDARG;
+}
+
+/* 将墨迹保存到字节数组。 */
 static HRESULT WINAPI ink_Save(IInkDisp *iface, InkPersistenceFormat format, InkPersistenceCompressionMode compression,
         VARIANT *data)
 {
-    FIXME("iface %p, format %d, compression %d, data %p, not implemented.\n", iface, format, compression, data);
-    return E_NOTIMPL;
+    static const char alphabet[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data **strokes;
+    unsigned int count;
+    SIZE_T size, encoded_size, i, j;
+    BYTE *bytes, *dest;
+    SAFEARRAY *array;
+    HRESULT hr;
+
+    TRACE("iface %p, format %d, compression %d, data %p.\n", iface, format, compression, data);
+    if (!data)
+        return E_POINTER;
+    VariantInit(data);
+    if (compression < IPCM_Default || compression > IPCM_NoCompression ||
+            format < IPF_InkSerializeFormat || format > IPF_Base64GIF) return E_INVALIDARG;
+    if (format == IPF_GIF || format == IPF_Base64GIF)
+    {
+        FIXME("GIF persistence is not implemented.\n");
+        return E_NOTIMPL;
+    }
+    if (FAILED(hr = ink_get_data(ink, &strokes, &count)))
+        return hr;
+    hr = isf_encode(strokes, count, ink->properties, compression, &bytes, &size);
+    strokes_free_data(strokes, count);
+    if (FAILED(hr))
+        return hr;
+    if (format == IPF_Base64InkSerializedFormat)
+    {
+        if (size > (SIZE_MAX - 8) / 4 * 3)
+        {
+            free(bytes);
+            return E_OUTOFMEMORY;
+        }
+        encoded_size = 7 + 4 * ((size + 2) / 3) + 1;
+    }
+    else
+        encoded_size = size;
+    if (encoded_size > UINT_MAX || !(array = SafeArrayCreateVector(VT_UI1, 0, encoded_size)))
+    {
+        free(bytes);
+        return E_OUTOFMEMORY;
+    }
+    if (FAILED(hr = SafeArrayAccessData(array, (void **)&dest)))
+    {
+        SafeArrayDestroy(array);
+        free(bytes);
+        return hr;
+    }
+    if (format == IPF_Base64InkSerializedFormat)
+    {
+        memcpy(dest, "base64:", 7);
+        j = 7;
+        for (i = 0; i < size; i += 3)
+        {
+            unsigned int value = bytes[i] << 16 | (i + 1 < size ? bytes[i + 1] << 8 : 0) |
+                    (i + 2 < size ? bytes[i + 2] : 0);
+            dest[j++] = alphabet[(value >> 18) & 63];
+            dest[j++] = alphabet[(value >> 12) & 63];
+            dest[j++] = i + 1 < size ? alphabet[(value >> 6) & 63] : '=';
+            dest[j++] = i + 2 < size ? alphabet[value & 63] : '=';
+        }
+        dest[j] = 0;
+    }
+    else
+        memcpy(dest, bytes, size);
+    SafeArrayUnaccessData(array);
+    free(bytes);
+    V_VT(data) = VT_ARRAY | VT_UI1;
+    V_ARRAY(data) = array;
+    return S_OK;
 }
 
+/* 从字节数组加载墨迹。 */
 static HRESULT WINAPI ink_Load(IInkDisp *iface, VARIANT data)
 {
-    FIXME("iface %p, data %s, not implemented.\n", iface, debugstr_variant(&data));
-    return E_NOTIMPL;
+    struct ink *ink = impl_from_IInkDisp(iface);
+    struct stroke_data **strokes = NULL;
+    IInkExtendedProperties *properties = NULL;
+    SAFEARRAY *array;
+    const BYTE *raw, *input;
+    BYTE *allocated = NULL;
+    SIZE_T size;
+    unsigned int count = 0;
+    unsigned int i;
+    LONG lower, upper;
+    HRESULT hr;
+
+    TRACE("iface %p, data %s.\n", iface, debugstr_variant(&data));
+
+    /* UNMEASURED: WPF refuses to load into ink that has strokes */
+    EnterCriticalSection(&ink->cs);
+    hr = list_empty(&ink->strokes) ? S_OK : E_UNEXPECTED;
+    LeaveCriticalSection(&ink->cs);
+    if (FAILED(hr))
+        return hr;
+    if (V_VT(&data) == (VT_ARRAY | VT_UI1))
+        array = V_ARRAY(&data);
+    else if (V_VT(&data) == (VT_BYREF | VT_ARRAY | VT_UI1) && V_ARRAYREF(&data))
+        array = *V_ARRAYREF(&data);
+    else
+        return E_INVALIDARG;
+    if (!array || SafeArrayGetDim(array) != 1 || FAILED(SafeArrayGetLBound(array, 1, &lower)) ||
+            FAILED(SafeArrayGetUBound(array, 1, &upper)) || upper < lower) return E_INVALIDARG;
+    size = (SIZE_T)((INT64)upper - lower + 1);
+    if (FAILED(hr = SafeArrayAccessData(array, (void **)&raw)))
+        return hr;
+    input = raw;
+    if (size >= 7 && !memcmp(raw, "base64:", 7))
+        hr = ink_decode_base64(raw + 7, size - 7, &allocated, &size);
+    else if (size >= 3 && !memcmp(raw, "GIF", 3))
+        hr = ink_gif_comment(raw, size, &allocated, &size);
+    else
+        hr = S_OK;
+    if (SUCCEEDED(hr) && allocated && size >= 3 && !memcmp(allocated, "GIF", 3))
+    {
+        BYTE *comment;
+        SIZE_T comment_size;
+        hr = ink_gif_comment(allocated, size, &comment, &comment_size);
+        free(allocated);
+        allocated = SUCCEEDED(hr) ? comment : NULL;
+        if (SUCCEEDED(hr))
+            size = comment_size;
+    }
+    if (SUCCEEDED(hr))
+    {
+        if (allocated)
+            input = allocated;
+        if (SUCCEEDED(hr = extended_properties_create(&properties)))
+            hr = isf_decode(input, size, properties, &strokes, &count);
+    }
+    SafeArrayUnaccessData(array);
+    free(allocated);
+    if (SUCCEEDED(hr))
+    {
+        EnterCriticalSection(&ink->cs);
+        if (!list_empty(&ink->strokes))
+            hr = E_UNEXPECTED;
+        /* the ink keeps its properties object, so one taken before Load sees the loaded properties */
+        else if (SUCCEEDED(hr = IInkExtendedProperties_Clear(ink->properties))
+                && SUCCEEDED(hr = extended_properties_copy(ink->properties, properties)))
+        {
+            for (i = 0; i < count; i++)
+                ink_add_stroke(ink, strokes[i]);
+            ink->dirty = VARIANT_FALSE; /* UNMEASURED */
+        }
+        LeaveCriticalSection(&ink->cs);
+    }
+    strokes_free_data(strokes, count);
+    if (properties)
+        IInkExtendedProperties_Release(properties);
+    return hr;
 }
 
 static HRESULT WINAPI ink_CreateStroke(IInkDisp *iface, VARIANT packet_data, VARIANT packet_description,
