+/* 读取定长字节。 */
+static BOOL isf_bytes(struct isf_reader *r, SIZE_T n, const BYTE **out)
+{
+    if (n > (SIZE_T)(r->end - r->ptr))
+        return FALSE;
+    *out = r->ptr;
+    r->ptr += n;
+    return TRUE;
+}
+
+/* 读取多字节无符号整数。 */
+static BOOL isf_uint(struct isf_reader *r, UINT64 *value)
+{
+    UINT64 v = 0;
+    unsigned int i;
+    BYTE b;
+
+    for (i = 0; i < 10; ++i)
+    {
+        if (r->ptr == r->end)
+            return FALSE;
+        b = *r->ptr++;
+        if (i == 9 && (b & 0xfe))
+            return FALSE;
+        v |= (UINT64)(b & 0x7f) << (7 * i);
+        if (!(b & 0x80))
+        {
+            *value = v;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+/* 读取多字节有符号整数。 */
+static BOOL isf_signed(struct isf_reader *r, LONG *value)
+{
+    UINT64 n;
+    if (!isf_uint(r, &n) || (n >> 1) > (UINT64)INT_MAX + (n & 1))
+        return FALSE;
+    *value = (n & 1) ? -(INT64)(n >> 1) : n >> 1;
+    return TRUE;
+}
+
+/* 读取带长度的块。 */
+static BOOL isf_block(struct isf_reader *r, struct isf_reader *block)
+{
+    UINT64 n;
+    const BYTE *data;
+    if (!isf_uint(r, &n) || n > (SIZE_T)(r->end - r->ptr) || !isf_bytes(r, n, &data))
+        return FALSE;
+    block->ptr = data;
+    block->end = data + (SIZE_T)n;
+    return TRUE;
+}
+
+/* 追加字节到输出缓冲区。 */
+static void isf_write(struct isf_writer *w, const void *data, SIZE_T n)
+{
+    BYTE *p;
+    SIZE_T capacity;
+    if (FAILED(w->hr) || n > ~(SIZE_T)0 - w->size)
+    {
+        w->hr = E_OUTOFMEMORY;
+        return;
+    }
+    if (w->size + n > w->capacity)
+    {
+        capacity = max(w->size + n, max((SIZE_T)64, w->capacity * 2));
+        if (capacity < w->size + n || !(p = realloc(w->data, capacity)))
+        {
+            w->hr = E_OUTOFMEMORY;
+            return;
+        }
+        w->data = p;
+        w->capacity = capacity;
+    }
+    if (n)
+        memcpy(w->data + w->size, data, n);
+    w->size += n;
+}
+
+/* 写入单个字节。 */
+static void isf_byte(struct isf_writer *w, BYTE b)
+{
+    isf_write(w, &b, 1);
+}
+
+/* 写入多字节无符号整数。 */
+static void isf_number(struct isf_writer *w, UINT64 n)
+{
+    while (n >= 128)
+    {
+        isf_byte(w, (n & 0x7f) | 0x80);
+        n >>= 7;
+    }
+    isf_byte(w, n);
+}
+
+/* 写入多字节有符号整数。 */
+static void isf_sign_number(struct isf_writer *w, LONG n)
+{
+    isf_number(w, ((UINT64)(n < 0 ? -(INT64)n : n) << 1) | (n < 0));
+}
+
+/* 写入带标签和长度的块。 */
+static void isf_section(struct isf_writer *w, UINT64 tag, const struct isf_writer *block)
+{
+    isf_number(w, tag);
+    isf_number(w, block->size);
+    isf_write(w, block->data, block->size);
+    if (FAILED(block->hr))
+        w->hr = block->hr;
+}
+
+/* 释放输出缓冲区。 */
+static void isf_drop(struct isf_writer *w)
+{
+    free(w->data);
+    w->data = NULL;
+}
+
+/* 按标签查找 GUID。 */
+static const GUID *isf_guid(const struct isf_state *s, UINT64 tag)
+{
+    if (tag >= TAG_GUID_X && tag < TAG_GUID_X + ARRAY_SIZE(known_guids))
+        return &known_guids[tag - TAG_GUID_X];
+    if (tag >= TAG_CUSTOM_GUID_BASE && tag - TAG_CUSTOM_GUID_BASE < s->guid_count)
+        return &s->guids[tag - TAG_CUSTOM_GUID_BASE];
+    return NULL;
+}
+
+/* 按 GUID 查找标签。 */
+static UINT64 isf_tag_for_guid(const struct isf_state *s, const GUID *guid)
+{
+    unsigned int i;
+    for (i = 0; i < ARRAY_SIZE(known_guids); i++)
+        if (IsEqualGUID(guid, &known_guids[i]))
+            return i + TAG_GUID_X;
+    for (i = 0; i < s->guid_count; i++)
+        if (IsEqualGUID(guid, &s->guids[i]))
+            return i + TAG_CUSTOM_GUID_BASE;
+    return 0;
+}
+
+/* 收集自定义 GUID。 */
+static HRESULT isf_add_guid(struct isf_state *s, const GUID *guid)
+{
+    GUID *list;
+    if (isf_tag_for_guid(s, guid))
+        return S_OK;
+    if (s->guid_count == UINT_MAX || !(list = realloc(s->guids, (s->guid_count + 1) * sizeof(*list))))
+        return E_OUTOFMEMORY;
+    s->guids = list;
+    list[s->guid_count++] = *guid;
+    return S_OK;
+}
+
+/* 收集描述符或度量块。 */
+static HRESULT isf_add_blob(struct isf_blob **blobs, unsigned int *count, struct isf_reader *block)
+{
+    struct isf_blob *p;
+    if (*count == UINT_MAX || !(p = realloc(*blobs, (*count + 1) * sizeof(*p))))
+        return E_OUTOFMEMORY;
+    *blobs = p;
+    p[*count].data = block->ptr;
+    p[*count].size = block->end - block->ptr;
+    ++*count;
+    return S_OK;
+}
+
+/* 加入扩展属性。 */
+static HRESULT isf_add_property(IInkExtendedProperties *props, const GUID *guid, VARIANT *data)
+{
+    IInkExtendedProperty *property;
+    WCHAR name[39];
+    BSTR bstr;
+    HRESULT hr;
+
+    StringFromGUID2(guid, name, ARRAY_SIZE(name));
+    if (!(bstr = SysAllocString(name)))
+        return E_OUTOFMEMORY;
+    hr = IInkExtendedProperties_Add(props, bstr, *data, &property);
+    SysFreeString(bstr);
+    if (SUCCEEDED(hr) && property)
+        IInkExtendedProperty_Release(property);
+    return hr;
+}
+
+/* 读取扩展属性。 */
+static HRESULT isf_get_property(IInkExtendedProperties *props, unsigned int index, GUID *guid, VARIANT *v)
+{
+    IInkExtendedProperty *prop;
+    VARIANT n;
+    BSTR str;
+    HRESULT hr;
+
+    V_VT(&n) = VT_I4;
+    V_I4(&n) = index;
+    if (FAILED(hr = IInkExtendedProperties_Item(props, n, &prop)))
+        return hr;
+    if (SUCCEEDED(hr = IInkExtendedProperty_get_Guid(prop, &str)))
+    {
+        hr = IIDFromString(str, guid);
+        SysFreeString(str);
+    }
+    if (SUCCEEDED(hr))
+        hr = IInkExtendedProperty_get_Data(prop, v);
+    IInkExtendedProperty_Release(prop);
+    return hr;
+}
+
+/* 返回标量类型的字节数。 */
+static unsigned int isf_scalar_size(VARTYPE vt)
+{
+    switch (vt)
+    {
+    case VT_I1: case VT_UI1:
+        return 1;
+    case VT_I2: case VT_UI2: case VT_BOOL:
+        return 2;
+    case VT_I4: case VT_UI4: case VT_R4:
+        return 4;
+    case VT_I8: case VT_UI8: case VT_R8: case VT_DATE:
+        return 8;
+    default:
+        return 0;
+    }
+}
+
+/* 将属性字节还原为 VARIANT。 */
+static HRESULT isf_decode_variant(const GUID *guid, struct isf_reader bytes, VARIANT *v)
+{
+    const BYTE *raw;
+    VARTYPE vt, base;
+    SIZE_T n;
+    UINT i, count;
+    BYTE *dest;
+    SAFEARRAY *array;
+    unsigned int item_size;
+
+    VariantInit(v);
+    if (isf_tag_for_guid(&(struct isf_state){0}, guid) >= TAG_GUID_X &&
+            isf_tag_for_guid(&(struct isf_state){0}, guid) < TAG_KNOWN_GUID_LIMIT)
+        vt = VT_ARRAY | VT_UI1;
+    else
+    {
+        if (!isf_bytes(&bytes, 2, &raw))
+            return E_INVALIDARG;
+        vt = raw[0] | (raw[1] << 8);
+    }
+    n = bytes.end - bytes.ptr;
+    base = vt & ~VT_ARRAY;
+    if (vt == VT_BSTR)
+    {
+        if (n & 1 || n > UINT_MAX || !(V_BSTR(v) = SysAllocStringLen((const WCHAR *)bytes.ptr, n / 2)))
+            return n ? E_INVALIDARG : E_OUTOFMEMORY;
+        V_VT(v) = VT_BSTR;
+        return S_OK;
+    }
+    item_size = isf_scalar_size(base);
+    if (!item_size && base != VT_BSTR)
+        return E_INVALIDARG;
+    if (vt & VT_ARRAY)
+    {
+        if (base == VT_BSTR)
+        {
+            /* Strings in a SAFEARRAY have explicit byte lengths; WPF does not emit this type. */
+            struct isf_reader strings = bytes;
+            UINT64 length;
+            if (!isf_uint(&strings, &length) || length > UINT_MAX)
+                return E_INVALIDARG;
+            count = length;
+            if (!(array = SafeArrayCreateVector(VT_BSTR, 0, count)))
+                return E_OUTOFMEMORY;
+            for (i = 0; i < count; ++i)
+            {
+                BSTR str;
+                HRESULT hr;
+                LONG index = i;
+                if (!isf_uint(&strings, &length) || length > (SIZE_T)(strings.end - strings.ptr) || (length & 1))
+                    break;
+                if (!(str = SysAllocStringLen((const WCHAR *)strings.ptr, length / 2)))
+                {
+                    SafeArrayDestroy(array);
+                    return E_OUTOFMEMORY;
+                }
+                hr = SafeArrayPutElement(array, &index, str);
+                SysFreeString(str);
+                if (FAILED(hr))
+                {
+                    SafeArrayDestroy(array);
+                    return hr;
+                }
+                strings.ptr += length;
+            }
+            if (i != count || strings.ptr != strings.end)
+            {
+                SafeArrayDestroy(array);
+                return E_INVALIDARG;
+            }
+        }
+        else
+        {
+            if (n % item_size || n / item_size > UINT_MAX)
+                return E_INVALIDARG;
+            count = n / item_size;
+            if (!(array = SafeArrayCreateVector(base, 0, count)))
+                return E_OUTOFMEMORY;
+            if (FAILED(SafeArrayAccessData(array, (void **)&dest)))
+            {
+                SafeArrayDestroy(array);
+                return E_INVALIDARG;
+            }
+            memcpy(dest, bytes.ptr, n);
+            SafeArrayUnaccessData(array);
+        }
+        V_VT(v) = vt;
+        V_ARRAY(v) = array;
+        return S_OK;
+    }
+    if (n != item_size)
+        return E_INVALIDARG;
+    V_VT(v) = vt;
+    memcpy(&V_I8(v), bytes.ptr, n);
+    return S_OK;
+}
+
+/* 将 VARIANT 写成属性字节。 */
+static void isf_encode_variant(struct isf_writer *w, const GUID *guid, const VARIANT *v)
+{
+    VARTYPE vt = V_VT(v);
+    VARTYPE base = vt & ~VT_ARRAY;
+    BYTE *bytes;
+    UINT count;
+    BSTR str;
+    unsigned int elem_size;
+
+    if (isf_tag_for_guid(&(struct isf_state){0}, guid) < TAG_GUID_X)
+    {
+        isf_byte(w, vt);
+        isf_byte(w, vt >> 8);
+    }
+    if (vt == VT_BSTR)
+    {
+        isf_write(w, V_BSTR(v), SysStringLen(V_BSTR(v)) * sizeof(WCHAR));
+        return;
+    }
+    elem_size = isf_scalar_size(base);
+    if (vt & VT_ARRAY)
+    {
+        if (!V_ARRAY(v) || SafeArrayGetDim(V_ARRAY(v)) != 1)
+        {
+            w->hr = E_INVALIDARG;
+            return;
+        }
+        if (base == VT_BSTR)
+        {
+            LONG lower, upper, index;
+            SafeArrayGetLBound(V_ARRAY(v), 1, &lower);
+            SafeArrayGetUBound(V_ARRAY(v), 1, &upper);
+            isf_number(w, upper - lower + 1);
+            for (index = lower; index <= upper; ++index)
+            {
+                if (FAILED(SafeArrayGetElement(V_ARRAY(v), &index, &str)))
+                {
+                    w->hr = E_INVALIDARG;
+                    return;
+                }
+                isf_number(w, SysStringLen(str) * sizeof(WCHAR));
+                isf_write(w, str, SysStringLen(str) * sizeof(WCHAR));
+                SysFreeString(str);
+            }
+            return;
+        }
+        if (!elem_size || SafeArrayGetVartype(V_ARRAY(v), &base) != S_OK || base != (vt & ~VT_ARRAY))
+        {
+            w->hr = E_INVALIDARG;
+            return;
+        }
+        count = V_ARRAY(v)->rgsabound[0].cElements;
+        if (FAILED(SafeArrayAccessData(V_ARRAY(v), (void **)&bytes)))
+        {
+            w->hr = E_INVALIDARG;
+            return;
+        }
+        isf_write(w, bytes, (SIZE_T)count * elem_size);
+        SafeArrayUnaccessData(V_ARRAY(v));
+        return;
+    }
+    if (!elem_size)
+    {
+        w->hr = E_INVALIDARG;
+        return;
+    }
+    isf_write(w, &V_I8(v), elem_size);
+}
+
+struct isf_bits
+{
+    struct isf_reader *reader;
+    struct isf_writer *writer;
+    BYTE current;
+    unsigned int used;
+};
+
+/* 从位流读取整数。 */
+static BOOL isf_read_bits(struct isf_bits *bits, unsigned int n, UINT64 *out)
+{
+    UINT64 result = 0;
+    unsigned int i;
+    for (i = 0; i < n; ++i)
+    {
+        if (!bits->used)
+        {
+            if (bits->reader->ptr == bits->reader->end)
+                return FALSE;
+            bits->current = *bits->reader->ptr++;
+            bits->used = 8;
+        }
+        result = (result << 1) | ((bits->current >> --bits->used) & 1);
+    }
+    *out = result;
+    return TRUE;
+}
+
+/* 向位流写入整数。 */
+static void isf_write_bits(struct isf_bits *bits, UINT64 v, unsigned int n)
+{
+    unsigned int i;
+    for (i = n; i; --i)
+    {
+        bits->current = (bits->current << 1) | ((v >> (i - 1)) & 1);
+        if (++bits->used == 8)
+        {
+            isf_byte(bits->writer, bits->current);
+            bits->used = 0;
+            bits->current = 0;
+        }
+    }
+}
+
+/* 写出位流中的末尾字节。 */
+static void isf_flush_bits(struct isf_bits *bits)
+{
+    if (bits->used)
+        isf_byte(bits->writer, bits->current << (8 - bits->used));
+}
+
+/* 解开属性的位打包数据。 */
+static BOOL isf_unpack_property(struct isf_reader data, BYTE algo, struct isf_writer *out)
+{
+    struct isf_bits bits = {.reader = &data};
+    unsigned int unit = (algo & 0x40) ? 4 : ((algo & 0x20) ? 2 : 1);
+    unsigned int index = algo & ((algo & 0x40) ? 63 : 31);
+    unsigned int nbits = index < 24 ? prop_bits[index] : index - 16;
+    unsigned int pads = index < 24 ? prop_pads[index] : 0;
+    SIZE_T count, i;
+    UINT64 v;
+    BYTE b;
+
+    if (algo & 0x80 || !nbits || nbits > 8 * unit || (data.end - data.ptr) > SIZE_MAX / 8)
+        return FALSE;
+    count = ((SIZE_T)(data.end - data.ptr) * 8) / nbits;
+    if (count < pads)
+        return FALSE;
+    count -= pads;
+    if (count > SIZE_MAX / unit)
+        return FALSE;
+    for (i = 0; i < count; ++i)
+    {
+        if (!isf_read_bits(&bits, nbits, &v))
+            return FALSE;
+        if (unit == 4 && nbits < 32 && (v & (1u << (nbits - 1))))
+            v |= ~((1ull << nbits) - 1);
+        for (unsigned int j = 0; j < unit; j++)
+        {
+            b = v >> (8 * j);
+            isf_byte(out, b);
+        }
+    }
+    return SUCCEEDED(out->hr);
+}
+
+/* 解开 LZ 压缩属性。 */
+static BOOL isf_unpack_lz(struct isf_reader data, struct isf_writer *out)
+{
+    BYTE ring[4069] = {0};
+    BYTE first, second;
+    unsigned int flags = 0;
+    unsigned int position = ARRAY_SIZE(ring) - 16;
+    unsigned int offset, count, i;
+
+    while (data.ptr < data.end)
+    {
+        if (((flags >>= 1) & 0x100) == 0)
+            flags = *data.ptr++ | 0xff00;
+        if (data.ptr == data.end)
+            return FALSE;
+        first = *data.ptr++;
+        if (flags & 1)
+        {
+            isf_byte(out, first);
+            ring[position++] = first;
+            position &= ARRAY_SIZE(ring) - 1;
+        }
+        else
+        {
+            if (data.ptr == data.end)
+                return FALSE;
+            second = *data.ptr++;
+            offset = ((second & 0xf0) << 4) | first;
+            count = (second & 0x0f) + 3;
+            for (i = 0; i < count; i++)
+            {
+                first = ring[(offset + i) & (ARRAY_SIZE(ring) - 1)];
+                isf_byte(out, first);
+                ring[position++] = first;
+                position &= ARRAY_SIZE(ring) - 1;
+            }
+        }
+        if (FAILED(out->hr))
+            return FALSE;
+    }
+    return TRUE;
+}
+
+/* 计算整数的最小位宽。 */
+static unsigned int isf_bits_for(UINT64 maximum, BOOL signed_value)
+{
+    unsigned int bits = 0;
+    do
+    {
+        ++bits;
+        maximum >>= 1;
+    }
+    while (maximum)
+        ;
+    return min(bits + !!signed_value, signed_value ? 32u : 16u);
+}
+
+/* 压缩属性数据。 */
+static void isf_pack_property(struct isf_writer *out, const BYTE *data, SIZE_T n,
+        InkPersistenceCompressionMode compression)
+{
+    static const BYTE offsets[] = {0,1,9,13,16,18,20,22};
+    struct isf_bits bits = {.writer = out};
+    unsigned int nbits = 8;
+    unsigned int unit = 1;
+    unsigned int index = 0;
+    unsigned int other;
+    UINT64 maximum = 0;
+    UINT64 v, magnitude;
+    INT64 signed_value;
+    SIZE_T i;
+
+    if (compression != IPCM_NoCompression && n)
+    {
+        for (i = 0; i < n; i++)
+            maximum = max(maximum, data[i]);
+        nbits = isf_bits_for(maximum, FALSE);
+        if (!(n & 1))
+        {
+            maximum = 0;
+            for (i = 0; i < n; i += 2)
+                maximum = max(maximum, data[i] | (unsigned int)data[i + 1] << 8);
+            other = isf_bits_for(maximum, FALSE);
+            if (other < nbits * 2)
+            {
+                nbits = other;
+                unit = 2;
+            }
+        }
+        if (!(n & 3))
+        {
+            maximum = 0;
+            for (i = 0; i < n; i += 4)
+            {
+                INT32 number = (UINT32)data[i] | (UINT32)data[i + 1] << 8 |
+                        (UINT32)data[i + 2] << 16 | (UINT32)data[i + 3] << 24;
+                signed_value = number;
+                magnitude = signed_value < 0 ? -signed_value : signed_value;
+                maximum = max(maximum, magnitude);
+            }
+            other = isf_bits_for(maximum, TRUE);
+            if (other < nbits * (unit == 2 ? 2 : 4))
+            {
+                nbits = other;
+                unit = 4;
+            }
+        }
+        if (unit == 1 && nbits == 8)
+            index = 0;
+        else if (nbits > 7)
+            index = 16 + nbits;
+        else
+            index = offsets[nbits] + ((8 - (n / unit * nbits) % 8) % 8) / nbits;
+        index |= unit == 4 ? 0x40 : (unit == 2 ? 0x20 : 0);
+    }
+    isf_byte(out, index);
+    for (i = 0; i < n; i += unit)
+    {
+        v = data[i];
+        if (unit > 1)
+            v |= (UINT64)data[i + 1] << 8;
+        if (unit > 2)
+            v |= (UINT64)data[i + 2] << 16 | (UINT64)data[i + 3] << 24;
+        isf_write_bits(&bits, v, nbits);
+    }
+    isf_flush_bits(&bits);
+}
+
+/* 读取单项扩展属性。 */
+static HRESULT isf_decode_property(struct isf_reader *r, const struct isf_state *s, UINT64 tag,
+        IInkExtendedProperties *properties)
+{
+    const GUID *guid = isf_guid(s, tag);
+    struct isf_reader compressed, raw;
+    struct isf_writer uncompressed = {0};
+    const BYTE *p;
+    UINT64 n;
+    VARIANT v;
+    HRESULT hr;
+
+    if (!guid)
+        return E_INVALIDARG;
+    if (tag >= TAG_GUID_X && tag < TAG_KNOWN_GUID_LIMIT && fixed_sizes[tag - TAG_GUID_X])
+    {
+        if (!isf_bytes(r, fixed_sizes[tag - TAG_GUID_X], &p))
+            return E_INVALIDARG;
+        raw.ptr = p;
+        raw.end = p + fixed_sizes[tag - TAG_GUID_X];
+    }
+    else
+    {
+        if (!isf_uint(r, &n) || n >= (SIZE_T)(r->end - r->ptr) || !isf_bytes(r, n + 1, &p))
+            return E_INVALIDARG;
+        compressed.ptr = p + 1;
+        compressed.end = p + n + 1;
+        if (!(*p == 0x80 ? isf_unpack_lz(compressed, &uncompressed) :
+                isf_unpack_property(compressed, *p, &uncompressed)))
+        {
+            hr = FAILED(uncompressed.hr) ? uncompressed.hr : E_INVALIDARG;
+            isf_drop(&uncompressed);
+            return hr;
+        }
+        raw.ptr = uncompressed.data ? uncompressed.data : (const BYTE *)"";
+        raw.end = raw.ptr + uncompressed.size;
+    }
+    hr = isf_decode_variant(guid, raw, &v);
+    if (SUCCEEDED(hr))
+    {
+        hr = isf_add_property(properties, guid, &v);
+        VariantClear(&v);
+    }
+    isf_drop(&uncompressed);
+    return hr;
+}
+
+/* 写入单项扩展属性。 */
+static HRESULT isf_encode_property(struct isf_writer *w, struct isf_state *s, const GUID *guid,
+        const VARIANT *v, InkPersistenceCompressionMode mode, BOOL tagged)
+{
+    struct isf_writer data = {0};
+    struct isf_writer compressed = {0};
+    UINT64 tag = isf_tag_for_guid(s, guid);
+    if (!tag)
+        return E_INVALIDARG;
+    if (tagged)
+        isf_number(w, tag);
+    isf_encode_variant(&data, guid, v);
+    if (FAILED(data.hr))
+    {
+        isf_drop(&data);
+        return data.hr;
+    }
+    if (tag >= TAG_GUID_X && tag < TAG_KNOWN_GUID_LIMIT && fixed_sizes[tag - TAG_GUID_X])
+    {
+        if (data.size != fixed_sizes[tag - TAG_GUID_X])
+            w->hr = E_INVALIDARG;
+        else
+            isf_write(w, data.data, data.size);
+    }
+    else
+    {
+        isf_pack_property(&compressed, data.data, data.size, mode);
+        if (!compressed.size)
+            w->hr = E_INVALIDARG;
+        else
+        {
+            isf_number(w, compressed.size - 1);
+            isf_write(w, compressed.data, compressed.size);
+        }
+        if (FAILED(compressed.hr))
+            w->hr = compressed.hr;
+    }
+    isf_drop(&data);
+    isf_drop(&compressed);
+    return w->hr;
+}
+
+/* 跳过已知的非公开属性。 */
+static HRESULT isf_skip_property(struct isf_reader *r, UINT64 tag)
+{
+    UINT64 n;
+    const BYTE *raw;
+    if (tag < TAG_GUID_X || tag >= TAG_KNOWN_GUID_LIMIT)
+        return E_INVALIDARG;
+    if (fixed_sizes[tag - TAG_GUID_X])
+        return isf_bytes(r, fixed_sizes[tag - TAG_GUID_X], &raw) ? S_OK : E_INVALIDARG;
+    if (!isf_uint(r, &n) || n >= (SIZE_T)(r->end - r->ptr) || !isf_bytes(r, n + 1, &raw))
+        return E_INVALIDARG;
+    return S_OK;
+}
+
+/* 读取绘图属性块。 */
+static HRESULT isf_decode_attrs(struct isf_state *s, struct isf_reader r)
+{
+    IInkDrawingAttributes *attributes, **list;
+    IInkExtendedProperties *props;
+    UINT64 tag, value, len;
+    const BYTE *raw;
+    float width;
+    HRESULT hr = S_OK;
+
+    if (FAILED(hr = drawing_attributes_create(&attributes)))
+        return hr;
+    if (FAILED(hr = IInkDrawingAttributes_get_ExtendedProperties(attributes, &props)))
+    {
+        IInkDrawingAttributes_Release(attributes);
+        return hr;
+    }
+    while (r.ptr < r.end)
+    {
+        if (!isf_uint(&r, &tag))
+        {
+            hr = E_INVALIDARG;
+            break;
+        }
+        TRACE("drawing tag %I64u, remaining %Iu.\n", tag, (SIZE_T)(r.end - r.ptr));
+        switch (tag)
+        {
+        case TAG_GUID_PEN_STYLE: /* pen style */
+        case TAG_GUID_CURVE_FITTING_ERROR: /* fitting error */
+            if (!isf_uint(&r, &value))
+                hr = E_INVALIDARG;
+            break;
+        case TAG_GUID_CURSOR_ID: /* cursor ID */
+            if (!isf_bytes(&r, fixed_sizes[TAG_GUID_CURSOR_ID - TAG_GUID_X], &raw))
+                hr = E_INVALIDARG;
+            break;
+        case TAG_GUID_COLORREF:
+            if (!isf_uint(&r, &value) || value > 0xffffff)
+            {
+                hr = E_INVALIDARG;
+                break;
+            }
+            hr = IInkDrawingAttributes_put_Color(attributes, value);
+            break;
+        case TAG_GUID_PEN_WIDTH: case TAG_GUID_PEN_HEIGHT:
+            if (!isf_uint(&r, &value) || value > INT_MAX)
+            {
+                hr = E_INVALIDARG;
+                break;
+            }
+            width = value;
+            if (r.ptr < r.end)
+            {
+                struct isf_reader saved = r;
+                UINT64 next;
+                if (!isf_uint(&r, &next))
+                {
+                    hr = E_INVALIDARG;
+                    break;
+                }
+                if (next == TAG_MANTISSA)
+                {
+                    struct isf_writer fraction = {0};
+                    struct isf_reader compressed;
+                    if (!isf_uint(&r, &len) || len >= (SIZE_T)(r.end - r.ptr) ||
+                            !isf_bytes(&r, len + 1, &raw))
+                    {
+                        hr = E_INVALIDARG;
+                        break;
+                    }
+                    compressed.ptr = raw + 1;
+                    compressed.end = raw + len + 1;
+                    if (!(*raw == 0x80 ? isf_unpack_lz(compressed, &fraction) :
+                            isf_unpack_property(compressed, *raw, &fraction)) || fraction.size != 2)
+                    {
+                        hr = FAILED(fraction.hr) ? fraction.hr : E_INVALIDARG;
+                        isf_drop(&fraction);
+                        break;
+                    }
+                    width += (SHORT)(fraction.data[0] | fraction.data[1] << 8) / 1000.0f;
+                    isf_drop(&fraction);
+                }
+                else
+                    r = saved;
+            }
+            hr = tag == TAG_GUID_PEN_WIDTH ? IInkDrawingAttributes_put_Width(attributes, width) :
+                    IInkDrawingAttributes_put_Height(attributes, width);
+            break;
+        case TAG_GUID_PEN_TIP:
+            if (!isf_uint(&r, &value) || value > 1)
+            {
+                hr = E_INVALIDARG;
+                break;
+            }
+            hr = IInkDrawingAttributes_put_PenTip(attributes, value);
+            break;
+        case TAG_GUID_DRAWING_FLAGS: /* drawing flags */
+            if (!isf_uint(&r, &value))
+            {
+                hr = E_INVALIDARG;
+                break;
+            }
+            IInkDrawingAttributes_put_FitToCurve(attributes,
+                    (value & DRAWING_FLAG_FIT_TO_CURVE) ? VARIANT_TRUE : VARIANT_FALSE);
+            IInkDrawingAttributes_put_IgnorePressure(attributes,
+                    (value & DRAWING_FLAG_IGNORE_PRESSURE) ? VARIANT_TRUE : VARIANT_FALSE);
+            hr = IInkDrawingAttributes_put_AntiAliased(attributes,
+                    (value & DRAWING_FLAG_ANTIALIASED) ? VARIANT_TRUE : VARIANT_FALSE);
+            break;
+        case TAG_GUID_TRANSPARENCY:
+            if (!isf_uint(&r, &value) || value > 255)
+            {
+                hr = E_INVALIDARG;
+                break;
+            }
+            hr = IInkDrawingAttributes_put_Transparency(attributes, value);
+            break;
+        case TAG_GUID_RASTER_OPERATION:
+            if (!isf_bytes(&r, fixed_sizes[TAG_GUID_RASTER_OPERATION - TAG_GUID_X], &raw) ||
+                    raw[0] < IRO_Black || raw[0] > IRO_White)
+            {
+                hr = E_INVALIDARG;
+                break;
+            }
+            hr = IInkDrawingAttributes_put_RasterOperation(attributes, raw[0]);
+            break;
+        default:
+            if (tag >= TAG_GUID_X && tag < TAG_KNOWN_GUID_LIMIT)
+                hr = isf_skip_property(&r, tag);
+            else if (isf_guid(s, tag))
+                hr = isf_decode_property(&r, s, tag, props);
+            else
+                hr = E_INVALIDARG;
+            break;
+        }
+        if (FAILED(hr))
+            break;
+    }
+    IInkExtendedProperties_Release(props);
+    if (SUCCEEDED(hr))
+    {
+        if (s->attr_count == UINT_MAX || !(list = realloc(s->attrs, (s->attr_count + 1) * sizeof(*list))))
+            hr = E_OUTOFMEMORY;
+        else
+        {
+            s->attrs = list;
+            list[s->attr_count++] = attributes;
+        }
+    }
+    if (FAILED(hr))
+        IInkDrawingAttributes_Release(attributes);
+    return hr;
+}
+
+/* 读取并收集变换。 */
+static HRESULT isf_add_transform(struct isf_state *s, struct isf_reader *r, UINT64 tag, BOOL extended,
+        unsigned int index)
+{
+    struct isf_transform *list;
+    const BYTE *raw;
+    UINT64 angle;
+    double values[6] = {0};
+    unsigned int count, i;
+    struct isf_transform xform = {1,0,0,1,0,0};
+
+    if (tag < TAG_TRANSFORM || tag > TAG_QUAD)
+        return E_INVALIDARG;
+    if (tag == TAG_ROTATE)
+    {
+        if (!isf_uint(r, &angle) || angle > 36000)
+            return E_INVALIDARG;
+        values[0] = angle;
+    }
+    else
+    {
+        count = tag == TAG_ISO_SCALE ? 1 : (tag == TAG_ANISO_SCALE || tag == TAG_TRANSLATE ? 2 :
+                (tag == TAG_SCALE_TRANSLATE ? 4 : 6));
+        if (!isf_bytes(r, count * (extended ? sizeof(double) : sizeof(float)), &raw))
+            return E_INVALIDARG;
+        for (i = 0; i < count; i++)
+        {
+            if (extended)
+                memcpy(&values[i], raw + i * sizeof(double), sizeof(double));
+            else
+            {
+                float f;
+                memcpy(&f, raw + i * sizeof(float), sizeof(float));
+                values[i] = f;
+            }
+            if (!isfinite(values[i]))
+                return E_INVALIDARG;
+        }
+    }
+    switch (tag)
+    {
+    case TAG_ISO_SCALE:
+        xform.m11 = xform.m22 = values[0];
+        break;
+    case TAG_ANISO_SCALE:
+        xform.m11 = values[0];
+        xform.m22 = values[1];
+        break;
+    case TAG_ROTATE:
+        xform.m11 = xform.m22 = cos(values[0] * 0.01 * M_PI / 180);
+        xform.m12 = sin(values[0] * 0.01 * M_PI / 180);
+        xform.m21 = -xform.m12;
+        break;
+    case TAG_TRANSLATE:
+        xform.dx = values[0];
+        xform.dy = values[1];
+        break;
+    case TAG_SCALE_TRANSLATE:
+        xform.m11 = values[0];
+        xform.m22 = values[1];
+        xform.dx = values[2];
+        xform.dy = values[3];
+        break;
+    default:
+        xform.m11 = values[0];
+        xform.m12 = values[1];
+        xform.m21 = values[2];
+        xform.m22 = values[3];
+        xform.dx = values[4];
+        xform.dy = values[5];
+    }
+    if (extended)
+    {
+        if (index >= s->transform_count)
+            return E_INVALIDARG;
+        s->transforms[index] = xform;
+    }
+    else
+    {
+        if (s->transform_count == UINT_MAX || !(list = realloc(s->transforms,
+                (s->transform_count + 1) * sizeof(*list)))) return E_OUTOFMEMORY;
+        s->transforms = list;
+        list[s->transform_count++] = xform;
+    }
+    return S_OK;
+}
+
+/* 设置属性的默认度量。 */
+static void isf_default_metric(UINT64 tag, struct property_metrics *m)
+{
+    m->minimum = tag >= TAG_CUSTOM_GUID_BASE ? INT_MIN : 0;
+    m->maximum = INT_MAX;
+    m->units = TPMU_Default;
+    m->resolution = 1;
+    if (tag == TAG_GUID_X || tag == TAG_GUID_Y)
+    {
+        m->maximum = tag == TAG_GUID_X ? 12699 : 9649;
+        m->units = TPMU_Centimeters;
+        m->resolution = 1000;
+    }
+    else if (tag == TAG_GUID_Z)
+    {
+        m->minimum = -1023;
+        m->maximum = 1023;
+        m->units = TPMU_Centimeters;
+        m->resolution = 1000;
+    }
+    else if (tag == TAG_GUID_NORMAL_PRESSURE || tag == TAG_GUID_TANGENT_PRESSURE || tag == TAG_GUID_BUTTON_PRESSURE)
+        m->maximum = 1023;
+    else if (tag >= TAG_GUID_X_TILT_ORIENTATION && tag <= TAG_GUID_TWIST_ORIENTATION)
+    {
+        m->minimum = tag == TAG_GUID_ALTITUDE_ORIENTATION ? -900 : 0;
+        m->maximum = tag == TAG_GUID_ALTITUDE_ORIENTATION ? 900 : 3600;
+        m->units = TPMU_Degrees;
+        m->resolution = 10;
+    }
+}
+
+/* 将度量块应用到笔画。 */
+static HRESULT isf_apply_metrics(const struct isf_blob *block, const struct isf_state *s,
+        struct stroke_data *stroke)
+{
+    struct isf_reader r = {block->data, block->data + block->size};
+    struct isf_reader entry;
+    UINT64 tag;
+    LONG n;
+    const BYTE *p;
+    unsigned int i;
+    float f;
+
+    while (r.ptr < r.end)
+    {
+        if (!isf_uint(&r, &tag) || !isf_block(&r, &entry))
+            return E_INVALIDARG;
+        if (!isf_guid(s, tag))
+            continue;
+        for (i = 0; i < stroke->packet_size; i++)
+            if (IsEqualGUID(&stroke->description[i], isf_guid(s, tag)))
+                break;
+        if (i == stroke->packet_size)
+            continue;
+        if (entry.ptr < entry.end)
+        {
+            if (!isf_signed(&entry, &n))
+                return E_INVALIDARG;
+            stroke->metrics[i].minimum = n;
+        }
+        if (entry.ptr < entry.end)
+        {
+            if (!isf_signed(&entry, &n))
+                return E_INVALIDARG;
+            stroke->metrics[i].maximum = n;
+        }
+        if (entry.ptr < entry.end)
+        {
+            if (!isf_uint(&entry, &tag) || tag > TPMU_Grams)
+                return E_INVALIDARG;
+            stroke->metrics[i].units = tag;
+        }
+        if (entry.ptr < entry.end)
+        {
+            if (!isf_bytes(&entry, sizeof(f), &p))
+                return E_INVALIDARG;
+            memcpy(&f, p, sizeof(f));
+            stroke->metrics[i].resolution = f;
+        }
+    }
+    return S_OK;
+}
+
+/* 读取一个 Huffman 符号。 */
+static BOOL isf_huff_value(struct isf_bits *bits, BYTE codec, LONG *value, UINT64 *extra,
+        unsigned int depth)
+{
+    UINT64 v;
+    UINT64 min = 0;
+    unsigned int pref = 0;
+    unsigned int i;
+    if (depth > 1 || codec >= ARRAY_SIZE(huff_bits))
+        return FALSE;
+    do
+    {
+        if (!isf_read_bits(bits, 1, &v))
+            return FALSE;
+        if (v && ++pref > huff_count[codec])
+            return FALSE;
+    }
+    while (v);
+    *extra = 0;
+    if (!pref)
+    {
+        *value = 0;
+        return TRUE;
+    }
+    if (pref == huff_count[codec])
+    {
+        LONG high;
+        UINT64 unused;
+        if (!isf_huff_value(bits, codec, &high, &unused, depth + 1) || unused ||
+                !isf_huff_value(bits, codec, value, &unused, depth + 1) || unused) return FALSE;
+        *extra = (UINT32)high;
+        return TRUE;
+    }
+    min = 1;
+    for (i = 1; i < pref; i++)
+        min += (UINT64)1 << (huff_bits[codec][i] - 1);
+    if (!isf_read_bits(bits, huff_bits[codec][pref], &v))
+        return FALSE;
+    if ((v >> 1) + min > (UINT64)INT_MAX + (v & 1))
+        return FALSE;
+    *value = (v & 1) ? -(INT64)((v >> 1) + min) : (v >> 1) + min;
+    return TRUE;
+}
+
+/* 写入一个 Huffman 符号。 */
+static void isf_huff_encode(struct isf_bits *bits, BYTE codec, LONG value, UINT64 extra)
+{
+    UINT64 n = value < 0 ? -(INT64)value : value;
+    UINT64 min[10] = {0};
+    unsigned int pref = 1;
+    unsigned int i;
+    if (!value && !extra)
+    {
+        isf_write_bits(bits, 0, 1);
+        return;
+    }
+    if (extra)
+    {
+        isf_write_bits(bits, ((1u << (huff_count[codec] + 1)) - 2), huff_count[codec] + 1);
+        isf_huff_encode(bits, codec, extra, 0);
+        isf_huff_encode(bits, codec, value, 0);
+        return;
+    }
+    min[1] = 1;
+    for (i = 2; i < huff_count[codec]; ++i)
+        min[i] = min[i - 1] + ((UINT64)1 << (huff_bits[codec][i - 1] - 1));
+    while (pref < huff_count[codec] && n >= min[pref])
+        ++pref;
+    isf_write_bits(bits, (1u << pref) - 2, pref);
+    isf_write_bits(bits, ((n - min[pref - 1]) << 1) | (value < 0), huff_bits[codec][pref - 1]);
+}
+
+/* 解压一个笔画数据数组。 */
+static BOOL isf_packet(struct isf_reader *r, LONG *points, unsigned int count, unsigned int stride)
+{
+    struct isf_bits bits = {.reader = r};
+    BYTE algo;
+    UINT64 v, extra, magnitude;
+    INT64 previous = 0;
+    INT64 before = 0;
+    INT64 delta, original;
+    LONG value;
+    unsigned int width, i;
+
+    if (!count)
+        return TRUE;
+    if (r->ptr == r->end)
+        return FALSE;
+    algo = *r->ptr++;
+    if ((algo & 0xc0) == 0x80)
+    {
+        if ((algo & 31) >= ARRAY_SIZE(huff_bits))
+            return FALSE;
+        for (i = 0; i < count; ++i)
+        {
+            if (!isf_huff_value(&bits, algo & 31, &value, &extra, 0))
+                return FALSE;
+            magnitude = (UINT32)value;
+            delta = extra ? ((extra & 1) ? -1 : 1) * (INT64)((extra >> 1) << 32 | magnitude) : value;
+            original = delta + 2 * previous - before;
+            if (original < INT_MIN || original > INT_MAX)
+                return FALSE;
+            points[i * stride] = original;
+            before = previous;
+            previous = original;
+        }
+        return TRUE;
+    }
+    if (algo & 0xc0)
+        return FALSE;
+    width = algo & 31;
+    if (!width)
+        width = 32;
+    if (algo & 0x20)
+    {
+        for (i = 0; i < min(count, 2u); i++)
+        {
+            if (!isf_signed(r, &value))
+                return FALSE;
+            original = value + 2 * previous - before;
+            if (original < INT_MIN || original > INT_MAX)
+                return FALSE;
+            points[i * stride] = original;
+            before = previous;
+            previous = original;
+        }
+    }
+    for (i = (algo & 0x20) ? min(count, 2u) : 0; i < count; ++i)
+    {
+        if (!isf_read_bits(&bits, width, &v))
+            return FALSE;
+        value = width == 32 ? v : ((v & (1u << (width - 1))) ? v | ~((1ull << width) - 1) : v);
+        original = (algo & 0x20) ? (INT64)value + 2 * previous - before : value;
+        if (original < INT_MIN || original > INT_MAX)
+            return FALSE;
+        points[i * stride] = original;
+        before = previous;
+        previous = original;
+    }
+    return TRUE;
+}
+
+/* 压缩一个笔画数据数组。 */
+static void isf_encode_packet(struct isf_writer *w, const struct stroke_data *stroke, unsigned int property,
+        InkPersistenceCompressionMode compression)
+{
+    struct isf_bits bits = {.writer = w};
+    INT64 previous = 0;
+    INT64 before = 0;
+    INT64 delta;
+    UINT64 magnitude, extra;
+    unsigned int i;
+    unsigned int width = 1;
+    LONG value;
+
+    if (compression != IPCM_NoCompression)
+    {
+        for (i = 0; i < stroke->packet_count; i++)
+        {
+            value = stroke->packets[i * stroke->packet_size + property];
+            delta = (INT64)value + before - 2 * previous;
+            if (delta > INT_MAX && delta < (1ll << 32))
+                compression = IPCM_NoCompression;
+            before = previous;
+            previous = value;
+        }
+        before = previous = 0;
+    }
+    if (compression != IPCM_NoCompression)
+    {
+        isf_byte(w, 0x83);
+        for (i = 0; i < stroke->packet_count; i++)
+        {
+            value = stroke->packets[i * stroke->packet_size + property];
+            delta = (INT64)value + before - 2 * previous;
+            if (delta > INT_MAX || delta < INT_MIN)
+            {
+                magnitude = delta < 0 ? -delta : delta;
+                extra = ((magnitude >> 32) << 1) | (delta < 0);
+                isf_huff_encode(&bits, 3, (UINT32)magnitude, extra);
+            }
+            else
+                isf_huff_encode(&bits, 3, delta, 0);
+            before = previous;
+            previous = value;
+        }
+    }
+    else
+    {
+        for (i = 0; i < stroke->packet_count; i++)
+        {
+            value = stroke->packets[i * stroke->packet_size + property];
+            while (width < 32 && ((INT64)value < -(1ll << (width - 1)) ||
+                    (INT64)value >= (1ll << (width - 1)))) ++width;
+        }
+        isf_byte(w, width == 32 ? 0 : width);
+        for (i = 0; i < stroke->packet_count; i++)
+            isf_write_bits(&bits, (UINT32)stroke->packets[i * stroke->packet_size + property], width);
+    }
+    isf_flush_bits(&bits);
+}
+
+/* 读取笔画及其属性。 */
+static HRESULT isf_decode_stroke(struct isf_state *s, struct isf_reader r)
+{
+    struct isf_reader desc = {0};
+    GUID *guids = NULL;
+    LONG *packets = NULL;
+    IInkDrawingAttributes *attr = NULL;
+    struct stroke_data *stroke = NULL;
+    struct stroke_data **list;
+    UINT64 tag, n;
+    UINT64 button_count = 0;
+    unsigned int count = 2;
+    unsigned int values = 2;
+    unsigned int i, j, stride;
+    unsigned int property_count = 0;
+    BOOL no_x = FALSE;
+    BOOL no_y = FALSE;
+    struct isf_bits button_bits;
+    HRESULT hr = E_INVALIDARG;
+
+    if (s->desc_count && s->sidx >= s->desc_count)
+        return E_INVALIDARG;
+    if (s->metric_count && s->midx >= s->metric_count)
+        return E_INVALIDARG;
+    if (s->attr_count && s->didx >= s->attr_count)
+        return E_INVALIDARG;
+    if (s->transform_count && s->tidx >= s->transform_count)
+        return E_INVALIDARG;
+    if (s->desc_count)
+    {
+        desc.ptr = s->desc[s->sidx].data;
+        desc.end = desc.ptr + s->desc[s->sidx].size;
+    }
+    else
+        desc.ptr = desc.end = (const BYTE *)"";
+    if (!isf_uint(&r, &n) || n > UINT_MAX ||
+            (r.end - r.ptr < SIZE_MAX / 8 && n > (SIZE_T)(r.end - r.ptr) * 8)) return E_INVALIDARG;
+    if (!(guids = malloc((2 + (desc.end - desc.ptr)) * sizeof(*guids))))
+        return E_OUTOFMEMORY;
+    guids[0] = known_guids[0];
+    guids[1] = known_guids[1];
+    while (desc.ptr < desc.end)
+    {
+        if (!isf_uint(&desc, &tag))
+            goto done;
+        if (tag == TAG_NO_X)
+        {
+            no_x = TRUE;
+            continue;
+        }
+        if (tag == TAG_NO_Y)
+        {
+            no_y = TRUE;
+            continue;
+        }
+        if (tag == TAG_BUTTONS)
+        {
+            if (!isf_uint(&desc, &button_count) || button_count > desc.end - desc.ptr)
+                goto done;
+            for (i = 0; i < button_count; i++)
+            {
+                if (!isf_uint(&desc, &tag) || !isf_guid(s, tag))
+                    goto done;
+                guids[count++] = *isf_guid(s, tag);
+            }
+            continue;
+        }
+        if (tag == TAG_STROKE_PROPERTIES)
+            break;
+        if (!isf_guid(s, tag))
+            goto done;
+        guids[count++] = *isf_guid(s, tag);
+        ++property_count;
+    }
+    stride = count;
+    values += property_count;
+    if (n > SIZE_MAX / stride / sizeof(*packets))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (!(packets = calloc(max((SIZE_T)1, n * stride), sizeof(*packets))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    for (i = 0; i < values; ++i)
+    {
+        if ((i == 0 && no_x) || (i == 1 && no_y))
+            continue;
+        if (!isf_packet(&r, packets + i, n, stride))
+            goto done;
+    }
+    if (button_count)
+    {
+        button_bits = (struct isf_bits){.reader = &r};
+        for (i = 0; i < n; i++)
+            for (j = 0; j < button_count; j++)
+            {
+                if (!isf_read_bits(&button_bits, 1, &tag))
+                    goto done;
+                packets[i * stride + values + j] = tag;
+            }
+    }
+    if (s->attr_count)
+        attr = s->attrs[s->didx];
+    if (FAILED(hr = stroke_data_create(stride, guids, n, packets, attr, &stroke)))
+        goto done;
+    for (i = 0; i < stride; i++)
+        isf_default_metric(isf_tag_for_guid(s, &guids[i]), &stroke->metrics[i]);
+    if (s->metric_count && FAILED(hr = isf_apply_metrics(&s->metric[s->midx], s, stroke)))
+        goto done;
+    if (s->transform_count)
+    {
+        const struct isf_transform *xf = &s->transforms[s->tidx];
+        for (i = 0; i < n; i++)
+        {
+            double x = packets[i * stride];
+            double y = packets[i * stride + 1];
+            double tx = x * xf->m11 + y * xf->m21 + xf->dx;
+            double ty = x * xf->m12 + y * xf->m22 + xf->dy;
+            if (!isfinite(tx) || !isfinite(ty) || tx < INT_MIN || tx > INT_MAX || ty < INT_MIN || ty > INT_MAX)
+            {
+                hr = E_INVALIDARG;
+                goto done;
+            }
+            stroke->packets[i * stride] = lround(tx);
+            stroke->packets[i * stride + 1] = lround(ty);
+        }
+    }
+    while (desc.ptr < desc.end)
+    {
+        if (!isf_uint(&desc, &tag))
+        {
+            hr = E_INVALIDARG;
+            goto done;
+        }
+        if (FAILED(hr = isf_decode_property(&r, s, tag, stroke->properties)))
+            goto done;
+    }
+    while (r.ptr < r.end)
+    {
+        if (!isf_uint(&r, &tag))
+        {
+            hr = E_INVALIDARG;
+            goto done;
+        }
+        if (tag == TAG_POINT_PROPERTIES)
+        {
+            struct isf_reader skip;
+            if (!isf_block(&r, &skip))
+            {
+                hr = E_INVALIDARG;
+                goto done;
+            }
+        }
+        else if (FAILED(hr = isf_decode_property(&r, s, tag, stroke->properties)))
+            goto done;
+    }
+    if (s->count == UINT_MAX || !(list = realloc(s->strokes, (s->count + 1) * sizeof(*list))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    s->strokes = list;
+    list[s->count++] = stroke;
+    stroke = NULL;
+    hr = S_OK;
+done:
+    if (stroke)
+        stroke_data_release(stroke);
+    free(guids);
+    free(packets);
+    return hr;
+}
+
+/* 读取绘图、描述符或度量表。 */
+static HRESULT isf_decode_blocks(struct isf_state *s, struct isf_reader table, UINT64 type, BOOL single)
+{
+    struct isf_reader block;
+    HRESULT hr;
+
+    while (table.ptr < table.end || (single && table.ptr == table.end))
+    {
+        if (single)
+        {
+            block = table;
+            table.ptr = table.end;
+        }
+        else if (!isf_block(&table, &block))
+            return E_INVALIDARG;
+        if (type == TAG_DA_BLOCK)
+            hr = isf_decode_attrs(s, block);
+        else if (type == TAG_DESC_BLOCK)
+            hr = isf_add_blob(&s->desc, &s->desc_count, &block);
+        else
+            hr = isf_add_blob(&s->metric, &s->metric_count, &block);
+        if (FAILED(hr))
+            return hr;
+        if (single)
+            break;
+    }
+    return S_OK;
+}
+
+/* 读取变换表。 */
+static HRESULT isf_decode_transforms(struct isf_state *s, struct isf_reader block, BOOL extended)
+{
+    UINT64 tag;
+    unsigned int i = 0;
+    HRESULT hr;
+
+    if (extended && !s->transform_count)
+        return E_INVALIDARG;
+    while (block.ptr < block.end)
+    {
+        if (!isf_uint(&block, &tag))
+            return E_INVALIDARG;
+        if (FAILED(hr = isf_add_transform(s, &block, tag, extended, i++)))
+            return hr;
+    }
+    if (extended && i != s->transform_count)
+        return E_INVALIDARG;
+    return S_OK;
+}
+
+/* 释放解码状态。 */
+static void isf_free_state(struct isf_state *s)
+{
+    unsigned int i;
+    free(s->guids);
+    free(s->desc);
+    free(s->metric);
+    for (i = 0; i < s->attr_count; i++)
+        IInkDrawingAttributes_Release(s->attrs[i]);
+    free(s->attrs);
+    free(s->transforms);
+    strokes_free_data(s->strokes, s->count);
+}
+
+/* 将 ISF 字节流加载为笔画。 */
+HRESULT isf_decode(const BYTE *data, SIZE_T size, IInkExtendedProperties *ink_properties,
+        struct stroke_data ***strokes, unsigned int *count)
+{
+    struct isf_state state = {.properties = ink_properties};
+    struct isf_reader r = {data, data + size};
+    struct isf_reader block;
+    UINT64 tag, n, version;
+    LONG signed_value;
+    HRESULT hr = E_INVALIDARG;
+    unsigned int i;
+
+    TRACE("data %p, size %Iu, properties %p.\n", data, size, ink_properties);
+    *strokes = NULL;
+    *count = 0;
+    if (!data || !isf_uint(&r, &version) || version != 0 ||
+            !isf_uint(&r, &n) || n != (UINT64)(r.end - r.ptr)) goto done;
+    while (r.ptr < r.end)
+    {
+        hr = E_INVALIDARG;
+        if (!isf_uint(&r, &tag))
+            goto done;
+        TRACE("tag %I64u, offset %Iu.\n", tag, (SIZE_T)(r.ptr - data));
+        switch (tag)
+        {
+        case TAG_GUID_TABLE:
+            if (!isf_block(&r, &block) || (block.end - block.ptr) % sizeof(GUID))
+                goto done;
+            free(state.guids);
+            state.guid_count = (block.end - block.ptr) / sizeof(GUID);
+            if (!(state.guids = malloc(max(1u, state.guid_count) * sizeof(GUID))))
+            {
+                hr = E_OUTOFMEMORY;
+                goto done;
+            }
+            memcpy(state.guids, block.ptr, state.guid_count * sizeof(GUID));
+            break;
+        case TAG_INK_RECT:
+            for (i = 0; i < 4; i++)
+                if (!isf_signed(&r, &signed_value))
+                    goto done;
+            break;
+        case TAG_DA_TABLE: case TAG_DA_BLOCK: case TAG_DESC_TABLE: case TAG_DESC_BLOCK:
+        case TAG_METRIC_TABLE: case TAG_METRIC_BLOCK:
+            if (!isf_block(&r, &block))
+                goto done;
+            hr = isf_decode_blocks(&state, block, tag == TAG_DA_TABLE ? TAG_DA_BLOCK :
+                    (tag == TAG_DESC_TABLE ? TAG_DESC_BLOCK : (tag == TAG_METRIC_TABLE ? TAG_METRIC_BLOCK : tag)),
+                    tag == TAG_DA_BLOCK || tag == TAG_DESC_BLOCK || tag == TAG_METRIC_BLOCK);
+            if (FAILED(hr))
+                goto done;
+            break;
+        case TAG_TRANSFORM_TABLE: case TAG_EXT_TRANSFORM_TABLE:
+            if (!isf_block(&r, &block) || FAILED(hr = isf_decode_transforms(&state, block,
+                    tag == TAG_EXT_TRANSFORM_TABLE))) goto done;
+            break;
+        case TAG_TRANSFORM: case TAG_ISO_SCALE: case TAG_ANISO_SCALE: case TAG_ROTATE:
+        case TAG_TRANSLATE: case TAG_SCALE_TRANSLATE: case TAG_QUAD:
+            if (FAILED(hr = isf_add_transform(&state, &r, tag, FALSE, 0)))
+                goto done;
+            break;
+        case TAG_DIDX: case TAG_SIDX: case TAG_MIDX: case TAG_TIDX:
+            if (!isf_uint(&r, &n) || n > UINT_MAX)
+            {
+                hr = E_INVALIDARG;
+                goto done;
+            }
+            if (tag == TAG_DIDX)
+                state.didx = n;
+            else if (tag == TAG_SIDX)
+                state.sidx = n;
+            else if (tag == TAG_MIDX)
+                state.midx = n;
+            else
+                state.tidx = n;
+            break;
+        case TAG_STROKE:
+            if (!isf_block(&r, &block) || FAILED(hr = isf_decode_stroke(&state, block)))
+                goto done;
+            break;
+        case TAG_HIMETRIC_SIZE:
+            if (!isf_block(&r, &block) || !isf_signed(&block, &signed_value) ||
+                    !isf_signed(&block, &signed_value) || block.ptr != block.end) goto done;
+            break;
+        case TAG_PERSISTENCE:
+            if (!isf_block(&r, &block) || !isf_uint(&block, &n) || block.ptr != block.end)
+                goto done;
+            break;
+        case TAG_COMPRESSION_HEADER: case TAG_STROKE_IDS:
+            if (!isf_block(&r, &block))
+                goto done;
+            break;
+        default:
+            if (isf_guid(&state, tag))
+            {
+                if (FAILED(hr = isf_decode_property(&r, &state, tag, ink_properties)))
+                    goto done;
+            }
+            else if (!isf_block(&r, &block))
+                goto done;
+            break;
+        }
+    }
+    *strokes = state.strokes;
+    *count = state.count;
+    state.strokes = NULL;
+    state.count = 0;
+    hr = S_OK;
+done:
+    isf_free_state(&state);
+    return hr;
+}
+
+/* 收集扩展属性使用的 GUID。 */
+static HRESULT isf_collect_properties(struct isf_state *s, IInkExtendedProperties *properties)
+{
+    GUID guid;
+    VARIANT v;
+    LONG count, i;
+    HRESULT hr;
+
+    if (FAILED(hr = IInkExtendedProperties_get_Count(properties, &count)))
+        return hr;
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(hr = isf_get_property(properties, i, &guid, &v)))
+            return hr;
+        hr = isf_add_guid(s, &guid);
+        VariantClear(&v);
+        if (FAILED(hr))
+            return hr;
+    }
+    return S_OK;
+}
+
+/* 写入扩展属性集合。 */
+static void isf_encode_properties(struct isf_writer *w, struct isf_state *s,
+        IInkExtendedProperties *props, InkPersistenceCompressionMode mode, BOOL tagged)
+{
+    LONG count, i;
+    GUID guid;
+    VARIANT v;
+    HRESULT hr;
+
+    if (FAILED(hr = IInkExtendedProperties_get_Count(props, &count)))
+    {
+        w->hr = hr;
+        return;
+    }
+    for (i = 0; i < count && SUCCEEDED(w->hr); ++i)
+    {
+        if (FAILED(hr = isf_get_property(props, i, &guid, &v)))
+        {
+            w->hr = hr;
+            return;
+        }
+        w->hr = isf_encode_property(w, s, &guid, &v, mode, tagged);
+        VariantClear(&v);
+    }
+}
+
+/* 写入绘图属性块。 */
+static void isf_encode_attrs(struct isf_writer *w, struct isf_state *s, IInkDrawingAttributes *attrs,
+        InkPersistenceCompressionMode mode)
+{
+    IInkExtendedProperties *props;
+    InkRasterOperation rop;
+    InkPenTip tip;
+    VARIANT_BOOL fit, ignore, aa;
+    float sizes[2], rounded;
+    SHORT fraction;
+    LONG color, transparency;
+    unsigned int i;
+    HRESULT hr;
+
+    if (FAILED(hr = IInkDrawingAttributes_get_Color(attrs, &color)) ||
+            FAILED(hr = IInkDrawingAttributes_get_Width(attrs, &sizes[0])) ||
+            FAILED(hr = IInkDrawingAttributes_get_Height(attrs, &sizes[1])) ||
+            FAILED(hr = IInkDrawingAttributes_get_FitToCurve(attrs, &fit)) ||
+            FAILED(hr = IInkDrawingAttributes_get_IgnorePressure(attrs, &ignore)) ||
+            FAILED(hr = IInkDrawingAttributes_get_AntiAliased(attrs, &aa)) ||
+            FAILED(hr = IInkDrawingAttributes_get_Transparency(attrs, &transparency)) ||
+            FAILED(hr = IInkDrawingAttributes_get_RasterOperation(attrs, &rop)) ||
+            FAILED(hr = IInkDrawingAttributes_get_PenTip(attrs, &tip)))
+    {
+        w->hr = hr;
+        return;
+    }
+    isf_number(w, TAG_GUID_DRAWING_FLAGS);
+    isf_number(w, (fit ? DRAWING_FLAG_FIT_TO_CURVE : 0) | (ignore ? DRAWING_FLAG_IGNORE_PRESSURE : 0) |
+            (aa ? DRAWING_FLAG_ANTIALIASED : 0));
+    if (color)
+    {
+        isf_number(w, TAG_GUID_COLORREF);
+        isf_number(w, color & 0xffffff);
+    }
+    if (transparency)
+    {
+        isf_number(w, TAG_GUID_TRANSPARENCY);
+        isf_number(w, transparency);
+    }
+    if (rop != IRO_CopyPen)
+    {
+        static const BYTE zeros[3] = {0};
+        isf_number(w, TAG_GUID_RASTER_OPERATION);
+        isf_byte(w, rop);
+        isf_write(w, zeros, sizeof(zeros));
+    }
+    for (i = 0; i < 2; ++i)
+    {
+        if (sizes[i] == (i ? 1.0f : 53.0f))
+            continue;
+        if (!isfinite(sizes[i]) || sizes[i] < 0 || sizes[i] > INT_MAX - 1)
+        {
+            w->hr = E_INVALIDARG;
+            return;
+        }
+        rounded = floorf(sizes[i] + 0.5f);
+        fraction = lroundf((sizes[i] - rounded) * 1000.0f);
+        isf_number(w, TAG_GUID_PEN_WIDTH + i);
+        isf_number(w, rounded);
+        if (fraction)
+        {
+            isf_number(w, TAG_MANTISSA);
+            isf_number(w, 2);
+            isf_byte(w, 0);
+            isf_write(w, &fraction, sizeof(fraction));
+        }
+    }
+    if (tip != IPT_Ball)
+    {
+        isf_number(w, TAG_GUID_PEN_TIP);
+        isf_number(w, tip);
+    }
+    if (FAILED(hr = IInkDrawingAttributes_get_ExtendedProperties(attrs, &props)))
+    {
+        w->hr = hr;
+        return;
+    }
+    isf_encode_properties(w, s, props, mode, TRUE);
+    IInkExtendedProperties_Release(props);
+}
+
+/* 写入非默认属性度量。 */
+static void isf_encode_metric(struct isf_writer *w, struct isf_state *s,
+        const struct stroke_data *stroke)
+{
+    struct property_metrics def, *m;
+    struct isf_writer entry;
+    UINT64 tag;
+    unsigned int i;
+
+    for (i = 0; i < stroke->packet_size; i++)
+    {
+        tag = isf_tag_for_guid(s, &stroke->description[i]);
+        isf_default_metric(tag, &def);
+        m = &stroke->metrics[i];
+        if (m->minimum == def.minimum && m->maximum == def.maximum && m->units == def.units &&
+                m->resolution == def.resolution) continue;
+        entry = (struct isf_writer){0};
+        isf_sign_number(&entry, m->minimum);
+        if (m->maximum != def.maximum || m->units != def.units || m->resolution != def.resolution)
+            isf_sign_number(&entry, m->maximum);
+        if (m->units != def.units || m->resolution != def.resolution)
+            isf_number(&entry, m->units);
+        if (m->resolution != def.resolution)
+            isf_write(&entry, &m->resolution, sizeof(m->resolution));
+        isf_number(w, tag);
+        isf_number(w, entry.size);
+        isf_write(w, entry.data, entry.size);
+        if (FAILED(entry.hr))
+            w->hr = entry.hr;
+        isf_drop(&entry);
+    }
+}
+
+/* 写入笔画描述符。 */
+static void isf_encode_desc(struct isf_writer *w, struct isf_state *s, struct stroke_data *stroke)
+{
+    LONG count, i;
+    GUID guid;
+    VARIANT v;
+    HRESULT hr;
+    unsigned int j;
+
+    for (j = 2; j < stroke->packet_size; j++)
+        isf_number(w, isf_tag_for_guid(s, &stroke->description[j]));
+    if (FAILED(hr = IInkExtendedProperties_get_Count(stroke->properties, &count)))
+    {
+        w->hr = hr;
+        return;
+    }
+    if (count)
+        isf_number(w, TAG_STROKE_PROPERTIES);
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(hr = isf_get_property(stroke->properties, i, &guid, &v)))
+        {
+            w->hr = hr;
+            return;
+        }
+        isf_number(w, isf_tag_for_guid(s, &guid));
+        VariantClear(&v);
+    }
+}
+
+/* 将笔画保存为 ISF 字节流。 */
+HRESULT isf_encode(struct stroke_data **strokes, unsigned int count, IInkExtendedProperties *ink_properties,
+        InkPersistenceCompressionMode compression, BYTE **data, SIZE_T *size)
+{
+    struct isf_state s = {0};
+    struct isf_writer content = {0};
+    struct isf_writer block = {0};
+    struct isf_writer table = {0};
+    struct isf_writer stream = {0};
+    IInkExtendedProperties *props;
+    unsigned int i, j;
+    HRESULT hr = S_OK;
+
+    *data = NULL;
+    *size = 0;
+    if (FAILED(hr = isf_collect_properties(&s, ink_properties)))
+        goto done;
+    for (i = 0; i < count; i++)
+    {
+        for (j = 0; j < strokes[i]->packet_size; j++)
+            if (FAILED(hr = isf_add_guid(&s, &strokes[i]->description[j])))
+                goto done;
+        if (FAILED(hr = isf_collect_properties(&s, strokes[i]->properties)) ||
+                FAILED(hr = IInkDrawingAttributes_get_ExtendedProperties(strokes[i]->attributes, &props))) goto done;
+        hr = isf_collect_properties(&s, props);
+        IInkExtendedProperties_Release(props);
+        if (FAILED(hr))
+            goto done;
+    }
+    if (s.guid_count)
+    {
+        isf_number(&content, TAG_GUID_TABLE);
+        isf_number(&content, s.guid_count * sizeof(GUID));
+        isf_write(&content, s.guids, s.guid_count * sizeof(GUID));
+    }
+    if (count)
+    {
+        for (i = 0; i < count; i++)
+        {
+            block = (struct isf_writer){0};
+            isf_encode_attrs(&block, &s, strokes[i]->attributes, compression);
+            if (count == 1)
+                isf_section(&content, TAG_DA_BLOCK, &block);
+            else
+            {
+                isf_number(&table, block.size);
+                isf_write(&table, block.data, block.size);
+                if (FAILED(block.hr))
+                    table.hr = block.hr;
+            }
+            isf_drop(&block);
+        }
+        if (count > 1)
+        {
+            isf_section(&content, TAG_DA_TABLE, &table);
+            isf_drop(&table);
+            table = (struct isf_writer){0};
+        }
+        for (i = 0; i < count; i++)
+        {
+            block = (struct isf_writer){0};
+            isf_encode_desc(&block, &s, strokes[i]);
+            if (count == 1)
+                isf_section(&content, TAG_DESC_BLOCK, &block);
+            else
+            {
+                isf_number(&table, block.size);
+                isf_write(&table, block.data, block.size);
+                if (FAILED(block.hr))
+                    table.hr = block.hr;
+            }
+            isf_drop(&block);
+        }
+        if (count > 1)
+        {
+            isf_section(&content, TAG_DESC_TABLE, &table);
+            isf_drop(&table);
+            table = (struct isf_writer){0};
+        }
+        for (i = 0; i < count; i++)
+        {
+            block = (struct isf_writer){0};
+            isf_encode_metric(&block, &s, strokes[i]);
+            if (count == 1)
+                isf_section(&content, TAG_METRIC_BLOCK, &block);
+            else
+            {
+                isf_number(&table, block.size);
+                isf_write(&table, block.data, block.size);
+                if (FAILED(block.hr))
+                    table.hr = block.hr;
+            }
+            isf_drop(&block);
+        }
+        if (count > 1)
+        {
+            isf_section(&content, TAG_METRIC_TABLE, &table);
+            isf_drop(&table);
+            table = (struct isf_writer){0};
+        }
+    }
+    isf_encode_properties(&content, &s, ink_properties, compression, TRUE);
+    for (i = 0; i < count && SUCCEEDED(content.hr); i++)
+    {
+        struct stroke_data *stroke = strokes[i];
+        if (count > 1)
+        {
+            isf_number(&content, TAG_DIDX);
+            isf_number(&content, i);
+            isf_number(&content, TAG_SIDX);
+            isf_number(&content, i);
+            isf_number(&content, TAG_MIDX);
+            isf_number(&content, i);
+        }
+        block = (struct isf_writer){0};
+        isf_number(&block, stroke->packet_count);
+        /* a stroke without points has no packet arrays at all */
+        for (j = 0; stroke->packet_count && j < stroke->packet_size && SUCCEEDED(block.hr); j++)
+            isf_encode_packet(&block, stroke, j, compression);
+        isf_encode_properties(&block, &s, stroke->properties, compression, FALSE);
+        isf_section(&content, TAG_STROKE, &block);
+        isf_drop(&block);
+    }
+    if (SUCCEEDED(content.hr))
+    {
+        isf_byte(&stream, 0);
+        isf_number(&stream, content.size);
+        isf_write(&stream, content.data, content.size);
+        if (SUCCEEDED(stream.hr))
+        {
+            *data = stream.data;
+            *size = stream.size;
+            stream.data = NULL;
+        }
+        else
+            hr = stream.hr;
+    }
+    else
+        hr = content.hr;
+done:
+    isf_drop(&stream);
+    isf_drop(&content);
+    isf_drop(&block);
+    isf_drop(&table);
+    free(s.guids);
+    return hr;
+}
