+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+#include <stdio.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "wingdi.h"
+#include "winuser.h"
+#include "winspool.h"
+#include "commctrl.h"
+
+#include "printui_private.h"
+
+#define QUEUE_REFRESH_TIMER  1
+#define QUEUE_REFRESH_MS     500
+
+#define IDM_JOB_PAUSE   0x100
+#define IDM_JOB_RESUME  0x101
+#define IDM_JOB_CANCEL  0x102
+
+struct queue_window
+{
+    WCHAR   printer[MAX_PATH];
+    HWND    list;
+};
+
+static HINSTANCE queue_instance;
+
+static void load_string( UINT id, WCHAR *buf, int len, const WCHAR *fallback )
+{
+    if (!LoadStringW( queue_instance, id, buf, len )) lstrcpynW( buf, fallback, len );
+}
+
+/* The one line that says what is happening to a job.  A queue that is waiting
+ * for someone to put paper in the manual feeder says so here, which is the
+ * whole point of showing this window during manual duplex. */
+static void status_text( const JOB_INFO_2W *job, WCHAR *buf, int len )
+{
+    static const struct { DWORD flag; UINT id; const WCHAR *text; } states[] =
+    {
+        { JOB_STATUS_ERROR,             IDS_JOB_ERROR,        L"Error" },
+        { JOB_STATUS_PAPEROUT,          IDS_JOB_PAPEROUT,     L"Out of paper" },
+        { JOB_STATUS_USER_INTERVENTION, IDS_JOB_INTERVENTION, L"Waiting at the printer" },
+        { JOB_STATUS_OFFLINE,           IDS_JOB_OFFLINE,      L"Printer offline" },
+        { JOB_STATUS_BLOCKED_DEVQ,      IDS_JOB_BLOCKED,      L"Blocked" },
+        { JOB_STATUS_DELETING,          IDS_JOB_DELETING,     L"Deleting" },
+        { JOB_STATUS_PAUSED,            IDS_JOB_PAUSED,       L"Paused" },
+        { JOB_STATUS_PRINTING,          IDS_JOB_PRINTING,     L"Printing" },
+        { JOB_STATUS_PRINTED,           IDS_JOB_PRINTED,      L"Printed" },
+        { JOB_STATUS_SPOOLING,          IDS_JOB_SPOOLING,     L"Spooling" },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(states); i++)
+    {
+        if (!(job->Status & states[i].flag)) continue;
+        load_string( states[i].id, buf, len, states[i].text );
+        return;
+    }
+
+    if (job->pStatus && job->pStatus[0]) lstrcpynW( buf, job->pStatus, len );
+    else load_string( IDS_JOB_QUEUED, buf, len, L"In queue" );
+}
+
+static void fill_list( struct queue_window *qw )
+{
+    DWORD needed = 0, count = 0, i, sel;
+    JOB_INFO_2W *jobs = NULL;
+    HANDLE printer = NULL;
+    WCHAR buf[128];
+    LVITEMW item;
+
+    sel = SendMessageW( qw->list, LVM_GETNEXTITEM, -1, LVNI_SELECTED );
+
+    if (!OpenPrinterW( qw->printer, &printer, NULL )) goto done;
+    EnumJobsW( printer, 0, 0xffffffff, 2, NULL, 0, &needed, &count );
+    if (needed && (jobs = HeapAlloc( GetProcessHeap(), 0, needed )))
+    {
+        if (!EnumJobsW( printer, 0, 0xffffffff, 2, (BYTE *)jobs, needed, &needed, &count ))
+            count = 0;
+    }
+
+done:
+    SendMessageW( qw->list, LVM_DELETEALLITEMS, 0, 0 );
+
+    for (i = 0; i < count; i++)
+    {
+        memset( &item, 0, sizeof(item) );
+        item.mask = LVIF_TEXT | LVIF_PARAM;
+        item.iItem = i;
+        item.lParam = jobs[i].JobId;
+        item.pszText = jobs[i].pDocument && jobs[i].pDocument[0] ? jobs[i].pDocument : (WCHAR *)L"";
+        SendMessageW( qw->list, LVM_INSERTITEMW, 0, (LPARAM)&item );
+
+        status_text( &jobs[i], buf, ARRAY_SIZE(buf) );
+        item.mask = LVIF_TEXT;
+        item.iSubItem = 1;
+        item.pszText = buf;
+        SendMessageW( qw->list, LVM_SETITEMW, 0, (LPARAM)&item );
+
+        item.iSubItem = 2;
+        item.pszText = jobs[i].pUserName ? jobs[i].pUserName : (WCHAR *)L"";
+        SendMessageW( qw->list, LVM_SETITEMW, 0, (LPARAM)&item );
+
+        if (jobs[i].TotalPages)
+            swprintf( buf, ARRAY_SIZE(buf), L"%lu/%lu", jobs[i].PagesPrinted, jobs[i].TotalPages );
+        else
+            swprintf( buf, ARRAY_SIZE(buf), L"%lu", jobs[i].PagesPrinted );
+        item.iSubItem = 3;
+        item.pszText = buf;
+        SendMessageW( qw->list, LVM_SETITEMW, 0, (LPARAM)&item );
+
+        swprintf( buf, ARRAY_SIZE(buf), L"%lu KB", (jobs[i].Size + 1023) / 1024 );
+        item.iSubItem = 4;
+        item.pszText = buf;
+        SendMessageW( qw->list, LVM_SETITEMW, 0, (LPARAM)&item );
+    }
+
+    if (sel != (DWORD)-1 && sel < count)
+    {
+        memset( &item, 0, sizeof(item) );
+        item.mask = LVIF_STATE;
+        item.stateMask = LVIS_SELECTED | LVIS_FOCUSED;
+        item.state = LVIS_SELECTED | LVIS_FOCUSED;
+        SendMessageW( qw->list, LVM_SETITEMSTATE, sel, (LPARAM)&item );
+    }
+
+    HeapFree( GetProcessHeap(), 0, jobs );
+    if (printer) ClosePrinter( printer );
+}
+
+static void command_selected_job( struct queue_window *qw, DWORD command )
+{
+    DWORD sel = SendMessageW( qw->list, LVM_GETNEXTITEM, -1, LVNI_SELECTED );
+    HANDLE printer;
+    LVITEMW item;
+
+    if (sel == (DWORD)-1) return;
+
+    memset( &item, 0, sizeof(item) );
+    item.mask = LVIF_PARAM;
+    item.iItem = sel;
+    if (!SendMessageW( qw->list, LVM_GETITEMW, 0, (LPARAM)&item )) return;
+
+    if (!OpenPrinterW( qw->printer, &printer, NULL )) return;
+    SetJobW( printer, item.lParam, 0, NULL, command );
+    ClosePrinter( printer );
+
+    fill_list( qw );
+}
+
+static void show_job_menu( struct queue_window *qw, int x, int y )
+{
+    WCHAR pause[64], resume[64], cancel[64];
+    HMENU menu;
+
+    if (SendMessageW( qw->list, LVM_GETNEXTITEM, -1, LVNI_SELECTED ) == (DWORD)-1) return;
+    if (!(menu = CreatePopupMenu())) return;
+
+    load_string( IDS_MENU_PAUSE, pause, ARRAY_SIZE(pause), L"Pause" );
+    load_string( IDS_MENU_RESUME, resume, ARRAY_SIZE(resume), L"Resume" );
+    load_string( IDS_MENU_CANCEL, cancel, ARRAY_SIZE(cancel), L"Cancel" );
+    AppendMenuW( menu, MF_STRING, IDM_JOB_PAUSE, pause );
+    AppendMenuW( menu, MF_STRING, IDM_JOB_RESUME, resume );
+    AppendMenuW( menu, MF_SEPARATOR, 0, NULL );
+    AppendMenuW( menu, MF_STRING, IDM_JOB_CANCEL, cancel );
+
+    TrackPopupMenu( menu, TPM_LEFTALIGN | TPM_RIGHTBUTTON, x, y, 0,
+                    GetParent( qw->list ), NULL );
+    DestroyMenu( menu );
+}
+
+static LRESULT CALLBACK queue_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    struct queue_window *qw = (void *)GetWindowLongPtrW( hwnd, GWLP_USERDATA );
+
+    switch (msg)
+    {
+    case WM_CREATE:
+    {
+        static const UINT columns[] = { IDS_COL_DOCUMENT, IDS_COL_STATUS, IDS_COL_OWNER,
+                                        IDS_COL_PAGES, IDS_COL_SIZE };
+        static const WCHAR *fallback[] = { L"Document", L"Status", L"Owner", L"Pages", L"Size" };
+        static const int widths[] = { 260, 150, 110, 80, 90 };
+        CREATESTRUCTW *cs = (CREATESTRUCTW *)lparam;
+        WCHAR text[64];
+        LVCOLUMNW col;
+        unsigned int i;
+
+        qw = cs->lpCreateParams;
+        SetWindowLongPtrW( hwnd, GWLP_USERDATA, (LONG_PTR)qw );
+
+        qw->list = CreateWindowExW( 0, WC_LISTVIEWW, NULL,
+                                    WS_CHILD | WS_VISIBLE | LVS_REPORT | LVS_SINGLESEL |
+                                    LVS_SHOWSELALWAYS, 0, 0, 0, 0, hwnd, NULL,
+                                    queue_instance, NULL );
+        if (!qw->list) return -1;
+        SendMessageW( qw->list, LVM_SETEXTENDEDLISTVIEWSTYLE, 0, LVS_EX_FULLROWSELECT );
+
+        memset( &col, 0, sizeof(col) );
+        col.mask = LVCF_TEXT | LVCF_WIDTH;
+        for (i = 0; i < ARRAY_SIZE(columns); i++)
+        {
+            load_string( columns[i], text, ARRAY_SIZE(text), fallback[i] );
+            col.pszText = text;
+            col.cx = widths[i];
+            SendMessageW( qw->list, LVM_INSERTCOLUMNW, i, (LPARAM)&col );
+        }
+
+        fill_list( qw );
+        SetTimer( hwnd, QUEUE_REFRESH_TIMER, QUEUE_REFRESH_MS, NULL );
+        return 0;
+    }
+
+    case WM_SIZE:
+        if (qw) MoveWindow( qw->list, 0, 0, LOWORD(lparam), HIWORD(lparam), TRUE );
+        return 0;
+
+    case WM_TIMER:
+        if (wparam == QUEUE_REFRESH_TIMER && qw) fill_list( qw );
+        return 0;
+
+    case WM_CONTEXTMENU:
+        if (qw && (HWND)wparam == qw->list)
+        {
+            int x = (short)LOWORD(lparam), y = (short)HIWORD(lparam);
+
+            if (x == -1 && y == -1)  /* keyboard */
+            {
+                RECT r;
+                GetWindowRect( qw->list, &r );
+                x = r.left + 20;
+                y = r.top + 20;
+            }
+            show_job_menu( qw, x, y );
+        }
+        return 0;
+
+    case WM_COMMAND:
+        switch (LOWORD(wparam))
+        {
+        case IDM_JOB_PAUSE:  command_selected_job( qw, JOB_CONTROL_PAUSE ); return 0;
+        case IDM_JOB_RESUME: command_selected_job( qw, JOB_CONTROL_RESUME ); return 0;
+        case IDM_JOB_CANCEL: command_selected_job( qw, JOB_CONTROL_CANCEL ); return 0;
+        }
+        break;
+
+    case WM_DESTROY:
+        KillTimer( hwnd, QUEUE_REFRESH_TIMER );
+        PostQuitMessage( 0 );
+        return 0;
+    }
+
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static const WCHAR queue_class[] = L"PrintUIQueueWindow";
+
+static BOOL register_queue_class( void )
+{
+    WNDCLASSEXW wc = { sizeof(wc) };
+
+    if (GetClassInfoExW( queue_instance, queue_class, &wc )) return TRUE;
+
+    wc.lpfnWndProc = queue_proc;
+    wc.hInstance = queue_instance;
+    wc.hCursor = LoadCursorW( NULL, (const WCHAR *)IDC_ARROW );
+    wc.hbrBackground = (HBRUSH)(COLOR_BTNFACE + 1);
+    wc.lpszClassName = queue_class;
+    return RegisterClassExW( &wc ) != 0;
+}
+
+/* Open the queue for a printer and pump it until the user closes it.  The
+ * caller is whoever wanted to show the queue, so this blocks on purpose. */
+BOOL printui_show_queue( const WCHAR *printer, int cmd_show )
+{
+    struct queue_window qw;
+    WCHAR title[256], fmt[128];
+    INITCOMMONCONTROLSEX icc = { sizeof(icc), ICC_LISTVIEW_CLASSES };
+    HWND hwnd;
+    MSG msg;
+
+    if (!printer || !printer[0]) return FALSE;
+
+    InitCommonControlsEx( &icc );
+    if (!register_queue_class()) return FALSE;
+
+    memset( &qw, 0, sizeof(qw) );
+    lstrcpynW( qw.printer, printer, ARRAY_SIZE(qw.printer) );
+
+    load_string( IDS_QUEUE_TITLE, fmt, ARRAY_SIZE(fmt), L"%s - Print queue" );
+    swprintf( title, ARRAY_SIZE(title), fmt, printer );
+
+    hwnd = CreateWindowExW( 0, queue_class, title, WS_OVERLAPPEDWINDOW,
+                            CW_USEDEFAULT, CW_USEDEFAULT, 720, 320,
+                            NULL, NULL, queue_instance, &qw );
+    if (!hwnd) return FALSE;
+
+    ShowWindow( hwnd, cmd_show ? cmd_show : SW_SHOW );
+    UpdateWindow( hwnd );
+
+    while (GetMessageW( &msg, NULL, 0, 0 ) > 0)
+    {
+        TranslateMessage( &msg );
+        DispatchMessageW( &msg );
+    }
+    return TRUE;
+}
+
+void printui_queue_init( HINSTANCE inst )
+{
+    queue_instance = inst;
+}
