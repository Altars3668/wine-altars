@@ -210,6 +211,29 @@ static BOOL parse_rundll(context_t * cx)
     return TRUE;
 }
 
+BOOL WINAPI DllMain(HINSTANCE inst, DWORD reason, void *reserved)
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls(inst);
+        printui_queue_init(inst);
+    }
+    return TRUE;
+}
+
+/*****************************************************
+ *  vQueueCreate                 [printui.@]
+ *
+ * Show the queue for a printer: what is waiting, what is printing, and how
+ * far it has got.  Without it a job leaves nothing on screen at all, which is
+ * the one thing every other system does show.
+ */
+BOOL WINAPI vQueueCreate(const WCHAR *printer, HWND hwnd, HINSTANCE inst, int cmd_show)
+{
+    TRACE("(%s, %p, %p, %d)\n", debugstr_w(printer), hwnd, inst, cmd_show);
+    return printui_show_queue(printer, cmd_show);
+}
+
 /*****************************************************
  *  PrintUIEntryW                [printui.@]
  *  Commandline-Interface for using printui.dll with rundll32.exe
@@ -237,6 +261,21 @@ void WINAPI PrintUIEntryW(HWND hWnd, HINSTANCE hInst, LPCWSTR pCommand, DWORD nC
     if (res && cx.command) {
         switch (cx.command)
         {
+            case 'o':   /* open the queue for a printer */
+            {
+                const WCHAR *printer = cx.options[OPT_N];
+
+                if (!printer || !printer[0])
+                {
+                    WCHAR buf[MAX_PATH];
+                    DWORD len = ARRAY_SIZE(buf);
+
+                    if (GetDefaultPrinterW(buf, &len)) printui_show_queue(buf, cx.nCmdShow);
+                    else FIXME("no printer given and no default printer\n");
+                }
+                else printui_show_queue(printer, cx.nCmdShow);
+                break;
+            }
 
             default:
             {
