From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 20 Sep 2026 09:59:01 -0400
Subject: [PATCH] Show what the print queue is doing: implement EnumJobs and a
 window for it.

Printing under Wine leaves nothing on screen.  No notification, no queue, no
page counter -- the paper either appears or it does not.  Every layer that
would have shown something was missing.

EnumJobsW was a stub in winspool.drv, so nothing could list a queue at all,
and localspl registered NULL for fpEnumJobs even though it already keeps the
jobs and already serialises them one at a time for GetJob.  This fills in
fpEnumJobs for levels 1 and 2 -- the entries packed from the front, their
strings and devmode taken from the back, the way the other Enums in the
spooler lay it out -- and points EnumJobsW at the backend like GetJobW.  Job
status is what the spooler can honestly say: spooling while the job still
holds its file, printing once it has been handed to the port.
tools/jobprobe calls it around a StartDoc/EndDoc pair and sees the job appear
with its title and disappear afterwards.

printui had a stub where the queue window belongs, so there was nowhere to
show it either.  vQueueCreate and PrintUIEntry /o now open a real one:
document, status, owner, pages and size, refreshed twice a second, with
pause, resume and cancel on the selected job.  Its strings are localised, and
the states it names include the ones that matter here -- out of paper, and
waiting at the printer, which is what manual duplex looks like while the
second side sits in the manual feeder.

What it still cannot show is progress on the printer's side: once a job has
gone to CUPS it is no longer localspl's, so the window empties.  Carrying the
port's view of the job back into the spooler is the next piece.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
(cherry picked from commit 8a87dfc21b3ec773ce3c52ffeef69e9e6e17b38f)

diff --git a/dlls/localspl/provider.c b/dlls/localspl/provider.c
index e318736e09a..5159fa3f739 100644
--- a/dlls/localspl/provider.c
+++ b/dlls/localspl/provider.c
@@ -3779,6 +3779,146 @@ static BOOL WINAPI fpGetJob(HANDLE hprinter, DWORD job_id, DWORD level,
     return ret;
 }
 
+/* How far a job has got, as far as the spooler can tell.  A job still holding
+ * its file open is being written; once that is done it is waiting for, or
+ * going through, the port. */
+static DWORD job_status(const job_info_t *job)
+{
+    return job->hf ? JOB_STATUS_SPOOLING : JOB_STATUS_PRINTING;
+}
+
+static DWORD job_info_size(const printer_info_t *info, const job_info_t *job, DWORD level)
+{
+    DWORD s = level == 1 ? sizeof(JOB_INFO_1W) : sizeof(JOB_INFO_2W);
+
+    s += job->document_title ? (wcslen(job->document_title) + 1) * sizeof(WCHAR) : 0;
+    s += info->name ? (wcslen(info->name) + 1) * sizeof(WCHAR) : 0;
+    if (level == 2 && job->devmode)
+    {
+        s += (4 - (s & 3)) & 3;
+        s += job->devmode->dmSize + job->devmode->dmDriverExtra;
+    }
+    return s;
+}
+
+/* Write one entry, its strings taken from the end of the buffer working back,
+ * which is the layout every Enum in the spooler API uses. */
+static BYTE *write_job_info(const printer_info_t *info, const job_info_t *job,
+        DWORD level, BYTE *entry, BYTE *strings)
+{
+    WCHAR **doc, **printer_name;
+    DEVMODEW **devmode = NULL;
+
+    if (level == 1)
+    {
+        JOB_INFO_1W *ji = (JOB_INFO_1W *)entry;
+
+        memset(ji, 0, sizeof(*ji));
+        ji->JobId = job->id;
+        ji->Status = job_status(job);
+        doc = &ji->pDocument;
+        printer_name = &ji->pPrinterName;
+    }
+    else
+    {
+        JOB_INFO_2W *ji = (JOB_INFO_2W *)entry;
+
+        memset(ji, 0, sizeof(*ji));
+        ji->JobId = job->id;
+        ji->Status = job_status(job);
+        doc = &ji->pDocument;
+        printer_name = &ji->pPrinterName;
+        devmode = &ji->pDevMode;
+    }
+
+    if (job->document_title)
+    {
+        strings -= (wcslen(job->document_title) + 1) * sizeof(WCHAR);
+        wcscpy((WCHAR *)strings, job->document_title);
+        *doc = (WCHAR *)strings;
+    }
+    if (info->name)
+    {
+        strings -= (wcslen(info->name) + 1) * sizeof(WCHAR);
+        wcscpy((WCHAR *)strings, info->name);
+        *printer_name = (WCHAR *)strings;
+    }
+    if (devmode && job->devmode)
+    {
+        strings -= job->devmode->dmSize + job->devmode->dmDriverExtra;
+        strings = (BYTE *)((ULONG_PTR)strings & ~(ULONG_PTR)3);
+        memcpy(strings, job->devmode, job->devmode->dmSize + job->devmode->dmDriverExtra);
+        *devmode = (DEVMODEW *)strings;
+    }
+    return strings;
+}
+
+/* Nothing could list what was in the queue before this: EnumJobs was a stub
+ * all the way down, so a print job left no trace on screen anywhere. */
+static BOOL WINAPI fpEnumJobs(HANDLE hprinter, DWORD first_job, DWORD no_jobs,
+        DWORD level, BYTE *data, DWORD size, DWORD *needed, DWORD *returned)
+{
+    printer_t *printer = (printer_t *)hprinter;
+    DWORD s = 0, count = 0, index = 0;
+    BYTE *entry, *strings;
+    job_info_t *job;
+
+    TRACE("%p %ld %ld %ld %p %ld %p %p\n", hprinter, first_job, no_jobs, level,
+          data, size, needed, returned);
+
+    if (!printer || printer->header.type != HANDLE_PRINTER)
+    {
+        SetLastError(ERROR_INVALID_HANDLE);
+        return FALSE;
+    }
+    if (!needed || !returned)
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
+    if (level != 1 && level != 2)
+    {
+        FIXME("level %ld not supported\n", level);
+        SetLastError(ERROR_INVALID_LEVEL);
+        return FALSE;
+    }
+
+    EnterCriticalSection(&printer->info->jobs_cs);
+
+    LIST_FOR_EACH_ENTRY(job, &printer->info->jobs, job_info_t, entry)
+    {
+        if (index++ < first_job) continue;
+        if (count >= no_jobs) break;
+        s += job_info_size(printer->info, job, level);
+        count++;
+    }
+
+    *needed = s;
+    *returned = 0;
+
+    if (size < s)
+    {
+        LeaveCriticalSection(&printer->info->jobs_cs);
+        SetLastError(ERROR_INSUFFICIENT_BUFFER);
+        return FALSE;
+    }
+
+    entry = data;
+    strings = data + s;
+    index = 0;
+    LIST_FOR_EACH_ENTRY(job, &printer->info->jobs, job_info_t, entry)
+    {
+        if (index++ < first_job) continue;
+        if (*returned >= count) break;
+        strings = write_job_info(printer->info, job, level, entry, strings);
+        entry += level == 1 ? sizeof(JOB_INFO_1W) : sizeof(JOB_INFO_2W);
+        (*returned)++;
+    }
+
+    LeaveCriticalSection(&printer->info->jobs_cs);
+    return TRUE;
+}
+
 static BOOL WINAPI fpScheduleJob(HANDLE hprinter, DWORD job_id)
 {
     printer_t *printer = (printer_t *)hprinter;
@@ -4094,7 +4234,7 @@ static const PRINTPROVIDOR backend = {
         fpOpenPrinter,
         fpSetJob,
         fpGetJob,
-        NULL,   /* fpEnumJobs */
+        fpEnumJobs,
         NULL,   /* fpAddPrinter */
         NULL,   /* fpDeletePrinter */
         NULL,   /* fpSetPrinter */
