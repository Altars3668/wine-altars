+ */
+
+#ifndef __WINE_AMSI_UNIXLIB_H
+#define __WINE_AMSI_UNIXLIB_H
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/unixlib.h"
+
+/* What the engine concluded about the content.  There is deliberately no value
+ * for "could not scan": a call that fails returns a failing status and leaves
+ * the verdict untouched, so a scan that did not happen can never be mistaken
+ * for one that came back clean. */
+enum scan_verdict
+{
+    SCAN_VERDICT_CLEAN,
+    SCAN_VERDICT_DETECTED,
+};
+
+/* Fixed-width throughout and 64-bit fields first, so the layout is the same
+ * for 32- and 64-bit callers and the wow64 entries need no thunk. */
+struct scan_params
+{
+    UINT64 buffer;           /* in: the bytes to scan */
+    UINT32 size;             /* in */
+    UINT32 verdict;          /* out: enum scan_verdict, only on success */
+    char   detection[128];   /* out: what the engine named it, empty if clean */
+};
+
+enum amsi_funcs
+{
+    unix_probe,   /* is an engine actually there and answering */
+    unix_scan,
+    unix_funcs_count
+};
+
+#endif /* __WINE_AMSI_UNIXLIB_H */
