+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAntimalware_iface.lpVtbl = &antimalware_vtbl;
+    impl->ref = 1;
+
+    hr = IAntimalware_QueryInterface( &impl->IAntimalware_iface, iid, out );
+    IAntimalware_Release( &impl->IAntimalware_iface );
+    return hr;
+}
