+/* The COM surface callers reach AMSI through.  Office asks for it by CLSID
+ * before running a macro and treats a failure to create it as a failed scan --
+ * the macro is then refused whatever the user says, because the application
+ * cannot tell "scanned and clean" from "never scanned".  Behind it is the
+ * host's own scanner, reached over the unix side. */
+
+struct antimalware
+{
+    IAntimalware IAntimalware_iface;
+    LONG ref;
+};
+
+static struct antimalware *impl_from_IAntimalware( IAntimalware *iface )
+{
+    return CONTAINING_RECORD( iface, struct antimalware, IAntimalware_iface );
+}
+
+static HRESULT WINAPI antimalware_QueryInterface( IAntimalware *iface, REFIID iid, void **out )
+{
+    struct antimalware *impl = impl_from_IAntimalware( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IAntimalware ))
+    {
+        *out = &impl->IAntimalware_iface;
+        IAntimalware_AddRef( &impl->IAntimalware_iface );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI antimalware_AddRef( IAntimalware *iface )
+{
+    struct antimalware *impl = impl_from_IAntimalware( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI antimalware_Release( IAntimalware *iface )
+{
+    struct antimalware *impl = impl_from_IAntimalware( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref) free( impl );
+    return ref;
+}
+
+/* Pull the whole content out of the caller's stream so the engine sees exactly
+ * what the application is about to act on. */
+static HRESULT read_stream( IAmsiStream *stream, void **data, ULONG *size )
+{
+    ULONGLONG content_size = 0;
+    ULONG got = 0, offset = 0;
+    BYTE *buffer;
+    HRESULT hr;
+
+    hr = IAmsiStream_GetAttribute( stream, AMSI_ATTRIBUTE_CONTENT_SIZE,
+                                   sizeof(content_size), (BYTE *)&content_size, &got );
+    if (FAILED(hr)) return hr;
+    if (got != sizeof(content_size)) return E_UNEXPECTED;
+    if (content_size > MAX_SCAN_SIZE)
+    {
+        WARN( "content of %s bytes is too large to scan\n", wine_dbgstr_longlong(content_size) );
+        return E_OUTOFMEMORY;
+    }
+
+    if (!(buffer = malloc( content_size ? content_size : 1 ))) return E_OUTOFMEMORY;
+
+    while (offset < content_size)
+    {
+        ULONG want = content_size - offset, read = 0;
+
+        hr = IAmsiStream_Read( stream, offset, want, buffer + offset, &read );
+        if (FAILED(hr))
+        {
+            free( buffer );
+            return hr;
+        }
+        if (!read) break;   /* stream ended early; scan what it did give */
+        offset += read;
+    }
+
+    *data = buffer;
+    *size = offset;
     return S_OK;
 }
 
