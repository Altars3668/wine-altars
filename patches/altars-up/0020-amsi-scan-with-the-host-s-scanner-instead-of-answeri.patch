+    if (!valid_context( context ) || !session) return E_INVALIDARG;
+
+    if (!(ses = malloc( sizeof(*ses) ))) return E_OUTOFMEMORY;
+    ses->magic = SESSION_MAGIC;
+    *session = (HAMSISESSION)ses;
     return S_OK;
 }
 
 void WINAPI AmsiCloseSession( HAMSICONTEXT context, HAMSISESSION session )
 {
-    FIXME( "%p, %p\n", context, session );
+    struct amsi_session *ses = (struct amsi_session *)session;
+
+    TRACE( "%p, %p\n", context, session );
+
+    if (!valid_context( context ) || !magic_matches( ses, SESSION_MAGIC )) return;
+    ses->magic = 0;
+    free( ses );
