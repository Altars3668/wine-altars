+
+static HRESULT antimalware_create( REFIID iid, void **out )
+{
+    struct antimalware *impl;
+    NTSTATUS status;
+    HRESULT hr;
+
+    /* Same contract as AmsiInitialize: without an engine there is nothing to
+     * hand out, and the caller is told so instead of being given an object
+     * whose answers would mean nothing. */
+    if ((status = AMSI_CALL( probe, NULL )))
+    {
+        WARN( "no scanner available, status %#lx\n", (DWORD)status );
+        return hresult_from_scan_status( status );
+    }
