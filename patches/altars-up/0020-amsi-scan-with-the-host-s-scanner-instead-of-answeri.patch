+#define AMSI_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
+
+/* Content bigger than this is not buffered up to be scanned.  The limit is
+ * generous for anything AMSI is asked about (scripts, macro projects) and the
+ * failure is reported as a failure, never as a clean result. */
+#define MAX_SCAN_SIZE (64 * 1024 * 1024)
+
+#define CONTEXT_MAGIC 0x69736d61  /* "amsi" */
+#define SESSION_MAGIC 0x73736573  /* "sess" */
+
+struct amsi_context
+{
+    DWORD magic;
+};
+
+struct amsi_session
+{
+    DWORD magic;
+};
+
+/* A scan that could not be carried out must not look like one that came back
+ * clean, so the failure is passed on as a failure.  Callers that treat any
+ * error as "do not run this" then behave correctly, and callers that ignore
+ * the return value at least do not get a forged verdict. */
+static HRESULT hresult_from_scan_status( NTSTATUS status )
+{
+    switch (status)
+    {
+    case STATUS_NOT_SUPPORTED:     return HRESULT_FROM_WIN32( ERROR_NOT_SUPPORTED );
+    case STATUS_DEVICE_NOT_READY:  return HRESULT_FROM_WIN32( ERROR_NOT_READY );
+    case STATUS_INVALID_PARAMETER: return E_INVALIDARG;
+    default:                       return E_FAIL;
+    }
+}
+
+static HRESULT scan_bytes( const void *data, ULONG size, AMSI_RESULT *result )
+{
+    struct scan_params params;
+    NTSTATUS status;
+
+    params.buffer = (UINT_PTR)data;
+    params.size = size;
+    params.verdict = SCAN_VERDICT_DETECTED;   /* never read unless the call succeeds */
+    params.detection[0] = 0;
+
+    if ((status = AMSI_CALL( scan, &params )))
+    {
+        WARN( "scan failed, status %#lx\n", (DWORD)status );
+        return hresult_from_scan_status( status );
+    }
+
+    if (params.verdict == SCAN_VERDICT_DETECTED)
+    {
+        WARN( "content identified as %s\n", debugstr_a(params.detection) );
+        *result = AMSI_RESULT_DETECTED;
+    }
+    else *result = AMSI_RESULT_NOT_DETECTED;
+
+    return S_OK;
+}
+
+/* Asking the engine whether it is there is the whole point of initialising:
+ * an application that gets a context is entitled to believe its later scans
+ * mean something.  With nothing to scan with, say so and hand back nothing. */
 HRESULT WINAPI AmsiInitialize( const WCHAR *appname, HAMSICONTEXT *context )
 {
-    FIXME( "%s, %p\n", debugstr_w(appname), context );
-    *context = (HAMSICONTEXT)0xdeadbeef;
+    struct amsi_context *ctx;
+    NTSTATUS status;
+
+    TRACE( "%s, %p\n", debugstr_w(appname), context );
+
+    if (!appname || !context) return E_INVALIDARG;
+
+    if ((status = AMSI_CALL( probe, NULL )))
+    {
+        WARN( "no scanner available, status %#lx\n", (DWORD)status );
+        return hresult_from_scan_status( status );
+    }
+
+    if (!(ctx = malloc( sizeof(*ctx) ))) return E_OUTOFMEMORY;
+    ctx->magic = CONTEXT_MAGIC;
+    *context = (HAMSICONTEXT)ctx;
     return S_OK;
 }
 
+/* The handle came from the caller, so reading it has to survive being handed
+ * something that was never one of ours. */
+static BOOL magic_matches( const void *handle, DWORD magic )
+{
+    BOOL matches = FALSE;
+
+    if (!handle) return FALSE;
+    __TRY
+    {
+        matches = *(const DWORD *)handle == magic;
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        matches = FALSE;
+    }
+    __ENDTRY
+    return matches;
+}
+
+static BOOL valid_context( HAMSICONTEXT context )
+{
+    return magic_matches( context, CONTEXT_MAGIC );
+}
+
+void WINAPI AmsiUninitialize( HAMSICONTEXT context )
+{
+    struct amsi_context *ctx = (struct amsi_context *)context;
+
+    TRACE( "%p\n", context );
+
+    if (!valid_context( context )) return;
+    ctx->magic = 0;
+    free( ctx );
+}
+
+/* Sessions let a provider correlate several scans that belong together.  The
+ * engine behind this one looks at each buffer on its own, so the session is
+ * just a token -- but it has to be a real one the caller can hold and close. */
 HRESULT WINAPI AmsiOpenSession( HAMSICONTEXT context, HAMSISESSION *session )
 {
-    FIXME( "%p, %p\n", context, session );
-    *session = (HAMSISESSION)0xdeadbeef;
