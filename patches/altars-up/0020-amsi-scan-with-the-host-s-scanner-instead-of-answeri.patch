+static HRESULT WINAPI antimalware_Scan( IAntimalware *iface, IAmsiStream *stream,
+                                        AMSI_RESULT *result, IAntimalwareProvider **provider )
+{
+    ULONG size = 0;
+    void *data;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %p, %p\n", iface, stream, result, provider );
+
+    if (!stream || !result) return E_INVALIDARG;
+    if (provider) *provider = NULL;
+
+    if (TRACE_ON(amsi))
+    {
+        unsigned char name[256];
+        ULONG got = 0;
+
+        if (SUCCEEDED(IAmsiStream_GetAttribute( stream, AMSI_ATTRIBUTE_CONTENT_NAME,
+                                                sizeof(name), name, &got )) && got)
+            TRACE( "content name %s\n", debugstr_w((const WCHAR *)name) );
+    }
+
+    if (FAILED(hr = read_stream( stream, &data, &size ))) return hr;
+
+    hr = scan_bytes( data, size, result );
+    free( data );
+    return hr;
+}
+
+static void WINAPI antimalware_CloseSession( IAntimalware *iface, ULONGLONG session )
+{
+    TRACE( "%p, %s\n", iface, wine_dbgstr_longlong(session) );
+}
