+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <errno.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(amsi);
+
+/* clamd holds the connection open while it scans, and a large macro project
+ * can take a while on a cold cache. */
+#define REPLY_TIMEOUT_MS 60000
+#define IO_TIMEOUT_MS    15000
+
+/* clamd's own INSTREAM chunk ceiling is well above this; staying small keeps
+ * the write loop honest about partial writes. */
+#define CHUNK_SIZE (64 * 1024)
+
+static char socket_path[108];  /* fits sockaddr_un.sun_path on every target */
+
+/* Where clamd listens.  WINE_AMSI_CLAMD_SOCKET wins, so a system that keeps
+ * the socket somewhere unusual -- or a different scanner speaking the same
+ * protocol -- can be pointed at without touching the code.  Otherwise take
+ * clamd's own configuration as the source of truth, and only fall back to the
+ * paths distributions actually use. */
+static const char *find_socket(void)
+{
+    static const char *const candidates[] =
+    {
+        "/var/run/clamav/clamd.ctl",
+        "/run/clamav/clamd.ctl",
+        "/var/run/clamd.scan/clamd.sock",
+        "/run/clamd.scan/clamd.sock",
+        "/tmp/clamd.socket",
+    };
+    static const char *const configs[] =
+    {
+        "/etc/clamav/clamd.conf",
+        "/etc/clamd.d/scan.conf",
+        "/etc/clamd.conf",
+    };
+    const char *env;
+    unsigned int i;
+
+    if (socket_path[0]) return socket_path;
+
+    if ((env = getenv( "WINE_AMSI_CLAMD_SOCKET" )) && *env)
+    {
+        if (strlen( env ) >= sizeof(socket_path))
+        {
+            ERR( "WINE_AMSI_CLAMD_SOCKET is too long for a unix socket path\n" );
+            return NULL;
+        }
+        strcpy( socket_path, env );
+        return socket_path;
+    }
+
+    for (i = 0; i < ARRAYSIZE(configs); i++)
+    {
+        char line[512];
+        FILE *f = fopen( configs[i], "r" );
+
+        if (!f) continue;
+        while (fgets( line, sizeof(line), f ))
+        {
+            char *value, *end;
+
+            if (strncmp( line, "LocalSocket", 11 ) || !isspace( (unsigned char)line[11] )) continue;
+            value = line + 11;
+            while (isspace( (unsigned char)*value )) value++;
+            end = value + strlen( value );
+            while (end > value && isspace( (unsigned char)end[-1] )) end--;
+            *end = 0;
+            if (*value && (size_t)(end - value) < sizeof(socket_path))
+            {
+                strcpy( socket_path, value );
+                fclose( f );
+                return socket_path;
+            }
+        }
+        fclose( f );
+    }
+
+    for (i = 0; i < ARRAYSIZE(candidates); i++)
+    {
+        if (access( candidates[i], F_OK )) continue;
+        strcpy( socket_path, candidates[i] );
+        return socket_path;
+    }
+
+    return NULL;
+}
+
+static void set_timeout( int fd, int option, int ms )
+{
+    struct timeval tv = { .tv_sec = ms / 1000, .tv_usec = (ms % 1000) * 1000 };
+    setsockopt( fd, SOL_SOCKET, option, &tv, sizeof(tv) );
+}
+
+static int connect_engine(void)
+{
+    struct sockaddr_un addr;
+    const char *path = find_socket();
+    int fd;
+
+    if (!path) return -1;
+
+    if ((fd = socket( AF_UNIX, SOCK_STREAM, 0 )) < 0) return -1;
+
+    /* The socket stays blocking; these bound the wait so a wedged scanner
+     * cannot hang the application that asked for the scan. */
+    set_timeout( fd, SO_SNDTIMEO, IO_TIMEOUT_MS );
+    set_timeout( fd, SO_RCVTIMEO, REPLY_TIMEOUT_MS );
+
+    memset( &addr, 0, sizeof(addr) );
+    addr.sun_family = AF_UNIX;
+    strcpy( addr.sun_path, path );
+
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ))
+    {
+        close( fd );
+        return -1;
+    }
+    return fd;
+}
+
+static int write_all( int fd, const void *data, size_t size )
+{
+    const char *ptr = data;
+
+    while (size)
+    {
+        ssize_t written = write( fd, ptr, size );
+
+        if (written > 0)
+        {
+            ptr += written;
+            size -= written;
+            continue;
+        }
+        if (written < 0 && errno == EINTR) continue;
+        return 0;   /* a send timeout lands here too, and counts as a failure */
+    }
+    return 1;
+}
+
+/* Replies are NUL-terminated in the "z" command dialect. */
+static int read_reply( int fd, char *reply, size_t size )
+{
+    size_t used = 0;
+
+    for (;;)
+    {
+        ssize_t got;
+
+        got = read( fd, reply + used, size - used - 1 );
+        if (got < 0)
+        {
+            if (errno == EINTR) continue;
+            return 0;
+        }
+        if (!got) break;               /* clamd closed after answering */
+        used += got;
+        if (memchr( reply, 0, used )) break;
+        if (used + 1 >= size) return 0;
+    }
+    reply[used] = 0;
+    return used > 0;
+}
+
+static NTSTATUS probe( void *args )
+{
+    char reply[64];
+    int fd;
+
+    if ((fd = connect_engine()) < 0)
+    {
+        WARN( "no scanner reachable; AMSI will report that it cannot scan\n" );
+        return STATUS_NOT_SUPPORTED;
+    }
+
+    if (!write_all( fd, "zPING", 6 ) || !read_reply( fd, reply, sizeof(reply) ))
+    {
+        close( fd );
+        WARN( "scanner did not answer PING\n" );
+        return STATUS_DEVICE_NOT_READY;
+    }
+    close( fd );
+
+    if (strncmp( reply, "PONG", 4 ))
+    {
+        WARN( "unexpected answer to PING: %s\n", debugstr_a(reply) );
+        return STATUS_DEVICE_NOT_READY;
+    }
+    TRACE( "scanner ready at %s\n", debugstr_a(find_socket()) );
+    return STATUS_SUCCESS;
+}
+
+/* Feed the bytes to clamd over INSTREAM and report what it says.  Every
+ * failure path returns an error status without touching params->verdict --
+ * the caller must never be able to read "clean" out of a scan that did not
+ * complete. */
+static NTSTATUS scan( void *args )
+{
+    struct scan_params *params = args;
+    const char *data = (const char *)(UINT_PTR)params->buffer;
+    UINT32 offset = 0;
+    char reply[512], *found;
+    unsigned char trailer[4] = { 0 };
+    size_t len;
+    int fd;
+
+    if (!data && params->size) return STATUS_INVALID_PARAMETER;
+
+    if ((fd = connect_engine()) < 0) return STATUS_NOT_SUPPORTED;
+
+    if (!write_all( fd, "zINSTREAM", 10 ))
+    {
+        close( fd );
+        return STATUS_DEVICE_NOT_READY;
+    }
+
+    while (offset < params->size)
+    {
+        UINT32 chunk = params->size - offset;
+        unsigned char header[4];
+
+        if (chunk > CHUNK_SIZE) chunk = CHUNK_SIZE;
+        header[0] = chunk >> 24;
+        header[1] = chunk >> 16;
+        header[2] = chunk >> 8;
+        header[3] = chunk;
+
+        if (!write_all( fd, header, sizeof(header) ) || !write_all( fd, data + offset, chunk ))
+        {
+            close( fd );
+            return STATUS_DEVICE_NOT_READY;
+        }
+        offset += chunk;
+    }
+
+    /* A zero-length chunk ends the stream. */
+    if (!write_all( fd, trailer, sizeof(trailer) ) || !read_reply( fd, reply, sizeof(reply) ))
+    {
+        close( fd );
+        return STATUS_DEVICE_NOT_READY;
+    }
+    close( fd );
+
+    if ((found = strstr( reply, " FOUND" )))
+    {
+        const char *name = strchr( reply, ':' );
+
+        name = name ? name + 1 : reply;
+        while (*name == ' ') name++;
+        *found = 0;
+        len = strlen( name );
+        if (len >= sizeof(params->detection)) len = sizeof(params->detection) - 1;
+        memcpy( params->detection, name, len );
+        params->detection[len] = 0;
+        params->verdict = SCAN_VERDICT_DETECTED;
+        WARN( "scanner reported %s\n", debugstr_a(params->detection) );
+        return STATUS_SUCCESS;
+    }
+
+    if (strstr( reply, "ERROR" ))
+    {
+        /* Size limits and read errors land here.  Refusing to answer is the
+         * only honest outcome: nothing examined the content. */
+        WARN( "scanner could not scan the content: %s\n", debugstr_a(reply) );
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    if (!strstr( reply, "OK" ))
+    {
+        WARN( "unexpected answer from scanner: %s\n", debugstr_a(reply) );
+        return STATUS_UNSUCCESSFUL;
+    }
+
+    params->detection[0] = 0;
+    params->verdict = SCAN_VERDICT_CLEAN;
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    probe,
+    scan,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+/* Every field is fixed-width and the 64-bit one comes first, so a 32-bit
+ * caller hands over exactly the same layout. */
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    probe,
+    scan,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif /* _WIN64 */
