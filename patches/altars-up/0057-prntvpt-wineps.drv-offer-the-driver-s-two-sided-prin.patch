+/* The DEVMODE a ticket is applied to is the driver's own, so the result
+ * carries its private part and is as big as what DocumentProperties() gives
+ * an application: Office compares the sizes before it takes the result. */
+static DEVMODEW *get_driver_devmode(struct prn_provider *prov)
+{
+    DEVMODEW *dm;
+    LONG size;
+
+    size = DocumentPropertiesW(NULL, prov->hprn, prov->name, NULL, NULL, 0);
+    if (size <= 0) return NULL;
+    if (!(dm = malloc(size))) return NULL;
+
+    /* ticket_to_devmode() writes up to dmCollate */
+    if (DocumentPropertiesW(NULL, prov->hprn, prov->name, dm, NULL, DM_OUT_BUFFER) < 0 ||
+        dm->dmSize < FIELD_OFFSET(DEVMODEW, dmFormName) || dm->dmSize + dm->dmDriverExtra > size)
+    {
+        free(dm);
+        return NULL;
+    }
+    return dm;
+}
+
+/* keep the form name in step with the paper the ticket asks for */
+static void set_form_name(struct prn_provider *prov, DEVMODEW *dm)
+{
+    WCHAR (*names)[64] = NULL;
+    WORD *papers = NULL;
+    int count, i;
+
+    if (dm->dmSize < FIELD_OFFSET(DEVMODEW, dmFormName) + sizeof(dm->dmFormName)) return;
+
+    dm->dmFields &= ~DM_FORMNAME;
+    dm->dmFormName[0] = 0;
+
+    count = DeviceCapabilitiesW(prov->name, NULL, DC_PAPERS, NULL, NULL);
+    if (count <= 0) return;
+
+    papers = malloc(count * sizeof(*papers));
+    names = malloc(count * sizeof(*names));
+    if (papers && names &&
+        DeviceCapabilitiesW(prov->name, NULL, DC_PAPERS, (WCHAR *)papers, NULL) == count &&
+        DeviceCapabilitiesW(prov->name, NULL, DC_PAPERNAMES, (WCHAR *)names, NULL) == count)
+    {
+        for (i = 0; i < count; i++)
+        {
+            if (papers[i] != dm->dmPaperSize) continue;
+            lstrcpynW(dm->dmFormName, names[i], CCHFORMNAME);
+            dm->dmFields |= DM_FORMNAME;
+            break;
+        }
+    }
+
+    free(papers);
+    free(names);
+}
