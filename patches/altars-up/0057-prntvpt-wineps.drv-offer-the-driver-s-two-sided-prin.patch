+/* A DEVMODE may give the paper by its size alone: dmPaperSize left at 0 with
+ * dmPaperWidth and dmPaperLength set, which is how Word hands over the page
+ * size of the document.  Recognise the standard sizes, a millimetre either
+ * way. */
+static int size_to_paper(const struct size *size)
+{
+    int i;
+
+    for (i = 0 ; i < ARRAY_SIZE(psk_media); i++)
+        if (abs( psk_media[i].size.width - size->width ) <= 1000 &&
+            abs( psk_media[i].size.height - size->height ) <= 1000)
+            return psk_media[i].paper;
+
+    return 0;
+}
