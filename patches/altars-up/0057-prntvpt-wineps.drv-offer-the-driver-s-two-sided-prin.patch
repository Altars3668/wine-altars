+/* Print Schema's duplex feature and DEVMODE's dmDuplex name the same three
+ * things.  Long edge is DMDUP_VERTICAL: on a portrait page the binding runs
+ * down the long side, which is how a book turns. */
+static void read_JobDuplex(IXMLDOMDocument2 *doc, struct ticket *ticket)
+{
+    IXMLDOMNode *node, *option;
+    HRESULT hr;
+
+    hr = IXMLDOMDocument2_selectSingleNode(doc,
+            (BSTR)L"psf:PrintTicket/psf:Feature[@name='psk:JobDuplexAllDocumentsContiguously']", &node);
+    if (hr != S_OK) return;
+
+    hr = IXMLDOMNode_selectSingleNode(node, (BSTR)L"./psf:Option", &option);
+    if (hr == S_OK)
+    {
+        IXMLDOMElement *element;
+
+        hr = IXMLDOMNode_QueryInterface(option, &IID_IXMLDOMElement, (void **)&element);
+        if (hr == S_OK)
+        {
+            VARIANT var;
+
+            VariantInit(&var);
+            hr = IXMLDOMElement_getAttribute(element, (BSTR)L"name", &var);
+            if (hr == S_OK && V_VT(&var) == VT_BSTR)
+            {
+                if (!wcscmp(V_BSTR(&var), L"psk:TwoSidedLongEdge"))
+                    ticket->job.duplex = DMDUP_VERTICAL;
+                else if (!wcscmp(V_BSTR(&var), L"psk:TwoSidedShortEdge"))
+                    ticket->job.duplex = DMDUP_HORIZONTAL;
+                else if (!wcscmp(V_BSTR(&var), L"psk:OneSided"))
+                    ticket->job.duplex = DMDUP_SIMPLEX;
+                else
+                {
+                    FIXME("%s\n", wine_dbgstr_w(V_BSTR(&var)));
+                    ticket->job.duplex = DMDUP_SIMPLEX;
+                }
+                TRACE("job.duplex: %s => %d\n", wine_dbgstr_w(V_BSTR(&var)), ticket->job.duplex);
+            }
+            VariantClear(&var);
+
+            IXMLDOMElement_Release(element);
+        }
+        IXMLDOMNode_Release(option);
+    }
+
+    IXMLDOMNode_Release(node);
+}
