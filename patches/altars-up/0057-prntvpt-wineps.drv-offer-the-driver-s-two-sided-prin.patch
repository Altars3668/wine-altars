+/* A pick-one feature, and an option in it nothing constrains.  Print Schema
+ * requires a feature to offer at least one option; an empty one makes the
+ * whole capabilities document invalid, and a reader that validates it -- Office
+ * does -- sets all of it aside rather than trust the part it can read. */
+static HRESULT create_PickOne_Feature(IXMLDOMElement *root, const WCHAR *name, IXMLDOMElement **feature)
+{
+    IXMLDOMElement *property;
+    HRESULT hr;
+
+    hr = create_Feature(root, name, feature);
+    if (hr != S_OK) return hr;
+
+    hr = create_Property(*feature, L"psf:SelectionType", &property);
+    if (hr == S_OK)
+    {
+        hr = write_qname_value(property, L"psk:PickOne");
+        IXMLDOMElement_Release(property);
+    }
+    if (hr != S_OK)
+    {
+        IXMLDOMElement_Release(*feature);
+        *feature = NULL;
+    }
+    return hr;
+}
+
+static HRESULT add_caps_option(IXMLDOMElement *feature, const WCHAR *name, IXMLDOMElement **out)
+{
+    IXMLDOMElement *option;
+    HRESULT hr;
+
+    hr = create_Option(feature, name, &option);
+    if (hr != S_OK) return hr;
+    hr = add_attribute(option, L"constrained", L"psk:None");
+    if (hr == S_OK && out) *out = option;
+    else IXMLDOMElement_Release(option);
+    return hr;
+}
