+
+static void rot_entry_delete(struct rot_entry *rot_entry)
+{
+    if (!rot_entry->retired) unregister(rot_entry->cookie, &rot_entry->ctxt_handle, rot_entry->object);
     HeapFree(GetProcessHeap(), 0, rot_entry->moniker_data);
     HeapFree(GetProcessHeap(), 0, rot_entry);
 }
 
+/* As Windows does, the registration of an object that was disconnected is not running any more: it leaves the
+ * system's table, and only Revoke still knows its cookie. */
+static void retire_disconnected(struct list *rot, CRITICAL_SECTION *lock)
+{
+    struct { DWORD cookie; IrotContextHandle ctxt_handle; InterfaceData *object; } retired[16];
+    struct rot_entry *rot_entry;
+    unsigned int i, count;
+
+    do
+    {
+        count = 0;
+        EnterCriticalSection(lock);
+        LIST_FOR_EACH_ENTRY(rot_entry, rot, struct rot_entry, entry)
+        {
+            if (rot_entry->retired || !rot_entry->object ||
+                    InternalIrotObjectConnected(rot_entry->object->abData, rot_entry->object->ulCntData))
+                continue;
+            retired[count].cookie = rot_entry->cookie;
+            retired[count].ctxt_handle = rot_entry->ctxt_handle;
+            retired[count].object = rot_entry->object;
+            rot_entry->object = NULL;
+            rot_entry->retired = TRUE;
+            if (++count == ARRAY_SIZE(retired)) break;
+        }
+        LeaveCriticalSection(lock);
+        for (i = 0; i < count; i++) unregister(retired[i].cookie, &retired[i].ctxt_handle, retired[i].object);
+    } while (count == ARRAY_SIZE(retired));
+}
