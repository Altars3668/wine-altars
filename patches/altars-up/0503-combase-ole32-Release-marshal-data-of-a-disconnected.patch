+/* an object that counts its references, and nothing else */
+struct ref_object
+{
+    IDropTarget IDropTarget_iface;
+    LONG refs;
+};
+
+static inline struct ref_object *impl_from_ref_object(IDropTarget *iface)
+{
+    return CONTAINING_RECORD(iface, struct ref_object, IDropTarget_iface);
+}
+
+static HRESULT WINAPI ref_object_QueryInterface(IDropTarget *iface, REFIID riid, void **obj)
+{
+    if (IsEqualIID(riid, &IID_IUnknown) || IsEqualIID(riid, &IID_IDropTarget))
+    {
+        *obj = iface;
+        IDropTarget_AddRef(iface);
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ref_object_AddRef(IDropTarget *iface)
+{
+    return InterlockedIncrement(&impl_from_ref_object(iface)->refs);
+}
+
+static ULONG WINAPI ref_object_Release(IDropTarget *iface)
+{
+    return InterlockedDecrement(&impl_from_ref_object(iface)->refs);
+}
+
+static HRESULT WINAPI ref_object_DragEnter(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ref_object_DragOver(IDropTarget *iface, DWORD keys, POINTL pt, DWORD *effect)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ref_object_DragLeave(IDropTarget *iface)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI ref_object_Drop(IDropTarget *iface, IDataObject *data, DWORD keys, POINTL pt, DWORD *effect)
+{
+    return E_NOTIMPL;
+}
+
+static const IDropTargetVtbl ref_object_vtbl =
+{
+    ref_object_QueryInterface,
+    ref_object_AddRef,
+    ref_object_Release,
+    ref_object_DragEnter,
+    ref_object_DragOver,
+    ref_object_DragLeave,
+    ref_object_Drop,
+};
+
+static void init_ref_object(struct ref_object *obj)
+{
+    obj->IDropTarget_iface.lpVtbl = &ref_object_vtbl;
+    obj->refs = 1;
+}
+
+/* releases marshal data of an object that was disconnected, or released already */
+static void test_release_marshal_data_disconnected(void)
+{
+    static const MSHLFLAGS flags[] = { MSHLFLAGS_NORMAL, MSHLFLAGS_TABLESTRONG, MSHLFLAGS_TABLEWEAK };
+    LARGE_INTEGER zero = {{0}};
+    struct ref_object obj;
+    IStream *stream;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(flags); i++)
+    {
+        winetest_push_context("flags %#x", flags[i]);
+        init_ref_object(&obj);
+        CreateStreamOnHGlobal(NULL, TRUE, &stream);
+        hr = CoMarshalInterface(stream, &IID_IUnknown, (IUnknown *)&obj.IDropTarget_iface, MSHCTX_INPROC, NULL, flags[i]);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        /* the IUnknown is the stub manager's, with no reference of its own */
+        ok(obj.refs == 2, "got %ld references\n", obj.refs);
+        hr = CoDisconnectObject((IUnknown *)&obj.IDropTarget_iface, 0);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        ok(obj.refs == 1, "got %ld references\n", obj.refs);
+
+        /* nothing is left to release, and that is no error */
+        IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+        hr = CoReleaseMarshalData(stream);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+        hr = CoReleaseMarshalData(stream);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        ok(obj.refs == 1, "got %ld references\n", obj.refs);
+        IStream_Release(stream);
+        winetest_pop_context();
+    }
+
+    /* nor is table data released twice */
+    init_ref_object(&obj);
+    CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    hr = CoMarshalInterface(stream, &IID_IDropTarget, (IUnknown *)&obj.IDropTarget_iface, MSHCTX_INPROC, NULL,
+                            MSHLFLAGS_TABLESTRONG);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(obj.refs == 4, "got %ld references\n", obj.refs);
+    IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    hr = CoReleaseMarshalData(stream);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(obj.refs == 1, "got %ld references\n", obj.refs);
+    IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    hr = CoReleaseMarshalData(stream);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(obj.refs == 1, "got %ld references\n", obj.refs);
+    IStream_Release(stream);
+}
+
