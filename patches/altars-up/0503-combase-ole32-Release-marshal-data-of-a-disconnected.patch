 {
-    if (rot_entry->cookie)
+    if (cookie)
     {
         InterfaceData *object = NULL;
         InterfaceData *moniker = NULL;
 
-        InternalIrotRevoke(rot_entry->cookie, &rot_entry->ctxt_handle, &object, &moniker);
+        InternalIrotRevoke(cookie, ctxt_handle, &object, &moniker);
         MIDL_user_free(object);
