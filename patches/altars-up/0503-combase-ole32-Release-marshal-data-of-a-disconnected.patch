+/* the registration of an object that was disconnected is not running any more, but Revoke still knows it */
+static void test_ROT_disconnected(void)
+{
+    struct test_factory factory;
+    IEnumMoniker *enum_moniker;
+    IRunningObjectTable *rot;
+    IMoniker *moniker, *found;
+    IUnknown *object;
+    FILETIME time;
+    BOOL listed;
+    DWORD cookie;
+    HRESULT hr;
+
+    test_factory_init(&factory);
+    hr = GetRunningObjectTable(0, &rot);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = CreateItemMoniker(L"!", L"wine-rot-disconnected", &moniker);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IRunningObjectTable_Register(rot, ROTFLAGS_REGISTRATIONKEEPSALIVE, (IUnknown *)&factory.IClassFactory_iface,
+                                      moniker, &cookie);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IRunningObjectTable_IsRunning(rot, moniker);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = CoDisconnectObject((IUnknown *)&factory.IClassFactory_iface, 0);
+    ok(hr == S_OK, "got %#lx\n", hr);
+
+    hr = IRunningObjectTable_IsRunning(rot, moniker);
+    ok(hr == S_FALSE, "got %#lx\n", hr);
+    object = NULL;
+    hr = IRunningObjectTable_GetObject(rot, moniker, &object);
+    ok(hr == MK_E_UNAVAILABLE, "got %#lx\n", hr);
+    ok(!object, "got %p\n", object);
+    hr = IRunningObjectTable_GetTimeOfLastChange(rot, moniker, &time);
+    ok(hr == MK_E_UNAVAILABLE, "got %#lx\n", hr);
+    listed = FALSE;
+    hr = IRunningObjectTable_EnumRunning(rot, &enum_moniker);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    while (IEnumMoniker_Next(enum_moniker, 1, &found, NULL) == S_OK)
+    {
+        if (IMoniker_IsEqual(found, moniker) == S_OK) listed = TRUE;
+        IMoniker_Release(found);
+    }
+    IEnumMoniker_Release(enum_moniker);
+    ok(!listed, "the moniker is listed\n");
+
+    hr = IRunningObjectTable_Revoke(rot, cookie);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IRunningObjectTable_Revoke(rot, cookie);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+
+    IMoniker_Release(moniker);
+    IRunningObjectTable_Release(rot);
+}
