+/***********************************************************************
+ *           InternalIrotObjectConnected (combase.@)
+ *
+ * For ole32's running object table: whether the object of standard marshal data made in this process is still
+ * there and not disconnected.  Windows' table hides the registrations of objects that are not.
+ */
+BOOL WINAPI InternalIrotObjectConnected(const void *data, ULONG size)
+{
+    const OBJREF *objref = data;
+    struct stub_manager *stubmgr;
+    struct apartment *apt;
+    BOOL ret = FALSE;
+
+    if (size < FIELD_OFFSET(OBJREF, u_objref.u_standard.saResAddr) || objref->signature != OBJREF_SIGNATURE ||
+            !(objref->flags & OBJREF_STANDARD))
+        return TRUE;
+
+    if ((apt = apartment_findfromoxid(objref->u_objref.u_standard.std.oxid)))
+    {
+        if ((stubmgr = get_stub_manager(apt, objref->u_objref.u_standard.std.oid)))
+        {
+            ret = !stubmgr->disconnected;
+            stub_manager_int_release(stubmgr);
+        }
+        apartment_release(apt);
+    }
+    return ret;
+}
+
 HRESULT WINAPI InternalCoStdMarshalObject(REFIID riid, DWORD dest_context, void *dest_context_data, void **ppvObject)
 {
     return StdMarshalImpl_Construct(riid, dest_context, dest_context_data, ppvObject);
