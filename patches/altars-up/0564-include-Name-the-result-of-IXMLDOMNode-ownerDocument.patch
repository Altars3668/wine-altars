From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 11:50:26 -0400
Subject: [PATCH] include: Name the result of IXMLDOMNode::ownerDocument
 XMLDOMDocument, as the SDK does.

A type library keeps one spelling of each name whatever its case, the
first one it meets, and "domDocument" here came before the coclass
DOMDocument: msxml3's type library then named that coclass
"domDocument", where Windows' says "DOMDocument" (IProvideClassInfo of
a document hands it out).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/include/msxml2.idl b/include/msxml2.idl
index 85bb6a5b0cb..7dae19ee40e 100644
--- a/include/msxml2.idl
+++ b/include/msxml2.idl
@@ -416,7 +416,7 @@ interface IXMLDOMNode : IDispatch
         [retval, out] VARIANT_BOOL *pbool);
 
     [propget, id(DISPID_DOM_NODE_OWNERDOC)]
-    HRESULT ownerDocument([retval, out] IXMLDOMDocument **domDocument);
+    HRESULT ownerDocument([retval, out] IXMLDOMDocument **XMLDOMDocument);
 
     [id(DISPID_DOM_NODE_CLONENODE)]
     HRESULT cloneNode(
diff --git a/include/msxml6.idl b/include/msxml6.idl
index ead87be7516..9955d078dc1 100644
--- a/include/msxml6.idl
+++ b/include/msxml6.idl
@@ -371,7 +371,7 @@ interface IXMLDOMNode : IDispatch
         [retval, out] VARIANT_BOOL *pbool);
 
     [propget, id(DISPID_DOM_NODE_OWNERDOC)]
-    HRESULT ownerDocument([retval, out] IXMLDOMDocument **domDocument);
+    HRESULT ownerDocument([retval, out] IXMLDOMDocument **XMLDOMDocument);
 
     [id(DISPID_DOM_NODE_CLONENODE)]
     HRESULT cloneNode(
