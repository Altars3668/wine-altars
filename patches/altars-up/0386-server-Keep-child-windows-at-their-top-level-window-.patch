From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 22:35:16 -0400
Subject: [PATCH] server: Keep child windows at their top-level window's DPI.

A child window copied its parent's monitor DPI when it was created or reparented, and never again:
once its top-level window went to a monitor with another DPI, or the monitor's DPI changed,
GetDpiForWindow() on the children still returned the old DPI while the top-level returned the new
one, and Word laid its ribbon and task panes out for 192 DPI in a frame at 96.  On Windows the
children of a per-monitor aware window have its DPI.

Update the whole tree when a top-level window's DPI changes, the moved window's own children too
when it is reparented, and the top-level windows' DPI as soon as the monitors change, so that a
window has its new DPI by the time it is told about it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/server/user.h b/server/user.h
index 88517e7f90c..7df1ca3c978 100644
--- a/server/user.h
+++ b/server/user.h
@@ -185,6 +185,7 @@ extern struct thread *window_thread_from_point( user_handle_t scope, int x, int
 extern user_handle_t find_window_to_repaint( user_handle_t parent, struct thread *thread );
 extern struct window_class *get_window_class( user_handle_t window );
 extern void set_window_rect_visible( user_handle_t window, struct rectangle rect );
+extern void update_desktop_monitor_dpi( struct desktop *desktop );
 
 /* window class functions */
 
diff --git a/server/window.c b/server/window.c
index 3cd82b0c3fd..75744ef8401 100644
--- a/server/window.c
+++ b/server/window.c
@@ -382,18 +382,42 @@ static int link_window( struct window *win, struct window *previous )
     return old_prev != win->entry.prev;
 }
 
-static void set_window_monitor_dpi( struct window *win )
+/* set the monitor DPI of a window and of all its children: a child has its top-level's */
+static void set_window_tree_dpi( struct window *win, struct ratio dpi, struct ratio raw_dpi )
 {
-    struct monitor_info *info;
-
-    if (!(info = get_monitor_from_rect( win->desktop->winstation, &win->window_rect, 0 ))) return;
+    struct window *child;
 
     SHARED_WRITE_BEGIN( win->shared, window_shm_t )
     {
-        shared->dpi     = info->dpi;
-        shared->raw_dpi = info->raw_dpi;
+        shared->dpi     = dpi;
+        shared->raw_dpi = raw_dpi;
     }
     SHARED_WRITE_END;
+
+    LIST_FOR_EACH_ENTRY( child, &win->children, struct window, entry )
+        set_window_tree_dpi( child, dpi, raw_dpi );
+}
+
+static void set_window_monitor_dpi( struct window *win )
+{
+    const window_shm_t *shared = win->shared;
+    struct monitor_info *info;
+
+    if (!(info = get_monitor_from_rect( win->desktop->winstation, &win->window_rect, 0 ))) return;
+    if (shared->dpi.num == info->dpi.num && shared->dpi.den == info->dpi.den &&
+        shared->raw_dpi.num == info->raw_dpi.num && shared->raw_dpi.den == info->raw_dpi.den) return;
+
+    set_window_tree_dpi( win, info->dpi, info->raw_dpi );
+}
+
+/* the monitors changed: the top-level windows take the DPI of the monitor they are on now */
+void update_desktop_monitor_dpi( struct desktop *desktop )
+{
+    struct window *win;
+
+    if (!desktop->top_window) return;
+    LIST_FOR_EACH_ENTRY( win, &desktop->top_window->children, struct window, entry )
+        set_window_monitor_dpi( win );
 }
 
 /* attach or detach the parent window thread input if necessary */
@@ -432,12 +456,7 @@ static int set_parent_window( struct window *win, struct window *parent )
         link_window( win, WINPTR_TOP );
 
         if (is_desktop_window( parent )) set_window_monitor_dpi( win );
-        else SHARED_WRITE_BEGIN( win->shared, window_shm_t )
-        {
-            shared->dpi         = parent->shared->dpi;
-            shared->raw_dpi     = parent->shared->raw_dpi;
-        }
-        SHARED_WRITE_END;
+        else set_window_tree_dpi( win, parent->shared->dpi, parent->shared->raw_dpi );
 
         if (win->paint_flags & (PAINT_HAS_PIXEL_FORMAT | PAINT_PIXEL_FORMAT_CHILD))
             update_pixel_format_flags( win );
diff --git a/server/winstation.c b/server/winstation.c
index 01049e58478..0554adfbacd 100644
--- a/server/winstation.c
+++ b/server/winstation.c
@@ -781,6 +781,10 @@ DECL_HANDLER(set_winstation_monitors)
     if (size && (winstation->monitors = memdup( get_req_data(), size )))
         winstation->monitor_count = size / sizeof(*winstation->monitors);
 
+    /* a window's DPI is that of the monitor it is on, which may just have changed */
+    LIST_FOR_EACH_ENTRY(desktop, &winstation->desktops, struct desktop, entry)
+        update_desktop_monitor_dpi( desktop );
+
     reply->serial = winstation->monitor_serial;
     release_object( winstation );
 }
