From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 01:23:50 -0400
Subject: [PATCH] kernelbase: pass CreateFile2's security quality of service
 on.

CreateFile2 handed its attributes, flags, security attributes and
template to CreateFileW but not dwSecurityQosFlags, the impersonation a
pipe server is allowed, which CreateFileW takes in the high bits of its
attributes; and it reported every extended parameter block as ignored,
which Word, calling it some nine hundred times on starting, filled its
log with.  The flags now go on, and only bits that are really not
supported are reported.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 8d0a88ef1227eda0b4586b8d57495028d0340bc0)

diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index b3c6df95b81..911eda816ff 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -731,16 +731,17 @@ HANDLE WINAPI DECLSPEC_HOTPATCH CreateFile2( LPCWSTR name, DWORD access, DWORD s
     HANDLE template = params ? params->hTemplateFile : NULL;
     DWORD attributes = params ? params->dwFileAttributes : 0;
     DWORD flags = params ? params->dwFileFlags : 0;
+    /* the impersonation a pipe server gets, as the high bits of CreateFileW's attributes carry it */
+    DWORD qos = params ? params->dwSecurityQosFlags & (SECURITY_SQOS_PRESENT | SECURITY_VALID_SQOS_FLAGS) : 0;
 
-    TRACE( "%s %#lx %#lx %#lx %p", debugstr_w(name), access, sharing, creation, params );
-    if (params) FIXME( "Ignoring extended parameters %p\n", params );
+    TRACE( "%s %#lx %#lx %#lx %p\n", debugstr_w(name), access, sharing, creation, params );
 
     if (attributes & ~attributes_mask) FIXME( "unsupported attributes %#lx\n", attributes );
     if (flags & ~flags_mask) FIXME( "unsupported flags %#lx\n", flags );
     attributes &= attributes_mask;
     flags &= flags_mask;
 
-    return CreateFileW( name, access, sharing, sa, creation, flags | attributes, template );
+    return CreateFileW( name, access, sharing, sa, creation, flags | attributes | qos, template );
 }
 
 
