+static ID2D1PathGeometry *create_polyline(ID2D1Factory *factory, const D2D1_POINT_2F *points,
+        unsigned int count)
+{
+    ID2D1GeometrySink *sink;
+    ID2D1PathGeometry *path;
+    HRESULT hr;
+
+    hr = ID2D1Factory_CreatePathGeometry(factory, &path);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1PathGeometry_Open(path, &sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1GeometrySink_BeginFigure(sink, points[0], D2D1_FIGURE_BEGIN_HOLLOW);
+    ID2D1GeometrySink_AddLines(sink, points + 1, count - 1);
+    ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_OPEN);
+    hr = ID2D1GeometrySink_Close(sink);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1GeometrySink_Release(sink);
+
+    return path;
+}
+
+static void test_stroke_joins(BOOL d3d11)
+{
+    /* A right angle at (40, 10), ten wide: the miter fills the square up to (45, 5), a bevel stops at the line
+     * x - y = 35 between the corners of the two sides, a round join at the circle of five around (40, 10). */
+    static const D2D1_POINT_2F corner[] = {{10.0f, 10.0f}, {40.0f, 10.0f}, {40.0f, 40.0f}};
+    static const D2D1_POINT_2F straight[] = {{10.0f, 60.0f}, {30.0f, 60.0f}, {50.0f, 60.0f}};
+    static const struct
+    {
+        D2D1_LINE_JOIN join;
+        float miter_limit;
+        DWORD tip, edge, inside;
+    }
+    tests[] =
+    {
+        {D2D1_LINE_JOIN_MITER,          10.0f, 0xffff0000, 0xffff0000, 0xffff0000},
+        {D2D1_LINE_JOIN_BEVEL,          10.0f, 0xffffffff, 0xffffffff, 0xffff0000},
+        {D2D1_LINE_JOIN_ROUND,          10.0f, 0xffffffff, 0xffff0000, 0xffff0000},
+        /* the miter of a right angle is √2 half widths long */
+        {D2D1_LINE_JOIN_MITER_OR_BEVEL,  2.0f, 0xffff0000, 0xffff0000, 0xffff0000},
+        {D2D1_LINE_JOIN_MITER_OR_BEVEL,  1.0f, 0xffffffff, 0xffffffff, 0xffff0000},
+    };
+    D2D1_STROKE_STYLE_PROPERTIES1 desc;
+    ID2D1PathGeometry *path, *line;
+    struct d2d1_test_context ctx;
+    ID2D1SolidColorBrush *brush;
+    D2D1_COLOR_F red, white;
+    ID2D1StrokeStyle1 *style;
+    unsigned int i;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    if (!ctx.factory1)
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    set_color(&red, 1.0f, 0.0f, 0.0f, 1.0f);
+    set_color(&white, 1.0f, 1.0f, 1.0f, 1.0f);
+    hr = ID2D1DeviceContext_CreateSolidColorBrush(ctx.context, &red, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    path = create_polyline((ID2D1Factory *)ctx.factory1, corner, ARRAY_SIZE(corner));
+    line = create_polyline((ID2D1Factory *)ctx.factory1, straight, ARRAY_SIZE(straight));
+
+    memset(&desc, 0, sizeof(desc));
+    desc.dashStyle = D2D1_DASH_STYLE_SOLID;
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        winetest_push_context("Test %u", i);
+
+        desc.lineJoin = tests[i].join;
+        desc.miterLimit = tests[i].miter_limit;
+        hr = ID2D1Factory1_CreateStrokeStyle(ctx.factory1, &desc, NULL, 0, &style);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ID2D1DeviceContext_BeginDraw(ctx.context);
+        ID2D1DeviceContext_Clear(ctx.context, &white);
+        ID2D1DeviceContext_DrawGeometry(ctx.context, (ID2D1Geometry *)path, (ID2D1Brush *)brush, 10.0f,
+                (ID2D1StrokeStyle *)style);
+        ID2D1DeviceContext_DrawGeometry(ctx.context, (ID2D1Geometry *)line, (ID2D1Brush *)brush, 4.0f,
+                (ID2D1StrokeStyle *)style);
+        hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+        check_effect_pixel(&ctx, 44, 5, tests[i].tip, 0);
+        check_effect_pixel(&ctx, 42, 6, tests[i].edge, 0);
+        check_effect_pixel(&ctx, 41, 8, tests[i].inside, 0);
+        /* the sides themselves */
+        check_effect_pixel(&ctx, 25, 6, 0xffff0000, 0);
+        check_effect_pixel(&ctx, 44, 25, 0xffff0000, 0);
+        /* going straight on through a point joins nothing, and stops at the end */
+        check_effect_pixel(&ctx, 48, 60, 0xffff0000, 0);
+        check_effect_pixel(&ctx, 52, 60, 0xffffffff, 0);
+
+        ID2D1StrokeStyle1_Release(style);
+        winetest_pop_context();
+    }
+
+    ID2D1PathGeometry_Release(line);
+    ID2D1PathGeometry_Release(path);
+    ID2D1SolidColorBrush_Release(brush);
+    release_test_context(&ctx);
+}
