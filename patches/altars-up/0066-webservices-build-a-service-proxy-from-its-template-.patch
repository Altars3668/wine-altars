From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 14:21:22 -0400
Subject: [PATCH] webservices: build a service proxy from its template
 description too.

Office writes its roaming settings through a proxy made with
WsCreateServiceProxyFromTemplate.  What the service requires -- here a SOAP
1.1 envelope with transport addressing -- is in the template description,
generated from the service's metadata; the template value only adds a
buffer size.  The description was ignored, the request went out as SOAP 1.2
with WS-Addressing, and the SOAP 1.1 service answered 415 Unsupported Media
Type to every write.

As a probe measured on Windows, the channel properties of the description
and of the template value are now used together, a property given in both
fails with E_INVALIDARG even when the values agree, and the TCP binding
template works the same way.  Around it:

- a request written through a proxy is in the channel's encoding, not always
  UTF-8 text: the binary encoding goes with SOAP 1.2 only (E_INVALIDARG
  otherwise, as on Windows) and names from the static dictionary, byte for
  byte what Windows sends;
- a binary message is labelled application/soap+msbin1 (msbinsession1 for
  the session encoding), with no charset or action;
- a SOAP 1.2 message carries its action in the content type only with
  transport addressing, since with WS-Addressing it is in the envelope;
- the binary encoding reads and writes with the static dictionary, not only
  the session one.

The writer has no UTF-16 or MTOM output yet; those encodings still go out as
UTF-8 text, labelled so.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 917db3d586da95af62fa56cca8d9320ed143effa)

diff --git a/dlls/webservices/channel.c b/dlls/webservices/channel.c
index d27ffb563d1..df46eeb421e 100644
--- a/dlls/webservices/channel.c
+++ b/dlls/webservices/channel.c
@@ -1557,7 +1557,7 @@ static HRESULT send_message_bytes( struct channel *channel, WS_MESSAGE *msg )
             channel->u.http.request = NULL;
         }
         if ((hr = open_http_request( channel, &channel->u.http.request )) != S_OK) return hr;
-        if ((hr = message_insert_http_headers( msg, channel->u.http.request )) != S_OK) return hr;
+        if ((hr = message_insert_http_headers( msg, channel->u.http.request, channel->encoding )) != S_OK) return hr;
         return send_message_http( channel->u.http.request, buf.bytes, buf.length );
 
     case WS_TCP_CHANNEL_BINDING:
@@ -1691,10 +1691,8 @@ static HRESULT init_writer( struct channel *channel )
         break;
 
     case WS_ENCODING_XML_BINARY_SESSION_1:
-        bin.staticDictionary = (WS_XML_DICTIONARY *)&dict_builtin_static.dict;
-        /* fall through */
-
     case WS_ENCODING_XML_BINARY_1:
+        bin.staticDictionary = (WS_XML_DICTIONARY *)&dict_builtin_static.dict;
         encoding = &bin.encoding;
         output = &buf.output;
         break;
@@ -1939,11 +1937,11 @@ static HRESULT init_reader( struct channel *channel )
         break;
 
     case WS_ENCODING_XML_BINARY_SESSION_1:
-        bin.staticDictionary  = (WS_XML_DICTIONARY *)&dict_builtin_static.dict;
         bin.dynamicDictionary = &channel->dict_recv.dict;
         /* fall through */
 
     case WS_ENCODING_XML_BINARY_1:
+        bin.staticDictionary = (WS_XML_DICTIONARY *)&dict_builtin_static.dict;
         encoding = &bin.encoding;
 
         buf.encodedData     = channel->read_buf;
diff --git a/dlls/webservices/msg.c b/dlls/webservices/msg.c
index 1f40316b3a4..c88f1d636b4 100644
--- a/dlls/webservices/msg.c
+++ b/dlls/webservices/msg.c
@@ -1951,7 +1951,7 @@ static HRESULT insert_mapped_headers( struct msg *msg, HINTERNET req )
     return S_OK;
 }
 
-HRESULT message_insert_http_headers( WS_MESSAGE *handle, HINTERNET req )
+HRESULT message_insert_http_headers( WS_MESSAGE *handle, HINTERNET req, WS_ENCODING encoding )
 {
     struct msg *msg = (struct msg *)handle;
     HRESULT hr = E_OUTOFMEMORY;
@@ -1966,6 +1966,19 @@ HRESULT message_insert_http_headers( WS_MESSAGE *handle, HINTERNET req )
         return E_INVALIDARG;
     }
 
+    /* A binary message is labelled with its encoding alone: no charset, and no action either way. */
+    if (encoding == WS_ENCODING_XML_BINARY_1 || encoding == WS_ENCODING_XML_BINARY_SESSION_1)
+    {
+        const WCHAR *type = (encoding == WS_ENCODING_XML_BINARY_1) ? L"application/soap+msbin1" :
+                                                                      L"application/soap+msbinsession1";
+        if (!(header = build_http_header( L"Content-Type", type, &len ))) goto done;
+        if ((hr = insert_http_header( req, header, len, WINHTTP_ADDREQ_FLAG_ADD )) == S_OK)
+            hr = insert_mapped_headers( msg, req );
+        goto done;
+    }
+    /* The writer produces UTF-8 text for the other encodings, and the label has to match. */
+    if (encoding != WS_ENCODING_XML_UTF8) FIXME( "encoding %u not supported, labelling UTF-8\n", encoding );
+
     switch (msg->version_env)
     {
     case WS_ENVELOPE_VERSION_SOAP_1_1:
@@ -2018,7 +2031,9 @@ HRESULT message_insert_http_headers( WS_MESSAGE *handle, HINTERNET req )
     {
         ULONG len_action = ARRAY_SIZE( L"action=\"" ) - 1;
 
-        if (!msg->action) break;
+        /* With WS-Addressing the action is in the envelope's headers; only a message without them carries
+         * it in the content type. */
+        if (!msg->action || msg->version_addr != WS_ADDRESSING_VERSION_TRANSPORT) break;
         if (!(len = MultiByteToWideChar( CP_UTF8, 0, (char *)msg->action->bytes, msg->action->length, NULL, 0 )))
             break;
 
diff --git a/dlls/webservices/proxy.c b/dlls/webservices/proxy.c
index d00ad4ad70b..7adb09f5ea5 100644
--- a/dlls/webservices/proxy.c
+++ b/dlls/webservices/proxy.c
@@ -154,8 +154,9 @@ HRESULT WINAPI WsCreateServiceProxyFromTemplate( WS_CHANNEL_TYPE channel_type,
                                                  const void *desc, ULONG desc_size, WS_SERVICE_PROXY **handle,
                                                  WS_ERROR *error )
 {
-    const WS_CHANNEL_PROPERTY *channel_props = NULL;
-    ULONG channel_props_count = 0;
+    const WS_CHANNEL_PROPERTIES *value_props = NULL, *desc_props;
+    WS_CHANNEL_PROPERTY *channel_props;
+    ULONG channel_props_count, i, j;
     WS_CHANNEL_BINDING binding;
     WS_CHANNEL *channel;
     HRESULT hr;
@@ -165,39 +166,62 @@ HRESULT WINAPI WsCreateServiceProxyFromTemplate( WS_CHANNEL_TYPE channel_type,
     if (error) FIXME( "ignoring error parameter\n" );
 
     if (!desc || !handle) return E_INVALIDARG;
-    FIXME( "ignoring description\n" );
 
     switch (type)
     {
     case WS_HTTP_BINDING_TEMPLATE_TYPE:
     {
         WS_HTTP_BINDING_TEMPLATE *http = value;
-        if (http)
-        {
-            channel_props = http->channelProperties.properties;
-            channel_props_count = http->channelProperties.propertyCount;
-        }
+        if (http) value_props = &http->channelProperties;
+        desc_props = &((const WS_HTTP_POLICY_DESCRIPTION *)desc)->channelProperties;
         binding = WS_HTTP_CHANNEL_BINDING;
         break;
     }
     case WS_HTTP_SSL_BINDING_TEMPLATE_TYPE:
     {
         WS_HTTP_SSL_BINDING_TEMPLATE *https = value;
-        if (https)
-        {
-            channel_props = https->channelProperties.properties;
-            channel_props_count = https->channelProperties.propertyCount;
-        }
+        if (https) value_props = &https->channelProperties;
+        desc_props = &((const WS_HTTP_SSL_POLICY_DESCRIPTION *)desc)->channelProperties;
+        FIXME( "ignoring security properties\n" );
         binding = WS_HTTP_CHANNEL_BINDING;
         break;
     }
+    case WS_TCP_BINDING_TEMPLATE_TYPE:
+    {
+        WS_TCP_BINDING_TEMPLATE *tcp = value;
+        if (tcp) value_props = &tcp->channelProperties;
+        desc_props = &((const WS_TCP_POLICY_DESCRIPTION *)desc)->channelProperties;
+        binding = WS_TCP_CHANNEL_BINDING;
+        break;
+    }
     default:
         FIXME( "template type %u not implemented\n", type );
         return E_NOTIMPL;
     }
 
-    if ((hr = WsCreateChannel( channel_type, binding, channel_props, channel_props_count, NULL,
-                               &channel, NULL )) != S_OK) return hr;
+    /* The description, generated from the service's metadata, sets what the service requires -- envelope and
+     * addressing version, encoding; the template value adds the rest.  A property may come from one or the
+     * other, not both. */
+    channel_props_count = desc_props->propertyCount + (value_props ? value_props->propertyCount : 0);
+    if (!(channel_props = malloc( max( channel_props_count, 1 ) * sizeof(*channel_props) ))) return E_OUTOFMEMORY;
+    channel_props_count = 0;
+    for (i = 0; i < desc_props->propertyCount; i++) channel_props[channel_props_count++] = desc_props->properties[i];
+    for (i = 0; value_props && i < value_props->propertyCount; i++)
+    {
+        for (j = 0; j < desc_props->propertyCount; j++)
+        {
+            if (desc_props->properties[j].id == value_props->properties[i].id)
+            {
+                free( channel_props );
+                return E_INVALIDARG;
+            }
+        }
+        channel_props[channel_props_count++] = value_props->properties[i];
+    }
+
+    hr = WsCreateChannel( channel_type, binding, channel_props, channel_props_count, NULL, &channel, NULL );
+    free( channel_props );
+    if (hr != S_OK) return hr;
 
     if ((hr = create_proxy( channel, properties, count, handle )) != S_OK)
     {
@@ -408,16 +432,47 @@ static HRESULT write_message( WS_MESSAGE *msg, WS_XML_WRITER *writer, const WS_E
 {
     HRESULT hr;
     message_do_send_callback( msg );
+    /* as for a message the channel writes itself: the envelope's names come from the static dictionary */
+    if ((hr = writer_set_lookup( writer, TRUE )) != S_OK) return hr;
     if ((hr = WsWriteEnvelopeStart( msg, writer, NULL, NULL, NULL )) != S_OK) return hr;
+    if ((hr = writer_set_lookup( writer, FALSE )) != S_OK) return hr;
     if ((hr = write_input_params( writer, desc, params, count, args )) != S_OK) return hr;
     return WsWriteEnvelopeEnd( msg, NULL );
 }
 
-static HRESULT set_output( WS_XML_WRITER *writer )
+/* Write the request in the channel's encoding, as the channel will label it. */
+static HRESULT set_output( WS_XML_WRITER *writer, WS_CHANNEL *channel )
 {
     WS_XML_WRITER_TEXT_ENCODING text = { {WS_XML_WRITER_ENCODING_TYPE_TEXT}, WS_CHARSET_UTF8 };
+    WS_XML_WRITER_BINARY_ENCODING bin = { {WS_XML_WRITER_ENCODING_TYPE_BINARY} };
     WS_XML_WRITER_BUFFER_OUTPUT buf = { {WS_XML_WRITER_OUTPUT_TYPE_BUFFER} };
-    return WsSetOutput( writer, &text.encoding, &buf.output, NULL, 0, NULL );
+    const WS_XML_WRITER_ENCODING *encoding = &text.encoding;
+    WS_ENVELOPE_VERSION env_version;
+    WS_ENCODING enc;
+    HRESULT hr;
+
+    if ((hr = WsGetChannelProperty( channel, WS_CHANNEL_PROPERTY_ENCODING, &enc, sizeof(enc), NULL )) != S_OK ||
+        (hr = WsGetChannelProperty( channel, WS_CHANNEL_PROPERTY_ENVELOPE_VERSION, &env_version,
+                                    sizeof(env_version), NULL )) != S_OK) return hr;
+
+    switch (enc)
+    {
+    case WS_ENCODING_XML_UTF8:
+        break;
+
+    case WS_ENCODING_XML_BINARY_1:
+    case WS_ENCODING_XML_BINARY_SESSION_1:
+        /* the binary encoding only goes with SOAP 1.2 */
+        if (env_version != WS_ENVELOPE_VERSION_SOAP_1_2) return E_INVALIDARG;
+        bin.staticDictionary = (WS_XML_DICTIONARY *)&dict_builtin_static.dict;
+        encoding = &bin.encoding;
+        break;
+
+    default:
+        FIXME( "encoding %u not supported, writing UTF-8\n", enc );
+        break;
+    }
+    return WsSetOutput( writer, encoding, &buf.output, NULL, 0, NULL );
 }
 
 static HRESULT send_message( WS_CHANNEL *channel, WS_MESSAGE *msg, WS_MESSAGE_DESCRIPTION *desc,
@@ -429,7 +484,7 @@ static HRESULT send_message( WS_CHANNEL *channel, WS_MESSAGE *msg, WS_MESSAGE_DE
     if ((hr = channel_address_message( channel, msg )) != S_OK) return hr;
     if ((hr = message_set_action( msg, desc->action )) != S_OK) return hr;
     if ((hr = WsCreateWriter( NULL, 0, &writer, NULL )) != S_OK) return hr;
-    if ((hr = set_output( writer )) != S_OK) goto done;
+    if ((hr = set_output( writer, channel )) != S_OK) goto done;
     if ((hr = write_message( msg, writer, desc->bodyElementDescription, params, count, args )) != S_OK) goto done;
     hr = channel_send_message( channel, msg );
 
diff --git a/dlls/webservices/tests/proxy.c b/dlls/webservices/tests/proxy.c
index 89046acd859..8a736a1a588 100644
--- a/dlls/webservices/tests/proxy.c
+++ b/dlls/webservices/tests/proxy.c
@@ -796,6 +796,126 @@ static void test_inout_params( int port )
     WsFreeHeap( heap );
 }
 
+static const char req_test6[] =
+    "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body>"
+    "<req_test6 xmlns=\"ns\"><val>1</val></req_test6>"
+    "</s:Body></s:Envelope>";
+
+static const char resp_test6[] =
+    "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body>"
+    "<resp_test6 xmlns=\"ns\"><val>2</val></resp_test6>"
+    "</s:Body></s:Envelope>";
+
+static void test_template_description( int port )
+{
+    WS_XML_STRING req = {3, (BYTE *)"req"};
+    WS_XML_STRING resp = {4, (BYTE *)"resp"};
+    WS_XML_STRING req_action = {9, (BYTE *)"req_test6"};
+    WS_XML_STRING resp_action = {10, (BYTE *)"resp_test6"};
+    WS_XML_STRING req_elem = {9, (BYTE *)"req_test6"};
+    WS_XML_STRING resp_elem = {10, (BYTE *)"resp_test6"};
+    WS_XML_STRING ns = {2, (BYTE *)"ns"};
+    WS_XML_STRING val = {3, (BYTE *)"val"};
+    WS_ENVELOPE_VERSION env_version = WS_ENVELOPE_VERSION_SOAP_1_1, env_version2 = WS_ENVELOPE_VERSION_SOAP_1_2;
+    WS_ADDRESSING_VERSION addr_version = WS_ADDRESSING_VERSION_TRANSPORT;
+    WS_ENCODING encoding = WS_ENCODING_XML_UTF8;
+    ULONG max_size = 0x800000;
+    WS_CHANNEL_PROPERTY desc_props[3], value_props[1];
+    WS_HTTP_POLICY_DESCRIPTION desc;
+    WS_HTTP_BINDING_TEMPLATE value;
+    WS_SERVICE_PROXY *proxy;
+    WS_ENDPOINT_ADDRESS addr;
+    WS_FIELD_DESCRIPTION f, f2, *fields[1], *fields2[1];
+    WS_STRUCT_DESCRIPTION input_struct, output_struct;
+    WS_ELEMENT_DESCRIPTION input_elem, output_elem;
+    WS_MESSAGE_DESCRIPTION input_msg, output_msg;
+    WS_PARAMETER_DESCRIPTION param[2];
+    WS_OPERATION_DESCRIPTION op;
+    const void *args[2];
+    WS_HEAP *heap;
+    INT32 in = 1, out = 0, *out_ptr = &out;
+    WCHAR url[64];
+    HRESULT hr;
+
+    /* what the service requires comes with the description, generated from its metadata */
+    desc_props[0].id        = WS_CHANNEL_PROPERTY_ENCODING;
+    desc_props[0].value     = &encoding;
+    desc_props[0].valueSize = sizeof(encoding);
+    desc_props[1].id        = WS_CHANNEL_PROPERTY_ADDRESSING_VERSION;
+    desc_props[1].value     = &addr_version;
+    desc_props[1].valueSize = sizeof(addr_version);
+    desc_props[2].id        = WS_CHANNEL_PROPERTY_ENVELOPE_VERSION;
+    desc_props[2].value     = &env_version;
+    desc_props[2].valueSize = sizeof(env_version);
+    desc.channelProperties.properties    = desc_props;
+    desc.channelProperties.propertyCount = ARRAY_SIZE(desc_props);
+
+    value_props[0].id        = WS_CHANNEL_PROPERTY_MAX_BUFFERED_MESSAGE_SIZE;
+    value_props[0].value     = &max_size;
+    value_props[0].valueSize = sizeof(max_size);
+    value.channelProperties.properties    = value_props;
+    value.channelProperties.propertyCount = ARRAY_SIZE(value_props);
+
+    /* a property may come from the description or from the template value, not from both */
+    value_props[0].id        = WS_CHANNEL_PROPERTY_ENVELOPE_VERSION;
+    value_props[0].value     = &env_version2;
+    value_props[0].valueSize = sizeof(env_version2);
+    proxy = NULL;
+    hr = WsCreateServiceProxyFromTemplate( WS_CHANNEL_TYPE_REQUEST, NULL, 0, WS_HTTP_BINDING_TEMPLATE_TYPE,
+                                           &value, sizeof(value), &desc, sizeof(desc), &proxy, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( !proxy, "proxy set\n" );
+
+    value_props[0].value     = &env_version;
+    hr = WsCreateServiceProxyFromTemplate( WS_CHANNEL_TYPE_REQUEST, NULL, 0, WS_HTTP_BINDING_TEMPLATE_TYPE,
+                                           &value, sizeof(value), &desc, sizeof(desc), &proxy, NULL );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+
+    value_props[0].id        = WS_CHANNEL_PROPERTY_MAX_BUFFERED_MESSAGE_SIZE;
+    value_props[0].value     = &max_size;
+    value_props[0].valueSize = sizeof(max_size);
+    hr = WsCreateServiceProxyFromTemplate( WS_CHANNEL_TYPE_REQUEST, NULL, 0, WS_HTTP_BINDING_TEMPLATE_TYPE,
+                                           &value, sizeof(value), &desc, sizeof(desc), &proxy, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    memset( &addr, 0, sizeof(addr) );
+    addr.url.length = wsprintfW( url, L"http://127.0.0.1:%u", port );
+    addr.url.chars  = url;
+    hr = WsOpenServiceProxy( proxy, &addr, NULL, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    hr = WsCreateHeap( 1 << 16, 0, NULL, 0, &heap, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    set_field_desc( &f, WS_ELEMENT_FIELD_MAPPING, &val, &ns, WS_INT32_TYPE, NULL, 0, 0, 0, NULL, NULL );
+    fields[0] = &f;
+    set_struct_desc( &input_struct, sizeof(INT32), TYPE_ALIGNMENT(INT32), fields, 1, &req, &ns, 0 );
+    set_elem_desc( &input_elem, &req_elem, &ns, WS_STRUCT_TYPE, &input_struct );
+    set_msg_desc( &input_msg, &req_action, &input_elem );
+
+    set_field_desc( &f2, WS_ELEMENT_FIELD_MAPPING, &val, &ns, WS_INT32_TYPE, NULL, 0, 0, 0, NULL, NULL );
+    fields2[0] = &f2;
+    set_struct_desc( &output_struct, sizeof(INT32), TYPE_ALIGNMENT(INT32), fields2, 1, &resp, &ns, 0 );
+    set_elem_desc( &output_elem, &resp_elem, &ns, WS_STRUCT_TYPE, &output_struct );
+    set_msg_desc( &output_msg, &resp_action, &output_elem );
+
+    set_param_desc( &param[0], WS_PARAMETER_TYPE_NORMAL, 0, 0xffff );
+    set_param_desc( &param[1], WS_PARAMETER_TYPE_NORMAL, 0xffff, 0 );
+    set_op_desc( &op, &input_msg, &output_msg, 2, param );
+
+    args[0] = &in;
+    args[1] = &out_ptr;
+    /* the test server checks that the request is a SOAP 1.1 envelope without addressing headers */
+    hr = WsCall( proxy, &op, args, heap, NULL, 0, NULL, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( out == 2, "got %d\n", out );
+
+    hr = WsCloseServiceProxy( proxy, NULL, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    WsFreeServiceProxy( proxy );
+    WsFreeHeap( heap );
+}
+
 static const char req_test5[] =
     "<s:Envelope xmlns:s=\"http://schemas.xmlsoap.org/soap/envelope/\"><s:Body>"
     "<req_test5 xmlns=\"ns\"><val>1</val></req_test5>"
@@ -908,6 +1028,7 @@ tests[] =
     { "req_test3", req_test3, sizeof(req_test3)-1, status_200, resp_test3, sizeof(resp_test3)-1 },
     { "req_test4", req_test4, sizeof(req_test4)-1, status_200, resp_test4, sizeof(resp_test4)-1 },
     { "req_test5", req_test5, sizeof(req_test5)-1, status_500, resp_test5, sizeof(resp_test5)-1 },
+    { "req_test6", req_test6, sizeof(req_test6)-1, status_200, resp_test6, sizeof(resp_test6)-1 },
 };
 
 static void send_response( int c, const char *status, const char *data, unsigned int len )
@@ -1043,6 +1164,7 @@ START_TEST(proxy)
     test_empty_response( info.port );
     test_inout_params( info.port );
     test_fault_response( info.port );
+    test_template_description( info.port );
 
     test_WsSendMessage( info.port, &quit );
     WaitForSingleObject( thread, 3000 );
diff --git a/dlls/webservices/webservices_private.h b/dlls/webservices/webservices_private.h
index e4a76afb7dd..e6a2bf38f09 100644
--- a/dlls/webservices/webservices_private.h
+++ b/dlls/webservices/webservices_private.h
@@ -161,7 +161,7 @@ void message_set_send_context( WS_MESSAGE *, const WS_PROXY_MESSAGE_CALLBACK_CON
 void message_set_receive_context( WS_MESSAGE *, const WS_PROXY_MESSAGE_CALLBACK_CONTEXT * );
 void message_do_send_callback( WS_MESSAGE * );
 void message_do_receive_callback( WS_MESSAGE * );
-HRESULT message_insert_http_headers( WS_MESSAGE *, HINTERNET );
+HRESULT message_insert_http_headers( WS_MESSAGE *, HINTERNET, WS_ENCODING );
 HRESULT message_map_http_response_headers( WS_MESSAGE *, HINTERNET, const WS_HTTP_MESSAGE_MAPPING * );
 HRESULT message_read_fault( WS_MESSAGE *, WS_HEAP *, WS_ERROR * );
 
diff --git a/include/webservices.h b/include/webservices.h
index 962826091d4..d44db966234 100644
--- a/include/webservices.h
+++ b/include/webservices.h
@@ -50,6 +50,10 @@ typedef struct _WS_ENDPOINT_IDENTITY WS_ENDPOINT_IDENTITY;
 typedef struct _WS_ENUM_DESCRIPTION WS_ENUM_DESCRIPTION;
 typedef struct _WS_ENUM_VALUE WS_ENUM_VALUE;
 typedef struct _WS_HTTP_POLICY_DESCRIPTION WS_HTTP_POLICY_DESCRIPTION;
+typedef struct _WS_SSL_TRANSPORT_SECURITY_BINDING_POLICY_DESCRIPTION WS_SSL_TRANSPORT_SECURITY_BINDING_POLICY_DESCRIPTION;
+typedef struct _WS_HTTP_SSL_POLICY_DESCRIPTION WS_HTTP_SSL_POLICY_DESCRIPTION;
+typedef struct _WS_TCP_BINDING_TEMPLATE WS_TCP_BINDING_TEMPLATE;
+typedef struct _WS_TCP_POLICY_DESCRIPTION WS_TCP_POLICY_DESCRIPTION;
 typedef struct _WS_MESSAGE WS_MESSAGE;
 typedef struct _WS_MESSAGE_DESCRIPTION WS_MESSAGE_DESCRIPTION;
 typedef struct _WS_OPERATION_DESCRIPTION WS_OPERATION_DESCRIPTION;
@@ -1170,6 +1174,24 @@ struct _WS_HTTP_POLICY_DESCRIPTION {
     WS_CHANNEL_PROPERTIES channelProperties;
 };
 
+struct _WS_SSL_TRANSPORT_SECURITY_BINDING_POLICY_DESCRIPTION {
+    WS_SECURITY_BINDING_PROPERTIES securityBindingProperties;
+};
+
+struct _WS_HTTP_SSL_POLICY_DESCRIPTION {
+    WS_CHANNEL_PROPERTIES channelProperties;
+    WS_SECURITY_PROPERTIES securityProperties;
+    WS_SSL_TRANSPORT_SECURITY_BINDING_POLICY_DESCRIPTION sslTransportSecurityBinding;
+};
+
+struct _WS_TCP_BINDING_TEMPLATE {
+    WS_CHANNEL_PROPERTIES channelProperties;
+};
+
+struct _WS_TCP_POLICY_DESCRIPTION {
+    WS_CHANNEL_PROPERTIES channelProperties;
+};
+
 struct _WS_MESSAGE_DESCRIPTION {
     WS_XML_STRING *action;
     WS_ELEMENT_DESCRIPTION *bodyElementDescription;
