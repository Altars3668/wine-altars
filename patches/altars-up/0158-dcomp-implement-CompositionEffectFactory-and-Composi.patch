+ */
+
+#include <math.h>
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+/*
+ * An effect is described by a graph of IGraphicsEffects, each of them, as
+ * IGraphicsEffectD2D1Interop tells, a Direct2D effect with its properties and
+ * its sources: a source is a parameter, a brush the effect brush is given by
+ * name, or another effect.  A factory takes the graph as it is when it is made,
+ * and a brush draws it as Direct2D effects, the properties named animatable
+ * coming from the brush, where they are set and animated as "Effect.Property".
+ *
+ * On Windows the compositor compiles and draws the graph; here the compositor
+ * draws with Direct2D anyway, and the same graph is Direct2D's to draw.
+ */
+
+struct effect_property
+{
+    UINT32 index;
+    PropertyType type;
+    UINT32 size;
+    BYTE data[20 * sizeof(float)];
+};
+
+struct effect_source
+{
+    HSTRING parameter;  /* a brush, by name */
+    int node;           /* or another effect; -1 when not */
+};
+
+struct effect_node
+{
+    GUID id;
+    WCHAR *name;
+    struct effect_property *properties;
+    UINT32 property_count;
+    struct effect_source *sources;
+    UINT32 source_count;
+};
+
+struct effect_animatable
+{
+    WCHAR *name;        /* "Effect.Property" */
+    UINT32 node;
+    UINT32 index;
+    GRAPHICS_EFFECT_PROPERTY_MAPPING mapping;
+    struct value initial;
+};
+
+struct effect_factory
+{
+    struct object base;
+    ICompositionEffectFactory ICompositionEffectFactory_iface;
+    struct effect_node *nodes;      /* the first is the one the graph puts out */
+    UINT32 node_count;
+    struct effect_animatable *animatables;
+    UINT32 animatable_count;
+};
+
+static inline struct effect_factory *impl_from_effect_factory_object( struct object *object )
+{
+    return CONTAINING_RECORD( object, struct effect_factory, base );
+}
+
+static HRESULT effect_factory_query_interface( struct object *object, REFIID iid, void **out )
+{
+    struct effect_factory *factory = impl_from_effect_factory_object( object );
+
+    if (IsEqualGUID( iid, &IID_ICompositionEffectFactory )) *out = &factory->ICompositionEffectFactory_iface;
+    else return object_query_interface( object, iid, out );
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static void effect_factory_destroy( struct object *object )
+{
+    struct effect_factory *factory = impl_from_effect_factory_object( object );
+    UINT32 i, j;
+
+    for (i = 0; i < factory->node_count; i++)
+    {
+        for (j = 0; j < factory->nodes[i].source_count; j++)
+            WindowsDeleteString( factory->nodes[i].sources[j].parameter );
+        free( factory->nodes[i].sources );
+        free( factory->nodes[i].properties );
+        free( factory->nodes[i].name );
+    }
+    free( factory->nodes );
+    for (i = 0; i < factory->animatable_count; i++) free( factory->animatables[i].name );
+    free( factory->animatables );
+    free( factory );
+}
+
+static const struct object_ops effect_factory_ops =
+{
+    L"Windows.UI.Composition.CompositionEffectFactory",
+    effect_factory_query_interface,
+    effect_factory_destroy,
+};
+
+DEFINE_IINSPECTABLE( effect_factory, ICompositionEffectFactory, struct effect_factory, base.ICompositionObject_iface )
+
+static HRESULT WINAPI effect_factory_CreateBrush( ICompositionEffectFactory *iface, ICompositionEffectBrush **result )
+{
+    struct effect_factory *factory = impl_from_ICompositionEffectFactory( iface );
+    struct brush *brush;
+    HRESULT hr;
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    if (FAILED(hr = brush_create( factory->base.compositor, BRUSH_EFFECT, &brush ))) return hr;
+    if (FAILED(hr = effect_brush_init( brush, factory )))
+    {
+        ICompositionBrush_Release( &brush->ICompositionBrush_iface );
+        return hr;
+    }
+    *result = &brush->ICompositionEffectBrush_iface;
+    return S_OK;
+}
+
+/* the graph is taken whole when the factory is made, so it is loaded already */
+static HRESULT WINAPI effect_factory_get_ExtendedError( ICompositionEffectFactory *iface, HRESULT *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = S_OK;
+    return S_OK;
+}
+
+static HRESULT WINAPI effect_factory_get_LoadStatus( ICompositionEffectFactory *iface,
+                                                     CompositionEffectFactoryLoadStatus *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = CompositionEffectFactoryLoadStatus_Success;
+    return S_OK;
+}
+
+static const struct ICompositionEffectFactoryVtbl effect_factory_vtbl =
+{
+    effect_factory_QueryInterface,
+    effect_factory_AddRef,
+    effect_factory_Release,
+    /* IInspectable methods */
+    effect_factory_GetIids,
+    effect_factory_GetRuntimeClassName,
+    effect_factory_GetTrustLevel,
+    /* ICompositionEffectFactory methods */
+    effect_factory_CreateBrush,
+    effect_factory_get_ExtendedError,
+    effect_factory_get_LoadStatus,
+};
+
+/* a property as Direct2D takes it, which is what IGraphicsEffectD2D1Interop hands out */
+static BOOL effect_property_from_value( IPropertyValue *value, UINT32 index, struct effect_property *property )
+{
+    UINT32 count;
+    FLOAT *array;
+    boolean b;
+    DOUBLE d;
+    BOOL set;
+    float f;
+
+    if (FAILED(IPropertyValue_get_Type( value, &property->type ))) return FALSE;
+    property->index = index;
+    switch (property->type)
+    {
+    case PropertyType_Single:
+        if (FAILED(IPropertyValue_GetSingle( value, &f ))) return FALSE;
+        memcpy( property->data, &f, sizeof(f) );
+        property->size = sizeof(f);
+        return TRUE;
+    case PropertyType_Double:
+        if (FAILED(IPropertyValue_GetDouble( value, &d ))) return FALSE;
+        f = d;
+        memcpy( property->data, &f, sizeof(f) );
+        property->size = sizeof(f);
+        property->type = PropertyType_Single;
+        return TRUE;
+    case PropertyType_Boolean:
+        if (FAILED(IPropertyValue_GetBoolean( value, &b ))) return FALSE;
+        set = !!b;
+        memcpy( property->data, &set, sizeof(set) );
+        property->size = sizeof(set);
+        return TRUE;
+    case PropertyType_UInt32:
+        property->size = sizeof(UINT32);
+        return SUCCEEDED(IPropertyValue_GetUInt32( value, (UINT32 *)property->data ));
+    case PropertyType_Int32:
+        property->size = sizeof(INT32);
+        return SUCCEEDED(IPropertyValue_GetInt32( value, (INT32 *)property->data ));
+    case PropertyType_SingleArray:
+        if (FAILED(IPropertyValue_GetSingleArray( value, &count, &array ))) return FALSE;
+        if (count * sizeof(*array) > sizeof(property->data))
+        {
+            FIXME( "property %u has %u values.\n", index, count );
+            CoTaskMemFree( array );
+            return FALSE;
+        }
+        memcpy( property->data, array, count * sizeof(*array) );
+        property->size = count * sizeof(*array);
+        CoTaskMemFree( array );
+        return TRUE;
+    default:
+        FIXME( "property %u of type %u is not taken.\n", index, property->type );
+        return FALSE;
+    }
+}
+
+struct effect_capture
+{
+    struct effect_factory *factory;
+    IGraphicsEffectD2D1Interop **interops;  /* of each node, until the factory is made */
+};
+
+/* takes the effect a source is, and what it draws from, into the factory's nodes */
+static HRESULT effect_capture( struct effect_capture *capture, IGraphicsEffectSource *source, int depth, UINT32 *out )
+{
+    struct effect_factory *factory = capture->factory;
+    IGraphicsEffectD2D1Interop *interop, **interops;
+    ICompositionEffectSourceParameter *parameter;
+    struct effect_property *properties;
+    IGraphicsEffectSource *input;
+    UINT32 i, count, index, child;
+    struct effect_node *nodes;
+    IGraphicsEffect *effect;
+    IPropertyValue *value;
+    HSTRING name;
+    HRESULT hr;
+    GUID id;
+
+    if (depth > 32)
+    {
+        WARN( "the effects are nested too deep.\n" );
+        return E_INVALIDARG;
+    }
+    if (FAILED(IGraphicsEffectSource_QueryInterface( source, &IID_IGraphicsEffectD2D1Interop, (void **)&interop )))
+    {
+        FIXME( "source %p is neither a parameter nor a Direct2D effect.\n", source );
+        return E_INVALIDARG;
+    }
+    if (FAILED(hr = IGraphicsEffectD2D1Interop_GetEffectId( interop, &id )))
+    {
+        IGraphicsEffectD2D1Interop_Release( interop );
+        return hr;
+    }
+
+    if (!(nodes = realloc( factory->nodes, (factory->node_count + 1) * sizeof(*nodes) )) ||
+        !(interops = realloc( capture->interops, (factory->node_count + 1) * sizeof(*interops) )))
+    {
+        if (nodes) factory->nodes = nodes;
+        IGraphicsEffectD2D1Interop_Release( interop );
+        return E_OUTOFMEMORY;
+    }
+    factory->nodes = nodes;
+    capture->interops = interops;
+    index = factory->node_count++;
+    memset( &factory->nodes[index], 0, sizeof(*factory->nodes) );
+    factory->nodes[index].id = id;
+    capture->interops[index] = interop;
+
+    if (SUCCEEDED(IGraphicsEffectSource_QueryInterface( source, &IID_IGraphicsEffect, (void **)&effect )))
+    {
+        if (SUCCEEDED(IGraphicsEffect_get_Name( effect, &name )))
+        {
+            factory->nodes[index].name = wcsdup( WindowsGetStringRawBuffer( name, NULL ) );
+            WindowsDeleteString( name );
+        }
+        IGraphicsEffect_Release( effect );
+    }
+    TRACE( "effect %u: %s, %s.\n", index, debugstr_guid( &id ), debugstr_w( factory->nodes[index].name ) );
+
+    /* the properties it has values for; the others keep Direct2D's */
+    if (SUCCEEDED(IGraphicsEffectD2D1Interop_GetPropertyCount( interop, &count )) && count)
+    {
+        if (!(properties = calloc( count, sizeof(*properties) ))) return E_OUTOFMEMORY;
+        factory->nodes[index].properties = properties;
+        for (i = 0; i < count; i++)
+        {
+            if (FAILED(IGraphicsEffectD2D1Interop_GetProperty( interop, i, &value )) || !value) continue;
+            if (effect_property_from_value( value, i, &properties[factory->nodes[index].property_count] ))
+                factory->nodes[index].property_count++;
+            IPropertyValue_Release( value );
+        }
+    }
+
+    if (SUCCEEDED(IGraphicsEffectD2D1Interop_GetSourceCount( interop, &count )) && count)
+    {
+        if (!(factory->nodes[index].sources = calloc( count, sizeof(*factory->nodes[index].sources) )))
+            return E_OUTOFMEMORY;
+        factory->nodes[index].source_count = count;
+        for (i = 0; i < count; i++) factory->nodes[index].sources[i].node = -1;
+        for (i = 0; i < count; i++)
+        {
+            /* a source there is not draws nothing */
+            if (FAILED(IGraphicsEffectD2D1Interop_GetSource( interop, i, &input )) || !input) continue;
+            if (SUCCEEDED(IGraphicsEffectSource_QueryInterface( input, &IID_ICompositionEffectSourceParameter,
+                                                                (void **)&parameter )))
+            {
+                hr = ICompositionEffectSourceParameter_get_Name( parameter, &factory->nodes[index].sources[i].parameter );
+                ICompositionEffectSourceParameter_Release( parameter );
+            }
+            else if (SUCCEEDED(hr = effect_capture( capture, input, depth + 1, &child )))
+                factory->nodes[index].sources[i].node = child;
+            IGraphicsEffectSource_Release( input );
+            if (FAILED(hr)) return hr;
+        }
+    }
+
+    *out = index;
+    return S_OK;
+}
+
+static const struct effect_property *effect_node_property( const struct effect_node *node, UINT32 index )
+{
+    UINT32 i;
+
+    for (i = 0; i < node->property_count; i++)
+        if (node->properties[i].index == index) return &node->properties[i];
+    return NULL;
+}
+
+/* what an animatable property starts at, from what the graph has for it */
+static void effect_initial_value( const struct effect_property *property, GRAPHICS_EFFECT_PROPERTY_MAPPING mapping,
+                                  struct value *value )
+{
+    float f[20] = {0};
+    UINT32 count = 0;
+    Vector4 vector;
+    Color color;
+
+    if (property && (property->type == PropertyType_Single || property->type == PropertyType_SingleArray))
+    {
+        count = property->size / sizeof(float);
+        memcpy( f, property->data, property->size );
+    }
+
+    switch (mapping)
+    {
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORX:
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORY:
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORZ:
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORW:
+        value_scalar( value, f[mapping - GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORX] );
+        return;
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_RADIANS_TO_DEGREES:
+        value_scalar( value, f[0] * 3.14159265358979f / 180.0f );
+        return;
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_COLOR_TO_VECTOR3:
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_COLOR_TO_VECTOR4:
+        color.R = min( max( f[0], 0.0f ), 1.0f ) * 255.0f + 0.5f;
+        color.G = min( max( f[1], 0.0f ), 1.0f ) * 255.0f + 0.5f;
+        color.B = min( max( f[2], 0.0f ), 1.0f ) * 255.0f + 0.5f;
+        color.A = count > 3 ? min( max( f[3], 0.0f ), 1.0f ) * 255.0f + 0.5f : 255;
+        value_color( value, color );
+        return;
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_RECT_TO_VECTOR4:
+        vector.X = f[0];
+        vector.Y = f[1];
+        vector.Z = f[2] - f[0];
+        vector.W = f[3] - f[1];
+        value_vector4( value, vector );
+        return;
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_COLORMATRIX_ALPHA_MODE:
+        value_scalar( value, property && property->size == sizeof(UINT32) &&
+                      *(const UINT32 *)property->data == D2D1_COLORMATRIX_ALPHA_MODE_STRAIGHT ? 1.0f : 0.0f );
+        return;
+    default:
+        break;
+    }
+
+    if (!property)
+    {
+        value_scalar( value, 0.0f );
+        return;
+    }
+    switch (property->type)
+    {
+    case PropertyType_Boolean:
+        value_boolean( value, *(const BOOL *)property->data );
+        return;
+    case PropertyType_UInt32:
+        value_scalar( value, *(const UINT32 *)property->data );
+        return;
+    case PropertyType_Int32:
+        value_scalar( value, *(const INT32 *)property->data );
+        return;
+    default:
+        break;
+    }
+    switch (count)
+    {
+    case 2:
+        value_vector2( value, (Vector2){f[0], f[1]} );
+        return;
+    case 3:
+        value_vector3( value, (Vector3){f[0], f[1], f[2]} );
+        return;
+    case 4:
+        value_vector4( value, (Vector4){f[0], f[1], f[2], f[3]} );
+        return;
+    case 6:
+        value_matrix3x2( value, (const Matrix3x2 *)f );
+        return;
+    case 16:
+        value_matrix4x4( value, (const Matrix4x4 *)f );
+        return;
+    default:
+        value_scalar( value, f[0] );
+        return;
+    }
+}
+
+/* an "Effect.Property" the brushes may set and animate */
+static HRESULT effect_add_animatable( struct effect_capture *capture, HSTRING string )
+{
+    struct effect_factory *factory = capture->factory;
+    const WCHAR *name = WindowsGetStringRawBuffer( string, NULL ), *dot;
+    struct effect_animatable *animatables, *animatable;
+    GRAPHICS_EFFECT_PROPERTY_MAPPING mapping;
+    UINT32 i, index;
+    size_t len;
+
+    if (!name || !(dot = wcschr( name, '.' )))
+    {
+        WARN( "%s names no effect.\n", debugstr_w( name ) );
+        return E_INVALIDARG;
+    }
+    len = dot - name;
+    for (i = 0; i < factory->node_count; i++)
+    {
+        const WCHAR *effect = factory->nodes[i].name;
+        if (effect && wcslen( effect ) == len && !wcsnicmp( effect, name, len )) break;
+    }
+    if (i == factory->node_count)
+    {
+        WARN( "no effect of %s.\n", debugstr_w( name ) );
+        return E_INVALIDARG;
+    }
+    if (FAILED(IGraphicsEffectD2D1Interop_GetNamedPropertyMapping( capture->interops[i], dot + 1, &index, &mapping )))
+    {
+        WARN( "effect %u has no property %s.\n", i, debugstr_w( dot + 1 ) );
+        return E_INVALIDARG;
+    }
+
+    if (!(animatables = realloc( factory->animatables, (factory->animatable_count + 1) * sizeof(*animatables) )))
+        return E_OUTOFMEMORY;
+    factory->animatables = animatables;
+    animatable = &factory->animatables[factory->animatable_count];
+    memset( animatable, 0, sizeof(*animatable) );
+    if (!(animatable->name = wcsdup( name ))) return E_OUTOFMEMORY;
+    animatable->node = i;
+    animatable->index = index;
+    animatable->mapping = mapping;
+    effect_initial_value( effect_node_property( &factory->nodes[i], index ), mapping, &animatable->initial );
+    factory->animatable_count++;
+    TRACE( "%s is property %u of effect %u, mapping %u, starting at %s.\n", debugstr_w( name ), index, i, mapping,
+           debugstr_value( &animatable->initial ) );
+    return S_OK;
+}
+
+HRESULT effect_factory_create( struct compositor *compositor, IGraphicsEffect *effect,
+                               IIterable_HSTRING *animatable, ICompositionEffectFactory **out )
+{
+    struct effect_capture capture = {0};
+    struct effect_factory *factory;
+    IGraphicsEffectSource *source;
+    IIterator_HSTRING *names;
+    boolean valid = FALSE;
+    HSTRING name;
+    UINT32 root, i;
+    HRESULT hr;
+
+    if (!effect) return E_INVALIDARG;
+    if (!(factory = calloc( 1, sizeof(*factory) ))) return E_OUTOFMEMORY;
+    object_init( &factory->base, &effect_factory_ops, compositor );
+    factory->ICompositionEffectFactory_iface.lpVtbl = &effect_factory_vtbl;
+    capture.factory = factory;
+
+    if (FAILED(hr = IGraphicsEffect_QueryInterface( effect, &IID_IGraphicsEffectSource, (void **)&source ))) goto done;
+    hr = effect_capture( &capture, source, 0, &root );
+    IGraphicsEffectSource_Release( source );
+    if (FAILED(hr)) goto done;
+
+    if (animatable)
+    {
+        if (FAILED(hr = IIterable_HSTRING_First( animatable, &names ))) goto done;
+        for (hr = IIterator_HSTRING_get_HasCurrent( names, &valid ); SUCCEEDED(hr) && valid;
+             hr = IIterator_HSTRING_MoveNext( names, &valid ))
+        {
+            if (FAILED(hr = IIterator_HSTRING_get_Current( names, &name ))) break;
+            hr = effect_add_animatable( &capture, name );
+            WindowsDeleteString( name );
+            if (FAILED(hr)) break;
+        }
+        IIterator_HSTRING_Release( names );
+    }
+
+done:
+    for (i = 0; i < factory->node_count; i++) IGraphicsEffectD2D1Interop_Release( capture.interops[i] );
+    free( capture.interops );
+    if (FAILED(hr))
+    {
+        WARN( "failed to take effect %p, hr %#lx.\n", effect, hr );
+        ICompositionEffectFactory_Release( &factory->ICompositionEffectFactory_iface );
+        return hr;
+    }
+    *out = &factory->ICompositionEffectFactory_iface;
+    return S_OK;
+}
+
+HRESULT effect_brush_init( struct brush *brush, struct effect_factory *factory )
+{
+    UINT32 i;
+
+    if (factory->animatable_count &&
+        !(brush->effect_values = calloc( factory->animatable_count, sizeof(*brush->effect_values) )))
+        return E_OUTOFMEMORY;
+    for (i = 0; i < factory->animatable_count; i++) brush->effect_values[i] = factory->animatables[i].initial;
+    ICompositionEffectFactory_AddRef( &factory->ICompositionEffectFactory_iface );
+    brush->factory = factory;
+    return S_OK;
+}
+
+static void effect_brush_release_effects( struct brush *brush )
+{
+    UINT32 i;
+
+    if (brush->effects)
+    {
+        for (i = 0; i < brush->factory->node_count; i++)
+            if (brush->effects[i]) ID2D1Effect_Release( brush->effects[i] );
+        free( brush->effects );
+        brush->effects = NULL;
+    }
+    if (brush->effect_opacity) ID2D1Effect_Release( brush->effect_opacity );
+    brush->effect_opacity = NULL;
+    if (brush->effect_context) ID2D1DeviceContext_Release( brush->effect_context );
+    brush->effect_context = NULL;
+}
+
+void effect_brush_cleanup( struct brush *brush )
+{
+    UINT32 i;
+
+    for (i = 0; i < brush->parameter_count; i++)
+    {
+        WindowsDeleteString( brush->parameters[i].name );
+        if (brush->parameters[i].brush) ICompositionBrush_Release( &brush->parameters[i].brush->ICompositionBrush_iface );
+    }
+    free( brush->parameters );
+    if (brush->factory)
+    {
+        effect_brush_release_effects( brush );
+        ICompositionEffectFactory_Release( &brush->factory->ICompositionEffectFactory_iface );
+    }
+    free( brush->effect_values );
+}
+
+static int effect_brush_animatable( const struct brush *brush, const WCHAR *name )
+{
+    UINT32 i;
+
+    for (i = 0; i < brush->factory->animatable_count; i++)
+        if (!wcsicmp( brush->factory->animatables[i].name, name )) return i;
+    return -1;
+}
+
+/* called with the compositor locked */
+BOOL effect_brush_get_property( struct brush *brush, const WCHAR *name, struct value *value )
+{
+    int i;
+
+    if ((i = effect_brush_animatable( brush, name )) < 0) return FALSE;
+    *value = brush->effect_values[i];
+    return TRUE;
+}
+
+/* called with the compositor locked */
+BOOL effect_brush_set_property( struct brush *brush, const WCHAR *name, const struct value *value )
+{
+    struct value converted;
+    int i;
+
+    if ((i = effect_brush_animatable( brush, name )) < 0) return FALSE;
+    if (!value_convert( value, brush->effect_values[i].type, &converted )) return FALSE;
+    brush->effect_values[i] = converted;
+    return TRUE;
+}
+
+/* called with the compositor locked */
+struct brush *effect_brush_get_parameter( struct brush *brush, HSTRING name )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( name, NULL );
+    UINT32 i;
+
+    for (i = 0; i < brush->parameter_count; i++)
+        if (!wcsicmp( WindowsGetStringRawBuffer( brush->parameters[i].name, NULL ), str ))
+            return brush->parameters[i].brush;
+    return NULL;
+}
+
+/* called with the compositor locked */
+HRESULT effect_brush_set_parameter( struct brush *brush, HSTRING name, struct brush *source )
+{
+    const WCHAR *str = WindowsGetStringRawBuffer( name, NULL );
+    struct effect_parameter *parameters;
+    UINT32 i, j;
+    HRESULT hr;
+
+    if (!str || !*str) return E_INVALIDARG;
+    for (i = 0; i < brush->factory->node_count; i++)
+    {
+        for (j = 0; j < brush->factory->nodes[i].source_count; j++)
+        {
+            HSTRING parameter = brush->factory->nodes[i].sources[j].parameter;
+            if (parameter && !wcsicmp( WindowsGetStringRawBuffer( parameter, NULL ), str )) break;
+        }
+        if (j < brush->factory->nodes[i].source_count) break;
+    }
+    if (i == brush->factory->node_count) WARN( "no effect takes %s.\n", debugstr_w( str ) );
+
+    for (i = 0; i < brush->parameter_count; i++)
+        if (!wcsicmp( WindowsGetStringRawBuffer( brush->parameters[i].name, NULL ), str )) break;
+    if (i == brush->parameter_count)
+    {
+        if (!(parameters = realloc( brush->parameters, (i + 1) * sizeof(*parameters) ))) return E_OUTOFMEMORY;
+        brush->parameters = parameters;
+        if (FAILED(hr = WindowsDuplicateString( name, &parameters[i].name ))) return hr;
+        parameters[i].brush = NULL;
+        brush->parameter_count++;
+    }
+    if (source) ICompositionBrush_AddRef( &source->ICompositionBrush_iface );
+    if (brush->parameters[i].brush) ICompositionBrush_Release( &brush->parameters[i].brush->ICompositionBrush_iface );
+    brush->parameters[i].brush = source;
+    return S_OK;
+}
+
+/* a property of a Direct2D effect set from what the brush has for it, with the parts the mapping does not cover
+ * as they are */
+static void effect_set_value( ID2D1Effect *effect, UINT32 index, GRAPHICS_EFFECT_PROPERTY_MAPPING mapping,
+                              const struct value *value )
+{
+    D2D1_PROPERTY_TYPE type = ID2D1Effect_GetType( effect, index );
+    UINT32 size = ID2D1Effect_GetValueSize( effect, index ), count, n;
+    struct value scalar;
+    float f[20], s = 0.0f;
+    Vector4 vector;
+    boolean b;
+    Color color;
+
+    if (!size || size > sizeof(f) || FAILED(ID2D1Effect_GetValue( effect, index, D2D1_PROPERTY_TYPE_UNKNOWN,
+                                                                   (BYTE *)f, size )))
+    {
+        WARN( "property %u of effect %p cannot be set.\n", index, effect );
+        return;
+    }
+    count = size / sizeof(float);
+    if (value_convert( value, VALUE_SCALAR, &scalar )) value_get_scalar( &scalar, &s );
+
+    switch (mapping)
+    {
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORX:
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORY:
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORZ:
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORW:
+        if ((n = mapping - GRAPHICS_EFFECT_PROPERTY_MAPPING_VECTORX) < count) f[n] = s;
+        break;
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_RADIANS_TO_DEGREES:
+        f[0] = s * 180.0f / 3.14159265358979f;
+        break;
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_COLOR_TO_VECTOR3:
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_COLOR_TO_VECTOR4:
+        if (!value_get_color( value, &color )) return;
+        f[0] = color.R / 255.0f;
+        f[1] = color.G / 255.0f;
+        f[2] = color.B / 255.0f;
+        if (mapping == GRAPHICS_EFFECT_PROPERTY_MAPPING_COLOR_TO_VECTOR4 && count > 3) f[3] = color.A / 255.0f;
+        break;
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_RECT_TO_VECTOR4:
+        if (!value_get_vector4( value, &vector ) || count < 4) return;
+        f[0] = vector.X;
+        f[1] = vector.Y;
+        f[2] = vector.X + vector.Z;
+        f[3] = vector.Y + vector.W;
+        break;
+    case GRAPHICS_EFFECT_PROPERTY_MAPPING_COLORMATRIX_ALPHA_MODE:
+        *(UINT32 *)f = s ? D2D1_COLORMATRIX_ALPHA_MODE_STRAIGHT : D2D1_COLORMATRIX_ALPHA_MODE_PREMULTIPLIED;
+        break;
+    default:
+        switch (type)
+        {
+        case D2D1_PROPERTY_TYPE_BOOL:
+            if (value_get_boolean( value, &b )) *(BOOL *)f = b;
+            else *(BOOL *)f = s != 0.0f;
+            break;
+        case D2D1_PROPERTY_TYPE_UINT32:
+        case D2D1_PROPERTY_TYPE_ENUM:
+            *(UINT32 *)f = s;
+            break;
+        case D2D1_PROPERTY_TYPE_INT32:
+            *(INT32 *)f = s;
+            break;
+        case D2D1_PROPERTY_TYPE_FLOAT:
+            f[0] = s;
+            break;
+        default:
+            if (value_get_color( value, &color ))
+            {
+                f[0] = color.R / 255.0f;
+                f[1] = color.G / 255.0f;
+                f[2] = color.B / 255.0f;
+                if (count > 3) f[3] = color.A / 255.0f;
+            }
+            else memcpy( f, value->f, min( count, ARRAY_SIZE(value->f) ) * sizeof(float) );
+            break;
+        }
+        break;
+    }
+
+    if (FAILED(ID2D1Effect_SetValue( effect, index, D2D1_PROPERTY_TYPE_UNKNOWN, (const BYTE *)f, size )))
+        WARN( "failed to set property %u of effect %p.\n", index, effect );
+}
+
+/* the Direct2D effects of the graph, made on the context they are to be drawn with */
+static BOOL effect_brush_make_effects( struct brush *brush, ID2D1DeviceContext *context )
+{
+    struct effect_factory *factory = brush->factory;
+    const struct effect_node *node;
+    ID2D1Image *output;
+    UINT32 i, j;
+    HRESULT hr;
+
+    if (brush->effect_context == context) return !!brush->effects;
+    effect_brush_release_effects( brush );
+    ID2D1DeviceContext_AddRef( (brush->effect_context = context) );
+    if (!(brush->effects = calloc( factory->node_count, sizeof(*brush->effects) ))) return FALSE;
+
+    for (i = 0; i < factory->node_count; i++)
+    {
+        node = &factory->nodes[i];
+        if (FAILED(hr = ID2D1DeviceContext_CreateEffect( context, &node->id, &brush->effects[i] )))
+        {
+            FIXME( "effect %s is not drawn, hr %#lx.\n", debugstr_guid( &node->id ), hr );
+            effect_brush_release_effects( brush );
+            ID2D1DeviceContext_AddRef( (brush->effect_context = context) );
+            return FALSE;
+        }
+        for (j = 0; j < node->property_count; j++)
+        {
+            if (FAILED(hr = ID2D1Effect_SetValue( brush->effects[i], node->properties[j].index,
+                                                  D2D1_PROPERTY_TYPE_UNKNOWN, node->properties[j].data,
+                                                  node->properties[j].size )))
+                WARN( "failed to set property %u of effect %s, hr %#lx.\n", node->properties[j].index,
+                      debugstr_guid( &node->id ), hr );
+        }
+        if (node->source_count && ID2D1Effect_GetInputCount( brush->effects[i] ) != node->source_count &&
+            FAILED(hr = ID2D1Effect_SetInputCount( brush->effects[i], node->source_count )))
+            WARN( "effect %s takes no %u inputs, hr %#lx.\n", debugstr_guid( &node->id ), node->source_count, hr );
+    }
+
+    /* the effects some of them draw from */
+    for (i = 0; i < factory->node_count; i++)
+    {
+        node = &factory->nodes[i];
+        for (j = 0; j < node->source_count; j++)
+        {
+            if (node->sources[j].node < 0) continue;
+            ID2D1Effect_GetOutput( brush->effects[node->sources[j].node], &output );
+            ID2D1Effect_SetInput( brush->effects[i], j, output, FALSE );
+            ID2D1Image_Release( output );
+        }
+    }
+
+    return TRUE;
+}
+
+/*
+ * The effect a brush draws with on a context, its properties and sources as
+ * they are now, and with the opacity it is drawn at; the caller draws each
+ * source brush.  Called with the compositor locked.
+ */
+ID2D1Effect *effect_brush_prepare( struct brush *brush, ID2D1DeviceContext *context, float opacity,
+                                   ID2D1Image *(*draw_source)( void *data, struct brush *source ), void *data )
+{
+    struct object *properties = brush->base.properties;
+    struct effect_factory *factory = brush->factory;
+    const struct effect_animatable *animatable;
+    struct value value, set, converted;
+    const struct effect_node *node;
+    ID2D1Image *image;
+    D2D_VECTOR_4F k;
+    UINT32 i, j;
+
+    if (!effect_brush_make_effects( brush, context )) return NULL;
+
+    /* what may be animated is what it is now: set on the brush or in its property set, animations and all */
+    for (i = 0; i < factory->animatable_count; i++)
+    {
+        animatable = &factory->animatables[i];
+        value = brush->effect_values[i];
+        if (properties && properties->ops->get_property( properties, animatable->name, &set ))
+        {
+            object_animate( properties, animatable->name, &set, 0 );
+            if (value_convert( &set, value.type, &converted )) value = converted;
+        }
+        object_animate( &brush->base, animatable->name, &value, 0 );
+        effect_set_value( brush->effects[animatable->node], animatable->index, animatable->mapping, &value );
+    }
+
+    for (i = 0; i < factory->node_count; i++)
+    {
+        node = &factory->nodes[i];
+        for (j = 0; j < node->source_count; j++)
+        {
+            struct brush *source;
+
+            if (!node->sources[j].parameter) continue;
+            source = effect_brush_get_parameter( brush, node->sources[j].parameter );
+            image = source && source != brush ? draw_source( data, source ) : NULL;
+            ID2D1Effect_SetInput( brush->effects[i], j, image, FALSE );
+            if (image) ID2D1Image_Release( image );
+        }
+    }
+
+    if (opacity >= 1.0f) return brush->effects[0];
+
+    /* the whole of it, faded: opacity times what it draws */
+    if (!brush->effect_opacity &&
+        FAILED(ID2D1DeviceContext_CreateEffect( context, &CLSID_D2D1ArithmeticComposite, &brush->effect_opacity )))
+        return brush->effects[0];
+    ID2D1Effect_GetOutput( brush->effects[0], &image );
+    ID2D1Effect_SetInput( brush->effect_opacity, 0, image, FALSE );
+    ID2D1Effect_SetInput( brush->effect_opacity, 1, image, FALSE );
+    ID2D1Image_Release( image );
+    k.x = 0.0f;
+    k.y = opacity;
+    k.z = 0.0f;
+    k.w = 0.0f;
+    ID2D1Effect_SetValue( brush->effect_opacity, D2D1_ARITHMETICCOMPOSITE_PROP_COEFFICIENTS,
+                          D2D1_PROPERTY_TYPE_VECTOR4, (const BYTE *)&k, sizeof(k) );
+    return brush->effect_opacity;
+}
+
+/* lets go of what the sources were drawn into, until the next time */
+void effect_brush_unbind( struct brush *brush )
+{
+    const struct effect_node *node;
+    UINT32 i, j;
+
+    if (!brush->effects) return;
+    for (i = 0; i < brush->factory->node_count; i++)
+    {
+        node = &brush->factory->nodes[i];
+        for (j = 0; j < node->source_count; j++)
+            if (node->sources[j].parameter) ID2D1Effect_SetInput( brush->effects[i], j, NULL, FALSE );
+    }
+}
