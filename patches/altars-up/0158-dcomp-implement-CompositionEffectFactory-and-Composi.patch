+    pixels.height = ceilf( draw->size.Y );
+    if (FAILED(hr = ID2D1DeviceContext_CreateBitmap( target->sources, pixels, NULL, 0, &props, &bitmap )))
+    {
+        WARN( "failed to create a bitmap for an effect source, hr %#lx.\n", hr );
+        return NULL;
+    }
+
+    inner.context = target->sources;
+    inner.solid = NULL;
+    ID2D1DeviceContext_SetTarget( inner.context, (ID2D1Image *)bitmap );
+    ID2D1DeviceContext_SetDpi( inner.context, 96.0f, 96.0f );
+    ID2D1DeviceContext_BeginDraw( inner.context );
+    ID2D1DeviceContext_Clear( inner.context, &clear );
+    ID2D1DeviceContext_SetTransform( inner.context, &identity );
+    brush_get_state( source, &state );
+    switch (source->kind)
