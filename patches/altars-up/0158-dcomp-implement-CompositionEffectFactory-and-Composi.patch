+    if (source->kind == BRUSH_EFFECT)
+    {
+        FIXME( "an effect brush drawing from effect brush %p is not drawn.\n", source );
+        return NULL;
+    }
+    /* a context of its own, so the target's clips and state stay as they are */
+    if (!target->sources)
+    {
+        ID2D1DeviceContext_GetDevice( target->context, &device );
+        hr = ID2D1Device_CreateDeviceContext( device, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &target->sources );
+        ID2D1Device_Release( device );
+        if (FAILED(hr))
+        {
+            WARN( "failed to create a context for effect sources, hr %#lx.\n", hr );
+            target->sources = NULL;
