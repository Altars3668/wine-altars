+    if (index > 1) return E_INVALIDARG;
+    str = hstring( L"Windows.Foundation.PropertyValue" );
+    hr = RoGetActivationFactory( str, &IID_IPropertyValueStatics, (void **)&statics );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) return hr;
+    if (!index) hr = IPropertyValueStatics_CreateSingleArray( statics, 4, (FLOAT *)coefficients, &inspectable );
+    else hr = IPropertyValueStatics_CreateBoolean( statics, FALSE, &inspectable );
+    IPropertyValueStatics_Release( statics );
+    if (FAILED(hr)) return hr;
+    hr = IInspectable_QueryInterface( inspectable, &IID_IPropertyValue, (void **)value );
+    IInspectable_Release( inspectable );
+    return hr;
+}
