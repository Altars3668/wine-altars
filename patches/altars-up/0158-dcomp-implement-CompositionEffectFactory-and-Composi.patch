+static struct test_effect *create_test_effect( const WCHAR *name )
+{
+    ICompositionEffectSourceParameterFactory *factory;
+    ICompositionEffectSourceParameter *parameter;
+    struct test_effect *effect;
+    unsigned int i;
+    HSTRING str;
+    HRESULT hr;
+
+    effect = calloc( 1, sizeof(*effect) );
+    effect->IGraphicsEffect_iface.lpVtbl = &test_effect_vtbl;
+    effect->IGraphicsEffectSource_iface.lpVtbl = &test_source_vtbl;
+    effect->IGraphicsEffectD2D1Interop_iface.lpVtbl = &test_interop_vtbl;
+    effect->ref = 1;
+    effect->name = hstring( name );
+
+    str = hstring( RuntimeClass_Windows_UI_Composition_CompositionEffectSourceParameter );
+    hr = RoGetActivationFactory( str, &IID_ICompositionEffectSourceParameterFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    for (i = 0; i < ARRAY_SIZE(effect->sources); i++)
+    {
+        str = hstring( i ? L"source2" : L"source1" );
+        hr = ICompositionEffectSourceParameterFactory_Create( factory, str, &parameter );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        WindowsDeleteString( str );
+        ICompositionEffectSourceParameter_QueryInterface( parameter, &IID_IGraphicsEffectSource,
+                                                          (void **)&effect->sources[i] );
+        ICompositionEffectSourceParameter_Release( parameter );
+    }
+    ICompositionEffectSourceParameterFactory_Release( factory );
+    return effect;
+}
