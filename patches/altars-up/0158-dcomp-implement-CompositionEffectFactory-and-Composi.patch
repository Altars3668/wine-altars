+static HRESULT WINAPI names_iterator_MoveNext( IIterator_HSTRING *iface, boolean *value )
+{
+    struct names *names = impl_from_IIterator_HSTRING( iface );
+
+    if (names->index < names->count) names->index++;
+    *value = names->index < names->count;
+    return S_OK;
+}
