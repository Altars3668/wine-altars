+    case BRUSH_COLOR: draw_color( &inner, &state, draw->size, 1.0f ); break;
+    case BRUSH_SURFACE: draw_surface( &inner, source, &state, draw->size, 1.0f, &identity ); break;
+    case BRUSH_NINE_GRID: draw_nine_grid( &inner, source, &state, draw->size, 1.0f ); break;
