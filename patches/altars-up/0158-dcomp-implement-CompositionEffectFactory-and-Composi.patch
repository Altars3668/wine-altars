+static HRESULT WINAPI names_iterator_get_Current( IIterator_HSTRING *iface, HSTRING *value )
+{
+    struct names *names = impl_from_IIterator_HSTRING( iface );
+
+    if (names->index >= names->count) return E_BOUNDS;
