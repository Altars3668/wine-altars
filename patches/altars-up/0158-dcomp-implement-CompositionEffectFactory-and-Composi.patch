+static void test_effect_brush(void)
+{
+    static const WCHAR *const animatable[] = {L"Crossfade.Source1Amount", L"Crossfade.Source2Amount"};
+    static const WCHAR *const unknown_effect[] = {L"Fade.Source1Amount"};
+    static const WCHAR *const unknown_property[] = {L"Crossfade.Opacity"};
+    CompositionEffectFactoryLoadStatus status;
+    ICompositorDesktopInterop *desktop;
+    ICompositorController *controller;
+    ICompositionEffectFactory *factory, *factory2;
+    ICompositionBrush *source, *source2, *got, *brush_iface;
+    IDispatcherQueueController *queue;
+    ICompositionEffectBrush *brush, *brush2;
+    ICompositionColorBrush *color, *color2;
+    IDesktopWindowTarget *target;
+    ICompositionTarget *ctarget;
+    ICompositor *compositor;
+    struct test_effect *effect;
+    IVisual *sprite_visual;
+    ISpriteVisual *sprite;
+    struct names names;
+    HRESULT hr, error;
+    HSTRING str;
+    Vector2 v2;
+    Color c;
+    HWND hwnd;
+
+    queue = create_queue( DQTAT_COM_STA );
+    if (!(controller = create_controller( &compositor ))) goto done;
+    effect = create_test_effect( L"Crossfade" );
+
+    init_names( &names, animatable, ARRAY_SIZE(animatable) );
+    hr = ICompositor_CreateEffectFactoryWithProperties( compositor, &effect->IGraphicsEffect_iface,
+                                                        &names.IIterable_HSTRING_iface, &factory );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) goto release;
+    check_class( factory, L"Windows.UI.Composition.CompositionEffectFactory" );
+    check_interface( factory, &IID_ICompositionObject, TRUE );
+    status = -1;
+    hr = ICompositionEffectFactory_get_LoadStatus( factory, &status );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( status == CompositionEffectFactoryLoadStatus_Success, "got status %d.\n", status );
+    error = E_FAIL;
+    hr = ICompositionEffectFactory_get_ExtendedError( factory, &error );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( error == S_OK, "got error %#lx.\n", error );
+
+    hr = ICompositionEffectFactory_CreateBrush( factory, &brush );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_class( brush, L"Windows.UI.Composition.CompositionEffectBrush" );
+    check_interface( brush, &IID_ICompositionBrush, TRUE );
+    check_interface( brush, &IID_ICompositionObject, TRUE );
+
+    /* the brushes it draws from go by the names of the parameters */
+    str = hstring( L"source1" );
+    got = (void *)0xdeadbeef;
+    hr = ICompositionEffectBrush_GetSourceParameter( brush, str, &got );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !got, "got brush %p.\n", got );
+    c.A = 255; c.R = 255; c.G = 0; c.B = 0;
+    ICompositor_CreateColorBrushWithColor( compositor, c, &color );
+    ICompositionColorBrush_QueryInterface( color, &IID_ICompositionBrush, (void **)&source );
+    hr = ICompositionEffectBrush_SetSourceParameter( brush, str, source );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionEffectBrush_GetSourceParameter( brush, str, &got );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( got == source, "got brush %p.\n", got );
+    if (got) ICompositionBrush_Release( got );
+    hr = ICompositionEffectBrush_SetSourceParameter( brush, str, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositionEffectBrush_GetSourceParameter( brush, str, &got );
+    ok( hr == S_OK && !got, "got hr %#lx, brush %p.\n", hr, got );
+    ICompositionEffectBrush_SetSourceParameter( brush, str, source );
+    WindowsDeleteString( str );
+    str = hstring( L"source2" );
+    c.R = 0; c.B = 255;
+    ICompositor_CreateColorBrushWithColor( compositor, c, &color2 );
+    ICompositionColorBrush_QueryInterface( color2, &IID_ICompositionBrush, (void **)&source2 );
+    hr = ICompositionEffectBrush_SetSourceParameter( brush, str, source2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsDeleteString( str );
+
+    /* what was named animatable is the brush's to animate, by the name of the effect */
+    hr = start_scalar( compositor, brush, L"Crossfade.Source1Amount", NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = start_scalar( compositor, brush, L"Crossfade.Source2Amount", NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = start_scalar( compositor, brush, L"Crossfade.MultiplyAmount", NULL );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+
+    /* and it draws */
+    hwnd = create_window();
+    pump_messages( 100 );
+    ICompositor_QueryInterface( compositor, &IID_ICompositorDesktopInterop, (void **)&desktop );
+    hr = ICompositorDesktopInterop_CreateDesktopWindowTarget( desktop, hwnd, FALSE, &target );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositorDesktopInterop_Release( desktop );
+    ICompositor_CreateSpriteVisual( compositor, &sprite );
+    ISpriteVisual_QueryInterface( sprite, &IID_IVisual, (void **)&sprite_visual );
+    v2.X = 100; v2.Y = 100;
+    IVisual_put_Size( sprite_visual, v2 );
+    ICompositionEffectBrush_QueryInterface( brush, &IID_ICompositionBrush, (void **)&brush_iface );
+    hr = ISpriteVisual_put_Brush( sprite, brush_iface );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionBrush_Release( brush_iface );
+    IDesktopWindowTarget_QueryInterface( target, &IID_ICompositionTarget, (void **)&ctarget );
+    hr = ICompositionTarget_put_Root( ctarget, sprite_visual );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = ICompositorController_Commit( controller );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    pump_messages( 300 );
+    ICompositionTarget_Release( ctarget );
+    IVisual_Release( sprite_visual );
+    ISpriteVisual_Release( sprite );
+    IDesktopWindowTarget_Release( target );
+    DestroyWindow( hwnd );
+
+    ICompositionBrush_Release( source2 );
+    ICompositionColorBrush_Release( color2 );
+    ICompositionBrush_Release( source );
+    ICompositionColorBrush_Release( color );
+    ICompositionEffectBrush_Release( brush );
+    ICompositionEffectFactory_Release( factory );
+
+    /* what is not named animatable is not */
+    hr = ICompositor_CreateEffectFactory( compositor, &effect->IGraphicsEffect_iface, &factory2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = ICompositionEffectFactory_CreateBrush( factory2, &brush2 );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = start_scalar( compositor, brush2, L"Crossfade.Source1Amount", NULL );
+        ok( FAILED(hr), "got hr %#lx.\n", hr );
+        ICompositionEffectBrush_Release( brush2 );
+        ICompositionEffectFactory_Release( factory2 );
+    }
+
+    /* a name that is no effect's, or no property of the effect, is not taken */
+    init_names( &names, unknown_effect, ARRAY_SIZE(unknown_effect) );
+    factory2 = (void *)0xdeadbeef;
+    hr = ICompositor_CreateEffectFactoryWithProperties( compositor, &effect->IGraphicsEffect_iface,
+                                                        &names.IIterable_HSTRING_iface, &factory2 );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    init_names( &names, unknown_property, ARRAY_SIZE(unknown_property) );
+    hr = ICompositor_CreateEffectFactoryWithProperties( compositor, &effect->IGraphicsEffect_iface,
+                                                        &names.IIterable_HSTRING_iface, &factory2 );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+
+release:
+    IGraphicsEffect_Release( &effect->IGraphicsEffect_iface );
+    ICompositor_Release( compositor );
+    ICompositorController_Release( controller );
+done:
+    if (queue) IDispatcherQueueController_Release( queue );
+}
