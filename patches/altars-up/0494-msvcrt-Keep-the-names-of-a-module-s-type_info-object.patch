From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:18 -0400
Subject: [PATCH] msvcrt: Keep the names of a module's type_info objects in its
 list.

type_info::_name_internal_method links the name it makes into the
module's list, and __clean_type_info_names_internal frees them when the
module goes away, as the MSVCR80-120 runtimes do.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msvcrt/cpp.c b/dlls/msvcrt/cpp.c
index c8537bda8f4..32bc772c176 100644
--- a/dlls/msvcrt/cpp.c
+++ b/dlls/msvcrt/cpp.c
@@ -970,22 +970,65 @@ int __cdecl _is_exception_typeof(const type_info *ti, EXCEPTION_POINTERS *ep)
 
 /*********************************************************************
  * __clean_type_info_names_internal (MSVCR80.@)
+ *
+ * Frees the names a module's type_info objects were given, which its own copy
+ * of the runtime does when the module goes away.
  */
 void CDECL __clean_type_info_names_internal(void *p)
 {
-    FIXME("(%p) stub\n", p);
+    struct __type_info_node *root = p, *node, *next;
+
+    TRACE("(%p)\n", p);
+
+    if (!root) return;
+    for (node = InterlockedExchangePointer((void **)&root->next, NULL); node; node = next)
+    {
+        next = node->next;
+        free(node->memPtr);
+        free(node);
+    }
 }
 
 /*********************************************************************
  * ?_name_internal_method@type_info@@QBEPBDPAU__type_info_node@@@Z (MSVCR100.@)
+ *
+ * The name is kept in the list of the module that asks, so that it is freed
+ * with the module.
  */
 DEFINE_THISCALL_WRAPPER(type_info_name_internal_method,8)
-const char * __thiscall type_info_name_internal_method(type_info * _this, struct __type_info_node *node)
+const char * __thiscall type_info_name_internal_method(type_info * _this, struct __type_info_node *root)
 {
-    static int once;
-    if (node && !once++) FIXME("type_info_node parameter ignored\n");
+    struct __type_info_node *node;
+    char *name;
 
-    return type_info_name(_this);
+    if (!root) return type_info_name(_this);
+    if (_this->name) return _this->name;
+
+    if (!(name = __unDName(0, _this->mangled + 1, 0, malloc, free,
+                           UNDNAME_NO_ARGUMENTS | UNDNAME_32_BIT_DECODE)))
+        return NULL;
+    /* It seems _unDName may leave blanks at the end of the demangled name */
+    {
+        unsigned int len = strlen(name);
+        while (len && name[--len] == ' ') name[len] = '\0';
+    }
+    if (!(node = malloc(sizeof(*node))))
+    {
+        free(name);
+        return NULL;
+    }
+    if (InterlockedCompareExchangePointer((void **)&_this->name, name, NULL))
+    {
+        /* Another thread set this member since we checked above - use it */
+        free(name);
+        free(node);
+        return _this->name;
+    }
+    node->memPtr = name;
+    do node->next = root->next;
+    while (InterlockedCompareExchangePointer((void **)&root->next, node, node->next) != node->next);
+    TRACE("(%p) returning %s\n", _this, name);
+    return name;
 }
 
 void* __cdecl __AdjustPointer(void *obj, const this_ptr_offsets *off)
