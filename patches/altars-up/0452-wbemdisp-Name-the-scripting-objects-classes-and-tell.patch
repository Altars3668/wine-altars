+static void check_class_( unsigned int line, IUnknown *unk, const WCHAR *expected )
+{
+    IProvideClassInfo *provide;
+    ITypeInfo *info;
+    HRESULT hr;
+    BSTR name;
+
+    hr = IUnknown_QueryInterface( unk, &IID_IProvideClassInfo, (void **)&provide );
+    ok_(__FILE__, line)( hr == S_OK, "got %#lx\n", hr );
+    if (hr != S_OK) return;
+    hr = IProvideClassInfo_GetClassInfo( provide, &info );
+    ok_(__FILE__, line)( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        hr = ITypeInfo_GetDocumentation( info, MEMBERID_NIL, &name, NULL, NULL, NULL );
+        ok_(__FILE__, line)( hr == S_OK && !wcscmp( name, expected ), "got %#lx, %s\n", hr, wine_dbgstr_w(name) );
+        SysFreeString( name );
+        ITypeInfo_Release( info );
+    }
+    IProvideClassInfo_Release( provide );
+}
+#define check_class(a, b) check_class_( __LINE__, (IUnknown *)(a), b )
+
+/* every object names its class; a failed call tells the script the status's text and the class; a query asked to
+ * return at once fails when its results are asked for (Windows 11, tools/winmgmtsprobe: classinfo.c, errorinfo.c,
+ * errors.vbs) */
+static void test_classes_and_errors(void)
+{
+    static const WCHAR *names[] = { L"Put", L"PutAsync" };
+    ISWbemLocator *locator;
+    ISWbemServices *services;
+    ISWbemObjectSet *objects;
+    ISWbemObjectPath *path;
+    ISWbemNamedValueSet *values;
+    ISWbemObject *object;
+    IEnumVARIANT *items;
+    IUnknown *unk;
+    DISPPARAMS params;
+    DISPID put = DISPID_PROPERTYPUT;
+    EXCEPINFO excep;
+    VARIANT var, arg;
+    unsigned int i;
+    DISPID id;
+    HRESULT hr;
+    BSTR str, lang;
+
+    hr = CoCreateInstance( &CLSID_SWbemLocator, NULL, CLSCTX_INPROC_SERVER, &IID_ISWbemLocator, (void **)&locator );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_class( locator, L"SWbemLocator" );
+    str = SysAllocString( L"root\\cimv2" );
+    hr = ISWbemLocator_ConnectServer( locator, NULL, str, NULL, NULL, NULL, NULL, 0, NULL, &services );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    check_class( services, L"SWbemServicesEx" );
+
+    hr = ISWbemServices_QueryInterface( services, &IID_ISWbemServicesEx, (void **)&unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK) IUnknown_Release( unk );
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        LPOLESTR name = (LPOLESTR)names[i];
+        id = -1;
+        hr = ISWbemServices_GetIDsOfNames( services, &IID_NULL, &name, 1, english, &id );
+        ok( hr == S_OK && id == 20 + i, "%s: got %#lx, %ld\n", wine_dbgstr_w(names[i]), hr, id );
+    }
+
+    hr = CoCreateInstance( &CLSID_SWbemObjectPath, NULL, CLSCTX_INPROC_SERVER, &IID_ISWbemObjectPath, (void **)&path );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_class( path, L"SWbemObjectPath" );
+    hr = ISWbemObjectPath_get_Keys( path, &values );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_class( values, L"SWbemNamedValueSet" );
+    ISWbemNamedValueSet_Release( values );
+
+    /* Path = "Class.A = 5" through IDispatch */
+    V_VT( &arg ) = VT_BSTR;
+    V_BSTR( &arg ) = SysAllocString( L"Class.A = 5" );
+    params.rgvarg = &arg;
+    params.rgdispidNamedArgs = &put;
+    params.cArgs = 1;
+    params.cNamedArgs = 1;
+    memset( &excep, 0, sizeof(excep) );
+    hr = ISWbemObjectPath_Invoke( path, DISPID_VALUE, &IID_NULL, english, DISPATCH_PROPERTYPUT, &params, NULL, &excep,
+                                  NULL );
+    ok( hr == DISP_E_EXCEPTION, "got %#lx\n", hr );
+    ok( excep.scode == WBEM_E_FAILED, "got %#lx\n", excep.scode );
+    ok( excep.bstrSource && !wcscmp( excep.bstrSource, L"SWbemObjectPath" ), "got %s\n",
+        wine_dbgstr_w(excep.bstrSource) );
+    ok( excep.bstrDescription && SysStringLen( excep.bstrDescription ) > 1 &&
+        excep.bstrDescription[SysStringLen( excep.bstrDescription ) - 1] == ' ', "got %s\n",
+        wine_dbgstr_w(excep.bstrDescription) );
+    if (PRIMARYLANGID( GetUserDefaultUILanguage() ) == LANG_ENGLISH)
+        ok( !wcscmp( excep.bstrDescription, L"Generic failure " ), "got %s\n", wine_dbgstr_w(excep.bstrDescription) );
+    SysFreeString( excep.bstrSource );
+    SysFreeString( excep.bstrDescription );
+    SysFreeString( excep.bstrHelpFile );
+    VariantClear( &arg );
+    ISWbemObjectPath_Release( path );
+
+    /* a query that is no query, asked to return at once and not */
+    str = SysAllocString( L"SELEC * FROM Win32_LogicalDisk" );
+    lang = SysAllocString( L"WQL" );
+    hr = ISWbemServices_ExecQuery( services, str, lang, wbemFlagReturnImmediately, NULL, &objects );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK)
+    {
+        check_class( objects, L"SWbemObjectSet" );
+        hr = ISWbemObjectSet_get__NewEnum( objects, &unk );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        hr = IUnknown_QueryInterface( unk, &IID_IEnumVARIANT, (void **)&items );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        IUnknown_Release( unk );
+        VariantInit( &var );
+        hr = IEnumVARIANT_Next( items, 1, &var, NULL );
+        ok( hr == WBEM_E_INVALID_QUERY, "got %#lx\n", hr );
+        IEnumVARIANT_Release( items );
+        ISWbemObjectSet_Release( objects );
+    }
+    hr = ISWbemServices_ExecQuery( services, str, lang, 0, NULL, &objects );
+    ok( hr == WBEM_E_INVALID_QUERY, "got %#lx\n", hr );
+    SysFreeString( str );
+
+    /* an object of the results by its path */
+    str = SysAllocString( L"SELECT * FROM Win32_LogicalDisk" );
+    hr = ISWbemServices_ExecQuery( services, str, lang, 0, NULL, &objects );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    if (hr == S_OK)
+    {
+        str = SysAllocString( L"Win32_LogicalDisk.DeviceID=\"C:\"" );
+        hr = ISWbemObjectSet_Item( objects, str, 0, &object );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (hr == S_OK)
+        {
+            check_class( object, L"SWbemObjectEx" );
+            ISWbemObject_Release( object );
+        }
+        SysFreeString( str );
+        str = SysAllocString( L"Win32_LogicalDisk.DeviceID=\"nonesuch\"" );
+        hr = ISWbemObjectSet_Item( objects, str, 0, &object );
+        ok( hr == WBEM_E_NOT_FOUND, "got %#lx\n", hr );
+        SysFreeString( str );
+        ISWbemObjectSet_Release( objects );
+    }
+    SysFreeString( lang );
+
+    /* there is no last error to be had */
+    hr = CoCreateInstance( &CLSID_SWbemLastError, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk );
+    ok( hr == E_FAIL, "got %#lx\n", hr );
+
+    ISWbemServices_Release( services );
+    ISWbemLocator_Release( locator );
+}
+
 START_TEST(wbemdisp)
 {
     CoInitialize( NULL );
@@ -1131,6 +1286,7 @@ START_TEST(wbemdisp)
     test_namedvalueset();
     test_objectpath();
     test_object_path();
+    test_classes_and_errors();
 
     CoUninitialize();
 }
