+
+    if (!objWbemObject) return E_INVALIDARG;
+    *objWbemObject = NULL;
+    if (objectset->failure) return objectset->failure;
+    if (!strObjectPath) return WBEM_E_INVALID_PARAMETER;
+    if (FAILED(IEnumWbemClassObject_Clone( objectset->objectenum, &objectenum ))) return WBEM_E_FAILED;
+    while (IEnumWbemClassObject_Next( objectenum, WBEM_INFINITE, 1, &obj, &count ) == S_OK && count)
