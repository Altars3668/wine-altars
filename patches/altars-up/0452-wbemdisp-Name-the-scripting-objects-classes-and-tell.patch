+/* IProvideClassInfo, which VBScript's TypeName asks for: every object Windows hands out names its class
+ * (Windows 11, tools/winmgmtsprobe, classinfo.c) */
+struct classinfo
+{
+    IProvideClassInfo IProvideClassInfo_iface;
+    LONG refs;
+    IUnknown *outer;
+    enum type_id class_tid;
+};
+
+static struct classinfo *impl_from_IProvideClassInfo( IProvideClassInfo *iface )
+{
+    return CONTAINING_RECORD( iface, struct classinfo, IProvideClassInfo_iface );
+}
+
+static HRESULT WINAPI classinfo_QueryInterface( IProvideClassInfo *iface, REFIID riid, void **obj )
+{
+    struct classinfo *classinfo = impl_from_IProvideClassInfo( iface );
+
+    if (IsEqualGUID( riid, &IID_IProvideClassInfo ))
+    {
+        *obj = iface;
+        IProvideClassInfo_AddRef( iface );
+        return S_OK;
+    }
+    return IUnknown_QueryInterface( classinfo->outer, riid, obj );
+}
+
+static ULONG WINAPI classinfo_AddRef( IProvideClassInfo *iface )
+{
+    struct classinfo *classinfo = impl_from_IProvideClassInfo( iface );
+    return InterlockedIncrement( &classinfo->refs );
+}
+
+static ULONG WINAPI classinfo_Release( IProvideClassInfo *iface )
+{
+    struct classinfo *classinfo = impl_from_IProvideClassInfo( iface );
+    LONG refs = InterlockedDecrement( &classinfo->refs );
+
+    if (!refs)
+    {
+        IUnknown_Release( classinfo->outer );
+        free( classinfo );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI classinfo_GetClassInfo( IProvideClassInfo *iface, ITypeInfo **info )
+{
+    struct classinfo *classinfo = impl_from_IProvideClassInfo( iface );
+
+    TRACE( "%p, %p\n", iface, info );
+
+    if (!info) return E_POINTER;
+    return get_typeinfo( classinfo->class_tid, info );
+}
+
+static const IProvideClassInfoVtbl classinfo_vtbl =
+{
+    classinfo_QueryInterface,
+    classinfo_AddRef,
+    classinfo_Release,
+    classinfo_GetClassInfo
+};
+
+static HRESULT classinfo_create( IUnknown *outer, enum type_id class_tid, void **obj )
+{
+    struct classinfo *classinfo;
+
+    if (!(classinfo = malloc( sizeof(*classinfo) ))) return E_OUTOFMEMORY;
+    classinfo->IProvideClassInfo_iface.lpVtbl = &classinfo_vtbl;
+    classinfo->refs = 1;
+    classinfo->outer = outer;
+    IUnknown_AddRef( outer );
+    classinfo->class_tid = class_tid;
+    *obj = &classinfo->IProvideClassInfo_iface;
+    return S_OK;
+}
+
+/* a failed call tells the script the status's text, with its line break a space, and the class that failed it
+ * (Windows 11, tools/winmgmtsprobe, errorinfo.c and errors.vbs) */
+static void fill_excepinfo( EXCEPINFO *info, enum type_id class_tid )
+{
+    IWbemStatusCodeText *text;
+    ITypeInfo *typeinfo;
+
+    if (!info || SUCCEEDED(info->scode) || info->bstrDescription || info->bstrSource) return;
+    if (SUCCEEDED(CoCreateInstance( &CLSID_WbemStatusCodeText, NULL, CLSCTX_INPROC_SERVER, &IID_IWbemStatusCodeText,
+                                    (void **)&text )))
+    {
+        IWbemStatusCodeText_GetErrorCodeText( text, info->scode, 0, WBEMSTATUS_FORMAT_NO_NEWLINE,
+                                              &info->bstrDescription );
+        IWbemStatusCodeText_Release( text );
+    }
+    if (SUCCEEDED(get_typeinfo( class_tid, &typeinfo )))
+    {
+        ITypeInfo_GetDocumentation( typeinfo, MEMBERID_NIL, &info->bstrSource, NULL, NULL, NULL );
+        ITypeInfo_Release( typeinfo );
+    }
+}
