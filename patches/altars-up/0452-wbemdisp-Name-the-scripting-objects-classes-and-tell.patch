+        VariantClear( &var );
+        if (!found && SUCCEEDED(IWbemClassObject_Get( obj, L"__PATH", 0, &var, NULL, NULL )) &&
+            V_VT( &var ) == VT_BSTR)
+            found = !wcsicmp( V_BSTR( &var ), strObjectPath );
+        VariantClear( &var );
+        if (found) hr = SWbemObject_create( objectset->services, obj, objWbemObject );
+        IWbemClassObject_Release( obj );
+        if (found) break;
+    }
+    IEnumWbemClassObject_Release( objectenum );
+    return hr;
 }
 
