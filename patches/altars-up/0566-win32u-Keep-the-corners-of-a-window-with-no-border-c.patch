From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 12:12:09 -0400
Subject: [PATCH] win32u: Keep the corners of a window with no border colour
 round for the drivers, and leave its default border to them.

Windows 11's desktop window manager draws a border along the edge of a
window with round corners: in the colour asked for with
DWMWA_BORDER_COLOR, none with DWMWA_COLOR_NONE, and by default a grey,
translucent one that shows what is behind the window.
tools/dwmframeprobe in the wine-altars repository measured it on
white, grey and black backdrops: 40% of a 0x767676 grey over the
backdrop and the shadow, in place of the window's outermost pixels.

A surface whose window asks for no colour now keeps the radius of its
corners, which the drivers need for the shadow that goes with them, and
draws a border only for a colour asked for.  For the default border its
window's shape leaves the outermost pixels out, so that the driver can
draw the border behind the window, where Windows draws it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 42b5659e37f..7777d14c497 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -665,7 +665,8 @@ static void draw_surface_frame( struct window_surface *surface, const RECT *dirt
  *           window_surface_set_frame
  *
  * Give the surface of a window of the given size the frame of round corners and a border, or
- * take it away with radius 0 or color CLR_INVALID.
+ * take it away with radius 0; with color CLR_INVALID the corners stay round, the drivers draw
+ * what goes with them, and the surface draws no border.
  */
 void window_surface_set_frame( struct window_surface *surface, const SIZE *size, UINT radius, UINT border,
                                COLORREF color )
@@ -676,7 +677,7 @@ void window_surface_set_frame( struct window_surface *surface, const SIZE *size,
 
     if (surface == &dummy_surface) return;
     radius = min( radius, max( 0, min( size->cx, size->cy ) / 2 ));
-    if (color == CLR_INVALID || !border) radius = 0;
+    if (!border) color = CLR_INVALID;
     if (!radius) color = CLR_INVALID;
 
     window_surface_lock( surface );
@@ -685,8 +686,8 @@ void window_surface_set_frame( struct window_surface *surface, const SIZE *size,
     window_surface_unlock( surface );
     if (same) return;
 
-    /* the corner pixels' coverage, 0 to 256, or more where they are cut */
-    if (radius && (pixels = calloc( radius * radius, sizeof(*pixels) )))
+    /* the corner pixels' coverage, 0 to 256, or more where they are cut, for drawing the border */
+    if (radius && color != CLR_INVALID && (pixels = calloc( radius * radius, sizeof(*pixels) )))
     {
         for (y = 0; y < radius; y++)
         {
@@ -697,7 +698,7 @@ void window_surface_set_frame( struct window_surface *surface, const SIZE *size,
             }
         }
     }
-    else radius = 0;
+    else color = CLR_INVALID;
 
     window_surface_lock( surface );
     free( surface->frame_pixels );
@@ -705,7 +706,7 @@ void window_surface_set_frame( struct window_surface *surface, const SIZE *size,
     surface->frame_size = *size;
     surface->frame_radius = radius;
     surface->frame_border = border;
-    surface->frame_color = radius ? color : CLR_INVALID;
+    surface->frame_color = color;
     surface->bounds = surface->rect;
     window_surface_unlock( surface );
 }
@@ -831,7 +832,7 @@ void window_surface_flush( struct window_surface *surface )
         void *shape_bits;
         BOOL shape_changed;
 
-        if (surface->frame_radius) draw_surface_frame( surface, &dirty, color_info, color_bits );
+        if (surface->frame_pixels) draw_surface_frame( surface, &dirty, color_info, color_bits );
         shape_changed = update_surface_shape( surface, &surface->rect, &dirty, color_info, color_bits );
         /* the shape belongs to the window, which may have had another surface, shaped: a new
          * surface tells the driver its own shape, or that it has none, at least once */
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 37fc5513d98..74c428f996f 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2157,7 +2157,7 @@ static UINT get_corner_radius( WND *win, UINT dpi )
  */
 static void update_surface_region( HWND hwnd )
 {
-    UINT dpi = round_dpi( get_dpi_for_window( hwnd )), radius;
+    UINT dpi = round_dpi( get_dpi_for_window( hwnd )), radius, border, inset = 0;
     WND *win = get_win_ptr( hwnd );
     HRGN region, shape = 0, corners;
     COLORREF border_color;
@@ -2171,11 +2171,15 @@ static void update_surface_region( HWND hwnd )
     size.cx = win->rects.visible.right - win->rects.visible.left;
     size.cy = win->rects.visible.bottom - win->rects.visible.top;
     radius = get_corner_radius( win, dpi );
-    /* the window manager draws a border along the edge in the colour asked for with
-     * DWMWA_BORDER_COLOR; the one it draws by default is not drawn */
+    /* the window manager draws a border along the edge, in the colour asked for with
+     * DWMWA_BORDER_COLOR, which the surface draws over the window, or none with DWMWA_COLOR_NONE;
+     * the translucent one it draws by default shows what is behind the window, and the driver
+     * draws it there, where the window leaves its outermost pixels out */
+    border = max( 1, muldiv( 1, dpi, USER_DEFAULT_SCREEN_DPI ));
     border_color = win->border_color & 0xff000000 ? CLR_INVALID : win->border_color;
-    window_surface_set_frame( win->surface, &size, radius, max( 1, muldiv( 1, dpi, USER_DEFAULT_SCREEN_DPI )),
-                              border_color );
+    if (win->border_color == 0xfffffffe /* DWMWA_COLOR_NONE */) border = 0;
+    else if (radius > border && border_color == CLR_INVALID) inset = border;
+    window_surface_set_frame( win->surface, &size, radius, border, border_color );
 
     if (get_window_region( hwnd, FALSE, &shape, &visible )) goto done;
     if (shape)
@@ -2187,8 +2191,9 @@ static void update_surface_region( HWND hwnd )
     }
     /* what the window manager rounds off comes on top of the window region; GetWindowRgn
      * still returns the region the application set */
-    if (radius && (corners = create_frame_region( size.cx, size.cy, radius )))
+    if (radius && (corners = create_frame_region( size.cx - 2 * inset, size.cy - 2 * inset, radius - inset )))
     {
+        NtGdiOffsetRgn( corners, inset, inset );
         if (!shape) shape = corners;
         else
         {
diff --git a/include/wine/gdi_driver.h b/include/wine/gdi_driver.h
index 860d85d68e6..04e5799e3ce 100644
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -324,8 +324,10 @@ struct window_surface
     HBITMAP                            color_bitmap; /* bitmap for the surface colors */
     SIZE                               frame_size;   /* size of the window in the surface */
     UINT                               frame_radius; /* radius of the corners the window manager rounds, 0 if square */
-    UINT                               frame_border; /* width of the border it draws along the edge, in pixels */
-    COLORREF                           frame_color;  /* colour of that border, CLR_INVALID if there is none */
+    UINT                               frame_border; /* width of the border it draws along the edge, in pixels, 0 if none */
+    COLORREF                           frame_color;  /* colour of that border, which the surface draws, or CLR_INVALID
+                                                        for the translucent default one, which the driver draws where
+                                                        the window's shape leaves the edge out */
     UINT32                            *frame_pixels; /* how much of each corner pixel the border covers */
     BOOL                               shape_flushed; /* the driver has been given the surface's shape */
     /* driver-specific fields here */
