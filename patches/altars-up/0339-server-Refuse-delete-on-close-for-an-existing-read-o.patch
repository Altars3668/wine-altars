From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 02:34:22 -0400
Subject: [PATCH] server: Refuse delete on close for an existing read-only file
 whatever the disposition.

A read-only file cannot be opened for delete on close; the server only
checked that for dispositions that do not create, so FILE_OPEN_IF on an
existing read-only file succeeded and deleted it at close, where the
_lcreat test expects STATUS_CANNOT_DELETE and the file kept.  Whether a
file that may be created was there already is now looked up first.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 6fd41ac0e97..8a410f8148a 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -384,17 +384,13 @@ static void test__lcreat( void )
     status = pNtCreateFile( &file, DELETE, &attr, &io, NULL, 0,
                            FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                            FILE_OPEN_IF, FILE_DELETE_ON_CLOSE | FILE_NON_DIRECTORY_FILE, NULL, 0 );
-    todo_wine
     ok( status == STATUS_CANNOT_DELETE, "expected STATUS_CANNOT_DELETE, got %08lx\n", status );
     if (!status) CloseHandle( file );
 
     pRtlFreeUnicodeString( &filenameW );
 
-    todo_wine
     ok( GetFileAttributesA( filename ) != INVALID_FILE_ATTRIBUTES, "file was deleted\n" );
-    todo_wine
     ok( SetFileAttributesA(filename, FILE_ATTRIBUTE_NORMAL ) != 0, "couldn't change attributes on file\n" );
-    todo_wine
     ok( DeleteFileA( filename ) != 0, "now it should be possible to delete the file\n" );
 
     filehandle = _lcreat( filename, 2 );
diff --git a/server/fd.c b/server/fd.c
index c334c17f008..29c8dcd4ec3 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -2025,7 +2025,7 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
     struct stat st;
     struct closed_fd *closed_fd;
     struct fd *fd;
-    int root_fd = -1;
+    int root_fd = -1, existed = 0;
     unsigned int unix_write_access;
     int rw_mode;
     char *path;
@@ -2084,6 +2084,9 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
     }
     else rw_mode = O_RDONLY;
 
+    /* whether a file to be deleted on close that may be created here was there already */
+    if ((flags & O_CREAT) && (options & FILE_DELETE_ON_CLOSE)) existed = !stat( name, &st );
+
     if ((fd->unix_fd = open( name, rw_mode | (flags & ~O_TRUNC), *mode )) == -1)
     {
         /* if we tried to open a directory for write access, retry read-only */
@@ -2163,7 +2166,7 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
         }
 
         /* can't unlink files if we don't have permission to access */
-        if ((options & FILE_DELETE_ON_CLOSE) && !(flags & O_CREAT) &&
+        if ((options & FILE_DELETE_ON_CLOSE) && (!(flags & O_CREAT) || existed) &&
             !(st.st_mode & (S_IWUSR | S_IWGRP | S_IWOTH)))
         {
             set_error( STATUS_CANNOT_DELETE );
