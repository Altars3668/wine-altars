From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 15:48:21 -0400
Subject: [PATCH] win32u: an output that is not on the desktop yet is not a
 screen.

A host part way through switching to another output enumerates it before
it is on the screen: its source is not attached to the desktop and its
monitor has no place.  That passed the check that keeps a moment with no
monitors from being written down, the configuration was replaced by one
with no primary source, and every process reading it at that moment fell
back to a 1024x768 stand-in monitor.  mutter does exactly this when one
virtual monitor replaces another, as gnome-remote-desktop does when a
phone is turned.

Only a monitor of an attached source with a place on the desktop now counts
as one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 7c83b5e5c7e520128111f6a89b0d7dbf8e8607f7)

diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index cdb0b70b3d2..43e414db34a 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -2888,15 +2888,16 @@ static BOOL add_virtual_source( struct device_manager_ctx *ctx )
  * GPU empties the stored configuration, and every source and monitor after it
  * is written as it arrives.  A host part way through a mode switch -- a remote
  * desktop client turned from portrait to landscape takes the old output down
- * before it puts the new one up -- enumerates as sources with no monitors, and
- * by the time that shows, the configuration every process reads has already
- * been replaced by it.  They then fall back to a stand-in monitor, and size
+ * before it puts the new one up -- enumerates as sources with no monitors, or
+ * with the new output there but not on the desktop yet, and by the time that
+ * shows, the configuration every process reads has already been replaced by
+ * it.  They then fall back to a stand-in monitor, and size
  * their windows from that.
  *
  * On Windows the configuration belongs to the kernel and changes in one step:
  * no program ever reads a screen that is half torn down.  Recording the
  * enumeration and replaying it into the device manager only once it has a
- * monitor gives the same guarantee -- the stored configuration goes straight
+ * monitor on the desktop gives the same guarantee -- the stored configuration goes straight
  * from the old screen to the new one, and a moment with nothing attached
  * leaves it where it was. */
 enum device_call
@@ -2938,7 +2939,8 @@ struct device_record
 struct device_recording
 {
     struct list records;
-    UINT monitor_count;
+    UINT monitor_count;   /* monitors on the desktop: of an attached source, and somewhere */
+    BOOL source_attached; /* whether the source being recorded is attached to the desktop */
     BOOL failed;
 };
 
@@ -2976,6 +2978,7 @@ static void record_source( const char *name, UINT state_flags, UINT dpi, void *p
     if (!(record = record_device_call( param, DEVICE_CALL_SOURCE, name ))) return;
     record->source.state_flags = state_flags;
     record->source.dpi = dpi;
+    ((struct device_recording *)param)->source_attached = !!(state_flags & DISPLAY_DEVICE_ATTACHED_TO_DESKTOP);
 }
 
 static void record_monitor( const struct gdi_monitor *monitor, void *param )
@@ -2995,7 +2998,9 @@ static void record_monitor( const struct gdi_monitor *monitor, void *param )
         }
         memcpy( record->monitor.edid, monitor->edid, monitor->edid_len );
     }
-    recording->monitor_count++;
+    /* An output the host has but has not put on the screen yet, part way through a switch to
+     * it, is no screen: its source is not attached and it has no place on the desktop. */
+    if (recording->source_attached && !IsRectEmpty( &monitor->rc_monitor )) recording->monitor_count++;
 }
 
 static void record_modes( const DEVMODEW *current, UINT count, const DEVMODEW *modes, void *param )
@@ -3072,7 +3077,7 @@ static UINT update_display_devices( struct device_manager_ctx *ctx )
     {
         if (recording.failed) status = STATUS_NO_MEMORY;
         else if (recording.monitor_count || is_virtual_desktop()) replay_device_calls( &recording, ctx );
-        else TRACE( "host reports no monitors, keeping the stored configuration.\n" );
+        else TRACE( "host reports no monitor on the desktop, keeping the stored configuration.\n" );
         free_device_recording( &recording );
 
         if (!status && ctx->source_count && is_virtual_desktop()) return add_virtual_source( ctx );
