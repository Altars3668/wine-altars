+static HRESULT WINAPI status_handler_QueryInterface(IEventHandler_TracingStatusChangedEventArgs *iface, REFIID iid,
+        void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_IAgileObject) ||
+        IsEqualGUID(iid, &IID_IEventHandler_TracingStatusChangedEventArgs))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI status_handler_AddRef(IEventHandler_TracingStatusChangedEventArgs *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI status_handler_Release(IEventHandler_TracingStatusChangedEventArgs *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI status_handler_Invoke(IEventHandler_TracingStatusChangedEventArgs *iface, IInspectable *sender,
+        ITracingStatusChangedEventArgs *args)
+{
+    return S_OK;
+}
+
+static const IEventHandler_TracingStatusChangedEventArgsVtbl status_handler_vtbl =
+{
+    status_handler_QueryInterface,
+    status_handler_AddRef,
+    status_handler_Release,
+    status_handler_Invoke,
+};
+
+static void test_AsyncCausalityTracer(void)
+{
+    static const WCHAR class_name[] = L"Windows.Foundation.Diagnostics.AsyncCausalityTracer";
+    IEventHandler_TracingStatusChangedEventArgs handler = { &status_handler_vtbl };
+    GUID platform_id = {0x12345678, 0x1234, 0x1234, {1, 2, 3, 4, 5, 6, 7, 8}};
+    IAsyncCausalityTracerStatics *statics;
+    IActivationFactory *factory;
+    EventRegistrationToken token;
+    IInspectable *instance;
+    HSTRING str, name;
+    TrustLevel level;
+    ULONG count;
+    IID *iids;
+    void *agile;
+    HRESULT hr;
+
+    hr = RoInitialize(RO_INIT_MULTITHREADED);
+    ok(hr == S_OK || hr == S_FALSE, "RoInitialize returned %#lx.\n", hr);
+    WindowsCreateString(class_name, wcslen(class_name), &str);
+    hr = RoGetActivationFactory(str, &IID_IActivationFactory, (void **)&factory);
+    WindowsDeleteString(str);
+    ok(hr == S_OK, "RoGetActivationFactory returned %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    /* the factory is all there is: agile, with the statics, making no instances and with no class name */
+    hr = IActivationFactory_GetIids(factory, &count, &iids);
+    ok(hr == S_OK, "GetIids returned %#lx.\n", hr);
+    ok(count == 2, "got %lu IIDs.\n", count);
+    if (count == 2)
+    {
+        ok(IsEqualGUID(&iids[0], &IID_IActivationFactory), "got %s.\n", wine_dbgstr_guid(&iids[0]));
+        ok(IsEqualGUID(&iids[1], &IID_IAsyncCausalityTracerStatics), "got %s.\n", wine_dbgstr_guid(&iids[1]));
+    }
+    CoTaskMemFree(iids);
+    hr = IActivationFactory_GetRuntimeClassName(factory, &name);
+    ok(hr == E_ILLEGAL_METHOD_CALL, "GetRuntimeClassName returned %#lx.\n", hr);
+    hr = IActivationFactory_GetTrustLevel(factory, &level);
+    ok(hr == S_OK && level == BaseTrust, "GetTrustLevel returned %#lx, level %d.\n", hr, level);
+    hr = IActivationFactory_QueryInterface(factory, &IID_IAgileObject, &agile);
+    ok(hr == S_OK, "QueryInterface(IAgileObject) returned %#lx.\n", hr);
+    if (SUCCEEDED(hr)) IUnknown_Release((IUnknown *)agile);
+    instance = (IInspectable *)0xdeadbeef;
+    hr = IActivationFactory_ActivateInstance(factory, &instance);
+    ok(hr == E_NOTIMPL, "ActivateInstance returned %#lx.\n", hr);
+    ok(!instance, "got instance %p.\n", instance);
+
+    hr = IActivationFactory_QueryInterface(factory, &IID_IAsyncCausalityTracerStatics, (void **)&statics);
+    ok(hr == S_OK, "QueryInterface(IAsyncCausalityTracerStatics) returned %#lx.\n", hr);
+    if (FAILED(hr)) goto done;
+
+    /* a trace takes any name, but only a known level and source */
+    WindowsCreateString(L"wine", 4, &str);
+    hr = IAsyncCausalityTracerStatics_TraceOperationCreation(statics, CausalityTraceLevel_Required,
+            CausalitySource_Application, platform_id, 1, str, 0);
+    ok(hr == S_OK, "TraceOperationCreation returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_TraceOperationCreation(statics, 7, CausalitySource_Application, platform_id, 1,
+            str, 0);
+    ok(hr == E_INVALIDARG, "TraceOperationCreation returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_TraceOperationCreation(statics, CausalityTraceLevel_Required, 7, platform_id, 1,
+            str, 0);
+    ok(hr == E_INVALIDARG, "TraceOperationCreation returned %#lx.\n", hr);
+    WindowsDeleteString(str);
+    hr = IAsyncCausalityTracerStatics_TraceOperationCreation(statics, CausalityTraceLevel_Required,
+            CausalitySource_Application, platform_id, 1, NULL, 0);
+    ok(hr == S_OK, "TraceOperationCreation returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_TraceOperationRelation(statics, CausalityTraceLevel_Required,
+            CausalitySource_Application, platform_id, 1, CausalityRelation_AssignDelegate);
+    ok(hr == S_OK, "TraceOperationRelation returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_TraceSynchronousWorkStart(statics, CausalityTraceLevel_Required,
+            CausalitySource_Application, platform_id, 1, CausalitySynchronousWork_Execution);
+    ok(hr == S_OK, "TraceSynchronousWorkStart returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_TraceSynchronousWorkCompletion(statics, CausalityTraceLevel_Required,
+            CausalitySource_Application, CausalitySynchronousWork_Execution);
+    ok(hr == S_OK, "TraceSynchronousWorkCompletion returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_TraceOperationCompletion(statics, CausalityTraceLevel_Required,
+            CausalitySource_Application, platform_id, 1, Completed);
+    ok(hr == S_OK, "TraceOperationCompletion returned %#lx.\n", hr);
+
+    hr = IAsyncCausalityTracerStatics_add_TracingStatusChanged(statics, NULL, &token);
+    ok(hr == E_INVALIDARG, "add_TracingStatusChanged returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_add_TracingStatusChanged(statics, &handler, &token);
+    ok(hr == S_OK, "add_TracingStatusChanged returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_remove_TracingStatusChanged(statics, token);
+    ok(hr == S_OK, "remove_TracingStatusChanged returned %#lx.\n", hr);
+    hr = IAsyncCausalityTracerStatics_remove_TracingStatusChanged(statics, token);
+    ok(hr == S_OK, "remove_TracingStatusChanged returned %#lx.\n", hr);
+
+    IAsyncCausalityTracerStatics_Release(statics);
+done:
+    if (factory) IActivationFactory_Release(factory);
+    RoUninitialize();
+}
+
 START_TEST(roapi)
 {
     BOOL ret;
@@ -871,6 +1005,7 @@ START_TEST(roapi)
     test_ActivationFactories();
     test_RoGetAgileReference();
     test_RoGetErrorReportingFlags();
+    test_AsyncCausalityTracer();
 
     SetLastError(0xdeadbeef);
     ret = DeleteFileW(L"wine.combase.test.dll");
