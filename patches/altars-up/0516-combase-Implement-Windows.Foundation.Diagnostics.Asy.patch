diff --git a/dlls/combase/roapi.c b/dlls/combase/roapi.c
index 58682380937..af3b087efa6 100644
--- a/dlls/combase/roapi.c
+++ b/dlls/combase/roapi.c
@@ -33,6 +33,8 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(combase);
 
+extern IActivationFactory *causality_tracer_factory;
+
 struct activatable_class_data
 {
     ULONG size;
@@ -695,8 +697,19 @@ void WINAPI CleanupTlsOleState(void *unknown)
  */
 HRESULT WINAPI DllGetActivationFactory(HSTRING classid, IActivationFactory **factory)
 {
-    FIXME("(%s, %p): stub\n", debugstr_hstring(classid), factory);
+    const WCHAR *name = WindowsGetStringRawBuffer(classid, NULL);
+
+    TRACE("(%s, %p)\n", debugstr_hstring(classid), factory);
+
+    if (!wcscmp(name, L"Windows.Foundation.Diagnostics.AsyncCausalityTracer"))
+    {
+        *factory = causality_tracer_factory;
+        IActivationFactory_AddRef(*factory);
+        return S_OK;
+    }
 
+    FIXME("class %s not implemented\n", debugstr_hstring(classid));
+    *factory = NULL;
     return REGDB_E_CLASSNOTREG;
 }
 
