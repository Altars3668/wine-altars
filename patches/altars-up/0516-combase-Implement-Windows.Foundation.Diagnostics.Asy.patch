+ */
+
+#define COBJMACROS
+#include "objbase.h"
+#include "winstring.h"
+#include "activation.h"
+#include "initguid.h"
+#define WIDL_using_Windows_Foundation
+#define WIDL_using_Windows_Foundation_Diagnostics
+#include "windows.foundation.diagnostics.h"
+
+#include "combase_private.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(combase);
+
+/*
+ * The tracer tells a debugger listening for it where asynchronous operations begin, end and continue.  Nothing here
+ * listens, so the traces go nowhere; what is checked is what Windows 11 checks: the level and the source.  The
+ * factory is the only object, it is agile, and it makes no instances.
+ */
+
+struct status_handler
+{
+    struct list entry;
+    IEventHandler_TracingStatusChangedEventArgs *handler;
+    EventRegistrationToken token;
+};
+
+static struct list status_handlers = LIST_INIT( status_handlers );
+static LONGLONG next_token = 1;
+static CRITICAL_SECTION handlers_cs;
+static CRITICAL_SECTION_DEBUG handlers_cs_debug =
+{
+    0, 0, &handlers_cs,
+    { &handlers_cs_debug.ProcessLocksList, &handlers_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": handlers_cs") }
+};
+static CRITICAL_SECTION handlers_cs = { &handlers_cs_debug, -1, 0, 0, 0, 0 };
+
+struct causality_tracer
+{
+    IActivationFactory IActivationFactory_iface;
+    IAsyncCausalityTracerStatics IAsyncCausalityTracerStatics_iface;
+};
+
+static struct causality_tracer *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct causality_tracer, IActivationFactory_iface );
+}
+
+static struct causality_tracer *impl_from_IAsyncCausalityTracerStatics( IAsyncCausalityTracerStatics *iface )
+{
+    return CONTAINING_RECORD( iface, struct causality_tracer, IAsyncCausalityTracerStatics_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct causality_tracer *tracer = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &tracer->IActivationFactory_iface;
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IAsyncCausalityTracerStatics ))
+    {
+        *out = &tracer->IAsyncCausalityTracerStatics_iface;
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *count, IID **iids )
+{
+    TRACE( "iface %p, count %p, iids %p.\n", iface, count, iids );
+
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(IID) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IActivationFactory;
+    (*iids)[1] = IID_IAsyncCausalityTracerStatics;
+    *count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return E_ILLEGAL_METHOD_CALL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+static HRESULT WINAPI statics_QueryInterface( IAsyncCausalityTracerStatics *iface, REFIID iid, void **out )
+{
+    struct causality_tracer *tracer = impl_from_IAsyncCausalityTracerStatics( iface );
+    return IActivationFactory_QueryInterface( &tracer->IActivationFactory_iface, iid, out );
+}
+
+static ULONG WINAPI statics_AddRef( IAsyncCausalityTracerStatics *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI statics_Release( IAsyncCausalityTracerStatics *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI statics_GetIids( IAsyncCausalityTracerStatics *iface, ULONG *count, IID **iids )
+{
+    struct causality_tracer *tracer = impl_from_IAsyncCausalityTracerStatics( iface );
+    return IActivationFactory_GetIids( &tracer->IActivationFactory_iface, count, iids );
+}
+
+static HRESULT WINAPI statics_GetRuntimeClassName( IAsyncCausalityTracerStatics *iface, HSTRING *class_name )
+{
+    struct causality_tracer *tracer = impl_from_IAsyncCausalityTracerStatics( iface );
+    return IActivationFactory_GetRuntimeClassName( &tracer->IActivationFactory_iface, class_name );
+}
+
+static HRESULT WINAPI statics_GetTrustLevel( IAsyncCausalityTracerStatics *iface, TrustLevel *trust_level )
+{
+    struct causality_tracer *tracer = impl_from_IAsyncCausalityTracerStatics( iface );
+    return IActivationFactory_GetTrustLevel( &tracer->IActivationFactory_iface, trust_level );
+}
+
+static BOOL valid_trace( CausalityTraceLevel level, CausalitySource source )
+{
+    return level <= CausalityTraceLevel_Verbose && source <= CausalitySource_System;
+}
+
+static HRESULT WINAPI statics_TraceOperationCreation( IAsyncCausalityTracerStatics *iface, CausalityTraceLevel level,
+                                                      CausalitySource source, GUID platform_id, UINT64 operation_id,
+                                                      HSTRING operation_name, UINT64 related_context )
+{
+    TRACE( "iface %p, level %u, source %u, platform_id %s, operation_id %#I64x, operation_name %s, related_context %#I64x.\n",
+           iface, level, source, debugstr_guid(&platform_id), operation_id, debugstr_hstring(operation_name),
+           related_context );
+    return valid_trace( level, source ) ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI statics_TraceOperationCompletion( IAsyncCausalityTracerStatics *iface, CausalityTraceLevel level,
+                                                        CausalitySource source, GUID platform_id, UINT64 operation_id,
+                                                        AsyncStatus status )
+{
+    TRACE( "iface %p, level %u, source %u, platform_id %s, operation_id %#I64x, status %u.\n", iface, level, source,
+           debugstr_guid(&platform_id), operation_id, status );
+    return valid_trace( level, source ) ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI statics_TraceOperationRelation( IAsyncCausalityTracerStatics *iface, CausalityTraceLevel level,
+                                                      CausalitySource source, GUID platform_id, UINT64 operation_id,
+                                                      CausalityRelation relation )
+{
+    TRACE( "iface %p, level %u, source %u, platform_id %s, operation_id %#I64x, relation %u.\n", iface, level, source,
+           debugstr_guid(&platform_id), operation_id, relation );
+    return valid_trace( level, source ) ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI statics_TraceSynchronousWorkStart( IAsyncCausalityTracerStatics *iface, CausalityTraceLevel level,
+                                                         CausalitySource source, GUID platform_id, UINT64 operation_id,
+                                                         CausalitySynchronousWork work )
+{
+    TRACE( "iface %p, level %u, source %u, platform_id %s, operation_id %#I64x, work %u.\n", iface, level, source,
+           debugstr_guid(&platform_id), operation_id, work );
+    return valid_trace( level, source ) ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI statics_TraceSynchronousWorkCompletion( IAsyncCausalityTracerStatics *iface,
+                                                              CausalityTraceLevel level, CausalitySource source,
+                                                              CausalitySynchronousWork work )
+{
+    TRACE( "iface %p, level %u, source %u, work %u.\n", iface, level, source, work );
+    return valid_trace( level, source ) ? S_OK : E_INVALIDARG;
+}
+
+/* handlers are kept for a listener coming and going, which never happens here */
+static HRESULT WINAPI statics_add_TracingStatusChanged( IAsyncCausalityTracerStatics *iface,
+                                                        IEventHandler_TracingStatusChangedEventArgs *handler,
+                                                        EventRegistrationToken *token )
+{
+    struct status_handler *entry;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!handler || !token) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    IEventHandler_TracingStatusChangedEventArgs_AddRef( (entry->handler = handler) );
+    EnterCriticalSection( &handlers_cs );
+    entry->token.value = next_token++;
+    list_add_tail( &status_handlers, &entry->entry );
+    LeaveCriticalSection( &handlers_cs );
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_remove_TracingStatusChanged( IAsyncCausalityTracerStatics *iface,
+                                                           EventRegistrationToken token )
+{
+    struct status_handler *entry;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    EnterCriticalSection( &handlers_cs );
+    LIST_FOR_EACH_ENTRY( entry, &status_handlers, struct status_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        LeaveCriticalSection( &handlers_cs );
+        IEventHandler_TracingStatusChangedEventArgs_Release( entry->handler );
+        free( entry );
+        return S_OK;
+    }
+    LeaveCriticalSection( &handlers_cs );
+    /* a token that is not there is no error */
+    return S_OK;
+}
+
+static const struct IAsyncCausalityTracerStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    statics_TraceOperationCreation,
+    statics_TraceOperationCompletion,
+    statics_TraceOperationRelation,
+    statics_TraceSynchronousWorkStart,
+    statics_TraceSynchronousWorkCompletion,
+    statics_add_TracingStatusChanged,
+    statics_remove_TracingStatusChanged,
+};
+
+static struct causality_tracer causality_tracer =
+{
+    { &factory_vtbl },
+    { &statics_vtbl },
+};
+
+IActivationFactory *causality_tracer_factory = &causality_tracer.IActivationFactory_iface;
