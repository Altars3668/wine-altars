From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 10:48:47 -0400
Subject: [PATCH] msxml3: Link the attribute declarations of each element in
 the DTD validation uses.

Validation runs on a libxml2 copy of the document, whose DTD is copied
with xmlCopyDtd().  That leaves each element declaration without the list
of its attributes' declarations ("TODO : rebuild the attribute list on
the copy"), which is where libxml2 looks for #REQUIRED attributes, so a
missing one was never noticed: validate() said a document lacking a
required attribute was valid, where Windows answers S_FALSE.  Link the
declarations as xmlAddAttributeDecl() does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 7d6e2cd0657..77d2c8d2637 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -4880,6 +4880,37 @@ static xmlNodePtr create_xmlnode_element(struct xmldoc_context *context, struct
     return xmlnode;
 }
 
+/* xmlCopyDtd() leaves each element declaration without the list of its attributes' declarations,
+ * which is where validation looks for the #REQUIRED ones: link them as xmlAddAttributeDecl() does */
+static void xmldtd_link_attribute_decls(xmlDtdPtr dtd)
+{
+    xmlAttributePtr attr, tmp;
+    xmlElementPtr elem;
+    xmlNodePtr decl;
+
+    for (decl = dtd->children; decl; decl = decl->next)
+    {
+        if (decl->type != XML_ATTRIBUTE_DECL) continue;
+        attr = (xmlAttributePtr)decl;
+        if (!attr->elem || !(elem = xmlGetDtdElementDesc(dtd, attr->elem))) continue;
+        attr->nexth = NULL;
+        if (xmlStrEqual(attr->name, BAD_CAST "xmlns") || xmlStrEqual(attr->prefix, BAD_CAST "xmlns"))
+        {
+            attr->nexth = elem->attributes;
+            elem->attributes = attr;
+            continue;
+        }
+        tmp = elem->attributes;
+        while (tmp && xmlStrEqual(tmp->name, BAD_CAST "xmlns") && tmp->nexth) tmp = tmp->nexth;
+        if (tmp)
+        {
+            attr->nexth = tmp->nexth;
+            tmp->nexth = attr;
+        }
+        else elem->attributes = attr;
+    }
+}
+
 static xmlDtdPtr create_xmldtd_from_domnode(struct domnode *node)
 {
     struct string_buffer buffer;
@@ -4897,8 +4928,8 @@ static xmlDtdPtr create_xmldtd_from_domnode(struct domnode *node)
     doc = xmlParseMemory((const char *)str, SysStringByteLen(str));
     SysFreeString(str);
 
-    if ((dtd = xmlGetIntSubset(doc)))
-        dtd = xmlCopyDtd(dtd);
+    if ((dtd = xmlGetIntSubset(doc)) && (dtd = xmlCopyDtd(dtd)))
+        xmldtd_link_attribute_decls(dtd);
     xmlFreeDoc(doc);
 
     return dtd;
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index 920231ea0a4..ca1bf1d022b 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -18820,11 +18820,9 @@ static void test_dtd_validation(void)
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     err = NULL;
     hr = IXMLDOMDocument2_validate(doc, &err);
-    todo_wine
     ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
     res = 0;
     hr = IXMLDOMParseError_get_errorCode(err, &res);
-    todo_wine
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     /* XML_REQUIRED_ATTRIBUTE_MISSING */
     todo_wine ok(res == 0xC00CE020, "Unexpected code %#lx.\n", res);
