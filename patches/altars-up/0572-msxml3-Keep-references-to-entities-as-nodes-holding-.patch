+#define check_parse_error_at(a, b, c, d, e, f) check_parse_error_at_(__LINE__, a, b, c, d, e, f)
+static void check_parse_error_at_(unsigned int line, IXMLDOMDocument2 *doc, LONG code, LONG eline, LONG linepos,
+        LONG filepos, const WCHAR *src)
+{
+    LONG value, pos, epos, fpos;
+    IXMLDOMParseError *error;
+    BSTR text = NULL;
+
+    IXMLDOMDocument2_get_parseError(doc, &error);
+    value = pos = epos = fpos = -1;
+    IXMLDOMParseError_get_errorCode(error, &value);
+    IXMLDOMParseError_get_line(error, &pos);
+    IXMLDOMParseError_get_linepos(error, &epos);
+    IXMLDOMParseError_get_filepos(error, &fpos);
+    IXMLDOMParseError_get_srcText(error, &text);
+    ok_(__FILE__, line)(value == code, "Unexpected error code %#lx.\n", value);
+    ok_(__FILE__, line)(pos == eline && epos == linepos && fpos == filepos, "Unexpected position %ld:%ld, %ld.\n",
+            pos, epos, fpos);
+    if (src) ok_(__FILE__, line)(text && !wcscmp(text, src), "Unexpected source %s.\n", debugstr_w(text));
+    SysFreeString(text);
+    IXMLDOMParseError_Release(error);
+}
