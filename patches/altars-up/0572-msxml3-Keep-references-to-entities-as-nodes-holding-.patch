+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        hr = IXMLDOMNode_put_text(ref, _bstr_("z"));
+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        hr = IXMLDOMNode_put_text(child, _bstr_("z"));
+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        hr = IXMLDOMText_appendData((IXMLDOMText *)child, _bstr_("z"));
+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        check_xml_text(ref, L"&e;", L"x");
+        IXMLDOMNode_Release(child);
+
+        other = get_child(root, 3);
+        child = get_child(other, 0);
+        IXMLDOMNode_Release(other);
+        IXMLDOMNode_QueryInterface(child, &IID_IXMLDOMElement, (void **)&element);
+        V_VT(&v) = VT_BSTR;
+        V_BSTR(&v) = _bstr_("1");
+        hr = IXMLDOMElement_setAttribute(element, _bstr_("x"), v);
+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        other = NULL;
+        hr = IXMLDOMElement_appendChild(element, node, &other);
+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        IXMLDOMElement_Release(element);
+        IXMLDOMNode_Release(child);
+
+        hr = IXMLDOMNode_cloneNode(ref, VARIANT_TRUE, &clone);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(get_child_count(clone) == 1, "Unexpected count %ld.\n", get_child_count(clone));
+        hr = IXMLDOMNode_appendChild(clone, node, &other);
+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        child = get_child(clone, 0);
+        hr = IXMLDOMNode_put_nodeValue(child, v);
+        ok(hr == (v6 ? E_FAIL : S_OK), "Unexpected hr %#lx.\n", hr);
+        IXMLDOMNode_Release(child);
+        IXMLDOMNode_Release(clone);
+        hr = IXMLDOMNode_cloneNode(ref, VARIANT_FALSE, &clone);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(get_child_count(clone) == (v6 ? 1 : 0), "Unexpected count %ld.\n", get_child_count(clone));
+        IXMLDOMNode_Release(clone);
+
+        IXMLDOMNode_QueryInterface(root, &IID_IXMLDOMElement, (void **)&element);
+        IXMLDOMElement_getAttributeNode(element, _bstr_("a"), (IXMLDOMAttribute **)&attr);
+        V_BSTR(&v) = _bstr_("new");
+        hr = IXMLDOMNode_put_nodeValue(attr, v);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_xml_text(attr, L"a=\"new\"", L"new");
+        IXMLDOMNode_Release(attr);
+        IXMLDOMElement_Release(element);
+
+        /* the reference itself may move */
+        hr = IXMLDOMNode_removeChild(root, ref, &other);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        IXMLDOMNode_Release(other);
+        check_xml_text(root, L"<r a=\"new\">pq&m;</r>", L"pqy");
+        IXMLDOMDocument2_createElement(doc, _bstr_("h"), &element);
+        hr = IXMLDOMElement_appendChild(element, ref, &other);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        IXMLDOMNode_Release(other);
+        check_xml_text(element, L"<h>&e;</h>", L"x");
+        hr = IXMLDOMNode_appendChild(ref, node, &other);
+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        IXMLDOMElement_Release(element);
+        IXMLDOMNode_Release(ref);
+
+        hr = IXMLDOMDocument2_createEntityReference(doc, _bstr_("e"), &created);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_children(created, "T(x)");
+        child = get_child((IXMLDOMNode *)created, 0);
+        hr = IXMLDOMNode_put_nodeValue(child, v);
+        ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+        IXMLDOMNode_Release(child);
+        IXMLDOMEntityReference_Release(created);
+        hr = IXMLDOMDocument2_createEntityReference(doc, _bstr_("zz"), &created);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_xml_text(created, L"&zz;", L"");
+        IXMLDOMEntityReference_Release(created);
+
+        hr = IXMLDOMNode_put_text(root, _bstr_("z"));
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_xml_text(root, L"<r a=\"new\">z</r>", L"z");
+        IXMLDOMNode_Release(node);
+        IXMLDOMNode_Release(root);
+        IXMLDOMDocument2_Release(doc);
+
+        /* normalize joins text, not across references */
+        sprintf(xml, "%s<r>x&e;&e;y</r>", dtd);
+        doc = load_entity_document(documents[i].clsid, documents[i].name, xml, FALSE, FALSE);
+        root = get_root(doc);
+        IXMLDOMNode_QueryInterface(root, &IID_IXMLDOMElement, (void **)&element);
+        hr = IXMLDOMElement_normalize(element);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_children(root, "T(x) R(e)[T(x)] R(e)[T(x)] T(y)");
+        IXMLDOMElement_Release(element);
+        IXMLDOMNode_Release(root);
+        IXMLDOMDocument2_Release(doc);
+
+        /* the text of every declaration is read when the DTD ends, where errors in it are */
+        doc = _create_object(documents[i].clsid, documents[i].name, &IID_IXMLDOMDocument2, __LINE__);
+        V_VT(&v) = VT_BOOL;
+        V_BOOL(&v) = VARIANT_FALSE;
+        IXMLDOMDocument2_setProperty(doc, _bstr_("ProhibitDTD"), v);
+        IXMLDOMDocument2_put_validateOnParse(doc, VARIANT_FALSE);
+        hr = IXMLDOMDocument2_loadXML(doc, _bstr_("<!DOCTYPE r [<!ENTITY u \"&zz;\">]><r/>"), &loaded);
+        ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+        check_parse_error_at(doc, 0xc00ce002 /* XML_ENTITY_UNDEFINED */, 1, 2, 1, L"&zz;");
+        sprintf(xml, "%s<r a=\"&m;\"/>", dtd);
+        hr = IXMLDOMDocument2_loadXML(doc, _bstr_(xml), &loaded);
+        ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+        check_parse_error_at(doc, 0xc00ce506 /* XML_BADCHARINSTRING */, 1, 182, 181, NULL);
+
+        /* external entities are loaded when the DTD ends, used or not, when resolving them */
+        hr = IXMLDOMDocument2_get_resolveExternals(doc, &loaded);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(loaded == (v6 ? VARIANT_FALSE : VARIANT_TRUE), "Unexpected value %d.\n", loaded);
+        IXMLDOMDocument2_put_resolveExternals(doc, VARIANT_TRUE);
+        hr = IXMLDOMDocument2_loadXML(doc, _bstr_("<!DOCTYPE r [<!ENTITY x SYSTEM \"wine-missing-x\">]><r/>"), &loaded);
+        ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+        check_parse_error_at(doc, v6 ? 0xc00ce009 : 0x800c0006 /* INET_E_OBJECT_NOT_FOUND */, 1, 51, 50, NULL);
+        IXMLDOMDocument2_put_resolveExternals(doc, VARIANT_FALSE);
+        hr = IXMLDOMDocument2_loadXML(doc, _bstr_("<!DOCTYPE r [<!ENTITY x SYSTEM \"wine-missing-x\">]><r/>"), &loaded);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        IXMLDOMDocument2_Release(doc);
+
+        free_bstrs();
+        winetest_pop_context();
+    }
+}
