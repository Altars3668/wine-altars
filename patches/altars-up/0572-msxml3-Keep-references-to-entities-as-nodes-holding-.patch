+/* What is in an entity reference or declaration may not change, nor may what an entity reference
+ * holds (Windows 11). */
+static bool domnode_is_readonly(const struct domnode *node)
+{
+    return node->flags & DOMNODE_READONLY;
+}
+
+static bool domnode_children_readonly(const struct domnode *node)
+{
+    return node->type == NODE_ENTITY_REFERENCE || node->type == NODE_ENTITY || domnode_is_readonly(node);
+}
+
 HRESULT node_append_data(struct domnode *node, BSTR data)
 {
     UINT len, current;
     BSTR str;
 
+    if (domnode_is_readonly(node))
+        return E_FAIL;
+
     if (!(len = SysStringLen(data)))
         return S_OK;
 
@@ -633,6 +648,9 @@ HRESULT node_insert_before(struct domnode *node, IXMLDOMNode *new_child, const V
     if (!(child_node = get_node_obj(new_child)))
