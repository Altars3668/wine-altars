+/* MSXML reads the replacement text of each internal entity on its own when the DTD ends, for the
+ * nodes of its declaration, and finds what is wrong in it even when nothing refers to the entity:
+ * where it is in that text.  The DOM is told which entity the events between belong to. */
+static void saxreader_parse_entity_content(struct saxlocator *locator, struct entity_decl *entity)
+{
+    struct saxextensionhandler_iface *handler = saxreader_get_extensionhandler(locator->saxreader);
+    ISequentialStream *stream;
+    struct saxlocator *text;
+    HRESULT hr;
+
+    if (FAILED(hr = stream_wrapper_create(entity->value, SysStringByteLen(entity->value), &stream)))
+        return saxreader_set_error(locator, hr);
+    hr = saxlocator_create(locator->saxreader, stream, locator->vbInterface, &text);
+    ISequentialStream_Release(stream);
+    if (FAILED(hr))
+        return saxreader_set_error(locator, hr);
+
+    text->dtd = parser_dtd_addref(locator->dtd);
+    text->dtd_external = locator->dtd_external;
+    text->dtd_pe_references = locator->dtd_pe_references;
+    text->string_input = true;
+    text->entity_content = true;
+    text->state = SAX_PARSER_CONTENT;
+    saxreader_detect_encoding(text, true);
+
+    if (text->status == S_OK && FAILED(hr = ISAXExtensionHandler_startEntityContent(handler->handler,
+            entity->name, entity->value)))
+        saxreader_set_error(text, hr);
+    entity->visited = true;
+    saxreader_parse_content(text);
+    entity->visited = false;
+    if (text->status == S_OK && FAILED(hr = ISAXExtensionHandler_endEntityContent(handler->handler)))
+        saxreader_set_error(text, hr);
+
+    if (text->status != S_OK)
+    {
+        saxreader_fatal_error(text);
+        saxreader_set_error(locator, text->status);
+    }
+    ISAXLocator_Release(&text->ISAXLocator_iface);
+}
+
+static void saxreader_parse_entity_contents(struct saxlocator *locator)
+{
+    struct entity_decl *entity;
+
+    if (!(locator->saxreader->features & DOMReader) || !locator->dtd || locator->vbInterface
+            || !saxreader_has_handler(locator, SAXExtensionHandler))
+        return;
+
+    LIST_FOR_EACH_ENTRY(entity, &locator->dtd->entities, struct entity_decl, entry)
+    {
+        HRESULT hr;
+
+        if (locator->status != S_OK) break;
+        if (entity->unparsed || entity->name[0] == '%') continue;
+        /* resolving externals, the external ones are loaded too, used or not: what fails, fails
+           where the DTD ends */
+        if (!entity->value && entity->sysid && (locator->saxreader->features & ExternalGeneralEntities)
+                && FAILED(hr = saxreader_load_external_entity(locator, entity)))
+        {
+            /* MSXML 3 gives the error of the download, a file not there as an object not found;
+               MSXML 6 its own (Windows 11) */
+            if (hr == INET_E_RESOURCE_NOT_FOUND) hr = INET_E_OBJECT_NOT_FOUND;
+            locator->line = locator->buffer.position.line;
+            locator->column = locator->buffer.position.column;
+            saxreader_set_error(locator, (locator->saxreader->features & DOMVersion6) ? E_XML_ENTITY_LOAD : hr);
+            break;
+        }
+        if (!entity->value || !*entity->value) continue;
+        saxreader_parse_entity_content(locator, entity);
+    }
+}
