+        { "m", L"<!ENTITY m \"\">", "E(b)[T(y)]", L"y" },
+        { "n", L"<!ENTITY n \"a&e;b\">", "T(a) R(e)[T(x)] T(b)", L"axb" },
+        { "s", L"<!ENTITY s \"\">", "", L"" },
+        { "w", L"<!ENTITY w \"\">", "", L"" },
+        { "k", L"<!ENTITY k \"x\">", "M T(x) P(p)", L"x" },
+        { "c", L"<!ENTITY c \"AB\">", "T(AB)", L"AB" },
+        { "t", L"<!ENTITY t \"  x  \">", "T(  x  )", L"x" },
