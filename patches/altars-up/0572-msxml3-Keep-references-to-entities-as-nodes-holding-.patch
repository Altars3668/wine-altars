+        return E_FAIL;
+
     if (ret)
         hr = create_node(attr, ret);
 
@@ -1347,6 +1377,8 @@ struct domdoc_properties *domdoc_create_properties(MSXML_VERSION version)
     properties->allow_xslt_script = version != MSXML6;
     properties->allow_document_function = version != MSXML6;
