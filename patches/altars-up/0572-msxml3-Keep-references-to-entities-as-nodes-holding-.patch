+static void node_dump_entity_decl(struct domnode *node, struct node_dump_context *context)
+{
+    struct domnode *n;
+
+    node_dump_append(context, L"<!ENTITY ", 9);
+    node_dump_append(context, node->name, SysStringLen(node->name));
+    if (list_empty(&node->attributes))
