+        return E_FAIL;
+
     switch (V_VT(ref_child))
     {
         case VT_EMPTY:
@@ -691,6 +709,9 @@ HRESULT node_replace_child(struct domnode *node, IXMLDOMNode *newChild, IXMLDOMN
     if (!(new_child = get_node_obj(newChild)))
         return E_FAIL;
 
