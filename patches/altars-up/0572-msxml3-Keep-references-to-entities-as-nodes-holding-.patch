+static IXMLDOMDocument2 *load_entity_document(const GUID *clsid, const char *name, const char *xml,
+        BOOL validate, BOOL preserve)
+{
+    IXMLDOMDocument2 *doc = _create_object(clsid, name, &IID_IXMLDOMDocument2, __LINE__);
+    VARIANT_BOOL loaded = 0x55;
+    HRESULT hr;
+    VARIANT v;
+
+    V_VT(&v) = VT_BOOL;
+    V_BOOL(&v) = VARIANT_FALSE;
+    IXMLDOMDocument2_setProperty(doc, _bstr_("ProhibitDTD"), v);
+    IXMLDOMDocument2_put_validateOnParse(doc, validate ? VARIANT_TRUE : VARIANT_FALSE);
+    IXMLDOMDocument2_put_preserveWhiteSpace(doc, preserve ? VARIANT_TRUE : VARIANT_FALSE);
+    hr = IXMLDOMDocument2_loadXML(doc, _bstr_(xml), &loaded);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(loaded == VARIANT_TRUE, "Unexpected result %d.\n", loaded);
+    return doc;
+}
+
+static IXMLDOMNode *get_root(IXMLDOMDocument2 *doc)
+{
+    IXMLDOMElement *root = NULL;
+
+    IXMLDOMDocument2_get_documentElement(doc, &root);
+    return (IXMLDOMNode *)root;
+}
