 }
@@ -1509,6 +1541,15 @@ static HRESULT clone_domnode(struct domnode *node, bool deep, struct domnode *ow
     if (node->data)
         object->data = SysAllocStringLen(node->data, SysStringLen(node->data));
 
+    /* MSXML 6 keeps what was in an entity reference from changing in a copy too, and gives a shallow
+       copy of a reference the entity's nodes again; MSXML 3 copies them as they are, or not at all */
+    if (node->type != NODE_DOCUMENT && domdoc_version(node_get_doc(object)) >= MSXML6)
+    {
+        object->flags |= node->flags & DOMNODE_READONLY;
+        if (node->type == NODE_ENTITY_REFERENCE && !deep)
+            domnode_fill_entity_reference(object);
+    }
+
     *cloned = object;
 
     return hr;
@@ -1519,6 +1560,93 @@ HRESULT node_clone_domnode(struct domnode *node, bool deep, struct domnode **clo
     return clone_domnode(node, deep, NULL, cloned);
 }
 
+/* the declaration of a general entity in the DTD of the document a node is in */
+struct domnode *domnode_get_entity_decl(struct domnode *node, const WCHAR *name)
+{
+    struct domnode *doc = node_get_doc(node), *child, *decl;
+
+    if (!name) return NULL;
+    LIST_FOR_EACH_ENTRY(child, &doc->children, struct domnode, entry)
+    {
+        if (child->type != NODE_DOCUMENT_TYPE) continue;
+        LIST_FOR_EACH_ENTRY(decl, &child->children, struct domnode, entry)
+        {
+            if (decl->type == NODE_ENTITY && decl->name && !wcscmp(decl->name, name))
+                return decl;
+        }
+    }
+    return NULL;
+}
+
+/* A copy of a node of an entity's declaration for a reference to it, which may not change either,
+ * with the spaces left out of it; for validation it is where the reference is. */
+static HRESULT domnode_copy_entity_node(const struct domnode *node, const struct domnode *ref, struct domnode **copy)
+{
+    struct domnode *object, *n, *child;
+    HRESULT hr;
+
+    *copy = NULL;
+    if (FAILED(hr = domnode_create(node->type, node->qname, SysStringLen(node->qname), node->uri,
+            SysStringLen(node->uri), ref->owner, &object)))
+        return hr;
+
+    object->flags = (node->flags & (DOMNODE_READONLY_VALUE | DOMNODE_IGNORED_WS_AFTER_STARTTAG | DOMNODE_IGNORED_WS
+            | DOMNODE_PARSED_VALUE | DOMNODE_NS_DECL)) | DOMNODE_READONLY;
+    object->parse_line = ref->parse_line;
+    object->parse_end_column = ref->parse_end_column;
+    object->parse_start_line = ref->parse_start_line;
+    object->parse_start_column = ref->parse_start_column;
+    if (node->data && !(object->data = SysAllocStringLen(node->data, SysStringLen(node->data))))
+        hr = E_OUTOFMEMORY;
+
+    LIST_FOR_EACH_ENTRY(n, &node->attributes, struct domnode, entry)
+    {
+        if (FAILED(hr) || FAILED(hr = domnode_copy_entity_node(n, ref, &child))) break;
+        domnode_insert_attribute(object, child, NULL);
+    }
+    LIST_FOR_EACH_ENTRY(n, &node->children, struct domnode, entry)
+    {
+        if (FAILED(hr) || FAILED(hr = domnode_copy_entity_node(n, ref, &child))) break;
+        domnode_append_child(object, child);
+    }
+
+    if (FAILED(hr))
+    {
+        domnode_destroy_tree(object);
+        return hr;
+    }
+    *copy = object;
+    return S_OK;
+}
+
+/* The nodes of a reference to an entity are those of the entity's declaration, copied; it has none
+ * when the entity is not declared. */
+HRESULT domnode_fill_entity_reference(struct domnode *ref)
+{
+    struct domnode *decl = domnode_get_entity_decl(ref, ref->name), *n, *copy;
+    HRESULT hr;
+
+    if (!decl) return S_OK;
+    ref->flags |= decl->flags & DOMNODE_IGNORED_WS_AFTER_STARTTAG;
+    LIST_FOR_EACH_ENTRY(n, &decl->children, struct domnode, entry)
+    {
+        if (FAILED(hr = domnode_copy_entity_node(n, ref, &copy))) return hr;
+        domnode_append_child(ref, copy);
+    }
+    return S_OK;
+}
+
+static void domnode_set_readonly(struct domnode *node)
+{
+    struct domnode *n;
+
+    node->flags |= DOMNODE_READONLY;
