+    struct domnode *ref, *text;
+    bool copied;
+
+    while (p < end && c->status == S_OK)
+    {
+        start = p;
+        if (*p == 0xffff)
+        {
+            for (start = ++p; p < end && *p != 0xfffe; ++p);
+            ref = parse_context_create_entity_reference(c, attr, start, p - start, &copied);
+            if (ref && !copied) domnode_set_readonly(ref);
+            if (p < end) ++p;
+            continue;
+        }
+        while (p < end && *p != 0xffff) ++p;
+        parse_context_node_create(c, NODE_TEXT, NULL, 0, NULL, 0, c->root, &text);
+        if (!text) break;
+        domnode_append_child(attr, text);
+        if (!(text->data = SysAllocStringLen(start, p - start))) c->status = E_OUTOFMEMORY;
+    }
+}
