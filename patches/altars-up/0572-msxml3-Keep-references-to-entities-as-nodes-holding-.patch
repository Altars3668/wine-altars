+/* the nodes below one: T(text), M for a comment, P(target), E(name)[...], R(name)[...] for an entity reference */
+static void dump_children(IXMLDOMNode *node, char *buf, size_t size)
+{
+    IXMLDOMNode *child = NULL, *next;
+    char str[64];
+    DOMNodeType type;
+    VARIANT value;
+    size_t len;
+    BSTR name;
+
+    IXMLDOMNode_get_firstChild(node, &child);
+    while (child)
+    {
+        len = strlen(buf);
+        if (len && buf[len - 1] != '[') strcat(buf, " ");
+        len = strlen(buf);
+        IXMLDOMNode_get_nodeType(child, &type);
+        IXMLDOMNode_get_nodeName(child, &name);
+        WideCharToMultiByte(CP_ACP, 0, name, -1, str, sizeof(str), NULL, NULL);
+        SysFreeString(name);
+        switch (type)
+        {
+        case NODE_TEXT:
+            VariantInit(&value);
+            IXMLDOMNode_get_nodeValue(child, &value);
+            WideCharToMultiByte(CP_ACP, 0, V_BSTR(&value), -1, str, sizeof(str), NULL, NULL);
+            VariantClear(&value);
+            snprintf(buf + len, size - len, "T(%s)", str);
+            break;
+        case NODE_COMMENT:
+            snprintf(buf + len, size - len, "M");
+            break;
+        case NODE_PROCESSING_INSTRUCTION:
+            snprintf(buf + len, size - len, "P(%s)", str);
+            break;
+        default:
+            snprintf(buf + len, size - len, "%c(%s)", type == NODE_ENTITY_REFERENCE ? 'R' : 'E', str);
+            next = NULL;
+            IXMLDOMNode_get_firstChild(child, &next);
+            if (next)
+            {
+                IXMLDOMNode_Release(next);
+                strcat(buf, "[");
+                dump_children(child, buf, size);
+                strcat(buf, "]");
+            }
+        }
+        next = NULL;
+        IXMLDOMNode_get_nextSibling(child, &next);
+        IXMLDOMNode_Release(child);
+        child = next;
+    }
+}
+
+#define check_children(a, b) check_children_(__LINE__, (IXMLDOMNode *)(a), b)
+static void check_children_(unsigned int line, IXMLDOMNode *node, const char *expect)
+{
+    char buf[512] = "";
+
+    dump_children(node, buf, sizeof(buf));
+    ok_(__FILE__, line)(!strcmp(buf, expect), "Unexpected nodes %s.\n", buf);
+}
+
+#define check_xml_text(a, b, c) check_xml_text_(__LINE__, (IXMLDOMNode *)(a), b, c)
+static void check_xml_text_(unsigned int line, IXMLDOMNode *node, const WCHAR *xml, const WCHAR *text)
+{
+    BSTR str;
+    HRESULT hr;
+
+    hr = IXMLDOMNode_get_xml(node, &str);
+    ok_(__FILE__, line)(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(!wcscmp(str, xml), "Unexpected xml %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    if (!text) return;
+    hr = IXMLDOMNode_get_text(node, &str);
+    ok_(__FILE__, line)(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(str && !wcscmp(str, text), "Unexpected text %s.\n", debugstr_w(str));
+    SysFreeString(str);
+}
+
+static IXMLDOMNode *get_child(IXMLDOMNode *node, LONG index)
+{
+    IXMLDOMNodeList *list = NULL;
+    IXMLDOMNode *child = NULL;
+
+    IXMLDOMNode_get_childNodes(node, &list);
+    if (!list) return NULL;
+    IXMLDOMNodeList_get_item(list, index, &child);
+    IXMLDOMNodeList_Release(list);
+    return child;
+}
+
+static LONG get_child_count(IXMLDOMNode *node)
+{
+    IXMLDOMNodeList *list = NULL;
+    LONG length = -1;
+
+    IXMLDOMNode_get_childNodes(node, &list);
+    if (!list) return -1;
+    IXMLDOMNodeList_get_length(list, &length);
+    IXMLDOMNodeList_Release(list);
+    return length;
+}
