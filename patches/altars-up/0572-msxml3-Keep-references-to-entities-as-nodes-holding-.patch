+            saxreader_parse_chardata(locator);
+        }
+    }
+
+    /* the entities whose text ended it */
+    while (locator->status == S_OK && !list_empty(&locator->buffer.entities))
+    {
+        entity = LIST_ENTRY(list_head(&locator->buffer.entities), struct entity_decl, input_entry);
+        if (entity->remaining) break;
+        saxreader_pop_entity(locator);
+    }
+
+    if (locator->status == S_OK && !list_empty(&locator->elements))
+    {
+        locator->line = locator->column = 0;
+        saxreader_set_error(locator, locator->saxreader->version >= MSXML4 ? E_SAX_INPUTEND : E_SAX_UNCLOSEDTAG);
+    }
+}
