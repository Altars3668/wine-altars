index 08b31e510cf..9547efa22bf 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -118,7 +118,6 @@ struct domdoc
     BOOL free_threaded;         /* created as one of the FreeThreadedDOMDocument classes */
     IMoniker *moniker;          /* what IPersistMoniker::Load was given */
     VARIANT_BOOL async;
-    VARIANT_BOOL resolving;
     HRESULT error;
     struct parse_error parse_error;
     LONG ready_state;
@@ -309,13 +308,14 @@ static void domdoc_set_parse_error(domdoc *doc, struct parse_error *error)
     doc->parse_error = *error;
 }
 
-/* the line an error is on and where in the text it is, from the text parsed */
-static void parse_error_set_source(struct parse_error *error, const WCHAR *text, size_t len)
+/* the line an error is on and where in the text it is, from the text parsed; an error in the text of
+   an entity has that already */
+void parse_error_set_source(struct parse_error *error, const WCHAR *text, size_t len)
 {
     size_t start = 0, end, i;
     LONG line = 1;
 
-    if (!error->code || error->line <= 0 || !text || error->nosource) return;
+    if (!error->code || error->line <= 0 || !text || error->nosource || error->srctext) return;
     for (i = 0; i < len && line < error->line; i++)
     {
         if (text[i] == '\r' && i + 1 < len && text[i + 1] == '\n') i++;
@@ -337,7 +337,7 @@ static void parse_error_set_source_bytes(struct parse_error *error, const BYTE *
     WCHAR *text;
     int len;
 
-    if (!error->code || error->line <= 0 || !data || !size || error->nosource) return;
+    if (!error->code || error->line <= 0 || !data || !size || error->nosource || error->srctext) return;
     if (size >= 2 && data[0] == 0xff && data[1] == 0xfe)
         return parse_error_set_source(error, (const WCHAR *)(data + 2), (size - 2) / sizeof(WCHAR));
     if (size >= 2 && data[0] && !data[1])
@@ -1347,6 +1347,13 @@ static HRESULT WINAPI domdoc_createNode(IXMLDOMDocument3 *iface, VARIANT type, B
         return hr;
     }
 
+    /* a reference has the nodes of the entity's declaration, which may not change */
+    if (node_type == NODE_ENTITY_REFERENCE && FAILED(hr = domnode_fill_entity_reference(domnode)))
+    {
+        domnode_destroy_tree(domnode);
+        return hr;
+    }
+
     return create_node(domnode, node);
 }
 
@@ -1826,7 +1833,7 @@ static HRESULT WINAPI domdoc_get_resolveExternals(IXMLDOMDocument3 *iface, VARIA
 
     TRACE("%p, %p.\n", iface, v);
 
-    *v = doc->resolving;
+    *v = doc->node->properties->resolve_externals ? VARIANT_TRUE : VARIANT_FALSE;
     return S_OK;
 }
 
@@ -1836,7 +1843,6 @@ static HRESULT WINAPI domdoc_put_resolveExternals(IXMLDOMDocument3 *iface, VARIA
 
     TRACE("%p, %d.\n", iface, v);
 
-    doc->resolving = v;
     doc->node->properties->resolve_externals = v != VARIANT_FALSE;
     return S_OK;
 }
@@ -2090,7 +2096,6 @@ static HRESULT WINAPI domdoc_setProperty(IXMLDOMDocument3 *iface, BSTR p, VARIAN
         else if (!wcsicmp(p, L"AllowDocumentFunction")) flag = &properties->allow_document_function;
         else flag = &properties->use_inline_schema;
