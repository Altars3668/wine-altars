+    if (!ref) return NULL;
+    if (parent->type == NODE_ATTRIBUTE)
+        domnode_append_child(parent, ref);
+    else
+        parse_context_append_child(c, parent, ref);
+    parse_context_get_position(c, &ref->parse_start_line, &ref->parse_start_column);
+    ref->parse_line = ref->parse_start_line;
