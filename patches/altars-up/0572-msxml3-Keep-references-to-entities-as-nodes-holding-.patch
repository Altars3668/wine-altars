+/* the DTD among node(), the spaces of values, the identifiers of declarations (Windows 11) */
+static void test_values_and_declarations(void)
+{
+    static const struct
+    {
+        const GUID *clsid;
+        const char *name;
+        BOOL v6;
+    }
+    documents[] =
+    {
+        { &_create(CLSID_DOMDocument30) },
+        { &_create(CLSID_DOMDocument60), TRUE },
+    };
+    IXMLDOMNode *root, *node;
+    IXMLDOMElement *r;
+    IXMLDOMDocument2 *doc;
+    IXMLDOMEntity *entity;
+    IXMLDOMNotation *notation;
+    unsigned int i, j;
+    HRESULT hr;
+    VARIANT v;
+    BSTR str;
+
+    for (i = 0; i < ARRAY_SIZE(documents); i++)
+    {
+        BOOL v6 = documents[i].v6;
+
+        winetest_push_context("%s", documents[i].name);
+
+
+        /* the text of an attribute leaves out the spaces around it, as that of text does */
+        for (j = 0; j < 2; j++)
+        {
+            doc = load_entity_document(documents[i].clsid, documents[i].name, "<r b=\"  x  \">  x  </r>", FALSE, j);
+            root = get_root(doc);
+            IXMLDOMNode_QueryInterface(root, &IID_IXMLDOMElement, (void **)&r);
+            IXMLDOMElement_getAttributeNode(r, _bstr_("b"), (IXMLDOMAttribute **)&node);
+            check_xml_text(node, L"b=\"  x  \"", j ? L"  x  " : L"x");
+            IXMLDOMNode_Release(node);
+            node = get_child(root, 0);
+            hr = IXMLDOMNode_get_nodeValue(node, &v);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            ok(!wcscmp(V_BSTR(&v), L"  x  "), "Unexpected value %s.\n", debugstr_w(V_BSTR(&v)));
+            VariantClear(&v);
+            check_xml_text(node, L"  x  ", j ? L"  x  " : L"x");
+            IXMLDOMNode_Release(node);
+            IXMLDOMElement_Release(r);
+            IXMLDOMNode_Release(root);
+            IXMLDOMDocument2_Release(doc);
+        }
+
+        /* identifiers as declared */
+        if (v6)
+        {
+            IXMLDOMDocumentType *doctype;
+
+            doc = load_entity_document(documents[i].clsid, documents[i].name,
+                    "<!DOCTYPE r [<!NOTATION n PUBLIC \"pub-id\" \"sys-id\"><!NOTATION n2 SYSTEM \"sys-2\">"
+                    "<!ENTITY u SYSTEM \"sys-u\" NDATA n><!ENTITY x PUBLIC \"pub-x\" \"sys-x\">]><r/>", FALSE, FALSE);
+            IXMLDOMDocument2_get_doctype(doc, &doctype);
+
+            node = get_child((IXMLDOMNode *)doctype, 0);
+            check_xml_text(node, L"<!NOTATION n PUBLIC \"pub-id\" \"sys-id\">", NULL);
+            IXMLDOMNode_QueryInterface(node, &IID_IXMLDOMNotation, (void **)&notation);
+            hr = IXMLDOMNotation_get_publicId(notation, &v);
+            ok(hr == S_OK && V_VT(&v) == VT_BSTR && !wcscmp(V_BSTR(&v), L"pub-id"), "Unexpected hr %#lx, id %s.\n",
+                    hr, debugstr_variant(&v));
+            VariantClear(&v);
+            hr = IXMLDOMNotation_get_systemId(notation, &v);
+            ok(hr == S_OK && V_VT(&v) == VT_BSTR && !wcscmp(V_BSTR(&v), L"sys-id"), "Unexpected hr %#lx, id %s.\n",
+                    hr, debugstr_variant(&v));
+            VariantClear(&v);
+            IXMLDOMNotation_Release(notation);
+            IXMLDOMNode_Release(node);
+
+            node = get_child((IXMLDOMNode *)doctype, 1);
+            check_xml_text(node, L"<!NOTATION n2 SYSTEM \"sys-2\">", NULL);
+            IXMLDOMNode_QueryInterface(node, &IID_IXMLDOMNotation, (void **)&notation);
+            hr = IXMLDOMNotation_get_publicId(notation, &v);
+            ok(hr == S_FALSE && V_VT(&v) == VT_BSTR && !V_BSTR(&v), "Unexpected hr %#lx, id %s.\n",
+                    hr, debugstr_variant(&v));
+            IXMLDOMNotation_Release(notation);
+            IXMLDOMNode_Release(node);
+
+            node = get_child((IXMLDOMNode *)doctype, 2);
+            check_xml_text(node, L"<!ENTITY u SYSTEM \"sys-u\" NDATA n>", NULL);
+            IXMLDOMNode_QueryInterface(node, &IID_IXMLDOMEntity, (void **)&entity);
+            hr = IXMLDOMEntity_get_systemId(entity, &v);
+            ok(hr == S_OK && V_VT(&v) == VT_BSTR && !wcscmp(V_BSTR(&v), L"sys-u"), "Unexpected hr %#lx, id %s.\n",
+                    hr, debugstr_variant(&v));
+            VariantClear(&v);
+            hr = IXMLDOMEntity_get_notationName(entity, &str);
+            ok(hr == S_OK && !wcscmp(str, L"n"), "Unexpected hr %#lx, name %s.\n", hr, debugstr_w(str));
+            SysFreeString(str);
+            IXMLDOMEntity_Release(entity);
+            IXMLDOMNode_Release(node);
+
+            node = get_child((IXMLDOMNode *)doctype, 3);
+            check_xml_text(node, L"<!ENTITY x PUBLIC \"pub-x\" \"sys-x\">", NULL);
+            IXMLDOMNode_QueryInterface(node, &IID_IXMLDOMEntity, (void **)&entity);
+            str = (BSTR)0xdeadbeef;
+            hr = IXMLDOMEntity_get_notationName(entity, &str);
+            ok(hr == S_FALSE && !str, "Unexpected hr %#lx, name %s.\n", hr, debugstr_w(str));
+            IXMLDOMEntity_Release(entity);
+            IXMLDOMNode_Release(node);
+
+            IXMLDOMDocumentType_Release(doctype);
+            IXMLDOMDocument2_Release(doc);
+        }
+
+        free_bstrs();
+        winetest_pop_context();
+    }
+}
