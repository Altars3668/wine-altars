+        if (!wcscmp(n->name, L"NDATA"))
+        {
+            node_dump_append(context, L" NDATA ", 7);
+            node_dump_append(context, value, SysStringLen(value));
+        }
+        else
+        {
+            if (!wcscmp(n->name, L"PUBLIC")) public = true;
+            if (!public || wcscmp(n->name, L"SYSTEM"))
+            {
+                node_dump_append(context, L" ", 1);
+                node_dump_append(context, n->name, SysStringLen(n->name));
+            }
+            node_dump_append(context, L" \"", 2);
+            node_dump_append(context, value, SysStringLen(value));
+            node_dump_append(context, L"\"", 1);
