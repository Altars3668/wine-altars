From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 05:10:09 -0400
Subject: [PATCH] d3d11: Return the flags a device was created with from
 GetCreationFlags().

Office asks for them on every device it creates.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/d3d11/d3d11_main.c b/dlls/d3d11/d3d11_main.c
index b8ad424ec09..50b7d8edd38 100644
--- a/dlls/d3d11/d3d11_main.c
+++ b/dlls/d3d11/d3d11_main.c
@@ -138,6 +138,7 @@ HRESULT WINAPI D3D11CoreCreateDevice(IDXGIFactory *factory, IDXGIAdapter *adapte
         return E_FAIL;
     }
     d3d_device->d3d11_only = TRUE;
+    d3d_device->create_flags = flags;
 
     return S_OK;
 }
diff --git a/dlls/d3d11/d3d11_private.h b/dlls/d3d11/d3d11_private.h
index bdb3e692ce8..7d9a23dc863 100644
--- a/dlls/d3d11/d3d11_private.h
+++ b/dlls/d3d11/d3d11_private.h
@@ -598,6 +598,7 @@ struct d3d_device
     LONG refcount;
 
     BOOL d3d11_only;
+    UINT create_flags;
 
     struct d3d_device_context_state *state;
     struct d3d11_device_context immediate_context;
diff --git a/dlls/d3d11/device.c b/dlls/d3d11/device.c
index 255d8058977..c23e538dcd7 100644
--- a/dlls/d3d11/device.c
+++ b/dlls/d3d11/device.c
@@ -5279,9 +5279,11 @@ static D3D_FEATURE_LEVEL STDMETHODCALLTYPE d3d11_device_GetFeatureLevel(ID3D11De
 
 static UINT STDMETHODCALLTYPE d3d11_device_GetCreationFlags(ID3D11Device5 *iface)
 {
-    FIXME("iface %p stub!\n", iface);
+    struct d3d_device *device = impl_from_ID3D11Device5(iface);
 
-    return 0;
+    TRACE("iface %p.\n", iface);
+
+    return device->create_flags;
 }
 
 static HRESULT STDMETHODCALLTYPE d3d11_device_GetDeviceRemovedReason(ID3D11Device5 *iface)
diff --git a/dlls/d3d11/tests/d3d11.c b/dlls/d3d11/tests/d3d11.c
index 3726823c6bf..188c4cc4a3f 100644
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -2143,6 +2143,15 @@ static void test_create_device(void)
 
     supported_feature_level = ID3D11Device_GetFeatureLevel(device);
     trace("Feature level %#x.\n", supported_feature_level);
+    ok(!ID3D11Device_GetCreationFlags(device), "Got flags %#x.\n", ID3D11Device_GetCreationFlags(device));
+    ID3D11Device_Release(device);
+
+    /* the flags the device was created with */
+    hr = D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, D3D11_CREATE_DEVICE_BGRA_SUPPORT, NULL, 0,
+            D3D11_SDK_VERSION, &device, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(ID3D11Device_GetCreationFlags(device) == D3D11_CREATE_DEVICE_BGRA_SUPPORT, "Got flags %#x.\n",
+            ID3D11Device_GetCreationFlags(device));
     ID3D11Device_Release(device);
 
     hr = D3D11CreateDevice(NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, 0, NULL, 0, D3D11_SDK_VERSION, NULL, NULL, NULL);
