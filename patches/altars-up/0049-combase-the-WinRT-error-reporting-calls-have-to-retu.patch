From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 21 Sep 2026 08:39:00 -0400
Subject: [PATCH] combase: the WinRT error-reporting calls have to return.

RoTransformError, RoTransformErrorW, RoCaptureErrorContext and RoClearError
were @ stub, and a stub does not return: it raises, and the thread goes with
it.  These are the calls WinRT makes while reporting a failure, so aborting in
them destroys the very thing the caller was trying to say, and a failure it
could have handled becomes a wait that never ends.

That is what Office's AutoSave does: pick an account and it spins on "loading"
for good, with no network traffic to show for it, because the thread that would
have surfaced the error died inside RoTransformError instead.  Two threads were
parked there at once.

Implement them the way RoOriginateError next door already is -- say what was
asked for and answer that nothing was recorded.  Failing to record an error is
something every caller of these copes with; not returning is not.

Co-Authored-By: Claude Opus 5 (1M context) <noreply@anthropic.com>
(cherry picked from commit 6f6c36a9d2b266a591fd07474ee5851f8ce13fb7)

diff --git a/dlls/combase/combase.spec b/dlls/combase/combase.spec
index 59e5db2aca8..b976b8b27cf 100644
--- a/dlls/combase/combase.spec
+++ b/dlls/combase/combase.spec
@@ -288,8 +288,8 @@
 @ stdcall PropVariantCopy(ptr ptr)
 @ stub ReleaseFuncDescs
 @ stdcall RoActivateInstance(ptr ptr)
-@ stub RoCaptureErrorContext
-@ stub RoClearError
+@ stdcall RoCaptureErrorContext(long)
+@ stdcall RoClearError()
 @ stdcall RoFailFastWithErrorContext(long)
 @ stub RoFreeParameterizedTypeExtra
 @ stub RoGetActivatableClassRegistration
@@ -315,8 +315,8 @@
 @ stub RoResolveRestrictedErrorInfoReference
 @ stub RoRevokeActivationFactories
 @ stdcall RoSetErrorReportingFlags(long)
-@ stub RoTransformError
-@ stub RoTransformErrorW
+@ stdcall RoTransformError(long long ptr)
+@ stdcall RoTransformErrorW(long long long ptr)
 @ stdcall RoUninitialize()
 @ stub RoUnregisterForApartmentShutdown
 @ stub SetCleanupFlag
diff --git a/dlls/combase/roapi.c b/dlls/combase/roapi.c
index 716001b11bc..e4fa618feda 100644
--- a/dlls/combase/roapi.c
+++ b/dlls/combase/roapi.c
@@ -591,6 +591,50 @@ BOOL WINAPI RoOriginateErrorW(HRESULT error, UINT max_len, const WCHAR *message)
     return FALSE;
 }
 
+/*
+ * The rest of this family used to be @ stub, and a stub does not return: it
+ * raises, and the thread goes with it.  These are the calls WinRT makes while
+ * reporting a failure, so aborting in them destroys the very thing the caller
+ * was trying to say and turns a failure it could have handled into a wait that
+ * never ends -- Office spins on "loading" for good.  Failing to record an
+ * error is something every caller of these copes with; not returning is not.
+ */
+
+/***********************************************************************
+ *      RoTransformError (combase.@)
+ */
+BOOL WINAPI RoTransformError(HRESULT old_error, HRESULT new_error, HSTRING message)
+{
+    FIXME("%#lx, %#lx, %s: stub\n", old_error, new_error, debugstr_hstring(message));
+    return FALSE;
+}
+
+/***********************************************************************
+ *      RoTransformErrorW (combase.@)
+ */
+BOOL WINAPI RoTransformErrorW(HRESULT old_error, HRESULT new_error, UINT max_len, const WCHAR *message)
+{
+    FIXME("%#lx, %#lx, %u, %s: stub\n", old_error, new_error, max_len, debugstr_w(message));
+    return FALSE;
+}
+
+/***********************************************************************
+ *      RoCaptureErrorContext (combase.@)
+ */
+HRESULT WINAPI RoCaptureErrorContext(HRESULT error)
+{
+    FIXME("%#lx: stub\n", error);
+    return E_NOTIMPL;
+}
+
+/***********************************************************************
+ *      RoClearError (combase.@)
+ */
+void WINAPI RoClearError(void)
+{
+    FIXME("stub\n");
+}
+
 /***********************************************************************
  *      RoReportUnhandledError (combase.@)
  */
diff --git a/include/roerrorapi.h b/include/roerrorapi.h
index f154c679418..e32776555e8 100644
--- a/include/roerrorapi.h
+++ b/include/roerrorapi.h
@@ -41,6 +41,10 @@ void    WINAPI RoFailFastWithErrorContext(HRESULT hr);
 HRESULT WINAPI RoGetErrorReportingFlags(UINT32 *flags);
 BOOL    WINAPI RoOriginateError(HRESULT error, HSTRING message);
 BOOL    WINAPI RoOriginateErrorW(HRESULT error, UINT max_len, const WCHAR *message);
+BOOL    WINAPI RoTransformError(HRESULT old_error, HRESULT new_error, HSTRING message);
+BOOL    WINAPI RoTransformErrorW(HRESULT old_error, HRESULT new_error, UINT max_len, const WCHAR *message);
+HRESULT WINAPI RoCaptureErrorContext(HRESULT error);
+void    WINAPI RoClearError(void);
 BOOL    WINAPI RoOriginateLanguageException(HRESULT error, HSTRING message, IUnknown *language_exception);
 HRESULT WINAPI RoReportUnhandledError(IRestrictedErrorInfo *info);
 HRESULT WINAPI RoSetErrorReportingFlags(UINT32 flags);
