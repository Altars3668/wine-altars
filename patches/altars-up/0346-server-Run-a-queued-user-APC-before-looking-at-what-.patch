From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:02:21 -0400
Subject: [PATCH] server: Run a queued user APC before looking at what an
 alertable wait waits for.

Windows answers WAIT_IO_COMPLETION to an alertable wait on a signaled
object when a user APC is queued, and the object stays signaled, as
kernel32's overlapped test shows.  The in-process synchronization path
reads the thread's alert event before it waits, to the same end; it is
not tried here, for want of /dev/ntsync.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 5426cc59468..3ae96aff30d 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -4100,7 +4100,7 @@ static void test_overlapped(void)
     QueueUserAPC( user_apc, GetCurrentThread(), 0 );
     SetEvent( event );
     r = WaitForSingleObjectEx( event, INFINITE, TRUE );
-    todo_wine ok( r == WAIT_IO_COMPLETION, "got %lu.\n", r );
+    ok( r == WAIT_IO_COMPLETION, "got %lu.\n", r );
     if (!r) SleepEx( 0, TRUE );
     ok( user_apc_ran, "APC was not run.\n" );
 
@@ -4108,7 +4108,7 @@ static void test_overlapped(void)
     SetEvent( event );
     QueueUserAPC( user_apc, GetCurrentThread(), 0 );
     r = WaitForSingleObjectEx( event, 2, TRUE );
-    todo_wine ok( r == WAIT_IO_COMPLETION, "got %lu.\n", r );
+    ok( r == WAIT_IO_COMPLETION, "got %lu.\n", r );
     if (!r) SleepEx( 0, TRUE );
     ok( user_apc_ran, "APC was not run.\n" );
 
@@ -4116,7 +4116,7 @@ static void test_overlapped(void)
     SetEvent( event );
     QueueUserAPC( user_apc, GetCurrentThread(), 0 );
     r = WaitForSingleObjectEx( event, 0, TRUE );
-    todo_wine ok( r == WAIT_IO_COMPLETION, "got %lu.\n", r );
+    ok( r == WAIT_IO_COMPLETION, "got %lu.\n", r );
     if (!r) SleepEx( 0, TRUE );
     ok( user_apc_ran, "APC was not run.\n" );
 
@@ -4178,9 +4178,7 @@ static void test_overlapped(void)
                     }
                     else if (wait_alerts)
                     {
-                        /* todo comes from WaitForSingleObjectEx() with signaled event and queued APC not preferring
-                         * user APC (which is tested above for clarity) */
-                        todo_wine_if(tests[i].set_event) ok( err == WAIT_IO_COMPLETION, "got %lu.\n", err );
+                        ok( err == WAIT_IO_COMPLETION, "got %lu.\n", err );
                         if (err == WAIT_IO_COMPLETION)
                         {
                             ok( !r, "got %lu.\n", r );
@@ -4224,7 +4222,6 @@ static void test_overlapped(void)
                 }
                 else
                 {
-                    todo_wine_if(will_wait && !wait_fails && wait_alerts && tests[i].set_event)
                     ok( r == WAIT_OBJECT_0, "got %#lx.\n", r );
                 }
 
diff --git a/dlls/ntdll/unix/sync.c b/dlls/ntdll/unix/sync.c
index 748d26a0077..6d25b0fa03b 100644
--- a/dlls/ntdll/unix/sync.c
+++ b/dlls/ntdll/unix/sync.c
@@ -419,6 +419,20 @@ static NTSTATUS linux_wait_objs( int device, DWORD count, const int *objs, WAIT_
         args.flags |= NTSYNC_WAIT_REALTIME;
     }
 
+    /* a queued user APC runs before what is waited for is looked at, as the server has it */
+    if (alert_fd)
+    {
+        struct ntsync_event_args alert = {0};
+
+        if (!ioctl( alert_fd, NTSYNC_IOC_EVENT_READ, &alert ) && alert.signaled)
+        {
+            static const LARGE_INTEGER zero_timeout;
+
+            if ((ret = server_wait( NULL, 0, SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, &zero_timeout )) == STATUS_USER_APC)
+                return ret;
+        }
+    }
+
     args.objs = (uintptr_t)objs;
     args.count = count;
     args.owner = GetCurrentThreadId();
diff --git a/server/thread.c b/server/thread.c
index d2073e1eabd..3f8fe513570 100644
--- a/server/thread.c
+++ b/server/thread.c
@@ -1130,6 +1130,9 @@ static int check_wait( struct thread *thread )
     /* Suspended threads may not acquire locks, but they can run system APCs */
     if (is_thread_suspended( thread )) return -1;
 
+    /* an alertable wait runs a queued user APC even when what it waits for is signaled, which stays so */
+    if ((wait->flags & SELECT_ALERTABLE) && !list_empty(&thread->user_apc)) return STATUS_USER_APC;
+
     if (wait->select == SELECT_WAIT_ALL)
     {
         int not_ok = 0;
@@ -1145,7 +1148,6 @@ static int check_wait( struct thread *thread )
             if (object_sync_signaled( entry->obj, entry )) return i;
     }
 
-    if ((wait->flags & SELECT_ALERTABLE) && !list_empty(&thread->user_apc)) return STATUS_USER_APC;
     if (wait->when >= 0 && wait->when <= current_time) return STATUS_TIMEOUT;
     if (wait->when < 0 && -wait->when <= monotonic_time) return STATUS_TIMEOUT;
     return -1;
