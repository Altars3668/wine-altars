From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 22:35:03 -0400
Subject: [PATCH] server: Scale negative coordinates between DPIs correctly.

scale_dpi() has multiplied the coordinate by an unsigned ratio since it was written, so a negative
one wrapped around: the (-4,-4) corner of a window maximized on a 192 DPI monitor came out as
22369618 for a caller at 96 DPI.  Compute in signed 64 bits.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/server/user.h b/server/user.h
index f1a1f07df66..88517e7f90c 100644
--- a/server/user.h
+++ b/server/user.h
@@ -234,7 +234,8 @@ static inline int point_in_rect( const struct rectangle *rect, int x, int y )
 
 static inline int scale_dpi( int val, struct ratio dpi_from, struct ratio dpi_to )
 {
-    unsigned int num = dpi_to.num * dpi_from.den, den = dpi_from.num * dpi_to.den;
+    /* signed: a negative coordinate times an unsigned ratio wraps around */
+    long long num = dpi_to.num * dpi_from.den, den = dpi_from.num * dpi_to.den;
     if (val >= 0) return (val * num + (den / 2)) / den;
     return (val * num - (den / 2)) / den;
 }
