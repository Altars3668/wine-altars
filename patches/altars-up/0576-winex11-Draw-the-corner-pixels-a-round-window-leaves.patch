From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 14:03:17 -0400
Subject: [PATCH] winex11: Draw the corner pixels a round window leaves out in
 its border colour, as much as they are covered.

Windows 11 blends the round corners of a window over what is behind it; in
the shadow window below, the pixels of the corners partly outside a window
with a border colour now show that colour over the shadow as much as they
are covered.  Against Windows, the corners of the probe's windows with a
border colour differ by at most 7/255 instead of 55.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 43b94a7f6e1..275afecda7c 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2475,9 +2475,11 @@ static UINT dwm_frame_coverage( int x, int y, int w, int h, int r )
 
 /* the shadow of a window at window, in a pixmap of width x height, as premultiplied ARGB, and
  * the default border, border pixels wide, where the window leaves its outermost pixels out; it
- * shows only where the window does not cover it */
+ * shows only where the window does not cover it.  With a border colour, the pixels of the round
+ * corners that the window's shape leaves out show that colour as much as they are covered. */
 static void render_dwm_shadow( UINT32 *bits, int width, int height, const RECT *window,
-                               const struct dwm_shadow *shadow, float scale, int radius, int border )
+                               const struct dwm_shadow *shadow, float scale, int radius, int border,
+                               COLORREF color )
 {
     float *fx, *fy, alpha;
     unsigned int i;
@@ -2507,24 +2509,37 @@ static void render_dwm_shadow( UINT32 *bits, int width, int height, const RECT *
     for (y = 0; y < height; y++) for (x = 0; x < width; x++)
     {
         int wx = x - window->left, wy = y - window->top, w = window->right - window->left, h = window->bottom - window->top;
-        float coverage = 0.0f, color;
+        float coverage = 0.0f, edge = 0.0f, grey;
         UINT32 premultiplied;
 
         alpha = 1.0f - ((float *)bits)[y * width + x];
         if (wx >= 0 && wy >= 0 && wx < w && wy < h)
         {
-            /* the window covers what is inside its shape, the round corners cut off */
-            if (dwm_frame_coverage( wx - border, wy - border, w - 2 * border, h - 2 * border, radius - border ) >= 32)
+            /* the window covers what is inside its shape, the round corners cut off: with a border
+               colour, all the pixels of the corners partly outside */
+            if (dwm_frame_coverage( wx - border, wy - border, w - 2 * border, h - 2 * border, radius - border ) >=
+                    (color != CLR_INVALID ? 64 : 32))
             {
                 bits[y * width + x] = 0;
                 continue;
             }
             if (border) coverage = dwm_frame_coverage( wx, wy, w, h, radius ) / 64.0f;
+            else if (color != CLR_INVALID) edge = dwm_frame_coverage( wx, wy, w, h, radius ) / 64.0f;
+        }
+        if (edge)
+        {
+            /* the window's border, over the shadow, as much as it covers the pixel */
+            alpha = 1.0f - (1.0f - alpha) * (1.0f - edge);
+            bits[y * width + x] = ((UINT32)(alpha * 255.0f + 0.5f) << 24) |
+                                  ((UINT32)(GetRValue( color ) * edge + 0.5f) << 16) |
+                                  ((UINT32)(GetGValue( color ) * edge + 0.5f) << 8) |
+                                  (UINT32)(GetBValue( color ) * edge + 0.5f);
+            continue;
         }
         /* the border over the shadow */
         alpha = 1.0f - (1.0f - alpha) * (1.0f - DWM_BORDER_ALPHA * coverage);
-        color = DWM_BORDER_PREMULTIPLIED * coverage;
-        premultiplied = (UINT32)(color + 0.5f);
+        grey = DWM_BORDER_PREMULTIPLIED * coverage;
+        premultiplied = (UINT32)(grey + 0.5f);
         bits[y * width + x] = ((UINT32)(alpha * 255.0f + 0.5f) << 24) | (premultiplied << 16) | (premultiplied << 8) | premultiplied;
     }
 }
@@ -2557,6 +2572,7 @@ static void update_dwm_shadow( struct x11drv_win_data *data, struct window_surfa
     UINT dpi = NtUserGetWinMonitorDpi( data->hwnd, MDT_RAW_DPI );
     float scale = (float)(dpi ? dpi : USER_DEFAULT_SCREEN_DPI) / USER_DEFAULT_SCREEN_DPI;
     int width, height, radius = surface ? surface->frame_radius : 0, border = 0;
+    COLORREF color = CLR_INVALID;
     XWindowChanges changes;
     POINT pt;
 
@@ -2568,6 +2584,8 @@ static void update_dwm_shadow( struct x11drv_win_data *data, struct window_surfa
     /* no colour asked for: the default border, drawn here where the window leaves it out */
     if (surface->frame_border && surface->frame_color == CLR_INVALID && radius > surface->frame_border)
         border = surface->frame_border;
+    else if (surface->frame_border)
+        color = surface->frame_color;
     if (!data->shadow_window && !compositing_manager_running( data->display )) return;
 
     window.left = (int)(shadow->margins.left * scale + 0.5f);
@@ -2602,6 +2620,7 @@ static void update_dwm_shadow( struct x11drv_win_data *data, struct window_surfa
     }
 
     if (data->shadow_kind != shadow || data->shadow_radius != radius || data->shadow_border != border ||
+        data->shadow_color != color ||
         data->shadow_rect.right - data->shadow_rect.left != width ||
         data->shadow_rect.bottom - data->shadow_rect.top != height || !data->shadow_mapped)
     {
@@ -2611,7 +2630,7 @@ static void update_dwm_shadow( struct x11drv_win_data *data, struct window_surfa
         GC gc;
 
         if (!bits) return;
-        render_dwm_shadow( bits, width, height, &window, shadow, scale, radius, border );
+        render_dwm_shadow( bits, width, height, &window, shadow, scale, radius, border, color );
         pixmap = XCreatePixmap( data->display, data->shadow_window, width, height, 32 );
         gc = XCreateGC( data->display, pixmap, 0, NULL );
         image = XCreateImage( data->display, argb_visual.visual, 32, ZPixmap, 0, (char *)bits, width, height, 32,
@@ -2627,6 +2646,7 @@ static void update_dwm_shadow( struct x11drv_win_data *data, struct window_surfa
         data->shadow_kind = shadow;
         data->shadow_radius = radius;
         data->shadow_border = border;
+        data->shadow_color = color;
     }
     data->shadow_rect = rect;
 
diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 72dbd3fd5fa..bbd5cdb341f 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -704,6 +704,7 @@ struct x11drv_win_data
     RECT        shadow_rect;    /* where it is, in root coordinates */
     UINT        shadow_radius;  /* the corner radius it was drawn for */
     UINT        shadow_border;  /* and the width of the default border drawn in it */
+    COLORREF    shadow_color;   /* or the colour of the window's own border, for its round corners */
     UINT        shadow_mapped : 1;
     Window      embedder;       /* window id of embedder */
     Pixmap         icon_pixmap;
