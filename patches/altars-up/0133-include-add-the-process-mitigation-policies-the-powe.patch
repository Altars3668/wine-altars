From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 13:16:30 -0400
Subject: [PATCH] include: add the process mitigation policies, the power
 throttling state, heap classes and GetGuiResources flags.

As the Windows SDK has them: the PROCESS_MITIGATION_*_POLICY structures
and the policies up to SEHOP, PROCESS_MITIGATION_POLICY_INFORMATION for
ntdll, Get/SetProcessMitigationPolicy, PROCESS_POWER_THROTTLING_STATE
with its version and flags, HeapEnableTerminationOnCorruption and the
other heap information classes, and the GR_* flags of GetGuiResources.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit ccb27bd507d10e4802c6cc589ab77d89cafdf82b)

diff --git a/include/processthreadsapi.h b/include/processthreadsapi.h
index cefd7023be5..1b55905d694 100644
--- a/include/processthreadsapi.h
+++ b/include/processthreadsapi.h
@@ -136,6 +136,19 @@ typedef struct _THREAD_POWER_THROTTLING_STATE
 
 typedef void (CALLBACK *PAPCFUNC)(ULONG_PTR);
 
+#define PROCESS_POWER_THROTTLING_CURRENT_VERSION        1
+#define PROCESS_POWER_THROTTLING_EXECUTION_SPEED        0x1
+#define PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION 0x4
+#define PROCESS_POWER_THROTTLING_VALID_FLAGS \
+    (PROCESS_POWER_THROTTLING_EXECUTION_SPEED | PROCESS_POWER_THROTTLING_IGNORE_TIMER_RESOLUTION)
+
+typedef struct _PROCESS_POWER_THROTTLING_STATE
+{
+    ULONG Version;
+    ULONG ControlMask;
+    ULONG StateMask;
+} PROCESS_POWER_THROTTLING_STATE, *PPROCESS_POWER_THROTTLING_STATE;
+
 typedef enum _QUEUE_USER_APC_FLAGS
 {
     QUEUE_USER_APC_FLAGS_NONE,
@@ -175,6 +188,7 @@ WINBASEAPI DWORD       WINAPI GetPriorityClass(HANDLE);
 WINBASEAPI DWORD       WINAPI GetProcessId(HANDLE);
 WINBASEAPI DWORD       WINAPI GetProcessIdOfThread(HANDLE);
 WINBASEAPI BOOL        WINAPI GetProcessInformation(HANDLE,PROCESS_INFORMATION_CLASS,void*,DWORD);
+WINBASEAPI BOOL        WINAPI GetProcessMitigationPolicy(HANDLE,PROCESS_MITIGATION_POLICY,void *,SIZE_T);
 WINBASEAPI BOOL        WINAPI GetProcessPriorityBoost(HANDLE,PBOOL);
 WINBASEAPI BOOL        WINAPI GetProcessShutdownParameters(LPDWORD,LPDWORD);
 WINBASEAPI BOOL        WINAPI GetProcessTimes(HANDLE,LPFILETIME,LPFILETIME,LPFILETIME,LPFILETIME);
@@ -199,6 +213,7 @@ WINBASEAPI DWORD       WINAPI QueueUserAPC2(PAPCFUNC,HANDLE,ULONG_PTR,QUEUE_USER
 WINBASEAPI DWORD       WINAPI ResumeThread(HANDLE);
 WINBASEAPI BOOL        WINAPI SetPriorityClass(HANDLE,DWORD);
 WINBASEAPI BOOL        WINAPI SetProcessInformation(HANDLE,PROCESS_INFORMATION_CLASS,LPVOID,DWORD);
+WINBASEAPI BOOL        WINAPI SetProcessMitigationPolicy(PROCESS_MITIGATION_POLICY,void *,SIZE_T);
 WINBASEAPI BOOL        WINAPI SetProcessPriorityBoost(HANDLE,BOOL);
 WINBASEAPI BOOL        WINAPI SetProcessShutdownParameters(DWORD,DWORD);
 WINBASEAPI BOOL        WINAPI SetThreadContext(HANDLE,const CONTEXT *);
