From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:49:42 -0400
Subject: [PATCH] combase: Keep the settings of IGlobalOptions::Set for Query.

Office sets the exception handling to COMGLB_EXCEPTION_DONOT_HANDLE_ANY
and the modal loop's handling of input; Query answered the defaults.
The settings are not acted on yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index 62b650d4c06..8fa16403180 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -497,7 +497,13 @@ static ULONG WINAPI global_options_Release(IGlobalOptions *iface)
 
 static HRESULT WINAPI global_options_Set(IGlobalOptions *iface, GLOBALOPT_PROPERTIES property, ULONG_PTR value)
 {
-    FIXME("%p, %u, %Ix.\n", iface, property, value);
+    TRACE("%p, %u, %Ix.\n", iface, property, value);
+
+    if (property < COMGLB_EXCEPTION_HANDLING || property > COMGLB_PROPERTIES_RESERVED3)
+        return E_INVALIDARG;
+
+    /* kept for Query; the exception handling and modal loop settings are not acted on */
+    global_options[property] = value;
 
     return S_OK;
 }
diff --git a/dlls/ole32/tests/compobj.c b/dlls/ole32/tests/compobj.c
index 91ebb0f4919..6f7c92e64d0 100644
--- a/dlls/ole32/tests/compobj.c
+++ b/dlls/ole32/tests/compobj.c
@@ -4507,6 +4507,19 @@ static void test_GlobalOptions(void)
     if (SUCCEEDED(hres))
         ok(value == COMGLB_EXCEPTION_HANDLE, "Unexpected value %Id.\n", value);
 
+    hres = IGlobalOptions_Set(global_options, COMGLB_EXCEPTION_HANDLING, COMGLB_EXCEPTION_DONOT_HANDLE_ANY);
+    ok(hres == S_OK, "Unexpected hr %#lx.\n", hres);
+    value = ~0u;
+    hres = IGlobalOptions_Query(global_options, COMGLB_EXCEPTION_HANDLING, &value);
+    ok(hres == S_OK || broken(hres == E_FAIL) /* Vista */, "Unexpected hr %#lx.\n", hres);
+    if (SUCCEEDED(hres))
+        ok(value == COMGLB_EXCEPTION_DONOT_HANDLE_ANY, "Unexpected value %Id.\n", value);
+    hres = IGlobalOptions_Set(global_options, COMGLB_EXCEPTION_HANDLING, COMGLB_EXCEPTION_HANDLE);
+    ok(hres == S_OK, "Unexpected hr %#lx.\n", hres);
+
+    hres = IGlobalOptions_Set(global_options, 0, 0);
+    ok(FAILED(hres), "Unexpected hr %#lx.\n", hres);
+
     IGlobalOptions_Release(global_options);
 
     hres = CoCreateInstance(&CLSID_GlobalOptions, (IUnknown*)0xdeadbeef, CLSCTX_INPROC_SERVER,
