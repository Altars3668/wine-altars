From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 14:52:23 -0400
Subject: [PATCH] imm32: Show the composition at the caret when the application
 leaves it to the IME.

Word leaves the composition window where the IME puts it (CFS_DEFAULT)
and does not draw the composition itself, and the builtin IME put its
window below the bottom left corner of the window: a composition typed
through ibus appeared under the status bar.  When the thread has a
caret, the composition window now starts at it, the size of the
string, which is where Word draws its caret; the bottom left remains
for windows without one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit b7bd4c8efb1e2f27f39830a84e7166db09b74e1d)

diff --git a/dlls/imm32/ime.c b/dlls/imm32/ime.c
index a6663d79722..1fb533543e9 100644
--- a/dlls/imm32/ime.c
+++ b/dlls/imm32/ime.c
@@ -282,16 +282,33 @@ static void ime_ui_paint( HIMC himc, HWND hwnd )
         }
         else /* CFS_DEFAULT */
         {
-            /* Windows places the default IME window in the bottom left */
+            GUITHREADINFO info = {.cbSize = sizeof(info)};
             HWND target = ctx->hWnd;
             if (!target) target = GetFocus();
 
-            GetWindowRect( target, &rect );
-            rect.top = rect.bottom;
-            rect.right = rect.left + pt.x + 20;
-            rect.bottom = rect.top + pt.y + 20;
-            offset.x = offset.y = 10;
-            monitor = MonitorFromWindow( target, MONITOR_DEFAULTTOPRIMARY );
+            if (GetGUIThreadInfo( GetWindowThreadProcessId( target, NULL ), &info ) && info.hwndCaret)
+            {
+                /* where the text goes, as the application's caret shows it: applications that leave the
+                 * composition window where the IME puts it, Word among them, draw a caret there */
+                POINT cpt = {info.rcCaret.left, info.rcCaret.top};
+                ClientToScreen( info.hwndCaret, &cpt );
+                rect.left = cpt.x;
+                rect.top = cpt.y;
+                rect.right = rect.left + pt.x;
+                rect.bottom = rect.top + pt.y;
+                offset.x = offset.y = 0;
+                monitor = MonitorFromPoint( cpt, MONITOR_DEFAULTTOPRIMARY );
+            }
+            else
+            {
+                /* Windows places the default IME window in the bottom left */
+                GetWindowRect( target, &rect );
+                rect.top = rect.bottom;
+                rect.right = rect.left + pt.x + 20;
+                rect.bottom = rect.top + pt.y + 20;
+                offset.x = offset.y = 10;
+                monitor = MonitorFromWindow( target, MONITOR_DEFAULTTOPRIMARY );
+            }
         }
 
         if (ctx->cfCompForm.dwStyle == CFS_RECT)
