From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 16:11:58 -0400
Subject: [PATCH] d3d11: Answer every feature Windows 11 knows of, as it does,
 and only those.

D3D11_OPTIONS reports what is done here (discards, the copy and update flags, ClearView, constant buffer offsets
and partial updates, double precision as the device has it) rather than a fake set, and the features left
unanswered are answered: FORMAT_SUPPORT2 (typed UAV stores, and the loads and atomics every device has, failing
with E_FAIL for a format with none), SHADER_MIN_PRECISION_SUPPORT, D3D9_SHADOW_SUPPORT, MARKER_SUPPORT,
D3D9_OPTIONS1, GPU_VIRTUAL_ADDRESS_SUPPORT, D3D11_OPTIONS4, SHADER_CACHE, D3D11_OPTIONS5 and DISPLAYABLE.  As on
Windows 11 build 29671, each takes only its own size, but for D3D11_OPTIONS2, which takes a larger one, and a
feature past DISPLAYABLE is E_INVALIDARG.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/d3d11/device.c b/dlls/d3d11/device.c
index c23e538dcd7..2a8cb60d393 100644
--- a/dlls/d3d11/device.c
+++ b/dlls/d3d11/device.c
@@ -5070,12 +5070,23 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFeatureSupport(ID3D11Device5
                 return E_INVALIDARG;
             }
 
-            FIXME("Returning fake Options support data.\n");
+            wined3d_mutex_lock();
+            hr = wined3d_device_get_device_caps(device->wined3d_device, &wined3d_caps);
+            wined3d_mutex_unlock();
+            if (FAILED(hr))
+            {
+                WARN("Failed to get device caps, hr %#lx.\n", hr);
+                return hr;
+            }
+
+            /* What is done here: discards, the copy and update flags, ClearView and constant buffer offsets and
+             * updates.  Logic ops, forced sample counts, copies within a resource that overlap, msad4 and
+             * sharing beyond the basics are not. */
             options->OutputMergerLogicOp = FALSE;
             options->UAVOnlyRenderingForcedSampleCount = FALSE;
-            options->DiscardAPIsSeenByDriver = FALSE;
-            options->FlagsForUpdateAndCopySeenByDriver = FALSE;
-            options->ClearView = FALSE;
+            options->DiscardAPIsSeenByDriver = TRUE;
+            options->FlagsForUpdateAndCopySeenByDriver = TRUE;
+            options->ClearView = TRUE;
             options->CopyWithOverlap = FALSE;
             options->ConstantBufferPartialUpdate = TRUE;
             options->ConstantBufferOffsetting = TRUE;
@@ -5083,7 +5094,7 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFeatureSupport(ID3D11Device5
             options->MapNoOverwriteOnDynamicBufferSRV = TRUE;
             options->MultisampleRTVWithForcedSampleCountOne = FALSE;
             options->SAD4ShaderInstructions = FALSE;
-            options->ExtendedDoublesShaderInstructions = FALSE;
+            options->ExtendedDoublesShaderInstructions = wined3d_caps.shader_double_precision;
             options->ExtendedResourceSharing = FALSE;
             return S_OK;
         }
@@ -5106,7 +5117,6 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFeatureSupport(ID3D11Device5
                 return hr;
             }
 
-            FIXME("Returning fake Options1 support data.\n");
             options->TiledResourcesTier = D3D11_TILED_RESOURCES_NOT_SUPPORTED;
             options->MinMaxFiltering = wined3d_caps.min_max_filtering;
             options->ClearViewAlsoSupportsDepthOnlyFormats = FALSE;
@@ -5117,7 +5127,8 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFeatureSupport(ID3D11Device5
         case D3D11_FEATURE_D3D11_OPTIONS2:
         {
             D3D11_FEATURE_DATA_D3D11_OPTIONS2 *options = feature_support_data;
-            if (feature_support_data_size != sizeof(*options))
+            /* unlike the others, a larger buffer will do */
+            if (feature_support_data_size < sizeof(*options))
             {
                 WARN("Invalid data size.\n");
                 return E_INVALIDARG;
@@ -5175,7 +5186,7 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFeatureSupport(ID3D11Device5
                 return E_INVALIDARG;
             }
 
-            FIXME("Returning fake data architecture info.\n");
+            /* the GPUs Wine runs on render immediately */
             options->TileBasedDeferredRenderer = FALSE;
             return S_OK;
         }
@@ -5214,9 +5225,177 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_CheckFeatureSupport(ID3D11Device5
             return S_OK;
         }
 
+        case D3D11_FEATURE_FORMAT_SUPPORT2:
+        {
+            D3D11_FEATURE_DATA_FORMAT_SUPPORT2 *data = feature_support_data;
+            UINT support = 0;
+
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid size %u for D3D11_FEATURE_FORMAT_SUPPORT2.\n", feature_support_data_size);
+                return E_INVALIDARG;
+            }
+
+            data->OutFormatSupport2 = 0;
+            if (FAILED(hr = d3d11_device_CheckFormatSupport(iface, data->InFormat, &support)))
+                return hr;
+            if (support & D3D11_FORMAT_SUPPORT_TYPED_UNORDERED_ACCESS_VIEW)
+            {
+                data->OutFormatSupport2 |= D3D11_FORMAT_SUPPORT2_UAV_TYPED_STORE;
+                /* what every device can load and work on atomically */
+                if (data->InFormat == DXGI_FORMAT_R32_FLOAT || data->InFormat == DXGI_FORMAT_R32_UINT
+                        || data->InFormat == DXGI_FORMAT_R32_SINT)
+                    data->OutFormatSupport2 |= D3D11_FORMAT_SUPPORT2_UAV_TYPED_LOAD;
+                if (data->InFormat == DXGI_FORMAT_R32_UINT || data->InFormat == DXGI_FORMAT_R32_SINT)
+                    data->OutFormatSupport2 |= D3D11_FORMAT_SUPPORT2_UAV_ATOMIC_ADD
+                            | D3D11_FORMAT_SUPPORT2_UAV_ATOMIC_BITWISE_OPS
+                            | D3D11_FORMAT_SUPPORT2_UAV_ATOMIC_COMPARE_STORE_OR_COMPARE_EXCHANGE
+                            | D3D11_FORMAT_SUPPORT2_UAV_ATOMIC_EXCHANGE
+                            | D3D11_FORMAT_SUPPORT2_UAV_ATOMIC_SIGNED_MIN_OR_MAX
+                            | D3D11_FORMAT_SUPPORT2_UAV_ATOMIC_UNSIGNED_MIN_OR_MAX;
+            }
+            /* a format with none of them is one it fails for */
+            return data->OutFormatSupport2 ? S_OK : E_FAIL;
+        }
+
+        case D3D11_FEATURE_SHADER_MIN_PRECISION_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_SHADER_MIN_PRECISION_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            /* shaders run at full precision */
+            data->PixelShaderMinPrecision = 0;
+            data->AllOtherShaderStagesMinPrecision = 0;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D9_SHADOW_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_D3D9_SHADOW_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->SupportsDepthAsTextureWithLessEqualComparisonFilter = TRUE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_MARKER_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_MARKER_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            /* nothing profiles the markers */
+            data->Profile = FALSE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D9_OPTIONS1:
+        {
+            D3D11_FEATURE_DATA_D3D9_OPTIONS1 *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            wined3d_mutex_lock();
+            hr = wined3d_device_get_device_caps(device->wined3d_device, &wined3d_caps);
+            wined3d_mutex_unlock();
+            if (FAILED(hr))
+            {
+                WARN("Failed to get device caps, hr %#lx.\n", hr);
+                return hr;
+            }
+
+            data->FullNonPow2TextureSupported = !(wined3d_caps.TextureCaps & WINED3DPTEXTURECAPS_POW2);
+            data->DepthAsTextureWithLessEqualComparisonFilterSupported = TRUE;
+            data->SimpleInstancingSupported = wined3d_caps.simple_instancing;
+            data->TextureCubeFaceRenderTargetWithNonCubeDepthStencilSupported = TRUE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_GPU_VIRTUAL_ADDRESS_SUPPORT:
+        {
+            D3D11_FEATURE_DATA_GPU_VIRTUAL_ADDRESS_SUPPORT *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->MaxGPUVirtualAddressBitsPerResource = sizeof(void *) == 8 ? 40 : 32;
+            data->MaxGPUVirtualAddressBitsPerProcess = sizeof(void *) == 8 ? 40 : 32;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D11_OPTIONS4:
+        {
+            D3D11_FEATURE_DATA_D3D11_OPTIONS4 *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->ExtendedNV12SharedTextureSupported = FALSE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_SHADER_CACHE:
+        {
+            D3D11_FEATURE_DATA_SHADER_CACHE *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->SupportFlags = D3D11_SHADER_CACHE_SUPPORT_NONE;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_D3D11_OPTIONS5:
+        {
+            D3D11_FEATURE_DATA_D3D11_OPTIONS5 *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->SharedResourceTier = D3D11_SHARED_RESOURCE_TIER_0;
+            return S_OK;
+        }
+
+        case D3D11_FEATURE_DISPLAYABLE:
+        {
+            D3D11_FEATURE_DATA_DISPLAYABLE *data = feature_support_data;
+            if (feature_support_data_size != sizeof(*data))
+            {
+                WARN("Invalid data size.\n");
+                return E_INVALIDARG;
+            }
+
+            data->DisplayableTexture = FALSE;
+            data->SharedResourceTier = D3D11_SHARED_RESOURCE_TIER_0;
+            return S_OK;
+        }
+
         default:
-            FIXME("Unhandled feature %#x.\n", feature);
-            return E_NOTIMPL;
+            /* Windows 11 knows nothing past DISPLAYABLE */
+            WARN("Unknown feature %#x.\n", feature);
+            return E_INVALIDARG;
     }
 }
 
diff --git a/dlls/d3d11/tests/d3d11.c b/dlls/d3d11/tests/d3d11.c
index 188c4cc4a3f..c674c49953c 100644
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -20535,7 +20535,34 @@ static void test_null_sampler(void)
 
 static void test_check_feature_support(void)
 {
+    static const struct
+    {
+        D3D11_FEATURE feature;
+        unsigned int size;
+    }
+    features[] =
+    {
+        {D3D11_FEATURE_D3D11_OPTIONS,                 sizeof(D3D11_FEATURE_DATA_D3D11_OPTIONS)},
+        {D3D11_FEATURE_ARCHITECTURE_INFO,             sizeof(D3D11_FEATURE_DATA_ARCHITECTURE_INFO)},
+        {D3D11_FEATURE_D3D9_OPTIONS,                  sizeof(D3D11_FEATURE_DATA_D3D9_OPTIONS)},
+        {D3D11_FEATURE_SHADER_MIN_PRECISION_SUPPORT,  sizeof(D3D11_FEATURE_DATA_SHADER_MIN_PRECISION_SUPPORT)},
+        {D3D11_FEATURE_D3D9_SHADOW_SUPPORT,           sizeof(D3D11_FEATURE_DATA_D3D9_SHADOW_SUPPORT)},
+        {D3D11_FEATURE_D3D11_OPTIONS1,                sizeof(D3D11_FEATURE_DATA_D3D11_OPTIONS1)},
+        {D3D11_FEATURE_D3D9_SIMPLE_INSTANCING_SUPPORT, sizeof(D3D11_FEATURE_DATA_D3D9_SIMPLE_INSTANCING_SUPPORT)},
+        {D3D11_FEATURE_MARKER_SUPPORT,                sizeof(D3D11_FEATURE_DATA_MARKER_SUPPORT)},
+        {D3D11_FEATURE_D3D9_OPTIONS1,                 sizeof(D3D11_FEATURE_DATA_D3D9_OPTIONS1)},
+        {D3D11_FEATURE_D3D11_OPTIONS2,                sizeof(D3D11_FEATURE_DATA_D3D11_OPTIONS2)},
+        {D3D11_FEATURE_D3D11_OPTIONS3,                sizeof(D3D11_FEATURE_DATA_D3D11_OPTIONS3)},
+        {D3D11_FEATURE_GPU_VIRTUAL_ADDRESS_SUPPORT,   sizeof(D3D11_FEATURE_DATA_GPU_VIRTUAL_ADDRESS_SUPPORT)},
+        {D3D11_FEATURE_D3D11_OPTIONS4,                sizeof(D3D11_FEATURE_DATA_D3D11_OPTIONS4)},
+        {D3D11_FEATURE_SHADER_CACHE,                  sizeof(D3D11_FEATURE_DATA_SHADER_CACHE)},
+        {D3D11_FEATURE_D3D11_OPTIONS5,                sizeof(D3D11_FEATURE_DATA_D3D11_OPTIONS5)},
+        {D3D11_FEATURE_DISPLAYABLE,                   sizeof(D3D11_FEATURE_DATA_DISPLAYABLE)},
+    };
     D3D11_FEATURE_DATA_D3D9_SIMPLE_INSTANCING_SUPPORT d3d9si;
+    D3D11_FEATURE_DATA_FORMAT_SUPPORT2 format2;
+    BYTE buffer[64];
+    unsigned int i;
     D3D11_FEATURE_DATA_THREADING threading[2];
     D3D11_FEATURE_DATA_D3D10_X_HARDWARE_OPTIONS hwopts;
     D3D11_FEATURE_DATA_ARCHITECTURE_INFO archinfo;
@@ -20607,6 +20634,42 @@ static void test_check_feature_support(void)
     hr = ID3D11Device_CheckFeatureSupport(device, D3D11_FEATURE_D3D9_SIMPLE_INSTANCING_SUPPORT, &d3d9si, sizeof(d3d9si));
     ok(hr == S_OK || broken(hr == E_INVALIDARG) /* Win 7 */, "Got unexpected hr %#lx.\n", hr);
 
+    /* the features of Windows 10 and 11, each at its own size only but the second options */
+    for (i = 0; i < ARRAY_SIZE(features); ++i)
+    {
+        winetest_push_context("feature %u", features[i].feature);
+        memset(buffer, 0xcc, sizeof(buffer));
+        hr = ID3D11Device_CheckFeatureSupport(device, features[i].feature, buffer, features[i].size);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        hr = ID3D11Device_CheckFeatureSupport(device, features[i].feature, buffer, features[i].size + 4);
+        ok(hr == (features[i].feature == D3D11_FEATURE_D3D11_OPTIONS2 ? S_OK : E_INVALIDARG),
+                "Got unexpected hr %#lx.\n", hr);
+        hr = ID3D11Device_CheckFeatureSupport(device, features[i].feature, buffer, features[i].size - 4);
+        ok(hr == E_INVALIDARG, "Got unexpected hr %#lx.\n", hr);
+        winetest_pop_context();
+    }
+    /* and nothing past them */
+    for (i = D3D11_FEATURE_DISPLAYABLE + 1; i <= D3D11_FEATURE_DISPLAYABLE + 7; ++i)
+    {
+        hr = ID3D11Device_CheckFeatureSupport(device, i, buffer, sizeof(buffer));
+        ok(hr == E_INVALIDARG, "Feature %u: got unexpected hr %#lx.\n", i, hr);
+        hr = ID3D11Device_CheckFeatureSupport(device, i, buffer, 4);
+        ok(hr == E_INVALIDARG, "Feature %u: got unexpected hr %#lx.\n", i, hr);
+    }
+
+    /* what a format supports beyond the first set, nothing being a failure */
+    format2.InFormat = DXGI_FORMAT_D24_UNORM_S8_UINT;
+    format2.OutFormatSupport2 = 0xdeadbeef;
+    hr = ID3D11Device_CheckFeatureSupport(device, D3D11_FEATURE_FORMAT_SUPPORT2, &format2, sizeof(format2));
+    ok(hr == E_FAIL || (hr == S_OK && format2.OutFormatSupport2), "Got unexpected hr %#lx.\n", hr);
+    if (hr == E_FAIL)
+        ok(!format2.OutFormatSupport2, "Got unexpected support %#x.\n", format2.OutFormatSupport2);
+    format2.InFormat = DXGI_FORMAT_R32_UINT;
+    hr = ID3D11Device_CheckFeatureSupport(device, D3D11_FEATURE_FORMAT_SUPPORT2, &format2, sizeof(format2));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ok(format2.OutFormatSupport2 & D3D11_FORMAT_SUPPORT2_UAV_TYPED_LOAD, "Got unexpected support %#x.\n",
+            format2.OutFormatSupport2);
+
     refcount = ID3D11Device_Release(device);
     ok(!refcount, "Device has %lu references left.\n", refcount);
 }
diff --git a/include/d3d11.idl b/include/d3d11.idl
index d13a7ad85bd..0c37302b3a8 100644
--- a/include/d3d11.idl
+++ b/include/d3d11.idl
@@ -678,6 +678,7 @@ typedef enum D3D11_FEATURE
     D3D11_FEATURE_D3D11_OPTIONS4,
     D3D11_FEATURE_SHADER_CACHE,
     D3D11_FEATURE_D3D11_OPTIONS5,
+    D3D11_FEATURE_DISPLAYABLE,
 } D3D11_FEATURE;
 
 typedef struct D3D11_FEATURE_DATA_THREADING
@@ -843,6 +844,12 @@ typedef struct D3D11_FEATURE_DATA_D3D11_OPTIONS5
     D3D11_SHARED_RESOURCE_TIER SharedResourceTier;
 } D3D11_FEATURE_DATA_D3D11_OPTIONS5;
 
+typedef struct D3D11_FEATURE_DATA_DISPLAYABLE
+{
+    BOOL DisplayableTexture;
+    D3D11_SHARED_RESOURCE_TIER SharedResourceTier;
+} D3D11_FEATURE_DATA_DISPLAYABLE;
+
 typedef enum D3D11_FILL_MODE
 {
     D3D11_FILL_WIREFRAME = 2,
