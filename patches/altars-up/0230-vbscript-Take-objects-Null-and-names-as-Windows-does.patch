 static HRESULT Global_LoadPicture(BuiltinDisp *This, VARIANT *arg, unsigned args_cnt, VARIANT *res)
 {
-    FIXME("\n");
-    return E_NOTIMPL;
+    IDispatch *picture;
+    IStream *stream;
+    DWORD size, read;
+    HANDLE file;
+    HGLOBAL mem;
+    HRESULT hres;
+    BSTR name;
+    BOOL ret;
+
+    TRACE("%s\n", debugstr_variant(arg));
+
+    hres = to_string(This->ctx->lcid, arg, &name);
+    if(FAILED(hres))
+        return hres;
+
+    /* the file fails to open as a storage's would: an empty name is a path not found */
+    file = CreateFileW(name, GENERIC_READ, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL);
+    SysFreeString(name);
+    if(file == INVALID_HANDLE_VALUE)
+        return MAKE_HRESULT(SEVERITY_ERROR, FACILITY_STORAGE, GetLastError());
+
+    size = GetFileSize(file, NULL);
+    if(size == INVALID_FILE_SIZE || !(mem = GlobalAlloc(GMEM_MOVEABLE, size ? size : 1))) {
+        CloseHandle(file);
+        return E_OUTOFMEMORY;
+    }
+    ret = ReadFile(file, GlobalLock(mem), size, &read, NULL);
+    GlobalUnlock(mem);
+    CloseHandle(file);
+    if(!ret) {
+        GlobalFree(mem);
+        return MAKE_HRESULT(SEVERITY_ERROR, FACILITY_STORAGE, GetLastError());
+    }
+
+    hres = CreateStreamOnHGlobal(mem, TRUE, &stream);
+    if(FAILED(hres)) {
+        GlobalFree(mem);
+        return hres;
+    }
+    hres = OleLoadPicture(stream, read, FALSE, &IID_IDispatch, (void **)&picture);
+    IStream_Release(stream);
+    if(FAILED(hres))
+        return hres;
+
+    if(!res) {
+        IDispatch_Release(picture);
+        return S_OK;
+    }
+    V_VT(res) = VT_DISPATCH;
+    V_DISPATCH(res) = picture;
+    return S_OK;
 }
 
