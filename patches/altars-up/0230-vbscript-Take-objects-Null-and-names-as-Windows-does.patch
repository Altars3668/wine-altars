diff --git a/dlls/vbscript/tests/api.vbs b/dlls/vbscript/tests/api.vbs
index 47aa0ef56a3..106ae917139 100644
--- a/dlls/vbscript/tests/api.vbs
+++ b/dlls/vbscript/tests/api.vbs
@@ -3455,4 +3455,109 @@ end sub
 
 call testDateValueLocale()
 
+sub testWindowsBehavior()
+    dim x, d, rx, o
+
+    on error resume next
+
+    ' Null is no number or character
+    call Err.clear()
+    x = Chr(null)
+    call ok(Err.number = 94, "Chr(null): Err.number = " & Err.number)
+    call Err.clear()
+    x = Sqr(null)
+    call ok(Err.number = 94, "Sqr(null): Err.number = " & Err.number)
+    call Err.clear()
+    x = String(null, "a")
+    call ok(Err.number = 94, "String(null, ""a""): Err.number = " & Err.number)
+    call Err.clear()
+    x = String(2, null)
+    call ok(Err.number = 94, "String(2, null): Err.number = " & Err.number)
+    call Err.clear()
+    x = StrReverse(null)
+    call ok(Err.number = 94, "StrReverse(null): Err.number = " & Err.number)
+    call Err.clear()
+    x = Round(null)
+    call ok(Err.number = 94, "Round(null): Err.number = " & Err.number)
+    call Err.clear()
+    x = Rnd(null)
+    call ok(Err.number = 94, "Rnd(null): Err.number = " & Err.number)
+
+    ' while trimming passes it on
+    call Err.clear()
+    x = Trim(null)
+    call ok(Err.number = 0 and getVT(x) = "VT_NULL*", "Trim(null): " & Err.number & " " & getVT(x))
+    x = LTrim(null)
+    call ok(Err.number = 0 and getVT(x) = "VT_NULL*", "LTrim(null): " & Err.number & " " & getVT(x))
+    x = RTrim(null)
+    call ok(Err.number = 0 and getVT(x) = "VT_NULL*", "RTrim(null): " & Err.number & " " & getVT(x))
+
+    call Err.clear()
+    x = Exp(1000)
+    call ok(Err.number = 6, "Exp(1000): Err.number = " & Err.number)
+    call Err.clear()
+    set o = CreateObject("")
+    call ok(Err.number = 5, "CreateObject(""""): Err.number = " & Err.number)
+    call Err.clear()
+    set o = GetObject("")
+    call ok(Err.number = 5, "GetObject(""""): Err.number = " & Err.number)
+    call Err.clear()
+    x = Split("a,b", ",", 0)
+    call ok(Err.number = 0 and UBound(x) = -1, "Split(""a,b"", "","", 0): " & Err.number & " " & UBound(x))
+
+    ' an object argument stands for its default value, which a Dictionary has only with a key
+    set d = CreateObject("Scripting.Dictionary")
+    set rx = new RegExp
+    call Err.clear()
+    x = CStr(d)
+    call ok(Err.number = 450, "CStr(dictionary): Err.number = " & Err.number)
+    call Err.clear()
+    x = Len(d)
+    call ok(Err.number = 450, "Len(dictionary): Err.number = " & Err.number)
+    call Err.clear()
+    x = CInt(d)
+    call ok(Err.number = 450, "CInt(dictionary): Err.number = " & Err.number)
+    call Err.clear()
+    x = Mid(d, 1)
+    call ok(Err.number = 450, "Mid(dictionary, 1): Err.number = " & Err.number)
+    call Err.clear()
+    x = CStr(rx)
+    call ok(Err.number = 438, "CStr(regexp): Err.number = " & Err.number)
+    call Err.clear()
+    x = CStr(nothing)
+    call ok(Err.number = 91, "CStr(nothing): Err.number = " & Err.number)
+
+    ' but the functions that look at the type take the object itself
+    call Err.clear()
+    call ok(IsObject(d), "IsObject(dictionary) is false")
+    call ok(not IsNumeric(d), "IsNumeric(dictionary) is true")
+    call ok(not IsEmpty(d), "IsEmpty(dictionary) is true")
+    call ok(VarType(d) = vbObject, "VarType(dictionary) = " & VarType(d))
+    call ok(VarType(rx) = vbObject, "VarType(regexp) = " & VarType(rx))
+    call ok(TypeName(d) = "Dictionary", "TypeName(dictionary) = " & TypeName(d))
+    call ok(TypeName(rx) = "IRegExp2", "TypeName(regexp) = " & TypeName(rx))
+    x = Array(d)
+    call ok(x(0) is d, "Array(dictionary)(0) is not the dictionary")
+    call ok(Err.number = 0, "Err.number = " & Err.number)
+
+    ' a picture file that is not there, and one of no name
+    call Err.clear()
+    set o = LoadPicture("wine-no-such-picture.bmp")
+    call ok(Err.number = 432, "LoadPicture(missing): Err.number = " & Err.number)
+    call Err.clear()
+    set o = LoadPicture("")
+    call ok(Err.number = 76, "LoadPicture(""""): Err.number = " & Err.number)
+
+    ' calling a name nothing declared, where Option Explicit is not in force
+    call Err.clear()
+    Execute "Call NoSuchSubAnywhere()"
+    call ok(Err.number = 13, "calling an undeclared name: Err.number = " & Err.number)
+
+    call Err.clear()
+    call ok(ScriptEngineMajorVersion() = 10, "ScriptEngineMajorVersion() = " & ScriptEngineMajorVersion())
+    call ok(ScriptEngineMinorVersion() = 8, "ScriptEngineMinorVersion() = " & ScriptEngineMinorVersion())
+end sub
+
+call testWindowsBehavior()
+
 Call reportSuccess()
