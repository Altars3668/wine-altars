From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 20:00:14 -0400
Subject: [PATCH] kernelbase: A known DLL asked for a signed target is refused
 as one found.

A relative name with LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR is an invalid
parameter, except when it names a known DLL, which Windows 11 finds
before any search path and refuses as unsigned (ERROR_INVALID_IMAGE_HASH,
imagehlp in tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernelbase/loader.c b/dlls/kernelbase/loader.c
index aaf079a3ea3..b530114865a 100644
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -162,6 +162,30 @@ static BOOL has_signature( HMODULE module )
     return dir->VirtualAddress && dir->Size;
 }
 
+/* whether a name is one of the known DLLs, which are found before any search path */
+static BOOL is_known_dll( const UNICODE_STRING *libname )
+{
+    static const WCHAR knowndlls[] = L"\\KnownDlls\\", knowndlls32[] = L"\\KnownDlls32\\";
+    const WCHAR *dir = NtCurrentTeb()->WowTebOffset ? knowndlls32 : knowndlls;
+    WCHAR name[MAX_PATH + 16];
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    HANDLE section;
+    SIZE_T len = libname->Length / sizeof(WCHAR);
+
+    if (len > MAX_PATH) return FALSE;
+    lstrcpyW( name, dir );
+    memcpy( name + lstrlenW( dir ), libname->Buffer, len * sizeof(WCHAR) );
+    name[lstrlenW( dir ) + len] = 0;
+    if (wcspbrk( name + lstrlenW( dir ), L"\\/" )) return FALSE;
+    if (!wcschr( name + lstrlenW( dir ), '.' )) lstrcatW( name, L".dll" );
+    RtlInitUnicodeString( &str, name );
+    InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE, 0, NULL );
+    if (NtOpenSection( &section, SECTION_QUERY, &attr )) return FALSE;
+    NtClose( section );
+    return TRUE;
+}
+
 /******************************************************************
  *      load_library
  */
@@ -190,7 +214,7 @@ static HMODULE load_library( const UNICODE_STRING *libname, DWORD flags )
         }
         if (!has_signature( NtCurrentTeb()->Peb->ImageBaseAddress ) &&
             (!(flags & LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR) ||
-             RtlDetermineDosPathNameType_U( libname->Buffer ) != RtlPathTypeRelative))
+             RtlDetermineDosPathNameType_U( libname->Buffer ) != RtlPathTypeRelative || is_known_dll( libname )))
         {
             SetLastError( ERROR_INVALID_IMAGE_HASH );
             return 0;
