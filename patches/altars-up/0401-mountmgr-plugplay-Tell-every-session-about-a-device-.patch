From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:08:04 -0400
Subject: [PATCH] mountmgr, plugplay: Tell every session about a device change.

They run as services, in session 0 from now on, and the programs that want to know are in the
user's session, which a BroadcastSystemMessage of their own does not reach.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/mountmgr.sys/Makefile.in b/dlls/mountmgr.sys/Makefile.in
index 5d732eb9e7c..9b70feb0d20 100644
--- a/dlls/mountmgr.sys/Makefile.in
+++ b/dlls/mountmgr.sys/Makefile.in
@@ -1,7 +1,7 @@
 MODULE    = mountmgr.sys
 UNIXLIB   = mountmgr.so
 IMPORTS   = uuid advapi32 ntoskrnl
-DELAYIMPORTS = user32
+DELAYIMPORTS = user32 winsta
 UNIX_CFLAGS  = $(DBUS_CFLAGS) $(HAL_CFLAGS)
 UNIX_LIBS    = $(DISKARBITRATION_LIBS) $(SYSTEMCONFIGURATION_LIBS) $(CORESERVICES_LIBS) $(SECURITY_LIBS)
 
diff --git a/dlls/mountmgr.sys/device.c b/dlls/mountmgr.sys/device.c
index acd52558853..d5d8fb9f5b0 100644
--- a/dlls/mountmgr.sys/device.c
+++ b/dlls/mountmgr.sys/device.c
@@ -28,6 +28,7 @@
 #include "winreg.h"
 #include "winnls.h"
 #include "winuser.h"
+#include "winsta.h"
 #include "dbt.h"
 #include "unixlib.h"
 
@@ -145,8 +146,9 @@ static void send_notify( int drive, int code )
     info.dbcv_reserved   = 0;
     info.dbcv_unitmask   = 1 << drive;
     info.dbcv_flags      = DBTF_MEDIA;
-    BroadcastSystemMessageW( BSF_FORCEIFHUNG|BSF_QUERY, NULL,
-                             WM_DEVICECHANGE, code, (LPARAM)&info );
+    /* to every session: this runs in the services' session, and the programs to tell are in the user's */
+    WinStationBroadcastSystemMessage( NULL, TRUE, 0, 0, BSF_FORCEIFHUNG | BSF_QUERY, NULL,
+                                      WM_DEVICECHANGE, code, (LPARAM)&info, NULL );
 }
 
 #define BLOCK_SIZE 2048
diff --git a/programs/plugplay/Makefile.in b/programs/plugplay/Makefile.in
index ce595a6d759..416c18bd0ba 100644
--- a/programs/plugplay/Makefile.in
+++ b/programs/plugplay/Makefile.in
@@ -1,5 +1,5 @@
 MODULE    = plugplay.exe
-IMPORTS   = advapi32 rpcrt4 user32
+IMPORTS   = advapi32 rpcrt4 user32 winsta
 
 EXTRADLLFLAGS = -mconsole -municode
 
diff --git a/programs/plugplay/main.c b/programs/plugplay/main.c
index d8f4d44f448..58f8af89086 100644
--- a/programs/plugplay/main.c
+++ b/programs/plugplay/main.c
@@ -19,6 +19,8 @@
 #define WIN32_LEAN_AND_MEAN
 
 #include <windows.h>
+#include <winternl.h>
+#include <winsta.h>
 #include <dbt.h>
 #include "winsvc.h"
 #include "wine/debug.h"
@@ -145,10 +147,11 @@ void __cdecl plugplay_send_event( const WCHAR *path, DWORD code, const BYTE *dat
     struct event *event;
     const DEV_BROADCAST_HDR *header = (const DEV_BROADCAST_HDR *)data;
 
+    /* to every session: this runs in the services' session, and the programs to tell are in the user's */
     if (header->dbch_devicetype == DBT_DEVTYP_DEVICEINTERFACE)
     {
-        BroadcastSystemMessageW( 0, NULL, WM_DEVICECHANGE, code, (LPARAM)data );
-        BroadcastSystemMessageW( 0, NULL, WM_DEVICECHANGE, DBT_DEVNODES_CHANGED, 0 );
+        WinStationBroadcastSystemMessage( NULL, TRUE, 0, 0, 0, NULL, WM_DEVICECHANGE, code, (LPARAM)data, NULL );
+        WinStationBroadcastSystemMessage( NULL, TRUE, 0, 0, 0, NULL, WM_DEVICECHANGE, DBT_DEVNODES_CHANGED, 0, NULL );
     }
 
     EnterCriticalSection( &plugplay_cs );
