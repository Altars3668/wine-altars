From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 15:33:12 -0400
Subject: [PATCH] msctf: Find a thread's manager by thread id instead of in a
 TLS slot.

ThreadMgr_Destructor() runs on the thread that makes the last Release()
and cleared that thread's slot, not the one of the thread that created
the manager, so when the last reference went away on another thread,
the creating thread's slot kept pointing at freed memory and its next
TF_GetThreadMgr(), TF_CreateThreadMgr() or focus hook used it: the new
test crashed in TF_GetThreadMgr() with an access violation.

Keep the managers in a list under a critical section, look them up by
the calling thread's id, and take them out in the destructor, as
CrossOver 26.3 does.  Unlike CrossOver, a lookup does not take a
reference on a manager whose last one is being released on another
thread, and TF_GetThreadMgr() still returns S_OK and NULL when the
thread has none.

The test has not been run on Windows yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msctf/msctf.c b/dlls/msctf/msctf.c
index e2dde836b12..0d7b86566b4 100644
--- a/dlls/msctf/msctf.c
+++ b/dlls/msctf/msctf.c
@@ -67,7 +67,6 @@ static UINT array_size;
 static struct list AtsList = LIST_INIT(AtsList);
 static UINT activated = 0;
 
-DWORD tlsIndex = 0;
 TfClientId processId = 0;
 ITfCompartmentMgr *globalCompartmentMgr = NULL;
 
@@ -394,23 +393,20 @@ HRESULT add_active_textservice(TF_LANGUAGEPROFILE *lp)
     ActivatedTextService *actsvr;
     ITfCategoryMgr *catmgr;
     AtsEntry *entry;
-    ITfThreadMgrEx *tm = TlsGetValue(tlsIndex);
+    ITfThreadMgr *tm;
     ITfClientId *clientid;
 
+    TF_GetThreadMgr(&tm);
     if (!tm) return E_UNEXPECTED;
 
     actsvr = malloc(sizeof(ActivatedTextService));
-    if (!actsvr) return E_OUTOFMEMORY;
+    if (!actsvr) goto fail;
 
-    ITfThreadMgrEx_QueryInterface(tm, &IID_ITfClientId, (void **)&clientid);
+    ITfThreadMgr_QueryInterface(tm, &IID_ITfClientId, (void **)&clientid);
     ITfClientId_GetClientId(clientid, &lp->clsid, &actsvr->tid);
     ITfClientId_Release(clientid);
 
-    if (!actsvr->tid)
-    {
-        free(actsvr);
-        return E_OUTOFMEMORY;
-    }
+    if (!actsvr->tid) goto fail;
 
     actsvr->pITfTextInputProcessor = NULL;
     actsvr->LanguageProfile = *lp;
@@ -437,20 +433,21 @@ HRESULT add_active_textservice(TF_LANGUAGEPROFILE *lp)
         deactivate_remove_conflicting_ts(&actsvr->LanguageProfile.catid);
 
     if (activated > 0)
-        activate_given_ts(actsvr, tm);
+        activate_given_ts(actsvr, (ITfThreadMgrEx *)tm);
 
     entry = malloc(sizeof(AtsEntry));
-
-    if (!entry)
-    {
-        free(actsvr);
-        return E_OUTOFMEMORY;
-    }
+    if (!entry) goto fail;
 
     entry->ats = actsvr;
     list_add_head(&AtsList, &entry->entry);
 
+    ITfThreadMgr_Release(tm);
     return S_OK;
+
+fail:
+    ITfThreadMgr_Release(tm);
+    free(actsvr);
+    return E_OUTOFMEMORY;
 }
 
 BOOL get_active_textservice(REFCLSID rclsid, TF_LANGUAGEPROFILE *profile)
@@ -551,16 +548,6 @@ HRESULT set_textservice_sink(TfClientId tid, REFCLSID iid, IUnknown* sink)
 BOOL WINAPI DllMain(HINSTANCE hinst, DWORD fdwReason, LPVOID fImpLoad)
 {
     TRACE("%p 0x%lx %p\n", hinst, fdwReason, fImpLoad);
-    switch (fdwReason)
-    {
-        case DLL_PROCESS_ATTACH:
-            tlsIndex = TlsAlloc();
-            break;
-        case DLL_PROCESS_DETACH:
-            if (fImpLoad) break;
-            TlsFree(tlsIndex);
-            break;
-    }
     return TRUE;
 }
 
@@ -592,20 +579,6 @@ HRESULT WINAPI TF_CreateThreadMgr(ITfThreadMgr **pptim)
     return ThreadMgr_Constructor(NULL,(IUnknown**)pptim);
 }
 
-/***********************************************************************
- *              TF_GetThreadMgr (MSCTF.@)
- */
-HRESULT WINAPI TF_GetThreadMgr(ITfThreadMgr **pptim)
-{
-    TRACE("\n");
-    *pptim = TlsGetValue(tlsIndex);
-
-    if (*pptim)
-        ITfThreadMgr_AddRef(*pptim);
-
-    return S_OK;
-}
-
 /***********************************************************************
  *              SetInputScope(MSCTF.@)
  */
diff --git a/dlls/msctf/msctf_internal.h b/dlls/msctf/msctf_internal.h
index 1d94fa1b9b3..e465b985bf2 100644
--- a/dlls/msctf/msctf_internal.h
+++ b/dlls/msctf/msctf_internal.h
@@ -36,7 +36,6 @@
 #define COOKIE_MAGIC_INPUTPROCESSORPROFILEACTIVATIONSINK 0x00b0
 #define COOKIE_MAGIC_ACTIVELANGSINK 0x00c0
 
-extern DWORD tlsIndex;
 extern TfClientId processId;
 extern ITfCompartmentMgr *globalCompartmentMgr;
 
diff --git a/dlls/msctf/tests/inputprocessor.c b/dlls/msctf/tests/inputprocessor.c
index b912ecda697..9790d0f93ca 100644
--- a/dlls/msctf/tests/inputprocessor.c
+++ b/dlls/msctf/tests/inputprocessor.c
@@ -2651,8 +2651,98 @@ static void test_function_provider(void)
     ITfFunctionProvider_Release(provider);
 }
 
+static HRESULT (WINAPI *pTF_CreateThreadMgr)(ITfThreadMgr **);
+static HRESULT (WINAPI *pTF_GetThreadMgr)(ITfThreadMgr **);
+
+static DWORD WINAPI release_thread_mgr(void *param)
+{
+    return ITfThreadMgr_Release(param);
+}
+
+static DWORD WINAPI test_cross_thread_release_thread(void *param)
+{
+    ITfThreadMgr *mgr = NULL, *found = (void *)0xdeadbeef, *new_mgr = NULL;
+    ITfDocumentMgr *doc_mgr = NULL;
+    DWORD ret;
+    HANDLE thread;
+    HRESULT hr;
+
+    hr = pTF_CreateThreadMgr(&mgr);
+    ok(hr == S_OK && mgr != NULL, "TF_CreateThreadMgr failed: %#lx, %p\n", hr, mgr);
+    if (hr != S_OK || !mgr) return 0;
+
+    thread = CreateThread(NULL, 0, release_thread_mgr, mgr, 0, NULL);
+    ok(thread != NULL, "Failed to create release thread\n");
+    if (!thread)
+    {
+        ITfThreadMgr_Release(mgr);
+        return 0;
+    }
+
+    ret = WaitForSingleObject(thread, INFINITE);
+    ok(ret == WAIT_OBJECT_0, "Failed to wait for release thread: %#lx\n", ret);
+    if (ret == WAIT_OBJECT_0)
+    {
+        GetExitCodeThread(thread, &ret);
+        ok(ret == 0, "Last Release returned %lu\n", ret);
+    }
+    CloseHandle(thread);
+    if (ret != 0) return 0;
+
+    hr = pTF_GetThreadMgr(&found);
+    ok(found == NULL, "TF_GetThreadMgr returned %p after cross-thread Release (hr %#lx)\n", found, hr);
+    if (found) return 0;
+
+    hr = pTF_CreateThreadMgr(&new_mgr);
+    ok(hr == S_OK && new_mgr != NULL, "Failed to create a replacement thread manager: %#lx, %p\n", hr, new_mgr);
+    if (hr != S_OK || !new_mgr) return 0;
+
+    hr = ITfThreadMgr_CreateDocumentMgr(new_mgr, &doc_mgr);
+    ok(hr == S_OK && doc_mgr != NULL, "Replacement thread manager is unusable: %#lx, %p\n", hr, doc_mgr);
+    if (doc_mgr) ITfDocumentMgr_Release(doc_mgr);
+    ITfThreadMgr_Release(new_mgr);
+    return 0xdeadcafe;
+}
+
+static void test_cross_thread_release(void)
+{
+    HMODULE module;
+    HANDLE thread;
+    DWORD ret;
+
+    module = LoadLibraryW(L"msctf.dll");
+    ok(module != NULL, "Failed to load msctf.dll\n");
+    if (!module) return;
+
+    pTF_CreateThreadMgr = (void *)GetProcAddress(module, "TF_CreateThreadMgr");
+    pTF_GetThreadMgr = (void *)GetProcAddress(module, "TF_GetThreadMgr");
+    ok(pTF_CreateThreadMgr != NULL && pTF_GetThreadMgr != NULL, "Thread manager exports unavailable\n");
+    if (!pTF_CreateThreadMgr || !pTF_GetThreadMgr)
+    {
+        FreeLibrary(module);
+        return;
+    }
+
+    thread = CreateThread(NULL, 0, test_cross_thread_release_thread, NULL, 0, NULL);
+    ok(thread != NULL, "Failed to create thread manager test thread\n");
+    if (thread)
+    {
+        ret = WaitForSingleObject(thread, INFINITE);
+        ok(ret == WAIT_OBJECT_0, "Failed to wait for thread manager test thread: %#lx\n", ret);
+        if (ret == WAIT_OBJECT_0)
+        {
+            GetExitCodeThread(thread, &ret);
+            ok(ret == 0xdeadcafe, "Thread manager test ended unexpectedly: %#lx\n", ret);
+        }
+        CloseHandle(thread);
+    }
+    FreeLibrary(module);
+}
+
 START_TEST(inputprocessor)
 {
+    test_cross_thread_release();
+
     if (SUCCEEDED(initialize()))
     {
         test_Register();
diff --git a/dlls/msctf/threadmgr.c b/dlls/msctf/threadmgr.c
index 312b527eb74..b67df0a5540 100644
--- a/dlls/msctf/threadmgr.c
+++ b/dlls/msctf/threadmgr.c
@@ -41,6 +41,16 @@ DEFINE_GUID(GUID_SYSTEM_FUNCTIONPROVIDER, 0x9a698bb0,0x0f21,0x11d3,0x8d,0xf1,0x0
 
 WINE_DEFAULT_DEBUG_CHANNEL(msctf);
 
+static CRITICAL_SECTION threadmgr_cs;
+static CRITICAL_SECTION_DEBUG threadmgr_cs_debug =
+{
+    0, 0, &threadmgr_cs,
+    { &threadmgr_cs_debug.ProcessLocksList, &threadmgr_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": threadmgr_cs") }
+};
+static CRITICAL_SECTION threadmgr_cs = { &threadmgr_cs_debug, -1, 0, 0, 0, 0 };
+static struct list threadmgr_list = LIST_INIT( threadmgr_list );
+
 typedef struct tagPreservedKey
 {
     struct list     entry;
@@ -103,6 +113,9 @@ typedef struct tagACLMulti {
     struct list     ThreadMgrEventSink;
     struct list     UIElementSink;
     struct list     InputProcessorProfileActivationSink;
+
+    DWORD thread_id;
+    struct list entry;
 } ThreadMgr;
 
 typedef struct tagEnumTfDocumentMgr {
@@ -331,6 +344,35 @@ static const ITfFunctionProviderVtbl TfFunctionProviderVtbl =
     func_provider_GetFunction,
 };
 
+/***********************************************************************
+ *              TF_GetThreadMgr (MSCTF.@)
+ */
+HRESULT WINAPI TF_GetThreadMgr(ITfThreadMgr **pptim)
+{
+    ThreadMgr *cursor;
+    DWORD thread_id = GetCurrentThreadId();
+
+    TRACE("\n");
+    *pptim = NULL;
+
+    EnterCriticalSection(&threadmgr_cs);
+    LIST_FOR_EACH_ENTRY(cursor, &threadmgr_list, ThreadMgr, entry)
+    {
+        LONG ref;
+
+        if (cursor->thread_id != thread_id) continue;
+        /* one whose last reference is going away on another thread is only waiting to leave the list */
+        for (ref = cursor->refCount; ref; ref = cursor->refCount)
+            if (InterlockedCompareExchange(&cursor->refCount, ref + 1, ref) == ref) break;
+        if (!ref) continue;
+        *pptim = (ITfThreadMgr *)&cursor->ITfThreadMgrEx_iface;
+        break;
+    }
+    LeaveCriticalSection(&threadmgr_cs);
+
+    return S_OK;
+}
+
 static void ThreadMgr_Destructor(ThreadMgr *This)
 {
     struct list *cursor, *cursor2;
@@ -339,7 +381,9 @@ static void ThreadMgr_Destructor(ThreadMgr *This)
     if (This->focusHook)
         UnhookWindowsHookEx(This->focusHook);
 
-    TlsSetValue(tlsIndex,NULL);
+    EnterCriticalSection(&threadmgr_cs);
+    list_remove(&This->entry);
+    LeaveCriticalSection(&threadmgr_cs);
     TRACE("destroying %p\n", This);
     if (This->focus)
         ITfDocumentMgr_Release(This->focus);
@@ -562,17 +606,21 @@ static HRESULT WINAPI ThreadMgr_SetFocus(ITfThreadMgrEx *iface, ITfDocumentMgr *
 
 static LRESULT CALLBACK ThreadFocusHookProc(int nCode, WPARAM wParam, LPARAM lParam)
 {
+    ITfThreadMgr *tm;
     ThreadMgr *This;
+    LRESULT ret;
 
-    This = TlsGetValue(tlsIndex);
-    if (!This)
+    TF_GetThreadMgr(&tm);
+    if (!tm)
     {
         ERR("Hook proc but no ThreadMgr for this thread. Serious Error\n");
         return 0;
     }
+    This = impl_from_ITfThreadMgrEx((ITfThreadMgrEx *)tm);
     if (!This->focusHook)
     {
         ERR("Hook proc but no ThreadMgr focus Hook. Serious Error\n");
+        ITfThreadMgr_Release(tm);
         return 0;
     }
 
@@ -593,7 +641,9 @@ static LRESULT CALLBACK ThreadFocusHookProc(int nCode, WPARAM wParam, LPARAM lPa
         }
     }
 
-    return CallNextHookEx(This->focusHook, nCode, wParam, lParam);
+    ret = CallNextHookEx(This->focusHook, nCode, wParam, lParam);
+    ITfThreadMgr_Release(tm);
+    return ret;
 }
 
 static HRESULT SetupWindowsHook(ThreadMgr *This)
@@ -1532,13 +1582,8 @@ HRESULT ThreadMgr_Constructor(IUnknown *pUnkOuter, IUnknown **ppOut)
         return CLASS_E_NOAGGREGATION;
 
     /* Only 1 ThreadMgr is created per thread */
-    This = TlsGetValue(tlsIndex);
-    if (This)
-    {
-        ThreadMgr_AddRef(&This->ITfThreadMgrEx_iface);
-        *ppOut = (IUnknown*)&This->ITfThreadMgrEx_iface;
-        return S_OK;
-    }
+    TF_GetThreadMgr((ITfThreadMgr **)ppOut);
+    if (*ppOut) return S_OK;
 
     This = calloc(1, sizeof(ThreadMgr));
     if (This == NULL)
@@ -1554,7 +1599,6 @@ HRESULT ThreadMgr_Constructor(IUnknown *pUnkOuter, IUnknown **ppOut)
     This->ITfSourceSingle_iface.lpVtbl = &SourceSingleVtbl;
     This->ITfFunctionProvider_iface.lpVtbl = &TfFunctionProviderVtbl;
     This->refCount = 1;
-    TlsSetValue(tlsIndex,This);
 
     CompartmentMgr_Constructor((IUnknown*)&This->ITfThreadMgrEx_iface, &IID_IUnknown, (IUnknown**)&This->CompartmentMgr);
 
@@ -1571,6 +1615,11 @@ HRESULT ThreadMgr_Constructor(IUnknown *pUnkOuter, IUnknown **ppOut)
     list_init(&This->UIElementSink);
     list_init(&This->InputProcessorProfileActivationSink);
 
+    This->thread_id = GetCurrentThreadId();
+    EnterCriticalSection(&threadmgr_cs);
+    list_add_tail(&threadmgr_list, &This->entry);
+    LeaveCriticalSection(&threadmgr_cs);
+
     TRACE("returning %p\n", This);
     *ppOut = (IUnknown *)&This->ITfThreadMgrEx_iface;
     return S_OK;
