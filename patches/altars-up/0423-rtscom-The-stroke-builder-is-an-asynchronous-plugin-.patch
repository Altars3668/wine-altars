From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 06:55:09 -0400
Subject: [PATCH] rtscom: The stroke builder is an asynchronous plugin only.

On Windows 11 a StrokeBuilder answers E_NOINTERFACE for IStylusSyncPlugin.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/rtscom/rtscom_main.c b/dlls/rtscom/rtscom_main.c
index 5dd575441ab..57aa305f020 100644
--- a/dlls/rtscom/rtscom_main.c
+++ b/dlls/rtscom/rtscom_main.c
@@ -1336,7 +1336,6 @@ struct built_stroke
 struct stroke_builder
 {
     IStrokeBuilder IStrokeBuilder_iface;
-    IStylusSyncPlugin IStylusSyncPlugin_iface;
     IStylusAsyncPlugin IStylusAsyncPlugin_iface;
     LONG ref;
 
@@ -1356,10 +1355,9 @@ static HRESULT WINAPI stroke_builder_QueryInterface( IStrokeBuilder *iface, REFI
 
     TRACE( "(%p)->(%s %p)\n", This, debugstr_guid( iid ), obj );
 
+    /* an asynchronous plugin only, on Windows too */
     if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IStrokeBuilder ))
         *obj = iface;
-    else if (IsEqualIID( iid, &IID_IStylusSyncPlugin ))
-        *obj = &This->IStylusSyncPlugin_iface;
     else if (IsEqualIID( iid, &IID_IStylusAsyncPlugin ) || IsEqualIID( iid, &IID_IStylusPlugin ))
         *obj = &This->IStylusAsyncPlugin_iface;
     else
@@ -1653,13 +1651,9 @@ static const struct IStrokeBuilderVtbl stroke_builder_vtbl =
     stroke_builder_putref_Ink,
 };
 
-static const IStylusPluginVtbl stroke_builder_sync_vtbl;
-
 /* as a plugin of a stylus, the builder makes a stroke of every touch of the stylus */
 static struct stroke_builder *impl_from_plugin( IStylusPlugin *iface )
 {
-    if (iface->lpVtbl == (const IStylusPluginVtbl *)&stroke_builder_sync_vtbl)
-        return CONTAINING_RECORD( iface, struct stroke_builder, IStylusSyncPlugin_iface );
     return CONTAINING_RECORD( iface, struct stroke_builder, IStylusAsyncPlugin_iface );
 }
 
@@ -1814,39 +1808,28 @@ static HRESULT WINAPI builder_plugin_DataInterest( IStylusPlugin *iface, RealTim
     return S_OK;
 }
 
-#define BUILDER_PLUGIN_METHODS \
-    builder_plugin_RealTimeStylusEnabled, \
-    builder_plugin_RealTimeStylusDisabled, \
-    builder_plugin_StylusInRange, \
-    builder_plugin_StylusOutOfRange, \
-    builder_plugin_StylusDown, \
-    builder_plugin_StylusUp, \
-    builder_plugin_StylusButtonDown, \
-    builder_plugin_StylusButtonUp, \
-    builder_plugin_InAirPackets, \
-    builder_plugin_Packets, \
-    builder_plugin_CustomStylusDataAdded, \
-    builder_plugin_SystemEvent, \
-    builder_plugin_TabletAdded, \
-    builder_plugin_TabletRemoved, \
-    builder_plugin_Error, \
-    builder_plugin_UpdateMapping, \
-    builder_plugin_DataInterest
-
-static const IStylusPluginVtbl stroke_builder_sync_vtbl =
-{
-    builder_plugin_QueryInterface,
-    builder_plugin_AddRef,
-    builder_plugin_Release,
-    BUILDER_PLUGIN_METHODS
-};
-
 static const IStylusPluginVtbl stroke_builder_async_vtbl =
 {
     builder_plugin_QueryInterface,
     builder_plugin_AddRef,
     builder_plugin_Release,
-    BUILDER_PLUGIN_METHODS
+    builder_plugin_RealTimeStylusEnabled,
+    builder_plugin_RealTimeStylusDisabled,
+    builder_plugin_StylusInRange,
+    builder_plugin_StylusOutOfRange,
+    builder_plugin_StylusDown,
+    builder_plugin_StylusUp,
+    builder_plugin_StylusButtonDown,
+    builder_plugin_StylusButtonUp,
+    builder_plugin_InAirPackets,
+    builder_plugin_Packets,
+    builder_plugin_CustomStylusDataAdded,
+    builder_plugin_SystemEvent,
+    builder_plugin_TabletAdded,
+    builder_plugin_TabletRemoved,
+    builder_plugin_Error,
+    builder_plugin_UpdateMapping,
+    builder_plugin_DataInterest,
 };
 
 static HRESULT stroke_builder_create( IUnknown *outer, REFIID iid, void **obj )
@@ -1857,7 +1840,6 @@ static HRESULT stroke_builder_create( IUnknown *outer, REFIID iid, void **obj )
     if (outer) return CLASS_E_NOAGGREGATION;
     if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
     This->IStrokeBuilder_iface.lpVtbl = &stroke_builder_vtbl;
-    This->IStylusSyncPlugin_iface.lpVtbl = (const IStylusSyncPluginVtbl *)&stroke_builder_sync_vtbl;
     This->IStylusAsyncPlugin_iface.lpVtbl = (const IStylusAsyncPluginVtbl *)&stroke_builder_async_vtbl;
     This->ref = 1;
     InitializeCriticalSectionEx( &This->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
diff --git a/dlls/rtscom/tests/rtscom.c b/dlls/rtscom/tests/rtscom.c
index 85dbb7513a4..692678a3ee1 100644
--- a/dlls/rtscom/tests/rtscom.c
+++ b/dlls/rtscom/tests/rtscom.c
@@ -288,8 +288,9 @@ static void test_stroke_builder(void)
     hr = IStrokeBuilder_QueryInterface(builder, &IID_IStylusAsyncPlugin, (void **)&unk);
     ok(hr == S_OK, "Got hr %#lx.\n", hr);
     if (hr == S_OK) IUnknown_Release(unk);
+    /* only an asynchronous one */
     hr = IStrokeBuilder_QueryInterface(builder, &IID_IStylusSyncPlugin, (void **)&unk);
-    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(hr == E_NOINTERFACE, "Got hr %#lx.\n", hr);
     if (hr == S_OK) IUnknown_Release(unk);
 
     hr = CoCreateInstance(&CLSID_InkDisp, NULL, CLSCTX_INPROC_SERVER, &IID_IInkDisp, (void **)&ink);
