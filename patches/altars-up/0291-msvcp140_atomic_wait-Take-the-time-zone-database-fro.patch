+/* the IANA zones and their links, and what a zone's offset is at an instant */
+static void test_tzdb_zones(struct tzdb_time_zones *z)
+{
+    static const struct
+    {
+        double time;
+        int32_t offset, save;
+        double begin, end;
+    }
+    tests[] =
+    {
+        /* 2026-07-01T12:00Z, in daylight saving time from 2026-03-08T07:00Z to 2026-11-01T06:00Z */
+        {1782907200000.0, -14400000, 3600000, 1772953200000.0, 1793512800000.0},
+        /* 2026-01-15T12:00Z, in standard time from 2025-11-02T06:00Z to 2026-03-08T07:00Z */
+        {1768478400000.0, -18000000, 0, 1762063200000.0, 1772953200000.0},
