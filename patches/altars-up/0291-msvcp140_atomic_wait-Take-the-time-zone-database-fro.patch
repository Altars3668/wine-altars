     free(c);
 }
 
+/* the abbreviation when ICU's short name does not convert: "+05", "-0930" */
+static char *offset_abbrev(int32_t offset)
+{
+    unsigned int minutes = (offset < 0 ? -offset : offset) / 60000;
+    char *ret = malloc(6);
+
+    if (!ret) return NULL;
+    if (minutes % 60) sprintf(ret, "%c%02u%02u", offset < 0 ? '-' : '+', minutes / 60 % 100, minutes % 60);
+    else sprintf(ret, "%c%02u", offset < 0 ? '-' : '+', minutes / 60 % 100);
+    return ret;
+}
+
+struct tzdb_sys_info * __stdcall __std_tzdb_get_sys_info(const char *tz, size_t len, double time)
+{
+    /* the name is followed by what the caller wants, or by its null terminator for everything */
+    enum tzdb_sys_info_type type = tz[len];
+    UErrorCode err = U_ZERO_ERROR;
+    struct short_name_params params;
+    struct tzdb_sys_info *info;
+    UCalendar *cal = NULL;
+    int32_t abbrev_len;
+    UDate transition;
+    UChar *abbrev;
+    WCHAR *name;
+
+    TRACE("(%s %Iu %.17g)\n", debugstr_an(tz, len), len, time);
+
+    if (!(info = calloc(1, sizeof(*info)))) return NULL;
+    if (!init_icu())
+    {
+        info->error = TZDB_ERROR_WIN;
+        return info;
+    }
+    if (!(name = wide_string(tz, len)))
+    {
+        if (GetLastError() == ERROR_NOT_ENOUGH_MEMORY) goto nomem;
+        info->error = TZDB_ERROR_WIN;
+        return info;
+    }
+    cal = icu.ucal_open(name, -1, NULL, UCAL_DEFAULT, &err);
+    free(name);
+    if (!U_FAILURE(err)) icu.ucal_setMillis(cal, time, &err);
+    if (!U_FAILURE(err)) info->save = icu.ucal_get(cal, UCAL_DST_OFFSET, &err);
+    if (!U_FAILURE(err)) info->offset = icu.ucal_get(cal, UCAL_ZONE_OFFSET, &err) + info->save;
+    if (U_FAILURE(err)) goto icu_error;
+    if (type == TZDB_SYS_INFO_OFFSET_ONLY) goto done;
+
+    /* a zone that never changed has its range reach as far as ICU's dates go */
+    info->begin = icu.ucal_getTimeZoneTransitionDate(cal, UCAL_TZ_TRANSITION_PREVIOUS_INCLUSIVE, &transition, &err)
+                  ? transition : -DBL_MAX;
+    if (!U_FAILURE(err))
+        info->end = icu.ucal_getTimeZoneTransitionDate(cal, UCAL_TZ_TRANSITION_NEXT, &transition, &err)
+                    ? transition : DBL_MAX;
+    if (U_FAILURE(err)) goto icu_error;
+    if (type == TZDB_SYS_INFO_OFFSET_AND_RANGE) goto done;
+
+    params.cal = cal;
+    params.daylight = info->save != 0;
+    if (!(abbrev = icu_string(get_short_name, &params, &abbrev_len))) goto icu_error;
+    info->abbrev = narrow_string(abbrev, abbrev_len);
+    free(abbrev);
+    if (!info->abbrev && !(info->abbrev = offset_abbrev(info->offset))) goto nomem;
+
+done:
+    icu.ucal_close(cal);
+    return info;
+icu_error:
+    info->error = TZDB_ERROR_ICU;
+    if (cal) icu.ucal_close(cal);
+    return info;
+nomem:
+    if (cal) icu.ucal_close(cal);
+    free(info);
+    return NULL;
+}
+
+void __stdcall __std_tzdb_delete_sys_info(struct tzdb_sys_info *info)
+{
+    TRACE("(%p)\n", info);
+
+    if (!info) return;
+    free(info->abbrev);
+    free(info);
+}
