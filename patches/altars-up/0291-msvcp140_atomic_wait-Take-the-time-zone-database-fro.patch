+/* Windows keeps the leap seconds it knows of in the registry, twelve bytes each. */
 struct tzdb_leap_second * __stdcall __std_tzdb_get_leap_seconds(size_t prev_size, size_t *new_size)
 {
-    FIXME("(%#Ix %p) stub\n", prev_size, new_size);
+    struct tzdb_leap_second *ret = NULL;
+    DWORD size = 0;
+    LSTATUS status;
+    HKEY key;
+
+    TRACE("(%#Ix %p)\n", prev_size, new_size);
 
     *new_size = 0;
-    return NULL;
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, L"SYSTEM\\CurrentControlSet\\Control\\LeapSecondInformation",
+                      0, KEY_READ, &key))
+        return NULL;
+
+    status = RegQueryValueExW(key, L"LeapSeconds", NULL, NULL, NULL, &size);
+    *new_size = size / sizeof(*ret);
+    if ((!status || status == ERROR_MORE_DATA) && *new_size > prev_size)
+    {
+        if (!(ret = malloc(*new_size * sizeof(*ret)))) status = ERROR_NOT_ENOUGH_MEMORY;
+        else if ((status = RegQueryValueExW(key, L"LeapSeconds", NULL, NULL, (BYTE *)ret, &size)))
+            *new_size = 0;
+    }
+    RegCloseKey(key);
+    if (status) SetLastError(status);
+    return ret;
 }
 
 void __stdcall __std_tzdb_delete_leap_seconds(struct tzdb_leap_second *l)
