     if (GetDynamicTimeZoneInformation(&tzd) == TIME_ZONE_ID_INVALID)
     {
@@ -294,16 +557,122 @@ void __stdcall __std_tzdb_delete_current_zone(struct tzdb_current_zone *c)
 {
     TRACE("(%p)\n", c);
 
