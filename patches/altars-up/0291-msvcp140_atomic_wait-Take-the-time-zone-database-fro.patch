+/* The time zone database comes from icu.dll, as on Windows; without it the Windows time zones stand in
+ * for the names, and nothing can be converted. */
+static struct
+{
+    void (__cdecl *ucal_close)(UCalendar *);
+    int32_t (__cdecl *ucal_get)(const UCalendar *, UCalendarDateFields, UErrorCode *);
+    int32_t (__cdecl *ucal_getCanonicalTimeZoneID)(const UChar *, int32_t, UChar *, int32_t, UBool *, UErrorCode *);
+    int32_t (__cdecl *ucal_getDefaultTimeZone)(UChar *, int32_t, UErrorCode *);
+    int32_t (__cdecl *ucal_getTimeZoneDisplayName)(const UCalendar *, UCalendarDisplayNameType, const char *,
+                                                   UChar *, int32_t, UErrorCode *);
+    UBool (__cdecl *ucal_getTimeZoneTransitionDate)(const UCalendar *, UTimeZoneTransitionType, UDate *, UErrorCode *);
+    const char * (__cdecl *ucal_getTZDataVersion)(UErrorCode *);
+    UCalendar * (__cdecl *ucal_open)(const UChar *, int32_t, const char *, UCalendarType, UErrorCode *);
+    UEnumeration * (__cdecl *ucal_openTimeZoneIDEnumeration)(USystemTimeZoneType, const char *, const int32_t *, UErrorCode *);
+    void (__cdecl *ucal_setMillis)(UCalendar *, UDate, UErrorCode *);
+    void (__cdecl *uenum_close)(UEnumeration *);
+    int32_t (__cdecl *uenum_count)(UEnumeration *, UErrorCode *);
+    const UChar * (__cdecl *uenum_unext)(UEnumeration *, int32_t *, UErrorCode *);
+} icu;
+static BOOL have_icu;
+
+#define U_FAILURE(e) ((e) > U_ZERO_ERROR)
+
+static BOOL WINAPI load_icu(INIT_ONCE *once, void *param, void **context)
+{
+    HMODULE module = LoadLibraryExW(L"icu.dll", NULL, LOAD_LIBRARY_SEARCH_SYSTEM32);
+
+    if (!module)
+    {
+        WARN("icu.dll not found\n");
+        return TRUE;
+    }
+#define LOAD(f) if (!(icu.f = (void *)GetProcAddress(module, #f))) goto fail;
+    LOAD(ucal_close)
+    LOAD(ucal_get)
+    LOAD(ucal_getCanonicalTimeZoneID)
+    LOAD(ucal_getDefaultTimeZone)
+    LOAD(ucal_getTimeZoneDisplayName)
+    LOAD(ucal_getTimeZoneTransitionDate)
+    LOAD(ucal_getTZDataVersion)
+    LOAD(ucal_open)
+    LOAD(ucal_openTimeZoneIDEnumeration)
+    LOAD(ucal_setMillis)
+    LOAD(uenum_close)
+    LOAD(uenum_count)
+    LOAD(uenum_unext)
+#undef LOAD
+    have_icu = TRUE;
+    return TRUE;
+
+fail:
+    WARN("icu.dll lacks a function\n");
+    FreeLibrary(module);
+    return TRUE;
+}
+
+static BOOL init_icu(void)
+{
+    static INIT_ONCE once = INIT_ONCE_STATIC_INIT;
+
+    InitOnceExecuteOnce(&once, load_icu, NULL, NULL);
+    if (!have_icu) SetLastError(ERROR_MOD_NOT_FOUND);
+    return have_icu;
+}
+
+/* the code page the C++ library's file system functions use */
+static UINT narrow_code_page(void)
+{
+    if (___lc_codepage_func() == CP_UTF8) return CP_UTF8;
+    return AreFileApisANSI() ? CP_ACP : CP_OEMCP;
+}
+
+/* NULL when the string does not convert, with GetLastError() telling why */
+static char *narrow_string(const UChar *str, int len)
+{
+    UINT cp = narrow_code_page();
+    DWORD flags = cp == CP_UTF8 ? WC_ERR_INVALID_CHARS : WC_NO_BEST_FIT_CHARS;
+    BOOL used_default = FALSE, *used = cp == CP_UTF8 ? NULL : &used_default;
+    char *ret;
+    int size;
+
+    if (!(size = WideCharToMultiByte(cp, flags, str, len, NULL, 0, NULL, used))) return NULL;
+    if (used_default)
+    {
+        SetLastError(ERROR_NO_UNICODE_TRANSLATION);
+        return NULL;
+    }
+    if (!(ret = malloc(size + 1))) return NULL;
+    WideCharToMultiByte(cp, flags, str, len, ret, size, NULL, NULL);
+    ret[size] = 0;
+    return ret;
+}
+
+static WCHAR *wide_string(const char *str, size_t len)
+{
+    UINT cp = narrow_code_page();
+    WCHAR *ret;
+    int size;
+
+    if (len && !(size = MultiByteToWideChar(cp, MB_ERR_INVALID_CHARS, str, len, NULL, 0))) return NULL;
+    if (!len) size = 0;
+    if (!(ret = malloc((size + 1) * sizeof(*ret)))) return NULL;
+    if (len) MultiByteToWideChar(cp, MB_ERR_INVALID_CHARS, str, len, ret, size);
+    ret[size] = 0;
+    return ret;
+}
+
+/* ICU's time zone names are never long, but ask again with the right size if one is */
+static UChar *icu_string(int32_t (*get)(void *, UChar *, int32_t, UErrorCode *), void *ctx, int32_t *len)
+{
+    UErrorCode err = U_ZERO_ERROR;
+    int32_t size = 32;
+    UChar *buf;
+
+    if (!(buf = malloc(size * sizeof(*buf)))) return NULL;
+    *len = get(ctx, buf, size, &err);
+    if (err == U_BUFFER_OVERFLOW_ERROR && *len > 0)
+    {
+        free(buf);
+        size = *len + 1;
+        if (!(buf = malloc(size * sizeof(*buf)))) return NULL;
+        err = U_ZERO_ERROR;
+        *len = get(ctx, buf, size, &err);
+    }
+    if (U_FAILURE(err) || *len <= 0)
+    {
+        free(buf);
+        return NULL;
+    }
+    return buf;
+}
+
+struct canonical_id_params
+{
+    const UChar *id;
+    int32_t len;
+};
+
+static int32_t get_canonical_id(void *ctx, UChar *buf, int32_t size, UErrorCode *err)
+{
+    struct canonical_id_params *params = ctx;
+    UBool system;
+
+    return icu.ucal_getCanonicalTimeZoneID(params->id, params->len, buf, size, &system, err);
+}
+
+static int32_t get_default_zone(void *ctx, UChar *buf, int32_t size, UErrorCode *err)
+{
+    return icu.ucal_getDefaultTimeZone(buf, size, err);
+}
+
+struct short_name_params
+{
+    UCalendar *cal;
+    BOOL daylight;
+};
+
+static int32_t get_short_name(void *ctx, UChar *buf, int32_t size, UErrorCode *err)
+{
+    struct short_name_params *params = ctx;
+
+    return icu.ucal_getTimeZoneDisplayName(params->cal, params->daylight ? UCAL_SHORT_DST : UCAL_SHORT_STANDARD,
+                                           NULL, buf, size, err);
+}
+
+static struct tzdb_time_zones *windows_time_zones(struct tzdb_time_zones *z)
 {
     DYNAMIC_TIME_ZONE_INFORMATION tzd;
     static char ver[] = "2022g";
-    struct tzdb_time_zones *z;
     unsigned int i, j;
 
-    FIXME("returning Windows time zone names.\n");
+    FIXME("no icu.dll, returning Windows time zone names.\n");
 
-    z = calloc(1, sizeof(*z));
     while (!EnumDynamicTimeZoneInformation(z->count, &tzd))
         ++z->count;
 
@@ -251,16 +438,78 @@ struct tzdb_time_zones * __stdcall __std_tzdb_get_time_zones(void)
     return z;
 }
 
+void __stdcall __std_tzdb_delete_time_zones(struct tzdb_time_zones *z);
+
+struct tzdb_time_zones * __stdcall __std_tzdb_get_time_zones(void)
+{
+    UEnumeration *zones = NULL;
+    UErrorCode err = U_ZERO_ERROR;
+    struct tzdb_time_zones *z;
+    unsigned int i;
+
+    TRACE("()\n");
+
+    if (!(z = calloc(1, sizeof(*z)))) return NULL;
+    if (!init_icu()) return windows_time_zones(z);
+
+    z->ver = (char *)icu.ucal_getTZDataVersion(&err);
+    if (!U_FAILURE(err)) zones = icu.ucal_openTimeZoneIDEnumeration(UCAL_ZONE_TYPE_ANY, NULL, NULL, &err);
+    if (!U_FAILURE(err)) z->count = icu.uenum_count(zones, &err);
+    if (U_FAILURE(err)) goto icu_error;
+
+    if (!(z->names = calloc(z->count, sizeof(*z->names))) || !(z->links = calloc(z->count, sizeof(*z->links))))
+        goto nomem;
+
+    for (i = 0; i < z->count; i++)
+    {
+        struct canonical_id_params params;
+        UChar *canonical;
+        int32_t len;
+
+        params.id = icu.uenum_unext(zones, &params.len, &err);
+        if (U_FAILURE(err) || !params.id) goto icu_error;
+        if (!(z->names[i] = narrow_string(params.id, params.len))) goto win_error;
+        /* a link names the zone it stands for */
+        if (!(canonical = icu_string(get_canonical_id, &params, &len))) goto icu_error;
+        if (len != params.len || memcmp(canonical, params.id, len * sizeof(*canonical)))
+        {
+            z->links[i] = narrow_string(canonical, len);
+            if (!z->links[i])
+            {
+                free(canonical);
+                goto win_error;
+            }
+        }
+        free(canonical);
+    }
+    icu.uenum_close(zones);
+    return z;
+
+icu_error:
+    z->error = TZDB_ERROR_ICU;
+    if (zones) icu.uenum_close(zones);
+    return z;
+win_error:
+    z->error = TZDB_ERROR_WIN;
+    icu.uenum_close(zones);
+    return z;
+nomem:
+    icu.uenum_close(zones);
+    __std_tzdb_delete_time_zones(z);
+    return NULL;
+}
+
 void __stdcall __std_tzdb_delete_time_zones(struct tzdb_time_zones *z)
 {
     unsigned int i;
 
     TRACE("(%p)\n", z);
 
+    if (!z) return;
     for (i = 0; i < z->count; ++i)
     {
-        free(z->names[i]);
-        free(z->links[i]);
+        if (z->names) free(z->names[i]);
+        if (z->links) free(z->links[i]);
     }
     free(z->names);
     free(z->links);
@@ -272,10 +521,24 @@ struct tzdb_current_zone * __stdcall __std_tzdb_get_current_zone(void)
     DYNAMIC_TIME_ZONE_INFORMATION tzd;
     struct tzdb_current_zone *c;
     unsigned int i;
+    int32_t len;
+    UChar *id;
 
-    FIXME("returning Windows time zone name.\n");
+    TRACE("()\n");
 
-    c = calloc(1, sizeof(*c));
+    if (!(c = calloc(1, sizeof(*c)))) return NULL;
+
+    if (init_icu())
+    {
+        if (!(id = icu_string(get_default_zone, NULL, &len)))
+            c->error = TZDB_ERROR_ICU;
+        else if (!(c->name = narrow_string(id, len)))
+            c->error = TZDB_ERROR_WIN;
+        free(id);
+        return c;
