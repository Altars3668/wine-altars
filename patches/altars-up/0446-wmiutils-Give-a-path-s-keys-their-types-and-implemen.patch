+/* a singleton has no keys: making one drops them, unmaking one leaves the class */
 static HRESULT WINAPI keylist_MakeSingleton(
     IWbemPathKeyList *iface,
     boolean bSet )
 {
-    FIXME("%p, %d\n", iface, bSet);
