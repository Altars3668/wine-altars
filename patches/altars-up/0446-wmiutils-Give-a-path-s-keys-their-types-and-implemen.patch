From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 10:30:29 -0400
Subject: [PATCH] wmiutils: Give a path's keys their types, and implement its
 key list as Windows does.

Measured on Windows 11 build 29671 with tools/winmgmtsprobe (pathprobe.c):

- A key's value is a string, in double or single quotes with backslash
  escaping a quote or a backslash; a decimal number, a sint32 when it
  fits, a sint64 when negative and a uint64 when not; a hexadecimal one,
  a uint64; true or false; or a reference in braces.  Anything else, a
  space or an empty name is no path.  Quoted commas and backslashes are
  the value's: a namespace ends before a key does.
- The path's text writes the values back: numbers in decimal, booleans
  in lower case, strings in double quotes, escaped.  A path with no
  namespace has no colon in front of its class, and \\. only when it has
  a namespace; WBEMPATH_COMPRESSED is not a form.  A path that has a
  class or a namespace is to this machine, ".", without a server.
- GetKey and GetKey2 give a key's name, its bytes or its text (with
  WBEMPATH_TEXT or WBEMPATH_QUOTEDTEXT) and its type; GetKey2 reads what
  GetKey gives as the type, so a number's text reads as a number.
  SetKey and SetKey2 replace a key of that name in its place or add one
  last, SetKey2 reading a string given for a number as one; RemoveKey,
  MakeSingleton (Class=@ has no keys), GetInfo and GetText work.
- GetInfo has the singleton, compound, implied key and reference flags,
  and a path to a namespace alone is a WMI 1.0 one.

The tests have the measured paths; on Windows they have no failures.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wmiutils/path.c b/dlls/wmiutils/path.c
index 819edf47bab..b03163d440e 100644
--- a/dlls/wmiutils/path.c
+++ b/dlls/wmiutils/path.c
@@ -42,8 +42,9 @@ struct key
 {
     WCHAR *name;
     int    len_name;
-    WCHAR *value;
-    int    len_value;
+    ULONG  type;    /* the CIM type the value appears to have */
+    BYTE  *data;    /* a string unescaped, with its terminator; a number or a boolean as its bytes */
+    ULONG  size;
 };
 
 struct path
@@ -63,6 +64,7 @@ struct path
     int              len_class;
     struct key      *keys;
     unsigned int     num_keys;
+    BOOL             singleton;
     ULONGLONG        flags;
 };
 
@@ -139,6 +141,240 @@ static HRESULT WINAPI keylist_GetCount(
     return S_OK;
 }
 
+static void free_keys( struct key *keys, unsigned int count )
+{
+    unsigned int i;
+
+    for (i = 0; i < count; i++)
+    {
+        free( keys[i].name );
+        free( keys[i].data );
+    }
+    free( keys );
+}
+
+static BOOL is_string_type( ULONG type )
+{
+    return type == CIM_STRING || type == CIM_REFERENCE || type == CIM_DATETIME;
+}
+
+/* the bytes a key of the type holds; a string's with its terminator */
+static ULONG value_size( ULONG type, const void *value )
+{
+    switch (type)
+    {
+    case CIM_SINT8:
+    case CIM_UINT8:
+        return 1;
+    case CIM_SINT16:
+    case CIM_UINT16:
+    case CIM_CHAR16:
+        return 2;
+    case CIM_SINT32:
+    case CIM_UINT32:
+    case CIM_BOOLEAN:
+        return 4;
+    case CIM_SINT64:
+    case CIM_UINT64:
+        return 8;
+    case CIM_STRING:
+    case CIM_REFERENCE:
+    case CIM_DATETIME:
+        return (wcslen( value ) + 1) * sizeof(WCHAR);
+    default:
+        return 0;
+    }
+}
+
+/* a key's value as a path writes it: a number in decimal, a boolean as true or false, a string with its
+ * quotes and backslashes escaped and, when asked, in quotes; a reference in braces as it is */
+static WCHAR *value_text( const struct key *key, BOOL quote )
+{
+    const WCHAR *str = (const WCHAR *)key->data;
+    unsigned int len;
+    WCHAR *ret, *p;
+
+    if (!is_string_type( key->type ))
+    {
+        WCHAR buf[24];
+
+        switch (key->type)
+        {
+        case CIM_SINT8:   swprintf( buf, ARRAY_SIZE(buf), L"%d", *(const signed char *)key->data ); break;
+        case CIM_UINT8:   swprintf( buf, ARRAY_SIZE(buf), L"%u", *key->data ); break;
+        case CIM_SINT16:  swprintf( buf, ARRAY_SIZE(buf), L"%d", *(const SHORT *)key->data ); break;
+        case CIM_UINT16:
+        case CIM_CHAR16:  swprintf( buf, ARRAY_SIZE(buf), L"%u", *(const USHORT *)key->data ); break;
+        case CIM_SINT32:  swprintf( buf, ARRAY_SIZE(buf), L"%ld", *(const LONG *)key->data ); break;
+        case CIM_UINT32:  swprintf( buf, ARRAY_SIZE(buf), L"%lu", *(const ULONG *)key->data ); break;
+        case CIM_SINT64:  swprintf( buf, ARRAY_SIZE(buf), L"%I64d", *(const LONGLONG *)key->data ); break;
+        case CIM_UINT64:  swprintf( buf, ARRAY_SIZE(buf), L"%I64u", *(const ULONGLONG *)key->data ); break;
+        case CIM_BOOLEAN: wcscpy( buf, *(const VARIANT_BOOL *)key->data ? L"true" : L"false" ); break;
+        default: return NULL;
+        }
+        return wcsdup( buf );
+    }
+    if (key->type == CIM_REFERENCE && str[0] == '{') return wcsdup( str );
+
+    for (len = 0, p = (WCHAR *)str; *p; p++) len += (*p == '"' || *p == '\\') ? 2 : 1;
+    if (quote) len += 2;
+    if (!(ret = p = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    if (quote) *p++ = '"';
+    for (; *str; str++)
+    {
+        if (*str == '"' || *str == '\\') *p++ = '\\';
+        *p++ = *str;
+    }
+    if (quote) *p++ = '"';
+    *p = 0;
+    return ret;
+}
+
+/* what GetKey gives for a key: its bytes, or with WBEMPATH_TEXT or WBEMPATH_QUOTEDTEXT its text; padded with
+ * zeroes to the size of the largest number, which GetKey2 may read the text as */
+static BYTE *key_value( const struct key *key, ULONG flags, ULONG *size )
+{
+    WCHAR *text = NULL;
+    const BYTE *src;
+    BYTE *ret;
+
+    if (flags)
+    {
+        if (!(text = value_text( key, flags & WBEMPATH_QUOTEDTEXT ))) return NULL;
+        src = (const BYTE *)text;
+        *size = (wcslen( text ) + 1) * sizeof(WCHAR);
+    }
+    else
+    {
+        src = key->data;
+        *size = key->size;
+    }
+    if ((ret = calloc( 1, max( *size, sizeof(ULONGLONG) ) ))) memcpy( ret, src, *size );
+    free( text );
+    return ret;
+}
+
+/* GetKey2's value: what GetKey gives, read as the key's type (so the text of a number reads as a number) */
+static HRESULT variant_from_value( ULONG type, const BYTE *value, VARIANT *var )
+{
+    WCHAR buf[24];
+
+    switch (type)
+    {
+    case CIM_SINT8:
+        V_VT( var ) = VT_I2;
+        V_I2( var ) = *(const signed char *)value;
+        return S_OK;
+    case CIM_UINT8:
+        V_VT( var ) = VT_UI1;
+        V_UI1( var ) = *value;
+        return S_OK;
+    case CIM_SINT16:
+    case CIM_CHAR16:
+        V_VT( var ) = VT_I2;
+        V_I2( var ) = *(const SHORT *)value;
+        return S_OK;
+    case CIM_UINT16:
+        V_VT( var ) = VT_I4;
+        V_I4( var ) = *(const USHORT *)value;
+        return S_OK;
+    case CIM_SINT32:
+    case CIM_UINT32:
+        V_VT( var ) = VT_I4;
+        V_I4( var ) = *(const LONG *)value;
+        return S_OK;
+    case CIM_BOOLEAN:
+        V_VT( var ) = VT_BOOL;
+        V_BOOL( var ) = *(const VARIANT_BOOL *)value;
+        return S_OK;
+    case CIM_SINT64:
+        swprintf( buf, ARRAY_SIZE(buf), L"%I64d", *(const LONGLONG *)value );
+        value = (const BYTE *)buf;
+        break;
+    case CIM_UINT64:
+        swprintf( buf, ARRAY_SIZE(buf), L"%I64u", *(const ULONGLONG *)value );
+        value = (const BYTE *)buf;
+        break;
+    default:
+        break;
+    }
+    if (!(V_BSTR( var ) = SysAllocString( (const WCHAR *)value ))) return E_OUTOFMEMORY;
+    V_VT( var ) = VT_BSTR;
+    return S_OK;
+}
+
+static void copy_key_name( const struct key *key, ULONG *len, WCHAR *name )
+{
+    if (!len) return;
+    if (name && *len > key->len_name) lstrcpyW( name, key->name );
+    *len = key->len_name + 1;
+}
+
+static HRESULT get_key( IWbemPathKeyList *iface, ULONG index, ULONG flags, ULONG *name_len, WCHAR *name,
+                        ULONG *size, BYTE **value, ULONG *type )
+{
+    struct keylist *keylist = impl_from_IWbemPathKeyList( iface );
+    struct path *parent = impl_from_IWbemPath( keylist->parent );
+    HRESULT hr = S_OK;
+
+    if (flags & ~(WBEMPATH_TEXT | WBEMPATH_QUOTEDTEXT)) return WBEM_E_INVALID_PARAMETER;
+
+    EnterCriticalSection( &parent->cs );
+
+    if (index >= parent->num_keys) hr = WBEM_E_INVALID_PARAMETER;
+    else if (!(*value = key_value( &parent->keys[index], flags, size ))) hr = E_OUTOFMEMORY;
+    else
+    {
+        copy_key_name( &parent->keys[index], name_len, name );
+        *type = parent->keys[index].type;
+    }
+
+    LeaveCriticalSection( &parent->cs );
+    return hr;
+}
+
+/* a key of that name has its value replaced, in its place; a new one goes last */
+static HRESULT set_key( struct path *path, const WCHAR *name, ULONG type, const void *value )
+{
+    struct key *key = NULL, *keys;
+    unsigned int i;
+    WCHAR *dup;
+    ULONG size;
+    BYTE *data;
+
+    if (!(size = value_size( type, value ))) return WBEM_E_INVALID_PARAMETER;
+    if (!(data = malloc( size ))) return WBEM_E_OUT_OF_MEMORY;
+    memcpy( data, value, size );
+
+    for (i = 0; i < path->num_keys; i++)
+    {
+        if (!wcsicmp( path->keys[i].name, name ))
+        {
+            key = &path->keys[i];
+            free( key->data );
+            break;
+        }
+    }
+    if (!key)
+    {
+        if (!(dup = wcsdup( name )) || !(keys = realloc( path->keys, (path->num_keys + 1) * sizeof(*keys) )))
+        {
+            free( dup );
+            free( data );
+            return WBEM_E_OUT_OF_MEMORY;
+        }
+        path->keys = keys;
+        key = &path->keys[path->num_keys++];
+        key->name = dup;
+        key->len_name = lstrlenW( dup );
+    }
+    key->type = type;
+    key->data = data;
+    key->size = size;
+    path->singleton = FALSE;
+    return S_OK;
+}
+
 static HRESULT WINAPI keylist_SetKey(
     IWbemPathKeyList *iface,
     LPCWSTR wszName,
@@ -146,10 +382,22 @@ static HRESULT WINAPI keylist_SetKey(
     ULONG uCimType,
     LPVOID pKeyVal )
 {
-    FIXME("%p, %s, %#lx, %lu, %p\n", iface, debugstr_w(wszName), uFlags, uCimType, pKeyVal);
-    return E_NOTIMPL;
+    struct keylist *keylist = impl_from_IWbemPathKeyList( iface );
+    struct path *parent = impl_from_IWbemPath( keylist->parent );
+    HRESULT hr;
+
+    TRACE("%p, %s, %#lx, %lu, %p\n", iface, debugstr_w(wszName), uFlags, uCimType, pKeyVal);
+
+    if (!wszName || !pKeyVal) return WBEM_E_INVALID_PARAMETER;
+    if (uFlags) FIXME("flags %#lx not supported\n", uFlags);
+
+    EnterCriticalSection( &parent->cs );
+    hr = set_key( parent, wszName, uCimType, pKeyVal );
+    LeaveCriticalSection( &parent->cs );
+    return hr;
 }
 
+/* the variant's string, or its data read as the type: a string given for a number is read as one */
 static HRESULT WINAPI keylist_SetKey2(
     IWbemPathKeyList *iface,
     LPCWSTR wszName,
@@ -157,8 +405,25 @@ static HRESULT WINAPI keylist_SetKey2(
     ULONG uCimType,
     VARIANT *pKeyVal )
 {
-    FIXME("%p, %s, %#lx, %lu, %p\n", iface, debugstr_w(wszName), uFlags, uCimType, pKeyVal);
-    return E_NOTIMPL;
+    ULONGLONG buf = 0;
+    void *value;
+
+    TRACE("%p, %s, %#lx, %lu, %p\n", iface, debugstr_w(wszName), uFlags, uCimType, pKeyVal);
+
+    if (!pKeyVal) return WBEM_E_INVALID_PARAMETER;
+    if (V_VT( pKeyVal ) == VT_BSTR)
+    {
+        if (!V_BSTR( pKeyVal )) return WBEM_E_INVALID_PARAMETER;
+        if (is_string_type( uCimType )) value = V_BSTR( pKeyVal );
+        else
+        {
+            memcpy( &buf, V_BSTR( pKeyVal ), min( sizeof(buf), SysStringByteLen( V_BSTR( pKeyVal ) ) + sizeof(WCHAR) ) );
+            value = &buf;
+        }
+    }
+    else if (is_string_type( uCimType )) return WBEM_E_INVALID_PARAMETER;
+    else value = &V_I4( pKeyVal );
+    return keylist_SetKey( iface, wszName, uFlags, uCimType, value );
 }
 
 static HRESULT WINAPI keylist_GetKey(
@@ -171,9 +436,23 @@ static HRESULT WINAPI keylist_GetKey(
     LPVOID pKeyVal,
     ULONG *puApparentCimType )
 {
-    FIXME("%p, %lu, %#lx, %p, %p, %p, %p, %p\n", iface, uKeyIx, uFlags, puNameBufSize,
+    ULONG size, type;
+    BYTE *value;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %#lx, %p, %p, %p, %p, %p\n", iface, uKeyIx, uFlags, puNameBufSize,
           pszKeyName, puKeyValBufSize, pKeyVal, puApparentCimType);
-    return E_NOTIMPL;
+
+    if ((hr = get_key( iface, uKeyIx, uFlags, puNameBufSize, pszKeyName, &size, &value, &type )) != S_OK)
+        return hr;
+    if (puKeyValBufSize)
+    {
+        if (pKeyVal && *puKeyValBufSize >= size) memcpy( pKeyVal, value, size );
+        *puKeyValBufSize = size;
+    }
+    if (puApparentCimType) *puApparentCimType = type;
+    free( value );
+    return S_OK;
 }
 
 static HRESULT WINAPI keylist_GetKey2(
@@ -185,9 +464,20 @@ static HRESULT WINAPI keylist_GetKey2(
     VARIANT *pKeyValue,
     ULONG *puApparentCimType )
 {
-    FIXME("%p, %lu, %#lx, %p, %p, %p, %p\n", iface, uKeyIx, uFlags, puNameBufSize,
+    ULONG size, type;
+    BYTE *value;
+    HRESULT hr;
+
+    TRACE("%p, %lu, %#lx, %p, %p, %p, %p\n", iface, uKeyIx, uFlags, puNameBufSize,
           pszKeyName, pKeyValue, puApparentCimType);
-    return E_NOTIMPL;
