+#define check_text(a, b, c) check_text_( __LINE__, a, b, c )
+static void check_text_( unsigned int line, IWbemPath *path, LONG flags, const WCHAR *expected )
+{
+    WCHAR buf[128];
+    ULONG len = ARRAY_SIZE(buf);
+    HRESULT hr;
+
+    buf[0] = 0;
+    hr = IWbemPath_GetText( path, flags, &len, buf );
+    ok_(__FILE__, line)( hr == S_OK, "got %#lx\n", hr );
+    ok_(__FILE__, line)( !lstrcmpW( buf, expected ), "flags %#lx: got %s\n", flags, wine_dbgstr_w(buf) );
+    ok_(__FILE__, line)( len == lstrlenW( expected ) + 1, "flags %#lx: got length %lu\n", flags, len );
+}
+
+#define check_keylist_text(a, b, c) check_keylist_text_( __LINE__, a, b, c )
+static void check_keylist_text_( unsigned int line, IWbemPathKeyList *keys, LONG flags, const WCHAR *expected )
+{
+    WCHAR buf[128];
+    ULONG len = ARRAY_SIZE(buf);
+    HRESULT hr;
+
+    buf[0] = 0;
+    hr = IWbemPathKeyList_GetText( keys, flags, &len, buf );
+    ok_(__FILE__, line)( hr == S_OK, "got %#lx\n", hr );
+    ok_(__FILE__, line)( !lstrcmpW( buf, expected ), "flags %#lx: got %s\n", flags, wine_dbgstr_w(buf) );
+    ok_(__FILE__, line)( len == lstrlenW( expected ) + 1, "flags %#lx: got length %lu\n", flags, len );
+}
