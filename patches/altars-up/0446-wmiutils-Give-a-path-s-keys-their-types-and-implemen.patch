+static void test_IWbemPathKeyList_SetKey(void)
+{
+    IWbemPathKeyList *keys;
+    ULONGLONG info;
+    ULONG count;
+    LONG value = 5;
+    IWbemPath *path;
+    VARIANT var;
+    HRESULT hr;
+
+    if (!(path = create_path())) return;
+
+    hr = IWbemPath_SetText( path, WBEMPATH_CREATE_ACCEPT_ALL, L"Class" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IWbemPath_GetKeyList( path, &keys );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    V_VT( &var ) = VT_I4;
+    V_I4( &var ) = 5;
+    hr = IWbemPathKeyList_SetKey2( keys, L"A", 0, CIM_SINT32, &var );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_text( path, 0, L"Class.A=5" );
+    check_text( path, WBEMPATH_GET_ORIGINAL, L"Class" );
+    info = 0;
+    hr = IWbemPath_GetInfo( path, 0, &info );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( info == 0xc19, "got %s\n", wine_dbgstr_longlong(info) );
+
+    V_VT( &var ) = VT_BSTR;
+    V_BSTR( &var ) = SysAllocString( L"x,y \"q\" \\" );
+    hr = IWbemPathKeyList_SetKey2( keys, L"B", 0, CIM_STRING, &var );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    VariantClear( &var );
+    /* a string given as a number is read as one */
+    V_VT( &var ) = VT_BSTR;
+    V_BSTR( &var ) = SysAllocString( L"7" );
+    hr = IWbemPathKeyList_SetKey2( keys, L"C", 0, CIM_UINT32, &var );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    VariantClear( &var );
+    V_VT( &var ) = VT_BOOL;
+    V_BOOL( &var ) = VARIANT_TRUE;
+    hr = IWbemPathKeyList_SetKey2( keys, L"D", 0, CIM_BOOLEAN, &var );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IWbemPathKeyList_SetKey( keys, L"E", 0, CIM_SINT32, &value );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IWbemPathKeyList_SetKey( keys, L"F", 0, CIM_STRING, (void *)L"text" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    V_VT( &var ) = VT_I4;
+    V_I4( &var ) = 9;
+    hr = IWbemPathKeyList_SetKey2( keys, L"A", 0, CIM_SINT32, &var );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_text( path, 0, L"Class.A=9,B=\"x,y \\\"q\\\" \\\\\",C=55,D=true,E=5,F=\"text\"" );
+    check_keylist_text( keys, 0, L"A=9,B=x,y \\\"q\\\" \\\\,C=55,D=true,E=5,F=text" );
+    count = 0;
+    hr = IWbemPathKeyList_GetCount( keys, &count );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( count == 6, "got %lu\n", count );
+
+    hr = IWbemPathKeyList_RemoveKey( keys, L"B", 0 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IWbemPathKeyList_RemoveKey( keys, L"nonesuch", 0 );
+    ok( hr == WBEM_E_INVALID_PARAMETER, "got %#lx\n", hr );
+    check_text( path, 0, L"Class.A=9,C=55,D=true,E=5,F=\"text\"" );
+
+    hr = IWbemPathKeyList_MakeSingleton( keys, TRUE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_text( path, 0, L"Class=@" );
+    count = 0xdeadbeef;
+    hr = IWbemPathKeyList_GetCount( keys, &count );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !count, "got %lu\n", count );
+    info = 0;
+    hr = IWbemPath_GetInfo( path, 0, &info );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( info == 0x1d19, "got %s\n", wine_dbgstr_longlong(info) );
+
+    hr = IWbemPathKeyList_MakeSingleton( keys, FALSE );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_text( path, 0, L"Class" );
+    info = 0;
+    hr = IWbemPath_GetInfo( path, 0, &info );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( info == 0xc15, "got %s\n", wine_dbgstr_longlong(info) );
+
+    V_VT( &var ) = VT_BSTR;
+    V_BSTR( &var ) = SysAllocString( L"C:" );
+    hr = IWbemPathKeyList_SetKey2( keys, L"", 0, CIM_STRING, &var );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    VariantClear( &var );
+    check_text( path, 0, L"Class=\"C:\"" );
+    info = 0;
+    hr = IWbemPath_GetInfo( path, 0, &info );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( info == 0xc99, "got %s\n", wine_dbgstr_longlong(info) );
+
+    hr = IWbemPathKeyList_RemoveAllKeys( keys, 0 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    check_text( path, 0, L"Class" );
+
+    IWbemPathKeyList_Release( keys );
+    IWbemPath_Release( path );
+}
