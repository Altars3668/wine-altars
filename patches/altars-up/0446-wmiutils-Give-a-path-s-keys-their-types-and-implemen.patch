+static ULONGLONG keys_info( const struct path *path )
+{
+    ULONGLONG info = 0;
+    unsigned int i;
+
+    if (path->singleton) info |= WBEMPATH_INFO_CONTAINS_SINGLETON;
+    if (path->num_keys > 1) info |= WBEMPATH_INFO_IS_COMPOUND;
+    for (i = 0; i < path->num_keys; i++)
+    {
+        if (!path->keys[i].len_name) info |= WBEMPATH_INFO_HAS_IMPLIED_KEY;
+        if (path->keys[i].type == CIM_REFERENCE && *(const WCHAR *)path->keys[i].data == '{')
+            info |= WBEMPATH_INFO_HAS_V2_REF_PATHS;
+    }
+    return info;
 }
 
