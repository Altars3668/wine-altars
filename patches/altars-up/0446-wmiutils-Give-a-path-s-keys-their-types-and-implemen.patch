+/* name=value, the values quoted or not, "@" for a singleton, a value alone for a key with no name */
+static WCHAR *build_keylist( const struct path *path, BOOL quote, int *len )
+{
+    WCHAR **values, *ret = NULL, *p;
+    unsigned int i;
+
+    *len = 0;
+    if (path->singleton)
+    {
+        *len = 1;
+        return wcsdup( L"@" );
+    }
+    if (!path->num_keys) return wcsdup( L"" );
+    if (!(values = calloc( path->num_keys, sizeof(*values) ))) return NULL;
+    for (i = 0; i < path->num_keys; i++)
+    {
+        if (!(values[i] = value_text( &path->keys[i], quote ))) goto done;
+        if (i) *len += 1;
+        if (path->keys[i].len_name) *len += path->keys[i].len_name + 1;
+        *len += lstrlenW( values[i] );
+    }
+    if (!(ret = p = malloc( (*len + 1) * sizeof(WCHAR) ))) goto done;
+    for (i = 0; i < path->num_keys; i++)
+    {
+        if (i) *p++ = ',';
+        if (path->keys[i].len_name)
+        {
+            memcpy( p, path->keys[i].name, path->keys[i].len_name * sizeof(WCHAR) );
+            p += path->keys[i].len_name;
+            *p++ = '=';
+        }
+        lstrcpyW( p, values[i] );
+        p += lstrlenW( values[i] );
+    }
+    *p = 0;
+
+done:
+    for (i = 0; i < path->num_keys; i++) free( values[i] );
+    free( values );
+    return ret;
 }
 
