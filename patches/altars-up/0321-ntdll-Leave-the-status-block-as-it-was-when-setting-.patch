diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 4f165a5e94d..85074fcd52f 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5364,7 +5364,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             char *unix_name;
 
             if ((status = server_get_unix_fd( handle, FILE_WRITE_ATTRIBUTES, &fd, &needs_close, NULL, NULL )))
-                return io->Status = status;
+                return status;
 
             if (server_get_unix_name( handle, &unix_name )) unix_name = NULL;
 
@@ -5391,7 +5391,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             const FILE_POSITION_INFORMATION *info = ptr;
 
             if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, NULL )))
-                return io->Status = status;
+                return status;
 
             if (lseek( fd, info->CurrentByteOffset.QuadPart, SEEK_SET ) == (off_t)-1)
                 status = errno_to_status( errno );
@@ -5514,7 +5514,7 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             const FILE_VALID_DATA_LENGTH_INFORMATION *info = ptr;
 
             if ((status = server_get_unix_fd( handle, FILE_WRITE_DATA, &fd, &needs_close, NULL, NULL )))
-                return io->Status = status;
+                return status;
 
             if (fstat( fd, &st ) == -1) status = errno_to_status( errno );
             else if (info->ValidDataLength.QuadPart <= 0 || (off_t)info->ValidDataLength.QuadPart > st.st_size)
@@ -5667,8 +5667,13 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         status = STATUS_NOT_IMPLEMENTED;
         break;
     }
-    io->Information = 0;
-    return io->Status = status;
+    /* a request that fails leaves the status block as it was */
+    if (!NT_ERROR( status ))
+    {
+        io->Status = status;
+        io->Information = 0;
+    }
+    return status;
 }
 
 
