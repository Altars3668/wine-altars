From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 00:16:16 -0400
Subject: [PATCH] dxgi: Copy a composition swapchain's buffer with a context
 state of its own.

Presenting to a composition swapchain copies the back buffer into the
texture the compositor reads, through the immediate context of the
application's device; with a state emulating ID3D10Device active it is
dropped, and the compositor shows what was there before.  The swapchain
now keeps a state of its own for the copy.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/dxgi/dxgi_private.h b/dlls/dxgi/dxgi_private.h
index 61d15c1ebac..db4ee3289ca 100644
--- a/dlls/dxgi/dxgi_private.h
+++ b/dlls/dxgi/dxgi_private.h
@@ -33,6 +33,7 @@
 #include "dxgi1_6.h"
 #include "d3d10_1.h"
 #include "d3d12.h"
+#include "d3d11_1.h"
 #ifdef DXGI_INIT_GUID
 #include "initguid.h"
 #endif
@@ -196,6 +197,7 @@ struct d3d11_swapchain
     CRITICAL_SECTION composition_cs;
     IDXGISurface *presented;
     UINT presented_version;
+    ID3DDeviceContextState *copy_state;     /* what the copy into it is made with */
     struct composition_listener *listeners;
     unsigned int listener_count;
     LARGE_INTEGER last_present;
diff --git a/dlls/dxgi/swapchain.c b/dlls/dxgi/swapchain.c
index 38ed5852c36..c8e8c37cfee 100644
--- a/dlls/dxgi/swapchain.c
+++ b/dlls/dxgi/swapchain.c
@@ -1301,6 +1301,8 @@ static void STDMETHODCALLTYPE d3d11_swapchain_wined3d_object_released(void *pare
         swapchain->composition_cs.DebugInfo->Spare[0] = 0;
         DeleteCriticalSection(&swapchain->composition_cs);
         free(swapchain->listeners);
+        if (swapchain->copy_state)
+            ID3DDeviceContextState_Release(swapchain->copy_state);
     }
     wined3d_private_store_cleanup(&swapchain->private_store);
     free(parent);
@@ -3929,7 +3931,9 @@ static HRESULT d3d11_swapchain_present_composition(struct d3d11_swapchain *swapc
     D3D11_TEXTURE2D_DESC desc, presented_desc;
     struct wined3d_texture *back_buffer;
     LARGE_INTEGER now, frequency;
-    ID3D11DeviceContext *context;
+    ID3DDeviceContextState *prev = NULL;
+    ID3D11DeviceContext1 *context;
+    ID3D11Device1 *device1;
     ID3D11Device *device;
     unsigned int i;
     HRESULT hr;
@@ -3978,9 +3982,29 @@ static HRESULT d3d11_swapchain_present_composition(struct d3d11_swapchain *swapc
         ID3D11Texture2D_QueryInterface(texture, &IID_IDXGISurface, (void **)&presented);
     }
 
-    ID3D11Device_GetImmediateContext(device, &context);
-    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)texture, (ID3D11Resource *)source);
-    ID3D11DeviceContext_Release(context);
+    /* With a state of our own: the application's may emulate ID3D10Device, which drops the copy. */
+    if (SUCCEEDED(ID3D11Device_QueryInterface(device, &IID_ID3D11Device1, (void **)&device1)))
+    {
+        if (!swapchain->copy_state)
+        {
+            D3D_FEATURE_LEVEL level = ID3D11Device1_GetFeatureLevel(device1);
+
+            if (FAILED(ID3D11Device1_CreateDeviceContextState(device1, 0, &level, 1, D3D11_SDK_VERSION,
+                    &IID_ID3D11Device1, NULL, &swapchain->copy_state)))
+                swapchain->copy_state = NULL;
+        }
+        ID3D11Device1_GetImmediateContext1(device1, &context);
+        if (swapchain->copy_state)
+            ID3D11DeviceContext1_SwapDeviceContextState(context, swapchain->copy_state, &prev);
+        ID3D11DeviceContext1_CopyResource(context, (ID3D11Resource *)texture, (ID3D11Resource *)source);
+        if (prev)
+        {
+            ID3D11DeviceContext1_SwapDeviceContextState(context, prev, NULL);
+            ID3DDeviceContextState_Release(prev);
+        }
+        ID3D11DeviceContext1_Release(context);
+        ID3D11Device1_Release(device1);
+    }
     ID3D11Texture2D_Release(texture);
 
     EnterCriticalSection(&swapchain->composition_cs);
