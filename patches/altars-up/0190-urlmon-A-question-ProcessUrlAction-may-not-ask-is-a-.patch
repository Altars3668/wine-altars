From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 23:30:14 -0400
Subject: [PATCH] urlmon: A question ProcessUrlAction may not ask is a refusal.

Where the zone's policy for an action is to ask, ProcessUrlAction failed with E_FAIL.
Windows (build 29671) answers S_FALSE when PUAF_NOUI forbids asking, and writes the
policy back.  Nothing here asks either way, so without the flag it refuses too.
PUAF_NOUI, PUAF_ISFILE and PUAF_WARN_IF_DENIED, the last a warning Windows puts up
even with PUAF_NOUI, need nothing more: the Click-to-Run service's checks of its
manifests with PUAF_NOUI printed a FIXME each, 45 in a PowerPoint session.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 50b5b8ba7446219d82b04ad124739381d3db2870)

diff --git a/dlls/urlmon/sec_mgr.c b/dlls/urlmon/sec_mgr.c
index 21f1b9e3d66..48b7784d388 100644
--- a/dlls/urlmon/sec_mgr.c
+++ b/dlls/urlmon/sec_mgr.c
@@ -999,8 +999,9 @@ static HRESULT WINAPI SecManagerImpl_ProcessUrlAction(IInternetSecurityManagerEx
             return hres;
     }
 
-    if(dwFlags || dwReserved)
-        FIXME("Unsupported arguments\n");
+    /* Nothing here puts up a prompt or a warning, so asking not to changes nothing. */
+    if((dwFlags & ~(PUAF_NOUI | PUAF_ISFILE | PUAF_WARN_IF_DENIED)) || dwReserved)
+        FIXME("Unsupported arguments %08lx %08lx\n", dwFlags, dwReserved);
 
     if(!pwszUrl)
         return E_INVALIDARG;
@@ -1024,8 +1025,10 @@ static HRESULT WINAPI SecManagerImpl_ProcessUrlAction(IInternetSecurityManagerEx
     case URLPOLICY_DISALLOW:
         return S_FALSE;
     case URLPOLICY_QUERY:
-        FIXME("URLPOLICY_QUERY not implemented\n");
-        return E_FAIL;
+        /* A question that may not be put is a refusal; one that may is not put either. */
+        if(!(dwFlags & PUAF_NOUI))
+            FIXME("Not asking about action %08lx\n", dwAction);
+        return S_FALSE;
     default:
         FIXME("Not implemented policy %lx\n", policy);
     }
diff --git a/dlls/urlmon/tests/sec_mgr.c b/dlls/urlmon/tests/sec_mgr.c
index 6f9bf3289fa..849c847a3f4 100644
--- a/dlls/urlmon/tests/sec_mgr.c
+++ b/dlls/urlmon/tests/sec_mgr.c
@@ -520,7 +520,14 @@ static void test_url_action(IInternetSecurityManager *secmgr, IInternetZoneManag
     ok(hres == S_OK, "GetZoneActionPolicy failed: %08lx\n", hres);
     ok(policy == reg_policy, "(%lx) policy=%lx, expected %lx\n", action, policy, reg_policy);
 
-    if(policy != URLPOLICY_QUERY) {
+    if(policy == URLPOLICY_QUERY) {
+        /* When it may not ask, a question is a refusal. */
+        policy = 0xdeadbeef;
+        hres = IInternetSecurityManager_ProcessUrlAction(secmgr, url9, action, (BYTE*)&policy,
+                sizeof(DWORD), NULL, 0, PUAF_NOUI, 0);
+        ok(hres == S_FALSE, "ProcessUrlAction(%lx) failed: %08lx, expected S_FALSE\n", action, hres);
+        ok(policy == URLPOLICY_QUERY, "(%lx) policy=%lx\n", action, policy);
+    }else {
         if(winetest_interactive || ! is_ie_hardened()) {
             BOOL expect_parse_call = !called_securl_http;
 
@@ -639,6 +646,7 @@ static void test_polices(void)
     test_url_action(secmgr, zonemgr, URLACTION_ACTIVEX_RUN);
     test_url_action(secmgr, zonemgr, URLACTION_ACTIVEX_OVERRIDE_OBJECT_SAFETY);
     test_url_action(secmgr, zonemgr, URLACTION_CHANNEL_SOFTDIST_PERMISSIONS);
+    test_url_action(secmgr, zonemgr, URLACTION_DOWNLOAD_SIGNED_ACTIVEX);
     test_url_action(secmgr, zonemgr, 0xdeadbeef);
 
     test_special_url_action(secmgr, zonemgr, URLACTION_SCRIPT_OVERRIDE_SAFETY);
