 WINE_DEFAULT_DEBUG_CHANNEL(eventlog);
@@ -30,6 +32,56 @@ WINE_DEFAULT_DEBUG_CHANNEL(eventlog);
 static SERVICE_STATUS_HANDLE svc_handle;
 static HANDLE done_event;
 
+#ifndef EVENT_EventlogStopped
+#define EVENT_EventlogStopped 0x80001776
+#endif
+#ifndef EVENT_EventLogProductInfo
+#define EVENT_EventLogProductInfo 0x80001779
+#endif
+
+/* What the service writes to the System log when it starts, as Windows 11 does: the version (6009), then that it
+ * started (6005) with the time it did; and when it stops, that it did (6006). */
+static void report_started(void)
+{
+    WCHAR version[16], build[16], *csd, *processors;
+    const WCHAR *strings[5];
+    RTL_OSVERSIONINFOEXW info = { sizeof(info) };
+    SYSTEM_INFO system;
+    BYTE data[24] = { 0 };
+    HANDLE source;
+
+    if (!(source = RegisterEventSourceW( NULL, L"EventLog" )))
+    {
+        ERR("RegisterEventSource error %lu\n", GetLastError());
+        return;
+    }
+    RtlGetVersion( &info );
+    GetSystemInfo( &system );
+    swprintf( version, ARRAY_SIZE(version), L"%lu.%02lu.", info.dwMajorVersion, info.dwMinorVersion );
+    swprintf( build, ARRAY_SIZE(build), L"%lu", info.dwBuildNumber );
+    csd = info.szCSDVersion;
+    processors = system.dwNumberOfProcessors > 1 ? (WCHAR *)L"Multiprocessor Free" : (WCHAR *)L"Uniprocessor Free";
+    strings[0] = version;
+    strings[1] = build;
+    strings[2] = csd;
+    strings[3] = processors;
+    strings[4] = L"0";
+    ReportEventW( source, EVENTLOG_INFORMATION_TYPE, 0, EVENT_EventLogProductInfo, NULL, 5, 0, strings, NULL );
+    GetSystemTime( (SYSTEMTIME *)data );
+    ReportEventW( source, EVENTLOG_INFORMATION_TYPE, 0, EVENT_EventlogStarted, NULL, 0, sizeof(data), NULL, data );
+    DeregisterEventSource( source );
+}
+
+static void report_stopped(void)
+{
+    DWORD data[2] = { 1, 0 };
+    HANDLE source;
+
+    if (!(source = RegisterEventSourceW( NULL, L"EventLog" ))) return;
+    ReportEventW( source, EVENTLOG_INFORMATION_TYPE, 0, EVENT_EventlogStopped, NULL, 0, sizeof(data), NULL, data );
+    DeregisterEventSource( source );
+}
+
 static void eventlog_update_status(DWORD state)
 {
     SERVICE_STATUS status;
