-static BOOL is_local_server( const WCHAR *server )
-{
-    static const COMPUTER_NAME_FORMAT formats[] =
-    {
-        ComputerNameNetBIOS, ComputerNameDnsHostname, ComputerNameDnsFullyQualified
-    };
-    WCHAR name[MAX_COMPUTERNAME_LENGTH * 8 + 1];
-    DWORD size;
-    unsigned int i;
-
-    if (!server || !server[0]) return TRUE;
-    if (server[0] == '\\' && server[1] == '\\') server += 2;
-    if (!wcsicmp( server, L"localhost" ) || !wcscmp( server, L"." ) || !wcscmp( server, L"127.0.0.1" ) ||
