+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * Each log is a file in the classic format -- ELF_LOGFILE_HEADER, the records, ELF_EOF_RECORD -- named after it in
+ * %SystemRoot%\system32\winevt\Logs, and shared by every process: a named mutex serializes all access to it, and
+ * a named event is pulsed when a record is written, for NotifyChangeEventLog.  The file never wraps; one that
+ * would grow past the log's MaxSize drops its oldest records instead.  A record has the layout Windows 11 gives
+ * ReadEventLogW: the source and computer names after the fixed part, the user SID at the next 8-byte boundary,
+ * the strings and the data right after it, and the whole padded to 8 bytes with its length in the last four.
+ * Record numbers go on from where they were when a log is cleared, as on Windows.  A source is in the log whose
+ * registry key under Services\EventLog names it, or is the log; others are in the Application log.
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winerror.h"
+#include "winreg.h"
+#include "winternl.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+#include "advapi32_misc.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(eventlog);
+
+typedef struct
+{
+    ULONG HeaderSize;
+    ULONG Signature;
+    ULONG MajorVersion;
+    ULONG MinorVersion;
+    ULONG StartOffset;
+    ULONG EndOffset;
+    ULONG CurrentRecordNumber;
+    ULONG OldestRecordNumber;
+    ULONG MaxSize;
+    ULONG Flags;
+    ULONG Retention;
+    ULONG EndHeaderSize;
+} ELF_LOGFILE_HEADER;
+
+typedef struct
+{
+    ULONG RecordSizeBeginning;
+    ULONG One;
+    ULONG Two;
+    ULONG Three;
+    ULONG Four;
+    ULONG BeginRecord;
+    ULONG EndRecord;
+    ULONG CurrentRecordNumber;
+    ULONG OldestRecordNumber;
+    ULONG RecordSizeEnd;
+} ELF_EOF_RECORD;
+
+#define LOG_SIGNATURE     0x654c664c /* LfLe */
+#define LOG_DEFAULT_SIZE  20971520
+#define LOG_MIN_SIZE      0x10000
+
+static const WCHAR eventlog_key[] = L"SYSTEM\\CurrentControlSet\\Services\\EventLog";
+
+/* A handle to an event log, by OpenEventLog(), OpenBackupEventLog() or RegisterEventSource(): the one kind, which
+ * the functions take alike; a handle closed is not one any more. */
+struct eventlog
+{
+    struct list entry;
+    CRITICAL_SECTION cs;
+    WCHAR *log;             /* the log, as the registry names it */
+    WCHAR *source;          /* what ReportEvent writes as the source */
+    BOOL backup;            /* a backup file, read only */
+    HANDLE file;
+    HANDLE mutex;           /* the log's, held around every access to its file; none for a backup */
+    HANDLE changed;         /* the log's, pulsed by every write */
+    DWORD max_size;
+    DWORD cursor;           /* the record a forward sequential read starts at, 0 before any read */
+    /* where the records are, oldest first: kept up as the log grows, rebuilt once it was cleared or cut */
+    DWORD oldest;
+    DWORD next;
+    DWORD end;
+    DWORD *offsets;
+    DWORD offsets_size;
+    HANDLE notify_thread;
+    HANDLE notify_stop;
+    HANDLE notify_event;
+};
+
+static struct list eventlogs = LIST_INIT( eventlogs );
+static CRITICAL_SECTION eventlog_cs;
+static CRITICAL_SECTION_DEBUG eventlog_cs_debug =
+{
+    0, 0, &eventlog_cs,
+    { &eventlog_cs_debug.ProcessLocksList, &eventlog_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": eventlog_cs") }
+};
+static CRITICAL_SECTION eventlog_cs = { &eventlog_cs_debug, -1, 0, 0, 0, 0 };
+
+static inline DWORD align8( DWORD size )
+{
+    return (size + 7) & ~7;
+}
+
+/* Whether a server is this computer: none, its names, its DNS names, or the loopback ones.  Another the event log
+ * service is not reached on. */
+static BOOL is_local_server( const WCHAR *server )
+{
+    static const COMPUTER_NAME_FORMAT formats[] =
+    {
+        ComputerNameNetBIOS, ComputerNameDnsHostname, ComputerNameDnsFullyQualified
+    };
+    WCHAR name[MAX_COMPUTERNAME_LENGTH * 8 + 1];
+    DWORD size;
+    unsigned int i;
+
+    if (!server || !server[0]) return TRUE;
+    if (server[0] == '\\' && server[1] == '\\') server += 2;
+    if (!wcsicmp( server, L"localhost" ) || !wcscmp( server, L"." ) || !wcscmp( server, L"127.0.0.1" ) ||
+        !wcscmp( server, L"::1" ))
+        return TRUE;
+    for (i = 0; i < ARRAY_SIZE(formats); i++)
+    {
+        size = ARRAY_SIZE(name);
+        if (GetComputerNameExW( formats[i], name, &size ) && !wcsicmp( server, name )) return TRUE;
+    }
+    return FALSE;
+}
+
+static BOOL read_at( HANDLE file, DWORD offset, void *buffer, DWORD size )
+{
+    OVERLAPPED ovl = {0};
+    DWORD done;
+
+    ovl.Offset = offset;
+    return ReadFile( file, buffer, size, &done, &ovl ) && done == size;
+}
+
+static BOOL write_at( HANDLE file, DWORD offset, const void *buffer, DWORD size )
+{
+    OVERLAPPED ovl = {0};
+    DWORD done;
+
+    ovl.Offset = offset;
+    return WriteFile( file, buffer, size, &done, &ovl ) && done == size;
+}
+
+static void init_header( ELF_LOGFILE_HEADER *header, DWORD max_size )
+{
+    memset( header, 0, sizeof(*header) );
+    header->HeaderSize = header->EndHeaderSize = sizeof(*header);
+    header->Signature = LOG_SIGNATURE;
+    header->MajorVersion = header->MinorVersion = 1;
+    header->StartOffset = header->EndOffset = sizeof(*header);
+    header->CurrentRecordNumber = header->OldestRecordNumber = 1;
+    header->MaxSize = max_size;
+}
+
+static BOOL valid_header( const ELF_LOGFILE_HEADER *header, DWORD file_size )
+{
+    return header->HeaderSize == sizeof(*header) && header->EndHeaderSize == sizeof(*header) &&
+           header->Signature == LOG_SIGNATURE && header->MajorVersion == 1 &&
+           header->StartOffset >= sizeof(*header) && header->StartOffset <= header->EndOffset &&
+           header->EndOffset <= file_size && header->OldestRecordNumber <= header->CurrentRecordNumber;
+}
+
+/* the end of a log file: an EOF record after the records, and the header saying where they are */
+static BOOL write_end( HANDLE file, const ELF_LOGFILE_HEADER *header )
+{
+    ELF_EOF_RECORD eof;
+
+    eof.RecordSizeBeginning = eof.RecordSizeEnd = sizeof(eof);
+    eof.One = 0x11111111;
+    eof.Two = 0x22222222;
+    eof.Three = 0x33333333;
+    eof.Four = 0x44444444;
+    eof.BeginRecord = header->StartOffset;
+    eof.EndRecord = header->EndOffset;
+    eof.CurrentRecordNumber = header->CurrentRecordNumber;
+    eof.OldestRecordNumber = header->OldestRecordNumber;
+    return write_at( file, header->EndOffset, &eof, sizeof(eof) ) && write_at( file, 0, header, sizeof(*header) );
+}
+
+static void lock_log( struct eventlog *log )
+{
+    if (log->mutex) WaitForSingleObject( log->mutex, INFINITE );
+}
+
+static void unlock_log( struct eventlog *log )
+{
+    if (log->mutex) ReleaseMutex( log->mutex );
+}
+
+/* the header of the log, with the index of its records brought up to date; the log is locked */
+static BOOL refresh_log( struct eventlog *log, ELF_LOGFILE_HEADER *header )
+{
+    LARGE_INTEGER size;
+    DWORD pos, length;
+
+    if (!GetFileSizeEx( log->file, &size ) || !read_at( log->file, 0, header, sizeof(*header) ) ||
+        !valid_header( header, size.u.LowPart ))
+    {
+        SetLastError( ERROR_EVENTLOG_FILE_CORRUPT );
+        return FALSE;
+    }
+    if (header->OldestRecordNumber != log->oldest || header->EndOffset < log->end || log->next < log->oldest)
+    {
+        log->oldest = log->next = header->OldestRecordNumber;
+        log->end = header->StartOffset;
+    }
+    for (pos = log->end; pos < header->EndOffset; pos += length)
+    {
+        if (!read_at( log->file, pos, &length, sizeof(length) ) || length < sizeof(EVENTLOGRECORD) ||
+            length > header->EndOffset - pos)
+        {
+            WARN( "corrupt record at %#lx in log %s\n", pos, debugstr_w(log->log) );
+            break;
+        }
+        if (log->next - log->oldest >= log->offsets_size)
+        {
+            DWORD new_size = max( 64, log->offsets_size * 2 ), *offsets;
+
+            if (!(offsets = realloc( log->offsets, new_size * sizeof(*offsets) )))
+            {
+                SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+                return FALSE;
+            }
+            log->offsets = offsets;
+            log->offsets_size = new_size;
+        }
+        log->offsets[log->next++ - log->oldest] = pos;
+        log->end = pos + length;
+    }
+    return TRUE;
+}
+
+/* the name of the log a source writes to: the log of that name, the log with the source in its key, or Application */
+static WCHAR *log_name( const WCHAR *source )
+{
+    WCHAR name[256];
+    HKEY key, log_key, source_key;
+    DWORD i, len;
+    WCHAR *ret = NULL;
+
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, eventlog_key, 0, KEY_READ, &key ))
+    {
+        for (i = 0; !ret && (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )); i++)
+            if (!wcsicmp( name, source )) ret = wcsdup( name );
+        for (i = 0; !ret && (len = ARRAY_SIZE(name), !RegEnumKeyExW( key, i, name, &len, NULL, NULL, NULL, NULL )); i++)
+        {
+            if (RegOpenKeyExW( key, name, 0, KEY_READ, &log_key )) continue;
+            if (!RegOpenKeyExW( log_key, source, 0, KEY_READ, &source_key ))
+            {
+                RegCloseKey( source_key );
+                ret = wcsdup( name );
+            }
+            RegCloseKey( log_key );
+        }
+        RegCloseKey( key );
+    }
+    return ret ? ret : wcsdup( L"Application" );
+}
+
+static DWORD log_max_size( const WCHAR *log )
+{
+    DWORD size = LOG_DEFAULT_SIZE, len = sizeof(size), type;
+    WCHAR path[ARRAY_SIZE(eventlog_key) + 260];
+    HKEY key;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\%s", eventlog_key, log );
+    if (!RegOpenKeyExW( HKEY_LOCAL_MACHINE, path, 0, KEY_READ, &key ))
+    {
+        if (RegQueryValueExW( key, L"MaxSize", NULL, &type, (BYTE *)&size, &len ) || type != REG_DWORD)
+            size = LOG_DEFAULT_SIZE;
+        RegCloseKey( key );
+    }
+    return max( size, LOG_MIN_SIZE );
+}
+
+/* a named object of the log, the same for every case of its name */
+static HANDLE log_object( const WCHAR *log, BOOL mutex )
+{
+    WCHAR name[300];
+    HANDLE ret;
+
+    swprintf( name, ARRAY_SIZE(name), L"__wine_eventlog_%s_%s", mutex ? L"lock" : L"changed", log );
+    wcsupr( name );
+    ret = mutex ? CreateMutexW( NULL, FALSE, name ) : CreateEventW( NULL, TRUE, FALSE, name );
+    return ret;
+}
+
+static void free_eventlog( struct eventlog *log )
+{
+    if (log->notify_thread)
+    {
+        SetEvent( log->notify_stop );
+        WaitForSingleObject( log->notify_thread, INFINITE );
+        CloseHandle( log->notify_thread );
+        CloseHandle( log->notify_stop );
+        CloseHandle( log->notify_event );
+    }
+    if (log->file && log->file != INVALID_HANDLE_VALUE) CloseHandle( log->file );
+    if (log->mutex) CloseHandle( log->mutex );
+    if (log->changed) CloseHandle( log->changed );
+    free( log->offsets );
+    free( log->log );
+    free( log->source );
+    log->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &log->cs );
+    free( log );
+}
+
+static HANDLE add_eventlog( struct eventlog *log )
+{
+    EnterCriticalSection( &eventlog_cs );
+    list_add_tail( &eventlogs, &log->entry );
+    LeaveCriticalSection( &eventlog_cs );
+    return log;
+}
+
+static struct eventlog *alloc_eventlog(void)
+{
+    struct eventlog *log;
+
+    if (!(log = calloc( 1, sizeof(*log) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    InitializeCriticalSectionEx( &log->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    log->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": eventlog.cs");
+    return log;
+}
+
+/* opens the log a source writes to, its file created if it is not there */
+static HANDLE open_log( const WCHAR *source )
+{
+    WCHAR path[MAX_PATH + 300];
+    ELF_LOGFILE_HEADER header;
+    struct eventlog *log;
+    LARGE_INTEGER size;
+    DWORD len;
+
+    if (!(log = alloc_eventlog())) return NULL;
+    if (!(log->log = log_name( source )) || !(log->source = wcsdup( source ))) goto oom;
+    log->max_size = log_max_size( log->log );
+    if (!(log->mutex = log_object( log->log, TRUE )) || !(log->changed = log_object( log->log, FALSE )))
+        goto error;
+
+    len = GetSystemDirectoryW( path, MAX_PATH );
+    wcscpy( path + len, L"\\winevt" );
+    CreateDirectoryW( path, NULL );
+    wcscat( path, L"\\Logs" );
+    CreateDirectoryW( path, NULL );
+    wcscat( path, L"\\" );
+    wcscat( path, log->log );
+    wcscat( path, L".evt" );
+    log->file = CreateFileW( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                             NULL, OPEN_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (log->file == INVALID_HANDLE_VALUE) goto error;
+
+    lock_log( log );
+    if (GetFileSizeEx( log->file, &size ) && size.QuadPart < sizeof(header) + sizeof(ELF_EOF_RECORD))
+    {
+        TRACE( "creating %s\n", debugstr_w(path) );
+        init_header( &header, log->max_size );
+        write_end( log->file, &header );
+    }
+    unlock_log( log );
+    TRACE( "source %s writes to log %s\n", debugstr_w(source), debugstr_w(log->log) );
+    return add_eventlog( log );
+
+oom:
+    SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+error:
+    len = GetLastError();
+    free_eventlog( log );
+    SetLastError( len );
+    return NULL;
+}
+
+/* the handle's log, locked against other threads of the process using the same handle */
+static struct eventlog *grab_eventlog( HANDLE handle )
+{
+    struct eventlog *log;
+
+    EnterCriticalSection( &eventlog_cs );
+    LIST_FOR_EACH_ENTRY( log, &eventlogs, struct eventlog, entry )
+    {
+        if (log != handle) continue;
+        EnterCriticalSection( &log->cs );
+        LeaveCriticalSection( &eventlog_cs );
+        return log;
+    }
+    LeaveCriticalSection( &eventlog_cs );
+    SetLastError( ERROR_INVALID_HANDLE );
+    return NULL;
+}
+
+static void release_eventlog( struct eventlog *log )
+{
+    LeaveCriticalSection( &log->cs );
+}
+
+static BOOL close_eventlog( HANDLE handle )
+{
+    struct eventlog *log;
+
+    EnterCriticalSection( &eventlog_cs );
+    LIST_FOR_EACH_ENTRY( log, &eventlogs, struct eventlog, entry )
+    {
+        if (log != handle) continue;
+        list_remove( &log->entry );
+        LeaveCriticalSection( &eventlog_cs );
+        EnterCriticalSection( &log->cs );
+        LeaveCriticalSection( &log->cs );
+        free_eventlog( log );
+        return TRUE;
+    }
+    LeaveCriticalSection( &eventlog_cs );
+    SetLastError( ERROR_INVALID_HANDLE );
+    return FALSE;
+}
+
+/* makes room for a record of that size: the oldest records go until the log is down to three quarters of its size */
+static BOOL make_room( struct eventlog *log, ELF_LOGFILE_HEADER *header, DWORD size )
+{
+    DWORD keep = log->max_size / 4 * 3, first, bytes;
+    BYTE *buffer;
+    BOOL ret;
+
+    if (header->EndOffset + size + sizeof(ELF_EOF_RECORD) <= log->max_size) return TRUE;
+    keep = size < keep ? keep - size : 0;
+    for (first = log->oldest; first < log->next; first++)
+        if (log->end - log->offsets[first - log->oldest] <= keep) break;
+    bytes = first < log->next ? log->end - log->offsets[first - log->oldest] : 0;
+    TRACE( "log %s: dropping records %lu to %lu\n", debugstr_w(log->log), log->oldest, first - 1 );
+
+    if (!(buffer = malloc( max( bytes, 1 ) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return FALSE;
+    }
+    ret = (!bytes || read_at( log->file, log->offsets[first - log->oldest], buffer, bytes )) &&
+          (!bytes || write_at( log->file, header->StartOffset, buffer, bytes ));
+    free( buffer );
+    if (!ret) return FALSE;
+    header->OldestRecordNumber = first;
+    header->EndOffset = header->StartOffset + bytes;
+    if (!write_end( log->file, header )) return FALSE;
+    SetFilePointer( log->file, header->EndOffset + sizeof(ELF_EOF_RECORD), NULL, FILE_BEGIN );
+    SetEndOfFile( log->file );
+    return refresh_log( log, header );
+}
+
+static void pulse_changed( struct eventlog *log )
+{
+    PulseEvent( log->changed );
+}
+
+/* appends a record built for this log; it gets its number here */
+static BOOL append_record( struct eventlog *log, EVENTLOGRECORD *record )
+{
+    ELF_LOGFILE_HEADER header;
+    BOOL ret = FALSE;
+
+    lock_log( log );
+    if (refresh_log( log, &header ) && make_room( log, &header, record->Length ))
+    {
+        record->RecordNumber = header.CurrentRecordNumber;
+        if (write_at( log->file, header.EndOffset, record, record->Length ))
+        {
+            header.EndOffset += record->Length;
+            header.CurrentRecordNumber++;
+            ret = write_end( log->file, &header );
+        }
+    }
+    unlock_log( log );
+    if (ret) pulse_changed( log );
+    return ret;
+}
+
+/* the computer name a record carries: the DNS one, as Windows since Vista writes */
+static void get_computer_name( WCHAR *name, DWORD size )
+{
+    if (!GetComputerNameExW( ComputerNameDnsFullyQualified, name, &size ) || !name[0])
+    {
+        size = MAX_COMPUTERNAME_LENGTH + 1;
+        GetComputerNameW( name, &size );
+    }
+}
+
+static DWORD write_string( WCHAR *dst, const WCHAR *src )
+{
+    DWORD len = src ? wcslen( src ) + 1 : 1;
+
+    if (dst)
+    {
+        if (src) memcpy( dst, src, len * sizeof(WCHAR) );
+        else dst[0] = 0;
+    }
+    return len * sizeof(WCHAR);
+}
+
+static EVENTLOGRECORD *build_record( const WCHAR *source, WORD type, WORD category, DWORD id, PSID sid,
+                                     WORD count, DWORD data_size, const WCHAR **strings, const void *data )
+{
+    WCHAR computer[MAX_COMPUTERNAME_LENGTH * 8 + 1];
+    DWORD size, sid_size = sid ? GetLengthSid( sid ) : 0, pos, i;
+    LARGE_INTEGER now;
+    EVENTLOGRECORD *record;
+    BYTE *ptr;
+
+    get_computer_name( computer, ARRAY_SIZE(computer) );
+    pos = sizeof(EVENTLOGRECORD) + write_string( NULL, source ) + write_string( NULL, computer );
+    size = align8( pos ) + sid_size;
+    for (i = 0; i < count; i++) size += write_string( NULL, strings ? strings[i] : NULL );
+    size = align8( size + data_size + sizeof(DWORD) );
+
+    if (!(record = calloc( 1, size )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    ptr = (BYTE *)record;
+    record->Length = size;
+    record->Reserved = LOG_SIGNATURE;
+    NtQuerySystemTime( &now );
+    RtlTimeToSecondsSince1970( &now, &record->TimeGenerated );
+    record->TimeWritten = record->TimeGenerated;
+    record->EventID = id;
+    /* what is not one of the types is written as EVENTLOG_SUCCESS, as since Vista */
+    switch (type)
+    {
+    case EVENTLOG_SUCCESS:
+    case EVENTLOG_ERROR_TYPE:
+    case EVENTLOG_WARNING_TYPE:
+    case EVENTLOG_INFORMATION_TYPE:
+    case EVENTLOG_AUDIT_SUCCESS:
+    case EVENTLOG_AUDIT_FAILURE:
+        record->EventType = type;
+        break;
+    default:
+        record->EventType = EVENTLOG_SUCCESS;
+        break;
+    }
+    record->NumStrings = count;
+    record->EventCategory = category;
+
+    pos = sizeof(EVENTLOGRECORD);
+    pos += write_string( (WCHAR *)(ptr + pos), source );
+    pos += write_string( (WCHAR *)(ptr + pos), computer );
+    pos = align8( pos );
+    record->UserSidOffset = pos;
+    record->UserSidLength = sid_size;
+    if (sid_size) CopySid( sid_size, ptr + pos, sid );
+    pos += sid_size;
+    record->StringOffset = pos;
+    for (i = 0; i < count; i++) pos += write_string( (WCHAR *)(ptr + pos), strings ? strings[i] : NULL );
+    record->DataOffset = pos;
+    record->DataLength = data_size;
+    if (data_size) memcpy( ptr + pos, data, data_size );
+    *(DWORD *)(ptr + size - sizeof(DWORD)) = size;
+    return record;
+}
+
+/* the size a record has for ReadEventLogA, and it converted when there is somewhere to put it */
+static DWORD record_to_ansi( const EVENTLOGRECORD *record, EVENTLOGRECORD *out )
+{
+    const WCHAR *source = (const WCHAR *)(record + 1), *computer = source + wcslen( source ) + 1;
+    const WCHAR *str = (const WCHAR *)((const BYTE *)record + record->StringOffset);
+    BYTE *ptr = (BYTE *)out;
+    DWORD pos = sizeof(EVENTLOGRECORD), size, i;
+    int len;
+
+    len = WideCharToMultiByte( CP_ACP, 0, source, -1, out ? (char *)ptr + pos : NULL, out ? 0x7fffffff : 0, NULL, NULL );
+    pos += len;
+    len = WideCharToMultiByte( CP_ACP, 0, computer, -1, out ? (char *)ptr + pos : NULL, out ? 0x7fffffff : 0, NULL, NULL );
+    pos += len;
+    pos = align8( pos );
+    if (out)
+    {
+        *out = *record;
+        out->UserSidOffset = pos;
+        if (record->UserSidLength)
+            memcpy( ptr + pos, (const BYTE *)record + record->UserSidOffset, record->UserSidLength );
+    }
+    pos += record->UserSidLength;
+    if (out) out->StringOffset = pos;
+    for (i = 0; i < record->NumStrings; i++)
+    {
+        len = WideCharToMultiByte( CP_ACP, 0, str, -1, out ? (char *)ptr + pos : NULL, out ? 0x7fffffff : 0, NULL, NULL );
+        pos += len;
+        str += wcslen( str ) + 1;
+    }
+    if (out)
+    {
+        out->DataOffset = pos;
+        if (record->DataLength)
+            memcpy( ptr + pos, (const BYTE *)record + record->DataOffset, record->DataLength );
+    }
+    pos += record->DataLength;
+    size = align8( pos + sizeof(DWORD) );
+    if (out)
+    {
+        memset( ptr + pos, 0, size - pos );
+        out->Length = size;
+        *(DWORD *)(ptr + size - sizeof(DWORD)) = size;
+    }
+    return size;
+}
+
+/* what a read needs: somewhere to put the records and the sizes, the handle, and one way to read in one
+ * direction */
+static BOOL check_read( void *buffer, DWORD *read, DWORD *needed )
+{
+    if (!buffer || !read || !needed)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+static BOOL check_flags( DWORD flags )
+{
+    DWORD how = flags & (EVENTLOG_SEQUENTIAL_READ | EVENTLOG_SEEK_READ);
+    DWORD direction = flags & (EVENTLOG_FORWARDS_READ | EVENTLOG_BACKWARDS_READ);
+
+    if (!how || how == (EVENTLOG_SEQUENTIAL_READ | EVENTLOG_SEEK_READ) ||
+        !direction || direction == (EVENTLOG_FORWARDS_READ | EVENTLOG_BACKWARDS_READ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/* Reads as many whole records as the buffer holds.  A sequential read starts where the last read left off --
+ * forwards at the record after the last one read, backwards at the one before it -- a seek read at the record
+ * asked for; either way the next sequential read goes on from the last record this one gave. */
+static BOOL read_records( HANDLE handle, DWORD flags, DWORD offset, void *buffer, DWORD size, DWORD *read,
+                          DWORD *needed, BOOL ansi )
+{
+    BOOL forward = !!(flags & EVENTLOG_FORWARDS_READ);
+    ELF_LOGFILE_HEADER header;
+    struct eventlog *log;
+    EVENTLOGRECORD *record = NULL;
+    DWORD number, used = 0, last = 0, length, rec_size = 0;
+    BOOL ret = FALSE;
+
+    if (!check_read( buffer, read, needed )) return FALSE;
+    if (!(log = grab_eventlog( handle ))) return FALSE;
+    if (!check_flags( flags )) goto done;
+
+    lock_log( log );
+    if (!refresh_log( log, &header )) goto unlock;
+
+    if (flags & EVENTLOG_SEEK_READ)
+    {
+        if (offset < log->oldest || offset >= log->next)
+        {
+            SetLastError( ERROR_INVALID_PARAMETER );
+            goto unlock;
+        }
+        number = offset;
+    }
+    else if (!log->cursor) number = forward ? log->oldest : log->next - 1;
+    else if (forward) number = max( log->cursor, log->oldest );
+    else number = min( log->cursor - 1, log->next - 1 );
+
+    for (;;)
+    {
+        if (log->next == log->oldest || number < log->oldest || number >= log->next) break;
+        if (!read_at( log->file, log->offsets[number - log->oldest], &length, sizeof(length) )) break;
+        if (length > rec_size)
+        {
+            free( record );
+            if (!(record = malloc( rec_size = length )))
+            {
+                SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+                goto unlock;
+            }
+        }
+        if (!read_at( log->file, log->offsets[number - log->oldest], record, length )) break;
+        length = ansi ? record_to_ansi( record, NULL ) : record->Length;
+        if (used + length > size)
+        {
+            if (!used)
+            {
+                *needed = length;
+                *read = 0;
+                SetLastError( ERROR_INSUFFICIENT_BUFFER );
+                goto unlock;
+            }
+            break;
+        }
+        if (ansi) record_to_ansi( record, (EVENTLOGRECORD *)((BYTE *)buffer + used ));
+        else memcpy( (BYTE *)buffer + used, record, length );
+        used += length;
+        last = number;
+        if (forward) number++;
+        else number--;
+    }
+
+    if (!used)
+    {
+        SetLastError( ERROR_HANDLE_EOF );
+        goto unlock;
+    }
+    log->cursor = forward ? last + 1 : last;
+    *read = used;
+    *needed = 0;
+    ret = TRUE;
+
+unlock:
+    unlock_log( log );
+done:
+    free( record );
+    release_eventlog( log );
+    return ret;
+}
+
+/* writes the records of a log or backup to a new backup file */
+static BOOL backup_log( struct eventlog *log, const WCHAR *file_name )
+{
+    ELF_LOGFILE_HEADER header;
+    HANDLE file;
+    BYTE *buffer = NULL;
+    DWORD bytes;
+    BOOL ret = FALSE;
+
+    if (GetFileAttributesW( file_name ) != INVALID_FILE_ATTRIBUTES)
+    {
+        SetLastError( ERROR_ALREADY_EXISTS );
+        return FALSE;
+    }
+    lock_log( log );
+    if (!refresh_log( log, &header )) goto done;
+    bytes = log->end - header.StartOffset;
+    if (!(buffer = malloc( max( bytes, 1 ) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        goto done;
+    }
+    if (bytes && !read_at( log->file, header.StartOffset, buffer, bytes )) goto done;
+
+    file = CreateFileW( file_name, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (file == INVALID_HANDLE_VALUE) goto done;
+    header.OldestRecordNumber = log->oldest;
+    header.CurrentRecordNumber = log->next;
+    header.StartOffset = sizeof(header);
+    header.EndOffset = sizeof(header) + bytes;
+    header.Flags = 0;
+    ret = (!bytes || write_at( file, sizeof(header), buffer, bytes )) && write_end( file, &header );
+    CloseHandle( file );
+    if (!ret) DeleteFileW( file_name );
+
+done:
+    unlock_log( log );
+    free( buffer );
+    return ret;
+}
+
+static DWORD CALLBACK notify_thread( void *arg )
+{
+    struct eventlog *log = arg;
+    HANDLE handles[2] = { log->notify_stop, log->changed };
+
+    while (WaitForMultipleObjects( 2, handles, FALSE, INFINITE ) == WAIT_OBJECT_0 + 1)
+        SetEvent( log->notify_event );
+    return 0;
+}
+
+/******************************************************************************
+ * BackupEventLogA [ADVAPI32.@]
+ */
+BOOL WINAPI BackupEventLogA( HANDLE handle, const char *file_name )
+{
+    WCHAR *file_nameW;
+    BOOL ret;
+
+    file_nameW = strdupAW( file_name );
+    ret = BackupEventLogW( handle, file_nameW );
+    free( file_nameW );
+    return ret;
+}
+
+/******************************************************************************
+ * BackupEventLogW [ADVAPI32.@]
+ */
+BOOL WINAPI BackupEventLogW( HANDLE handle, const WCHAR *file_name )
+{
+    struct eventlog *log;
+    BOOL ret;
+
+    TRACE( "%p, %s\n", handle, debugstr_w(file_name) );
+
+    if (!file_name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(log = grab_eventlog( handle ))) return FALSE;
+    ret = backup_log( log, file_name );
+    release_eventlog( log );
+    return ret;
+}
+
+/******************************************************************************
+ * ClearEventLogA [ADVAPI32.@]
+ */
+BOOL WINAPI ClearEventLogA( HANDLE handle, const char *file_name )
+{
+    WCHAR *file_nameW;
+    BOOL ret;
+
+    file_nameW = strdupAW( file_name );
+    ret = ClearEventLogW( handle, file_nameW );
+    free( file_nameW );
+    return ret;
+}
+
+/******************************************************************************
+ * ClearEventLogW [ADVAPI32.@]
+ *
+ * Saves the records to the backup file first, when there is one; a backup cannot be cleared.
+ */
+BOOL WINAPI ClearEventLogW( HANDLE handle, const WCHAR *file_name )
+{
+    ELF_LOGFILE_HEADER header;
+    struct eventlog *log;
+    BOOL ret = FALSE;
+
+    TRACE( "%p, %s\n", handle, debugstr_w(file_name) );
+
+    if (!(log = grab_eventlog( handle ))) return FALSE;
+    if (log->backup)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        goto done;
+    }
+    if (file_name && !backup_log( log, file_name )) goto done;
+
+    lock_log( log );
+    if (refresh_log( log, &header ))
+    {
+        header.OldestRecordNumber = header.CurrentRecordNumber;
+        header.EndOffset = header.StartOffset;
+        if ((ret = write_end( log->file, &header )))
+        {
+            SetFilePointer( log->file, header.EndOffset + sizeof(ELF_EOF_RECORD), NULL, FILE_BEGIN );
+            SetEndOfFile( log->file );
+            refresh_log( log, &header );
+        }
+    }
+    unlock_log( log );
+
+done:
+    release_eventlog( log );
+    return ret;
+}
+
+/******************************************************************************
+ * CloseEventLog [ADVAPI32.@]
+ */
+BOOL WINAPI CloseEventLog( HANDLE handle )
+{
+    TRACE( "%p\n", handle );
+
+    return close_eventlog( handle );
+}
+
+/******************************************************************************
+ * DeregisterEventSource [ADVAPI32.@]
+ */
+BOOL WINAPI DeregisterEventSource( HANDLE handle )
+{
+    TRACE( "%p\n", handle );
+
+    /* no handle is no call, and leaves the last error as it is */
+    if (!handle) return FALSE;
+    return close_eventlog( handle );
+}
+
+/******************************************************************************
+ * GetEventLogInformation [ADVAPI32.@]
+ *
+ * A log is never full: it drops its oldest records instead.
+ */
+BOOL WINAPI GetEventLogInformation( HANDLE handle, DWORD level, void *buffer, DWORD size, DWORD *needed )
+{
+    EVENTLOG_FULL_INFORMATION *efi = buffer;
+    struct eventlog *log;
+
+    TRACE( "%p, %lu, %p, %lu, %p\n", handle, level, buffer, size, needed );
+
+    if (level != EVENTLOG_FULL_INFO)
+    {
+        SetLastError( ERROR_INVALID_LEVEL );
+        return FALSE;
+    }
+    if (!(log = grab_eventlog( handle ))) return FALSE;
+    release_eventlog( log );
+
+    if (!buffer || !needed)
+    {
+        SetLastError( RPC_X_NULL_REF_POINTER );
+        return FALSE;
+    }
+    *needed = sizeof(EVENTLOG_FULL_INFORMATION);
+    if (size < sizeof(EVENTLOG_FULL_INFORMATION))
+    {
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    efi->dwFull = 0;
+    return TRUE;
+}
+
+/******************************************************************************
+ * GetNumberOfEventLogRecords [ADVAPI32.@]
+ */
+BOOL WINAPI GetNumberOfEventLogRecords( HANDLE handle, DWORD *count )
+{
+    ELF_LOGFILE_HEADER header;
+    struct eventlog *log;
+    BOOL ret;
+
+    TRACE( "%p, %p\n", handle, count );
+
+    if (!count)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(log = grab_eventlog( handle ))) return FALSE;
+    lock_log( log );
+    if ((ret = refresh_log( log, &header ))) *count = log->next - log->oldest;
+    unlock_log( log );
+    release_eventlog( log );
+    return ret;
+}
+
+/******************************************************************************
+ * GetOldestEventLogRecord [ADVAPI32.@]
+ *
+ * An empty log has none, record 0.
+ */
+BOOL WINAPI GetOldestEventLogRecord( HANDLE handle, DWORD *oldest )
+{
+    ELF_LOGFILE_HEADER header;
+    struct eventlog *log;
+    BOOL ret;
+
+    TRACE( "%p, %p\n", handle, oldest );
+
+    if (!oldest)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!(log = grab_eventlog( handle ))) return FALSE;
+    lock_log( log );
+    if ((ret = refresh_log( log, &header ))) *oldest = log->next > log->oldest ? log->oldest : 0;
+    unlock_log( log );
+    release_eventlog( log );
+    return ret;
+}
+
+/******************************************************************************
+ * NotifyChangeEventLog [ADVAPI32.@]
+ *
+ * Sets the event whenever a record is written to the log, from now on; a later call takes another event.
+ */
+BOOL WINAPI NotifyChangeEventLog( HANDLE handle, HANDLE event )
+{
+    struct eventlog *log;
+    BOOL ret = FALSE;
+    HANDLE dup;
+
+    TRACE( "%p, %p\n", handle, event );
+
+    if (!(log = grab_eventlog( handle ))) return FALSE;
+    if (log->backup)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        goto done;
+    }
+    if (!DuplicateHandle( GetCurrentProcess(), event, GetCurrentProcess(), &dup, 0, FALSE, DUPLICATE_SAME_ACCESS ))
+        goto done;
+    if (log->notify_thread)
+    {
+        SetEvent( log->notify_stop );
+        WaitForSingleObject( log->notify_thread, INFINITE );
+        CloseHandle( log->notify_thread );
+        CloseHandle( log->notify_event );
+        ResetEvent( log->notify_stop );
+    }
+    else if (!(log->notify_stop = CreateEventW( NULL, TRUE, FALSE, NULL )))
+    {
+        CloseHandle( dup );
+        goto done;
+    }
+    log->notify_event = dup;
+    if (!(log->notify_thread = CreateThread( NULL, 0, notify_thread, log, 0, NULL )))
+    {
+        CloseHandle( dup );
+        log->notify_event = NULL;
+        goto done;
+    }
+    ret = TRUE;
+
+done:
+    release_eventlog( log );
+    return ret;
+}
+
+/******************************************************************************
+ * OpenBackupEventLogA [ADVAPI32.@]
+ */
+HANDLE WINAPI OpenBackupEventLogA( const char *server, const char *file_name )
+{
+    WCHAR *serverW, *file_nameW;
+    HANDLE handle;
+
+    serverW = strdupAW( server );
+    file_nameW = strdupAW( file_name );
+    handle = OpenBackupEventLogW( serverW, file_nameW );
+    free( serverW );
+    free( file_nameW );
+    return handle;
+}
+
+/******************************************************************************
+ * OpenBackupEventLogW [ADVAPI32.@]
+ *
+ * A backup is read as it is when it is opened.
+ */
+HANDLE WINAPI OpenBackupEventLogW( const WCHAR *server, const WCHAR *file_name )
+{
+    ELF_LOGFILE_HEADER header;
+    struct eventlog *log;
+
+    TRACE( "%s, %s\n", debugstr_w(server), debugstr_w(file_name) );
+
+    if (!file_name)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!is_local_server( server ))
+    {
+        FIXME( "Remote server not supported\n" );
+        SetLastError( RPC_S_SERVER_UNAVAILABLE );
+        return NULL;
+    }
+
+    if (!(log = alloc_eventlog())) return NULL;
+    log->backup = TRUE;
+    log->file = CreateFileW( file_name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                             OPEN_EXISTING, FILE_ATTRIBUTE_NORMAL, NULL );
+    if (log->file == INVALID_HANDLE_VALUE || !(log->log = wcsdup( file_name )) || !refresh_log( log, &header ))
+    {
+        DWORD error = GetLastError();
+
+        if (log->file != INVALID_HANDLE_VALUE && error != ERROR_NOT_ENOUGH_MEMORY) error = ERROR_EVENTLOG_FILE_CORRUPT;
+        free_eventlog( log );
+        SetLastError( error );
+        return NULL;
+    }
+    return add_eventlog( log );
+}
+
+/******************************************************************************
+ * OpenEventLogA [ADVAPI32.@]
+ */
+HANDLE WINAPI OpenEventLogA( const char *server, const char *source )
+{
+    WCHAR *serverW, *sourceW;
+    HANDLE handle;
+
+    serverW = strdupAW( server );
+    sourceW = strdupAW( source );
+    handle = OpenEventLogW( serverW, sourceW );
+    free( serverW );
+    free( sourceW );
+    return handle;
+}
+
+/******************************************************************************
+ * OpenEventLogW [ADVAPI32.@]
+ *
+ * Opens the log of that name, or the one the source of that name writes to.
+ */
+HANDLE WINAPI OpenEventLogW( const WCHAR *server, const WCHAR *source )
+{
+    TRACE( "%s, %s\n", debugstr_w(server), debugstr_w(source) );
+
+    if (!source)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!is_local_server( server ))
+    {
+        FIXME( "Remote server not supported\n" );
+        SetLastError( RPC_S_SERVER_UNAVAILABLE );
+        return NULL;
+    }
+    return open_log( source );
+}
+
+/******************************************************************************
+ * ReadEventLogA [ADVAPI32.@]
+ */
+BOOL WINAPI ReadEventLogA( HANDLE handle, DWORD flags, DWORD offset, void *buffer, DWORD size, DWORD *read,
+                           DWORD *needed )
+{
+    TRACE( "%p, %#lx, %lu, %p, %lu, %p, %p\n", handle, flags, offset, buffer, size, read, needed );
+
+    return read_records( handle, flags, offset, buffer, size, read, needed, TRUE );
+}
+
+/******************************************************************************
+ * ReadEventLogW [ADVAPI32.@]
+ */
+BOOL WINAPI ReadEventLogW( HANDLE handle, DWORD flags, DWORD offset, void *buffer, DWORD size, DWORD *read,
+                           DWORD *needed )
+{
+    TRACE( "%p, %#lx, %lu, %p, %lu, %p, %p\n", handle, flags, offset, buffer, size, read, needed );
+
+    return read_records( handle, flags, offset, buffer, size, read, needed, FALSE );
+}
+
+/******************************************************************************
+ * RegisterEventSourceA [ADVAPI32.@]
+ */
+HANDLE WINAPI RegisterEventSourceA( const char *server, const char *source )
+{
+    WCHAR *serverW, *sourceW;
+    HANDLE handle;
+
+    TRACE( "%s, %s\n", debugstr_a(server), debugstr_a(source) );
+
+    serverW = strdupAW( server );
+    sourceW = strdupAW( source );
+    handle = RegisterEventSourceW( serverW, sourceW );
+    free( serverW );
+    free( sourceW );
+    return handle;
+}
+
+/******************************************************************************
+ * RegisterEventSourceW [ADVAPI32.@]
+ */
+HANDLE WINAPI RegisterEventSourceW( const WCHAR *server, const WCHAR *source )
+{
+    TRACE( "%s, %s\n", debugstr_w(server), debugstr_w(source) );
+
+    if (!source || !source[0])
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (!is_local_server( server ))
+    {
+        FIXME( "Remote server not supported\n" );
+        SetLastError( RPC_S_SERVER_UNAVAILABLE );
+        return NULL;
+    }
+    /* only the system writes the security log */
+    if (!wcsicmp( source, L"Security" ))
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return NULL;
+    }
+    return open_log( source );
+}
+
+/******************************************************************************
+ * ReportEventA [ADVAPI32.@]
+ */
+BOOL WINAPI ReportEventA( HANDLE handle, WORD type, WORD category, DWORD id, PSID sid, WORD count,
+                          DWORD data_size, const char **strings, void *data )
+{
+    WCHAR **stringsW = NULL;
+    unsigned int i;
+    BOOL ret;
+
+    TRACE( "%p, %#x, %#x, %#lx, %p, %u, %lu, %p, %p\n", handle, type, category, id, sid, count, data_size,
+           strings, data );
+
+    if (count && strings)
+    {
+        if (!(stringsW = calloc( count, sizeof(*stringsW) )))
+        {
+            SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+            return FALSE;
+        }
+        for (i = 0; i < count; i++) stringsW[i] = strdupAW( strings[i] );
+    }
+    ret = ReportEventW( handle, type, category, id, sid, count, data_size, (const WCHAR **)stringsW, data );
+    if (stringsW)
+    {
+        for (i = 0; i < count; i++) free( stringsW[i] );
+        free( stringsW );
+    }
+    return ret;
+}
+
+/******************************************************************************
+ * ReportEventW [ADVAPI32.@]
+ */
+BOOL WINAPI ReportEventW( HANDLE handle, WORD type, WORD category, DWORD id, PSID sid, WORD count,
+                          DWORD data_size, const WCHAR **strings, void *data )
+{
+    EVENTLOGRECORD *record;
+    struct eventlog *log;
+    BOOL ret = FALSE;
+
+    TRACE( "%p, %#x, %#x, %#lx, %p, %u, %lu, %p, %p\n", handle, type, category, id, sid, count, data_size,
+           strings, data );
+
+    if (!(log = grab_eventlog( handle ))) return FALSE;
+    if (log->backup)
+    {
+        SetLastError( ERROR_INVALID_HANDLE );
+        goto done;
+    }
+    if (sid && !IsValidSid( sid ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        goto done;
+    }
+    if (!data) data_size = 0;
+    if (!(record = build_record( log->source, type, category, id, sid, count, data_size, strings, data ))) goto done;
+    ret = append_record( log, record );
+    free( record );
+
+done:
+    release_eventlog( log );
+    return ret;
+}
