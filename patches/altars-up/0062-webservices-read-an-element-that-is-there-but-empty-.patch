+static void test_empty_element_fields(void)
+{
+    static const char xml[] = "<t><a></a><b/><c></c><e></e></t>";
+    WS_XML_STRING str_t = {1, (BYTE *)"t"}, str_a = {1, (BYTE *)"a"}, str_b = {1, (BYTE *)"b"};
+    WS_XML_STRING str_c = {1, (BYTE *)"c"}, str_d = {1, (BYTE *)"d"}, str_e = {1, (BYTE *)"e"};
+    WS_XML_STRING ns = {0, NULL};
+    WS_FIELD_DESCRIPTION f_a, f_b, f_c, f_d, f_e, *fields[5];
+    WS_STRUCT_DESCRIPTION s;
+    WS_XML_READER *reader;
+    WS_HEAP *heap;
+    HRESULT hr;
+    struct test
+    {
+        WCHAR    *a;
+        WCHAR    *b;
+        WCHAR    *c;
+        WCHAR    *d;
+        WS_STRING e;
+    } *test;
+
+    hr = WsCreateHeap( 1 << 16, 0, NULL, 0, &heap, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    hr = WsCreateReader( NULL, 0, &reader, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    memset( &f_a, 0, sizeof(f_a) );
+    f_a.mapping   = WS_ELEMENT_FIELD_MAPPING;
+    f_a.localName = &str_a;
+    f_a.ns        = &ns;
+    f_a.type      = WS_WSZ_TYPE;
+    f_a.offset    = FIELD_OFFSET(struct test, a);
+    f_a.options   = WS_FIELD_OPTIONAL;
+    fields[0] = &f_a;
+
+    f_b = f_a;
+    f_b.localName = &str_b;
+    f_b.offset    = FIELD_OFFSET(struct test, b);
+    fields[1] = &f_b;
+
+    f_c = f_a;
+    f_c.localName = &str_c;
+    f_c.offset    = FIELD_OFFSET(struct test, c);
+    f_c.options   = 0;
+    fields[2] = &f_c;
+
+    f_d = f_a;
+    f_d.localName = &str_d;
+    f_d.offset    = FIELD_OFFSET(struct test, d);
+    fields[3] = &f_d;
+
+    f_e = f_a;
+    f_e.localName = &str_e;
+    f_e.type      = WS_STRING_TYPE;
+    f_e.offset    = FIELD_OFFSET(struct test, e);
+    fields[4] = &f_e;
+
+    memset( &s, 0, sizeof(s) );
+    s.size          = sizeof(struct test);
+    s.alignment     = TYPE_ALIGNMENT(struct test);
+    s.fields        = fields;
+    s.fieldCount    = 5;
+    s.typeLocalName = &str_t;
+    s.typeNs        = &ns;
+
+    /* an element that is there but empty is an empty string, not a missing one */
+    prepare_struct_type_test( reader, xml );
+    test = NULL;
+    hr = WsReadType( reader, WS_ELEMENT_TYPE_MAPPING, WS_STRUCT_TYPE, &s,
+                     WS_READ_REQUIRED_POINTER, heap, &test, sizeof(test), NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( test != NULL, "test not set\n" );
+    ok( test->a != NULL, "a not set\n" );
+    if (test->a) ok( !test->a[0], "got %s\n", wine_dbgstr_w(test->a) );
+    ok( test->b != NULL, "b not set\n" );
+    if (test->b) ok( !test->b[0], "got %s\n", wine_dbgstr_w(test->b) );
+    ok( test->c != NULL, "c not set\n" );
+    if (test->c) ok( !test->c[0], "got %s\n", wine_dbgstr_w(test->c) );
+    ok( !test->d, "d is set\n" );
+    ok( !test->e.length, "got %lu\n", test->e.length );
+    ok( test->e.chars != NULL, "chars not set\n" );
+
+    WsFreeReader( reader );
+    WsFreeHeap( heap );
+}
+
 static void test_WsReadBytes(void)
 {
     HRESULT hr;
@@ -7592,6 +7678,7 @@ START_TEST(reader)
     test_WsSetReaderPosition();
     test_entities();
     test_field_options();
+    test_empty_element_fields();
     test_WsReadBytes();
     test_WsReadChars();
     test_WsReadCharsUtf8();
