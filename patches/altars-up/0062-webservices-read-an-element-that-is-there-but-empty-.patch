From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 12:22:02 -0400
Subject: [PATCH] webservices: read an element that is there but empty as an
 empty string.

Office keeps the catalog of the places it can save to, OneDrive among them,
in the registry, filled from a document odc.officeapps.live.com serves and
read with WsReadType.  Two of its services carry <o:Scope></o:Scope>.  On
Windows that field reads back as "", on Wine as NULL, and Office takes a NULL
scope for a broken catalog: it writes none of it, AutoSave finds no location
to upload to, and its dialog shows an empty list with "Sign in" beside it.

An element whose content is empty, <a></a> or <a/>, now gives the string
types an empty value where they used to see none at all: "" for WS_WSZ_TYPE
and a zero-length value with its pointer set for WS_STRING_TYPE,
WS_XML_STRING_TYPE and WS_BYTES_TYPE, whatever the field's options, as a
probe measured on Windows.  A missing element is still a missing field.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 6b8b7461d742b542ccc78bfd2e28467130df20dd)

diff --git a/dlls/webservices/reader.c b/dlls/webservices/reader.c
index a15c516a385..119fcc14cf7 100644
--- a/dlls/webservices/reader.c
+++ b/dlls/webservices/reader.c
@@ -4406,6 +4406,36 @@ static HRESULT get_text( struct reader *reader, WS_TYPE_MAPPING mapping, const W
     }
 }
 
+/* An element that is there but holds no text, <a></a> or <a/>, has empty text rather than none:
+ * read as a string it comes back as "" and not as NULL, as it does on Windows. */
+static HRESULT get_text_or_empty( struct reader *reader, WS_TYPE_MAPPING mapping, const WS_XML_STRING *localname,
+                                  const WS_XML_STRING *ns, const WS_XML_TEXT **ret, BOOL *found )
+{
+    static const WS_XML_UTF8_TEXT empty = {{WS_XML_TEXT_TYPE_UTF8}, {0, (BYTE *)""}};
+    struct reader_pos pos;
+    BOOL is_empty;
+    HRESULT hr;
+
+    if ((hr = get_text( reader, mapping, localname, ns, ret, found )) != S_OK || *found) return hr;
+    if (mapping != WS_ELEMENT_TYPE_MAPPING && mapping != WS_ELEMENT_CONTENT_TYPE_MAPPING) return S_OK;
+
+    if (!localname) is_empty = node_type( reader->current ) == WS_XML_NODE_TYPE_END_ELEMENT;
+    else
+    {
+        if (!match_element( reader->current, localname, ns )) return S_OK;
+        save_reader_position( reader, &pos );
+        if ((hr = read_next_node( reader )) != S_OK) return hr;
+        is_empty = node_type( reader->current ) == WS_XML_NODE_TYPE_END_ELEMENT;
+        restore_reader_position( reader, &pos );
+    }
+    if (is_empty)
+    {
+        *ret = &empty.text;
+        *found = TRUE;
+    }
+    return S_OK;
+}
+
 static HRESULT text_to_bool( const WS_XML_TEXT *text, BOOL *val )
 {
     HRESULT hr;
@@ -5352,7 +5382,7 @@ static HRESULT read_type_wsz( struct reader *reader, WS_TYPE_MAPPING mapping,
         FIXME( "description not supported\n" );
         return E_NOTIMPL;
     }
-    if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
+    if ((hr = get_text_or_empty( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_wsz( text, heap, &str )) != S_OK) return hr;
 
     switch (option)
@@ -5715,7 +5745,7 @@ static HRESULT read_type_string( struct reader *reader, WS_TYPE_MAPPING mapping,
 
     if (desc) FIXME( "ignoring description\n" );
 
-    if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
+    if ((hr = get_text_or_empty( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_string( text, heap, &val )) != S_OK) return hr;
 
     switch (option)
@@ -5796,7 +5826,7 @@ static HRESULT read_type_bytes( struct reader *reader, WS_TYPE_MAPPING mapping,
 
     if (desc) FIXME( "ignoring description\n" );
 
-    if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
+    if ((hr = get_text_or_empty( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_bytes( text, heap, &val )) != S_OK) return hr;
 
     switch (option)
@@ -5855,7 +5885,7 @@ static HRESULT read_type_xml_string( struct reader *reader, WS_TYPE_MAPPING mapp
 
     if (desc) FIXME( "ignoring description\n" );
 
-    if ((hr = get_text( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
+    if ((hr = get_text_or_empty( reader, mapping, localname, ns, &text, found )) != S_OK) return hr;
     if (*found && (hr = text_to_xml_string( text, heap, &val )) != S_OK) return hr;
 
     switch (option)
