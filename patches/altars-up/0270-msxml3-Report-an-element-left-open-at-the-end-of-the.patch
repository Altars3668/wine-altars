From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 10:46:36 -0400
Subject: [PATCH] msxml3: Report an element left open at the end of the input
 as MSXML does.

The reader answered E_SAX_UNEXPECTED_EOF when the input ended inside an
element.  Measured with tools/saxpropprobe on Windows 11, MSXML 3 names
the tag left unclosed, 0xc00ce553, and MSXML 6 the end of the input,
0xc00cee01.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/msxml_private.h b/dlls/msxml3/msxml_private.h
index 20089260d1f..1a1c32248a8 100644
--- a/dlls/msxml3/msxml_private.h
+++ b/dlls/msxml3/msxml_private.h
@@ -64,6 +64,7 @@ enum error_codes
     E_SAX_INVALID_UNICODE = 0xc00ce51f,
     E_SAX_WHITESPACEORQUESTIONMARK = 0xc00ce520,
     E_SAX_UNEXPECTEDENDTAG = 0xc00ce552,
+    E_SAX_UNCLOSEDTAG = 0xc00ce553,
     E_SAX_DUPLICATEATTRIBUTE = 0xc00ce554,
     E_SAX_INVALIDATROOTLEVEL = 0xc00ce556,
     E_SAX_BAD_XMLDECL = 0xc00ce557,
@@ -87,6 +88,7 @@ enum error_codes
     E_DOM_PROHIBIT_DTD = 0xc00ce584,
     E_DOM_MAX_ELEMENT_DEPTH = 0xc00ce586,
 
+    E_SAX_INPUTEND = 0xc00cee01,
     E_SAX_PROHIBIT_DTD = 0xc00cee4e,
     E_SAX_MAX_XML_SIZE = 0xc00cee91,
     E_SAX_MAX_ELEMENT_DEPTH = 0xc00cee92,
diff --git a/dlls/msxml3/saxreader.c b/dlls/msxml3/saxreader.c
index 6ad94267b9e..6afc1e1b854 100644
--- a/dlls/msxml3/saxreader.c
+++ b/dlls/msxml3/saxreader.c
@@ -4902,7 +4902,11 @@ static void saxreader_parse_chardata(struct saxlocator *locator)
     }
 
     free(context.buffer.data);
-    saxreader_set_error(locator, E_SAX_UNEXPECTED_EOF);
+    /* the input ran out inside an element */
+    if (list_empty(&locator->elements))
+        saxreader_set_error(locator, E_SAX_UNEXPECTED_EOF);
+    else
+        saxreader_set_error(locator, locator->saxreader->version >= MSXML4 ? E_SAX_INPUTEND : E_SAX_UNCLOSEDTAG);
 }
 
 /* [18] CDSect ::= CDStart CData CDEnd
diff --git a/dlls/msxml3/tests/saxreader.c b/dlls/msxml3/tests/saxreader.c
index 6a24c20e74c..520db097c3c 100644
--- a/dlls/msxml3/tests/saxreader.c
+++ b/dlls/msxml3/tests/saxreader.c
@@ -4229,6 +4229,37 @@ static void check_attr_types6(ISAXAttributes *attributes, BOOL modern)
             "Unexpected type %#lx, %s.\n", hr, wine_dbgstr_wn(str, len));
 }
 
+static void test_unclosed_element(void)
+{
+    static const CLSID saxreader60 = {0x88d96a0c, 0xf192, 0x11d4, {0xa6, 0x5f, 0, 0x40, 0x96, 0x32, 0x51, 0xe5}};
+    /* an element still open when the input ends: MSXML 3 names the unclosed tag, 6 the end of the input */
+    static const struct { const CLSID *clsid; const char *name; HRESULT hr; } readers[] =
+    {
+        { &CLSID_SAXXMLReader30, "SAXXMLReader30", 0xc00ce553 },
+        { &saxreader60, "SAXXMLReader60", 0xc00cee01 },
+    };
+    ISAXXMLReader *reader;
+    unsigned int i;
+    VARIANT source;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(readers); ++i)
+    {
+        hr = CoCreateInstance(readers[i].clsid, NULL, CLSCTX_INPROC_SERVER, &IID_ISAXXMLReader, (void **)&reader);
+        if (FAILED(hr))
+        {
+            win_skip("%s is not supported.\n", readers[i].name);
+            continue;
+        }
+        V_VT(&source) = VT_BSTR;
+        V_BSTR(&source) = SysAllocString(L"<?xml version=\"1.0\"?><e>");
+        hr = ISAXXMLReader_parse(reader, source);
+        ok(hr == readers[i].hr, "%s: unexpected hr %#lx.\n", readers[i].name, hr);
+        VariantClear(&source);
+        ISAXXMLReader_Release(reader);
+    }
+}
+
 static void test_saxreader_attributes(void)
 {
     static const CLSID saxreader60 = {0x88d96a0c, 0xf192, 0x11d4, {0xa6, 0x5f, 0, 0x40, 0x96, 0x32, 0x51, 0xe5}};
@@ -8088,6 +8119,7 @@ START_TEST(saxreader)
     test_saxreader_encoding();
     test_saxreader_dispex();
     test_saxreader_attributes();
+    test_unclosed_element();
     test_saxreader_vb_content_handler();
     test_saxreader_cdata();
     test_saxreader_pi();
