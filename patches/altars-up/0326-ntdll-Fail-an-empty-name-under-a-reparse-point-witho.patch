From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 01:41:47 -0400
Subject: [PATCH] ntdll: Fail an empty name under a reparse point without
 FILE_OPEN_REPARSE_POINT.

Opening the reparse point that a root handle is, through an empty name
and without FILE_OPEN_REPARSE_POINT, fails with
STATUS_IO_REPARSE_DATA_INVALID on Windows, consistently across machines
as the test notes.  Wine opened the reparse point itself, and the test
then marked it for deletion and went on as if the open had failed.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 0afc10b19f2..dd58088e583 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -6671,7 +6671,7 @@ static void test_reparse_points(void)
     RtlInitUnicodeString( &nameW, L"" );
     status = NtCreateFile( &subdir, GENERIC_ALL, &attr2, &io, NULL, 0, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
                            FILE_OPEN_IF, 0, NULL, 0 );
-    todo_wine ok( status == STATUS_IO_REPARSE_DATA_INVALID, "got %#lx\n", status );
+    ok( status == STATUS_IO_REPARSE_DATA_INVALID, "got %#lx\n", status );
     if (!status)
     {
         status = NtSetInformationFile( subdir, &io, &fdi, sizeof(fdi), FileDispositionInformation );
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 2ac0d8141dc..e01fe1fe4ec 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -3986,6 +3986,12 @@ static NTSTATUS nt_to_unix_file_name( OBJECT_ATTRIBUTES *attr, UNICODE_STRING *n
             if (needs_close) close( root_fd );
             status = STATUS_BAD_DEVICE_TYPE;
         }
+        else if (!name_len && !open_reparse && xattr_fget( root_fd, XATTR_REPARSE, NULL, 0 ) >= 0)
+        {
+            /* the root itself is a reparse point, which an empty name does not resolve */
+            if (needs_close) close( root_fd );
+            status = STATUS_IO_REPARSE_DATA_INVALID;
+        }
         else
         {
             status = lookup_unix_name( root_fd, attr, nt_name, 0, &unix_name, unix_len,
