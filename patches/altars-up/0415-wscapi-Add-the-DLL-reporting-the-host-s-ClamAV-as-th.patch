+#ifndef __WINE_WSCAPI_UNIXLIB_H
+#define __WINE_WSCAPI_UNIXLIB_H
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/unixlib.h"
+
+/* The host's scanner, the one AMSI hands content to. */
+enum antivirus_state
+{
+    ANTIVIRUS_NONE,        /* none installed */
+    ANTIVIRUS_STOPPED,     /* installed, but not answering: nothing is scanned */
+    ANTIVIRUS_RUNNING,     /* answering, so what AMSI hands it is scanned */
+};
+
+/* Fixed-width throughout and the 64-bit field first, so a 32-bit caller hands over the same layout. */
+struct antivirus_params
+{
+    INT64  database_time;  /* out: unix time its signatures were built, 0 if it did not say */
+    UINT32 state;          /* out: enum antivirus_state */
+    char   product[64];    /* out: what it calls itself, "ClamAV 1.5.4" */
+    char   database[32];   /* out: the version of its signatures */
+};
+
+enum wscapi_funcs
+{
+    unix_query_antivirus,
+    unix_funcs_count
+};
+
+#endif /* __WINE_WSCAPI_UNIXLIB_H */
