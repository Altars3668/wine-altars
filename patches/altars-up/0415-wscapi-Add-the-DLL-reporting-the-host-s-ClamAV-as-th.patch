+
+static WSC_SECURITY_PROVIDER_HEALTH antivirus_health = ~0u;
+
+static void test_WscGetSecurityProviderHealth(void)
+{
+    WSC_SECURITY_PROVIDER_HEALTH health;
+    DWORD provider;
+    HRESULT hr;
+
+    hr = WscGetSecurityProviderHealth( WSC_SECURITY_PROVIDER_ANTIVIRUS, NULL );
+    trace( "no health pointer: %#lx\n", hr );
+    ok( FAILED(hr), "got %#lx\n", hr );
+
+    health = 0xdeadbeef;
+    hr = WscGetSecurityProviderHealth( 0, &health );
+    trace( "no provider: %#lx, health %#x\n", hr, health );
+
+    health = 0xdeadbeef;
+    hr = WscGetSecurityProviderHealth( 0x80, &health );
+    trace( "unknown provider: %#lx, health %#x\n", hr, health );
+
+    for (provider = WSC_SECURITY_PROVIDER_FIREWALL; provider <= WSC_SECURITY_PROVIDER_SERVICE; provider <<= 1)
+    {
+        health = 0xdeadbeef;
+        hr = WscGetSecurityProviderHealth( provider, &health );
+        ok( hr == S_OK, "provider %#lx: got %#lx\n", provider, hr );
+        ok( health <= WSC_SECURITY_PROVIDER_HEALTH_SNOOZE, "provider %#lx: got health %#x\n", provider, health );
+        trace( "provider %#lx: health %u\n", provider, health );
+        if (provider == WSC_SECURITY_PROVIDER_ANTIVIRUS) antivirus_health = health;
+    }
+
+    health = 0xdeadbeef;
+    hr = WscGetSecurityProviderHealth( WSC_SECURITY_PROVIDER_ALL, &health );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( health <= WSC_SECURITY_PROVIDER_HEALTH_SNOOZE, "got health %#x\n", health );
+    trace( "all providers: health %u\n", health );
+
+    health = 0xdeadbeef;
+    hr = WscGetSecurityProviderHealth( WSC_SECURITY_PROVIDER_ANTIVIRUS | WSC_SECURITY_PROVIDER_SERVICE, &health );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    trace( "antivirus and service: health %u\n", health );
+}
+
+static DWORD WINAPI changes_callback( void *context )
+{
+    return 0;
+}
+
+static void test_WscRegisterForChanges(void)
+{
+    HANDLE handle;
+    HRESULT hr;
+
+    hr = WscRegisterForChanges( NULL, NULL, changes_callback, NULL );
+    trace( "no handle pointer: %#lx\n", hr );
+    ok( FAILED(hr), "got %#lx\n", hr );
+
+    handle = (HANDLE)0xdeadbeef;
+    hr = WscRegisterForChanges( NULL, &handle, NULL, NULL );
+    trace( "no callback: %#lx, handle %p\n", hr, handle );
+    ok( FAILED(hr), "got %#lx\n", hr );
+
+    handle = NULL;
+    hr = WscRegisterForChanges( NULL, &handle, changes_callback, (void *)0xdeadbeef );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( handle != NULL, "got no handle\n" );
+    hr = WscUnRegisterChanges( handle );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    hr = WscUnRegisterChanges( NULL );
+    trace( "unregistering NULL: %#lx\n", hr );
+}
+
+static void test_product_list(ULONG provider)
+{
+    WSC_SECURITY_SIGNATURE_STATUS signatures;
+    WSC_SECURITY_PRODUCT_STATE state;
+    IWSCProductList *list;
+    IWscProduct *product;
+    BOOL good_found = FALSE, is_default;
+    LONG count, i;
+    BSTR str;
+    HRESULT hr;
+
+    hr = CoCreateInstance( &CLSID_WSCProductList, NULL, CLSCTX_INPROC_SERVER, &IID_IWSCProductList, (void **)&list );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (FAILED(hr)) return;
+
+    count = 0xdeadbeef;
+    hr = IWSCProductList_get_Count( list, &count );
+    trace( "count before initializing: %#lx, %ld\n", hr, count );
+
+    hr = IWSCProductList_Initialize( list, provider );
+    ok( hr == S_OK, "provider %#lx: got %#lx\n", provider, hr );
+
+    count = -1;
+    hr = IWSCProductList_get_Count( list, &count );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( count >= 0, "got count %ld\n", count );
+    trace( "provider %#lx: %ld products\n", provider, count );
+
+    for (i = 0; i < count; i++)
+    {
+        product = NULL;
+        hr = IWSCProductList_get_Item( list, i, &product );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        if (FAILED(hr)) continue;
+
+        hr = IWscProduct_get_ProductName( product, &str );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( str && *str, "got an empty name\n" );
+        trace( "  name %s\n", wine_dbgstr_w(str) );
+        SysFreeString( str );
+
+        state = 0xdeadbeef;
+        hr = IWscProduct_get_ProductState( product, &state );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( state <= WSC_SECURITY_PRODUCT_STATE_EXPIRED, "got state %#x\n", state );
+
+        signatures = 0xdeadbeef;
+        hr = IWscProduct_get_SignatureStatus( product, &signatures );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( signatures <= WSC_SECURITY_PRODUCT_UP_TO_DATE, "got signature status %#x\n", signatures );
+        trace( "  state %u, signatures %u\n", state, signatures );
+        if (state == WSC_SECURITY_PRODUCT_STATE_ON && signatures == WSC_SECURITY_PRODUCT_UP_TO_DATE) good_found = TRUE;
+
+        hr = IWscProduct_get_ProductGuid( product, &str );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( str && str[0] == '{', "got guid %s\n", wine_dbgstr_w(str) );
+        SysFreeString( str );
+
+        hr = IWscProduct_get_RemediationPath( product, &str );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        trace( "  remediation path %s\n", wine_dbgstr_w(str) );
+        SysFreeString( str );
+
+        hr = IWscProduct_get_ProductStateTimestamp( product, &str );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        trace( "  timestamp %s\n", wine_dbgstr_w(str) );
+        SysFreeString( str );
+
+        hr = IWscProduct_get_ProductIsDefault( product, &is_default );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        trace( "  default %d\n", is_default );
+
+        IWscProduct_Release( product );
+    }
+
+    product = (IWscProduct *)0xdeadbeef;
+    hr = IWSCProductList_get_Item( list, count, &product );
+    trace( "item past the end: %#lx, %p\n", hr, product );
+    ok( FAILED(hr), "got %#lx\n", hr );
+
+    /* the health of the antivirus is the state of the products */
+    if (provider == WSC_SECURITY_PROVIDER_ANTIVIRUS && antivirus_health == WSC_SECURITY_PROVIDER_HEALTH_GOOD)
+        ok( good_found, "the antivirus is in good health, but no product is on and up to date\n" );
+    if (provider == WSC_SECURITY_PROVIDER_ANTIVIRUS && antivirus_health == WSC_SECURITY_PROVIDER_HEALTH_NOTMONITORED)
+        ok( !count, "no antivirus is monitored, but there are %ld\n", count );
+
+    IWSCProductList_Release( list );
+}
+
+static void test_product_list_initialize(void)
+{
+    IWSCProductList *list;
+    HRESULT hr;
+
+    hr = CoCreateInstance( &CLSID_WSCProductList, NULL, CLSCTX_INPROC_SERVER, &IID_IWSCProductList, (void **)&list );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (FAILED(hr)) return;
+
+    hr = IWSCProductList_Initialize( list, WSC_SECURITY_PROVIDER_AUTOUPDATE_SETTINGS );
+    trace( "initializing for automatic updates: %#lx\n", hr );
+    hr = IWSCProductList_Initialize( list, WSC_SECURITY_PROVIDER_ANTIVIRUS );
+    trace( "initializing for an antivirus after that: %#lx\n", hr );
+    hr = IWSCProductList_Initialize( list, WSC_SECURITY_PROVIDER_ANTIVIRUS );
+    trace( "initializing a second time: %#lx\n", hr );
+    IWSCProductList_Release( list );
+}
+
+START_TEST(wscapi)
+{
+    CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+
+    test_WscGetSecurityProviderHealth();
+    test_WscRegisterForChanges();
+    test_product_list( WSC_SECURITY_PROVIDER_ANTIVIRUS );
+    test_product_list( WSC_SECURITY_PROVIDER_ANTISPYWARE );
+    test_product_list( WSC_SECURITY_PROVIDER_FIREWALL );
+    test_product_list_initialize();
+
+    CoUninitialize();
+}
