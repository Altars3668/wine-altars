+
+static HRESULT WINAPI product_get_FirewallPublicProfileSubstatus( IWscProduct3 *iface,
+                                                                  WSC_SECURITY_PRODUCT_SUBSTATUS *status )
+{
+    TRACE( "%p, %p\n", iface, status );
+    return firewall_substatus( status );
+}
+
+static HRESULT WINAPI product_get_AntivirusDaysUntilExpired( IWscProduct3 *iface, DWORD *days )
+{
+    FIXME( "%p, %p stub\n", iface, days );
+    return E_NOTIMPL;
+}
+
+static const IWscProduct3Vtbl product_vtbl =
+{
+    product_QueryInterface,
+    product_AddRef,
+    product_Release,
+    product_GetTypeInfoCount,
+    product_GetTypeInfo,
+    product_GetIDsOfNames,
+    product_Invoke,
+    product_get_ProductName,
+    product_get_ProductState,
+    product_get_SignatureStatus,
+    product_get_RemediationPath,
+    product_get_ProductStateTimestamp,
+    product_get_ProductGuid,
+    product_get_ProductIsDefault,
+    product_get_AntivirusScanSubstatus,
+    product_get_AntivirusSettingsSubstatus,
+    product_get_AntivirusProtectionUpdateSubstatus,
+    product_get_FirewallDomainProfileSubstatus,
+    product_get_FirewallPrivateProfileSubstatus,
+    product_get_FirewallPublicProfileSubstatus,
+    product_get_AntivirusDaysUntilExpired,
+};
+
+struct product_list
+{
+    IWSCProductList IWSCProductList_iface;
+    LONG refcount;
+    ULONG provider;        /* 0 until initialized */
+    LONG count;
+    struct antivirus_params params;
+};
+
+static inline struct product_list *impl_from_IWSCProductList( IWSCProductList *iface )
+{
+    return CONTAINING_RECORD( iface, struct product_list, IWSCProductList_iface );
+}
+
+static HRESULT WINAPI product_list_QueryInterface( IWSCProductList *iface, REFIID iid, void **out )
+{
+    struct product_list *list = impl_from_IWSCProductList( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IDispatch ) || IsEqualIID( iid, &IID_IWSCProductList ))
+    {
+        *out = &list->IWSCProductList_iface;
+        IWSCProductList_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI product_list_AddRef( IWSCProductList *iface )
+{
+    struct product_list *list = impl_from_IWSCProductList( iface );
+    return InterlockedIncrement( &list->refcount );
+}
+
+static ULONG WINAPI product_list_Release( IWSCProductList *iface )
+{
+    struct product_list *list = impl_from_IWSCProductList( iface );
+    ULONG refcount = InterlockedDecrement( &list->refcount );
+
+    if (!refcount) free( list );
+    return refcount;
+}
+
+static HRESULT WINAPI product_list_GetTypeInfoCount( IWSCProductList *iface, UINT *count )
+{
+    TRACE( "%p, %p\n", iface, count );
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI product_list_GetTypeInfo( IWSCProductList *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    FIXME( "%p, %u, %#lx, %p stub\n", iface, index, lcid, info );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI product_list_GetIDsOfNames( IWSCProductList *iface, REFIID iid, LPOLESTR *names, UINT count,
+                                                  LCID lcid, DISPID *ids )
+{
+    FIXME( "%p, %s, %p, %u, %#lx, %p stub\n", iface, debugstr_guid(iid), names, count, lcid, ids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI product_list_Invoke( IWSCProductList *iface, DISPID id, REFIID iid, LCID lcid, WORD flags,
+                                          DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    FIXME( "%p, %ld, %s, %#lx, %#x, %p, %p, %p, %p stub\n", iface, id, debugstr_guid(iid), lcid, flags,
+           params, result, excep, arg_err );
+    return E_NOTIMPL;
+}
+
+/* the products of one kind: an antivirus, a firewall or an antispyware product */
+static HRESULT WINAPI product_list_Initialize( IWSCProductList *iface, ULONG provider )
+{
+    struct product_list *list = impl_from_IWSCProductList( iface );
+
+    TRACE( "%p, %#lx\n", iface, provider );
+
+    if (provider != WSC_SECURITY_PROVIDER_ANTIVIRUS && provider != WSC_SECURITY_PROVIDER_ANTISPYWARE
+        && provider != WSC_SECURITY_PROVIDER_FIREWALL)
+        return E_INVALIDARG;
+    if (list->provider) return HRESULT_FROM_WIN32( ERROR_ALREADY_INITIALIZED );
+
+    list->provider = provider;
+    query_antivirus( &list->params );
+    list->count = provider != WSC_SECURITY_PROVIDER_FIREWALL && list->params.state != ANTIVIRUS_NONE ? 1 : 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI product_list_get_Count( IWSCProductList *iface, LONG *val )
+{
+    struct product_list *list = impl_from_IWSCProductList( iface );
+
+    TRACE( "%p, %p\n", iface, val );
+
+    if (!val) return E_POINTER;
+    if (!list->provider) return E_UNEXPECTED;
+    *val = list->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI product_list_get_Item( IWSCProductList *iface, ULONG index, IWscProduct **val )
+{
+    struct product_list *list = impl_from_IWSCProductList( iface );
+    struct product *product;
+
+    TRACE( "%p, %lu, %p\n", iface, index, val );
+
+    if (!val) return E_POINTER;
+    if (!list->provider) return E_UNEXPECTED;
+    if (index >= list->count) return E_INVALIDARG;
+
+    if (!(product = calloc( 1, sizeof(*product) ))) return E_OUTOFMEMORY;
+    product->IWscProduct3_iface.lpVtbl = &product_vtbl;
+    product->refcount = 1;
+    product->params = list->params;
+    *val = (IWscProduct *)&product->IWscProduct3_iface;
+    return S_OK;
+}
+
+static const IWSCProductListVtbl product_list_vtbl =
+{
+    product_list_QueryInterface,
+    product_list_AddRef,
+    product_list_Release,
+    product_list_GetTypeInfoCount,
+    product_list_GetTypeInfo,
+    product_list_GetIDsOfNames,
+    product_list_Invoke,
+    product_list_Initialize,
+    product_list_get_Count,
+    product_list_get_Item,
+};
+
+static HRESULT product_list_create( REFIID iid, void **out )
+{
+    struct product_list *list;
+    HRESULT hr;
+
+    if (!(list = calloc( 1, sizeof(*list) ))) return E_OUTOFMEMORY;
+    list->IWSCProductList_iface.lpVtbl = &product_list_vtbl;
+    list->refcount = 1;
+    hr = IWSCProductList_QueryInterface( &list->IWSCProductList_iface, iid, out );
+    IWSCProductList_Release( &list->IWSCProductList_iface );
+    return hr;
+}
+
+struct class_factory
+{
+    IClassFactory IClassFactory_iface;
+    HRESULT (*create)( REFIID iid, void **out );
+};
+
+static inline struct class_factory *impl_from_IClassFactory( IClassFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct class_factory, IClassFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IClassFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IClassFactory ))
+    {
+        *out = iface;
+        IClassFactory_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IClassFactory *iface ) { return 2; }
+static ULONG WINAPI factory_Release( IClassFactory *iface ) { return 1; }
+
+static HRESULT WINAPI factory_CreateInstance( IClassFactory *iface, IUnknown *outer, REFIID iid, void **out )
+{
+    struct class_factory *factory = impl_from_IClassFactory( iface );
+
+    TRACE( "%p, %p, %s, %p\n", iface, outer, debugstr_guid(iid), out );
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    return factory->create( iid, out );
+}
+
+static HRESULT WINAPI factory_LockServer( IClassFactory *iface, BOOL lock )
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_CreateInstance,
+    factory_LockServer,
+};
+
+static struct class_factory product_list_factory = { { &factory_vtbl }, product_list_create };
+
+HRESULT WINAPI DllGetClassObject( REFCLSID clsid, REFIID iid, void **out )
+{
+    TRACE( "%s, %s, %p\n", debugstr_guid(clsid), debugstr_guid(iid), out );
+
+    if (IsEqualCLSID( clsid, &CLSID_WSCProductList ))
+        return IClassFactory_QueryInterface( &product_list_factory.IClassFactory_iface, iid, out );
+
+    FIXME( "class %s not available\n", debugstr_guid(clsid) );
+    *out = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
+BOOL WINAPI DllMain( HINSTANCE instance, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        DisableThreadLibraryCalls( instance );
+        if (__wine_init_unix_call()) ERR( "no unix side\n" );
+    }
+    return TRUE;
+}
