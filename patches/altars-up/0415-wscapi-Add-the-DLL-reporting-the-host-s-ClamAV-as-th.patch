+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <stdarg.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <ctype.h>
+#include <errno.h>
+#include <time.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/time.h>
+#include <sys/un.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wscapi);
+
+/* a question about itself, which clamd answers at once */
+#define IO_TIMEOUT_MS 5000
+
+/* Where clamd listens, found the way amsi finds it, as it is the scanner AMSI hands content to:
+ * WINE_AMSI_CLAMD_SOCKET, then clamd's own configuration, then the paths distributions use.  Whether
+ * one is installed at all is whether either of the latter two names a place. */
+static const char *find_socket( char *socket_path, size_t size, BOOL *installed )
+{
+    static const char *const candidates[] =
+    {
+        "/var/run/clamav/clamd.ctl",
+        "/run/clamav/clamd.ctl",
+        "/var/run/clamd.scan/clamd.sock",
+        "/run/clamd.scan/clamd.sock",
+        "/tmp/clamd.socket",
+    };
+    static const char *const configs[] =
+    {
+        "/etc/clamav/clamd.conf",
+        "/etc/clamd.d/scan.conf",
+        "/etc/clamd.conf",
+    };
+    const char *env;
+    unsigned int i;
+
+    *installed = FALSE;
+    if ((env = getenv( "WINE_AMSI_CLAMD_SOCKET" )) && *env)
+    {
+        if (strlen( env ) >= size) return NULL;
+        strcpy( socket_path, env );
+        *installed = TRUE;
+        return socket_path;
+    }
+
+    for (i = 0; i < ARRAYSIZE(configs); i++)
+    {
+        char line[512];
+        FILE *f = fopen( configs[i], "r" );
+
+        if (!f) continue;
+        *installed = TRUE;
+        while (fgets( line, sizeof(line), f ))
+        {
+            char *value, *end;
+
+            if (strncmp( line, "LocalSocket", 11 ) || !isspace( (unsigned char)line[11] )) continue;
+            value = line + 11;
+            while (isspace( (unsigned char)*value )) value++;
+            end = value + strlen( value );
+            while (end > value && isspace( (unsigned char)end[-1] )) end--;
+            *end = 0;
+            if (*value && (size_t)(end - value) < size)
+            {
+                strcpy( socket_path, value );
+                fclose( f );
+                return socket_path;
+            }
+        }
+        fclose( f );
+    }
+
+    for (i = 0; i < ARRAYSIZE(candidates); i++)
+    {
+        if (access( candidates[i], F_OK )) continue;
+        strcpy( socket_path, candidates[i] );
+        *installed = TRUE;
+        return socket_path;
+    }
+    return NULL;
+}
+
+static void set_timeout( int fd, int option, int ms )
+{
+    struct timeval tv = { .tv_sec = ms / 1000, .tv_usec = (ms % 1000) * 1000 };
+    setsockopt( fd, SOL_SOCKET, option, &tv, sizeof(tv) );
+}
+
+/* a command in the "z" dialect, whose reply is NUL-terminated */
+static BOOL ask( const char *path, const char *command, char *reply, size_t size )
+{
+    struct sockaddr_un addr;
+    size_t used = 0;
+    int fd;
+
+    if ((fd = socket( AF_UNIX, SOCK_STREAM, 0 )) < 0) return FALSE;
+    set_timeout( fd, SO_SNDTIMEO, IO_TIMEOUT_MS );
+    set_timeout( fd, SO_RCVTIMEO, IO_TIMEOUT_MS );
+    memset( &addr, 0, sizeof(addr) );
+    addr.sun_family = AF_UNIX;
+    strcpy( addr.sun_path, path );
+    if (connect( fd, (struct sockaddr *)&addr, sizeof(addr) ) || write( fd, command, strlen( command ) + 1 ) != strlen( command ) + 1)
+    {
+        close( fd );
+        return FALSE;
+    }
+    for (;;)
+    {
+        ssize_t got = read( fd, reply + used, size - used - 1 );
+
+        if (got < 0 && errno == EINTR) continue;
+        if (got <= 0) break;
+        used += got;
+        if (memchr( reply, 0, used ) || used + 1 >= size) break;
+    }
+    close( fd );
+    reply[used] = 0;
+    return used > 0;
+}
+
+/* "ClamAV 1.5.4/28140/Thu Oct  1 02:24:38 2026": VERSION, or what VERSIONCOMMANDS starts with where
+ * the configuration turns VERSION off (EnableVersionCommand), which clamd answers either way */
+static BOOL ask_version( const char *path, char *reply, size_t size )
+{
+    char *end;
+
+    if (!ask( path, "zVERSION", reply, size )) return FALSE;
+    if (strncmp( reply, "COMMAND UNAVAILABLE", 19 )) return TRUE;
+    if (!ask( path, "zVERSIONCOMMANDS", reply, size )) return FALSE;
+    if ((end = strchr( reply, '|' ))) *end = 0;
+    return TRUE;
+}
+
+/* the time the signatures were built, as clamd prints it in local time: "Thu Oct  1 02:24:38 2026" */
+static INT64 parse_database_time( const char *str )
+{
+    static const char months[] = "JanFebMarAprMayJunJulAugSepOctNovDec";
+    char month[4];
+    struct tm tm = { 0 };
+    const char *found;
+
+    if (sscanf( str, "%*3s %3s %d %d:%d:%d %d", month, &tm.tm_mday, &tm.tm_hour, &tm.tm_min, &tm.tm_sec,
+                &tm.tm_year ) != 6)
+        return 0;
+    if (!(found = strstr( months, month )) || (found - months) % 3) return 0;
+    tm.tm_mon = (found - months) / 3;
+    tm.tm_year -= 1900;
+    tm.tm_isdst = -1;
+    return mktime( &tm );
+}
+
+static NTSTATUS query_antivirus( void *args )
+{
+    struct antivirus_params *params = args;
+    char reply[256], *database, *date;
+    char socket_path[108];  /* fits sockaddr_un.sun_path on every target */
+    const char *path;
+    BOOL installed;
+
+    memset( params, 0, sizeof(*params) );
+    params->state = ANTIVIRUS_NONE;
+    if (!(path = find_socket( socket_path, sizeof(socket_path), &installed )))
+    {
+        if (installed) params->state = ANTIVIRUS_STOPPED;
+        return STATUS_SUCCESS;
+    }
+    params->state = ANTIVIRUS_STOPPED;
+    if (!ask_version( path, reply, sizeof(reply) ) || strncmp( reply, "ClamAV ", 7 ))
+    {
+        WARN( "scanner at %s does not answer\n", debugstr_a(path) );
+        return STATUS_SUCCESS;
+    }
+    TRACE( "%s\n", debugstr_a(reply) );
+
+    params->state = ANTIVIRUS_RUNNING;
+    if ((database = strchr( reply, '/' ))) *database++ = 0;
+    snprintf( params->product, sizeof(params->product), "%.*s", (int)sizeof(params->product) - 1, reply );
+    if (database && (date = strchr( database, '/' )))
+    {
+        *date++ = 0;
+        snprintf( params->database, sizeof(params->database), "%.*s", (int)sizeof(params->database) - 1, database );
+        params->database_time = parse_database_time( date );
+    }
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    query_antivirus,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    query_antivirus,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif /* _WIN64 */
