+
+/*
+ * The security products Windows reports on are the host's: the antivirus is the scanner AMSI hands
+ * content to (amsi.dll), clamd.  It is on when it answers, which is when a program's scripts, macros
+ * and the like actually get scanned, and its signatures are out of date once they are older than a
+ * week, the point at which ClamAV itself warns about them.  There is nothing to say about a
+ * firewall, Windows Update and so on, which are not monitored.
+ */
+
+#include <stdarg.h>
+#include <stdlib.h>
+#include <time.h>
+
+#define COBJMACROS
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "oleauto.h"
+#include "rpcproxy.h"
+#include "wscapi.h"
+#include "initguid.h"
+#include "iwscapi.h"
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wscapi);
+
+#define WSCAPI_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
+
+/* how old signatures may be and still be up to date: ClamAV warns about older ones */
+#define SIGNATURE_MAX_AGE (7 * 24 * 60 * 60)
+
+/* how often the state is looked at again for those registered for changes */
+#define POLL_INTERVAL_MS 30000
+
+/* the bridged product's identity, which is Wine's own */
+static const WCHAR product_guid[] = L"{5239CE97-D486-4079-B69E-9507A57707A7}";
+
+static void query_antivirus( struct antivirus_params *params )
+{
+    if (WSCAPI_CALL( query_antivirus, params ))
+    {
+        memset( params, 0, sizeof(*params) );
+        params->state = ANTIVIRUS_NONE;
+    }
+}
+
+static BOOL signatures_up_to_date( const struct antivirus_params *params )
+{
+    LONGLONG now;
+
+    if (!params->database_time) return FALSE;
+    now = (LONGLONG)time( NULL );
+    return now - params->database_time <= SIGNATURE_MAX_AGE;
+}
+
+static WSC_SECURITY_PROVIDER_HEALTH antivirus_health( const struct antivirus_params *params )
+{
+    switch (params->state)
+    {
+    case ANTIVIRUS_NONE:    return WSC_SECURITY_PROVIDER_HEALTH_NOTMONITORED;
+    case ANTIVIRUS_STOPPED: return WSC_SECURITY_PROVIDER_HEALTH_POOR;
+    default: return signatures_up_to_date( params ) ? WSC_SECURITY_PROVIDER_HEALTH_GOOD : WSC_SECURITY_PROVIDER_HEALTH_POOR;
+    }
+}
+
+static WSC_SECURITY_PROVIDER_HEALTH provider_health( DWORD provider, const struct antivirus_params *params )
+{
+    switch (provider)
+    {
+    case WSC_SECURITY_PROVIDER_ANTIVIRUS:
+    case WSC_SECURITY_PROVIDER_ANTISPYWARE:
+        return antivirus_health( params );
+    case WSC_SECURITY_PROVIDER_SERVICE:
+        /* the one answering */
+        return WSC_SECURITY_PROVIDER_HEALTH_GOOD;
+    default:
+        return WSC_SECURITY_PROVIDER_HEALTH_NOTMONITORED;
+    }
+}
+
+/* the worse of two, for the health of several providers together */
+static WSC_SECURITY_PROVIDER_HEALTH worse_health( WSC_SECURITY_PROVIDER_HEALTH a, WSC_SECURITY_PROVIDER_HEALTH b )
+{
+    static const unsigned int rank[] =
+    {
+        [WSC_SECURITY_PROVIDER_HEALTH_GOOD] = 0,
+        [WSC_SECURITY_PROVIDER_HEALTH_NOTMONITORED] = 1,
+        [WSC_SECURITY_PROVIDER_HEALTH_SNOOZE] = 2,
+        [WSC_SECURITY_PROVIDER_HEALTH_POOR] = 3,
+    };
+    return rank[b] > rank[a] ? b : a;
+}
+
+/***********************************************************************
+ *              WscGetSecurityProviderHealth (wscapi.@)
+ */
+HRESULT WINAPI WscGetSecurityProviderHealth( DWORD providers, WSC_SECURITY_PROVIDER_HEALTH *health )
+{
+    WSC_SECURITY_PROVIDER_HEALTH ret = WSC_SECURITY_PROVIDER_HEALTH_GOOD;
+    struct antivirus_params params;
+    DWORD bit;
+
+    TRACE( "%#lx, %p\n", providers, health );
+
+    if (!health) return E_INVALIDARG;
+    if (!providers || (providers & ~WSC_SECURITY_PROVIDER_ALL)) return E_INVALIDARG;
+
+    query_antivirus( &params );
+    for (bit = 1; bit <= providers; bit <<= 1)
+        if (providers & bit) ret = worse_health( ret, provider_health( bit, &params ) );
+
+    TRACE( "health %u\n", ret );
+    *health = ret;
+    return S_OK;
+}
+
+struct registration
+{
+    DWORD magic;
+    LPTHREAD_START_ROUTINE callback;
+    void *context;
+    TP_TIMER *timer;
+    WSC_SECURITY_PROVIDER_HEALTH health;
+    BOOL signatures;
+};
+
+#define REGISTRATION_MAGIC 0x72637377  /* "wscr" */
+
+/* tell the registrant when the antivirus's health, or the state of its signatures, has changed */
+static void CALLBACK poll_callback( TP_CALLBACK_INSTANCE *instance, void *context, TP_TIMER *timer )
+{
+    struct registration *reg = context;
+    struct antivirus_params params;
+    WSC_SECURITY_PROVIDER_HEALTH health;
+    BOOL signatures;
+
+    query_antivirus( &params );
+    health = antivirus_health( &params );
+    signatures = signatures_up_to_date( &params );
+    if (health == reg->health && signatures == reg->signatures) return;
+    TRACE( "health %u -> %u\n", reg->health, health );
+    reg->health = health;
+    reg->signatures = signatures;
+    reg->callback( reg->context );
+}
+
+/***********************************************************************
+ *              WscRegisterForChanges (wscapi.@)
+ */
+HRESULT WINAPI WscRegisterForChanges( void *reserved, HANDLE *handle, LPTHREAD_START_ROUTINE callback, void *context )
+{
+    struct antivirus_params params;
+    struct registration *reg;
+    LARGE_INTEGER due;
+    FILETIME ft;
+
+    TRACE( "%p, %p, %p, %p\n", reserved, handle, callback, context );
+
+    if (!handle || !callback) return E_INVALIDARG;
+    if (!(reg = calloc( 1, sizeof(*reg) ))) return E_OUTOFMEMORY;
+
+    reg->magic = REGISTRATION_MAGIC;
+    reg->callback = callback;
+    reg->context = context;
+    query_antivirus( &params );
+    reg->health = antivirus_health( &params );
+    reg->signatures = signatures_up_to_date( &params );
+    if (!(reg->timer = CreateThreadpoolTimer( poll_callback, reg, NULL )))
+    {
+        free( reg );
+        return HRESULT_FROM_WIN32( GetLastError() );
+    }
+    due.QuadPart = -(LONGLONG)POLL_INTERVAL_MS * 10000;
+    ft.dwLowDateTime = due.u.LowPart;
+    ft.dwHighDateTime = due.u.HighPart;
+    SetThreadpoolTimer( reg->timer, &ft, POLL_INTERVAL_MS, 1000 );
+
+    *handle = reg;
+    return S_OK;
+}
+
+/***********************************************************************
+ *              WscUnRegisterChanges (wscapi.@)
+ */
+HRESULT WINAPI WscUnRegisterChanges( HANDLE handle )
+{
+    struct registration *reg = handle;
+
+    TRACE( "%p\n", handle );
+
+    if (!reg || reg->magic != REGISTRATION_MAGIC) return E_INVALIDARG;
+    reg->magic = 0;
+    SetThreadpoolTimer( reg->timer, NULL, 0, 0 );
+    WaitForThreadpoolTimerCallbacks( reg->timer, TRUE );
+    CloseThreadpoolTimer( reg->timer );
+    free( reg );
+    return S_OK;
+}
+
+/***********************************************************************
+ *              WscRegisterForUserNotifications (wscapi.@)
+ */
+HRESULT WINAPI WscRegisterForUserNotifications(void)
+{
+    FIXME( "stub\n" );
+    return E_NOTIMPL;
+}
+
+/***********************************************************************
+ *              WscQueryAntiMalwareUri (wscapi.@)
+ */
+HRESULT WINAPI WscQueryAntiMalwareUri(void)
+{
+    FIXME( "stub\n" );
+    return E_NOTIMPL;
+}
+
+/***********************************************************************
+ *              WscGetAntiMalwareUri (wscapi.@)
+ */
+HRESULT WINAPI WscGetAntiMalwareUri( WCHAR **uri )
+{
+    FIXME( "%p stub\n", uri );
+    return E_NOTIMPL;
+}
+
+/* a product, as it was when the list was made */
+struct product
+{
+    IWscProduct3 IWscProduct3_iface;
+    LONG refcount;
+    struct antivirus_params params;
+};
+
+static inline struct product *impl_from_IWscProduct3( IWscProduct3 *iface )
+{
+    return CONTAINING_RECORD( iface, struct product, IWscProduct3_iface );
+}
+
+static HRESULT WINAPI product_QueryInterface( IWscProduct3 *iface, REFIID iid, void **out )
+{
+    struct product *product = impl_from_IWscProduct3( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IDispatch ) || IsEqualIID( iid, &IID_IWscProduct )
+        || IsEqualIID( iid, &IID_IWscProduct2 ) || IsEqualIID( iid, &IID_IWscProduct3 ))
+    {
+        *out = &product->IWscProduct3_iface;
+        IWscProduct3_AddRef( iface );
+        return S_OK;
+    }
+    FIXME( "%s not implemented\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI product_AddRef( IWscProduct3 *iface )
+{
+    struct product *product = impl_from_IWscProduct3( iface );
+    return InterlockedIncrement( &product->refcount );
+}
+
+static ULONG WINAPI product_Release( IWscProduct3 *iface )
+{
+    struct product *product = impl_from_IWscProduct3( iface );
+    ULONG refcount = InterlockedDecrement( &product->refcount );
+
+    if (!refcount) free( product );
+    return refcount;
+}
+
+static HRESULT WINAPI product_GetTypeInfoCount( IWscProduct3 *iface, UINT *count )
+{
+    TRACE( "%p, %p\n", iface, count );
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI product_GetTypeInfo( IWscProduct3 *iface, UINT index, LCID lcid, ITypeInfo **info )
+{
+    FIXME( "%p, %u, %#lx, %p stub\n", iface, index, lcid, info );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI product_GetIDsOfNames( IWscProduct3 *iface, REFIID iid, LPOLESTR *names, UINT count,
+                                             LCID lcid, DISPID *ids )
+{
+    FIXME( "%p, %s, %p, %u, %#lx, %p stub\n", iface, debugstr_guid(iid), names, count, lcid, ids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI product_Invoke( IWscProduct3 *iface, DISPID id, REFIID iid, LCID lcid, WORD flags,
+                                     DISPPARAMS *params, VARIANT *result, EXCEPINFO *excep, UINT *arg_err )
+{
+    FIXME( "%p, %ld, %s, %#lx, %#x, %p, %p, %p, %p stub\n", iface, id, debugstr_guid(iid), lcid, flags,
+           params, result, excep, arg_err );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI product_get_ProductName( IWscProduct3 *iface, BSTR *val )
+{
+    struct product *product = impl_from_IWscProduct3( iface );
+    const char *name = product->params.product;
+    WCHAR buffer[ARRAY_SIZE(product->params.product)];
+    int len;
+
+    TRACE( "%p, %p\n", iface, val );
+
+    if (!val) return E_POINTER;
+    /* the name, without the version that follows it */
+    for (len = 0; name[len] && name[len] != ' '; len++) buffer[len] = name[len];
+    if (!len)
+    {
+        static const char clamav[] = "ClamAV";
+        for (len = 0; clamav[len]; len++) buffer[len] = clamav[len];
+    }
+    if (!(*val = SysAllocStringLen( buffer, len ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT WINAPI product_get_ProductState( IWscProduct3 *iface, WSC_SECURITY_PRODUCT_STATE *val )
+{
+    struct product *product = impl_from_IWscProduct3( iface );
+
+    TRACE( "%p, %p\n", iface, val );
+
+    if (!val) return E_POINTER;
+    *val = product->params.state == ANTIVIRUS_RUNNING ? WSC_SECURITY_PRODUCT_STATE_ON : WSC_SECURITY_PRODUCT_STATE_OFF;
+    return S_OK;
+}
+
+static HRESULT WINAPI product_get_SignatureStatus( IWscProduct3 *iface, WSC_SECURITY_SIGNATURE_STATUS *val )
+{
+    struct product *product = impl_from_IWscProduct3( iface );
+
+    TRACE( "%p, %p\n", iface, val );
+
+    if (!val) return E_POINTER;
+    *val = signatures_up_to_date( &product->params ) ? WSC_SECURITY_PRODUCT_UP_TO_DATE : WSC_SECURITY_PRODUCT_OUT_OF_DATE;
+    return S_OK;
+}
+
+static HRESULT WINAPI product_get_RemediationPath( IWscProduct3 *iface, BSTR *val )
+{
+    TRACE( "%p, %p\n", iface, val );
+
+    /* the product has no Windows program to fix things with */
+    if (!val) return E_POINTER;
+    if (!(*val = SysAllocString( L"" ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+/* when its state last changed, which here is when its signatures were built, as in an HTTP date */
+static HRESULT WINAPI product_get_ProductStateTimestamp( IWscProduct3 *iface, BSTR *val )
+{
+    static const WCHAR days[][4] = { L"Sun", L"Mon", L"Tue", L"Wed", L"Thu", L"Fri", L"Sat" };
+    static const WCHAR months[][4] = { L"Jan", L"Feb", L"Mar", L"Apr", L"May", L"Jun", L"Jul", L"Aug", L"Sep",
+                                       L"Oct", L"Nov", L"Dec" };
+    struct product *product = impl_from_IWscProduct3( iface );
+    WCHAR buffer[32];
+    LARGE_INTEGER time;
+    SYSTEMTIME st;
+    FILETIME ft;
+
+    TRACE( "%p, %p\n", iface, val );
+
+    if (!val) return E_POINTER;
+    if (!product->params.database_time) *val = SysAllocString( L"" );
+    else
+    {
+        time.QuadPart = product->params.database_time * 10000000 + 116444736000000000;
+        ft.dwLowDateTime = time.u.LowPart;
+        ft.dwHighDateTime = time.u.HighPart;
+        FileTimeToSystemTime( &ft, &st );
+        swprintf( buffer, ARRAY_SIZE(buffer), L"%s, %02u %s %04u %02u:%02u:%02u GMT", days[st.wDayOfWeek], st.wDay,
+                  months[st.wMonth - 1], st.wYear, st.wHour, st.wMinute, st.wSecond );
+        *val = SysAllocString( buffer );
+    }
+    return *val ? S_OK : E_OUTOFMEMORY;
+}
+
+static HRESULT WINAPI product_get_ProductGuid( IWscProduct3 *iface, BSTR *val )
+{
+    TRACE( "%p, %p\n", iface, val );
+
+    if (!val) return E_POINTER;
+    if (!(*val = SysAllocString( product_guid ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT WINAPI product_get_ProductIsDefault( IWscProduct3 *iface, BOOL *val )
+{
+    TRACE( "%p, %p\n", iface, val );
+
+    /* the only one */
+    if (!val) return E_POINTER;
+    *val = TRUE;
+    return S_OK;
+}
