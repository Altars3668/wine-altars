From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 20:04:33 -0400
Subject: [PATCH] wined3d: Present nothing to a window that is gone.

Word presents to the swapchains of windows it has destroyed (its start
screen among them).  The window's device context then belongs to no
window, the context fell back to the backup window and presented
through GDI, which failed ("Failed to blit") after a FIXME that blamed
a missing GL context.  A present to a window that is gone now goes
nowhere quietly, and the device context that no longer fits its window
says so in a WARN.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wined3d/context_gl.c b/dlls/wined3d/context_gl.c
index b090e17f5f1..c38cc5e7024 100644
--- a/dlls/wined3d/context_gl.c
+++ b/dlls/wined3d/context_gl.c
@@ -1174,7 +1174,11 @@ static BOOL wined3d_context_gl_set_pixel_format(struct wined3d_context_gl *conte
         return TRUE;
 
     if (!private && WindowFromDC(dc) != context_gl->window)
+    {
+        WARN("Device context %p is no longer one of window %p (a window %d).\n",
+                dc, context_gl->window, IsWindow(context_gl->window));
         return FALSE;
+    }
 
     current = gl_info->gl_ops.wgl.p_wglGetPixelFormat(dc);
     if ((current == format) || (!current && context_gl->internal_format_set))
diff --git a/dlls/wined3d/swapchain.c b/dlls/wined3d/swapchain.c
index 112f26ffc6e..b290abb21c4 100644
--- a/dlls/wined3d/swapchain.c
+++ b/dlls/wined3d/swapchain.c
@@ -672,7 +672,12 @@ static void swapchain_gl_present(struct wined3d_swapchain *swapchain,
     TRACE("Presenting DC %p.\n", context_gl->dc);
 
     pixel_format = &wined3d_adapter_gl(swapchain->device->adapter)->pixel_formats[context_gl->pixel_format - 1];
-    if (context_gl->dc == wined3d_device_gl(swapchain->device)->backup_dc
+    if (context_gl->dc == wined3d_device_gl(swapchain->device)->backup_dc && !IsWindow(swapchain->win_handle))
+    {
+        /* what is presented to a window that is gone goes nowhere */
+        TRACE("Window %p is gone, nothing to present to.\n", swapchain->win_handle);
+    }
+    else if (context_gl->dc == wined3d_device_gl(swapchain->device)->backup_dc
             || (pixel_format->swap_method != WGL_SWAP_COPY_ARB
             && swapchain_present_is_partial_copy(swapchain, dst_rect)))
     {
@@ -1303,7 +1308,12 @@ static void swapchain_vk_present(struct wined3d_swapchain *swapchain, const RECT
 
     context_vk = wined3d_context_vk(context_acquire(swapchain->device, back_buffer, 0));
 
-    if (!swapchain_vk->vk_swapchain || swapchain_present_is_partial_copy(swapchain, dst_rect))
+    if (!swapchain_vk->vk_swapchain && !IsWindow(swapchain->win_handle))
+    {
+        /* what is presented to a window that is gone goes nowhere */
+        TRACE("Window %p is gone, nothing to present to.\n", swapchain->win_handle);
+    }
+    else if (!swapchain_vk->vk_swapchain || swapchain_present_is_partial_copy(swapchain, dst_rect))
     {
         swapchain_blit_gdi(swapchain, &context_vk->c, src_rect, dst_rect, !swapchain_vk->vk_swapchain);
     }
