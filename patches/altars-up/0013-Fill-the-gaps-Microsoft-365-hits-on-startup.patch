diff --git a/dlls/twinapi.appcore/system_properties.c b/dlls/twinapi.appcore/system_properties.c
new file mode 100644
index 00000000000..6dc2cf751e1
--- /dev/null
+++ b/dlls/twinapi.appcore/system_properties.c
@@ -0,0 +1,404 @@
+/*
+ * Windows.System.Profile.AnalyticsInfo.GetSystemPropertiesAsync
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/* the sentinel the other WinRT dlls use to tell "no handler yet" from "NULL
+ * handler set on purpose" */
+#define HANDLER_NOT_SET ((void *)~(ULONG_PTR)0)
+
+/*
+ * The properties this answers are the ones Windows reports about the flighting
+ * (Windows Insider) configuration of the machine - the only attribute seen
+ * asked for in practice is "n:TriggeredFlightIds". A machine on no flight ring
+ * has none of them, and Windows returns a map without those keys rather than
+ * an error, so an empty view is the correct answer here rather than a
+ * placeholder: callers read "not present" as "not flighted".
+ *
+ * The operation therefore has its result the moment it is created, and this
+ * implements it as an already-completed IAsyncOperation instead of borrowing
+ * the thread-pool machinery the other WinRT dlls carry for genuinely async work.
+ */
+
+struct empty_map_view
+{
+    IMapView_HSTRING_HSTRING IMapView_HSTRING_HSTRING_iface;
+    LONG ref;
+};
+
+static inline struct empty_map_view *impl_from_IMapView_HSTRING_HSTRING( IMapView_HSTRING_HSTRING *iface )
+{
+    return CONTAINING_RECORD( iface, struct empty_map_view, IMapView_HSTRING_HSTRING_iface );
+}
+
+static HRESULT WINAPI map_view_QueryInterface( IMapView_HSTRING_HSTRING *iface, REFIID iid, void **out )
+{
+    struct empty_map_view *impl = impl_from_IMapView_HSTRING_HSTRING( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IMapView_HSTRING_HSTRING ))
+    {
+        IMapView_HSTRING_HSTRING_AddRef( (*out = &impl->IMapView_HSTRING_HSTRING_iface) );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI map_view_AddRef( IMapView_HSTRING_HSTRING *iface )
+{
+    struct empty_map_view *impl = impl_from_IMapView_HSTRING_HSTRING( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI map_view_Release( IMapView_HSTRING_HSTRING *iface )
+{
+    struct empty_map_view *impl = impl_from_IMapView_HSTRING_HSTRING( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI map_view_GetIids( IMapView_HSTRING_HSTRING *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI map_view_GetRuntimeClassName( IMapView_HSTRING_HSTRING *iface, HSTRING *class_name )
+{
+    return WindowsCreateString( L"Windows.Foundation.Collections.IMapView`2<String,String>",
+                                ARRAY_SIZE(L"Windows.Foundation.Collections.IMapView`2<String,String>") - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI map_view_GetTrustLevel( IMapView_HSTRING_HSTRING *iface, TrustLevel *trust_level )
+{
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_view_Lookup( IMapView_HSTRING_HSTRING *iface, HSTRING key, HSTRING *value )
+{
+    TRACE( "iface %p, key %s, value %p.\n", iface, debugstr_hstring( key ), value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return E_BOUNDS;
+}
+
+static HRESULT WINAPI map_view_get_Size( IMapView_HSTRING_HSTRING *iface, UINT32 *size )
+{
+    TRACE( "iface %p, size %p.\n", iface, size );
+    if (!size) return E_POINTER;
+    *size = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_view_HasKey( IMapView_HSTRING_HSTRING *iface, HSTRING key, boolean *found )
+{
+    TRACE( "iface %p, key %s, found %p.\n", iface, debugstr_hstring( key ), found );
+    if (!found) return E_POINTER;
+    *found = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI map_view_Split( IMapView_HSTRING_HSTRING *iface, IMapView_HSTRING_HSTRING **first,
+                                      IMapView_HSTRING_HSTRING **second )
+{
+    TRACE( "iface %p, first %p, second %p.\n", iface, first, second );
+    if (!first || !second) return E_POINTER;
+    *first = NULL;
+    *second = NULL;
+    return S_OK;
+}
+
+static const struct IMapView_HSTRING_HSTRINGVtbl map_view_vtbl =
+{
+    map_view_QueryInterface,
+    map_view_AddRef,
+    map_view_Release,
+    /* IInspectable methods */
+    map_view_GetIids,
+    map_view_GetRuntimeClassName,
+    map_view_GetTrustLevel,
+    /* IMapView<HSTRING,HSTRING> methods */
+    map_view_Lookup,
+    map_view_get_Size,
+    map_view_HasKey,
+    map_view_Split,
+};
+
+static HRESULT empty_map_view_create( IMapView_HSTRING_HSTRING **out )
+{
+    struct empty_map_view *impl;
