 }
 
 
+/***********************************************************************
+ *         FindPackagesByPackageFamily   (kernelbase.@)
+ *
+ * Wine has no MSIX/AppX package repository, so nothing matches any family.
+ * Answering "no packages" is what a machine with none installed reports, and
+ * callers handle it; leaving the export off entirely does not, because a delay
+ * import that cannot bind raises rather than returning an error.
+ */
+LONG WINAPI FindPackagesByPackageFamily( const WCHAR *family_name, UINT32 filters, UINT32 *count,
+                                         WCHAR **full_names, UINT32 *buffer_length, WCHAR *buffer,
+                                         UINT32 *properties )
+{
+    TRACE( "%s, %#x, %p, %p, %p, %p, %p\n", debugstr_w(family_name), filters, count,
+           full_names, buffer_length, buffer, properties );
+
+    if (!family_name || !count || !buffer_length) return ERROR_INVALID_PARAMETER;
+
+    *count = 0;
+    *buffer_length = 0;
+    return ERROR_SUCCESS;
+}
+
 /***********************************************************************
  *         GetCurrentPackageId   (kernelbase.@)
  */
diff --git a/dlls/ntdll/exception.c b/dlls/ntdll/exception.c
index 1802244dac0..1099193641f 100644
--- a/dlls/ntdll/exception.c
+++ b/dlls/ntdll/exception.c
@@ -32,6 +32,7 @@
 #include "wine/list.h"
 #include "wine/debug.h"
 #include "excpt.h"
+#include "delayloadhandler.h"
 #include "ntdll_misc.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(seh);
@@ -254,6 +255,33 @@ NTSTATUS WINAPI dispatch_exception( EXCEPTION_RECORD *rec, CONTEXT *context )
                      (char *)rec->ExceptionInformation[0], (USHORT)rec->ExceptionInformation[1] );
         break;
 
+    /* The MSVC delay-load helper reports failure by raising
+     * VcppException(ERROR_SEVERITY_ERROR, ERROR_MOD_NOT_FOUND / ERROR_PROC_NOT_FOUND)
+     * with a DelayLoadInfo in ExceptionInformation[0]. Wine says nothing about
+     * these, so a process that dies on one leaves no trace of which import it
+     * was -- name it. */
+    case 0xc06d007e:  /* VcppException(ERROR_SEVERITY_ERROR, ERROR_MOD_NOT_FOUND) */
+    case 0xc06d007f:  /* VcppException(ERROR_SEVERITY_ERROR, ERROR_PROC_NOT_FOUND) */
+    {
+        const DELAYLOAD_INFO *info = (const DELAYLOAD_INFO *)rec->ExceptionInformation[0];
+
+        if (rec->NumberParameters >= 1 && info)
+        {
+            if (rec->ExceptionCode == 0xc06d007e)
+                ERR( "delay load of %s failed: module not found (from %p)\n",
+                     debugstr_a( info->TargetDllName ), rec->ExceptionAddress );
+            else if (info->TargetApiDescriptor.ImportDescribedByName)
+                ERR( "delay load of %s.%s failed: procedure not found (from %p)\n",
+                     debugstr_a( info->TargetDllName ),
+                     debugstr_a( info->TargetApiDescriptor.Description.Name ), rec->ExceptionAddress );
+            else
+                ERR( "delay load of %s.#%lu failed: procedure not found (from %p)\n",
+                     debugstr_a( info->TargetDllName ),
+                     info->TargetApiDescriptor.Description.Ordinal, rec->ExceptionAddress );
+        }
+        break;
+    }
+
     case EXCEPTION_WINE_NAME_THREAD:
         if (rec->ExceptionInformation[0] == 0x1000)
         {
diff --git a/dlls/sppc/sppc.c b/dlls/sppc/sppc.c
index 6bc35261491..7bedc274642 100644
--- a/dlls/sppc/sppc.c
+++ b/dlls/sppc/sppc.c
@@ -66,3 +66,38 @@ HRESULT WINAPI SLPersistApplicationPolicies(const SLID *app, const SLID *product
 
     return S_OK;
 }
+
+/*
+ * The application-policy calls. Wine has no Software Protection Platform, so
+ * there are no policies to load -- but refusing outright is not the same as
+ * having none: a caller that cannot even open the policy set treats it as a
+ * broken licensing stack, while one that opens it and finds every value absent
+ * falls back on its own defaults. Office takes the second path and carries on,
+ * so hand it an empty policy set rather than a failure.
+ */
+HRESULT WINAPI SLLoadApplicationPolicies(const SLID *app, const SLID *product, DWORD flags, HSLP *policy)
+{
+    FIXME("(%s,%s,%#lx,%p) stub, returning an empty policy set\n",
+          wine_dbgstr_guid(app), wine_dbgstr_guid(product), flags, policy);
+
+    if (!policy) return E_INVALIDARG;
+    *policy = (HSLP)0xdeadbeef;
+    return S_OK;
+}
+
+HRESULT WINAPI SLGetApplicationPolicy(HSLP policy, LPCWSTR name, SLDATATYPE *type, UINT *size, LPBYTE *value)
+{
+    FIXME("(%p,%s,%p,%p,%p) stub\n", policy, debugstr_w(name), type, size, value);
+
+    /* no policies are defined, so every name is genuinely absent */
+    if (size) *size = 0;
+    if (value) *value = NULL;
+    return SL_E_VALUE_NOT_FOUND;
+}
+
+HRESULT WINAPI SLFreeApplicationPolicies(HSLP policy)
+{
+    TRACE("(%p)\n", policy);
+    return S_OK;
+}
+
