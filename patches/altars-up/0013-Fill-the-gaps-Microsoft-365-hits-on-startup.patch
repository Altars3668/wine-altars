+ *
+ * Wine's filesystems carry no 8.3 alias to set. On Windows this needs
+ * SE_RESTORE_NAME and fails for an ordinary caller too, so refuse the same way
+ * rather than claiming success: a caller that checks gets a truthful answer,
+ * and one that only delay-imports the symbol gets to keep running.
+ */
+BOOL WINAPI SetFileShortNameW( HANDLE handle, const WCHAR *short_name )
+{
+    FIXME( "(%p, %s): stub\n", handle, debugstr_w(short_name) );
+    SetLastError( ERROR_PRIVILEGE_NOT_HELD );
+    return FALSE;
+}
+
