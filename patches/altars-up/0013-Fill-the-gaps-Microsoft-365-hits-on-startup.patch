 }
 
 static const struct IAnalyticsInfoStaticsVtbl statics_vtbl =
@@ -257,10 +268,59 @@ static const struct IAnalyticsInfoStaticsVtbl statics_vtbl =
     statics_get_DeviceForm,
 };
 
+DEFINE_IINSPECTABLE( statics2, IAnalyticsInfoStatics2, struct analytics_info_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI statics2_GetSystemPropertiesAsync( IAnalyticsInfoStatics2 *iface, IIterable_HSTRING *attribute_names,
+                                                         IAsyncOperation_IMapView_HSTRING_HSTRING **operation )
+{
+    TRACE( "iface %p, attribute_names %p, operation %p.\n", iface, attribute_names, operation );
+
+    if (!operation) return E_POINTER;
+
+    if (TRACE_ON(twinapi) && attribute_names)
+    {
+        IIterator_HSTRING *iter;
+        boolean has_current;
+        HRESULT hr;
+
+        if (SUCCEEDED(IIterable_HSTRING_First( attribute_names, &iter )))
+        {
+            hr = IIterator_HSTRING_get_HasCurrent( iter, &has_current );
+            while (SUCCEEDED(hr) && has_current)
+            {
+                HSTRING str = NULL;
+                if (SUCCEEDED(IIterator_HSTRING_get_Current( iter, &str )))
+                {
+                    TRACE( "  attribute %s\n", debugstr_hstring( str ) );
+                    WindowsDeleteString( str );
+                }
+                hr = IIterator_HSTRING_MoveNext( iter, &has_current );
+            }
+            IIterator_HSTRING_Release( iter );
+        }
+    }
+
+    return system_properties_async_create( operation );
+}
+
+static const struct IAnalyticsInfoStatics2Vtbl statics2_vtbl =
+{
+    statics2_QueryInterface,
+    statics2_AddRef,
+    statics2_Release,
+    /* IInspectable methods */
+    statics2_GetIids,
+    statics2_GetRuntimeClassName,
+    statics2_GetTrustLevel,
+    /* IAnalyticsInfoStatics2 methods */
+    statics2_GetSystemPropertiesAsync,
+};
+
 static struct analytics_info_factory factory =
 {
     {&activation_factory_vtbl},
     {&statics_vtbl},
+    {&statics2_vtbl},
     1,
 };
 
