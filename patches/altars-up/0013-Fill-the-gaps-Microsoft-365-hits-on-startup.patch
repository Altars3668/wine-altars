+/***********************************************************************
+ *           OOBEComplete   (KERNEL32.@)
+ *
+ * Whether the out-of-box experience has finished. A Wine prefix is never in
+ * OOBE -- there is no first-run wizard to be part-way through -- so the answer
+ * is always yes. Office asks before deciding whether it may show UI.
+ */
+BOOL WINAPI OOBEComplete( BOOL *is_complete )
+{
+    TRACE( "%p\n", is_complete );
+
+    if (!is_complete)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    *is_complete = TRUE;
+    return TRUE;
+}
