+    if (effect->prepared && (dpi_x != effect->dpi_x || dpi_y != effect->dpi_y))
+        effect->change = max(effect->change, D2D1_CHANGE_TYPE_CONTEXT);
+
+    if (!effect->prepared || effect->change != D2D1_CHANGE_TYPE_NONE)
+    {
+        if (FAILED(hr = ID2D1EffectImpl_PrepareForRender(effect->impl, effect->change)))
+            return hr;
+        effect->prepared = TRUE;
+        effect->change = D2D1_CHANGE_TYPE_NONE;
+        effect->dpi_x = dpi_x;
+        effect->dpi_y = dpi_y;
+    }
+
+    return d2d_effect_transform_graph_initialize_nodes(effect->graph);
+}
+
 HRESULT d2d_effect_create(struct d2d_device_context *context, const CLSID *effect_id,
         ID2D1Effect **effect)
 {
diff --git a/dlls/d2d1/effect_render.c b/dlls/d2d1/effect_render.c
new file mode 100644
index 00000000000..9be0b19d471
--- /dev/null
+++ b/dlls/d2d1/effect_render.c
@@ -0,0 +1,1185 @@
+/*
+ * Rendering Direct2D effect graphs
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+/* As on Windows, an effect is a graph of transforms, and each transform houses the shaders run for every pixel
+ * it puts out; the effects of our own and those of applications are drawn the same way.  The graph is worked
+ * through from the output back: a transform says which part of each input it needs for the part of its output
+ * wanted, those parts are drawn into intermediate textures first, and then its pixel shader draws. */
+
+#include "d2d1_private.h"
+#include <d3dcompiler.h>
+
+WINE_DEFAULT_DEBUG_CHANNEL(d2d);
+
+#define D2D_EFFECT_MAX_INPUTS 8
+/* how deep effects may be nested in one another, and transforms chained in one graph */
+#define D2D_EFFECT_MAX_DEPTH 32
+#define D2D_EFFECT_MAX_NODE_DEPTH 1024
+
+/* What a transform is handed for each pixel: its position in the effect's space, SCENE_POSITION, and for each input
+ * where to sample it, TEXCOORDn, with the size of one pixel of the effect's space in that input's texture
+ * coordinates, the way the pixel shaders of custom effects expect them. */
+static const char d2d_effect_vs_code[] =
+    "cbuffer effect_vs_cb : register(b0)\n"
+    "{\n"
+    "    float4 dst;\n"
+    "    float4 quad;\n"
+    "    float4 src[8];\n"
+    "};\n"
+    "\n"
+    "struct vs_out\n"
+    "{\n"
+    "    float4 position : SV_POSITION;\n"
+    "    float4 scene : SCENE_POSITION;\n"
+    "    float4 uv0 : TEXCOORD0;\n"
+    "    float4 uv1 : TEXCOORD1;\n"
+    "    float4 uv2 : TEXCOORD2;\n"
+    "    float4 uv3 : TEXCOORD3;\n"
+    "    float4 uv4 : TEXCOORD4;\n"
+    "    float4 uv5 : TEXCOORD5;\n"
+    "    float4 uv6 : TEXCOORD6;\n"
+    "    float4 uv7 : TEXCOORD7;\n"
+    "};\n"
+    "\n"
+    "float4 input_uv(float4 s, float2 p)\n"
+    "{\n"
+    "    return float4((p - s.xy) * s.zw, s.zw);\n"
+    "}\n"
+    "\n"
+    "vs_out main(uint id : SV_VertexID)\n"
+    "{\n"
+    "    float2 p = float2((id & 1) ? quad.z : quad.x, (id & 2) ? quad.w : quad.y);\n"
+    "    vs_out o;\n"
+    "\n"
+    "    o.position = float4((p - dst.xy) * dst.zw + float2(-1.0f, 1.0f), 0.0f, 1.0f);\n"
+    "    o.scene = float4(p, 0.0f, 1.0f);\n"
+    "    o.uv0 = input_uv(src[0], p);\n"
+    "    o.uv1 = input_uv(src[1], p);\n"
+    "    o.uv2 = input_uv(src[2], p);\n"
+    "    o.uv3 = input_uv(src[3], p);\n"
+    "    o.uv4 = input_uv(src[4], p);\n"
+    "    o.uv5 = input_uv(src[5], p);\n"
+    "    o.uv6 = input_uv(src[6], p);\n"
+    "    o.uv7 = input_uv(src[7], p);\n"
+    "    return o;\n"
+    "}\n";
+
+/* what blend transforms and the final copy draw with */
+static const char d2d_effect_copy_ps_code[] =
+    "Texture2D t0 : register(t0);\n"
+    "SamplerState s0 : register(s0);\n"
+    "\n"
+    "float4 main(float4 position : SV_POSITION, float4 scene : SCENE_POSITION,\n"
+    "        float4 uv0 : TEXCOORD0) : SV_Target\n"
+    "{\n"
+    "    return t0.SampleLevel(s0, uv0.xy, 0.0f);\n"
+    "}\n";
+
+struct d2d_effect_vs_cb
+{
+    /* the output's top left in the effect's space, and 2 / width, -2 / height */
+    struct d2d_vec4 dst;
+    /* what is drawn, in the effect's space */
+    struct d2d_vec4 quad;
+    /* where each input is in the effect's space: its top left, and 1 / width, 1 / height */
+    struct d2d_vec4 src[D2D_EFFECT_MAX_INPUTS];
+};
+
+/* A part of an image as drawn so far.  The bitmap is stretched over rect; outside it the image is transparent, or
+ * the bitmap repeats the way the address modes say. */
+struct d2d_effect_image
+{
+    struct d2d_bitmap *bitmap;
+    D2D1_RECT_L rect;
+    enum d2d_effect_address address_x, address_y;
+};
+
+struct d2d_effect_renderer
+{
+    struct d2d_device_context *context;
+    unsigned int depth;
+    unsigned int node_depth;
+    LONG max_size;
+    /* what was drawn into, kept until the drawing is done */
+    struct d2d_bitmap **bitmaps;
+    size_t bitmaps_size;
+    size_t bitmap_count;
+};
+
+static const D2D1_FILTER d2d_effect_filters[D2D_EFFECT_FILTER_COUNT] =
+{
+    D2D1_FILTER_MIN_MAG_MIP_POINT,
+    D2D1_FILTER_MIN_MAG_POINT_MIP_LINEAR,
+    D2D1_FILTER_MIN_POINT_MAG_LINEAR_MIP_POINT,
+    D2D1_FILTER_MIN_POINT_MAG_MIP_LINEAR,
+    D2D1_FILTER_MIN_LINEAR_MAG_MIP_POINT,
+    D2D1_FILTER_MIN_LINEAR_MAG_POINT_MIP_LINEAR,
+    D2D1_FILTER_MIN_MAG_LINEAR_MIP_POINT,
+    D2D1_FILTER_MIN_MAG_MIP_LINEAR,
+    D2D1_FILTER_ANISOTROPIC,
+};
+
+static HRESULT d2d_effect_compile(const char *code, size_t size, const char *profile, ID3D10Blob **blob)
+{
+    ID3D10Blob *messages = NULL;
+    HRESULT hr;
+
+    hr = D3DCompile(code, size, profile, NULL, NULL, "main", profile, 0, 0, blob, &messages);
+    if (FAILED(hr))
+        ERR("Failed to compile a %s shader, hr %#lx, %s.\n", profile, hr,
+                messages ? debugstr_a(ID3D10Blob_GetBufferPointer(messages)) : "");
+    if (messages)
+        ID3D10Blob_Release(messages);
+    return hr;
+}
+
+static HRESULT d2d_effect_renderer_init_resources(struct d2d_device_context *context)
+{
+    ID3D11PixelShader *copy_ps = NULL;
+    ID3D11VertexShader *vs = NULL;
+    D3D11_BUFFER_DESC buffer_desc;
+    ID3D11Buffer *vs_cb = NULL;
+    ID3D10Blob *blob;
+    HRESULT hr;
+
+    if (context->effect_vs)
+        return S_OK;
+
+    if (FAILED(hr = d2d_effect_compile(d2d_effect_vs_code, sizeof(d2d_effect_vs_code) - 1, "vs_4_0", &blob)))
+        return hr;
+    hr = ID3D11Device1_CreateVertexShader(context->d3d_device, ID3D10Blob_GetBufferPointer(blob),
+            ID3D10Blob_GetBufferSize(blob), NULL, &vs);
+    ID3D10Blob_Release(blob);
+    if (FAILED(hr))
+    {
+        WARN("Failed to create the effect vertex shader, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    if (FAILED(hr = d2d_effect_compile(d2d_effect_copy_ps_code, sizeof(d2d_effect_copy_ps_code) - 1, "ps_4_0", &blob)))
+        goto fail;
+    hr = ID3D11Device1_CreatePixelShader(context->d3d_device, ID3D10Blob_GetBufferPointer(blob),
+            ID3D10Blob_GetBufferSize(blob), NULL, &copy_ps);
+    ID3D10Blob_Release(blob);
+    if (FAILED(hr))
+    {
+        WARN("Failed to create the effect copy shader, hr %#lx.\n", hr);
+        goto fail;
+    }
+
+    buffer_desc.ByteWidth = sizeof(struct d2d_effect_vs_cb);
+    buffer_desc.Usage = D3D11_USAGE_DYNAMIC;
+    buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    buffer_desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    buffer_desc.MiscFlags = 0;
+    buffer_desc.StructureByteStride = 0;
+    if (FAILED(hr = ID3D11Device1_CreateBuffer(context->d3d_device, &buffer_desc, NULL, &vs_cb)))
+    {
+        WARN("Failed to create the effect constant buffer, hr %#lx.\n", hr);
+        goto fail;
+    }
+
+    context->effect_vs = vs;
+    context->effect_copy_ps = copy_ps;
+    context->effect_vs_cb = vs_cb;
+    return S_OK;
+
+fail:
+    if (copy_ps)
+        ID3D11PixelShader_Release(copy_ps);
+    ID3D11VertexShader_Release(vs);
+    return hr;
+}
+
+void d2d_device_context_cleanup_effects(struct d2d_device_context *context)
+{
+    unsigned int i, j, k;
+
+    if (context->effect_vs)
+        ID3D11VertexShader_Release(context->effect_vs);
+    if (context->effect_copy_ps)
+        ID3D11PixelShader_Release(context->effect_copy_ps);
+    if (context->effect_vs_cb)
+        ID3D11Buffer_Release(context->effect_vs_cb);
+    for (i = 0; i < D2D_EFFECT_FILTER_COUNT; ++i)
+    {
+        for (j = 0; j < D2D_EFFECT_ADDRESS_COUNT; ++j)
+        {
+            for (k = 0; k < D2D_EFFECT_ADDRESS_COUNT; ++k)
+            {
+                if (context->effect_samplers[i][j][k])
+                    ID3D11SamplerState_Release(context->effect_samplers[i][j][k]);
+            }
+        }
+    }
+}
+
+static unsigned int d2d_effect_filter_index(D2D1_FILTER filter)
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(d2d_effect_filters); ++i)
+    {
+        if (d2d_effect_filters[i] == filter)
+            return i;
+    }
+
+    WARN("Unknown filter %#x.\n", filter);
+    return 7;
+}
+
+static ID3D11SamplerState *d2d_effect_get_sampler(struct d2d_device_context *context, D2D1_FILTER filter,
+        enum d2d_effect_address address_x, enum d2d_effect_address address_y)
+{
+    static const D3D11_TEXTURE_ADDRESS_MODE modes[] =
+    {
+        [D2D_EFFECT_ADDRESS_TRANSPARENT] = D3D11_TEXTURE_ADDRESS_BORDER,
+        [D2D_EFFECT_ADDRESS_CLAMP] = D3D11_TEXTURE_ADDRESS_CLAMP,
+        [D2D_EFFECT_ADDRESS_WRAP] = D3D11_TEXTURE_ADDRESS_WRAP,
+        [D2D_EFFECT_ADDRESS_MIRROR] = D3D11_TEXTURE_ADDRESS_MIRROR,
+    };
+    unsigned int index = d2d_effect_filter_index(filter);
+    ID3D11SamplerState **sampler = &context->effect_samplers[index][address_x][address_y];
+    D3D11_SAMPLER_DESC desc;
+    HRESULT hr;
+
+    if (*sampler)
+        return *sampler;
+
+    desc.Filter = (D3D11_FILTER)d2d_effect_filters[index];
+    desc.AddressU = modes[address_x];
+    desc.AddressV = modes[address_y];
+    desc.AddressW = D3D11_TEXTURE_ADDRESS_CLAMP;
+    desc.MipLODBias = 0.0f;
+    desc.MaxAnisotropy = d2d_effect_filters[index] == D2D1_FILTER_ANISOTROPIC ? 16 : 1;
+    desc.ComparisonFunc = D3D11_COMPARISON_NEVER;
+    desc.BorderColor[0] = 0.0f;
+    desc.BorderColor[1] = 0.0f;
+    desc.BorderColor[2] = 0.0f;
+    desc.BorderColor[3] = 0.0f;
+    desc.MinLOD = 0.0f;
+    desc.MaxLOD = D3D11_FLOAT32_MAX;
+    if (FAILED(hr = ID3D11Device1_CreateSamplerState(context->d3d_device, &desc, sampler)))
+    {
+        WARN("Failed to create a sampler state, hr %#lx.\n", hr);
+        *sampler = NULL;
+    }
+
+    return *sampler;
+}
+
+static void d2d_effect_renderer_init(struct d2d_effect_renderer *renderer, struct d2d_device_context *context)
+{
+    memset(renderer, 0, sizeof(*renderer));
+    renderer->context = context;
+    renderer->max_size = ID3D11Device1_GetFeatureLevel(context->d3d_device) >= D3D_FEATURE_LEVEL_11_0
+            ? D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION : D3D10_REQ_TEXTURE2D_U_OR_V_DIMENSION;
+}
+
+static void d2d_effect_renderer_cleanup(struct d2d_effect_renderer *renderer)
+{
+    size_t i;
+
+    for (i = 0; i < renderer->bitmap_count; ++i)
+        ID2D1Bitmap1_Release(&renderer->bitmaps[i]->ID2D1Bitmap1_iface);
+    free(renderer->bitmaps);
+}
+
+static HRESULT d2d_effect_renderer_hold(struct d2d_effect_renderer *renderer, struct d2d_bitmap *bitmap)
+{
+    if (!d2d_array_reserve((void **)&renderer->bitmaps, &renderer->bitmaps_size,
+            renderer->bitmap_count + 1, sizeof(*renderer->bitmaps)))
+        return E_OUTOFMEMORY;
+
+    ID2D1Bitmap1_AddRef(&bitmap->ID2D1Bitmap1_iface);
+    renderer->bitmaps[renderer->bitmap_count++] = bitmap;
+    return S_OK;
+}
+
+/* An intermediate texture for the part rect of the effect's space, one pixel for each of its pixels. */
+static HRESULT d2d_effect_renderer_create_bitmap(struct d2d_effect_renderer *renderer, const D2D1_RECT_L *rect,
+        struct d2d_bitmap **bitmap)
+{
+    D2D1_BITMAP_PROPERTIES1 desc;
+    struct d2d_bitmap *object;
+    D2D1_SIZE_U size;
+    HRESULT hr;
+
+    if (d2d_rect_l_is_infinite(rect) || (LONGLONG)rect->right - rect->left > renderer->max_size
+            || (LONGLONG)rect->bottom - rect->top > renderer->max_size)
+    {
+        FIXME("Not drawing %s, it is too large.\n", debug_d2d_rect_l(rect));
+        return D2DERR_MAX_TEXTURE_SIZE_EXCEEDED;
+    }
+
+    size.width = rect->right - rect->left;
+    size.height = rect->bottom - rect->top;
+    desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    desc.dpiX = 96.0f;
+    desc.dpiY = 96.0f;
+    desc.bitmapOptions = D2D1_BITMAP_OPTIONS_TARGET;
+    desc.colorContext = NULL;
+    if (FAILED(hr = d2d_bitmap_create(renderer->context, size, NULL, 0, &desc, &object)))
+    {
+        WARN("Failed to create an intermediate bitmap, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    hr = d2d_effect_renderer_hold(renderer, object);
+    ID2D1Bitmap1_Release(&object->ID2D1Bitmap1_iface);
+    if (SUCCEEDED(hr))
+        *bitmap = object;
+    return hr;
+}
+
+/* Draws the part quad of the effect's space into output, which holds output_rect of it. */
+static HRESULT d2d_effect_renderer_draw(struct d2d_effect_renderer *renderer, ID3D11PixelShader *ps,
+        ID3D11Buffer *ps_cb, const struct d2d_effect_image *inputs, const D2D1_FILTER *filters,
+        unsigned int input_count, struct d2d_bitmap *output, const D2D1_RECT_L *output_rect,
+        const D2D1_RECT_L *quad, ID3D11BlendState *blend_state, const float *blend_factor, BOOL clear)
+{
+    static const float transparent[4];
+    ID3D11ShaderResourceView *srvs[D2D_EFFECT_MAX_INPUTS] = {0}, *no_srvs[D2D_EFFECT_MAX_INPUTS] = {0};
+    ID3D11SamplerState *samplers[D2D_EFFECT_MAX_INPUTS] = {0};
+    struct d2d_device_context *context = renderer->context;
+    ID3DDeviceContextState *prev_state;
+    ID3D11DeviceContext1 *d3d_context;
+    D3D11_MAPPED_SUBRESOURCE map;
+    struct d2d_effect_vs_cb *cb;
+    D3D11_RECT scissor_rect;
+    D3D11_VIEWPORT vp;
+    unsigned int i;
+    HRESULT hr;
+
+    for (i = 0; i < input_count; ++i)
+    {
+        if (inputs[i].bitmap)
+            srvs[i] = inputs[i].bitmap->srv;
+        if (!(samplers[i] = d2d_effect_get_sampler(context, filters[i], inputs[i].address_x, inputs[i].address_y)))
+            return E_FAIL;
+    }
+
+    vp.TopLeftX = 0.0f;
+    vp.TopLeftY = 0.0f;
+    vp.Width = output->pixel_size.width;
+    vp.Height = output->pixel_size.height;
+    vp.MinDepth = 0.0f;
+    vp.MaxDepth = 1.0f;
+    scissor_rect.left = 0;
+    scissor_rect.top = 0;
+    scissor_rect.right = output->pixel_size.width;
+    scissor_rect.bottom = output->pixel_size.height;
+
+    if (context->cs)
+        EnterCriticalSection(context->cs);
+
+    ID3D11Device1_GetImmediateContext1(context->d3d_device, &d3d_context);
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, context->d3d_state, &prev_state);
+
+    if (FAILED(hr = ID3D11DeviceContext1_Map(d3d_context, (ID3D11Resource *)context->effect_vs_cb,
+            0, D3D11_MAP_WRITE_DISCARD, 0, &map)))
+    {
+        WARN("Failed to map the effect constant buffer, hr %#lx.\n", hr);
+        goto done;
+    }
+    cb = map.pData;
+    memset(cb, 0, sizeof(*cb));
+    cb->dst.x = output_rect->left;
+    cb->dst.y = output_rect->top;
+    cb->dst.z = 2.0f / output->pixel_size.width;
+    cb->dst.w = -2.0f / output->pixel_size.height;
+    cb->quad.x = quad->left;
+    cb->quad.y = quad->top;
+    cb->quad.z = quad->right;
+    cb->quad.w = quad->bottom;
+    for (i = 0; i < input_count; ++i)
+    {
+        if (!inputs[i].bitmap)
+            continue;
+        cb->src[i].x = inputs[i].rect.left;
+        cb->src[i].y = inputs[i].rect.top;
+        cb->src[i].z = 1.0f / (inputs[i].rect.right - inputs[i].rect.left);
+        cb->src[i].w = 1.0f / (inputs[i].rect.bottom - inputs[i].rect.top);
+    }
+    ID3D11DeviceContext1_Unmap(d3d_context, (ID3D11Resource *)context->effect_vs_cb, 0);
+
+    if (clear)
+        ID3D11DeviceContext1_ClearRenderTargetView(d3d_context, output->rtv, transparent);
+
+    /* An input may still be bound for output, the last time something drew into it, and a view bound for
+     * output is not read from: the output goes first. */
+    ID3D11DeviceContext1_OMSetRenderTargets(d3d_context, 1, &output->rtv, NULL);
+    ID3D11DeviceContext1_OMSetBlendState(d3d_context, blend_state, blend_factor, D3D11_DEFAULT_SAMPLE_MASK);
+    ID3D11DeviceContext1_IASetInputLayout(d3d_context, NULL);
+    ID3D11DeviceContext1_IASetPrimitiveTopology(d3d_context, D3D11_PRIMITIVE_TOPOLOGY_TRIANGLESTRIP);
+    ID3D11DeviceContext1_VSSetShader(d3d_context, context->effect_vs, NULL, 0);
+    ID3D11DeviceContext1_VSSetConstantBuffers(d3d_context, 0, 1, &context->effect_vs_cb);
+    ID3D11DeviceContext1_PSSetShader(d3d_context, ps, NULL, 0);
+    ID3D11DeviceContext1_PSSetConstantBuffers(d3d_context, 0, 1, &ps_cb);
+    ID3D11DeviceContext1_PSSetShaderResources(d3d_context, 0, D2D_EFFECT_MAX_INPUTS, srvs);
+    ID3D11DeviceContext1_PSSetSamplers(d3d_context, 0, D2D_EFFECT_MAX_INPUTS, samplers);
+    ID3D11DeviceContext1_RSSetViewports(d3d_context, 1, &vp);
+    ID3D11DeviceContext1_RSSetScissorRects(d3d_context, 1, &scissor_rect);
+    ID3D11DeviceContext1_RSSetState(d3d_context, context->rs);
+    ID3D11DeviceContext1_Draw(d3d_context, 4, 0);
+
+    /* what the next draw reads may be what this one wrote */
+    ID3D11DeviceContext1_PSSetShaderResources(d3d_context, 0, D2D_EFFECT_MAX_INPUTS, no_srvs);
+    ID3D11DeviceContext1_OMSetRenderTargets(d3d_context, 0, NULL, NULL);
+
+done:
+    ID3D11DeviceContext1_SwapDeviceContextState(d3d_context, prev_state, NULL);
+    ID3DDeviceContextState_Release(prev_state);
+    ID3D11DeviceContext1_Release(d3d_context);
+
+    if (context->cs)
+        LeaveCriticalSection(context->cs);
+
+    return hr;
+}
+
+/* In the effect's space a bitmap takes the size it has in DIPs, at the DPI of the context. */
+static void d2d_effect_bitmap_rect(const struct d2d_device_context *context, const struct d2d_bitmap *bitmap,
+        D2D1_RECT_L *rect)
+{
+    d2d_rect_l_set(rect, 0, 0, lroundf(bitmap->pixel_size.width * context->desc.dpiX / bitmap->dpi_x),
+            lroundf(bitmap->pixel_size.height * context->desc.dpiY / bitmap->dpi_y));
+}
+
+static HRESULT d2d_effect_renderer_effect_bounds(struct d2d_effect_renderer *renderer,
+        struct d2d_effect *effect, D2D1_RECT_L *bounds);
+static HRESULT d2d_effect_renderer_render_effect(struct d2d_effect_renderer *renderer,
+        struct d2d_effect *effect, const D2D1_RECT_L *rect, struct d2d_effect_image *image);
+
+static HRESULT d2d_effect_renderer_image_bounds(struct d2d_effect_renderer *renderer, ID2D1Image *image,
+        D2D1_RECT_L *bounds)
+{
+    struct d2d_effect *effect;
+    ID2D1CommandList *list;
+    ID2D1Bitmap *bitmap;
+
+    if (!image)
+    {
+        d2d_rect_l_set(bounds, 0, 0, 0, 0);
+        return S_OK;
+    }
+
+    if ((effect = unsafe_impl_from_effect_ID2D1Image(image)))
+        return d2d_effect_renderer_effect_bounds(renderer, effect, bounds);
+
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Bitmap, (void **)&bitmap)))
+    {
+        d2d_effect_bitmap_rect(renderer->context, unsafe_impl_from_ID2D1Bitmap(bitmap), bounds);
+        ID2D1Bitmap_Release(bitmap);
+        return S_OK;
+    }
+
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1CommandList, (void **)&list)))
+    {
+        /* what it draws is taken to be everywhere, as far as it is asked for */
+        ID2D1CommandList_Release(list);
+        d2d_rect_l_set_infinite(bounds);
+        return S_OK;
+    }
+
+    FIXME("Unhandled image %p.\n", image);
+    d2d_rect_l_set(bounds, 0, 0, 0, 0);
+    return S_OK;
+}
+
+/* What feeds an input of a node, when no node does: an input of the effect, if any. */
+static ID2D1Image *d2d_effect_node_effect_input(const struct d2d_effect *effect,
+        const struct d2d_transform_node *node, unsigned int index)
+{
+    const struct d2d_transform_graph *graph = effect->graph;
+    unsigned int i;
+
+    for (i = 0; i < graph->input_count; ++i)
+    {
+        if (graph->inputs[i].node == node && graph->inputs[i].index == index)
+            return i < effect->input_count ? effect->inputs[i] : NULL;
+    }
+
+    return NULL;
+}
+
+static HRESULT d2d_effect_renderer_node_bounds(struct d2d_effect_renderer *renderer, struct d2d_effect *effect,
+        struct d2d_transform_node *node, D2D1_RECT_L *bounds);
+
+static HRESULT d2d_effect_renderer_node_input_bounds(struct d2d_effect_renderer *renderer,
+        struct d2d_effect *effect, struct d2d_transform_node *node, unsigned int index, D2D1_RECT_L *bounds)
+{
+    if (node->inputs[index])
+        return d2d_effect_renderer_node_bounds(renderer, effect, node->inputs[index], bounds);
+    return d2d_effect_renderer_image_bounds(renderer, d2d_effect_node_effect_input(effect, node, index), bounds);
+}
+
+static HRESULT d2d_effect_renderer_node_bounds(struct d2d_effect_renderer *renderer, struct d2d_effect *effect,
+        struct d2d_transform_node *node, D2D1_RECT_L *bounds)
+{
+    D2D1_RECT_L inputs[D2D_EFFECT_MAX_INPUTS], opaque[D2D_EFFECT_MAX_INPUTS], opaque_output;
+    ID2D1BoundsAdjustmentTransform *adjustment;
+    ID2D1OffsetTransform *offset_transform;
+    ID2D1BorderTransform *border;
+    ID2D1Transform *transform;
+    ID2D1BlendTransform *blend;
+    D2D1_POINT_2L offset;
+    unsigned int i;
+    HRESULT hr;
+
+    if (node->input_count > D2D_EFFECT_MAX_INPUTS)
+    {
+        FIXME("Transform %p has %u inputs.\n", node->object, node->input_count);
+        return E_NOTIMPL;
+    }
+    if (renderer->node_depth >= D2D_EFFECT_MAX_NODE_DEPTH)
+    {
+        WARN("The transform graph of effect %p has a cycle.\n", effect);
+        return D2DERR_CYCLIC_GRAPH;
+    }
+
+    ++renderer->node_depth;
+    for (i = 0, hr = S_OK; i < node->input_count && SUCCEEDED(hr); ++i)
+        hr = d2d_effect_renderer_node_input_bounds(renderer, effect, node, i, &inputs[i]);
+    --renderer->node_depth;
+    if (FAILED(hr))
+        return hr;
+
+    if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1OffsetTransform,
+            (void **)&offset_transform)))
+    {
+        offset = ID2D1OffsetTransform_GetOffset(offset_transform);
+        ID2D1OffsetTransform_Release(offset_transform);
+        *bounds = inputs[0];
+        if (!d2d_rect_l_is_empty(bounds))
+            d2d_rect_l_offset(bounds, offset.x, offset.y);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BoundsAdjustmentTransform,
+            (void **)&adjustment)))
+    {
+        ID2D1BoundsAdjustmentTransform_GetOutputBounds(adjustment, bounds);
+        ID2D1BoundsAdjustmentTransform_Release(adjustment);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BorderTransform,
+            (void **)&border)))
+    {
+        ID2D1BorderTransform_Release(border);
+        *bounds = inputs[0];
+        if (!d2d_rect_l_is_empty(bounds))
+            d2d_rect_l_set_infinite(bounds);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BlendTransform,
+            (void **)&blend)))
+    {
+        ID2D1BlendTransform_Release(blend);
+        d2d_rect_l_set(bounds, 0, 0, 0, 0);
+        for (i = 0; i < node->input_count; ++i)
+            d2d_rect_l_union(bounds, &inputs[i]);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1Transform, (void **)&transform)))
+    {
+        memset(opaque, 0, sizeof(opaque));
+        hr = ID2D1Transform_MapInputRectsToOutputRect(transform, inputs, opaque, node->input_count,
+                bounds, &opaque_output);
+        ID2D1Transform_Release(transform);
+        if (FAILED(hr))
+        {
+            WARN("Failed to map the input rectangles of transform %p, hr %#lx.\n", node->object, hr);
+            return hr;
+        }
+        if (d2d_rect_l_is_empty(bounds))
+            d2d_rect_l_set(bounds, 0, 0, 0, 0);
+    }
+    else
+    {
+        FIXME("Unhandled transform %p.\n", node->object);
+        return E_NOTIMPL;
+    }
+
+    node->bounds = *bounds;
+    return S_OK;
+}
+
+static HRESULT d2d_effect_renderer_effect_bounds(struct d2d_effect_renderer *renderer,
+        struct d2d_effect *effect, D2D1_RECT_L *bounds)
+{
+    struct d2d_transform_graph *graph;
+    HRESULT hr;
+
+    if (renderer->depth >= D2D_EFFECT_MAX_DEPTH)
+    {
+        WARN("Effect %p is nested too deep, or in itself.\n", effect);
+        return D2DERR_CYCLIC_GRAPH;
+    }
+
+    if (FAILED(hr = d2d_effect_prepare(effect)))
+    {
+        WARN("Failed to prepare effect %p, hr %#lx.\n", effect, hr);
+        return hr;
+    }
+
+    graph = effect->graph;
+    ++renderer->depth;
+    if (graph->passthrough)
+    {
+        hr = d2d_effect_renderer_image_bounds(renderer, graph->passthrough_input < effect->input_count
+                ? effect->inputs[graph->passthrough_input] : NULL, bounds);
+    }
+    else if (graph->output)
+    {
+        hr = d2d_effect_renderer_node_bounds(renderer, effect, graph->output, bounds);
+    }
+    else
+    {
+        FIXME("Effect %p has no transform graph, it is not drawn.\n", effect);
+        hr = E_NOTIMPL;
+    }
+    --renderer->depth;
+
+    return hr;
+}
+
+static HRESULT d2d_effect_renderer_render_node(struct d2d_effect_renderer *renderer, struct d2d_effect *effect,
+        struct d2d_transform_node *node, const D2D1_RECT_L *rect, struct d2d_effect_image *image);
+
+static HRESULT d2d_effect_renderer_render_image(struct d2d_effect_renderer *renderer, ID2D1Image *image,
+        const D2D1_RECT_L *rect, struct d2d_effect_image *out)
+{
+    struct d2d_device_context *context = renderer->context;
+    D2D1_MATRIX_3X2_F transform;
+    struct d2d_bitmap *bitmap;
+    struct d2d_effect *effect;
+    ID2D1CommandList *list;
+    ID2D1Bitmap *iface;
+    HRESULT hr;
+
+    memset(out, 0, sizeof(*out));
+    if (!image || d2d_rect_l_is_empty(rect))
+        return S_OK;
+
+    if ((effect = unsafe_impl_from_effect_ID2D1Image(image)))
+        return d2d_effect_renderer_render_effect(renderer, effect, rect, out);
+
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Bitmap, (void **)&iface)))
+    {
+        bitmap = unsafe_impl_from_ID2D1Bitmap(iface);
+        if (bitmap->srv)
+        {
+            if (SUCCEEDED(hr = d2d_effect_renderer_hold(renderer, bitmap)))
+            {
+                out->bitmap = bitmap;
+                d2d_effect_bitmap_rect(context, bitmap, &out->rect);
+            }
+        }
+        else
+        {
+            WARN("Bitmap %p cannot be drawn.\n", iface);
+            hr = D2DERR_BITMAP_CANNOT_DRAW;
+        }
+        ID2D1Bitmap_Release(iface);
+        return hr;
+    }
+
+    if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1CommandList, (void **)&list)))
+    {
+        if (SUCCEEDED(hr = d2d_effect_renderer_create_bitmap(renderer, rect, &bitmap)))
+        {
+            /* from DIPs to the pixels of the bitmap */
+            transform._11 = context->desc.dpiX / 96.0f;
+            transform._12 = 0.0f;
+            transform._21 = 0.0f;
+            transform._22 = context->desc.dpiY / 96.0f;
+            transform._31 = -rect->left;
+            transform._32 = -rect->top;
+            if (SUCCEEDED(hr = d2d_device_context_draw_command_list_to_bitmap(context, list, bitmap, &transform)))
+            {
+                out->bitmap = bitmap;
+                out->rect = *rect;
+            }
+        }
+        ID2D1CommandList_Release(list);
+        return hr;
+    }
+
+    FIXME("Unhandled image %p.\n", image);
+    return S_OK;
+}
+
+static HRESULT d2d_effect_renderer_render_node_input(struct d2d_effect_renderer *renderer,
+        struct d2d_effect *effect, struct d2d_transform_node *node, unsigned int index, const D2D1_RECT_L *rect,
+        struct d2d_effect_image *image)
+{
+    if (node->inputs[index])
+        return d2d_effect_renderer_render_node(renderer, effect, node->inputs[index], rect, image);
+    return d2d_effect_renderer_render_image(renderer, d2d_effect_node_effect_input(effect, node, index), rect, image);
+}
+
+static HRESULT d2d_effect_renderer_update_constants(struct d2d_effect_renderer *renderer,
+        struct d2d_render_info *render_info)
+{
+    D3D11_SUBRESOURCE_DATA buffer_data;
+    D3D11_BUFFER_DESC buffer_desc;
+    BYTE *data;
+    HRESULT hr;
+
+    if (!render_info->ps_cb_dirty)
+        return S_OK;
+
+    if (render_info->ps_cb)
+    {
+        ID3D11Buffer_Release(render_info->ps_cb);
+        render_info->ps_cb = NULL;
+    }
+    render_info->ps_cb_size = 0;
+    render_info->ps_cb_dirty = FALSE;
+    if (!render_info->ps_constants_size)
+        return S_OK;
+
+    /* constant buffers come in whole registers */
+    buffer_desc.ByteWidth = (render_info->ps_constants_size + 15) & ~15u;
+    buffer_desc.Usage = D3D11_USAGE_DEFAULT;
+    buffer_desc.BindFlags = D3D11_BIND_CONSTANT_BUFFER;
+    buffer_desc.CPUAccessFlags = 0;
+    buffer_desc.MiscFlags = 0;
+    buffer_desc.StructureByteStride = 0;
+    if (!(data = calloc(1, buffer_desc.ByteWidth)))
+        return E_OUTOFMEMORY;
+    memcpy(data, render_info->ps_constants, render_info->ps_constants_size);
+    buffer_data.pSysMem = data;
+    buffer_data.SysMemPitch = 0;
+    buffer_data.SysMemSlicePitch = 0;
+    hr = ID3D11Device1_CreateBuffer(renderer->context->d3d_device, &buffer_desc, &buffer_data, &render_info->ps_cb);
+    free(data);
+    if (FAILED(hr))
+    {
+        WARN("Failed to create a constant buffer, hr %#lx.\n", hr);
+        render_info->ps_cb = NULL;
+        render_info->ps_cb_dirty = TRUE;
+        return hr;
+    }
+    render_info->ps_cb_size = buffer_desc.ByteWidth;
+
+    return S_OK;
+}
+
+static HRESULT d2d_effect_renderer_render_draw(struct d2d_effect_renderer *renderer, struct d2d_effect *effect,
+        struct d2d_transform_node *node, ID2D1DrawTransform *transform, const D2D1_RECT_L *rect,
+        struct d2d_effect_image *out)
+{
+    struct d2d_effect_image inputs[D2D_EFFECT_MAX_INPUTS];
+    struct d2d_render_info *render_info = node->render_info;
+    D2D1_RECT_L input_rects[D2D_EFFECT_MAX_INPUTS];
+    D2D1_FILTER filters[D2D_EFFECT_MAX_INPUTS];
+    struct d2d_device *device = renderer->context->device;
+    ID3D11PixelShader *ps = NULL;
+    struct d2d_bitmap *output;
+    unsigned int i, count;
+    IUnknown *shader;
+    HRESULT hr;
+
+    if (!render_info || !(render_info->mask & D2D_RENDER_INFO_PIXEL_SHADER))
+    {
+        FIXME("Draw transform %p has no pixel shader.\n", transform);
+        return S_OK;
+    }
+
+    count = node->input_count;
+    memset(input_rects, 0, sizeof(input_rects));
+    if (FAILED(hr = ID2D1DrawTransform_MapOutputRectToInputRects(transform, rect, input_rects, count)))
+    {
+        WARN("Failed to map the output rectangle of transform %p, hr %#lx.\n", transform, hr);
+        return hr;
+    }
+
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(hr = d2d_effect_renderer_render_node_input(renderer, effect, node, i, &input_rects[i], &inputs[i])))
+            return hr;
+        filters[i] = render_info->inputs[i].description.filter;
+        if (render_info->inputs[i].address != D2D_EFFECT_ADDRESS_TRANSPARENT
+                && inputs[i].address_x == D2D_EFFECT_ADDRESS_TRANSPARENT
+                && inputs[i].address_y == D2D_EFFECT_ADDRESS_TRANSPARENT)
+            inputs[i].address_x = inputs[i].address_y = render_info->inputs[i].address;
+    }
+
+    if (!d2d_device_get_indexed_object(&device->shaders, &render_info->pixel_shader, &shader))
+    {
+        WARN("Pixel shader %s was never loaded.\n", debugstr_guid(&render_info->pixel_shader));
+        return D2DERR_INVALID_GRAPH_CONFIGURATION;
+    }
+    hr = IUnknown_QueryInterface(shader, &IID_ID3D11PixelShader, (void **)&ps);
+    IUnknown_Release(shader);
+    if (FAILED(hr))
+    {
+        WARN("Shader %s is not a pixel shader.\n", debugstr_guid(&render_info->pixel_shader));
+        return D2DERR_INVALID_GRAPH_CONFIGURATION;
+    }
+
+    if (SUCCEEDED(hr = d2d_effect_renderer_update_constants(renderer, render_info))
+            && SUCCEEDED(hr = d2d_effect_renderer_create_bitmap(renderer, rect, &output))
+            && SUCCEEDED(hr = d2d_effect_renderer_draw(renderer, ps, render_info->ps_cb, inputs, filters, count,
+            output, rect, rect, NULL, NULL, TRUE)))
+    {
+        out->bitmap = output;
+        out->rect = *rect;
+    }
+    ID3D11PixelShader_Release(ps);
+
+    return hr;
+}
+
+/* Each input is drawn over the whole output in turn, the first as it is and the others blended with it. */
+static HRESULT d2d_effect_renderer_render_blend(struct d2d_effect_renderer *renderer, struct d2d_effect *effect,
+        struct d2d_transform_node *node, ID2D1BlendTransform *transform, const D2D1_RECT_L *rect,
+        struct d2d_effect_image *out)
+{
+    D2D1_FILTER filter = D2D1_FILTER_MIN_MAG_MIP_LINEAR;
+    struct d2d_effect_image input;
+    ID3D11BlendState *blend_state;
+    D2D1_BLEND_DESCRIPTION desc;
+    D3D11_BLEND_DESC blend_desc;
+    struct d2d_bitmap *output;
+    unsigned int i;
+    HRESULT hr;
+
+    ID2D1BlendTransform_GetDescription(transform, &desc);
+    memset(&blend_desc, 0, sizeof(blend_desc));
+    blend_desc.RenderTarget[0].BlendEnable = TRUE;
+    blend_desc.RenderTarget[0].SrcBlend = (D3D11_BLEND)desc.sourceBlend;
+    blend_desc.RenderTarget[0].DestBlend = (D3D11_BLEND)desc.destinationBlend;
+    blend_desc.RenderTarget[0].BlendOp = (D3D11_BLEND_OP)desc.blendOperation;
+    blend_desc.RenderTarget[0].SrcBlendAlpha = (D3D11_BLEND)desc.sourceBlendAlpha;
+    blend_desc.RenderTarget[0].DestBlendAlpha = (D3D11_BLEND)desc.destinationBlendAlpha;
+    blend_desc.RenderTarget[0].BlendOpAlpha = (D3D11_BLEND_OP)desc.blendOperationAlpha;
+    blend_desc.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+    if (FAILED(hr = ID3D11Device1_CreateBlendState(renderer->context->d3d_device, &blend_desc, &blend_state)))
+    {
+        WARN("Failed to create the blend state of transform %p, hr %#lx.\n", transform, hr);
+        return hr;
+    }
+
+    if (FAILED(hr = d2d_effect_renderer_create_bitmap(renderer, rect, &output)))
+        goto done;
+
+    for (i = 0; i < node->input_count; ++i)
+    {
+        if (FAILED(hr = d2d_effect_renderer_render_node_input(renderer, effect, node, i, rect, &input)))
+            goto done;
+        if (FAILED(hr = d2d_effect_renderer_draw(renderer, renderer->context->effect_copy_ps, NULL, &input, &filter,
+                1, output, rect, rect, i ? blend_state : NULL, desc.blendFactor, !i)))
+            goto done;
+    }
+
+    out->bitmap = output;
+    out->rect = *rect;
+
+done:
+    ID3D11BlendState_Release(blend_state);
+    return hr;
+}
+
+static enum d2d_effect_address d2d_effect_address_from_extend_mode(D2D1_EXTEND_MODE mode)
+{
+    switch (mode)
+    {
+        case D2D1_EXTEND_MODE_CLAMP:
+            return D2D_EFFECT_ADDRESS_CLAMP;
+        case D2D1_EXTEND_MODE_WRAP:
+            return D2D_EFFECT_ADDRESS_WRAP;
+        case D2D1_EXTEND_MODE_MIRROR:
+            return D2D_EFFECT_ADDRESS_MIRROR;
+        default:
+            WARN("Unknown extend mode %#x.\n", mode);
+            return D2D_EFFECT_ADDRESS_CLAMP;
+    }
+}
+
+/* Draws the part rect of what node puts out; image gets no more of it than there is. */
+static HRESULT d2d_effect_renderer_render_node(struct d2d_effect_renderer *renderer, struct d2d_effect *effect,
+        struct d2d_transform_node *node, const D2D1_RECT_L *rect, struct d2d_effect_image *image)
+{
+    ID2D1OffsetTransform *offset_transform;
+    ID2D1BoundsAdjustmentTransform *adjust;
+    D2D1_RECT_L r = *rect, input_bounds;
+    ID2D1DrawTransform *draw_transform;
+    ID2D1BorderTransform *border;
+    ID2D1BlendTransform *blend;
+    D2D1_POINT_2L offset;
+    HRESULT hr = S_OK;
+
+    memset(image, 0, sizeof(*image));
+    d2d_rect_l_intersect(&r, &node->bounds);
+    if (d2d_rect_l_is_empty(&r))
+        return S_OK;
+
+    if (renderer->node_depth >= D2D_EFFECT_MAX_NODE_DEPTH)
+        return D2DERR_CYCLIC_GRAPH;
+    ++renderer->node_depth;
+
+    if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1OffsetTransform,
+            (void **)&offset_transform)))
+    {
+        offset = ID2D1OffsetTransform_GetOffset(offset_transform);
+        ID2D1OffsetTransform_Release(offset_transform);
+        d2d_rect_l_offset(&r, -offset.x, -offset.y);
+        if (SUCCEEDED(hr = d2d_effect_renderer_render_node_input(renderer, effect, node, 0, &r, image))
+                && image->bitmap)
+            d2d_rect_l_offset(&image->rect, offset.x, offset.y);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BoundsAdjustmentTransform,
+            (void **)&adjust)))
+    {
+        ID2D1BoundsAdjustmentTransform_Release(adjust);
+        hr = d2d_effect_renderer_render_node_input(renderer, effect, node, 0, &r, image);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BorderTransform,
+            (void **)&border)))
+    {
+        /* all of the input, for it to be repeated from its edges */
+        if (SUCCEEDED(hr = d2d_effect_renderer_node_input_bounds(renderer, effect, node, 0, &input_bounds)))
+        {
+            if (d2d_rect_l_is_infinite(&input_bounds))
+            {
+                hr = d2d_effect_renderer_render_node_input(renderer, effect, node, 0, &r, image);
+            }
+            else if (SUCCEEDED(hr = d2d_effect_renderer_render_node_input(renderer, effect, node, 0,
+                    &input_bounds, image)) && image->bitmap)
+            {
+                image->address_x = d2d_effect_address_from_extend_mode(ID2D1BorderTransform_GetExtendModeX(border));
+                image->address_y = d2d_effect_address_from_extend_mode(ID2D1BorderTransform_GetExtendModeY(border));
+            }
+        }
+        ID2D1BorderTransform_Release(border);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1BlendTransform, (void **)&blend)))
+    {
+        hr = d2d_effect_renderer_render_blend(renderer, effect, node, blend, &r, image);
+        ID2D1BlendTransform_Release(blend);
+    }
+    else if (SUCCEEDED(ID2D1TransformNode_QueryInterface(node->object, &IID_ID2D1DrawTransform,
+            (void **)&draw_transform)))
+    {
+        hr = d2d_effect_renderer_render_draw(renderer, effect, node, draw_transform, &r, image);
+        ID2D1DrawTransform_Release(draw_transform);
+    }
+    else
+    {
+        FIXME("Unhandled transform %p, it is not drawn.\n", node->object);
+    }
+
+    --renderer->node_depth;
+    return hr;
+}
+
+static HRESULT d2d_effect_renderer_render_effect(struct d2d_effect_renderer *renderer,
+        struct d2d_effect *effect, const D2D1_RECT_L *rect, struct d2d_effect_image *image)
+{
+    struct d2d_transform_graph *graph;
+    D2D1_RECT_L bounds;
+    HRESULT hr;
+
+    memset(image, 0, sizeof(*image));
+
+    /* which also brings the bounds of every transform up to date */
+    if (FAILED(hr = d2d_effect_renderer_effect_bounds(renderer, effect, &bounds)))
+        return hr == E_NOTIMPL ? S_OK : hr;
+
+    graph = effect->graph;
+    ++renderer->depth;
+    if (graph->passthrough)
+    {
+        hr = d2d_effect_renderer_render_image(renderer, graph->passthrough_input < effect->input_count
+                ? effect->inputs[graph->passthrough_input] : NULL, rect, image);
+    }
+    else
+    {
+        hr = d2d_effect_renderer_render_node(renderer, effect, graph->output, rect, image);
+    }
+    --renderer->depth;
+
+    return hr;
+}
+
+/* The part rect of an image, as a bitmap with a pixel for each of its pixels. */
+static HRESULT d2d_effect_renderer_resolve(struct d2d_effect_renderer *renderer,
+        const struct d2d_effect_image *image, D2D1_RECT_L *rect, struct d2d_bitmap **bitmap, D2D1_POINT_2L *origin)
+{
+    D2D1_FILTER filter = D2D1_FILTER_MIN_MAG_MIP_LINEAR;
+    struct d2d_bitmap *output;
+    HRESULT hr;
+
+    *bitmap = NULL;
+    if (!image->bitmap)
+        return S_OK;
+
+    if (image->address_x == D2D_EFFECT_ADDRESS_TRANSPARENT && image->address_y == D2D_EFFECT_ADDRESS_TRANSPARENT)
+    {
+        d2d_rect_l_intersect(rect, &image->rect);
+        if (d2d_rect_l_is_empty(rect))
+            return S_OK;
+        if (image->rect.right - image->rect.left == image->bitmap->pixel_size.width
+                && image->rect.bottom - image->rect.top == image->bitmap->pixel_size.height)
+        {
+            *bitmap = image->bitmap;
+            origin->x = image->rect.left;
+            origin->y = image->rect.top;
+            return S_OK;
+        }
+    }
+
+    if (FAILED(hr = d2d_effect_renderer_create_bitmap(renderer, rect, &output)))
+        return hr;
+    if (FAILED(hr = d2d_effect_renderer_draw(renderer, renderer->context->effect_copy_ps, NULL, image, &filter, 1,
+            output, rect, rect, NULL, NULL, TRUE)))
+        return hr;
+
+    *bitmap = output;
+    origin->x = rect->left;
+    origin->y = rect->top;
+    return S_OK;
+}
+
+HRESULT d2d_device_context_get_effect_bounds(struct d2d_device_context *context, struct d2d_effect *effect,
+        D2D1_RECT_L *bounds)
+{
+    struct d2d_effect_renderer renderer;
+    HRESULT hr;
+
+    d2d_effect_renderer_init(&renderer, context);
+    hr = d2d_effect_renderer_effect_bounds(&renderer, effect, bounds);
+    d2d_effect_renderer_cleanup(&renderer);
+
+    return hr;
+}
+
+/* Only what can be seen is drawn: the clip, or the whole target, taken back into the effect's space. */
+static BOOL d2d_effect_visible_rect(struct d2d_device_context *context, const D2D1_POINT_2F *offset,
+        D2D1_RECT_L *visible)
+{
+    float scale_x = context->desc.dpiX / 96.0f, scale_y = context->desc.dpiY / 96.0f;
+    D2D1_MATRIX_3X2_F to_device, to_effect, scale;
+    D2D1_RECT_F device_rect, rect;
+    D2D1_POINT_2F point;
+
+    /* from the effect's pixels to DIPs, where the world transform takes them, then to the target's pixels */
+    to_device._11 = 1.0f / scale_x;
+    to_device._12 = 0.0f;
+    to_device._21 = 0.0f;
+    to_device._22 = 1.0f / scale_y;
+    to_device._31 = offset->x;
+    to_device._32 = offset->y;
+    d2d_matrix_multiply(&to_device, &context->drawing_state.transform);
+    scale._11 = scale_x;
+    scale._12 = 0.0f;
+    scale._21 = 0.0f;
+    scale._22 = scale_y;
+    scale._31 = 0.0f;
+    scale._32 = 0.0f;
+    d2d_matrix_multiply(&to_device, &scale);
+    if (!d2d_matrix_invert(&to_effect, &to_device))
+        return FALSE;
+
+    if (context->clip_stack.count)
+    {
+        device_rect = context->clip_stack.stack[context->clip_stack.count - 1];
+    }
+    else
+    {
+        device_rect.left = 0.0f;
+        device_rect.top = 0.0f;
+        device_rect.right = context->pixel_size.width;
+        device_rect.bottom = context->pixel_size.height;
+    }
+    if (device_rect.left >= device_rect.right || device_rect.top >= device_rect.bottom)
+        return FALSE;
+
+    d2d_point_transform(&point, &to_effect, device_rect.left, device_rect.top);
+    rect.left = rect.right = point.x;
+    rect.top = rect.bottom = point.y;
+    d2d_point_transform(&point, &to_effect, device_rect.right, device_rect.top);
+    d2d_rect_expand(&rect, &point);
+    d2d_point_transform(&point, &to_effect, device_rect.left, device_rect.bottom);
+    d2d_rect_expand(&rect, &point);
+    d2d_point_transform(&point, &to_effect, device_rect.right, device_rect.bottom);
+    d2d_rect_expand(&rect, &point);
+
+    /* and a pixel more, for what filtering on the way to the target reads */
+    d2d_rect_l_set(visible, d2d_long_floor(rect.left) - 1, d2d_long_floor(rect.top) - 1,
+            d2d_long_ceil(rect.right) + 1, d2d_long_ceil(rect.bottom) + 1);
+    return TRUE;
+}
+
+HRESULT d2d_device_context_draw_effect(struct d2d_device_context *context, struct d2d_effect *effect,
+        const D2D1_POINT_2F *target_offset, const D2D1_RECT_F *image_rect,
+        D2D1_INTERPOLATION_MODE interpolation_mode, D2D1_COMPOSITE_MODE composite_mode)
+{
+    float scale_x = context->desc.dpiX / 96.0f, scale_y = context->desc.dpiY / 96.0f;
+    struct d2d_effect_renderer renderer;
+    D2D1_RECT_L region, part, visible;
+    struct d2d_effect_image image;
+    D2D1_RECT_F dst_rect, src_rect;
+    struct d2d_bitmap *bitmap;
+    D2D1_POINT_2F offset;
+    D2D1_POINT_2L origin;
+    HRESULT hr;
+
+    offset.x = target_offset ? target_offset->x : 0.0f;
+    offset.y = target_offset ? target_offset->y : 0.0f;
+
+    d2d_effect_renderer_init(&renderer, context);
+    if (FAILED(hr = d2d_effect_renderer_init_resources(context)))
+        goto done;
+
+    if (FAILED(hr = d2d_effect_renderer_effect_bounds(&renderer, effect, &region)))
+    {
+        if (hr == E_NOTIMPL)
+            hr = S_OK;
+        goto done;
+    }
+
+    if (image_rect)
+    {
+        d2d_rect_l_set(&part, d2d_long_floor(image_rect->left * scale_x), d2d_long_floor(image_rect->top * scale_y),
+                d2d_long_ceil(image_rect->right * scale_x), d2d_long_ceil(image_rect->bottom * scale_y));
+        d2d_rect_l_intersect(&region, &part);
+        offset.x -= image_rect->left;
+        offset.y -= image_rect->top;
+    }
+
+    if (!d2d_effect_visible_rect(context, &offset, &visible))
+        goto done;
+    d2d_rect_l_intersect(&region, &visible);
+    if (d2d_rect_l_is_empty(&region))
+        goto done;
+
+    TRACE("Drawing %s of effect %p.\n", debug_d2d_rect_l(&region), effect);
+
+    if (FAILED(hr = d2d_effect_renderer_render_effect(&renderer, effect, &region, &image)))
+        goto done;
+    if (FAILED(hr = d2d_effect_renderer_resolve(&renderer, &image, &region, &bitmap, &origin)) || !bitmap)
+        goto done;
+
+    dst_rect.left = region.left / scale_x + offset.x;
+    dst_rect.top = region.top / scale_y + offset.y;
+    dst_rect.right = region.right / scale_x + offset.x;
+    dst_rect.bottom = region.bottom / scale_y + offset.y;
+    src_rect.left = (region.left - origin.x) * 96.0f / bitmap->dpi_x;
+    src_rect.top = (region.top - origin.y) * 96.0f / bitmap->dpi_y;
+    src_rect.right = (region.right - origin.x) * 96.0f / bitmap->dpi_x;
+    src_rect.bottom = (region.bottom - origin.y) * 96.0f / bitmap->dpi_y;
+    d2d_device_context_draw_bitmap_composite(context, (ID2D1Bitmap *)&bitmap->ID2D1Bitmap1_iface,
+            &dst_rect, &src_rect, NULL, interpolation_mode, composite_mode);
+
+done:
+    d2d_effect_renderer_cleanup(&renderer);
+    return hr;
+}
