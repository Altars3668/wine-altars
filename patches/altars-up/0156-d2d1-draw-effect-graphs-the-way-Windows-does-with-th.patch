@@ -2570,12 +2586,34 @@ static HRESULT STDMETHODCALLTYPE d2d_device_context_GetImageLocalBounds(ID2D1Dev
         ID2D1Image *image, D2D1_RECT_F *local_bounds)
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    float scale_x = 1.0f, scale_y = 1.0f;
+    struct d2d_effect *effect;
     D2D_SIZE_U pixel_size;
     ID2D1Bitmap *bitmap;
+    D2D1_RECT_L bounds;
     D2D_SIZE_F size;
+    HRESULT hr;
 
     TRACE("iface %p, image %p, local_bounds %p.\n", iface, image, local_bounds);
 
+    if ((effect = unsafe_impl_from_effect_ID2D1Image(image)))
+    {
+        if (FAILED(hr = d2d_device_context_get_effect_bounds(context, effect, &bounds)))
+            return hr;
+
+        /* effects work in pixels; an infinite side stays so */
+        if (context->drawing_state.unitMode == D2D1_UNIT_MODE_DIPS)
+        {
+            scale_x = 96.0f / context->desc.dpiX;
+            scale_y = 96.0f / context->desc.dpiY;
+        }
+        local_bounds->left = bounds.left == LONG_MIN ? (float)LONG_MIN : bounds.left * scale_x;
+        local_bounds->top = bounds.top == LONG_MIN ? (float)LONG_MIN : bounds.top * scale_y;
+        local_bounds->right = bounds.right == LONG_MAX ? (float)LONG_MAX : bounds.right * scale_x;
+        local_bounds->bottom = bounds.bottom == LONG_MAX ? (float)LONG_MAX : bounds.bottom * scale_y;
+        return S_OK;
+    }
+
     if (SUCCEEDED(ID2D1Image_QueryInterface(image, &IID_ID2D1Bitmap, (void **)&bitmap)))
     {
         local_bounds->left = 0.0f;
@@ -3178,6 +3216,58 @@ static const ID2D1CommandSink1Vtbl d2d_command_player_vtbl =
