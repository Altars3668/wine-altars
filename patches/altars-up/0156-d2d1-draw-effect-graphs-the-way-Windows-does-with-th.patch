+    check_effect_pixel(&ctx, 1, 1, 0xffff0000, 0);
+    check_effect_pixel(&ctx, 2, 2, 0xffff0000, 0);
+    check_effect_pixel(&ctx, 3, 3, 0x00000000, 0);
+
+    /* Part of an image, placed at an offset. */
+    offset.x = 10.0f;
+    offset.y = 20.0f;
+    set_rect(&image_rect, 0.0f, 0.0f, 2.0f, 2.0f);
+    draw_effect(&ctx, flood, &offset, &image_rect, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 9, 19, 0x00000000, 0);
+    check_effect_pixel(&ctx, 10, 20, 0xffff0000, 0);
+    check_effect_pixel(&ctx, 11, 21, 0xffff0000, 0);
+    check_effect_pixel(&ctx, 12, 22, 0x00000000, 0);
+    ID2D1Effect_Release(effect);
+
+    /* A shadow without a blur is its colour wherever the input is. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1Shadow, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)blue, FALSE);
+    f = 0.0f;
+    hr = ID2D1Effect_SetValue(effect, D2D1_SHADOW_PROP_BLUR_STANDARD_DEVIATION, D2D1_PROPERTY_TYPE_FLOAT,
+            (const BYTE *)&f, sizeof(f));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_color(&color, 0.0f, 1.0f, 0.0f, 1.0f);
+    hr = ID2D1Effect_SetValue(effect, D2D1_SHADOW_PROP_COLOR, D2D1_PROPERTY_TYPE_VECTOR4,
+            (const BYTE *)&color, sizeof(color));
