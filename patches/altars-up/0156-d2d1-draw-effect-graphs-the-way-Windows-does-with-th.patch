+/* As on Windows, the output has every pixel whose centre the input, grown by half a pixel, is taken to. */
+static void _2d_affine_transform_map_input_rects(struct d2d_effect_transform *transform,
+        const D2D1_RECT_L *input_rects, D2D1_RECT_L *output_rect)
+{
+    const D2D1_RECT_L *r = &input_rects[0];
+    double min_x, min_y, max_x, max_y;
+
+    if (transform->singular || d2d_rect_l_is_empty(r))
+    {
+        d2d_rect_l_set(output_rect, 0, 0, 0, 0);
+        return;
+    }
+    if (d2d_rect_l_is_infinite(r))
+    {
+        d2d_rect_l_set_infinite(output_rect);
+        return;
+    }
+
+    d2d_transform_rect_bounds(&transform->matrix, r->left - 0.5, r->top - 0.5, r->right + 0.5, r->bottom + 0.5,
+            &min_x, &min_y, &max_x, &max_y);
+    d2d_rect_l_set(output_rect, d2d_long_ceil(min_x - 0.5), d2d_long_ceil(min_y - 0.5),
+            d2d_long_add(d2d_long_floor(max_x - 0.5), 1), d2d_long_add(d2d_long_floor(max_y - 0.5), 1));
+    if (d2d_rect_l_is_empty(output_rect))
+        d2d_rect_l_set(output_rect, 0, 0, 0, 0);
+}
