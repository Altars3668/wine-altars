+/* Plays a command list into a bitmap of the effect renderer's instead of the target, transform taking its DIPs to
+ * the pixels of the bitmap. */
+HRESULT d2d_device_context_draw_command_list_to_bitmap(struct d2d_device_context *context,
+        ID2D1CommandList *command_list, struct d2d_bitmap *bitmap, const D2D1_MATRIX_3X2_F *transform)
+{
+    D2D1_DRAWING_STATE_DESCRIPTION1 drawing_state = context->drawing_state;
+    enum d2d_device_context_target_type type = context->target.type;
+    struct d2d_bitmap *target_bitmap = context->target.bitmap;
+    D2D1_PIXEL_FORMAT format = context->desc.pixelFormat;
+    float dpi_x = context->desc.dpiX, dpi_y = context->desc.dpiY;
+    struct d2d_clip_stack clip_stack = context->clip_stack;
+    ID2D1Image *object = context->target.object;
+    D2D1_SIZE_U pixel_size = context->pixel_size;
+    size_t push_count = context->push_count;
+
+    if (!d2d_clip_stack_init(&context->clip_stack))
+    {
+        context->clip_stack = clip_stack;
+        return E_OUTOFMEMORY;
+    }
+
+    context->target.object = (ID2D1Image *)&bitmap->ID2D1Bitmap1_iface;
+    context->target.type = D2D_TARGET_BITMAP;
+    context->target.bitmap = bitmap;
+    context->pixel_size = bitmap->pixel_size;
+    context->desc.pixelFormat = bitmap->format;
+    context->desc.dpiX = 96.0f;
+    context->desc.dpiY = 96.0f;
+    context->drawing_state.transform = *transform;
+    context->drawing_state.primitiveBlend = D2D1_PRIMITIVE_BLEND_SOURCE_OVER;
+    context->drawing_state.unitMode = D2D1_UNIT_MODE_DIPS;
+
+    d2d_device_context_draw_command_list(context, command_list, NULL, NULL);
+
+    d2d_clip_stack_cleanup(&context->clip_stack);
+    context->clip_stack = clip_stack;
+    context->push_count = push_count;
+    context->target.object = object;
+    context->target.type = type;
+    context->target.bitmap = target_bitmap;
+    context->pixel_size = pixel_size;
+    context->desc.pixelFormat = format;
+    context->desc.dpiX = dpi_x;
+    context->desc.dpiY = dpi_y;
+    context->drawing_state = drawing_state;
+
+    return S_OK;
+}
