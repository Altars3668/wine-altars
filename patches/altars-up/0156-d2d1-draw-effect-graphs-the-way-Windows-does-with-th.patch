+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0xff00ff00, 1);
+    check_effect_pixel(&ctx, 4, 4, 0x00000000, 0);
+    ID2D1Effect_Release(effect);
+
+    /* A blur keeps the inside of a large image, and softens its edges out into the transparent around it. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1GaussianBlur, &blur);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(blur, 0, (ID2D1Image *)white, FALSE);
+    f = 1.0f;
+    hr = ID2D1Effect_SetValue(blur, D2D1_GAUSSIANBLUR_PROP_STANDARD_DEVIATION, D2D1_PROPERTY_TYPE_FLOAT,
