+static ID2D1Bitmap1 *create_effect_input(ID2D1DeviceContext *context, unsigned int width, unsigned int height,
+        DWORD colour)
+{
+    D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+    ID2D1Bitmap1 *bitmap;
+    D2D1_SIZE_U size;
+    unsigned int i;
+    DWORD *data;
+    HRESULT hr;
+
+    data = malloc(width * height * sizeof(*data));
+    for (i = 0; i < width * height; ++i)
+        data[i] = colour;
+    set_size_u(&size, width, height);
+    bitmap_desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    bitmap_desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+    bitmap_desc.dpiX = 96.0f;
+    bitmap_desc.dpiY = 96.0f;
+    bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_NONE;
+    bitmap_desc.colorContext = NULL;
+    hr = ID2D1DeviceContext_CreateBitmap(context, size, data, width * sizeof(*data), &bitmap_desc, &bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    free(data);
+
+    return bitmap;
+}
+
+static void set_effect_input_effect(ID2D1Effect *effect, unsigned int index, ID2D1Effect *input)
+{
+    ID2D1Image *output;
+
+    ID2D1Effect_GetOutput(input, &output);
+    ID2D1Effect_SetInput(effect, index, output, FALSE);
+    ID2D1Image_Release(output);
+}
+
+static void draw_effect(struct d2d1_test_context *ctx, ID2D1Effect *effect, const D2D1_POINT_2F *offset,
+        const D2D1_RECT_F *image_rect, D2D1_COMPOSITE_MODE mode)
+{
+    ID2D1Image *output;
+    HRESULT hr;
+
+    ID2D1Effect_GetOutput(effect, &output);
+    ID2D1DeviceContext_BeginDraw(ctx->context);
+    ID2D1DeviceContext_Clear(ctx->context, NULL);
+    ID2D1DeviceContext_DrawImage(ctx->context, output, offset, image_rect, D2D1_INTERPOLATION_MODE_LINEAR, mode);
+    hr = ID2D1DeviceContext_EndDraw(ctx->context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Image_Release(output);
+}
+
+#define check_effect_pixel(a, b, c, d, e) check_effect_pixel_(__LINE__, a, b, c, d, e)
+static void check_effect_pixel_(unsigned int line, struct d2d1_test_context *ctx, unsigned int x, unsigned int y,
+        DWORD expected, BYTE max_diff)
+{
+    struct resource_readback rb;
+    DWORD colour;
+
+    get_surface_readback(ctx, &rb);
+    colour = get_readback_colour(&rb, x, y);
+    ok_(__FILE__, line)(compare_colour(colour, expected, max_diff),
+            "Got unexpected colour %#lx at (%u, %u), expected %#lx.\n", colour, x, y, expected);
+    release_resource_readback(&rb);
+}
+
+/* The values follow from the formulas the documentation of each effect gives. */
+static void test_effect_rendering(BOOL d3d11)
+{
+    D2D1_RECT_F rect, image_rect, bounds;
+    ID2D1Effect *effect, *flood, *blur;
+    ID2D1Bitmap1 *blue, *red, *white;
+    struct d2d1_test_context ctx;
+    ID2D1CommandList *list;
+    ID2D1SolidColorBrush *brush;
+    ID2D1DeviceContext *context;
+    ID2D1Image *target, *output;
+    D2D_VECTOR_4F vec4;
+    D2D1_COLOR_F color;
+    D2D1_POINT_2F offset;
+    struct resource_readback rb;
+    DWORD colour;
+    float f;
+    HRESULT hr;
+    UINT32 v;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    if (!ctx.factory1)
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+    context = ctx.context;
+
+    blue = create_effect_input(context, 4, 4, 0xff0000ff);
+    red = create_effect_input(context, 4, 4, 0x80800000);
+    white = create_effect_input(context, 16, 16, 0xffffffff);
+
+    /* An arithmetic composite as a cross fade: half of each input. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1ArithmeticComposite, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)blue, FALSE);
+    ID2D1Effect_SetInput(effect, 1, (ID2D1Image *)white, FALSE);
+    vec4.x = 0.0f;
+    vec4.y = 0.5f;
+    vec4.z = 0.5f;
+    vec4.w = 0.0f;
+    hr = ID2D1Effect_SetValue(effect, D2D1_ARITHMETICCOMPOSITE_PROP_COEFFICIENTS, D2D1_PROPERTY_TYPE_VECTOR4,
+            (const BYTE *)&vec4, sizeof(vec4));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0xff8080ff, 1);
+    check_effect_pixel(&ctx, 8, 8, 0x80808080, 1);
+    check_effect_pixel(&ctx, 20, 20, 0x00000000, 0);
+    /* The first input alone; setting a property takes effect on the next draw. */
+    vec4.y = 1.0f;
+    vec4.z = 0.0f;
+    hr = ID2D1Effect_SetValue(effect, D2D1_ARITHMETICCOMPOSITE_PROP_COEFFICIENTS, D2D1_PROPERTY_TYPE_VECTOR4,
+            (const BYTE *)&vec4, sizeof(vec4));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0xff0000ff, 1);
+    check_effect_pixel(&ctx, 8, 8, 0x00000000, 0);
+    /* The product of the inputs, by default. */
+    vec4.x = 1.0f;
+    vec4.y = 0.0f;
+    hr = ID2D1Effect_SetValue(effect, D2D1_ARITHMETICCOMPOSITE_PROP_COEFFICIENTS, D2D1_PROPERTY_TYPE_VECTOR4,
+            (const BYTE *)&vec4, sizeof(vec4));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 1, (ID2D1Image *)red, FALSE);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0x80000000, 1);
+    ID2D1Effect_Release(effect);
+
+    /* Composite: the first input is the destination, the second the source. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1Composite, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)blue, FALSE);
+    ID2D1Effect_SetInput(effect, 1, (ID2D1Image *)red, FALSE);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0xff80007f, 1);
+    v = D2D1_COMPOSITE_MODE_DESTINATION_OUT;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COMPOSITE_PROP_MODE, D2D1_PROPERTY_TYPE_ENUM, (const BYTE *)&v, sizeof(v));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0x7f00007f, 1);
+    v = D2D1_COMPOSITE_MODE_PLUS;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COMPOSITE_PROP_MODE, D2D1_PROPERTY_TYPE_ENUM, (const BYTE *)&v, sizeof(v));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0xff8000ff, 1);
+    /* A third input is composited onto the first two. */
+    hr = ID2D1Effect_SetInputCount(effect, 3);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 2, (ID2D1Image *)white, FALSE);
+    v = D2D1_COMPOSITE_MODE_SOURCE_OVER;
+    hr = ID2D1Effect_SetValue(effect, D2D1_COMPOSITE_PROP_MODE, D2D1_PROPERTY_TYPE_ENUM, (const BYTE *)&v, sizeof(v));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0xffffffff, 1);
+    check_effect_pixel(&ctx, 8, 8, 0xffffffff, 1);
+    ID2D1Effect_Release(effect);
+
+    /* An effect taking another's output: a flood cropped to a rectangle. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1Flood, &flood);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_color(&color, 1.0f, 0.0f, 0.0f, 1.0f);
+    hr = ID2D1Effect_SetValue(flood, D2D1_FLOOD_PROP_COLOR, D2D1_PROPERTY_TYPE_VECTOR4,
+            (const BYTE *)&color, sizeof(color));
