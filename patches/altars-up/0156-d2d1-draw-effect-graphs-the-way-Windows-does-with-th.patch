+static void d2d_transform_rect_bounds(const D2D1_MATRIX_3X2_F *m, double left, double top, double right,
+        double bottom, double *min_x, double *min_y, double *max_x, double *max_y)
+{
+    double x[4] = {left, right, left, right}, y[4] = {top, top, bottom, bottom}, tx, ty;
+    unsigned int i;
+
+    *min_x = *min_y = INFINITY;
+    *max_x = *max_y = -INFINITY;
+    for (i = 0; i < 4; ++i)
+    {
+        tx = x[i] * m->_11 + y[i] * m->_21 + m->_31;
+        ty = x[i] * m->_12 + y[i] * m->_22 + m->_32;
+        *min_x = min(*min_x, tx);
+        *min_y = min(*min_y, ty);
+        *max_x = max(*max_x, tx);
+        *max_y = max(*max_y, ty);
+    }
+}
