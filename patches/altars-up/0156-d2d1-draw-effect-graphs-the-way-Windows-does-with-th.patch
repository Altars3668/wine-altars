+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1Crop, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_effect_input_effect(effect, 0, flood);
