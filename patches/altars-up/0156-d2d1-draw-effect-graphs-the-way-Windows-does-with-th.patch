+    d2d_rect_l_set(&input_rects[0], d2d_long_add(d2d_long_floor(min_x), -1), d2d_long_add(d2d_long_floor(min_y), -1),
+            d2d_long_add(d2d_long_ceil(max_x), 1), d2d_long_add(d2d_long_ceil(max_y), 1));
