+    get_surface_readback(&ctx, &rb);
+    colour = get_readback_colour(&rb, 16, 8);
+    ok(colour >> 24 > 0x20 && colour >> 24 < 0xa0, "Got unexpected colour %#lx.\n", colour);
+    colour = get_readback_colour(&rb, 15, 8);
+    ok(colour >> 24 > 0x60 && colour >> 24 < 0xff, "Got unexpected colour %#lx.\n", colour);
+    release_resource_readback(&rb);
+    ID2D1Effect_Release(blur);
+
+    /* A command list is drawn into what the effect takes. */
+    hr = ID2D1DeviceContext_CreateCommandList(context, &list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_GetTarget(context, &target);
+    ID2D1DeviceContext_SetTarget(context, (ID2D1Image *)list);
+    set_color(&color, 0.0f, 0.0f, 1.0f, 1.0f);
+    hr = ID2D1DeviceContext_CreateSolidColorBrush(context, &color, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_BeginDraw(context);
+    set_rect(&rect, 2.0f, 2.0f, 6.0f, 6.0f);
+    ID2D1DeviceContext_FillRectangle(context, &rect, (ID2D1Brush *)brush);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1CommandList_Close(list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_SetTarget(context, target);
+    ID2D1Image_Release(target);
+    ID2D1SolidColorBrush_Release(brush);
+
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1Composite, &effect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(effect, 0, (ID2D1Image *)list, FALSE);
+    ID2D1Effect_SetInput(effect, 1, (ID2D1Image *)red, FALSE);
+    draw_effect(&ctx, effect, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 1, 1, 0x80800000, 1);
+    check_effect_pixel(&ctx, 3, 3, 0xff80007f, 1);
+    check_effect_pixel(&ctx, 5, 5, 0xff0000ff, 1);
+    check_effect_pixel(&ctx, 7, 7, 0x00000000, 0);
+    ID2D1Effect_Release(effect);
+    ID2D1CommandList_Release(list);
+
+    ID2D1Effect_Release(flood);
+    ID2D1Bitmap1_Release(white);
+    ID2D1Bitmap1_Release(red);
+    ID2D1Bitmap1_Release(blue);
+    release_test_context(&ctx);
+}
