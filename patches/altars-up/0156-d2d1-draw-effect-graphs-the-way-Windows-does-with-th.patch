+/* A bitmap drawn the way DrawImage composites it; only what primitive blends can do so far. */
+void d2d_device_context_draw_bitmap_composite(struct d2d_device_context *context, ID2D1Bitmap *bitmap,
+        const D2D1_RECT_F *dst_rect, const D2D1_RECT_F *src_rect, const D2D1_POINT_2F *offset,
+        D2D1_INTERPOLATION_MODE interpolation_mode, D2D1_COMPOSITE_MODE composite_mode)
+{
+    D2D1_PRIMITIVE_BLEND previous_blend = context->drawing_state.primitiveBlend;
+
+    if (composite_mode == D2D1_COMPOSITE_MODE_SOURCE_OVER)
+        context->drawing_state.primitiveBlend = D2D1_PRIMITIVE_BLEND_SOURCE_OVER;
+    else if (composite_mode == D2D1_COMPOSITE_MODE_PLUS)
+        context->drawing_state.primitiveBlend = D2D1_PRIMITIVE_BLEND_ADD;
+    d2d_device_context_draw_bitmap(context, bitmap, dst_rect, 1.0f, interpolation_mode, src_rect, offset, NULL);
+    context->drawing_state.primitiveBlend = previous_blend;
+}
