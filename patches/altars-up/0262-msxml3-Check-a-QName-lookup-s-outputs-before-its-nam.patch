From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 08:34:29 -0400
Subject: [PATCH] msxml3: Check a QName lookup's outputs before its name.

The attribute lookups as each version answers them made
getValueFromQName() return E_INVALIDARG for a missing name before
looking at its outputs, and 39 checks in msxml6's saxreader tests, which
pass on Windows, failed: MSXML 6 answers E_POINTER when the outputs are
missing, and E_INVALIDARG for a missing name only once they are there,
the order its other lookups follow.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/saxreader.c b/dlls/msxml3/saxreader.c
index b33b48e5c2e..b87cca5006b 100644
--- a/dlls/msxml3/saxreader.c
+++ b/dlls/msxml3/saxreader.c
@@ -1811,6 +1811,7 @@ static HRESULT WINAPI isaxattributes_getValueFromQName(ISAXAttributes *iface,
     TRACE("%p, %s, %d, %p, %p.\n", iface, debugstr_w(name), name_length, value, length);
 
     saxlocator_clear_string(locator, value, length);
+    if (!value || !length) return E_POINTER;
     if (!name)
         return locator->saxreader->version >= MSXML4 ? E_INVALIDARG : E_POINTER;
 
diff --git a/dlls/msxml3/tests/saxreader.c b/dlls/msxml3/tests/saxreader.c
index 573ac1400f3..e07e2373b08 100644
--- a/dlls/msxml3/tests/saxreader.c
+++ b/dlls/msxml3/tests/saxreader.c
@@ -4207,6 +4207,14 @@ static void check_attr_lookups6(ISAXAttributes *attributes, BOOL modern)
     len = -1;
     hr = ISAXAttributes_getValueFromName(attributes, NULL, 0, L"b", 1, &str, &len);
     ok(hr == E_INVALIDARG && !str && !len, "Unexpected outputs %#lx, %p, %d.\n", hr, str, len);
+
+    /* the outputs are checked before the name */
+    hr = ISAXAttributes_getValueFromQName(attributes, NULL, 0, NULL, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getValueFromQName(attributes, NULL, 0, &str, &len);
+    ok(hr == E_INVALIDARG && !str && !len, "Unexpected outputs %#lx, %p, %d.\n", hr, str, len);
 }
 
 static void check_attr_types6(ISAXAttributes *attributes, BOOL modern)
