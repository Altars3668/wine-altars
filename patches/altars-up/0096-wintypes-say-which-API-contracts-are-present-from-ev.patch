From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 01:14:32 -0400
Subject: [PATCH] wintypes: say which API contracts are present, from every
 entry point alike.

Word asks RoIsApiContractMajorVersionPresent whether
UniversalApiContract 7 through 15 is there, and was told none of them
were: the function was a stub answering FALSE, as if this were a
Windows 10 older than 1809.  RoIsApiContractPresent, with a minor
version, was not even exported.  ApiInformation had a table of its own
and a stub for the minor-version case.

All four now read one table, the contracts at the versions the Windows
10 2004-22H2 Wine reports declares them: UniversalApiContract 10,
FoundationContract 4, and the three contracts of classes this tree
implements at the versions it declares.  As measured on Windows, every
version up to a contract's own is present, any minor version of an
earlier major but none past the current one's, the name matches
whatever its case and nothing else (a namespace, a trailing space), an
unknown contract is absent and an empty name is E_INVALIDARG.

The checks ApiInformation's tests held as todo now pass, and the new
tests pass on Windows as here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 76a6f19e3820e4e54f16f87f774fc674f95e21da)

diff --git a/dlls/wintypes/main.c b/dlls/wintypes/main.c
index 00815d8456d..6a92383ec9f 100644
--- a/dlls/wintypes/main.c
+++ b/dlls/wintypes/main.c
@@ -22,27 +22,45 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(wintypes);
 
+/*
+ * The API contracts this Windows has, at the version it has them: the
+ * Windows 10 2004 through 22H2 Wine reports, as their metadata declares
+ * them.  A contract's every version up to its own is present, any minor
+ * version of an earlier one; the names match whatever their case.
+ */
 static const struct
 {
     const WCHAR *name;
-    unsigned int max_major;
+    UINT16 major;
+    UINT16 minor;
 }
 present_contracts[] =
 {
-    { L"Windows.Foundation.UniversalApiContract", 10, },
+    { L"Windows.Foundation.FoundationContract", 4, 0 },
+    { L"Windows.Foundation.UniversalApiContract", 10, 0 },
+    { L"Windows.Networking.Connectivity.WwanContract", 2, 0 },
+    { L"Windows.System.Profile.ProfileSharedModeContract", 2, 0 },
+    { L"Windows.System.Profile.SystemManufacturers.SystemManufacturersContract", 3, 0 },
 };
 
-static BOOLEAN is_api_contract_present( const HSTRING hname, unsigned int version )
+static BOOLEAN is_contract_present( const WCHAR *name, UINT16 major, UINT16 minor )
 {
-    const WCHAR *name = WindowsGetStringRawBuffer( hname, NULL );
     unsigned int i;
 
     for (i = 0; i < ARRAY_SIZE(present_contracts); ++i)
-        if (!wcsicmp( name, present_contracts[i].name )) return version <= present_contracts[i].max_major;
-
+    {
+        if (wcsicmp( name, present_contracts[i].name )) continue;
+        return major < present_contracts[i].major ||
+               (major == present_contracts[i].major && minor <= present_contracts[i].minor);
+    }
     return FALSE;
 }
 
+static BOOLEAN is_api_contract_present( const HSTRING hname, unsigned int version )
+{
+    return version <= 0xffff && is_contract_present( WindowsGetStringRawBuffer( hname, NULL ), version, 0 );
+}
+
 struct api_information_statics
 {
     IActivationFactory IActivationFactory_iface;
@@ -245,7 +263,7 @@ static HRESULT STDMETHODCALLTYPE api_information_statics_IsEnumNamedValuePresent
 static HRESULT STDMETHODCALLTYPE api_information_statics_IsApiContractPresentByMajor(
         IApiInformationStatics *iface, HSTRING contract_name, UINT16 major_version, BOOLEAN *value)
 {
-    FIXME("iface %p, contract_name %s, major_version %u, value %p semi-stub.\n", iface,
+    TRACE("iface %p, contract_name %s, major_version %u, value %p.\n", iface,
             debugstr_hstring(contract_name), major_version, value);
 
     if (!contract_name)
@@ -259,13 +277,14 @@ static HRESULT STDMETHODCALLTYPE api_information_statics_IsApiContractPresentByM
         IApiInformationStatics *iface, HSTRING contract_name, UINT16 major_version,
         UINT16 minor_version, BOOLEAN *value)
 {
-    FIXME("iface %p, contract_name %s, major_version %u, minor_version %u, value %p stub!\n", iface,
+    TRACE("iface %p, contract_name %s, major_version %u, minor_version %u, value %p.\n", iface,
             debugstr_hstring(contract_name), major_version, minor_version, value);
 
     if (!contract_name)
         return E_INVALIDARG;
 
-    return E_NOTIMPL;
+    *value = is_contract_present( WindowsGetStringRawBuffer( contract_name, NULL ), major_version, minor_version );
+    return S_OK;
 }
 
 static const struct IApiInformationStaticsVtbl api_information_statics_vtbl =
@@ -1808,10 +1827,27 @@ HRESULT WINAPI DllGetActivationFactory(HSTRING classid, IActivationFactory **fac
     return CLASS_E_CLASSNOTAVAILABLE;
 }
 
+/***********************************************************************
+ *      RoIsApiContractMajorVersionPresent (wintypes.@)
+ */
 HRESULT WINAPI RoIsApiContractMajorVersionPresent(const WCHAR *name, UINT16 major, BOOL *result)
 {
-    FIXME("name %s, major %u, result %p\n", debugstr_w(name), major, result);
-    *result = FALSE;
+    TRACE("name %s, major %u, result %p\n", debugstr_w(name), major, result);
+
+    if (!name || !*name || !result) return E_INVALIDARG;
+    *result = is_contract_present(name, major, 0);
+    return S_OK;
+}
+
+/***********************************************************************
+ *      RoIsApiContractPresent (wintypes.@)
+ */
+HRESULT WINAPI RoIsApiContractPresent(const WCHAR *name, UINT16 major, UINT16 minor, BOOL *result)
+{
+    TRACE("name %s, major %u, minor %u, result %p\n", debugstr_w(name), major, minor, result);
+
+    if (!name || !*name || !result) return E_INVALIDARG;
+    *result = is_contract_present(name, major, minor);
     return S_OK;
 }
 
