+/* A contract is there at every version up to its own, whatever the case of its name. */
+static void test_RoIsApiContractPresent(void)
+{
+    static const WCHAR universal[] = L"Windows.Foundation.UniversalApiContract";
+    BOOL present;
+    HRESULT hr;
+    UINT16 v;
+
+    /* Windows 10 2004 and later have version 10 */
+    for (v = 0; v <= 10; v++)
+    {
+        present = FALSE;
+        hr = RoIsApiContractMajorVersionPresent(universal, v, &present);
+        ok(hr == S_OK, "%u: got hr %#lx.\n", v, hr);
+        ok(present, "%u: not present.\n", v);
+    }
+    present = TRUE;
+    hr = RoIsApiContractMajorVersionPresent(universal, 999, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!present, "999 present.\n");
+
+    present = FALSE;
+    hr = RoIsApiContractMajorVersionPresent(L"windows.foundation.universalapicontract", 1, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(present, "not present.\n");
+    present = TRUE;
+    hr = RoIsApiContractMajorVersionPresent(L"Windows.Foundation.UniversalApiContract ", 1, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!present, "present with a space after.\n");
+    present = TRUE;
+    hr = RoIsApiContractMajorVersionPresent(L"Windows.Foundation", 1, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!present, "a namespace is present.\n");
+    present = TRUE;
+    hr = RoIsApiContractMajorVersionPresent(L"Windows.Phone.PhoneContract", 1, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!present, "the phone's contract is present.\n");
+    hr = RoIsApiContractMajorVersionPresent(L"", 1, &present);
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+
+    /* any minor version of an earlier major, none past the present one's */
+    present = FALSE;
+    hr = RoIsApiContractPresent(universal, 0, 0, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(present, "0.0 not present.\n");
+    present = FALSE;
+    hr = RoIsApiContractPresent(universal, 1, 65535, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(present, "1.65535 not present.\n");
+    present = FALSE;
+    hr = RoIsApiContractPresent(universal, 10, 0, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(present, "10.0 not present.\n");
+    present = TRUE;
+    hr = RoIsApiContractPresent(universal, 999, 0, &present);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!present, "999.0 present.\n");
+    hr = RoIsApiContractPresent(L"", 1, 0, &present);
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+}
+
