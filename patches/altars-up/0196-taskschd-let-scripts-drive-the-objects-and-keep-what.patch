+/* The schema version a definition needs: what put_Compatibility said last, raised by each setter of
+ * something a later version added, whatever it sets it to.  A definition shares it with its settings,
+ * its principal and its actions. */
+struct task_version
+{
+    LONG ref;
+    TASK_COMPATIBILITY level;
+};
+
+static struct task_version *task_version_create(void)
+{
+    struct task_version *version;
+
+    if (!(version = malloc(sizeof(*version)))) return NULL;
+    version->ref = 1;
+    version->level = TASK_COMPATIBILITY_V2;
+    return version;
+}
+
+static struct task_version *task_version_addref(struct task_version *version)
+{
+    if (version) InterlockedIncrement(&version->ref);
+    return version;
+}
+
+static void task_version_release(struct task_version *version)
+{
+    if (version && !InterlockedDecrement(&version->ref)) free(version);
+}
+
+static void task_version_raise(struct task_version *version, TASK_COMPATIBILITY level)
+{
+    if (version && version->level < level) version->level = level;
+}
+
+/* An object that kept its own version joins another's, and brings along what it needed. */
+static void task_version_join(struct task_version **version, struct task_version *shared)
+{
+    if (*version == shared) return;
+    if (*version) task_version_raise(shared, (*version)->level);
+    task_version_release(*version);
+    *version = task_version_addref(shared);
+}
