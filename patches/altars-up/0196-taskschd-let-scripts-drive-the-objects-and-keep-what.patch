+static ITypeLib *typelib;
+
+/* Every object speaks for its interface through the type library, as the objects of Windows do. */
+static HRESULT get_typeinfo(REFIID riid, ITypeInfo **info)
+{
+    ITypeLib *lib;
+    HRESULT hr;
+
+    if (!typelib)
+    {
+        if (FAILED(hr = LoadRegTypeLib(&LIBID_TaskScheduler, 1, 0, LOCALE_SYSTEM_DEFAULT, &lib)))
+        {
+            ERR("failed to load the type library, hr %#lx\n", hr);
+            return hr;
+        }
+        if (InterlockedCompareExchangePointer((void **)&typelib, lib, NULL)) ITypeLib_Release(lib);
+    }
+    if (FAILED(hr = ITypeLib_GetTypeInfoOfGuid(typelib, riid, info)))
+        ERR("no type information for %s, hr %#lx\n", debugstr_guid(riid), hr);
+    return hr;
+}
+
+HRESULT dispatch_get_type_info(REFIID riid, UINT index, ITypeInfo **info)
+{
+    if (!info) return E_INVALIDARG;
+    *info = NULL;
+    if (index) return DISP_E_BADINDEX;
+    return get_typeinfo(riid, info);
+}
+
+HRESULT dispatch_get_ids_of_names(REFIID riid, LPOLESTR *names, UINT count, DISPID *dispid)
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (!names || !count || !dispid) return E_INVALIDARG;
+    if (FAILED(hr = get_typeinfo(riid, &info))) return hr;
+    hr = ITypeInfo_GetIDsOfNames(info, names, count, dispid);
+    ITypeInfo_Release(info);
+    return hr;
+}
+
+HRESULT dispatch_invoke(void *iface, REFIID riid, DISPID dispid, WORD flags, DISPPARAMS *params,
+                        VARIANT *result, EXCEPINFO *excepinfo, UINT *argerr)
+{
+    ITypeInfo *info;
+    HRESULT hr;
+
+    if (FAILED(hr = get_typeinfo(riid, &info))) return hr;
+    hr = ITypeInfo_Invoke(info, iface, dispid, flags, params, result, excepinfo, argerr);
+    ITypeInfo_Release(info);
+    return hr;
+}
+
+/* The enumerator of a collection whose items are numbered from 1, which goes through what the
+ * collection holds as it goes. */
+struct collection_enum
+{
+    IEnumVARIANT IEnumVARIANT_iface;
+    LONG ref;
+    IUnknown *collection;
+    collection_count_func count;
+    collection_item_func item;
+    LONG pos;
+};
+
+static inline struct collection_enum *impl_from_IEnumVARIANT(IEnumVARIANT *iface)
+{
+    return CONTAINING_RECORD(iface, struct collection_enum, IEnumVARIANT_iface);
+}
+
+static HRESULT WINAPI collection_enum_QueryInterface(IEnumVARIANT *iface, REFIID riid, void **obj)
+{
+    TRACE("%p,%s,%p\n", iface, debugstr_guid(riid), obj);
+
+    if (IsEqualGUID(riid, &IID_IEnumVARIANT) ||
+        IsEqualGUID(riid, &IID_IUnknown))
+    {
+        IEnumVARIANT_AddRef(iface);
+        *obj = iface;
+        return S_OK;
+    }
+
+    WARN("interface %s is not implemented\n", debugstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI collection_enum_AddRef(IEnumVARIANT *iface)
+{
+    struct collection_enum *enumerator = impl_from_IEnumVARIANT(iface);
+    return InterlockedIncrement(&enumerator->ref);
+}
+
+static ULONG WINAPI collection_enum_Release(IEnumVARIANT *iface)
+{
+    struct collection_enum *enumerator = impl_from_IEnumVARIANT(iface);
+    LONG ref = InterlockedDecrement(&enumerator->ref);
+
+    if (!ref)
+    {
+        TRACE("destroying %p\n", iface);
+        IUnknown_Release(enumerator->collection);
+        free(enumerator);
+    }
+
+    return ref;
+}
+
+static HRESULT WINAPI collection_enum_Next(IEnumVARIANT *iface, ULONG celt, VARIANT *var, ULONG *fetched)
+{
+    struct collection_enum *enumerator = impl_from_IEnumVARIANT(iface);
+    LONG count = 0;
+    IDispatch *item;
+    ULONG i = 0;
+    HRESULT hr;
+
+    TRACE("%p,%lu,%p,%p\n", iface, celt, var, fetched);
+
+    if (!var && celt) return E_INVALIDARG;
+
+    enumerator->count(enumerator->collection, &count);
+    while (i < celt && enumerator->pos < count)
+    {
+        if (FAILED(hr = enumerator->item(enumerator->collection, enumerator->pos + 1, &item)))
+        {
+            while (i) VariantClear(&var[--i]);
+            return hr;
+        }
+        enumerator->pos++;
+        V_VT(&var[i]) = VT_DISPATCH;
+        V_DISPATCH(&var[i]) = item;
+        i++;
+    }
+
+    if (fetched) *fetched = i;
+    return i == celt ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI collection_enum_Skip(IEnumVARIANT *iface, ULONG celt)
+{
+    struct collection_enum *enumerator = impl_from_IEnumVARIANT(iface);
+    LONG count = 0;
+
+    TRACE("%p,%lu\n", iface, celt);
+
+    enumerator->count(enumerator->collection, &count);
+    if (celt > count - enumerator->pos)
+    {
+        enumerator->pos = count;
+        return S_FALSE;
+    }
+    enumerator->pos += celt;
+    return S_OK;
+}
+
+static HRESULT WINAPI collection_enum_Reset(IEnumVARIANT *iface)
+{
+    TRACE("%p\n", iface);
+
+    impl_from_IEnumVARIANT(iface)->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_collection_enum(IUnknown *collection, collection_count_func count, collection_item_func item,
+                                      LONG pos, IEnumVARIANT **obj);
+
+static HRESULT WINAPI collection_enum_Clone(IEnumVARIANT *iface, IEnumVARIANT **clone)
+{
+    struct collection_enum *enumerator = impl_from_IEnumVARIANT(iface);
+
+    TRACE("%p,%p\n", iface, clone);
+
+    if (!clone) return E_POINTER;
+    return create_collection_enum(enumerator->collection, enumerator->count, enumerator->item, enumerator->pos, clone);
+}
+
+static const IEnumVARIANTVtbl collection_enum_vtbl =
+{
+    collection_enum_QueryInterface,
+    collection_enum_AddRef,
+    collection_enum_Release,
+    collection_enum_Next,
+    collection_enum_Skip,
+    collection_enum_Reset,
+    collection_enum_Clone
+};
+
+static HRESULT create_collection_enum(IUnknown *collection, collection_count_func count, collection_item_func item,
+                                      LONG pos, IEnumVARIANT **obj)
+{
+    struct collection_enum *enumerator;
+
+    if (!(enumerator = malloc(sizeof(*enumerator)))) return E_OUTOFMEMORY;
+
+    enumerator->IEnumVARIANT_iface.lpVtbl = &collection_enum_vtbl;
+    enumerator->ref = 1;
+    enumerator->collection = collection;
+    IUnknown_AddRef(collection);
+    enumerator->count = count;
+    enumerator->item = item;
+    enumerator->pos = pos;
+
+    *obj = &enumerator->IEnumVARIANT_iface;
+    TRACE("created %p\n", *obj);
+    return S_OK;
+}
+
+HRESULT collection_enum_create(IUnknown *collection, collection_count_func count, collection_item_func item,
+                               IUnknown **obj)
+{
+    if (!obj) return E_POINTER;
+    return create_collection_enum(collection, count, item, 0, (IEnumVARIANT **)obj);
+}
+
+BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, void *reserved)
+{
+    switch (reason)
+    {
+    case DLL_PROCESS_ATTACH:
+        DisableThreadLibraryCalls(instance);
+        break;
+    case DLL_PROCESS_DETACH:
+        if (reserved) break;
+        if (typelib) ITypeLib_Release(typelib);
+        break;
+    }
+    return TRUE;
+}
