+static HRESULT read_header_fields(IXmlReader *reader, IEmailAction *email)
+{
+    ITaskNamedValueCollection *fields;
+    const WCHAR *name, *value;
+    ITaskNamedValuePair *pair;
+    WCHAR *field_name, *field_value;
+    UINT depth, field_depth;
+    HRESULT hr;
+
+    if ((hr = element_depth(reader, &depth)) != S_OK) return FAILED(hr) ? hr : S_OK;
+    if (FAILED(hr = IEmailAction_get_HeaderFields(email, &fields))) return hr;
+
+    while ((hr = next_child(reader, depth, &name)) == S_OK)
+    {
+        if (wcscmp(name, L"HeaderField"))
+        {
+            WARN("unexpected HeaderFields element %s\n", debugstr_w(name));
+            hr = SCHED_E_UNEXPECTEDNODE;
+            break;
+        }
+        field_name = field_value = NULL;
+        if ((hr = element_depth(reader, &field_depth)) == S_OK)
+        {
+            while ((hr = next_child(reader, field_depth, &name)) == S_OK)
+            {
+                if ((hr = read_text_value(reader, &value)) != S_OK) break;
+                if (!wcscmp(name, L"Name")) hr = put_string(&field_name, value);
+                else if (!wcscmp(name, L"Value")) hr = put_string(&field_value, value);
+                else
+                {
+                    WARN("unexpected HeaderField element %s\n", debugstr_w(name));
+                    hr = SCHED_E_UNEXPECTEDNODE;
+                }
+                if (hr != S_OK) break;
+            }
+        }
+        if (SUCCEEDED(hr))
+        {
+            if (!field_name || !field_value) hr = SCHED_E_MISSINGNODE;
+            else if (SUCCEEDED(hr = ITaskNamedValueCollection_Create(fields, field_name, field_value, &pair)))
+                ITaskNamedValuePair_Release(pair);
+        }
+        free(field_name);
+        free(field_value);
+        if (FAILED(hr)) break;
+    }
+
+    ITaskNamedValueCollection_Release(fields);
+    return FAILED(hr) ? hr : S_OK;
+}
