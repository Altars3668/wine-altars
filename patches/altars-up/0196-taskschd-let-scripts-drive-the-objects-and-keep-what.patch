+/* A GUID, with its braces or without, and nothing a ProgID could be. */
+static BOOL is_class_id(const WCHAR *str)
+{
+    WCHAR braced[39];
+    GUID guid;
+
+    if (wcslen(str) == 36)
+    {
+        swprintf(braced, ARRAY_SIZE(braced), L"{%s}", str);
+        str = braced;
+    }
+    return wcslen(str) == 38 && SUCCEEDED(IIDFromString(str, &guid));
+}
