+/* What a later schema added raises the version of the task that uses it, which then bounds what XML it reads. */
+static void test_compatibility(void)
+{
+    static const struct
+    {
+        const WCHAR *version, *element;
+        HRESULT hr;
+    }
+    reads[] =
+    {
+        { L"1.2", L"<Settings><DisallowStartOnRemoteAppSession>true</DisallowStartOnRemoteAppSession></Settings>",
+          SCHED_E_UNEXPECTEDNODE },
+        { L"1.3", L"<Settings><DisallowStartOnRemoteAppSession>true</DisallowStartOnRemoteAppSession></Settings>", S_OK },
+        { L"1.3", L"<Settings><Volatile>true</Volatile></Settings>", SCHED_E_UNEXPECTEDNODE },
+        { L"1.4", L"<Settings><Volatile>true</Volatile></Settings>", S_OK },
+        { L"1.4", L"<Settings><MaintenanceSettings><Deadline>P1D</Deadline></MaintenanceSettings></Settings>",
+          SCHED_E_MISSINGNODE },
+        { L"1.2", L"<Principals><Principal><ProcessTokenSidType>None</ProcessTokenSidType></Principal></Principals>",
+          SCHED_E_UNEXPECTEDNODE },
+        { L"1.3", L"<Principals><Principal><ProcessTokenSidType>Bogus</ProcessTokenSidType></Principal></Principals>",
+          SCHED_E_INVALIDVALUE },
+        { L"1.3", L"<Principals><Principal><RequiredPrivileges><Privilege>SeBogusPrivilege</Privilege>"
+          "</RequiredPrivileges></Principal></Principals>", SCHED_E_INVALIDVALUE },
+        { L"1.7", L"", SCHED_E_INVALIDVALUE },
+    };
+    TASK_PROCESSTOKENSID_TYPE sid_type;
+    IMaintenanceSettings *maintenance;
+    TASK_COMPATIBILITY compatibility;
+    IActionCollection *actions;
+    ITaskSettings3 *settings3;
+    ITaskDefinition *taskdef;
+    ITaskSettings *settings;
+    IPrincipal2 *principal2;
+    ITaskService *service;
+    IPrincipal *principal;
+    IExecAction2 *exec2;
+    IAction *action;
+    WCHAR buffer[1024];
+    VARIANT_BOOL flag;
+    unsigned int i;
+    LONG count;
+    BSTR bstr;
+    HRESULT hr;
+
+    taskdef = new_task_definition(&service);
+    ITaskDefinition_get_Settings(taskdef, &settings);
+    hr = ITaskSettings_QueryInterface(settings, &IID_ITaskSettings3, (void **)&settings3);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+
+    ITaskSettings_get_Compatibility(settings, &compatibility);
+    ok(compatibility == TASK_COMPATIBILITY_V2, "got %d\n", compatibility);
+    /* setting it at all raises it, even to false */
+    hr = ITaskSettings3_put_DisallowStartOnRemoteAppSession(settings3, VARIANT_FALSE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ITaskSettings_get_Compatibility(settings, &compatibility);
+    ok(compatibility == TASK_COMPATIBILITY_V2_1, "got %d\n", compatibility);
+    flag = VARIANT_TRUE;
+    hr = ITaskSettings3_get_Volatile(settings3, &flag);
+    ok(hr == S_OK && flag == VARIANT_FALSE, "got hr %#lx, %d\n", hr, flag);
+    hr = ITaskSettings3_put_Volatile(settings3, VARIANT_FALSE);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ITaskSettings_get_Compatibility(settings, &compatibility);
+    ok(compatibility == TASK_COMPATIBILITY_V2_2, "got %d\n", compatibility);
+
+    maintenance = (void *)0xdeadbeef;
+    hr = ITaskSettings3_get_MaintenanceSettings(settings3, &maintenance);
+    ok(hr == S_OK && !maintenance, "got hr %#lx, %p\n", hr, maintenance);
+    hr = ITaskSettings3_CreateMaintenanceSettings(settings3, &maintenance);
+    ok(hr == S_OK && maintenance, "got hr %#lx, %p\n", hr, maintenance);
+    IMaintenanceSettings_put_Period(maintenance, (BSTR)L"P2D");
+    IMaintenanceSettings_Release(maintenance);
+    ITaskSettings3_put_Volatile(settings3, VARIANT_TRUE);
+
+    ITaskDefinition_get_Principal(taskdef, &principal);
+    hr = IPrincipal_QueryInterface(principal, &IID_IPrincipal2, (void **)&principal2);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+    hr = IPrincipal2_get_ProcessTokenSidType(principal2, &sid_type);
+    ok(hr == S_OK && sid_type == TASK_PROCESSTOKENSID_DEFAULT, "got hr %#lx, %d\n", hr, sid_type);
+    hr = IPrincipal2_AddRequiredPrivilege(principal2, (BSTR)L"SeBogusPrivilege");
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = IPrincipal2_AddRequiredPrivilege(principal2, (BSTR)L"SeBackupPrivilege");
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IPrincipal2_get_RequiredPrivilegeCount(principal2, &count);
+    ok(hr == S_OK && count == 1, "got hr %#lx, %ld\n", hr, count);
+    hr = IPrincipal2_get_RequiredPrivilege(principal2, 0, &bstr);
+    ok(hr == E_INVALIDARG, "got %#lx\n", hr);
+    hr = IPrincipal2_get_RequiredPrivilege(principal2, 1, &bstr);
+    ok(hr == S_OK && !wcscmp(bstr, L"SeBackupPrivilege"), "got hr %#lx, %s\n", hr, wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+    IPrincipal2_Release(principal2);
+    IPrincipal_put_UserId(principal, (BSTR)L"S-1-5-18");
+    IPrincipal_Release(principal);
+
+    ITaskDefinition_get_Actions(taskdef, &actions);
+    IActionCollection_Create(actions, TASK_ACTION_EXEC, &action);
+    hr = IAction_QueryInterface(action, &IID_IExecAction2, (void **)&exec2);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+    IExecAction2_put_Path(exec2, (BSTR)L"a.exe");
+    IExecAction2_put_HideAppWindow(exec2, VARIANT_TRUE);
+    IExecAction2_Release(exec2);
+    IAction_Release(action);
+    IActionCollection_Release(actions);
+    ITaskSettings_get_Compatibility(settings, &compatibility);
+    ok(compatibility == TASK_COMPATIBILITY_V2_4, "got %d\n", compatibility);
+
+    hr = ITaskDefinition_get_XmlText(taskdef, &bstr);
+    ok(hr == S_OK, "get_XmlText error %#lx\n", hr);
+    ok(wcsstr(bstr, L"<Task version=\"1.6\" ") != NULL, "got %s\n", wine_dbgstr_w(bstr));
+    ok(wcsstr(bstr, L"      <RunLevel>LeastPrivilege</RunLevel>\r\n"
+                    "      <RequiredPrivileges>\r\n"
+                    "        <Privilege>SeBackupPrivilege</Privilege>\r\n"
+                    "      </RequiredPrivileges>\r\n") != NULL, "got %s\n", wine_dbgstr_w(bstr));
+    ok(wcsstr(bstr, L"    <UseUnifiedSchedulingEngine>false</UseUnifiedSchedulingEngine>\r\n"
+                    "    <MaintenanceSettings>\r\n"
+                    "      <Period>P2D</Period>\r\n"
+                    "      <Exclusive>false</Exclusive>\r\n"
+                    "    </MaintenanceSettings>\r\n"
+                    "    <Volatile>true</Volatile>\r\n"
+                    "    <WakeToRun>") != NULL, "got %s\n", wine_dbgstr_w(bstr));
+    ok(wcsstr(bstr, L"      <Command>a.exe</Command>\r\n      <HideAppWindow>true</HideAppWindow>\r\n") != NULL,
+       "got %s\n", wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+
+    /* and a lower version drops what it did not have */
+    hr = ITaskSettings_put_Compatibility(settings, TASK_COMPATIBILITY_V2);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = ITaskDefinition_get_XmlText(taskdef, &bstr);
+    ok(hr == S_OK, "get_XmlText error %#lx\n", hr);
+    ok(wcsstr(bstr, L"<Task version=\"1.2\" ") != NULL, "got %s\n", wine_dbgstr_w(bstr));
+    ok(!wcsstr(bstr, L"Volatile") && !wcsstr(bstr, L"HideAppWindow") && !wcsstr(bstr, L"Privilege>"),
+       "got %s\n", wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+
+    ITaskSettings3_Release(settings3);
+    ITaskSettings_Release(settings);
+
+    for (i = 0; i < ARRAY_SIZE(reads); ++i)
+    {
+        swprintf(buffer, ARRAY_SIZE(buffer), L"<Task version=\"%s\" "
+                 "xmlns=\"http://schemas.microsoft.com/windows/2004/02/mit/task\">%s"
+                 "<Actions><Exec><Command>a</Command></Exec></Actions></Task>", reads[i].version, reads[i].element);
+        hr = ITaskDefinition_put_XmlText(taskdef, buffer);
+        ok(hr == reads[i].hr, "%u: got %#lx, expected %#lx\n", i, hr, reads[i].hr);
+    }
+
+    ITaskDefinition_Release(taskdef);
+    ITaskService_Release(service);
+}
