+/* The objects speak for their interfaces through the type library, as a script finds them. */
+static void test_dispatch(void)
+{
+    ITaskService *service;
+    ITaskDefinition *taskdef;
+    ITriggerCollection *triggers;
+    ITaskSettings *settings;
+    IDispatch *disp, *object;
+    OLECHAR *name;
+    TYPEATTR *attr;
+    ITypeInfo *info;
+    VARIANT arg, result;
+    DISPID dispid;
+    UINT count;
+    BSTR bstr;
+    HRESULT hr;
+
+    taskdef = new_task_definition(&service);
+
+    hr = ITaskService_QueryInterface(service, &IID_IDispatch, (void **)&disp);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+    count = 7;
+    hr = IDispatch_GetTypeInfoCount(disp, &count);
+    ok(hr == S_OK && count == 1, "got hr %#lx, count %u\n", hr, count);
+    hr = IDispatch_GetTypeInfo(disp, 0, LOCALE_USER_DEFAULT, &info);
+    ok(hr == S_OK, "GetTypeInfo error %#lx\n", hr);
+    hr = ITypeInfo_GetTypeAttr(info, &attr);
+    ok(hr == S_OK, "GetTypeAttr error %#lx\n", hr);
+    ok(attr->typekind == TKIND_DISPATCH, "got kind %d\n", attr->typekind);
+    ok(attr->wTypeFlags == (TYPEFLAG_FDISPATCHABLE | TYPEFLAG_FNONEXTENSIBLE | TYPEFLAG_FDUAL),
+       "got flags %#x\n", attr->wTypeFlags);
+    ok(IsEqualGUID(&attr->guid, &IID_ITaskService), "got %s\n", wine_dbgstr_guid(&attr->guid));
+    ITypeInfo_ReleaseTypeAttr(info, attr);
+    ITypeInfo_Release(info);
+    hr = IDispatch_GetTypeInfo(disp, 1, LOCALE_USER_DEFAULT, &info);
+    ok(hr == DISP_E_BADINDEX, "got %#lx\n", hr);
+
+    name = (OLECHAR *)L"connected";
+    hr = IDispatch_GetIDsOfNames(disp, &IID_NULL, &name, 1, LOCALE_USER_DEFAULT, &dispid);
+    ok(hr == S_OK && dispid == 5, "got hr %#lx, dispid %ld\n", hr, dispid);
+    name = (OLECHAR *)L"Nonexistent";
+    hr = IDispatch_GetIDsOfNames(disp, &IID_NULL, &name, 1, LOCALE_USER_DEFAULT, &dispid);
+    ok(hr == DISP_E_UNKNOWNNAME, "got %#lx\n", hr);
+    VariantInit(&result);
+    hr = dispatch_call(disp, L"Connected", DISPATCH_PROPERTYGET, NULL, &result);
+    ok(hr == S_OK && V_VT(&result) == VT_BOOL && V_BOOL(&result) == VARIANT_TRUE, "got hr %#lx, vt %d\n", hr,
+       V_VT(&result));
+    IDispatch_Release(disp);
+
+    ITaskDefinition_QueryInterface(taskdef, &IID_IDispatch, (void **)&disp);
+    VariantInit(&result);
+    hr = dispatch_call(disp, L"RegistrationInfo", DISPATCH_PROPERTYGET, NULL, &result);
+    ok(hr == S_OK && V_VT(&result) == VT_DISPATCH, "got hr %#lx, vt %d\n", hr, V_VT(&result));
+    object = V_DISPATCH(&result);
+    V_VT(&arg) = VT_BSTR;
+    V_BSTR(&arg) = SysAllocString(L"through IDispatch");
+    hr = dispatch_call(object, L"Author", DISPATCH_PROPERTYPUT, &arg, NULL);
+    ok(hr == S_OK, "put Author error %#lx\n", hr);
+    VariantClear(&arg);
+    hr = IRegistrationInfo_get_Author((IRegistrationInfo *)object, &bstr);
+    ok(hr == S_OK && !wcscmp(bstr, L"through IDispatch"), "got hr %#lx, %s\n", hr, wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+    IDispatch_Release(object);
+
+    VariantInit(&result);
+    hr = dispatch_call(disp, L"Triggers", DISPATCH_PROPERTYGET, NULL, &result);
+    ok(hr == S_OK && V_VT(&result) == VT_DISPATCH, "got hr %#lx, vt %d\n", hr, V_VT(&result));
+    object = V_DISPATCH(&result);
+    V_VT(&arg) = VT_I4;
+    V_I4(&arg) = TASK_TRIGGER_DAILY;
+    VariantInit(&result);
+    hr = dispatch_call(object, L"Create", DISPATCH_METHOD, &arg, &result);
+    ok(hr == S_OK && V_VT(&result) == VT_DISPATCH, "got hr %#lx, vt %d\n", hr, V_VT(&result));
+    /* a daily trigger speaks for IDailyTrigger */
+    name = (OLECHAR *)L"DaysInterval";
+    hr = IDispatch_GetIDsOfNames(V_DISPATCH(&result), &IID_NULL, &name, 1, LOCALE_USER_DEFAULT, &dispid);
+    ok(hr == S_OK && dispid == 25, "got hr %#lx, dispid %ld\n", hr, dispid);
+    VariantClear(&result);
+    VariantInit(&result);
+    hr = IDispatch_Invoke(object, DISPID_NEWENUM, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_METHOD | DISPATCH_PROPERTYGET,
+                          &(DISPPARAMS){ 0 }, &result, NULL, NULL);
+    ok(hr == S_OK && V_VT(&result) == VT_UNKNOWN, "got hr %#lx, vt %d\n", hr, V_VT(&result));
+    VariantClear(&result);
+    IDispatch_Release(object);
+    IDispatch_Release(disp);
+
+    /* settings speak for ITaskSettings3, with what Windows 10 added */
+    ITaskDefinition_get_Settings(taskdef, &settings);
+    name = (OLECHAR *)L"Volatile";
+    hr = ITaskSettings_GetIDsOfNames(settings, &IID_NULL, &name, 1, LOCALE_USER_DEFAULT, &dispid);
+    ok(hr == S_OK && dispid == 42, "got hr %#lx, dispid %ld\n", hr, dispid);
+    ITaskSettings_Release(settings);
+
+    ITaskDefinition_get_Triggers(taskdef, &triggers);
+    ITriggerCollection_Release(triggers);
+    ITaskDefinition_Release(taskdef);
+    ITaskService_Release(service);
+}
