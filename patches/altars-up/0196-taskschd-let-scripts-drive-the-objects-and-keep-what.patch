+static void test_SecurityDescriptor(void)
+{
+    IRegistrationInfo *reginfo;
+    ITaskDefinition *taskdef;
+    ITaskService *service;
+    VARIANT sddl;
+    BSTR bstr;
+    HRESULT hr;
+
+    taskdef = new_task_definition(&service);
+    ITaskDefinition_get_RegistrationInfo(taskdef, &reginfo);
+
+    hr = IRegistrationInfo_get_XmlText(reginfo, &bstr);
+    ok(hr == E_NOTIMPL, "got %#lx\n", hr);
+
+    /* kept as text, whatever it is */
+    V_VT(&sddl) = VT_I4;
+    V_I4(&sddl) = 5;
+    hr = IRegistrationInfo_put_SecurityDescriptor(reginfo, sddl);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    VariantInit(&sddl);
+    hr = IRegistrationInfo_get_SecurityDescriptor(reginfo, &sddl);
+    ok(hr == S_OK && V_VT(&sddl) == VT_BSTR && !wcscmp(V_BSTR(&sddl), L"5"), "got hr %#lx, vt %d\n", hr, V_VT(&sddl));
+    VariantClear(&sddl);
+
+    IRegistrationInfo_put_URI(reginfo, (BSTR)L"\\uri");
+    V_VT(&sddl) = VT_BSTR;
+    V_BSTR(&sddl) = SysAllocString(L"");
+    hr = IRegistrationInfo_put_SecurityDescriptor(reginfo, sddl);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    VariantClear(&sddl);
+    hr = ITaskDefinition_get_XmlText(taskdef, &bstr);
+    ok(hr == S_OK, "get_XmlText error %#lx\n", hr);
+    ok(wcsstr(bstr, L"    <URI>\\uri</URI>\r\n    <SecurityDescriptor></SecurityDescriptor>\r\n") != NULL,
+       "got %s\n", wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+
+    V_VT(&sddl) = VT_NULL;
+    hr = IRegistrationInfo_put_SecurityDescriptor(reginfo, sddl);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    VariantInit(&sddl);
+    hr = IRegistrationInfo_get_SecurityDescriptor(reginfo, &sddl);
+    ok(hr == S_OK && V_VT(&sddl) == VT_NULL, "got hr %#lx, vt %d\n", hr, V_VT(&sddl));
+    hr = ITaskDefinition_get_XmlText(taskdef, &bstr);
+    ok(hr == S_OK && !wcsstr(bstr, L"SecurityDescriptor"), "got hr %#lx, %s\n", hr, wine_dbgstr_w(bstr));
+    SysFreeString(bstr);
+
+    IRegistrationInfo_Release(reginfo);
+    ITaskDefinition_Release(taskdef);
+    ITaskService_Release(service);
+}
