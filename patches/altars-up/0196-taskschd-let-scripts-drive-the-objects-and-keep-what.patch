+        ITrigger_Release(trigger);
+    }
+    hr = ITriggerCollection_get__NewEnum(triggers, &unk);
+    ok(hr == S_OK, "get__NewEnum error %#lx\n", hr);
+    hr = IUnknown_QueryInterface(unk, &IID_IEnumVARIANT, (void **)&enumvar);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+    IUnknown_Release(unk);
+
+    for (i = 0; i < 4; ++i) VariantInit(&v[i]);
+    hr = IEnumVARIANT_Next(enumvar, 1, v, &fetched);
+    ok(hr == S_OK && fetched == 1 && V_VT(&v[0]) == VT_DISPATCH, "got hr %#lx, %lu, vt %d\n", hr, fetched, V_VT(&v[0]));
+    VariantClear(&v[0]);
+    hr = IEnumVARIANT_Next(enumvar, 4, v, &fetched);
+    ok(hr == S_FALSE && fetched == 2, "got hr %#lx, %lu\n", hr, fetched);
+    for (i = 0; i < 4; ++i) VariantClear(&v[i]);
+    hr = IEnumVARIANT_Reset(enumvar);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumVARIANT_Skip(enumvar, 1);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumVARIANT_Clone(enumvar, &clone);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    hr = IEnumVARIANT_Skip(enumvar, 5);
+    ok(hr == S_FALSE, "got %#lx\n", hr);
+    hr = IEnumVARIANT_Next(enumvar, 1, v, &fetched);
+    ok(hr == S_FALSE && !fetched, "got hr %#lx, %lu\n", hr, fetched);
+    hr = IEnumVARIANT_Next(clone, 1, v, NULL);
+    ok(hr == S_OK && V_VT(&v[0]) == VT_DISPATCH, "got hr %#lx, vt %d\n", hr, V_VT(&v[0]));
+    VariantClear(&v[0]);
+
+    IEnumVARIANT_Release(clone);
+    IEnumVARIANT_Release(enumvar);
+    ITriggerCollection_Release(triggers);
+    ITaskDefinition_Release(taskdef);
+    ITaskService_Release(service);
+}
