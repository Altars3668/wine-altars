+static void write_email_action(struct xml_writer *writer, IAction *action, BSTR id)
+{
+    static const WCHAR * const names[] = { L"Server", L"Subject", L"To", L"Cc", L"Bcc", L"ReplyTo", L"From", L"Body" };
+    ITaskNamedValueCollection *fields = NULL;
+    SAFEARRAY *attachments = NULL;
+    ITaskNamedValuePair *pair;
+    BSTR values[ARRAY_SIZE(names)], name, value;
+    LONG count = 0, lower, upper, i;
+    IEmailAction *email;
+    VARIANT file;
+
+    if (FAILED(IAction_QueryInterface(action, &IID_IEmailAction, (void **)&email))) return;
+    GET_STRING(IEmailAction, email, Server, values[0]);
+    GET_STRING(IEmailAction, email, Subject, values[1]);
+    GET_STRING(IEmailAction, email, To, values[2]);
+    GET_STRING(IEmailAction, email, Cc, values[3]);
+    GET_STRING(IEmailAction, email, Bcc, values[4]);
+    GET_STRING(IEmailAction, email, ReplyTo, values[5]);
+    GET_STRING(IEmailAction, email, From, values[6]);
+    GET_STRING(IEmailAction, email, Body, values[7]);
+    if (SUCCEEDED(IEmailAction_get_HeaderFields(email, &fields)) && fields)
+        ITaskNamedValueCollection_get_Count(fields, &count);
+    if (FAILED(IEmailAction_get_Attachments(email, &attachments))) attachments = NULL;
+
+    /* the body, the header fields and the attachments are always there, if only empty */
+    write_element(writer, L"SendEmail", L"id", id);
+    for (i = 0; i < ARRAY_SIZE(names) - 1; ++i) write_text_value(writer, names[i], values[i]);
+    if (values[7]) write_text_value(writer, L"Body", values[7]);
+    else write_empty_element(writer, L"Body", NULL, NULL);
+    if (!count) write_empty_element(writer, L"HeaderFields", NULL, NULL);
+    else
+    {
+        write_element(writer, L"HeaderFields", NULL, NULL);
+        for (i = 1; i <= count; ++i)
+        {
+            if (FAILED(ITaskNamedValueCollection_get_Item(fields, i, &pair))) continue;
+            GET_STRING(ITaskNamedValuePair, pair, Name, name);
+            GET_STRING(ITaskNamedValuePair, pair, Value, value);
+            write_element(writer, L"HeaderField", NULL, NULL);
+            write_text_value(writer, L"Name", name);
+            write_text_value(writer, L"Value", value);
+            write_element_end(writer, L"HeaderField");
+            SysFreeString(name);
+            SysFreeString(value);
+            ITaskNamedValuePair_Release(pair);
+        }
+        write_element_end(writer, L"HeaderFields");
+    }
+    if (attachments && SUCCEEDED(SafeArrayGetLBound(attachments, 1, &lower)) &&
+        SUCCEEDED(SafeArrayGetUBound(attachments, 1, &upper)) && lower <= upper)
+    {
+        write_element(writer, L"Attachments", NULL, NULL);
+        for (i = lower; i <= upper; ++i)
+        {
+            VariantInit(&file);
+            if (SUCCEEDED(SafeArrayGetElement(attachments, &i, &file)) && V_VT(&file) == VT_BSTR)
+                write_text_value(writer, L"File", V_BSTR(&file));
+            VariantClear(&file);
+        }
+        write_element_end(writer, L"Attachments");
+    }
+    else write_empty_element(writer, L"Attachments", NULL, NULL);
+    write_element_end(writer, L"SendEmail");
+    for (i = 0; i < ARRAY_SIZE(names); ++i) SysFreeString(values[i]);
+    if (attachments) SafeArrayDestroy(attachments);
+    if (fields) ITaskNamedValueCollection_Release(fields);
+    IEmailAction_Release(email);
+}
