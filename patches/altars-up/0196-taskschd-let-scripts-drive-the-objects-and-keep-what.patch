+static HRESULT read_attachments(IXmlReader *reader, IEmailAction *email)
+{
+    const WCHAR *name, *value;
+    SAFEARRAY *array = NULL;
+    SAFEARRAYBOUND bound;
+    LONG count = 0;
+    VARIANT file;
+    UINT depth;
+    HRESULT hr;
+
+    if ((hr = element_depth(reader, &depth)) != S_OK) return FAILED(hr) ? hr : S_OK;
+
+    while ((hr = next_child(reader, depth, &name)) == S_OK)
+    {
+        if (wcscmp(name, L"File"))
+        {
+            WARN("unexpected Attachments element %s\n", debugstr_w(name));
+            hr = SCHED_E_UNEXPECTEDNODE;
+            break;
+        }
+        if ((hr = read_text_value(reader, &value)) != S_OK) break;
+        if (!array)
+        {
+            if (!(array = SafeArrayCreateVector(VT_VARIANT, 0, 1)))
+            {
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+        }
+        else
+        {
+            bound.lLbound = 0;
+            bound.cElements = count + 1;
+            if (FAILED(hr = SafeArrayRedim(array, &bound))) break;
+        }
+        V_VT(&file) = VT_BSTR;
+        if (!(V_BSTR(&file) = SysAllocString(value)))
+        {
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        hr = SafeArrayPutElement(array, &count, &file);
+        VariantClear(&file);
+        if (FAILED(hr)) break;
+        count++;
+    }
+
+    if (SUCCEEDED(hr) && array) hr = IEmailAction_put_Attachments(email, array);
+    if (array) SafeArrayDestroy(array);
     return FAILED(hr) ? hr : S_OK;
 }
 
+/* An email goes from someone through a server to someone. */
+static HRESULT read_email_action(IXmlReader *reader, IActionCollection *actions)
+{
+    static const WCHAR * const names[] = { L"Server", L"Subject", L"To", L"Cc", L"Bcc", L"ReplyTo", L"From", L"Body" };
+    const WCHAR *name, *value;
+    BOOL seen[ARRAY_SIZE(names)] = {0};
+    IEmailAction *email;
+    unsigned int i;
+    UINT depth;
+    HRESULT hr;
+
+    if (FAILED(hr = read_action_start(reader, actions, TASK_ACTION_SEND_EMAIL, &IID_IEmailAction, (void **)&email)))
+        return hr;
+
+    if ((hr = element_depth(reader, &depth)) == S_OK)
+    {
+        while ((hr = next_child(reader, depth, &name)) == S_OK)
+        {
+            if (!wcscmp(name, L"HeaderFields")) hr = read_header_fields(reader, email);
+            else if (!wcscmp(name, L"Attachments")) hr = read_attachments(reader, email);
+            else
+            {
+                for (i = 0; i < ARRAY_SIZE(names); ++i)
+                    if (!wcscmp(name, names[i])) break;
+                if (i == ARRAY_SIZE(names))
+                {
+                    WARN("unexpected SendEmail element %s\n", debugstr_w(name));
+                    hr = SCHED_E_UNEXPECTEDNODE;
+                }
+                else if ((hr = read_text_value(reader, &value)) == S_OK)
+                {
+                    seen[i] = TRUE;
+                    switch (i)
+                    {
+                    case 0: hr = IEmailAction_put_Server(email, (BSTR)value); break;
+                    case 1: hr = IEmailAction_put_Subject(email, (BSTR)value); break;
+                    case 2: hr = IEmailAction_put_To(email, (BSTR)value); break;
+                    case 3: hr = IEmailAction_put_Cc(email, (BSTR)value); break;
+                    case 4: hr = IEmailAction_put_Bcc(email, (BSTR)value); break;
+                    case 5: hr = IEmailAction_put_ReplyTo(email, (BSTR)value); break;
+                    case 6: hr = IEmailAction_put_From(email, (BSTR)value); break;
+                    case 7: hr = IEmailAction_put_Body(email, (BSTR)value); break;
+                    }
+                }
+            }
+            if (hr != S_OK) break;
+        }
+    }
+
+    IEmailAction_Release(email);
+    if (FAILED(hr)) return hr;
+    /* a server, a sender, and a recipient of some kind */
+    return seen[0] && seen[6] && (seen[2] || seen[3] || seen[4]) ? S_OK : SCHED_E_MISSINGNODE;
+}
