+    hr = ITaskService_NewTask(*service, 0, &taskdef);
+    ok(hr == S_OK, "NewTask error %#lx\n", hr);
+    return taskdef;
+}
+
+static HRESULT dispatch_call(IDispatch *disp, const WCHAR *name, WORD flags, VARIANT *arg, VARIANT *result)
+{
+    DISPID dispid, put = DISPID_PROPERTYPUT;
+    DISPPARAMS params = { arg, NULL, arg ? 1 : 0, 0 };
+    OLECHAR *names = (OLECHAR *)name;
+    HRESULT hr;
+
+    hr = IDispatch_GetIDsOfNames(disp, &IID_NULL, &names, 1, LOCALE_USER_DEFAULT, &dispid);
+    if (FAILED(hr)) return hr;
+    if (flags & DISPATCH_PROPERTYPUT)
+    {
+        params.rgdispidNamedArgs = &put;
+        params.cNamedArgs = 1;
+    }
+    return IDispatch_Invoke(disp, dispid, &IID_NULL, LOCALE_USER_DEFAULT, flags, &params, result, NULL, NULL);
+}
