+/* the Ex functions say whether the timer or the wait was set, and they replace that setting */
+static void test_tp_set_ex(void)
+{
+    TP_CALLBACK_ENVIRON environment;
+    struct wait_info info;
+    HANDLE semaphore, event;
+    LARGE_INTEGER when;
+    FILETIME due;
+    NTSTATUS status;
+    TP_TIMER *timer;
+    TP_WAIT *wait;
+    TP_POOL *pool;
+    DWORD result;
+    BOOL ret;
+
+    if (!pTpSetTimerEx || !pTpSetWaitEx)
+    {
+        win_skip("TpSetTimerEx or TpSetWaitEx is not available\n");
+        return;
+    }
+
+    semaphore = CreateSemaphoreA(NULL, 0, 1, NULL);
+    status = pTpAllocPool(&pool, NULL);
+    ok(!status, "TpAllocPool failed with status %lx\n", status);
+    memset(&environment, 0, sizeof(environment));
+    environment.Version = 1;
+    environment.Pool = pool;
+
+    status = pTpAllocTimer(&timer, timer_cb, semaphore, &environment);
+    ok(!status, "TpAllocTimer failed with status %lx\n", status);
+    ret = pTpSetTimerEx(timer, NULL, 0, 0);
+    ok(!ret, "got %d\n", ret);
+    when.QuadPart = (ULONGLONG)10000 * -10000;
+    ret = pTpSetTimerEx(timer, &when, 0, 0);
+    ok(!ret, "got %d\n", ret);
+    ret = pTpSetTimerEx(timer, &when, 0, 0);
+    ok(ret, "got %d\n", ret);
+    ret = pTpSetTimerEx(timer, NULL, 0, 0);
+    ok(ret, "got %d\n", ret);
+    ret = pTpSetTimerEx(timer, NULL, 0, 0);
+    ok(!ret, "got %d\n", ret);
+
+    /* a timer that has gone off */
+    when.QuadPart = (ULONGLONG)1 * -10000;
+    ret = pTpSetTimerEx(timer, &when, 0, 0);
+    ok(!ret, "got %d\n", ret);
+    result = WaitForSingleObject(semaphore, 1000);
+    ok(result == WAIT_OBJECT_0, "WaitForSingleObject returned %lu\n", result);
+    pTpWaitForTimer(timer, FALSE);
+    ret = pTpSetTimerEx(timer, NULL, 0, 0);
+    ok(!ret, "got %d after the timer went off\n", ret);
+
+    /* a periodic timer that has gone off */
+    ret = pTpSetTimerEx(timer, &when, 50, 0);
+    ok(!ret, "got %d\n", ret);
+    result = WaitForSingleObject(semaphore, 1000);
+    ok(result == WAIT_OBJECT_0, "WaitForSingleObject returned %lu\n", result);
+    ret = pTpSetTimerEx(timer, NULL, 0, 0);
+    ok(ret, "got %d after the periodic timer went off\n", ret);
+    pTpWaitForTimer(timer, TRUE);
+
+    if (pSetThreadpoolTimerEx)
+    {
+        when.QuadPart = (ULONGLONG)10000 * -10000;
+        due.dwLowDateTime = when.u.LowPart;
+        due.dwHighDateTime = when.u.HighPart;
+        ret = pSetThreadpoolTimerEx(timer, &due, 0, 0);
+        ok(!ret, "got %d\n", ret);
+        ret = pSetThreadpoolTimerEx(timer, NULL, 0, 0);
+        ok(ret, "got %d\n", ret);
+    }
+    else win_skip("SetThreadpoolTimerEx is not available\n");
+    pTpReleaseTimer(timer);
+
+    event = CreateEventW(NULL, FALSE, FALSE, NULL);
+    info.semaphore = semaphore;
+    info.userdata = 0;
+    status = pTpAllocWait(&wait, wait_cb, &info, &environment);
+    ok(!status, "TpAllocWait failed with status %lx\n", status);
+    ret = pTpSetWaitEx(wait, NULL, NULL, NULL);
+    ok(!ret, "got %d\n", ret);
+    ret = pTpSetWaitEx(wait, event, NULL, NULL);
+    ok(!ret, "got %d\n", ret);
+    ret = pTpSetWaitEx(wait, event, NULL, NULL);
+    ok(ret, "got %d\n", ret);
+    ret = pTpSetWaitEx(wait, NULL, NULL, NULL);
+    ok(ret, "got %d\n", ret);
+    ret = pTpSetWaitEx(wait, NULL, NULL, NULL);
+    ok(!ret, "got %d\n", ret);
+
+    /* a wait that has been satisfied */
+    ret = pTpSetWaitEx(wait, event, NULL, NULL);
+    ok(!ret, "got %d\n", ret);
+    SetEvent(event);
+    result = WaitForSingleObject(semaphore, 1000);
+    ok(result == WAIT_OBJECT_0, "WaitForSingleObject returned %lu\n", result);
+    pTpWaitForWait(wait, FALSE);
+    ret = pTpSetWaitEx(wait, NULL, NULL, NULL);
+    ok(!ret, "got %d after the wait was satisfied\n", ret);
+
+    if (pSetThreadpoolWaitEx)
+    {
+        ret = pSetThreadpoolWaitEx(wait, event, NULL, NULL);
+        ok(!ret, "got %d\n", ret);
+        ret = pSetThreadpoolWaitEx(wait, NULL, NULL, NULL);
+        ok(ret, "got %d\n", ret);
+    }
+    else win_skip("SetThreadpoolWaitEx is not available\n");
+    pTpReleaseWait(wait);
+
+    CloseHandle(event);
+    pTpReleasePool(pool);
+    CloseHandle(semaphore);
+}
+
 static void test_tp_multi_wait(void)
 {
     TP_POOL_STACK_INFORMATION stack_info;
@@ -2512,6 +2633,7 @@ START_TEST(threadpool)
     test_tp_instance();
     test_tp_disassociate();
     test_tp_timer();
+    test_tp_set_ex();
     test_tp_window_length();
     test_tp_wait();
     test_tp_multi_wait();
diff --git a/dlls/ntdll/threadpool.c b/dlls/ntdll/threadpool.c
index b47a26775ea..110c9f6ad28 100644
--- a/dlls/ntdll/threadpool.c
+++ b/dlls/ntdll/threadpool.c
@@ -3073,7 +3073,7 @@ BOOL WINAPI TpSetPoolMinThreads( TP_POOL *pool, DWORD minimum )
 static BOOL tp_set_timer( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period, LONG window_length )
 {
     struct threadpool_object *this = impl_from_TP_TIMER( timer );
-    BOOL submit_timer = FALSE, was_timer_set;
+    BOOL submit_timer = FALSE, was_timer_pending;
     struct threadpool_object *other_timer;
     struct list *pending_timers;
     ULONGLONG timestamp;
@@ -3084,7 +3084,9 @@ static BOOL tp_set_timer( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period,
 
     assert( this->u.timer.timer_initialized );
 
-    was_timer_set = this->u.timer.timer_set;
+    /* what is returned is whether the timer was still to go off: one that went off, and does not go
+     * off again, stays set, but is no longer pending */
+    was_timer_pending = this->u.timer.timer_pending;
     this->u.timer.timer_set = timeout != NULL;
 
     /* Convert relative timeout to absolute timestamp and handle a timeout
@@ -3157,7 +3159,7 @@ static BOOL tp_set_timer( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period,
     if (submit_timer)
        tp_object_submit( this, FALSE );
 
-    return was_timer_set;
+    return was_timer_pending;
 }
 
 /***********************************************************************
@@ -3180,20 +3182,17 @@ BOOL WINAPI TpSetTimerEx( TP_TIMER *timer, LARGE_INTEGER *timeout, LONG period,
     return tp_set_timer( timer, timeout, period, window_length );
 }
 
-/***********************************************************************
- *           TpSetWait    (NTDLL.@)
- */
-VOID WINAPI TpSetWait( TP_WAIT *wait, HANDLE handle, LARGE_INTEGER *timeout )
+/* sets or cancels the wait; returns whether it was set, waiting for its object */
+static BOOL tp_set_wait( TP_WAIT *wait, HANDLE handle, LARGE_INTEGER *timeout )
 {
     struct threadpool_object *this = impl_from_TP_WAIT( wait );
     ULONGLONG timestamp = MAXLONGLONG;
-    BOOL same_handle;
-
-    TRACE( "%p %p %p\n", wait, handle, timeout );
+    BOOL same_handle, was_set;
 
     RtlEnterCriticalSection( &waitqueue.cs );
 
     assert( this->u.wait.bucket );
+    was_set = this->u.wait.wait_pending;
 
     same_handle = this->u.wait.handle == handle;
     tp_wait_close_duped_handle( this );
@@ -3241,6 +3240,25 @@ VOID WINAPI TpSetWait( TP_WAIT *wait, HANDLE handle, LARGE_INTEGER *timeout )
     }
 
     RtlLeaveCriticalSection( &waitqueue.cs );
+    return was_set;
+}
+
+/***********************************************************************
+ *           TpSetWait    (NTDLL.@)
+ */
+VOID WINAPI TpSetWait( TP_WAIT *wait, HANDLE handle, LARGE_INTEGER *timeout )
+{
+    TRACE( "%p %p %p\n", wait, handle, timeout );
+    tp_set_wait( wait, handle, timeout );
+}
+
+/***********************************************************************
+ *           TpSetWaitEx    (NTDLL.@)
+ */
+BOOL WINAPI TpSetWaitEx( TP_WAIT *wait, HANDLE handle, LARGE_INTEGER *timeout, void *reserved )
+{
+    TRACE( "%p %p %p %p\n", wait, handle, timeout, reserved );
+    return tp_set_wait( wait, handle, timeout );
 }
 
 /***********************************************************************
