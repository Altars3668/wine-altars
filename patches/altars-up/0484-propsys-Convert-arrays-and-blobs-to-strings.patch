From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:01 -0400
Subject: [PATCH] propsys: Convert arrays and blobs to strings.

VariantToString and PropVariantToStringAlloc join the elements of an
array with "; ", as Windows 11 does, a blob becomes its bytes in hex, and
a string that does not fit is cut to the buffer with
STRSAFE_E_INSUFFICIENT_BUFFER (tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/propsys/propvar.c b/dlls/propsys/propvar.c
index e871ee366be..ee669298dfc 100644
--- a/dlls/propsys/propvar.c
+++ b/dlls/propsys/propvar.c
@@ -537,6 +537,31 @@ static size_t vector_elem_size(VARTYPE vt)
     return 0;
 }
 
+/* the elements of an array, each as it would be alone, between semicolons */
+static HRESULT string_buffer_append_array(struct string_buffer *buffer, VARTYPE vt, SAFEARRAY *array)
+{
+    size_t size = vector_elem_size(vt);
+    ULONG count = 1, i;
+    const BYTE *elem;
+    HRESULT hr = S_OK;
+
+    if (!array) return S_OK;
+    if (!size || size != array->cbElements)
+    {
+        FIXME("Unsupported conversion (%d)\n", vt | VT_ARRAY);
+        return E_FAIL;
+    }
+    for (i = 0; i < array->cDims; i++) count *= array->rgsabound[i].cElements;
+    if (FAILED(hr = SafeArrayAccessData(array, (void **)&elem))) return hr;
+    for (i = 0; SUCCEEDED(hr) && i < count; i++, elem += size)
+    {
+        if (i && !string_buffer_append(buffer, L"; ", 2)) hr = E_OUTOFMEMORY;
+        else hr = string_buffer_append_value(buffer, vt, elem);
+    }
+    SafeArrayUnaccessData(array);
+    return hr;
+}
+
 HRESULT WINAPI PropVariantToStringAlloc(REFPROPVARIANT propvarIn, WCHAR **ret)
 {
     struct string_buffer buffer = {0};
@@ -565,7 +590,21 @@ HRESULT WINAPI PropVariantToStringAlloc(REFPROPVARIANT propvarIn, WCHAR **ret)
     }
     else if (propvarIn->vt == VT_CLSID)
         hr = string_buffer_append_value(&buffer, VT_CLSID, propvarIn->puuid);
-    else if (propvarIn->vt & (VT_ARRAY | VT_BYREF))
+    else if (propvarIn->vt == VT_BLOB)
+    {
+        /* the bytes in hexadecimal */
+        WCHAR digits[3];
+        ULONG i;
+
+        for (i = 0; SUCCEEDED(hr) && i < propvarIn->blob.cbSize; i++)
+        {
+            swprintf(digits, ARRAY_SIZE(digits), L"%02X", propvarIn->blob.pBlobData[i]);
+            if (!string_buffer_append(&buffer, digits, 2)) hr = E_OUTOFMEMORY;
+        }
+    }
+    else if (propvarIn->vt & VT_ARRAY)
+        hr = string_buffer_append_array(&buffer, propvarIn->vt & VT_TYPEMASK, propvarIn->parray);
+    else if (propvarIn->vt & VT_BYREF)
     {
         FIXME("Unsupported conversion (%d)\n", propvarIn->vt);
         hr = E_FAIL;
@@ -634,16 +673,21 @@ HRESULT WINAPI VariantToString(REFVARIANT var, PWSTR ret, UINT cch)
     if (!cch)
         return E_INVALIDARG;
 
-    if (V_VT(var) & (VT_ARRAY | VT_BYREF))
+    if (V_VT(var) & VT_BYREF)
     {
         FIXME("Unsupported type %d.\n", V_VT(var));
         return E_NOTIMPL;
     }
 
-    if (SUCCEEDED(hr = string_buffer_append_value(&buffer, V_VT(var), &V_I1(var))) && buffer.str)
+    if (V_VT(var) & VT_ARRAY)
+        hr = string_buffer_append_array(&buffer, V_VT(var) & VT_TYPEMASK, V_ARRAY(var));
+    else
+        hr = string_buffer_append_value(&buffer, V_VT(var), &V_I1(var));
+    /* what does not fit is cut off */
+    if (SUCCEEDED(hr) && buffer.str)
     {
         if (buffer.len > cch - 1) hr = STRSAFE_E_INSUFFICIENT_BUFFER;
-        else wcscpy(ret, buffer.str);
+        lstrcpynW(ret, buffer.str, cch);
     }
     CoTaskMemFree(buffer.str);
     return hr;
diff --git a/dlls/propsys/tests/propsys.c b/dlls/propsys/tests/propsys.c
index 679a73687be..7e249c3846b 100644
--- a/dlls/propsys/tests/propsys.c
+++ b/dlls/propsys/tests/propsys.c
@@ -2819,6 +2819,46 @@ static void test_VariantToString(void)
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     ok(!wcscmp(buff, L"test1"), "Unexpected string.\n");
     VariantClear(&v);
+
+    /* an array: its elements between semicolons, and what does not fit cut off */
+    {
+        static const BYTE bytes[] = { 0x41, 0x42, 0x43 };
+        SAFEARRAY *array = SafeArrayCreateVector(VT_UI1, 0, ARRAY_SIZE(bytes));
+        LONG i;
+
+        for (i = 0; i < ARRAY_SIZE(bytes); i++) SafeArrayPutElement(array, &i, (void *)&bytes[i]);
+        V_VT(&v) = VT_ARRAY | VT_UI1;
+        V_ARRAY(&v) = array;
+        hr = VariantToString(&v, buff, ARRAY_SIZE(buff));
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(!wcscmp(buff, L"65; 66; 67"), "Unexpected buffer %s.\n", wine_dbgstr_w(buff));
+        hr = VariantToString(&v, buff, 3);
+        ok(hr == STRSAFE_E_INSUFFICIENT_BUFFER, "Unexpected hr %#lx.\n", hr);
+        ok(!wcscmp(buff, L"65"), "Unexpected buffer %s.\n", wine_dbgstr_w(buff));
+        SafeArrayDestroy(array);
+
+        array = SafeArrayCreateVector(VT_I4, 0, 3);
+        for (i = 0; i < 3; i++)
+        {
+            LONG n = i + 1;
+            SafeArrayPutElement(array, &i, &n);
+        }
+        V_VT(&v) = VT_ARRAY | VT_I4;
+        V_ARRAY(&v) = array;
+        hr = VariantToString(&v, buff, ARRAY_SIZE(buff));
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(!wcscmp(buff, L"1; 2; 3"), "Unexpected buffer %s.\n", wine_dbgstr_w(buff));
+        SafeArrayDestroy(array);
+
+        array = SafeArrayCreateVector(VT_UI1, 0, 0);
+        V_VT(&v) = VT_ARRAY | VT_UI1;
+        V_ARRAY(&v) = array;
+        buff[0] = 1;
+        hr = VariantToString(&v, buff, ARRAY_SIZE(buff));
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(!buff[0], "Unexpected buffer %s.\n", wine_dbgstr_w(buff));
+        SafeArrayDestroy(array);
+    }
 }
 
 #define check_VariantToPropVariant(var, propvar, type, member, value, format) do                     \
