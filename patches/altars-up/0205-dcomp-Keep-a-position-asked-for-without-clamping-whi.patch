From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 07:09:46 -0400
Subject: [PATCH] dcomp: Keep a position asked for without clamping while an
 idle tracker's bounds move toward it.

An idle InteractionTracker whose bounds animations move clamped the position it
had into them each frame, so a position asked for with
InteractionTrackerClampingOption_Disabled ahead of bounds still catching up was
dragged along by the nearer bound and left where that bound stopped.  The
position asked for is now kept: the bounds clamp where the tracker is shown, and
it goes there once they allow it; a new request, an adjustment or leaving the
idle state ends that.

Office's scrolling layer scrolls this way while the content's size animates.
Its bounds round to whole pixels a pixel apart, so the tracker came to rest one
pixel short of where Word scrolled; Word then asked for the same place again,
began another scroll animation that never ended, and kept an Excel worksheet
active in place hidden.  With this it stays shown.

Not measured on Windows yet: the reference machine's session is locked, and a
locked session draws no composition frames (tools/trackerprobe/clamp.c waits
for it).  The documentation says only that an idle tracker's position is always
within its bounds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 6d8710181f435606f8db6add95fa25187d780864)

diff --git a/dlls/dcomp/interaction.c b/dlls/dcomp/interaction.c
index 2fc6759e872..5bfeadcd5cf 100644
--- a/dlls/dcomp/interaction.c
+++ b/dlls/dcomp/interaction.c
@@ -167,6 +167,8 @@ struct tracker
     INT32 request_id;
 
     Vector3 position, min_position, max_position, natural_resting_position, position_velocity;
+    Vector3 unclamped_position;     /* where a request without clamping put it, while the bounds keep it elsewhere */
+    BOOL position_unclamped;
     FLOAT scale, min_scale, max_scale, natural_resting_scale, scale_velocity;
     boolean position_rounding;
     IReference_Vector3 *position_decay;
@@ -1682,6 +1684,9 @@ static void tracker_tell_owner_args( struct tracker *tracker, enum tracker_callb
     struct owner_call *call;
     boolean queued = FALSE;
 
+    TRACE( "tracker %p, callback %u, request %d, position %f,%f,%f, scale %f.\n", tracker, kind, request_id,
+           tracker->position.X, tracker->position.Y, tracker->position.Z, tracker->scale );
+
     if (!tracker->owner || !(queue = compositor_dispatcher_queue( tracker->base.compositor ))) return;
     if (!(call = calloc( 1, sizeof(*call) ))) return;
     if (!(call->args = args_create( kind, request_id, tracker->position, tracker->scale )))
@@ -1755,6 +1760,21 @@ static void tracker_clamp( struct tracker *tracker, BOOL position_unclamped )
     tracker->position.Z = clampf( tracker->position.Z, low.Z, max( low.Z, high.Z ) );
 }
 
+/*
+ * Keeps an idle tracker within its bounds as they change.  A position a request
+ * asked for without clamping is kept: the bounds clamp where the tracker is,
+ * and it goes there once they allow it.  Office scrolls so, to where the bounds
+ * its content's size animates will reach, and waits for the tracker to get there.
+ */
+static void tracker_clamp_idle( struct tracker *tracker )
+{
+    if (tracker->position_unclamped) tracker->position = tracker->unclamped_position;
+    tracker_clamp( tracker, FALSE );
+    if (tracker->position_unclamped &&
+        !memcmp( &tracker->position, &tracker->unclamped_position, sizeof(tracker->position) ))
+        tracker->position_unclamped = FALSE;
+}
+
 /* Copy the axes one partner shares, without recursively notifying the source. */
 static void tracker_copy_bound_axes( struct tracker *tracker, struct tracker *other, unsigned int mode )
 {
@@ -1823,7 +1843,11 @@ static void tracker_scale_about( struct tracker *tracker, float old, float new,
 static BOOL tracker_request( struct tracker *tracker, INT32 *id )
 {
     *id = ++tracker->request_id;
-    if (tracker->state != TRACKER_INTERACTING) return TRUE;
+    if (tracker->state != TRACKER_INTERACTING)
+    {
+        tracker->position_unclamped = FALSE;
+        return TRUE;
+    }
     TRACE( "tracker %p ignores request %d.\n", tracker, *id );
     tracker_tell_owner( tracker, CALLBACK_REQUEST_IGNORED, *id );
     return FALSE;
@@ -1863,6 +1887,7 @@ static void tracker_enter( struct tracker *tracker, enum tracker_state state, IN
 
     TRACE( "tracker %p enters state %u for request %d.\n", tracker, state, request_id );
     tracker->state = state;
+    if (state != TRACKER_IDLE) tracker->position_unclamped = FALSE;
     tracker->motion_request = request_id;
     tracker_tell_owner_args( tracker, callbacks[state], request_id, inertia );
     compositor_changed( tracker->base.compositor );
@@ -2139,7 +2164,7 @@ void trackers_frame( struct compositor *compositor )
             continue;
         case TRACKER_IDLE:
             if (list_empty( &tracker->base.animations )) continue;
-            tracker_clamp( tracker, FALSE );
+            tracker_clamp_idle( tracker );
             if (!memcmp( &position, &tracker->position, sizeof(position) ) && scale == tracker->scale) continue;
             tracker->natural_resting_position = tracker->position;
             tracker->natural_resting_scale = tracker->scale;
@@ -2198,6 +2223,8 @@ static HRESULT tracker_update_position( struct tracker *tracker, Vector3 value,
         }
         tracker->position = value;
         tracker_clamp( tracker, !clamp );
+        tracker->unclamped_position = value;
+        tracker->position_unclamped = !clamp;
         tracker->natural_resting_position = tracker->position;
         if (!tracker->scale_motion) tracker->natural_resting_scale = tracker->scale;
         tracker_values_changed( tracker, id );
@@ -2810,7 +2837,7 @@ static HRESULT WINAPI tracker_put_MaxPosition( IInteractionTracker *iface, Vecto
 
     compositor_lock( tracker->base.compositor );
     tracker->max_position = value;
-    tracker_clamp( tracker, 0 );
+    tracker_clamp_idle( tracker );
     compositor_changed( tracker->base.compositor );
     compositor_unlock( tracker->base.compositor );
     return S_OK;
@@ -2838,7 +2865,7 @@ static HRESULT WINAPI tracker_put_MaxScale( IInteractionTracker *iface, FLOAT va
     compositor_lock( tracker->base.compositor );
     tracker->max_scale = value;
     ++tracker->request_id;
-    tracker_clamp( tracker, 0 );
+    tracker_clamp_idle( tracker );
     compositor_changed( tracker->base.compositor );
     compositor_unlock( tracker->base.compositor );
     return S_OK;
@@ -2865,7 +2892,7 @@ static HRESULT WINAPI tracker_put_MinPosition( IInteractionTracker *iface, Vecto
 
     compositor_lock( tracker->base.compositor );
     tracker->min_position = value;
-    tracker_clamp( tracker, 0 );
+    tracker_clamp_idle( tracker );
     compositor_changed( tracker->base.compositor );
     compositor_unlock( tracker->base.compositor );
     return S_OK;
@@ -2893,7 +2920,7 @@ static HRESULT WINAPI tracker_put_MinScale( IInteractionTracker *iface, FLOAT va
     compositor_lock( tracker->base.compositor );
     tracker->min_scale = value;
     ++tracker->request_id;
-    tracker_clamp( tracker, 0 );
+    tracker_clamp_idle( tracker );
     compositor_changed( tracker->base.compositor );
     compositor_unlock( tracker->base.compositor );
     return S_OK;
@@ -3055,6 +3082,8 @@ static HRESULT WINAPI tracker_AdjustPositionXIfGreaterThanThreshold( IInteractio
     compositor_lock( tracker->base.compositor );
     if (tracker->position.X > positionThreshold)
     {
+        /* what it moves is where the tracker is */
+        tracker->position_unclamped = FALSE;
         tracker->position.X += adjustment;
         tracker_clamp( tracker, 0 );
         tracker_values_changed( tracker, tracker->request_id );
@@ -3072,6 +3101,8 @@ static HRESULT WINAPI tracker_AdjustPositionYIfGreaterThanThreshold( IInteractio
     compositor_lock( tracker->base.compositor );
     if (tracker->position.Y > positionThreshold)
     {
+        /* what it moves is where the tracker is */
+        tracker->position_unclamped = FALSE;
         tracker->position.Y += adjustment;
         tracker_clamp( tracker, 0 );
         tracker_values_changed( tracker, tracker->request_id );
