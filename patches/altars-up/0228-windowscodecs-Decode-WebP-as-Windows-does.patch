+/* the loop count after the background colour of the ANIM chunk */
+static HRESULT load_anim_metadata( MetadataHandler *handler, IStream *stream, const GUID *vendor, DWORD options )
+{
+    MetadataItem *item;
+    BYTE data[6];
+    ULONG read;
+    HRESULT hr;
+
+    if (FAILED(hr = IStream_Read( stream, data, sizeof(data), &read ))) return hr;
+    if (read != sizeof(data)) return WINCODEC_ERR_BADMETADATAHEADER;
+
+    if (!(item = calloc( 1, sizeof(*item) ))) return E_OUTOFMEMORY;
+    item->id.vt = VT_LPWSTR;
+    SHStrDupW( L"LoopCount", &item->id.pwszVal );
+    item->value.vt = VT_UI2;
+    item->value.uiVal = data[4] | data[5] << 8;
+
+    MetadataHandler_FreeItems( handler );
+    handler->items = item;
+    handler->item_count = 1;
+    return S_OK;
+}
+
+static const MetadataHandlerVtbl anim_reader_vtbl =
+{
+    .clsid = &CLSID_WICWebpAnimMetadataReader,
+    .fnLoad = load_anim_metadata,
+};
+
+HRESULT WebpAnimReader_CreateInstance( REFIID iid, void **ppv )
+{
+    return MetadataReader_Create( &anim_reader_vtbl, iid, ppv );
+}
+
+/* the duration after the frame's offset and size in the ANMF chunk */
+static HRESULT load_anmf_metadata( MetadataHandler *handler, IStream *stream, const GUID *vendor, DWORD options )
+{
+    MetadataItem *item;
+    BYTE data[16];
+    ULONG read;
+    HRESULT hr;
+
+    if (FAILED(hr = IStream_Read( stream, data, sizeof(data), &read ))) return hr;
+    if (read != sizeof(data)) return WINCODEC_ERR_BADMETADATAHEADER;
+
+    if (!(item = calloc( 1, sizeof(*item) ))) return E_OUTOFMEMORY;
+    item->id.vt = VT_LPWSTR;
+    SHStrDupW( L"FrameDuration", &item->id.pwszVal );
+    item->value.vt = VT_UI4;
+    item->value.ulVal = data[12] | data[13] << 8 | data[14] << 16;
+
+    MetadataHandler_FreeItems( handler );
+    handler->items = item;
+    handler->item_count = 1;
+    return S_OK;
+}
+
+static const MetadataHandlerVtbl anmf_reader_vtbl =
+{
+    .clsid = &CLSID_WICWebpAnmfMetadataReader,
+    .fnLoad = load_anmf_metadata,
+};
+
