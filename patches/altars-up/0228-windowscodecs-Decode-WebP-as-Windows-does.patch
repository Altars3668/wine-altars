+static DWORD checksum(const BYTE *data, UINT size)
+{
+    DWORD hash = 2166136261u;
+    UINT i;
+
+    for (i = 0; i < size; i++) hash = (hash ^ data[i]) * 16777619u;
+    return hash;
+}
+
+/* the one block an animation has, at the decoder or at a frame, and its one item */
+static void check_blocks(IUnknown *object, const GUID *format, const WCHAR *name, VARTYPE vt, ULONG value)
+{
+    PROPVARIANT schema, id, item;
+    IWICMetadataBlockReader *blocks;
+    IWICMetadataReader *reader;
+    UINT count;
+    GUID guid;
+    HRESULT hr;
+
+    hr = IUnknown_QueryInterface(object, &IID_IWICMetadataBlockReader, (void **)&blocks);
+    ok(hr == S_OK, "no block reader, hr %#lx\n", hr);
+    if (hr != S_OK) return;
+    hr = IWICMetadataBlockReader_GetCount(blocks, &count);
+    ok(hr == S_OK && count == (format ? 1 : 0), "got hr %#lx, %u blocks\n", hr, count);
+    if (format && count == 1)
+    {
+        hr = IWICMetadataBlockReader_GetReaderByIndex(blocks, 0, &reader);
+        ok(hr == S_OK, "GetReaderByIndex failed, hr %#lx\n", hr);
+        hr = IWICMetadataReader_GetMetadataFormat(reader, &guid);
+        ok(hr == S_OK && IsEqualGUID(&guid, format), "got format %s\n", wine_dbgstr_guid(&guid));
+        hr = IWICMetadataReader_GetCount(reader, &count);
+        ok(hr == S_OK && count == 1, "got hr %#lx, %u items\n", hr, count);
+        PropVariantInit(&schema);
+        PropVariantInit(&id);
+        PropVariantInit(&item);
+        hr = IWICMetadataReader_GetValueByIndex(reader, 0, &schema, &id, &item);
+        ok(hr == S_OK, "GetValueByIndex failed, hr %#lx\n", hr);
+        ok(schema.vt == VT_EMPTY, "got schema type %d\n", schema.vt);
+        ok(id.vt == VT_LPWSTR && !wcscmp(id.pwszVal, name), "got id %s\n",
+           id.vt == VT_LPWSTR ? debugstr_w(id.pwszVal) : "not a string");
+        ok(item.vt == vt && (vt == VT_UI2 ? item.uiVal : item.ulVal) == value, "got type %d, %lu\n", item.vt,
+           item.ulVal);
+        PropVariantClear(&schema);
+        PropVariantClear(&id);
+        PropVariantClear(&item);
+        IWICMetadataReader_Release(reader);
+    }
+    IWICMetadataBlockReader_Release(blocks);
+}
+
+static void check_frame(IWICBitmapDecoder *decoder, UINT index, UINT width, UINT height, DWORD expect,
+                        UINT duration)
+{
+    IWICMetadataQueryReader *reader;
+    IWICBitmapFrameDecode *frame;
+    WICPixelFormatGUID format;
+    UINT w, h, stride = width * 4;
+    double dpi_x, dpi_y;
+    BYTE *pixels;
+    HRESULT hr;
+
+    winetest_push_context("frame %u", index);
+    hr = IWICBitmapDecoder_GetFrame(decoder, index, &frame);
+    ok(hr == S_OK, "GetFrame failed, hr %#lx\n", hr);
+    hr = IWICBitmapFrameDecode_GetSize(frame, &w, &h);
+    ok(hr == S_OK && w == width && h == height, "got hr %#lx, %ux%u\n", hr, w, h);
+    hr = IWICBitmapFrameDecode_GetPixelFormat(frame, &format);
+    ok(hr == S_OK && IsEqualGUID(&format, &GUID_WICPixelFormat32bppRGBA), "got hr %#lx, %s\n", hr,
+       wine_dbgstr_guid(&format));
+    hr = IWICBitmapFrameDecode_GetResolution(frame, &dpi_x, &dpi_y);
+    ok(hr == S_OK && dpi_x == 72.0 && dpi_y == 72.0, "got hr %#lx, %f %f\n", hr, dpi_x, dpi_y);
+    hr = IWICBitmapFrameDecode_GetMetadataQueryReader(frame, &reader);
+    ok(hr == S_OK, "GetMetadataQueryReader failed, hr %#lx\n", hr);
+    if (hr == S_OK) IWICMetadataQueryReader_Release(reader);
+    check_blocks((IUnknown *)frame, duration ? &GUID_MetadataFormatWebpANMF : NULL, L"FrameDuration", VT_UI4,
+                 duration);
+
+    pixels = malloc(stride * height);
+    hr = IWICBitmapFrameDecode_CopyPixels(frame, NULL, stride, stride * height, pixels);
+    ok(hr == S_OK, "CopyPixels failed, hr %#lx\n", hr);
+    ok(checksum(pixels, stride * height) == expect, "got pixels %08lx\n", checksum(pixels, stride * height));
+    free(pixels);
+    IWICBitmapFrameDecode_Release(frame);
+    winetest_pop_context();
+}
+
+static void test_webp_decoder(void)
+{
+    static const struct
+    {
+        const BYTE *data;
+        UINT size, width, height, frames;
+        DWORD pixels[3];
+        UINT durations[3];
+    }
+    tests[] =
+    {
+        { webp_odd_size, sizeof(webp_odd_size), 33, 17, 1, { 0x49f47f80 } },
+        { webp_lossless_alpha, sizeof(webp_lossless_alpha), 96, 64, 1, { 0xa2fa2566 } },
+        { webp_animated, sizeof(webp_animated), 64, 48, 3, { 0xfe8e2047, 0x20c824de, 0x37a363fa },
+          { 100, 200, 300 } },
+    };
+    IWICMetadataQueryReader *reader;
+    IWICBitmapDecoderInfo *info;
+    IWICBitmapFrameDecode *frame;
+    IWICBitmapDecoder *decoder;
+    IWICBitmapSource *source;
+    IWICColorContext *context;
+    IWICPalette *palette;
+    IEnumString *names;
+    IStream *stream;
+    LPOLESTR name;
+    DWORD capability;
+    UINT count, i, j, w, h;
+    GUID guid;
+    HRESULT hr;
+    BYTE *pixels;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context("%u", i);
+        stream = SHCreateMemStream(tests[i].data, tests[i].size);
+        hr = IWICImagingFactory_CreateDecoderFromStream(factory, stream, NULL, WICDecodeMetadataCacheOnDemand,
+                                                        &decoder);
+        if (hr == WINCODEC_ERR_COMPONENTNOTFOUND)
+        {
+            win_skip("WebP is not supported\n");
+            IStream_Release(stream);
+            winetest_pop_context();
+            return;
+        }
+        ok(hr == S_OK, "CreateDecoderFromStream failed, hr %#lx\n", hr);
+
+        hr = IWICBitmapDecoder_GetContainerFormat(decoder, &guid);
+        ok(hr == S_OK && IsEqualGUID(&guid, &GUID_ContainerFormatWebp), "got %s\n", wine_dbgstr_guid(&guid));
+        hr = IWICBitmapDecoder_GetDecoderInfo(decoder, &info);
+        ok(hr == S_OK, "GetDecoderInfo failed, hr %#lx\n", hr);
+        hr = IWICBitmapDecoderInfo_GetCLSID(info, &guid);
+        ok(hr == S_OK && IsEqualGUID(&guid, &CLSID_WICWebpDecoder), "got %s\n", wine_dbgstr_guid(&guid));
+        IWICBitmapDecoderInfo_Release(info);
+
+        hr = IWICBitmapDecoder_GetFrameCount(decoder, &count);
+        ok(hr == S_OK && count == tests[i].frames, "got hr %#lx, %u frames\n", hr, count);
+
+        /* no metadata in these, but the readers are there */
+        hr = IWICBitmapDecoder_GetMetadataQueryReader(decoder, &reader);
+        ok(hr == S_OK, "GetMetadataQueryReader failed, hr %#lx\n", hr);
+        if (hr == S_OK)
+        {
+            hr = IWICMetadataQueryReader_GetEnumerator(reader, &names);
+            ok(hr == S_OK, "GetEnumerator failed, hr %#lx\n", hr);
+            name = NULL;
+            hr = IEnumString_Next(names, 1, &name, NULL);
+            ok(hr == (tests[i].frames > 1 ? S_OK : S_FALSE), "got hr %#lx\n", hr);
+            CoTaskMemFree(name);
+            IEnumString_Release(names);
+            IWICMetadataQueryReader_Release(reader);
+        }
+        hr = IWICBitmapDecoder_GetThumbnail(decoder, &source);
+        ok(hr == WINCODEC_ERR_CODECNOTHUMBNAIL, "GetThumbnail returned %#lx\n", hr);
+        hr = IWICBitmapDecoder_GetPreview(decoder, &source);
+        ok(hr == WINCODEC_ERR_UNSUPPORTEDOPERATION, "GetPreview returned %#lx\n", hr);
+        IWICImagingFactory_CreatePalette(factory, &palette);
+        hr = IWICBitmapDecoder_CopyPalette(decoder, palette);
+        ok(hr == WINCODEC_ERR_PALETTEUNAVAILABLE, "CopyPalette returned %#lx\n", hr);
+        IWICPalette_Release(palette);
+        IWICImagingFactory_CreateColorContext(factory, &context);
+        hr = IWICBitmapDecoder_GetColorContexts(decoder, 1, &context, &count);
+        ok(hr == WINCODEC_ERR_UNSUPPORTEDOPERATION, "GetColorContexts returned %#lx\n", hr);
+        IWICColorContext_Release(context);
+        check_blocks((IUnknown *)decoder, tests[i].frames > 1 ? &GUID_MetadataFormatWebpANIM : NULL, L"LoopCount",
+                     VT_UI2, 0);
+
+        /* the frames are the canvas as composed, whichever comes first */
+        for (j = tests[i].frames; j-- > 0;)
+            check_frame(decoder, j, tests[i].width, tests[i].height, tests[i].pixels[j], tests[i].durations[j]);
+        check_frame(decoder, 0, tests[i].width, tests[i].height, tests[i].pixels[0], tests[i].durations[0]);
+
+        /* any frame can be had, but not the pixels of one that is not there */
+        hr = IWICBitmapDecoder_GetFrame(decoder, tests[i].frames + 5, &frame);
+        ok(hr == S_OK, "GetFrame failed, hr %#lx\n", hr);
+        if (hr == S_OK)
+        {
+            hr = IWICBitmapFrameDecode_GetSize(frame, &w, &h);
+            ok(hr == S_OK && w == tests[i].width && h == tests[i].height, "got hr %#lx, %ux%u\n", hr, w, h);
+            pixels = malloc(w * 4 * h);
+
+            hr = IWICBitmapFrameDecode_CopyPixels(frame, NULL, w * 4, w * 4 * h, pixels);
+            ok(hr == MF_E_INVALIDINDEX, "CopyPixels returned %#lx\n", hr);
+            free(pixels);
+            IWICBitmapFrameDecode_Release(frame);
+        }
+        IWICBitmapDecoder_Release(decoder);
+
+        hr = CoCreateInstance(&CLSID_WICWebpDecoder, NULL, CLSCTX_INPROC_SERVER, &IID_IWICBitmapDecoder,
+                              (void **)&decoder);
+        ok(hr == S_OK, "CoCreateInstance failed, hr %#lx\n", hr);
+        capability = 0xdeadbeef;
+        hr = IWICBitmapDecoder_QueryCapability(decoder, stream, &capability);
+        ok(hr == S_OK, "QueryCapability failed, hr %#lx\n", hr);
+        ok(capability == (WICBitmapDecoderCapabilityCanDecodeAllImages |
+                          WICBitmapDecoderCapabilityCanEnumerateMetadata), "got capability %#lx\n", capability);
+        IWICBitmapDecoder_Release(decoder);
+        IStream_Release(stream);
+        winetest_pop_context();
+    }
+
+    /* a still picture cut short or damaged is had, and fails to decode; a broken animation is refused */
+    {
+        static const struct { UINT size, damage; HRESULT create; } broken[] =
+        {
+            { 40, 0, S_OK },
+            { sizeof(webp_odd_size), 60, S_OK },
+            { 12, 0, MF_E_INVALID_FILE_FORMAT },
+            { 900, 0, E_UNEXPECTED },
+        };
+        BYTE *data = malloc(sizeof(webp_animated));
+
+        for (i = 0; i < ARRAY_SIZE(broken); i++)
+        {
+            winetest_push_context("broken %u", i);
+            memcpy(data, i == 3 ? webp_animated : webp_odd_size, broken[i].size);
+            if (broken[i].damage) memset(data + broken[i].damage, 0x55, broken[i].size - broken[i].damage);
+            stream = SHCreateMemStream(data, broken[i].size);
+            hr = IWICImagingFactory_CreateDecoderFromStream(factory, stream, NULL, WICDecodeMetadataCacheOnDemand,
+                                                            &decoder);
+            ok(hr == broken[i].create, "got hr %#lx\n", hr);
+            if (hr == S_OK)
+            {
+                hr = IWICBitmapDecoder_GetFrameCount(decoder, &count);
+                ok(hr == S_OK && count == 1, "got hr %#lx, %u frames\n", hr, count);
+                hr = IWICBitmapDecoder_GetFrame(decoder, 0, &frame);
+                ok(hr == S_OK, "GetFrame failed, hr %#lx\n", hr);
+                hr = IWICBitmapFrameDecode_GetSize(frame, &w, &h);
+                ok(hr == S_OK && w == 33 && h == 17, "got hr %#lx, %ux%u\n", hr, w, h);
+                pixels = malloc(33 * 17 * 4);
+                hr = IWICBitmapFrameDecode_CopyPixels(frame, NULL, 33 * 4, 33 * 17 * 4, pixels);
+                ok(hr == MF_E_INVALID_FILE_FORMAT, "CopyPixels returned %#lx\n", hr);
+                free(pixels);
+                IWICBitmapFrameDecode_Release(frame);
+                IWICBitmapDecoder_Release(decoder);
+            }
+            IStream_Release(stream);
+            winetest_pop_context();
+        }
+        free(data);
+    }
+}
+
+/* the metadata readers are the decoder's, and not to be had on their own */
+static void test_webp_metadata_readers(void)
+{
+    static const struct { const CLSID *clsid; const GUID *format; } readers[] =
+    {
+        { &CLSID_WICWebpAnimMetadataReader, &GUID_MetadataFormatWebpANIM },
+        { &CLSID_WICWebpAnmfMetadataReader, &GUID_MetadataFormatWebpANMF },
+    };
+    IWICMetadataReaderInfo *info;
+    IWICComponentInfo *component;
+    IWICMetadataReader *reader;
+    GUID format, containers[4];
+    UINT count, i;
+    HRESULT hr;
+    BOOL flag;
+
+    for (i = 0; i < ARRAY_SIZE(readers); i++)
+    {
+        hr = CoCreateInstance(readers[i].clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IWICMetadataReader,
+                              (void **)&reader);
+        ok(hr == REGDB_E_CLASSNOTREG, "%u: got hr %#lx\n", i, hr);
+        if (hr == S_OK) IWICMetadataReader_Release(reader);
+
+        hr = IWICImagingFactory_CreateComponentInfo(factory, readers[i].clsid, &component);
+        ok(hr == S_OK, "%u: CreateComponentInfo failed, hr %#lx\n", i, hr);
+        if (hr != S_OK) continue;
+        hr = IWICComponentInfo_QueryInterface(component, &IID_IWICMetadataReaderInfo, (void **)&info);
+        ok(hr == S_OK, "%u: got hr %#lx\n", i, hr);
+        IWICComponentInfo_Release(component);
+        hr = IWICMetadataReaderInfo_GetMetadataFormat(info, &format);
+        ok(hr == S_OK && IsEqualGUID(&format, readers[i].format), "%u: got %s\n", i, wine_dbgstr_guid(&format));
+        count = 0;
+        hr = IWICMetadataReaderInfo_GetContainerFormats(info, ARRAY_SIZE(containers), containers, &count);
+        ok(hr == S_OK && count == 1 && IsEqualGUID(&containers[0], &GUID_ContainerFormatWebp), "%u: got %u %s\n",
+           i, count, wine_dbgstr_guid(&containers[0]));
+        hr = IWICMetadataReaderInfo_DoesRequireFixedSize(info, &flag);
+        ok(hr == S_OK && flag, "%u: got %d\n", i, flag);
+        hr = IWICMetadataReaderInfo_DoesRequireFullStream(info, &flag);
+        ok(hr == S_OK && !flag, "%u: got %d\n", i, flag);
+        IWICMetadataReaderInfo_Release(info);
+    }
+}
+
+START_TEST(webpformat)
+{
+    HRESULT hr;
+
+    CoInitializeEx(NULL, COINIT_APARTMENTTHREADED);
+    hr = CoCreateInstance(&CLSID_WICImagingFactory, NULL, CLSCTX_INPROC_SERVER, &IID_IWICImagingFactory,
+                          (void **)&factory);
+    ok(hr == S_OK, "CoCreateInstance failed, hr %#lx\n", hr);
+    if (FAILED(hr)) return;
+
+    test_webp_decoder();
+    test_webp_metadata_readers();
+
+    IWICImagingFactory_Release(factory);
+    CoUninitialize();
+}
