+HRESULT WebpImageExtension_CreateInstance( REFIID iid, void **out )
+{
+    struct webp_extension *transform;
+    HRESULT hr;
+
+    if (!(transform = calloc( 1, sizeof(*transform) ))) return E_OUTOFMEMORY;
+    transform->IMFTransform_iface.lpVtbl = &webp_extension_vtbl;
+    transform->refcount = 1;
+    if (FAILED(hr = MFCreateAttributes( &transform->attributes, 0 )))
+    {
+        free( transform );
+        return hr;
+    }
+    hr = IMFTransform_QueryInterface( &transform->IMFTransform_iface, iid, out );
+    IMFTransform_Release( &transform->IMFTransform_iface );
+    return hr;
+}
+
+HRESULT register_webp_image_extension(void)
+{
+    MFT_REGISTER_TYPE_INFO input = { MFMediaType_Video, CLSID_WICWebpDecoder };
+    MFT_REGISTER_TYPE_INFO output = { MFMediaType_Video, MFVideoFormat_P010 };
+
+    return MFTRegister( CLSID_WebpImageExtension, MFT_CATEGORY_VIDEO_DECODER, (WCHAR *)L"WebpImageExtension",
+                        MFT_ENUM_FLAG_SYNCMFT, 1, &input, 1, &output, NULL );
+}
+
+HRESULT unregister_webp_image_extension(void)
+{
+    return MFTUnregister( CLSID_WebpImageExtension );
+}
