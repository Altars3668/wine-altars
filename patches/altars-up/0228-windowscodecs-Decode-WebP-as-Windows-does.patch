+/* Windows' WebP image extension registers a video decoder transform for the WebP subtype, which is the WIC
+ * decoder's class id.  It decodes nothing -- every method but GetAttributes is E_NOTIMPL -- but Office inserts a
+ * WebP picture only when there is one, and then decodes it with WIC. */
+struct webp_extension
+{
+    IMFTransform IMFTransform_iface;
+    LONG refcount;
+    IMFAttributes *attributes;
+};
+
+static inline struct webp_extension *impl_from_IMFTransform( IMFTransform *iface )
+{
+    return CONTAINING_RECORD( iface, struct webp_extension, IMFTransform_iface );
+}
+
+static HRESULT WINAPI webp_extension_QueryInterface( IMFTransform *iface, REFIID iid, void **out )
+{
+    struct webp_extension *transform = impl_from_IMFTransform( iface );
+
+    TRACE( "iface %p, iid %s, out %p\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IMFTransform ))
+    {
+        *out = &transform->IMFTransform_iface;
+        IMFTransform_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI webp_extension_AddRef( IMFTransform *iface )
+{
+    struct webp_extension *transform = impl_from_IMFTransform( iface );
+    return InterlockedIncrement( &transform->refcount );
+}
+
+static ULONG WINAPI webp_extension_Release( IMFTransform *iface )
+{
+    struct webp_extension *transform = impl_from_IMFTransform( iface );
+    ULONG refcount = InterlockedDecrement( &transform->refcount );
+
+    if (!refcount)
+    {
+        IMFAttributes_Release( transform->attributes );
+        free( transform );
+    }
+    return refcount;
+}
+
