+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/* Windows' WebP decoder is libwebp's: its frames are what the animation decoder composes on the canvas, in
+ * straight RGBA, a still picture being an animation of one frame.  GetFrame takes any index, and copying the
+ * pixels of a frame the file does not have fails.  A still picture is taken on the strength of its header and
+ * only decoded for its pixels, an animation has to be whole from the start.  An animation's loop count and each
+ * frame's duration are its metadata, read from the ANIM and ANMF chunks by readers of their own. */
+
+#include <stdarg.h>
+#include <webp/decode.h>
+#include <webp/demux.h>
+
+#define COBJMACROS
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winternl.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "shlwapi.h"
+#include "mfapi.h"
+#include "mftransform.h"
+#include "mferror.h"
+
+#include "wincodecs_private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(wincodecs);
+
+struct webp_chunk
+{
+    ULONG offset;  /* of the payload */
+    ULONG length;
+};
+
+struct webp_decoder
+{
+    struct decoder decoder;
+    BYTE *data;
+    ULONG size;
+    WebPAnimDecoder *anim;
+    WebPAnimInfo info;
+    UINT decoded;  /* frames composed on the canvas so far */
+    BYTE *canvas;
+    struct webp_chunk anim_chunk;
+    struct webp_chunk *frame_chunks;
+    UINT frame_chunk_count;
+};
+
+/* where the ANIM chunk and the ANMF chunks are */
+static HRESULT find_animation_chunks( struct webp_decoder *This )
+{
+    ULONG offset = 12, length;
+
+    while (offset + 8 <= This->size)
+    {
+        length = This->data[offset + 4] | This->data[offset + 5] << 8 | This->data[offset + 6] << 16 |
+                 This->data[offset + 7] << 24;
+        if (length > This->size - offset - 8) break;
+        if (!memcmp( This->data + offset, "ANIM", 4 ))
+        {
+            This->anim_chunk.offset = offset + 8;
+            This->anim_chunk.length = length;
+        }
+        else if (!memcmp( This->data + offset, "ANMF", 4 ))
+        {
+            struct webp_chunk *chunks;
+
+            if (!(chunks = realloc( This->frame_chunks, (This->frame_chunk_count + 1) * sizeof(*chunks) )))
+                return E_OUTOFMEMORY;
+            This->frame_chunks = chunks;
+            chunks[This->frame_chunk_count].offset = offset + 8;
+            chunks[This->frame_chunk_count].length = length;
+            This->frame_chunk_count++;
+        }
+        offset += 8 + length + (length & 1);
+    }
+    return S_OK;
+}
+
+static inline struct webp_decoder *impl_from_decoder( struct decoder *iface )
+{
+    return CONTAINING_RECORD( iface, struct webp_decoder, decoder );
+}
+
+static WebPAnimDecoder *create_anim_decoder( struct webp_decoder *This )
+{
+    WebPAnimDecoderOptions options;
+    WebPData webp;
+
+    WebPAnimDecoderOptionsInit( &options );
+    options.color_mode = MODE_RGBA;
+    options.use_threads = 0;
+    webp.bytes = This->data;
+    webp.size = This->size;
+    return WebPAnimDecoderNew( &webp, &options );
+}
+
+static HRESULT CDECL webp_decoder_initialize( struct decoder *iface, IStream *stream, struct decoder_stat *st )
+{
+    struct webp_decoder *This = impl_from_decoder( iface );
+    WebPBitstreamFeatures features;
+    ULONGLONG size;
+    ULONG read;
+    HRESULT hr;
+
+    /* after a failed attempt */
+    WebPAnimDecoderDelete( This->anim );
+    This->anim = NULL;
+    free( This->data );
+    This->data = NULL;
+    free( This->frame_chunks );
+    This->frame_chunks = NULL;
+    This->frame_chunk_count = 0;
+    memset( &This->anim_chunk, 0, sizeof(This->anim_chunk) );
+
+    if (FAILED(hr = stream_getsize( stream, &size ))) return hr;
+    if (size > 0x7fffffff) return WINCODEC_ERR_BADIMAGE;
+    if (FAILED(hr = stream_seek( stream, 0, STREAM_SEEK_SET, NULL ))) return hr;
+    if (!(This->data = malloc( size ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = stream_read( stream, This->data, size, &read ))) return hr;
+    This->size = read;
+
+    if (WebPGetFeatures( This->data, read, &features ) != VP8_STATUS_OK)
+    {
+        WARN( "not a WebP file\n" );
+        return MF_E_INVALID_FILE_FORMAT;
+    }
+    if (features.has_animation)
+    {
+        if (!(This->anim = create_anim_decoder( This )))
+        {
+            WARN( "broken animation\n" );
+            return E_UNEXPECTED;
+        }
+        WebPAnimDecoderGetInfo( This->anim, &This->info );
+        if (FAILED(hr = find_animation_chunks( This ))) return hr;
+    }
+    else
+    {
+        This->info.canvas_width = features.width;
+        This->info.canvas_height = features.height;
+        This->info.frame_count = 1;
+    }
+    TRACE( "%ux%u, %u frames, loop %u, background %08x\n", This->info.canvas_width, This->info.canvas_height,
+           This->info.frame_count, This->info.loop_count, This->info.bgcolor );
+
+    st->frame_count = This->info.frame_count;
+    st->flags = WICBitmapDecoderCapabilityCanDecodeAllImages | WICBitmapDecoderCapabilityCanEnumerateMetadata |
+                DECODER_FLAGS_METADATA_AT_DECODER | DECODER_FLAGS_UNSUPPORTED_COLOR_CONTEXT |
+                DECODER_FLAGS_ANY_FRAME_INDEX;
+    return S_OK;
+}
+
+static HRESULT CDECL webp_decoder_get_frame_info( struct decoder *iface, UINT frame, struct decoder_frame *info )
+{
+    struct webp_decoder *This = impl_from_decoder( iface );
+
+    info->pixel_format = GUID_WICPixelFormat32bppRGBA;
+    info->width = This->info.canvas_width;
+    info->height = This->info.canvas_height;
+    info->bpp = 32;
+    info->dpix = info->dpiy = 72.0;
+    info->num_color_contexts = 0;
+    info->num_colors = 0;
+    return S_OK;
+}
+
+static HRESULT CDECL webp_decoder_get_decoder_palette( struct decoder *iface, UINT frame, WICColor *colors,
+                                                       UINT *num_colors )
+{
+    *num_colors = 0;
+    return S_OK;
+}
+
+static HRESULT CDECL webp_decoder_copy_pixels( struct decoder *iface, UINT frame, const WICRect *prc,
+                                               UINT stride, UINT buffersize, BYTE *buffer )
+{
+    struct webp_decoder *This = impl_from_decoder( iface );
+    uint8_t *canvas;
+    int timestamp;
+
+    if (frame >= This->info.frame_count) return MF_E_INVALIDINDEX;
+    if (!This->anim && !(This->anim = create_anim_decoder( This ))) return MF_E_INVALID_FILE_FORMAT;
+
+    /* the frames are composed in order, each on those before */
+    if (frame + 1 < This->decoded)
+    {
+        WebPAnimDecoderReset( This->anim );
+        This->decoded = 0;
+    }
+    while (This->decoded <= frame)
+    {
+        if (!WebPAnimDecoderGetNext( This->anim, &canvas, &timestamp ))
+        {
+            WARN( "frame %u does not decode\n", This->decoded );
+            WebPAnimDecoderReset( This->anim );
+            This->decoded = 0;
+            return MF_E_INVALID_FILE_FORMAT;
+        }
+        This->canvas = canvas;
+        This->decoded++;
+    }
+
+    return copy_pixels( 32, This->canvas, This->info.canvas_width, This->info.canvas_height,
+                        This->info.canvas_width * 4, prc, stride, buffersize, buffer );
+}
+
+static HRESULT CDECL webp_decoder_get_metadata_blocks( struct decoder *iface, UINT frame, UINT *count,
+                                                       struct decoder_block **blocks )
+{
+    struct webp_decoder *This = impl_from_decoder( iface );
+    const struct webp_chunk *chunk = NULL;
+    const CLSID *reader = NULL;
+
+    *count = 0;
+    *blocks = NULL;
+    if (frame == ~0u && This->anim_chunk.length)
+    {
+        chunk = &This->anim_chunk;
+        reader = &CLSID_WICWebpAnimMetadataReader;
+    }
+    else if (frame < This->frame_chunk_count)
+    {
+        chunk = &This->frame_chunks[frame];
+        reader = &CLSID_WICWebpAnmfMetadataReader;
+    }
+    if (!chunk) return S_OK;
+
+    if (!(*blocks = calloc( 1, sizeof(**blocks) ))) return E_OUTOFMEMORY;
+    (*blocks)->offset = chunk->offset;
+    (*blocks)->length = chunk->length;
+    (*blocks)->options = DECODER_BLOCK_READER_CLSID;
+    (*blocks)->reader_clsid = *reader;
+    *count = 1;
+    return S_OK;
+}
+
+static HRESULT CDECL webp_decoder_get_color_context( struct decoder *iface, UINT frame, UINT num,
+                                                     BYTE **data, DWORD *datasize )
+{
+    return E_NOTIMPL;
+}
+
+static void CDECL webp_decoder_destroy( struct decoder *iface )
+{
+    struct webp_decoder *This = impl_from_decoder( iface );
+
+    WebPAnimDecoderDelete( This->anim );
+    free( This->frame_chunks );
+    free( This->data );
+    free( This );
+}
+
+static const struct decoder_funcs webp_decoder_vtable =
+{
+    webp_decoder_initialize,
+    webp_decoder_get_frame_info,
+    webp_decoder_get_decoder_palette,
+    webp_decoder_copy_pixels,
+    webp_decoder_get_metadata_blocks,
+    webp_decoder_get_color_context,
+    webp_decoder_destroy
+};
+
+HRESULT CDECL webp_decoder_create( struct decoder_info *info, struct decoder **result )
+{
+    struct webp_decoder *This;
+
+    if (!(This = calloc( 1, sizeof(*This) ))) return E_OUTOFMEMORY;
+    This->decoder.vtable = &webp_decoder_vtable;
+    *result = &This->decoder;
+
+    info->container_format = GUID_ContainerFormatWebp;
+    info->block_format = GUID_ContainerFormatWebp;
+    info->clsid = CLSID_WICWebpDecoder;
+    return S_OK;
+}
