+/* what a codec says it supports, and what every component reports as its signing and specification version */
+static void check_codec_info(IWICBitmapCodecInfo *info, const char *supports)
+{
+    WCHAR value[16];
+    DWORD status;
+    BOOL flag;
+    HRESULT hr;
+    UINT len;
+
+    flag = 0xdeadbeef;
+    hr = IWICBitmapCodecInfo_DoesSupportAnimation(info, &flag);
+    ok(hr == S_OK && flag == supports[0] - '0', "animation: got hr %#lx, %d\n", hr, flag);
+    flag = 0xdeadbeef;
+    hr = IWICBitmapCodecInfo_DoesSupportChromaKey(info, &flag);
+    ok(hr == S_OK && flag == supports[1] - '0', "chroma key: got hr %#lx, %d\n", hr, flag);
+    flag = 0xdeadbeef;
+    hr = IWICBitmapCodecInfo_DoesSupportLossless(info, &flag);
+    ok(hr == S_OK && flag == supports[2] - '0', "lossless: got hr %#lx, %d\n", hr, flag);
+    flag = 0xdeadbeef;
+    hr = IWICBitmapCodecInfo_DoesSupportMultiframe(info, &flag);
+    ok(hr == S_OK && flag == supports[3] - '0', "multiframe: got hr %#lx, %d\n", hr, flag);
+    hr = IWICBitmapCodecInfo_DoesSupportMultiframe(info, NULL);
+    ok(hr == E_INVALIDARG, "got hr %#lx\n", hr);
+
+    status = 0xdeadbeef;
+    hr = IWICBitmapCodecInfo_GetSigningStatus(info, &status);
+    ok(hr == S_OK && status == WICComponentSigned, "signing: got hr %#lx, %#lx\n", hr, status);
+    hr = IWICBitmapCodecInfo_GetSigningStatus(info, NULL);
+    ok(hr == E_INVALIDARG, "got hr %#lx\n", hr);
+
+    len = 0;
+    hr = IWICBitmapCodecInfo_GetSpecVersion(info, ARRAY_SIZE(value), value, &len);
+    ok(hr == S_OK && !wcscmp(value, L"1.0.0.0") && len == 8, "spec version: got hr %#lx, %s %u\n", hr,
+       debugstr_w(value), len);
+}
