diff --git a/dlls/windowscodecs/libwebp.c b/dlls/windowscodecs/libwebp.c
new file mode 100644
index 00000000000..9c6f2f693fa
--- /dev/null
+++ b/dlls/windowscodecs/libwebp.c
@@ -0,0 +1,606 @@
+/*
+ * WebP decoder
+ *
+ * Copyright 2026 AltarsCN
+ *
