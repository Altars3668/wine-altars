+
+/*
+ * The operations with a value: IAsyncOperation<boolean>, and with progress
+ * IAsyncOperationWithProgress<UINT32, UINT32> and <IBuffer *, UINT32>.  All
+ * are the same object around an IAsyncInfoImpl, told apart by their vtables;
+ * progress is never reported, as each completes in one step.
+ */
+
+struct async_value
+{
+    IInspectable IInspectable_iface;
+    IAsyncInfoImpl *IAsyncInfoImpl_inner;
+    LONG ref;
+    const GUID *iid;
+    const WCHAR *class_name;
+    IUnknown *progress;
+};
+
+static inline struct async_value *impl_from_async_value( void *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_value, IInspectable_iface );
+}
+
+static HRESULT WINAPI async_value_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, impl->iid ))
+    {
+        IInspectable_AddRef( (*out = &impl->IInspectable_iface) );
+        return S_OK;
+    }
+
+    return IAsyncInfoImpl_QueryInterface( impl->IAsyncInfoImpl_inner, iid, out );
+}
+
+static ULONG WINAPI async_value_AddRef( IInspectable *iface )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI async_value_Release( IInspectable *iface )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        /* guard against re-entry if inner releases an outer iface */
+        InterlockedIncrement( &impl->ref );
+        IAsyncInfoImpl_Release( impl->IAsyncInfoImpl_inner );
+        if (impl->progress) IUnknown_Release( impl->progress );
+        free( impl );
+    }
+
+    return ref;
+}
+
+static HRESULT WINAPI async_value_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI async_value_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+    return WindowsCreateString( impl->class_name, wcslen( impl->class_name ), class_name );
+}
+
+static HRESULT WINAPI async_value_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT async_value_put_Progress( void *iface, IUnknown *handler )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+    IUnknown *old;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (handler) IUnknown_AddRef( handler );
+    if ((old = InterlockedExchangePointer( (void **)&impl->progress, handler ))) IUnknown_Release( old );
+    return S_OK;
+}
+
+static HRESULT async_value_get_Progress( void *iface, IUnknown **handler )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (!handler) return E_POINTER;
+    if ((*handler = impl->progress)) IUnknown_AddRef( *handler );
+    return S_OK;
+}
+
+static HRESULT async_value_put_Completed( void *iface, void *handler )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return IAsyncInfoImpl_put_Completed( impl->IAsyncInfoImpl_inner, (IAsyncOperationCompletedHandlerImpl *)handler );
+}
+
+static HRESULT async_value_get_Completed( void *iface, void **handler )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+    return IAsyncInfoImpl_get_Completed( impl->IAsyncInfoImpl_inner, (IAsyncOperationCompletedHandlerImpl **)handler );
+}
+
+static HRESULT async_value_result( void *iface, PROPVARIANT *result )
+{
+    struct async_value *impl = impl_from_async_value( iface );
+    PropVariantInit( result );
+    return IAsyncInfoImpl_get_Result( impl->IAsyncInfoImpl_inner, result );
+}
+
+/* IAsyncOperation<boolean> */
+
+static HRESULT WINAPI async_boolean_put_Completed( IAsyncOperation_boolean *iface, IAsyncOperationCompletedHandler_boolean *handler )
+{
+    return async_value_put_Completed( iface, handler );
+}
+
+static HRESULT WINAPI async_boolean_get_Completed( IAsyncOperation_boolean *iface, IAsyncOperationCompletedHandler_boolean **handler )
+{
+    return async_value_get_Completed( iface, (void **)handler );
+}
+
+static HRESULT WINAPI async_boolean_GetResults( IAsyncOperation_boolean *iface, boolean *results )
+{
+    PROPVARIANT result;
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    if (SUCCEEDED(hr = async_value_result( iface, &result ))) *results = result.boolVal != VARIANT_FALSE;
+    PropVariantClear( &result );
+    return hr;
+}
+
+static const struct IAsyncOperation_booleanVtbl async_boolean_vtbl =
+{
+    (void *)async_value_QueryInterface,
+    (void *)async_value_AddRef,
+    (void *)async_value_Release,
+    /* IInspectable methods */
+    (void *)async_value_GetIids,
+    (void *)async_value_GetRuntimeClassName,
+    (void *)async_value_GetTrustLevel,
+    /* IAsyncOperation<boolean> */
+    async_boolean_put_Completed,
+    async_boolean_get_Completed,
+    async_boolean_GetResults,
+};
+
+/* IAsyncOperationWithProgress<UINT32, UINT32> */
+
+static HRESULT WINAPI async_uint32_put_Progress( IAsyncOperationWithProgress_UINT32_UINT32 *iface,
+                                                 IAsyncOperationProgressHandler_UINT32_UINT32 *handler )
+{
+    return async_value_put_Progress( iface, (IUnknown *)handler );
+}
+
+static HRESULT WINAPI async_uint32_get_Progress( IAsyncOperationWithProgress_UINT32_UINT32 *iface,
+                                                 IAsyncOperationProgressHandler_UINT32_UINT32 **handler )
+{
+    return async_value_get_Progress( iface, (IUnknown **)handler );
+}
+
+static HRESULT WINAPI async_uint32_put_Completed( IAsyncOperationWithProgress_UINT32_UINT32 *iface,
+                                                  IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 *handler )
+{
+    return async_value_put_Completed( iface, handler );
+}
+
+static HRESULT WINAPI async_uint32_get_Completed( IAsyncOperationWithProgress_UINT32_UINT32 *iface,
+                                                  IAsyncOperationWithProgressCompletedHandler_UINT32_UINT32 **handler )
+{
+    return async_value_get_Completed( iface, (void **)handler );
+}
+
+static HRESULT WINAPI async_uint32_GetResults( IAsyncOperationWithProgress_UINT32_UINT32 *iface, UINT32 *results )
+{
+    PROPVARIANT result;
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    if (SUCCEEDED(hr = async_value_result( iface, &result ))) *results = result.ulVal;
+    PropVariantClear( &result );
+    return hr;
+}
+
+static const struct IAsyncOperationWithProgress_UINT32_UINT32Vtbl async_uint32_vtbl =
+{
+    (void *)async_value_QueryInterface,
+    (void *)async_value_AddRef,
+    (void *)async_value_Release,
+    /* IInspectable methods */
+    (void *)async_value_GetIids,
+    (void *)async_value_GetRuntimeClassName,
+    (void *)async_value_GetTrustLevel,
+    /* IAsyncOperationWithProgress<UINT32, UINT32> */
+    async_uint32_put_Progress,
+    async_uint32_get_Progress,
+    async_uint32_put_Completed,
+    async_uint32_get_Completed,
+    async_uint32_GetResults,
+};
+
+/* IAsyncOperationWithProgress<IBuffer *, UINT32> */
+
+static HRESULT WINAPI async_buffer_put_Progress( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+                                                 IAsyncOperationProgressHandler_IBuffer_UINT32 *handler )
+{
+    return async_value_put_Progress( iface, (IUnknown *)handler );
+}
+
+static HRESULT WINAPI async_buffer_get_Progress( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+                                                 IAsyncOperationProgressHandler_IBuffer_UINT32 **handler )
+{
+    return async_value_get_Progress( iface, (IUnknown **)handler );
+}
+
+static HRESULT WINAPI async_buffer_put_Completed( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+                                                  IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *handler )
+{
+    return async_value_put_Completed( iface, handler );
+}
+
+static HRESULT WINAPI async_buffer_get_Completed( IAsyncOperationWithProgress_IBuffer_UINT32 *iface,
+                                                  IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 **handler )
+{
+    return async_value_get_Completed( iface, (void **)handler );
+}
+
+static HRESULT WINAPI async_buffer_GetResults( IAsyncOperationWithProgress_IBuffer_UINT32 *iface, IBuffer **results )
+{
+    PROPVARIANT result;
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    *results = NULL;
+    if (SUCCEEDED(hr = async_value_result( iface, &result )) && result.vt == VT_UNKNOWN && result.punkVal)
+        hr = IUnknown_QueryInterface( result.punkVal, &IID_IBuffer, (void **)results );
+    PropVariantClear( &result );
+    return hr;
+}
+
+static const struct IAsyncOperationWithProgress_IBuffer_UINT32Vtbl async_buffer_vtbl =
+{
+    (void *)async_value_QueryInterface,
+    (void *)async_value_AddRef,
+    (void *)async_value_Release,
+    /* IInspectable methods */
+    (void *)async_value_GetIids,
+    (void *)async_value_GetRuntimeClassName,
+    (void *)async_value_GetTrustLevel,
+    /* IAsyncOperationWithProgress<IBuffer *, UINT32> */
+    async_buffer_put_Progress,
+    async_buffer_get_Progress,
+    async_buffer_put_Completed,
+    async_buffer_get_Completed,
+    async_buffer_GetResults,
+};
+
+static HRESULT async_value_create( const void *vtbl, const GUID *iid, const WCHAR *class_name, IUnknown *invoker,
+                                   IUnknown *param, async_operation_callback callback, void **out )
+{
+    struct async_value *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_iface.lpVtbl = vtbl;
+    impl->ref = 1;
+    impl->iid = iid;
+    impl->class_name = class_name;
+
+    if (FAILED(hr = async_info_create( invoker, param, callback, &impl->IInspectable_iface, &impl->IAsyncInfoImpl_inner )) ||
+        FAILED(hr = IAsyncInfoImpl_Start( impl->IAsyncInfoImpl_inner )))
+    {
+        if (impl->IAsyncInfoImpl_inner) IAsyncInfoImpl_Release( impl->IAsyncInfoImpl_inner );
+        free( impl );
+        return hr;
+    }
+
+    *out = &impl->IInspectable_iface;
+    TRACE( "created %s %p\n", debugstr_w( class_name ), *out );
+    return S_OK;
+}
+
+HRESULT async_operation_boolean_create( IUnknown *invoker, IUnknown *param, async_operation_callback callback,
+                                        IAsyncOperation_boolean **out )
+{
+    return async_value_create( &async_boolean_vtbl, &IID_IAsyncOperation_boolean,
+                               L"Windows.Foundation.IAsyncOperation`1<Boolean>", invoker, param, callback, (void **)out );
+}
+
+HRESULT async_operation_uint32_progress_create( IUnknown *invoker, IUnknown *param, async_operation_callback callback,
+                                                IAsyncOperationWithProgress_UINT32_UINT32 **out )
+{
+    return async_value_create( &async_uint32_vtbl, &IID_IAsyncOperationWithProgress_UINT32_UINT32,
+                               L"Windows.Foundation.IAsyncOperationWithProgress`2<UInt32, UInt32>",
+                               invoker, param, callback, (void **)out );
+}
+
+HRESULT async_operation_buffer_progress_create( IUnknown *invoker, IUnknown *param, async_operation_callback callback,
+                                                IAsyncOperationWithProgress_IBuffer_UINT32 **out )
+{
+    return async_value_create( &async_buffer_vtbl, &IID_IAsyncOperationWithProgress_IBuffer_UINT32,
+                               L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Storage.Streams.IBuffer, UInt32>",
+                               invoker, param, callback, (void **)out );
+}
