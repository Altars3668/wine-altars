+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;                                              \
+    impl->IVector_iface.lpVtbl = &name##_vector_vtbl;                                                            \
+    impl->IIterable_iface.lpVtbl = &name##_vector_iterable_vtbl;                                                 \
+    impl->ref = 1;                                                                                               \
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );                     \
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": " #name "_vector.cs");                               \
+    *out = &impl->IVector_iface;                                                                                 \
+    return S_OK;                                                                                                 \
+}                                                                                                                \
