+
+/* an empty view of certificates, for a connection that has none to tell of */
+struct empty_certificates
+{
+    IVectorView_Certificate IVectorView_iface;
+    LONG ref;
+};
+
+static HRESULT WINAPI empty_QueryInterface( IVectorView_Certificate *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IVectorView_Certificate ))
+    {
+        IInspectable_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI empty_AddRef( IVectorView_Certificate *iface )
+{
+    struct empty_certificates *impl = CONTAINING_RECORD( iface, struct empty_certificates, IVectorView_iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI empty_Release( IVectorView_Certificate *iface )
+{
+    struct empty_certificates *impl = CONTAINING_RECORD( iface, struct empty_certificates, IVectorView_iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI empty_GetIids( IVectorView_Certificate *iface, ULONG *count, IID **iids ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI empty_GetRuntimeClassName( IVectorView_Certificate *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.Foundation.Collections.IVectorView`1<Windows.Security.Cryptography.Certificates.Certificate>";
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
+}
+
+static HRESULT WINAPI empty_GetTrustLevel( IVectorView_Certificate *iface, TrustLevel *level ) { return E_NOTIMPL; }
+
+static HRESULT WINAPI empty_GetAt( IVectorView_Certificate *iface, UINT32 index, ICertificate **value )
+{
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return E_BOUNDS;
+}
+
+static HRESULT WINAPI empty_get_Size( IVectorView_Certificate *iface, UINT32 *value )
+{
+    if (!value) return E_POINTER;
+    *value = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI empty_IndexOf( IVectorView_Certificate *iface, ICertificate *element, UINT32 *index, boolean *found )
+{
+    if (!index || !found) return E_POINTER;
+    *index = 0;
+    *found = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI empty_GetMany( IVectorView_Certificate *iface, UINT32 start, UINT32 size, ICertificate **items, UINT32 *count )
+{
+    if (!count) return E_POINTER;
+    if (start) return E_BOUNDS;
+    *count = 0;
+    return S_OK;
+}
+
+static const struct IVectorView_CertificateVtbl empty_vtbl =
+{
+    empty_QueryInterface,
+    empty_AddRef,
+    empty_Release,
+    empty_GetIids,
+    empty_GetRuntimeClassName,
+    empty_GetTrustLevel,
+    empty_GetAt,
+    empty_get_Size,
+    empty_IndexOf,
+    empty_GetMany,
+};
+
+HRESULT empty_certificates_create( IVectorView_Certificate **out )
+{
+    struct empty_certificates *impl;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVectorView_iface.lpVtbl = &empty_vtbl;
+    impl->ref = 1;
+    *out = &impl->IVectorView_iface;
+    return S_OK;
+}
