+/* the security flags the certificate errors the caller would ignore stand for */
+static DWORD security_flags( struct websocket_control *control )
+{
+    ChainValidationResult errors[16];
+    UINT32 count = 0, i;
+    DWORD flags = 0;
+
+    if (FAILED(IVector_ChainValidationResult_GetMany( control->ignorable_errors, 0, ARRAY_SIZE(errors), errors, &count )))
+        return 0;
+    for (i = 0; i < count; i++)
+    {
+        switch (errors[i])
+        {
+        case ChainValidationResult_Expired:
+            flags |= SECURITY_FLAG_IGNORE_CERT_DATE_INVALID;
+            break;
+        case ChainValidationResult_InvalidName:
+            flags |= SECURITY_FLAG_IGNORE_CERT_CN_INVALID;
+            break;
+        case ChainValidationResult_Untrusted:
+        case ChainValidationResult_IncompleteChain:
+            flags |= SECURITY_FLAG_IGNORE_UNKNOWN_CA;
+            break;
+        case ChainValidationResult_WrongUsage:
+            flags |= SECURITY_FLAG_IGNORE_CERT_WRONG_USAGE;
+            break;
+        default:
+            FIXME( "cannot ignore %d.\n", errors[i] );
+            break;
+        }
+    }
+    return flags;
+}
