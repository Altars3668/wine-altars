+        IDataReaderStatics *tmp;
+        if (FAILED(hr = WindowsCreateString( RuntimeClass_Windows_Storage_Streams_DataReader,
+                                             wcslen( RuntimeClass_Windows_Storage_Streams_DataReader ), &name )))
