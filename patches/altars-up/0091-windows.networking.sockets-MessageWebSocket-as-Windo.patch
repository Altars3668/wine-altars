+static HRESULT websocket_connect( struct message_websocket *impl, const WCHAR *uri )
+{
+    struct websocket_transport transport = {0};
+    struct websocket_control *control = impl->control;
+    WCHAR host[256], path[2048], protocol[256];
+    DWORD status = 0, size, flags, err;
+    INTERNET_PORT port = 0;
+    struct request_header *header;
+    IHostName *address;
+    BOOL secure = FALSE;
+    HSTRING str;
+    UINT32 count, i;
+    HRESULT hr;
+
+    path[0] = 0;
+    if (FAILED(hr = split_uri( uri, host, ARRAY_SIZE(host), &port, path, ARRAY_SIZE(path), &secure )))
+    {
+        WARN( "cannot parse %s.\n", debugstr_w( uri ) );
+        return E_INVALIDARG;
+    }
+
+    TRACE( "connecting to %s port %u path %s%s.\n", debugstr_w( host ), port, debugstr_w( path ), secure ? " (tls)" : "" );
+
+    if (!(transport.session = WinHttpOpen( NULL, WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY, WINHTTP_NO_PROXY_NAME,
+                                           WINHTTP_NO_PROXY_BYPASS, 0 )))
+        goto failed;
+    if (!(transport.connect = WinHttpConnect( transport.session, host, port, 0 )))
+        goto failed;
+    if (!(transport.request = WinHttpOpenRequest( transport.connect, L"GET", path, NULL, WINHTTP_NO_REFERER,
+                                                  WINHTTP_DEFAULT_ACCEPT_TYPES, secure ? WINHTTP_FLAG_SECURE : 0 )))
+        goto failed;
+
+    /* whatever the caller asked to be sent with the handshake, first */
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( header, &impl->request_headers, struct request_header, entry )
+    {
+        const WCHAR *name = WindowsGetStringRawBuffer( header->name, NULL );
+        const WCHAR *value = WindowsGetStringRawBuffer( header->value, NULL );
+        WCHAR *line;
+        SIZE_T len;
+
+        len = wcslen( name ) + wcslen( value ) + 3;
+        if (!(line = malloc( len * sizeof(WCHAR) ))) continue;
+        swprintf( line, len, L"%s: %s", name, value );
+        WinHttpAddRequestHeaders( transport.request, line, -1, WINHTTP_ADDREQ_FLAG_ADD );
+        free( line );
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    /* the protocols asked for */
+    protocol[0] = 0;
+    if (SUCCEEDED(IVector_HSTRING_get_Size( control->protocols, &count )) && count)
+    {
+        wcscpy( protocol, L"Sec-WebSocket-Protocol: " );
+        for (i = 0; i < count; i++)
+        {
+            if (FAILED(IVector_HSTRING_GetAt( control->protocols, i, &str ))) continue;
+            if (wcslen( protocol ) + WindowsGetStringLen( str ) + 3 < ARRAY_SIZE(protocol))
+            {
+                if (i) wcscat( protocol, L", " );
+                wcscat( protocol, WindowsGetStringRawBuffer( str, NULL ) );
+            }
+            WindowsDeleteString( str );
+        }
+        WinHttpAddRequestHeaders( transport.request, protocol, -1, WINHTTP_ADDREQ_FLAG_ADD );
+    }
+    /* Windows asks that nothing on the way answer from a cache */
+    WinHttpAddRequestHeaders( transport.request, L"Cache-Control: no-cache", -1, WINHTTP_ADDREQ_FLAG_ADD );
+
+    EnterCriticalSection( &control->cs );
+    if ((flags = security_flags( control )))
+        WinHttpSetOption( transport.request, WINHTTP_OPTION_SECURITY_FLAGS, &flags, sizeof(flags) );
+    set_credential( transport.request, control->server_credential, WINHTTP_OPTION_USERNAME, WINHTTP_OPTION_PASSWORD );
+    set_credential( transport.request, control->proxy_credential, WINHTTP_OPTION_PROXY_USERNAME,
+                    WINHTTP_OPTION_PROXY_PASSWORD );
+    LeaveCriticalSection( &control->cs );
+
+    if (!WinHttpSetOption( transport.request, WINHTTP_OPTION_UPGRADE_TO_WEB_SOCKET, NULL, 0 ))
+        goto failed;
+    if (!WinHttpSendRequest( transport.request, WINHTTP_NO_ADDITIONAL_HEADERS, 0, WINHTTP_NO_REQUEST_DATA, 0, 0, 0 ))
+        goto failed;
+    if (!WinHttpReceiveResponse( transport.request, NULL ))
+        goto failed;
+
+    /* a server that will not upgrade answers with its status */
+    size = sizeof(status);
+    WinHttpQueryHeaders( transport.request, WINHTTP_QUERY_STATUS_CODE | WINHTTP_QUERY_FLAG_NUMBER,
+                         WINHTTP_HEADER_NAME_BY_INDEX, &status, &size, WINHTTP_NO_HEADER_INDEX );
+    if (status != 101)
+    {
+        WARN( "server answered %lu.\n", status );
+        transport_close( &transport );
+        return 0x80190000 | (status & 0xffff);
+    }
+
+    if (!(transport.socket = WinHttpWebSocketCompleteUpgrade( transport.request, 0 )))
+        goto failed;
+
+    /* what the server chose, and where this end is */
+    size = sizeof(protocol);
+    if (!WinHttpQueryHeaders( transport.request, WINHTTP_QUERY_CUSTOM, L"Sec-WebSocket-Protocol", protocol, &size,
+                              WINHTTP_NO_HEADER_INDEX ))
+        protocol[0] = 0;
+    address = local_address( transport.request );
+    EnterCriticalSection( &impl->information->cs );
+    WindowsDeleteString( impl->information->protocol );
+    impl->information->protocol = NULL;
+    if (*protocol) WindowsCreateString( protocol, wcslen( protocol ), &impl->information->protocol );
+    if (impl->information->local_address) IHostName_Release( impl->information->local_address );
+    impl->information->local_address = address;
+    LeaveCriticalSection( &impl->information->cs );
+
+    /* the request handle has done its job once the upgrade is through */
+    WinHttpCloseHandle( transport.request );
+    transport.request = NULL;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->state == SOCKET_CLOSED)
+    {
+        /* closed while it was connecting */
+        LeaveCriticalSection( &impl->cs );
+        transport_close( &transport );
+        return RO_E_CLOSED;
+    }
+    impl->transport = transport;
+    impl->state = SOCKET_OPEN;
+    /* the thread holds a reference so the socket cannot go away under it */
+    IMessageWebSocket_AddRef( &impl->IMessageWebSocket_iface );
+    if (!(impl->receive_thread = CreateThread( NULL, 0, receive_thread_proc, impl, 0, NULL )))
+    {
+        err = GetLastError();
+        memset( &impl->transport, 0, sizeof(impl->transport) );
+        impl->state = SOCKET_NEW;
+        LeaveCriticalSection( &impl->cs );
+        IMessageWebSocket_Release( &impl->IMessageWebSocket_iface );
+        transport_close( &transport );
+        return HRESULT_FROM_WIN32( err );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+
+failed:
+    hr = HRESULT_FROM_WIN32( GetLastError() );
+    WARN( "connect failed, hr %#lx.\n", hr );
+    transport_close( &transport );
+    return hr;
+}
+
+static HRESULT connect_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct message_websocket *impl = impl_from_IMessageWebSocket( (IMessageWebSocket *)invoker );
+    WCHAR *uri;
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+
+    if (!(uri = http_uri( (IUriRuntimeClass *)param ))) return E_INVALIDARG;
+    hr = websocket_connect( impl, uri );
+    free( uri );
+
+    if (FAILED(hr))
+    {
+        EnterCriticalSection( &impl->cs );
+        if (impl->state == SOCKET_CONNECTING) impl->state = SOCKET_NEW;
+        LeaveCriticalSection( &impl->cs );
+    }
+    return hr;
+}
