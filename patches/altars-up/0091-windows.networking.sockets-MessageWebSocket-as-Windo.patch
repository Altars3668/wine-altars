+static void set_credential( HINTERNET request, IPasswordCredential *credential, DWORD user_option, DWORD password_option )
+{
+    HSTRING user = NULL, password = NULL;
+
+    if (!credential) return;
+    if (SUCCEEDED(IPasswordCredential_get_UserName( credential, &user )) && user)
+        WinHttpSetOption( request, user_option, (void *)WindowsGetStringRawBuffer( user, NULL ), WindowsGetStringLen( user ) );
+    if (SUCCEEDED(IPasswordCredential_get_Password( credential, &password )) && password)
+        WinHttpSetOption( request, password_option, (void *)WindowsGetStringRawBuffer( password, NULL ),
+                          WindowsGetStringLen( password ) );
+    WindowsDeleteString( user );
+    WindowsDeleteString( password );
+}
