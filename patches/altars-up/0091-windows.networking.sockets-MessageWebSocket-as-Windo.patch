+/*** receiving ***/
+
+static void raise_closed( struct message_websocket *impl, UINT16 code, const WCHAR *reason )
+{
+    ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs *handler;
+    IWebSocketClosedEventArgs *args;
+
+    EnterCriticalSection( &impl->cs );
+    if ((handler = impl->closed)) ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_AddRef( handler );
+    LeaveCriticalSection( &impl->cs );
+    if (!handler) return;
+
+    if (SUCCEEDED(closed_event_args_create( code, reason, &args )))
+    {
+        ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_Invoke( handler, &impl->IWebSocket_iface, args );
+        IWebSocketClosedEventArgs_Release( args );
+    }
+    ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_Release( handler );
+}
