+/*
+ * The web socket control hands out two vectors the caller fills before
+ * connecting: SupportedProtocols, of strings, and
+ * IgnorableServerCertificateErrors, of ChainValidationResult.  Each is an
+ * IVector with its IIterable, a view that is a copy taken when it is asked
+ * for, and an iterator over such a copy.  The two differ only in the element
+ * type, so they are written once below and instantiated twice.
+ */
+
+static HRESULT copy_hstring( HSTRING src, HSTRING *dst ) { return WindowsDuplicateString( src, dst ); }
+static void free_hstring( HSTRING value ) { WindowsDeleteString( value ); }
+static BOOL equal_hstring( HSTRING a, HSTRING b )
+{
+    INT32 order;
+    return SUCCEEDED(WindowsCompareStringOrdinal( a, b, &order )) && !order;
+}
+
+static HRESULT copy_chain( ChainValidationResult src, ChainValidationResult *dst ) { *dst = src; return S_OK; }
+static void free_chain( ChainValidationResult value ) { }
+static BOOL equal_chain( ChainValidationResult a, ChainValidationResult b ) { return a == b; }
+
+#define DEFINE_VECTOR( name, type, suffix, class_suffix, copy, free_value, equal )                              \
+                                                                                                                 \
+struct name##_view                                                                                               \
+{                                                                                                                \
+    IVectorView_##suffix IVectorView_iface;                                                                      \
+    IIterable_##suffix IIterable_iface;                                                                          \
+    LONG ref;                                                                                                    \
+    UINT32 size;                                                                                                 \
+    type *elements;                                                                                              \
+};                                                                                                               \
+                                                                                                                 \
+struct name##_iterator                                                                                           \
+{                                                                                                                \
+    IIterator_##suffix IIterator_iface;                                                                          \
+    LONG ref;                                                                                                    \
+    struct name##_view *view;                                                                                    \
+    UINT32 index;                                                                                                \
+};                                                                                                               \
+                                                                                                                 \
+struct name##_vector                                                                                             \
+{                                                                                                                \
+    IVector_##suffix IVector_iface;                                                                              \
+    IIterable_##suffix IIterable_iface;                                                                          \
+    LONG ref;                                                                                                    \
+    CRITICAL_SECTION cs;                                                                                         \
+    UINT32 size;                                                                                                 \
+    UINT32 capacity;                                                                                             \
+    type *elements;                                                                                              \
+};                                                                                                               \
+                                                                                                                 \
+static HRESULT name##_view_create( struct name##_vector *vector, struct name##_view **out );                     \
+                                                                                                                 \
+/* the iterator */                                                                                               \
+                                                                                                                 \
+static inline struct name##_iterator *name##_impl_from_IIterator( IIterator_##suffix *iface )                    \
+{                                                                                                                \
+    return CONTAINING_RECORD( iface, struct name##_iterator, IIterator_iface );                                  \
+}                                                                                                                \
+                                                                                                                 \
+static HRESULT WINAPI name##_iterator_QueryInterface( IIterator_##suffix *iface, REFIID iid, void **out )         \
+{                                                                                                                \
+    struct name##_iterator *impl = name##_impl_from_IIterator( iface );                                          \
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||                            \
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IIterator_##suffix ))                    \
+    {                                                                                                            \
+        IInspectable_AddRef( (*out = &impl->IIterator_iface) );                                                  \
+        return S_OK;                                                                                             \
+    }                                                                                                            \
+    *out = NULL;                                                                                                 \
+    return E_NOINTERFACE;                                                                                        \
+}                                                                                                                \
+                                                                                                                 \
+static ULONG WINAPI name##_iterator_AddRef( IIterator_##suffix *iface )                                          \
+{                                                                                                                \
+    struct name##_iterator *impl = name##_impl_from_IIterator( iface );                                          \
+    return InterlockedIncrement( &impl->ref );                                                                   \
+}                                                                                                                \
+                                                                                                                 \
+static ULONG WINAPI name##_iterator_Release( IIterator_##suffix *iface )                                         \
+{                                                                                                                \
+    struct name##_iterator *impl = name##_impl_from_IIterator( iface );                                          \
+    ULONG ref = InterlockedDecrement( &impl->ref );                                                              \
+    if (!ref)                                                                                                    \
+    {                                                                                                            \
+        IVectorView_##suffix##_Release( &impl->view->IVectorView_iface );                                        \
+        free( impl );                                                                                            \
+    }                                                                                                            \
+    return ref;                                                                                                  \
+}                                                                                                                \
+                                                                                                                 \
+static HRESULT WINAPI name##_iterator_GetIids( IIterator_##suffix *iface, ULONG *count, IID **iids )             \
+{                                                                                                                \
+    return E_NOTIMPL;                                                                                            \
+}                                                                                                                \
+                                                                                                                 \
+static HRESULT WINAPI name##_iterator_GetRuntimeClassName( IIterator_##suffix *iface, HSTRING *class_name )      \
+{                                                                                                                \
+    static const WCHAR name[] = L"Windows.Foundation.Collections.IIterator`1<" class_suffix L">";               \
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );                                        \
+}                                                                                                                \
+                                                                                                                 \
+static HRESULT WINAPI name##_iterator_GetTrustLevel( IIterator_##suffix *iface, TrustLevel *level )              \
+{                                                                                                                \
+    return E_NOTIMPL;                                                                                            \
+}                                                                                                                \
+                                                                                                                 \
+static HRESULT WINAPI name##_iterator_get_Current( IIterator_##suffix *iface, type *value )                      \
+{                                                                                                                \
+    struct name##_iterator *impl = name##_impl_from_IIterator( iface );                                          \
+    if (!value) return E_POINTER;                                                                                \
+    if (impl->index >= impl->view->size) return E_BOUNDS;                                                        \
+    return copy( impl->view->elements[impl->index], value );                                                     \
+}                                                                                                                \
+                                                                                                                 \
+static HRESULT WINAPI name##_iterator_get_HasCurrent( IIterator_##suffix *iface, boolean *value )                \
+{                                                                                                                \
+    struct name##_iterator *impl = name##_impl_from_IIterator( iface );                                          \
+    if (!value) return E_POINTER;                                                                                \
+    *value = impl->index < impl->view->size;                                                                     \
+    return S_OK;                                                                                                 \
+}                                                                                                                \
+                                                                                                                 \
+static HRESULT WINAPI name##_iterator_MoveNext( IIterator_##suffix *iface, boolean *value )                      \
+{                                                                                                                \
+    struct name##_iterator *impl = name##_impl_from_IIterator( iface );                                          \
+    if (!value) return E_POINTER;                                                                                \
+    if (impl->index < impl->view->size) impl->index++;                                                           \
+    *value = impl->index < impl->view->size;                                                                     \
+    return S_OK;                                                                                                 \
+}                                                                                                                \
+                                                                                                                 \
+static HRESULT WINAPI name##_iterator_GetMany( IIterator_##suffix *iface, UINT32 items_size, type *items,         \
+                                               UINT32 *count )                                                   \
+{                                                                                                                \
+    struct name##_iterator *impl = name##_impl_from_IIterator( iface );                                          \
+    UINT32 i;                                                                                                    \
+    HRESULT hr;                                                                                                  \
+    if (!count) return E_POINTER;                                                                                \
+    for (i = 0; i < items_size && impl->index < impl->view->size; i++, impl->index++)                            \
+        if (FAILED(hr = copy( impl->view->elements[impl->index], &items[i] ))) return hr;                        \
+    *count = i;                                                                                                  \
+    return S_OK;                                                                                                 \
+}                                                                                                                \
+                                                                                                                 \
+static const struct IIterator_##suffix##Vtbl name##_iterator_vtbl =                                              \
+{                                                                                                                \
+    name##_iterator_QueryInterface,                                                                              \
+    name##_iterator_AddRef,                                                                                      \
+    name##_iterator_Release,                                                                                     \
+    name##_iterator_GetIids,                                                                                     \
+    name##_iterator_GetRuntimeClassName,                                                                         \
+    name##_iterator_GetTrustLevel,                                                                               \
+    name##_iterator_get_Current,                                                                                 \
+    name##_iterator_get_HasCurrent,                                                                              \
+    name##_iterator_MoveNext,                                                                                    \
+    name##_iterator_GetMany,                                                                                     \
+};                                                                                                               \
+                                                                                                                 \
+static HRESULT name##_iterator_create( struct name##_view *view, IIterator_##suffix **out )                      \
+{                                                                                                                \
+    struct name##_iterator *impl;                                                                                \
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;                                              \
