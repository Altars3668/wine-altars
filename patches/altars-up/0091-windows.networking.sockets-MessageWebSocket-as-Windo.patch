+/* takes the data; with an error, the message is that error */
+static void raise_message( struct message_websocket *impl, SocketMessageType type, boolean complete,
+                           BYTE *data, UINT32 size, HRESULT error )
+{
+    ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs *handler;
+    IMessageWebSocketMessageReceivedEventArgs *args;
+
+    EnterCriticalSection( &impl->cs );
+    if ((handler = impl->message_received))
+        ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs_AddRef( handler );
+    LeaveCriticalSection( &impl->cs );
+    if (!handler)
+    {
+        free( data );
+        return;
+    }
+
+    if (SUCCEEDED(message_event_args_create( type, complete, data, size, error, &args )))
+    {
+        ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs_Invoke(
+                handler, &impl->IMessageWebSocket_iface, args );
+        IMessageWebSocketMessageReceivedEventArgs_Release( args );
+    }
+    else free( data );
+    ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs_Release( handler );
+}
