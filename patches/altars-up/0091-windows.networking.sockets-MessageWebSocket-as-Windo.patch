+/* Take the address apart with the parser winhttp already has, so a URI this
+ * accepts is one winhttp will accept too. */
+static HRESULT split_uri( const WCHAR *uri, WCHAR *host, DWORD host_len, INTERNET_PORT *port,
+                          WCHAR *path, DWORD path_len, BOOL *secure )
+{
+    URL_COMPONENTS components = {.dwStructSize = sizeof(components)};
+
+    components.lpszHostName = host;
+    components.dwHostNameLength = host_len;
+    components.lpszUrlPath = path;
+    components.dwUrlPathLength = path_len;
+    components.dwExtraInfoLength = 1;
+
+    if (!WinHttpCrackUrl( uri, 0, 0, &components )) return HRESULT_FROM_WIN32( GetLastError() );
+
+    /* the query is part of what is asked for */
+    if (components.lpszExtraInfo && components.dwExtraInfoLength &&
+        wcslen( path ) + components.dwExtraInfoLength < path_len)
+        wcsncat( path, components.lpszExtraInfo, components.dwExtraInfoLength );
+    *port = components.nPort;
+    *secure = (components.nScheme == INTERNET_SCHEME_HTTPS);
+    return S_OK;
+}
+
+/* ws and wss only: http becomes ws and https wss for winhttp */
+static WCHAR *http_uri( IUriRuntimeClass *uri )
+{
+    HSTRING scheme = NULL, raw = NULL;
+    const WCHAR *text, *rest;
+    WCHAR *ret = NULL;
+    BOOL secure;
+
+    if (FAILED(IUriRuntimeClass_get_SchemeName( uri, &scheme ))) return NULL;
+    text = WindowsGetStringRawBuffer( scheme, NULL );
+    if (!wcsicmp( text, L"ws" )) secure = FALSE;
+    else if (!wcsicmp( text, L"wss" )) secure = TRUE;
+    else
+    {
+        WindowsDeleteString( scheme );
+        return NULL;
+    }
+    WindowsDeleteString( scheme );
+
+    if (FAILED(IUriRuntimeClass_get_AbsoluteUri( uri, &raw ))) return NULL;
+    text = WindowsGetStringRawBuffer( raw, NULL );
+    if ((rest = wcschr( text, ':' )) && (ret = malloc( (wcslen( rest ) + 6) * sizeof(WCHAR) )))
+    {
+        wcscpy( ret, secure ? L"https" : L"http" );
+        wcscat( ret, rest );
+    }
+    WindowsDeleteString( raw );
+    return ret;
+}
+
+static HRESULT hostname_create( const WCHAR *name, IHostName **out )
+{
+    static IHostNameFactory *factory;
+    HSTRING str;
+    HRESULT hr;
+
+    if (!factory)
+    {
+        IHostNameFactory *tmp;
+        if (FAILED(hr = WindowsCreateString( RuntimeClass_Windows_Networking_HostName,
+                                             wcslen( RuntimeClass_Windows_Networking_HostName ), &str )))
+            return hr;
+        hr = RoGetActivationFactory( str, &IID_IHostNameFactory, (void **)&tmp );
+        WindowsDeleteString( str );
+        if (FAILED(hr)) return hr;
+        if (InterlockedCompareExchangePointer( (void **)&factory, tmp, NULL )) IHostNameFactory_Release( tmp );
+    }
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &str ))) return hr;
+    hr = IHostNameFactory_CreateHostName( factory, str, out );
+    WindowsDeleteString( str );
+    return hr;
+}
+
+/* the address this end of the connection has */
+static IHostName *local_address( HINTERNET request )
+{
+    WINHTTP_CONNECTION_INFO info = {.cbSize = sizeof(info)};
+    DWORD size = sizeof(info), len;
+    WCHAR buffer[64];
+    IHostName *ret = NULL;
+
+    if (!WinHttpQueryOption( request, WINHTTP_OPTION_CONNECTION_INFO, &info, &size )) return NULL;
+    len = ARRAY_SIZE(buffer);
+    if (info.LocalAddress.ss_family == AF_INET)
+    {
+        struct sockaddr_in *addr = (struct sockaddr_in *)&info.LocalAddress;
+        if (!InetNtopW( AF_INET, &addr->sin_addr, buffer, len )) return NULL;
+    }
+    else if (info.LocalAddress.ss_family == AF_INET6)
+    {
+        struct sockaddr_in6 *addr = (struct sockaddr_in6 *)&info.LocalAddress;
+        if (!InetNtopW( AF_INET6, &addr->sin6_addr, buffer, len )) return NULL;
+    }
+    else return NULL;
+    if (FAILED(hostname_create( buffer, &ret ))) return NULL;
+    return ret;
+}
