+/*
+ * One frame at a time out of winhttp, gathered into a message: a whole
+ * message raises MessageReceived, or with PartialMessage each fragment does.
+ * The loop ends as Windows' does:
+ * - at the peer's close frame, raising Closed with its code and reason
+ *   (1005 for an empty one); this side can still write until it closes;
+ * - when the connection ends after this side's Close, raising Closed with
+ *   1006, the peer having never answered;
+ * - when the connection ends otherwise, or the peer breaks the protocol,
+ *   raising no Closed but a last MessageReceived whose data is the error,
+ *   and writes fail from then on.
+ */
+static DWORD WINAPI receive_thread_proc( void *arg )
+{
+    struct message_websocket *impl = arg;
+    SocketMessageType message_type = SocketMessageType_Binary;
+    BYTE *message = NULL, frame[65536];
+    BOOL close_frame = FALSE, closed;
+    UINT32 message_size = 0;
+    USHORT code = 1006;
+    WCHAR reason[124] = {0};
+    DWORD err = ERROR_SUCCESS;
+    HINTERNET socket;
+
+    EnterCriticalSection( &impl->cs );
+    socket = impl->transport.socket;
+    LeaveCriticalSection( &impl->cs );
+
+    for (;;)
+    {
+        WINHTTP_WEB_SOCKET_BUFFER_TYPE type;
+        MessageWebSocketReceiveMode mode;
+        DWORD read = 0;
+        BOOL last;
+        void *grown;
+
+        if ((err = WinHttpWebSocketReceive( socket, frame, sizeof(frame), &read, &type )))
+        {
+            TRACE( "receive ended, error %lu.\n", err );
+            break;
+        }
+
+        if (type == WINHTTP_WEB_SOCKET_CLOSE_BUFFER_TYPE)
+        {
+            BYTE raw[123];
+            DWORD len = 0;
+
+            if (!WinHttpWebSocketQueryCloseStatus( socket, &code, raw, sizeof(raw), &len ))
+                reason[MultiByteToWideChar( CP_UTF8, 0, (char *)raw, len, reason, ARRAY_SIZE(reason) - 1 )] = 0;
+            TRACE( "closed by the peer, code %u reason %s.\n", code, debugstr_w( reason ) );
+            close_frame = TRUE;
+            break;
+        }
+
+        last = (type == WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE ||
+                type == WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE);
+        if (type == WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE || type == WINHTTP_WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE)
+            message_type = SocketMessageType_Utf8;
+        else
+            message_type = SocketMessageType_Binary;
+
+        if (!(grown = realloc( message, max( 1, message_size + read ) )))
+        {
+            ERR( "out of memory assembling a %u byte message.\n", (UINT)(message_size + read) );
+            break;
+        }
+        message = grown;
+        memcpy( message + message_size, frame, read );
+        message_size += read;
+
+        EnterCriticalSection( &impl->control->cs );
+        mode = impl->control->receive_mode;
+        LeaveCriticalSection( &impl->control->cs );
+        /* winhttp hands a long frame over in parts; only a message's end ends it */
+        if (last || mode == MessageWebSocketReceiveMode_PartialMessage)
+        {
+            raise_message( impl, message_type, last, message, message_size, S_OK );
+            message = NULL;
+            message_size = 0;
+        }
+    }
+    free( message );
+
+    EnterCriticalSection( &impl->cs );
+    closed = impl->state == SOCKET_CLOSED;
+    if (!close_frame && !closed) impl->lost = TRUE;
+    LeaveCriticalSection( &impl->cs );
+
+    /* a server breaking the protocol says so; otherwise the connection went away */
+    if (err != ERROR_WINHTTP_INVALID_SERVER_RESPONSE) err = ERROR_WINHTTP_CONNECTION_ERROR;
+    if (close_frame || closed) raise_closed( impl, code, reason );
+    else raise_message( impl, SocketMessageType_Utf8, TRUE, NULL, 0, HRESULT_FROM_WIN32( err ) );
+    IMessageWebSocket_Release( &impl->IMessageWebSocket_iface );
+    return 0;
+}
