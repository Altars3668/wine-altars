+/*** sending ***/
+
+/* what a send asks for, handed to the operation that does it: a frame, or
+ * the close frame (close is set, the data is the reason) */
+struct send_request
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    struct list entry;
+    struct message_websocket *socket;
+    BOOL close;
+    USHORT status;
+    WINHTTP_WEB_SOCKET_BUFFER_TYPE type;
+    UINT32 size;
+    BYTE data[];
+};
+
+static inline struct send_request *impl_from_send_request( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct send_request, IUnknown_iface );
+}
+
+static HRESULT WINAPI send_request_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        *out = iface;
+        IUnknown_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI send_request_AddRef( IUnknown *iface )
+{
+    return InterlockedIncrement( &impl_from_send_request( iface )->ref );
+}
+
+static ULONG WINAPI send_request_Release( IUnknown *iface )
+{
+    struct send_request *impl = impl_from_send_request( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static const IUnknownVtbl send_request_vtbl =
+{
+    send_request_QueryInterface,
+    send_request_AddRef,
+    send_request_Release,
+};
+
+static struct send_request *send_request_create( struct message_websocket *impl, const BYTE *data, UINT32 size )
+{
+    struct send_request *request;
+
+    if (!(request = calloc( 1, offsetof( struct send_request, data[size] ) ))) return NULL;
+    request->IUnknown_iface.lpVtbl = &send_request_vtbl;
+    request->ref = 1;
+    request->socket = impl;
+    request->size = size;
+    if (size) memcpy( request->data, data, size );
+    return request;
+}
+
+/* Waits for the request's turn, sends it, and hands the turn on.  A write
+ * to a connection that has gone away fails as Windows' does. */
+static HRESULT send_request_run( struct send_request *request )
+{
+    struct message_websocket *impl = request->socket;
+    HINTERNET socket;
+    HRESULT hr = S_OK;
+    BOOL lost;
+    DWORD err;
+
+    EnterCriticalSection( &impl->cs );
+    while (list_head( &impl->send_queue ) != &request->entry)
+        SleepConditionVariableCS( &impl->send_turn, &impl->cs, INFINITE );
+    socket = impl->transport.socket;
+    lost = impl->lost;
+    LeaveCriticalSection( &impl->cs );
+
+    if (request->close)
+    {
+        /* the reason, if any, is UTF-8 */
+        if (socket && !lost && (err = WinHttpWebSocketShutdown( socket, request->status,
+                                                                request->size ? request->data : NULL, request->size )))
+            WARN( "close frame not sent, error %lu.\n", err );
+    }
+    else if (lost) hr = HRESULT_FROM_WIN32( ERROR_WINHTTP_CONNECTION_ERROR );
+    else if (!socket) hr = E_ILLEGAL_METHOD_CALL;
+    else if ((err = WinHttpWebSocketSend( socket, request->type, request->size ? request->data : NULL, request->size )))
+    {
+        WARN( "send failed, error %lu.\n", err );
+        if (err != ERROR_INVALID_OPERATION) err = ERROR_WINHTTP_CONNECTION_ERROR;
+        hr = HRESULT_FROM_WIN32( err );
+    }
+
+    EnterCriticalSection( &impl->cs );
+    list_remove( &request->entry );
+    LeaveCriticalSection( &impl->cs );
+    WakeAllConditionVariable( &impl->send_turn );
+    return hr;
+}
+
+static HRESULT send_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result, BOOL called_async )
+{
+    struct send_request *request = impl_from_send_request( param );
+    HRESULT hr;
+
+    if (!called_async) return STATUS_PENDING;
+
+    if (SUCCEEDED(hr = send_request_run( request )))
+    {
+        result->vt = VT_UI4;
+        result->ulVal = request->size;
+    }
+    return hr;
+}
+
+static HRESULT socket_send( struct message_websocket *impl, IBuffer *buffer, BOOL message, BOOL final,
+                            IAsyncOperationWithProgress_UINT32_UINT32 **operation )
+{
+    struct send_request *request;
+    SocketMessageType type;
+    BOOL closed;
+    UINT32 size;
+    BYTE *bytes;
+    HRESULT hr;
+
+    if (!buffer || !operation) return E_POINTER;
+
+    /* after Close, or the output stream's own, nothing more is written */
+    EnterCriticalSection( &impl->cs );
+    closed = impl->state == SOCKET_CLOSED || (message && impl->output_closed);
+    LeaveCriticalSection( &impl->cs );
+    if (closed) return RO_E_CLOSED;
+
+    bytes = buffer_bytes( buffer, &size );
+    if (!(request = send_request_create( impl, bytes, size ))) return E_OUTOFMEMORY;
+
+    /* the message type is the control's at the time of the call */
+    EnterCriticalSection( &impl->control->cs );
+    type = impl->control->message_type;
+    LeaveCriticalSection( &impl->control->cs );
+    if (message || final)
+        request->type = type == SocketMessageType_Utf8 ? WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE
+                                                       : WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE;
+    else
+        request->type = type == SocketMessageType_Utf8 ? WINHTTP_WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE
+                                                       : WINHTTP_WEB_SOCKET_BINARY_FRAGMENT_BUFFER_TYPE;
+
+    EnterCriticalSection( &impl->cs );
+    list_add_tail( &impl->send_queue, &request->entry );
+    LeaveCriticalSection( &impl->cs );
+
+    if (FAILED(hr = async_operation_uint32_progress_create( (IUnknown *)&impl->IMessageWebSocket_iface,
+                                                            &request->IUnknown_iface, send_async, operation )))
+    {
+        /* its turn will never come */
+        EnterCriticalSection( &impl->cs );
+        list_remove( &request->entry );
+        LeaveCriticalSection( &impl->cs );
+        WakeAllConditionVariable( &impl->send_turn );
+    }
+    IUnknown_Release( &request->IUnknown_iface );
+    return hr;
+}
+
+static void CALLBACK close_callback( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct send_request *request = context;
+    struct message_websocket *impl = request->socket;
+
+    send_request_run( request );
+    IUnknown_Release( &request->IUnknown_iface );
+    IMessageWebSocket_Release( &impl->IMessageWebSocket_iface );
+}
+
+/* The close frame goes out after whatever was written before it. */
+static void queue_close( struct message_websocket *impl, USHORT status, const char *reason, UINT32 len )
+{
+    struct send_request *request;
+
+    if (!(request = send_request_create( impl, (const BYTE *)reason, len ))) return;
+    request->close = TRUE;
+    request->status = status;
+
+    EnterCriticalSection( &impl->cs );
+    list_add_tail( &impl->send_queue, &request->entry );
+    LeaveCriticalSection( &impl->cs );
+
+    IMessageWebSocket_AddRef( &impl->IMessageWebSocket_iface );
+    if (!TrySubmitThreadpoolCallback( close_callback, request, NULL ))
+    {
+        EnterCriticalSection( &impl->cs );
+        list_remove( &request->entry );
+        LeaveCriticalSection( &impl->cs );
+        WakeAllConditionVariable( &impl->send_turn );
+        IUnknown_Release( &request->IUnknown_iface );
+        IMessageWebSocket_Release( &impl->IMessageWebSocket_iface );
+    }
+}
+
+static void raise_closed( struct message_websocket *impl, UINT16 code, const WCHAR *reason );
+
+/* Close sends the close frame, with a status or empty; nothing more is
+ * written or connected after it.  Closed comes from the connection's end,
+ * or at once if it has already gone. */
+static void socket_close( struct message_websocket *impl, USHORT status, const char *reason, UINT32 len )
+{
+    enum socket_state state;
+    BOOL lost;
+
+    EnterCriticalSection( &impl->cs );
+    state = impl->state;
+    lost = impl->lost;
+    impl->state = SOCKET_CLOSED;
+    LeaveCriticalSection( &impl->cs );
+
+    if (state != SOCKET_OPEN) return;
+    if (lost) raise_closed( impl, 1006, NULL );
+    else queue_close( impl, status, reason, len );
+}
