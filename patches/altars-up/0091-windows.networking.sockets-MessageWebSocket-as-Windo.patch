+        hr = RoGetActivationFactory( name, &IID_IDataReaderStatics, (void **)&tmp );
+        WindowsDeleteString( name );
+        if (FAILED(hr)) return hr;
+        if (InterlockedCompareExchangePointer( (void **)&statics, tmp, NULL )) IDataReaderStatics_Release( tmp );
+    }
+
+    EnterCriticalSection( &impl->cs );
+    if (!impl->reader && SUCCEEDED(hr = buffer_create( impl->data, impl->size, &buffer )))
+    {
+        hr = IDataReaderStatics_FromBuffer( statics, buffer, &impl->reader );
+        IBuffer_Release( buffer );
