From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 07:07:19 -0400
Subject: [PATCH] msxml3: Compare a number in a predicate with the position as
 a number.

xpath_evaluate_predicate_result() passed the number to
xpath_adjust_nodeset_index(), which takes an int, so /r[1.5] and
/r[number('1.5')] were truncated to position 1 and selected the first
node.  MSXML, like XPath 1.0, selects nothing for them.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index fb46a941d26..0532081d032 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -5440,6 +5440,42 @@ static int xpath_compare_value(IXMLDOMDocument2 *doc, const WCHAR *expr)
     return result;
 }
 
+static void test_XPath_number_predicate(void)
+{
+    static const struct { const char *query; LONG count; } tests[] =
+    {
+        { "/r[1]", 1 }, { "/r[1.0]", 1 }, { "/r[3 - 2]", 1 }, { "/r[position() = 1.0]", 1 },
+        { "/r[1.5]", 0 }, { "/r[2 - 0.5]", 0 }, { "/r[number('1.5')]", 0 }, { "/r[0.5]", 0 },
+    };
+    IXMLDOMDocument2 *doc;
+    IXMLDOMNodeList *list;
+    VARIANT_BOOL b;
+    unsigned int i;
+    HRESULT hr;
+    LONG len;
+
+    doc = create_document(&IID_IXMLDOMDocument2);
+    hr = IXMLDOMDocument2_setProperty(doc, _bstr_("SelectionLanguage"), _variantbstr_("XPath"));
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMDocument2_loadXML(doc, _bstr_("<r><e/></r>"), &b);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* a number in a predicate is compared with the position as a number */
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        list = NULL;
+        hr = IXMLDOMDocument2_selectNodes(doc, _bstr_(tests[i].query), &list);
+        ok(hr == S_OK, "%s: unexpected hr %#lx.\n", tests[i].query, hr);
+        len = -1;
+        if (list) IXMLDOMNodeList_get_length(list, &len);
+        ok(len == tests[i].count, "%s: got %ld nodes.\n", tests[i].query, len);
+        if (list) IXMLDOMNodeList_Release(list);
+    }
+
+    IXMLDOMDocument2_Release(doc);
+    free_bstrs();
+}
+
 static void test_XPath_ms_functions(void)
 {
     static const struct
@@ -19028,6 +19064,7 @@ START_TEST(domdoc)
     test_IXMLDOMDocument2();
     test_whitespace();
     test_XPath();
+    test_XPath_number_predicate();
     test_XPath_ms_functions();
     test_XSLPattern();
     test_cloneNode();
diff --git a/dlls/msxml3/xpath.c b/dlls/msxml3/xpath.c
index 1349075a076..86b575a6ae0 100644
--- a/dlls/msxml3/xpath.c
+++ b/dlls/msxml3/xpath.c
@@ -4792,7 +4792,8 @@ static int xpath_evaluate_predicate_result(struct xpath_parser_context *ctxt, st
         case _XPATH_BOOLEAN:
             return res->boolval;
         case _XPATH_NUMBER:
-            return xpath_adjust_nodeset_index(ctxt, res->floatval) == ctxt->context->proximityPosition;
+            /* compared as a number: [1.5] is no position at all */
+            return (ctxt->context->xpath ? res->floatval : res->floatval + 1) == ctxt->context->proximityPosition;
         case _XPATH_NODESET:
             return res->nodesetval && res->nodesetval->count;
         case _XPATH_STRING:
