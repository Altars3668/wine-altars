@@ -61,6 +62,8 @@ struct pipe_end
     struct pipe_end     *connection; /* the other end of the pipe */
     process_id_t         client_pid; /* process that created the client */
     process_id_t         server_pid; /* process that created the server */
+    unsigned int         sqos;       /* security quality of service of the client (OPEN_SQOS_*) */
+    struct token        *client_token; /* server end: the client's security context to impersonate */
     data_size_t          buffer_size;/* size of buffered data that doesn't block caller */
     struct list          message_queue;
     struct async_queue   read_q;     /* read queue */
@@ -373,6 +376,7 @@ static struct pipe_message *queue_message( struct pipe_end *pipe_end, struct ios
     if (!(message = mem_alloc( sizeof(*message) ))) return NULL;
     message->iosb = (struct iosb *)grab_object( iosb );
     message->async = NULL;
+    message->token = NULL;
     message->read_pos = 0;
     list_add_tail( &pipe_end->message_queue, &message->entry );
     return message;
@@ -393,9 +397,36 @@ static void free_message( struct pipe_message *message )
 {
     list_remove( &message->entry );
     if (message->iosb) release_object( message->iosb );
+    if (message->token) release_object( message->token );
     free( message );
 }
 
+/* a client that did not say how to be impersonated is tracked dynamically, with its enabled privileges */
+#define DEFAULT_CLIENT_SQOS (SecurityImpersonation | OPEN_SQOS_DYNAMIC | OPEN_SQOS_EFFECTIVE_ONLY)
+
+/* the client's security context as its server will impersonate it: the token itself when the client
+ * is tracked dynamically, to be copied as it is when the server impersonates, else a copy made now */
+static struct token *get_client_context( unsigned int sqos )
+{
+    struct token *token = thread_get_impersonation_token( current );
+
+    if (!token) return NULL;
+    if (sqos & OPEN_SQOS_DYNAMIC) return (struct token *)grab_object( token );
+    return token_duplicate_client( token, sqos & OPEN_SQOS_LEVEL_MASK, !!(sqos & OPEN_SQOS_EFFECTIVE_ONLY) );
+}
+
+static void set_client_context( struct pipe_end *server_end, struct token *token )
+{
+    if (server_end->client_token) release_object( server_end->client_token );
+    server_end->client_token = token;
+}
+
+/* a dynamically tracked client is impersonated as it was when it wrote what the server last read */
+static void read_client_context( struct pipe_end *pipe_end, struct pipe_message *message )
+{
+    if (message->token) set_client_context( pipe_end, (struct token *)grab_object( message->token ));
+}
+
 static void pipe_end_disconnect( struct pipe_end *pipe_end, unsigned int status )
 {
     struct pipe_end *connection = pipe_end->connection;
@@ -406,6 +437,7 @@ static void pipe_end_disconnect( struct pipe_end *pipe_end, unsigned int status
 
     pipe_end->state = status == STATUS_PIPE_DISCONNECTED
         ? FILE_PIPE_DISCONNECTED_STATE : FILE_PIPE_CLOSING_STATE;
+    if (status == STATUS_PIPE_DISCONNECTED) set_client_context( pipe_end, NULL );
     fd_async_wake_up( pipe_end->fd, ASYNC_TYPE_WAIT, status );
     async_wake_up( &pipe_end->read_q, status );
     LIST_FOR_EACH_ENTRY_SAFE( message, next, &pipe_end->message_queue, struct pipe_message, entry )
@@ -431,6 +463,7 @@ static void pipe_end_destroy( struct object *obj )
     struct pipe_message *message;
 
     pipe_end_disconnect( pipe_end, STATUS_PIPE_BROKEN );
+    set_client_context( pipe_end, NULL );
 
     while (!list_empty( &pipe_end->message_queue ))
     {
@@ -921,6 +954,7 @@ static void message_queue_read( struct pipe_end *pipe_end, struct async *async )
     message = LIST_ENTRY( list_head(&pipe_end->message_queue), struct pipe_message, entry );
     if (!message->read_pos && message->iosb->in_size == iosb->out_size) /* fast path */
     {
+        read_client_context( pipe_end, message );
         async_request_complete( async, status, out_size, out_size, message->iosb->in_data );
         message->iosb->in_data = NULL;
         wake_message( message, message->iosb->in_size );
@@ -941,6 +975,7 @@ static void message_queue_read( struct pipe_end *pipe_end, struct async *async )
         do
         {
             message = LIST_ENTRY( list_head(&pipe_end->message_queue), struct pipe_message, entry );
+            read_client_context( pipe_end, message );
             writing = min( out_size - write_pos, message->iosb->in_size - message->read_pos );
             if (writing) memcpy( buf + write_pos, (const char *)message->iosb->in_data + message->read_pos, writing );
             write_pos += writing;
@@ -1080,6 +1115,8 @@ static void pipe_end_write( struct fd *fd, struct async *async, file_pos_t pos )
     message = queue_message( pipe_end->connection, iosb );
     release_object( iosb );
     if (!message) return;
+    if (pipe_end->obj.ops == &pipe_client_ops && (pipe_end->sqos & OPEN_SQOS_DYNAMIC))
+        message->token = get_client_context( pipe_end->sqos );
 
     message->async = (struct async *)grab_object( async );
     queue_async( &pipe_end->write_q, async );
@@ -1310,15 +1347,22 @@ static void pipe_server_ioctl( struct fd *fd, ioctl_code_t code, struct async *a
         return;
 
     case FSCTL_PIPE_IMPERSONATE:
-        if (current->process->token) /* FIXME: use the client token */
+    {
+        unsigned int sqos = server->pipe_end.sqos;
+        struct token *token;
+
+        if (!server->pipe_end.client_token)
         {
-            struct token *token;
-            if (!(token = token_duplicate( current->process->token, 0, SecurityImpersonation, NULL, NULL, 0, NULL, 0 )))
-                return;
-            if (current->token) release_object( current->token );
-            current->token = token;
+            set_error( STATUS_CANNOT_IMPERSONATE );
+            return;
         }
+        if (!(token = token_duplicate_client( server->pipe_end.client_token, sqos & OPEN_SQOS_LEVEL_MASK,
+                                              !!(sqos & OPEN_SQOS_EFFECTIVE_ONLY) )))
+            return;
+        if (current->token) release_object( current->token );
+        current->token = token;
         return;
+    }
 
     default:
         pipe_end_ioctl( &server->pipe_end, code, async );
@@ -1347,6 +1391,8 @@ static void init_pipe_end( struct pipe_end *pipe_end, struct named_pipe *pipe,
     pipe_end->fd = NULL;
     pipe_end->flags = pipe_flags;
     pipe_end->connection = NULL;
+    pipe_end->sqos = 0;
+    pipe_end->client_token = NULL;
     pipe_end->buffer_size = buffer_size;
     init_async_queue( &pipe_end->read_q );
     init_async_queue( &pipe_end->write_q );
@@ -1448,6 +1494,9 @@ static struct object *named_pipe_open_file( struct object *obj, unsigned int acc
         client->connection = &server->pipe_end;
         server->pipe_end.client_pid = client->client_pid;
         client->server_pid = server->pipe_end.server_pid;
+        client->sqos = (open_file_sqos & OPEN_SQOS_PRESENT) ? open_file_sqos : DEFAULT_CLIENT_SQOS;
+        server->pipe_end.sqos = client->sqos;
+        set_client_context( &server->pipe_end, get_client_context( client->sqos ));
         list_remove( &server->entry );
     }
     return &client->obj;
