+/* the token a named pipe server impersonates: a copy of the client's at the level the client allows,
+ * without the privileges it has disabled when only its effective ones count */
+struct token *token_duplicate_client( struct token *src_token, int impersonation_level, int effective_only )
+{
+    struct privilege *privilege, *next;
+    struct token *token;
+
+    if (!src_token->primary && impersonation_level > src_token->impersonation_level)
+        impersonation_level = src_token->impersonation_level;
+    if (!(token = token_duplicate( src_token, 0, impersonation_level, NULL, NULL, 0, NULL, 0 ))) return NULL;
+    if (effective_only)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( privilege, next, &token->privileges, struct privilege, entry )
+            if (!privilege->enabled) privilege_remove( privilege );
+    }
+    return token;
+}
+
 struct token *token_duplicate( struct token *src_token, unsigned primary,
                                int impersonation_level, const struct security_descriptor *sd,
                                const struct luid_attr *remove_privs, unsigned int remove_priv_count,
