index 1e51158a1c0..f363cddf148 100644
--- a/server/named_pipe.c
+++ b/server/named_pipe.c
@@ -49,6 +49,7 @@ struct pipe_message
     data_size_t          read_pos;   /* already read bytes */
     struct iosb         *iosb;       /* message iosb */
     struct async        *async;      /* async of pending write */
+    struct token        *token;      /* security context of a client that tracks it dynamically */
 };
 
