diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index b2fa59581db..f95f59a6c8c 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5857,6 +5857,17 @@ static void set_sync_iosb( IO_STATUS_BLOCK *io, NTSTATUS status, ULONG_PTR info,
 }
 
 
+/* the security quality of service the opener of a named pipe asks for, as the server keeps it */
+static unsigned int open_sqos( const OBJECT_ATTRIBUTES *attr )
+{
+    const SECURITY_QUALITY_OF_SERVICE *qos = attr->SecurityQualityOfService;
+
+    if (!qos) return 0;
+    return OPEN_SQOS_PRESENT | (qos->ImpersonationLevel & OPEN_SQOS_LEVEL_MASK) |
+           (qos->ContextTrackingMode == SECURITY_DYNAMIC_TRACKING ? OPEN_SQOS_DYNAMIC : 0) |
+           (qos->EffectiveOnly ? OPEN_SQOS_EFFECTIVE_ONLY : 0);
+}
+
 static unsigned int server_open_file_object( HANDLE *ret_handle, ACCESS_MASK access, OBJECT_ATTRIBUTES *attr,
                                              ULONG sharing, ULONG options )
 {
@@ -5874,6 +5885,7 @@ static unsigned int server_open_file_object( HANDLE *ret_handle, ACCESS_MASK acc
         req->rootdir    = wine_server_obj_handle( attr->RootDirectory );
         req->sharing    = sharing;
         req->options    = options;
+        req->sqos       = open_sqos( attr );
         req->async_user = wine_server_client_ptr( &async->io );
         wine_server_add_data( req, attr->ObjectName->Buffer, attr->ObjectName->Length );
         status = wine_server_call( req );
@@ -6917,11 +6929,6 @@ NTSTATUS WINAPI NtFsControlFile( HANDLE handle, HANDLE event, PIO_APC_ROUTINE ap
         if (!status) status = unmount_device( handle );
         return status;
 
-    case FSCTL_PIPE_IMPERSONATE:
-        FIXME("FSCTL_PIPE_IMPERSONATE: impersonating self\n");
-        return server_ioctl_file( handle, event, apc, apc_context, io, code,
-                                  in_buffer, in_size, out_buffer, out_size );
-
     case FSCTL_IS_VOLUME_MOUNTED:
     case FSCTL_LOCK_VOLUME:
     case FSCTL_UNLOCK_VOLUME:
