@@ -3774,6 +3775,21 @@ static void test_classesroot_enum(void)
     res = RegCreateKeyA( hklm, "C", &hklmsub[1] );
     ok(res == ERROR_SUCCESS, "RegCreateKeyA failed: %ld\n", res);
 
