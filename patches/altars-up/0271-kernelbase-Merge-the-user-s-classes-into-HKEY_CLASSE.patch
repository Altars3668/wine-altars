         {
             NtClose( subkey_root );
             subkey_root = root;
@@ -337,16 +378,16 @@ static NTSTATUS open_key( HKEY *retkey, HKEY root, UNICODE_STRING *name, DWORD o
     while (!status && (name->Length || !subkey))
     {
         was_wow6432node = is_wow6432node( name );
-        status = open_subkey( &subkey, subkey_root, name, options, access );
+        status = open_subkey( &subkey, subkey_root, name, options, access, hkcr_user );
         if (subkey && subkey_root && subkey_root != root) NtClose( subkey_root );
         if (subkey) subkey_root = subkey;
     }
 
     /* Return the shared parent if we didn't explicitly look for the Wow6432Node */
-    if (!status && !was_wow6432node && is_wow64_key && is_classes_wow6432node( subkey_root ))
+    if (!status && !was_wow6432node && is_wow64_key && is_classes_wow6432node( subkey_root, hkcr_user ))
     {
         if (subkey_root && subkey_root != root) NtClose( subkey_root );
-        subkey_root = open_classes_root();
+        subkey_root = open_classes_root( subkey_root );
     }
 
     if (!status || (status == STATUS_OBJECT_NAME_NOT_FOUND && create))
@@ -417,7 +458,7 @@ static NTSTATUS create_key( HKEY *retkey, HKEY root, UNICODE_STRING name, ULONG
             return status;
     }
 
-    status = open_key( &subkey_root, root, &name, options & REG_OPTION_OPEN_LINK, access, TRUE );
+    status = open_key( &subkey_root, root, &name, options & REG_OPTION_OPEN_LINK, access, TRUE, FALSE );
     if (!status && (options & REG_OPTION_CREATE_LINK))
     {
         NtClose( subkey_root );
@@ -484,6 +525,15 @@ static inline HKEY get_special_root_hkey( HKEY hkey )
     switch (HandleToUlong(hkey))
     {
         case (LONG)(LONG_PTR)HKEY_CLASSES_ROOT:
+        {
+            HKEY root = special_root_keys[index];
+            if (!root) root = create_special_root_hkey( hkey, MAXIMUM_ALLOWED );
+            /* handles opened through it merge the user's classes into the machine's; an override
+             * is a plain key */
+            if (root && !hkcr_overridden) root = (HKEY)((ULONG_PTR)root | 2);
+            return root;
+        }
+
         case (LONG)(LONG_PTR)HKEY_CURRENT_USER:
         case (LONG)(LONG_PTR)HKEY_LOCAL_MACHINE:
         case (LONG)(LONG_PTR)HKEY_USERS:
@@ -505,6 +555,638 @@ static BOOL is_perf_key( HKEY key )
             || HandleToUlong(key) == HandleToUlong(HKEY_PERFORMANCE_NLSTEXT);
 }
 
+static BOOL is_hkcr_key( HKEY key )
+{
+    return HandleToUlong(key) < 0x80000000 && (HandleToUlong(key) & 3) == 2;
+}
+
+static HKEY unmark_hkcr_key( HKEY key )
+{
+    return is_hkcr_key( key ) ? (HKEY)((ULONG_PTR)key & ~(ULONG_PTR)3) : key;
+}
+
+/* What is known of a handle opened through HKEY_CLASSES_ROOT: whether it is the user's key or the
+ * machine's, its path relative to Classes once something has needed it, and where an enumeration
+ * of it has got to. */
+struct hkcr_key
+{
+    struct list entry;
+    HKEY key;
+    BOOL user;
+    WCHAR *path;
+    struct { DWORD index, machine_index, user_count; BOOL valid; } pos[2];
+};
+
+static CRITICAL_SECTION hkcr_cs;
+static CRITICAL_SECTION_DEBUG hkcr_cs_debug =
+{
+    0, 0, &hkcr_cs,
+    { &hkcr_cs_debug.ProcessLocksList, &hkcr_cs_debug.ProcessLocksList },
+    0, 0, { (DWORD_PTR)(__FILE__ ": hkcr_cs") }
+};
+static CRITICAL_SECTION hkcr_cs = { &hkcr_cs_debug, -1, 0, 0, 0, 0 };
+static struct list hkcr_keys[64];
+
+/* HKEY_CURRENT_USER\Software\Classes and HKEY_LOCAL_MACHINE\Software\Classes, kept open once found */
+static HKEY user_classes_root, machine_classes_root;
+
+/* called with hkcr_cs held */
+static struct hkcr_key *find_hkcr_key( HKEY key, BOOL create )
+{
+    struct list *bucket = &hkcr_keys[((ULONG_PTR)key >> 2) % ARRAY_SIZE(hkcr_keys)];
+    struct hkcr_key *entry;
+
+    if (!bucket->next) list_init( bucket );
+    LIST_FOR_EACH_ENTRY( entry, bucket, struct hkcr_key, entry )
+        if (entry->key == key) return entry;
+    if (!create || !(entry = HeapAlloc( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*entry) ))) return NULL;
+    entry->key = key;
+    list_add_head( bucket, &entry->entry );
+    return entry;
+}
+
+/* takes over path, which may be NULL */
+static void add_hkcr_key( HKEY key, BOOL user, WCHAR *path )
+{
+    struct hkcr_key *entry;
+
+    RtlEnterCriticalSection( &hkcr_cs );
+    if ((entry = find_hkcr_key( key, TRUE )))
+    {
+        /* one may be left from a handle that was closed without RegCloseKey */
+        HeapFree( GetProcessHeap(), 0, entry->path );
+        memset( entry->pos, 0, sizeof(entry->pos) );
+        entry->user = user;
+        entry->path = path;
+        path = NULL;
+    }
+    RtlLeaveCriticalSection( &hkcr_cs );
+    HeapFree( GetProcessHeap(), 0, path );
+}
+
+static void remove_hkcr_key( HKEY key )
+{
+    struct hkcr_key *entry;
+
+    RtlEnterCriticalSection( &hkcr_cs );
+    if ((entry = find_hkcr_key( key, FALSE )))
+    {
+        list_remove( &entry->entry );
+        HeapFree( GetProcessHeap(), 0, entry->path );
+        HeapFree( GetProcessHeap(), 0, entry );
+    }
+    RtlLeaveCriticalSection( &hkcr_cs );
+}
+
+static WCHAR *hkcr_strdup( const WCHAR *str )
+{
+    DWORD size = (lstrlenW( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = HeapAlloc( GetProcessHeap(), 0, size );
+
+    if (ret) memcpy( ret, str, size );
+    return ret;
+}
+
+/* The path of a key relative to the user's or the machine's Classes, from the key's name. */
+static NTSTATUS query_hkcr_path( HKEY key, WCHAR **path, BOOL *user )
+{
+    static const WCHAR machine_root[] = L"\\Registry\\Machine\\Software\\Classes";
+    static const WCHAR user_root[] = L"\\Registry\\User\\";
+    static const WCHAR classes[] = L"\\Software\\Classes";
+    KEY_NAME_INFORMATION *info;
+    DWORD size = 256, len, pos;
+    NTSTATUS status;
+
+    *path = NULL;
+    if (!(info = HeapAlloc( GetProcessHeap(), 0, size ))) return STATUS_NO_MEMORY;
+    while ((status = NtQueryKey( unmark_hkcr_key( key ), KeyNameInformation, info, size, &size )) == STATUS_BUFFER_OVERFLOW)
+    {
+        KEY_NAME_INFORMATION *new_info = HeapReAlloc( GetProcessHeap(), 0, info, size + sizeof(WCHAR) );
+        if (!new_info)
+        {
+            HeapFree( GetProcessHeap(), 0, info );
+            return STATUS_NO_MEMORY;
+        }
+        info = new_info;
+        size += sizeof(WCHAR);
+    }
+    if (status) goto done;
+
+    len = info->NameLength / sizeof(WCHAR);
+    if (len >= ARRAY_SIZE(machine_root) - 1 &&
+        !wcsnicmp( info->Name, machine_root, ARRAY_SIZE(machine_root) - 1 ))
+    {
+        pos = ARRAY_SIZE(machine_root) - 1;
+        *user = FALSE;
+    }
+    else if (len >= ARRAY_SIZE(user_root) - 1 &&
+             !wcsnicmp( info->Name, user_root, ARRAY_SIZE(user_root) - 1 ))
+    {
+        pos = ARRAY_SIZE(user_root) - 1;
+        while (pos < len && info->Name[pos] != '\\') pos++;
+        if (pos + ARRAY_SIZE(classes) - 1 > len ||
+            wcsnicmp( info->Name + pos, classes, ARRAY_SIZE(classes) - 1 ))
+            goto invalid_path;
+        pos += ARRAY_SIZE(classes) - 1;
+        *user = TRUE;
+    }
+    else goto invalid_path;
+
+    if (pos < len && info->Name[pos] != '\\') goto invalid_path;
+    if (pos < len) pos++;
+    memmove( info, info->Name + pos, (len - pos) * sizeof(WCHAR) );
+    ((WCHAR *)info)[len - pos] = 0;
+    *path = (WCHAR *)info;
+    return STATUS_SUCCESS;
+
+invalid_path:
+    status = STATUS_OBJECT_PATH_INVALID;
+done:
+    HeapFree( GetProcessHeap(), 0, info );
+    return status;
+}
+
+/* Whether a handle opened through HKCR is the user's key, and, when path is not NULL, a copy of its
+ * path relative to Classes.  Each handle's name is only asked for once. */
+static NTSTATUS get_hkcr_key( HKEY key, BOOL *user, WCHAR **path )
+{
+    struct hkcr_key *entry;
+    WCHAR *name;
+    NTSTATUS status;
+
+    if (path) *path = NULL;
+    if (special_root_keys[0] && unmark_hkcr_key( key ) == special_root_keys[0])
+    {
+        *user = FALSE;
+        if (path && !(*path = hkcr_strdup( L"" ))) return STATUS_NO_MEMORY;
+        return STATUS_SUCCESS;
+    }
+
+    RtlEnterCriticalSection( &hkcr_cs );
+    if ((entry = find_hkcr_key( key, FALSE )) && (!path || entry->path))
+    {
+        *user = entry->user;
+        if (path && !(*path = hkcr_strdup( entry->path ))) status = STATUS_NO_MEMORY;
+        else status = STATUS_SUCCESS;
+        RtlLeaveCriticalSection( &hkcr_cs );
+        return status;
+    }
+    RtlLeaveCriticalSection( &hkcr_cs );
+
+    if ((status = query_hkcr_path( key, &name, user ))) return status;
+    RtlEnterCriticalSection( &hkcr_cs );
+    if ((entry = find_hkcr_key( key, TRUE )) && !entry->path)
+    {
+        entry->user = *user;
+        entry->path = hkcr_strdup( name );
+    }
+    RtlLeaveCriticalSection( &hkcr_cs );
+    if (path) *path = name;
+    else HeapFree( GetProcessHeap(), 0, name );
+    return STATUS_SUCCESS;
+}
+
+static HKEY open_classes_root_key( HKEY *cache, HANDLE root, const WCHAR *name )
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING nameW;
+    HKEY key;
+
+    RtlInitUnicodeString( &nameW, name );
+    InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, root, NULL );
+    if (NtOpenKeyEx( (HANDLE *)&key, MAXIMUM_ALLOWED, &attr, 0 )) return 0;
+    if (InterlockedCompareExchangePointer( (void **)cache, key, 0 ))
+    {
+        NtClose( key );  /* somebody beat us to it */
+        key = *cache;
+    }
+    return key;
+}
+
+static HKEY get_user_classes_root( HKEY deleted )
+{
+    HANDLE user;
+    HKEY key;
+
+    /* the key was deleted, and perhaps created again; the old handle may still be in use */
+    if (deleted) InterlockedCompareExchangePointer( (void **)&user_classes_root, 0, deleted );
+    if ((key = user_classes_root)) return key;
+    if (RtlOpenCurrentUser( MAXIMUM_ALLOWED, &user )) return 0;
+    key = open_classes_root_key( &user_classes_root, user, L"Software\\Classes" );
+    NtClose( user );
+    return key;
+}
+
+static HKEY get_machine_classes_root(void)
+{
+    HKEY key;
+
+    if ((key = machine_classes_root)) return key;
+    return open_classes_root_key( &machine_classes_root, 0, root_key_names[0] );
+}
+
+static BOOL hkcr_key_missing( NTSTATUS status )
+{
+    return status == STATUS_OBJECT_NAME_NOT_FOUND || status == STATUS_OBJECT_PATH_NOT_FOUND;
+}
+
+static WCHAR *hkcr_join( const WCHAR *path, const UNICODE_STRING *name )
+{
+    DWORD len = lstrlenW( path ), name_len = name ? name->Length / sizeof(WCHAR) : 0;
+    WCHAR *ret = HeapAlloc( GetProcessHeap(), 0, (len + name_len + 2) * sizeof(WCHAR) );
+
+    if (!ret) return NULL;
+    memcpy( ret, path, len * sizeof(WCHAR) );
+    if (len && name_len) ret[len++] = '\\';
+    if (name_len) memcpy( ret + len, name->Buffer, name->Length );
+    ret[len + name_len] = 0;
+    return ret;
+}
+
+/* A Wow6432Node walk costs a server call at every level, and can only find a key whose first
+ * component is in the user's Classes or in their Classes\Wow6432Node; most users' Classes are
+ * nearly empty, so look for that first. */
+static BOOL hkcr_user_may_have( HKEY root, const WCHAR *path )
+{
+    WCHAR buffer[12 + 256];
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING str;
+    NTSTATUS status;
+    HANDLE key;
+    DWORD len = 0;
+
+    while (path[len] && path[len] != '\\') len++;
+    if (!len || len > 255) return TRUE;
+    memcpy( buffer, L"Wow6432Node\\", 12 * sizeof(WCHAR) );
+    memcpy( buffer + 12, path, len * sizeof(WCHAR) );
+    InitializeObjectAttributes( &attr, &str, OBJ_CASE_INSENSITIVE, root, NULL );
+    str.Buffer = buffer + 12;
+    str.Length = str.MaximumLength = len * sizeof(WCHAR);
+    if (!(status = NtOpenKeyEx( &key, MAXIMUM_ALLOWED | KEY_WOW64_64KEY, &attr, 0 ))) NtClose( key );
+    if (!hkcr_key_missing( status )) return TRUE;
+    str.Buffer = buffer;
+    str.Length = str.MaximumLength = (12 + len) * sizeof(WCHAR);
+    if (!(status = NtOpenKeyEx( &key, MAXIMUM_ALLOWED | KEY_WOW64_64KEY, &attr, 0 ))) NtClose( key );
+    return !hkcr_key_missing( status );
+}
+
+/* Open a key of the user's Classes by its path. */
+static NTSTATUS open_hkcr_user( const WCHAR *path, DWORD options, ACCESS_MASK access, HKEY *retkey )
+{
+    BOOL walk = (is_win64 && (access & KEY_WOW64_32KEY)) || (is_wow64 && !(access & KEY_WOW64_64KEY));
+    UNICODE_STRING name;
+    NTSTATUS status;
+    HKEY root = 0;
+    int i;
+
+    *retkey = NULL;
+    for (i = 0; i < 2; i++)
+    {
+        if (!(root = get_user_classes_root( root ))) return STATUS_OBJECT_NAME_NOT_FOUND;
+        if (walk && !hkcr_user_may_have( root, path )) return STATUS_OBJECT_NAME_NOT_FOUND;
+        RtlInitUnicodeString( &name, path );
+        status = open_key( retkey, root, &name, options, access, FALSE, TRUE );
+        if (status != STATUS_KEY_DELETED) break;
+    }
+    return status;
+}
+
+/* Open a key of the machine's Classes by its path. */
+static NTSTATUS open_hkcr_machine( const WCHAR *path, DWORD options, ACCESS_MASK access, HKEY *retkey )
+{
+    UNICODE_STRING name;
+    HKEY root;
+
+    *retkey = NULL;
+    if (!(root = get_machine_classes_root())) return STATUS_OBJECT_NAME_NOT_FOUND;
+    RtlInitUnicodeString( &name, path );
+    return open_key( retkey, root, &name, options, access, FALSE, FALSE );
+}
+
+/* The key a value is set on through a handle opened through HKCR: the user's if it exists, else the
+ * machine's.  *opened is to be closed after use. */
+static NTSTATUS select_hkcr_key( HKEY key, ACCESS_MASK access, HKEY *use, HKEY *opened )
+{
+    WCHAR *path;
+    NTSTATUS status;
+    BOOL user;
+
+    *use = unmark_hkcr_key( key );
+    *opened = NULL;
+    if ((status = get_hkcr_key( key, &user, &path ))) return status;
+    if (!user && !open_hkcr_user( path, 0, access | KEY_WOW64_64KEY, opened )) *use = *opened;
+    HeapFree( GetProcessHeap(), 0, path );
+    return STATUS_SUCCESS;
+}
+
+/* The key a value is read from through a handle opened through HKCR: the user's if it has the value,
+ * else the machine's.  *opened is to be closed after use. */
+static NTSTATUS select_hkcr_value( HKEY key, const UNICODE_STRING *name, HKEY *use, HKEY *opened )
+{
+    WCHAR *path;
+    NTSTATUS status;
+    DWORD size;
+    BOOL user;
+    HKEY other;
+
+    *use = unmark_hkcr_key( key );
+    *opened = NULL;
+    if ((status = get_hkcr_key( key, &user, &path ))) return status;
+    if (user)
+    {
+        if (NtQueryValueKey( *use, name, KeyValueBasicInformation, NULL, 0, &size ) == STATUS_OBJECT_NAME_NOT_FOUND &&
+            !open_hkcr_machine( path, 0, KEY_QUERY_VALUE | KEY_WOW64_64KEY, &other ))
+            *use = *opened = other;
+    }
+    else if (!open_hkcr_user( path, 0, KEY_QUERY_VALUE | KEY_WOW64_64KEY, &other ))
+    {
+        if (NtQueryValueKey( other, name, KeyValueBasicInformation, NULL, 0, &size ) == STATUS_OBJECT_NAME_NOT_FOUND)
+            NtClose( other );
+        else *use = *opened = other;
+    }
+    HeapFree( GetProcessHeap(), 0, path );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS open_hkcr_key( HKEY key, UNICODE_STRING *name, DWORD options,
+                                ACCESS_MASK access, BOOL create, HKEY *retkey, DWORD *dispos,
+                                const UNICODE_STRING *class )
+{
+    BOOL walk = (is_win64 && (access & KEY_WOW64_32KEY)) || (is_wow64 && !(access & KEY_WOW64_64KEY));
+    WCHAR *path, *full = NULL;
+    UNICODE_STRING full_name;
+    NTSTATUS status;
+    BOOL user;
+
+    *retkey = NULL;
+    if ((status = get_hkcr_key( key, &user, &path ))) return status;
+    if (!(full = hkcr_join( path, name )))
+    {
+        HeapFree( GetProcessHeap(), 0, path );
+        return STATUS_NO_MEMORY;
+    }
+    status = open_hkcr_user( full, options, access, retkey );
+    if (!status)
+    {
+        if (dispos) *dispos = REG_OPENED_EXISTING_KEY;
+        user = TRUE;
+    }
+    else if (hkcr_key_missing( status ))
+    {
+        RtlInitUnicodeString( &full_name, full );
+        /* a key the user does not have is the machine's, and is created there */
+        if (user)
+        {
+            if (create) status = create_key( retkey, get_machine_classes_root(), full_name, options, access, class, dispos );
+            else status = open_hkcr_machine( full, options, access, retkey );
+        }
+        else
+        {
+            if (create) status = create_key( retkey, unmark_hkcr_key( key ), *name, options, access, class, dispos );
+            else status = open_key( retkey, unmark_hkcr_key( key ), name, options, access, FALSE, FALSE );
+        }
+        user = FALSE;
+    }
+    HeapFree( GetProcessHeap(), 0, path );
+    if (status)
+    {
+        HeapFree( GetProcessHeap(), 0, full );
+        return status;
+    }
+    /* After a Wow6432Node walk, or through a link, the key's path is not the one asked for; its name
+     * is asked for when something needs it. */
+    if (walk || (options & REG_OPTION_OPEN_LINK))
+    {
+        HeapFree( GetProcessHeap(), 0, full );
+        full = NULL;
+    }
+    add_hkcr_key( *retkey, user, full );
+    *retkey = (HKEY)((ULONG_PTR)*retkey | 2);
+    return STATUS_SUCCESS;
+}
+
+/* Read only the name; values may have arbitrarily large data. */
+static NTSTATUS enum_hkcr_name( HKEY key, DWORD index, BOOL values, WCHAR **name )
+{
+    KEY_VALUE_BASIC_INFORMATION *value_info;
+    KEY_BASIC_INFORMATION *key_info;
+    DWORD size = 256, needed, length;
+    NTSTATUS status;
+    char *buffer;
+
+    *name = NULL;
+    if (!(buffer = HeapAlloc( GetProcessHeap(), 0, size ))) return STATUS_NO_MEMORY;
+    for (;;)
+    {
+        if (values)
+            status = NtEnumerateValueKey( key, index, KeyValueBasicInformation, buffer, size, &needed );
+        else
+            status = NtEnumerateKey( key, index, KeyBasicInformation, buffer, size, &needed );
+        if (status != STATUS_BUFFER_OVERFLOW) break;
+        if (!(value_info = HeapReAlloc( GetProcessHeap(), 0, buffer, needed + sizeof(WCHAR) )))
+        {
+            status = STATUS_NO_MEMORY;
+            break;
+        }
+        buffer = (char *)value_info;
+        size = needed + sizeof(WCHAR);
+    }
+    if (!status)
+    {
+        value_info = (KEY_VALUE_BASIC_INFORMATION *)buffer;
+        key_info = (KEY_BASIC_INFORMATION *)buffer;
+        length = values ? value_info->NameLength : key_info->NameLength;
+        if (!(*name = HeapAlloc( GetProcessHeap(), 0, length + sizeof(WCHAR) ))) status = STATUS_NO_MEMORY;
+        else
+        {
+            memcpy( *name, values ? value_info->Name : key_info->Name, length );
+            (*name)[length / sizeof(WCHAR)] = 0;
+        }
+    }
+    HeapFree( GetProcessHeap(), 0, buffer );
+    return status;
+}
+
+static BOOL hkcr_has_entry( HKEY key, const WCHAR *name, BOOL values )
+{
+    UNICODE_STRING nameW;
+    OBJECT_ATTRIBUTES attr;
+    HANDLE child;
+    DWORD size;
+    NTSTATUS status;
+
+    if (!key) return FALSE;
+    RtlInitUnicodeString( &nameW, name );
+    if (values)
+        status = NtQueryValueKey( key, &nameW, KeyValueBasicInformation, NULL, 0, &size );
+    else
+    {
+        InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, key, NULL );
+        status = NtOpenKeyEx( &child, MAXIMUM_ALLOWED | KEY_WOW64_64KEY, &attr, 0 );
+        if (!status) NtClose( child );
+        return !hkcr_key_missing( status );
+    }
+    return status == STATUS_BUFFER_OVERFLOW || status == STATUS_BUFFER_TOO_SMALL || !status;
+}
+
+/* Enumeration through a handle opened through HKCR: the user's entries, then the machine's that the
+ * user does not have.  *use is the key to enumerate at *actual, *opened is to be closed after use. */
+static NTSTATUS enum_hkcr_index( HKEY key, DWORD index, BOOL values, HKEY *use, HKEY *opened, DWORD *actual )
+{
+    ACCESS_MASK access = (values ? KEY_QUERY_VALUE : KEY_ENUMERATE_SUB_KEYS) | KEY_WOW64_64KEY;
+    DWORD user_count, machine_index, merged_index, size;
+    HKEY user_key, machine_key, other = NULL;
+    KEY_CACHED_INFORMATION info;
+    struct hkcr_key *entry;
+    NTSTATUS status;
+    WCHAR *path, *name;
+    BOOL user;
+
+    *use = unmark_hkcr_key( key );
+    *opened = NULL;
+    *actual = index;
+    if ((status = get_hkcr_key( key, &user, &path ))) return status;
+    if (user)
+    {
+        user_key = *use;
+        /* this fails when the user's key the handle was opened on has been deleted */
+        if ((status = NtQueryKey( user_key, KeyCachedInformation, &info, sizeof(info), &size ))) goto done;
+        user_count = values ? info.Values : info.SubKeys;
+        if (index < user_count) goto done;
+        status = open_hkcr_machine( path, 0, access, &other );
+        if (hkcr_key_missing( status )) status = STATUS_NO_MORE_ENTRIES;
+        if (status) goto done;
+        machine_key = other;
+    }
+    else
+    {
+        machine_key = *use;
+        if (!path[0]) user_key = get_user_classes_root( 0 );
+        else if (open_hkcr_user( path, 0, access, &other )) user_key = NULL;
+        else user_key = other;
+        if (!user_key || NtQueryKey( user_key, KeyCachedInformation, &info, sizeof(info), &size ))
+            goto done;  /* nothing of the user's: the machine's key as it is */
+        if (!(user_count = values ? info.Values : info.SubKeys)) goto done;
+        /* the machine's key the handle was opened on may have been deleted */
+        if ((status = NtQueryKey( machine_key, KeyCachedInformation, &info, sizeof(info), &size ))) goto done;
+        if (index < user_count)
+        {
+            *use = user_key;
+            if (user_key == other)
+            {
+                *opened = other;
+                other = NULL;
+            }
+            goto done;
+        }
+    }
+
+    if (!user_count)
+    {
+        machine_index = index;
+        goto found;
+    }
+    RtlEnterCriticalSection( &hkcr_cs );
+    entry = find_hkcr_key( key, TRUE );
+    if (entry && entry->pos[values].valid && entry->pos[values].user_count == user_count &&
+        entry->pos[values].index < index)
+    {
+        machine_index = entry->pos[values].machine_index + 1;
+        merged_index = entry->pos[values].index + 1;
+    }
+    else
+    {
+        machine_index = 0;
+        merged_index = user_count;
+    }
+    while (merged_index <= index)
+    {
+        status = enum_hkcr_name( machine_key, machine_index, values, &name );
+        if (status) break;
+        if (!hkcr_has_entry( user_key, name, values ))
+        {
+            if (entry)
+            {
+                entry->pos[values].valid = TRUE;
+                entry->pos[values].index = merged_index;
+                entry->pos[values].machine_index = machine_index;
+                entry->pos[values].user_count = user_count;
+            }
+            merged_index++;
+        }
+        HeapFree( GetProcessHeap(), 0, name );
+        if (merged_index <= index) machine_index++;
+    }
+    RtlLeaveCriticalSection( &hkcr_cs );
+    if (status) goto done;
+found:
+    *use = machine_key;
+    if (machine_key == other)
+    {
+        *opened = other;
+        other = NULL;
+    }
+    *actual = machine_index;
+done:
+    if (other) NtClose( other );
+    HeapFree( GetProcessHeap(), 0, path );
+    return status;
+}
+
+/* How many of one side's entries the other side has too; counts through the smaller side. */
+static DWORD count_hkcr_shared( HKEY a, DWORD a_count, HKEY b, DWORD b_count, BOOL values )
+{
+    DWORD i, count = 0;
+    WCHAR *name;
+
+    if (b_count < a_count)
+    {
+        HKEY key = a;
+        DWORD n = a_count;
+        a = b; a_count = b_count;
+        b = key; b_count = n;
+    }
+    for (i = 0; i < a_count; i++)
+    {
+        if (enum_hkcr_name( a, i, values, &name )) break;
+        if (hkcr_has_entry( b, name, values )) count++;
+        HeapFree( GetProcessHeap(), 0, name );
+    }
+    return count;
+}
+
+/* RegQueryInfoKey through a handle opened through HKCR counts both sides' entries, once each. */
+static void query_hkcr_info( HKEY key, DWORD *subkeys, DWORD *values, DWORD *max_subkey,
+                              DWORD *max_value, DWORD *max_data )
+{
+    KEY_CACHED_INFORMATION mine, theirs;
+    HKEY other;
+    WCHAR *path;
+    DWORD size;
+    BOOL user;
+
+    if (get_hkcr_key( key, &user, &path )) return;
+    if (user ? open_hkcr_machine( path, 0, KEY_READ | KEY_WOW64_64KEY, &other )
+             : open_hkcr_user( path, 0, KEY_READ | KEY_WOW64_64KEY, &other ))
+    {
+        HeapFree( GetProcessHeap(), 0, path );
+        return;
+    }
+    if (!NtQueryKey( unmark_hkcr_key( key ), KeyCachedInformation, &mine, sizeof(mine), &size ) &&
+        !NtQueryKey( other, KeyCachedInformation, &theirs, sizeof(theirs), &size ))
+    {
+        if (subkeys) *subkeys = mine.SubKeys + theirs.SubKeys -
+            count_hkcr_shared( unmark_hkcr_key( key ), mine.SubKeys, other, theirs.SubKeys, FALSE );
+        if (values) *values = mine.Values + theirs.Values -
+            count_hkcr_shared( unmark_hkcr_key( key ), mine.Values, other, theirs.Values, TRUE );
+        if (max_subkey) *max_subkey = max( *max_subkey, theirs.MaxNameLen / sizeof(WCHAR) );
+        if (max_value) *max_value = max( *max_value, theirs.MaxValueNameLen / sizeof(WCHAR) );
+        if (max_data) *max_data = max( *max_data, theirs.MaxValueDataLen );
+    }
+    NtClose( other );
+    HeapFree( GetProcessHeap(), 0, path );
+}
