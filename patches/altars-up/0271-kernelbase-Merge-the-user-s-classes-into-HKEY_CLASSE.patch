@@ -3702,9 +3703,9 @@ static void test_classesroot_enum(void)
     }
 
     res = RegOpenKeyA( HKEY_CLASSES_ROOT, "WineTestCls", &hkcr );
-    todo_wine ok(res == ERROR_SUCCESS ||
-                 broken(res == ERROR_FILE_NOT_FOUND /* WinNT */),
