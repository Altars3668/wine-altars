From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 19 Sep 2026 02:28:11 -0400
Subject: [PATCH] winemenubuilder: name the Wine that wrote the entry, not
 whatever is on PATH.

Every entry this program writes says "wine", resolved from PATH when the entry
is clicked. On a machine with more than one Wine -- a distribution package
beside a build of one's own, which is every machine anybody develops Wine on --
that is not the Wine the prefix was built against, and the entry quietly starts
the application under the wrong one.

Measured: a menu entry for Word in a prefix built from this tree launched
/usr/bin/wine instead, which is the WineHQ package. Word started, ran far
enough to load its own modules, and exited 3 without ever painting a window;
the next launch offered safe mode, and answering it changed nothing. Nothing
anywhere said which Wine had run.

WINELOADER is the loader the builder itself is running under, so writing that
absolute path makes each entry name the Wine it belongs to, whatever PATH says
afterwards. It arrives as an NT path and is converted the same way the prefix
directory already is. Both writers -- Start Menu entries and file type
associations -- go through one helper, and it still falls back to plain "wine"
if the variable is not set.

(cherry picked from commit 086d4a6ec254eb38a7b054aa6b408dea8c74c276)

diff --git a/programs/winemenubuilder/winemenubuilder.c b/programs/winemenubuilder/winemenubuilder.c
index 281e02f63d4..bf7782cfefc 100644
--- a/programs/winemenubuilder/winemenubuilder.c
+++ b/programs/winemenubuilder/winemenubuilder.c
@@ -1241,6 +1241,38 @@ static LPSTR escape(LPCWSTR arg)
     return utf8_string;
 }
 
+
+/* The entry has to name the Wine that wrote it.  A bare "wine" is looked up on
+ * PATH when the entry is clicked, and on a machine carrying more than one Wine
+ * -- a distribution package beside a build of one's own, which is the ordinary
+ * case for anyone working on Wine at all -- that is not the Wine the prefix
+ * belongs to.  The failure is quiet and misleading: the application starts
+ * under the wrong build, dies before it paints anything, and the next launch
+ * offers safe mode.  WINELOADER names the loader this very process is running
+ * under, so an entry written with it keeps working whatever PATH says later. */
+static char *loader_unix_path(void)
+{
+    const WCHAR *loader = _wgetenv( L"WINELOADER" );
+    WCHAR buffer[MAX_PATH];
+
+    if (!loader || !*loader) return NULL;
+    if (!wcsncmp( loader, L"\\??\\", 4 )) loader += 4;   /* it arrives as an NT path */
+    lstrcpynW( buffer, loader, ARRAY_SIZE(buffer) );
+    return wine_get_unix_file_name( buffer );
+}
+
+static void write_exec_wine( FILE *file )
+{
+    char *loader = loader_unix_path();
+
+    if (loader)
+    {
+        fprintf( file, "\"%s\" ", loader );
+        heap_free( loader );
+    }
+    else fprintf( file, "wine " );
+}
+
 static BOOL write_desktop_entry(const WCHAR *link, const WCHAR *location, const WCHAR *linkname,
                                 const WCHAR *path, const WCHAR *args, const WCHAR *descr,
                                 const WCHAR *workdir, const WCHAR *icon, const WCHAR *wmclass)
@@ -1276,7 +1308,8 @@ static BOOL write_desktop_entry(const WCHAR *link, const WCHAR *location, const
         fprintf(file, "env \"WINEPREFIX=%s\" ", path);
         heap_free( path );
     }
-    fprintf(file, "wine \"%s\"", escape(path));
+    write_exec_wine( file );
+    fprintf(file, "\"%s\"", escape(path));
     if (args && *args) fprintf(file, " \"%s\"", escape(args) );
     fputc( '\n', file );
     fprintf(file, "Type=Application\n");
@@ -2032,11 +2065,13 @@ static BOOL write_freedesktop_association_entry(const WCHAR *desktopPath, const
         if (prefix)
         {
             char *path = wine_get_unix_file_name( prefix );
-            fprintf(desktop, "Exec=env \"WINEPREFIX=%s\" wine start ", path);
+            fprintf(desktop, "Exec=env \"WINEPREFIX=%s\" ", path);
             heap_free( path );
         }
         else
-            fprintf(desktop, "Exec=wine start ");
+            fprintf(desktop, "Exec=");
+        write_exec_wine( desktop );
+        fprintf(desktop, "start ");
         if (progId) /* file association */
             fprintf(desktop, "/ProgIDOpen \"%s\" %%f\n", escape(progId));
         else /* protocol association */
