From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 17:34:19 -0400
Subject: [PATCH] windowscodecs: Register the 8bpp alpha pixel format.

Word's PDF import (PDFREFLOW.EXE) asks for the component info of
GUID_WICPixelFormat8bppAlpha, the format of Direct2D's alpha-only bitmaps
and of PDF soft masks, and throws when CreateComponentInfo fails, so every
PDF with an image, chart or SmartArt failed to open.

The test's values (8 bits, one channel, mask 0xff, unsigned integer, with
transparency) are still to be run on Windows.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/windowscodecs/regsvr.c b/dlls/windowscodecs/regsvr.c
index 0aaf9b21d59..87f5b44726b 100644
--- a/dlls/windowscodecs/regsvr.c
+++ b/dlls/windowscodecs/regsvr.c
@@ -2428,6 +2428,17 @@ static struct regsvr_pixelformat const pixelformat_list[] = {
         WICPixelFormatNumericRepresentationUnsignedInteger,
         0
     },
+    {   &GUID_WICPixelFormat8bppAlpha,
+        "The Wine Project",
+        "8bpp Alpha",
+        NULL, /* no version */
+        &GUID_VendorMicrosoft,
+        8, /* bitsperpixel */
+        1, /* channel count */
+        channel_masks_8bit,
+        WICPixelFormatNumericRepresentationUnsignedInteger,
+        1
+    },
     {   &GUID_WICPixelFormat16bppGray,
         "The Wine Project",
         "16bpp Grayscale",
diff --git a/dlls/windowscodecs/tests/info.c b/dlls/windowscodecs/tests/info.c
index 1fbc7cabb55..e2cacff74b2 100644
--- a/dlls/windowscodecs/tests/info.c
+++ b/dlls/windowscodecs/tests/info.c
@@ -570,6 +570,40 @@ static void test_encoder_info(void)
     }
 }
 
+static void test_pixelformat_info_8bppAlpha(void)
+{
+    IWICPixelFormatInfo2 *info2;
+    WICPixelFormatNumericRepresentation representation;
+    IWICComponentInfo *info;
+    BOOL transparency;
+    BYTE mask[4];
+    UINT value;
+    HRESULT hr;
+
+    /* an alpha-only format, as Direct2D's alpha-only bitmaps and PDF soft masks use */
+    hr = get_component_info(&GUID_WICPixelFormat8bppAlpha, &info);
+    ok(hr == S_OK, "CreateComponentInfo failed, hr=%lx\n", hr);
+    if (FAILED(hr)) return;
+
+    hr = IWICComponentInfo_QueryInterface(info, &IID_IWICPixelFormatInfo2, (void **)&info2);
+    ok(hr == S_OK, "QueryInterface failed, hr=%lx\n", hr);
+    hr = IWICPixelFormatInfo2_GetBitsPerPixel(info2, &value);
+    ok(hr == S_OK && value == 8, "GetBitsPerPixel %lx, %u\n", hr, value);
+    hr = IWICPixelFormatInfo2_GetChannelCount(info2, &value);
+    ok(hr == S_OK && value == 1, "GetChannelCount %lx, %u\n", hr, value);
+    memset(mask, 0xcc, sizeof(mask));
+    hr = IWICPixelFormatInfo2_GetChannelMask(info2, 0, sizeof(mask), mask, &value);
+    ok(hr == S_OK && value == 1 && mask[0] == 0xff, "GetChannelMask %lx, %u, %#x\n", hr, value, mask[0]);
+    hr = IWICPixelFormatInfo2_GetNumericRepresentation(info2, &representation);
+    ok(hr == S_OK && representation == WICPixelFormatNumericRepresentationUnsignedInteger,
+            "GetNumericRepresentation %lx, %u\n", hr, representation);
+    hr = IWICPixelFormatInfo2_SupportsTransparency(info2, &transparency);
+    ok(hr == S_OK && transparency, "SupportsTransparency %lx, %d\n", hr, transparency);
+
+    IWICPixelFormatInfo2_Release(info2);
+    IWICComponentInfo_Release(info);
+}
+
 static void test_pixelformat_info(void)
 {
     IWICComponentInfo *info;
@@ -1060,6 +1094,7 @@ START_TEST(info)
     test_encoder_info();
     test_reader_info();
     test_pixelformat_info();
+    test_pixelformat_info_8bppAlpha();
     test_imagingfactory_interfaces();
     test_component_enumerator();
 
