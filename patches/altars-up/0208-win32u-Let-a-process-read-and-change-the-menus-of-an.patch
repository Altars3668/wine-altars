+/* a call that a thread of another process asked for on a menu of this one (WM_WINE_MENU_CALL), made as that thread
+ * would have made it, the error it leaves going back with the result */
+LRESULT handle_menu_call( struct menu_call *call )
+{
+    HMENU handle = UlongToHandle( call->menu );
+    DWORD error = RtlGetLastWin32Error();
+    MENUITEMINFOW item;
+    MENUINFO info;
+    LRESULT ret = 0;
+
+    TRACE( "menu %p: call %u\n", handle, call->func );
+
+    RtlSetLastWin32Error( 0 );
+    switch (call->func)
+    {
+    case MENU_CALL_GET_INFO:
+        menu_info_from_call( &info, call );
+        if ((ret = get_menu_info( handle, &info ))) menu_info_to_call( call, &info );
+        break;
+    case MENU_CALL_SET_INFO:
+        menu_info_from_call( &info, call );
+        if (!(ret = set_menu_info( handle, &info ))) RtlSetLastWin32Error( ERROR_INVALID_MENU_HANDLE );
+        break;
+    case MENU_CALL_ITEM_COUNT:
+        ret = get_menu_item_count( handle );
+        break;
+    case MENU_CALL_ITEM_INFO:
+    {
+        WCHAR *text = call->text_size ? (WCHAR *)(call + 1) : NULL;
+
+        menu_item_from_call( &item, call );
+        item.dwTypeData = text;
+        if (text && (call->method == NtUserInsertMenuItem || call->method == NtUserSetMenuItemInfo))
+            text[call->text_size / sizeof(WCHAR) - 1] = 0;
+        ret = NtUserThunkedMenuItemInfo( handle, call->pos, call->flags, call->method, &item, NULL );
+        menu_item_to_call( call, &item );
+        call->item_type_data = item.dwTypeData == text ? MENU_TYPE_DATA_UNCHANGED : MENU_TYPE_DATA_VALUE;
+        break;
+    }
+    case MENU_CALL_REMOVE:
+        ret = NtUserRemoveMenu( handle, call->pos, call->flags );
+        break;
+    case MENU_CALL_DELETE:
+        ret = NtUserDeleteMenu( handle, call->pos, call->flags );
+        break;
+    case MENU_CALL_DESTROY:
+        ret = NtUserDestroyMenu( handle );
+        break;
+    case MENU_CALL_CHECK:
+        ret = NtUserCheckMenuItem( handle, call->pos, call->flags );
+        break;
+    case MENU_CALL_ENABLE:
+        ret = NtUserEnableMenuItem( handle, call->pos, call->flags );
+        break;
+    case MENU_CALL_SET_DEFAULT:
+        ret = NtUserSetMenuDefaultItem( handle, call->pos, call->flags );
+        break;
+    case MENU_CALL_SET_HELP_ID:
+        ret = NtUserSetMenuContextHelpId( handle, call->arg );
+        break;
+    default:
+        FIXME( "unknown menu call %u\n", call->func );
+        break;
+    }
+    call->error = RtlGetLastWin32Error();
+    RtlSetLastWin32Error( error );
+    return ret;
+}
