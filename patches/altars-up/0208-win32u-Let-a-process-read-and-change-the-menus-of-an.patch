+/* the process and the thread that own a user handle */
+BOOL get_user_handle_owner( HANDLE handle, unsigned short type, DWORD *pid, DWORD *tid )
+{
+    struct user_entry entry;
+
+    if (!get_user_entry( handle, type, &entry, &handle )) return FALSE;
+    *pid = entry.pid;
+    *tid = entry.tid;
+    return TRUE;
+}
