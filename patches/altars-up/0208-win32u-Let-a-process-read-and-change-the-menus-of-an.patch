From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 08:53:36 -0400
Subject: [PATCH] win32u: Let a process read and change the menus of another,
 through the thread owning them.

A menu is a USER object that any process on the desktop reads and
changes, and OLE's in-place activation relies on it: the server makes the
shared menu and asks the container to put its groups in it.  Here a menu
lives in the memory of its process, and every call on one of another
process failed.  Word, activating an Excel worksheet in place, found
Excel's shared menu was no menu (IsMenu), Excel gave the menu up, and
Word kept its own ribbon.

A call on a menu of another process now goes, packed as it is with the
text it sets or reads, to the thread that owns the menu as an internal
message, which makes the call and sends back its result and error: menu
and item information, item count, state, id, submenu and default item,
inserting, setting, removing and deleting items, checking, enabling,
default and help id, and destroying the menu.  A popup of another process
goes into a menu as it is, a window takes a menu of another process as
its menu, and calls that meet one of those in a submenu make them once
the menu is let go of, since no message can be sent while holding one.

What another process may do, and what becomes of its popup when it
exits, follows Windows as measured with tools/menuprobe in the outer
tree; the new test checks it.  The owning thread has to take the messages
sent to it, as for the calls on windows of other threads.  With this Word
swaps its ribbon for Excel's while the worksheet is active in place.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 423911260daea3b11cb032867059b1d5db46cf94)

diff --git a/dlls/user32/tests/menu.c b/dlls/user32/tests/menu.c
index 6862f13c6b1..22af03c0248 100644
--- a/dlls/user32/tests/menu.c
+++ b/dlls/user32/tests/menu.c
@@ -21,6 +21,7 @@
 
 #include <stdarg.h>
 #include <stdio.h>
+#include <stdlib.h>
 #include <string.h>
 #include <assert.h>
 
@@ -4230,8 +4231,177 @@ if (0) /* FIXME: uncomment once Wine is fixed */ {
     DeleteObject(hbmp);
 }
 
+/* wait as a thread with windows does, taking the messages sent to it meanwhile */
+static DWORD wait_for_object_pumping( HANDLE handle, DWORD timeout )
+{
+    DWORD start = GetTickCount(), elapsed, ret;
+    MSG msg;
+
+    for (;;)
+    {
+        if ((elapsed = GetTickCount() - start) >= timeout) return WAIT_TIMEOUT;
+        ret = MsgWaitForMultipleObjects( 1, &handle, FALSE, timeout - elapsed, QS_ALLINPUT );
+        if (ret != WAIT_OBJECT_0 + 1) return ret;
+        while (PeekMessageA( &msg, NULL, 0, 0, PM_REMOVE )) DispatchMessageA( &msg );
+    }
+}
+
+/* another process reads and changes a menu as its own, and destroys one */
+static void test_menu_other_process_child( char **argv )
+{
+    HMENU menu = (HMENU)(ULONG_PTR)strtoull( argv[3], NULL, 16 );
+    HMENU popup = (HMENU)(ULONG_PTR)strtoull( argv[4], NULL, 16 );
+    HMENU doomed = (HMENU)(ULONG_PTR)strtoull( argv[5], NULL, 16 );
+    HANDLE done, go;
+    MENUITEMINFOW info;
+    WCHAR text[32];
+    MENUINFO mi;
+    HMENU mine;
+    int ret;
+
+    done = OpenEventA( EVENT_MODIFY_STATE, FALSE, "menu_other_process_done" );
+    go = OpenEventA( SYNCHRONIZE, FALSE, "menu_other_process_go" );
+
+    ok( IsMenu( menu ), "not a menu\n" );
+    memset( &mi, 0, sizeof(mi) );
+    mi.cbSize = sizeof(mi);
+    mi.fMask = MIM_MENUDATA | MIM_HELPID;
+    ret = GetMenuInfo( menu, &mi );
+    ok( ret, "GetMenuInfo failed, error %lu\n", GetLastError() );
+    ok( mi.dwMenuData == 0x1234, "got data %#Ix\n", mi.dwMenuData );
+    ok( mi.dwContextHelpID == 77, "got help id %lu\n", mi.dwContextHelpID );
+    ret = GetMenuItemCount( menu );
+    ok( ret == 2, "got %d items\n", ret );
+    memset( text, 0xcc, sizeof(text) );
+    ret = GetMenuStringW( menu, 101, text, 4, MF_BYCOMMAND );
+    ok( ret == 3 && !wcscmp( text, L"&Fi" ), "got %d %s\n", ret, debugstr_w(text) );
+    ok( text[4] == 0xcccc, "wrote past the text\n" );
+    ret = GetMenuState( menu, 1, MF_BYPOSITION );
+    ok( ret == 0x110, "got state %#x\n", ret );
+    ok( GetMenuItemID( menu, 0 ) == 101, "got id %u\n", GetMenuItemID( menu, 0 ) );
+    ok( GetSubMenu( menu, 1 ) == popup, "got submenu %p\n", GetSubMenu( menu, 1 ) );
+
+    mi.fMask = MIM_MENUDATA;
+    mi.dwMenuData = 0x5678;
+    ret = SetMenuInfo( menu, &mi );
+    ok( ret, "SetMenuInfo failed, error %lu\n", GetLastError() );
+    ret = InsertMenuW( menu, 0, MF_BYPOSITION | MF_STRING, 301, L"Child item" );
+    ok( ret, "InsertMenu failed, error %lu\n", GetLastError() );
+    mine = CreatePopupMenu();
+    AppendMenuW( mine, MF_STRING, 401, L"Child sub item" );
+    memset( &info, 0, sizeof(info) );
+    info.cbSize = sizeof(info);
+    info.fMask = MIIM_STRING | MIIM_SUBMENU | MIIM_ID | MIIM_DATA;
+    info.wID = 402;
+    info.hSubMenu = mine;
+    info.dwItemData = 0xc0de;
+    info.dwTypeData = (WCHAR *)L"Child popup";
+    ret = InsertMenuItemW( menu, -1, TRUE, &info );
+    ok( ret, "InsertMenuItem failed, error %lu\n", GetLastError() );
+    ret = ModifyMenuW( menu, 101, MF_BYCOMMAND | MF_STRING, 102, L"First, modified" );
+    ok( ret, "ModifyMenu failed, error %lu\n", GetLastError() );
+    ret = CheckMenuItem( menu, 102, MF_BYCOMMAND | MF_CHECKED );
+    ok( ret == MF_UNCHECKED, "got %#x\n", ret );
+    ret = AppendMenuW( popup, MF_STRING, 202, L"Sub item from the child" );
+    ok( ret, "AppendMenu failed, error %lu\n", GetLastError() );
+    ret = DeleteMenu( menu, 103, MF_BYCOMMAND );
+    ok( !ret, "DeleteMenu of an item it does not have succeeded\n" );
+    ret = DestroyMenu( doomed );
+    ok( ret, "DestroyMenu failed, error %lu\n", GetLastError() );
+    ok( !IsMenu( doomed ), "the menu is still there\n" );
+
+    SetEvent( done );
+    wait_for_object_pumping( go, 10000 );
+}
+
+static void test_menu_other_process(void)
+{
+    char cmdline[MAX_PATH * 2], **argv;
+    HMENU menu, popup, doomed, sub;
+    PROCESS_INFORMATION pi;
+    STARTUPINFOA si = { sizeof(si) };
+    MENUITEMINFOW info;
+    HANDLE done, go;
+    WCHAR text[32];
+    MENUINFO mi;
+    MSG msg;
+    int ret;
+
+    winetest_get_mainargs( &argv );
+    PeekMessageA( &msg, NULL, 0, 0, PM_NOREMOVE );
+
+    menu = CreateMenu();
+    AppendMenuW( menu, MF_STRING, 101, L"&First" );
+    popup = CreatePopupMenu();
+    AppendMenuW( popup, MF_STRING, 201, L"Sub item" );
+    AppendMenuW( menu, MF_POPUP, (UINT_PTR)popup, L"&Popup" );
+    memset( &mi, 0, sizeof(mi) );
+    mi.cbSize = sizeof(mi);
+    mi.fMask = MIM_MENUDATA | MIM_HELPID;
+    mi.dwMenuData = 0x1234;
+    mi.dwContextHelpID = 77;
+    SetMenuInfo( menu, &mi );
+    doomed = CreatePopupMenu();
+
+    done = CreateEventA( NULL, TRUE, FALSE, "menu_other_process_done" );
+    go = CreateEventA( NULL, TRUE, FALSE, "menu_other_process_go" );
+    sprintf( cmdline, "\"%s\" menu other_process %Ix %Ix %Ix", argv[0], (ULONG_PTR)menu, (ULONG_PTR)popup,
+             (ULONG_PTR)doomed );
+    ret = CreateProcessA( NULL, cmdline, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi );
+    ok( ret, "CreateProcess failed, error %lu\n", GetLastError() );
+    ret = wait_for_object_pumping( done, 20000 );
+    ok( !ret, "the other process never got through, %d\n", ret );
+
+    memset( &mi, 0, sizeof(mi) );
+    mi.cbSize = sizeof(mi);
+    mi.fMask = MIM_MENUDATA;
+    GetMenuInfo( menu, &mi );
+    ok( mi.dwMenuData == 0x5678, "got data %#Ix\n", mi.dwMenuData );
+    ret = GetMenuItemCount( menu );
+    ok( ret == 4, "got %d items\n", ret );
+    ret = GetMenuStringW( menu, 0, text, ARRAY_SIZE(text), MF_BYPOSITION );
+    ok( ret == 10 && !wcscmp( text, L"Child item" ), "got %d %s\n", ret, debugstr_w(text) );
+    ret = GetMenuState( menu, 102, MF_BYCOMMAND );
+    ok( ret == MF_CHECKED, "got state %#x\n", ret );
+    memset( &info, 0, sizeof(info) );
+    info.cbSize = sizeof(info);
+    info.fMask = MIIM_SUBMENU | MIIM_ID | MIIM_DATA;
+    ret = GetMenuItemInfoW( menu, 3, TRUE, &info );
+    ok( ret, "GetMenuItemInfo failed, error %lu\n", GetLastError() );
+    ok( info.wID == 402, "got id %u\n", info.wID );
+    ok( info.dwItemData == 0xc0de, "got data %#Ix\n", info.dwItemData );
+    sub = info.hSubMenu;
+    ok( IsMenu( sub ), "the other process's popup is not a menu\n" );
+    ret = GetMenuStringW( sub, 0, text, ARRAY_SIZE(text), MF_BYPOSITION );
+    ok( ret == 14 && !wcscmp( text, L"Child sub item" ), "got %d %s\n", ret, debugstr_w(text) );
+    ret = GetMenuItemCount( popup );
+    ok( ret == 2, "got %d items in the popup\n", ret );
+    ok( !IsMenu( doomed ), "the destroyed menu is still there\n" );
+
+    SetEvent( go );
+    wait_for_object_pumping( pi.hProcess, 20000 );
+    wait_child_process( &pi );
+    /* the other process's popup went with it */
+    ok( !IsMenu( sub ), "the other process's popup is still there\n" );
+    ret = GetMenuItemCount( menu );
+    ok( ret == 4, "got %d items\n", ret );
+
+    DestroyMenu( menu );
+    CloseHandle( done );
+    CloseHandle( go );
+}
+
 START_TEST(menu)
 {
+    char **argv;
+    int argc = winetest_get_mainargs( &argv );
+
+    if (argc > 5 && !strcmp( argv[2], "other_process" ))
+    {
+        test_menu_other_process_child( argv );
+        return;
+    }
+
     register_menu_check_class();
 
     test_menu_add_string();
@@ -4262,4 +4432,5 @@ START_TEST(menu)
     test_menu_circref();
     test_emptypopup();
     test_AppendMenu();
+    test_menu_other_process();
 }
