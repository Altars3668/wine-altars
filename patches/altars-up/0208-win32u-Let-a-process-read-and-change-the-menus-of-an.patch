index a8227d22707..f56a59b57f0 100644
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -313,7 +313,7 @@ static struct menu *grab_menu_ptr( HMENU handle )
 
     if (menu == OBJ_OTHER_PROCESS)
     {
-        WARN( "other process menu %p\n", handle );
+        TRACE( "other process menu %p\n", handle );
         return NULL;
     }
 
@@ -344,18 +344,193 @@ static struct menu *unsafe_menu_ptr( HMENU handle )
     return menu;
 }
 
-/* see IsMenu */
+/* see IsMenu; a menu of another process is a menu too */
 BOOL is_menu( HMENU handle )
 {
-    struct menu *menu;
-    BOOL is_menu;
+    void *ptr = get_user_handle_ptr( handle, NTUSER_OBJ_MENU );
 
-    menu = grab_menu_ptr( handle );
-    is_menu = menu != NULL;
-    release_menu_ptr( menu );
+    if (ptr && ptr != OBJ_OTHER_PROCESS) release_user_handle_ptr( ptr );
+    if (!ptr) RtlSetLastWin32Error( ERROR_INVALID_MENU_HANDLE );
+    return ptr != NULL;
+}
+
+/* Menus are USER objects that any process on the desktop reads and changes, as OLE's in-place activation has a
+ * container and its object's server do with the menu they share, but here a menu lives in the memory of the process
+ * that made it: a call on a menu of another process is made by the thread that owns the menu (WM_WINE_MENU_CALL).
+ * No such call is made while holding a menu, which is to hold the USER lock. */
+static BOOL is_other_process_menu( HMENU handle )
+{
+    void *ptr = get_user_handle_ptr( handle, NTUSER_OBJ_MENU );
+
+    if (ptr == OBJ_OTHER_PROCESS) return TRUE;
+    if (ptr) release_user_handle_ptr( ptr );
+    return FALSE;
+}
+
+static struct menu_call *alloc_menu_call( enum menu_call_func func, HMENU handle, UINT text_size )
+{
+    struct menu_call *call;
+
+    if (!(call = calloc( 1, sizeof(*call) + text_size )))
+    {
+        RtlSetLastWin32Error( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    call->func = func;
+    call->menu = HandleToUlong( handle );
+    call->text_size = text_size;
+    return call;
+}
+
+/* have the thread owning a menu of another process make a call on it, and take up the error it left */
+static BOOL call_other_process_menu( struct menu_call *call, LRESULT *result )
+{
+    HMENU handle = UlongToHandle( call->menu );
+    DWORD_PTR res = 0;
+    DWORD pid, tid;
+
+    if (!get_user_handle_owner( handle, NTUSER_OBJ_MENU, &pid, &tid ))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_MENU_HANDLE );
+        return FALSE;
+    }
+    TRACE( "menu %p: call %u by thread %04x of process %04x\n", handle, call->func, tid, pid );
+    if (!send_internal_message_timeout( pid, tid, WM_WINE_MENU_CALL, 0, (LPARAM)call, SMTO_NORMAL, 0, &res ))
+    {
+        WARN( "menu %p: its thread %04x does not answer\n", handle, tid );
+        RtlSetLastWin32Error( ERROR_INVALID_MENU_HANDLE );
+        return FALSE;
+    }
+    if (call->error) RtlSetLastWin32Error( call->error );
+    *result = res;
+    return TRUE;
+}
+
+/* a call on a menu of another process that has nothing to send and nothing to bring back but its result */
+static LRESULT call_other_process_menu_args( enum menu_call_func func, HMENU handle, UINT pos, UINT flags,
+                                             UINT arg, LRESULT failed )
+{
+    struct menu_call *call;
+    LRESULT ret;
+
+    if (!(call = alloc_menu_call( func, handle, 0 ))) return failed;
+    call->pos   = pos;
+    call->flags = flags;
+    call->arg   = arg;
+    if (!call_other_process_menu( call, &ret )) ret = failed;
+    free( call );
+    return ret;
+}
+
+static void menu_info_to_call( struct menu_call *call, const MENUINFO *info )
+{
+    call->info_mask       = info->fMask;
+    call->info_style      = info->dwStyle;
+    call->info_max_height = info->cyMax;
+    call->info_background = (ULONG_PTR)info->hbrBack;
+    call->info_help_id    = info->dwContextHelpID;
+    call->info_data       = info->dwMenuData;
+}
+
+static void menu_info_from_call( MENUINFO *info, const struct menu_call *call )
+{
+    info->cbSize          = sizeof(*info);
+    info->fMask           = call->info_mask;
+    info->dwStyle         = call->info_style;
+    info->cyMax           = call->info_max_height;
+    info->hbrBack         = (HBRUSH)(ULONG_PTR)call->info_background;
+    info->dwContextHelpID = call->info_help_id;
+    info->dwMenuData      = call->info_data;
+}
+
+/* get or set the menu information of a menu of another process */
+static BOOL call_other_process_menu_info( enum menu_call_func func, HMENU handle, MENUINFO *info )
+{
+    struct menu_call *call;
+    LRESULT ret;
+
+    if (!(call = alloc_menu_call( func, handle, 0 ))) return FALSE;
+    menu_info_to_call( call, info );
+    if (!call_other_process_menu( call, &ret )) ret = FALSE;
+    else if (ret && func == MENU_CALL_GET_INFO) menu_info_from_call( info, call );
+    free( call );
+    return ret;
+}
+
+static void menu_item_to_call( struct menu_call *call, const MENUITEMINFOW *info )
+{
+    call->item_mask       = info->fMask;
+    call->item_type       = info->fType;
+    call->item_state      = info->fState;
+    call->item_id         = info->wID;
+    call->item_submenu    = HandleToUlong( info->hSubMenu );
+    call->item_checked    = (ULONG_PTR)info->hbmpChecked;
+    call->item_unchecked  = (ULONG_PTR)info->hbmpUnchecked;
+    call->item_data       = info->dwItemData;
+    call->item_type_value = (ULONG_PTR)info->dwTypeData;
+    call->item_cch        = info->cch;
+    call->item_bitmap     = (ULONG_PTR)info->hbmpItem;
+}
+
+static void menu_item_from_call( MENUITEMINFOW *info, const struct menu_call *call )
+{
+    info->cbSize        = sizeof(*info);
+    info->fMask         = call->item_mask;
+    info->fType         = call->item_type;
+    info->fState        = call->item_state;
+    info->wID           = call->item_id;
+    info->hSubMenu      = UlongToHandle( call->item_submenu );
+    info->hbmpChecked   = (HBITMAP)(ULONG_PTR)call->item_checked;
+    info->hbmpUnchecked = (HBITMAP)(ULONG_PTR)call->item_unchecked;
+    info->dwItemData    = call->item_data;
+    info->cch           = call->item_cch;
+    info->hbmpItem      = (HBITMAP)(ULONG_PTR)call->item_bitmap;
+}
+
+/* NtUserThunkedMenuItemInfo on a menu of another process: an item's text goes along to be set or inserted, and the
+ * caller's buffer goes and comes back to be read into, so that what the owner does not write stays as it was */
+static UINT call_other_process_menu_item_info( HMENU handle, UINT pos, UINT flags, UINT method,
+                                               MENUITEMINFOW *info )
+{
+    BOOL get = method == NtUserGetMenuItemInfoA || method == NtUserGetMenuItemInfoW;
+    BOOL set = method == NtUserInsertMenuItem || method == NtUserSetMenuItemInfo;
+    UINT failed = (method == NtUserGetMenuItemID || method == NtUserGetMenuState ||
+                   method == NtUserGetMenuDefaultItem) ? -1 : 0;
+    struct menu_call *call;
+    UINT text_size = 0;
+    LRESULT ret;
+
+    if ((get || set) && (!info || info->cbSize != sizeof(*info)))
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (get && (info->fMask & (MIIM_TYPE | MIIM_STRING)) && info->dwTypeData && info->cch)
+        text_size = info->cch * (method == NtUserGetMenuItemInfoA ? sizeof(char) : sizeof(WCHAR));
+    else if (set && (info->fMask & MIIM_STRING) && info->dwTypeData)
+        text_size = (wcslen( info->dwTypeData ) + 1) * sizeof(WCHAR);
 
-    if (!is_menu) RtlSetLastWin32Error( ERROR_INVALID_MENU_HANDLE );
-    return is_menu;
+    if (!(call = alloc_menu_call( MENU_CALL_ITEM_INFO, handle, text_size ))) return failed;
+    call->pos    = pos;
+    call->flags  = flags;
+    call->method = method;
+    if (info) menu_item_to_call( call, info );
+    if (text_size) memcpy( call + 1, info->dwTypeData, text_size );
+
+    if (!call_other_process_menu( call, &ret )) ret = failed;
+    else if (get)
+    {
+        WCHAR *buffer = info->dwTypeData;
+
+        menu_item_from_call( info, call );
+        if (call->item_type_data == MENU_TYPE_DATA_VALUE)
+            info->dwTypeData = (WCHAR *)(ULONG_PTR)call->item_type_value;
+        else
+            info->dwTypeData = buffer;
+        if (text_size) memcpy( buffer, call + 1, text_size );
+    }
+    free( call );
+    return ret;
 }
 
