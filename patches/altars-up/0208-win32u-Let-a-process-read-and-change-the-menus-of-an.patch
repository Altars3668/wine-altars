+/* menu.c */
+
+/* what a call on a menu of another process does (WM_WINE_MENU_CALL) */
+enum menu_call_func
+{
+    MENU_CALL_GET_INFO,
+    MENU_CALL_SET_INFO,
+    MENU_CALL_ITEM_COUNT,
+    MENU_CALL_ITEM_INFO,
+    MENU_CALL_REMOVE,
+    MENU_CALL_DELETE,
+    MENU_CALL_DESTROY,
+    MENU_CALL_CHECK,
+    MENU_CALL_ENABLE,
+    MENU_CALL_SET_DEFAULT,
+    MENU_CALL_SET_HELP_ID,
+};
+
+/* a call on a menu of another process, which the thread owning the menu makes for the caller; laid out the same in
+ * every process, with its 64-bit fields 8-byte aligned whatever the alignment rules, it goes between processes as it
+ * is, followed by text_size bytes of an item's text */
+struct menu_call
+{
+    UINT      func;            /* enum menu_call_func */
+    UINT      menu;            /* the menu */
+    UINT      pos;             /* item id or position */
+    UINT      flags;           /* MF_BYPOSITION and the like */
+    UINT      method;          /* NtUserThunkedMenuItemInfo method */
+    UINT      arg;             /* context help id */
+    UINT      error;           /* the error of a call that failed */
+    UINT      text_size;       /* bytes of text that follow: to set or insert, or room for what is read */
+    UINT      item_mask;       /* MENUITEMINFOW */
+    UINT      item_type;
+    UINT      item_state;
+    UINT      item_id;
+    UINT      item_submenu;
+    UINT      item_cch;
+    UINT      item_type_data;  /* how the call left dwTypeData: MENU_TYPE_DATA_* below */
+    UINT      info_mask;       /* MENUINFO */
+    ULONGLONG item_checked;
+    ULONGLONG item_unchecked;
+    ULONGLONG item_data;
+    ULONGLONG item_type_value; /* dwTypeData that is not the text */
+    ULONGLONG item_bitmap;
+    UINT      info_style;
+    UINT      info_max_height;
+    UINT      info_help_id;
+    UINT      padding;
+    ULONGLONG info_background;
+    ULONGLONG info_data;
+};
+
+#define MENU_TYPE_DATA_UNCHANGED 0  /* dwTypeData left as the caller had it */
+#define MENU_TYPE_DATA_TEXT      1  /* the text that follows */
+#define MENU_TYPE_DATA_VALUE     2  /* item_type_value */
+
+extern LRESULT handle_menu_call( struct menu_call *call );
+
 /* window.c */
 HANDLE alloc_user_handle( void *ptr, unsigned short type );
 void *free_user_handle( HANDLE handle, unsigned short type );
 void *get_user_handle_ptr( HANDLE handle, unsigned short type );
+BOOL get_user_handle_owner( HANDLE handle, unsigned short type, DWORD *pid, DWORD *tid );
 void release_user_handle_ptr( void *ptr );
 void *next_thread_user_object( UINT tid, HANDLE *handle, unsigned short type );
