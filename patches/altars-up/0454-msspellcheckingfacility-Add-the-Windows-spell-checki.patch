+    static const struct expected_error dont[] = { { 0, 4, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    static const struct expected_error capitals[] = { { 10, 5, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    static const struct expected_error i_i[] = { { 6, 1, CORRECTIVE_ACTION_DELETE }, { 0 } };
+    static const struct expected_error world_caps[] = { { 6, 5, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
