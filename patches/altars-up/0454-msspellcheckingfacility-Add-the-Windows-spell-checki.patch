+static void test_word_lists( ISpellCheckerFactory *factory, ISpellChecker *checker )
+{
+    static const struct expected_error none[] = { { 0 } };
+    static const struct expected_error misspelt[] = { { 0, 13, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    static const struct expected_error misspelt_ignored[] = { { 0, 16, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    static const struct expected_error hello[] = { { 0, 5, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    static const struct expected_error corrected[] =
+        { { 0, 11, CORRECTIVE_ACTION_REPLACE, L"wineprobereplacement" }, { 0 } };
+    static const struct expected_error corrected_capital[] = { { 0, 11, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    WCHAR path[MAX_PATH], *text;
+    ISpellChecker *other;
+    ISpellChecker2 *checker2;
+    unsigned int count;
+    DWORD cookie, size;
+    BYTE *data;
+    HRESULT hr;
+    LONG seen;
+
+    hr = ISpellCheckerFactory_CreateSpellChecker( factory, L"en-US", &other );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISpellChecker_add_SpellCheckerChanged( checker, &handler, &cookie );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    check_errors( checker, L"wineprobeword", FALSE, misspelt );
+    hr = ISpellChecker_Add( checker, L"" );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    seen = events;
+    hr = ISpellChecker_Add( checker, L"wineprobeword" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( wait_events( seen + 1 ), "no event\n" );
+    check_errors( checker, L"wineprobeword", FALSE, none );
+    check_errors( checker, L"Wineprobeword", FALSE, none );
+    check_errors( other, L"wineprobeword", FALSE, none );
+    ok( has_suggestion( checker, L"wineprobewrd", L"wineprobeword", &count ), "no wineprobeword\n" );
+
+    /* a word ignored is ignored by that checker */
+    seen = events;
+    hr = ISpellChecker_Ignore( checker, L"wineprobeignored" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( wait_events( seen + 1 ), "no event\n" );
+    check_errors( checker, L"wineprobeignored", FALSE, none );
+    check_errors( other, L"wineprobeignored", FALSE, misspelt_ignored );
+
+    hr = ISpellChecker_QueryInterface( checker, &IID_ISpellChecker2, (void **)&checker2 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    /* removing tells twice, once for each list */
+    seen = events;
+    hr = ISpellChecker2_Remove( checker2, L"wineprobeword" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( wait_events( seen + 2 ), "%ld events\n", events - seen );
+    check_errors( checker, L"wineprobeword", FALSE, misspelt );
+    check_errors( other, L"wineprobeword", FALSE, misspelt );
+    /* a word of the dictionary is taken out as well */
+    seen = events;
+    hr = ISpellChecker2_Remove( checker2, L"hello" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( wait_events( seen + 2 ), "%ld events\n", events - seen );
+    check_errors( checker, L"hello", FALSE, hello );
+    hr = ISpellChecker2_Remove( checker2, L"" );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ISpellChecker2_Release( checker2 );
+
+    hr = ISpellChecker_AutoCorrect( checker, L"", L"x" );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = ISpellChecker_AutoCorrect( checker, L"x", L"" );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    seen = events;
+    hr = ISpellChecker_AutoCorrect( checker, L"wineprobeac", L"wineprobereplacement" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( wait_events( seen + 2 ), "%ld events\n", events - seen );
+    check_errors( checker, L"wineprobeac", FALSE, corrected );
+    check_errors( checker, L"wineprobeac", TRUE, corrected );
+    check_errors( other, L"wineprobeac", FALSE, corrected );
+    /* the correction is for the word as written */
+    check_errors( checker, L"Wineprobeac", FALSE, corrected_capital );
+    ok( has_suggestion( checker, L"wineprobeac", L"wineprobereplacement", &count ), "no correction\n" );
+    ok( count == 1, "got %u\n", count );
+
+    list_path( 2, path );
+    data = read_file( path, &size );
+    ok( data != NULL, "no %s\n", debugstr_w(path) );
+    if (data)
+    {
+        ok( size >= 2 && data[0] == 0xff && data[1] == 0xfe, "no byte order mark\n" );
+        text = (WCHAR *)(data + 2);
+        ok( wcsstr( text, L"wineprobeac|wineprobereplacement\r\n" ) != NULL, "got %s\n", debugstr_w(text) );
+        free( data );
+    }
+
+    hr = ISpellChecker_remove_SpellCheckerChanged( checker, cookie );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ISpellChecker_Release( other );
+}
