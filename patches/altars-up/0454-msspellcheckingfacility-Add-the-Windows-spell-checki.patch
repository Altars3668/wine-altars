+static void test_user_dictionaries( ISpellCheckerFactory *factory, ISpellChecker *checker )
+{
+    IUserDictionariesRegistrar *registrar;
+    WCHAR temp[MAX_PATH], path[MAX_PATH];
+    DWORD written;
+    HANDLE file;
+    HRESULT hr;
+
+    ISpellCheckerFactory_QueryInterface( factory, &IID_IUserDictionariesRegistrar, (void **)&registrar );
+    GetTempPathW( ARRAY_SIZE(temp), temp );
+    swprintf( path, ARRAY_SIZE(path), L"%swineprobe.dic", temp );
+    file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    WriteFile( file, L"\xfeffwineprobeuser\r\n", 16 * sizeof(WCHAR), &written, NULL );
+    CloseHandle( file );
+
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, NULL, L"en-US" );
+    ok( hr == E_POINTER, "got %#lx\n", hr );
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, path, NULL );
+    ok( hr == E_POINTER, "got %#lx\n", hr );
+    ok( wait_word_right( checker, L"wineprobeuser", FALSE ), "wineprobeuser right\n" );
+    /* with no language, for every language, as Office registers its custom dictionary */
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, path, L"" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, path, L"" );
+    ok( hr == S_FALSE, "got %#lx\n", hr );
+    ok( wait_word_right( checker, L"wineprobeuser", TRUE ), "wineprobeuser not right\n" );
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, path, L"en-US" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, path, L"EN-us" );
+    ok( hr == S_FALSE, "got %#lx\n", hr );
+    /* any language */
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, path, L"xx-XX" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUserDictionariesRegistrar_UnregisterUserDictionary( registrar, path, L"xx-XX" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUserDictionariesRegistrar_UnregisterUserDictionary( registrar, path, L"" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUserDictionariesRegistrar_UnregisterUserDictionary( registrar, path, L"en-US" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUserDictionariesRegistrar_UnregisterUserDictionary( registrar, path, L"en-US" );
+    ok( hr == S_FALSE, "got %#lx\n", hr );
+    ok( wait_word_right( checker, L"wineprobeuser", FALSE ), "wineprobeuser still right\n" );
+    DeleteFileW( path );
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, path, L"en-US" );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    swprintf( path, ARRAY_SIZE(path), L"%swineprobe.txt", temp );
+    file = CreateFileW( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    CloseHandle( file );
+    hr = IUserDictionariesRegistrar_RegisterUserDictionary( registrar, path, L"en-US" );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    DeleteFileW( path );
+    IUserDictionariesRegistrar_Release( registrar );
+}
