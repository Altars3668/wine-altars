+/* whether a word is right, as it is once a change is taken in */
+static BOOL wait_word_right( ISpellChecker *checker, const WCHAR *word, BOOL right )
+{
+    IEnumSpellingError *errors;
+    ISpellingError *error;
+    DWORD start = GetTickCount();
+    BOOL ret;
+
+    do
+    {
+        if (FAILED(ISpellChecker_Check( checker, word, &errors ))) return FALSE;
+        ret = IEnumSpellingError_Next( errors, &error ) != S_OK;
+        if (!ret) ISpellingError_Release( error );
+        IEnumSpellingError_Release( errors );
+        if (ret == right) return TRUE;
+        Sleep( 100 );
+    } while (GetTickCount() - start < 5000);
+    return FALSE;
+}
