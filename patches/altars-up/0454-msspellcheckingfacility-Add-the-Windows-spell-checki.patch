+/* whether a word is among the suggestions, and how many there are */
+static BOOL has_suggestion( ISpellChecker *checker, const WCHAR *word, const WCHAR *suggestion, unsigned int *count )
+{
+    IEnumString *strings = NULL;
+    BOOL found = FALSE;
+    WCHAR *str;
+    HRESULT hr;
+
+    *count = 0;
+    hr = ISpellChecker_Suggest( checker, word, &strings );
+    ok( hr == S_OK, "%s: got %#lx\n", debugstr_w(word), hr );
+    if (FAILED(hr)) return FALSE;
+    while (IEnumString_Next( strings, 1, &str, NULL ) == S_OK)
+    {
+        if (!wcscmp( str, suggestion )) found = TRUE;
+        (*count)++;
+        CoTaskMemFree( str );
+    }
+    IEnumString_Release( strings );
+    return found;
+}
