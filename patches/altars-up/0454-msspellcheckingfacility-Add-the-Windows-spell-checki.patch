+#include <stdlib.h>
+
+#include "private.h"
+#include "winnls.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(spell);
+
+/* the most suggestions Windows gives */
+#define MAX_SUGGESTIONS 10
+
+/* ISpellingError */
+
+struct spelling_error
+{
+    ISpellingError ISpellingError_iface;
+    LONG refcount;
+    ULONG start;
+    ULONG length;
+    CORRECTIVE_ACTION action;
+    WCHAR *replacement;
+};
+
+static inline struct spelling_error *impl_from_ISpellingError( ISpellingError *iface )
+{
+    return CONTAINING_RECORD( iface, struct spelling_error, ISpellingError_iface );
+}
+
+static HRESULT WINAPI error_QueryInterface( ISpellingError *iface, REFIID iid, void **out )
+{
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_ISpellingError ))
+    {
+        ISpellingError_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    WARN( "%s not implemented\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI error_AddRef( ISpellingError *iface )
+{
+    return InterlockedIncrement( &impl_from_ISpellingError( iface )->refcount );
+}
+
+static ULONG WINAPI error_Release( ISpellingError *iface )
+{
+    struct spelling_error *error = impl_from_ISpellingError( iface );
+    ULONG ref = InterlockedDecrement( &error->refcount );
+
+    if (!ref)
+    {
+        free( error->replacement );
+        free( error );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI error_get_StartIndex( ISpellingError *iface, ULONG *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ISpellingError( iface )->start;
+    return S_OK;
+}
+
+static HRESULT WINAPI error_get_Length( ISpellingError *iface, ULONG *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ISpellingError( iface )->length;
+    return S_OK;
+}
+
+static HRESULT WINAPI error_get_CorrectiveAction( ISpellingError *iface, CORRECTIVE_ACTION *value )
+{
+    if (!value) return E_POINTER;
+    *value = impl_from_ISpellingError( iface )->action;
+    return S_OK;
+}
+
+/* an empty string for an error that has no replacement */
+static HRESULT WINAPI error_get_Replacement( ISpellingError *iface, WCHAR **value )
+{
+    struct spelling_error *error = impl_from_ISpellingError( iface );
+
+    if (!value) return E_POINTER;
+    if (!(*value = co_strdupW( error->replacement ? error->replacement : L"" ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static const ISpellingErrorVtbl error_vtbl =
+{
+    error_QueryInterface,
+    error_AddRef,
+    error_Release,
+    error_get_StartIndex,
+    error_get_Length,
+    error_get_CorrectiveAction,
+    error_get_Replacement,
+};
+
+/* IEnumSpellingError */
+
+struct error_enum
+{
+    IEnumSpellingError IEnumSpellingError_iface;
+    LONG refcount;
+    ISpellingError **errors;
+    unsigned int count;
+    unsigned int capacity;
+    unsigned int pos;
+};
+
+static inline struct error_enum *impl_from_IEnumSpellingError( IEnumSpellingError *iface )
+{
+    return CONTAINING_RECORD( iface, struct error_enum, IEnumSpellingError_iface );
+}
+
+static HRESULT WINAPI error_enum_QueryInterface( IEnumSpellingError *iface, REFIID iid, void **out )
+{
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IEnumSpellingError ))
+    {
+        IEnumSpellingError_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    WARN( "%s not implemented\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI error_enum_AddRef( IEnumSpellingError *iface )
+{
+    return InterlockedIncrement( &impl_from_IEnumSpellingError( iface )->refcount );
+}
+
+static ULONG WINAPI error_enum_Release( IEnumSpellingError *iface )
+{
+    struct error_enum *errors = impl_from_IEnumSpellingError( iface );
+    ULONG ref = InterlockedDecrement( &errors->refcount );
+
+    if (!ref)
+    {
+        while (errors->count) ISpellingError_Release( errors->errors[--errors->count] );
+        free( errors->errors );
+        free( errors );
+    }
+    return ref;
+}
+
+/* S_FALSE once there are no more */
+static HRESULT WINAPI error_enum_Next( IEnumSpellingError *iface, ISpellingError **value )
+{
+    struct error_enum *errors = impl_from_IEnumSpellingError( iface );
+
+    if (!value) return E_POINTER;
+    if (errors->pos >= errors->count)
+    {
+        *value = NULL;
+        return S_FALSE;
+    }
+    ISpellingError_AddRef( (*value = errors->errors[errors->pos++]) );
+    return S_OK;
+}
+
+static const IEnumSpellingErrorVtbl error_enum_vtbl =
+{
+    error_enum_QueryInterface,
+    error_enum_AddRef,
+    error_enum_Release,
+    error_enum_Next,
+};
+
+static BOOL add_error( struct error_enum *errors, ULONG start, ULONG length, CORRECTIVE_ACTION action,
+                       const WCHAR *replacement )
+{
+    struct spelling_error *error;
+
+    if (errors->count == errors->capacity)
+    {
+        unsigned int capacity = max( 8, errors->capacity * 2 );
+        ISpellingError **array = realloc( errors->errors, capacity * sizeof(*array) );
+
+        if (!array) return FALSE;
+        errors->errors = array;
+        errors->capacity = capacity;
+    }
+    if (!(error = calloc( 1, sizeof(*error) ))) return FALSE;
+    error->ISpellingError_iface.lpVtbl = &error_vtbl;
+    error->refcount = 1;
+    error->start = start;
+    error->length = length;
+    error->action = action;
+    if (replacement && !(error->replacement = strdupW( replacement )))
+    {
+        free( error );
+        return FALSE;
+    }
+    errors->errors[errors->count++] = &error->ISpellingError_iface;
+    return TRUE;
+}
+
+/* ISpellChecker */
+
+struct handler
+{
+    struct list entry;
+    DWORD cookie;
+    ISpellCheckerChangedEventHandler *handler;
+};
+
+struct checker
+{
+    ISpellChecker2 ISpellChecker2_iface;
+    LONG refcount;
+    struct list entry;              /* in the list of checkers, to tell them of changes */
+    struct language *language;
+    WCHAR *tag;                     /* as it was asked for */
+    CRITICAL_SECTION cs;
+    WCHAR **ignored;                /* this checker's alone, for as long as it lives */
+    unsigned int ignored_count;
+    struct list handlers;
+    DWORD next_cookie;
+};
+
+static struct list checkers = LIST_INIT( checkers );
+static CRITICAL_SECTION checkers_cs;
+static CRITICAL_SECTION_DEBUG checkers_cs_debug =
+{
+    0, 0, &checkers_cs,
+    { &checkers_cs_debug.ProcessLocksList, &checkers_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": checkers_cs") }
+};
+static CRITICAL_SECTION checkers_cs = { &checkers_cs_debug, -1, 0, 0, 0, 0 };
+
+static inline struct checker *impl_from_ISpellChecker2( ISpellChecker2 *iface )
+{
+    return CONTAINING_RECORD( iface, struct checker, ISpellChecker2_iface );
+}
+
+struct invocation
+{
+    ISpellCheckerChangedEventHandler *handler;
+    ISpellChecker2 *sender;
+};
+
+/* call the handlers of the checkers of a language, all of them for NULL, or of one checker */
+static void invoke_handlers( const struct language *language, struct checker *only )
+{
+    struct invocation *invocations = NULL;
+    unsigned int count = 0, capacity = 0, i;
+    struct checker *checker;
+    struct handler *handler;
+
+    EnterCriticalSection( &checkers_cs );
+    LIST_FOR_EACH_ENTRY( checker, &checkers, struct checker, entry )
+    {
+        if (only ? checker != only : language && checker->language != language) continue;
+        EnterCriticalSection( &checker->cs );
+        LIST_FOR_EACH_ENTRY( handler, &checker->handlers, struct handler, entry )
+        {
+            if (count == capacity)
+            {
+                struct invocation *array;
+                capacity = max( 8, capacity * 2 );
+                if (!(array = realloc( invocations, capacity * sizeof(*array) ))) break;
+                invocations = array;
+            }
+            ISpellCheckerChangedEventHandler_AddRef( (invocations[count].handler = handler->handler) );
+            ISpellChecker2_AddRef( (invocations[count].sender = &checker->ISpellChecker2_iface) );
+            count++;
+        }
+        LeaveCriticalSection( &checker->cs );
+    }
+    LeaveCriticalSection( &checkers_cs );
+
+    for (i = 0; i < count; i++)
+    {
+        ISpellCheckerChangedEventHandler_Invoke( invocations[i].handler, (ISpellChecker *)invocations[i].sender );
+        ISpellCheckerChangedEventHandler_Release( invocations[i].handler );
+        ISpellChecker2_Release( invocations[i].sender );
+    }
+    free( invocations );
+}
+
+void notify_checkers( const struct language *language )
+{
+    invoke_handlers( language, NULL );
+}
+
+static HRESULT WINAPI checker_QueryInterface( ISpellChecker2 *iface, REFIID iid, void **out )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_ISpellChecker ) ||
+        IsEqualIID( iid, &IID_ISpellChecker2 ))
+    {
+        ISpellChecker2_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    WARN( "%s not implemented\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI checker_AddRef( ISpellChecker2 *iface )
+{
+    return InterlockedIncrement( &impl_from_ISpellChecker2( iface )->refcount );
+}
+
+static ULONG WINAPI checker_Release( ISpellChecker2 *iface )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+    struct handler *handler, *next;
+    ULONG ref = InterlockedDecrement( &checker->refcount );
+
+    if (!ref)
+    {
+        EnterCriticalSection( &checkers_cs );
+        list_remove( &checker->entry );
+        LeaveCriticalSection( &checkers_cs );
+        LIST_FOR_EACH_ENTRY_SAFE( handler, next, &checker->handlers, struct handler, entry )
+        {
+            ISpellCheckerChangedEventHandler_Release( handler->handler );
+            free( handler );
+        }
+        free_words( checker->ignored, checker->ignored_count );
+        free( checker->tag );
+        checker->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &checker->cs );
+        free( checker );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI checker_get_LanguageTag( ISpellChecker2 *iface, WCHAR **value )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+
+    TRACE( "%p, %p\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!(*value = co_strdupW( checker->tag ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static BOOL is_word_char( WCHAR c )
+{
+    WORD type1, type3;
+
+    GetStringTypeW( CT_CTYPE1, &c, 1, &type1 );
+    if (type1 & (C1_ALPHA | C1_DIGIT)) return TRUE;
+    GetStringTypeW( CT_CTYPE3, &c, 1, &type3 );
+    return (type3 & C3_NONSPACING) != 0;
+}
+
+static BOOL is_joiner( WCHAR c )
+{
+    return c == '\'' || c == 0x2019 /* right single quotation mark */ || c == '-' || c == 0x2010 /* hyphen */;
+}
+
+static BOOL is_hyphen( WCHAR c )
+{
+    return c == '-' || c == 0x2010;
+}
+
+static BOOL is_space( WCHAR c )
+{
+    WORD type;
+
+    GetStringTypeW( CT_CTYPE1, &c, 1, &type );
+    return (type & (C1_SPACE | C1_BLANK)) != 0;
+}
+
+/* addresses are not words: a URL, a mail address, a host name */
+static BOOL is_address( const WCHAR *chunk, unsigned int len )
+{
+    unsigned int i, at = len;
+
+    for (i = 0; i + 2 < len; i++) if (chunk[i] == ':' && chunk[i + 1] == '/' && chunk[i + 2] == '/') return TRUE;
+    if (len > 4 && !wcsnicmp( chunk, L"www.", 4 )) return TRUE;
+    for (i = 0; i < len; i++)
+    {
+        if (chunk[i] == '@' && i && at == len) at = i;
+        else if (chunk[i] == '.' && at < i) return TRUE;
+    }
+    return FALSE;
+}
+
+/* a word is not checked when it holds a digit, or is in capitals, as names and abbreviations are */
+static BOOL is_checked( const WCHAR *word, unsigned int len )
+{
+    BOOL upper = FALSE, lower = FALSE;
+    unsigned int i;
+    WORD type;
+
+    for (i = 0; i < len; i++)
+    {
+        GetStringTypeW( CT_CTYPE1, word + i, 1, &type );
+        if (type & C1_DIGIT) return FALSE;
+        if (type & C1_UPPER) upper = TRUE;
+        if (type & C1_LOWER) lower = TRUE;
+    }
+    return !upper || lower;
+}
+
+static BOOL is_ignored( struct checker *checker, const WCHAR *word, unsigned int len )
+{
+    unsigned int i;
+    BOOL ret = FALSE;
+
+    EnterCriticalSection( &checker->cs );
+    for (i = 0; !ret && i < checker->ignored_count; i++)
+        ret = wcslen( checker->ignored[i] ) == len && !wcsnicmp( checker->ignored[i], word, len );
+    LeaveCriticalSection( &checker->cs );
+    return ret;
+}
+
+static BOOL is_word_right( struct checker *checker, const WCHAR *word, unsigned int len )
+{
+    if (is_word_excluded( checker->language, word, len )) return FALSE;
+    if (is_ignored( checker, word, len ) || is_word_added( checker->language, word, len )) return TRUE;
+    return spell_word( checker->language, word, len );
+}
+
+/* the edits from one word to another, a transposition counting as one */
+static unsigned int word_distance( const WCHAR *a, unsigned int la, const WCHAR *b, unsigned int lb )
+{
+    unsigned int d[33][33], i, j, cost;
+
+    if (la > 32 || lb > 32) return ~0u;
+    for (i = 0; i <= la; i++) d[i][0] = i;
+    for (j = 0; j <= lb; j++) d[0][j] = j;
+    for (i = 1; i <= la; i++)
+        for (j = 1; j <= lb; j++)
+        {
+            cost = towlower( a[i - 1] ) != towlower( b[j - 1] );
+            d[i][j] = min( min( d[i - 1][j] + 1, d[i][j - 1] + 1 ), d[i - 1][j - 1] + cost );
+            if (i > 1 && j > 1 && towlower( a[i - 1] ) == towlower( b[j - 2] ) &&
+                towlower( a[i - 2] ) == towlower( b[j - 1] ))
+                d[i][j] = min( d[i][j], d[i - 2][j - 2] + 1 );
+        }
+    return d[la][lb];
+}
+
+/* the suggestions for a word: its correction where it has one, else the words the user added that are close
+ * to it, then the dictionary's */
+static unsigned int get_suggestions( struct checker *checker, const WCHAR *word, unsigned int len, WCHAR ***out )
+{
+    WCHAR **ret, **words, *correction;
+    unsigned int count = 0, nb, i, j;
+
+    *out = NULL;
+    if (!(ret = calloc( MAX_SUGGESTIONS, sizeof(*ret) ))) return 0;
+    if ((correction = find_autocorrect( checker->language, word, len )))
+    {
+        ret[count++] = correction;
+        *out = ret;
+        return count;
+    }
+    nb = added_words( &words );
+    for (i = 0; i < nb && count < MAX_SUGGESTIONS; i++)
+    {
+        unsigned int lw = wcslen( words[i] );
+        if (lw == len && !wcsnicmp( words[i], word, len )) continue;
+        if (word_distance( words[i], lw, word, len ) > 2) continue;
+        if ((ret[count] = strdupW( words[i] ))) count++;
+    }
+    free_words( words, nb );
+    nb = suggest_words( checker->language, word, len, &words );
+    for (i = 0; i < nb && count < MAX_SUGGESTIONS; i++)
+    {
+        if (is_word_excluded( checker->language, words[i], wcslen( words[i] ) )) continue;
+        for (j = 0; j < count; j++) if (!wcscmp( ret[j], words[i] )) break;
+        if (j < count) continue;
+        if ((ret[count] = strdupW( words[i] ))) count++;
+    }
+    free_words( words, nb );
+    *out = ret;
+    return count;
+}
+
+/* an error for a misspelt word: a comprehensive check gives the replacement when there is only one */
+static BOOL add_misspelling( struct checker *checker, struct error_enum *errors, const WCHAR *text, ULONG start,
+                             ULONG len, BOOL comprehensive )
+{
+    WCHAR **suggestions;
+    unsigned int count;
+    BOOL ret;
+
+    if (!comprehensive) return add_error( errors, start, len, CORRECTIVE_ACTION_GET_SUGGESTIONS, NULL );
+    count = get_suggestions( checker, text + start, len, &suggestions );
+    if (count == 1) ret = add_error( errors, start, len, CORRECTIVE_ACTION_REPLACE, suggestions[0] );
+    else ret = add_error( errors, start, len, CORRECTIVE_ACTION_GET_SUGGESTIONS, NULL );
+    free_words( suggestions, count );
+    return ret;
+}
+
+static BOOL check_word( struct checker *checker, struct error_enum *errors, const WCHAR *text, ULONG start,
+                        ULONG len, BOOL comprehensive )
+{
+    WCHAR *correction;
+    ULONG part, end;
+    BOOL ret = TRUE;
+
+    if ((correction = find_autocorrect( checker->language, text + start, len )))
+    {
+        ret = add_error( errors, start, len, CORRECTIVE_ACTION_REPLACE, correction );
+        free( correction );
+        return ret;
+    }
+    if (is_word_right( checker, text + start, len )) return TRUE;
+    /* in a compound, the parts that are wrong */
+    for (part = start; part < start + len && !is_hyphen( text[part] ); part++) ;
+    if (part == start + len) return add_misspelling( checker, errors, text, start, len, comprehensive );
+    for (part = start; ret && part < start + len; part = end + 1)
+    {
+        for (end = part; end < start + len && !is_hyphen( text[end] ); end++) ;
+        if (end > part && is_checked( text + part, end - part ) && !is_word_right( checker, text + part, end - part ))
+            ret = add_misspelling( checker, errors, text, part, end - part, comprehensive );
+    }
+    return ret;
+}
+
+static HRESULT check_text( struct checker *checker, const WCHAR *text, BOOL comprehensive, IEnumSpellingError **out )
+{
+    ULONG len = wcslen( text ), pos = 0, end, prev_start = 0, prev_len = 0;
+    struct error_enum *errors;
+    BOOL repeatable = FALSE, ok = TRUE;
+
+    if (!(errors = calloc( 1, sizeof(*errors) ))) return E_OUTOFMEMORY;
+    errors->IEnumSpellingError_iface.lpVtbl = &error_enum_vtbl;
+    errors->refcount = 1;
+    refresh_lists( checker->language );
+
+    while (ok && pos < len)
+    {
+        /* only spaces between them make a word a repetition of the one before */
+        if (is_space( text[pos] ))
+        {
+            if (text[pos] != ' ') repeatable = FALSE;
+            pos++;
+            continue;
+        }
+        if (!pos || is_space( text[pos - 1] ))
+        {
+            for (end = pos; end < len && !is_space( text[end] ); end++) ;
+            if (is_address( text + pos, end - pos ))
+            {
+                repeatable = FALSE;
+                pos = end;
+                continue;
+            }
+        }
+        if (!is_word_char( text[pos] ))
+        {
+            repeatable = FALSE;
+            pos++;
+            continue;
+        }
+        /* a word, apostrophes and hyphens included where letters are on both sides */
+        for (end = pos; end < len; end++)
+        {
+            if (is_word_char( text[end] )) continue;
+            if (is_joiner( text[end] ) && end + 1 < len && is_word_char( text[end + 1] )) continue;
+            break;
+        }
+        if (!is_checked( text + pos, end - pos ))
+        {
+            /* a number is no repetition, a word in capitals can be one */
+            WORD type;
+            GetStringTypeW( CT_CTYPE1, text + pos, 1, &type );
+            if (repeatable && end - pos == prev_len && !wcsnicmp( text + pos, text + prev_start, prev_len ) &&
+                !(type & C1_DIGIT))
+                ok = add_error( errors, pos, end - pos, CORRECTIVE_ACTION_DELETE, NULL );
+            repeatable = !(type & C1_DIGIT);
+        }
+        else if (repeatable && end - pos == prev_len && !wcsnicmp( text + pos, text + prev_start, prev_len ))
+            ok = add_error( errors, pos, end - pos, CORRECTIVE_ACTION_DELETE, NULL );
+        else
+        {
+            ok = check_word( checker, errors, text, pos, end - pos, comprehensive );
+            repeatable = TRUE;
+        }
+        prev_start = pos;
+        prev_len = end - pos;
+        pos = end;
+    }
+    if (!ok)
+    {
+        IEnumSpellingError_Release( &errors->IEnumSpellingError_iface );
+        return E_OUTOFMEMORY;
+    }
+    *out = &errors->IEnumSpellingError_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI checker_Check( ISpellChecker2 *iface, const WCHAR *text, IEnumSpellingError **out )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_w(text), out );
+
+    if (!text || !out) return E_POINTER;
+    *out = NULL;
+    if (!*text) return E_INVALIDARG;
+    return check_text( checker, text, FALSE, out );
+}
+
+static HRESULT WINAPI checker_Suggest( ISpellChecker2 *iface, const WCHAR *word, IEnumString **out )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+    WCHAR **suggestions;
+    unsigned int count;
+    HRESULT hr;
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_w(word), out );
+
+    if (!word || !out) return E_POINTER;
+    *out = NULL;
+    if (!*word) return E_INVALIDARG;
+    refresh_lists( checker->language );
+    count = get_suggestions( checker, word, wcslen( word ), &suggestions );
+    hr = create_string_enum( suggestions, count, out );
+    free_words( suggestions, count );
+    return hr;
+}
+
+static HRESULT WINAPI checker_Add( ISpellChecker2 *iface, const WCHAR *word )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+
+    TRACE( "%p, %s\n", iface, debugstr_w(word) );
+
+    if (!word) return E_POINTER;
+    if (!*word) return E_INVALIDARG;
+    return add_word( checker->language, word );
+}
+
+static HRESULT WINAPI checker_Ignore( ISpellChecker2 *iface, const WCHAR *word )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+    WCHAR **ignored, *copy;
+
+    TRACE( "%p, %s\n", iface, debugstr_w(word) );
+
+    if (!word) return E_POINTER;
+    if (!*word) return E_INVALIDARG;
+    if (!(copy = strdupW( word ))) return E_OUTOFMEMORY;
+    EnterCriticalSection( &checker->cs );
+    if (!(ignored = realloc( checker->ignored, (checker->ignored_count + 1) * sizeof(*ignored) )))
+    {
+        LeaveCriticalSection( &checker->cs );
+        free( copy );
+        return E_OUTOFMEMORY;
+    }
+    checker->ignored = ignored;
+    checker->ignored[checker->ignored_count++] = copy;
+    LeaveCriticalSection( &checker->cs );
+    invoke_handlers( NULL, checker );
+    return S_OK;
+}
+
+static HRESULT WINAPI checker_AutoCorrect( ISpellChecker2 *iface, const WCHAR *from, const WCHAR *to )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+
+    TRACE( "%p, %s, %s\n", iface, debugstr_w(from), debugstr_w(to) );
+
+    if (!from || !to) return E_POINTER;
+    if (!*from || !*to) return E_INVALIDARG;
+    return add_autocorrect( checker->language, from, to );
+}
+
+/* Windows has no options for its own dictionaries */
+static HRESULT WINAPI checker_GetOptionValue( ISpellChecker2 *iface, const WCHAR *id, BYTE *value )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_w(id), value );
+
+    if (!id || !value) return E_POINTER;
+    *value = 0;
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI checker_get_OptionIds( ISpellChecker2 *iface, IEnumString **value )
+{
+    TRACE( "%p, %p\n", iface, value );
+
+    if (!value) return E_POINTER;
+    return create_string_enum( NULL, 0, value );
+}
+
+static HRESULT WINAPI checker_get_Id( ISpellChecker2 *iface, WCHAR **value )
+{
+    TRACE( "%p, %p\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!(*value = co_strdupW( L"MsSpell" ))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+/* a string of the resources in the user's language, without user32 */
+static const WCHAR *load_string( UINT id, unsigned int *len )
+{
+    const WCHAR *str;
+    unsigned int i;
+    HRSRC rsrc;
+
+    if (!(rsrc = FindResourceW( instance, MAKEINTRESOURCEW( (id >> 4) + 1 ), (const WCHAR *)RT_STRING ))) return NULL;
+    if (!(str = LockResource( LoadResource( instance, rsrc ) ))) return NULL;
+    for (i = 0; i < (id & 15); i++) str += *str + 1;
+    *len = *str;
+    return *len ? str + 1 : NULL;
+}
+
+static HRESULT WINAPI checker_get_LocalizedName( ISpellChecker2 *iface, WCHAR **value )
+{
+    const WCHAR *name;
+    unsigned int len;
+    WCHAR *copy;
+
+    TRACE( "%p, %p\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if (!(name = load_string( IDS_LOCALIZED_NAME, &len )))
+    {
+        name = L"Microsoft Windows Spell Checker";
+        len = wcslen( name );
+    }
+    if (!(copy = CoTaskMemAlloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    memcpy( copy, name, len * sizeof(WCHAR) );
+    copy[len] = 0;
+    *value = copy;
+    return S_OK;
+}
+
+static HRESULT WINAPI checker_add_SpellCheckerChanged( ISpellChecker2 *iface, ISpellCheckerChangedEventHandler *handler,
+                                                       DWORD *cookie )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+    struct handler *entry;
+
+    TRACE( "%p, %p, %p\n", iface, handler, cookie );
+
+    if (!handler || !cookie) return E_POINTER;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ISpellCheckerChangedEventHandler_AddRef( (entry->handler = handler) );
+    EnterCriticalSection( &checker->cs );
+    entry->cookie = *cookie = ++checker->next_cookie;
+    list_add_tail( &checker->handlers, &entry->entry );
+    LeaveCriticalSection( &checker->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI checker_remove_SpellCheckerChanged( ISpellChecker2 *iface, DWORD cookie )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+    struct handler *entry, *found = NULL;
+
+    TRACE( "%p, %#lx\n", iface, cookie );
+
+    EnterCriticalSection( &checker->cs );
+    LIST_FOR_EACH_ENTRY( entry, &checker->handlers, struct handler, entry )
+    {
+        if (entry->cookie != cookie) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &checker->cs );
+    if (found)
+    {
+        ISpellCheckerChangedEventHandler_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI checker_GetOptionDescription( ISpellChecker2 *iface, const WCHAR *id, IOptionDescription **out )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_w(id), out );
+
+    if (!id || !out) return E_POINTER;
+    *out = NULL;
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI checker_ComprehensiveCheck( ISpellChecker2 *iface, const WCHAR *text, IEnumSpellingError **out )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_w(text), out );
+
+    if (!text || !out) return E_POINTER;
+    *out = NULL;
+    if (!*text) return E_INVALIDARG;
+    return check_text( checker, text, TRUE, out );
+}
+
+static HRESULT WINAPI checker_Remove( ISpellChecker2 *iface, const WCHAR *word )
+{
+    struct checker *checker = impl_from_ISpellChecker2( iface );
+
+    TRACE( "%p, %s\n", iface, debugstr_w(word) );
+
+    if (!word) return E_POINTER;
+    if (!*word) return E_INVALIDARG;
+    return remove_word( checker->language, word );
+}
+
+static const ISpellChecker2Vtbl checker_vtbl =
+{
+    checker_QueryInterface,
+    checker_AddRef,
+    checker_Release,
+    checker_get_LanguageTag,
+    checker_Check,
+    checker_Suggest,
+    checker_Add,
+    checker_Ignore,
+    checker_AutoCorrect,
+    checker_GetOptionValue,
+    checker_get_OptionIds,
+    checker_get_Id,
+    checker_get_LocalizedName,
+    checker_add_SpellCheckerChanged,
+    checker_remove_SpellCheckerChanged,
+    checker_GetOptionDescription,
+    checker_ComprehensiveCheck,
+    checker_Remove,
+};
+
+HRESULT create_spell_checker( struct language *language, const WCHAR *tag, ISpellChecker **out )
+{
+    struct checker *checker;
+
+    if (!(checker = calloc( 1, sizeof(*checker) ))) return E_OUTOFMEMORY;
+    checker->ISpellChecker2_iface.lpVtbl = &checker_vtbl;
+    checker->refcount = 1;
+    checker->language = language;
+    if (!(checker->tag = strdupW( tag )))
+    {
+        free( checker );
+        return E_OUTOFMEMORY;
+    }
+    list_init( &checker->handlers );
+    InitializeCriticalSectionEx( &checker->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    checker->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": checker.cs");
+    EnterCriticalSection( &checkers_cs );
+    list_add_tail( &checkers, &checker->entry );
+    LeaveCriticalSection( &checkers_cs );
+    *out = (ISpellChecker *)&checker->ISpellChecker2_iface;
+    return S_OK;
+}
