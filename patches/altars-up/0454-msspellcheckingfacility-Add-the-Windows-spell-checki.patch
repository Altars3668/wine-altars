+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#ifndef __WINE_MSSPELLCHECKINGFACILITY_UNIXLIB_H
+#define __WINE_MSSPELLCHECKINGFACILITY_UNIXLIB_H
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/unixlib.h"
+
+/* The host's dictionaries are Hunspell's.  Pointers and handles are 64-bit fields throughout, so that a 32-bit
+ * caller hands over the same layout. */
+
+/* the dictionaries found: their names (en_US, de_DE...), one after the other, each ending in a null, and a null
+ * after the last */
+struct list_dictionaries_params
+{
+    UINT64 buffer;      /* in: where the names go */
+    UINT32 size;        /* in: its size */
+    UINT32 needed;      /* out: the size the names need */
+};
+
+struct open_dictionary_params
+{
+    char   name[32];    /* in: the dictionary's name, en_US */
+    UINT64 handle;      /* out: 0 if it cannot be opened */
+    char   encoding[32];/* out: the encoding of its words, UTF-8 or ISO8859-1 say */
+};
+
+struct close_dictionary_params
+{
+    UINT64 handle;
+};
+
+/* a word, in the dictionary's encoding and ending in a null */
+struct spell_params
+{
+    UINT64 handle;
+    UINT64 word;
+    UINT32 correct;     /* out */
+};
+
+/* suggestions, as list_dictionaries gives names */
+struct suggest_params
+{
+    UINT64 handle;
+    UINT64 word;
+    UINT64 buffer;
+    UINT32 size;
+    UINT32 needed;      /* out */
+};
+
+/* a word the dictionary takes as right, or no longer takes, for as long as it is open */
+struct word_params
+{
+    UINT64 handle;
+    UINT64 word;
+};
+
+enum msspellcheckingfacility_funcs
+{
+    unix_list_dictionaries,
+    unix_open_dictionary,
+    unix_close_dictionary,
+    unix_spell,
+    unix_suggest,
+    unix_add_word,
+    unix_remove_word,
+    unix_funcs_count
+};
+
+#endif /* __WINE_MSSPELLCHECKINGFACILITY_UNIXLIB_H */
