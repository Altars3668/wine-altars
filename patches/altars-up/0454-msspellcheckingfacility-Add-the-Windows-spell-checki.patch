+
+import "oaidl.idl";
+import "ocidl.idl";
+import "objidl.idl";
+
+typedef enum WORDLIST_TYPE
+{
+    WORDLIST_TYPE_IGNORE = 0,
+    WORDLIST_TYPE_ADD = 1,
+    WORDLIST_TYPE_EXCLUDE = 2,
+    WORDLIST_TYPE_AUTOCORRECT = 3
+} WORDLIST_TYPE;
+
+typedef enum CORRECTIVE_ACTION
+{
+    CORRECTIVE_ACTION_NONE = 0,
+    CORRECTIVE_ACTION_GET_SUGGESTIONS = 1,
+    CORRECTIVE_ACTION_REPLACE = 2,
+    CORRECTIVE_ACTION_DELETE = 3
+} CORRECTIVE_ACTION;
+
+[
+    object,
+    uuid(b7c82d61-fbe8-4b47-9b27-6c0d2e0de0a3),
+    pointer_default(unique)
+]
+interface ISpellingError : IUnknown
+{
+    [propget] HRESULT StartIndex([out, retval] ULONG *val);
+    [propget] HRESULT Length([out, retval] ULONG *val);
+    [propget] HRESULT CorrectiveAction([out, retval] CORRECTIVE_ACTION *val);
+    [propget] HRESULT Replacement([out, retval, string] LPWSTR *val);
+}
+
+[
+    object,
+    uuid(803e3bd4-2828-4410-8290-418d1d73c762),
+    pointer_default(unique)
+]
+interface IEnumSpellingError : IUnknown
+{
+    HRESULT Next([out] ISpellingError **value);
+}
+
+[
+    object,
+    uuid(432e5f85-35cf-4606-a801-6f70277e1d7a),
+    pointer_default(unique)
+]
+interface IOptionDescription : IUnknown
+{
+    [propget] HRESULT Id([out, retval, string] LPWSTR *val);
+    [propget] HRESULT Heading([out, retval, string] LPWSTR *val);
+    [propget] HRESULT Description([out, retval, string] LPWSTR *val);
+    [propget] HRESULT Labels([out, retval] IEnumString **val);
+}
+
+interface ISpellChecker;
+
+[
+    object,
+    uuid(0b83a5b0-792f-4eab-9799-acf52c5ed08a),
+    pointer_default(unique)
+]
+interface ISpellCheckerChangedEventHandler : IUnknown
+{
+    HRESULT Invoke([in] ISpellChecker *sender);
+}
+
+[
+    object,
+    uuid(b6fd0b71-e2bc-4653-8d05-f197e412770b),
+    pointer_default(unique)
+]
+interface ISpellChecker : IUnknown
+{
+    [propget] HRESULT LanguageTag([out, retval, string] LPWSTR *val);
+    HRESULT Check([in, string] LPCWSTR text, [out, retval] IEnumSpellingError **value);
+    HRESULT Suggest([in, string] LPCWSTR word, [out, retval] IEnumString **value);
+    HRESULT Add([in, string] LPCWSTR word);
+    HRESULT Ignore([in, string] LPCWSTR word);
+    HRESULT AutoCorrect([in, string] LPCWSTR from, [in, string] LPCWSTR to);
+    HRESULT GetOptionValue([in, string] LPCWSTR option_id, [out, retval] BYTE *val);
+    [propget] HRESULT OptionIds([out, retval] IEnumString **val);
+    [propget] HRESULT Id([out, retval, string] LPWSTR *val);
+    [propget] HRESULT LocalizedName([out, retval, string] LPWSTR *val);
+    HRESULT add_SpellCheckerChanged([in] ISpellCheckerChangedEventHandler *handler, [out, retval] DWORD *event_cookie);
+    HRESULT remove_SpellCheckerChanged([in] DWORD event_cookie);
+    HRESULT GetOptionDescription([in, string] LPCWSTR option_id, [out, retval] IOptionDescription **value);
+    HRESULT ComprehensiveCheck([in, string] LPCWSTR text, [out, retval] IEnumSpellingError **value);
+}
+
+[
+    object,
+    uuid(e7ed1c71-87f7-4378-a840-c9200dacee47),
+    pointer_default(unique)
+]
+interface ISpellChecker2 : ISpellChecker
+{
+    HRESULT Remove([in, string] LPCWSTR word);
+}
+
+[
+    object,
+    uuid(8e018a9d-2415-4677-bf08-794ea61f94bb),
+    pointer_default(unique)
+]
+interface ISpellCheckerFactory : IUnknown
+{
+    [propget] HRESULT SupportedLanguages([out, retval] IEnumString **value);
+    HRESULT IsSupported([in, string] LPCWSTR language_tag, [out, retval] BOOL *value);
+    HRESULT CreateSpellChecker([in, string] LPCWSTR language_tag, [out, retval] ISpellChecker **value);
+}
+
+[
+    object,
+    uuid(aa176b85-0e12-4844-8e1a-eef1da77f586),
+    pointer_default(unique)
+]
+interface IUserDictionariesRegistrar : IUnknown
+{
+    HRESULT RegisterUserDictionary([in, string] LPCWSTR dictionary_path, [in, string] LPCWSTR language_tag);
+    HRESULT UnregisterUserDictionary([in, string] LPCWSTR dictionary_path, [in, string] LPCWSTR language_tag);
+}
+
+[
+    uuid(4a250e01-61ea-400b-a27d-bf3744bcc9f5),
+    version(1.0)
+]
+library MsSpellCheckLib
+{
+    [
+        uuid(7ab36653-1796-484b-bdfa-e74f1db7c1dc)
+    ]
+    coclass SpellCheckerFactory
+    {
+        [default] interface ISpellCheckerFactory;
+        interface IUserDictionariesRegistrar;
+    }
+}
