+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdlib.h>
+
+#include "private.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(spell);
+
+#define SPELL_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
+
+HINSTANCE instance;
+
+WCHAR *strdupW( const WCHAR *str )
+{
+    size_t size = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = malloc( size );
+
+    if (ret) memcpy( ret, str, size );
+    return ret;
+}
+
+WCHAR *co_strdupW( const WCHAR *str )
+{
+    size_t size = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = CoTaskMemAlloc( size );
+
+    if (ret) memcpy( ret, str, size );
+    return ret;
+}
+
+/* the languages, one for each of the host's dictionaries, found the first time they are asked for */
+
+static struct list languages = LIST_INIT( languages );
+static INIT_ONCE languages_once = INIT_ONCE_STATIC_INIT;
+
+/* the code page of a dictionary's words, from its SET line */
+static UINT encoding_codepage( const char *encoding )
+{
+    static const struct { const char *name; UINT codepage; } encodings[] =
+    {
+        { "UTF-8", CP_UTF8 }, { "ISO8859-1", 28591 }, { "ISO8859-2", 28592 }, { "ISO8859-3", 28593 },
+        { "ISO8859-4", 28594 }, { "ISO8859-5", 28595 }, { "ISO8859-6", 28596 }, { "ISO8859-7", 28597 },
+        { "ISO8859-8", 28598 }, { "ISO8859-9", 28599 }, { "ISO8859-13", 28603 }, { "ISO8859-15", 28605 },
+        { "KOI8-R", 20866 }, { "KOI8-U", 21866 }, { "microsoft-cp1251", 1251 }, { "TIS620-2533", 874 },
+        { "ISCII-DEVANAGARI", 57002 },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(encodings); i++)
+        if (!_stricmp( encoding, encodings[i].name )) return encodings[i].codepage;
+    FIXME( "encoding %s, taken as ISO8859-1\n", debugstr_a(encoding) );
+    return 28591;
+}
+
+static int __cdecl compare_languages( const void *a, const void *b )
+{
+    const struct language *const *l1 = a, *const *l2 = b;
+    return wcsicmp( (*l1)->tag, (*l2)->tag );
+}
+
+static BOOL WINAPI init_languages( INIT_ONCE *once, void *param, void **context )
+{
+    struct list_dictionaries_params params = { 0 };
+    struct language **sorted, *language;
+    unsigned int count = 0, i;
+    char *names = NULL, *name;
+
+    for (;;)
+    {
+        params.buffer = (UINT_PTR)names;
+        if (SPELL_CALL( list_dictionaries, &params ) != STATUS_BUFFER_TOO_SMALL) break;
+        free( names );
+        if (!(names = malloc( params.needed ))) return TRUE;
+        params.size = params.needed;
+    }
+    if (!names) return TRUE;
+
+    for (name = names; *name; name += strlen( name ) + 1) count++;
+    if (!(sorted = calloc( count, sizeof(*sorted) )))
+    {
+        free( names );
+        return TRUE;
+    }
+    count = 0;
+    for (name = names; *name; name += strlen( name ) + 1)
+    {
+        if (!(language = calloc( 1, sizeof(*language) ))) break;
+        lstrcpynA( language->name, name, sizeof(language->name) );
+        /* a dictionary's name is its language with an underscore, its tag is the language with a hyphen */
+        MultiByteToWideChar( CP_UTF8, 0, name, -1, language->tag, ARRAY_SIZE(language->tag) );
+        for (i = 0; language->tag[i]; i++) if (language->tag[i] == '_') language->tag[i] = '-';
+        InitializeCriticalSectionEx( &language->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+        language->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": language.cs");
+        sorted[count++] = language;
+        TRACE( "%s\n", debugstr_w(language->tag) );
+    }
+    /* as Windows lists them */
+    qsort( sorted, count, sizeof(*sorted), compare_languages );
+    for (i = 0; i < count; i++) list_add_tail( &languages, &sorted[i]->entry );
+    free( sorted );
+    free( names );
+    return TRUE;
+}
+
+struct language *find_language( const WCHAR *tag )
+{
+    struct language *language;
+
+    InitOnceExecuteOnce( &languages_once, init_languages, NULL, NULL );
+    LIST_FOR_EACH_ENTRY( language, &languages, struct language, entry )
+        if (!wcsicmp( language->tag, tag )) return language;
+    return NULL;
+}
+
+/* open the dictionary the first time it is used; called in its critical section */
+static BOOL open_language( struct language *language )
+{
+    struct open_dictionary_params params = { { 0 } };
+
+    if (language->opened) return language->handle != 0;
+    language->opened = TRUE;
+    lstrcpynA( params.name, language->name, sizeof(params.name) );
+    if (SPELL_CALL( open_dictionary, &params ))
+    {
+        WARN( "cannot open %s\n", debugstr_a(language->name) );
+        return FALSE;
+    }
+    language->handle = params.handle;
+    language->codepage = encoding_codepage( params.encoding );
+    return TRUE;
+}
+
+/* a word in the dictionary's encoding, with the typographic apostrophe as the plain one dictionaries have;
+ * NULL where a character has no place in that encoding */
+static char *encode_word( const struct language *language, const WCHAR *word, unsigned int len )
+{
+    BOOL lossy = FALSE, *plossy = language->codepage == CP_UTF8 ? NULL : &lossy;
+    WCHAR *copy;
+    char *ret;
+    int size;
+
+    if (!(copy = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( copy, word, len * sizeof(WCHAR) );
+    copy[len] = 0;
+    for (size = 0; size < len; size++) if (copy[size] == 0x2019) copy[size] = '\'';
+    size = WideCharToMultiByte( language->codepage, 0, copy, -1, NULL, 0, NULL, plossy );
+    if (!size || lossy || !(ret = malloc( size )))
+    {
+        free( copy );
+        return NULL;
+    }
+    WideCharToMultiByte( language->codepage, 0, copy, -1, ret, size, NULL, NULL );
+    free( copy );
+    return ret;
+}
+
+BOOL spell_word( struct language *language, const WCHAR *word, unsigned int len )
+{
+    struct spell_params params = { 0 };
+    char *encoded;
+
+    EnterCriticalSection( &language->cs );
+    if (open_language( language ) && (encoded = encode_word( language, word, len )))
+    {
+        params.handle = language->handle;
+        params.word = (UINT_PTR)encoded;
+        SPELL_CALL( spell, &params );
+        free( encoded );
+    }
+    LeaveCriticalSection( &language->cs );
+    return params.correct;
+}
+
+void free_words( WCHAR **words, unsigned int count )
+{
+    while (count) free( words[--count] );
+    free( words );
+}
+
+unsigned int suggest_words( struct language *language, const WCHAR *word, unsigned int len, WCHAR ***words )
+{
+    struct suggest_params params = { 0 };
+    unsigned int count = 0, i;
+    char *encoded, *buffer = NULL, *p;
+    WCHAR **ret = NULL, *str;
+    int size;
+
+    *words = NULL;
+    EnterCriticalSection( &language->cs );
+    if (open_language( language ) && (encoded = encode_word( language, word, len )))
+    {
+        params.handle = language->handle;
+        params.word = (UINT_PTR)encoded;
+        for (;;)
+        {
+            params.buffer = (UINT_PTR)buffer;
+            if (SPELL_CALL( suggest, &params ) != STATUS_BUFFER_TOO_SMALL) break;
+            free( buffer );
+            if (!(buffer = malloc( params.needed ))) break;
+            params.size = params.needed;
+        }
+        free( encoded );
+    }
+    LeaveCriticalSection( &language->cs );
+    if (!buffer) return 0;
+
+    for (p = buffer; *p; p += strlen( p ) + 1) count++;
+    if (count && (ret = calloc( count, sizeof(*ret) )))
+    {
+        count = 0;
+        for (p = buffer; *p; p += strlen( p ) + 1)
+        {
+            size = MultiByteToWideChar( language->codepage, 0, p, -1, NULL, 0 );
+            if (!size || !(str = malloc( size * sizeof(WCHAR) ))) continue;
+            MultiByteToWideChar( language->codepage, 0, p, -1, str, size );
+            /* the word itself is no suggestion */
+            if (wcslen( str ) == len && !wcsncmp( str, word, len ))
+            {
+                free( str );
+                continue;
+            }
+            for (i = 0; i < count; i++) if (!wcscmp( ret[i], str )) break;
+            if (i < count) free( str );
+            else ret[count++] = str;
+        }
+    }
+    else count = 0;
+    free( buffer );
+    *words = ret;
+    return count;
+}
+
+/* IEnumString over a copy of some strings */
+
+struct string_enum
+{
+    IEnumString IEnumString_iface;
+    LONG refcount;
+    WCHAR **strings;
+    unsigned int count;
+    unsigned int pos;
+};
+
+static inline struct string_enum *impl_from_IEnumString( IEnumString *iface )
+{
+    return CONTAINING_RECORD( iface, struct string_enum, IEnumString_iface );
+}
+
+static HRESULT WINAPI string_enum_QueryInterface( IEnumString *iface, REFIID iid, void **out )
+{
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IEnumString ))
+    {
+        IEnumString_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    WARN( "%s not implemented\n", debugstr_guid(iid) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI string_enum_AddRef( IEnumString *iface )
+{
+    struct string_enum *strings = impl_from_IEnumString( iface );
+    return InterlockedIncrement( &strings->refcount );
+}
+
+static ULONG WINAPI string_enum_Release( IEnumString *iface )
+{
+    struct string_enum *strings = impl_from_IEnumString( iface );
+    ULONG ref = InterlockedDecrement( &strings->refcount );
+
+    if (!ref)
+    {
+        free_words( strings->strings, strings->count );
+        free( strings );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI string_enum_Next( IEnumString *iface, ULONG count, LPOLESTR *out, ULONG *fetched )
+{
+    struct string_enum *strings = impl_from_IEnumString( iface );
+    ULONG done = 0;
+
+    if (!out) return E_POINTER;
+    if (count > 1 && !fetched) return E_INVALIDARG;
+    while (done < count && strings->pos < strings->count)
+    {
+        if (!(out[done] = co_strdupW( strings->strings[strings->pos] )))
+        {
+            while (done) CoTaskMemFree( out[--done] );
+            return E_OUTOFMEMORY;
+        }
+        strings->pos++;
+        done++;
+    }
+    if (fetched) *fetched = done;
+    return done == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI string_enum_Skip( IEnumString *iface, ULONG count )
+{
+    struct string_enum *strings = impl_from_IEnumString( iface );
+
+    if (count > strings->count - strings->pos)
+    {
+        strings->pos = strings->count;
+        return S_FALSE;
+    }
+    strings->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI string_enum_Reset( IEnumString *iface )
+{
+    impl_from_IEnumString( iface )->pos = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI string_enum_Clone( IEnumString *iface, IEnumString **out )
+{
+    struct string_enum *strings = impl_from_IEnumString( iface );
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (SUCCEEDED(hr = create_string_enum( strings->strings, strings->count, out )))
+        impl_from_IEnumString( *out )->pos = strings->pos;
+    return hr;
+}
+
+static const IEnumStringVtbl string_enum_vtbl =
+{
+    string_enum_QueryInterface,
+    string_enum_AddRef,
+    string_enum_Release,
+    string_enum_Next,
+    string_enum_Skip,
+    string_enum_Reset,
+    string_enum_Clone,
+};
+
+HRESULT create_string_enum( WCHAR **strings, unsigned int count, IEnumString **out )
+{
+    struct string_enum *ret;
+
+    if (!(ret = calloc( 1, sizeof(*ret) ))) return E_OUTOFMEMORY;
+    ret->IEnumString_iface.lpVtbl = &string_enum_vtbl;
+    ret->refcount = 1;
+    if (count && !(ret->strings = calloc( count, sizeof(*ret->strings) )))
+    {
+        free( ret );
+        return E_OUTOFMEMORY;
+    }
+    for (ret->count = 0; ret->count < count; ret->count++)
+    {
+        if (!(ret->strings[ret->count] = strdupW( strings[ret->count] )))
+        {
+            IEnumString_Release( &ret->IEnumString_iface );
+            return E_OUTOFMEMORY;
+        }
+    }
+    *out = &ret->IEnumString_iface;
+    return S_OK;
+}
+
+/* the factory, which is also where user dictionaries are registered */
+
+struct factory
+{
+    ISpellCheckerFactory ISpellCheckerFactory_iface;
+    IUserDictionariesRegistrar IUserDictionariesRegistrar_iface;
+    LONG refcount;
+};
+
+static inline struct factory *impl_from_ISpellCheckerFactory( ISpellCheckerFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct factory, ISpellCheckerFactory_iface );
+}
+
+static inline struct factory *impl_from_IUserDictionariesRegistrar( IUserDictionariesRegistrar *iface )
+{
+    return CONTAINING_RECORD( iface, struct factory, IUserDictionariesRegistrar_iface );
+}
+
+static HRESULT WINAPI spell_factory_QueryInterface( ISpellCheckerFactory *iface, REFIID iid, void **out )
+{
+    struct factory *factory = impl_from_ISpellCheckerFactory( iface );
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_guid(iid), out );
+
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_ISpellCheckerFactory ))
+        *out = &factory->ISpellCheckerFactory_iface;
+    else if (IsEqualIID( iid, &IID_IUserDictionariesRegistrar ))
+        *out = &factory->IUserDictionariesRegistrar_iface;
+    else
+    {
+        WARN( "%s not implemented\n", debugstr_guid(iid) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI spell_factory_AddRef( ISpellCheckerFactory *iface )
+{
+    struct factory *factory = impl_from_ISpellCheckerFactory( iface );
+    return InterlockedIncrement( &factory->refcount );
+}
+
+static ULONG WINAPI spell_factory_Release( ISpellCheckerFactory *iface )
+{
+    struct factory *factory = impl_from_ISpellCheckerFactory( iface );
+    ULONG ref = InterlockedDecrement( &factory->refcount );
+
+    if (!ref) free( factory );
+    return ref;
+}
+
+static HRESULT WINAPI spell_factory_get_SupportedLanguages( ISpellCheckerFactory *iface, IEnumString **out )
+{
+    struct language *language;
+    WCHAR **tags = NULL;
+    unsigned int count = 0;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", iface, out );
+
+    if (!out) return E_POINTER;
+    find_language( L"" );
+    if ((tags = calloc( list_count( &languages ) + 1, sizeof(*tags) )))
+        LIST_FOR_EACH_ENTRY( language, &languages, struct language, entry ) tags[count++] = language->tag;
+    hr = create_string_enum( tags, count, out );
+    free( tags );
+    return hr;
+}
+
+static HRESULT WINAPI spell_factory_IsSupported( ISpellCheckerFactory *iface, const WCHAR *tag, BOOL *value )
+{
+    TRACE( "%p, %s, %p\n", iface, debugstr_w(tag), value );
+
+    if (!tag || !value) return E_POINTER;
+    if (!*tag) return E_INVALIDARG;
+    *value = find_language( tag ) != NULL;
+    return S_OK;
+}
+
+static HRESULT WINAPI spell_factory_CreateSpellChecker( ISpellCheckerFactory *iface, const WCHAR *tag,
+                                                        ISpellChecker **out )
+{
+    struct language *language;
+
+    TRACE( "%p, %s, %p\n", iface, debugstr_w(tag), out );
+
+    if (!tag || !out) return E_POINTER;
+    *out = NULL;
+    if (!(language = find_language( tag ))) return E_INVALIDARG;
+    return create_spell_checker( language, tag, out );
+}
+
+static const ISpellCheckerFactoryVtbl spell_factory_vtbl =
+{
+    spell_factory_QueryInterface,
+    spell_factory_AddRef,
+    spell_factory_Release,
+    spell_factory_get_SupportedLanguages,
+    spell_factory_IsSupported,
+    spell_factory_CreateSpellChecker,
+};
+
+static HRESULT WINAPI registrar_QueryInterface( IUserDictionariesRegistrar *iface, REFIID iid, void **out )
+{
+    struct factory *factory = impl_from_IUserDictionariesRegistrar( iface );
+    return ISpellCheckerFactory_QueryInterface( &factory->ISpellCheckerFactory_iface, iid, out );
+}
+
+static ULONG WINAPI registrar_AddRef( IUserDictionariesRegistrar *iface )
+{
+    struct factory *factory = impl_from_IUserDictionariesRegistrar( iface );
+    return ISpellCheckerFactory_AddRef( &factory->ISpellCheckerFactory_iface );
+}
+
+static ULONG WINAPI registrar_Release( IUserDictionariesRegistrar *iface )
+{
+    struct factory *factory = impl_from_IUserDictionariesRegistrar( iface );
+    return ISpellCheckerFactory_Release( &factory->ISpellCheckerFactory_iface );
+}
+
+static HRESULT WINAPI registrar_RegisterUserDictionary( IUserDictionariesRegistrar *iface, const WCHAR *path,
+                                                        const WCHAR *tag )
+{
+    TRACE( "%p, %s, %s\n", iface, debugstr_w(path), debugstr_w(tag) );
+
+    if (!path || !tag) return E_POINTER;
+    return register_user_dictionary( path, tag );
+}
+
+static HRESULT WINAPI registrar_UnregisterUserDictionary( IUserDictionariesRegistrar *iface, const WCHAR *path,
+                                                          const WCHAR *tag )
+{
+    TRACE( "%p, %s, %s\n", iface, debugstr_w(path), debugstr_w(tag) );
+
+    if (!path || !tag) return E_POINTER;
+    return unregister_user_dictionary( path, tag );
+}
+
+static const IUserDictionariesRegistrarVtbl registrar_vtbl =
+{
+    registrar_QueryInterface,
+    registrar_AddRef,
+    registrar_Release,
+    registrar_RegisterUserDictionary,
+    registrar_UnregisterUserDictionary,
+};
+
+static HRESULT WINAPI class_factory_QueryInterface( IClassFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualIID( iid, &IID_IUnknown ) || IsEqualIID( iid, &IID_IClassFactory ))
+    {
+        IClassFactory_AddRef( (*out = iface) );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI class_factory_AddRef( IClassFactory *iface ) { return 2; }
+static ULONG WINAPI class_factory_Release( IClassFactory *iface ) { return 1; }
+
+static HRESULT WINAPI class_factory_CreateInstance( IClassFactory *iface, IUnknown *outer, REFIID iid, void **out )
+{
+    struct factory *factory;
+    HRESULT hr;
+
+    TRACE( "%p, %p, %s, %p\n", iface, outer, debugstr_guid(iid), out );
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(factory = calloc( 1, sizeof(*factory) ))) return E_OUTOFMEMORY;
+    factory->ISpellCheckerFactory_iface.lpVtbl = &spell_factory_vtbl;
+    factory->IUserDictionariesRegistrar_iface.lpVtbl = &registrar_vtbl;
+    factory->refcount = 1;
+    hr = ISpellCheckerFactory_QueryInterface( &factory->ISpellCheckerFactory_iface, iid, out );
+    ISpellCheckerFactory_Release( &factory->ISpellCheckerFactory_iface );
+    return hr;
+}
+
+static HRESULT WINAPI class_factory_LockServer( IClassFactory *iface, BOOL lock )
+{
+    return S_OK;
+}
+
+static const IClassFactoryVtbl class_factory_vtbl =
+{
+    class_factory_QueryInterface,
+    class_factory_AddRef,
+    class_factory_Release,
+    class_factory_CreateInstance,
+    class_factory_LockServer,
+};
+
+static IClassFactory class_factory = { &class_factory_vtbl };
+
+HRESULT WINAPI DllGetClassObject( REFCLSID clsid, REFIID iid, void **out )
+{
+    TRACE( "%s, %s, %p\n", debugstr_guid(clsid), debugstr_guid(iid), out );
+
+    if (IsEqualCLSID( clsid, &CLSID_SpellCheckerFactory ))
+        return IClassFactory_QueryInterface( &class_factory, iid, out );
+
+    FIXME( "class %s not available\n", debugstr_guid(clsid) );
+    *out = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
+
+BOOL WINAPI DllMain( HINSTANCE inst, DWORD reason, void *reserved )
+{
+    if (reason == DLL_PROCESS_ATTACH)
+    {
+        instance = inst;
+        DisableThreadLibraryCalls( inst );
+        if (__wine_init_unix_call()) ERR( "no unix side\n" );
+    }
+    return TRUE;
+}
