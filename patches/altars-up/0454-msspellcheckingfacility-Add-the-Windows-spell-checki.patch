+
+#define COBJMACROS
+#include <stdarg.h>
+#include <stdio.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "spellcheck.h"
+
+#include "wine/test.h"
+
+struct expected_error
+{
+    ULONG start, length;
+    CORRECTIVE_ACTION action;
+    const WCHAR *replacement;
+    BOOL todo;
+};
+
+#define check_errors(a, b, c, d) check_errors_(__LINE__, a, b, c, d)
+static void check_errors_( unsigned int line, ISpellChecker *checker, const WCHAR *text, BOOL comprehensive,
+                           const struct expected_error *expected )
+{
+    IEnumSpellingError *errors = NULL;
+    CORRECTIVE_ACTION action;
+    ISpellingError *error;
+    ULONG start, length;
+    unsigned int i = 0;
+    WCHAR *replacement;
+    HRESULT hr;
+
+    if (comprehensive) hr = ISpellChecker_ComprehensiveCheck( checker, text, &errors );
+    else hr = ISpellChecker_Check( checker, text, &errors );
+    ok_(__FILE__, line)( hr == S_OK, "%s: got %#lx\n", debugstr_w(text), hr );
+    if (FAILED(hr)) return;
+    while ((hr = IEnumSpellingError_Next( errors, &error )) == S_OK)
+    {
+        ISpellingError_get_StartIndex( error, &start );
+        ISpellingError_get_Length( error, &length );
+        ISpellingError_get_CorrectiveAction( error, &action );
+        replacement = NULL;
+        ISpellingError_get_Replacement( error, &replacement );
+        ok_(__FILE__, line)( expected[i].length != 0, "%s: unexpected error %lu,%lu\n", debugstr_w(text), start, length );
+        if (expected[i].length)
+        {
+            ok_(__FILE__, line)( start == expected[i].start && length == expected[i].length,
+                                 "%s: error %u at %lu,%lu\n", debugstr_w(text), i, start, length );
+            todo_wine_if( expected[i].todo )
+            ok_(__FILE__, line)( action == expected[i].action, "%s: error %u action %d\n", debugstr_w(text), i, action );
+            todo_wine_if( expected[i].todo )
+            ok_(__FILE__, line)( replacement && !wcscmp( replacement, expected[i].replacement ? expected[i].replacement : L"" ),
+                                 "%s: error %u replacement %s\n", debugstr_w(text), i, debugstr_w(replacement) );
+            i++;
+        }
+        CoTaskMemFree( replacement );
+        ISpellingError_Release( error );
+    }
+    ok_(__FILE__, line)( hr == S_FALSE, "%s: Next returned %#lx\n", debugstr_w(text), hr );
+    ok_(__FILE__, line)( !expected[i].length, "%s: %u errors, error %u missing\n", debugstr_w(text), i, i );
+    IEnumSpellingError_Release( errors );
+}
