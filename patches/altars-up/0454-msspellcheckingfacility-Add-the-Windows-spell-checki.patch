+static void test_checker( ISpellChecker *checker )
+{
+    static const struct expected_error none[] = { { 0 } };
+    static const struct expected_error helo_wrold[] = { { 0, 4, CORRECTIVE_ACTION_GET_SUGGESTIONS },
+                                                        { 5, 5, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    /* Windows has one suggestion for "wrold", Hunspell has "wold" as well */
+    static const struct expected_error helo_wrold_comprehensive[] =
+        { { 0, 4, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 5, 5, CORRECTIVE_ACTION_REPLACE, L"world", TRUE }, { 0 } };
