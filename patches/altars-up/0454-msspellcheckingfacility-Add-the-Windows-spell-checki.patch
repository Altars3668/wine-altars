+    BOOL supported = FALSE;
+    HRESULT hr;
+
+    CoInitializeEx( NULL, COINIT_MULTITHREADED );
+    hr = CoCreateInstance( &CLSID_SpellCheckerFactory, NULL, CLSCTX_INPROC_SERVER, &IID_ISpellCheckerFactory,
+                           (void **)&factory );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (FAILED(hr))
+    {
+        CoUninitialize();
+        return;
+    }
+    ISpellCheckerFactory_IsSupported( factory, L"en-US", &supported );
+    if (!supported)
+    {
+        skip( "no en-US dictionary\n" );
+        ISpellCheckerFactory_Release( factory );
+        CoUninitialize();
+        return;
+    }
+    test_factory( factory );
+    hr = ISpellCheckerFactory_CreateSpellChecker( factory, L"en-US", &checker );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    test_checker( checker );
+    save_lists();
+    test_word_lists( factory, checker );
+    restore_lists();
+    test_user_dictionaries( factory, checker );
+    ISpellChecker_Release( checker );
+    ISpellCheckerFactory_Release( factory );
+    CoUninitialize();
+}
diff --git a/dlls/msspellcheckingfacility/unixlib.c b/dlls/msspellcheckingfacility/unixlib.c
new file mode 100644
index 00000000000..24a5a6d086a
--- /dev/null
+++ b/dlls/msspellcheckingfacility/unixlib.c
@@ -0,0 +1,319 @@
+/*
+ * The host's spell checker: Hunspell and its dictionaries
+ *
+ * Copyright 2026 the Wine Altars project
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#if 0
+#pragma makedep unix
+#endif
+
+#include "config.h"
+
+#include <dirent.h>
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <unistd.h>
+
+#include "ntstatus.h"
+#include "unixlib.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(spell);
+
+/* Hunspell's C interface, which has been the same since 1.2 */
+typedef struct Hunhandle Hunhandle;
+static Hunhandle *(*pHunspell_create)( const char *aff, const char *dic );
+static void (*pHunspell_destroy)( Hunhandle *handle );
+static int (*pHunspell_spell)( Hunhandle *handle, const char *word );
+static char *(*pHunspell_get_dic_encoding)( Hunhandle *handle );
+static int (*pHunspell_suggest)( Hunhandle *handle, char ***list, const char *word );
+static void (*pHunspell_free_list)( Hunhandle *handle, char ***list, int count );
+static int (*pHunspell_add)( Hunhandle *handle, const char *word );
+static int (*pHunspell_remove)( Hunhandle *handle, const char *word );
+
+static pthread_once_t init_once = PTHREAD_ONCE_INIT;
+static void *libhunspell;
+
+static void load_hunspell(void)
+{
+    static const char *names[] =
+    {
+#ifdef __APPLE__
+        "libhunspell-1.7.0.dylib", "libhunspell-1.6.0.dylib", "libhunspell.dylib",
+#else
+        "libhunspell-1.7.so.0", "libhunspell-1.6.so.0", "libhunspell-1.5.so.0", "libhunspell.so",
+#endif
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(names) && !libhunspell; i++) libhunspell = dlopen( names[i], RTLD_NOW );
+    if (!libhunspell)
+    {
+        WARN( "no Hunspell library: there is no spell checker\n" );
+        return;
+    }
+#define LOAD(name) if (!(p##name = dlsym( libhunspell, #name ))) goto fail
+    LOAD(Hunspell_create);
+    LOAD(Hunspell_destroy);
+    LOAD(Hunspell_spell);
+    LOAD(Hunspell_get_dic_encoding);
+    LOAD(Hunspell_suggest);
+    LOAD(Hunspell_free_list);
+    LOAD(Hunspell_add);
+    LOAD(Hunspell_remove);
+#undef LOAD
+    return;
+fail:
+    WARN( "Hunspell has no %s\n", dlerror() );
+    dlclose( libhunspell );
+    libhunspell = NULL;
+}
+
+static BOOL hunspell_loaded(void)
+{
+    pthread_once( &init_once, load_hunspell );
+    return libhunspell != NULL;
+}
+
+/* where distributions put the dictionaries, after those DICPATH names, as hunspell itself looks */
+static const char *dictionary_dirs[] =
+{
+    "/usr/share/hunspell", "/usr/local/share/hunspell", "/usr/share/myspell", "/usr/share/myspell/dicts",
+    "/usr/local/share/myspell", "/opt/homebrew/share/hunspell", "/Library/Spelling",
+};
+
+/* a dictionary's name is a language, en, or a language and a region, en_US; hyphenation patterns and thesauri
+ * share the directory with other names */
+static BOOL is_dictionary_name( const char *name, size_t len )
+{
+    size_t i = 0;
+
+    while (i < len && name[i] >= 'a' && name[i] <= 'z') i++;
+    if (i < 2 || i > 3) return FALSE;
+    if (i == len) return TRUE;
+    if (name[i++] != '_' || len - i != 2) return FALSE;
+    for (; i < len; i++) if (name[i] < 'A' || name[i] > 'Z') return FALSE;
+    return TRUE;
+}
+
+/* call back for each directory to look in */
+static void for_each_dictionary_dir( void (*func)( const char *dir, void *context ), void *context )
+{
+    const char *dicpath = getenv( "DICPATH" );
+    unsigned int i;
+
+    if (dicpath)
+    {
+        char *copy = strdup( dicpath ), *dir, *next;
+
+        for (dir = copy; dir && *dir; dir = next)
+        {
+            if ((next = strchr( dir, ':' ))) *next++ = 0;
+            func( dir, context );
+        }
+        free( copy );
+    }
+    for (i = 0; i < ARRAY_SIZE(dictionary_dirs); i++) func( dictionary_dirs[i], context );
+}
+
+/* the path of a dictionary's file, if the directory has both of its files */
+static BOOL dictionary_files( const char *dir, const char *name, char *aff, char *dic, size_t size )
+{
+    struct stat st;
+
+    if ((size_t)snprintf( aff, size, "%s/%s.aff", dir, name ) >= size) return FALSE;
+    if ((size_t)snprintf( dic, size, "%s/%s.dic", dir, name ) >= size) return FALSE;
+    return !stat( aff, &st ) && S_ISREG( st.st_mode ) && !stat( dic, &st ) && S_ISREG( st.st_mode );
+}
+
+struct name_list
+{
+    char  *buffer;
+    UINT32 size;
+    UINT32 needed;
+};
+
+static BOOL list_has( const struct name_list *list, const char *name )
+{
+    const char *p = list->buffer;
+    UINT32 pos = 0;
+
+    while (pos < list->needed && pos < list->size && p[pos])
+    {
+        if (!strcmp( p + pos, name )) return TRUE;
+        pos += strlen( p + pos ) + 1;
+    }
+    return FALSE;
+}
+
+static void list_add( struct name_list *list, const char *name )
+{
+    size_t len = strlen( name ) + 1;
+
+    if (list->needed + len <= list->size) memcpy( list->buffer + list->needed, name, len );
+    list->needed += len;
+}
+
+static void add_dir_dictionaries( const char *dir, void *context )
+{
+    struct name_list *list = context;
+    char aff[4096], dic[4096], name[32];
+    struct dirent *de;
+    DIR *d;
+
+    if (!(d = opendir( dir ))) return;
+    while ((de = readdir( d )))
+    {
+        size_t len = strlen( de->d_name );
+
+        if (len < 5 || strcmp( de->d_name + len - 4, ".dic" )) continue;
+        len -= 4;
+        if (len >= sizeof(name) || !is_dictionary_name( de->d_name, len )) continue;
+        memcpy( name, de->d_name, len );
+        name[len] = 0;
+        if (list_has( list, name ) || !dictionary_files( dir, name, aff, dic, sizeof(aff) )) continue;
+        list_add( list, name );
+    }
+    closedir( d );
+}
+
+static NTSTATUS list_dictionaries( void *args )
+{
+    struct list_dictionaries_params *params = args;
+    struct name_list list = { (void *)(UINT_PTR)params->buffer, params->size, 0 };
+
+    if (hunspell_loaded()) for_each_dictionary_dir( add_dir_dictionaries, &list );
+    list_add( &list, "" );
+    params->needed = list.needed;
+    return list.needed <= list.size ? STATUS_SUCCESS : STATUS_BUFFER_TOO_SMALL;
+}
+
+struct find_dictionary
+{
+    const char *name;
+    Hunhandle  *handle;
+};
+
+static void open_dir_dictionary( const char *dir, void *context )
+{
+    struct find_dictionary *find = context;
+    char aff[4096], dic[4096];
+
+    if (find->handle || !dictionary_files( dir, find->name, aff, dic, sizeof(aff) )) return;
+    find->handle = pHunspell_create( aff, dic );
+    TRACE( "%s from %s: %p\n", find->name, dir, find->handle );
+}
+
+static NTSTATUS open_dictionary( void *args )
+{
+    struct open_dictionary_params *params = args;
+    struct find_dictionary find = { params->name, NULL };
+    const char *encoding;
+
+    params->handle = 0;
+    params->name[sizeof(params->name) - 1] = 0;
+    if (!hunspell_loaded() || !is_dictionary_name( params->name, strlen( params->name ) ))
+        return STATUS_NOT_FOUND;
+    for_each_dictionary_dir( open_dir_dictionary, &find );
+    if (!find.handle) return STATUS_NOT_FOUND;
+    params->handle = (UINT_PTR)find.handle;
+    encoding = pHunspell_get_dic_encoding( find.handle );
+    snprintf( params->encoding, sizeof(params->encoding), "%s", encoding ? encoding : "ISO8859-1" );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS close_dictionary( void *args )
+{
+    struct close_dictionary_params *params = args;
+
+    if (params->handle) pHunspell_destroy( (Hunhandle *)(UINT_PTR)params->handle );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS spell( void *args )
+{
+    struct spell_params *params = args;
+
+    params->correct = pHunspell_spell( (Hunhandle *)(UINT_PTR)params->handle, (void *)(UINT_PTR)params->word ) != 0;
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS suggest( void *args )
+{
+    struct suggest_params *params = args;
+    Hunhandle *handle = (Hunhandle *)(UINT_PTR)params->handle;
+    struct name_list list = { (void *)(UINT_PTR)params->buffer, params->size, 0 };
+    char **words = NULL;
+    int i, count;
+
+    count = pHunspell_suggest( handle, &words, (void *)(UINT_PTR)params->word );
+    for (i = 0; i < count; i++) list_add( &list, words[i] );
+    if (words) pHunspell_free_list( handle, &words, count );
+    list_add( &list, "" );
+    params->needed = list.needed;
+    return list.needed <= list.size ? STATUS_SUCCESS : STATUS_BUFFER_TOO_SMALL;
+}
+
+static NTSTATUS add_word( void *args )
+{
+    struct word_params *params = args;
+
+    pHunspell_add( (Hunhandle *)(UINT_PTR)params->handle, (void *)(UINT_PTR)params->word );
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS remove_word( void *args )
+{
+    struct word_params *params = args;
+
+    pHunspell_remove( (Hunhandle *)(UINT_PTR)params->handle, (void *)(UINT_PTR)params->word );
+    return STATUS_SUCCESS;
+}
+
+const unixlib_entry_t __wine_unix_call_funcs[] =
+{
+    list_dictionaries,
+    open_dictionary,
+    close_dictionary,
+    spell,
+    suggest,
+    add_word,
+    remove_word,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_funcs) == unix_funcs_count );
+
+#ifdef _WIN64
+
+const unixlib_entry_t __wine_unix_call_wow64_funcs[] =
+{
+    list_dictionaries,
+    open_dictionary,
+    close_dictionary,
+    spell,
+    suggest,
+    add_word,
+    remove_word,
+};
+
+C_ASSERT( ARRAYSIZE(__wine_unix_call_wow64_funcs) == unix_funcs_count );
+
+#endif /* _WIN64 */
