+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdlib.h>
+
+#include "private.h"
+#include "winreg.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(spell);
+
+/* Where Windows keeps them, in %APPDATA%\Microsoft\Spelling: the words added, in neutral\default.dic for every
+ * language, and for each language the words taken out, <language>\default.exc, and the words corrected,
+ * <language>\default.acl, a "word|correction" line each.  UTF-16 with a byte order mark, a word to a line.  Other
+ * programs, and other processes, change them as well: a list is read again when its file has changed, and is
+ * changed by reading it, changing it and writing it while holding a mutex every process shares. */
+
+struct word_list
+{
+    WCHAR       *path;
+    FILETIME     time;          /* the file's when it was read */
+    BOOL         loaded;
+    BOOL         autocorrect;   /* "word|correction" lines */
+    WCHAR      **words;
+    WCHAR      **corrections;
+    unsigned int count;
+    unsigned int capacity;
+};
+
+struct language_lists
+{
+    struct list      entry;
+    WCHAR            tag[32];
+    struct word_list exclude;
+    struct word_list autocorrect;
+};
+
+enum dictionary_type
+{
+    DICTIONARY_ADD,
+    DICTIONARY_EXCLUDE,
+    DICTIONARY_AUTOCORRECT,
+};
+
+/* a user dictionary a program registered for a language, or for every language with no language at all, as
+ * Office registers its own custom dictionary each time it starts */
+struct user_dictionary
+{
+    struct list          entry;
+    WCHAR                tag[32];
+    enum dictionary_type type;
+    struct word_list     words;
+};
+
+static struct word_list added;
+static struct list language_lists = LIST_INIT( language_lists );
+static struct list user_dictionaries = LIST_INIT( user_dictionaries );
+static BOOL user_dictionaries_loaded;
+
+static CRITICAL_SECTION lists_cs;
+static CRITICAL_SECTION_DEBUG lists_cs_debug =
+{
+    0, 0, &lists_cs,
+    { &lists_cs_debug.ProcessLocksList, &lists_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": lists_cs") }
+};
+static CRITICAL_SECTION lists_cs = { &lists_cs_debug, -1, 0, 0, 0, 0 };
+
+static const WCHAR user_dictionaries_key[] = L"Software\\Microsoft\\Spelling\\Dictionaries";
+
+/* %APPDATA%\Microsoft\Spelling\<dir>\default.<ext> */
+static WCHAR *list_path( const WCHAR *dir, const WCHAR *ext )
+{
+    WCHAR appdata[MAX_PATH], *path;
+    DWORD len;
+
+    if (!(len = GetEnvironmentVariableW( L"APPDATA", appdata, ARRAY_SIZE(appdata) )) || len >= ARRAY_SIZE(appdata))
+        return NULL;
+    len = len + wcslen( dir ) + 40;
+    if ((path = malloc( len * sizeof(WCHAR) )))
+        swprintf( path, len, L"%s\\Microsoft\\Spelling\\%s\\default.%s", appdata, dir, ext );
+    return path;
+}
+
+static void clear_list( struct word_list *list )
+{
+    unsigned int i;
+
+    for (i = 0; i < list->count; i++)
+    {
+        free( list->words[i] );
+        if (list->corrections) free( list->corrections[i] );
+    }
+    list->count = 0;
+}
+
+static BOOL append_word( struct word_list *list, const WCHAR *word, unsigned int len, const WCHAR *correction )
+{
+    WCHAR *copy, *copy2 = NULL;
+
+    if (list->count == list->capacity)
+    {
+        unsigned int capacity = max( 16, list->capacity * 2 );
+        WCHAR **words, **corrections = NULL;
+
+        if (!(words = realloc( list->words, capacity * sizeof(*words) ))) return FALSE;
+        list->words = words;
+        if (list->autocorrect)
+        {
+            if (!(corrections = realloc( list->corrections, capacity * sizeof(*corrections) ))) return FALSE;
+            list->corrections = corrections;
+        }
+        list->capacity = capacity;
+    }
+    if (!(copy = malloc( (len + 1) * sizeof(WCHAR) ))) return FALSE;
+    memcpy( copy, word, len * sizeof(WCHAR) );
+    copy[len] = 0;
+    if (list->autocorrect && !(copy2 = strdupW( correction )))
+    {
+        free( copy );
+        return FALSE;
+    }
+    list->words[list->count] = copy;
+    if (list->autocorrect) list->corrections[list->count] = copy2;
+    list->count++;
+    return TRUE;
+}
+
+static void remove_entry( struct word_list *list, unsigned int i )
+{
+    free( list->words[i] );
+    if (list->autocorrect) free( list->corrections[i] );
+    list->count--;
+    memmove( list->words + i, list->words + i + 1, (list->count - i) * sizeof(*list->words) );
+    if (list->autocorrect)
+        memmove( list->corrections + i, list->corrections + i + 1, (list->count - i) * sizeof(*list->corrections) );
+}
+
+/* the file's text: UTF-16 with or without its byte order mark, or UTF-8 with one */
+static WCHAR *read_text( const WCHAR *path, FILETIME *time )
+{
+    WIN32_FILE_ATTRIBUTE_DATA info;
+    DWORD size, read;
+    HANDLE file;
+    BYTE *data;
+    WCHAR *text = NULL;
+    int len;
+
+    if (!GetFileAttributesExW( path, GetFileExInfoStandard, &info )) return NULL;
+    *time = info.ftLastWriteTime;
+    file = CreateFileW( path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return NULL;
+    size = GetFileSize( file, NULL );
+    if (size != INVALID_FILE_SIZE && (data = malloc( size + 2 )))
+    {
+        if (ReadFile( file, data, size, &read, NULL ))
+        {
+            data[read] = data[read + 1] = 0;
+            if (read >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf)
+            {
+                len = MultiByteToWideChar( CP_UTF8, 0, (char *)data + 3, read - 3, NULL, 0 );
+                if ((text = malloc( (len + 1) * sizeof(WCHAR) )))
+                {
+                    MultiByteToWideChar( CP_UTF8, 0, (char *)data + 3, read - 3, text, len );
+                    text[len] = 0;
+                }
+                free( data );
+            }
+            else if (read >= 2 && data[0] == 0xff && data[1] == 0xfe)
+            {
+                memmove( data, data + 2, read );
+                text = (WCHAR *)data;
+            }
+            else text = (WCHAR *)data;
+        }
+        else free( data );
+    }
+    CloseHandle( file );
+    return text;
+}
+
+static void load_list( struct word_list *list )
+{
+    WCHAR *text, *line, *end, *bar;
+    FILETIME time = { 0 };
+
+    clear_list( list );
+    list->loaded = TRUE;
+    list->time = time;
+    if (!list->path || !(text = read_text( list->path, &list->time ))) return;
+    for (line = text; *line; line = end)
+    {
+        for (end = line; *end && *end != '\n'; end++) ;
+        if (*end) *end++ = 0;
+        if (*line && line[wcslen( line ) - 1] == '\r') line[wcslen( line ) - 1] = 0;
+        if (!*line) continue;
+        if (list->autocorrect)
+        {
+            if (!(bar = wcschr( line, '|' )) || bar == line || !bar[1]) continue;
+            *bar = 0;
+            append_word( list, line, bar - line, bar + 1 );
+        }
+        else append_word( list, line, wcslen( line ), NULL );
+    }
+    free( text );
+}
+
+/* read the list again if its file changed */
+static void refresh_list( struct word_list *list )
+{
+    WIN32_FILE_ATTRIBUTE_DATA info;
+    FILETIME none = { 0 };
+
+    if (!list->path) return;
+    if (!GetFileAttributesExW( list->path, GetFileExInfoStandard, &info )) info.ftLastWriteTime = none;
+    if (list->loaded && !CompareFileTime( &info.ftLastWriteTime, &list->time )) return;
+    TRACE( "reading %s\n", debugstr_w(list->path) );
+    load_list( list );
+}
+
+static BOOL create_dirs( const WCHAR *path )
+{
+    WCHAR *copy = strdupW( path ), *p;
+    BOOL ret = TRUE;
+
+    if (!copy) return FALSE;
+    for (p = copy + 3; (p = wcschr( p, '\\' )); p++)
+    {
+        *p = 0;
+        if (!CreateDirectoryW( copy, NULL ) && GetLastError() != ERROR_ALREADY_EXISTS) ret = FALSE;
+        *p = '\\';
+    }
+    free( copy );
+    return ret;
+}
+
+static HRESULT write_list( struct word_list *list )
+{
+    static const WCHAR bom = 0xfeff;
+    WIN32_FILE_ATTRIBUTE_DATA info;
+    unsigned int i;
+    DWORD written;
+    HANDLE file;
+    BOOL ret;
+
+    if (!list->path) return S_OK;
+    create_dirs( list->path );
+    file = CreateFileW( list->path, GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, CREATE_ALWAYS, 0, NULL );
+    if (file == INVALID_HANDLE_VALUE) return HRESULT_FROM_WIN32( GetLastError() );
+    ret = WriteFile( file, &bom, sizeof(bom), &written, NULL );
+    for (i = 0; ret && i < list->count; i++)
+    {
+        ret = WriteFile( file, list->words[i], wcslen( list->words[i] ) * sizeof(WCHAR), &written, NULL );
+        if (ret && list->autocorrect)
+        {
+            ret = WriteFile( file, L"|", sizeof(WCHAR), &written, NULL ) &&
+                  WriteFile( file, list->corrections[i], wcslen( list->corrections[i] ) * sizeof(WCHAR),
+                             &written, NULL );
+        }
+        if (ret) ret = WriteFile( file, L"\r\n", 2 * sizeof(WCHAR), &written, NULL );
+    }
+    CloseHandle( file );
+    if (!ret) return HRESULT_FROM_WIN32( GetLastError() );
+    if (GetFileAttributesExW( list->path, GetFileExInfoStandard, &info )) list->time = info.ftLastWriteTime;
+    return S_OK;
+}
+
+static int find_word( const struct word_list *list, const WCHAR *word, unsigned int len, BOOL match_case )
+{
+    unsigned int i;
+
+    for (i = 0; i < list->count; i++)
+    {
+        if (wcslen( list->words[i] ) != len) continue;
+        if (match_case ? !wcsncmp( list->words[i], word, len ) : !wcsnicmp( list->words[i], word, len ))
+            return i;
+    }
+    return -1;
+}
+
+/* the lists of a language; in lists_cs */
+static struct language_lists *get_language_lists( const struct language *language )
+{
+    struct language_lists *lists;
+
+    LIST_FOR_EACH_ENTRY( lists, &language_lists, struct language_lists, entry )
+        if (!wcscmp( lists->tag, language->tag )) return lists;
+    if (!(lists = calloc( 1, sizeof(*lists) ))) return NULL;
+    lstrcpynW( lists->tag, language->tag, ARRAY_SIZE(lists->tag) );
+    lists->exclude.path = list_path( language->tag, L"exc" );
+    lists->autocorrect.path = list_path( language->tag, L"acl" );
+    lists->autocorrect.autocorrect = TRUE;
+    list_add_tail( &language_lists, &lists->entry );
+    return lists;
+}
+
+static enum dictionary_type dictionary_type( const WCHAR *path )
+{
+    const WCHAR *ext = wcsrchr( path, '.' );
+
+    if (ext && !wcsicmp( ext, L".dic" )) return DICTIONARY_ADD;
+    if (ext && !wcsicmp( ext, L".exc" )) return DICTIONARY_EXCLUDE;
+    if (ext && !wcsicmp( ext, L".acl" )) return DICTIONARY_AUTOCORRECT;
+    return -1;
+}
+
+static struct user_dictionary *add_user_dictionary( const WCHAR *path, const WCHAR *tag )
+{
+    struct user_dictionary *dict;
+
+    if (!(dict = calloc( 1, sizeof(*dict) ))) return NULL;
+    if (!(dict->words.path = strdupW( path )))
+    {
+        free( dict );
+        return NULL;
+    }
+    lstrcpynW( dict->tag, tag, ARRAY_SIZE(dict->tag) );
+    dict->type = dictionary_type( path );
+    dict->words.autocorrect = dict->type == DICTIONARY_AUTOCORRECT;
+    list_add_tail( &user_dictionaries, &dict->entry );
+    return dict;
+}
+
+static void free_user_dictionary( struct user_dictionary *dict )
+{
+    list_remove( &dict->entry );
+    clear_list( &dict->words );
+    free( dict->words.words );
+    free( dict->words.corrections );
+    free( dict->words.path );
+    free( dict );
+}
+
+/* The dictionaries registered before, which stay until they are unregistered: as Windows keeps them, a value for
+ * each language, the paths of its dictionaries one after the other.  Those for every language are not kept, as
+ * Windows does not keep them.  In lists_cs. */
+static void load_user_dictionaries(void)
+{
+    WCHAR tag[64], *data, *path;
+    DWORD i, tag_len, size, type;
+    HKEY key;
+
+    if (user_dictionaries_loaded) return;
+    user_dictionaries_loaded = TRUE;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, user_dictionaries_key, 0, KEY_READ, &key )) return;
+    for (i = 0; ; i++)
+    {
+        tag_len = ARRAY_SIZE(tag);
+        if (RegEnumValueW( key, i, tag, &tag_len, NULL, &type, NULL, &size ) == ERROR_NO_MORE_ITEMS) break;
+        if (type != REG_MULTI_SZ || !*tag || !(data = malloc( size + 2 * sizeof(WCHAR) ))) continue;
+        tag_len = ARRAY_SIZE(tag);
+        if (!RegEnumValueW( key, i, tag, &tag_len, NULL, NULL, (BYTE *)data, &size ))
+        {
+            data[size / sizeof(WCHAR)] = data[size / sizeof(WCHAR) + 1] = 0;
+            for (path = data; *path; path += wcslen( path ) + 1) add_user_dictionary( path, tag );
+        }
+        free( data );
+    }
+    RegCloseKey( key );
+}
+
+/* write the dictionaries of a language; in lists_cs */
+static void save_user_dictionaries( const WCHAR *tag )
+{
+    struct user_dictionary *dict;
+    WCHAR *data, *p;
+    size_t size = 1;
+    HKEY key;
+
+    if (!*tag) return;
+    LIST_FOR_EACH_ENTRY( dict, &user_dictionaries, struct user_dictionary, entry )
+        if (!wcsicmp( dict->tag, tag )) size += wcslen( dict->words.path ) + 1;
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, user_dictionaries_key, 0, NULL, 0, KEY_WRITE, NULL, &key, NULL ))
+        return;
+    if (size == 1) RegDeleteValueW( key, tag );
+    else if ((data = malloc( size * sizeof(WCHAR) )))
+    {
+        p = data;
+        LIST_FOR_EACH_ENTRY( dict, &user_dictionaries, struct user_dictionary, entry )
+        {
+            if (wcsicmp( dict->tag, tag )) continue;
+            wcscpy( p, dict->words.path );
+            p += wcslen( p ) + 1;
+        }
+        *p = 0;
+        RegSetValueExW( key, tag, 0, REG_MULTI_SZ, (BYTE *)data, size * sizeof(WCHAR) );
+        free( data );
+    }
+    RegCloseKey( key );
+}
+
+/* whether a dictionary is for a language: those registered for none are for every one */
+static BOOL is_dictionary_for( const struct user_dictionary *dict, const WCHAR *tag )
+{
+    return !tag || !dict->tag[0] || !wcsicmp( dict->tag, tag );
+}
+
+void refresh_lists( const struct language *language )
+{
+    struct language_lists *lists;
+    struct user_dictionary *dict;
+
+    EnterCriticalSection( &lists_cs );
+    if (!added.path) added.path = list_path( L"neutral", L"dic" );
+    refresh_list( &added );
+    if ((lists = get_language_lists( language )))
+    {
+        refresh_list( &lists->exclude );
+        refresh_list( &lists->autocorrect );
+    }
+    load_user_dictionaries();
+    LIST_FOR_EACH_ENTRY( dict, &user_dictionaries, struct user_dictionary, entry )
+        if (is_dictionary_for( dict, language->tag )) refresh_list( &dict->words );
+    LeaveCriticalSection( &lists_cs );
+}
+
+/* the lists are case-insensitive, as a word that starts a sentence is the same word */
+static BOOL in_user_dictionaries( const WCHAR *tag, enum dictionary_type type, const WCHAR *word, unsigned int len )
+{
+    struct user_dictionary *dict;
+
+    LIST_FOR_EACH_ENTRY( dict, &user_dictionaries, struct user_dictionary, entry )
+        if (dict->type == type && is_dictionary_for( dict, tag ) && find_word( &dict->words, word, len, FALSE ) >= 0)
+            return TRUE;
+    return FALSE;
+}
+
+BOOL is_word_added( const struct language *language, const WCHAR *word, unsigned int len )
+{
+    BOOL ret;
+
+    EnterCriticalSection( &lists_cs );
+    ret = find_word( &added, word, len, FALSE ) >= 0 ||
+          in_user_dictionaries( language->tag, DICTIONARY_ADD, word, len );
+    LeaveCriticalSection( &lists_cs );
+    return ret;
+}
+
+BOOL is_word_excluded( const struct language *language, const WCHAR *word, unsigned int len )
+{
+    struct language_lists *lists;
+    BOOL ret = FALSE;
+
+    EnterCriticalSection( &lists_cs );
+    if ((lists = get_language_lists( language ))) ret = find_word( &lists->exclude, word, len, FALSE ) >= 0;
+    if (!ret) ret = in_user_dictionaries( language->tag, DICTIONARY_EXCLUDE, word, len );
+    LeaveCriticalSection( &lists_cs );
+    return ret;
+}
+
+/* a correction is for the word as it is written; a copy, to be freed */
+WCHAR *find_autocorrect( const struct language *language, const WCHAR *word, unsigned int len )
+{
+    struct language_lists *lists;
+    struct user_dictionary *dict;
+    const WCHAR *found = NULL;
+    WCHAR *ret = NULL;
+    int i;
+
+    EnterCriticalSection( &lists_cs );
+    if ((lists = get_language_lists( language )) && (i = find_word( &lists->autocorrect, word, len, TRUE )) >= 0)
+        found = lists->autocorrect.corrections[i];
+    LIST_FOR_EACH_ENTRY( dict, &user_dictionaries, struct user_dictionary, entry )
+    {
+        if (found) break;
+        if (dict->type != DICTIONARY_AUTOCORRECT || !is_dictionary_for( dict, language->tag )) continue;
+        if ((i = find_word( &dict->words, word, len, TRUE )) >= 0) found = dict->words.corrections[i];
+    }
+    if (found) ret = strdupW( found );
+    LeaveCriticalSection( &lists_cs );
+    return ret;
+}
+
+/* the words added that are close to one, for suggestions; to be freed */
+unsigned int added_words( WCHAR ***words )
+{
+    unsigned int i, count = 0;
+    WCHAR **ret;
+
+    *words = NULL;
+    EnterCriticalSection( &lists_cs );
+    if (added.count && (ret = calloc( added.count, sizeof(*ret) )))
+    {
+        for (i = 0; i < added.count; i++) if ((ret[count] = strdupW( added.words[i] ))) count++;
+        *words = ret;
+    }
+    LeaveCriticalSection( &lists_cs );
+    return count;
+}
+
+/* changes are made under a mutex every process shares, to the lists as they are on disk */
+static HANDLE lock_lists(void)
+{
+    HANDLE mutex = CreateMutexW( NULL, FALSE, L"Local\\WineSpellingLists" );
+
+    if (mutex) WaitForSingleObject( mutex, INFINITE );
+    EnterCriticalSection( &lists_cs );
+    return mutex;
+}
+
+static void unlock_lists( HANDLE mutex )
+{
+    LeaveCriticalSection( &lists_cs );
+    if (mutex)
+    {
+        ReleaseMutex( mutex );
+        CloseHandle( mutex );
+    }
+}
+
+/* a word added is the user's in every language, and is no longer taken out of this one */
+HRESULT add_word( const struct language *language, const WCHAR *word )
+{
+    struct language_lists *lists;
+    unsigned int len = wcslen( word );
+    HRESULT hr = S_OK;
+    HANDLE mutex;
+    int i;
+
+    mutex = lock_lists();
+    if (!added.path) added.path = list_path( L"neutral", L"dic" );
+    load_list( &added );
+    if (find_word( &added, word, len, TRUE ) < 0)
+    {
+        if (!append_word( &added, word, len, NULL )) hr = E_OUTOFMEMORY;
+        else hr = write_list( &added );
+    }
+    if (SUCCEEDED(hr) && (lists = get_language_lists( language )))
+    {
+        load_list( &lists->exclude );
+        if ((i = find_word( &lists->exclude, word, len, FALSE )) >= 0)
+        {
+            remove_entry( &lists->exclude, i );
+            hr = write_list( &lists->exclude );
+        }
+    }
+    unlock_lists( mutex );
+    notify_checkers( NULL );
+    return hr;
+}
+
+/* a word removed is taken out of the language, even one of its dictionary */
+HRESULT remove_word( const struct language *language, const WCHAR *word )
+{
+    struct language_lists *lists;
+    unsigned int len = wcslen( word );
+    HRESULT hr = S_OK;
+    HANDLE mutex;
+    int i;
+
+    mutex = lock_lists();
+    if (!added.path) added.path = list_path( L"neutral", L"dic" );
+    load_list( &added );
+    if ((i = find_word( &added, word, len, FALSE )) >= 0)
+    {
+        remove_entry( &added, i );
+        hr = write_list( &added );
+    }
+    if (SUCCEEDED(hr) && (lists = get_language_lists( language )))
+    {
+        load_list( &lists->exclude );
+        if (find_word( &lists->exclude, word, len, FALSE ) < 0)
+        {
+            if (!append_word( &lists->exclude, word, len, NULL )) hr = E_OUTOFMEMORY;
+            else hr = write_list( &lists->exclude );
+        }
+    }
+    unlock_lists( mutex );
+    /* as Windows, once for each list */
+    notify_checkers( NULL );
+    notify_checkers( NULL );
+    return hr;
+}
+
+HRESULT add_autocorrect( const struct language *language, const WCHAR *from, const WCHAR *to )
+{
+    struct language_lists *lists;
+    unsigned int len = wcslen( from );
+    HRESULT hr = E_OUTOFMEMORY;
+    WCHAR *copy;
+    HANDLE mutex;
+    int i;
+
+    mutex = lock_lists();
+    if ((lists = get_language_lists( language )))
+    {
+        load_list( &lists->autocorrect );
+        if ((i = find_word( &lists->autocorrect, from, len, TRUE )) >= 0)
+        {
+            if ((copy = strdupW( to )))
+            {
+                free( lists->autocorrect.corrections[i] );
+                lists->autocorrect.corrections[i] = copy;
+                hr = write_list( &lists->autocorrect );
+            }
+        }
+        else if (append_word( &lists->autocorrect, from, len, to )) hr = write_list( &lists->autocorrect );
+    }
+    unlock_lists( mutex );
+    /* Windows tells twice of a correction as well */
+    notify_checkers( language );
+    notify_checkers( language );
+    return hr;
+}
+
+HRESULT register_user_dictionary( const WCHAR *path, const WCHAR *tag )
+{
+    struct user_dictionary *dict;
+    DWORD attrs;
+    HRESULT hr = S_OK;
+
+    if (!*path || dictionary_type( path ) == -1) return E_INVALIDARG;
+    attrs = GetFileAttributesW( path );
+    if (attrs == INVALID_FILE_ATTRIBUTES || (attrs & FILE_ATTRIBUTE_DIRECTORY)) return E_INVALIDARG;
+
+    EnterCriticalSection( &lists_cs );
+    load_user_dictionaries();
+    LIST_FOR_EACH_ENTRY( dict, &user_dictionaries, struct user_dictionary, entry )
+        if (!wcsicmp( dict->words.path, path ) && !wcsicmp( dict->tag, tag )) hr = S_FALSE;
+    if (hr == S_OK)
+    {
+        if (!add_user_dictionary( path, tag )) hr = E_OUTOFMEMORY;
+        else save_user_dictionaries( tag );
+    }
+    LeaveCriticalSection( &lists_cs );
+    if (hr == S_OK) notify_checkers( NULL );
+    return hr;
+}
+
+HRESULT unregister_user_dictionary( const WCHAR *path, const WCHAR *tag )
+{
+    struct user_dictionary *dict, *next;
+    HRESULT hr = S_FALSE;
+
+    if (!*path) return E_INVALIDARG;
+
+    EnterCriticalSection( &lists_cs );
+    load_user_dictionaries();
+    LIST_FOR_EACH_ENTRY_SAFE( dict, next, &user_dictionaries, struct user_dictionary, entry )
+    {
+        if (wcsicmp( dict->words.path, path ) || wcsicmp( dict->tag, tag )) continue;
+        free_user_dictionary( dict );
+        hr = S_OK;
+    }
+    if (hr == S_OK) save_user_dictionaries( tag );
+    LeaveCriticalSection( &lists_cs );
+    if (hr == S_OK) notify_checkers( NULL );
+    return hr;
+}
diff --git a/dlls/msspellcheckingfacility/main.c b/dlls/msspellcheckingfacility/main.c
new file mode 100644
index 00000000000..35b9d27d628
--- /dev/null
+++ b/dlls/msspellcheckingfacility/main.c
@@ -0,0 +1,605 @@
+/*
+ * The Windows spell checking API, with the host's dictionaries
+ *
+ * Copyright 2026 the Wine Altars project
+ *
