+    static const struct expected_error in_brackets[] = { { 1, 5, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    static const struct expected_error chinese[] = { { 0, 2, CORRECTIVE_ACTION_GET_SUGGESTIONS },
+                                                     { 3, 5, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    static const struct
+    {
+        const WCHAR *text;
+        const struct expected_error *errors;
+    }
+    tests[] =
+    {
+        { L"hello world", none },
+        { L"helo wrold", helo_wrold },
+        { L"the the cat", the_the_cat },
+        { L"Hello, world. hello", none },
+        { L"dont don't", dont },
+        { L"e-mail", none },
+        { L"1234 abc123 3rd", none },
+        { L"IBM WORLD Wrold", capitals },
+        { L"http://example.com/foo user@example.com", none },
+        { L"   ", none },
+        { L"Hello\nworld", none },
+        { L"x a I i", i_i },
+        { L"Mr. Smith U.S.A. OK", none },
+        { L"it's its", none },
+        { L"HELLO wORLD", world_caps },
+        { L"a a", a_a },
+        { L"The the", the_the },
+        { L"the, the", none },
+        { L"the  the", the_2_the },
+        { L"the\nthe", none },
+        { L"hello hello hello", hello3 },
+        { L"Wrold's", wrolds },
+        { L"helo-world", helo_world },
+        { L"(wrold)", in_brackets },
+        { L"\x4f60\x597d wrold", chinese },
+    };
+    IOptionDescription *description;
+    IEnumSpellingError *errors;
+    IEnumString *strings;
+    unsigned int i, count;
+    WCHAR *str;
+    BYTE value;
+    HRESULT hr;
+
+    hr = ISpellChecker_get_Id( checker, &str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( str, L"MsSpell" ), "got %s\n", debugstr_w(str) );
+    CoTaskMemFree( str );
+    hr = ISpellChecker_get_LocalizedName( checker, &str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( str && *str, "got %s\n", debugstr_w(str) );
+    CoTaskMemFree( str );
+
+    hr = ISpellChecker_get_OptionIds( checker, &strings );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IEnumString_Next( strings, 1, &str, NULL );
