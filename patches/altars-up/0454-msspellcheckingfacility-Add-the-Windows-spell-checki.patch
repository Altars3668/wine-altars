+    ok( has_suggestion( checker, L"helo", L"hello", &count ), "no hello\n" );
+    ok( count > 1 && count <= 10, "got %u\n", count );
+    ok( has_suggestion( checker, L"Helo", L"Hello", &count ), "no Hello\n" );
+    ok( has_suggestion( checker, L"teh", L"the", &count ), "no the\n" );
+}
