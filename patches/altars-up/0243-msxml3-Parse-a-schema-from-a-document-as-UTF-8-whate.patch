From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 03:10:16 -0400
Subject: [PATCH] msxml3: Parse a schema from a document as UTF-8 whatever its
 declaration says.

A schema added to a cache from a document is serialized and parsed again
by libxml2.  The text is UTF-8 by then, but a document loaded from UTF-16
keeps encoding="utf-16" in its declaration, which libxml2 followed, so it
failed to parse the text and add() answered E_INVALIDARG.

Office's App-V runtime loads its deployment configuration schema, an
embedded UTF-16 resource, with loadXML() and adds it to a schema cache
before it lets a process into the package's virtual environment; every
Office application stopped as its App-V subsystem failed to initialize.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/schema.c b/dlls/msxml3/schema.c
index bceb8d097a9..1427f213f3b 100644
--- a/dlls/msxml3/schema.c
+++ b/dlls/msxml3/schema.c
@@ -921,7 +921,9 @@ static xmlDocPtr create_xmldoc_for_text(BSTR xml)
     xmlChar *str = xmlchar_from_wchar(xml);
     xmlDocPtr doc;
 
-    doc = xmlParseMemory((const char *)str, xmlStrlen(str));
+    /* the text is UTF-8 now, whatever encoding its declaration names: a document loaded from UTF-16 keeps
+     * encoding="utf-16" in it */
+    doc = xmlReadMemory((const char *)str, xmlStrlen(str), NULL, "UTF-8", 0);
     free(str);
     return doc;
 }
diff --git a/dlls/msxml3/tests/schema.c b/dlls/msxml3/tests/schema.c
index 50e5a743b82..2ab5689468d 100644
--- a/dlls/msxml3/tests/schema.c
+++ b/dlls/msxml3/tests/schema.c
@@ -929,6 +929,48 @@ static void test_length(void)
     free_bstrs();
 }
 
+/* not in msxml2.h */
+static const CLSID CLSID_XMLSchemaCache60 = {0x88d96a07,0xf192,0x11d4,{0xa6,0x5f,0x00,0x40,0x96,0x32,0x51,0xe5}};
+
+static void test_encoding_declaration(void)
+{
+    static const WCHAR xsd[] =
+        L"<?xml version=\"1.0\" encoding=\"utf-16\" ?>\r\n"
+        L"<xs:schema xmlns:xs=\"http://www.w3.org/2001/XMLSchema\" targetNamespace=\"urn:wine-test\">"
+        L"<xs:element name=\"a\" type=\"xs:string\"/></xs:schema>";
+    IXMLDOMSchemaCollection *cache;
+    IXMLDOMDocument2 *schema;
+    VARIANT_BOOL b;
+    LONG length;
+    HRESULT hr;
+
+    schema = create_document_version(60, &IID_IXMLDOMDocument2);
+    cache = create_cache_version(60, &IID_IXMLDOMSchemaCollection);
+    if (!schema || !cache)
+    {
+        if (schema) IXMLDOMDocument2_Release(schema);
+        if (cache) IXMLDOMSchemaCollection_Release(cache);
+        return;
+    }
+
+    /* a schema whose declaration names the encoding of the text it was loaded from */
+    hr = IXMLDOMDocument2_loadXML(schema, _bstr_(xsd), &b);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(b == VARIANT_TRUE, "failed to load XML\n");
+
+    hr = IXMLDOMSchemaCollection_add(cache, _bstr_(L"urn:wine-test"), _variantdoc_(schema));
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    length = -1;
+    hr = IXMLDOMSchemaCollection_get_length(cache, &length);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(length == 1, "Unexpected length %ld.\n", length);
+
+    IXMLDOMDocument2_Release(schema);
+    IXMLDOMSchemaCollection_Release(cache);
+    free_bstrs();
+}
+
 static void test_collection_content(void)
 {
     IXMLDOMDocument2 *schema1, *schema2, *schema3;
@@ -1543,6 +1585,7 @@ START_TEST(schema)
     test_schema_refs();
     test_collection_refs();
     test_length();
+    test_encoding_declaration();
     test_collection_content();
     test_XDR_schemas();
     test_XDR_datatypes();
