    [67] Reference ::= EntityRef | CharRef
    [68] EntityRef ::= '&' Name ';' */
+static HRESULT saxreader_load_external_entity(struct saxlocator *locator, struct entity_decl *entity)
+{
+    IStream *stream;
+    BYTE *data = NULL, chunk[4096];
+    ULONG read, length = 0;
+    HRESULT hr;
+    UINT codepage = CP_UTF8;
+    BSTR value;
+    int count;
+
+    if (FAILED(hr = URLOpenBlockingStreamW(NULL, entity->sysid, &stream, 0, NULL))) return hr;
+    do
+    {
+        BYTE *buffer;
+        hr = IStream_Read(stream, chunk, sizeof(chunk), &read);
+        if (FAILED(hr)) break;
+        if (read >= ~0u - length || !(buffer = realloc(data, (size_t)length + read + 1)))
+        {
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        data = buffer;
+        memcpy(data + length, chunk, read);
+        length += read;
+        data[length] = 0;
+    } while (read);
+    IStream_Release(stream);
+    if (FAILED(hr)) { free(data); return hr; }
+    if (length >= 2 && ((data[0] == 0xff && data[1] == 0xfe) || (data[0] == 0xfe && data[1] == 0xff)))
+    {
+        unsigned int i;
+
+        if (length & 1) { free(data); return E_SAX_INVALIDENCODING; }
+        value = SysAllocStringLen(NULL, (length - 2) / 2);
+        if (value)
+            for (i = 0; i < (length - 2) / 2; ++i)
+                value[i] = data[0] == 0xff ? data[2 + i * 2] | data[3 + i * 2] << 8 :
+                                           data[2 + i * 2] << 8 | data[3 + i * 2];
+    }
+    else
+    {
+        const char *text = (const char *)data;
+        ULONG skip = length >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf ? 3 : 0;
+
+        text += skip;
+        length -= skip;
+        if (length >= 5 && !memcmp(text, "<?xml", 5))
+        {
+            const char *end = strstr(text, "?>"), *encoding = strstr(text, "encoding");
+            if (end && encoding && encoding < end)
+            {
+                const char *p = strchr(encoding, '=');
+                if (p && p < end)
+                {
+                    WCHAR name[64];
+                    unsigned int i = 0;
+                    char quote;
+                    p++;
+                    while (p < end && (*p == ' ' || *p == '\t')) p++;
+                    quote = *p++;
+                    if (quote == '\'' || quote == '"')
+                    {
+                        while (p < end && *p != quote && i < ARRAY_SIZE(name) - 1) name[i++] = *p++;
+                        name[i] = 0;
+                        codepage = get_codepage_for_encoding(name);
+                    }
+                }
+            }
+        }
+        count = codepage ? MultiByteToWideChar(codepage, codepage == CP_UTF8 ? MB_ERR_INVALID_CHARS : 0,
+                text, length, NULL, 0) : 0;
+        value = SysAllocStringLen(NULL, count);
+        if (value && count) MultiByteToWideChar(codepage, codepage == CP_UTF8 ? MB_ERR_INVALID_CHARS : 0,
+                text, length, value, count);
+        if (length && !count) { SysFreeString(value); value = NULL; hr = E_SAX_INVALIDENCODING; }
+    }
+    free(data);
+    if (!value) return FAILED(hr) ? hr : E_OUTOFMEMORY;
+    if (!wcsncmp(value, L"<?xml", 5))
+    {
+        WCHAR *end = wcsstr(value, L"?>");
+        if (end)
+        {
+            BSTR text = SysAllocString(end + 2);
+            SysFreeString(value);
+            value = text;
+        }
+    }
+    if (!value) return E_OUTOFMEMORY;
+    entity->value = value;
+    return S_OK;
+}
