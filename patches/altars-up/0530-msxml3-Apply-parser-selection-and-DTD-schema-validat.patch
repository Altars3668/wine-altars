+static void test_deferred_schema_validation(void)
+{
+    static const WCHAR *const sources[] =
+    {
+        L"<xs:schema xmlns:xs='http://www.w3.org/2001/XMLSchema' targetNamespace='urn:test'><xs:element name='root' type='xs:int'/></xs:schema>",
+        L"<xs:schema xmlns:xs='http://www.w3.org/2001/XMLSchema' targetNamespace='urn:test'><xs:element name='root' type='xs:undefinedType'/></xs:schema>",
+    };
+    unsigned int mode, invalid;
+    HRESULT hr;
+
+    for (mode = 0; mode < 2; ++mode)
+    for (invalid = 0; invalid < ARRAY_SIZE(sources); ++invalid)
+    {
+        IXMLDOMSchemaCollection2 *cache;
+        IXMLDOMDocument2 *doc;
+        VARIANT input;
+        VARIANT_BOOL loaded, validating;
+        BSTR xml, uri;
+
+        winetest_push_context("validateOnLoad %u invalid %u", mode, invalid);
+        hr = CoCreateInstance(&CLSID_XMLSchemaCache60, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IXMLDOMSchemaCollection2, (void **)&cache);
+        if (FAILED(hr)) { win_skip("MSXML6 schema cache is unavailable.\n"); winetest_pop_context(); return; }
+        hr = IXMLDOMSchemaCollection2_put_validateOnLoad(cache, mode ? VARIANT_TRUE : VARIANT_FALSE);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+        hr = IXMLDOMSchemaCollection2_get_validateOnLoad(cache, &validating);
+        ok(hr == S_OK && validating == (mode ? VARIANT_TRUE : VARIANT_FALSE), "Got %#lx, %d.\n", hr, validating);
+        hr = CoCreateInstance(&CLSID_DOMDocument60, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IXMLDOMDocument2, (void **)&doc);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+        if (FAILED(hr)) { IXMLDOMSchemaCollection2_Release(cache); winetest_pop_context(); continue; }
+        xml = SysAllocString(sources[invalid]);
+        hr = IXMLDOMDocument2_loadXML(doc, xml, &loaded);
+        ok(hr == S_OK && loaded == VARIANT_TRUE, "Got %#lx, %d.\n", hr, loaded);
+        SysFreeString(xml);
+        V_VT(&input) = VT_DISPATCH;
+        V_DISPATCH(&input) = (IDispatch *)doc;
+        uri = SysAllocString(L"urn:test");
+        hr = IXMLDOMSchemaCollection2_add(cache, uri, input);
+        ok(hr == (mode && invalid ? E_FAIL : S_OK), "Got add %#lx.\n", hr);
+        hr = IXMLDOMSchemaCollection2_validate(cache);
+        ok(hr == (!mode && invalid ? E_FAIL : S_OK), "Got validate %#lx.\n", hr);
+        SysFreeString(uri);
+        IXMLDOMDocument2_Release(doc);
+        IXMLDOMSchemaCollection2_Release(cache);
+        winetest_pop_context();
+    }
+}
+
 START_TEST(schema)
 {
     HRESULT r;
+    int argc;
+    char **argv;
 
     r = CoInitialize( NULL );
     ok( r == S_OK, "failed to init com\n");
 
+    argc = winetest_get_mainargs(&argv);
+    if (argc >= 3 && !strcmp(argv[2], "deferred"))
+    {
+        test_deferred_schema_validation();
+        CoUninitialize();
+        return;
+    }
+    test_deferred_schema_validation();
     test_schema_refs();
     test_collection_refs();
     test_length();
