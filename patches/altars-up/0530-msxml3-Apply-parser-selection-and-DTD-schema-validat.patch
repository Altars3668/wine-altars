+static void test_new_parser_validation(void)
+{
+    static const struct
+    {
+        const char *xml;
+        BOOL validate;
+        LONG code[2], line[2], column[2];
+    } cases[] =
+    {
+        {"<!DOCTYPE root [<!ELEMENT root EMPTY>]><root/>", TRUE, {0, 0xc00ce23d}, {0, 1}, {0, 16}},
+        {"<!DOCTYPE root [<!ELEMENT root (child)><!ELEMENT child EMPTY>]><root/>", FALSE, {0, 0}, {0, 0}, {0, 0}},
+        {"<!DOCTYPE root [<!ELEMENT root (child)><!ELEMENT child EMPTY>]><root/>", TRUE,
+         {0xc00ce011, 0xc00ce23d}, {1, 1}, {71, 16}},
+        {"<root>\n  <child>value</root>", FALSE, {0xc00ce56d, 0xc00cee3b}, {2, 2}, {17, 21}},
+    };
+    IXMLDOMDocument2 *doc;
+    IXMLDOMParseError *error;
+    VARIANT option;
+    VARIANT_BOOL loaded;
+    HRESULT hr;
+    LONG code, line, column;
+    unsigned int i, newer;
+
+    if (!is_clsid_supported(&CLSID_DOMDocument60, &IID_IXMLDOMDocument2)) return;
+    for (newer = 0; newer < 2; ++newer)
+    for (i = 0; i < ARRAY_SIZE(cases); ++i)
+    {
+        winetest_push_context("NewParser %u case %u", newer, i);
+        doc = create_document_version(60, &IID_IXMLDOMDocument2);
+        V_VT(&option) = VT_BOOL;
+        V_BOOL(&option) = VARIANT_FALSE;
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("ProhibitDTD"), option);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+        V_BOOL(&option) = newer ? VARIANT_TRUE : VARIANT_FALSE;
+        hr = IXMLDOMDocument2_setProperty(doc, _bstr_("NewParser"), option);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+        IXMLDOMDocument2_put_validateOnParse(doc, cases[i].validate ? VARIANT_TRUE : VARIANT_FALSE);
+        hr = IXMLDOMDocument2_loadXML(doc, _bstr_(cases[i].xml), &loaded);
+        ok(hr == (cases[i].code[newer] ? S_FALSE : S_OK), "Got %#lx.\n", hr);
+        ok(loaded == (cases[i].code[newer] ? VARIANT_FALSE : VARIANT_TRUE), "Got loaded %d.\n", loaded);
+        hr = IXMLDOMDocument2_get_parseError(doc, &error);
+        ok(hr == S_OK, "Got %#lx.\n", hr);
+        hr = IXMLDOMParseError_get_errorCode(error, &code);
+        ok(hr == (cases[i].code[newer] ? S_OK : S_FALSE), "Got %#lx.\n", hr);
+        ok(code == cases[i].code[newer], "Got error %#lx.\n", code);
+        hr = IXMLDOMParseError_get_line(error, &line);
+        ok(hr == (code ? S_OK : S_FALSE), "Got line hr %#lx.\n", hr);
+        ok(line == cases[i].line[newer], "Got line %ld.\n", line);
+        hr = IXMLDOMParseError_get_linepos(error, &column);
+        ok(hr == (code ? S_OK : S_FALSE), "Got column hr %#lx.\n", hr);
+        ok(column == cases[i].column[newer], "Got column %ld.\n", column);
+        IXMLDOMParseError_Release(error);
+        IXMLDOMDocument2_Release(doc);
+        winetest_pop_context();
+    }
+}
+
 START_TEST(domdoc)
 {
     HRESULT hr;
+    int argc;
+    char **argv;
 
     hr = CoInitialize( NULL );
     ok( hr == S_OK, "failed to init com\n");
@@ -19801,6 +19860,14 @@ START_TEST(domdoc)
         return;
     }
 
+    argc = winetest_get_mainargs(&argv);
+    if (argc >= 3 && !strcmp(argv[2], "newparser"))
+    {
+        test_new_parser_validation();
+        CoUninitialize();
+        return;
+    }
+    test_new_parser_validation();
     test_createProcessingInstruction();
     test_load_with_site();
     test_domdoc();
