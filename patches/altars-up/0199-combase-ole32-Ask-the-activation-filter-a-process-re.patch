+/* Windows asks about classes of its own too, around the ones it is told to activate; only the calls about
+ * the class given are checked, and the total count only when it is given. */
+#define check_calls(a, b, c, d) check_calls_(__LINE__, a, b, c, d)
+static void check_calls_(unsigned int line, const CLSID *clsid, DWORD type, unsigned int count, int total)
+{
+    unsigned int i, found = 0;
+
+    for (i = 0; i < min(call_count, ARRAY_SIZE(calls)); i++)
+    {
+        if (!IsEqualCLSID(&calls[i].clsid, clsid)) continue;
+        found++;
+        ok_(__FILE__, line)(calls[i].type == type, "got type %#lx.\n", calls[i].type);
+        ok_(__FILE__, line)(IsEqualCLSID(&calls[i].replacement, &GUID_NULL), "got replacement %s.\n",
+                            wine_dbgstr_guid(&calls[i].replacement));
+    }
+    ok_(__FILE__, line)(found == count, "asked %u times about %s.\n", found, wine_dbgstr_guid(clsid));
+    if (total >= 0) ok_(__FILE__, line)(call_count == total, "asked %u times.\n", call_count);
+    call_count = 0;
+}
