+
+#define COBJMACROS
+#define USE_COM_CONTEXT_DEF
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "objbase.h"
+#include "ole2.h"
+#include "urlmon.h"
+#include "cguid.h"
+
+#include "wine/test.h"
+
+/* A filter, once registered, stays for the life of the process, so these tests have one of their own. */
+
+static HRESULT (WINAPI *pCoRegisterActivationFilter)(IActivationFilter *filter);
+
+static const CLSID CLSID_unregistered = {0x3f2d8a1e,0x55c1,0x4a7e,{0x9b,0x0e,0x61,0x2c,0x7d,0x13,0xa4,0x5f}};
+static const CLSID CLSID_registered = {0x1c9d5b3a,0x2e4f,0x4d6a,{0x8b,0x7c,0x9e,0x0f,0x1a,0x2b,0x3c,0x4d}};
+static const CLSID CLSID_PSDispatch = {0x00020420,0x0000,0x0000,{0xc0,0x00,0x00,0x00,0x00,0x00,0x00,0x46}};
+
+static struct
+{
+    DWORD type;
+    CLSID clsid, replacement;
+} calls[16];
+static unsigned int call_count;
+static enum { PASS, REFUSE, REPLACE, REPLACE_REFUSE, SUCCESS_CODE } mode;
+static LONG filter_refs;
+
+static HRESULT WINAPI filter_QueryInterface(IActivationFilter *iface, REFIID riid, void **obj)
+{
+    ok(0, "unexpected QueryInterface %s\n", wine_dbgstr_guid(riid));
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI filter_AddRef(IActivationFilter *iface)
+{
+    return InterlockedIncrement(&filter_refs);
+}
+
+static ULONG WINAPI filter_Release(IActivationFilter *iface)
+{
+    return InterlockedDecrement(&filter_refs);
+}
+
+static HRESULT WINAPI filter_HandleActivation(IActivationFilter *iface, DWORD type, REFCLSID clsid, CLSID *replacement)
+{
+    if (call_count < ARRAY_SIZE(calls))
+    {
+        calls[call_count].type = type;
+        calls[call_count].clsid = *clsid;
+        calls[call_count].replacement = *replacement;
+    }
+    call_count++;
+
+    if (mode == REFUSE && IsEqualCLSID(clsid, &CLSID_InternetZoneManager)) return E_ACCESSDENIED;
+    if ((mode == REPLACE || mode == REPLACE_REFUSE) && IsEqualCLSID(clsid, &CLSID_InternetZoneManager))
+        *replacement = CLSID_InternetSecurityManager;
+    if (mode == REPLACE_REFUSE && IsEqualCLSID(clsid, &CLSID_InternetSecurityManager)) return E_ACCESSDENIED;
+    return mode == SUCCESS_CODE ? S_FALSE : S_OK;
+}
+
