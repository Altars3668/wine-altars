+    mode = SUCCESS_CODE;
+    hr = CoCreateInstance(&CLSID_InternetSecurityManager, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IUnknown_Release(unk);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
