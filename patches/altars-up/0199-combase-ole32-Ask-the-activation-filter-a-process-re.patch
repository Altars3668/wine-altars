+    hr = E_UNEXPECTED;
+
     if (server_info)
         FIXME("server_info name %s, authinfo %p\n", debugstr_w(server_info->pwszName), server_info->pAuthInfo);
 
@@ -2227,6 +2330,25 @@ HRESULT WINAPI CoWaitForMultipleHandles(DWORD flags, DWORD timeout, ULONG handle
     return hr;
 }
 
+/***********************************************************************
+ *            CoRegisterActivationFilter        (combase.@)
+ *
+ * Registers the filter every activation in the process asks first, for as
+ * long as the process lives. There is only the one: registering it again
+ * succeeds, and registering another is not supported. It is not referenced.
+ */
+HRESULT WINAPI CoRegisterActivationFilter(IActivationFilter *filter)
+{
+    IActivationFilter *previous;
+
+    TRACE("%p\n", filter);
+
+    if (!filter) return E_INVALIDARG;
+
+    previous = InterlockedCompareExchangePointer((void **)&activation_filter, filter, NULL);
+    return !previous || previous == filter ? S_OK : CO_E_NOT_SUPPORTED;
+}
+
 /******************************************************************************
  *            CoRegisterMessageFilter        (combase.@)
  */
@@ -3602,16 +3724,6 @@ BOOL WINAPI CoIsOle1Class(REFCLSID clsid)
     return FALSE;
 }
 
-/***********************************************************************
- *           CoRegisterActivationFilter  (combase.@)
- */
-HRESULT WINAPI CoRegisterActivationFilter(IActivationFilter *filter)
-{
-    FIXME("%p stub\n", filter);
-
-    return E_NOTIMPL;
-}
