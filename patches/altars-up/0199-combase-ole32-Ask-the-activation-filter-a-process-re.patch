+static void test_activation_filter(void)
+{
+    IInternetSecurityManager *manager;
+    WCHAR path[MAX_PATH];
+    IClassFactory *cf;
+    IStorage *storage;
+    IMoniker *moniker;
+    IStream *stream;
+    IBindCtx *bind;
+    MULTI_QI mqi;
+    IUnknown *unk;
+    HANDLE thread;
+    DWORD cookie;
+    HRESULT hr;
+
+    hr = OleInitialize(NULL);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    cf_embed_source = RegisterClipboardFormatA("Embed Source");
+
+    /* there is only the one filter, which COM does not reference */
+    hr = pCoRegisterActivationFilter(NULL);
+    ok(hr == E_INVALIDARG, "got %#lx.\n", hr);
+    hr = pCoRegisterActivationFilter(&filter);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    hr = pCoRegisterActivationFilter(&filter);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    hr = pCoRegisterActivationFilter(&other_filter);
+    ok(hr == CO_E_NOT_SUPPORTED, "got %#lx.\n", hr);
+    hr = pCoRegisterActivationFilter(NULL);
+    ok(hr == E_INVALIDARG, "got %#lx.\n", hr);
+    ok(!filter_refs, "got %ld references.\n", filter_refs);
+
+    /* every activation asks it once, before it knows whether there is such a class */
+    hr = CoCreateInstance(&CLSID_InternetSecurityManager, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IUnknown_Release(unk);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+    hr = CoCreateInstance(&CLSID_InternetSecurityManager, NULL, CLSCTX_ALL, &IID_IUnknown, (void **)&unk);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IUnknown_Release(unk);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+    hr = CoGetClassObject(&CLSID_InternetSecurityManager, CLSCTX_INPROC_SERVER, NULL, &IID_IClassFactory,
+                          (void **)&cf);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IClassFactory_Release(cf);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+    hr = CoCreateInstance(&CLSID_StdGlobalInterfaceTable, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IUnknown_Release(unk);
+    check_calls(&CLSID_StdGlobalInterfaceTable, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+    hr = CoRegisterClassObject(&CLSID_registered, (IUnknown *)&factory, CLSCTX_INPROC_SERVER, REGCLS_MULTIPLEUSE,
+                               &cookie);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    hr = CoCreateInstance(&CLSID_registered, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IUnknown_Release(unk);
+    check_calls(&CLSID_registered, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+    CoRevokeClassObject(cookie);
+    hr = CoCreateInstance(&CLSID_unregistered, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk);
+    ok(hr == REGDB_E_CLASSNOTREG, "got %#lx.\n", hr);
+    check_calls(&CLSID_unregistered, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+
+    thread = CreateThread(NULL, 0, thread_proc, NULL, 0, NULL);
+    ok(!WaitForSingleObject(thread, 10000), "thread did not finish.\n");
+    CloseHandle(thread);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+
+    /* and it is told where the class came from */
+    storage = create_storage();
+    WriteClassStg(storage, &CLSID_InternetSecurityManager);
+    hr = OleLoad(storage, &IID_IUnknown, NULL, (void **)&unk);
+    ok(hr == E_NOINTERFACE, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_FROM_STORAGE, 1, -1);
+    IStorage_Release(storage);
+
+    CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    WriteClassStm(stream, &CLSID_InternetSecurityManager);
+    IStream_Seek(stream, (LARGE_INTEGER){{0}}, STREAM_SEEK_SET, NULL);
+    hr = OleLoadFromStream(stream, &IID_IUnknown, (void **)&unk);
+    ok(hr == E_NOINTERFACE, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_FROM_MONIKER, 1, 1);
+    IStream_Release(stream);
+
+    GetTempPathW(ARRAY_SIZE(path), path);
+    lstrcatW(path, L"wine_activation.stg");
+    hr = StgCreateDocfile(path, STGM_CREATE | STGM_READWRITE | STGM_SHARE_EXCLUSIVE, 0, &storage);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    WriteClassStg(storage, &CLSID_InternetSecurityManager);
+    IStorage_Release(storage);
+    call_count = 0;
+
+    mqi.pIID = &IID_IUnknown;
+    mqi.pItf = NULL;
+    mqi.hr = S_OK;
+    hr = CoGetInstanceFromFile(NULL, NULL, NULL, CLSCTX_INPROC_SERVER, STGM_READ, path, 1, &mqi);
+    ok(hr == E_NOINTERFACE, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_FROM_FILE, 1, -1);
+
+    hr = CreateFileMoniker(path, &moniker);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    CreateBindCtx(0, &bind);
+    hr = IMoniker_BindToObject(moniker, bind, NULL, &IID_IUnknown, (void **)&unk);
+    ok(hr == E_NOINTERFACE, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_FROM_MONIKER | ACTIVATIONTYPE_FROM_FILE, 1, -1);
+    IBindCtx_Release(bind);
+    IMoniker_Release(moniker);
+    DeleteFileW(path);
+
+    hr = CreateClassMoniker(&CLSID_InternetSecurityManager, &moniker);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    CreateBindCtx(0, &bind);
+    hr = IMoniker_BindToObject(moniker, bind, NULL, &IID_IUnknown, (void **)&unk);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IUnknown_Release(unk);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_FROM_MONIKER, 1, 1);
+    IBindCtx_Release(bind);
+    IMoniker_Release(moniker);
+
+    storage = create_storage();
+    hr = OleCreate(&CLSID_InternetSecurityManager, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, storage, (void **)&unk);
+    ok(hr == E_NOINTERFACE, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, -1);
+    IStorage_Release(storage);
+
+    hr = OleQueryCreateFromData(&data_object);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    storage = create_storage();
+    hr = OleCreateFromData(&data_object, &IID_IUnknown, OLERENDER_NONE, NULL, NULL, storage, (void **)&unk);
+    ok(hr == E_NOINTERFACE, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_FROM_DATA, 1, -1);
+    IStorage_Release(storage);
+
+    {
+        /* an OBJREF whose custom marshaler is the security manager */
+        struct
+        {
+            ULONG signature, flags;
+            IID iid;
+            CLSID clsid;
+            ULONG extension, size;
+        }
+        objref = { 0x574f454d, 4, IID_IUnknown, CLSID_InternetSecurityManager, 0, 0 };
+
+        CreateStreamOnHGlobal(NULL, TRUE, &stream);
+        IStream_Write(stream, &objref, sizeof(objref), NULL);
+        IStream_Seek(stream, (LARGE_INTEGER){{0}}, STREAM_SEEK_SET, NULL);
+        hr = CoUnmarshalInterface(stream, &IID_IUnknown, (void **)&unk);
+        ok(hr == E_NOINTERFACE, "got %#lx.\n", hr);
+        check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+        IStream_Release(stream);
+    }
+
+    /* COM's own proxies and stubs are no activation, and the others it asks about when it first loads them */
+    CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    hr = CoMarshalInterface(stream, &IID_IClassFactory, (IUnknown *)&factory, MSHCTX_INPROC, NULL,
+                            MSHLFLAGS_NORMAL);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    ok(!call_count, "asked %u times.\n", call_count);
+    IStream_Seek(stream, (LARGE_INTEGER){{0}}, STREAM_SEEK_SET, NULL);
+    CoReleaseMarshalData(stream);
+    IStream_Release(stream);
+    call_count = 0;
+
+    CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    hr = CoMarshalInterface(stream, &IID_IDispatch, (IUnknown *)&object, MSHCTX_INPROC, NULL, MSHLFLAGS_NORMAL);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    ok(call_count == 1, "asked %u times.\n", call_count);
+    ok(calls[0].type == ACTIVATIONTYPE_UNCATEGORIZED, "got type %#lx.\n", calls[0].type);
+    ok(IsEqualCLSID(&calls[0].clsid, &CLSID_PSDispatch), "got %s.\n", wine_dbgstr_guid(&calls[0].clsid));
+    ok(IsEqualCLSID(&calls[0].replacement, &GUID_NULL), "got replacement %s.\n",
+       wine_dbgstr_guid(&calls[0].replacement));
+    IStream_Seek(stream, (LARGE_INTEGER){{0}}, STREAM_SEEK_SET, NULL);
+    CoReleaseMarshalData(stream);
+    IStream_Release(stream);
+    call_count = 0;
+    CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    hr = CoMarshalInterface(stream, &IID_IDispatch, (IUnknown *)&object, MSHCTX_INPROC, NULL, MSHLFLAGS_NORMAL);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    ok(!call_count, "asked %u times.\n", call_count);
+    IStream_Seek(stream, (LARGE_INTEGER){{0}}, STREAM_SEEK_SET, NULL);
+    CoReleaseMarshalData(stream);
+    IStream_Release(stream);
+    call_count = 0;
+
+    /* what it refuses fails with what it answered, and what it puts in a class's place it is asked about too */
+    mode = REFUSE;
+    hr = CoCreateInstance(&CLSID_InternetZoneManager, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk);
+    ok(hr == E_ACCESSDENIED, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetZoneManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+    hr = CoGetClassObject(&CLSID_InternetZoneManager, CLSCTX_INPROC_SERVER, NULL, &IID_IClassFactory, (void **)&cf);
+    ok(hr == E_ACCESSDENIED, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetZoneManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 1);
+
+    mode = REPLACE;
+    hr = CoCreateInstance(&CLSID_InternetZoneManager, NULL, CLSCTX_INPROC_SERVER, &IID_IInternetSecurityManager,
+                          (void **)&manager);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IInternetSecurityManager_Release(manager);
+    ok(call_count == 2, "asked %u times.\n", call_count);
+    ok(IsEqualCLSID(&calls[1].clsid, &CLSID_InternetSecurityManager), "got %s.\n", wine_dbgstr_guid(&calls[1].clsid));
+    check_calls(&CLSID_InternetZoneManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, -1);
+
+    hr = CreateClassMoniker(&CLSID_InternetZoneManager, &moniker);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    CreateBindCtx(0, &bind);
+    hr = IMoniker_BindToObject(moniker, bind, NULL, &IID_IUnknown, (void **)&unk);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    IUnknown_Release(unk);
+    ok(call_count == 2, "asked %u times.\n", call_count);
+    ok(calls[1].type == ACTIVATIONTYPE_FROM_MONIKER, "got type %#lx.\n", calls[1].type);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_FROM_MONIKER, 1, -1);
+    IBindCtx_Release(bind);
+    IMoniker_Release(moniker);
+
+    mode = REPLACE_REFUSE;
+    hr = CoCreateInstance(&CLSID_InternetZoneManager, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk);
+    ok(hr == E_ACCESSDENIED, "got %#lx.\n", hr);
+    check_calls(&CLSID_InternetSecurityManager, ACTIVATIONTYPE_UNCATEGORIZED, 1, 2);
