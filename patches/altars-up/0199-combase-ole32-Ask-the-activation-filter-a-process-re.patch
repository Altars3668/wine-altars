From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 02:39:57 -0400
Subject: [PATCH] combase, ole32: Ask the activation filter a process
 registers, as Windows does.

CoRegisterActivationFilter took the filter and never asked it.  Now
every activation asks it first, before the class is looked for, and
fails with what it answers or activates what it puts in the class's
place, which it is asked about too.  It is told how the activation came
about: from a moniker, stored data, a storage or a file, as each way
OLE creates objects says on Windows.  Proxy and stub factories are
asked about when they are first loaded, and COM's own not at all.
There is only the one filter, kept for the life of the process and not
referenced.

Creating an object from data also needs the clipboard formats OLE uses,
which were registered only once the clipboard had been used: until
then OleQueryCreateFromData and OleCreateFromData saw no embedded
object in any data.

Office registers its filter at start-up.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 5510cc7d40992911895592e31d2c5a2acf3d5e2e)

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index a62dbbadd93..14030504b28 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -1579,6 +1579,96 @@ static HRESULT return_multi_qi(IUnknown *unk, DWORD count, MULTI_QI *mqi, BOOL i
     return fetched == count ? S_OK : CO_S_NOTALLINTERFACES;
 }
 
+/* The filter the process registered, which every activation asks first. */
+static IActivationFilter *activation_filter;
+
+/* COM's own proxies and stubs, which it does not activate */
+static const CLSID CLSID_StdPSFactoryBuffer = {0x00000320,0x0000,0x0000,{0xc0,0x00,0x00,0x00,0x00,0x00,0x00,0x46}};
+
+/* The proxy/stub factories loaded so far: COM keeps them, and asks the filter about each only the first time. */
+static CLSID *ps_classes;
+static unsigned int ps_class_count;
+static SRWLOCK ps_classes_lock = SRWLOCK_INIT;
+
+static BOOL is_loaded_ps_class(const CLSID *clsid)
+{
+    BOOL loaded = FALSE;
+    unsigned int i;
+
+    AcquireSRWLockShared(&ps_classes_lock);
+    for (i = 0; i < ps_class_count && !loaded; i++) loaded = IsEqualCLSID(&ps_classes[i], clsid);
+    ReleaseSRWLockShared(&ps_classes_lock);
+    return loaded;
+}
+
+static void add_loaded_ps_class(const CLSID *clsid)
+{
+    CLSID *classes;
+
+    AcquireSRWLockExclusive(&ps_classes_lock);
+    if ((classes = realloc(ps_classes, (ps_class_count + 1) * sizeof(*classes))))
+    {
+        ps_classes = classes;
+        ps_classes[ps_class_count++] = *clsid;
+    }
+    ReleaseSRWLockExclusive(&ps_classes_lock);
+}
+
+/* Asks the filter whether the class may be activated, and whether another is to be activated in its place,
+ * which it is then asked about too, as what the caller said the activation is.  A proxy/stub factory is asked
+ * about only when it is first loaded. */
+static HRESULT filter_activation(const CLSID *clsid, DWORD clscontext, CLSID *actual)
+{
+    CLSID replacement = GUID_NULL, again = GUID_NULL;
+    DWORD type = ACTIVATIONTYPE_UNCATEGORIZED;
+    BOOL ps = clscontext & CLSCTX_PS_DLL;
+    IActivationFilter *filter;
+    struct tlsdata *tlsdata;
+    HRESULT hr;
+
+    *actual = *clsid;
+
+    if (ps && (IsEqualCLSID(clsid, &CLSID_StdPSFactoryBuffer) || is_loaded_ps_class(clsid))) return S_OK;
+
+    /* what the caller said this activation is, and not the ones it leads to */
+    if (!ps && SUCCEEDED(com_get_tlsdata(&tlsdata)))
+    {
+        type = tlsdata->activation_type;
+        tlsdata->activation_type = ACTIVATIONTYPE_UNCATEGORIZED;
+    }
+
+    if ((filter = activation_filter))
+    {
+        TRACE("asking the filter about %s, type %#lx\n", debugstr_guid(clsid), type);
+        if (FAILED(hr = IActivationFilter_HandleActivation(filter, type, clsid, &replacement)))
+        {
+            TRACE("filter refused %s, hr %#lx\n", debugstr_guid(clsid), hr);
+            return hr;
+        }
+        if (!IsEqualGUID(&replacement, &GUID_NULL) && !IsEqualGUID(&replacement, clsid))
+        {
+            TRACE("filter puts %s in the place of %s\n", debugstr_guid(&replacement), debugstr_guid(clsid));
+            if (FAILED(hr = IActivationFilter_HandleActivation(filter, type, &replacement, &again)))
+            {
+                TRACE("filter refused %s, hr %#lx\n", debugstr_guid(&replacement), hr);
+                return hr;
+            }
+            *actual = replacement;
+        }
+    }
+
+    if (ps) add_loaded_ps_class(clsid);
+    return S_OK;
+}
+
+/* Tells the activation filter how the next activation in this thread comes about. */
+static void set_activation_type(DWORD type)
+{
+    struct tlsdata *tlsdata;
+
+    if (SUCCEEDED(com_get_tlsdata(&tlsdata))) tlsdata->activation_type = type;
+}
+
