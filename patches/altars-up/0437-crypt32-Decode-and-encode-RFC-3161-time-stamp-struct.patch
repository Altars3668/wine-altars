+static void test_decodeTimeStampResponse(DWORD dwEncoding)
+{
+    /* rejected, with the text "no" and the failure badAlg, and no token */
+    static const BYTE rejected[] = { 0x30, 0x10, 0x30, 0x0e, 0x02, 0x01, 0x02, 0x30, 0x04, 0x0c, 0x02, 0x6e, 0x6f,
+     0x03, 0x03, 0x07, 0x80, 0x00 };
+    CRYPT_TIMESTAMP_RESPONSE *response;
+    DWORD size;
+    BOOL ret;
+
+    ret = CryptDecodeObjectEx(dwEncoding, TIMESTAMP_RESPONSE, rejected, sizeof(rejected), CRYPT_DECODE_ALLOC_FLAG,
+     NULL, &response, &size);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    if (!ret) return;
+    ok(size == 88, "got size %lu.\n", size);
+    ok(response->dwStatus == TIMESTAMP_STATUS_REJECTED, "got status %lu.\n", response->dwStatus);
+    ok(response->cFreeText == 1 && !wcscmp(response->rgFreeText[0], L"no"), "got %lu texts.\n",
+     response->cFreeText);
+    ok(response->FailureInfo.cbData == 2 && response->FailureInfo.cUnusedBits == 7 &&
+     response->FailureInfo.pbData[0] == 0x80, "got %lu bytes of failure information.\n",
+     response->FailureInfo.cbData);
+    ok(!response->ContentInfo.cbData, "got %lu bytes of content.\n", response->ContentInfo.cbData);
+    LocalFree(response);
+}
