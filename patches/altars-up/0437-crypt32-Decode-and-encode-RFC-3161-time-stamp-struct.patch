+static void test_decodeTimeStampInfo(DWORD dwEncoding)
+{
+    static const BYTE serial[] = { 5, 4, 3, 2, 1 };
+    static const struct
+    {
+        const BYTE *encoded;
+        DWORD size, decoded_size;
+        DWORD version;
+        WORD millis;
+        BOOL ordering;
+        DWORD nonce, tsa, extensions;
+    }
+    tests[] =
+    {
+        { tst_plain,          sizeof(tst_plain),          224, 1, 74 },
+        { tst_seconds_millis, sizeof(tst_seconds_millis), 240, 1, 74 },
+        { tst_ordering,       sizeof(tst_ordering),       224, 1, 74, TRUE },
+        { tst_nonce,          sizeof(tst_nonce),          232, 1, 74, FALSE, 8 },
+        { tst_tsa,            sizeof(tst_tsa),            248, 1, 74, FALSE, 0, 18 },
+        { tst_extensions,     sizeof(tst_extensions),     272, 1, 74, FALSE, 0, 0, 1 },
+        { tst_everything,     sizeof(tst_everything),     320, 1, 74, TRUE, 2, 18, 1 },
+        { tst_no_fraction,    sizeof(tst_no_fraction),    224, 1, 0 },
+        { tst_one_digit,      sizeof(tst_one_digit),      224, 1, 500 },
+        { tst_four_digits,    sizeof(tst_four_digits),    224, 1, 74 },
+        { tst_version2,       sizeof(tst_version2),       224, 2, 74 },
+    };
+    CRYPT_TIMESTAMP_INFO *info;
+    SYSTEMTIME st;
+    DWORD i, size;
+    BOOL ret;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context("%lu", i);
+        size = 0;
+        ret = CryptDecodeObjectEx(dwEncoding, TIMESTAMP_INFO, tests[i].encoded, tests[i].size, 0, NULL, NULL, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        ok(size == tests[i].decoded_size, "got size %lu.\n", size);
+        ret = CryptDecodeObjectEx(dwEncoding, TIMESTAMP_INFO, tests[i].encoded, tests[i].size,
+         CRYPT_DECODE_ALLOC_FLAG, NULL, &info, &size);
+        ok(ret, "got error %#lx.\n", GetLastError());
+        if (!ret)
+        {
+            winetest_pop_context();
+            continue;
+        }
+        ok(info->dwVersion == tests[i].version, "got version %lu.\n", info->dwVersion);
+        ok(!strcmp(info->pszTSAPolicyId, "1.2.3.4"), "got policy %s.\n", info->pszTSAPolicyId);
+        ok(!strcmp(info->HashAlgorithm.pszObjId, szOID_NIST_sha256), "got hash %s.\n", info->HashAlgorithm.pszObjId);
+        ok(info->HashAlgorithm.Parameters.cbData == 2, "got %lu bytes of parameters.\n",
+         info->HashAlgorithm.Parameters.cbData);
+        ok(info->HashedMessage.cbData == 32 && info->HashedMessage.pbData[0] == 0x11 &&
+         info->HashedMessage.pbData[31] == 0x11, "got %lu bytes of imprint.\n", info->HashedMessage.cbData);
+        ok(info->SerialNumber.cbData == sizeof(serial) &&
+         !memcmp(info->SerialNumber.pbData, serial, sizeof(serial)), "got a serial of %lu bytes.\n",
+         info->SerialNumber.cbData);
+        FileTimeToSystemTime(&info->ftTime, &st);
+        ok(st.wYear == 2023 && st.wMonth == 7 && st.wDay == 3 && st.wHour == 7 && st.wMinute == 14 &&
+         st.wSecond == 34 && st.wMilliseconds == tests[i].millis, "got %u-%u-%u %u:%u:%u.%u.\n", st.wYear,
+         st.wMonth, st.wDay, st.wHour, st.wMinute, st.wSecond, st.wMilliseconds);
+        ok(!info->pvAccuracy, "got accuracy %p.\n", info->pvAccuracy);
+        ok(info->fOrdering == tests[i].ordering, "got ordering %d.\n", info->fOrdering);
+        ok(info->Nonce.cbData == tests[i].nonce, "got a nonce of %lu bytes.\n", info->Nonce.cbData);
+        if (tests[i].nonce == 8)
+            ok(info->Nonce.pbData[0] == 8 && info->Nonce.pbData[7] == 1, "got nonce %02x...%02x.\n",
+             info->Nonce.pbData[0], info->Nonce.pbData[7]);
+        ok(info->Tsa.cbData == tests[i].tsa, "got a TSA name of %lu bytes.\n", info->Tsa.cbData);
+        if (tests[i].tsa)
+            ok(info->Tsa.pbData[0] == 0xa4, "got tag %02x.\n", info->Tsa.pbData[0]);
+        ok(info->cExtension == tests[i].extensions, "got %lu extensions.\n", info->cExtension);
+        if (tests[i].extensions)
+            ok(!strcmp(info->rgExtension[0].pszObjId, "1.2.3.5") && !info->rgExtension[0].fCritical &&
+             info->rgExtension[0].Value.cbData == 2, "got extension %s.\n", info->rgExtension[0].pszObjId);
+        LocalFree(info);
+
+        SetLastError(0xdeadbeef);
+        ret = CryptDecodeObjectEx(dwEncoding, TIMESTAMP_INFO, tests[i].encoded, tests[i].size - 1,
+         CRYPT_DECODE_ALLOC_FLAG, NULL, &info, &size);
+        ok(!ret && GetLastError() == CRYPT_E_ASN1_EOD, "got %d, error %#lx.\n", ret, GetLastError());
+        winetest_pop_context();
+    }
+
+    size = 100;
+    info = malloc(tests[0].decoded_size);
+    SetLastError(0xdeadbeef);
+    ret = CryptDecodeObjectEx(dwEncoding, TIMESTAMP_INFO, tst_plain, sizeof(tst_plain), 0, NULL, info, &size);
+    ok(!ret && GetLastError() == ERROR_MORE_DATA, "got %d, error %#lx.\n", ret, GetLastError());
+    ok(size == tests[0].decoded_size, "got size %lu.\n", size);
+    ret = CryptDecodeObjectEx(dwEncoding, TIMESTAMP_INFO, tst_plain, sizeof(tst_plain), 0, NULL, info, &size);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    free(info);
+}
+
+static void test_encodeTimeStampInfo(DWORD dwEncoding)
+{
+    CRYPT_TIMESTAMP_INFO *info;
+    DWORD size;
+    BYTE *buf;
+    BOOL ret;
+
+    ret = CryptDecodeObjectEx(dwEncoding, TIMESTAMP_INFO, tst_plain, sizeof(tst_plain), CRYPT_DECODE_ALLOC_FLAG,
+     NULL, &info, &size);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    if (!ret) return;
+    ret = CryptEncodeObjectEx(dwEncoding, TIMESTAMP_INFO, info, CRYPT_ENCODE_ALLOC_FLAG, NULL, &buf, &size);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    if (ret)
+    {
+        ok(size == sizeof(tst_plain) && !memcmp(buf, tst_plain, size), "got %lu bytes.\n", size);
+        LocalFree(buf);
+    }
+    LocalFree(info);
+}
