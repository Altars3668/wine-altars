From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 08:52:08 -0400
Subject: [PATCH] crypt32: Decode and encode RFC 3161 time stamp structures.

TIMESTAMP_INFO, the TSTInfo a time stamp token signs, decodes and
encodes; TIMESTAMP_REQUEST encodes and TIMESTAMP_RESPONSE decodes.  The
tests are what Windows 11 build 29671 answers for TSTInfos with each
optional part on its own, measured with tools/wintrustprobe's
tstinfoprobe: the sizes, the serial number and nonce little-endian, the
TSA name kept as the GeneralName's encoding, the time to the
millisecond; and the accuracy, which Windows makes room for whatever it
holds and still leaves pvAccuracy NULL.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/crypt32/decode.c b/dlls/crypt32/decode.c
index 686525a9048..d3e34e5a3d8 100644
--- a/dlls/crypt32/decode.c
+++ b/dlls/crypt32/decode.c
@@ -6744,6 +6744,243 @@ static BOOL WINAPI CRYPT_AsnDecodeOCSPBasicResponse(DWORD dwCertEncodingType,
     return ret;
 }
 
+/* MessageImprint, the hash a time stamp is of: the HashAlgorithm and
+ * HashedMessage that follow each other in a CRYPT_TIMESTAMP_INFO
+ */
+static BOOL CRYPT_AsnDecodeMessageImprint(const BYTE *pbEncoded,
+ DWORD cbEncoded, DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo,
+ DWORD *pcbDecoded)
+{
+    CRYPT_ALGORITHM_IDENTIFIER *algo = pvStructInfo;
+    struct AsnDecodeSequenceItem items[] = {
+     { ASN_SEQUENCEOF, 0, CRYPT_AsnDecodeAlgorithmId,
+       sizeof(CRYPT_ALGORITHM_IDENTIFIER), FALSE, TRUE,
+       offsetof(CRYPT_ALGORITHM_IDENTIFIER, pszObjId), 0 },
+     { ASN_OCTETSTRING,
+       MEMBERSIZE(CRYPT_TIMESTAMP_INFO, HashAlgorithm, HashedMessage),
+       CRYPT_AsnDecodeOctets, sizeof(CRYPT_DER_BLOB), FALSE, TRUE,
+       MEMBERSIZE(CRYPT_TIMESTAMP_INFO, HashAlgorithm, HashedMessage) +
+       offsetof(CRYPT_DER_BLOB, pbData), 0 },
+    };
+
+    return CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items), pbEncoded,
+     cbEncoded, dwFlags, NULL, pvStructInfo, pcbStructInfo, pcbDecoded,
+     algo ? algo->pszObjId : NULL);
+}
+
+/* Accuracy, into the CRYPT_TIMESTAMP_ACCURACY pvStructInfo points to */
+static BOOL CRYPT_AsnDecodeTimeStampAccuracy(const BYTE *pbEncoded,
+ DWORD cbEncoded, DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo,
+ DWORD *pcbDecoded)
+{
+    struct AsnDecodeSequenceItem items[] = {
+     { ASN_INTEGER, offsetof(CRYPT_TIMESTAMP_ACCURACY, dwSeconds),
+       CRYPT_AsnDecodeIntInternal, sizeof(DWORD), TRUE, FALSE, 0, 0 },
+     { ASN_CONTEXT, offsetof(CRYPT_TIMESTAMP_ACCURACY, dwMillis),
+       CRYPT_AsnDecodeIntInternal, sizeof(DWORD), TRUE, FALSE, 0, 0 },
+     { ASN_CONTEXT | 1, offsetof(CRYPT_TIMESTAMP_ACCURACY, dwMicros),
+       CRYPT_AsnDecodeIntInternal, sizeof(DWORD), TRUE, FALSE, 0, 0 },
+    };
+    DWORD bytesNeeded = sizeof(CRYPT_TIMESTAMP_ACCURACY *) +
+     sizeof(CRYPT_TIMESTAMP_ACCURACY), size = sizeof(CRYPT_TIMESTAMP_ACCURACY);
+    BOOL ret;
+
+    if (pvStructInfo && *pcbStructInfo < bytesNeeded)
+    {
+        *pcbStructInfo = bytesNeeded;
+        SetLastError(ERROR_MORE_DATA);
+        return FALSE;
+    }
+    ret = CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items), pbEncoded,
+     cbEncoded, dwFlags, NULL,
+     pvStructInfo ? *(CRYPT_TIMESTAMP_ACCURACY **)pvStructInfo : NULL, &size,
+     pcbDecoded, NULL);
+    if (ret)
+        *pcbStructInfo = bytesNeeded;
+    return ret;
+}
+
+/* tsa [0] GeneralName, kept as the GeneralName's encoding */
+static BOOL CRYPT_AsnDecodeTimeStampTsa(const BYTE *pbEncoded, DWORD cbEncoded,
+ DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo, DWORD *pcbDecoded)
+{
+    BOOL ret;
+    DWORD dataLen;
+
+    if (pbEncoded[0] != (ASN_CONTEXT | ASN_CONSTRUCTOR))
+    {
+        SetLastError(CRYPT_E_ASN1_BADTAG);
+        return FALSE;
+    }
+    if ((ret = CRYPT_GetLen(pbEncoded, cbEncoded, &dataLen)))
+    {
+        BYTE lenBytes = GET_LEN_BYTES(pbEncoded[1]);
+
+        ret = CRYPT_AsnDecodeDerBlob(pbEncoded + 1 + lenBytes, dataLen, dwFlags,
+         pvStructInfo, pcbStructInfo, NULL);
+        if (ret && pcbDecoded)
+            *pcbDecoded = 1 + lenBytes + dataLen;
+    }
+    return ret;
+}
+
+/* extensions [1] IMPLICIT Extensions */
+static BOOL CRYPT_AsnDecodeTimeStampExtensions(const BYTE *pbEncoded,
+ DWORD cbEncoded, DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo,
+ DWORD *pcbDecoded)
+{
+    struct AsnArrayDescriptor arrayDesc = { ASN_CONTEXT | ASN_CONSTRUCTOR | 1,
+     offsetof(CRYPT_TIMESTAMP_INFO, cExtension),
+     offsetof(CRYPT_TIMESTAMP_INFO, rgExtension),
+     FINALMEMBERSIZE(CRYPT_TIMESTAMP_INFO, cExtension),
+     CRYPT_AsnDecodeExtension, sizeof(CERT_EXTENSION), TRUE,
+     offsetof(CERT_EXTENSION, pszObjId) };
+
+    return CRYPT_AsnDecodeArray(&arrayDesc, pbEncoded, cbEncoded, dwFlags,
+     NULL, pvStructInfo, pcbStructInfo, pcbDecoded);
+}
+
+/* TSTInfo, what a time stamp token signs (RFC 3161) */
+static BOOL WINAPI CRYPT_AsnDecodeTimeStampInfo(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const BYTE *pbEncoded, DWORD cbEncoded, DWORD dwFlags,
+ CRYPT_DECODE_PARA *pDecodePara, void *pvStructInfo, DWORD *pcbStructInfo)
+{
+    struct AsnDecodeSequenceItem items[] = {
+     { ASN_INTEGER, offsetof(CRYPT_TIMESTAMP_INFO, dwVersion),
+       CRYPT_AsnDecodeIntInternal, sizeof(DWORD), FALSE, FALSE, 0, 0 },
+     { ASN_OBJECTIDENTIFIER, offsetof(CRYPT_TIMESTAMP_INFO, pszTSAPolicyId),
+       CRYPT_AsnDecodeOidIgnoreTag, sizeof(LPSTR), FALSE, TRUE,
+       offsetof(CRYPT_TIMESTAMP_INFO, pszTSAPolicyId), 0 },
+     { ASN_SEQUENCEOF, offsetof(CRYPT_TIMESTAMP_INFO, HashAlgorithm),
+       CRYPT_AsnDecodeMessageImprint,
+       MEMBERSIZE(CRYPT_TIMESTAMP_INFO, HashAlgorithm, SerialNumber), FALSE,
+       TRUE, offsetof(CRYPT_TIMESTAMP_INFO, HashAlgorithm.pszObjId), 0 },
+     { ASN_INTEGER, offsetof(CRYPT_TIMESTAMP_INFO, SerialNumber),
+       CRYPT_AsnDecodeIntegerInternal, sizeof(CRYPT_INTEGER_BLOB), FALSE,
+       TRUE, offsetof(CRYPT_TIMESTAMP_INFO, SerialNumber.pbData), 0 },
+     { ASN_GENERALTIME, offsetof(CRYPT_TIMESTAMP_INFO, ftTime),
+       CRYPT_AsnDecodeGeneralizedTime, sizeof(FILETIME), FALSE, FALSE, 0, 0 },
+     { ASN_SEQUENCEOF, offsetof(CRYPT_TIMESTAMP_INFO, pvAccuracy),
+       CRYPT_AsnDecodeTimeStampAccuracy, sizeof(PCRYPT_TIMESTAMP_ACCURACY),
+       TRUE, TRUE, offsetof(CRYPT_TIMESTAMP_INFO, pvAccuracy), 0 },
+     { ASN_BOOL, offsetof(CRYPT_TIMESTAMP_INFO, fOrdering),
+       CRYPT_AsnDecodeBool, sizeof(BOOL), TRUE, FALSE, 0, 0 },
+     { ASN_INTEGER, offsetof(CRYPT_TIMESTAMP_INFO, Nonce),
+       CRYPT_AsnDecodeIntegerInternal, sizeof(CRYPT_INTEGER_BLOB), TRUE, TRUE,
+       offsetof(CRYPT_TIMESTAMP_INFO, Nonce.pbData), 0 },
+     { ASN_CONTEXT | ASN_CONSTRUCTOR, offsetof(CRYPT_TIMESTAMP_INFO, Tsa),
+       CRYPT_AsnDecodeTimeStampTsa, sizeof(CRYPT_DER_BLOB), TRUE, TRUE,
+       offsetof(CRYPT_TIMESTAMP_INFO, Tsa.pbData), 0 },
+     { ASN_CONTEXT | ASN_CONSTRUCTOR | 1,
+       offsetof(CRYPT_TIMESTAMP_INFO, cExtension),
+       CRYPT_AsnDecodeTimeStampExtensions,
+       FINALMEMBERSIZE(CRYPT_TIMESTAMP_INFO, cExtension), TRUE, TRUE,
+       offsetof(CRYPT_TIMESTAMP_INFO, rgExtension), 0 },
+    };
+    BOOL ret;
+
+    __TRY
+    {
+        ret = CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items),
+         pbEncoded, cbEncoded, dwFlags, pDecodePara, pvStructInfo,
+         pcbStructInfo, NULL, NULL);
+        if (ret && pvStructInfo)
+        {
+            CRYPT_TIMESTAMP_INFO *info = dwFlags & CRYPT_DECODE_ALLOC_FLAG ?
+             *(CRYPT_TIMESTAMP_INFO **)pvStructInfo : pvStructInfo;
+
+            /* Windows makes room for the accuracy, and leaves pvAccuracy NULL */
+            info->pvAccuracy = NULL;
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+        ret = FALSE;
+    }
+    __ENDTRY
+    return ret;
+}
+
+/* PKIFreeText, a sequence of UTF8Strings */
+static BOOL CRYPT_AsnDecodeFreeText(const BYTE *pbEncoded, DWORD cbEncoded,
+ DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo, DWORD *pcbDecoded)
+{
+    struct AsnArrayDescriptor arrayDesc = { ASN_SEQUENCEOF,
+     offsetof(CRYPT_TIMESTAMP_RESPONSE, cFreeText),
+     offsetof(CRYPT_TIMESTAMP_RESPONSE, rgFreeText),
+     MEMBERSIZE(CRYPT_TIMESTAMP_RESPONSE, cFreeText, FailureInfo),
+     CRYPT_AsnDecodeUnicodeString, sizeof(LPWSTR), TRUE, 0 };
+
+    return CRYPT_AsnDecodeArray(&arrayDesc, pbEncoded, cbEncoded, dwFlags,
+     NULL, pvStructInfo, pcbStructInfo, pcbDecoded);
+}
+
+/* PKIStatusInfo, the fields of a CRYPT_TIMESTAMP_RESPONSE before ContentInfo */
+static BOOL CRYPT_AsnDecodePKIStatusInfo(const BYTE *pbEncoded,
+ DWORD cbEncoded, DWORD dwFlags, void *pvStructInfo, DWORD *pcbStructInfo,
+ DWORD *pcbDecoded)
+{
+    CRYPT_TIMESTAMP_RESPONSE *response = pvStructInfo;
+    struct AsnDecodeSequenceItem items[] = {
+     { ASN_INTEGER, offsetof(CRYPT_TIMESTAMP_RESPONSE, dwStatus),
+       CRYPT_AsnDecodeIntInternal, sizeof(DWORD), FALSE, FALSE, 0, 0 },
+     { ASN_SEQUENCEOF, offsetof(CRYPT_TIMESTAMP_RESPONSE, cFreeText),
+       CRYPT_AsnDecodeFreeText,
+       MEMBERSIZE(CRYPT_TIMESTAMP_RESPONSE, cFreeText, FailureInfo), TRUE,
+       TRUE, offsetof(CRYPT_TIMESTAMP_RESPONSE, rgFreeText), 0 },
+     { ASN_BITSTRING, offsetof(CRYPT_TIMESTAMP_RESPONSE, FailureInfo),
+       CRYPT_AsnDecodeBitsInternal, sizeof(CRYPT_BIT_BLOB), TRUE, TRUE,
+       offsetof(CRYPT_TIMESTAMP_RESPONSE, FailureInfo.pbData), 0 },
+    };
+
+    return CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items), pbEncoded,
+     cbEncoded, dwFlags, NULL, pvStructInfo, pcbStructInfo, pcbDecoded,
+     response ? (void *)response->rgFreeText : NULL);
+}
+
+/* TimeStampResp, a time stamp authority's answer (RFC 3161) */
+static BOOL WINAPI CRYPT_AsnDecodeTimeStampResponse(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const BYTE *pbEncoded, DWORD cbEncoded, DWORD dwFlags,
+ CRYPT_DECODE_PARA *pDecodePara, void *pvStructInfo, DWORD *pcbStructInfo)
+{
+    struct AsnDecodeSequenceItem items[] = {
+     { ASN_SEQUENCEOF, 0, CRYPT_AsnDecodePKIStatusInfo,
+       offsetof(CRYPT_TIMESTAMP_RESPONSE, ContentInfo), FALSE, TRUE,
+       offsetof(CRYPT_TIMESTAMP_RESPONSE, rgFreeText), 0 },
+     { ASN_SEQUENCEOF, offsetof(CRYPT_TIMESTAMP_RESPONSE, ContentInfo),
+       CRYPT_AsnDecodeDerBlob, sizeof(CRYPT_DER_BLOB), TRUE, TRUE,
+       offsetof(CRYPT_TIMESTAMP_RESPONSE, ContentInfo.pbData), 0 },
+    };
+    BOOL ret;
+
+    __TRY
+    {
+        ret = CRYPT_AsnDecodeSequence(items, ARRAY_SIZE(items),
+         pbEncoded, cbEncoded, dwFlags, pDecodePara, pvStructInfo,
+         pcbStructInfo, NULL, NULL);
+        if (ret && pvStructInfo)
+        {
+            CRYPT_TIMESTAMP_RESPONSE *response = dwFlags & CRYPT_DECODE_ALLOC_FLAG ?
+             *(CRYPT_TIMESTAMP_RESPONSE **)pvStructInfo : pvStructInfo;
+
+            if (!response->cFreeText)
+                response->rgFreeText = NULL;
+            if (!response->FailureInfo.cbData)
+                response->FailureInfo.pbData = NULL;
+            if (!response->ContentInfo.cbData)
+                response->ContentInfo.pbData = NULL;
+        }
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+        ret = FALSE;
+    }
+    __ENDTRY
+    return ret;
+}
+
 static CryptDecodeObjectExFunc CRYPT_GetBuiltinDecoder(DWORD dwCertEncodingType,
  LPCSTR lpszStructType)
 {
@@ -6901,6 +7138,12 @@ static CryptDecodeObjectExFunc CRYPT_GetBuiltinDecoder(DWORD dwCertEncodingType,
         case LOWORD(OCSP_BASIC_RESPONSE):
             decodeFunc = CRYPT_AsnDecodeOCSPBasicResponse;
             break;
+        case LOWORD(TIMESTAMP_RESPONSE):
+            decodeFunc = CRYPT_AsnDecodeTimeStampResponse;
+            break;
+        case LOWORD(TIMESTAMP_INFO):
+            decodeFunc = CRYPT_AsnDecodeTimeStampInfo;
+            break;
         default:
             break;
         }
diff --git a/dlls/crypt32/encode.c b/dlls/crypt32/encode.c
index 6390810c137..68b9cc18ddd 100644
--- a/dlls/crypt32/encode.c
+++ b/dlls/crypt32/encode.c
@@ -4673,6 +4673,207 @@ static BOOL WINAPI CRYPT_AsnEncodeOCSPSignedRequest(DWORD dwCertEncodingType,
     return ret;
 }
 
+/* MessageImprint, from a HashAlgorithm and the HashedMessage after it, as in
+ * a CRYPT_TIMESTAMP_REQUEST and a CRYPT_TIMESTAMP_INFO
+ */
+static BOOL WINAPI CRYPT_AsnEncodeMessageImprint(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    const CRYPT_ALGORITHM_IDENTIFIER *algo = pvStructInfo;
+    struct AsnEncodeSequenceItem items[] = {
+     { algo,                               CRYPT_AsnEncodeAlgorithmIdWithNullParams, 0 },
+     { (const CRYPT_DER_BLOB *)(algo + 1), CRYPT_AsnEncodeOctets, 0 },
+    };
+
+    return CRYPT_AsnEncodeSequence(dwCertEncodingType, items, ARRAY_SIZE(items),
+     dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+}
+
+/* GeneralizedTime with the milliseconds, if there are any, without trailing
+ * zeroes as DER wants
+ */
+static BOOL WINAPI CRYPT_AsnEncodeTimeStampTime(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    SYSTEMTIME sysTime;
+    char buf[32];
+    DWORD len;
+    BOOL ret;
+
+    if (!FileTimeToSystemTime(pvStructInfo, &sysTime))
+        return FALSE;
+    len = snprintf(buf, sizeof(buf), "%04d%02d%02d%02d%02d%02d", sysTime.wYear,
+     sysTime.wMonth, sysTime.wDay, sysTime.wHour, sysTime.wMinute,
+     sysTime.wSecond);
+    if (sysTime.wMilliseconds)
+    {
+        len += snprintf(buf + len, sizeof(buf) - len, ".%03d",
+         sysTime.wMilliseconds);
+        while (buf[len - 1] == '0')
+            len--;
+    }
+    buf[len++] = 'Z';
+    if (!pbEncoded)
+    {
+        *pcbEncoded = 2 + len;
+        return TRUE;
+    }
+    if ((ret = CRYPT_EncodeEnsureSpace(dwFlags, pEncodePara, pbEncoded,
+     pcbEncoded, 2 + len)))
+    {
+        if (dwFlags & CRYPT_ENCODE_ALLOC_FLAG)
+            pbEncoded = *(BYTE **)pbEncoded;
+        pbEncoded[0] = ASN_GENERALTIME;
+        pbEncoded[1] = len;
+        memcpy(pbEncoded + 2, buf, len);
+    }
+    return ret;
+}
+
+static BOOL WINAPI CRYPT_AsnEncodeTimeStampAccuracy(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    const CRYPT_TIMESTAMP_ACCURACY *accuracy = pvStructInfo;
+    struct AsnEncodeTagSwappedItem millis = { ASN_CONTEXT, &accuracy->dwMillis,
+     CRYPT_AsnEncodeInt };
+    struct AsnEncodeTagSwappedItem micros = { ASN_CONTEXT | 1,
+     &accuracy->dwMicros, CRYPT_AsnEncodeInt };
+    struct AsnEncodeSequenceItem items[3] = { { 0 } };
+    DWORD count = 0;
+
+    if (accuracy->dwSeconds)
+    {
+        items[count].pvStructInfo = &accuracy->dwSeconds;
+        items[count++].encodeFunc = CRYPT_AsnEncodeInt;
+    }
+    if (accuracy->dwMillis)
+    {
+        items[count].pvStructInfo = &millis;
+        items[count++].encodeFunc = CRYPT_AsnEncodeSwapTag;
+    }
+    if (accuracy->dwMicros)
+    {
+        items[count].pvStructInfo = &micros;
+        items[count++].encodeFunc = CRYPT_AsnEncodeSwapTag;
+    }
+    return CRYPT_AsnEncodeSequence(dwCertEncodingType, items, count, dwFlags,
+     pEncodePara, pbEncoded, pcbEncoded);
+}
+
+/* TSTInfo, what a time stamp token signs (RFC 3161) */
+static BOOL WINAPI CRYPT_AsnEncodeTimeStampInfo(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret;
+
+    __TRY
+    {
+        const CRYPT_TIMESTAMP_INFO *info = pvStructInfo;
+        struct AsnEncodeTagSwappedItem extensions = {
+         ASN_CONTEXT | ASN_CONSTRUCTOR | 1, &info->cExtension,
+         CRYPT_AsnEncodeExtensions };
+        struct AsnConstructedItem tsa = { 0, &info->Tsa, CRYPT_CopyEncodedBlob };
+        struct AsnEncodeSequenceItem items[10] = {
+         { &info->dwVersion,     CRYPT_AsnEncodeInt, 0 },
+         { info->pszTSAPolicyId, CRYPT_AsnEncodeOid, 0 },
+         { &info->HashAlgorithm, CRYPT_AsnEncodeMessageImprint, 0 },
+         { &info->SerialNumber,  CRYPT_AsnEncodeInteger, 0 },
+         { &info->ftTime,        CRYPT_AsnEncodeTimeStampTime, 0 },
+        };
+        DWORD count = 5;
+
+        if (info->pvAccuracy)
+        {
+            items[count].pvStructInfo = info->pvAccuracy;
+            items[count++].encodeFunc = CRYPT_AsnEncodeTimeStampAccuracy;
+        }
+        if (info->fOrdering)
+        {
+            items[count].pvStructInfo = &info->fOrdering;
+            items[count++].encodeFunc = CRYPT_AsnEncodeBool;
+        }
+        if (info->Nonce.cbData)
+        {
+            items[count].pvStructInfo = &info->Nonce;
+            items[count++].encodeFunc = CRYPT_AsnEncodeInteger;
+        }
+        if (info->Tsa.cbData)
+        {
+            items[count].pvStructInfo = &tsa;
+            items[count++].encodeFunc = CRYPT_AsnEncodeConstructed;
+        }
+        if (info->cExtension)
+        {
+            items[count].pvStructInfo = &extensions;
+            items[count++].encodeFunc = CRYPT_AsnEncodeSwapTag;
+        }
+        ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items, count,
+         dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+        ret = FALSE;
+    }
+    __ENDTRY
+    return ret;
+}
+
+/* TimeStampReq, a request for a time stamp (RFC 3161) */
+static BOOL WINAPI CRYPT_AsnEncodeTimeStampRequest(DWORD dwCertEncodingType,
+ LPCSTR lpszStructType, const void *pvStructInfo, DWORD dwFlags,
+ PCRYPT_ENCODE_PARA pEncodePara, BYTE *pbEncoded, DWORD *pcbEncoded)
+{
+    BOOL ret;
+
+    __TRY
+    {
+        const CRYPT_TIMESTAMP_REQUEST *request = pvStructInfo;
+        struct AsnEncodeTagSwappedItem extensions = {
+         ASN_CONTEXT | ASN_CONSTRUCTOR, &request->cExtension,
+         CRYPT_AsnEncodeExtensions };
+        struct AsnEncodeSequenceItem items[6] = {
+         { &request->dwVersion,     CRYPT_AsnEncodeInt, 0 },
+         { &request->HashAlgorithm, CRYPT_AsnEncodeMessageImprint, 0 },
+        };
+        DWORD count = 2;
+
+        if (request->pszTSAPolicyId)
+        {
+            items[count].pvStructInfo = request->pszTSAPolicyId;
+            items[count++].encodeFunc = CRYPT_AsnEncodeOid;
+        }
+        if (request->Nonce.cbData)
+        {
+            items[count].pvStructInfo = &request->Nonce;
+            items[count++].encodeFunc = CRYPT_AsnEncodeInteger;
+        }
+        if (request->fCertReq)
+        {
+            items[count].pvStructInfo = &request->fCertReq;
+            items[count++].encodeFunc = CRYPT_AsnEncodeBool;
+        }
+        if (request->cExtension)
+        {
+            items[count].pvStructInfo = &extensions;
+            items[count++].encodeFunc = CRYPT_AsnEncodeSwapTag;
+        }
+        ret = CRYPT_AsnEncodeSequence(dwCertEncodingType, items, count,
+         dwFlags, pEncodePara, pbEncoded, pcbEncoded);
+    }
+    __EXCEPT_PAGE_FAULT
+    {
+        SetLastError(STATUS_ACCESS_VIOLATION);
+        ret = FALSE;
+    }
+    __ENDTRY
+    return ret;
+}
+
 static CryptEncodeObjectExFunc CRYPT_GetBuiltinEncoder(DWORD dwCertEncodingType,
  LPCSTR lpszStructType)
 {
@@ -4819,6 +5020,12 @@ static CryptEncodeObjectExFunc CRYPT_GetBuiltinEncoder(DWORD dwCertEncodingType,
         case LOWORD(OCSP_SIGNED_REQUEST):
             encodeFunc = CRYPT_AsnEncodeOCSPSignedRequest;
             break;
+        case LOWORD(TIMESTAMP_REQUEST):
+            encodeFunc = CRYPT_AsnEncodeTimeStampRequest;
+            break;
+        case LOWORD(TIMESTAMP_INFO):
+            encodeFunc = CRYPT_AsnEncodeTimeStampInfo;
+            break;
         }
     }
     else if (!strcmp(lpszStructType, szOID_CERT_EXTENSIONS))
diff --git a/dlls/crypt32/tests/encode.c b/dlls/crypt32/tests/encode.c
index 2d714f71931..429e8fc009c 100644
--- a/dlls/crypt32/tests/encode.c
+++ b/dlls/crypt32/tests/encode.c
@@ -9068,6 +9068,288 @@ static void test_decodeOCSPBasicResponseInfo(DWORD dwEncoding)
     LocalFree(info);
 }
 
+/* RFC 3161 TSTInfo with each optional part on its own; the sizes are what
+ * Windows 11 decodes them into.  Windows makes room for the accuracy but
+ * leaves pvAccuracy NULL.
+ */
+static const BYTE tst_plain[] = {
+    0x30, 0x57, 0x02, 0x01, 0x01, 0x06, 0x03, 0x2a, 0x03, 0x04, 0x30, 0x31, 0x30, 0x0d, 0x06, 0x09,
+    0x60, 0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20, 0x11, 0x11, 0x11,
+    0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11,
+    0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x11, 0x02, 0x05, 0x01,
+    0x02, 0x03, 0x04, 0x05, 0x18, 0x13, 0x32, 0x30, 0x32, 0x33, 0x30, 0x37, 0x30, 0x33, 0x30, 0x37,
+    0x31, 0x34, 0x33, 0x34, 0x2e, 0x30, 0x37, 0x34, 0x5a,
