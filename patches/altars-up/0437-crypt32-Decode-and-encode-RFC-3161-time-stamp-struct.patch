+static void test_encodeTimeStampRequest(DWORD dwEncoding)
+{
+    static BYTE hash[32] = { 0x11 }, nonce[8] = { 1, 2, 3, 4, 5, 6, 7, 8 };
+    static const BYTE request_head[] = { 0x30, 0x43, 0x02, 0x01, 0x01, 0x30, 0x31, 0x30, 0x0d, 0x06, 0x09, 0x60,
+     0x86, 0x48, 0x01, 0x65, 0x03, 0x04, 0x02, 0x01, 0x05, 0x00, 0x04, 0x20, 0x11 };
+    static const BYTE request_tail[] = { 0x02, 0x08, 0x08, 0x07, 0x06, 0x05, 0x04, 0x03, 0x02, 0x01, 0x01, 0x01,
+     0xff };
+    static const BYTE policy_tail[] = { 0x06, 0x03, 0x2a, 0x03, 0x04, 0x02, 0x08, 0x08, 0x07, 0x06, 0x05, 0x04,
+     0x03, 0x02, 0x01 };
+    CRYPT_TIMESTAMP_REQUEST request = { 0 };
+    DWORD size;
+    BYTE *buf;
+    BOOL ret;
+
+    request.dwVersion = TIMESTAMP_VERSION;
+    request.HashAlgorithm.pszObjId = (char *)szOID_NIST_sha256;
+    request.HashedMessage.cbData = sizeof(hash);
+    request.HashedMessage.pbData = hash;
+    request.Nonce.cbData = sizeof(nonce);
+    request.Nonce.pbData = nonce;
+    request.fCertReq = TRUE;
+    ret = CryptEncodeObjectEx(dwEncoding, TIMESTAMP_REQUEST, &request, CRYPT_ENCODE_ALLOC_FLAG, NULL, &buf, &size);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    if (ret)
+    {
+        ok(size == 69, "got %lu bytes.\n", size);
+        ok(!memcmp(buf, request_head, sizeof(request_head)), "got a different start.\n");
+        ok(!memcmp(buf + size - sizeof(request_tail), request_tail, sizeof(request_tail)), "got a different end.\n");
+        LocalFree(buf);
+    }
+
+    /* a policy goes after the imprint; certReq FALSE, the default, is left out */
+    request.pszTSAPolicyId = (char *)"1.2.3.4";
+    request.fCertReq = FALSE;
+    ret = CryptEncodeObjectEx(dwEncoding, TIMESTAMP_REQUEST, &request, CRYPT_ENCODE_ALLOC_FLAG, NULL, &buf, &size);
+    ok(ret, "got error %#lx.\n", GetLastError());
+    if (ret)
+    {
+        ok(size == 71, "got %lu bytes.\n", size);
+        ok(!memcmp(buf + size - sizeof(policy_tail), policy_tail, sizeof(policy_tail)), "got a different end.\n");
+        LocalFree(buf);
+    }
+}
