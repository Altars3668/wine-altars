From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 11:02:33 -0400
Subject: [PATCH] vbscript: Pass on the error of the object that parsed
 GetObject's name, and of a factory under cscript.

Measured on Windows 11 build 29671 with tools/winmgmtsprobe (errors.vbs):
GetObject("winmgmts:\\.\root\nonesuch") is WMI's invalid namespace,
8004100E, and creating WbemScripting.SWbemLastError with no last error
is E_FAIL.  A name no moniker takes stays a syntax error, a class that
is not there or not allowed one that cannot be created, and so does any
under a host with a security manager, as the tests have it.  The class
factory CreateObject used is released.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/vbscript/global.c b/dlls/vbscript/global.c
index 20567c309f9..4bc89319308 100644
--- a/dlls/vbscript/global.c
+++ b/dlls/vbscript/global.c
@@ -527,7 +527,9 @@ static HRESULT set_object_site(script_ctx_t *ctx, IUnknown *obj)
     return hres;
 }
 
-static IUnknown *create_object(script_ctx_t *ctx, const WCHAR *progid)
+/* a class that is not there, or not allowed, cannot be created; one that fails to create an object gives its own
+ * error, as SWbemLastError's E_FAIL under cscript (tools/winmgmtsprobe, errors.vbs) */
+static IUnknown *create_object(script_ctx_t *ctx, const WCHAR *progid, HRESULT *error)
 {
     IInternetHostSecurityManager *secmgr = NULL;
     struct CONFIRMSAFETY cs;
@@ -540,6 +542,7 @@ static IUnknown *create_object(script_ctx_t *ctx, const WCHAR *progid)
     GUID guid;
     HRESULT hres;
 
+    *error = VB_E_CANNOT_CREATE_OBJ;
     hres = CLSIDFromProgID(progid, &guid);
     if(FAILED(hres))
         return NULL;
@@ -569,8 +572,13 @@ static IUnknown *create_object(script_ctx_t *ctx, const WCHAR *progid)
     }
 
     hres = IClassFactory_CreateInstance(cf, NULL, &IID_IUnknown, (void**)&obj);
-    if(FAILED(hres))
+    IClassFactory_Release(cf);
+    if(FAILED(hres)) {
+        /* a host with a security manager hears only that it could not be created */
+        if(!secmgr)
+            *error = hres;
         return NULL;
+    }
 
     if(secmgr) {
         cs.clsid = guid;
@@ -595,6 +603,7 @@ static IUnknown *create_object(script_ctx_t *ctx, const WCHAR *progid)
         return NULL;
     }
 
+    *error = S_OK;
     return obj;
 }
 
@@ -2886,9 +2895,9 @@ static HRESULT Global_CreateObject(BuiltinDisp *This, VARIANT *arg, unsigned arg
     if(!SysStringLen(V_BSTR(arg)))
         return MAKE_VBSERROR(VBSE_ILLEGAL_FUNC_CALL);
 
-    obj = create_object(This->ctx, V_BSTR(arg));
+    obj = create_object(This->ctx, V_BSTR(arg), &hres);
     if(!obj)
-        return VB_E_CANNOT_CREATE_OBJ;
+        return hres;
 
     if(res) {
         hres = IUnknown_QueryInterface(obj, &IID_IDispatch, (void**)&V_DISPATCH(res));
@@ -2937,8 +2946,8 @@ static HRESULT get_object_of_class(BuiltinDisp *This, VARIANT *path, VARIANT *cl
             if(FAILED(hres))
                 IUnknown_Release(obj_unk);
         }
-    }else if(!(obj_unk = create_object(This->ctx, progid))) {
-        hres = VB_E_CANNOT_CREATE_OBJ;
+    }else if(!(obj_unk = create_object(This->ctx, progid, &hres))) {
+        /* hres says why */
     }else if(SysStringLen(file)) {
         hres = IUnknown_QueryInterface(obj_unk, &IID_IPersistFile, (void**)&persist_file);
         if(SUCCEEDED(hres)) {
@@ -2993,11 +3002,13 @@ static HRESULT Global_GetObject(BuiltinDisp *This, VARIANT *args, unsigned args_
         if(FAILED(hres))
             return hres;
 
+        /* a name no moniker takes is a syntax error; the error of the object that parsed it goes to the script as it
+         * is, WMI's invalid namespace say (tools/winmgmtsprobe, errors.vbs) */
         hres = MkParseDisplayName(bind_ctx, V_BSTR(args), &eaten, &mon);
         if(SUCCEEDED(hres)) {
             hres = IMoniker_BindToObject(mon, bind_ctx, NULL, &IID_IUnknown, (void**)&obj_unk);
             IMoniker_Release(mon);
-        }else {
+        }else if(hres >= MK_E_FIRST && hres <= MK_E_LAST) {
             hres = MK_E_SYNTAX;
         }
         IBindCtx_Release(bind_ctx);
