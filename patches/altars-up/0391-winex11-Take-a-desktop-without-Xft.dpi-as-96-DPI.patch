From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 00:17:16 -0400
Subject: [PATCH] winex11: Take a desktop without Xft.dpi as 96 DPI.

X clients draw at 96 where the desktop sets no Xft.dpi.  Falling back to the system DPI instead
kept whatever DPI an earlier desktop had stored as the hardware profile's: a prefix used once on a
desktop at 200% stayed at 192 on one that says nothing.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/winex11.drv/display.c b/dlls/winex11.drv/display.c
index 83adefeca34..d37c501120d 100644
--- a/dlls/winex11.drv/display.c
+++ b/dlls/winex11.drv/display.c
@@ -273,16 +273,19 @@ static void set_default_dpi( UINT dpi )
     NtClose( hkey );
 }
 
-/* the DPI of the monitors: the desktop's, unless the user set one */
+/* the DPI of the monitors: the desktop's, unless the user set one; X clients draw at 96 where the
+ * desktop says nothing, and so does a desktop that stops saying anything, rather than keeping what
+ * another one said */
 static UINT get_monitor_dpi(void)
 {
+    UINT dpi;
+
     host_dpi = read_host_dpi();
-    if (host_dpi && !user_set_dpi())
-    {
-        set_default_dpi( host_dpi );
-        return host_dpi;
-    }
-    return NtUserGetSystemDpiForProcess( NULL );
+    if (user_set_dpi()) return NtUserGetSystemDpiForProcess( NULL );
+
+    dpi = host_dpi ? host_dpi : USER_DEFAULT_SCREEN_DPI;
+    set_default_dpi( dpi );
+    return dpi;
 }
 
 /* the root window's resource database changed: if Xft.dpi did, the desktop rescans the monitors */
