-static BOOL d2d_clip_stack_push(struct d2d_clip_stack *stack, const D2D1_RECT_F *rect)
+/* Each edge of the intersection is the one of the clip it comes from, antialiased or not as that clip is. */
+static BOOL d2d_clip_stack_push(struct d2d_clip_stack *stack, const D2D1_RECT_F *rect, BOOL antialias)
 {
+    unsigned char edges = antialias ? 0xf : 0;
+    const D2D1_RECT_F *prev;
     D2D1_RECT_F r;
 
-    if (!d2d_array_reserve((void **)&stack->stack, &stack->size, stack->count + 1, sizeof(*stack->stack)))
+    if (!d2d_array_reserve((void **)&stack->stack, &stack->size, stack->count + 1, sizeof(*stack->stack))
+            || !d2d_array_reserve((void **)&stack->edges, &stack->edges_size, stack->count + 1,
+            sizeof(*stack->edges)))
         return FALSE;
 
     r = *rect;
     if (stack->count)
-        d2d_rect_intersect(&r, &stack->stack[stack->count - 1]);
+    {
+        prev = &stack->stack[stack->count - 1];
+        if (prev->left >= r.left)
+            edges = (edges & ~0x1) | (stack->edges[stack->count - 1] & 0x1);
+        if (prev->top >= r.top)
+            edges = (edges & ~0x2) | (stack->edges[stack->count - 1] & 0x2);
+        if (prev->right <= r.right)
