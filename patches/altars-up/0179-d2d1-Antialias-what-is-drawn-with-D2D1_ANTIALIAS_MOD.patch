+/* The primitive drawn as the rectangle of its mask, each pixel as much of the brush as the mask covers of it. */
+static void d2d_device_context_cover(struct d2d_device_context *context, const struct d2d_coverage_pass *mask,
+        struct d2d_brush *brush, struct d2d_brush *opacity_brush)
+{
+    struct d2d_coverage_pass pass = *mask;
+    D2D1_MATRIX_3X2_F m, to_world, quad;
+
+    pass.coverage = D2D_COVERAGE_COVER;
+    d2d_device_context_get_device_transform(context, &m);
+    if (!d2d_matrix_invert(&to_world, &m))
+        return;
+    /* The unit quad's corners at ±1 go to the corners of the mask's pixels, and from there to the world. */
+    quad._11 = (pass.bounds.right - pass.bounds.left) / 2.0f;
+    quad._12 = 0.0f;
+    quad._21 = 0.0f;
+    quad._22 = (pass.bounds.bottom - pass.bounds.top) / 2.0f;
+    quad._31 = (pass.bounds.left + pass.bounds.right) / 2.0f;
+    quad._32 = (pass.bounds.top + pass.bounds.bottom) / 2.0f;
+    d2d_matrix_multiply(&quad, &to_world);
+
+    if (FAILED(d2d_device_context_update_vs_cb(context, &quad, 0.0f, 0.0f, FALSE))
+            || FAILED(d2d_device_context_update_ps_cb(context, brush, opacity_brush, FALSE, FALSE, FALSE, &pass)))
+        return;
+    d2d_device_context_draw(context, D2D_SHAPE_TYPE_TRIANGLE, context->ib, 6, context->vb, context->vb_stride,
+            brush, opacity_brush, &pass);
+}
