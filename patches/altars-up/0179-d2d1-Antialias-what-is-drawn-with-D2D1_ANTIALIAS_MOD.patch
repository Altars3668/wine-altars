 }
 
+/* An antialiased primitive is drawn into a multisampled mask of what it covers, then as a rectangle through the
+ * mask; "bounds" are the pixels of the target the mask stands for. */
+struct d2d_coverage_pass
+{
+    enum d2d_coverage coverage;
+    RECT bounds;
+};
+
+static void d2d_device_context_release_coverage(struct d2d_device_context *context)
+{
+    if (context->coverage.srv)
+        ID3D11ShaderResourceView_Release(context->coverage.srv);
+    if (context->coverage.rtv)
+        ID3D11RenderTargetView_Release(context->coverage.rtv);
+    if (context->coverage.texture)
+        ID3D11Texture2D_Release(context->coverage.texture);
+    context->coverage.srv = NULL;
+    context->coverage.rtv = NULL;
+    context->coverage.texture = NULL;
+    context->coverage.size.width = context->coverage.size.height = 0;
+}
+
+/* The pixels drawing reaches: those whose centres the clip keeps, and, unless "centres" says otherwise, those an
+ * antialiased edge of it crosses; else the whole target. */
+static void d2d_device_context_get_scissor(const struct d2d_device_context *context, RECT *rect, BOOL centres)
+{
+    const D2D1_RECT_F *clip_rect;
+    unsigned char edges;
+
+    if (context->clip_stack.count)
+    {
+        clip_rect = &context->clip_stack.stack[context->clip_stack.count - 1];
+        edges = centres ? 0 : context->clip_stack.edges[context->clip_stack.count - 1];
+        rect->left = edges & 0x1 ? floorf(clip_rect->left) : ceilf(clip_rect->left - 0.5f);
+        rect->top = edges & 0x2 ? floorf(clip_rect->top) : ceilf(clip_rect->top - 0.5f);
+        rect->right = edges & 0x4 ? ceilf(clip_rect->right) : ceilf(clip_rect->right - 0.5f);
+        rect->bottom = edges & 0x8 ? ceilf(clip_rect->bottom) : ceilf(clip_rect->bottom - 0.5f);
+    }
+    else
+    {
+        rect->left = 0;
+        rect->top = 0;
+        rect->right = context->pixel_size.width;
+        rect->bottom = context->pixel_size.height;
+    }
+}
