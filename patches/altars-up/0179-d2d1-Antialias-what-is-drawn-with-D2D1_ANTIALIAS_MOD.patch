+BOOL d2d_geometry_get_rectangle(const struct d2d_geometry *geometry, D2D1_RECT_F *rect)
+{
+    if (geometry->ID2D1Geometry_iface.lpVtbl != (const ID2D1GeometryVtbl *)&d2d_rectangle_geometry_vtbl)
+        return FALSE;
+    *rect = geometry->u.rectangle.rect;
+    return TRUE;
+}
