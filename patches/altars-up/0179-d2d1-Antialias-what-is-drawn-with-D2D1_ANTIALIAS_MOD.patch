index 3c0f29e222d..604e6a19a23 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -62,11 +62,15 @@ struct d2d_settings
 };
 extern struct d2d_settings d2d_settings;
 
+/* Axis-aligned clips, each the intersection of those before; "edges" says which of an intersection's left, top,
+ * right and bottom edges (bits 0 to 3) come from a clip pushed antialiased. */
 struct d2d_clip_stack
 {
     D2D1_RECT_F *stack;
     size_t size;
     size_t count;
+    unsigned char *edges;
+    size_t edges_size;
 };
 
 struct d2d_error_state
@@ -130,12 +134,26 @@ struct d2d_brush_cb
     } u;
 };
 
+/* How a draw counts what a shape covers: drawn straight to the target, where the shaders' tests keep a pixel's
+ * centre; into a multisampled mask of what an antialiased primitive covers; or through such a mask. */
+enum d2d_coverage
+{
+    D2D_COVERAGE_SHAPE,
+    D2D_COVERAGE_MASK,
+    D2D_COVERAGE_COVER,
+};
+
 struct d2d_ps_cb
 {
     BOOL outline;
     BOOL is_arc;
     BOOL round_joins;
-    BOOL pad;
+    enum d2d_coverage coverage;
+    int mask_offset[2];
+    unsigned int sample_count;
+    /* the edges of the clip that are antialiased, and where the clip is */
+    unsigned int clip_edges;
+    D2D1_RECT_F clip;
     struct d2d_brush_cb colour_brush;
     struct d2d_brush_cb opacity_brush;
 };
@@ -240,6 +258,18 @@ struct d2d_device_context
     struct d2d_shape_resources shape_resources[D2D_SHAPE_TYPE_COUNT];
     ID3D11Buffer *vs_cb;
     ID3D11PixelShader *ps;
+    /* What an antialiased primitive covers is drawn here first, made when first wanted and grown as needed,
+     * with a blend state that keeps the most any part covers; "sample_count" is 0 until looked up, and 1 where
+     * multisampling is not to be had. */
+    struct
+    {
+        ID3D11Texture2D *texture;
+        ID3D11RenderTargetView *rtv;
+        ID3D11ShaderResourceView *srv;
+        ID3D11BlendState *bs;
+        D2D1_SIZE_U size;
+        unsigned int sample_count;
+    } coverage;
     ID3D11Buffer *ps_cb;
     ID3D11Buffer *ib;
     unsigned int vb_stride;
@@ -829,6 +859,7 @@ void d2d_transformed_geometry_init(struct d2d_geometry *geometry, ID2D1Factory *
