-static void d2d_device_context_draw_geometry(struct d2d_device_context *render_target,
+/* The transform from the world to the target's pixels. */
+static void d2d_device_context_get_device_transform(const struct d2d_device_context *context,
+        D2D1_MATRIX_3X2_F *m)
+{
+    const D2D1_MATRIX_3X2_F *w = &context->drawing_state.transform;
+    float scale_x = context->desc.dpiX / 96.0f, scale_y = context->desc.dpiY / 96.0f;
+
+    m->_11 = w->_11 * scale_x;
+    m->_21 = w->_21 * scale_x;
+    m->_31 = w->_31 * scale_x;
+    m->_12 = w->_12 * scale_y;
+    m->_22 = w->_22 * scale_y;
+    m->_32 = w->_32 * scale_y;
+}
+
+/* A mask of at least "width" by "height" pixels, with as many samples as the device allows, up to eight. */
+static BOOL d2d_device_context_get_coverage(struct d2d_device_context *context, unsigned int width,
+        unsigned int height)
+{
+    static const unsigned int sample_counts[] = {8, 4, 2};
+    D3D11_TEXTURE2D_DESC desc;
+    unsigned int i;
+    UINT levels;
+    HRESULT hr;
+
+    if (!context->coverage.sample_count)
+    {
+        context->coverage.sample_count = 1;
+        for (i = 0; i < ARRAY_SIZE(sample_counts); ++i)
+        {
+            if (SUCCEEDED(ID3D11Device1_CheckMultisampleQualityLevels(context->d3d_device, DXGI_FORMAT_R8_UNORM,
+                    sample_counts[i], &levels)) && levels)
+            {
+                context->coverage.sample_count = sample_counts[i];
+                break;
+            }
+        }
+        TRACE("Antialiasing with %u samples a pixel.\n", context->coverage.sample_count);
+    }
+    if (context->coverage.sample_count < 2)
+        return FALSE;
+    if (!context->coverage.bs)
+    {
+        D3D11_BLEND_DESC blend_desc;
+
+        memset(&blend_desc, 0, sizeof(blend_desc));
+        blend_desc.RenderTarget[0].BlendEnable = TRUE;
+        blend_desc.RenderTarget[0].SrcBlend = D3D11_BLEND_ONE;
+        blend_desc.RenderTarget[0].DestBlend = D3D11_BLEND_ONE;
+        blend_desc.RenderTarget[0].BlendOp = D3D11_BLEND_OP_MAX;
+        blend_desc.RenderTarget[0].SrcBlendAlpha = D3D11_BLEND_ONE;
+        blend_desc.RenderTarget[0].DestBlendAlpha = D3D11_BLEND_ONE;
+        blend_desc.RenderTarget[0].BlendOpAlpha = D3D11_BLEND_OP_MAX;
+        blend_desc.RenderTarget[0].RenderTargetWriteMask = D3D11_COLOR_WRITE_ENABLE_ALL;
+        if (FAILED(hr = ID3D11Device1_CreateBlendState(context->d3d_device, &blend_desc, &context->coverage.bs)))
+        {
+            ERR("Failed to create the coverage blend state, hr %#lx; not antialiasing.\n", hr);
+            context->coverage.sample_count = 1;
+            return FALSE;
+        }
+    }
+    if (context->coverage.texture && context->coverage.size.width >= width && context->coverage.size.height >= height)
+        return TRUE;
+
+    width = (max(width, context->coverage.size.width) + 255) & ~255u;
+    height = (max(height, context->coverage.size.height) + 255) & ~255u;
+    if (width > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION || height > D3D11_REQ_TEXTURE2D_U_OR_V_DIMENSION)
+        return FALSE;
+    d2d_device_context_release_coverage(context);
+
+    desc.Width = width;
+    desc.Height = height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = DXGI_FORMAT_R8_UNORM;
+    desc.SampleDesc.Count = context->coverage.sample_count;
+    desc.SampleDesc.Quality = 0;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    desc.CPUAccessFlags = 0;
+    desc.MiscFlags = 0;
+    if (FAILED(hr = ID3D11Device1_CreateTexture2D(context->d3d_device, &desc, NULL, &context->coverage.texture))
+            || FAILED(hr = ID3D11Device1_CreateRenderTargetView(context->d3d_device,
+            (ID3D11Resource *)context->coverage.texture, NULL, &context->coverage.rtv))
+            || FAILED(hr = ID3D11Device1_CreateShaderResourceView(context->d3d_device,
+            (ID3D11Resource *)context->coverage.texture, NULL, &context->coverage.srv)))
+    {
+        ERR("Failed to create a %ux%u coverage mask, hr %#lx; not antialiasing.\n", width, height, hr);
+        d2d_device_context_release_coverage(context);
+        context->coverage.sample_count = 1;
+        return FALSE;
+    }
+    context->coverage.size.width = width;
+    context->coverage.size.height = height;
+    return TRUE;
+}
+
+/* Whether the geometry, filled, or stroked "stroke_width" wide in "style", is drawn antialiased through a mask
+ * of what it covers; if so, the mask is cleared over the pixels it may. */
+static BOOL d2d_device_context_begin_coverage(struct d2d_device_context *context,
+        const struct d2d_geometry *geometry, BOOL stroke, float stroke_width, const struct d2d_stroke_style *style,
+        struct d2d_coverage_pass *pass)
+{
+    static const float transparent[4];
+    ID3D11DeviceContext1 *d3d_context;
+    D2D1_RECT_F bounds, rect;
+    D2D1_MATRIX_3X2_F m;
+    RECT scissor, clear;
+    HRESULT hr;
+
+    if (context->drawing_state.antialiasMode != D2D1_ANTIALIAS_MODE_PER_PRIMITIVE
+            || context->target.type != D2D_TARGET_BITMAP)
+        return FALSE;
