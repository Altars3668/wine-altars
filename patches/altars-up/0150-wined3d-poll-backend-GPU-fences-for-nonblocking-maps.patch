diff --git a/dlls/wined3d/adapter_vk.c b/dlls/wined3d/adapter_vk.c
index 3e349247899..4a3f5223afb 100644
--- a/dlls/wined3d/adapter_vk.c
+++ b/dlls/wined3d/adapter_vk.c
@@ -902,7 +902,7 @@ VkPipelineStageFlags vk_pipeline_stage_mask_from_buffer_usage(VkBufferUsageFlags
 }
 
 static void *adapter_vk_map_bo_address(struct wined3d_context *context,
-        const struct wined3d_bo_address *data, size_t size, uint32_t map_flags)
+        const struct wined3d_bo_address *data, size_t size, uint32_t map_flags, HRESULT *hr)
 {
     struct wined3d_context_vk *context_vk = wined3d_context_vk(context);
     const struct wined3d_vk_info *vk_info;
@@ -912,8 +912,13 @@ static void *adapter_vk_map_bo_address(struct wined3d_context *context,
     struct wined3d_bo_user *bo_user;
     struct wined3d_bo_vk *bo, tmp;
     VkMappedMemoryRange range;
+    HRESULT result;
     void *map_ptr;
+    VkResult vr;
+    SIZE_T i;
 
+    if (!hr) hr = &result;
+    *hr = S_OK;
     if (!data->buffer_object)
         return data->addr;
     bo = wined3d_bo_vk(data->buffer_object);
@@ -947,11 +952,12 @@ static void *adapter_vk_map_bo_address(struct wined3d_context *context,
 
     if (map_flags & WINED3D_MAP_READ)
     {
-        if (!bo->host_synced)
+        if (!bo->host_synced && bo->command_buffer_id != bo->host_read_barrier_id)
         {
             if (!(vk_command_buffer = wined3d_context_vk_get_command_buffer(context_vk)))
             {
                 ERR("Failed to get command buffer.\n");
+                *hr = E_OUTOFMEMORY;
                 return NULL;
             }
 
@@ -970,30 +976,55 @@ static void *adapter_vk_map_bo_address(struct wined3d_context *context,
                     VK_PIPELINE_STAGE_HOST_BIT, 0, 0, NULL, 1, &vk_barrier, 0, NULL));
 
             wined3d_context_vk_reference_bo(context_vk, bo);
-        }
-
-        if (!bo->b.coherent)
-        {
-            range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
-            range.pNext = NULL;
-            range.memory = bo->vk_memory;
-            range.offset = bo->b.memory_offset + (uintptr_t)data->addr;
-            range.size = size;
-            VK_CALL(vkInvalidateMappedMemoryRanges(device_vk->vk_device, 1, &range));
+            bo->host_read_barrier_id = bo->command_buffer_id;
         }
     }
 
     if (bo->command_buffer_id == context_vk->current_command_buffer.id)
         wined3d_context_vk_submit_command_buffer(context_vk, 0, NULL, NULL, 0, NULL);
+
+    if ((map_flags & WINED3D_MAP_DONOTWAIT)
+            && bo->command_buffer_id > context_vk->completed_command_buffer_id)
+    {
+        for (i = 0; i < context_vk->submitted.buffer_count; ++i)
+        {
+            if (context_vk->submitted.buffers[i].id != bo->command_buffer_id)
+                continue;
+            vr = VK_CALL(vkGetFenceStatus(device_vk->vk_device, context_vk->submitted.buffers[i].vk_fence));
+            if (vr != VK_SUCCESS)
+            {
+                TRACE("Nonblocking map of bo %p got GPU fence status %s.\n", bo, wined3d_debug_vkresult(vr));
+                *hr = vr == VK_NOT_READY ? DXGI_ERROR_WAS_STILL_DRAWING : E_FAIL;
+                return NULL;
+            }
+            break;
+        }
+        if (i == context_vk->submitted.buffer_count)
+        {
+            *hr = DXGI_ERROR_WAS_STILL_DRAWING;
+            return NULL;
+        }
+    }
     wined3d_context_vk_wait_command_buffer(context_vk, bo->command_buffer_id);
 
 map:
     if (!(map_ptr = wined3d_bo_vk_map(bo, context_vk)))
     {
         ERR("Failed to map bo.\n");
+        *hr = E_OUTOFMEMORY;
         return NULL;
     }
 
+    if ((map_flags & WINED3D_MAP_READ) && !bo->b.coherent)
+    {
+        range.sType = VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE;
+        range.pNext = NULL;
+        range.memory = bo->vk_memory;
+        range.offset = bo->b.memory_offset + (uintptr_t)data->addr;
+        range.size = size;
+        VK_CALL(vkInvalidateMappedMemoryRanges(device_vk->vk_device, 1, &range));
+    }
+
     return (uint8_t *)map_ptr + bo->b.memory_offset + (uintptr_t)data->addr;
 }
 
@@ -1162,8 +1193,8 @@ void adapter_vk_copy_bo_address(struct wined3d_context *context,
         return;
     }
 
-    src_ptr = adapter_vk_map_bo_address(context, src, size, WINED3D_MAP_READ);
-    dst_ptr = adapter_vk_map_bo_address(context, dst, size, map_flags);
+    src_ptr = adapter_vk_map_bo_address(context, src, size, WINED3D_MAP_READ, NULL);
+    dst_ptr = adapter_vk_map_bo_address(context, dst, size, map_flags, NULL);
 
     for (i = 0; i < range_count; ++i)
         memcpy(dst_ptr + ranges[i].offset, src_ptr + ranges[i].offset, ranges[i].size);
