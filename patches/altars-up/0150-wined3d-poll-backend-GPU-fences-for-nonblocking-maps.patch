From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 00:02:14 -0400
Subject: [PATCH] wined3d: poll backend GPU fences for nonblocking maps

Propagate busy Map results without claiming a mapping, track Vulkan host-read barriers across retries, and cover retry and data integrity with D3D11 tests.

Co-Authored-By: Claude Code <noreply@anthropic.com>
(cherry picked from commit c95e723c36c8564df98ca9176a24e1c47ba96c83)

diff --git a/dlls/d3d11/tests/d3d11.c b/dlls/d3d11/tests/d3d11.c
index 67406b6ee23..26efad8988b 100644
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -15595,12 +15595,15 @@ static void test_map_do_not_wait(void)
 {
     D3D11_TEXTURE2D_DESC texture_desc = {0};
     D3D11_BUFFER_DESC buffer_desc = {0};
+    D3D11_SUBRESOURCE_DATA data = {0};
     D3D11_MAPPED_SUBRESOURCE mapped;
     ID3D11DeviceContext *context;
-    ID3D11Texture2D *texture;
+    ID3D11Texture2D *texture, *source, *staging;
+    DWORD pixels[64 * 64];
     ID3D11Buffer *buffer;
     ID3D11Device *device;
     HRESULT hr;
+    unsigned int i;
 
     if (!(device = create_device(NULL)))
     {
@@ -15653,6 +15656,58 @@ static void test_map_do_not_wait(void)
         if (SUCCEEDED(hr)) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)texture, 0);
         ID3D11Texture2D_Release(texture);
     }
+
+    for (i = 0; i < ARRAY_SIZE(pixels); ++i)
+        pixels[i] = 0x12345678;
+    data.pSysMem = pixels;
+    data.SysMemPitch = sizeof(pixels[0]) * texture_desc.Width;
+    texture_desc.Usage = D3D11_USAGE_DEFAULT;
+    texture_desc.CPUAccessFlags = 0;
+    hr = ID3D11Device_CreateTexture2D(device, &texture_desc, &data, &source);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        texture_desc.Usage = D3D11_USAGE_STAGING;
+        texture_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+        hr = ID3D11Device_CreateTexture2D(device, &texture_desc, NULL, &staging);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)staging, (ID3D11Resource *)source);
+            ID3D11DeviceContext_Flush(context);
+            mapped.pData = (void *)0xdeadbeef;
+            hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ,
+                                        D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+            ok(hr == S_OK || hr == DXGI_ERROR_WAS_STILL_DRAWING, "Got hr %#lx.\n", hr);
+            for (i = 0; i < 4 && hr == DXGI_ERROR_WAS_STILL_DRAWING; ++i)
+            {
+                ok(!mapped.pData, "Got data %p after busy.\n", mapped.pData);
+                Sleep(1);
+                mapped.pData = (void *)0xdeadbeef;
+                hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ,
+                                            D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+                ok(hr == S_OK || hr == DXGI_ERROR_WAS_STILL_DRAWING, "Retry returned %#lx.\n", hr);
+            }
+            if (hr == DXGI_ERROR_WAS_STILL_DRAWING)
+            {
+                ok(!mapped.pData, "Got data %p after busy.\n", mapped.pData);
+                hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &mapped);
+                ok(hr == S_OK, "Blocking map returned %#lx after busy.\n", hr);
+            }
+            if (SUCCEEDED(hr))
+            {
+                ok(mapped.pData && *(DWORD *)mapped.pData == pixels[0], "Got data %p.\n", mapped.pData);
+                ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+            }
+            mapped.pData = (void *)0xdeadbeef;
+            hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ,
+                                        D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+            ok(hr == S_OK && mapped.pData, "Idle map returned %#lx, data %p.\n", hr, mapped.pData);
+            if (SUCCEEDED(hr)) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+            ID3D11Texture2D_Release(staging);
+        }
+        ID3D11Texture2D_Release(source);
+    }
     ID3D11DeviceContext_Release(context);
     ID3D11Device_Release(device);
 }
