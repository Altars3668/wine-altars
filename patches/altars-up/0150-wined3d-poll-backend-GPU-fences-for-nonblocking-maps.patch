+    if ((flags & WINED3D_MAP_DONOTWAIT) && context_gl->c.d3d_info->fences
+            && bo->command_fence_id > device_gl->completed_fence_id)
+    {
+        if (bo->command_fence_id == device_gl->current_fence_id)
+            wined3d_context_gl_submit_command_fence(context_gl);
+        /* Without a flush, repeated zero-time fence polls may never observe progress. */
