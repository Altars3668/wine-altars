From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 13:46:54 -0400
Subject: [PATCH] dwrite: Let an installed free math font stand in for Cambria
 Math too.

win32u maps Cambria Math to the first free font with a MATH table that
is installed, but DirectWrite reads only the replacements in the
registry, so Word found Cambria Math through GDI and not through
DirectWrite.  Exporting a PDF, it asks DirectWrite for the font's
PostScript name, and failing that it named the embedded subset of
DejaVu Math TeX Gyre "Cambria Math".  The system collection now takes
the same replacement, after those in the registry and also when there
is no Replacements key at all.  Word's PDF names the subset by the
font that is in it, and draws the same pixels.

The tests check that Cambria Math, if GDI or DirectWrite has it, has a
MATH table, and on Wine that it is there whenever one of the free math
fonts is.  They pass on Windows and fail nine times each on Wine with
the replacements turned off.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 5a8ec28c57f04fa20e67038791943ee46ee790f4)

diff --git a/dlls/dwrite/font.c b/dlls/dwrite/font.c
index fc1bc25a508..a4a22541ebb 100644
--- a/dlls/dwrite/font.c
+++ b/dlls/dwrite/font.c
@@ -4629,9 +4629,29 @@ static BOOL fontcollection_add_replacement(struct dwrite_fontcollection *collect
     return TRUE;
 }
 
+/* Word lays out equations with the OpenType MATH table of "Cambria Math", which Windows ships.
+   Without a replacement it gets a font with no MATH table and draws nothing; win32u maps the
+   name to the same free fonts in the same order. */
+static void fontcollection_add_default_replacements(struct dwrite_fontcollection *collection)
+{
+    static const WCHAR *math_fonts[] =
+    {
+        L"DejaVu Math TeX Gyre", L"STIX Two Math", L"Latin Modern Math", L"TeX Gyre Termes Math",
+        L"TeX Gyre Pagella Math", L"TeX Gyre Bonum Math", L"TeX Gyre Schola Math", L"TeX Gyre DejaVu Math",
+        L"Libertinus Math", L"XITS Math", L"Asana Math", L"Fira Math",
+    };
+    unsigned int i;
+
+    if (getenv("CX_TURN_OFF_FONT_REPLACEMENTS")) return;
+    if (collection_find_family(collection, L"Cambria Math") != ~0u) return;
+
+    for (i = 0; i < ARRAY_SIZE(math_fonts); ++i)
+        if (fontcollection_add_replacement(collection, L"Cambria Math", math_fonts[i])) break;
+}
+
 /* Add family mappings from HKCU\Software\Wine\Fonts\Replacements. This only affects
    system font collections. */
-static void fontcollection_add_replacements(struct dwrite_fontcollection *collection)
+static void fontcollection_add_registry_replacements(struct dwrite_fontcollection *collection)
 {
     DWORD max_namelen, max_datalen, i = 0, type, datalen, namelen;
     WCHAR *name;
@@ -4677,6 +4697,12 @@ static void fontcollection_add_replacements(struct dwrite_fontcollection *collec
     RegCloseKey(hkey);
 }
 
+static void fontcollection_add_replacements(struct dwrite_fontcollection *collection)
+{
+    fontcollection_add_registry_replacements(collection);
+    fontcollection_add_default_replacements(collection);
+}
+
 HRESULT create_font_collection(IDWriteFactory7 *factory, IDWriteFontFileEnumerator *enumerator, IDWriteFontCollection3 **ret)
 {
     struct fontfile_enum {
diff --git a/dlls/dwrite/tests/font.c b/dlls/dwrite/tests/font.c
index fafb040aaed..bd5a510bbe8 100644
--- a/dlls/dwrite/tests/font.c
+++ b/dlls/dwrite/tests/font.c
@@ -50,6 +50,7 @@
 #define MS_SBIX_TAG DWRITE_MAKE_OPENTYPE_TAG('s','b','i','x')
 #define MS_MAXP_TAG DWRITE_MAKE_OPENTYPE_TAG('m','a','x','p')
 #define MS_CBLC_TAG DWRITE_MAKE_OPENTYPE_TAG('C','B','L','C')
+#define MS_MATH_TAG DWRITE_MAKE_OPENTYPE_TAG('M','A','T','H')
 
 /* 'sbix' formats */
 #define MS_PNG__TAG DWRITE_MAKE_OPENTYPE_TAG('p','n','g',' ')
@@ -2692,6 +2693,70 @@ static void test_system_fontcollection(void)
     ok(!ref, "Factory wasn't released, %lu.\n", ref);
 }
 
+static void test_math_font(void)
+{
+    /* Free fonts with a MATH table that Wine lets stand in for Cambria Math. */
+    static const WCHAR *math_fonts[] =
+    {
+        L"DejaVu Math TeX Gyre", L"STIX Two Math", L"Latin Modern Math", L"TeX Gyre Termes Math",
+        L"TeX Gyre Pagella Math", L"TeX Gyre Bonum Math", L"TeX Gyre Schola Math", L"TeX Gyre DejaVu Math",
+        L"Libertinus Math", L"XITS Math", L"Asana Math", L"Fira Math",
+    };
+    IDWriteFontCollection *collection;
+    IDWriteFontFamily *family;
+    IDWriteFontFace *fontface;
+    IDWriteFactory *factory;
+    IDWriteFont *font;
+    UINT32 index, size;
+    const void *data;
+    void *context;
+    unsigned int i;
+    BOOL exists;
+    HRESULT hr;
+
+    factory = create_factory();
+    hr = IDWriteFactory_GetSystemFontCollection(factory, &collection, FALSE);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* Word lays out equations with the MATH table of Cambria Math. */
+    exists = FALSE;
+    hr = IDWriteFontCollection_FindFamilyName(collection, L"Cambria Math", &index, &exists);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (!exists)
+    {
+        for (i = 0; i < ARRAY_SIZE(math_fonts); ++i)
+        {
+            hr = IDWriteFontCollection_FindFamilyName(collection, math_fonts[i], &index, &exists);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            ok(!exists, "%s is installed, but not Cambria Math.\n", wine_dbgstr_w(math_fonts[i]));
+        }
+        skip("Cambria Math is not installed.\n");
+        IDWriteFontCollection_Release(collection);
+        IDWriteFactory_Release(factory);
+        return;
+    }
+
+    hr = IDWriteFontCollection_GetFontFamily(collection, index, &family);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IDWriteFontFamily_GetFirstMatchingFont(family, DWRITE_FONT_WEIGHT_NORMAL, DWRITE_FONT_STRETCH_NORMAL,
+            DWRITE_FONT_STYLE_NORMAL, &font);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IDWriteFont_CreateFontFace(font, &fontface);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    exists = FALSE;
+    hr = IDWriteFontFace_TryGetFontTable(fontface, MS_MATH_TAG, &data, &size, &context, &exists);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(exists && size, "Got no MATH table, exists %d, size %u.\n", exists, size);
+    if (exists) IDWriteFontFace_ReleaseFontTable(fontface, context);
+
+    IDWriteFontFace_Release(fontface);
+    IDWriteFont_Release(font);
+    IDWriteFontFamily_Release(family);
+    IDWriteFontCollection_Release(collection);
+    IDWriteFactory_Release(factory);
+}
+
 static void get_logfont_from_font(IDWriteFont *font, LOGFONTW *logfont)
 {
     void *os2_context, *head_context;
@@ -10724,6 +10789,7 @@ START_TEST(font)
     test_CreateFontFace();
     test_GetMetrics();
     test_system_fontcollection();
+    test_math_font();
     test_ConvertFontFaceToLOGFONT();
     test_CustomFontCollection();
     test_CreateCustomFontFileReference();
diff --git a/dlls/gdi32/tests/font.c b/dlls/gdi32/tests/font.c
index 5758cf70cde..4ad4c5a61a9 100644
--- a/dlls/gdi32/tests/font.c
+++ b/dlls/gdi32/tests/font.c
@@ -6517,6 +6517,48 @@ static INT CALLBACK has_vertical_font_proc(const LOGFONTA *lf, const TEXTMETRICA
     return 1;
 }
 
+static void test_math_font(void)
+{
+    /* Free fonts with a MATH table that Wine lets stand in for Cambria Math. */
+    static const char *math_fonts[] =
+    {
+        "DejaVu Math TeX Gyre", "STIX Two Math", "Latin Modern Math", "TeX Gyre Termes Math",
+        "TeX Gyre Pagella Math", "TeX Gyre Bonum Math", "TeX Gyre Schola Math", "TeX Gyre DejaVu Math",
+        "Libertinus Math", "XITS Math", "Asana Math", "Fira Math",
+    };
+    char face_name[LF_FACESIZE];
+    LOGFONTA lf;
+    HFONT hfont;
+    DWORD size;
+    HDC hdc;
+    int i;
+
+    /* Word lays out equations with the MATH table of Cambria Math. */
+    if (!is_font_installed("Cambria Math"))
+    {
+        for (i = 0; i < ARRAY_SIZE(math_fonts); i++)
+            ok(!is_font_installed(math_fonts[i]), "%s is installed, but not Cambria Math.\n", math_fonts[i]);
+        skip("Cambria Math is not installed.\n");
+        return;
+    }
+
+    hdc = CreateCompatibleDC(0);
+    memset(&lf, 0, sizeof(lf));
+    strcpy(lf.lfFaceName, "Cambria Math");
+    lf.lfHeight = -24;
+    lf.lfCharSet = DEFAULT_CHARSET;
+    hfont = SelectObject(hdc, CreateFontIndirectA(&lf));
+
+    memset(face_name, 0, sizeof(face_name));
+    GetTextFaceA(hdc, sizeof(face_name), face_name);
+    ok(!strcmp(face_name, "Cambria Math"), "Got face %s.\n", face_name);
+    size = GetFontData(hdc, MS_MAKE_TAG('M','A','T','H'), 0, NULL, 0);
+    ok(size && size != GDI_ERROR, "Got MATH table size %#lx.\n", size);
+
+    DeleteObject(SelectObject(hdc, hfont));
+    DeleteDC(hdc);
+}
+
 static void test_east_asian_font_selection(void)
 {
     HDC hdc;
@@ -8239,6 +8281,7 @@ START_TEST(font)
     test_fullname();
     test_fullname2();
     test_east_asian_font_selection();
+    test_math_font();
     test_max_height();
     test_vertical_order();
     test_GetCharWidth32();
