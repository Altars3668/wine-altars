From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 12:22:02 -0400
Subject: [PATCH] xmllite: write a namespace declaration once, where it was
 asked for.

Office saves to OneDrive with FSSHTTP, a SOAP request whose envelope it
writes as WriteStartElement(L"s", L"Envelope", uri) followed by
WriteAttributeString(L"xmlns", L"s", NULL, uri).  The writer looked the
declared prefix up under "xmlns" rather than under the prefix itself, did not
find the one it already had for the element, and wrote xmlns:s twice.  The
server's front end took the malformed envelope and answered 503 after the
origin dropped the connection; Office showed "changes saved, but the server
was busy", and no AutoSave upload ever went through.

A namespace declaration written as an attribute now goes through one place,
following what Windows was measured to do: it is written where it stands and
only once, so the element's own declaration is not repeated when the start
tag closes; declaring a prefix again on the same element fails with
WR_E_NSPREFIXDECLARED, as does giving an unprefixed element a default
namespace other than the one its name is in; the xmlns prefix goes with the
xmlns namespace URI; and a local name "xmlns" in that namespace, which is how
a reader reports xmlns="...", declares the default namespace instead of
writing xmlns:xmlns="...".  An element started with an empty prefix reuses the
default namespace in scope when it is the same one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 5b4cf1036bfec657d6c66f7605206670a082f696)

diff --git a/dlls/xmllite/tests/writer.c b/dlls/xmllite/tests/writer.c
index c441e026924..5e5fdd38acf 100644
--- a/dlls/xmllite/tests/writer.c
+++ b/dlls/xmllite/tests/writer.c
@@ -1733,7 +1733,7 @@ static void test_WriteAttributeString(void)
 
         /* Failing cases. */
         { NULL, NULL, L"http://www.w3.org/2000/xmlns/", L"defuri", "<e />", "<e", E_INVALIDARG },
-        { L"", L"a", L"http://www.w3.org/2000/xmlns/", L"defuri", "<e />", "<e", WR_E_XMLNSPREFIXDECLARATION, 1, 1, 1 },
+        { L"", L"a", L"http://www.w3.org/2000/xmlns/", L"defuri", "<e />", "<e", WR_E_XMLNSPREFIXDECLARATION },
         { L"", NULL, L"http://www.w3.org/2000/xmlns/", L"defuri", "<e />", "<e", E_INVALIDARG },
         { L"", L"", L"http://www.w3.org/2000/xmlns/", L"defuri", "<e />", "<e", E_INVALIDARG },
         { NULL, L"", L"http://www.w3.org/2000/xmlns/", L"defuri", "<e />", "<e", E_INVALIDARG },
@@ -1884,6 +1884,123 @@ static void test_WriteAttributeString(void)
     IXmlWriter_Release(writer);
 }
 
+static void test_namespace_declaration_attributes(void)
+{
+    static const WCHAR xmlnsuriW[] = L"http://www.w3.org/2000/xmlns/";
+    IXmlWriter *writer;
+    IStream *stream;
+    HRESULT hr;
+
+    hr = CreateXmlWriter(&IID_IXmlWriter, (void **)&writer, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    writer_set_property(writer, XmlWriterProperty_OmitXmlDeclaration);
+
+    /* The element's own namespace, declared again as an attribute, is written once. */
+    stream = writer_set_output(writer);
+
+    hr = IXmlWriter_WriteStartElement(writer, L"s", L"Envelope", L"urn:s");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteAttributeString(writer, L"xmlns", L"s", NULL, L"urn:s");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteAttributeString(writer, L"xmlns", L"s", NULL, L"urn:s");
+    ok(hr == WR_E_NSPREFIXDECLARED, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteAttributeString(writer, L"xmlns", L"s", NULL, L"urn:other");
+    ok(hr == WR_E_NSPREFIXDECLARED, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteStartElement(writer, L"s", L"Body", L"urn:s");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteEndDocument(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_Flush(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    CHECK_OUTPUT(stream, "<s:Envelope xmlns:s=\"urn:s\"><s:Body /></s:Envelope>");
+    IStream_Release(stream);
+
+    /* The "xmlns" prefix goes with its own namespace URI. */
+    stream = writer_set_output(writer);
+
+    hr = IXmlWriter_WriteStartElement(writer, NULL, L"e", NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteAttributeString(writer, L"xmlns", L"p", xmlnsuriW, L"urn:p");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteStartElement(writer, L"p", L"c", L"urn:p");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteEndDocument(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_Flush(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    CHECK_OUTPUT(stream, "<e xmlns:p=\"urn:p\"><p:c /></e>");
+    IStream_Release(stream);
+
+    /* Default namespace, as a reader reports it. */
+    stream = writer_set_output(writer);
+
+    hr = IXmlWriter_WriteStartElement(writer, L"", L"r", L"urn:r");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteAttributeString(writer, L"", L"xmlns", xmlnsuriW, L"urn:r");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteStartElement(writer, L"", L"c", L"urn:r");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteEndElement(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteStartElement(writer, L"", L"e", L"");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteAttributeString(writer, L"", L"xmlns", xmlnsuriW, L"");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteEndDocument(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_Flush(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    CHECK_OUTPUT(stream, "<r xmlns=\"urn:r\"><c /><e xmlns=\"\" /></r>");
+    IStream_Release(stream);
+
+    /* An unprefixed element cannot move itself to another default namespace. */
+    stream = writer_set_output(writer);
+
+    hr = IXmlWriter_WriteStartElement(writer, NULL, L"e", L"urn:a");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteAttributeString(writer, NULL, L"xmlns", NULL, L"urn:a");
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteStartElement(writer, NULL, L"c", NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteAttributeString(writer, NULL, L"xmlns", NULL, L"urn:b");
+    ok(hr == WR_E_NSPREFIXDECLARED, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_WriteEndDocument(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IXmlWriter_Flush(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    CHECK_OUTPUT(stream, "<e xmlns=\"urn:a\"><c /></e>");
+    IStream_Release(stream);
+
+    IXmlWriter_Release(writer);
+}
+
 static void test_WriteFullEndElement(void)
 {
     IXmlWriter *writer;
@@ -3462,6 +3579,7 @@ START_TEST(writer)
     test_WriteRaw();
     test_indentation();
     test_WriteAttributeString();
+    test_namespace_declaration_attributes();
     test_WriteFullEndElement();
     test_WriteCharEntity();
     test_WriteChars();
diff --git a/dlls/xmllite/writer.c b/dlls/xmllite/writer.c
index 4c4ce7eb87d..5567ff8cb8c 100644
--- a/dlls/xmllite/writer.c
+++ b/dlls/xmllite/writer.c
@@ -80,6 +80,7 @@ struct element
     struct list entry;
     WCHAR *qname;
     unsigned int len; /* qname length in chars */
+    WCHAR *uri; /* namespace passed for the element's own name, if any */
     struct list ns;
 };
 
@@ -201,6 +202,7 @@ static struct element *alloc_element(xmlwriter *writer, const WCHAR *prefix, con
         lstrcatW(ret->qname, L":");
     }
     lstrcatW(ret->qname, local);
+    ret->uri = NULL;
     list_init(&ret->ns);
 
     return ret;
@@ -219,6 +221,7 @@ static void writer_free_element(xmlwriter *writer, struct element *element)
     }
 
     writer_free(writer, element->qname);
+    writer_free(writer, element->uri);
     writer_free(writer, element);
 }
 
@@ -311,20 +314,19 @@ static struct ns *writer_push_ns(xmlwriter *writer, const WCHAR *prefix, int pre
     return ns;
 }
 
-static struct ns *writer_find_ns_current(const xmlwriter *writer, const WCHAR *prefix, const WCHAR *uri)
+/* The default namespace in scope, if it is the given one. */
+static struct ns *writer_find_default_ns(const xmlwriter *writer, const WCHAR *uri)
 {
     struct element *element;
     struct ns *ns;
 
-    if (is_empty_string(prefix) || is_empty_string(uri))
-        return NULL;
-
-    element = LIST_ENTRY(list_head(&writer->elements), struct element, entry);
-
-    LIST_FOR_EACH_ENTRY(ns, &element->ns, struct ns, entry)
+    LIST_FOR_EACH_ENTRY(element, &writer->elements, struct element, entry)
     {
-        if (!wcscmp(uri, ns->uri) && !wcscmp(prefix, ns->prefix))
-            return ns;
+        LIST_FOR_EACH_ENTRY(ns, &element->ns, struct ns, entry)
+        {
+            if (ns->prefix_len) continue;
+            return wcscmp(uri, ns->uri ? ns->uri : L"") ? NULL : ns;
+        }
     }
 
     return NULL;
@@ -1024,6 +1026,58 @@ static HRESULT write_output_attribute(xmlwriter *writer, const WCHAR *prefix, in
     return *hr;
 }
 
+/* The namespace an unprefixed element's name is in: the one it was started with, or else the
+ * default namespace declared around it. */
+static const WCHAR *writer_element_default_ns(const xmlwriter *writer, const struct element *element)
+{
+    struct element *outer;
+    struct ns *ns;
+
+    if (element->uri) return element->uri;
+    LIST_FOR_EACH_ENTRY(outer, &writer->elements, struct element, entry)
+    {
+        LIST_FOR_EACH_ENTRY(ns, &outer->ns, struct ns, entry)
+            if (!ns->prefix_len) return ns->uri ? ns->uri : L"";
+    }
+    return L"";
+}
+
+/* A namespace declaration written as an attribute, xmlns:prefix="uri" or xmlns="uri".  It is
+ * written where it stands and only once: a declaration the element needs for its own name or for
+ * one of its attributes is not repeated when the start tag is closed.  Declaring a prefix again on
+ * the same element fails, as does giving an unprefixed element a default namespace other than the
+ * one its name is in. */
+static HRESULT writer_declare_ns(xmlwriter *writer, const WCHAR *prefix, int prefix_len, const WCHAR *uri)
+{
+    struct element *element = LIST_ENTRY(list_head(&writer->elements), struct element, entry);
+    struct ns *ns, *found = NULL;
+    HRESULT hr = S_OK;
+
+    if (!uri) uri = L"";
+
+    LIST_FOR_EACH_ENTRY(ns, &element->ns, struct ns, entry)
+    {
+        if (ns->prefix_len != prefix_len || (prefix_len && wcscmp(ns->prefix, prefix))) continue;
+        found = ns;
+        break;
+    }
+
+    if (found)
+    {
+        if (found->emitted || wcscmp(found->uri ? found->uri : L"", uri)) return WR_E_NSPREFIXDECLARED;
+    }
+    else
+    {
+        if (!prefix_len && !wcschr(element->qname, ':') && wcscmp(writer_element_default_ns(writer, element), uri))
+            return WR_E_NSPREFIXDECLARED;
+        if (!(found = writer_push_ns(writer, prefix, prefix_len, uri))) return E_OUTOFMEMORY;
+    }
+    found->emitted = TRUE;
+
+    if (!prefix_len) return write_output_attribute(writer, NULL, 0, L"xmlns", 5, uri, &hr);
+    return write_output_attribute(writer, L"xmlns", 5, prefix, prefix_len, uri, &hr);
+}
+
 static BOOL is_valid_xml_space_value(const WCHAR *value)
 {
     return value && (!wcscmp(value, L"preserve") || !wcscmp(value, L"default"));
@@ -1071,6 +1125,10 @@ static HRESULT WINAPI xmlwriter_WriteAttributeString(IXmlWriter *iface, LPCWSTR
 
     is_xmlns_local = !wcscmp(local, L"xmlns");
 
+    /* Default namespace declaration. */
+    if (is_xmlns_local && prefix_len == 0 && (is_empty_string(uri) || !wcscmp(uri, xmlnsuriW)))
+        return writer_declare_ns(writer, NULL, 0, value);
+
     /* Trivial case, no prefix. */
     if (prefix_len == 0 && is_empty_string(uri))
         return write_output_attribute(writer, prefix, prefix_len, local, local_len, value, &hr);
@@ -1091,15 +1149,13 @@ static HRESULT WINAPI xmlwriter_WriteAttributeString(IXmlWriter *iface, LPCWSTR
 
     if (is_xmlns_prefix || (prefix_len == 0 && uri && !wcscmp(uri, xmlnsuriW)))
     {
-        if (prefix_len && !is_empty_string(uri))
+        /* "xmlns" only goes with its own namespace URI, and an empty prefix does not stand for it. */
+        if (prefix_len && !is_empty_string(uri) && wcscmp(uri, xmlnsuriW))
+            return WR_E_XMLNSPREFIXDECLARATION;
+        if (prefix && !*prefix)
             return WR_E_XMLNSPREFIXDECLARATION;
 
-        /* Look for exact match defined in current element, and write it out. */
-        if (!(ns = writer_find_ns_current(writer, prefix, value)))
-            ns = writer_push_ns(writer, local, local_len, value);
-        ns->emitted = TRUE;
-
-        return write_output_attribute(writer, L"xmlns", 5, local, local_len, value, &hr);
+        return writer_declare_ns(writer, local, local_len, value);
     }
 
     /* Ignore prefix if URI wasn't specified. */
@@ -2128,11 +2184,21 @@ static HRESULT WINAPI xmlwriter_WriteStartElement(IXmlWriter *iface, LPCWSTR pre
             return WR_E_XMLNSURIDECLARATION;
     }
 
-    ns = writer_find_ns(writer, prefix, uri);
+    /* An empty prefix puts the element in the default namespace, which is declared again unless
+     * it is already the one in scope. */
+    if (prefix && !*prefix && !is_empty_string(uri))
+        ns = writer_find_default_ns(writer, uri);
+    else
+        ns = writer_find_ns(writer, prefix, uri);
 
     element = alloc_element(writer, prefix, local_name);
     if (!element)
         return E_OUTOFMEMORY;
+    if (uri && !(element->uri = writer_strdupW(writer, uri)))
+    {
+        writer_free_element(writer, element);
+        return E_OUTOFMEMORY;
+    }
 
     write_encoding_bom(writer, &hr);
     write_node_indent(writer, &hr);
