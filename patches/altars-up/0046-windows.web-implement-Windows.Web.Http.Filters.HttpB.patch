+#ifdef __WIDL__
+#pragma winrt ns_prefix
+#endif
+
+import "inspectable.idl";
+import "asyncinfo.idl";
+import "eventtoken.idl";
+import "windowscontracts.idl";
+import "windows.foundation.idl";
+
+/* Several members of these interfaces hand back objects from Windows.Web.Http
+ * and Windows.Security.Cryptography.Certificates, neither of which exists here
+ * yet.  They are declared as IInspectable * rather than named and left
+ * undefined: the slot is an interface pointer either way, so the vtable is the
+ * one the ABI asks for, and the comment on each says what really belongs
+ * there.  The implementation fails those members rather than answering with
+ * something that is not what was asked for.  Narrow them back to the real
+ * types as those namespaces arrive. */
+
+namespace Windows.Web.Http.Filters {
+    interface IHttpBaseProtocolFilter;
+    interface IHttpFilter;
+
+    runtimeclass HttpBaseProtocolFilter;
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        uuid(a4cb6dd5-0902-439e-bfd7-e12552b165ce)
+    ]
+    interface IHttpFilter : IInspectable
+        requires Windows.Foundation.IClosable
+    {
+        /* IAsyncOperationWithProgress<HttpResponseMessage *, HttpProgress> *
+         *     SendRequestAsync(HttpRequestMessage *request) */
+        HRESULT SendRequestAsync([in] IInspectable *request, [out, retval] IInspectable **operation);
+    }
+
+    [
+        contract(Windows.Foundation.UniversalApiContract, 1.0),
+        exclusiveto(Windows.Web.Http.Filters.HttpBaseProtocolFilter),
+        uuid(71c89b09-e131-4b54-a53c-eb43ff37e9bb)
+    ]
+    interface IHttpBaseProtocolFilter : IInspectable
+        requires Windows.Web.Http.Filters.IHttpFilter, Windows.Foundation.IClosable
+    {
+        [propget] HRESULT AllowAutoRedirect([out, retval] boolean *value);
+        [propput] HRESULT AllowAutoRedirect([in] boolean value);
