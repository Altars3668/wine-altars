+++ b/dlls/windows.web/filters.c
@@ -0,0 +1,430 @@
+/* WinRT Windows.Web.Http.Filters implementation
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+/*
+ * HttpBaseProtocolFilter is the settings object an HttpClient is built on: how
+ * many connections to open per server, whether to follow redirects, which
+ * credentials to offer.  Every one of those is a value the caller stores and
+ * reads back, and that much is implemented here.
+ *
+ * What is not implemented is the part that needs the rest of Windows.Web.Http:
+ * SendRequestAsync, and the members handing back a cookie manager, a
+ * certificate or a credential.  Those report that they are not implemented
+ * rather than answering with an empty object -- a caller that is given one
+ * cannot tell it apart from a real one, and the failure surfaces somewhere
+ * else entirely.
+ */
+
+struct filter
+{
+    IHttpBaseProtocolFilter IHttpBaseProtocolFilter_iface;
+    IHttpFilter IHttpFilter_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    boolean allow_auto_redirect;
+    boolean allow_ui;
+    boolean automatic_decompression;
+    boolean use_proxy;
+    UINT32 max_connections_per_server;
+};
+
+static inline struct filter *impl_from_IHttpBaseProtocolFilter( IHttpBaseProtocolFilter *iface )
+{
+    return CONTAINING_RECORD( iface, struct filter, IHttpBaseProtocolFilter_iface );
+}
+
+static HRESULT WINAPI filter_QueryInterface( IHttpBaseProtocolFilter *iface, REFIID iid, void **out )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IHttpBaseProtocolFilter ))
+    {
+        *out = &impl->IHttpBaseProtocolFilter_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IHttpFilter ))
+    {
+        *out = &impl->IHttpFilter_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        *out = &impl->IClosable_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI filter_AddRef( IHttpBaseProtocolFilter *iface )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI filter_Release( IHttpBaseProtocolFilter *iface )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref) free( impl );
+    return ref;
+}
+
+static HRESULT WINAPI filter_GetIids( IHttpBaseProtocolFilter *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_GetRuntimeClassName( IHttpBaseProtocolFilter *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Web_Http_Filters_HttpBaseProtocolFilter,
+                                ARRAY_SIZE(RuntimeClass_Windows_Web_Http_Filters_HttpBaseProtocolFilter) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI filter_GetTrustLevel( IHttpBaseProtocolFilter *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+#define FILTER_BOOL_PROPERTY( name, field )                                                        \
+    static HRESULT WINAPI filter_get_##name( IHttpBaseProtocolFilter *iface, boolean *value )      \
+    {                                                                                              \
+        struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );                          \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        *value = impl->field;                                                                      \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI filter_put_##name( IHttpBaseProtocolFilter *iface, boolean value )       \
+    {                                                                                              \
+        struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );                          \
+        TRACE( "iface %p, value %d.\n", iface, value );                                            \
+        impl->field = !!value;                                                                     \
+        return S_OK;                                                                               \
+    }
+
+FILTER_BOOL_PROPERTY( AllowAutoRedirect, allow_auto_redirect )
+FILTER_BOOL_PROPERTY( AllowUI, allow_ui )
+FILTER_BOOL_PROPERTY( AutomaticDecompression, automatic_decompression )
+FILTER_BOOL_PROPERTY( UseProxy, use_proxy )
+
+static HRESULT WINAPI filter_get_MaxConnectionsPerServer( IHttpBaseProtocolFilter *iface, UINT32 *value )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->max_connections_per_server;
+    return S_OK;
+}
+
+static HRESULT WINAPI filter_put_MaxConnectionsPerServer( IHttpBaseProtocolFilter *iface, UINT32 value )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter( iface );
+
+    TRACE( "iface %p, value %u.\n", iface, value );
+
+    /* Windows rejects zero rather than taking it to mean "no limit". */
+    if (!value) return E_INVALIDARG;
+    impl->max_connections_per_server = value;
+    return S_OK;
+}
+
+/* These hand back objects from namespaces that are not implemented yet.  See
+ * the note at the top of windows.web.http.filters.idl. */
+static HRESULT WINAPI filter_get_CacheControl( IHttpBaseProtocolFilter *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p: HttpCacheControl is not implemented.\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_get_CookieManager( IHttpBaseProtocolFilter *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p: HttpCookieManager is not implemented.\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_get_ClientCertificate( IHttpBaseProtocolFilter *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p: Certificate is not implemented.\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_put_ClientCertificate( IHttpBaseProtocolFilter *iface, IInspectable *value )
+{
+    FIXME( "iface %p, value %p: Certificate is not implemented.\n", iface, value );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_get_IgnorableServerCertificateErrors( IHttpBaseProtocolFilter *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p: ChainValidationResult is not implemented.\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_get_ProxyCredential( IHttpBaseProtocolFilter *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p: PasswordCredential is not implemented.\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_put_ProxyCredential( IHttpBaseProtocolFilter *iface, IInspectable *value )
+{
+    FIXME( "iface %p, value %p: PasswordCredential is not implemented.\n", iface, value );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_get_ServerCredential( IHttpBaseProtocolFilter *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p: PasswordCredential is not implemented.\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI filter_put_ServerCredential( IHttpBaseProtocolFilter *iface, IInspectable *value )
+{
+    FIXME( "iface %p, value %p: PasswordCredential is not implemented.\n", iface, value );
+    return E_NOTIMPL;
+}
+
+static const struct IHttpBaseProtocolFilterVtbl filter_vtbl =
+{
+    filter_QueryInterface,
+    filter_AddRef,
+    filter_Release,
+    /* IInspectable methods */
+    filter_GetIids,
+    filter_GetRuntimeClassName,
+    filter_GetTrustLevel,
+    /* IHttpBaseProtocolFilter methods */
+    filter_get_AllowAutoRedirect,
+    filter_put_AllowAutoRedirect,
+    filter_get_AllowUI,
+    filter_put_AllowUI,
+    filter_get_AutomaticDecompression,
+    filter_put_AutomaticDecompression,
+    filter_get_CacheControl,
+    filter_get_CookieManager,
+    filter_get_ClientCertificate,
+    filter_put_ClientCertificate,
+    filter_get_IgnorableServerCertificateErrors,
+    filter_get_MaxConnectionsPerServer,
+    filter_put_MaxConnectionsPerServer,
+    filter_get_ProxyCredential,
+    filter_put_ProxyCredential,
+    filter_get_ServerCredential,
+    filter_put_ServerCredential,
+    filter_get_UseProxy,
+    filter_put_UseProxy,
+};
+
+DEFINE_IINSPECTABLE( http_filter, IHttpFilter, struct filter, IHttpBaseProtocolFilter_iface )
+
+static HRESULT WINAPI http_filter_SendRequestAsync( IHttpFilter *iface, IInspectable *request, IInspectable **operation )
+{
+    FIXME( "iface %p, request %p, operation %p: Windows.Web.Http is not implemented.\n",
+           iface, request, operation );
+    if (operation) *operation = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IHttpFilterVtbl http_filter_vtbl =
+{
+    http_filter_QueryInterface,
+    http_filter_AddRef,
+    http_filter_Release,
+    /* IInspectable methods */
+    http_filter_GetIids,
+    http_filter_GetRuntimeClassName,
+    http_filter_GetTrustLevel,
+    /* IHttpFilter methods */
+    http_filter_SendRequestAsync,
+};
+
+DEFINE_IINSPECTABLE( closable, IClosable, struct filter, IHttpBaseProtocolFilter_iface )
+
+static HRESULT WINAPI closable_Close( IClosable *iface )
+{
+    /* Nothing is held open yet: the connections this would drop belong to the
+     * part of Windows.Web.Http that is not here. */
+    TRACE( "iface %p.\n", iface );
+    return S_OK;
+}
+
+static const struct IClosableVtbl closable_vtbl =
+{
+    closable_QueryInterface,
+    closable_AddRef,
+    closable_Release,
+    /* IInspectable methods */
+    closable_GetIids,
+    closable_GetRuntimeClassName,
+    closable_GetTrustLevel,
+    /* IClosable methods */
+    closable_Close,
+};
+
+struct filter_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    LONG ref;
+};
+
+static inline struct filter_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct filter_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct filter_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    struct filter_statics *impl = impl_from_IActivationFactory( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    struct filter_statics *impl = impl_from_IActivationFactory( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    struct filter *impl;
+
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+
+    if (!instance) return E_POINTER;
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        *instance = NULL;
+        return E_OUTOFMEMORY;
+    }
+
+    impl->IHttpBaseProtocolFilter_iface.lpVtbl = &filter_vtbl;
+    impl->IHttpFilter_iface.lpVtbl = &http_filter_vtbl;
+    impl->IClosable_iface.lpVtbl = &closable_vtbl;
+    impl->ref = 1;
+
+    /* The documented defaults a fresh filter comes with. */
+    impl->allow_auto_redirect = TRUE;
+    impl->allow_ui = TRUE;
+    impl->automatic_decompression = TRUE;
+    impl->use_proxy = TRUE;
+    impl->max_connections_per_server = 6;
+
+    *instance = (IInspectable *)&impl->IHttpBaseProtocolFilter_iface;
+    return S_OK;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+static struct filter_statics filter_statics =
+{
+    {&factory_vtbl},
+    1,
+};
+
+IActivationFactory *http_base_protocol_filter_factory = &filter_statics.IActivationFactory_iface;
