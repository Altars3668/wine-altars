diff --git a/dlls/d3d11/d3d11.spec b/dlls/d3d11/d3d11.spec
index bb755e2e869..a04c7ada2b7 100644
--- a/dlls/d3d11/d3d11.spec
+++ b/dlls/d3d11/d3d11.spec
@@ -1,3 +1,5 @@
+@ stdcall CreateDirect3D11DeviceFromDXGIDevice(ptr ptr)
+@ stdcall CreateDirect3D11SurfaceFromDXGISurface(ptr ptr)
 @ stdcall D3D11CoreCreateDevice(ptr ptr long ptr long ptr)
 @ stub D3D11CoreCreateLayeredDevice
 @ stub D3D11CoreGetLayeredDeviceSize
diff --git a/dlls/d3d11/winrt.c b/dlls/d3d11/winrt.c
new file mode 100644
index 00000000000..b4573237de6
--- /dev/null
+++ b/dlls/d3d11/winrt.c
@@ -0,0 +1,364 @@
+/*
+ * Direct3D 11 devices and surfaces as Windows.Graphics.DirectX.Direct3D11 objects
+ *
+ * Copyright 2026 AltarsCN
+ *
