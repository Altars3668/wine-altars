index c51ec398d98..edb983bee2f 100644
--- a/dlls/d3d11/Makefile.in
+++ b/dlls/d3d11/Makefile.in
@@ -1,6 +1,7 @@
 MODULE    = d3d11.dll
 IMPORTLIB = d3d11
 IMPORTS   = dxguid uuid dxgi wined3d
+DELAYIMPORTS = combase
 EXTRAINCL = $(VKD3D_PE_CFLAGS)
 
 VER_FILEDESCRIPTION_STR = "Wine Direct3D"
@@ -18,4 +19,5 @@ SOURCES = \
 	state.c \
 	texture.c \
 	utils.c \
-	view.c
+	view.c \
