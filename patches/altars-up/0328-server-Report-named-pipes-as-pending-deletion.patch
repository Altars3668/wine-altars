From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 01:41:47 -0400
Subject: [PATCH] server: Report named pipes as pending deletion.

NPFS answers FileStandardInformation with DeletePending set for both ends
of a pipe in every state, as the pipe test expects.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/pipe.c b/dlls/ntdll/tests/pipe.c
index 8a2c8e55599..40097c52dad 100644
--- a/dlls/ntdll/tests/pipe.c
+++ b/dlls/ntdll/tests/pipe.c
@@ -2162,7 +2162,7 @@ static void test_pipe_with_data_state(HANDLE pipe, BOOL is_server, DWORD state)
                 std_info.AllocationSize.QuadPart, local_info.InboundQuota + local_info.OutboundQuota);
         ok(std_info.EndOfFile.QuadPart == local_info.ReadDataAvailable, "got %I64u.\n", std_info.EndOfFile.QuadPart);
         ok(std_info.NumberOfLinks == 1, "got %lu.\n", std_info.NumberOfLinks);
-        todo_wine ok(std_info.DeletePending, "got %d.\n", std_info.DeletePending);
+        ok(std_info.DeletePending, "got %d.\n", std_info.DeletePending);
         ok(!std_info.Directory, "got %d.\n", std_info.Directory);
     }
 
diff --git a/server/named_pipe.c b/server/named_pipe.c
index f363cddf148..20d691f3a62 100644
--- a/server/named_pipe.c
+++ b/server/named_pipe.c
@@ -871,7 +871,7 @@ static void pipe_end_get_file_info( struct fd *fd, obj_handle_t handle, unsigned
             std_info->AllocationSize.QuadPart = pipe->outsize + pipe->insize;
             std_info->EndOfFile.QuadPart      = pipe_end_get_avail( pipe_end );
             std_info->NumberOfLinks           = 1; /* FIXME */
-            std_info->DeletePending           = 0; /* FIXME */
+            std_info->DeletePending           = 1;  /* as NPFS reports it */
             std_info->Directory               = 0;
             break;
         }
