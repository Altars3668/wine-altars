+/*
+ * The time stamps' chains, each as of its time and for time stamping; what is
+ * wrong with one is its counter signer's error, and the signer's time is then
+ * the time WinVerifyTrust was called.
+ */
+static void WINTRUST_CreateChainsForCounterSigners(CRYPT_PROVIDER_DATA *data,
+ DWORD signer, PWTD_GENERIC_CHAIN_POLICY_CREATE_INFO createInfo,
+ HCERTSTORE store)
+{
+    static char timeStampUsage[] = szOID_PKIX_KP_TIMESTAMP_SIGNING;
+    char *usage[] = { timeStampUsage };
+    CERT_CHAIN_PARA chainPara = { sizeof(chainPara) };
+    CRYPT_PROVIDER_SGNR *counter;
+    DWORD i, err;
+
+    chainPara.RequestedUsage.dwType = USAGE_MATCH_TYPE_AND;
+    chainPara.RequestedUsage.Usage.cUsageIdentifier = ARRAY_SIZE(usage);
+    chainPara.RequestedUsage.Usage.rgpszUsageIdentifier = usage;
+    for (i = 0; i < data->pasSigners[signer].csCounterSigners; i++)
+    {
+        counter = &data->pasSigners[signer].pasCounterSigners[i];
+        if (counter->dwError || !counter->csCertChain)
+            continue;
+        if (!CertGetCertificateChain(createInfo->hChainEngine,
+         counter->pasCertChain[0].pCert, &counter->sftVerifyAsOf, store,
+         &chainPara, createInfo->dwFlags, createInfo->pvReserved,
+         &counter->pChainContext))
+        {
+            counter->dwError = GetLastError();
+            continue;
+        }
+        if (counter->pChainContext->cChain != 1)
+        {
+            FIXME("unimplemented for more than 1 simple chain\n");
+            continue;
+        }
+        if ((err = WINTRUST_CopyChain(data, signer, TRUE, i)))
+        {
+            data->pasSigners[signer].pasCounterSigners[i].dwError = err;
+            continue;
+        }
+        counter = &data->pasSigners[signer].pasCounterSigners[i];
+        if (data->psPfns->pfnCertCheckPolicy)
+            data->psPfns->pfnCertCheckPolicy(data, signer, TRUE, i);
+        if ((err = WINTRUST_TrustStatusToError(
+         counter->pChainContext->TrustStatus.dwErrorStatus)))
+        {
+            WARN("time stamp's chain: %08lx\n", err);
+            counter->dwError = err;
+        }
+    }
+}
+
 static DWORD WINTRUST_CreateChainForSigner(CRYPT_PROVIDER_DATA *data,
  DWORD signer, PWTD_GENERIC_CHAIN_POLICY_CREATE_INFO createInfo,
  PCERT_CHAIN_PARA chainPara)
@@ -1120,6 +1274,10 @@ static DWORD WINTRUST_CreateChainForSigner(CRYPT_PROVIDER_DATA *data,
