+/* the time of the first counter signer that holds, else the time WinVerifyTrust was called */
+static void WINTRUST_ChooseTime(CRYPT_PROVIDER_DATA *data, DWORD signerIdx)
+{
+    CRYPT_PROVIDER_SGNR *sgnr = &data->pasSigners[signerIdx];
+    DWORD i;
+
+    sgnr->sftVerifyAsOf = data->sftSystemTime;
+    for (i = 0; i < sgnr->csCounterSigners; i++)
+    {
+        if (sgnr->pasCounterSigners[i].dwError)
+            continue;
+        sgnr->sftVerifyAsOf = sgnr->pasCounterSigners[i].sftVerifyAsOf;
+        break;
+    }
+    TRACE("signer %lu: verifying as of %s\n", signerIdx,
+     filetime_to_str(&sgnr->sftVerifyAsOf));
+}
+
+/*
+ * A signer's counter signers time stamp its signature, either the legacy way
+ * or with an RFC 3161 token; the first one verified is the time it is verified
+ * as of, else it is the time WinVerifyTrust was called.
+ */
+static void WINTRUST_SaveCounterSigners(CRYPT_PROVIDER_DATA *data, DWORD signerIdx)
+{
+    const CMSG_SIGNER_INFO *signerInfo = data->pasSigners[signerIdx].psSigner;
+    DWORD i, j;
+
+    for (i = 0; i < signerInfo->UnauthAttrs.cAttr; i++)
+    {
+        const CRYPT_ATTRIBUTE *attr = &signerInfo->UnauthAttrs.rgAttr[i];
+
+        for (j = 0; j < attr->cValue; j++)
+        {
+            if (!strcmp(attr->pszObjId, szOID_RSA_counterSign))
+                WINTRUST_SaveLegacyCounterSigner(data, signerIdx, &attr->rgValue[j]);
+            else if (!strcmp(attr->pszObjId, szOID_RFC3161_counterSign))
+                WINTRUST_SaveTimeStampCounterSigner(data, signerIdx, &attr->rgValue[j]);
+        }
+    }
+
+    WINTRUST_ChooseTime(data, signerIdx);
 }
 
