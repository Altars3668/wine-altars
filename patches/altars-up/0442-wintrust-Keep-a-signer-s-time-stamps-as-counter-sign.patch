+/* an RFC 3161 time stamp of the signature, signed with a certificate the token carries */
+static void WINTRUST_SaveTimeStampCounterSigner(CRYPT_PROVIDER_DATA *data,
+ DWORD signerIdx, const CRYPT_ATTR_BLOB *token)
+{
+    const CMSG_SIGNER_INFO *signerInfo = data->pasSigners[signerIdx].psSigner;
+    CRYPT_PROVIDER_SGNR counter = { sizeof(counter) };
+    CRYPT_TIMESTAMP_CONTEXT *context;
+    const CERT_CONTEXT *cert;
+    HCERTSTORE store;
+    HCRYPTMSG msg;
+    DWORD size;
+
+    if (!CryptVerifyTimeStampSignature(token->pbData, token->cbData,
+     signerInfo->EncryptedHash.pbData, signerInfo->EncryptedHash.cbData, NULL,
+     &context, &cert, &store))
+    {
+        WARN("time stamp not verified: %08lx\n", GetLastError());
+        return;
     }
-    if (!foundTimeStamp)
+    counter.sftVerifyAsOf = context->pTimeStamp->ftTime;
+    counter.dwSignerType = SGNR_TYPE_TIMESTAMP;
+    if ((msg = CryptMsgOpenToDecode(data->dwEncoding, 0, 0, 0, NULL, NULL)))
     {
-        TRACE("returning system time %s\n",
-         filetime_to_str(&data->sftSystemTime));
-        time = data->sftSystemTime;
+        if (CryptMsgUpdate(msg, token->pbData, token->cbData, TRUE) &&
+         CryptMsgGetParam(msg, CMSG_SIGNER_INFO_PARAM, 0, NULL, &size) &&
+         (counter.psSigner = data->psPfns->pfnAlloc(size)) &&
+         !CryptMsgGetParam(msg, CMSG_SIGNER_INFO_PARAM, 0, counter.psSigner, &size))
+        {
+            data->psPfns->pfnFree(counter.psSigner);
+            counter.psSigner = NULL;
+        }
+        CryptMsgClose(msg);
     }
+    /* the token's certificates are where the time stamp's chain is found */
+    data->psPfns->pfnAddStore2Chain(data, store);
+    if (!data->psPfns->pfnAddSgnr2Chain(data, TRUE, signerIdx, &counter))
+        data->psPfns->pfnFree(counter.psSigner);
     else
-        TRACE("returning time from message %s\n", filetime_to_str(&time));
-    return time;
+        data->psPfns->pfnAddCert2Chain(data, signerIdx, TRUE,
+         data->pasSigners[signerIdx].csCounterSigners - 1, cert);
+    CertFreeCertificateContext(cert);
