+/***********************************************************************
+ *           NtUserCalculatePopupWindowPosition    (win32u.@)
+ *
+ * Work out where a popup of a given size should sit for an anchor point, so
+ * that it stays on the monitor the anchor is on and -- when an exclude
+ * rectangle is given -- does not cover it.  The flags are the TPM_ ones
+ * TrackPopupMenuEx takes: TPM_VERTICAL means keep the vertical placement and
+ * move aside, anything else means keep the horizontal placement and move up
+ * or down.
+ */
+BOOL WINAPI NtUserCalculatePopupWindowPosition( const POINT *anchor_point, const SIZE *window_size,
+                                                UINT flags, RECT *exclude_rect, RECT *pos )
+{
+    RECT rect, work, ignored;
+    MONITORINFO info;
+    LONG x, y;
+
+    TRACE( "anchor %s size %ldx%ld flags %#x exclude %s\n", wine_dbgstr_point( anchor_point ),
+           window_size ? window_size->cx : 0, window_size ? window_size->cy : 0, flags,
+           wine_dbgstr_rect( exclude_rect ) );
+
+    if (!anchor_point || !window_size || !pos)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    x = anchor_point->x;
+    y = anchor_point->y;
+    if (flags & TPM_CENTERALIGN) x -= window_size->cx / 2;
+    else if (flags & TPM_RIGHTALIGN) x -= window_size->cx;
+    if (flags & TPM_VCENTERALIGN) y -= window_size->cy / 2;
+    else if (flags & TPM_BOTTOMALIGN) y -= window_size->cy;
+    SetRect( &rect, x, y, x + window_size->cx, y + window_size->cy );
+
+    SetRect( &work, anchor_point->x, anchor_point->y, anchor_point->x, anchor_point->y );
+    info = monitor_info_from_rect( work, get_thread_dpi() );
+    work = (flags & TPM_WORKAREA) ? info.rcWork : info.rcMonitor;
+
+    /* The exclude rectangle is whatever the popup belongs to -- the button or
+     * the menu bar item that opened it.  Covering that is the one placement
+     * that is never wanted, so step off it, towards the side the alignment
+     * already leans to and to the other side when that one has no room. */
+    if (exclude_rect && intersect_rect( &ignored, &rect, exclude_rect ))
+    {
+        if (flags & TPM_VERTICAL)
+        {
+            BOOL prefer_left = (flags & (TPM_RIGHTALIGN | TPM_CENTERALIGN)) != 0;
+            BOOL fits_left = exclude_rect->left - work.left >= window_size->cx;
+            BOOL fits_right = work.right - exclude_rect->right >= window_size->cx;
+
+            if (prefer_left ? fits_left : !fits_right)
+                OffsetRect( &rect, exclude_rect->left - rect.right, 0 );
+            else
+                OffsetRect( &rect, exclude_rect->right - rect.left, 0 );
+        }
+        else
+        {
+            BOOL prefer_above = (flags & (TPM_BOTTOMALIGN | TPM_VCENTERALIGN)) != 0;
+            BOOL fits_above = exclude_rect->top - work.top >= window_size->cy;
+            BOOL fits_below = work.bottom - exclude_rect->bottom >= window_size->cy;
+
+            if (prefer_above ? fits_above : !fits_below)
+                OffsetRect( &rect, 0, exclude_rect->top - rect.bottom );
+            else
+                OffsetRect( &rect, 0, exclude_rect->bottom - rect.top );
+        }
+    }
+
+    /* whatever is left of the placement still has to fit on the monitor */
+    if (rect.right > work.right) OffsetRect( &rect, work.right - rect.right, 0 );
+    if (rect.bottom > work.bottom) OffsetRect( &rect, 0, work.bottom - rect.bottom );
+    if (rect.left < work.left) OffsetRect( &rect, work.left - rect.left, 0 );
+    if (rect.top < work.top) OffsetRect( &rect, 0, work.top - rect.top );
+
+    *pos = rect;
+    return TRUE;
+}
+
