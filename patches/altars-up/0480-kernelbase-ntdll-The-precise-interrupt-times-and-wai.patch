From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:01 -0400
Subject: [PATCH] kernelbase, ntdll: The precise interrupt times, and waitable
 timers with a wake context.

QueryInterruptTimePrecise and QueryUnbiasedInterruptTimePrecise come from
the performance counter, the unbiased one less the interrupt time bias,
as RtlQueryUnbiasedInterruptTime is now too.  SetWaitableTimerEx checks
the version of a wake context (ERROR_INVALID_PARAMETER for another) and
fires when due, which is within the tolerable delay; waking the machine
is not Wine's to do (tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernelbase/sync.c b/dlls/kernelbase/sync.c
index 94036acfad4..d9da533fdfa 100644
--- a/dlls/kernelbase/sync.c
+++ b/dlls/kernelbase/sync.c
@@ -222,25 +222,28 @@ void WINAPI DECLSPEC_HOTPATCH QueryInterruptTime( ULONGLONG *time )
 
 /******************************************************************************
  *           QueryInterruptTimePrecise  (kernelbase.@)
+ *
+ * The interrupt time as the performance counter has it now, in 100 ns, rather than as of the last clock tick.
  */
 void WINAPI DECLSPEC_HOTPATCH QueryInterruptTimePrecise( ULONGLONG *time )
 {
-    static int once;
-    if (!once++) FIXME( "(%p) semi-stub\n", time );
+    LARGE_INTEGER counter, freq;
 
-    QueryInterruptTime( time );
+    RtlQueryPerformanceCounter( &counter );
+    RtlQueryPerformanceFrequency( &freq );
+    *time = counter.QuadPart / freq.QuadPart * 10000000 + counter.QuadPart % freq.QuadPart * 10000000 / freq.QuadPart;
 }
 
 
 /***********************************************************************
  *           QueryUnbiasedInterruptTimePrecise  (kernelbase.@)
+ *
+ * The same, without the time the system spent asleep.
  */
 void WINAPI DECLSPEC_HOTPATCH QueryUnbiasedInterruptTimePrecise( ULONGLONG *time )
 {
-    static int once;
-    if (!once++) FIXME( "(%p): semi-stub.\n", time );
-
-    RtlQueryUnbiasedInterruptTime( time );
+    QueryInterruptTimePrecise( time );
+    *time -= user_shared_data->InterruptTimeBias;
 }
 
 
@@ -924,10 +927,15 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetWaitableTimerEx( HANDLE handle, const LARGE_INT
                                                   PTIMERAPCROUTINE callback, LPVOID arg,
                                                   REASON_CONTEXT *context, ULONG tolerabledelay )
 {
-    static int once;
-    if (!once++) FIXME( "(%p, %p, %ld, %p, %p, %p, %ld) semi-stub\n",
-                        handle, when, period, callback, arg, context, tolerabledelay );
+    TRACE( "(%p, %p, %ld, %p, %p, %p, %lu)\n", handle, when, period, callback, arg, context, tolerabledelay );
 
+    if (context && context->Version != POWER_REQUEST_CONTEXT_VERSION)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    /* the timer may fire up to the tolerable delay late, so firing when due is right; a wake context asks to
+     * wake the machine from sleep, which is not Wine's to do */
     return SetWaitableTimer( handle, when, period, callback, arg, FALSE );
 }
 
diff --git a/dlls/ntdll/time.c b/dlls/ntdll/time.c
index 5a96a1e2746..061317c989f 100644
--- a/dlls/ntdll/time.c
+++ b/dlls/ntdll/time.c
@@ -475,7 +475,7 @@ BOOL WINAPI RtlQueryUnbiasedInterruptTime(ULONGLONG *time)
         low = user_shared_data->InterruptTime.LowPart;
     }
     while (high != user_shared_data->InterruptTime.High2Time);
-    /* FIXME: should probably subtract InterruptTimeBias */
-    *time = (ULONGLONG)high << 32 | low;
+    /* without the time the system spent asleep */
+    *time = ((ULONGLONG)high << 32 | low) - user_shared_data->InterruptTimeBias;
     return TRUE;
 }
