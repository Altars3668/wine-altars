From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 12:48:54 -0400
Subject: [PATCH] msxml3: Stop compiling an expression after an error, as
 libxml2 does.

An XSL pattern with an axis, such as ancestor::node(), compiled no step
and then read the step before the first one, which crashed; Windows
fails such a query with E_FAIL.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index 83532454499..52a76aa1ffd 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -8292,6 +8292,12 @@ static const struct query_test xslpattern_test[] =
 
     /* Predicate at different levels requiring index fixup vs XPath */
     { "root//elem[0][0]", "E1.E2.D1" },
+
+    /* XSL patterns have no axes */
+    { "ancestor::node()", NULL },
+    { "root/ancestor::*", NULL },
+    { "root/elem/preceding-sibling::node()", NULL },
+    { "root/elem/following-sibling::node()", NULL },
     { NULL }
 };
 
diff --git a/dlls/msxml3/xpath.c b/dlls/msxml3/xpath.c
index 93cab507daa..6ca9ec5beb8 100644
--- a/dlls/msxml3/xpath.c
+++ b/dlls/msxml3/xpath.c
@@ -2080,6 +2080,8 @@ static void xpath_compile_expr(struct xpath_parser_context *ctxt, bool sort)
     }
 
     xpath_compile_and_expr(ctxt);
+    if (ctxt->error != XPATH_EXPRESSION_OK)
+        return;
     xpath_parse_skipspaces(ctxt);
     while (xpath_parse_cmp(ctxt, L"or"))
     {
@@ -2087,6 +2089,8 @@ static void xpath_compile_expr(struct xpath_parser_context *ctxt, bool sort)
 
         xpath_parse_skipspaces(ctxt);
         xpath_compile_and_expr(ctxt);
+        if (ctxt->error != XPATH_EXPRESSION_OK)
+            return;
         xpath_push_binary_step(ctxt, XPATH_OP_OR, op1, ctxt->comp->last, 0, 0);
         xpath_parse_skipspaces(ctxt);
     }
@@ -7592,6 +7596,8 @@ static void xslpattern_compile_expr(struct xpath_parser_context *ctxt, bool sort
     }
 
     xslpattern_compile_and_expr(ctxt);
+    if (ctxt->error != XPATH_EXPRESSION_OK)
+        return;
 
     xpath_parse_skipspaces(ctxt);
     while (xpath_parse_cmp(ctxt, L"or")
@@ -7602,6 +7608,8 @@ static void xslpattern_compile_expr(struct xpath_parser_context *ctxt, bool sort
 
         xpath_parse_skipspaces(ctxt);
         xslpattern_compile_and_expr(ctxt);
+        if (ctxt->error != XPATH_EXPRESSION_OK)
+            return;
         xpath_push_binary_step(ctxt, XPATH_OP_OR, op1, ctxt->comp->last, 0, 0);
         xpath_parse_skipspaces(ctxt);
     }
