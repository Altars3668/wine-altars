From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 18:11:08 -0400
Subject: [PATCH] d2d1: Let go of a command list's pointer to a context that
 goes away.

A command list set as a context's target points back at that context, so
that closing the list can take it off the context.  A context released
while the list was still its target left the list pointing at freed
memory, and closing the list then worked on it: PowerPoint drew a shape's
shadow into a list, released the context, closed the list and crashed
reading 0xfeeefeeefeeefeee there.  A context going away now clears the
pointer.

The test sets a list on a second context, releases the context and
closes the list; under warn+heap the crash was the one PowerPoint had.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 18683582f7c63cc0b066f64658d8f961bcb45d74)

diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 113889fe525..3c0d9afef61 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -357,6 +357,9 @@ static ULONG STDMETHODCALLTYPE d2d_device_context_inner_Release(IUnknown *iface)
         d2d_device_context_cleanup_effects(context);
         if (context->d3d_state)
             ID3DDeviceContextState_Release(context->d3d_state);
+        /* a command list that outlives its context stops pointing at it */
+        if (context->target.type == D2D_TARGET_COMMAND_LIST && context->target.command_list->context == context)
+            context->target.command_list->context = NULL;
         if (context->target.object)
             IUnknown_Release(context->target.object);
         ID3D11Device1_Release(context->d3d_device);
diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index 9896aa5cad4..1ebbdc831b3 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -10891,6 +10891,49 @@ static void test_command_list_playback(BOOL d3d11)
     release_test_context(&ctx);
 }
 
+/* A list set on a context that is let go of before the list is closed. */
+static void test_command_list_outlives_context(BOOL d3d11)
+{
+    ID2D1CommandList *command_list;
+    struct d2d1_test_context ctx;
+    ID2D1DeviceContext *context;
+    D2D1_COLOR_F colour;
+    ID2D1Device *device;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    if (!ctx.factory1)
+    {
+        win_skip("Command lists are not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    ID2D1DeviceContext_GetDevice(ctx.context, &device);
+    hr = ID2D1Device_CreateDeviceContext(device, D2D1_DEVICE_CONTEXT_OPTIONS_NONE, &context);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Device_Release(device);
+
+    hr = ID2D1DeviceContext_CreateCommandList(context, &command_list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_SetTarget(context, (ID2D1Image *)command_list);
+    ID2D1DeviceContext_BeginDraw(context);
+    set_color(&colour, 1.0f, 0.0f, 0.0f, 1.0f);
+    ID2D1DeviceContext_Clear(context, &colour);
+    hr = ID2D1DeviceContext_EndDraw(context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_Release(context);
+
+    hr = ID2D1CommandList_Close(command_list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1CommandList_Close(command_list);
+    ok(hr == D2DERR_WRONG_STATE, "Got unexpected hr %#lx.\n", hr);
+
+    ID2D1CommandList_Release(command_list);
+    release_test_context(&ctx);
+}
+
 static void test_command_list(BOOL d3d11)
 {
     static const DWORD bitmap_data[] =
@@ -19422,6 +19465,7 @@ START_TEST(d2d1)
     queue_d3d10_test(test_invert_matrix);
     queue_d3d10_test(test_skew_matrix);
     queue_test(test_command_list);
+    queue_test(test_command_list_outlives_context);
     queue_test(test_command_list_playback);
     queue_d3d10_test(test_max_bitmap_size);
     queue_test(test_dpi);
