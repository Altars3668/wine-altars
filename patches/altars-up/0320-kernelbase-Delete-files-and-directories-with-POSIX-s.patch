diff --git a/server/fd.c b/server/fd.c
index 198f7e71a48..d8fee9ff3bf 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -2817,7 +2817,11 @@ static void set_fd_disposition( struct fd *fd, unsigned int flags )
 
     if (!fd->inode)
     {
-        set_error( STATUS_OBJECT_TYPE_MISMATCH );
+        /* a device is not deleted: its driver does not take the request */
+        if (fd->unix_fd != -1 && !fstat( fd->unix_fd, &st ) && S_ISCHR( st.st_mode ))
+            set_error( STATUS_INVALID_DEVICE_REQUEST );
+        else
+            set_error( STATUS_OBJECT_TYPE_MISMATCH );
         return;
     }
 
