From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 00:45:17 -0400
Subject: [PATCH] kernelbase: Delete files and directories with POSIX
 semantics, as Windows 10 does.

Since Windows 10 1809, DeleteFileW() and RemoveDirectoryW() set FileDispositionInformationEx with
FILE_DISPOSITION_POSIX_SEMANTICS: the name goes at once and handles still open keep the file, where
the file system allows it, and they fall back to the old disposition where it does not.  Wine kept
the name until the last handle was closed and opening it meanwhile succeeded.

The server answers a disposition on a character device as a device driver does, with
STATUS_INVALID_DEVICE_REQUEST, which is what deleting "nul" gives.  Nine todos of ntdll's file test
pass.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index e21f6909f56..5c85e583c5a 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -1125,6 +1125,21 @@ BOOL WINAPI DECLSPEC_HOTPATCH DeleteFileA( LPCSTR path )
 /***********************************************************************
  *	DeleteFileW   (kernelbase.@)
  */
+/* delete as Windows 10 does: the name goes at once, with POSIX semantics, and handles still open keep
+ * the file; where the file system has no POSIX semantics, it goes when the last handle is closed */
+static NTSTATUS delete_open_file( HANDLE handle )
+{
+    FILE_DISPOSITION_INFORMATION_EX info = { FILE_DISPOSITION_DELETE | FILE_DISPOSITION_POSIX_SEMANTICS };
+    FILE_DISPOSITION_INFORMATION old_info = { TRUE };
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+
+    status = NtSetInformationFile( handle, &io, &info, sizeof(info), FileDispositionInformationEx );
+    if (status == STATUS_INVALID_INFO_CLASS || status == STATUS_NOT_SUPPORTED)
+        status = NtSetInformationFile( handle, &io, &old_info, sizeof(old_info), FileDispositionInformation );
+    return status;
+}
+
 BOOL WINAPI DECLSPEC_HOTPATCH DeleteFileW( LPCWSTR path )
 {
     UNICODE_STRING nameW;
@@ -1142,10 +1157,14 @@ BOOL WINAPI DECLSPEC_HOTPATCH DeleteFileW( LPCWSTR path )
     }
 
     InitializeObjectAttributes( &attr, &nameW, OBJ_CASE_INSENSITIVE, 0, NULL );
-    status = NtCreateFile( &hFile, SYNCHRONIZE | DELETE, &attr, &io, NULL, 0,
-                           FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN,
-                           FILE_DELETE_ON_CLOSE | FILE_NON_DIRECTORY_FILE | FILE_OPEN_REPARSE_POINT, NULL, 0 );
-    if (status == STATUS_SUCCESS) status = NtClose(hFile);
+    status = NtOpenFile( &hFile, SYNCHRONIZE | DELETE, &attr, &io,
+                         FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                         FILE_NON_DIRECTORY_FILE | FILE_OPEN_REPARSE_POINT | FILE_SYNCHRONOUS_IO_NONALERT );
+    if (status == STATUS_SUCCESS)
+    {
+        status = delete_open_file( hFile );
+        NtClose( hFile );
+    }
 
     RtlFreeUnicodeString( &nameW );
     return set_ntstatus( status );
@@ -3827,8 +3846,7 @@ BOOL WINAPI DECLSPEC_HOTPATCH RemoveDirectoryW( LPCWSTR path )
 
     if (!status)
     {
-        FILE_DISPOSITION_INFORMATION info = { TRUE };
-        status = NtSetInformationFile( handle, &io, &info, sizeof(info), FileDispositionInformation );
+        status = delete_open_file( handle );
         NtClose( handle );
     }
     return set_ntstatus( status );
