 WINE_DEFAULT_DEBUG_CHANNEL(rstrtmgr);
 
+/* A session is a key under HKEY_CURRENT_USER\Software\Microsoft\RestartManager, as on Windows, holding its key and
+ * the resources registered with it so that another process can join it; what was shut down and is to be restarted is
+ * the shutting down process's own.  Each start and join gives a handle of its own to the session's number. */
+
+#define MAX_SESSIONS        64
+#define SHUTDOWN_TIMEOUT    20000
+
+static const WCHAR rm_keyW[] = L"Software\\Microsoft\\RestartManager";
+
+struct filter
+{
+    struct list       entry;
+    RM_FILTER_ACTION  action;
+    RM_FILTER_TRIGGER trigger;
+    WCHAR            *name;          /* a file or a service */
+    RM_UNIQUE_PROCESS process;
+};
+
+struct app
+{
+    struct list      entry;
+    RM_PROCESS_INFO  info;
+    WCHAR           *image;          /* what restarting it starts */
+    WCHAR           *cmdline;
+    WCHAR           *directory;
+    HANDLE           restarted;      /* the process restarting started */
+};
+
+struct session
+{
+    struct list entry;
+    DWORD       handle;
+    DWORD       number;              /* the session's key in the registry */
+    BOOL        owner;
+    struct list filters;
+    struct list apps;                /* those shut down, as they were found */
+    BOOL        cancel;
+};
+
+static struct list sessions = LIST_INIT( sessions );
+static DWORD next_handle;
+
+static CRITICAL_SECTION rm_cs;
+static CRITICAL_SECTION_DEBUG rm_cs_debug =
+{
+    0, 0, &rm_cs,
+    { &rm_cs_debug.ProcessLocksList, &rm_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": rm_cs") }
+};
+static CRITICAL_SECTION rm_cs = { &rm_cs_debug, -1, 0, 0, 0, 0 };
+
+static WCHAR *strdupW( const WCHAR *str )
+{
+    WCHAR *ret;
+
+    if (!str) return NULL;
+    if ((ret = malloc( (wcslen( str ) + 1) * sizeof(WCHAR) ))) wcscpy( ret, str );
+    return ret;
+}
+
+static HKEY open_session_key( DWORD number, REGSAM access )
+{
+    WCHAR path[ARRAY_SIZE(rm_keyW) + 16];
+    HKEY key;
+
+    swprintf( path, ARRAY_SIZE(path), L"%s\\Session%04u", rm_keyW, number );
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, path, 0, access, &key )) return NULL;
+    return key;
+}
+
+/* the session a handle is, in this process; the lock is held */
+static struct session *get_session( DWORD handle )
+{
+    struct session *session;
+
+    LIST_FOR_EACH_ENTRY( session, &sessions, struct session, entry )
+        if (session->handle == handle) return session;
+    return NULL;
+}
+
+static struct session *add_session( DWORD number, BOOL owner )
+{
+    struct session *session;
+
+    if (!(session = calloc( 1, sizeof(*session) ))) return NULL;
+    session->handle = next_handle++;
+    session->number = number;
+    session->owner = owner;
+    list_init( &session->filters );
+    list_init( &session->apps );
+    list_add_tail( &sessions, &session->entry );
+    return session;
+}
+
+static void free_app( struct app *app )
+{
+    if (app->restarted) CloseHandle( app->restarted );
+    free( app->image );
+    free( app->cmdline );
+    free( app->directory );
+    free( app );
+}
+
+static void free_session( struct session *session )
+{
+    struct filter *filter, *next_filter;
+    struct app *app, *next_app;
+
+    list_remove( &session->entry );
+    LIST_FOR_EACH_ENTRY_SAFE( filter, next_filter, &session->filters, struct filter, entry )
+    {
+        free( filter->name );
+        free( filter );
+    }
+    LIST_FOR_EACH_ENTRY_SAFE( app, next_app, &session->apps, struct app, entry ) free_app( app );
+    free( session );
+}
