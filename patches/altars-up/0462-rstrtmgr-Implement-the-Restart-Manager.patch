 /***********************************************************************
- * RmGetList (rstrtmgr.@)
+ * RmStartSession (rstrtmgr.@)
  *
- * Retrieve the list of all applications and services using resources registered with the Restart Manager session
+ * Start a new Restart Manager session
  */
-DWORD WINAPI RmGetList(DWORD dwSessionHandle, UINT *pnProcInfoNeeded, UINT *pnProcInfo,
-                                      RM_PROCESS_INFO *rgAffectedApps[], LPDWORD lpdwRebootReasons)
-{
-    FIXME("%ld, %p, %p, %p, %p stub!\n", dwSessionHandle, pnProcInfoNeeded, pnProcInfo, rgAffectedApps, lpdwRebootReasons);
-    if (pnProcInfoNeeded)
-        *pnProcInfoNeeded = 0;
-    if (pnProcInfo)
-        *pnProcInfo = 0;
+DWORD WINAPI RmStartSession( DWORD *handle, DWORD flags, WCHAR key[] )
+{
+    WCHAR session_key[CCH_RM_SESSION_KEY + 1];
+    struct session *session;
+    HKEY root, sk;
+    DWORD i, disposition, pid = GetCurrentProcessId();
+    GUID guid;
+
+    TRACE( "%p, %#lx, %p\n", handle, flags, key );
+
+    if (!handle || !key) return ERROR_INVALID_PARAMETER;
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, rm_keyW, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &root, NULL ))
+        return ERROR_WRITE_FAULT;
+
+    UuidCreate( &guid );
+    swprintf( session_key, ARRAY_SIZE(session_key), L"%08lx%04x%04x%02x%02x%02x%02x%02x%02x%02x%02x", guid.Data1,
+              guid.Data2, guid.Data3, guid.Data4[0], guid.Data4[1], guid.Data4[2], guid.Data4[3], guid.Data4[4],
+              guid.Data4[5], guid.Data4[6], guid.Data4[7] );
+
+    /* the first number no session has */
+    for (i = 0; i < MAX_SESSIONS; i++)
+    {
+        WCHAR name[16];
+
+        swprintf( name, ARRAY_SIZE(name), L"Session%04u", i );
+        if (RegCreateKeyExW( root, name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &sk, &disposition )) continue;
+        if (disposition == REG_CREATED_NEW_KEY) break;
+        RegCloseKey( sk );
+    }
+    RegCloseKey( root );
+    if (i == MAX_SESSIONS) return ERROR_MAX_SESSIONS_REACHED;
+
+    RegSetValueExW( sk, L"SessionKey", 0, REG_SZ, (BYTE *)session_key, sizeof(session_key) );
+    RegSetValueExW( sk, L"Owner", 0, REG_DWORD, (BYTE *)&pid, sizeof(pid) );
+    RegCloseKey( sk );
+
+    EnterCriticalSection( &rm_cs );
+    if (!(session = add_session( i, TRUE )))
+    {
+        LeaveCriticalSection( &rm_cs );
+        return ERROR_OUTOFMEMORY;
+    }
+    *handle = session->handle;
+    LeaveCriticalSection( &rm_cs );
+    wcscpy( key, session_key );
+    TRACE( "session %lu, key %s\n", i, debugstr_w(session_key) );
     return ERROR_SUCCESS;
 }
 
+/***********************************************************************
+ * RmJoinSession (rstrtmgr.@)
+ *
+ * Join a session another process started
+ */
+DWORD WINAPI RmJoinSession( DWORD *handle, const WCHAR key[] )
+{
+    WCHAR name[16], value[CCH_RM_SESSION_KEY + 1];
+    struct session *session;
+    DWORD i, size;
+    HKEY root;
+
+    TRACE( "%p, %s\n", handle, debugstr_w(key) );
+
+    if (!handle || !key) return ERROR_INVALID_PARAMETER;
+    if (RegOpenKeyExW( HKEY_CURRENT_USER, rm_keyW, 0, KEY_READ, &root )) return ERROR_SESSION_CREDENTIAL_CONFLICT;
+    for (i = 0; i < MAX_SESSIONS; i++)
+    {
+        swprintf( name, ARRAY_SIZE(name), L"Session%04u", i );
+        size = sizeof(value);
+        if (RegGetValueW( root, name, L"SessionKey", RRF_RT_REG_SZ, NULL, value, &size )) continue;
+        if (wcsicmp( value, key )) continue;
+        RegCloseKey( root );
+        EnterCriticalSection( &rm_cs );
+        if (!(session = add_session( i, FALSE )))
+        {
+            LeaveCriticalSection( &rm_cs );
+            return ERROR_OUTOFMEMORY;
+        }
+        *handle = session->handle;
+        LeaveCriticalSection( &rm_cs );
+        return ERROR_SUCCESS;
+    }
+    RegCloseKey( root );
+    return ERROR_SESSION_CREDENTIAL_CONFLICT;
+}
+
+/***********************************************************************
+ * RmEndSession (rstrtmgr.@)
+ */
+DWORD WINAPI RmEndSession( DWORD handle )
+{
+    struct session *session;
+    WCHAR name[16];
+    DWORD number;
+    HKEY root;
+    BOOL owner;
+
+    TRACE( "%lu\n", handle );
+
+    EnterCriticalSection( &rm_cs );
+    if (!(session = get_session( handle )))
+    {
+        LeaveCriticalSection( &rm_cs );
+        return ERROR_INVALID_HANDLE;
+    }
+    owner = session->owner;
+    number = session->number;
+    free_session( session );
+    LeaveCriticalSection( &rm_cs );
+
+    /* the session goes when the process that started it ends it */
+    if (owner && !RegOpenKeyExW( HKEY_CURRENT_USER, rm_keyW, 0, KEY_ALL_ACCESS, &root ))
+    {
+        swprintf( name, ARRAY_SIZE(name), L"Session%04u", number );
+        RegDeleteTreeW( root, name );
+        RegCloseKey( root );
+    }
+    return ERROR_SUCCESS;
+}
+
+/* add strings to a REG_MULTI_SZ value */
+static DWORD add_multi_sz( HKEY key, const WCHAR *value_name, UINT count, const WCHAR **strings )
+{
+    DWORD size = 0, len, i, ret;
+    WCHAR *data, *p;
+
+    RegQueryValueExW( key, value_name, NULL, NULL, NULL, &size );
+    len = size / sizeof(WCHAR);
+    if (len) len--;     /* the final null */
+    for (i = 0; i < count; i++)
+    {
+        if (!strings[i]) return ERROR_INVALID_PARAMETER;
+        len += wcslen( strings[i] ) + 1;
+    }
+    if (!(data = calloc( len + 2, sizeof(WCHAR) ))) return ERROR_OUTOFMEMORY;
+    size = (len + 2) * sizeof(WCHAR);
+    if (RegQueryValueExW( key, value_name, NULL, NULL, (BYTE *)data, &size ) || size < 2 * sizeof(WCHAR))
+        p = data;
+    else
+        for (p = data; *p; p += wcslen( p ) + 1);
+    for (i = 0; i < count; i++)
+    {
+        wcscpy( p, strings[i] );
+        p += wcslen( p ) + 1;
+    }
+    *p++ = 0;
+    ret = RegSetValueExW( key, value_name, 0, REG_MULTI_SZ, (BYTE *)data, (p - data) * sizeof(WCHAR) );
+    free( data );
+    return ret;
+}
+
 /***********************************************************************
  * RmRegisterResources (rstrtmgr.@)
  *
  * Register resources for a Restart Manager session
  */
-DWORD WINAPI RmRegisterResources(DWORD dwSessionHandle, UINT nFiles, LPCWSTR rgsFilenames[],
-                                                     UINT nApplications, RM_UNIQUE_PROCESS *rgApplications,
-                                                     UINT nServices, LPCWSTR rgsServiceNames[])
+DWORD WINAPI RmRegisterResources( DWORD handle, UINT nfiles, const WCHAR *files[], UINT napps,
+                                  RM_UNIQUE_PROCESS *apps, UINT nservices, const WCHAR *services[] )
 {
-    FIXME("%ld, %d, %p, %d, %p, %d, %p stub!\n", dwSessionHandle, nFiles, rgsFilenames,
-              nApplications, rgApplications, nServices, rgsServiceNames);
-    return ERROR_SUCCESS;
+    WCHAR full[MAX_PATH], **paths;
+    DWORD ret = ERROR_SUCCESS, size = 0, number;
+    struct session *session;
+    BYTE *procs;
+    HKEY key;
+    UINT i;
+
+    TRACE( "%lu, %u, %p, %u, %p, %u, %p\n", handle, nfiles, files, napps, apps, nservices, services );
+
+    if ((nfiles && !files) || (napps && !apps) || (nservices && !services)) return ERROR_INVALID_PARAMETER;
+    EnterCriticalSection( &rm_cs );
+    if (!(session = get_session( handle )))
+    {
+        LeaveCriticalSection( &rm_cs );
+        return ERROR_INVALID_HANDLE;
+    }
+    number = session->number;
+    LeaveCriticalSection( &rm_cs );
+    if (!(key = open_session_key( number, KEY_ALL_ACCESS ))) return ERROR_INVALID_HANDLE;
+
+    /* files by their full path */
+    if (nfiles && (paths = calloc( nfiles, sizeof(*paths) )))
+    {
+        for (i = 0; i < nfiles; i++)
+        {
+            if (!files[i] || !GetFullPathNameW( files[i], ARRAY_SIZE(full), full, NULL )) break;
+            paths[i] = strdupW( full );
+        }
+        ret = i < nfiles ? ERROR_BAD_ARGUMENTS : add_multi_sz( key, L"RegFiles", nfiles, (const WCHAR **)paths );
+        for (i = 0; i < nfiles; i++) free( paths[i] );
+        free( paths );
+    }
+    if (!ret && napps)
+    {
+        RegQueryValueExW( key, L"RegProcs", NULL, NULL, NULL, &size );
+        if ((procs = malloc( size + napps * sizeof(*apps) )))
+        {
+            if (RegQueryValueExW( key, L"RegProcs", NULL, NULL, procs, &size )) size = 0;
+            memcpy( procs + size, apps, napps * sizeof(*apps) );
+            ret = RegSetValueExW( key, L"RegProcs", 0, REG_BINARY, procs, size + napps * sizeof(*apps) );
+            free( procs );
+        }
+        else ret = ERROR_OUTOFMEMORY;
+    }
+    if (!ret && nservices) ret = add_multi_sz( key, L"RegSvcs", nservices, services );
+    RegCloseKey( key );
+    return ret;
+}
+
+/* the processes found, each once */
+struct found
+{
+    DWORD *pids;
+    WCHAR **services;            /* the service a process is, if it is one */
+    unsigned int count, size;
+};
+
+static void add_found( struct found *found, DWORD pid, const WCHAR *service )
+{
+    unsigned int i;
+
+    for (i = 0; i < found->count; i++)
+        if (found->pids[i] == pid)
+        {
+            if (service && !found->services[i]) found->services[i] = strdupW( service );
+            return;
+        }
+    if (found->count == found->size)
+    {
+        unsigned int size = max( 16, found->size * 2 );
+        DWORD *pids = realloc( found->pids, size * sizeof(*pids) );
+        WCHAR **services;
+
+        if (!pids) return;
+        found->pids = pids;
+        if (!(services = realloc( found->services, size * sizeof(*services) ))) return;
+        found->services = services;
+        found->size = size;
+    }
+    found->pids[found->count] = pid;
+    found->services[found->count] = strdupW( service );
+    found->count++;
+}
+
+/* the processes that have a file open or mapped */
+static void find_file_users( const WCHAR *path, struct found *found )
+{
+    FILE_PROCESS_IDS_USING_FILE_INFORMATION *info;
+    ULONG size = 4096, i;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    HANDLE file;
+
+    file = CreateFileW( path, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL );
+    if (file == INVALID_HANDLE_VALUE) return;
+    for (;;)
+    {
+        if (!(info = malloc( size ))) break;
+        status = NtQueryInformationFile( file, &io, info, size, FileProcessIdsUsingFileInformation );
+        if (status == STATUS_INFO_LENGTH_MISMATCH && io.Information > size)
+        {
+            size = io.Information;
+            free( info );
+            continue;
+        }
+        if (!status)
+            for (i = 0; i < info->NumberOfProcessIdsInList; i++) add_found( found, info->ProcessIdList[i], NULL );
+        free( info );
+        break;
+    }
+    CloseHandle( file );
+}
+
+static void find_service( SC_HANDLE scm, const WCHAR *name, struct found *found )
+{
+    SERVICE_STATUS_PROCESS status;
+    SC_HANDLE service;
+    DWORD size;
+
+    if (!(service = OpenServiceW( scm, name, SERVICE_QUERY_STATUS ))) return;
+    if (QueryServiceStatusEx( service, SC_STATUS_PROCESS_INFO, (BYTE *)&status, sizeof(status), &size ) &&
+        status.dwCurrentState != SERVICE_STOPPED && status.dwProcessId)
+        add_found( found, status.dwProcessId, name );
+    CloseServiceHandle( service );
+}
+
+/* everything the session's resources lead to */
+static void find_processes( DWORD number, struct found *found )
+{
+    WCHAR *data, *p;
+    DWORD size;
+    HKEY key;
+
+    if (!(key = open_session_key( number, KEY_READ ))) return;
+    size = 0;
+    if (!RegQueryValueExW( key, L"RegFiles", NULL, NULL, NULL, &size ) && (data = malloc( size + 2 * sizeof(WCHAR) )))
+    {
+        memset( data, 0, size + 2 * sizeof(WCHAR) );
+        if (!RegQueryValueExW( key, L"RegFiles", NULL, NULL, (BYTE *)data, &size ))
+            for (p = data; *p; p += wcslen( p ) + 1) find_file_users( p, found );
+        free( data );
+    }
+    size = 0;
+    if (!RegQueryValueExW( key, L"RegProcs", NULL, NULL, NULL, &size ) && (data = malloc( size )))
+    {
+        if (!RegQueryValueExW( key, L"RegProcs", NULL, NULL, (BYTE *)data, &size ))
+        {
+            RM_UNIQUE_PROCESS *procs = (RM_UNIQUE_PROCESS *)data;
+            DWORD i;
+
+            for (i = 0; i < size / sizeof(*procs); i++)
+            {
+                HANDLE process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, procs[i].dwProcessId );
+                FILETIME created, dummy;
+
+                /* only the process as it was when registered, not another with its id since */
+                if (process && GetProcessTimes( process, &created, &dummy, &dummy, &dummy ) &&
+                    !CompareFileTime( &created, &procs[i].ProcessStartTime ))
+                    add_found( found, procs[i].dwProcessId, NULL );
+                if (process) CloseHandle( process );
+            }
+        }
+        free( data );
+    }
+    size = 0;
+    if (!RegQueryValueExW( key, L"RegSvcs", NULL, NULL, NULL, &size ) && (data = malloc( size + 2 * sizeof(WCHAR) )))
+    {
+        SC_HANDLE scm = OpenSCManagerW( NULL, NULL, SC_MANAGER_CONNECT );
+
+        memset( data, 0, size + 2 * sizeof(WCHAR) );
+        if (scm && !RegQueryValueExW( key, L"RegSvcs", NULL, NULL, (BYTE *)data, &size ))
+            for (p = data; *p; p += wcslen( p ) + 1) find_service( scm, p, found );
+        if (scm) CloseServiceHandle( scm );
+        free( data );
+    }
+    RegCloseKey( key );
+}
+
+/* what an image says it is, or its file name */
+static void get_app_name( const WCHAR *image, WCHAR *name, DWORD len )
+{
+    struct { WORD lang, codepage; } *translation;
+    WCHAR path[64], *description;
+    const WCHAR *p;
+    DWORD size;
+    UINT n;
+    void *data;
+
+    if ((size = GetFileVersionInfoSizeW( image, NULL )) && (data = malloc( size )))
+    {
+        if (GetFileVersionInfoW( image, 0, size, data ) &&
+            VerQueryValueW( data, L"\\VarFileInfo\\Translation", (void **)&translation, &n ) && n >= sizeof(*translation))
+        {
+            swprintf( path, ARRAY_SIZE(path), L"\\StringFileInfo\\%04x%04x\\FileDescription", translation->lang,
+                      translation->codepage );
+            if (VerQueryValueW( data, path, (void **)&description, &n ) && n && *description)
+            {
+                lstrcpynW( name, description, len );
+                free( data );
+                return;
+            }
+        }
+        free( data );
+    }
+    p = wcsrchr( image, '\\' );
+    lstrcpynW( name, p ? p + 1 : image, len );
+}
+
+struct window_search
+{
+    DWORD pid;
+    BOOL  visible;
+    BOOL  any;
+};
+
+static BOOL CALLBACK find_window( HWND hwnd, LPARAM lparam )
+{
+    struct window_search *search = (struct window_search *)lparam;
+    DWORD pid;
+
+    GetWindowThreadProcessId( hwnd, &pid );
+    if (pid != search->pid) return TRUE;
+    search->any = TRUE;
+    if (IsWindowVisible( hwnd ) && !GetWindow( hwnd, GW_OWNER )) search->visible = TRUE;
+    return TRUE;
+}
+
+static RM_APP_TYPE get_app_type( DWORD pid, const WCHAR *image, const WCHAR *service )
+{
+    struct window_search search = { pid };
+    const WCHAR *name = wcsrchr( image, '\\' );
+    IMAGE_NT_HEADERS nt;
+    DWORD read;
+    HANDLE file;
+
+    name = name ? name + 1 : image;
+    if (service) return RmService;
+    if (!wcsicmp( name, L"explorer.exe" )) return RmExplorer;
+    if (!wcsicmp( name, L"csrss.exe" ) || !wcsicmp( name, L"smss.exe" ) || !wcsicmp( name, L"wininit.exe" ) ||
+        !wcsicmp( name, L"winlogon.exe" ) || !wcsicmp( name, L"services.exe" ) || !wcsicmp( name, L"lsass.exe" ))
+        return RmCritical;
+
+    /* a console program is one, whatever windows it has */
+    file = CreateFileW( image, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                        OPEN_EXISTING, 0, NULL );
+    if (file != INVALID_HANDLE_VALUE)
+    {
+        IMAGE_DOS_HEADER dos;
+
+        if (ReadFile( file, &dos, sizeof(dos), &read, NULL ) && read == sizeof(dos) &&
+            dos.e_magic == IMAGE_DOS_SIGNATURE && SetFilePointer( file, dos.e_lfanew, NULL, FILE_BEGIN ) != INVALID_SET_FILE_POINTER &&
+            ReadFile( file, &nt, sizeof(nt), &read, NULL ) && read >= FIELD_OFFSET(IMAGE_NT_HEADERS, OptionalHeader) + 0x48 &&
+            nt.OptionalHeader.Subsystem == IMAGE_SUBSYSTEM_WINDOWS_CUI)
+        {
+            CloseHandle( file );
+            return RmConsole;
+        }
+        CloseHandle( file );
+    }
+    EnumWindows( find_window, (LPARAM)&search );
+    if (search.visible) return RmMainWindow;
+    if (search.any) return RmOtherWindow;
+    return RmUnknownApp;
+}
+
+/* how RmGetList shows a process, and what restarting it takes */
+static struct app *describe_process( DWORD pid, const WCHAR *service )
+{
+    WCHAR image[MAX_PATH], cmdline[RESTART_MAX_CMD_LINE];
+    DWORD size, flags, session_id = 0;
+    FILETIME dummy;
+    HANDLE process;
+    struct app *app;
+
+    if (!(app = calloc( 1, sizeof(*app) ))) return NULL;
+    app->info.Process.dwProcessId = pid;
+    app->info.AppStatus = RmStatusRunning;
+    app->info.TSSessionID = ProcessIdToSessionId( pid, &session_id ) ? session_id : RM_INVALID_TS_SESSION;
+
+    process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION | PROCESS_VM_READ, FALSE, pid );
+    if (!process) process = OpenProcess( PROCESS_QUERY_LIMITED_INFORMATION, FALSE, pid );
+    size = ARRAY_SIZE(image);
+    if (!process || !QueryFullProcessImageNameW( process, 0, image, &size )) image[0] = 0;
+    if (process) GetProcessTimes( process, &app->info.Process.ProcessStartTime, &dummy, &dummy, &dummy );
+    app->image = strdupW( image );
+
+    if (service)
+    {
+        lstrcpynW( app->info.strServiceShortName, service, ARRAY_SIZE(app->info.strServiceShortName) );
+        lstrcpynW( app->info.strAppName, service, ARRAY_SIZE(app->info.strAppName) );
+        app->info.bRestartable = TRUE;
+    }
+    else if (image[0]) get_app_name( image, app->info.strAppName, ARRAY_SIZE(app->info.strAppName) );
+    app->info.ApplicationType = get_app_type( pid, image, service );
+
+    /* an application restarts if it registered for it, but not for a patch */
+    size = ARRAY_SIZE(cmdline);
+    if (!service && process && GetApplicationRestartSettings( process, cmdline, &size, &flags ) == S_OK &&
+        !(flags & RESTART_NO_PATCH))
+    {
+        app->info.bRestartable = TRUE;
+        app->cmdline = strdupW( cmdline );
+    }
+    if (process) CloseHandle( process );
+    return app;
+}
+
+static BOOL filtered( struct session *session, const struct app *app, RM_FILTER_ACTION action )
+{
+    struct filter *filter;
+    const WCHAR *name;
+
+    LIST_FOR_EACH_ENTRY( filter, &session->filters, struct filter, entry )
+    {
+        if (filter->action != action) continue;
+        switch (filter->trigger)
+        {
+        case RmFilterTriggerProcess:
+            if (filter->process.dwProcessId == app->info.Process.dwProcessId &&
+                !CompareFileTime( &filter->process.ProcessStartTime, &app->info.Process.ProcessStartTime ))
+                return TRUE;
+            break;
+        case RmFilterTriggerService:
+            if (!wcsicmp( filter->name, app->info.strServiceShortName )) return TRUE;
+            break;
+        case RmFilterTriggerFile:
+            /* a module by its path, or by its name alone */
+            if (!app->image) break;
+            if (wcschr( filter->name, '\\' )) name = app->image;
+            else name = wcsrchr( app->image, '\\' ) ? wcsrchr( app->image, '\\' ) + 1 : app->image;
+            if (!wcsicmp( filter->name, name )) return TRUE;
+            break;
+        default:
+            break;
+        }
+    }
+    return FALSE;
+}
+
+/* the applications the session affects: those shut down as they were, then those found now; the lock is held */
+static void get_apps( struct session *session, struct list *apps, DWORD *reasons )
+{
+    struct found found = { 0 };
+    struct app *app, *copy;
+    unsigned int i;
+
+    *reasons = RmRebootReasonNone;
+    LIST_FOR_EACH_ENTRY( app, &session->apps, struct app, entry )
+    {
+        if (!(copy = calloc( 1, sizeof(*copy) ))) continue;
+        copy->info = app->info;
+        /* restarted, it runs again while the new process does */
+        if (app->restarted && WaitForSingleObject( app->restarted, 0 ) == WAIT_TIMEOUT)
+            copy->info.AppStatus |= RmStatusRunning;
+        list_add_tail( apps, &copy->entry );
+    }
+    find_processes( session->number, &found );
+    for (i = 0; i < found.count; i++)
+    {
+        BOOL known = FALSE;
+
+        if (found.pids[i] == GetCurrentProcessId())
+        {
+            /* the caller cannot shut itself down */
+            *reasons |= RmRebootReasonDetectedSelf;
+            continue;
+        }
+        LIST_FOR_EACH_ENTRY( app, &session->apps, struct app, entry )
+            if (app->info.Process.dwProcessId == found.pids[i] && (app->info.AppStatus & RmStatusRestarted) == 0 &&
+                (app->info.AppStatus & RmStatusStopped)) known = TRUE;
+        if (known || !(app = describe_process( found.pids[i], found.services[i] ))) continue;
+        if (app->info.ApplicationType == RmCritical) *reasons |= RmRebootReasonCriticalProcess;
+        if (filtered( session, app, RmNoShutdown )) app->info.AppStatus |= RmStatusShutdownMasked;
+        if (filtered( session, app, RmNoRestart )) app->info.AppStatus |= RmStatusRestartMasked;
+        list_add_tail( apps, &app->entry );
+    }
+    for (i = 0; i < found.count; i++) free( found.services[i] );
+    free( found.pids );
+    free( found.services );
 }
 
