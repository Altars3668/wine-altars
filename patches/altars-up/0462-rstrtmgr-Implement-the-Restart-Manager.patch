+struct close_info
+{
+    DWORD pid;
+    BOOL  end;
+};
+
+/* ask a process's top-level windows, hidden ones as well, to end their session for the application's sake */
+static BOOL CALLBACK close_windows( HWND hwnd, LPARAM lparam )
+{
+    struct close_info *info = (struct close_info *)lparam;
+    DWORD pid;
+    DWORD_PTR result;
+
+    GetWindowThreadProcessId( hwnd, &pid );
+    if (pid != info->pid) return TRUE;
+    if (!info->end)
+        SendMessageTimeoutW( hwnd, WM_QUERYENDSESSION, 0, ENDSESSION_CLOSEAPP, SMTO_ABORTIFHUNG, 5000, &result );
+    else
+        SendMessageTimeoutW( hwnd, WM_ENDSESSION, TRUE, ENDSESSION_CLOSEAPP, SMTO_ABORTIFHUNG, 5000, &result );
+    return TRUE;
+}
+
+static BOOL stop_service( const WCHAR *name, BOOL force )
+{
+    SC_HANDLE scm, service;
+    SERVICE_STATUS status;
+    DWORD start = GetTickCount();
+    BOOL ret = FALSE;
+
+    if (!(scm = OpenSCManagerW( NULL, NULL, SC_MANAGER_CONNECT ))) return FALSE;
+    if ((service = OpenServiceW( scm, name, SERVICE_STOP | SERVICE_QUERY_STATUS )))
+    {
+        if (ControlService( service, SERVICE_CONTROL_STOP, &status ) || GetLastError() == ERROR_SERVICE_NOT_ACTIVE)
+        {
+            while (QueryServiceStatus( service, &status ) && status.dwCurrentState != SERVICE_STOPPED &&
+                   GetTickCount() - start < SHUTDOWN_TIMEOUT)
+                Sleep( 100 );
+            ret = status.dwCurrentState == SERVICE_STOPPED;
+        }
+        CloseServiceHandle( service );
+    }
+    CloseServiceHandle( scm );
+    return ret;
+}
+
+static BOOL stop_app( struct app *app, BOOL force )
+{
+    struct close_info info = { app->info.Process.dwProcessId };
+    HANDLE process;
+    BOOL ret;
+
+    if (app->info.ApplicationType == RmService) return stop_service( app->info.strServiceShortName, force );
+    if (!(process = OpenProcess( SYNCHRONIZE | PROCESS_TERMINATE, FALSE, app->info.Process.dwProcessId )))
+        return GetLastError() == ERROR_INVALID_PARAMETER;   /* gone already */
+    EnumWindows( close_windows, (LPARAM)&info );
+    info.end = TRUE;
+    EnumWindows( close_windows, (LPARAM)&info );
+    ret = !WaitForSingleObject( process, SHUTDOWN_TIMEOUT );
+    if (!ret && force) ret = TerminateProcess( process, 1 ) && !WaitForSingleObject( process, 5000 );
+    CloseHandle( process );
+    return ret;
 }
 
