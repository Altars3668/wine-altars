+static char selfname[MAX_PATH];
+
+static void test_sessions(void)
+{
+    WCHAR key[CCH_RM_SESSION_KEY + 1], other[CCH_RM_SESSION_KEY + 1];
+    DWORD session, session2, ret, reasons;
+    UINT needed, count;
+
+    memset( key, 0, sizeof(key) );
+    ret = RmStartSession( &session, 0, key );
+    ok( !ret, "got %lu\n", ret );
+    ok( wcslen( key ) == CCH_RM_SESSION_KEY, "got key %s\n", wine_dbgstr_w(key) );
+
+    ret = RmStartSession( &session2, 0, other );
+    ok( !ret, "got %lu\n", ret );
+    ok( session2 != session, "the same handle\n" );
+    ok( wcscmp( key, other ), "the same key\n" );
+    ret = RmEndSession( session2 );
+    ok( !ret, "got %lu\n", ret );
+
+    ret = RmJoinSession( &session2, key );
+    ok( !ret, "got %lu\n", ret );
+    if (!ret && session2 != session) RmEndSession( session2 );
+
+    /* a count with nowhere to put them is wrong */
+    needed = count = 0xdead;
+    reasons = 0xdead;
+    ret = RmGetList( session, &needed, &count, NULL, &reasons );
+    ok( ret == ERROR_BAD_ARGUMENTS, "got %lu\n", ret );
+    ok( needed == 0xdead, "got %u\n", needed );
+    needed = count = 0;
+    ret = RmGetList( session, &needed, &count, NULL, &reasons );
+    ok( !ret, "got %lu\n", ret );
+    ok( !needed, "got %u\n", needed );
+    ok( !reasons, "got %#lx\n", reasons );
+
+    ret = RmEndSession( session );
+    ok( !ret, "got %lu\n", ret );
+    ret = RmEndSession( session );
+    ok( ret == ERROR_INVALID_HANDLE, "got %lu\n", ret );
+    ret = RmGetList( session, &needed, &count, NULL, &reasons );
+    ok( ret == ERROR_INVALID_HANDLE, "got %lu\n", ret );
+}
+
+static LRESULT CALLBACK child_proc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_QUERYENDSESSION)
+    {
+        ok( lparam == ENDSESSION_CLOSEAPP, "got %#Ix\n", lparam );
+        return TRUE;
+    }
+    if (msg == WM_ENDSESSION && wparam)
+    {
+        ok( lparam == ENDSESSION_CLOSEAPP, "got %#Ix\n", lparam );
+        ExitProcess( 5 );
+    }
+    return DefWindowProcA( hwnd, msg, wparam, lparam );
+}
+
+/* hold the file, be restartable, and go when the session ends */
+static void child( const char *path, DWORD flags )
+{
+    HANDLE file, ready, done;
+    WNDCLASSA cls = { 0 };
+    MSG msg;
+
+    file = CreateFileA( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_DELETE, NULL, OPEN_EXISTING,
+                        0, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError() );
+    RegisterApplicationRestart( L"rstrtmgr restarted", flags );
+    cls.lpfnWndProc = child_proc;
+    cls.lpszClassName = "rm_child";
+    RegisterClassA( &cls );
+    CreateWindowExA( 0, "rm_child", "rm child", WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL, NULL, NULL );
+    ready = OpenEventA( EVENT_MODIFY_STATE, FALSE, "rm_test_ready" );
+    done = OpenEventA( SYNCHRONIZE, FALSE, "rm_test_done" );
+    SetEvent( ready );
+    while (MsgWaitForMultipleObjects( 1, &done, FALSE, 30000, QS_ALLINPUT ) == WAIT_OBJECT_0 + 1)
+        while (PeekMessageA( &msg, NULL, 0, 0, PM_REMOVE )) DispatchMessageA( &msg );
+    CloseHandle( file );
+}
+
+static void test_shutdown_restart( DWORD restart_flags )
+{
+    char path[MAX_PATH], cmdline[MAX_PATH * 2], marker[MAX_PATH];
+    STARTUPINFOA si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    WCHAR key[CCH_RM_SESSION_KEY + 1], pathW[MAX_PATH];
+    const WCHAR *files[1] = { pathW };
+    RM_PROCESS_INFO info[4];
+    HANDLE ready, done, file;
+    DWORD session, ret, reasons, exit_code;
+    UINT needed, count;
+    BOOL restartable = !(restart_flags & RESTART_NO_PATCH);
+
+    GetTempPathA( MAX_PATH, path );
+    strcat( path, "rm_test.tmp" );
+    sprintf( marker, "%s.restarted", path );
+    DeleteFileA( marker );
+    file = CreateFileA( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+    CloseHandle( file );
+    MultiByteToWideChar( CP_ACP, 0, path, -1, pathW, MAX_PATH );
+
+    ready = CreateEventA( NULL, TRUE, FALSE, "rm_test_ready" );
+    done = CreateEventA( NULL, TRUE, FALSE, "rm_test_done" );
+    sprintf( cmdline, "\"%s\" rstrtmgr child \"%s\" %lu", selfname, path, restart_flags );
+    ok( CreateProcessA( NULL, cmdline, NULL, NULL, FALSE, DETACHED_PROCESS, NULL, NULL, &si, &pi ),
+        "CreateProcess failed\n" );
+    ok( !WaitForSingleObject( ready, 10000 ), "the child did not get ready\n" );
+
+    ret = RmStartSession( &session, 0, key );
+    ok( !ret, "got %lu\n", ret );
+    ret = RmRegisterResources( session, 1, files, 0, NULL, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+
+    needed = 0xdead;
+    count = 0;
+    ret = RmGetList( session, &needed, &count, NULL, &reasons );
+    ok( ret == ERROR_MORE_DATA, "got %lu\n", ret );
+    ok( needed == 1, "got %u\n", needed );
+    ok( !count, "got %u\n", count );
+    count = ARRAY_SIZE(info);
+    ret = RmGetList( session, &needed, &count, info, &reasons );
+    ok( !ret, "got %lu\n", ret );
+    ok( count == 1, "got %u\n", count );
+    ok( info[0].Process.dwProcessId == pi.dwProcessId, "got %lu\n", info[0].Process.dwProcessId );
+    ok( info[0].ApplicationType == RmConsole, "got %u\n", info[0].ApplicationType );
+    ok( info[0].AppStatus == RmStatusRunning, "got %#lx\n", info[0].AppStatus );
+    ok( info[0].bRestartable == restartable, "got %d\n", info[0].bRestartable );
+    ok( !wcsicmp( info[0].strAppName, L"rstrtmgr_test.exe" ), "got %s\n", wine_dbgstr_w(info[0].strAppName) );
+
+    ret = RmShutdown( session, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForSingleObject( pi.hProcess, 5000 );
+    ok( !ret, "the child is still running\n" );
+    GetExitCodeProcess( pi.hProcess, &exit_code );
+    ok( exit_code == 5, "got %lu\n", exit_code );
+
+    count = ARRAY_SIZE(info);
+    ret = RmGetList( session, &needed, &count, info, &reasons );
+    ok( !ret, "got %lu\n", ret );
+    ok( count == 1, "got %u\n", count );
+    ok( info[0].AppStatus == RmStatusStopped, "got %#lx\n", info[0].AppStatus );
+
+    ret = RmRestart( session, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    count = ARRAY_SIZE(info);
+    ret = RmGetList( session, &needed, &count, info, &reasons );
+    ok( !ret, "got %lu\n", ret );
+    ok( count >= 1, "got %u\n", count );
+    /* restarted, it runs again while the new process does */
+    ok( (info[0].AppStatus & ~RmStatusRunning) == (restartable ? RmStatusStopped | RmStatusRestarted : RmStatusStopped),
+        "got %#lx\n", info[0].AppStatus );
+
+    ret = RmEndSession( session );
+    ok( !ret, "got %lu\n", ret );
+    if (restartable)
+    {
+        /* the restarted child says it was */
+        DWORD start = GetTickCount();
+        while (GetFileAttributesA( marker ) == INVALID_FILE_ATTRIBUTES && GetTickCount() - start < 10000)
+            Sleep( 100 );
+        /* Windows from a service session starts it where it is not seen */
+        ok( GetFileAttributesA( marker ) != INVALID_FILE_ATTRIBUTES || broken(TRUE), "nothing restarted\n" );
+    }
+    SetEvent( done );
+    CloseHandle( pi.hProcess );
+    CloseHandle( pi.hThread );
+    CloseHandle( ready );
+    CloseHandle( done );
+    DeleteFileA( marker );
+    DeleteFileA( path );
+}
+
+START_TEST(rstrtmgr)
+{
+    char **argv;
+    int argc = winetest_get_mainargs( &argv );
+
+    GetModuleFileNameA( NULL, selfname, sizeof(selfname) );
+    if (argc >= 5 && !strcmp( argv[2], "child" ))
+    {
+        child( argv[3], atoi( argv[4] ) );
+        return;
+    }
+    if (argc >= 3 && !strcmp( argv[2], "restarted" ))
+    {
+        char path[MAX_PATH];
+        HANDLE file;
+
+        GetTempPathA( MAX_PATH, path );
+        strcat( path, "rm_test.tmp.restarted" );
+        file = CreateFileA( path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL );
+        CloseHandle( file );
+        return;
+    }
+
+    test_sessions();
+    test_shutdown_restart( 0 );
+    test_shutdown_restart( RESTART_NO_PATCH );
+}
