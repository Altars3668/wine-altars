From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 10:12:17 -0400
Subject: [PATCH] wininet: Cache a response with an Expires that is not a date
 as expired.

HTTP takes an invalid Expires, "-1" being the usual way to say not to keep the response, as a time in
the past.  It failed to parse and the default of ten minutes applied, so such a response was served
from the cache for ten minutes; Exchange's answers to Outlook are among them.  A date in a header
that does not parse is the server's, not an error here: warn about it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wininet/http.c b/dlls/wininet/http.c
index fe68860bbd2..afb6502bc8b 100644
--- a/dlls/wininet/http.c
+++ b/dlls/wininet/http.c
@@ -4514,7 +4514,7 @@ static BOOL HTTP_ParseDateAsAsctime(LPCWSTR value, FILETIME *ft)
     st.wDayOfWeek = HTTP_ParseWkday(day);
     if (st.wDayOfWeek >= 7)
     {
-        ERR("unexpected weekday %s\n", debugstr_w(day));
+        WARN("unexpected weekday %s\n", debugstr_w(day));
         return FALSE;
     }
 
@@ -4688,7 +4688,7 @@ static BOOL HTTP_ParseRfc850Date(LPCWSTR value, FILETIME *ft)
         st.wDayOfWeek = HTTP_ParseWkday(day);
         if (st.wDayOfWeek > 6)
         {
-            ERR("unexpected weekday %s\n", debugstr_wn(value, ptr - value));
+            WARN("unexpected weekday %s\n", debugstr_wn(value, ptr - value));
             return FALSE;
         }
     }
@@ -4699,13 +4699,13 @@ static BOOL HTTP_ParseRfc850Date(LPCWSTR value, FILETIME *ft)
         st.wDayOfWeek = HTTP_ParseWeekday(day);
         if (st.wDayOfWeek > 6)
         {
-            ERR("unexpected weekday %s\n", debugstr_wn(value, ptr - value));
+            WARN("unexpected weekday %s\n", debugstr_wn(value, ptr - value));
             return FALSE;
         }
     }
     else
     {
-        ERR("unexpected weekday %s\n", debugstr_wn(value, ptr - value));
+        WARN("unexpected weekday %s\n", debugstr_wn(value, ptr - value));
         return FALSE;
     }
     ptr++;
@@ -4786,14 +4786,14 @@ static BOOL HTTP_ParseDate(LPCWSTR value, FILETIME *ft)
         {
             ret = HTTP_ParseRfc850Date(value, ft);
             if (!ret)
-                ERR("unexpected date format %s\n", debugstr_w(value));
+                WARN("unexpected date format %s\n", debugstr_w(value));
         }
     }
     else
     {
         ret = HTTP_ParseDateAsAsctime(value, ft);
         if (!ret)
-            ERR("unexpected date format %s\n", debugstr_w(value));
+            WARN("unexpected date format %s\n", debugstr_w(value));
     }
     return ret;
 }
@@ -4865,11 +4865,12 @@ static void HTTP_ProcessExpires(http_request_t *request)
             LPHTTPHEADERW expiresHeader = &request->custHeaders[headerIndex];
             FILETIME ft;
 
-            if (HTTP_ParseDate(expiresHeader->lpszValue, &ft))
-            {
-                expirationFound = TRUE;
-                request->expires = ft;
-            }
+            /* one that is not a date means one in the past (RFC 9111): "-1" is the usual way to say "do not
+             * keep this", and the default ten minutes kept it */
+            if (!HTTP_ParseDate(expiresHeader->lpszValue, &ft))
+                ft.dwLowDateTime = ft.dwHighDateTime = 0;
+            expirationFound = TRUE;
+            request->expires = ft;
         }
     }
     if (!expirationFound)
diff --git a/dlls/wininet/tests/http.c b/dlls/wininet/tests/http.c
index d0da3db4654..107a3967e39 100644
--- a/dlls/wininet/tests/http.c
+++ b/dlls/wininet/tests/http.c
@@ -2855,6 +2855,12 @@ static DWORD CALLBACK server_thread(LPVOID param)
                                                     "Content-Length: 12\r\n\r\nsome content";
             send(c, max_age_response, sizeof(max_age_response)-1, 0);
         }
+        if (strstr(buffer, "GET /test_cache_expires_invalid"))
+        {
+            static const char expires_response[] = "HTTP/1.1 200 OK\r\nExpires: -1\r\n"
+                                                   "Content-Length: 12\r\n\r\nsome content";
+            send(c, expires_response, sizeof(expires_response)-1, 0);
+        }
         if (strstr(buffer, "GET /test_cache_control_no_store"))
         {
             static const char no_cache_response[] = "HTTP/1.1 200 OK\r\nCache-Control: junk, \t No-StOrE\r\n\r\nsome content";
@@ -4244,10 +4250,10 @@ static void test_no_cache(int port)
     InternetCloseHandle(ses);
 }
 
-/* a response kept for an hour is cached with an hour to go */
-static void test_cache_max_age(int port)
+/* a response is cached to expire as it says: an hour to go for one kept for an hour, and none for one whose
+ * Expires is not a date, which HTTP takes as one in the past and is the usual way to say "-1" */
+static void test_cache_expiry(int port, const char *path, LONGLONG min_left, LONGLONG max_left)
 {
-    static const char path[] = "/test_cache_max_age";
     char cache_url[256], buf[256], info_buf[4096];
     INTERNET_CACHE_ENTRY_INFOA *info = (INTERNET_CACHE_ENTRY_INFOA *)info_buf;
     HINTERNET ses, con, req;
@@ -4286,7 +4292,7 @@ static void test_cache_max_age(int port)
         expires.LowPart = info->ExpireTime.dwLowDateTime;
         expires.HighPart = info->ExpireTime.dwHighDateTime;
         left = ((LONGLONG)expires.QuadPart - (LONGLONG)now.QuadPart) / 10000000;
-        ok(left > 3500 && left <= 3600, "entry expires in %I64d s\n", left);
+        ok(left > min_left && left <= max_left, "%s: entry expires in %I64d s\n", path, left);
     }
     DeleteUrlCacheEntryA(cache_url);
 
@@ -7092,7 +7098,8 @@ static void test_http_connection(void)
     test_large_header(si.port);
     test_conn_close(si.port);
     test_no_cache(si.port);
-    test_cache_max_age(si.port);
+    test_cache_expiry(si.port, "/test_cache_max_age", 3500, 3600);
+    test_cache_expiry(si.port, "/test_cache_expires_invalid", LLONG_MIN, 0);
     test_cache_read_gzipped(si.port);
     test_http_status(si.port);
     test_premature_disconnect(si.port);
