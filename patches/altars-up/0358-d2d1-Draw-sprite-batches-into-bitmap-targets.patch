From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 05:01:07 -0400
Subject: [PATCH] d2d1: Draw sprite batches into bitmap targets.

Each sprite draws its source rectangle of the bitmap, in pixels, into its
destination through its own transform and then the context's, at the
opacity of its colour.  PowerPoint draws sprite batches; they drew
nothing.  Colours other than white, which tint on Windows, and clamping
to the source rectangle are not done yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 95d92bb45f3..4894a93dca8 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -4479,7 +4479,40 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawSpriteBatch(ID2D1DeviceCont
     }
     else
     {
-        FIXME("Unimplemented for bitmap render target.\n");
+        D2D1_MATRIX_3X2_F transform = context->drawing_state.transform;
+        float dpi_x, dpi_y;
+        unsigned int i;
+
+        if (sprite_options & D2D1_SPRITE_OPTIONS_CLAMP_TO_SOURCE_RECTANGLE)
+            FIXME("Ignoring sprite options %#x.\n", sprite_options);
+
+        ID2D1Bitmap_GetDpi(bitmap, &dpi_x, &dpi_y);
+        /* each sprite is the bitmap's source rectangle, in pixels, drawn into its destination through its
+         * own transform and then the context's */
+        for (i = start_index; i < start_index + sprite_count; ++i)
+        {
+            const struct d2d_sprite *sprite = &batch->sprites[i];
+            D2D1_RECT_F src;
+
+            if (sprite->color.r != 1.0f || sprite->color.g != 1.0f || sprite->color.b != 1.0f)
+            {
+                static int once;
+                if (!once++)
+                    FIXME("Sprite colour %s is drawn as its opacity only.\n", debug_d2d_color_f(&sprite->color));
+            }
+
+            src.left = sprite->source.left * 96.0f / dpi_x;
+            src.top = sprite->source.top * 96.0f / dpi_y;
+            src.right = sprite->source.right * 96.0f / dpi_x;
+            src.bottom = sprite->source.bottom * 96.0f / dpi_y;
+
+            context->drawing_state.transform = sprite->transform;
+            d2d_matrix_multiply(&context->drawing_state.transform, &transform);
+            d2d_device_context_draw_bitmap(context, bitmap, &sprite->dest, sprite->color.a,
+                    d2d1_1_interp_mode_from_d2d1(interpolation_mode),
+                    sprite->source.right == UINT_MAX ? NULL : &src, NULL, NULL);
+        }
+        context->drawing_state.transform = transform;
     }
 }
 
diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index ad9665eaa50..faa6e0346b7 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -21510,6 +21510,66 @@ static void test_sprite_batch(BOOL d3d11)
     ok(match, "Got unexpected rectangle {%.8e, %.8e, %.8e, %.8e}.\n",
             dests[1].left, dests[1].top, dests[1].right, dests[1].bottom);
 
+    /* Drawn into a bitmap: the whole bitmap, one quarter of it scaled up, and the whole bitmap moved
+     * down by its sprite's transform. */
+    {
+        static const DWORD data[16] =
+        {
+            0xffff0000, 0xffff0000, 0xff0000ff, 0xff0000ff,
+            0xffff0000, 0xffff0000, 0xff0000ff, 0xff0000ff,
+            0xff00ff00, 0xff00ff00, 0xffffffff, 0xffffffff,
+            0xff00ff00, 0xff00ff00, 0xffffffff, 0xffffffff,
+        };
+        D2D1_BITMAP_PROPERTIES1 bitmap_desc;
+        D2D1_RECT_U quarter = { 0, 0, 2, 2 };
+        ID2D1Bitmap1 *bitmap;
+        D2D1_SIZE_U size;
+
+        set_size_u(&size, 4, 4);
+        bitmap_desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+        bitmap_desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_PREMULTIPLIED;
+        bitmap_desc.dpiX = 96.0f;
+        bitmap_desc.dpiY = 96.0f;
+        bitmap_desc.bitmapOptions = D2D1_BITMAP_OPTIONS_NONE;
+        bitmap_desc.colorContext = NULL;
+        hr = ID2D1DeviceContext3_CreateBitmap(context, size, data, sizeof(*data) * 4, &bitmap_desc, &bitmap);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+        ID2D1SpriteBatch_Clear(sprite_batch);
+        set_rect(&dests[0], 0.0f, 0.0f, 4.0f, 4.0f);
+        set_rect(&dests[1], 8.0f, 0.0f, 12.0f, 4.0f);
+        hr = ID2D1SpriteBatch_AddSprites(sprite_batch, 1, &dests[0], NULL, NULL, NULL, 0, 0, 0, 0);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        hr = ID2D1SpriteBatch_AddSprites(sprite_batch, 1, &dests[1], &quarter, NULL, NULL, 0, 0, 0, 0);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        set_matrix_identity(&transforms[0]);
+        translate_matrix(&transforms[0], 0.0f, 8.0f);
+        hr = ID2D1SpriteBatch_AddSprites(sprite_batch, 1, &dests[0], NULL, NULL, &transforms[0], 0, 0, 0, 0);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+        ID2D1DeviceContext3_BeginDraw(context);
+        ID2D1DeviceContext3_Clear(context, NULL);
+        ID2D1DeviceContext3_SetAntialiasMode(context, D2D1_ANTIALIAS_MODE_ALIASED);
+        ID2D1DeviceContext3_DrawSpriteBatch(context, sprite_batch, 0, 3, (ID2D1Bitmap *)bitmap,
+                D2D1_BITMAP_INTERPOLATION_MODE_NEAREST_NEIGHBOR, D2D1_SPRITE_OPTIONS_NONE);
+        hr = ID2D1DeviceContext3_EndDraw(context, NULL, NULL);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ID2D1DeviceContext3_SetAntialiasMode(context, D2D1_ANTIALIAS_MODE_PER_PRIMITIVE);
+
+        check_effect_pixel(&ctx, 1, 1, 0xffff0000, 0);
+        check_effect_pixel(&ctx, 3, 1, 0xff0000ff, 0);
+        check_effect_pixel(&ctx, 1, 3, 0xff00ff00, 0);
+        check_effect_pixel(&ctx, 3, 3, 0xffffffff, 0);
+        check_effect_pixel(&ctx, 8, 0, 0xffff0000, 0);
+        check_effect_pixel(&ctx, 11, 3, 0xffff0000, 0);
+        check_effect_pixel(&ctx, 13, 1, 0x00000000, 0);
+        check_effect_pixel(&ctx, 1, 9, 0xffff0000, 0);
+        check_effect_pixel(&ctx, 3, 11, 0xffffffff, 0);
+        check_effect_pixel(&ctx, 1, 5, 0x00000000, 0);
+
+        ID2D1Bitmap1_Release(bitmap);
+    }
+
     ID2D1DeviceContext3_Release(context);
     ID2D1SpriteBatch_Release(sprite_batch);
     release_test_context(&ctx);
