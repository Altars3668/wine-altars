--- a/server/fd.c
+++ b/server/fd.c
@@ -3046,6 +3046,11 @@ static void set_fd_eof( struct fd *fd, file_pos_t eof )
         file_set_error();
         return;
     }
+    if (S_ISDIR( st.st_mode ))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
