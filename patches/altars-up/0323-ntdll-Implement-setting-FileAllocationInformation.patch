From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 01:26:19 -0400
Subject: [PATCH] ntdll: Implement setting FileAllocationInformation.

As [MS-FSA] 2.1.5.15.1 describes NTFS: the size goes up to a whole
cluster, space past the end of file is reserved without moving it
(fallocate with FALLOC_FL_KEEP_SIZE where the file system can), and an
allocation below the end of file truncates the file to it.  It takes
FILE_WRITE_DATA and does not apply to directories, and neither does
setting the end of file, which the server allowed on any handle and
refused on a read-only one only when ftruncate failed, as
STATUS_INVALID_HANDLE.

SetFileInformationByHandle passes FileAllocationInfo on, and fails the
classes that are only for querying with ERROR_INVALID_PARAMETER, as it
already did for four of them, instead of a FIXME.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 5c85e583c5a..3d0b94e2b3c 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -3885,25 +3885,12 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetFileInformationByHandle( HANDLE file, FILE_INFO
 
     switch (class)
     {
-    case FileNameInfo:
-    case FileAllocationInfo:
-    case FileStreamInfo:
-    case FileIdBothDirectoryInfo:
-    case FileIdBothDirectoryRestartInfo:
-    case FileFullDirectoryInfo:
-    case FileFullDirectoryRestartInfo:
-    case FileStorageInfo:
-    case FileAlignmentInfo:
-    case FileIdInfo:
-    case FileIdExtdDirectoryInfo:
-    case FileIdExtdDirectoryRestartInfo:
-        FIXME( "%p, %u, %p, %lu\n", file, class, info, size );
-        SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
-        return FALSE;
-
     case FileEndOfFileInfo:
         status = NtSetInformationFile( file, &io, info, size, FileEndOfFileInformation );
         break;
+    case FileAllocationInfo:
+        status = NtSetInformationFile( file, &io, info, size, FileAllocationInformation );
+        break;
     case FileBasicInfo:
         status = NtSetInformationFile( file, &io, info, size, FileBasicInformation );
         break;
@@ -3940,10 +3927,22 @@ BOOL WINAPI DECLSPEC_HOTPATCH SetFileInformationByHandle( HANDLE file, FILE_INFO
             RtlFreeUnicodeString( &nt_name );
             break;
         }
+    /* ways to query, not to set */
     case FileStandardInfo:
+    case FileNameInfo:
+    case FileStreamInfo:
     case FileCompressionInfo:
     case FileAttributeTagInfo:
+    case FileIdBothDirectoryInfo:
+    case FileIdBothDirectoryRestartInfo:
     case FileRemoteProtocolInfo:
+    case FileFullDirectoryInfo:
+    case FileFullDirectoryRestartInfo:
+    case FileStorageInfo:
+    case FileAlignmentInfo:
+    case FileIdInfo:
+    case FileIdExtdDirectoryInfo:
+    case FileIdExtdDirectoryRestartInfo:
     default:
         SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 9f00ae8e8ec..75f47c822bc 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -1671,6 +1671,83 @@ static void test_file_basic_information_access(void)
     DeleteFileA( name );
 }
 
+static void test_file_allocation_information(void)
+{
+    char path[MAX_PATH], name[MAX_PATH];
+    FILE_END_OF_FILE_INFORMATION feofi;
+    FILE_ALLOCATION_INFORMATION fai;
+    FILE_STANDARD_INFORMATION fsi;
+    FILE_FS_SIZE_INFORMATION ffsi;
+    LONGLONG cluster;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    HANDLE h;
+
+    GetTempPathA( MAX_PATH, path );
+    GetTempFileNameA( path, "fai", 0, name );
+    h = CreateFileA( name, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, 0 );
+    ok( h != INVALID_HANDLE_VALUE, "failed to open %s, error %lu\n", name, GetLastError() );
+    status = pNtQueryVolumeInformationFile( h, &io, &ffsi, sizeof(ffsi), FileFsSizeInformation );
+    ok( !status, "got %#lx\n", status );
+    cluster = ffsi.BytesPerSector * ffsi.SectorsPerAllocationUnit;
+
+    status = pNtSetInformationFile( h, &io, &fai, 0, FileAllocationInformation );
+    ok( status == STATUS_INFO_LENGTH_MISMATCH, "got %#lx\n", status );
+
+    feofi.EndOfFile.QuadPart = 10000;
+    status = pNtSetInformationFile( h, &io, &feofi, sizeof(feofi), FileEndOfFileInformation );
+    ok( !status, "got %#lx\n", status );
+
+    /* more space than the file holds leaves its end where it was */
+    fai.AllocationSize.QuadPart = 1 << 20;
+    status = pNtSetInformationFile( h, &io, &fai, sizeof(fai), FileAllocationInformation );
+    ok( !status, "got %#lx\n", status );
+    status = pNtQueryInformationFile( h, &io, &fsi, sizeof(fsi), FileStandardInformation );
+    ok( !status, "got %#lx\n", status );
+    ok( fsi.EndOfFile.QuadPart == 10000, "got end of file %s\n", wine_dbgstr_longlong(fsi.EndOfFile.QuadPart) );
+    ok( fsi.AllocationSize.QuadPart >= 1 << 20, "got allocation %s\n",
+        wine_dbgstr_longlong(fsi.AllocationSize.QuadPart) );
+
+    /* less truncates the file, to the whole clusters asked for */
+    fai.AllocationSize.QuadPart = 5000;
+    status = pNtSetInformationFile( h, &io, &fai, sizeof(fai), FileAllocationInformation );
+    ok( !status, "got %#lx\n", status );
+    status = pNtQueryInformationFile( h, &io, &fsi, sizeof(fsi), FileStandardInformation );
+    ok( !status, "got %#lx\n", status );
+    ok( fsi.EndOfFile.QuadPart == min( 10000, (5000 + cluster - 1) / cluster * cluster ),
+        "got end of file %s, cluster %s\n", wine_dbgstr_longlong(fsi.EndOfFile.QuadPart), wine_dbgstr_longlong(cluster) );
+
+    fai.AllocationSize.QuadPart = 0;
+    status = pNtSetInformationFile( h, &io, &fai, sizeof(fai), FileAllocationInformation );
+    ok( !status, "got %#lx\n", status );
+    status = pNtQueryInformationFile( h, &io, &fsi, sizeof(fsi), FileStandardInformation );
+    ok( !status, "got %#lx\n", status );
+    ok( !fsi.EndOfFile.QuadPart, "got end of file %s\n", wine_dbgstr_longlong(fsi.EndOfFile.QuadPart) );
+    CloseHandle( h );
+
+    /* both take FILE_WRITE_DATA */
+    h = CreateFileA( name, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, OPEN_EXISTING, 0, 0 );
+    ok( h != INVALID_HANDLE_VALUE, "failed to open %s, error %lu\n", name, GetLastError() );
+    fai.AllocationSize.QuadPart = 4096;
+    status = pNtSetInformationFile( h, &io, &fai, sizeof(fai), FileAllocationInformation );
+    ok( status == STATUS_ACCESS_DENIED, "got %#lx\n", status );
+    feofi.EndOfFile.QuadPart = 4096;
+    status = pNtSetInformationFile( h, &io, &feofi, sizeof(feofi), FileEndOfFileInformation );
+    ok( status == STATUS_ACCESS_DENIED, "got %#lx\n", status );
+    CloseHandle( h );
+    DeleteFileA( name );
+
+    /* and neither applies to a directory */
+    h = CreateFileA( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                     OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, 0 );
+    ok( h != INVALID_HANDLE_VALUE, "failed to open %s, error %lu\n", path, GetLastError() );
+    status = pNtSetInformationFile( h, &io, &fai, sizeof(fai), FileAllocationInformation );
+    ok( status == STATUS_INVALID_PARAMETER, "got %#lx\n", status );
+    status = pNtSetInformationFile( h, &io, &feofi, sizeof(feofi), FileEndOfFileInformation );
+    ok( status == STATUS_INVALID_PARAMETER, "got %#lx\n", status );
+    CloseHandle( h );
+}
+
 static void test_file_all_information(void)
 {
     IO_STATUS_BLOCK io;
@@ -8540,6 +8617,7 @@ START_TEST(file)
     test_file_io_completion();
     test_file_basic_information();
     test_file_basic_information_access();
+    test_file_allocation_information();
     test_file_all_information();
     test_file_both_information();
     test_file_name_information();
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 9b50672e2ba..2ac0d8141dc 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5417,6 +5417,44 @@ NTSTATUS WINAPI NtSetInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         else status = STATUS_INFO_LENGTH_MISMATCH;
         break;
 
+    case FileAllocationInformation:
+        if (len >= sizeof(FILE_ALLOCATION_INFORMATION))
+        {
+            const FILE_ALLOCATION_INFORMATION *info = ptr;
+            /* the size goes up to a whole cluster, the 4096 bytes reported for disks */
+            ULONGLONG alloc = ((ULONGLONG)info->AllocationSize.QuadPart + 4095) & ~(ULONGLONG)4095;
+            struct stat st;
+
+            if ((status = server_get_unix_fd( handle, FILE_WRITE_DATA, &fd, &needs_close, NULL, NULL )))
+                return status;
+
+            if (fstat( fd, &st ) == -1) status = errno_to_status( errno );
+            else if (S_ISDIR( st.st_mode ) || info->AllocationSize.QuadPart < 0)
+                status = STATUS_INVALID_PARAMETER;
+            else if (alloc < (ULONGLONG)st.st_size)
+            {
+                /* allocating less than the file holds truncates it, as NTFS does to the cluster */
+                SERVER_START_REQ( set_fd_eof_info )
+                {
+                    req->handle   = wine_server_obj_handle( handle );
+                    req->eof      = alloc;
+                    status = wine_server_call( req );
+                }
+                SERVER_END_REQ;
+            }
+#ifdef FALLOC_FL_KEEP_SIZE
+            /* reserve the space past the end of file without moving it; where the file system
+             * cannot, the allocation is only a hint and there is nothing to do */
+            else if (alloc > (ULONGLONG)st.st_size &&
+                     fallocate( fd, FALLOC_FL_KEEP_SIZE, 0, alloc ) == -1 && errno != EOPNOTSUPP)
+                status = errno == EFBIG ? STATUS_INVALID_PARAMETER : errno_to_status( errno );
+#endif
+
+            if (needs_close) close( fd );
+        }
+        else status = STATUS_INFO_LENGTH_MISMATCH;
+        break;
+
     case FilePipeInformation:
         if (len >= sizeof(FILE_PIPE_INFORMATION))
         {
diff --git a/dlls/wow64/file.c b/dlls/wow64/file.c
index 5d8eec0bccf..4ad490cbfc4 100644
--- a/dlls/wow64/file.c
+++ b/dlls/wow64/file.c
@@ -814,6 +814,7 @@ NTSTATUS WINAPI wow64_NtSetInformationFile( UINT *args )
     case FileValidDataLengthInformation:   /* FILE_VALID_DATA_LENGTH_INFORMATION */
     case FileDispositionInformation:   /* FILE_DISPOSITION_INFORMATION */
     case FileDispositionInformationEx:   /* FILE_DISPOSITION_INFORMATION_EX */
+    case FileAllocationInformation:   /* FILE_ALLOCATION_INFORMATION */
         status = NtSetInformationFile( handle, iosb_32to64( &io, io32 ), ptr, len, class );
         break;
 
