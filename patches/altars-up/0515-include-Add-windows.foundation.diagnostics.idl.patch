Subject: [PATCH] include: Add windows.foundation.diagnostics.idl.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/include/Makefile.in b/include/Makefile.in
index d2eaab21e5e..33fea79ea82 100644
--- a/include/Makefile.in
+++ b/include/Makefile.in
@@ -1045,6 +1045,7 @@ SOURCES = \
 	windows.devices.radios.idl \
 	windows.devices.usb.idl \
 	windows.foundation.collections.idl \
+	windows.foundation.diagnostics.idl \
 	windows.foundation.idl \
 	windows.foundation.metadata.idl \
 	windows.foundation.numerics.idl \
diff --git a/include/windows.foundation.diagnostics.idl b/include/windows.foundation.diagnostics.idl
new file mode 100644
index 00000000000..2d4ad553770
--- /dev/null
+++ b/include/windows.foundation.diagnostics.idl
@@ -0,0 +1,136 @@
