diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 1126a741bd6..cac3b39772b 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -3189,6 +3189,111 @@ static void placement_screen_to_workarea( HWND hwnd, WINDOWPLACEMENT *wp )
 }
 
 /* Coordinates returned in WINDOWPLACEMENT is always in screen coordinates */
+/* give the server the placement of a window, for other processes to read; called with the window locked */
+static void sync_window_placement( WND *win )
+{
+    UINT flags = (win->flags & WIN_RESTORE_MAX) ? WPF_RESTORETOMAXIMIZED : 0;
+
+    if (flags == win->synced_placement_flags && EqualRect( &win->normal_rect, &win->synced_normal_rect ) &&
+        !memcmp( &win->min_pos, &win->synced_min_pos, sizeof(POINT) ) &&
+        !memcmp( &win->max_pos, &win->synced_max_pos, sizeof(POINT) ))
+        return;
+
+    SERVER_START_REQ( set_window_placement )
+    {
+        req->handle = wine_server_user_handle( win->handle );
+        req->flags  = flags;
+        req->normal = wine_server_rectangle( win->normal_rect );
+        req->min_x  = win->min_pos.x;
+        req->min_y  = win->min_pos.y;
+        req->max_x  = win->max_pos.x;
+        req->max_y  = win->max_pos.y;
+        if (!wine_server_call( req ))
+        {
+            win->synced_placement_flags = flags;
+            win->synced_normal_rect = win->normal_rect;
+            win->synced_min_pos = win->min_pos;
+            win->synced_max_pos = win->max_pos;
+        }
+    }
+    SERVER_END_REQ;
+}
+
+static void sync_window_placement_hwnd( HWND hwnd )
+{
+    WND *win = get_win_ptr( hwnd );
+
+    if (!win || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return;
+    sync_window_placement( win );
+    release_win_ptr( win );
+}
+
+/* the placement of another process's window, from what its process last gave the server, updated
+ * from where the window is now as that process would update it */
+static BOOL get_other_process_placement( HWND hwnd, WINDOWPLACEMENT *placement )
+{
+    struct object_lock lock = OBJECT_LOCK_INIT;
+    const window_shm_t *window_shm;
+    struct ratio win_dpi = get_dpi_for_window( hwnd );
+    POINT min_pos = { -1, -1 }, max_pos = { -1, -1 };
+    RECT normal = { 0 }, window;
+    UINT flags = 0;
+    NTSTATUS status;
+    DWORD style;
+    HWND parent;
+
+    while ((status = get_shared_window( hwnd, &lock, &window_shm )) == STATUS_PENDING)
+    {
+        SetRect( &normal, window_shm->normal_rect.left, window_shm->normal_rect.top,
+                 window_shm->normal_rect.right, window_shm->normal_rect.bottom );
+        min_pos.x = window_shm->min_x;
+        min_pos.y = window_shm->min_y;
+        max_pos.x = window_shm->max_x;
+        max_pos.y = window_shm->max_y;
+        flags = window_shm->placement_flags;
+    }
+    if (status) return FALSE;
+    style = get_window_long( hwnd, GWL_STYLE );
+    if (!get_window_rect_rel( hwnd, COORDS_PARENT, &window, win_dpi )) return FALSE;
+
+    if (style & WS_MINIMIZE)
+    {
+        min_pos.x = window.left;
+        min_pos.y = window.top;
+    }
+    else if (style & WS_MAXIMIZE)
+    {
+        max_pos.x = window.left;
+        max_pos.y = window.top;
+    }
+    else normal = window;
+
+    /* as update_maximized_pos() */
+    parent = NtUserGetAncestor( hwnd, GA_PARENT );
+    if (!parent || parent == get_desktop_window())
+    {
+        if (style & WS_MAXIMIZE)
+        {
+            RECT work = { 0 };
+
+            if (!(style & WS_MINIMIZE)) work = monitor_info_from_window( hwnd, MONITOR_DEFAULTTOPRIMARY ).rcWork;
+            if (window.left <= work.left && window.top <= work.top &&
+                window.right >= work.right && window.bottom >= work.bottom)
+                max_pos.x = max_pos.y = -1;
+        }
+        else max_pos.x = max_pos.y = -1;
+    }
+
+    placement->length  = sizeof(*placement);
+    if (style & WS_MINIMIZE) placement->showCmd = SW_SHOWMINIMIZED;
+    else placement->showCmd = (style & WS_MAXIMIZE) ? SW_SHOWMAXIMIZED : SW_SHOWNORMAL;
+    placement->flags = flags;
+    placement->ptMinPosition = empty_point( min_pos ) ? min_pos : map_dpi_point( min_pos, win_dpi, get_thread_dpi() );
+    placement->ptMaxPosition = empty_point( max_pos ) ? max_pos : map_dpi_point( max_pos, win_dpi, get_thread_dpi() );
+    placement->rcNormalPosition = map_dpi_rect( normal, win_dpi, get_thread_dpi() );
+    return TRUE;
+}
+
 BOOL get_window_placement( HWND hwnd, WINDOWPLACEMENT *placement )
 {
     WND *win = get_win_ptr( hwnd );
@@ -3213,10 +3318,12 @@ BOOL get_window_placement( HWND hwnd, WINDOWPLACEMENT *placement )
         RECT normal_position;
         DWORD style;
 
+        if (get_other_process_placement( hwnd, placement )) return TRUE;
+
         if (!get_window_rect( hwnd, &normal_position, get_thread_dpi() ))
             return FALSE;
 
-        FIXME("not fully supported on other process window %p.\n", hwnd);
+        WARN( "no shared placement for %p, guessing it.\n", hwnd );
 
         placement->length  = sizeof(*placement);
         style = get_window_long( hwnd, GWL_STYLE );
@@ -3250,6 +3357,7 @@ BOOL get_window_placement( HWND hwnd, WINDOWPLACEMENT *placement )
         win->normal_rect = win->rects.window;
     }
     update_maximized_pos( win );
+    sync_window_placement( win );
 
     placement->length  = sizeof(*placement);
     if (win->dwStyle & WS_MINIMIZE)
@@ -3348,12 +3456,13 @@ void set_window_normal_placement( HWND hwnd, RECT rect )
     {
         make_rect_onscreen( &rect );
         win->normal_rect = rect_thread_to_win_dpi( hwnd, rect );
+        sync_window_placement( win );
         release_win_ptr( win );
     }
 }
 
 /* Coordinates in WINDOWPLACEMENT should already be in screen coordinates instead of work area coordinates */
-static BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT flags )
+BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT flags )
 {
     WND *win = get_win_ptr( hwnd );
     WINDOWPLACEMENT wp = *wndpl;
@@ -3371,7 +3480,14 @@ static BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT
            wp.ptMaxPosition.x, wp.ptMaxPosition.y,
            wine_dbgstr_rect(&wp.rcNormalPosition) );
 
-    if (!win || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return FALSE;
+    if (!win || win == WND_DESKTOP) return FALSE;
+    if (win == WND_OTHER_PROCESS)
+    {
+        /* the window's own thread keeps its placement: hand it over, in this thread's DPI */
+        struct set_placement_params params = { .placement = wp, .flags = flags };
+        return send_message_timeout( hwnd, WM_WINE_SETWINDOWPLACEMENT, get_thread_dpi_awareness_context(),
+                                     (LPARAM)&params, SMTO_ABORTIFHUNG, 2000, FALSE );
+    }
 
     if (flags & PLACE_MIN) win->min_pos = point_thread_to_win_dpi( hwnd, wp.ptMinPosition );
     if (flags & PLACE_MAX)
@@ -3380,6 +3496,7 @@ static BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT
         update_maximized_pos( win );
     }
     if (flags & PLACE_RECT) win->normal_rect = rect_thread_to_win_dpi( hwnd, wp.rcNormalPosition );
+    sync_window_placement( win );
 
     style = win->dwStyle;
 
@@ -3412,6 +3529,7 @@ static BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT
         if (wndpl->flags & WPF_RESTORETOMAXIMIZED)
             win_set_flags( hwnd, WIN_RESTORE_MAX, 0 );
     }
+    sync_window_placement_hwnd( hwnd );
     return TRUE;
 }
 
@@ -4967,8 +5085,8 @@ static UINT window_min_maximize( HWND hwnd, UINT cmd, RECT *rect )
         minmax = get_min_max_info( hwnd );
 
         old_style = set_window_style_bits( hwnd, WS_MAXIMIZE, WS_MINIMIZE );
-        if (old_style & WS_MINIMIZE)
-            win_set_flags( hwnd, WIN_RESTORE_MAX, 0 );
+        /* minimized from here it is restored maximized, and its placement says so at once */
+        win_set_flags( hwnd, WIN_RESTORE_MAX, 0 );
 
         if (!(old_style & WS_MAXIMIZE)) swp_flags |= SWP_STATECHANGED;
         SetRect( rect, minmax.ptMaxPosition.x, minmax.ptMaxPosition.y,
@@ -5007,6 +5125,7 @@ static UINT window_min_maximize( HWND hwnd, UINT cmd, RECT *rect )
         break;
     }
 
+    sync_window_placement_hwnd( hwnd );
     return swp_flags;
 }
 
@@ -5133,6 +5252,7 @@ static void move_onto_display( HWND hwnd, DWORD style, POINT old_origin )
     {
         if (!(win = get_win_ptr( hwnd )) || win == WND_OTHER_PROCESS || win == WND_DESKTOP) return;
         win->normal_rect = rect_thread_to_win_dpi( hwnd, rect );
+        sync_window_placement( win );
         release_win_ptr( win );
     }
     else NtUserSetWindowPos( hwnd, 0, x, y, width, height, SWP_NOZORDER | SWP_NOACTIVATE | SWP_NOOWNERZORDER );
@@ -5160,6 +5280,7 @@ void fit_window_to_display( HWND hwnd, UINT how, POINT old_origin )
         if ((win = get_win_ptr( hwnd )) && win != WND_OTHER_PROCESS && win != WND_DESKTOP)
         {
             win->max_pos.x = win->max_pos.y = -1;
+            sync_window_placement( win );
             release_win_ptr( win );
         }
         minmax = get_min_max_info( hwnd );
@@ -6317,6 +6438,8 @@ HWND WINAPI NtUserCreateWindowEx( DWORD ex_style, UNICODE_STRING *class_name,
     win->min_pos.x = win->min_pos.y = -1;
     win->max_pos.x = win->max_pos.y = -1;
     SetRect( &win->normal_rect, cs.x, cs.y, cs.x + cs.cx, cs.y + cs.cy );
+    win->synced_placement_flags = ~0u;
+    sync_window_placement( win );
 
     if (win->dwStyle & WS_SYSMENU) NtUserSetSystemMenu( hwnd, 0 );
 
