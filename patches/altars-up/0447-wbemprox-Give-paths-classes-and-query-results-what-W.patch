+/*
+ * WBEM_FLAG_ENSURE_LOCATABLE: a query that leaves its class's keys out gets them, and its results a path.
+ * Without it a result of a query naming its properties has no path, server or namespace, and a relative
+ * path only when the keys were among them (Windows 11, tools/winmgmtsprobe, locatable.c).
+ */
+static HRESULT ensure_locatable( struct query *query )
+{
+    struct view *view = query->view;
+    struct property *prop;
+    struct list *mem;
+    UINT i, j;
+
+    if (view->type != VIEW_TYPE_SELECT || !view->proplist) return S_OK;
+    for (i = 0; i < view->table_count; i++)
+    {
+        const struct table *table = view->table[i];
+
+        for (j = 0; j < table->num_cols; j++)
+        {
+            if (!(table->columns[j].type & COL_FLAG_KEY) || is_result_prop( view, table->columns[j].name )) continue;
+            if (!(mem = malloc( sizeof(*mem) + sizeof(*prop) ))) return E_OUTOFMEMORY;
+            list_add_tail( &query->mem, mem );
+            prop = (struct property *)&mem[1];
+            prop->name  = table->columns[j].name;
+            prop->class = NULL;
+            prop->next  = view->proplist;
+            view->proplist = prop;
+        }
+    }
+    view->locatable = TRUE;
+    return S_OK;
+}
