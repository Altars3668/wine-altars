+/* A result of a query that names its properties has no path, server or namespace, and a relative path only when the
+ * keys are among them; WBEM_FLAG_ENSURE_LOCATABLE adds the keys and gives it a path. */
+static void test_locatable( IWbemServices *services )
+{
+    static const struct
+    {
+        const WCHAR *query;
+        LONG flags;
+        BOOL null_path, null_relpath;
+        LONG count;
+        BOOL has_key;
+    }
+    tests[] =
+    {
+        { L"SELECT Size FROM Win32_LogicalDisk", 0, TRUE, TRUE, 1, FALSE },
+        { L"SELECT Size FROM Win32_LogicalDisk", WBEM_FLAG_ENSURE_LOCATABLE, FALSE, FALSE, 2, TRUE },
+        { L"SELECT Size FROM Win32_LogicalDisk", WBEM_FLAG_RETURN_IMMEDIATELY | WBEM_FLAG_FORWARD_ONLY, TRUE, TRUE, 1,
+          FALSE },
+        { L"SELECT DeviceID, Size FROM Win32_LogicalDisk", 0, TRUE, FALSE, 2, TRUE },
+        { L"SELECT * FROM Win32_LogicalDisk", 0, FALSE, FALSE, 0, TRUE },
+        { L"SELECT Caption FROM Win32_OperatingSystem", 0, TRUE, FALSE, 1, FALSE },
+        { L"SELECT Caption FROM Win32_OperatingSystem", WBEM_FLAG_ENSURE_LOCATABLE, FALSE, FALSE, 1, FALSE },
+    };
+    BSTR wql = SysAllocString( L"wql" ), query;
+    IEnumWbemClassObject *result;
+    IWbemClassObject *obj;
+    WCHAR buf[64];
+    unsigned int i;
+    VARIANT var;
+    ULONG count;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context( "%s, %#lx", wine_dbgstr_w(tests[i].query), tests[i].flags );
+        query = SysAllocString( tests[i].query );
+        hr = IWbemServices_ExecQuery( services, wql, query, tests[i].flags, NULL, &result );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        SysFreeString( query );
+        if (hr != S_OK || IEnumWbemClassObject_Next( result, 10000, 1, &obj, &count ) != S_OK)
+        {
+            skip( "no results\n" );
+            if (hr == S_OK) IEnumWbemClassObject_Release( result );
+            winetest_pop_context();
+            continue;
+        }
+        check_null( obj, L"__PATH", tests[i].null_path );
+        check_null( obj, L"__SERVER", tests[i].null_path );
+        check_null( obj, L"__NAMESPACE", tests[i].null_path );
+        check_null( obj, L"__RELPATH", tests[i].null_relpath );
+        if (tests[i].count)
+        {
+            VariantInit( &var );
+            hr = IWbemClassObject_Get( obj, L"__PROPERTY_COUNT", 0, &var, NULL, NULL );
+            ok( hr == S_OK, "got %#lx\n", hr );
+            ok( V_VT( &var ) == VT_I4 && V_I4( &var ) == tests[i].count, "got %s\n", wine_dbgstr_variant(&var) );
+        }
+        if (wcsstr( tests[i].query, L"LogicalDisk" ))
+        {
+            VariantInit( &var );
+            hr = IWbemClassObject_Get( obj, L"DeviceID", 0, &var, NULL, NULL );
+            ok( hr == (tests[i].has_key ? S_OK : WBEM_E_NOT_FOUND), "got %#lx\n", hr );
+            VariantClear( &var );
+        }
+        IWbemClassObject_Release( obj );
+        IEnumWbemClassObject_Release( result );
+        winetest_pop_context();
+    }
+
+    /* a full path names the machine as . or by its name */
+    query = SysAllocString( L"\\\\.\\root\\cimv2:Win32_LogicalDisk.DeviceID=\"C:\"" );
+    hr = IWbemServices_GetObject( services, query, 0, NULL, &obj, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr == S_OK) IWbemClassObject_Release( obj );
+    SysFreeString( query );
+
+    /* a number given for a string property compares as its digits */
+    swprintf( buf, ARRAY_SIZE(buf), L"SELECT Name FROM Win32_Process WHERE Handle = %lu", GetCurrentProcessId() );
+    query = SysAllocString( buf );
+    hr = IWbemServices_ExecQuery( services, wql, query, 0, NULL, &result );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( query );
+    if (hr == S_OK)
+    {
+        count = 0;
+        hr = IEnumWbemClassObject_Next( result, 10000, 1, &obj, &count );
+        ok( hr == S_OK && count == 1, "got %#lx, %lu\n", hr, count );
+        if (count) IWbemClassObject_Release( obj );
+        IEnumWbemClassObject_Release( result );
+    }
+    SysFreeString( wql );
+}
