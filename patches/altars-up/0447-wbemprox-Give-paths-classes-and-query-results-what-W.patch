+/* the system properties of a class itself: genus 1, its name for a path */
+static HRESULT get_class_system_propval( enum wbm_namespace ns, const struct table *table, const WCHAR *name,
+                                         VARIANT *ret, CIMTYPE *type, LONG *flavor )
+{
+    BSTR server, namespace;
+    UINT len;
+
+    if (flavor) *flavor = WBEM_FLAVOR_ORIGIN_SYSTEM;
+    if (!wcsicmp( name, L"__GENUS" ) || !wcsicmp( name, L"__PROPERTY_COUNT" ))
+    {
+        if (ret)
+        {
+            V_VT( ret ) = VT_I4;
+            V_I4( ret ) = wcsicmp( name, L"__GENUS" ) ? count_properties( table ) : WBEM_GENUS_CLASS;
+        }
+        if (type) *type = CIM_SINT32;
+        return S_OK;
+    }
+    if (!wcsicmp( name, L"__DERIVATION" ))
+    {
+        if (ret)
+        {
+            SAFEARRAY *sa;
+            if (!(sa = SafeArrayCreateVector( VT_BSTR, 0, 0 ))) return E_OUTOFMEMORY;
+            V_VT( ret ) = VT_BSTR | VT_ARRAY;
+            V_ARRAY( ret ) = sa;
+        }
+        if (type) *type = CIM_STRING | CIM_FLAG_ARRAY;
+        return S_OK;
+    }
+    if (type) *type = CIM_STRING;
+    if (!ret) return S_OK;
+    V_VT( ret ) = VT_BSTR;
+    if (!wcsicmp( name, L"__CLASS" ) || !wcsicmp( name, L"__RELPATH" ))
+        V_BSTR( ret ) = SysAllocString( table->name );
+    else if (!wcsicmp( name, L"__SERVER" ))
+        V_BSTR( ret ) = build_servername();
+    else if (!wcsicmp( name, L"__NAMESPACE" ))
+        V_BSTR( ret ) = build_namespace( ns );
+    else if (!wcsicmp( name, L"__PATH" ))
+    {
+        server = build_servername();
+        namespace = build_namespace( ns );
