+static void test_verify_timestamp(void)
+{
+    static const char data[] = "wine";
+    CRYPT_TIMESTAMP_CONTEXT *context;
+    const CERT_CONTEXT *signer, *cert;
+    HCERTSTORE store;
+    unsigned int count;
+    char name[64];
+    SYSTEMTIME st;
+    BYTE *copy;
+    BOOL ret;
+
+    context = (void *)0xdeadbeef;
