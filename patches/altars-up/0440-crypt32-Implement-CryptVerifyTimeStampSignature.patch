diff --git a/dlls/crypt32/message.c b/dlls/crypt32/message.c
index 9e7705bddb8..dfe540e3196 100644
--- a/dlls/crypt32/message.c
+++ b/dlls/crypt32/message.c
@@ -581,3 +581,165 @@ BOOL WINAPI CryptEncryptMessage(PCRYPT_ENCRYPT_MESSAGE_PARA pEncryptPara,
     if (!ret) *pcbEncryptedBlob = 0;
     return ret;
 }
+
+/* checks that the hash a time stamp is of is the hash of the data */
+static BOOL CRYPT_CheckMessageImprint(const CRYPT_TIMESTAMP_INFO *info,
+ const BYTE *data, DWORD size)
+{
+    ALG_ID algid = CertOIDToAlgId(info->HashAlgorithm.pszObjId);
+    BYTE hash[64];
+    DWORD hash_size = sizeof(hash);
+
+    if (!algid || !CryptHashCertificate(0, algid, 0, data, size, hash,
+     &hash_size))
+    {
+        WARN("can't hash with %s\n", debugstr_a(info->HashAlgorithm.pszObjId));
+        SetLastError(NTE_BAD_ALGID);
+        return FALSE;
+    }
+    if (hash_size != info->HashedMessage.cbData ||
+     memcmp(hash, info->HashedMessage.pbData, hash_size))
+    {
+        SetLastError(NTE_BAD_HASH);
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/***********************************************************************
+ *      CryptVerifyTimeStampSignature (CRYPT32.@)
+ *
+ * Verifies that an RFC 3161 time stamp token was signed by the certificate
+ * it names, among its own and those in hAdditionalStore, and, given the data,
+ * that it is a time stamp of it.  Whether the signer is trusted is left to
+ * the caller.
+ */
+BOOL WINAPI CryptVerifyTimeStampSignature(const BYTE *pbTSContentInfo,
+ DWORD cbTSContentInfo, const BYTE *pbData, DWORD cbData,
+ HCERTSTORE hAdditionalStore, PCRYPT_TIMESTAMP_CONTEXT *ppTsContext,
+ PCCERT_CONTEXT *ppTsSigner, HCERTSTORE *phStore)
+{
+    static const DWORD encoding = X509_ASN_ENCODING | PKCS_7_ASN_ENCODING;
+    CMSG_CTRL_VERIFY_SIGNATURE_EX_PARA para = { sizeof(para) };
+    CRYPT_TIMESTAMP_CONTEXT *context = NULL;
+    HCERTSTORE store = NULL, search = NULL;
+    PCCERT_CONTEXT signer = NULL;
+    CERT_INFO *certInfo = NULL;
+    DWORD size, info_size, token_size;
+    BYTE *content = NULL;
+    BOOL ret = FALSE;
+    HCRYPTMSG msg;
+
+    TRACE("(%p, %ld, %p, %ld, %p, %p, %p, %p)\n", pbTSContentInfo,
+     cbTSContentInfo, pbData, cbData, hAdditionalStore, ppTsContext,
+     ppTsSigner, phStore);
+
+    if (ppTsSigner)
+        *ppTsSigner = NULL;
+    if (phStore)
+        *phStore = NULL;
+    if (!pbTSContentInfo || !ppTsContext)
+    {
+        SetLastError(E_INVALIDARG);
+        return FALSE;
+    }
+    *ppTsContext = NULL;
+
+    if (!(msg = CryptMsgOpenToDecode(encoding, 0, 0, 0, NULL, NULL)))
+        return FALSE;
+    if (!CryptMsgUpdate(msg, pbTSContentInfo, cbTSContentInfo, TRUE))
+        goto done;
+
+    /* the TSTInfo it signs, decoded after a copy of the token */
+    if (!CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, NULL, &size))
+        goto done;
+    if (!(content = CryptMemAlloc(size)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        goto done;
+    }
+    if (!CryptMsgGetParam(msg, CMSG_CONTENT_PARAM, 0, content, &size) ||
+     !CryptDecodeObjectEx(encoding, TIMESTAMP_INFO, content, size, 0, NULL,
+     NULL, &info_size))
+        goto done;
+    token_size = (cbTSContentInfo + sizeof(void *) - 1) & ~(sizeof(void *) - 1);
+    if (!(context = CryptMemAlloc(sizeof(*context) + token_size + info_size)))
+    {
+        SetLastError(ERROR_OUTOFMEMORY);
+        goto done;
+    }
+    context->cbEncoded = cbTSContentInfo;
+    context->pbEncoded = (BYTE *)(context + 1);
+    memcpy(context->pbEncoded, pbTSContentInfo, cbTSContentInfo);
+    context->pTimeStamp = (CRYPT_TIMESTAMP_INFO *)(context->pbEncoded + token_size);
+    if (!CryptDecodeObjectEx(encoding, TIMESTAMP_INFO, content, size, 0, NULL,
+     context->pTimeStamp, &info_size))
+        goto done;
+
+    if (pbData && !CRYPT_CheckMessageImprint(context->pTimeStamp, pbData, cbData))
+        goto done;
+
+    /* who signed it */
+    if (!(certInfo = CRYPT_GetSignerCertInfoFromMsg(msg, 0)) ||
+     !(store = CertOpenStore(CERT_STORE_PROV_MSG, encoding, 0, 0, msg)))
+        goto done;
+    if (hAdditionalStore)
+    {
+        if (!(search = CertOpenStore(CERT_STORE_PROV_COLLECTION, 0, 0, 0, NULL)))
+            goto done;
+        CertAddStoreToCollection(search, store, 0, 0);
+        CertAddStoreToCollection(search, hAdditionalStore, 0, 0);
+    }
+    else
+        search = CertDuplicateStore(store);
+    if (!(signer = CertFindCertificateInStore(search, encoding, 0,
+     CERT_FIND_SUBJECT_CERT, certInfo, NULL)))
+        goto done;
+    para.dwSignerType = CMSG_VERIFY_SIGNER_CERT;
+    para.pvSigner = (void *)signer;
+    if (!CryptMsgControl(msg, 0, CMSG_CTRL_VERIFY_SIGNATURE_EX, &para))
+        goto done;
+
+    ret = TRUE;
+    *ppTsContext = context;
+    context = NULL;
+    if (ppTsSigner)
+    {
+        *ppTsSigner = signer;
+        signer = NULL;
+    }
+    if (phStore)
+    {
+        *phStore = store;
+        store = NULL;
+    }
+
+done:
+    if (signer)
+        CertFreeCertificateContext(signer);
+    if (search)
+        CertCloseStore(search, 0);
+    if (store)
+        CertCloseStore(store, 0);
+    CryptMemFree(certInfo);
+    CryptMemFree(context);
+    CryptMemFree(content);
+    CryptMsgClose(msg);
+    TRACE("returning %d\n", ret);
+    return ret;
+}
+
+/***********************************************************************
+ *      CryptRetrieveTimeStamp (CRYPT32.@)
+ */
+BOOL WINAPI CryptRetrieveTimeStamp(LPCWSTR wszUrl, DWORD dwRetrievalFlags,
+ DWORD dwTimeout, LPCSTR pszHashId, const CRYPT_TIMESTAMP_PARA *pPara,
+ const BYTE *pbData, DWORD cbData, PCRYPT_TIMESTAMP_CONTEXT *ppTsContext,
+ PCCERT_CONTEXT *ppTsSigner, HCERTSTORE *phStore)
+{
+    FIXME("(%s, %#lx, %lu, %s, %p, %p, %lu, %p, %p, %p): stub\n",
+     debugstr_w(wszUrl), dwRetrievalFlags, dwTimeout, debugstr_a(pszHashId),
+     pPara, pbData, cbData, ppTsContext, ppTsSigner, phStore);
+    SetLastError(ERROR_CALL_NOT_IMPLEMENTED);
+    return FALSE;
+}
