From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:08:04 -0400
Subject: [PATCH] kernel32: Return the session on the screen from
 WTSGetActiveConsoleSessionId.

It returned the caller's session, which is not the one on the screen for a service, since Windows
Vista a process of session 0; a service that starts a program for the user asks for exactly that
one.  Windows keeps it in KUSER_SHARED_DATA.ActiveConsoleId, which the server now fills with the
session of the desktop.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/process.c b/dlls/kernel32/process.c
index 17c69f43307..0be80d90c51 100644
--- a/dlls/kernel32/process.c
+++ b/dlls/kernel32/process.c
@@ -538,10 +538,7 @@ HRESULT WINAPI RegisterApplicationRestart(PCWSTR pwzCommandLine, DWORD dwFlags)
  */
 DWORD WINAPI WTSGetActiveConsoleSessionId(void)
 {
-    static int once;
-    if (!once++) FIXME("stub\n");
-    /* Return current session id. */
-    return NtCurrentTeb()->Peb->SessionId;
+    return user_shared_data->ActiveConsoleId;
 }
 
 /**********************************************************************
diff --git a/dlls/kernel32/tests/process.c b/dlls/kernel32/tests/process.c
index 4a1c22a0d9d..a3ab655ca50 100644
--- a/dlls/kernel32/tests/process.c
+++ b/dlls/kernel32/tests/process.c
@@ -5566,6 +5566,22 @@ static void test_services_exe(void)
     ok(services_session_id == 0, "got services.exe SessionId %lu\n", services_session_id);
 }
 
+static void test_active_console_session(void)
+{
+    /* KUSER_SHARED_DATA.ActiveConsoleId */
+    ULONG active = *(volatile ULONG *)((char *)0x7ffe0000 + 0x2d8);
+    DWORD session, own = 0xdeadbeef;
+    BOOL ret;
+
+    ret = ProcessIdToSessionId(GetCurrentProcessId(), &own);
+    ok(ret, "got error %lu\n", GetLastError());
+    session = WTSGetActiveConsoleSessionId();
+    trace("session %lu, console session %lu\n", own, session);
+    ok(session == active, "got %lu, ActiveConsoleId %lu\n", session, active);
+    /* since Windows Vista the console is never session 0, which only services run in */
+    ok(session && session != ~0u, "got console session %lu\n", session);
+}
+
 static void test_startupinfo( void )
 {
     STARTUPINFOA startup_beforeA, startup_afterA;
@@ -5837,6 +5853,7 @@ START_TEST(process)
     test_handle_list_attribute(FALSE, NULL, NULL);
     test_dead_process();
     test_services_exe();
+    test_active_console_session();
     test_startupinfo();
     test_GetProcessInformation();
 
diff --git a/server/mapping.c b/server/mapping.c
index 7446c706aec..161ee2646e2 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1496,7 +1496,12 @@ struct object *create_user_data_mapping( struct object *root, struct unicode_str
 
     if (!(mapping = create_named_object( &params ))) return NULL;
     ptr = mmap( NULL, mapping->size, PROT_WRITE, MAP_SHARED, get_unix_fd( mapping->fd ), 0 );
-    if (ptr != MAP_FAILED) user_shared_data = ptr;
+    if (ptr != MAP_FAILED)
+    {
+        user_shared_data = ptr;
+        /* the session of the desktop the user sees; services run in session 0 */
+        user_shared_data->ActiveConsoleId = default_session_id;
+    }
     return &mapping->obj;
 }
 
