From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 06:36:08 -0400
Subject: [PATCH] combase: Return the in-process server's answer when no other
 context has the class.

Asked for an interface its class object lacks, an in-process server answers
E_NOINTERFACE, and Windows 11 returns that whatever else the context allows:
CoGetClassObject(WinMGMTS, CLSCTX_ALL, IParseDisplayName) gives E_NOINTERFACE,
which MkParseDisplayName runs into whenever it parses "winmgmts:" and gets past
through IClassFactory.  Wine went on to the local and remote servers, found
neither registered and returned REGDB_E_CLASSNOTREG, with three ERRs on the way.
Asking is not an error, so those are WARNs now.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/combase/apartment.c b/dlls/combase/apartment.c
index 27f0cbfb217..ed57bd2e67b 100644
--- a/dlls/combase/apartment.c
+++ b/dlls/combase/apartment.c
@@ -778,7 +778,9 @@ static HRESULT apartment_getclassobject(struct apartment *apt, LPCWSTR dllpath,
         TRACE("calling ole32!DllGetClassObject\n");
         hr = p_ole32_DllGetClassObject(rclsid, riid, ppv);
 
-        if (hr != S_OK)
+        if (hr == E_NOINTERFACE)
+            WARN("class object %s has no %s\n", debugstr_guid(rclsid), debugstr_guid(riid));
+        else if (hr != S_OK)
             ERR("DllGetClassObject returned error %#lx for dll %s\n", hr, debugstr_w(dllpath));
 
         return hr;
@@ -827,7 +829,10 @@ static HRESULT apartment_getclassobject(struct apartment *apt, LPCWSTR dllpath,
         /* OK: get the ClassObject */
         hr = apartment_loaded_dll->dll->DllGetClassObject(rclsid, riid, ppv);
 
-        if (hr != S_OK)
+        /* asking a class object for an interface it lacks is a question, not a failure */
+        if (hr == E_NOINTERFACE)
+            WARN("class object %s in %s has no %s\n", debugstr_guid(rclsid), debugstr_w(dllpath), debugstr_guid(riid));
+        else if (hr != S_OK)
             ERR("DllGetClassObject returned error %#lx for dll %s\n", hr, debugstr_w(dllpath));
     }
 
diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index 8fa16403180..c945acd1905 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -1941,7 +1941,7 @@ static HRESULT com_get_class_object(REFCLSID requested, DWORD clscontext,
         COSERVERINFO *server_info, REFIID riid, void **obj)
 {
     struct class_reg_data clsreg = { 0 };
-    HRESULT hr = E_UNEXPECTED;
+    HRESULT hr = E_UNEXPECTED, server_hr = S_OK;
     IUnknown *registered_obj;
     struct apartment *apt;
     CLSID filtered;
@@ -2043,6 +2043,10 @@ static HRESULT com_get_class_object(REFCLSID requested, DWORD clscontext,
 
             hr = apartment_get_inproc_class_object(apt, &clsreg, rclsid, riid, clscontext, obj);
             RegCloseKey(hkey);
+            /* A server that is there but would not give the object -- asked, say, for an interface its class
+             * object lacks, as MkParseDisplayName does -- has answered, and the contexts the class is not
+             * registered for change nothing about that.  Windows returns its answer. */
+            if (FAILED(hr)) server_hr = hr;
         }
 
         /* return if we got a class, otherwise fall through to one of the
@@ -2078,6 +2082,7 @@ static HRESULT com_get_class_object(REFCLSID requested, DWORD clscontext,
 
             hr = apartment_get_inproc_class_object(apt, &clsreg, rclsid, riid, clscontext, obj);
             RegCloseKey(hkey);
+            if (FAILED(hr) && SUCCEEDED(server_hr)) server_hr = hr;
         }
 
         /* return if we got a class, otherwise fall through to one of the
@@ -2105,6 +2110,12 @@ static HRESULT com_get_class_object(REFCLSID requested, DWORD clscontext,
         hr = REGDB_E_CLASSNOTREG;
     }
 
+    if (FAILED(server_hr) && (hr == server_hr || hr == REGDB_E_CLASSNOTREG || hr == REGDB_E_KEYMISSING))
+    {
+        WARN("class object %s gave %#lx for %s\n", debugstr_guid(rclsid), server_hr, debugstr_guid(riid));
+        return server_hr;
+    }
+
     if (FAILED(hr))
         ERR("no class object %s could be created for context %#lx\n", debugstr_guid(rclsid), clscontext);
 
diff --git a/dlls/combase/rpc.c b/dlls/combase/rpc.c
index b4cbbe1322c..2d4c1afae60 100644
--- a/dlls/combase/rpc.c
+++ b/dlls/combase/rpc.c
@@ -503,7 +503,8 @@ static HRESULT create_server(REFCLSID rclsid, HANDLE *process)
     }
     if (FAILED(hr))
     {
-        ERR("class %s not registered\n", debugstr_guid(rclsid));
+        /* whoever asked for any kind of server decides whether that matters */
+        WARN("class %s not registered as a local server\n", debugstr_guid(rclsid));
         return hr;
     }
 
diff --git a/dlls/wbemdisp/tests/wbemdisp.c b/dlls/wbemdisp/tests/wbemdisp.c
index 498e603157c..4fc59dfc67f 100644
--- a/dlls/wbemdisp/tests/wbemdisp.c
+++ b/dlls/wbemdisp/tests/wbemdisp.c
@@ -634,11 +634,55 @@ todo_wine {
     ISWbemNamedValueSet_Release(set);
 }
 
+/* The class object has no IParseDisplayName, in any context; MkParseDisplayName gets one from an instance. */
+static void test_class_object(void)
+{
+    static const DWORD contexts[] = { CLSCTX_INPROC_SERVER, CLSCTX_ALL };
+    static const WCHAR name[] = L"winmgmts:{impersonationLevel=impersonate}!\\\\.\\root\\cimv2";
+    IParseDisplayName *displayname;
+    IClassFactory *factory;
+    IMoniker *moniker;
+    IBindCtx *ctx;
+    unsigned int i;
+    DWORD mksys;
+    ULONG eaten;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE( contexts ); i++)
+    {
+        hr = CoGetClassObject( &CLSID_WINMGMTS, contexts[i], NULL, &IID_IParseDisplayName, (void **)&displayname );
+        ok( hr == E_NOINTERFACE, "context %#lx: got %#lx\n", contexts[i], hr );
+        if (hr == S_OK) IParseDisplayName_Release( displayname );
+
+        hr = CoGetClassObject( &CLSID_WINMGMTS, contexts[i], NULL, &IID_IClassFactory, (void **)&factory );
+        ok( hr == S_OK, "context %#lx: got %#lx\n", contexts[i], hr );
+        if (hr == S_OK) IClassFactory_Release( factory );
+    }
+
+    hr = CreateBindCtx( 0, &ctx );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    eaten = 0xdeadbeef;
+    moniker = NULL;
+    hr = MkParseDisplayName( ctx, name, &eaten, &moniker );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( eaten == ARRAY_SIZE( name ) - 1, "got %lu\n", eaten );
+    if (moniker)
+    {
+        mksys = 0xdeadbeef;
+        hr = IMoniker_IsSystemMoniker( moniker, &mksys );
+        ok( hr == S_OK, "got %#lx\n", hr );
+        ok( mksys == MKSYS_POINTERMONIKER, "got %lu\n", mksys );
+        IMoniker_Release( moniker );
+    }
+    IBindCtx_Release( ctx );
+}
+
 START_TEST(wbemdisp)
 {
     CoInitialize( NULL );
 
     test_ParseDisplayName();
+    test_class_object();
     test_locator();
     test_namedvalueset();
 
