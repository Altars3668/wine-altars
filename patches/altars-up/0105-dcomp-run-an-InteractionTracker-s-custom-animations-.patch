+/* moves it along its inertia; FALSE once every axis has come to rest */
+static BOOL tracker_inertia_frame( struct tracker *tracker, LONGLONG now )
+{
+    float before[3], scale, t;
+    BOOL moving = FALSE;
+    unsigned int i;
+
+    /* the first frame is where the clock starts */
+    if (!tracker->inertia_start)
+    {
+        tracker->inertia_start = now;
+        return TRUE;
+    }
+    t = (now - tracker->inertia_start) / 10000000.0f;
+    for (i = 0; i < ARRAY_SIZE(tracker->inertia); i++)
+    {
+        before[i] = tracker->inertia[i].at;
+        inertia_axis_at( &tracker->inertia[i], t, i == 2 ? 1e-4f : 0.05f );
+        moving |= tracker->inertia[i].moving;
+    }
+    /* scale moves what is under the center point with it, and position goes on from there as it would have */
+    scale = expf( tracker->inertia[2].at );
+    tracker_scale_about( tracker, tracker->scale, scale, tracker->scale_center );
+    tracker->scale = scale;
+    tracker->position.X += tracker->inertia[0].at - before[0];
+    tracker->position.Y += tracker->inertia[1].at - before[1];
+    tracker_clamp( tracker, FALSE );
+    tracker->position_velocity.X = tracker->inertia[0].speed;
+    tracker->position_velocity.Y = tracker->inertia[1].speed;
+    tracker->scale_velocity = tracker->inertia[2].speed;
+    return moving;
+}
