+    tracker->inertia[0].from = tracker->position.X;
+    tracker->inertia[1].from = tracker->position.Y;
+    tracker->inertia[2].from = logf( max( tracker->scale, 1e-6f ) );
+    for (i = 0; i < ARRAY_SIZE(tracker->inertia); i++)
