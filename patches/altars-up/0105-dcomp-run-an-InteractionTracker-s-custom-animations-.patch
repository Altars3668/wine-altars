+static HRESULT WINAPI modifier_iterator_get_Current( IIterator_InteractionTrackerInertiaModifier *iface,
+                                                     IInteractionTrackerInertiaModifier **value )
+{
+    struct modifier_list *list = list_from_iterator( iface );
+
+    if (list->index >= list->count) return E_BOUNDS;
+    IInteractionTrackerInertiaModifier_AddRef( (*value = list->items[list->index]) );
+    return S_OK;
+}
+
+static HRESULT WINAPI modifier_iterator_get_HasCurrent( IIterator_InteractionTrackerInertiaModifier *iface, boolean *value )
+{
+    struct modifier_list *list = list_from_iterator( iface );
+    *value = list->index < list->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI modifier_iterator_MoveNext( IIterator_InteractionTrackerInertiaModifier *iface, boolean *value )
+{
+    struct modifier_list *list = list_from_iterator( iface );
+    if (list->index < list->count) list->index++;
+    *value = list->index < list->count;
+    return S_OK;
+}
+
+static HRESULT WINAPI modifier_iterator_GetMany( IIterator_InteractionTrackerInertiaModifier *iface, UINT32 size,
+                                                 IInteractionTrackerInertiaModifier **items, UINT32 *count )
+{
+    return E_NOTIMPL;
+}
+
+static const IIterator_InteractionTrackerInertiaModifierVtbl modifier_iterator_vtbl =
+{
+    modifier_iterator_QueryInterface,
+    modifier_iterator_AddRef,
+    modifier_iterator_Release,
+    modifier_iterator_GetIids,
+    modifier_iterator_GetRuntimeClassName,
+    modifier_iterator_GetTrustLevel,
+    modifier_iterator_get_Current,
+    modifier_iterator_get_HasCurrent,
+    modifier_iterator_MoveNext,
+    modifier_iterator_GetMany,
+};
+
+static ICompositionAnimation *create_vector3_animation( ICompositor *compositor, Vector3 value, INT64 duration )
+{
+    IVector3KeyFrameAnimation *key_frames;
+    ICompositionAnimation *animation;
+    IKeyFrameAnimation *key_frame;
+    TimeSpan span = {duration};
+
+    ICompositor_CreateVector3KeyFrameAnimation( compositor, &key_frames );
+    IVector3KeyFrameAnimation_InsertKeyFrame( key_frames, 1.0f, value );
+    IVector3KeyFrameAnimation_QueryInterface( key_frames, &IID_IKeyFrameAnimation, (void **)&key_frame );
+    IKeyFrameAnimation_put_Duration( key_frame, span );
+    IKeyFrameAnimation_Release( key_frame );
+    IVector3KeyFrameAnimation_QueryInterface( key_frames, &IID_ICompositionAnimation, (void **)&animation );
+    IVector3KeyFrameAnimation_Release( key_frames );
+    return animation;
+}
+
+static ICompositionAnimation *create_scalar_animation( ICompositor *compositor, FLOAT value )
+{
+    IScalarKeyFrameAnimation *key_frames;
+    ICompositionAnimation *animation;
+    IKeyFrameAnimation *key_frame;
+    TimeSpan span = {2000000};
+
+    ICompositor_CreateScalarKeyFrameAnimation( compositor, &key_frames );
+    IScalarKeyFrameAnimation_InsertKeyFrame( key_frames, 1.0f, value );
+    IScalarKeyFrameAnimation_QueryInterface( key_frames, &IID_IKeyFrameAnimation, (void **)&key_frame );
+    IKeyFrameAnimation_put_Duration( key_frame, span );
+    IKeyFrameAnimation_Release( key_frame );
+    IScalarKeyFrameAnimation_QueryInterface( key_frames, &IID_ICompositionAnimation, (void **)&animation );
+    IScalarKeyFrameAnimation_Release( key_frames );
+    return animation;
+}
+
+static IExpressionAnimation *create_expression( ICompositor *compositor, const WCHAR *text )
+{
+    IExpressionAnimation *expression;
+    HSTRING str = hstring( text );
+
+    ICompositor_CreateExpressionAnimationWithExpression( compositor, str, &expression );
+    WindowsDeleteString( str );
+    return expression;
+}
+
+static ICompositionAnimation *create_expression_animation( ICompositor *compositor, const WCHAR *text )
+{
+    IExpressionAnimation *expression = create_expression( compositor, text );
+    ICompositionAnimation *animation;
+
+    IExpressionAnimation_QueryInterface( expression, &IID_ICompositionAnimation, (void **)&animation );
+    IExpressionAnimation_Release( expression );
+    return animation;
+}
+
+static HRESULT start_on_tracker( IInteractionTracker *tracker, const WCHAR *property, ICompositionAnimation *animation )
+{
+    ICompositionObject *object;
+    HSTRING str = hstring( property );
+    HRESULT hr;
+
+    IInteractionTracker_QueryInterface( tracker, &IID_ICompositionObject, (void **)&object );
+    hr = ICompositionObject_StartAnimation( object, str, animation );
+    if (SUCCEEDED(hr)) ICompositionObject_StopAnimation( object, str );
+    WindowsDeleteString( str );
+    ICompositionObject_Release( object );
+    return hr;
+}
+
+static void test_tracker_motion(void)
+{
+    struct modifier_list modifiers = {{&modifier_iterable_vtbl}, {&modifier_iterator_vtbl}};
+    IInteractionTrackerInertiaRestingValueStatics *resting_statics;
+    IInteractionTrackerInertiaRestingValue *resting;
+    IInteractionTrackerStatics *tracker_statics;
+    IDispatcherQueueController *queue;
+    ICompositionAnimation *animation;
+    IInteractionTracker5 *tracker5;
+    IInteractionTracker *tracker;
+    IExpressionAnimation *expression;
+    ICompositor *compositor;
+    IInspectable *inspectable;
+    Vector3 v3, center = {0};
+    int i, idle, custom;
+    BOOL between, beyond;
+    HSTRING str;
+    INT32 id;
+    HRESULT hr;
+
+    queue = create_queue( DQTAT_COM_STA );
+    str = hstring( L"Windows.UI.Composition.Compositor" );
+    hr = RoActivateInstance( str, &inspectable );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) goto done;
+    IInspectable_QueryInterface( inspectable, &IID_ICompositor, (void **)&compositor );
+    IInspectable_Release( inspectable );
+    str = hstring( L"Windows.UI.Composition.Interactions.InteractionTracker" );
+    hr = RoGetActivationFactory( str, &IID_IInteractionTrackerStatics, (void **)&tracker_statics );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    hr = IInteractionTrackerStatics_CreateWithOwner( tracker_statics, compositor, &tracker_owner, &tracker );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    v3.X = 0.0f;
+    v3.Y = 1000.0f;
+    v3.Z = 0.0f;
+    IInteractionTracker_put_MaxPosition( tracker, v3 );
+    /* these two take requests 1 and 2 */
+    IInteractionTracker_put_MaxScale( tracker, 4.0f );
+    IInteractionTracker_put_MinScale( tracker, 0.5f );
+
+    /* what it takes as an animation of its position is checked there and then; the request is counted all the same */
+    hr = IInteractionTracker_TryUpdatePositionWithAnimation( tracker, NULL, &id );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    animation = create_vector3_animation( compositor, (Vector3){0, 100, 0}, 2000000 );
+    id = -1;
+    hr = IInteractionTracker_TryUpdatePositionWithAnimation( tracker, animation, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( id == 3, "got request %d.\n", id );
+    hr = IInteractionTracker_TryUpdateScaleWithAnimation( tracker, animation, center, &id );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ICompositionAnimation_Release( animation );
+    animation = create_scalar_animation( compositor, 2.0f );
+    id = -1;
+    hr = IInteractionTracker_TryUpdatePositionWithAnimation( tracker, animation, &id );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ok( id == -1, "got request %d.\n", id );
+    hr = IInteractionTracker_TryUpdateScaleWithAnimation( tracker, animation, center, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( id == 6, "got request %d.\n", id );
+    ICompositionAnimation_Release( animation );
+    animation = create_expression_animation( compositor, L"Vector3(0, 50, 0)" );
+    hr = IInteractionTracker_TryUpdatePositionWithAnimation( tracker, animation, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( id == 7, "got request %d.\n", id );
+    ICompositionAnimation_Release( animation );
+    animation = create_expression_animation( compositor, L"2.5" );
+    hr = IInteractionTracker_TryUpdatePositionWithAnimation( tracker, animation, &id );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ICompositionAnimation_Release( animation );
+    hr = IInteractionTracker_TryUpdatePositionWithAdditionalVelocity( tracker, (Vector3){0, 500, 0}, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( id == 9, "got request %d.\n", id );
+    /* options are looked at once the request has its number, which is handed back */
+    IInteractionTracker_QueryInterface( tracker, &IID_IInteractionTracker5, (void **)&tracker5 );
+    id = -1;
+    hr = IInteractionTracker5_TryUpdatePositionWithOption( tracker5, (Vector3){0, 5, 0}, 7, 0, &id );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ok( id == 10, "got request %d.\n", id );
+    id = -1;
+    hr = IInteractionTracker5_TryUpdatePositionWithOption( tracker5, (Vector3){0, 5, 0},
+            InteractionTrackerClampingOption_Auto, 7, &id );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ok( id == 11, "got request %d.\n", id );
+    IInteractionTracker5_Release( tracker5 );
+    /* its bounds can be animated; what it works out cannot */
+    animation = create_vector3_animation( compositor, (Vector3){0, 100, 0}, 2000000 );
+    hr = start_on_tracker( tracker, L"Position", animation );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = start_on_tracker( tracker, L"MinPosition", animation );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = start_on_tracker( tracker, L"NaturalRestingPosition", animation );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = start_on_tracker( tracker, L"PositionVelocityInPixelsPerSecond", animation );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ICompositionAnimation_Release( animation );
+    animation = create_scalar_animation( compositor, 2.0f );
+    hr = start_on_tracker( tracker, L"Scale", animation );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = start_on_tracker( tracker, L"MaxScale", animation );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = start_on_tracker( tracker, L"Position.Y", animation );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ICompositionAnimation_Release( animation );
+    IInteractionTracker_Release( tracker );
+
+    /* the rest needs a compositor that draws frames, which a locked session's does not */
+    hr = IInteractionTrackerStatics_CreateWithOwner( tracker_statics, compositor, &tracker_owner, &tracker );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IInteractionTracker_put_MaxPosition( tracker, v3 );
+    pump_messages( 100 );
+    event_count = 0;
+    animation = create_vector3_animation( compositor, (Vector3){0, 300, 0}, 2000000 );
+    hr = IInteractionTracker_TryUpdatePositionWithAnimation( tracker, animation, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionAnimation_Release( animation );
+    if ((idle = wait_for_event( EVENT_IDLE, id, 3000 )) < 0 && !event_count)
+    {
+        skip( "the compositor draws no frames here.\n" );
+        IInteractionTracker_Release( tracker );
+        goto release;
+    }
+    ok( idle >= 0, "the animation did not end.\n" );
+    /* it goes into its custom animation state, moves through the values between, and comes to rest where it goes */
+    ok( event_count && events[0].kind == EVENT_CUSTOM_ANIMATION && events[0].id == id,
+        "got first event %d for request %d.\n", events[0].kind, events[0].id );
+    between = FALSE;
+    for (i = 0; i < idle; i++)
+    {
+        if (events[i].kind != EVENT_VALUES) continue;
+        ok( events[i].id == id, "got request %d.\n", events[i].id );
+        if (events[i].position.Y > 0.0f && events[i].position.Y < 300.0f) between = TRUE;
+    }
+    ok( between, "saw nothing between where it started and where it went.\n" );
+    IInteractionTracker_get_Position( tracker, &v3 );
+    ok( v3.Y == 300.0f, "got position %f,%f,%f.\n", v3.X, v3.Y, v3.Z );
+
+    /* custom animations are kept within bounds */
+    event_count = 0;
+    animation = create_vector3_animation( compositor, (Vector3){0, 5000, 0}, 2000000 );
+    hr = IInteractionTracker_TryUpdatePositionWithAnimation( tracker, animation, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionAnimation_Release( animation );
+    idle = wait_for_event( EVENT_IDLE, id, 3000 );
+    ok( idle >= 0, "the animation did not end.\n" );
+    beyond = FALSE;
+    for (i = 0; i < idle; i++) if (events[i].kind == EVENT_VALUES && events[i].position.Y > 1000.0f) beyond = TRUE;
+    ok( !beyond, "it went beyond its bounds.\n" );
+    IInteractionTracker_get_Position( tracker, &v3 );
+    ok( v3.Y == 1000.0f, "got position %f,%f,%f.\n", v3.X, v3.Y, v3.Z );
+
+    /* a position set outright ends an animation, and it is idle for that request */
+    event_count = 0;
+    animation = create_vector3_animation( compositor, (Vector3){0, 0, 0}, 20000000 );
+    hr = IInteractionTracker_TryUpdatePositionWithAnimation( tracker, animation, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ICompositionAnimation_Release( animation );
+    custom = wait_for_event( EVENT_CUSTOM_ANIMATION, id, 1000 );
+    ok( custom >= 0, "no custom animation state.\n" );
+    pump_messages( 200 );
+    hr = IInteractionTracker_TryUpdatePosition( tracker, (Vector3){0, 500, 0}, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    idle = wait_for_event( EVENT_IDLE, id, 1000 );
+    ok( idle >= 0, "not idle for the update.\n" );
+    pump_messages( 300 );
+    for (i = idle + 1; i < event_count; i++)
+        ok( events[i].kind != EVENT_VALUES, "the animation went on, to %f.\n", events[i].position.Y );
+    IInteractionTracker_get_Position( tracker, &v3 );
+    ok( v3.Y == 500.0f, "got position %f,%f,%f.\n", v3.X, v3.Y, v3.Z );
+
+    /* velocity starts inertia, which ends where it naturally rests */
+    event_count = 0;
+    hr = IInteractionTracker_TryUpdatePositionWithAdditionalVelocity( tracker, (Vector3){0, 200, 0}, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    i = wait_for_event( EVENT_INERTIA, id, 1000 );
+    ok( i >= 0, "no inertia.\n" );
+    if (i >= 0)
+    {
+        ok( events[i].velocity.Y == 200.0f, "got velocity %f.\n", events[i].velocity.Y );
+        ok( events[i].natural.Y > 500.0f && events[i].natural.Y < 1000.0f, "got natural resting position %f.\n",
+            events[i].natural.Y );
+        ok( !events[i].has_modified, "got a modified resting position.\n" );
+        v3 = events[i].natural;
+    }
+    idle = wait_for_event( EVENT_IDLE, id, 5000 );
+    ok( idle >= 0, "inertia did not end.\n" );
+    if (i >= 0)
+    {
+        Vector3 at;
+        IInteractionTracker_get_Position( tracker, &at );
+        ok( fabsf( at.Y - v3.Y ) < 1.0f, "got position %f, expected %f.\n", at.Y, v3.Y );
+    }
+
+    /* an inertia modifier whose condition holds says where it rests instead */
+    str = hstring( L"Windows.UI.Composition.Interactions.InteractionTrackerInertiaRestingValue" );
+    hr = RoGetActivationFactory( str, &IID_IInteractionTrackerInertiaRestingValueStatics, (void **)&resting_statics );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IInteractionTrackerInertiaRestingValueStatics_Create( resting_statics, compositor, &resting );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    expression = create_expression( compositor, L"this.Target.NaturalRestingPosition.Y > 0" );
+    IInteractionTrackerInertiaRestingValue_put_Condition( resting, expression );
+    IExpressionAnimation_Release( expression );
+    expression = create_expression( compositor, L"700" );
+    IInteractionTrackerInertiaRestingValue_put_RestingValue( resting, expression );
+    IExpressionAnimation_Release( expression );
+    IInteractionTrackerInertiaRestingValue_QueryInterface( resting, &IID_IInteractionTrackerInertiaModifier,
+                                                           (void **)&modifiers.items[0] );
+    modifiers.count = 1;
+    hr = IInteractionTracker_ConfigurePositionYInertiaModifiers( tracker,
+            &modifiers.IIterable_InteractionTrackerInertiaModifier_iface );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    event_count = 0;
+    hr = IInteractionTracker_TryUpdatePositionWithAdditionalVelocity( tracker, (Vector3){0, -50, 0}, &id );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    i = wait_for_event( EVENT_INERTIA, id, 1000 );
+    ok( i >= 0, "no inertia.\n" );
+    if (i >= 0)
+    {
+        ok( events[i].has_modified, "got no modified resting position.\n" );
+        ok( events[i].modified.Y == 700.0f, "got modified resting position %f.\n", events[i].modified.Y );
+    }
+    idle = wait_for_event( EVENT_IDLE, id, 5000 );
+    ok( idle >= 0, "inertia did not end.\n" );
+    IInteractionTracker_get_Position( tracker, &v3 );
+    ok( fabsf( v3.Y - 700.0f ) < 1.0f, "got position %f.\n", v3.Y );
+    hr = IInteractionTracker_ConfigurePositionYInertiaModifiers( tracker, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IInteractionTrackerInertiaModifier_Release( modifiers.items[0] );
+    IInteractionTrackerInertiaRestingValue_Release( resting );
+    IInteractionTrackerInertiaRestingValueStatics_Release( resting_statics );
+    IInteractionTracker_Release( tracker );
+
+release:
+    IInteractionTrackerStatics_Release( tracker_statics );
+    ICompositor_Release( compositor );
+    pump_messages( 100 );
+done:
+    if (queue) IDispatcherQueueController_Release( queue );
+}
+
 START_TEST(composition)
 {
     IDispatcherQueueController *queue;
@@ -1271,5 +1861,6 @@ START_TEST(composition)
     test_drop_shadow();
     test_redirect_visual();
     test_interactions();
+    test_tracker_motion();
     RoUninitialize();
