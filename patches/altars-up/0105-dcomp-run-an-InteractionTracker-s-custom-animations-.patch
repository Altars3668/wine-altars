+/*
+ * Copies what an animation says into what runs, and checks it as Windows does
+ * when it starts: an expression has to compute a value of the type animated,
+ * and a key frame animation has to be of that type.  The running record's
+ * object, starting value and type are set already.
+ */
+static HRESULT running_prepare( struct running *running, struct animation *animation )
+{
+    const WCHAR *what = running->property ? running->property : L"a motion";
+    struct eval_context context;
+    struct value check;
+    unsigned int i;
+    HRESULT hr;
+
+    running->kind = animation->kind;
+    if (FAILED(hr = parameters_copy( &running->parameters, &animation->parameters ))) return hr;
+    if (animation->kind == ANIMATION_EXPRESSION)
