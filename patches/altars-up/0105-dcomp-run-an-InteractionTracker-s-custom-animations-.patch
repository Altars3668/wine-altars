+/* what a modifier is made of, for a tracker to use: its kind and its two expressions, NULL where unset */
+BOOL modifier_parts( IUnknown *iface, enum modifier_kind *kind, ICompositionAnimation **condition,
+                     ICompositionAnimation **value )
+{
+    ICompositionObject *composition;
+    struct modifier *modifier;
+    struct object *object;
+    unsigned int i;
+
+    *condition = *value = NULL;
+    if (!iface || FAILED(IUnknown_QueryInterface( iface, &IID_ICompositionObject, (void **)&composition ))) return FALSE;
+    object = unsafe_impl_from_ICompositionObject( composition );
+    ICompositionObject_Release( composition );
+    if (!object) return FALSE;
+    for (i = 0; i < ARRAY_SIZE(modifier_ops); i++) if (object->ops == &modifier_ops[i]) break;
+    if (i == ARRAY_SIZE(modifier_ops)) return FALSE;
+    modifier = impl_from_modifier_object( object );
+
+    compositor_lock( object->compositor );
+    *kind = modifier->kind;
+    if (modifier->expressions[0])
+        IExpressionAnimation_QueryInterface( modifier->expressions[0], &IID_ICompositionAnimation, (void **)condition );
+    if (modifier->expressions[1])
+        IExpressionAnimation_QueryInterface( modifier->expressions[1], &IID_ICompositionAnimation, (void **)value );
+    compositor_unlock( object->compositor );
+    return TRUE;
+}
