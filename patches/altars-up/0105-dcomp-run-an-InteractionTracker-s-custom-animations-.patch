+                                                 IInteractionTrackerInertiaStateEnteredArgs *args )
+{
+    struct tracker_event *event;
+    IReference_Vector3 *modified = NULL;
+    INT32 id = -1;
+
+    IInteractionTrackerInertiaStateEnteredArgs_get_RequestId( args, &id );
