+    tracker->natural_resting_position.X = natural[0];
+    tracker->natural_resting_position.Y = natural[1];
+    tracker->natural_resting_position.Z = tracker->position.Z;
+    tracker->natural_resting_scale = expf( natural[2] );
+    tracker->position_velocity.X = velocity.X;
+    tracker->position_velocity.Y = velocity.Y;
+    tracker->position_velocity.Z = 0.0f;
+    tracker->scale_velocity = scale_velocity;
+
+    args.natural_position = tracker->natural_resting_position;
+    args.natural_scale = tracker->natural_resting_scale;
+    args.velocity = tracker->position_velocity;
+    args.scale_velocity = scale_velocity;
+    args.modified_position = tracker->natural_resting_position;
+    args.modified_scale = tracker->natural_resting_scale;
+    for (i = 0; i < ARRAY_SIZE(tracker->inertia); i++)
+    {
+        struct inertia_axis *axis = &tracker->inertia[i];
+        float rest = natural[i];
+
+        if ((modified[i] = tracker_modified( tracker, &tracker->inertia_modifiers[i], &value )))
+        {
+            if (i == 0) args.modified_position.X = value;
+            else if (i == 1) args.modified_position.Y = value;
+            else args.modified_scale = value;
+            rest = i == 2 ? logf( max( value, 1e-6f ) ) : value;
+        }
+        axis->rest = clampf( rest, lows[i], highs[i] );
+        axis->at = axis->from;
+        axis->speed = axis->velocity;
+        axis->moving = axis->rest != axis->from;
+    }
+    args.position_modified = modified[0] || modified[1];
+    args.scale_modified = modified[2];
+    args.from_impulse = from_impulse;
