     compositor_unlock( compositor );
     for (i = 0; i < count; i++)
     {
@@ -240,7 +246,7 @@ static HRESULT WINAPI frame_handler_Invoke( ITypedEventHandler_DispatcherQueueTi
 
     compositor_render( compositor, FALSE );
     compositor_lock( compositor );
