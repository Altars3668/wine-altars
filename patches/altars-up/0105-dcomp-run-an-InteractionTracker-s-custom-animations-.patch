+#include <math.h>
+
 #include "private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
 
 /*
  * An interaction tracker holds a position and a scale that input or the
- * application moves, within bounds, and tells its owner what they became.
- * Nothing here turns input into motion yet: the position moves when the
- * application asks it to, and inertia and animated updates end where they
- * would have ended, at once.
+ * application moves, within bounds, and tells its owner what they became.  It
+ * is a state machine, as Windows documents it: idle; moved by a custom
+ * animation, which is kept within the bounds; coasting to rest in inertia,
+ * slowing as its decay rates say and ending where its inertia modifiers say;
+ * and interacting, which only input brings about -- and nothing here turns
+ * input into motion yet, so a tracker is never in that state.
  */
 
+/* conditional values or inertia modifiers, as configured: copies of what the iterable held */
+struct modifiers
+{
+    IUnknown **items;
+    UINT count;
+};
+
+static void modifiers_clear( struct modifiers *modifiers )
+{
+    while (modifiers->count)
+    {
+        modifiers->count--;
+        IUnknown_Release( modifiers->items[modifiers->count] );
+    }
+    free( modifiers->items );
+    modifiers->items = NULL;
+}
+
+/* replaces what was configured with what the iterable holds now; NULL configures none */
+static HRESULT modifiers_set( struct compositor *compositor, struct modifiers *modifiers, IIterable_IInspectable *iterable )
+{
+    struct modifiers new = {0}, old;
+    IIterator_IInspectable *iterator;
+    IInspectable *item, **items;
+    boolean more = FALSE;
+    HRESULT hr;
+
+    if (iterable)
+    {
+        if (FAILED(hr = IIterable_IInspectable_First( iterable, &iterator ))) return hr;
+        hr = IIterator_IInspectable_get_HasCurrent( iterator, &more );
+        while (SUCCEEDED(hr) && more)
+        {
+            if (FAILED(hr = IIterator_IInspectable_get_Current( iterator, &item ))) break;
+            if (!(items = realloc( new.items, (new.count + 1) * sizeof(*items) )))
+            {
+                if (item) IInspectable_Release( item );
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            new.items = (IUnknown **)items;
+            if (item) new.items[new.count++] = (IUnknown *)item;
+            hr = IIterator_IInspectable_MoveNext( iterator, &more );
+        }
+        IIterator_IInspectable_Release( iterator );
+        if (FAILED(hr))
+        {
+            modifiers_clear( &new );
+            return hr;
+        }
+    }
+    compositor_lock( compositor );
+    old = *modifiers;
+    *modifiers = new;
+    compositor_unlock( compositor );
+    modifiers_clear( &old );
+    return S_OK;
+}
