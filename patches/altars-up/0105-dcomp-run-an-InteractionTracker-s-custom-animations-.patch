+/*
+ * A motion is an animation an object runs on a value of its own instead of on
+ * a property: an interaction tracker's custom animations, which it keeps
+ * within its bounds and reports as they go.  It is checked and copied as a
+ * started animation is, and counts in the batches, but it is applied to
+ * nothing; its object asks where it is each frame, and ends it.  All of these
+ * are called with the compositor locked.
+ */
+HRESULT motion_start( struct object *object, ICompositionAnimation *iface, const struct value *starting,
+                      struct running **out )
+{
+    struct animation *animation = unsafe_impl_from_ICompositionAnimation( iface );
+    struct running *running;
+    HRESULT hr;
+
+    if (!animation)
+    {
+        if (iface) FIXME( "animation %p is not one of ours.\n", iface );
+        return E_INVALIDARG;
+    }
+    if (!(running = calloc( 1, sizeof(*running) ))) return E_OUTOFMEMORY;
+    list_init( &running->parameters );
+    list_init( &running->entry );
+    list_init( &running->time_entry );
+    running->object = object;
+    running->motion = TRUE;
+    running->starting = *starting;
+    running->type = starting->type;
+    if (FAILED(hr = running_prepare( running, animation )))
+    {
+        running_free( running );
+        return hr;
+    }
+    if (running->kind == ANIMATION_KEY_FRAME) list_add_tail( compositor_running( object->compositor ), &running->time_entry );
+    batch_take_animation( object->compositor, running );
+    compositor_changed( object->compositor );
+    *out = running;
+    return S_OK;
+}
+
+/* where a motion has got to; FALSE until it has anything to say */
+BOOL motion_value( struct running *running, struct value *out )
+{
+    if (!running_value( running, compositor_time(), out, 0 ))
+    {
+        if (!running->has_last) return FALSE;
+        *out = running->last;
+    }
+    running->last = *out;
+    running->has_last = TRUE;
+    return TRUE;
+}
+
+/* whether a key frame motion has run its course; an expression never does */
+BOOL motion_done( struct running *running )
+{
+    return running_done( running, compositor_time() );
+}
+
+void motion_stop( struct running *running )
+{
+    running_stop( running, FALSE );
+}
+
+/*
+ * What an expression animation computes now, of the type of like, with target
+ * as this.Target: the conditions and values a tracker's inertia modifiers are
+ * made of.  Called with the compositor locked.
+ */
+BOOL animation_evaluate( ICompositionAnimation *iface, struct object *target, const struct value *like,
+                         struct value *out )
+{
+    struct animation *animation = unsafe_impl_from_ICompositionAnimation( iface );
+    struct running running = {0};
+    struct eval_context context;
+    BOOL ret;
+
+    if (!animation || animation->kind != ANIMATION_EXPRESSION || !animation->text) return FALSE;
+    if (FAILED(expression_parse( WindowsGetStringRawBuffer( animation->text, NULL ), &running.expression )))
+        return FALSE;
+    list_init( &running.parameters );
+    running.object = target;
+    running.starting = *like;
+    running.type = like->type;
+    running_context( &running, &context, NULL );
+    context.lookup_data = &animation->parameters;
+    ret = evaluate_as( running.expression, &context, running.type, out );
+    expression_free( running.expression );
+    return ret;
+}
+
 HRESULT object_stop_animation( struct object *object, HSTRING property )
 {
     const WCHAR *name = WindowsGetStringRawBuffer( property, NULL );
@@ -736,6 +844,7 @@ void animations_frame( struct compositor *compositor )
             running->start = now;
             continue;
         }
+        if (running->motion) continue;
         if (running_done( running, now )) running_stop( running, TRUE );
     }
 }
