+    tracker->scale_center = center;
+    if (tracker_modified( tracker, &tracker->center_modifiers[0], &value )) tracker->scale_center.X = value;
+    if (tracker_modified( tracker, &tracker->center_modifiers[1], &value )) tracker->scale_center.Y = value;
+    tracker->inertia_start = 0;
+    tracker->from_impulse = from_impulse;
+    tracker_enter( tracker, TRACKER_INERTIA, request_id, &args );
+}
