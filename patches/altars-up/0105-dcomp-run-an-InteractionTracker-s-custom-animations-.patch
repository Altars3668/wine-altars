+static BOOL tracker_modified( struct tracker *tracker, const struct modifiers *modifiers, float *value )
+{
+    ICompositionAnimation *condition, *result;
+    struct value like, out;
+    enum modifier_kind kind;
+    BOOL found = FALSE, holds;
+    unsigned int i;
+
+    for (i = 0; i < modifiers->count; i++)
+    {
+        if (!modifier_parts( modifiers->items[i], &kind, &condition, &result )) continue;
+        value_boolean( &like, FALSE );
+        holds = condition && animation_evaluate( condition, &tracker->base, &like, &out ) && out.f[0];
+        if (holds)
+        {
+            value_scalar( &like, 0.0f );
+            if (kind == MODIFIER_MOTION) FIXME( "inertia motion modifiers are not run, the tracker coasts to rest.\n" );
+            else if (result && animation_evaluate( result, &tracker->base, &like, &out ))
+            {
