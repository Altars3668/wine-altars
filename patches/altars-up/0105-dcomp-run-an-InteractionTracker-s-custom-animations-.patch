+/*** what an interaction tracker's owner hears ***/
+
+enum tracker_event_kind
+{
+    EVENT_VALUES,
+    EVENT_IDLE,
+    EVENT_CUSTOM_ANIMATION,
+    EVENT_INERTIA,
+    EVENT_INTERACTING,
+    EVENT_IGNORED,
+};
+
+struct tracker_event
+{
+    enum tracker_event_kind kind;
+    INT32 id;
+    Vector3 position;
+    FLOAT scale;
+    Vector3 natural, velocity, modified;
+    BOOL has_modified;
+};
+
+static struct tracker_event events[512];
+static unsigned int event_count;
+
+static struct tracker_event *add_event( enum tracker_event_kind kind, INT32 id )
+{
+    struct tracker_event *event;
+
+    if (event_count == ARRAY_SIZE(events)) return NULL;
+    event = &events[event_count++];
+    memset( event, 0, sizeof(*event) );
+    event->kind = kind;
+    event->id = id;
+    return event;
+}
+
+static HRESULT WINAPI owner_QueryInterface( IInteractionTrackerOwner *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IInteractionTrackerOwner ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
