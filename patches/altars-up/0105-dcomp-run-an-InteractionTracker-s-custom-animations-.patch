+/* pumps until the owner hears of kind for request id; the index of the event, or -1 */
+static int wait_for_event( enum tracker_event_kind kind, INT32 id, DWORD timeout )
+{
+    DWORD end = GetTickCount() + timeout;
+    unsigned int i, seen = 0;
+
+    do
+    {
+        for (i = seen; i < event_count; i++) if (events[i].kind == kind && events[i].id == id) return i;
+        seen = event_count;
+        pump_messages( 10 );
+    } while ((int)(end - GetTickCount()) > 0);
+    return -1;
+}
