+/* sets it coasting from where it is, as fast as it is told */
+static void tracker_start_inertia( struct tracker *tracker, Vector3 velocity, float scale_velocity, Vector3 center,
+                                   INT32 request_id, boolean from_impulse )
+{
+    struct inertia_args args = {0};
+    float rates[3], lows[3], highs[3], natural[3], value, low_scale, high_scale;
+    const float velocities[3] = {velocity.X, velocity.Y, scale_velocity};
+    BOOL modified[3];
+    Vector3 low, high;
+    unsigned int i;
+
+    tracker_bounds( tracker, &low, &high, &low_scale, &high_scale );
+    lows[0] = low.X;
+    highs[0] = max( low.X, high.X );
+    lows[1] = low.Y;
+    highs[1] = max( low.Y, high.Y );
+    lows[2] = logf( max( low_scale, 1e-6f ) );
+    highs[2] = logf( max( max( low_scale, high_scale ), 1e-6f ) );
