From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 23:36:58 -0400
Subject: [PATCH] vbscript: Support GetObject with a class name.

GetObject(pathname, class) gives the class's running instance when the path is left out, a new
instance when the path is empty, and a new instance that loads the file otherwise; only a path
naming a moniker was supported, and every form with a class failed with "Object doesn't support
this action", including GetObject(, "Excel.Application") that scripts use to reach a running Excel.

Also release the object a moniker bound to once its IDispatch is taken.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/vbscript/global.c b/dlls/vbscript/global.c
index 7ff12658fdf..20567c309f9 100644
--- a/dlls/vbscript/global.c
+++ b/dlls/vbscript/global.c
@@ -2902,6 +2902,60 @@ static HRESULT Global_CreateObject(BuiltinDisp *This, VARIANT *arg, unsigned arg
     return S_OK;
 }
 
+static BOOL is_arg_missing(const VARIANT *v)
+{
+    return V_VT(v) == VT_ERROR && V_ERROR(v) == DISP_E_PARAMNOTFOUND;
+}
+
+/* GetObject(pathname, class): with a class and no path, the class's running instance; with an empty
+ * path, a new instance; with a file, a new instance that loads it */
+static HRESULT get_object_of_class(BuiltinDisp *This, VARIANT *path, VARIANT *class, IUnknown **ret)
+{
+    IPersistFile *persist_file;
+    BSTR progid, file = NULL;
+    IUnknown *obj_unk;
+    HRESULT hres;
+    CLSID clsid;
+
+    hres = to_string(This->ctx->lcid, class, &progid);
+    if(FAILED(hres))
+        return hres;
+    if(!is_arg_missing(path)) {
+        hres = to_string(This->ctx->lcid, path, &file);
+        if(FAILED(hres)) {
+            SysFreeString(progid);
+            return hres;
+        }
+    }
+
+    if(is_arg_missing(path)) {
+        hres = CLSIDFromProgID(progid, &clsid);
+        if(SUCCEEDED(hres))
+            hres = GetActiveObject(&clsid, NULL, &obj_unk);
+        if(SUCCEEDED(hres)) {
+            hres = set_object_site(This->ctx, obj_unk);
+            if(FAILED(hres))
+                IUnknown_Release(obj_unk);
+        }
+    }else if(!(obj_unk = create_object(This->ctx, progid))) {
+        hres = VB_E_CANNOT_CREATE_OBJ;
+    }else if(SysStringLen(file)) {
+        hres = IUnknown_QueryInterface(obj_unk, &IID_IPersistFile, (void**)&persist_file);
+        if(SUCCEEDED(hres)) {
+            hres = IPersistFile_Load(persist_file, file, STGM_READ);
+            IPersistFile_Release(persist_file);
+        }
+        if(FAILED(hres))
+            IUnknown_Release(obj_unk);
+    }
+
+    SysFreeString(progid);
+    SysFreeString(file);
+    if(SUCCEEDED(hres))
+        *ret = obj_unk;
+    return hres;
+}
+
 static HRESULT Global_GetObject(BuiltinDisp *This, VARIANT *args, unsigned args_cnt, VARIANT *res)
 {
     IBindCtx *bind_ctx;
@@ -2913,40 +2967,52 @@ static HRESULT Global_GetObject(BuiltinDisp *This, VARIANT *args, unsigned args_
 
     TRACE("%s %s\n", args_cnt ? debugstr_variant(args) : "", args_cnt > 1 ? debugstr_variant(args+1) : "");
 
-    if(args_cnt != 1 || V_VT(args) != VT_BSTR) {
-        FIXME("unsupported args\n");
-        return E_NOTIMPL;
-    }
-    if(!SysStringLen(V_BSTR(args)))
-        return MAKE_VBSERROR(VBSE_ILLEGAL_FUNC_CALL);
+    if(args_cnt == 2 && !is_arg_missing(args + 1)) {
+        if(This->ctx->safeopt & (INTERFACE_USES_SECURITY_MANAGER|INTERFACESAFE_FOR_UNTRUSTED_DATA)) {
+            WARN("blocked in current safety mode\n");
+            return VB_E_CANNOT_CREATE_OBJ;
+        }
 
-    if(This->ctx->safeopt & (INTERFACE_USES_SECURITY_MANAGER|INTERFACESAFE_FOR_UNTRUSTED_DATA)) {
-        WARN("blocked in current safety mode\n");
-        return VB_E_CANNOT_CREATE_OBJ;
-    }
+        hres = get_object_of_class(This, args, args + 1, &obj_unk);
+        if(FAILED(hres))
+            return hres;
+    }else {
+        if(V_VT(args) != VT_BSTR) {
+            FIXME("unsupported args\n");
+            return E_NOTIMPL;
+        }
+        if(!SysStringLen(V_BSTR(args)))
+            return MAKE_VBSERROR(VBSE_ILLEGAL_FUNC_CALL);
 
-    hres = CreateBindCtx(0, &bind_ctx);
-    if(FAILED(hres))
-        return hres;
+        if(This->ctx->safeopt & (INTERFACE_USES_SECURITY_MANAGER|INTERFACESAFE_FOR_UNTRUSTED_DATA)) {
+            WARN("blocked in current safety mode\n");
+            return VB_E_CANNOT_CREATE_OBJ;
+        }
 
-    hres = MkParseDisplayName(bind_ctx, V_BSTR(args), &eaten, &mon);
-    if(SUCCEEDED(hres)) {
-        hres = IMoniker_BindToObject(mon, bind_ctx, NULL, &IID_IUnknown, (void**)&obj_unk);
-        IMoniker_Release(mon);
-    }else {
-        hres = MK_E_SYNTAX;
-    }
-    IBindCtx_Release(bind_ctx);
-    if(FAILED(hres))
-        return hres;
+        hres = CreateBindCtx(0, &bind_ctx);
+        if(FAILED(hres))
+            return hres;
 
-    hres = set_object_site(This->ctx, obj_unk);
-    if(FAILED(hres)) {
-        IUnknown_Release(obj_unk);
-        return hres;
+        hres = MkParseDisplayName(bind_ctx, V_BSTR(args), &eaten, &mon);
+        if(SUCCEEDED(hres)) {
+            hres = IMoniker_BindToObject(mon, bind_ctx, NULL, &IID_IUnknown, (void**)&obj_unk);
+            IMoniker_Release(mon);
+        }else {
+            hres = MK_E_SYNTAX;
+        }
+        IBindCtx_Release(bind_ctx);
+        if(FAILED(hres))
+            return hres;
+
+        hres = set_object_site(This->ctx, obj_unk);
+        if(FAILED(hres)) {
+            IUnknown_Release(obj_unk);
+            return hres;
+        }
     }
 
     hres = IUnknown_QueryInterface(obj_unk, &IID_IDispatch, (void**)&disp);
+    IUnknown_Release(obj_unk);
     if(SUCCEEDED(hres)) {
         if(res) {
             V_VT(res) = VT_DISPATCH;
diff --git a/dlls/vbscript/tests/api.vbs b/dlls/vbscript/tests/api.vbs
index 106ae917139..bbb8cc01d5b 100644
--- a/dlls/vbscript/tests/api.vbs
+++ b/dlls/vbscript/tests/api.vbs
@@ -3502,6 +3502,17 @@ sub testWindowsBehavior()
     set o = GetObject("")
     call ok(Err.number = 5, "GetObject(""""): Err.number = " & Err.number)
     call Err.clear()
+    ' with a class: its running instance when the path is left out, a new one when the path is empty
+    set o = GetObject(, "Wine.NoSuchClass")
+    call ok(Err.number = 429, "GetObject(, ""Wine.NoSuchClass""): Err.number = " & Err.number)
+    call Err.clear()
+    set o = GetObject(, "Scripting.Dictionary")
+    call ok(Err.number = 429, "GetObject(, ""Scripting.Dictionary""): Err.number = " & Err.number)
+    call Err.clear()
+    set o = GetObject("", "Scripting.Dictionary")
+    call ok(Err.number = 0, "GetObject("""", ""Scripting.Dictionary""): Err.number = " & Err.number)
+    call ok(TypeName(o) = "Dictionary", "GetObject("""", ""Scripting.Dictionary""): " & TypeName(o))
+    call Err.clear()
     x = Split("a,b", ",", 0)
     call ok(Err.number = 0 and UBound(x) = -1, "Split(""a,b"", "","", 0): " & Err.number & " " & UBound(x))
 
diff --git a/dlls/vbscript/tests/createobj.c b/dlls/vbscript/tests/createobj.c
index b972c10832b..cda19fb15b9 100644
--- a/dlls/vbscript/tests/createobj.c
+++ b/dlls/vbscript/tests/createobj.c
@@ -979,6 +979,7 @@ static void test_CreateObject(void)
 static void test_GetObject(void)
 {
     IActiveScriptParse *parser;
+    DWORD cookie;
     HRESULT hres;
 
     /* Never allowed with security manager */
@@ -1030,6 +1031,39 @@ static void test_GetObject(void)
     hres = parse_script_e(parser, L"Call GetObject(\"nonexistent:test\").reportSuccess()");
     ok(hres == MK_E_SYNTAX, "hres = %08lx\n", hres);
     IActiveScriptParse_Release(parser);
+
+    /* With a class and an empty path, a new instance */
+    parser = create_script(FALSE);
+    SET_EXPECT(CreateInstance);
+    SET_EXPECT(QI_IObjectWithSite);
+    SET_EXPECT(SetSite);
+    SET_EXPECT(reportSuccess);
+    hres = parse_script_e(parser, L"Call GetObject(\"\", \"Wine.Test\").reportSuccess()");
+    ok(hres == S_OK, "hres = %08lx\n", hres);
+    CHECK_CALLED(CreateInstance);
+    CHECK_CALLED(QI_IObjectWithSite);
+    CHECK_CALLED(SetSite);
+    CHECK_CALLED(reportSuccess);
+    IActiveScriptParse_Release(parser);
+
+    /* With a class and no path, the running instance, and none when none runs */
+    parser = create_script(FALSE);
+    hres = parse_script_e(parser, L"Call GetObject(, \"Wine.Test\").reportSuccess()");
+    ok(hres == VB_E_CANNOT_CREATE_OBJ, "hres = %08lx\n", hres);
+
+    hres = RegisterActiveObject((IUnknown *)&testObj, &CLSID_TestObj, ACTIVEOBJECT_STRONG, &cookie);
+    ok(hres == S_OK, "RegisterActiveObject failed: %08lx\n", hres);
+    SET_EXPECT(QI_IObjectWithSite);
+    SET_EXPECT(SetSite);
+    SET_EXPECT(reportSuccess);
+    hres = parse_script_e(parser, L"Call GetObject(, \"Wine.Test\").reportSuccess()");
+    ok(hres == S_OK, "hres = %08lx\n", hres);
+    CLEAR_CALLED(QI_IObjectWithSite);
+    CLEAR_CALLED(SetSite);
+    CHECK_CALLED(reportSuccess);
+    hres = RevokeActiveObject(cookie, NULL);
+    ok(hres == S_OK, "RevokeActiveObject failed: %08lx\n", hres);
+    IActiveScriptParse_Release(parser);
 }
 
