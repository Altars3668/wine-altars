+        cur = prev;
 
     return cur;
 }
@@ -3196,21 +3299,23 @@ static struct domnode * xpath_next_preceding_sibling(struct xpath_parser_context
         return NULL;
 
     if (!cur)
-        return domnode_get_previous_sibling(ctxt->context->node);
