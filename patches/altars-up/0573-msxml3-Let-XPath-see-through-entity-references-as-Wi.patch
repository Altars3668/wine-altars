+/* XPath sees through entity references to what they hold, which takes their place: MSXML 6 through all of
+ * them, MSXML 3 through those not in another one, whose own references and all they hold are left out.
+ * Neither has a node for the DTD.  The axes are relative to the context node, which an entity reference
+ * may be in MSXML 3, so what it holds goes no further (Windows 11). */
+static bool xpath_opens_reference(const struct xpath_parser_context *ctxt, const struct domnode *node)
+{
+    if (node->type != NODE_ENTITY_REFERENCE) return false;
+    if (ctxt->context->properties->version >= MSXML6) return true;
+    return !node->parent || node->parent->type != NODE_ENTITY_REFERENCE;
+}
+
+static bool xpath_left_out(const struct xpath_parser_context *ctxt, const struct domnode *node)
+{
+    return node->type == NODE_ENTITY_REFERENCE || (node->type == NODE_DOCUMENT_TYPE && ctxt->context->xpath);
+}
+
+/* the node after one, past the end of the references it is in */
+static struct domnode *xpath_view_after(const struct xpath_parser_context *ctxt, struct domnode *node)
+{
+    struct domnode *next;
+
+    while (!(next = domnode_get_next_sibling(node)))
+    {
+        if (!(node = node->parent) || node == ctxt->context->node || !xpath_opens_reference(ctxt, node))
+            return NULL;
+    }
+    return next;
+}
+
+static struct domnode *xpath_view_before(const struct xpath_parser_context *ctxt, struct domnode *node)
+{
+    struct domnode *prev;
+
+    while (!(prev = domnode_get_previous_sibling(node)))
+    {
+        if (!(node = node->parent) || node == ctxt->context->node || !xpath_opens_reference(ctxt, node))
+            return NULL;
+    }
+    return prev;
+}
+
+/* the first node XPath sees at or after one, going into the references it meets */
+static struct domnode *xpath_view_forward(const struct xpath_parser_context *ctxt, struct domnode *node)
+{
+    while (node && xpath_left_out(ctxt, node))
+    {
+        if (xpath_opens_reference(ctxt, node) && !list_empty(&node->children))
+            node = domnode_get_first_child(node);
+        else
+            node = xpath_view_after(ctxt, node);
+    }
+    return node;
+}
+
+static struct domnode *xpath_view_backward(const struct xpath_parser_context *ctxt, struct domnode *node)
+{
+    while (node && xpath_left_out(ctxt, node))
+    {
+        if (xpath_opens_reference(ctxt, node) && !list_empty(&node->children))
+            node = domnode_get_last_child(node);
+        else
+            node = xpath_view_before(ctxt, node);
+    }
+    return node;
+}
+
+static struct domnode *xpath_view_first_child(const struct xpath_parser_context *ctxt, struct domnode *node)
+{
+    return xpath_view_forward(ctxt, domnode_get_first_child(node));
+}
+
+static struct domnode *xpath_view_last_child(const struct xpath_parser_context *ctxt, struct domnode *node)
+{
+    return xpath_view_backward(ctxt, domnode_get_last_child(node));
+}
+
+static struct domnode *xpath_view_next_sibling(const struct xpath_parser_context *ctxt, struct domnode *node)
+{
+    return xpath_view_forward(ctxt, xpath_view_after(ctxt, node));
+}
+
+static struct domnode *xpath_view_prev_sibling(const struct xpath_parser_context *ctxt, struct domnode *node)
+{
+    return xpath_view_backward(ctxt, xpath_view_before(ctxt, node));
+}
+
+static struct domnode *xpath_view_parent(const struct xpath_parser_context *ctxt, const struct domnode *node)
+{
+    struct domnode *parent = xpath_get_parent(node);
+
+    while (parent && parent != ctxt->context->node && parent->type == NODE_ENTITY_REFERENCE)
+        parent = xpath_get_parent(parent);
+    return parent;
+}
+
+/* an XPath query for what an entity reference holds fails from the reference (MSXML 3; MSXML 6 fails
+   any query from one) */
+static bool xpath_reference_context(struct xpath_parser_context *ctxt)
+{
+    if (ctxt->context->node->type != NODE_ENTITY_REFERENCE || !ctxt->context->xpath) return false;
+    xpath_parser_context_set_error(ctxt, XPATH_INVALID_OPERAND);
+    return true;
+}
+
