From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:08:18 -0400
Subject: [PATCH] include: Make the event telling services.exe has started a
 global one.

services.exe is to run in session 0, the services' session, and wineboot, which waits for it, in the
user's: a name without a prefix is a different event in each.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/include/wine/svcctl.idl b/include/wine/svcctl.idl
index 74b939ddd17..e4cbde4c0c6 100644
--- a/include/wine/svcctl.idl
+++ b/include/wine/svcctl.idl
@@ -34,8 +34,9 @@ cpp_quote("#define SVCCTL_TRANSPORTA \"ncacn_np\"")
 cpp_quote("#define SVCCTL_ENDPOINT {'\\\\','p','i','p','e','\\\\','s','v','c','c','t','l',0}")
 cpp_quote("#define SVCCTL_ENDPOINTA \"\\\\pipe\\\\svcctl\"")
 
-/* Not the Windows event name - if needed the true one can be found in Inside Windows */
-cpp_quote("#define SVCCTL_STARTED_EVENT {'_','_','w','i','n','e','_','S','v','c','c','t','l','S','t','a','r','t','e','d',0}")
+/* Not the Windows event name - if needed the true one can be found in Inside Windows.  A global one, as
+ * services.exe runs in session 0 and wineboot, which waits for it, in the user's session. */
+cpp_quote("#define SVCCTL_STARTED_EVENT {'G','l','o','b','a','l','\\\\','_','_','w','i','n','e','_','S','v','c','c','t','l','S','t','a','r','t','e','d',0}")
 
 /* Service startup protocol over control pipe - not compatible with Windows */
 cpp_quote("#define SERVICE_PROTOCOL_MAGIC 0x57494e45")
