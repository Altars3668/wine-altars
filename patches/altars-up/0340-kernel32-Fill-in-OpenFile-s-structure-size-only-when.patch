From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 02:35:50 -0400
Subject: [PATCH] kernel32: Fill in OpenFile's structure size only when it
 succeeds.

The tests find cBytes left as it was when OpenFile fails, for a missing
file and for a name too long alike.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/file.c b/dlls/kernel32/file.c
index 8574e5fe54e..0dd517bb525 100644
--- a/dlls/kernel32/file.c
+++ b/dlls/kernel32/file.c
@@ -443,7 +443,7 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
         );
 
 
-    ofs->cBytes = sizeof(OFSTRUCT);
+    /* the size is filled in only when the call succeeds */
     ofs->nErrCode = 0;
     if (mode & OF_REOPEN) name = ofs->szPathName;
 
@@ -467,6 +467,7 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
     if (mode & OF_PARSE)
     {
         ofs->fFixedDisk = (GetDriveTypeA( ofs->szPathName ) != DRIVE_REMOVABLE);
+        ofs->cBytes = sizeof(OFSTRUCT);
         TRACE("(%s): OF_PARSE, res = '%s'\n", name, ofs->szPathName );
         return 0;
     }
@@ -496,6 +497,7 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
         if (mode & OF_DELETE)
         {
             if (!DeleteFileA( ofs->szPathName )) goto error;
+            ofs->cBytes = sizeof(OFSTRUCT);
             TRACE("(%s): OF_DELETE return = OK\n", name);
             return TRUE;
         }
@@ -520,6 +522,7 @@ HFILE WINAPI OpenFile( LPCSTR name, OFSTRUCT *ofs, UINT mode )
         ofs->Reserved2 = filedatetime[1];
     }
     TRACE("(%s): OK, return = %p\n", name, handle );
+    ofs->cBytes = sizeof(OFSTRUCT);
     if (mode & OF_EXIST)  /* Return TRUE instead of a handle */
     {
         CloseHandle( handle );
diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 8a410f8148a..5426cc59468 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -3804,7 +3804,6 @@ static void test_OpenFile(void)
         hFile = OpenFile(foo, &ofs, OF_EXIST);
         ok( hFile == HFILE_ERROR, "hFile != HFILE_ERROR : %ld\n", GetLastError());
         ok( GetLastError() == ERROR_FILE_NOT_FOUND, "GetLastError() returns %ld\n", GetLastError() );
-        todo_wine
         ok( ofs.cBytes == 0xA5, "OpenFile set ofs.cBytes to %d\n", ofs.cBytes );
         ok( ofs.nErrCode == ERROR_FILE_NOT_FOUND, "OpenFile set ofs.nErrCode to %d\n", ofs.nErrCode );
         ok( lstrcmpiA(ofs.szPathName, buff) == 0 || strncmp(ofs.szPathName, filled_0xA5, OFS_MAXPATHNAME) == 0,
@@ -3826,7 +3825,6 @@ static void test_OpenFile(void)
         ok( hFile == HFILE_ERROR, "hFile != HFILE_ERROR : %ld\n", GetLastError());
         ok( GetLastError() == ERROR_INVALID_DATA || GetLastError() == ERROR_FILENAME_EXCED_RANGE, 
             "GetLastError() returns %ld\n", GetLastError() );
-        todo_wine
         ok( ofs.cBytes == 0xA5, "OpenFile set ofs.cBytes to %d\n", ofs.cBytes );
         ok( ofs.nErrCode == ERROR_INVALID_DATA || ofs.nErrCode == ERROR_FILENAME_EXCED_RANGE,
             "OpenFile set ofs.nErrCode to %d\n", ofs.nErrCode );
