From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 09:02:06 -0400
Subject: [PATCH] wineps.drv: print the backs of a manual duplex job the way
 the stack goes back in.

On Windows the stack of printed sheets comes out of the bin printed side down
and goes back into the tray just as it came out, moved and not turned.  The
second side was written for a stack turned over about its long edge instead,
so with the stack put back the Windows way every back came out upside down
against its front, and on more than one sheet on the wrong sheet as well.

The sheet printed last is on top and is picked up first, so the backs now go
last page first: the job ticket asks CUPS for outputorder=reverse.  With an
odd number of pages that top sheet has no back; CUPS' page-set filter makes
the "even" half up with a blank page, and the reversal puts it first, where
it carries that sheet through.

The edge that left the printer first goes back in last, so a back printed as
it is lines up with its front for binding on the short edge.  Binding on the
long edge is the case that turns the content now, not the short one.

The prompt shown for a printer with no manual feeder says the same thing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 6cda833d484a3bfb7c02a2aa4ace86eff235aea3)

diff --git a/dlls/wineps.drv/printproc.c b/dlls/wineps.drv/printproc.c
index 426c80e0161..c9a6f66b724 100644
--- a/dlls/wineps.drv/printproc.c
+++ b/dlls/wineps.drv/printproc.c
@@ -3028,7 +3028,7 @@ static INPUTSLOT *find_manual_slot(PPD *ppd)
  * both passes send exactly the same pages, and only the job ticket differs, so
  * nothing in the rendering path has to know about it. */
 static BOOL print_pass(struct pp_data *data, WCHAR *doc_name, const char *page_set,
-                       BOOL manual_feed, BOOL upside_down)
+                       BOOL reverse, BOOL manual_feed, BOOL upside_down)
 {
     DEVMODEW *dm = &data->ctx->Devmode->dmPublic;
     DWORD saved_source = dm->dmDefaultSource;
@@ -3046,6 +3046,7 @@ static BOOL print_pass(struct pp_data *data, WCHAR *doc_name, const char *page_s
         return FALSE;
 
     data->ctx->job.page_set = page_set;
+    data->ctx->job.reverse = reverse;
     data->ctx->job.upside_down = upside_down;
 
     /* The second side goes through the manual feeder.  That is what makes the
@@ -3194,6 +3195,7 @@ cleanup:
     ClosePrinter(spool_data);
     pass_ret = EndDocPrinter(data->hport) && ret;
     data->ctx->job.page_set = NULL;
+    data->ctx->job.reverse = FALSE;
     data->ctx->job.upside_down = FALSE;
     dm->dmDefaultSource = saved_source;
     dm->dmFields = saved_fields;
@@ -3203,8 +3205,8 @@ cleanup:
 /* Duplex on a printer that cannot do it by itself.
  *
  * Windows printers that lack a duplexer are still offered "print on both sides
- * (manually)": one side is printed, the stack goes back in the tray the other
- * way up, and a prompt waits for the person to say it is ready.  Here the PPD
+ * (manually)": one side is printed, the stack goes back in the tray as it came
+ * out, and a prompt waits for the person to say it is ready.  Here the PPD
  * has no *Duplex at all, so a request for it would otherwise be dropped on the
  * floor -- DeviceCapabilities says the printer cannot, applications stop
  * offering it, and there is no way to print both sides at all.
@@ -3230,8 +3232,8 @@ static BOOL ask_to_reinsert_paper(void)
 
     if (!LoadStringW(PSDRV_hInstance, IDS_MANUAL_DUPLEX_TEXT, text, ARRAY_SIZE(text)))
         lstrcpyW(text, L"The first side has been printed.\n\n"
-                       L"Put the printed sheets back in the tray with the other side "
-                       L"up, then continue.");
+                       L"Put the printed sheets back in the tray just as they came out, "
+                       L"without turning them over or round, then continue.");
     if (!LoadStringW(PSDRV_hInstance, IDS_MANUAL_DUPLEX_CAPTION, caption, ARRAY_SIZE(caption)))
         lstrcpyW(caption, L"Manual duplex");
 
@@ -3267,19 +3269,27 @@ BOOL WINAPI PrintDocumentOnPrintProcessor(HANDLE pp, WCHAR *doc_name)
     GdiDeleteSpoolFileHandle(spool_data);
 
     if (!manual_duplex_wanted(data))
-        return print_pass(data, doc_name, NULL, FALSE, FALSE);
+        return print_pass(data, doc_name, NULL, FALSE, FALSE, FALSE);
 
     manual_feeder = find_manual_slot(data->ctx->pi->ppd) != NULL;
-    /* The stack comes out of the bin printed side down and goes back in turned
-     * over about its long edge, so the backs already line up for binding on
-     * that edge.  Binding on the short one is the case that needs the content
-     * turned instead. */
-    upside_down = data->ctx->Devmode->dmPublic.dmDuplex == DMDUP_HORIZONTAL;
-    TRACE("manual duplex: odd pages first, second side %s%s\n",
+    /* The stack comes out of the bin printed side down and goes back into the
+     * tray just as it came out, moved and not turned -- the way it is done on
+     * Windows, where nothing else is asked of the person at the printer.
+     *
+     * So the sheet printed last is on top and is picked up first, and the
+     * backs go last page first.  With an odd number of pages that sheet has
+     * no back: CUPS' page-set filter makes the "even" half up with a blank
+     * page, which the reversal puts first.
+     *
+     * And the edge that left the printer first goes back in last, so a back
+     * printed as it is lines up with its front for binding on the short edge.
+     * Binding on the long edge is the case that needs the content turned. */
+    upside_down = data->ctx->Devmode->dmPublic.dmDuplex == DMDUP_VERTICAL;
+    TRACE("manual duplex: odd pages first, then the backs last page first %s%s\n",
           manual_feeder ? "through the manual feeder" : "after a prompt",
-          upside_down ? ", turned for short-edge binding" : "");
+          upside_down ? ", turned for long-edge binding" : "");
 
-    if (!print_pass(data, doc_name, "odd", FALSE, FALSE))
+    if (!print_pass(data, doc_name, "odd", FALSE, FALSE, FALSE))
         return FALSE;
 
     /* With a manual feeder both jobs go out together: the printer prints the
@@ -3292,7 +3302,7 @@ BOOL WINAPI PrintDocumentOnPrintProcessor(HANDLE pp, WCHAR *doc_name)
         return TRUE;   /* the first side did print */
     }
 
-    return print_pass(data, doc_name, "even", manual_feeder, upside_down);
+    return print_pass(data, doc_name, "even", TRUE, manual_feeder, upside_down);
 }
 BOOL WINAPI ControlPrintProcessor(HANDLE pp, DWORD cmd)
 {
diff --git a/dlls/wineps.drv/ps.c b/dlls/wineps.drv/ps.c
index 64e3598f996..527fe63d8b4 100644
--- a/dlls/wineps.drv/ps.c
+++ b/dlls/wineps.drv/ps.c
@@ -51,6 +51,7 @@ static const char cups_collate_false[] = "%cupsJobTicket: collate=false\n";
 static const char cups_collate_true[] = "%cupsJobTicket: collate=true\n";
 static const char cups_ap_d_inputslot[] = "%cupsJobTicket: AP_D_InputSlot=\n"; /* intentionally empty value */
 static const char cups_page_set[] = "%cupsJobTicket: page-set=";
+static const char cups_output_order_reverse[] = "%cupsJobTicket: outputorder=reverse\n";
 
 static const char psheader[] = /* title */
 "%%%%Creator: Wine PostScript Driver\n"
@@ -402,6 +403,12 @@ static void write_cups_job_ticket( print_ctx *ctx, const struct ticket_info *inf
             write_spool( ctx, buf, len );
     }
 
+    /* CUPS reverses after selecting the half, so the blank page its page-set
+     * filter adds to an odd-length "even" half comes first -- which is the
+     * sheet on top of the stack, the one with no back to print. */
+    if (ctx->job.reverse)
+        write_spool( ctx, cups_output_order_reverse, sizeof(cups_output_order_reverse) - 1 );
+
     /* The tray only reaches a PostScript printer through the PPD's invocation
      * string, which means nothing to a queue that rasterizes the job instead --
      * and every CUPS queue for a non-PostScript printer does.  Name it in the
@@ -572,9 +579,9 @@ INT PSDRV_WriteNewPage( print_ctx *ctx )
 
     sprintf(name, "%d", ctx->job.PageNo);
 
-    /* Turning the whole sheet over, before anything is placed on it, keeps
-     * short-edge duplex out of the rest of the drawing code: every coordinate
-     * downstream is still the one the application asked for. */
+    /* Turning the whole sheet round, before anything is placed on it, keeps
+     * the backs of a manual duplex job out of the rest of the drawing code:
+     * every coordinate downstream is still the one the application asked for. */
     turn[0] = 0;
     if (ctx->job.upside_down)
     {
diff --git a/dlls/wineps.drv/psdrv.h b/dlls/wineps.drv/psdrv.h
index 81afc4e41af..99e31050c5e 100644
--- a/dlls/wineps.drv/psdrv.h
+++ b/dlls/wineps.drv/psdrv.h
@@ -341,10 +341,13 @@ typedef struct {
      * selecting, so both passes send the same pages and only the ticket
      * differs. */
     const char          *page_set;
-    /* Set on the pass that prints the backs of the sheets when the two sides
-     * are to be bound on the short edge.  The stack can only go back into the
-     * tray turned about its long edge, so the content is what has to be turned
-     * for the short one. */
+    /* Set on the pass that prints the backs of the sheets, which goes last
+     * page first: the stack goes back into the tray as it came out of the bin,
+     * so the sheet printed last is picked up first. */
+    BOOL                reverse;
+    /* Set on the pass that prints the backs when the two sides are to be bound
+     * on the long edge.  The edge that left the printer first goes back in
+     * last, so an unturned back lines up with its front for the short edge. */
     BOOL                upside_down;
 } JOB;
 
diff --git a/dlls/wineps.drv/wineps.rc b/dlls/wineps.drv/wineps.rc
index f2940a7618c..92f523653bb 100644
--- a/dlls/wineps.drv/wineps.rc
+++ b/dlls/wineps.drv/wineps.rc
@@ -72,7 +72,7 @@ STRINGTABLE
  IDS_COLOR "Color"
  IDS_MONOCHROME "Black and White"
  IDS_MANUAL_DUPLEX_CAPTION "Manual duplex"
- IDS_MANUAL_DUPLEX_TEXT "The first side has been printed.\n\nPut the printed sheets back in the tray with the other side up, then continue."
+ IDS_MANUAL_DUPLEX_TEXT "The first side has been printed.\n\nPut the printed sheets back in the tray just as they came out, without turning them over or round, then continue."
  IDS_DUPLEX_NONE "#msgctxt#duplex#None"
  IDS_DUPLEX_MANUAL_LONG "Flip on long edge"
  IDS_DUPLEX_MANUAL_SHORT "Flip on short edge"
diff --git a/po/zh_CN.po b/po/zh_CN.po
index d02bf61be30..d2bf41bfc3b 100644
--- a/po/zh_CN.po
+++ b/po/zh_CN.po
@@ -20563,9 +20563,9 @@ msgstr "手动双面打印"
 msgid ""
 "The first side has been printed.\n"
 "\n"
-"Put the printed sheets back in the tray with the other side up, then "
-"continue."
+"Put the printed sheets back in the tray just as they came out, without "
+"turning them over or round, then continue."
 msgstr ""
 "第一面已打印完毕。\n"
 "\n"
-"请将打印好的纸张翻面放回纸盒，然后继续。"
+"请把打印好的纸按出纸时的样子原样平移放回纸盒，不要翻面，也不要调转方向，然后继续。"
