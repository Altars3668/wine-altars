From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 26 Sep 2026 16:44:15 -0400
Subject: [PATCH] dcomp: free a visual after removing all interaction sources

Co-Authored-By: Claude Code <noreply@anthropic.com>
(cherry picked from commit fb62cc5166e196b317b18ebb76dafa03dcce9dc4)

diff --git a/dlls/dcomp/interaction.c b/dlls/dcomp/interaction.c
index ada3ad20b31..2fc6759e872 100644
--- a/dlls/dcomp/interaction.c
+++ b/dlls/dcomp/interaction.c
@@ -2447,11 +2447,21 @@ static HRESULT WINAPI sources_Remove( ICompositionInteractionSourceCollection *i
 static HRESULT WINAPI sources_RemoveAll( ICompositionInteractionSourceCollection *iface )
 {
     struct source_collection *sources = impl_from_ICompositionInteractionSourceCollection( iface );
+    unsigned int i;
 
     TRACE( "iface %p.\n", iface );
 
     compositor_lock( sources->base.compositor );
     if (sources->count && sources->tracker) ++sources->tracker->request_id;
+    for (i = 0; i < sources->count; i++)
+    {
+        ICompositionInteractionSource *item = sources->items[i];
+        struct interaction_source *source;
+
+        if (item->lpVtbl != &isource_vtbl) continue;
+        source = impl_from_ICompositionInteractionSource( item );
+        if (source->visual->interaction_source == source) source->visual->interaction_source = NULL;
+    }
     sources_release_all( sources );
     compositor_unlock( sources->base.compositor );
     return S_OK;
diff --git a/dlls/dcomp/tests/composition.c b/dlls/dcomp/tests/composition.c
index e8033224967..9cc19388510 100644
--- a/dlls/dcomp/tests/composition.c
+++ b/dlls/dcomp/tests/composition.c
@@ -1112,9 +1112,9 @@ static void test_interactions(void)
     ICompositionInteractionSourceCollection *sources;
     IVisualInteractionSourceStatics *source_statics;
     IInteractionTrackerStatics *tracker_statics;
-    IVisualInteractionSource *source, *source2;
+    IVisualInteractionSource *source, *source2, *source_after_remove;
     IInteractionSourceConfiguration *config;
-    ICompositionInteractionSource *isource;
+    ICompositionInteractionSource *isource, *isource2;
     IVisualInteractionSource2 *source2_iface;
     IVisualInteractionSource3 *source3;
     IDispatcherQueueController *queue;
@@ -1241,6 +1241,36 @@ static void test_interactions(void)
     hr = IInteractionTracker_TryUpdatePosition( tracker, (Vector3){30, 20, 0}, &id );
     ok( hr == S_OK, "got hr %#lx.\n", hr );
     ok( id == 4, "got request %d.\n", id );
+
+    /* Removing every source releases the visual's reservation even if an old source is still referenced. */
+    hr = ICompositionInteractionSourceCollection_RemoveAll( sources );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    count = -1;
+    ICompositionInteractionSourceCollection_get_Count( sources, &count );
+    ok( !count, "got count %d.\n", count );
+    source2 = NULL;
+    hr = IVisualInteractionSourceStatics_Create( source_statics, visual, &source2 );
+    ok( hr == S_OK && !!source2, "got hr %#lx, source %p.\n", hr, source2 );
+    if (source2)
+    {
+        isource2 = NULL;
+        hr = IVisualInteractionSource_QueryInterface( source2, &IID_ICompositionInteractionSource,
+                                                     (void **)&isource2 );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        if (isource2)
+        {
+            hr = ICompositionInteractionSourceCollection_Add( sources, isource2 );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = ICompositionInteractionSourceCollection_Remove( sources, isource2 );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            ICompositionInteractionSource_Release( isource2 );
+        }
+        source_after_remove = NULL;
+        hr = IVisualInteractionSourceStatics_Create( source_statics, visual, &source_after_remove );
+        ok( hr == E_INVALIDARG && !source_after_remove, "got hr %#lx, source %p.\n", hr, source_after_remove );
+        if (source_after_remove) IVisualInteractionSource_Release( source_after_remove );
+        IVisualInteractionSource_Release( source2 );
+    }
     ICompositionInteractionSource_Release( isource );
     ICompositionInteractionSourceCollection_Release( sources );
 
