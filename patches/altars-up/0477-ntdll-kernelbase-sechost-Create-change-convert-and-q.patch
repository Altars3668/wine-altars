From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:46:32 -0400
Subject: [PATCH] ntdll, kernelbase, sechost: Create, change, convert and query
 private object security as Windows 11 does.

RtlNewSecurityObjectEx gave every object a descriptor of Everyone with
all access; SetPrivateObjectSecurity(Ex) did nothing and said it had,
and RtlConvertToAutoInheritSecurityObject and RtlQuerySecurityObject
were stubs.  Now, as measured on Windows 11 (tools/startupgapsprobe
misc, misc3):

- the owner and group are the creator's, else the token's (or the
  parent's if asked for); a token is wanted even when the creator gives
  everything (ERROR_NO_TOKEN, or ERROR_INVALID_PRIMARY_GROUP when the
  creator has an owner but no group);
- the DACL and SACL are the creator's, with what the parent passes on
  when inheritance is automatic, else what the parent passes on, else
  for a DACL the token's default; an ACE a container both gets and
  passes on is split in two when its generic rights are mapped or the
  creator owner or group are replaced, as Windows splits it;
- setting keeps the object's inherited ACEs after the new explicit ones
  when inheritance is automatic and the DACL is not protected, makes an
  ACL the modification does not have a NULL one, needs a token for the
  owner only, and keeps the label unless it is set too;
- converting marks the ACEs the parent passes on as inherited, after
  the object's own, or protects the ACL that does not have them all.

The SDDL printer gets mandatory labels (ML, NR/NW/NX), the other ACE
types and object GUIDs, NO_ACCESS_CONTROL for a NULL ACL, a SACL's own
flags, and the label alone for LABEL_SECURITY_INFORMATION; the parser
reads NO_ACCESS_CONTROL as a NULL ACL and a SACL's flags as its own.
winnt.h gets the SEF_* flags.  The archive attribute test that now
passes loses its todo.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/advapi32/tests/security.c b/dlls/advapi32/tests/security.c
index ef0778e6b10..edd79bc8c3d 100644
--- a/dlls/advapi32/tests/security.c
+++ b/dlls/advapi32/tests/security.c
@@ -971,7 +971,6 @@ cleanup:
 
     rc = GetFileAttributesA(file);
     rc &= ~(FILE_ATTRIBUTE_NOT_CONTENT_INDEXED|FILE_ATTRIBUTE_COMPRESSED);
-    todo_wine
     ok(rc == (FILE_ATTRIBUTE_ARCHIVE|FILE_ATTRIBUTE_READONLY),
        "expected FILE_ATTRIBUTE_ARCHIVE|FILE_ATTRIBUTE_READONLY got %#lx\n", rc);
 
@@ -4512,6 +4511,278 @@ static void test_SetSecurityDescriptorControl (PSECURITY_DESCRIPTOR sec)
     }
 }
 
+/* what Windows 11 makes of a parent's and a creator's descriptors for a file or a directory */
+static void test_CreatePrivateObjectSecurity(void)
+{
+    static const char parent_sddl[] = "O:BAG:SYD:(A;OICI;GA;;;WD)(A;CIIO;GR;;;BU)(A;;GX;;;AU)";
+    static const char creator_sddl[] = "D:(A;;GR;;;BU)";
+    static const struct
+    {
+        BOOL parent, creator, is_container;
+        ULONG flags;
+        WORD control;
+        const char *dacl;
+    }
+    tests[] =
+    {
+        { TRUE, FALSE, FALSE, 0, 0x8004, "D:(A;;FA;;;WD)" },
+        { TRUE, FALSE, TRUE, 0, 0x8004, "D:(A;;FA;;;WD)(A;OICIIO;GA;;;WD)(A;;FR;;;BU)(A;CIIO;GR;;;BU)" },
+        { TRUE, TRUE, FALSE, 0, 0x8004, "D:(A;;FR;;;BU)" },
+        { TRUE, TRUE, FALSE, SEF_DACL_AUTO_INHERIT, 0x8404, "D:AI(A;;FR;;;BU)(A;ID;FA;;;WD)" },
+        { FALSE, TRUE, FALSE, 0, 0x8004, "D:(A;;FR;;;BU)" },
+    };
+    GENERIC_MAPPING mapping = { FILE_GENERIC_READ, FILE_GENERIC_WRITE, FILE_GENERIC_EXECUTE, FILE_ALL_ACCESS };
+    PSECURITY_DESCRIPTOR parent, creator, sd;
+    TOKEN_DEFAULT_DACL *default_dacl;
+    TOKEN_PRIMARY_GROUP *token_group;
+    TOKEN_OWNER *token_owner;
+    BOOL ret, present, defaulted;
+    SECURITY_DESCRIPTOR_CONTROL control;
+    DWORD revision, size, i;
+    PSID owner, group;
+    char buffer[1024], buffer2[1024], buffer3[1024];
+    HANDLE token;
+    char *sddl;
+    ACL *dacl;
+
+    OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token );
+    GetTokenInformation( token, TokenOwner, buffer, sizeof(buffer), &size );
+    token_owner = (TOKEN_OWNER *)buffer;
+    GetTokenInformation( token, TokenPrimaryGroup, buffer2, sizeof(buffer2), &size );
+    token_group = (TOKEN_PRIMARY_GROUP *)buffer2;
+    GetTokenInformation( token, TokenDefaultDacl, buffer3, sizeof(buffer3), &size );
+    default_dacl = (TOKEN_DEFAULT_DACL *)buffer3;
+
+    /* nothing given: the token's owner, group and default DACL, its generic rights mapped */
+    sd = NULL;
+    ret = CreatePrivateObjectSecurityEx( NULL, NULL, &sd, NULL, FALSE, 0, token, &mapping );
+    ok( ret, "got error %lu\n", GetLastError() );
+    GetSecurityDescriptorControl( sd, &control, &revision );
+    ok( control == (SE_SELF_RELATIVE | SE_DACL_PRESENT), "got control %#x\n", control );
+    GetSecurityDescriptorOwner( sd, &owner, &defaulted );
+    ok( EqualSid( owner, token_owner->Owner ), "wrong owner\n" );
+    GetSecurityDescriptorGroup( sd, &group, &defaulted );
+    ok( EqualSid( group, token_group->PrimaryGroup ), "wrong group\n" );
+    GetSecurityDescriptorDacl( sd, &present, &dacl, &defaulted );
+    ok( present && dacl, "no DACL\n" );
+    if (dacl && default_dacl->DefaultDacl)
+    {
+        ok( dacl->AceCount == default_dacl->DefaultDacl->AceCount, "got %u ACEs\n", dacl->AceCount );
+        for (i = 0; i < dacl->AceCount && i < default_dacl->DefaultDacl->AceCount; i++)
+        {
+            ACCESS_ALLOWED_ACE *ace, *expect;
+            ACCESS_MASK mask;
+
+            GetAce( dacl, i, (void **)&ace );
+            GetAce( default_dacl->DefaultDacl, i, (void **)&expect );
+            mask = expect->Mask;
+            MapGenericMask( &mask, &mapping );
+            ok( ace->Mask == mask, "ACE %lu: got mask %#lx, expected %#lx\n", i, ace->Mask, mask );
+            ok( EqualSid( &ace->SidStart, &expect->SidStart ), "ACE %lu: wrong SID\n", i );
+        }
+    }
+    ret = DestroyPrivateObjectSecurity( &sd );
+    ok( ret, "got error %lu\n", GetLastError() );
+
+    /* the thread impersonates nobody */
+    sd = NULL;
+    SetLastError( 0xdeadbeef );
+    ret = CreatePrivateObjectSecurityEx( NULL, NULL, &sd, NULL, FALSE, 0, NULL, &mapping );
+    ok( !ret, "succeeded\n" );
+    ok( GetLastError() == ERROR_NO_TOKEN, "got error %lu\n", GetLastError() );
+
+    sd = NULL;
+    ret = CreatePrivateObjectSecurityEx( NULL, NULL, &sd, NULL, TRUE, SEF_DACL_AUTO_INHERIT | SEF_SACL_AUTO_INHERIT,
+                                         token, &mapping );
+    ok( ret, "got error %lu\n", GetLastError() );
+    GetSecurityDescriptorControl( sd, &control, &revision );
+    ok( control == (SE_SELF_RELATIVE | SE_DACL_PRESENT | SE_DACL_AUTO_INHERITED | SE_SACL_AUTO_INHERITED),
+        "got control %#x\n", control );
+    DestroyPrivateObjectSecurity( &sd );
+
+    ConvertStringSecurityDescriptorToSecurityDescriptorA( parent_sddl, SDDL_REVISION_1, &parent, NULL );
+    ConvertStringSecurityDescriptorToSecurityDescriptorA( creator_sddl, SDDL_REVISION_1, &creator, NULL );
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context( "%lu", i );
+        sd = NULL;
+        ret = CreatePrivateObjectSecurityEx( tests[i].parent ? parent : NULL, tests[i].creator ? creator : NULL,
+                                             &sd, NULL, tests[i].is_container, tests[i].flags, token, &mapping );
+        ok( ret, "got error %lu\n", GetLastError() );
+        GetSecurityDescriptorControl( sd, &control, &revision );
+        ok( control == tests[i].control, "got control %#x\n", control );
+        /* the owner and group are never the parent's */
+        GetSecurityDescriptorOwner( sd, &owner, &defaulted );
+        ok( EqualSid( owner, token_owner->Owner ), "wrong owner\n" );
+        GetSecurityDescriptorGroup( sd, &group, &defaulted );
+        ok( EqualSid( group, token_group->PrimaryGroup ), "wrong group\n" );
+        ConvertSecurityDescriptorToStringSecurityDescriptorA( sd, SDDL_REVISION_1, DACL_SECURITY_INFORMATION,
+                                                              &sddl, NULL );
+        ok( !strcmp( sddl, tests[i].dacl ), "got %s\n", debugstr_a(sddl) );
+        LocalFree( sddl );
+        DestroyPrivateObjectSecurity( &sd );
+        winetest_pop_context();
+    }
+
+    sd = NULL;
+    ret = CreatePrivateObjectSecurity( NULL, creator, &sd, FALSE, token, &mapping );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ConvertSecurityDescriptorToStringSecurityDescriptorA( sd, SDDL_REVISION_1, DACL_SECURITY_INFORMATION, &sddl, NULL );
+    ok( !strcmp( sddl, "D:(A;;FR;;;BU)" ), "got %s\n", debugstr_a(sddl) );
+    LocalFree( sddl );
+    DestroyPrivateObjectSecurity( &sd );
+
+    LocalFree( parent );
+    LocalFree( creator );
+    CloseHandle( token );
+}
+
+/* how Windows 11 changes a file's private descriptor that inherited from its parent */
+static void test_SetPrivateObjectSecurity(void)
+{
+    static const struct
+    {
+        SECURITY_INFORMATION info;
+        const char *modification;
+        ULONG flags;
+        DWORD error;
+        WORD control;
+        const char *result;
+    }
+    tests[] =
+    {
+        { DACL_SECURITY_INFORMATION, "D:(A;;GR;;;BU)", 0, 0, 0x8004, "D:(A;;FR;;;BU)" },
+        { DACL_SECURITY_INFORMATION, "D:(A;;GR;;;BU)", SEF_DACL_AUTO_INHERIT, 0, 0x8404, "D:AI(A;;FR;;;BU)(A;ID;FA;;;WD)" },
+        { DACL_SECURITY_INFORMATION, "D:P(A;;GR;;;BU)", SEF_DACL_AUTO_INHERIT, 0, 0x9404, "D:PAI(A;;FR;;;BU)" },
+        { DACL_SECURITY_INFORMATION, "D:(A;;GR;;;BU)(A;ID;GX;;;AU)", SEF_DACL_AUTO_INHERIT, 0, 0x8404,
+          "D:AI(A;;FR;;;BU)(A;ID;FA;;;WD)" },
+        { DACL_SECURITY_INFORMATION, "D:(A;;GR;;;BU)(A;ID;GX;;;AU)", 0, 0, 0x8004, "D:(A;;FR;;;BU)(A;ID;FX;;;AU)" },
+        { DACL_SECURITY_INFORMATION, "O:BA", 0, 0, 0x8004, "D:NO_ACCESS_CONTROL" },
+        { DACL_SECURITY_INFORMATION, "D:NO_ACCESS_CONTROL", 0, 0, 0x8004, "D:NO_ACCESS_CONTROL" },
+        { DACL_SECURITY_INFORMATION, "D:", SEF_DACL_AUTO_INHERIT, 0, 0x8404, "D:AI(A;ID;FA;;;WD)" },
+        { DACL_SECURITY_INFORMATION, "D:(A;OICI;GR;;;BU)(A;OICIIO;GW;;;CO)", SEF_DACL_AUTO_INHERIT, 0, 0x8404,
+          "D:AI(A;;FR;;;BU)(A;OICIIO;GR;;;BU)(A;OICIIO;GW;;;CO)(A;ID;FA;;;WD)" },
+        { DACL_SECURITY_INFORMATION, "D:(A;;GR;;;BU)", 0x80000000, 0, 0x8004, "D:(A;;FR;;;BU)" },
+        { OWNER_SECURITY_INFORMATION, "O:SY", 0, 0, 0x8404, "O:SY" },
+        { OWNER_SECURITY_INFORMATION, "D:(A;;GR;;;BU)", 0, ERROR_INVALID_OWNER },
+        { GROUP_SECURITY_INFORMATION, "G:SY", 0, 0, 0x8404, "G:SY" },
+        { GROUP_SECURITY_INFORMATION, "D:(A;;GR;;;BU)", 0, ERROR_INVALID_PRIMARY_GROUP },
+        { SACL_SECURITY_INFORMATION, "S:(AU;SA;GA;;;WD)", 0, 0, 0x8414, "S:(AU;SA;FA;;;WD)" },
+        { LABEL_SECURITY_INFORMATION, "S:(ML;;NW;;;LW)", 0, 0, 0x8414, "S:(ML;;NW;;;LW)" },
+        { SACL_SECURITY_INFORMATION | LABEL_SECURITY_INFORMATION, "S:(AU;SA;GA;;;WD)(ML;;NW;;;LW)", 0, 0, 0x8414,
+          "S:(AU;SA;FA;;;WD)(ML;;NW;;;LW)" },
+        { 0, "D:(A;;GR;;;BU)", 0, 0, 0x8404, "D:AI(A;ID;FA;;;WD)" },
+    };
+    GENERIC_MAPPING mapping = { FILE_GENERIC_READ, FILE_GENERIC_WRITE, FILE_GENERIC_EXECUTE, FILE_ALL_ACCESS };
+    PSECURITY_DESCRIPTOR parent, current, modification, sd, before;
+    SECURITY_DESCRIPTOR_CONTROL control;
+    SECURITY_INFORMATION shown;
+    DWORD revision, i;
+    HANDLE token;
+    char *sddl;
+    BOOL ret;
+
+    OpenProcessToken( GetCurrentProcess(), TOKEN_QUERY, &token );
+    ConvertStringSecurityDescriptorToSecurityDescriptorA( "O:BAG:SYD:(A;OICI;GA;;;WD)", SDDL_REVISION_1, &parent, NULL );
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context( "%lu", i );
+        sd = NULL;
+        CreatePrivateObjectSecurityEx( parent, NULL, &sd, NULL, FALSE, SEF_DACL_AUTO_INHERIT, token, &mapping );
+        ConvertStringSecurityDescriptorToSecurityDescriptorA( tests[i].modification, SDDL_REVISION_1, &modification,
+                                                              NULL );
+        before = sd;
+        SetLastError( 0xdeadbeef );
+        ret = SetPrivateObjectSecurityEx( tests[i].info, modification, &sd, tests[i].flags, &mapping, token );
+        if (tests[i].error)
+        {
+            ok( !ret, "succeeded\n" );
+            ok( GetLastError() == tests[i].error, "got error %lu\n", GetLastError() );
+            ok( sd == before, "descriptor replaced\n" );
+        }
+        else
+        {
+            ok( ret, "got error %lu\n", GetLastError() );
+            ok( sd != before, "descriptor kept\n" );
+            GetSecurityDescriptorControl( sd, &control, &revision );
+            ok( control == tests[i].control, "got control %#x\n", control );
+            if (tests[i].info & OWNER_SECURITY_INFORMATION) shown = OWNER_SECURITY_INFORMATION;
+            else if (tests[i].info & GROUP_SECURITY_INFORMATION) shown = GROUP_SECURITY_INFORMATION;
+            else if (tests[i].info & (SACL_SECURITY_INFORMATION | LABEL_SECURITY_INFORMATION))
+                shown = SACL_SECURITY_INFORMATION;
+            else shown = DACL_SECURITY_INFORMATION;
+            ConvertSecurityDescriptorToStringSecurityDescriptorA( sd, SDDL_REVISION_1, shown, &sddl, NULL );
+            ok( !strcmp( sddl, tests[i].result ), "got %s\n", debugstr_a(sddl) );
+            LocalFree( sddl );
+        }
+        DestroyPrivateObjectSecurity( &sd );
+        LocalFree( modification );
+        winetest_pop_context();
+    }
+
+    /* the owner needs a token, the DACL does not */
+    ConvertStringSecurityDescriptorToSecurityDescriptorA( "O:SYD:(A;;GR;;;BU)", SDDL_REVISION_1, &modification, NULL );
+    sd = NULL;
+    CreatePrivateObjectSecurityEx( parent, NULL, &sd, NULL, FALSE, SEF_DACL_AUTO_INHERIT, token, &mapping );
+    SetLastError( 0xdeadbeef );
+    ret = SetPrivateObjectSecurityEx( OWNER_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION, modification, &sd, 0,
+                                      &mapping, NULL );
+    ok( !ret, "succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_OWNER, "got error %lu\n", GetLastError() );
+    ret = SetPrivateObjectSecurity( DACL_SECURITY_INFORMATION, modification, &sd, &mapping, NULL );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ConvertSecurityDescriptorToStringSecurityDescriptorA( sd, SDDL_REVISION_1, DACL_SECURITY_INFORMATION, &sddl, NULL );
+    ok( !strcmp( sddl, "D:(A;;FR;;;BU)" ), "got %s\n", debugstr_a(sddl) );
+    LocalFree( sddl );
+    DestroyPrivateObjectSecurity( &sd );
+    LocalFree( modification );
+
+    /* the ACEs the parent passes on become inherited ones, after the object's own */
+    ConvertStringSecurityDescriptorToSecurityDescriptorA( "O:BAG:SYD:(A;;FA;;;WD)(A;;FR;;;BU)", SDDL_REVISION_1,
+                                                          &current, NULL );
+    sd = NULL;
+    ret = ConvertToAutoInheritPrivateObjectSecurity( parent, current, &sd, NULL, FALSE, &mapping );
+    ok( ret, "got error %lu\n", GetLastError() );
+    GetSecurityDescriptorControl( sd, &control, &revision );
+    ok( control == 0x8c04, "got control %#x\n", control );
+    ConvertSecurityDescriptorToStringSecurityDescriptorA( sd, SDDL_REVISION_1,
+            OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION | DACL_SECURITY_INFORMATION, &sddl, NULL );
+    ok( !strcmp( sddl, "O:BAG:SYD:AI(A;;FR;;;BU)(A;ID;FA;;;WD)" ), "got %s\n", debugstr_a(sddl) );
+    LocalFree( sddl );
+    DestroyPrivateObjectSecurity( &sd );
+    LocalFree( current );
+    ConvertStringSecurityDescriptorToSecurityDescriptorA( "O:BAG:SYD:(A;;FA;;;WD)(A;OICIIO;GA;;;WD)(A;;FR;;;BU)",
+                                                          SDDL_REVISION_1, &current, NULL );
+    sd = NULL;
+    ret = ConvertToAutoInheritPrivateObjectSecurity( parent, current, &sd, NULL, TRUE, &mapping );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ConvertSecurityDescriptorToStringSecurityDescriptorA( sd, SDDL_REVISION_1, DACL_SECURITY_INFORMATION, &sddl, NULL );
+    ok( !strcmp( sddl, "D:AI(A;;FR;;;BU)(A;ID;FA;;;WD)(A;OICIIOID;GA;;;WD)" ), "got %s\n", debugstr_a(sddl) );
+    LocalFree( sddl );
+    DestroyPrivateObjectSecurity( &sd );
+    LocalFree( current );
+
+    /* a creator's descriptor that has everything still wants a token */
+    ConvertStringSecurityDescriptorToSecurityDescriptorA( "O:BAG:SYD:(A;;GA;;;WD)", SDDL_REVISION_1, &modification,
+                                                          NULL );
+    sd = NULL;
+    SetLastError( 0xdeadbeef );
+    ret = CreatePrivateObjectSecurityEx( NULL, modification, &sd, NULL, FALSE, 0, NULL, &mapping );
+    ok( !ret, "succeeded\n" );
+    ok( GetLastError() == ERROR_NO_TOKEN, "got error %lu\n", GetLastError() );
+    LocalFree( modification );
+    ConvertStringSecurityDescriptorToSecurityDescriptorA( "O:BAD:(A;;GA;;;WD)", SDDL_REVISION_1, &modification, NULL );
+    SetLastError( 0xdeadbeef );
+    ret = CreatePrivateObjectSecurityEx( NULL, modification, &sd, NULL, FALSE, 0, NULL, &mapping );
+    ok( !ret, "succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_PRIMARY_GROUP, "got error %lu\n", GetLastError() );
+    LocalFree( modification );
+
+    LocalFree( parent );
+    CloseHandle( token );
+}
+
 static void test_PrivateObjectSecurity(void)
 {
     SECURITY_INFORMATION sec_info = OWNER_SECURITY_INFORMATION|GROUP_SECURITY_INFORMATION|DACL_SECURITY_INFORMATION|SACL_SECURITY_INFORMATION;
@@ -8972,6 +9243,8 @@ START_TEST(security)
     test_ConvertStringSecurityDescriptor();
     test_ConvertSecurityDescriptorToString();
     test_PrivateObjectSecurity();
+    test_CreatePrivateObjectSecurity();
+    test_SetPrivateObjectSecurity();
     test_InitializeAcl();
     test_GetWindowsAccountDomainSid();
     test_EqualDomainSid();
