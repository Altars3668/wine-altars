+
+static const SID creator_owner_sid = { SID_REVISION, 1, { SECURITY_CREATOR_SID_AUTHORITY }, { SECURITY_CREATOR_OWNER_RID } };
+static const SID creator_group_sid = { SID_REVISION, 1, { SECURITY_CREATOR_SID_AUTHORITY }, { SECURITY_CREATOR_GROUP_RID } };
+
+static void *acl_builder_add( struct acl_builder *b, SIZE_T size )
+{
+    void *ret;
+
+    if (b->status) return NULL;
+    if (sizeof(ACL) + b->size + size > 0xffff)
+    {
+        b->status = STATUS_BUFFER_OVERFLOW;
+        return NULL;
+    }
+    if (b->size + size > b->alloc)
+    {
+        SIZE_T alloc = max( b->alloc * 2, b->size + size );
+        BYTE *aces = b->aces ? RtlReAllocateHeap( GetProcessHeap(), 0, b->aces, alloc )
+                             : RtlAllocateHeap( GetProcessHeap(), 0, alloc );
+        if (!aces)
+        {
+            b->status = STATUS_NO_MEMORY;
+            return NULL;
+        }
+        b->aces = aces;
+        b->alloc = alloc;
+    }
+    ret = b->aces + b->size;
+    b->size += size;
+    b->count++;
+    return ret;
+}
+
+/* where the SID of an ACE is, for the types that have their mask after the header and a SID after that */
+static SID *ace_sid( const ACE_HEADER *ace )
+{
+    const BYTE *body = (const BYTE *)ace + sizeof(ACE_HEADER) + sizeof(ACCESS_MASK);
+
+    switch (ace->AceType)
+    {
+    case ACCESS_ALLOWED_ACE_TYPE:
+    case ACCESS_DENIED_ACE_TYPE:
+    case SYSTEM_AUDIT_ACE_TYPE:
+    case SYSTEM_ALARM_ACE_TYPE:
+    case ACCESS_ALLOWED_CALLBACK_ACE_TYPE:
+    case ACCESS_DENIED_CALLBACK_ACE_TYPE:
+    case SYSTEM_AUDIT_CALLBACK_ACE_TYPE:
+    case SYSTEM_ALARM_CALLBACK_ACE_TYPE:
+    case SYSTEM_MANDATORY_LABEL_ACE_TYPE:
+    case SYSTEM_RESOURCE_ATTRIBUTE_ACE_TYPE:
+    case SYSTEM_SCOPED_POLICY_ID_ACE_TYPE:
+    case SYSTEM_PROCESS_TRUST_LABEL_ACE_TYPE:
+        return (SID *)body;
+    case ACCESS_ALLOWED_OBJECT_ACE_TYPE:
+    case ACCESS_DENIED_OBJECT_ACE_TYPE:
+    case ACCESS_AUDIT_OBJECT_ACE_TYPE:
+    case ACCESS_ALARM_OBJECT_ACE_TYPE:
+    case ACCESS_ALLOWED_CALLBACK_OBJECT_ACE_TYPE:
+    case ACCESS_DENIED_CALLBACK_OBJECT_ACE_TYPE:
+    case SYSTEM_AUDIT_CALLBACK_OBJECT_ACE_TYPE:
+    case SYSTEM_ALARM_CALLBACK_OBJECT_ACE_TYPE:
+    {
+        DWORD flags = *(const DWORD *)body;
+
+        body += sizeof(DWORD);
+        if (flags & ACE_OBJECT_TYPE_PRESENT) body += sizeof(GUID);
+        if (flags & ACE_INHERITED_OBJECT_TYPE_PRESENT) body += sizeof(GUID);
+        return (SID *)body;
+    }
+    default:
+        return NULL;
+    }
+}
+
+/* whether an ACE limits its inheritance to objects of a type, and the object is not one of them */
+static BOOL ace_skips_types( const ACE_HEADER *ace, GUID **types, ULONG count )
+{
+    const ACCESS_ALLOWED_OBJECT_ACE *object = (const ACCESS_ALLOWED_OBJECT_ACE *)ace;
+    const GUID *type;
+    ULONG i;
+
+    switch (ace->AceType)
+    {
+    case ACCESS_ALLOWED_OBJECT_ACE_TYPE:
+    case ACCESS_DENIED_OBJECT_ACE_TYPE:
+    case ACCESS_AUDIT_OBJECT_ACE_TYPE:
+    case ACCESS_ALARM_OBJECT_ACE_TYPE:
+    case ACCESS_ALLOWED_CALLBACK_OBJECT_ACE_TYPE:
+    case ACCESS_DENIED_CALLBACK_OBJECT_ACE_TYPE:
+    case SYSTEM_AUDIT_CALLBACK_OBJECT_ACE_TYPE:
+    case SYSTEM_ALARM_CALLBACK_OBJECT_ACE_TYPE:
+        break;
+    default:
+        return FALSE;
+    }
+    if (!(object->Flags & ACE_INHERITED_OBJECT_TYPE_PRESENT)) return FALSE;
+    type = (object->Flags & ACE_OBJECT_TYPE_PRESENT) ? &object->InheritedObjectType : &object->ObjectType;
+    for (i = 0; i < count; i++) if (types[i] && IsEqualGUID( types[i], type )) return FALSE;
+    return TRUE;
+}
+
+/* whether the copy of an ACE that applies to an object differs from the one passed on: generic rights to map,
+ * or the creator owner or group to replace */
+static BOOL ace_needs_mapping( const ACE_HEADER *ace )
+{
+    SID *sid = ace_sid( ace );
+
+    if (!sid || ace->AceType == SYSTEM_MANDATORY_LABEL_ACE_TYPE) return FALSE;
+    if (*(const ACCESS_MASK *)(ace + 1) & (GENERIC_READ | GENERIC_WRITE | GENERIC_EXECUTE | GENERIC_ALL)) return TRUE;
+    return RtlEqualSid( sid, (PSID)&creator_owner_sid ) || RtlEqualSid( sid, (PSID)&creator_group_sid );
+}
+
+/* add a copy of an ACE with other flags, mapped for the object it applies to if a mapping is given: generic
+ * rights mapped, and the creator owner and group replaced by the object's owner and group */
+static void add_ace( struct acl_builder *b, const ACE_HEADER *ace, BYTE flags, const GENERIC_MAPPING *mapping,
+                     PSID owner, PSID group )
+{
+    SID *sid = ace_sid( ace );
+    PSID new_sid = NULL;
+    SIZE_T prefix = 0, old_len = 0, new_len = 0, size;
+    BYTE *ret;
+
+    if (mapping && sid)
+    {
+        if (owner && RtlEqualSid( sid, (PSID)&creator_owner_sid )) new_sid = owner;
+        else if (group && RtlEqualSid( sid, (PSID)&creator_group_sid )) new_sid = group;
+    }
+    if (new_sid)
+    {
+        prefix = (BYTE *)sid - (BYTE *)ace;
+        old_len = RtlLengthSid( sid );
+        new_len = RtlLengthSid( new_sid );
+    }
+    size = ace->AceSize - old_len + new_len;
+    if (!(ret = acl_builder_add( b, size ))) return;
+    if (new_sid)
+    {
+        memcpy( ret, ace, prefix );
+        memcpy( ret + prefix, new_sid, new_len );
+        memcpy( ret + prefix + new_len, (BYTE *)sid + old_len, ace->AceSize - prefix - old_len );
+    }
+    else memcpy( ret, ace, ace->AceSize );
+    ((ACE_HEADER *)ret)->AceFlags = flags;
+    ((ACE_HEADER *)ret)->AceSize = size;
+    if (mapping && sid && ace->AceType != SYSTEM_MANDATORY_LABEL_ACE_TYPE)
+        RtlMapGenericMask( (ACCESS_MASK *)(ret + sizeof(ACE_HEADER)), mapping );
+}
+
+#define INHERITANCE_FLAGS (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE | NO_PROPAGATE_INHERIT_ACE | INHERIT_ONLY_ACE)
+
+/* add the ACEs an object inherits from those of its parent: an object an ACE is inherited by gets it as it applies
+ * to the object, and a container also gets it to pass on, in one ACE if the two are the same */
+static void inherit_aces( struct acl_builder *b, const ACL *parent, BOOL is_container, BOOL auto_inherit,
+                          GUID **types, ULONG count, const GENERIC_MAPPING *mapping, PSID owner, PSID group )
+{
+    const ACE_HEADER *ace = (const ACE_HEADER *)(parent + 1);
+    BYTE inherited = auto_inherit ? INHERITED_ACE : 0;
+    WORD i;
+
+    b->revision = max( b->revision, parent->AclRevision );
+    for (i = 0; i < parent->AceCount; i++, ace = (const ACE_HEADER *)((const BYTE *)ace + ace->AceSize))
+    {
+        BYTE flags = ace->AceFlags & (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE);
+        BOOL applies, passes_on;
+
+        if (!flags) continue;
+        if (is_container)
+        {
+            applies = (ace->AceFlags & CONTAINER_INHERIT_ACE) && !ace_skips_types( ace, types, count );
+            passes_on = !(ace->AceFlags & NO_PROPAGATE_INHERIT_ACE);
+        }
+        else
+        {
+            applies = (ace->AceFlags & OBJECT_INHERIT_ACE) && !ace_skips_types( ace, types, count );
+            passes_on = FALSE;
+        }
+        if (applies && passes_on && !ace_needs_mapping( ace ))
+            add_ace( b, ace, flags | inherited, NULL, NULL, NULL );
+        else
+        {
+            if (applies) add_ace( b, ace, inherited, mapping, owner, group );
+            if (passes_on) add_ace( b, ace, flags | INHERIT_ONLY_ACE | inherited, NULL, NULL, NULL );
+        }
+    }
+}
+
+/* add the ACEs an object was given; one that applies to it is mapped, and kept to pass on as it was if the
+ * object is a container */
+static void add_explicit_aces( struct acl_builder *b, const ACL *acl, BOOL is_container, BOOL auto_inherit,
+                               const GENERIC_MAPPING *mapping, PSID owner, PSID group )
+{
+    const ACE_HEADER *ace = (const ACE_HEADER *)(acl + 1);
+    WORD i;
+
+    b->revision = max( b->revision, acl->AclRevision );
+    for (i = 0; i < acl->AceCount; i++, ace = (const ACE_HEADER *)((const BYTE *)ace + ace->AceSize))
+    {
+        /* inherited ones are inherited again */
+        if (auto_inherit && (ace->AceFlags & INHERITED_ACE)) continue;
+        if (ace->AceFlags & INHERIT_ONLY_ACE)
+            add_ace( b, ace, ace->AceFlags, NULL, NULL, NULL );
+        else if (is_container && (ace->AceFlags & (OBJECT_INHERIT_ACE | CONTAINER_INHERIT_ACE)) &&
+                 !(ace->AceFlags & NO_PROPAGATE_INHERIT_ACE) && ace_needs_mapping( ace ))
+        {
+            add_ace( b, ace, ace->AceFlags & ~INHERITANCE_FLAGS, mapping, owner, group );
+            add_ace( b, ace, ace->AceFlags | INHERIT_ONLY_ACE, NULL, NULL, NULL );
+        }
+        else add_ace( b, ace, ace->AceFlags, mapping, owner, group );
+    }
+}
+
+/* the ACL put together, in memory of its own */
+static ACL *acl_builder_finish( struct acl_builder *b )
+{
+    ACL *acl;
+
+    if (b->status) return NULL;
+    if (!(acl = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(ACL) + b->size )))
+    {
+        b->status = STATUS_NO_MEMORY;
+        return NULL;
+    }
+    acl->AclRevision = max( b->revision, ACL_REVISION );
+    acl->Sbz1 = 0;
+    acl->AclSize = sizeof(ACL) + b->size;
+    acl->AceCount = b->count;
+    acl->Sbz2 = 0;
+    if (b->size) memcpy( acl + 1, b->aces, b->size );
+    return acl;
+}
+
+static void acl_builder_free( struct acl_builder *b )
+{
+    RtlFreeHeap( GetProcessHeap(), 0, b->aces );
+}
+
+/* a piece of information from a token, in memory of its own */
+static void *query_token( HANDLE token, TOKEN_INFORMATION_CLASS class, NTSTATUS *status )
+{
+    ULONG size = 0;
+    void *ret;
+
+    *status = NtQueryInformationToken( token, class, NULL, 0, &size );
+    if (*status != STATUS_BUFFER_TOO_SMALL) return NULL;
+    if (!(ret = RtlAllocateHeap( GetProcessHeap(), 0, size )))
+    {
+        *status = STATUS_NO_MEMORY;
+        return NULL;
+    }
+    if ((*status = NtQueryInformationToken( token, class, ret, size, &size )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, ret );
+        return NULL;
+    }
+    return ret;
+}
+
+/* the token a security object is made for: the one given, or the one the thread impersonates */
+static NTSTATUS open_object_token( HANDLE *token, HANDLE given )
+{
+    if ((*token = given)) return STATUS_SUCCESS;
+    return NtOpenThreadToken( GetCurrentThread(), TOKEN_QUERY, TRUE, token );
+}
+
+/* the parts of a security descriptor, wherever they are kept */
+static void get_sd_parts( PSECURITY_DESCRIPTOR sd, PSID *owner, PSID *group, ACL **dacl, BOOLEAN *dacl_present,
+                          ACL **sacl, BOOLEAN *sacl_present, SECURITY_DESCRIPTOR_CONTROL *control )
+{
+    BOOLEAN defaulted;
+    DWORD revision;
+
+    *owner = *group = NULL;
+    *dacl = *sacl = NULL;
+    *dacl_present = *sacl_present = FALSE;
+    *control = 0;
+    if (!sd) return;
+    RtlGetOwnerSecurityDescriptor( sd, owner, &defaulted );
+    RtlGetGroupSecurityDescriptor( sd, group, &defaulted );
+    RtlGetDaclSecurityDescriptor( sd, dacl_present, dacl, &defaulted );
+    RtlGetSaclSecurityDescriptor( sd, sacl_present, sacl, &defaulted );
+    RtlGetControlSecurityDescriptor( sd, control, &revision );
+}
+
+/* a self-relative descriptor of a private object in memory of its own, from its parts */
+static NTSTATUS make_object_sd( PSECURITY_DESCRIPTOR *ret, PSID owner, PSID group, BOOL dacl_present, ACL *dacl,
+                                BOOL sacl_present, ACL *sacl, SECURITY_DESCRIPTOR_CONTROL control )
+{
+    SECURITY_DESCRIPTOR absolute;
+    PSECURITY_DESCRIPTOR relative;
+    ULONG size = 0;
+    NTSTATUS status;
+
+    RtlCreateSecurityDescriptor( &absolute, SECURITY_DESCRIPTOR_REVISION );
+    RtlSetOwnerSecurityDescriptor( &absolute, owner, FALSE );
+    RtlSetGroupSecurityDescriptor( &absolute, group, FALSE );
+    if (dacl_present) RtlSetDaclSecurityDescriptor( &absolute, TRUE, dacl, FALSE );
+    if (sacl_present) RtlSetSaclSecurityDescriptor( &absolute, TRUE, sacl, FALSE );
+    absolute.Control |= control & (SE_DACL_AUTO_INHERITED | SE_SACL_AUTO_INHERITED |
+                                   SE_DACL_PROTECTED | SE_SACL_PROTECTED);
+
+    RtlMakeSelfRelativeSD( &absolute, NULL, &size );
+    if (!(relative = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return STATUS_NO_MEMORY;
+    if ((status = RtlMakeSelfRelativeSD( &absolute, relative, &size )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, relative );
+        return status;
+    }
+    *ret = relative;
+    return STATUS_SUCCESS;
+}
+
+/* the DACL or SACL of a new object: the creator's, with what the parent passes on if inheritance is automatic;
+ * else what the parent passes on; else, for a DACL, the token's default */
+static NTSTATUS new_object_acl( ACL **ret, BOOLEAN *present, SECURITY_DESCRIPTOR_CONTROL *control,
+                                const ACL *parent, BOOLEAN parent_present, const ACL *creator, BOOLEAN creator_present,
+                                SECURITY_DESCRIPTOR_CONTROL creator_control, BOOL is_dacl, BOOL is_container,
+                                BOOL auto_inherit, GUID **types, ULONG count, const GENERIC_MAPPING *mapping,
+                                PSID owner, PSID group, HANDLE token )
+{
+    SECURITY_DESCRIPTOR_CONTROL defaulted = is_dacl ? SE_DACL_DEFAULTED : SE_SACL_DEFAULTED;
+    SECURITY_DESCRIPTOR_CONTROL protected = is_dacl ? SE_DACL_PROTECTED : SE_SACL_PROTECTED;
+    struct acl_builder b = { 0 };
+    NTSTATUS status = STATUS_SUCCESS;
+
+    *ret = NULL;
+    *present = FALSE;
+    if (auto_inherit) *control |= is_dacl ? SE_DACL_AUTO_INHERITED : SE_SACL_AUTO_INHERITED;
+
+    if (parent_present && parent && (!creator_present || (creator_control & defaulted)))
+    {
+        inherit_aces( &b, parent, is_container, auto_inherit, types, count, mapping, owner, group );
+        if (b.count || b.status)
+        {
+            *present = TRUE;
+            *ret = acl_builder_finish( &b );
+            acl_builder_free( &b );
+            return b.status;
+        }
+    }
+    if (creator_present)
+    {
+        *present = TRUE;
+        /* a NULL ACL stays so */
+        if (!creator) return STATUS_SUCCESS;
+        if (creator_control & protected) *control |= protected;
+        add_explicit_aces( &b, creator, is_container, auto_inherit, mapping, owner, group );
+        if (auto_inherit && !(creator_control & protected) && parent_present && parent)
+            inherit_aces( &b, parent, is_container, auto_inherit, types, count, mapping, owner, group );
+    }
+    else if (is_dacl)
+    {
+        TOKEN_DEFAULT_DACL *dacl;
+
+        if (!(dacl = query_token( token, TokenDefaultDacl, &status ))) return status;
+        if (dacl->DefaultDacl)
+        {
+            *present = TRUE;
+            add_explicit_aces( &b, dacl->DefaultDacl, is_container, FALSE, mapping, owner, group );
+        }
+        RtlFreeHeap( GetProcessHeap(), 0, dacl );
+        if (!*present) return STATUS_SUCCESS;
+    }
+    else return STATUS_SUCCESS;
+
+    *ret = acl_builder_finish( &b );
+    acl_builder_free( &b );
+    return b.status;
+}
+
+static NTSTATUS new_security_object( PSECURITY_DESCRIPTOR parent, PSECURITY_DESCRIPTOR creator,
+                                     PSECURITY_DESCRIPTOR *descr, GUID **types, ULONG count, BOOLEAN is_container,
+                                     ULONG flags, HANDLE given_token, PGENERIC_MAPPING mapping )
+{
+    PSID parent_owner, parent_group, creator_owner, creator_group, owner, group;
+    ACL *parent_dacl, *parent_sacl, *creator_dacl, *creator_sacl, *dacl = NULL, *sacl = NULL;
+    BOOLEAN parent_dacl_present, parent_sacl_present, creator_dacl_present, creator_sacl_present;
+    BOOLEAN dacl_present, sacl_present;
+    SECURITY_DESCRIPTOR_CONTROL parent_control, creator_control, control = 0;
+    TOKEN_OWNER *token_owner = NULL;
+    TOKEN_PRIMARY_GROUP *token_group = NULL;
+    HANDLE token;
+    NTSTATUS status;
+
+    get_sd_parts( parent, &parent_owner, &parent_group, &parent_dacl, &parent_dacl_present,
+                  &parent_sacl, &parent_sacl_present, &parent_control );
+    get_sd_parts( creator, &creator_owner, &creator_group, &creator_dacl, &creator_dacl_present,
+                  &creator_sacl, &creator_sacl_present, &creator_control );
+
+    /* the owner and group are the creator's, else the token's, or the parent's if asked for */
+    if (!(owner = creator_owner) && (flags & SEF_DEFAULT_OWNER_FROM_PARENT)) owner = parent_owner;
+    if (!(group = creator_group) && (flags & SEF_DEFAULT_GROUP_FROM_PARENT)) group = parent_group;
+
+    /* there must be a token, whatever the creator gives */
+    if (open_object_token( &token, given_token ))
+    {
+        if (!owner) return STATUS_NO_TOKEN;
+        if (!group) return STATUS_INVALID_PRIMARY_GROUP;
+        return STATUS_NO_TOKEN;
+    }
+    if (!owner)
+    {
+        if (!(token_owner = query_token( token, TokenOwner, &status ))) goto done;
+        owner = token_owner->Owner;
+    }
+    if (!group)
+    {
+        if (!(token_group = query_token( token, TokenPrimaryGroup, &status ))) goto done;
+        group = token_group->PrimaryGroup;
+    }
+
+    if ((status = new_object_acl( &dacl, &dacl_present, &control, parent_dacl, parent_dacl_present, creator_dacl,
+                                  creator_dacl_present, creator_control, TRUE, is_container,
+                                  flags & SEF_DACL_AUTO_INHERIT, types, count, mapping, owner, group, token )))
+        goto done;
+    if ((status = new_object_acl( &sacl, &sacl_present, &control, parent_sacl, parent_sacl_present, creator_sacl,
+                                  creator_sacl_present, creator_control, FALSE, is_container,
+                                  flags & SEF_SACL_AUTO_INHERIT, types, count, mapping, owner, group, token )))
+        goto done;
+
+    status = make_object_sd( descr, owner, group, dacl_present, dacl, sacl_present, sacl, control );
+
+done:
+    RtlFreeHeap( GetProcessHeap(), 0, dacl );
+    RtlFreeHeap( GetProcessHeap(), 0, sacl );
+    RtlFreeHeap( GetProcessHeap(), 0, token_owner );
+    RtlFreeHeap( GetProcessHeap(), 0, token_group );
+    if (token != given_token) NtClose( token );
+    return status;
+}
+
+/* the ACEs of an ACL that are, or are not, mandatory labels */
+static void add_label_aces( struct acl_builder *b, const ACL *acl, BOOL labels )
+{
+    const ACE_HEADER *ace = (const ACE_HEADER *)(acl + 1);
+    WORD i;
+
+    b->revision = max( b->revision, acl->AclRevision );
+    for (i = 0; i < acl->AceCount; i++, ace = (const ACE_HEADER *)((const BYTE *)ace + ace->AceSize))
+        if ((ace->AceType == SYSTEM_MANDATORY_LABEL_ACE_TYPE) == labels) add_ace( b, ace, ace->AceFlags, NULL, NULL, NULL );
+}
+
+/* the inherited ACEs of an ACL */
+static void add_inherited_aces( struct acl_builder *b, const ACL *acl )
+{
+    const ACE_HEADER *ace = (const ACE_HEADER *)(acl + 1);
+    WORD i;
+
+    b->revision = max( b->revision, acl->AclRevision );
+    for (i = 0; i < acl->AceCount; i++, ace = (const ACE_HEADER *)((const BYTE *)ace + ace->AceSize))
+        if (ace->AceFlags & INHERITED_ACE) add_ace( b, ace, ace->AceFlags, NULL, NULL, NULL );
+}
+
+/* the DACL or SACL an object gets from a modification: its explicit ACEs, with the inherited ones the object
+ * has if inheritance is automatic; an ACL the modification does not have is a NULL one */
+static NTSTATUS set_object_acl( ACL **ret, BOOLEAN *present, SECURITY_DESCRIPTOR_CONTROL *control,
+                                const ACL *current, BOOLEAN current_present, const ACL *modification,
+                                BOOLEAN modification_present, SECURITY_DESCRIPTOR_CONTROL modification_control,
+                                BOOL is_dacl, BOOL auto_inherit, const GENERIC_MAPPING *mapping, PSID owner, PSID group )
+{
+    SECURITY_DESCRIPTOR_CONTROL protected = is_dacl ? SE_DACL_PROTECTED : SE_SACL_PROTECTED;
+    SECURITY_DESCRIPTOR_CONTROL inherited = is_dacl ? SE_DACL_AUTO_INHERITED : SE_SACL_AUTO_INHERITED;
+    struct acl_builder b = { 0 };
+
+    *control &= ~(protected | inherited);
+    *control |= modification_control & protected;
+    if (auto_inherit) *control |= inherited;
+    *ret = NULL;
+    *present = TRUE;
+    if (!modification_present || !modification) return STATUS_SUCCESS;
+
+    add_explicit_aces( &b, modification, TRUE, auto_inherit, mapping, owner, group );
+    if (auto_inherit && !(modification_control & protected) && current_present && current)
+        add_inherited_aces( &b, current );
+    *ret = acl_builder_finish( &b );
+    acl_builder_free( &b );
+    return b.status;
 }
 
