From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 4 Oct 2026 03:38:48 -0400
Subject: [PATCH] ws2_32: Handle FQDN queries and native numeric address
 metadata.

Reject AI_FQDN with AI_CANONNAME, request canonical names for FQDN,
report numeric-host flags and distinguish numeric canonical reverse
lookup from FQDN literals. Cover ANSI and Unicode queries with an
isolated native regression mode.

Co-Authored-By: Claude Code <noreply@anthropic.com>

diff --git a/dlls/ws2_32/protocol.c b/dlls/ws2_32/protocol.c
index 98ba3e888da..16f9bf6962c 100644
--- a/dlls/ws2_32/protocol.c
+++ b/dlls/ws2_32/protocol.c
@@ -197,6 +197,11 @@ int WINAPI getaddrinfo( const char *node, const char *service,
 
     *info = NULL;
 
+    if (hints && (hints->ai_flags & AI_FQDN) && (hints->ai_flags & AI_CANONNAME))
+    {
+        SetLastError( WSAEINVAL );
+        return WSAEINVAL;
+    }
     if (!node && !service)
     {
         SetLastError( WSAHOST_NOT_FOUND );
diff --git a/dlls/ws2_32/tests/protocol.c b/dlls/ws2_32/tests/protocol.c
index 547b88d6570..eea929b162a 100644
--- a/dlls/ws2_32/tests/protocol.c
+++ b/dlls/ws2_32/tests/protocol.c
@@ -1720,6 +1720,51 @@ static void compare_addrinfow(ADDRINFOW *a, ADDRINFOW *b)
     ok(!a && !b, "Expected both addresses null (%p != %p)\n", a, b);
 }
 
+static void test_fqdn(void)
+{
+    static const char *names[] = { "127.0.0.1", "::1", "localhost" };
+    struct addrinfo hints = {0}, *result;
+    ADDRINFOW hints_w = {0}, *result_w;
+    int ret;
+    unsigned int i;
+
+    hints.ai_socktype = SOCK_STREAM;
+    for (i = 0; i < ARRAY_SIZE(names); i++)
+    {
+        hints.ai_flags = AI_FQDN;
+        ret = getaddrinfo( names[i], "80", &hints, &result );
+        ok( !ret, "%s got %d\n", names[i], ret );
+        if (!ret)
+        {
+            ok( result && result->ai_canonname, "no canonical name for %s\n", names[i] );
+            if (result && result->ai_canonname && i < 2)
+                ok( !strcmp( result->ai_canonname, names[i] ), "got %s\n", result->ai_canonname );
+            freeaddrinfo( result );
+        }
+        hints.ai_flags = AI_FQDN | AI_CANONNAME;
+        result = (void *)0xdeadbeef;
+        ret = getaddrinfo( names[i], "80", &hints, &result );
+        ok( ret == WSAEINVAL, "got %d\n", ret );
+        ok( !result, "got %p\n", result );
+    }
+    hints_w.ai_socktype = SOCK_STREAM;
+    hints_w.ai_flags = AI_FQDN | AI_NUMERICHOST;
+    ret = GetAddrInfoW( L"127.0.0.1", L"80", &hints_w, &result_w );
+    ok( !ret, "got %d\n", ret );
+    if (!ret)
+    {
+        ok( result_w && result_w->ai_canonname, "no canonical name\n" );
+        if (result_w && result_w->ai_canonname)
+            ok( !lstrcmpW( result_w->ai_canonname, L"127.0.0.1" ), "got %s\n", wine_dbgstr_w(result_w->ai_canonname) );
+        FreeAddrInfoW( result_w );
+    }
+    hints_w.ai_flags = AI_FQDN | AI_CANONNAME;
+    result_w = (void *)0xdeadbeef;
+    ret = GetAddrInfoW( L"127.0.0.1", L"80", &hints_w, &result_w );
+    ok( ret == WSAEINVAL, "got %d\n", ret );
+    ok( !result_w, "got %p\n", result_w );
+}
+
 static void test_GetAddrInfoW(void)
 {
     static const WCHAR port[] = {'8','0',0};
@@ -3162,7 +3207,18 @@ static void test_WSAProviderConfigChange(void)
 START_TEST( protocol )
 {
     WSADATA data;
-    int ret;
+    int ret, argc;
+    char **argv;
+
+    argc = winetest_get_mainargs( &argv );
+    if (argc > 2 && !strcmp( argv[2], "fqdn" ))
+    {
+        ret = WSAStartup( 0x202, &data );
+        ok( !ret, "got %d\n", ret );
+        test_fqdn();
+        WSACleanup();
+        return;
+    }
 
     pFreeAddrInfoExW = (void *)GetProcAddress(GetModuleHandleA("ws2_32"), "FreeAddrInfoExW");
     pGetAddrInfoExOverlappedResult = (void *)GetProcAddress(GetModuleHandleA("ws2_32"), "GetAddrInfoExOverlappedResult");
@@ -3192,6 +3248,7 @@ START_TEST( protocol )
     test_WSAAddressToString();
     test_WSAStringToAddress();
 
+    test_fqdn();
     test_GetAddrInfoW();
     test_GetAddrInfoExW();
     test_getaddrinfo();
diff --git a/dlls/ws2_32/unixlib.c b/dlls/ws2_32/unixlib.c
index d16107be1af..d874d1401e1 100644
--- a/dlls/ws2_32/unixlib.c
+++ b/dlls/ws2_32/unixlib.c
@@ -239,6 +239,11 @@ static int addrinfo_flags_to_unix( int flags )
     int unix_flags = 0;
     unsigned int i;
 
+    if (flags & WS_AI_FQDN)
+    {
+        unix_flags |= AI_CANONNAME;
+        flags &= ~WS_AI_FQDN;
+    }
     for (i = 0; i < ARRAY_SIZE(addrinfo_flag_map); ++i)
     {
         if (flags & addrinfo_flag_map[i][0])
@@ -700,8 +705,11 @@ static NTSTATUS unix_getaddrinfo( void *args )
     const char *service = params->service;
     const struct WS_addrinfo *hints = params->hints;
     struct addrinfo unix_hints = {0};
-    struct addrinfo *unix_info, *src;
+    struct addrinfo *unix_info, *src, *numeric_info, numeric_hints = {0};
     struct WS_addrinfo *dst, *prev = NULL;
+    const char *canonical_name = NULL;
+    char reverse_name[NI_MAXHOST];
+    BOOL numeric = FALSE;
     unsigned int needed_size = 0;
     int ret;
 
@@ -754,11 +762,29 @@ static NTSTATUS unix_getaddrinfo( void *args )
     if (ret)
         return addrinfo_err_from_unix( ret );
 
+    if (params->node)
+    {
+        numeric_hints.ai_flags = AI_NUMERICHOST;
+        numeric_hints.ai_socktype = SOCK_STREAM;
+        if (!getaddrinfo( params->node, NULL, &numeric_hints, &numeric_info ))
+        {
+            numeric = TRUE;
+            freeaddrinfo( numeric_info );
+        }
+    }
+    canonical_name = unix_info->ai_canonname;
+    if (numeric && hints && (hints->ai_flags & WS_AI_CANONNAME) &&
+        !getnameinfo( unix_info->ai_addr, unix_info->ai_addrlen, reverse_name, sizeof(reverse_name),
+                      NULL, 0, NI_NAMEREQD ))
+        canonical_name = reverse_name;
+
     for (src = unix_info; src != NULL; src = src->ai_next)
     {
+        const char *name = src == unix_info ? canonical_name : src->ai_canonname;
+
         needed_size += sizeof(struct WS_addrinfo);
-        if (src->ai_canonname)
-            needed_size += strlen( src->ai_canonname ) + 1;
+        if (name)
+            needed_size += strlen( name ) + 1;
         needed_size += sockaddr_from_unix( (const union unix_sockaddr *)src->ai_addr, NULL, 0 );
     }
 
@@ -775,9 +801,11 @@ static NTSTATUS unix_getaddrinfo( void *args )
 
     for (src = unix_info; src != NULL; src = src->ai_next)
     {
+        const char *name = src == unix_info ? canonical_name : src->ai_canonname;
         void *next = dst + 1;
 
-        dst->ai_flags = addrinfo_flags_from_unix( src->ai_flags );
+        dst->ai_flags = addrinfo_flags_from_unix( src->ai_flags ) & WS_AI_NUMERICHOST;
+        if (numeric) dst->ai_flags |= WS_AI_NUMERICHOST;
         dst->ai_family = family_from_unix( src->ai_family );
         if (hints)
         {
@@ -789,12 +817,12 @@ static NTSTATUS unix_getaddrinfo( void *args )
             dst->ai_socktype = socktype_from_unix( src->ai_socktype );
             dst->ai_protocol = protocol_from_unix( src->ai_protocol );
         }
-        if (src->ai_canonname)
+        if (name)
         {
-            size_t len = strlen( src->ai_canonname ) + 1;
+            size_t len = strlen( name ) + 1;
 
             dst->ai_canonname = next;
-            memcpy( dst->ai_canonname, src->ai_canonname, len );
+            memcpy( dst->ai_canonname, name, len );
             next = dst->ai_canonname + len;
         }
 
diff --git a/include/ws2tcpip.h b/include/ws2tcpip.h
index abffd3b0d91..605818db1ff 100644
--- a/include/ws2tcpip.h
+++ b/include/ws2tcpip.h
@@ -74,6 +74,7 @@ typedef ADDRINFOA ADDRINFO, *LPADDRINFO;
 # define AI_NON_AUTHORITATIVE      0x00004000
 # define AI_SECURE                 0x00008000
 # define AI_RETURN_PREFERRED_NAMES 0x00010000
+# define AI_FQDN                   0x00020000
 # define AI_DISABLE_IDN_ENCODING   0x00080000
 /* getaddrinfo error codes */
 # define EAI_AGAIN	WSATRY_AGAIN
@@ -96,6 +97,7 @@ typedef ADDRINFOA ADDRINFO, *LPADDRINFO;
 # define WS_AI_NON_AUTHORITATIVE      0x00004000
 # define WS_AI_SECURE                 0x00008000
 # define WS_AI_RETURN_PREFERRED_NAMES 0x00010000
+# define WS_AI_FQDN                   0x00020000
 # define WS_AI_DISABLE_IDN_ENCODING   0x00080000
 /* getaddrinfo error codes */
 # define WS_EAI_AGAIN	WSATRY_AGAIN
