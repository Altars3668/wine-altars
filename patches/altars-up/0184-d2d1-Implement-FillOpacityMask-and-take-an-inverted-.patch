From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 22:20:44 -0400
Subject: [PATCH] d2d1: Implement FillOpacityMask(), and take an inverted
 DrawBitmap() source the right way round.

Both FillOpacityMask() methods only validated their arguments and recorded into command
lists; on a bitmap target they drew nothing.  Measured on Windows (build 29671): the mask
is sampled bilinearly and clamped at its own edges rather than the source rectangle's; the
source rectangle is normalised and cut to the mask, and without a destination it goes at
the origin at its own size in DIPs; only the mask's alpha counts, and the content kind is
only validated.  Fill a rectangle with the brush through a clamped, linear bitmap brush of
the mask, which is FillGeometry()'s opacity brush path.

DrawBitmap() dropped an inverted source rectangle and drew the whole bitmap; Windows
normalises it, as it does for FillOpacityMask().  The existing test only inverted a
source spanning the whole bitmap, where the two agree.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 8755ae51a50a1e046b315b99470c8e6030c71528)

diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index 939af2a5812..e5285ecdb2a 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -1619,19 +1619,96 @@ static void STDMETHODCALLTYPE d2d_device_context_FillMesh(ID2D1DeviceContext6 *i
         d2d_command_list_fill_mesh(context->target.command_list, context, mesh, brush);
 }
 
+/* Where DrawBitmap() and FillOpacityMask() put a bitmap: the source rectangle, taken in
+ * either orientation and cut to the bitmap, stretched over the destination rectangle, or
+ * put at the origin at its own size when there is none.  The transform maps the bitmap's
+ * DIPs to the destination.  FALSE when the source rectangle is empty. */
+static BOOL d2d_bitmap_get_placement(ID2D1Bitmap *bitmap, const D2D1_RECT_F *dst_rect,
+        const D2D1_RECT_F *src_rect, D2D1_RECT_F *d, D2D1_MATRIX_3X2_F *transform)
+{
+    D2D1_SIZE_F size = ID2D1Bitmap_GetSize(bitmap);
+    D2D1_RECT_F s, r;
+
+    d2d_rect_set(&s, 0.0f, 0.0f, size.width, size.height);
+    if (src_rect)
+    {
+        d2d_rect_set(&r, min(src_rect->left, src_rect->right), min(src_rect->top, src_rect->bottom),
+                max(src_rect->left, src_rect->right), max(src_rect->top, src_rect->bottom));
+        d2d_rect_intersect(&s, &r);
+    }
+
+    if (s.left == s.right || s.top == s.bottom)
+        return FALSE;
+
+    if (dst_rect)
+        *d = *dst_rect;
+    else
+        d2d_rect_set(d, 0.0f, 0.0f, s.right - s.left, s.bottom - s.top);
+
+    transform->_11 = fabsf((d->right - d->left) / (s.right - s.left));
+    transform->_21 = 0.0f;
+    transform->_31 = min(d->left, d->right) - min(s.left, s.right) * transform->_11;
+    transform->_12 = 0.0f;
+    transform->_22 = fabsf((d->bottom - d->top) / (s.bottom - s.top));
+    transform->_32 = min(d->top, d->bottom) - min(s.top, s.bottom) * transform->_22;
+
+    return TRUE;
+}
+
+/* The mask is sampled bilinearly and clamped at its own edges, not at those of the
+ * source rectangle; only its alpha is used.  What kind of content it holds changes
+ * nothing. */
+static void d2d_device_context_fill_opacity_mask(struct d2d_device_context *context, ID2D1Bitmap *mask,
+        ID2D1Brush *brush, const D2D1_RECT_F *dst_rect, const D2D1_RECT_F *src_rect)
+{
+    D2D1_BITMAP_BRUSH_PROPERTIES1 bitmap_brush_desc;
+    ID2D1RectangleGeometry *geometry;
+    D2D1_BRUSH_PROPERTIES brush_desc;
+    struct d2d_brush *opacity_brush;
+    D2D1_RECT_F d;
+    HRESULT hr;
+
+    if (!d2d_bitmap_get_placement(mask, dst_rect, src_rect, &d, &brush_desc.transform))
+        return;
+
+    bitmap_brush_desc.extendModeX = D2D1_EXTEND_MODE_CLAMP;
+    bitmap_brush_desc.extendModeY = D2D1_EXTEND_MODE_CLAMP;
+    bitmap_brush_desc.interpolationMode = D2D1_INTERPOLATION_MODE_LINEAR;
+    brush_desc.opacity = 1.0f;
+    if (FAILED(hr = d2d_bitmap_brush_create(context->factory, mask, &bitmap_brush_desc, &brush_desc, &opacity_brush)))
+    {
+        ERR("Failed to create opacity brush, hr %#lx.\n", hr);
+        return;
+    }
+
+    if (SUCCEEDED(hr = ID2D1Factory_CreateRectangleGeometry(context->factory, &d, &geometry)))
+    {
+        d2d_device_context_fill_geometry(context, unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)geometry),
+                unsafe_impl_from_ID2D1Brush(brush), opacity_brush);
+        ID2D1RectangleGeometry_Release(geometry);
+    }
+    else
+    {
+        ERR("Failed to create geometry, hr %#lx.\n", hr);
+    }
+
+    ID2D1Brush_Release(&opacity_brush->ID2D1Brush_iface);
+}
+
 static void STDMETHODCALLTYPE d2d_device_context_FillOpacityMask(ID2D1DeviceContext6 *iface,
         ID2D1Bitmap *mask, ID2D1Brush *brush, D2D1_OPACITY_MASK_CONTENT content,
         const D2D1_RECT_F *dst_rect, const D2D1_RECT_F *src_rect)
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
 
-    FIXME("iface %p, mask %p, brush %p, content %#x, dst_rect %s, src_rect %s stub!\n",
+    TRACE("iface %p, mask %p, brush %p, content %#x, dst_rect %s, src_rect %s.\n",
             iface, mask, brush, content, debug_d2d_rect_f(dst_rect), debug_d2d_rect_f(src_rect));
 
     if (FAILED(context->error.code))
         return;
 
-    if (context->drawing_state.antialiasMode != D2D1_ANTIALIAS_MODE_ALIASED)
+    if (context->target.type == D2D_TARGET_UNKNOWN || !context->drawing
+            || context->drawing_state.antialiasMode != D2D1_ANTIALIAS_MODE_ALIASED)
     {
         d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
         return;
@@ -1645,6 +1722,8 @@ static void STDMETHODCALLTYPE d2d_device_context_FillOpacityMask(ID2D1DeviceCont
 
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
         d2d_command_list_fill_opacity_mask(context->target.command_list, context, mask, brush, dst_rect, src_rect);
+    else
+        d2d_device_context_fill_opacity_mask(context, mask, brush, dst_rect, src_rect);
 }
 
