From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 16:45:45 -0400
Subject: [PATCH] services: Add a service's Environment value to the
 environment it starts with.

The Windows service manager merges the REG_MULTI_SZ "Environment" value
of a service's key, "name=value" strings, into the environment of the
process it starts for the service; it is the documented way to give a
single service its own variables (for instance a debug channel set for
one service only, as WINEDEBUG is otherwise the same for every process
of a session).  services.exe built the block from the system and user
environment only.

The test sets the value for its test services and checks the variable
from service_main().  It has not been run on Windows yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/programs/services/services.c b/programs/services/services.c
index b9d2a77df3a..db9112c873c 100644
--- a/programs/services/services.c
+++ b/programs/services/services.c
@@ -955,7 +955,36 @@ error:
  * system environment reaches services as they are restarted, not only when the
  * service manager is.  Services start rarely enough that the cost is nothing.
  */
-static void *create_service_environment(void)
+/* What the service's own Environment value, a list of "name=value", adds to or changes in the block. */
+static void add_service_environment(struct service_entry *service, void **environment)
+{
+    UNICODE_STRING name, value;
+    DWORD type, size = 0;
+    WCHAR *data, *p, *eq;
+    HKEY key;
+
+    if (RegOpenKeyExW(service->db->root_key, service->name, 0, KEY_READ, &key)) return;
+    if (!RegQueryValueExW(key, L"Environment", NULL, &type, NULL, &size) && type == REG_MULTI_SZ &&
+        (data = calloc(1, size + 2 * sizeof(WCHAR))))
+    {
+        if (!RegQueryValueExW(key, L"Environment", NULL, NULL, (BYTE *)data, &size))
+        {
+            for (p = data; *p; p += wcslen(p) + 1)
+            {
+                /* a name may itself start with '=' */
+                if (!(eq = wcschr(p + 1, '='))) continue;
+                name.Buffer = p;
+                name.Length = name.MaximumLength = (eq - p) * sizeof(WCHAR);
+                RtlInitUnicodeString(&value, eq + 1);
+                RtlSetEnvironmentVariable((WCHAR **)environment, &name, &value);
+            }
+        }
+        free(data);
+    }
+    RegCloseKey(key);
+}
+
+static void *create_service_environment(struct service_entry *service)
 {
     void *environment = NULL;
     HANDLE token;
@@ -975,6 +1004,7 @@ static void *create_service_environment(void)
         RtlInitUnicodeString( &value, val );
         RtlSetEnvironmentVariable( (WCHAR **)&environment, &name, &value );
     }
+    if (environment) add_service_environment(service, &environment);
     return environment;
 }
 
@@ -1097,7 +1127,7 @@ found:
         si.lpDesktop = (WCHAR *)L"__wineservice_winstation\\Default";
     }
 
-    environment = create_service_environment();
+    environment = create_service_environment(service_entry);
 
     service_entry->status.dwCurrentState = SERVICE_START_PENDING;
     service_entry->status.dwControlsAccepted = 0;
diff --git a/programs/services/tests/service.c b/programs/services/tests/service.c
index 530f551b1ee..b60e3c1d466 100644
--- a/programs/services/tests/service.c
+++ b/programs/services/tests/service.c
@@ -23,6 +23,7 @@
 #include <stdio.h>
 #include <winbase.h>
 #include <winuser.h>
+#include <winreg.h>
 
 #include "wine/test.h"
 
@@ -221,6 +222,11 @@ static void WINAPI service_main(DWORD argc, char **argv)
     GetEnvironmentVariableA("PATHEXT", buf, sizeof(buf));
     service_ok(buf[0], "did not find PATHEXT environment variable\n");
 
+    /* from the Environment value of the service's key */
+    buf[0] = 0;
+    GetEnvironmentVariableA("WINE_SERVICE_TEST", buf, sizeof(buf));
+    service_ok(!strcmp(buf, "from its key"), "WINE_SERVICE_TEST = '%s'\n", buf);
+
     service_handle = pRegisterServiceCtrlHandlerExA(service_name, service_handler, NULL);
     service_ok(service_handle != NULL, "RegisterServiceCtrlHandlerEx failed: %lu\n", GetLastError());
     if(!service_handle)
@@ -371,6 +377,20 @@ static SC_HANDLE register_service(const char *test_name)
     }
 
     ok(service != NULL, "CreateService failed: %lu\n", GetLastError());
+    if (service)
+    {
+        static const char environment[] = "WINE_SERVICE_TEST=from its key\0";
+        char key_name[MAX_PATH];
+        HKEY key;
+        LONG ret;
+
+        sprintf(key_name, "System\\CurrentControlSet\\Services\\%s", service_name);
+        ret = RegOpenKeyExA(HKEY_LOCAL_MACHINE, key_name, 0, KEY_SET_VALUE, &key);
+        ok(!ret, "RegOpenKeyEx failed: %ld\n", ret);
+        ret = RegSetValueExA(key, "Environment", 0, REG_MULTI_SZ, (const BYTE *)environment, sizeof(environment));
+        ok(!ret, "RegSetValueEx failed: %ld\n", ret);
+        RegCloseKey(key);
+    }
     return service;
 }
 
