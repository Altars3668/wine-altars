+START_TEST(power)
+{
+    WNDCLASSW cls = {0};
+    HWND hwnd;
+
+    main_thread = GetCurrentThreadId();
+    told_event = CreateEventW( NULL, FALSE, FALSE, NULL );
+    cls.lpfnWndProc = power_wndproc;
+    cls.lpszClassName = L"power_test";
+    RegisterClassW( &cls );
+    hwnd = CreateWindowW( L"power_test", NULL, WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL, NULL, NULL );
+    ok( !!hwnd, "CreateWindow failed, error %lu\n", GetLastError() );
+
+    test_power_setting_window( hwnd );
+    test_power_setting_callback();
+    test_suspend_resume( hwnd );
+
+    DestroyWindow( hwnd );
+    CloseHandle( told_event );
+}
