+static void test_suspend_resume( HWND hwnd )
+{
+    DEVICE_NOTIFY_SUBSCRIBE_PARAMETERS params = { power_callback, (void *)0x1234 };
+    HPOWERNOTIFY notify;
+    BOOL ret;
+
+    SetLastError( 0xdeadbeef );
+    notify = RegisterSuspendResumeNotification( hwnd, DEVICE_NOTIFY_WINDOW_HANDLE );
+    ok( !!notify, "got error %lu\n", GetLastError() );
+    ok( GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError() );
+    ret = UnregisterSuspendResumeNotification( notify );
+    ok( ret, "UnregisterSuspendResumeNotification failed\n" );
+
+    SetLastError( 0xdeadbeef );
+    notify = RegisterSuspendResumeNotification( &params, DEVICE_NOTIFY_CALLBACK );
+    ok( !!notify, "got error %lu\n", GetLastError() );
+    ok( GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError() );
+    ret = UnregisterSuspendResumeNotification( notify );
+    ok( ret, "UnregisterSuspendResumeNotification failed\n" );
+
+    SetLastError( 0xdeadbeef );
+    notify = RegisterSuspendResumeNotification( NULL, DEVICE_NOTIFY_WINDOW_HANDLE );
+    ok( !!notify, "got error %lu\n", GetLastError() );
+    ok( GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError() );
+    ret = UnregisterSuspendResumeNotification( notify );
+    ok( ret, "UnregisterSuspendResumeNotification failed\n" );
+
+    SetLastError( 0xdeadbeef );
+    notify = RegisterSuspendResumeNotification( hwnd, 7 );
+    ok( !notify, "got a handle\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    notify = RegisterSuspendResumeNotification( (HANDLE)0x1234, DEVICE_NOTIFY_SERVICE_HANDLE );
+    ok( !notify, "got a handle\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+
+    SetLastError( 0xdeadbeef );
+    ret = UnregisterSuspendResumeNotification( NULL );
+    ok( !ret, "UnregisterSuspendResumeNotification succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+}
