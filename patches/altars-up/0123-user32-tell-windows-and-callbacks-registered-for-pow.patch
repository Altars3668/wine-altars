new file mode 100644
index 00000000000..b0e6503989f
--- /dev/null
+++ b/dlls/user32/power.c
@@ -0,0 +1,354 @@
+/*
+ * Power setting, and suspend and resume, notifications
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "user_private.h"
+#include "winternl.h"
+#include "powrprof.h"
+
+#include "wine/list.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(power);
+
+/* A registration.  Windows tells each one the current value of its setting
+ * soon after it is made, from another thread, and again whenever the value
+ * changes; a window by WM_POWERBROADCAST, sent, and a callback by a call. */
+struct power_notify
+{
+    struct list entry;
+    LONG refcount;
+    BOOL suspend_resume;    /* for suspend and resume, not for a setting */
+    GUID setting;
+    DWORD flags;            /* DEVICE_NOTIFY_WINDOW_HANDLE, _SERVICE_HANDLE or _CALLBACK */
+    HANDLE recipient;       /* the window, or the service status handle */
+    DEVICE_NOTIFY_SUBSCRIBE_PARAMETERS params;
+    DWORD thread;           /* the thread telling it, while one is */
+    DWORD size;             /* of the value last told, 0 before the first */
+    BYTE value[sizeof(GUID)];
+};
+
+static struct list power_notifies = LIST_INIT( power_notifies );
+static CONDITION_VARIABLE power_told = CONDITION_VARIABLE_INIT;
+static PTP_TIMER power_timer;
+
+static CRITICAL_SECTION power_section;
+static CRITICAL_SECTION_DEBUG power_section_debug =
+{
+    0, 0, &power_section,
+    { &power_section_debug.ProcessLocksList, &power_section_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": power_section") }
+};
+static CRITICAL_SECTION power_section = { &power_section_debug, -1, 0, 0, 0, 0 };
+
+/* how often a change of power source or battery charge is looked for */
+#define POWER_POLL_MS 5000
+
+static void power_notify_release( struct power_notify *notify )
+{
+    if (!InterlockedDecrement( &notify->refcount )) free( notify );
+}
+
+/* the value of a setting as Windows tells it; FALSE for one it tells nothing of */
+static BOOL power_setting_value( const GUID *setting, BYTE *value, DWORD *size )
+{
+    SYSTEM_BATTERY_STATE battery;
+    DWORD dword;
+
+    if (IsEqualGUID( setting, &GUID_POWERSCHEME_PERSONALITY ) || IsEqualGUID( setting, &GUID_ACTIVE_POWERSCHEME ))
+    {
+        /* the one scheme there is, as on a computer with modern standby: balanced, of balanced personality */
+        memcpy( value, &GUID_TYPICAL_POWER_SAVINGS, sizeof(GUID) );
+        *size = sizeof(GUID);
+        return TRUE;
+    }
+
+    if (IsEqualGUID( setting, &GUID_MONITOR_POWER_ON )) dword = TRUE;
+    else if (IsEqualGUID( setting, &GUID_CONSOLE_DISPLAY_STATE )) dword = PowerMonitorOn;
+    else if (IsEqualGUID( setting, &GUID_ENERGY_SAVER_STATUS )) dword = ENERGY_SAVER_OFF;
+    /* its data means nothing, Windows says; this is what it sends */
+    else if (IsEqualGUID( setting, &GUID_IDLE_BACKGROUND_TASK )) dword = 2;
+    else if (IsEqualGUID( setting, &GUID_ACDC_POWER_SOURCE ) || IsEqualGUID( setting, &GUID_BATTERY_PERCENTAGE_REMAINING ))
+    {
+        memset( &battery, 0, sizeof(battery) );
+        if (NtPowerInformation( SystemBatteryState, NULL, 0, &battery, sizeof(battery) )) battery.AcOnLine = TRUE;
+        if (IsEqualGUID( setting, &GUID_ACDC_POWER_SOURCE ))
+            dword = battery.AcOnLine || !battery.BatteryPresent ? PoAc : PoDc;
+        else if (!battery.BatteryPresent) return FALSE;  /* no charge to tell of */
+        else if (!battery.MaxCapacity) dword = 100;
+        else dword = min( 100, (ULONGLONG)battery.RemainingCapacity * 100 / battery.MaxCapacity );
+    }
+    /* away mode is never on here; Windows tells nothing of it then, nor of settings there are none of */
+    else return FALSE;
+
+    memcpy( value, &dword, sizeof(dword) );
+    *size = sizeof(dword);
+    return TRUE;
+}
+
+/* tell a registration its setting's value, if it changed since it was last told or it never was */
+static void power_notify_update( struct power_notify *notify )
+{
+    union
+    {
+        POWERBROADCAST_SETTING setting;
+        BYTE buffer[offsetof(POWERBROADCAST_SETTING, Data[sizeof(GUID)])];
+    } u;
+    DWORD size, thread = GetCurrentThreadId();
+    DEVICE_NOTIFY_SUBSCRIBE_PARAMETERS params;
+    BYTE value[sizeof(GUID)];
+    HANDLE recipient;
+
+    EnterCriticalSection( &power_section );
+    /* one thread at a time tells a registration, so that values arrive in order */
+    while (notify->thread && notify->thread != thread)
+        SleepConditionVariableCS( &power_told, &power_section, INFINITE );
+    if (!notify->recipient || notify->thread || !power_setting_value( &notify->setting, value, &size )
+        || (size == notify->size && !memcmp( value, notify->value, size )))
+    {
+        LeaveCriticalSection( &power_section );
+        return;
+    }
+    memcpy( notify->value, value, size );
+    notify->size = size;
+    notify->thread = thread;
+    recipient = notify->recipient;
+    params = notify->params;
+    LeaveCriticalSection( &power_section );
+
+    u.setting.PowerSetting = notify->setting;
+    u.setting.DataLength = size;
+    memcpy( u.setting.Data, value, size );
+    TRACE( "telling %p of %s, %lu bytes\n", notify, debugstr_guid( &notify->setting ), size );
+
+    switch (notify->flags)
+    {
+    case DEVICE_NOTIFY_WINDOW_HANDLE:
+        SendMessageTimeoutW( recipient, WM_POWERBROADCAST, PBT_POWERSETTINGCHANGE, (LPARAM)&u.setting,
+                             SMTO_NORMAL, 20000, NULL );
+        break;
+    case DEVICE_NOTIFY_CALLBACK:
+        params.Callback( params.Context, PBT_POWERSETTINGCHANGE, &u.setting );
+        break;
+    }
+
+    EnterCriticalSection( &power_section );
+    notify->thread = 0;
+    WakeAllConditionVariable( &power_told );
+    LeaveCriticalSection( &power_section );
+}
+
+static void CALLBACK power_notify_first( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct power_notify *notify = context;
+
+    power_notify_update( notify );
+    power_notify_release( notify );
+}
+
+static BOOL power_setting_changes( const GUID *setting )
+{
+    return IsEqualGUID( setting, &GUID_ACDC_POWER_SOURCE ) || IsEqualGUID( setting, &GUID_BATTERY_PERCENTAGE_REMAINING );
+}
+
+/* Windows tells of a change as it happens; here the power source and the battery charge are looked at every
+ * few seconds while anything is registered for them */
+static void CALLBACK power_poll( TP_CALLBACK_INSTANCE *instance, void *context, TP_TIMER *timer )
+{
+    struct power_notify *notify, **notifies = NULL;
+    unsigned int i, count = 0;
+
+    EnterCriticalSection( &power_section );
+    LIST_FOR_EACH_ENTRY( notify, &power_notifies, struct power_notify, entry )
+        if (!notify->suspend_resume && power_setting_changes( &notify->setting )) count++;
+    if (count && (notifies = malloc( count * sizeof(*notifies) )))
+    {
+        count = 0;
+        LIST_FOR_EACH_ENTRY( notify, &power_notifies, struct power_notify, entry )
+        {
+            if (notify->suspend_resume || !power_setting_changes( &notify->setting )) continue;
+            InterlockedIncrement( &notify->refcount );
+            notifies[count++] = notify;
+        }
+    }
+    LeaveCriticalSection( &power_section );
+
+    for (i = 0; notifies && i < count; i++)
+    {
+        power_notify_update( notifies[i] );
+        power_notify_release( notifies[i] );
+    }
+    free( notifies );
+}
+
+/* the power_section is held */
+static void power_poll_update(void)
+{
+    struct power_notify *notify;
+    LARGE_INTEGER due;
+    FILETIME ft;
+
+    LIST_FOR_EACH_ENTRY( notify, &power_notifies, struct power_notify, entry )
+        if (!notify->suspend_resume && power_setting_changes( &notify->setting )) break;
+
+    if (&notify->entry == &power_notifies)
+    {
+        if (power_timer) SetThreadpoolTimer( power_timer, NULL, 0, 0 );
+        return;
+    }
+    if (!power_timer && !(power_timer = CreateThreadpoolTimer( power_poll, NULL, NULL ))) return;
+    if (IsThreadpoolTimerSet( power_timer )) return;
+    due.QuadPart = -(LONGLONG)POWER_POLL_MS * 10000;
+    ft.dwLowDateTime = due.u.LowPart;
+    ft.dwHighDateTime = due.u.HighPart;
+    SetThreadpoolTimer( power_timer, &ft, POWER_POLL_MS, POWER_POLL_MS / 5 );
+}
+
+static struct power_notify *power_notify_create( HANDLE recipient, const GUID *setting, DWORD flags )
+{
+    struct power_notify *notify;
+
+    if (!(notify = calloc( 1, sizeof(*notify) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return NULL;
+    }
+    notify->refcount = 1;
+    notify->flags = flags;
+    if (setting) notify->setting = *setting;
+    else notify->suspend_resume = TRUE;
+    if (flags == DEVICE_NOTIFY_CALLBACK)
+    {
+        /* a caller's parameters may live on its stack */
+        notify->params = *(DEVICE_NOTIFY_SUBSCRIBE_PARAMETERS *)recipient;
+        notify->recipient = &notify->params;
+    }
+    else notify->recipient = recipient;
+
+    EnterCriticalSection( &power_section );
+    list_add_tail( &power_notifies, &notify->entry );
+    if (setting) power_poll_update();
+    LeaveCriticalSection( &power_section );
+    return notify;
+}
+
+static BOOL power_notify_destroy( struct power_notify *notify, BOOL suspend_resume )
+{
+    struct power_notify *entry;
+    DWORD thread = GetCurrentThreadId();
+
+    EnterCriticalSection( &power_section );
+    LIST_FOR_EACH_ENTRY( entry, &power_notifies, struct power_notify, entry )
+        if (entry == notify && entry->suspend_resume == suspend_resume) break;
+    if (&entry->entry == &power_notifies)
+    {
+        LeaveCriticalSection( &power_section );
+        return FALSE;
+    }
+    list_remove( &notify->entry );
+    if (!suspend_resume) power_poll_update();
+    /* no call is made after this returns, but a window may still be sent what it was about to be sent */
+    notify->recipient = NULL;
+    if (notify->flags == DEVICE_NOTIFY_CALLBACK)
+        while (notify->thread && notify->thread != thread)
+            SleepConditionVariableCS( &power_told, &power_section, INFINITE );
+    LeaveCriticalSection( &power_section );
+    power_notify_release( notify );
+    return TRUE;
+}
+
+/**********************************************************************
+ * RegisterPowerSettingNotification [USER32.@]
+ */
+HPOWERNOTIFY WINAPI RegisterPowerSettingNotification( HANDLE recipient, const GUID *setting, DWORD flags )
+{
+    struct power_notify *notify;
+
+    TRACE( "(%p, %s, %#lx)\n", recipient, debugstr_guid( setting ), flags );
+
+    /* Windows does not check for a NULL setting, nor for NULL parameters */
+    if (!setting || (flags == DEVICE_NOTIFY_CALLBACK && !recipient)
+        || (flags != DEVICE_NOTIFY_WINDOW_HANDLE && flags != DEVICE_NOTIFY_SERVICE_HANDLE && flags != DEVICE_NOTIFY_CALLBACK))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    if (flags == DEVICE_NOTIFY_SERVICE_HANDLE)
+        FIXME( "service %p is not told of %s\n", recipient, debugstr_guid( setting ) );
+
+    if (!(notify = power_notify_create( recipient, setting, flags ))) return NULL;
+    if (flags != DEVICE_NOTIFY_SERVICE_HANDLE && (flags != DEVICE_NOTIFY_WINDOW_HANDLE || recipient))
+    {
+        InterlockedIncrement( &notify->refcount );
+        if (!TrySubmitThreadpoolCallback( power_notify_first, notify, NULL )) power_notify_release( notify );
+    }
+    SetLastError( ERROR_SUCCESS );
+    return notify;
+}
+
+/**********************************************************************
+ * UnregisterPowerSettingNotification [USER32.@]
+ */
+BOOL WINAPI UnregisterPowerSettingNotification( HPOWERNOTIFY handle )
+{
+    TRACE( "(%p)\n", handle );
+
+    if (!handle || !power_notify_destroy( handle, FALSE ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return TRUE;
+}
+
+/**********************************************************************
+ * RegisterSuspendResumeNotification (USER32.@)
+ */
+HPOWERNOTIFY WINAPI RegisterSuspendResumeNotification( HANDLE recipient, DWORD flags )
+{
+    struct power_notify *notify;
+
+    TRACE( "(%p, %#lx)\n", recipient, flags );
+
+    if ((flags != DEVICE_NOTIFY_WINDOW_HANDLE && flags != DEVICE_NOTIFY_CALLBACK)
+        || (flags == DEVICE_NOTIFY_CALLBACK && !recipient))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return NULL;
+    }
+    /* the system is not seen to suspend here, so there is nothing to tell */
+    if (!(notify = power_notify_create( recipient, NULL, flags ))) return NULL;
+    SetLastError( ERROR_SUCCESS );
+    return notify;
+}
+
+/**********************************************************************
+ * UnregisterSuspendResumeNotification (USER32.@)
+ */
+BOOL WINAPI UnregisterSuspendResumeNotification( HPOWERNOTIFY handle )
+{
+    TRACE( "(%p)\n", handle );
+
+    if (!handle || !power_notify_destroy( handle, TRUE ))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    return TRUE;
+}
