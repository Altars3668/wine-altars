new file mode 100644
index 00000000000..ec27d7bbefd
--- /dev/null
+++ b/dlls/user32/tests/power.c
@@ -0,0 +1,294 @@
+/*
+ * Unit tests for power setting, and suspend and resume, notifications
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "powrprof.h"
+
+#include "wine/test.h"
+
+static DWORD main_thread;
+
+/* what the last WM_POWERBROADCAST or callback told */
+static struct
+{
+    LONG count;
+    BOOL sent;
+    BOOL other_thread;
+    void *context;
+    ULONG type;
+    GUID setting;
+    DWORD size;
+    BYTE data[16];
+} told;
+static HANDLE told_event;
+
+static void remember( const POWERBROADCAST_SETTING *setting )
+{
+    told.setting = setting->PowerSetting;
+    told.size = setting->DataLength;
+    memcpy( told.data, setting->Data, min( setting->DataLength, sizeof(told.data) ));
+    told.other_thread = GetCurrentThreadId() != main_thread;
+    InterlockedIncrement( &told.count );
+}
+
+static LRESULT CALLBACK power_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
+{
+    if (msg == WM_POWERBROADCAST)
+    {
+        told.type = wparam;
+        told.sent = InSendMessage();
+        if (wparam == PBT_POWERSETTINGCHANGE) remember( (const POWERBROADCAST_SETTING *)lparam );
+        else InterlockedIncrement( &told.count );
+        return TRUE;
+    }
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
+}
+
+static ULONG CALLBACK power_callback( void *context, ULONG type, void *setting )
+{
+    told.context = context;
+    told.type = type;
+    if (type == PBT_POWERSETTINGCHANGE) remember( setting );
+    else InterlockedIncrement( &told.count );
+    SetEvent( told_event );
+    return 0;
+}
+
+/* until something is told, or for as long as it might take */
+static void wait_told( DWORD timeout )
+{
+    DWORD end = GetTickCount() + timeout;
+    MSG msg;
+
+    while (!told.count && (LONG)(end - GetTickCount()) > 0)
+    {
+        MsgWaitForMultipleObjects( 1, &told_event, FALSE, 50, QS_ALLINPUT );
+        while (PeekMessageW( &msg, 0, 0, 0, PM_REMOVE )) DispatchMessageW( &msg );
+    }
+}
+
+static void test_power_setting_window( HWND hwnd )
+{
+    static const struct
+    {
+        const GUID *guid;
+        DWORD size;
+        DWORD max;      /* the highest value it takes, of those that are numbers */
+    }
+    settings[] =
+    {
+        { &GUID_ACDC_POWER_SOURCE, sizeof(DWORD), PoHot },
+        { &GUID_MONITOR_POWER_ON, sizeof(DWORD), TRUE },
+        { &GUID_CONSOLE_DISPLAY_STATE, sizeof(DWORD), PowerMonitorDim },
+        { &GUID_ENERGY_SAVER_STATUS, sizeof(DWORD), ENERGY_SAVER_HIGH_SAVINGS },
+        { &GUID_POWERSCHEME_PERSONALITY, sizeof(GUID) },
+        { &GUID_ACTIVE_POWERSCHEME, sizeof(GUID) },
+        { &GUID_IDLE_BACKGROUND_TASK, sizeof(DWORD), ~0u },
+    };
+    static const GUID unknown = {0x12345678, 0x1234, 0x1234, {1, 2, 3, 4, 5, 6, 7, 8}};
+    HPOWERNOTIFY notify;
+    unsigned int i;
+    BOOL ret;
+
+    for (i = 0; i < ARRAY_SIZE(settings); i++)
+    {
+        winetest_push_context( "%s", debugstr_guid( settings[i].guid ));
+        memset( &told, 0, sizeof(told) );
+        SetLastError( 0xdeadbeef );
+        notify = RegisterPowerSettingNotification( hwnd, settings[i].guid, DEVICE_NOTIFY_WINDOW_HANDLE );
+        if (!notify && settings[i].guid == &GUID_IDLE_BACKGROUND_TASK)
+        {
+            /* outside an interactive session */
+            ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+            winetest_pop_context();
+            continue;
+        }
+        ok( !!notify, "got error %lu\n", GetLastError() );
+        ok( GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError() );
+
+        /* the current value is sent, from another thread, soon after */
+        ok( !told.count, "told %ld times already\n", told.count );
+        wait_told( 5000 );
+        ok( told.count == 1, "told %ld times\n", told.count );
+        ok( told.sent, "not sent\n" );
+        ok( told.type == PBT_POWERSETTINGCHANGE, "got type %#lx\n", told.type );
+        ok( IsEqualGUID( &told.setting, settings[i].guid ), "got setting %s\n", debugstr_guid( &told.setting ));
+        ok( told.size == settings[i].size, "got %lu bytes\n", told.size );
+        if (settings[i].size == sizeof(DWORD))
+            ok( *(DWORD *)told.data <= settings[i].max, "got value %lu\n", *(DWORD *)told.data );
+        else
+            ok( IsEqualGUID( (GUID *)told.data, &GUID_TYPICAL_POWER_SAVINGS )
+                || IsEqualGUID( (GUID *)told.data, &GUID_MAX_POWER_SAVINGS )
+                || IsEqualGUID( (GUID *)told.data, &GUID_MIN_POWER_SAVINGS )
+                || settings[i].guid == &GUID_ACTIVE_POWERSCHEME /* a scheme of the user's own */,
+                "got scheme %s\n", debugstr_guid( (GUID *)told.data ));
+
+        ret = UnregisterPowerSettingNotification( notify );
+        ok( ret, "UnregisterPowerSettingNotification failed\n" );
+        winetest_pop_context();
+    }
+
+    /* nothing is told of away mode unless it is on, nor of settings there are none of */
+    memset( &told, 0, sizeof(told) );
+    notify = RegisterPowerSettingNotification( hwnd, &GUID_SYSTEM_AWAYMODE, DEVICE_NOTIFY_WINDOW_HANDLE );
+    ok( !!notify, "got error %lu\n", GetLastError() );
+    wait_told( 500 );
+    ok( !told.count, "told %ld times\n", told.count );
+    UnregisterPowerSettingNotification( notify );
+
+    SetLastError( 0xdeadbeef );
+    notify = RegisterPowerSettingNotification( hwnd, &unknown, DEVICE_NOTIFY_WINDOW_HANDLE );
+    ok( !!notify, "got error %lu\n", GetLastError() );
+    ok( GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError() );
+    wait_told( 500 );
+    ok( !told.count, "told %ld times\n", told.count );
+    UnregisterPowerSettingNotification( notify );
+
+    /* the battery's charge is told only where there is a battery */
+    notify = RegisterPowerSettingNotification( hwnd, &GUID_BATTERY_PERCENTAGE_REMAINING, DEVICE_NOTIFY_WINDOW_HANDLE );
+    ok( !!notify, "got error %lu\n", GetLastError() );
+    wait_told( 1000 );
+    if (told.count)
+    {
+        ok( told.size == sizeof(DWORD), "got %lu bytes\n", told.size );
+        ok( *(DWORD *)told.data <= 100, "got %lu percent\n", *(DWORD *)told.data );
+    }
+    UnregisterPowerSettingNotification( notify );
+
+    /* a registration without a window to tell */
+    SetLastError( 0xdeadbeef );
+    notify = RegisterPowerSettingNotification( NULL, &GUID_ACDC_POWER_SOURCE, DEVICE_NOTIFY_WINDOW_HANDLE );
+    ok( !!notify, "got NULL\n" );
+    ok( GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError() );
+    ret = UnregisterPowerSettingNotification( notify );
+    ok( ret, "UnregisterPowerSettingNotification failed\n" );
+
+    SetLastError( 0xdeadbeef );
+    notify = RegisterPowerSettingNotification( hwnd, &GUID_ACDC_POWER_SOURCE, 7 );
+    ok( !notify, "got a handle\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    notify = RegisterPowerSettingNotification( hwnd, &GUID_ACDC_POWER_SOURCE, DEVICE_NOTIFY_ALL_INTERFACE_CLASSES );
+    ok( !notify, "got a handle\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+
+    /* a service status handle of no service of this process */
+    SetLastError( 0xdeadbeef );
+    notify = RegisterPowerSettingNotification( (HANDLE)0x1234, &GUID_ACDC_POWER_SOURCE, DEVICE_NOTIFY_SERVICE_HANDLE );
+    todo_wine ok( !notify, "got a handle\n" );
+    todo_wine ok( GetLastError() == ERROR_SERVICE_NOT_IN_EXE, "got error %lu\n", GetLastError() );
+    if (notify) UnregisterPowerSettingNotification( notify );
+
+    SetLastError( 0xdeadbeef );
+    ret = UnregisterPowerSettingNotification( NULL );
+    ok( !ret, "UnregisterPowerSettingNotification succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+}
+
+static void test_power_setting_callback(void)
+{
+    DEVICE_NOTIFY_SUBSCRIBE_PARAMETERS params = { power_callback, (void *)0x1234 };
+    HPOWERNOTIFY notify;
+    DWORD ret;
+
+    memset( &told, 0, sizeof(told) );
+    SetLastError( 0xdeadbeef );
+    notify = RegisterPowerSettingNotification( &params, &GUID_ACDC_POWER_SOURCE, DEVICE_NOTIFY_CALLBACK );
+    ok( !!notify, "got error %lu\n", GetLastError() );
+    ok( GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError() );
+    ret = WaitForSingleObject( told_event, 5000 );
+    ok( !ret, "not called\n" );
+    ok( told.count == 1, "called %ld times\n", told.count );
+    ok( told.other_thread, "called on the thread that registered\n" );
+    ok( told.context == (void *)0x1234, "got context %p\n", told.context );
+    ok( told.type == PBT_POWERSETTINGCHANGE, "got type %#lx\n", told.type );
+    ok( IsEqualGUID( &told.setting, &GUID_ACDC_POWER_SOURCE ), "got setting %s\n", debugstr_guid( &told.setting ));
+    ok( told.size == sizeof(DWORD), "got %lu bytes\n", told.size );
+    ok( *(DWORD *)told.data <= PoHot, "got value %lu\n", *(DWORD *)told.data );
+    ret = UnregisterPowerSettingNotification( notify );
+    ok( ret, "UnregisterPowerSettingNotification failed\n" );
+}
