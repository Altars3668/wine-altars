--- /dev/null
+++ b/dlls/mfsensorgroup/main.c
@@ -0,0 +1,304 @@
+/*
+ * Media Foundation sensor groups
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+
+#include "mfidl.h"
+#include "mferror.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(mfplat);
+
+struct activities_report
+{
+    IMFSensorActivitiesReport IMFSensorActivitiesReport_iface;
+    LONG refcount;
+};
+
+static struct activities_report *impl_from_IMFSensorActivitiesReport(IMFSensorActivitiesReport *iface)
+{
+    return CONTAINING_RECORD(iface, struct activities_report, IMFSensorActivitiesReport_iface);
+}
+
+static HRESULT WINAPI activities_report_QueryInterface(IMFSensorActivitiesReport *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFSensorActivitiesReport) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFSensorActivitiesReport_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI activities_report_AddRef(IMFSensorActivitiesReport *iface)
+{
+    struct activities_report *report = impl_from_IMFSensorActivitiesReport(iface);
+    ULONG refcount = InterlockedIncrement(&report->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI activities_report_Release(IMFSensorActivitiesReport *iface)
+{
+    struct activities_report *report = impl_from_IMFSensorActivitiesReport(iface);
+    ULONG refcount = InterlockedDecrement(&report->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+        free(report);
+
+    return refcount;
+}
+
+static HRESULT WINAPI activities_report_GetCount(IMFSensorActivitiesReport *iface, ULONG *count)
+{
+    TRACE("iface %p, count %p.\n", iface, count);
+
+    if (!count)
+        return E_POINTER;
+
+    *count = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI activities_report_GetActivityReport(IMFSensorActivitiesReport *iface, ULONG index,
+        IMFSensorActivityReport **report)
+{
+    TRACE("iface %p, index %lu, report %p.\n", iface, index, report);
+
+    if (!report)
+        return E_POINTER;
+
+    *report = NULL;
+    return E_INVALIDARG;
+}
+
+static HRESULT WINAPI activities_report_GetActivityReportByDeviceName(IMFSensorActivitiesReport *iface,
+        const WCHAR *name, IMFSensorActivityReport **report)
+{
+    TRACE("iface %p, name %s, report %p.\n", iface, debugstr_w(name), report);
+
+    if (!name || !report)
+        return E_POINTER;
+
+    *report = NULL;
+    return MF_E_NOT_FOUND;
+}
+
+static const IMFSensorActivitiesReportVtbl activities_report_vtbl =
+{
+    activities_report_QueryInterface,
+    activities_report_AddRef,
+    activities_report_Release,
+    activities_report_GetCount,
+    activities_report_GetActivityReport,
+    activities_report_GetActivityReportByDeviceName,
+};
+
+static HRESULT activities_report_create(IMFSensorActivitiesReport **out)
+{
+    struct activities_report *report;
+
+    if (!(report = calloc(1, sizeof(*report))))
+        return E_OUTOFMEMORY;
+
+    report->IMFSensorActivitiesReport_iface.lpVtbl = &activities_report_vtbl;
+    report->refcount = 1;
+
+    *out = &report->IMFSensorActivitiesReport_iface;
+    return S_OK;
+}
+
+struct activity_monitor
+{
+    IMFSensorActivityMonitor IMFSensorActivityMonitor_iface;
+    LONG refcount;
+
+    IMFSensorActivitiesReportCallback *callback;
+    SRWLOCK lock;
+    BOOL started;
+};
+
+static struct activity_monitor *impl_from_IMFSensorActivityMonitor(IMFSensorActivityMonitor *iface)
+{
+    return CONTAINING_RECORD(iface, struct activity_monitor, IMFSensorActivityMonitor_iface);
+}
+
+static HRESULT WINAPI activity_monitor_QueryInterface(IMFSensorActivityMonitor *iface, REFIID riid, void **out)
+{
+    TRACE("iface %p, riid %s, out %p.\n", iface, debugstr_guid(riid), out);
+
+    if (IsEqualIID(riid, &IID_IMFSensorActivityMonitor) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFSensorActivityMonitor_AddRef(iface);
+        return S_OK;
+    }
+
+    WARN("Unsupported interface %s.\n", debugstr_guid(riid));
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI activity_monitor_AddRef(IMFSensorActivityMonitor *iface)
+{
+    struct activity_monitor *monitor = impl_from_IMFSensorActivityMonitor(iface);
+    ULONG refcount = InterlockedIncrement(&monitor->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG WINAPI activity_monitor_Release(IMFSensorActivityMonitor *iface)
+{
+    struct activity_monitor *monitor = impl_from_IMFSensorActivityMonitor(iface);
+    ULONG refcount = InterlockedDecrement(&monitor->refcount);
+
+    TRACE("iface %p, refcount %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        IMFSensorActivitiesReportCallback_Release(monitor->callback);
+        free(monitor);
+    }
+
+    return refcount;
+}
+
+/* The report is made on a thread of the pool, as the frame server's arrive on threads of
+ * their own.  The item holds a reference to the monitor until it has taken one to the
+ * callback, so that the monitor can go while its last report is being made. */
+static void CALLBACK activity_monitor_report(TP_CALLBACK_INSTANCE *instance, void *context)
+{
+    struct activity_monitor *monitor = context;
+    IMFSensorActivitiesReportCallback *callback = NULL;
+    IMFSensorActivitiesReport *report;
+    HRESULT hr;
+
+    AcquireSRWLockShared(&monitor->lock);
+    if (monitor->started)
+    {
+        callback = monitor->callback;
+        IMFSensorActivitiesReportCallback_AddRef(callback);
+    }
+    ReleaseSRWLockShared(&monitor->lock);
+    IMFSensorActivityMonitor_Release(&monitor->IMFSensorActivityMonitor_iface);
+
+    if (!callback)
+        return;
+
+    if (SUCCEEDED(activities_report_create(&report)))
+    {
+        if (FAILED(hr = IMFSensorActivitiesReportCallback_OnActivitiesReport(callback, report)))
+            WARN("Callback %p failed the report, hr %#lx.\n", callback, hr);
+        IMFSensorActivitiesReport_Release(report);
+    }
+    IMFSensorActivitiesReportCallback_Release(callback);
+}
+
+static HRESULT WINAPI activity_monitor_Start(IMFSensorActivityMonitor *iface)
+{
+    struct activity_monitor *monitor = impl_from_IMFSensorActivityMonitor(iface);
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p.\n", iface);
+
+    AcquireSRWLockExclusive(&monitor->lock);
+    if (!monitor->started)
+    {
+        /* Windows learns from its frame server which processes stream from which sensor.
+         * Wine has none, so the one report it has to give is that no sensor is in use. */
+        FIXME("iface %p, the use of sensors by processes is not tracked.\n", iface);
+        monitor->started = TRUE;
+        IMFSensorActivityMonitor_AddRef(iface);
+        if (!TrySubmitThreadpoolCallback(activity_monitor_report, monitor, NULL))
+        {
+            hr = HRESULT_FROM_WIN32(GetLastError());
+            monitor->started = FALSE;
+            InterlockedDecrement(&monitor->refcount);
+        }
+    }
+    ReleaseSRWLockExclusive(&monitor->lock);
+
+    return hr;
+}
+
+static HRESULT WINAPI activity_monitor_Stop(IMFSensorActivityMonitor *iface)
+{
+    struct activity_monitor *monitor = impl_from_IMFSensorActivityMonitor(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    AcquireSRWLockExclusive(&monitor->lock);
+    monitor->started = FALSE;
+    ReleaseSRWLockExclusive(&monitor->lock);
+
+    return S_OK;
+}
+
+static const IMFSensorActivityMonitorVtbl activity_monitor_vtbl =
+{
+    activity_monitor_QueryInterface,
+    activity_monitor_AddRef,
+    activity_monitor_Release,
+    activity_monitor_Start,
+    activity_monitor_Stop,
+};
+
+/***********************************************************************
+ *      MFCreateSensorActivityMonitor (mfsensorgroup.@)
+ */
+HRESULT WINAPI MFCreateSensorActivityMonitor(IMFSensorActivitiesReportCallback *callback,
+        IMFSensorActivityMonitor **out)
+{
+    struct activity_monitor *monitor;
+
+    TRACE("callback %p, out %p.\n", callback, out);
+
+    if (!out)
+        return E_POINTER;
+    *out = NULL;
+    if (!callback)
+        return E_POINTER;
+
+    if (!(monitor = calloc(1, sizeof(*monitor))))
+        return E_OUTOFMEMORY;
+
+    monitor->IMFSensorActivityMonitor_iface.lpVtbl = &activity_monitor_vtbl;
+    monitor->refcount = 1;
+    monitor->callback = callback;
+    IMFSensorActivitiesReportCallback_AddRef(callback);
+    InitializeSRWLock(&monitor->lock);
+
+    *out = &monitor->IMFSensorActivityMonitor_iface;
+    TRACE("Created monitor %p.\n", *out);
+    return S_OK;
+}
