diff --git a/dlls/mfsensorgroup/tests/mfsensorgroup.c b/dlls/mfsensorgroup/tests/mfsensorgroup.c
new file mode 100644
index 00000000000..965a70da537
--- /dev/null
+++ b/dlls/mfsensorgroup/tests/mfsensorgroup.c
@@ -0,0 +1,192 @@
+/*
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include <stdarg.h>
+
+#define COBJMACROS
+
+#include "windef.h"
+#include "winbase.h"
+#include "mfidl.h"
+#include "mferror.h"
+
+#include "wine/test.h"
+
+struct callback
+{
+    IMFSensorActivitiesReportCallback IMFSensorActivitiesReportCallback_iface;
+    LONG refcount;
+    LONG reports;
+    HANDLE event;
+    DWORD thread;
+    ULONG count;
+};
+
+static struct callback *impl_from_IMFSensorActivitiesReportCallback(IMFSensorActivitiesReportCallback *iface)
+{
+    return CONTAINING_RECORD(iface, struct callback, IMFSensorActivitiesReportCallback_iface);
+}
+
+static HRESULT WINAPI callback_QueryInterface(IMFSensorActivitiesReportCallback *iface, REFIID riid, void **out)
+{
+    if (IsEqualIID(riid, &IID_IMFSensorActivitiesReportCallback) || IsEqualIID(riid, &IID_IUnknown))
+    {
+        *out = iface;
+        IMFSensorActivitiesReportCallback_AddRef(iface);
+        return S_OK;
+    }
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI callback_AddRef(IMFSensorActivitiesReportCallback *iface)
+{
+    return InterlockedIncrement(&impl_from_IMFSensorActivitiesReportCallback(iface)->refcount);
+}
+
+static ULONG WINAPI callback_Release(IMFSensorActivitiesReportCallback *iface)
+{
+    return InterlockedDecrement(&impl_from_IMFSensorActivitiesReportCallback(iface)->refcount);
+}
+
+static HRESULT WINAPI callback_OnActivitiesReport(IMFSensorActivitiesReportCallback *iface,
+        IMFSensorActivitiesReport *report)
+{
+    struct callback *callback = impl_from_IMFSensorActivitiesReportCallback(iface);
+    IMFSensorActivityReport *activity;
+    ULONG count = ~0u, i;
+    HRESULT hr;
+
+    callback->thread = GetCurrentThreadId();
+    ok(!!report, "Got no report.\n");
+
+    hr = IMFSensorActivitiesReport_GetCount(report, &count);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(count != ~0u, "Got no count.\n");
+    callback->count = count;
+    hr = IMFSensorActivitiesReport_GetCount(report, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < count; i++)
+    {
+        ULONG processes = ~0u;
+
+        hr = IMFSensorActivitiesReport_GetActivityReport(report, i, &activity);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IMFSensorActivityReport_GetProcessCount(activity, &processes);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(processes != ~0u, "Got no process count.\n");
+        IMFSensorActivityReport_Release(activity);
+    }
+
+    activity = (void *)0xdeadbeef;
+    hr = IMFSensorActivitiesReport_GetActivityReport(report, count, &activity);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(!activity, "Got report %p.\n", activity);
+    hr = IMFSensorActivitiesReport_GetActivityReport(report, 0, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+
+    activity = (void *)0xdeadbeef;
+    hr = IMFSensorActivitiesReport_GetActivityReportByDeviceName(report, L"\\\\?\\wine#no#such#device", &activity);
+    ok(hr == MF_E_NOT_FOUND, "Unexpected hr %#lx.\n", hr);
+    ok(!activity, "Got report %p.\n", activity);
+
+    InterlockedIncrement(&callback->reports);
+    SetEvent(callback->event);
+    return S_OK;
+}
+
+static const IMFSensorActivitiesReportCallbackVtbl callback_vtbl =
+{
+    callback_QueryInterface,
+    callback_AddRef,
+    callback_Release,
+    callback_OnActivitiesReport,
+};
+
+static void test_activity_monitor(void)
+{
+    struct callback callback = {{&callback_vtbl}, 1};
+    IMFSensorActivityMonitor *monitor;
+    LONG reports;
+    HRESULT hr;
+    DWORD ret;
+    ULONG ref;
+    int i;
+
+    callback.event = CreateEventW(NULL, FALSE, FALSE, NULL);
+
+    hr = MFCreateSensorActivityMonitor(&callback.IMFSensorActivitiesReportCallback_iface, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    monitor = (void *)0xdeadbeef;
+    hr = MFCreateSensorActivityMonitor(NULL, &monitor);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    ok(!monitor, "Got monitor %p.\n", monitor);
+
+    hr = MFCreateSensorActivityMonitor(&callback.IMFSensorActivitiesReportCallback_iface, &monitor);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(callback.refcount == 2, "Unexpected refcount %ld.\n", callback.refcount);
+
+    /* nothing is reported before Start */
+    ret = WaitForSingleObject(callback.event, 200);
+    ok(ret == WAIT_TIMEOUT, "Unexpected ret %#lx.\n", ret);
+
+    hr = IMFSensorActivityMonitor_Stop(monitor);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IMFSensorActivityMonitor_Start(monitor);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ret = WaitForSingleObject(callback.event, 5000);
+    ok(!ret, "Unexpected ret %#lx.\n", ret);
+    ok(callback.thread && callback.thread != GetCurrentThreadId(), "Reported on thread %#lx.\n", callback.thread);
+    trace("%lu sensors in use.\n", callback.count);
+
+    hr = IMFSensorActivityMonitor_Start(monitor);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IMFSensorActivityMonitor_Stop(monitor);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    reports = callback.reports;
+    ret = WaitForSingleObject(callback.event, 500);
+    ok(ret == WAIT_TIMEOUT, "Unexpected ret %#lx.\n", ret);
+    ok(callback.reports == reports, "Got %ld reports after Stop.\n", callback.reports - reports);
+    hr = IMFSensorActivityMonitor_Stop(monitor);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* a new Start reports again */
+    hr = IMFSensorActivityMonitor_Start(monitor);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ret = WaitForSingleObject(callback.event, 5000);
+    ok(!ret, "Unexpected ret %#lx.\n", ret);
+    hr = IMFSensorActivityMonitor_Stop(monitor);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    ref = IMFSensorActivityMonitor_Release(monitor);
+    ok(!ref, "Unexpected refcount %lu.\n", ref);
+    /* the report that has just been made may still hold the callback for a moment */
+    for (i = 0; i < 100 && callback.refcount != 1; i++) Sleep(10);
+    ok(callback.refcount == 1, "Unexpected refcount %ld.\n", callback.refcount);
+
+    CloseHandle(callback.event);
+}
+
+START_TEST(mfsensorgroup)
+{
+    test_activity_monitor();
+}
