From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 01:19:06 -0400
Subject: [PATCH] include: describe the Task Scheduler's interfaces as its type
 library does.

The interfaces are dual and nonextensible with the DISPIDs, parameter
names and flags of Windows' own type library, which a script or an
early-bound client relies on, and the library gains what Windows 10
added: IExecAction2, IPrincipal2, ITaskSettings3, IMaintenanceSettings,
the email, message and COM handler actions, the task handler interfaces
and TASK_RUN_FLAGS.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 13a0fbaa3c8385d63b830b40d15a7f0a5d96d05d)

diff --git a/include/taskschd.idl b/include/taskschd.idl
index 173c020ae04..cb9e8679150 100644
--- a/include/taskschd.idl
+++ b/include/taskschd.idl
@@ -38,6 +38,15 @@ typedef enum _TASK_STATE
     TASK_STATE_RUNNING
 } TASK_STATE;
 
+typedef enum _TASK_RUN_FLAGS
+{
+    TASK_RUN_NO_FLAGS = 0,
+    TASK_RUN_AS_SELF = 1,
+    TASK_RUN_IGNORE_CONSTRAINTS = 2,
+    TASK_RUN_USE_SESSION_ID = 4,
+    TASK_RUN_USER_SID = 8
+} TASK_RUN_FLAGS;
+
 typedef enum _TASK_ENUM_FLAGS
 {
     TASK_ENUM_HIDDEN = 0x0001
@@ -124,6 +133,13 @@ typedef enum _TASK_CREATION
     TASK_IGNORE_REGISTRATION_TRIGGERS = 32
 } TASK_CREATION;
 
+typedef enum _TASK_PROCESSTOKENSID
+{
+    TASK_PROCESSTOKENSID_NONE = 0,
+    TASK_PROCESSTOKENSID_UNRESTRICTED = 1,
+    TASK_PROCESSTOKENSID_DEFAULT = 2
+} TASK_PROCESSTOKENSID_TYPE;
+
 interface ITaskService;
 interface IRegisteredTask;
 interface IRegisteredTaskCollection;
@@ -154,259 +170,287 @@ interface IRepetitionPattern;
 interface IAction;
 interface IActionCollection;
 interface IExecAction;
+interface IComHandlerAction;
+interface IEmailAction;
+interface IShowMessageAction;
+interface IExecAction2;
 interface INetworkSettings;
 interface IPrincipal;
+interface IPrincipal2;
+interface ITaskSettings3;
+interface IMaintenanceSettings;
 
