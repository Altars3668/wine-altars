     ID3D11DeviceContext_Unmap(d3d_context, (ID3D11Resource *)context->vs_cb, 0);
     ID3D11DeviceContext_Release(d3d_context);
@@ -1207,7 +1205,7 @@ static void d2d_device_context_cover(struct d2d_device_context *context, const s
     quad._32 = (pass.bounds.top + pass.bounds.bottom) / 2.0f;
     d2d_matrix_multiply(&quad, &to_world);
 
-    if (FAILED(d2d_device_context_update_vs_cb(context, &quad, 0.0f, 0.0f, FALSE))
+    if (FAILED(d2d_device_context_update_vs_cb(context, &quad, 0.0f, NULL))
             || FAILED(d2d_device_context_update_ps_cb(context, brush, opacity_brush, FALSE, FALSE, FALSE, &pass)))
         return;
     d2d_device_context_draw(context, D2D_SHAPE_TYPE_TRIANGLE, context->ib, 6, context->vb, context->vb_stride,
@@ -1218,35 +1216,47 @@ static void d2d_device_context_draw_geometry_pass(struct d2d_device_context *ren
         const struct d2d_geometry *geometry, struct d2d_brush *brush, float stroke_width,
         const struct d2d_stroke_style *style, const struct d2d_coverage_pass *pass)
 {
+    /* Without a style, joins are mitres cut off 10 half widths out. */
+    struct d2d_vec4 join = {10.0f, 0.0f, 1.0f, 10.0f};
     D3D11_SUBRESOURCE_DATA buffer_data;
     D3D11_BUFFER_DESC buffer_desc;
-    BOOL round_joins = FALSE;
-    float miter_limit = 0.0f;
     ID3D11Buffer *ib, *vb;
+    BOOL round_joins;
+    float limit;
     HRESULT hr;
 
-    /* Joins are drawn as miters and cut back in the shaders: to a bevel past the miter limit, or to the circle
-     * around the point they join at. A miter join longer than the limit is drawn in full. */
+    /* Joins are drawn as mitres and cut back in the shaders: square at the mitre limit, to a bevel, or to the circle
+     * around the point they join at, for which the mitre only has to reach twice as far as the circle.  Where the
+     * stroke turns straight back, a mitre reaches ahead as far as its limit, a round join as far as the circle, and
+     * a bevel not at all. */
     if (style)
     {
+        limit = max(style->desc.miterLimit, 1.0f);
         switch (style->desc.lineJoin)
         {
+            case D2D1_LINE_JOIN_MITER:
+                join.x = join.w = limit;
+                break;
             case D2D1_LINE_JOIN_BEVEL:
-                miter_limit = 1.0f;
+                join.x = 1.0f;
+                join.z = join.w = 0.0f;
                 break;
             case D2D1_LINE_JOIN_ROUND:
-                round_joins = TRUE;
+                join.x = 2.0f;
+                join.y = 1.0f;
+                join.w = 1.0f;
                 break;
             case D2D1_LINE_JOIN_MITER_OR_BEVEL:
-                miter_limit = max(style->desc.miterLimit, 1.0f);
