 {
@@ -5203,7 +5214,11 @@ static const char shape_vs_code_outline[] =
     "float stroke_width;\n"
     "float4 transform_rtx;\n"
     "float4 transform_rty;\n"
-    "float2 join;\n"
+    "float4 join;\n"
+    "\n"
+    "#define JOIN_VERTEX_TIP 1.0f\n"
+    "#define JOIN_VERTEX_CENTRE 2.0f\n"
+    "#define JOIN_VERTEX_FRONT 3.0f\n"
     "\n"
     "struct output\n"
     "{\n"
@@ -5222,7 +5237,8 @@ static const char shape_vs_code_outline[] =
     " *   q⃑ᵢ = q̂ₚᵣₑᵥ⊥ + tan(½θ) · -q̂ₚᵣₑᵥ\n"
     " *   θ  = ∠PₚᵣₑᵥP₀Pₙₑₓₜ\n"
     " *   q⃑ₚᵣₑᵥ = P₀ - Pₚᵣₑᵥ */\n"
-    "void main(float2 position : POSITION, float2 prev : PREV, float2 next : NEXT, out struct output o)\n"
+    "void main(float2 position : POSITION, float2 prev : PREV, float2 next : NEXT, float join_vertex : JOIN,\n"
+    "        out struct output o)\n"
     "{\n"
     "    float2 q_prev, q_next, v_p, q_i;\n"
     "    float2x2 geom;\n"
@@ -5233,19 +5249,39 @@ static const char shape_vs_code_outline[] =
     "    geom = float2x2(transform_geometry._11_21, transform_geometry._12_22);\n"
     "    q_prev = normalize(mul(geom, prev));\n"
     "    q_next = normalize(mul(geom, next));\n"
-    "\n"
-    "    /* tan(½θ) = sin(θ) / (1 + cos(θ))\n"
-    "     *         = (q̂ₚᵣₑᵥ⊥ · q̂ₙₑₓₜ) / (1 + (q̂ₚᵣₑᵥ · q̂ₙₑₓₜ)) */\n"
     "    v_p = float2(-q_prev.y, q_prev.x);\n"
-    "    l = -dot(v_p, q_next) / (1.0f + dot(q_prev, q_next));\n"
-    "    q_i = l * q_prev + v_p;\n"
     "\n"
-    "    /* A join longer than the miter limit is bevelled: its tip, and the inner\n"
-    "     * point opposite, come back along the bisector to where it crosses the\n"
-    "     * line between the ends of the two sides, at sin²(½θ) the length of the\n"
-    "     * miter. The sides of a segment are never longer than 1. */\n"
-    "    if (join.x > 0.0f && dot(q_i, q_i) > join.x * join.x)\n"
-    "        q_i /= dot(q_i, q_i);\n"
+    "    if (join_vertex == JOIN_VERTEX_CENTRE)\n"
+    "    {\n"
+    "        q_i = float2(0.0f, 0.0f);\n"
+    "    }\n"
+    "    else if (join_vertex == JOIN_VERTEX_FRONT)\n"
+    "    {\n"
+    "        /* Where the stroke turns straight back, the side, ahead along\n"
+    "         * next as far as the join reaches. */\n"
+    "        q_i = v_p + join.w * q_next;\n"
+    "    }\n"
+    "    else\n"
+    "    {\n"
+    "        /* tan(½θ) = sin(θ) / (1 + cos(θ))\n"
+    "         *         = (q̂ₚᵣₑᵥ⊥ · q̂ₙₑₓₜ) / (1 + (q̂ₚᵣₑᵥ · q̂ₙₑₓₜ)) */\n"
+    "        l = -dot(v_p, q_next) / (1.0f + dot(q_prev, q_next));\n"
+    "        q_i = l * q_prev + v_p;\n"
+    "\n"
+    "        /* A mitre longer than the limit is cut off square to the bisector\n"
+    "         * at the limit, each copy of the tip sliding back along its own\n"
+    "         * side; or bevelled, the tip coming back along the bisector to\n"
+    "         * where it crosses the line between the ends of the two sides, at\n"
+    "         * sin²(½θ) the length of the mitre. The sides of a segment are\n"
+    "         * never longer than 1. */\n"
