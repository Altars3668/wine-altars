             default:
                 break;
         }
     }
+    round_joins = join.y != 0.0f;
 
-    if (FAILED(hr = d2d_device_context_update_vs_cb(render_target, &geometry->transform, stroke_width,
-            miter_limit, round_joins)))
+    if (FAILED(hr = d2d_device_context_update_vs_cb(render_target, &geometry->transform, stroke_width, &join)))
     {
