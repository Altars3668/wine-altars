From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 22:43:57 -0400
Subject: [PATCH] d2d1: Cut mitres off at the limit, and join a stroke that
 turns straight back by its style.

A MITER join, which is also what a stroke without a style has, with a limit of 10, was
drawn whole however long the mitre was; Windows cuts it off square to the bisector at
the limit.  And where a stroke turned straight back, a rectangle 25 units long was drawn
ahead of the point whatever the join; Windows draws one as long as the mitre limit for a
mitre, a half circle for a round join, and nothing for a bevel.

Each outline vertex now says what it is to its join.  A join is the point joined at, the
ends of the two sides, and the mitre's tip twice, once from each side, which the vertex
shader cuts off by sliding each copy back along its own side, bevels, or leaves; the
inner point opposite the tip, which could reach past short segments, is gone.  The
vertices ahead of a turn back reach as far as the style makes them.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit bbce22a23918d49c010fe8634c71eb7362218b1e)

diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index 4fb636be7e4..9cf7c7b574a 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -172,7 +172,9 @@ struct d2d_vs_cb
     } transform_geometry;
     struct d2d_vec4 transform_rtx;
     struct d2d_vec4 transform_rty;
-    /* x: the miter limit past which a join is bevelled, 0 for none; y: non-zero for round joins. */
+    /* x: the mitre limit, in half widths, past which a join is cut off or bevelled, 0 for none; y: non-zero for
+     * round joins; z: non-zero to cut a mitre off square at the limit rather than bevel it; w: how far, in half
+     * widths, a stroke that turns straight back reaches ahead. */
     struct d2d_vec4 join;
 };
 
@@ -725,11 +727,21 @@ struct d2d_face
     UINT16 v[3];
 };
 
+/* What an outline vertex is to a join; the vertex shader places it by that and the stroke style. */
+enum d2d_join_vertex
+{
+    D2D_JOIN_VERTEX_NONE,   /* on a segment's side, where prev and next give it */
+    D2D_JOIN_VERTEX_TIP,    /* the tip of the mitre, cut off or bevelled from the side of prev */
+    D2D_JOIN_VERTEX_CENTRE, /* the point joined at */
+    D2D_JOIN_VERTEX_FRONT,  /* ahead along next, where a stroke turns straight back */
+};
+
 struct d2d_outline_vertex
 {
     D2D1_POINT_2F position;
     D2D1_POINT_2F prev;
     D2D1_POINT_2F next;
+    float join;
 };
 
 struct d2d_curve_outline_vertex
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
