+    "                q_i += (join.x - length(q_i)) / dot(q_prev, normalize(q_i)) * q_prev;\n"
+    "            else\n"
+    "                q_i /= dot(q_i, q_i);\n"
+    "        }\n"
+    "    }\n"
     "\n"
     "    /* For round joins, the offset from the point joined at, in half stroke\n"
     "     * widths; what lies further than one of them from it is cut away. */\n"
