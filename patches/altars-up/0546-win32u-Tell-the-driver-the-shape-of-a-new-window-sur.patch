From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 08:36:14 -0400
Subject: [PATCH] win32u: Tell the driver the shape of a new window surface at
 least once, even if it has none.

A window surface told the display driver about its shape only when the
shape changed, and the shape of a surface that has none never changes.
But the shape belongs to the window, which can have had another surface
before, with a shape: Word's main window asks for round corners, gets a
rounded shape while restored, and when maximized, where corners are not
rounded, gets a new surface with no shape bitmap.  The X window kept the
shape of the restored window, so Word showed only that much of itself.

The first flush of a surface that the driver takes now passes its
shape, or the lack of one, as changed.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index c2dd2f9e6d0..42b5659e37f 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -833,6 +833,9 @@ void window_surface_flush( struct window_surface *surface )
 
         if (surface->frame_radius) draw_surface_frame( surface, &dirty, color_info, color_bits );
         shape_changed = update_surface_shape( surface, &surface->rect, &dirty, color_info, color_bits );
+        /* the shape belongs to the window, which may have had another surface, shaped: a new
+         * surface tells the driver its own shape, or that it has none, at least once */
+        if (!surface->shape_flushed) shape_changed = TRUE;
         shape_bits = window_surface_get_shape( surface, shape_info );
 
         TRACE( "Flushing hwnd %p, surface %p %s, bounds %s, dirty %s\n", surface->hwnd, surface,
@@ -840,7 +843,10 @@ void window_surface_flush( struct window_surface *surface )
 
         if (surface->funcs->flush( surface, &surface->rect, &dirty, color_info, color_bits,
                                    shape_changed, shape_info, shape_bits ))
+        {
             reset_bounds( &surface->bounds );
+            surface->shape_flushed = TRUE;
+        }
     }
 
     window_surface_unlock( surface );
diff --git a/include/wine/gdi_driver.h b/include/wine/gdi_driver.h
index b90f77e939b..860d85d68e6 100644
--- a/include/wine/gdi_driver.h
+++ b/include/wine/gdi_driver.h
@@ -219,7 +219,7 @@ struct gdi_dc_funcs
 };
 
 /* increment this when you change the DC function table */
-#define WINE_GDI_DRIVER_VERSION 112
+#define WINE_GDI_DRIVER_VERSION 113
 
 #define GDI_PRIORITY_NULL_DRV        0  /* null driver */
 #define GDI_PRIORITY_FONT_DRV      100  /* any font driver */
@@ -327,6 +327,7 @@ struct window_surface
     UINT                               frame_border; /* width of the border it draws along the edge, in pixels */
     COLORREF                           frame_color;  /* colour of that border, CLR_INVALID if there is none */
     UINT32                            *frame_pixels; /* how much of each corner pixel the border covers */
+    BOOL                               shape_flushed; /* the driver has been given the surface's shape */
     /* driver-specific fields here */
 };
 
