From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 14:11:19 -0400
Subject: [PATCH] winex11: Draw the drop shadow Windows 11 gives a window with
 square corners whose class has CS_DROPSHADOW.

When shadows under windows are on, Windows 11 draws a soft black shadow to
the right of such a pop-up and below it: a rectangle from 7 pixels inside
the window's top left corner to 2 pixels past its bottom right one, blurred
with a sigma of 1.2 pixels, at half opacity (at 96 dpi).  The probe's window
differs from Windows by at most 2/255.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 275afecda7c..21ca1b47294 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -2397,7 +2397,7 @@ struct dwm_shadow_layer
 {
     float alpha;
     float sigma;    /* at 96 dpi */
-    float offset;   /* down, at 96 dpi */
+    float left, top, right, bottom;  /* how far its edges are from the window's, right and down, at 96 dpi */
 };
 
 struct dwm_shadow
@@ -2410,8 +2410,12 @@ struct dwm_shadow
 
 static const struct dwm_shadow dwm_shadows[] =
 {
-    { 8, { 44, 14, 44, 78 }, 2, { { 0.1445f, 7.08f, 1.98f }, { 0.1487f, 19.55f, 34.5f } } },  /* ROUND */
-    { 4, { 9, 1, 9, 18 }, 1, { { 0.0977f, 4.05f, 9.17f } } },                                 /* ROUNDSMALL */
+    /* ROUND */
+    { 8, { 44, 14, 44, 78 }, 2, { { 0.1445f, 7.08f, 0.0f, 1.98f, 0.0f, 1.98f }, { 0.1487f, 19.55f, 0.0f, 34.5f, 0.0f, 34.5f } } },
+    /* ROUNDSMALL */
+    { 4, { 9, 1, 9, 18 }, 1, { { 0.0977f, 4.05f, 0.0f, 9.17f, 0.0f, 9.17f } } },
+    /* CS_DROPSHADOW on a window with square corners: right and below it only */
+    { 0, { 0, 0, 6, 6 }, 1, { { 0.4973f, 1.217f, 7.0f, 7.0f, 2.0f, 2.0f } } },
 };
 
 static BOOL compositing_manager_running( Display *display )
@@ -2427,14 +2431,23 @@ static BOOL compositing_manager_running( Display *display )
     return XGetSelectionOwner( display, atom ) != None;
 }
 
-/* the shadow a window gets, if any: the kind by the radius of its corners in its DPI */
+/* the shadow a window gets, if any: the kind by the radius of its corners in its DPI; one with square
+ * corners whose class asks for a drop shadow gets the one Windows 11 draws for it, when shadows under
+ * windows are on */
 static const struct dwm_shadow *get_dwm_shadow( struct x11drv_win_data *data, struct window_surface *surface )
 {
     UINT dpi, radius;
+    BOOL enabled = FALSE;
 
-    if (!surface || !surface->frame_radius) return NULL;
+    if (!surface) return NULL;
     if (data->managed || data->embedded || data->parent || data->use_alpha || is_virtual_desktop()) return NULL;
     if (!argb_visual.visualid) return NULL;
+    if (!surface->frame_radius)
+    {
+        if (!(NtUserGetClassLongW( data->hwnd, GCL_STYLE ) & CS_DROPSHADOW)) return NULL;
+        if (!NtUserSystemParametersInfo( SPI_GETDROPSHADOW, 0, &enabled, 0 ) || !enabled) return NULL;
+        return &dwm_shadows[2];
+    }
     if (!(dpi = NtUserGetDpiForWindow( data->hwnd ))) dpi = USER_DEFAULT_SCREEN_DPI;
     radius = (surface->frame_radius * USER_DEFAULT_SCREEN_DPI + dpi / 2) / dpi;
     return radius >= 6 ? &dwm_shadows[0] : &dwm_shadows[1];
@@ -2494,13 +2507,14 @@ static void render_dwm_shadow( UINT32 *bits, int width, int height, const RECT *
     for (i = 0; i < shadow->count; i++)
     {
         const struct dwm_shadow_layer *layer = &shadow->layers[i];
-        float sigma = layer->sigma * scale, offset = layer->offset * scale;
+        float sigma = layer->sigma * scale;
 
         for (x = 0; x < width; x++)
-            fx[x] = dwm_shadow_phi( (x + 0.5f - window->left) / sigma ) - dwm_shadow_phi( (x + 0.5f - window->right) / sigma );
+            fx[x] = dwm_shadow_phi( (x + 0.5f - window->left - layer->left * scale) / sigma ) -
+                    dwm_shadow_phi( (x + 0.5f - window->right - layer->right * scale) / sigma );
         for (y = 0; y < height; y++)
-            fy[y] = dwm_shadow_phi( (y + 0.5f - window->top - offset) / sigma ) -
-                    dwm_shadow_phi( (y + 0.5f - window->bottom - offset) / sigma );
+            fy[y] = dwm_shadow_phi( (y + 0.5f - window->top - layer->top * scale) / sigma ) -
+                    dwm_shadow_phi( (y + 0.5f - window->bottom - layer->bottom * scale) / sigma );
         for (y = 0; y < height; y++) for (x = 0; x < width; x++)
             ((float *)bits)[y * width + x] *= 1.0f - layer->alpha * fx[x] * fy[y];
     }
