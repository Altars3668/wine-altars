From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 10:01:30 -0400
Subject: [PATCH] win32u: Forget the owner of another process's window when the
 owner is destroyed.

Destroying a window destroys the windows its thread has that it owns,
and leaves those of other threads owned by nothing, as Windows does.
For a window of another process Wine could not do the latter: it said
"cannot set owner (nil) on other process window", and the window kept a
handle to a window that no longer existed, the server too.  It happens
whenever a dialog of Word's that a WebView2 window is shown over closes.

The server's owner is cleared at once now, and the other process's own
copy when its thread gets the message that clears it there; until then
that process takes a cached owner that is no longer a window as gone and
asks the server, so GetWindow(GW_OWNER) and GetParent() answer NULL
straight away, as on Windows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 7b2c38cb714..1126a741bd6 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -710,9 +710,12 @@ HWND get_parent( HWND hwnd )
     }
     else
     {
-        if (win->dwStyle & WS_POPUP) retval = win->owner;
+        BOOL popup = win->dwStyle & WS_POPUP;
+
+        if (popup) retval = win->owner;
         else if (win->dwStyle & WS_CHILD) retval = win->parent;
         release_win_ptr( win );
+        if (popup && retval && !is_window( retval )) retval = get_window_relative( hwnd, GW_OWNER );
     }
     return retval;
 }
@@ -861,7 +864,10 @@ HWND get_window_relative( HWND hwnd, UINT rel )
         {
             retval = win->owner;
             release_win_ptr( win );
-            return retval;
+            /* an owner in another process that is destroyed clears the owner on the server
+             * before this thread hears of it */
+            if (!retval || is_window( retval )) return retval;
+            retval = 0;
         }
         /* else fall through to server call */
     }
@@ -1533,8 +1539,18 @@ static HWND set_window_owner( HWND hwnd, HWND owner )
     if (!win || win == WND_DESKTOP) return 0;
     if (win == WND_OTHER_PROCESS)
     {
-        if (is_window(hwnd)) ERR( "cannot set owner %p on other process window %p\n", owner, hwnd );
-        return 0;
+        /* the owner of another process's window changes on the server at once, and in that
+         * process when its thread gets the message; a destroyed owner leaves it owned by nothing */
+        SERVER_START_REQ( set_window_owner )
+        {
+            req->handle = wine_server_user_handle( hwnd );
+            req->owner  = wine_server_user_handle( owner );
+            if (!wine_server_call( req )) ret = wine_server_ptr_handle( reply->prev_owner );
+        }
+        SERVER_END_REQ;
+        send_notify_message( hwnd, WM_WINE_SETWINDOWLONG, MAKEWPARAM( GWLP_HWNDPARENT, sizeof(LONG_PTR) ),
+                             (LPARAM)owner, FALSE );
+        return ret;
     }
     SERVER_START_REQ( set_window_owner )
     {
