From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 15:43:12 -0400
Subject: [PATCH] netprofm: Register the network list interfaces as Windows
 does, so that their sinks can be marshaled.

Nothing registered INetworkListManagerEvents, INetworkEvents or INetworkConnectionEvents, and a sink living in
another apartment could not be advised: CoMarshalInterface failed with E_NOINTERFACE.  As on Windows 11, the
interfaces of the NETWORKLIST type library are marshaled through it (PSOAInterface, TypeLib {DCB00D01} 1.0), and
the cost interfaces, which are not automation compatible, through the proxies of class {DCB00009}.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/netprofm/Makefile.in b/dlls/netprofm/Makefile.in
index 64139c196cd..dd48afcbb71 100644
--- a/dlls/netprofm/Makefile.in
+++ b/dlls/netprofm/Makefile.in
@@ -8,4 +8,5 @@ SOURCES = \
 	netprofm.rc \
 	netprofm_tlb.idl
 
-dlldata_EXTRADEFS = -DENTRY_PREFIX=netprofm_ -DPROXY_DELEGATION
+dlldata_EXTRADEFS = -DENTRY_PREFIX=netprofm_ -DPROXY_DELEGATION -DWINE_REGISTER_DLL \
+	    -DPROXY_CLSID_IS="{0xdcb00009,0x570f,0x4a9b,{0x8d,0x69,0x19,0x9f,0xdb,0xa5,0x72,0x3b}}"
diff --git a/dlls/netprofm/netprofm.rc b/dlls/netprofm/netprofm.rc
index 50caf13993a..1e936ab878f 100644
--- a/dlls/netprofm/netprofm.rc
+++ b/dlls/netprofm/netprofm.rc
@@ -23,6 +23,9 @@
 
 #pragma makedep po
 
+/* the interfaces in the type library are marshaled through it, the cost ones through the proxies here */
+1 WINE_REGISTRY netprofm.rgs
+
 LANGUAGE LANG_ENGLISH, SUBLANG_DEFAULT
 
 STRINGTABLE
diff --git a/dlls/netprofm/netprofm.rgs b/dlls/netprofm/netprofm.rgs
new file mode 100644
index 00000000000..71f62c769a7
--- /dev/null
+++ b/dlls/netprofm/netprofm.rgs
@@ -0,0 +1,33 @@
+HKCR
+{
+    NoRemove Interface
+    {
+        '{DCB00008-570F-4A9B-8D69-199FDBA5723B}' = s 'INetworkCostManager'
+        {
+            NumMethods = s 6
+            ProxyStubClsid32 = s '{DCB00009-570F-4A9B-8D69-199FDBA5723B}'
+        }
+        '{DCB00009-570F-4A9B-8D69-199FDBA5723B}' = s 'INetworkCostManagerEvents'
+        {
+            NumMethods = s 5
+            ProxyStubClsid32 = s '{DCB00009-570F-4A9B-8D69-199FDBA5723B}'
+        }
+        '{DCB0000A-570F-4A9B-8D69-199FDBA5723B}' = s 'INetworkConnectionCost'
+        {
+            NumMethods = s 5
+            ProxyStubClsid32 = s '{DCB00009-570F-4A9B-8D69-199FDBA5723B}'
+        }
+        '{DCB0000B-570F-4A9B-8D69-199FDBA5723B}' = s 'INetworkConnectionCostEvents'
+        {
+            NumMethods = s 5
+            ProxyStubClsid32 = s '{DCB00009-570F-4A9B-8D69-199FDBA5723B}'
+        }
+    }
+    NoRemove CLSID
+    {
+        '{DCB00009-570F-4A9B-8D69-199FDBA5723B}' = s 'PSFactoryBuffer'
+        {
+            InprocServer32 = s '%MODULE%' { val ThreadingModel = s 'Both' }
+        }
+    }
+}
diff --git a/dlls/netprofm/netprofm_tlb.idl b/dlls/netprofm/netprofm_tlb.idl
index 2cd55cfda89..bed534ba38e 100644
--- a/dlls/netprofm/netprofm_tlb.idl
+++ b/dlls/netprofm/netprofm_tlb.idl
@@ -18,7 +18,7 @@
  * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
  */
 
-#pragma makedep typelib
+#pragma makedep regtypelib
 
 #include "netlistmgr.idl"
 
