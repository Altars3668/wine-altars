From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 10:47:56 -0400
Subject: [PATCH] msxml3: Offer IXMLDOMDocument3 only in MSXML 6.0.

IXMLDOMDocument3 is new in MSXML 6.0: on Windows a document of MSXML 3.0,
free-threaded or not, answers E_NOINTERFACE for it (tools/msxmlmoreprobe
in the wine-altars repository).  Its IDispatch is then that of
IXMLDOMDocument2, as the dispatch code invokes members through the
interface it describes, and the one internal user of IXMLDOMDocument3
needed only IXMLDOMDocument2's schemas.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/attribute.c b/dlls/msxml3/attribute.c
index 8eda004d7e1..6e87fc9c23e 100644
--- a/dlls/msxml3/attribute.c
+++ b/dlls/msxml3/attribute.c
@@ -350,17 +350,17 @@ static HRESULT WINAPI domattr_get_nodeTypedValue(IXMLDOMAttribute *iface, VARIAN
     hr = IXMLDOMAttribute_get_ownerDocument(iface, &doc);
     if (hr == S_OK)
     {
-        IXMLDOMDocument3 *doc3;
+        IXMLDOMDocument2 *doc2;
 
-        hr = IXMLDOMDocument_QueryInterface(doc, &IID_IXMLDOMDocument3, (void**)&doc3);
+        hr = IXMLDOMDocument_QueryInterface(doc, &IID_IXMLDOMDocument2, (void**)&doc2);
         IXMLDOMDocument_Release(doc);
 
         if (hr == S_OK)
         {
             VARIANT schemas;
 
-            hr = IXMLDOMDocument3_get_schemas(doc3, &schemas);
-            IXMLDOMDocument3_Release(doc3);
+            hr = IXMLDOMDocument2_get_schemas(doc2, &schemas);
+            IXMLDOMDocument2_Release(doc2);
 
             if (hr != S_OK)
                 return IXMLDOMAttribute_get_value(iface, value);
diff --git a/dlls/msxml3/domdoc.c b/dlls/msxml3/domdoc.c
index 13a3c43e570..58d7c2bff94 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -497,11 +497,17 @@ static HRESULT WINAPI domdoc_QueryInterface(IXMLDOMDocument3 *iface, REFIID riid
         IsEqualGUID(riid, &IID_IDispatch) ||
         IsEqualGUID(riid, &IID_IXMLDOMNode) ||
         IsEqualGUID(riid, &IID_IXMLDOMDocument) ||
-        IsEqualGUID(riid, &IID_IXMLDOMDocument2)||
-        IsEqualGUID(riid, &IID_IXMLDOMDocument3))
+        IsEqualGUID(riid, &IID_IXMLDOMDocument2))
     {
         *obj = iface;
     }
+    else if (IsEqualGUID(riid, &IID_IXMLDOMDocument3))
+    {
+        /* new in MSXML 6.0: MSXML 3.0 does not have it, free-threaded or not */
+        if (doc->node->properties->version < MSXML6)
+            return E_NOINTERFACE;
+        *obj = iface;
+    }
     else if (IsEqualGUID(&IID_IPersistStream, riid) ||
              IsEqualGUID(&IID_IPersistStreamInit, riid))
     {
@@ -2631,19 +2637,33 @@ static const IObjectSafetyVtbl domdocObjectSafetyVtbl = {
     domdoc_Safety_SetInterfaceSafetyOptions
 };
 
+/* a document's IDispatch is that of the interface its version has: MSXML 3.0 has no IXMLDOMDocument3 */
 static const tid_t domdoc_iface_tids[] =
 {
-    IXMLDOMDocument3_tid,
+    IXMLDOMDocument2_tid,
     0
 };
 
 static dispex_static_data_t domdoc_dispex = {
     NULL,
-    IXMLDOMDocument3_tid,
+    IXMLDOMDocument2_tid,
     NULL,
     domdoc_iface_tids
 };
 
+static const tid_t domdoc6_iface_tids[] =
+{
+    IXMLDOMDocument3_tid,
+    0
+};
+
+static dispex_static_data_t domdoc6_dispex = {
+    NULL,
+    IXMLDOMDocument3_tid,
+    NULL,
+    domdoc6_iface_tids
+};
+
 HRESULT dom_document_create(MSXML_VERSION version, void **obj)
 {
     struct domnode *node;
@@ -2687,7 +2707,8 @@ HRESULT create_domdoc(struct domnode *node, IUnknown **obj)
     ConnectionPoint_Init(&object->cp_propnotif, object, &IID_IPropertyNotifySink);
     ConnectionPoint_Init(&object->cp_domdocevents, object, &DIID_XMLDOMDocumentEvents);
 
-    init_dispex(&object->dispex, (IUnknown *)&object->IXMLDOMDocument3_iface, &domdoc_dispex);
+    init_dispex(&object->dispex, (IUnknown *)&object->IXMLDOMDocument3_iface,
+            node->properties->version >= MSXML6 ? &domdoc6_dispex : &domdoc_dispex);
 
     *obj = (IUnknown *)&object->IXMLDOMDocument3_iface;
 
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index a2538a514c3..920231ea0a4 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -18620,7 +18620,46 @@ static void test_prohibitdtd(void)
 
 static void test_interfaces(void)
 {
+    static const struct
+    {
+        const GUID *clsid;
+        const char *name;
+        BOOL document3;
+    }
+    classes[] =
+    {
+        { &_create(CLSID_DOMDocument2) },
+        { &_create(CLSID_DOMDocument30) },
+        { &_create(CLSID_FreeThreadedDOMDocument) },
+        { &_create(CLSID_DOMDocument60), TRUE },
+    };
+    DISPPARAMS params = { 0 };
     IXMLDOMDocument *doc;
+    OLECHAR *name;
+    unsigned int i;
+    DISPID dispid;
+    HRESULT hr;
+    VARIANT v;
+
+    /* IXMLDOMDocument3 is new in MSXML 6.0; a document is a dispatch object either way */
+    for (i = 0; i < ARRAY_SIZE(classes); i++)
+    {
+        if (!is_clsid_supported(classes[i].clsid, &IID_IXMLDOMDocument)) continue;
+        winetest_push_context("%s", classes[i].name);
+        doc = _create_object(classes[i].clsid, classes[i].name, &IID_IXMLDOMDocument, __LINE__);
+        check_interface(doc, &IID_IXMLDOMDocument2, TRUE);
+        check_interface(doc, &IID_IXMLDOMDocument3, classes[i].document3);
+        name = (OLECHAR *)L"async";
+        hr = IXMLDOMDocument_GetIDsOfNames(doc, &IID_NULL, &name, 1, LOCALE_USER_DEFAULT, &dispid);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        V_VT(&v) = VT_EMPTY;
+        hr = IXMLDOMDocument_Invoke(doc, dispid, &IID_NULL, LOCALE_USER_DEFAULT, DISPATCH_PROPERTYGET, &params,
+                &v, NULL, NULL);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(V_VT(&v) == VT_BOOL && V_BOOL(&v) == VARIANT_TRUE, "Unexpected value %s.\n", wine_dbgstr_variant(&v));
+        IXMLDOMDocument_Release(doc);
+        winetest_pop_context();
+    }
 
     doc = create_document(&IID_IXMLDOMDocument);
 
