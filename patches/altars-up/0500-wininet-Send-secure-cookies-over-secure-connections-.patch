From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 20:15:51 -0400
Subject: [PATCH] wininet: Send secure cookies over secure connections only,
 and take SameSite.

A cookie with the Secure attribute was kept as any other, with a FIXME,
and SameSite was an unknown option.  Windows 11 keeps a secure cookie
for https only, wherever it was set, and takes SameSite whatever it
says, keeping the cookie as it is (tools/startupgapsprobe misc5).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wininet/cookie.c b/dlls/wininet/cookie.c
index b729bc00072..d7a1b1e07f2 100644
--- a/dlls/wininet/cookie.c
+++ b/dlls/wininet/cookie.c
@@ -501,7 +501,7 @@ static BOOL save_persistent_cookie(cookie_container_t *container)
     return CommitUrlCacheEntryW(container->cookie_url, cookie_file, time, time, 0, NULL, 0, L"txt", 0);
 }
 
-static BOOL cookie_parse_url(const WCHAR *url, substr_t *host, substr_t *path)
+static BOOL cookie_parse_url(const WCHAR *url, substr_t *host, substr_t *path, BOOL *secure)
 {
     URL_COMPONENTSW comp = { sizeof(comp) };
 
@@ -511,6 +511,9 @@ static BOOL cookie_parse_url(const WCHAR *url, substr_t *host, substr_t *path)
     if(!InternetCrackUrlW(url, 0, 0, &comp) || !comp.dwHostNameLength)
         return FALSE;
 
+    if(secure)
+        *secure = comp.nScheme == INTERNET_SCHEME_HTTPS;
+
     /* discard the webpage off the end of the path */
     while(comp.dwUrlPathLength && comp.lpszUrlPath[comp.dwUrlPathLength-1] != '/')
         comp.dwUrlPathLength--;
@@ -528,7 +531,8 @@ typedef struct {
     unsigned string_len;
 } cookie_set_t;
 
-static DWORD get_cookie(substr_t host, substr_t path, DWORD flags, cookie_set_t *res)
+/* the cookies for a host and path; the secure ones only over a secure connection */
+static DWORD get_cookie(substr_t host, substr_t path, BOOL secure, DWORD flags, cookie_set_t *res)
 {
     const WCHAR *p;
     cookie_domain_t *domain;
@@ -582,6 +586,9 @@ static DWORD get_cookie(substr_t host, substr_t path, DWORD flags, cookie_set_t
                 if((cookie_iter->flags & INTERNET_COOKIE_HTTPONLY) && !(flags & INTERNET_COOKIE_HTTPONLY))
                     continue;
 
+                if((cookie_iter->flags & INTERNET_COOKIE_IS_SECURE) && !secure)
+                    continue;
+
                 if(!res->size) {
                     res->cookies = malloc(4 * sizeof(*res->cookies));
                     if(!res->cookies)
@@ -639,7 +646,7 @@ static void cookie_set_to_string(const cookie_set_t *cookie_set, WCHAR *str)
     TRACE("%s\n", debugstr_wn(str, ptr-str));
 }
 
-DWORD get_cookie_header(const WCHAR *host, const WCHAR *path, WCHAR **ret)
+DWORD get_cookie_header(const WCHAR *host, const WCHAR *path, BOOL secure, WCHAR **ret)
 {
     cookie_set_t cookie_set = {0};
     DWORD res;
@@ -648,7 +655,7 @@ DWORD get_cookie_header(const WCHAR *host, const WCHAR *path, WCHAR **ret)
 
     EnterCriticalSection(&cookie_cs);
 
-    res = get_cookie(substrz(host), substrz(path), INTERNET_COOKIE_HTTPONLY, &cookie_set);
+    res = get_cookie(substrz(host), substrz(path), secure, INTERNET_COOKIE_HTTPONLY, &cookie_set);
     if(res != ERROR_SUCCESS) {
         LeaveCriticalSection(&cookie_cs);
         return res;
@@ -727,8 +734,8 @@ BOOL WINAPI InternetGetCookieExW(LPCWSTR lpszUrl, LPCWSTR lpszCookieName,
 {
     cookie_set_t cookie_set = {0};
     substr_t host, path;
+    BOOL ret, secure;
     DWORD res;
-    BOOL ret;
 
     TRACE("(%s, %s, %p, %p, %lx, %p)\n", debugstr_w(lpszUrl),debugstr_w(lpszCookieName), lpCookieData, lpdwSize, flags, reserved);
 
@@ -741,7 +748,7 @@ BOOL WINAPI InternetGetCookieExW(LPCWSTR lpszUrl, LPCWSTR lpszCookieName,
         return FALSE;
     }
 
-    ret = cookie_parse_url(lpszUrl, &host, &path);
+    ret = cookie_parse_url(lpszUrl, &host, &path, &secure);
     if (!ret) {
         SetLastError(ERROR_INVALID_PARAMETER);
         return FALSE;
@@ -749,7 +756,7 @@ BOOL WINAPI InternetGetCookieExW(LPCWSTR lpszUrl, LPCWSTR lpszCookieName,
 
     EnterCriticalSection(&cookie_cs);
 
-    res = get_cookie(host, path, flags, &cookie_set);
+    res = get_cookie(host, path, secure, flags, &cookie_set);
     if(res != ERROR_SUCCESS) {
         LeaveCriticalSection(&cookie_cs);
         SetLastError(res);
@@ -937,6 +944,7 @@ DWORD set_cookie(substr_t domain, substr_t path, substr_t name, substr_t data, D
         static const WCHAR szHttpOnly[] = {'h','t','t','p','o','n','l','y'};
         static const WCHAR szVersion[] = {'v','e','r','s','i','o','n','='};
         static const WCHAR max_ageW[] = {'m','a','x','-','a','g','e','='};
+        static const WCHAR samesiteW[] = {'s','a','m','e','s','i','t','e','='};
 
         /* Skip ';' */
         if(data.len)
@@ -986,8 +994,9 @@ DWORD set_cookie(substr_t domain, substr_t path, substr_t name, substr_t data, D
                 }
             }
         }else if(data.len >= (len = ARRAY_SIZE(szSecure)) && !wcsnicmp(data.str, szSecure, len)) {
+            /* sent over secure connections only, wherever it came from */
             substr_skip(&data, len);
-            FIXME("secure not handled\n");
+            cookie_flags |= INTERNET_COOKIE_IS_SECURE;
         }else if(data.len >= (len = ARRAY_SIZE(szHttpOnly)) && !wcsnicmp(data.str, szHttpOnly, len)) {
             substr_skip(&data, len);
 
@@ -1005,6 +1014,9 @@ DWORD set_cookie(substr_t domain, substr_t path, substr_t name, substr_t data, D
         }else if(data.len >= (len = ARRAY_SIZE(max_ageW)) && !wcsnicmp(data.str, max_ageW, len)) {
             /* Native doesn't support Max-Age attribute. */
             WARN("Max-Age ignored\n");
+        }else if(data.len >= (len = ARRAY_SIZE(samesiteW)) && !wcsnicmp(data.str, samesiteW, len)) {
+            /* a request of its own is no site's; Windows 11 takes any value and keeps the cookie as it is */
+            TRACE("SameSite %s\n", debugstr_wn(data.str + len, end_ptr - data.str - len));
         }else if(data.len) {
             FIXME("Unknown additional option %s\n", debugstr_wn(data.str, data.len));
         }
@@ -1096,7 +1108,7 @@ DWORD WINAPI InternetSetCookieExW(LPCWSTR lpszUrl, LPCWSTR lpszCookieName,
         return COOKIE_STATE_UNKNOWN;
     }
 
-    ret = cookie_parse_url(lpszUrl, &host, &path);
+    ret = cookie_parse_url(lpszUrl, &host, &path, NULL);
     if (!ret || !host.len) return COOKIE_STATE_UNKNOWN;
 
     if (!lpszCookieName) {
diff --git a/dlls/wininet/http.c b/dlls/wininet/http.c
index afb6502bc8b..cc0b6f9b57f 100644
--- a/dlls/wininet/http.c
+++ b/dlls/wininet/http.c
@@ -4399,7 +4399,8 @@ static void HTTP_InsertCookies(http_request_t *request)
     WCHAR *cookies;
     DWORD res;
 
-    res = get_cookie_header(request->server->name, request->path, &cookies);
+    res = get_cookie_header(request->server->name, request->path,
+                            !!(request->hdr.dwFlags & INTERNET_FLAG_SECURE), &cookies);
     if(res != ERROR_SUCCESS || !cookies)
         return;
 
diff --git a/dlls/wininet/internet.h b/dlls/wininet/internet.h
index 89eb86b8ee4..a1c589090b8 100644
--- a/dlls/wininet/internet.h
+++ b/dlls/wininet/internet.h
@@ -388,7 +388,7 @@ DWORD HTTP_Connect(appinfo_t*,LPCWSTR,
 server_addr_t *GetAddress(const WCHAR*,INTERNET_PORT);
 int create_connect_socket(server_addr_t*,int,DWORD,object_header_t*,DWORD_PTR);
 
-DWORD get_cookie_header(const WCHAR*,const WCHAR*,WCHAR**);
+DWORD get_cookie_header(const WCHAR*,const WCHAR*,BOOL,WCHAR**);
 DWORD set_cookie(substr_t,substr_t,substr_t,substr_t,DWORD);
 
 void INTERNET_SetLastError(DWORD dwError);
diff --git a/dlls/wininet/tests/internet.c b/dlls/wininet/tests/internet.c
index a5325c05cbb..e27dc3f1e6a 100644
--- a/dlls/wininet/tests/internet.c
+++ b/dlls/wininet/tests/internet.c
@@ -816,6 +816,34 @@ static void test_cookie_attrs(void)
 
 }
 
+/* a secure cookie is sent over https only, wherever it was set; SameSite is taken whatever it says */
+static void test_cookie_secure(void)
+{
+    static const WCHAR https[] = L"https://wine-cookie-test.invalid/", http[] = L"http://wine-cookie-test.invalid/";
+    WCHAR buffer[256];
+    DWORD size, ret;
+
+    ret = InternetSetCookieExW( https, NULL, L"a=1; secure", 0, 0 );
+    ok( ret == COOKIE_STATE_ACCEPT, "got %lu\n", ret );
+    ret = InternetSetCookieExW( http, NULL, L"b=2; Secure; SameSite=Strict", 0, 0 );
+    ok( ret == COOKIE_STATE_ACCEPT, "got %lu\n", ret );
+    ret = InternetSetCookieExW( https, NULL, L"c=3; samesite=none", 0, 0 );
+    ok( ret == COOKIE_STATE_ACCEPT, "got %lu\n", ret );
+
+    size = ARRAY_SIZE(buffer);
+    ret = InternetGetCookieExW( https, NULL, buffer, &size, 0, NULL );
+    ok( ret, "InternetGetCookieEx failed, error %lu\n", GetLastError() );
+    ok( !wcscmp( buffer, L"a=1; b=2; c=3" ), "got %s\n", wine_dbgstr_w(buffer) );
+    size = ARRAY_SIZE(buffer);
+    ret = InternetGetCookieExW( http, NULL, buffer, &size, 0, NULL );
+    ok( ret, "InternetGetCookieEx failed, error %lu\n", GetLastError() );
+    ok( !wcscmp( buffer, L"c=3" ), "got %s\n", wine_dbgstr_w(buffer) );
+
+    InternetSetCookieExW( https, NULL, L"a=; expires=Thu, 01 Jan 1970 00:00:00 GMT", 0, 0 );
+    InternetSetCookieExW( https, NULL, L"b=; expires=Thu, 01 Jan 1970 00:00:00 GMT", 0, 0 );
+    InternetSetCookieExW( https, NULL, L"c=; expires=Thu, 01 Jan 1970 00:00:00 GMT", 0, 0 );
+}
+
 static void test_cookie_url(void)
 {
     char long_url[5000] = "http://long.url.test.com/", *p;
@@ -2084,6 +2112,7 @@ START_TEST(internet)
     test_complicated_cookie();
     test_cookie_url();
     test_cookie_attrs();
+    test_cookie_secure();
     test_version();
     test_null();
     test_Option_PerConnectionOption();
