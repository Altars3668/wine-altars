From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 15:37:52 -0400
Subject: [PATCH] kernelbase: Add TlsGetValue2 and FlsGetValue2.

The Windows 11 24H2 getters return the value like TlsGetValue and
FlsGetValue but leave the last error alone.  Office's AI component
looks FlsGetValue2 up in kernelbase.  The tests pass on Windows 11
build 29671.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 7d3052f0a7ad69b9a228747b27a14b49540793b8)

diff --git a/dlls/kernel32/kernel32.spec b/dlls/kernel32/kernel32.spec
index 96da6be043f..a94c9ac8510 100644
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -525,6 +525,7 @@
 @ stdcall -import FlsAlloc(ptr)
 @ stdcall -import FlsFree(long)
 @ stdcall -import FlsGetValue(long)
+@ stdcall -import FlsGetValue2(long)
 @ stdcall -import FlsSetValue(long ptr)
 @ stdcall -import FlushConsoleInputBuffer(long)
 @ stdcall -import FlushFileBuffers(long)
@@ -1562,6 +1563,7 @@
 @ stdcall -import TlsFree(long)
 @ stdcall -import TlsFreeInternal(long) TlsFree
 @ stdcall -import TlsGetValue(long)
+@ stdcall -import TlsGetValue2(long)
 @ stdcall -import TlsSetValue(long ptr)
 @ stdcall Toolhelp32ReadProcessMemory(long ptr ptr long ptr)
 @ stdcall -import TransactNamedPipe(long ptr long ptr long ptr ptr)
diff --git a/dlls/kernel32/tests/thread.c b/dlls/kernel32/tests/thread.c
index 31514af4f93..902a4ad1784 100644
--- a/dlls/kernel32/tests/thread.c
+++ b/dlls/kernel32/tests/thread.c
@@ -76,6 +76,8 @@
 #endif
 
 static void (WINAPI *pGetCurrentThreadStackLimits)(PULONG_PTR,PULONG_PTR);
+static void *(WINAPI *pTlsGetValue2)(DWORD);
+static void *(WINAPI *pFlsGetValue2)(DWORD);
 static BOOL (WINAPI *pGetThreadPriorityBoost)(HANDLE,PBOOL);
 static BOOL (WINAPI *pGetProcessPriorityBoost)(HANDLE,PBOOL);
 static HANDLE (WINAPI *pOpenThread)(DWORD,BOOL,DWORD);
@@ -2031,6 +2033,50 @@ static unsigned int get_thread_fpu_cw( unsigned long *fpu_cw )
     return ctx.cw;
 }
 
+/* the Windows 11 24H2 getters, which leave the last error alone */
+static void test_get_value2(void)
+{
+    DWORD tls, fls;
+    void *value;
+
+    if (!pTlsGetValue2 || !pFlsGetValue2)
+    {
+        win_skip("TlsGetValue2 or FlsGetValue2 is not available\n");
+        return;
+    }
+
+    tls = TlsAlloc();
+    ok(tls != TLS_OUT_OF_INDEXES, "TlsAlloc failed\n");
+    TlsSetValue(tls, (void *)0x1234);
+    SetLastError(0xdeadbeef);
+    value = pTlsGetValue2(tls);
+    ok(value == (void *)0x1234, "got %p\n", value);
+    ok(GetLastError() == 0xdeadbeef, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    value = TlsGetValue(tls);
+    ok(value == (void *)0x1234, "got %p\n", value);
+    ok(GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError());
+    TlsSetValue(tls, NULL);
+    SetLastError(0xdeadbeef);
+    value = pTlsGetValue2(tls);
+    ok(!value, "got %p\n", value);
+    ok(GetLastError() == 0xdeadbeef, "got error %lu\n", GetLastError());
+    TlsFree(tls);
+
+    fls = FlsAlloc(NULL);
+    ok(fls != FLS_OUT_OF_INDEXES, "FlsAlloc failed\n");
+    FlsSetValue(fls, (void *)0x5678);
+    SetLastError(0xdeadbeef);
+    value = pFlsGetValue2(fls);
+    ok(value == (void *)0x5678, "got %p\n", value);
+    ok(GetLastError() == 0xdeadbeef, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    value = FlsGetValue(fls);
+    ok(value == (void *)0x5678, "got %p\n", value);
+    ok(GetLastError() == ERROR_SUCCESS, "got error %lu\n", GetLastError());
+    FlsFree(fls);
+}
+
 static void test_thread_fpu_cw(void)
 {
     static const struct {
@@ -2636,6 +2682,8 @@ static void init_funcs(void)
 
 #define X(f) p##f = (void*)GetProcAddress(hKernel32, #f)
     X(GetCurrentThreadStackLimits);
+    X(TlsGetValue2);
+    X(FlsGetValue2);
     X(GetThreadPriorityBoost);
     X(GetProcessPriorityBoost);
     X(OpenThread);
@@ -2835,6 +2883,7 @@ START_TEST(thread)
    test_QueueUserWorkItem();
    test_RegisterWaitForSingleObject();
    test_TLS();
+   test_get_value2();
    test_FLS();
    test_ThreadErrorMode();
    test_thread_fpu_cw();
diff --git a/dlls/kernelbase/kernelbase.spec b/dlls/kernelbase/kernelbase.spec
index eadf4c4e9e6..c207ac1c257 100644
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -388,6 +388,7 @@
 @ stdcall FlsAlloc(ptr)
 @ stdcall FlsFree(long)
 @ stdcall FlsGetValue(long)
+@ stdcall FlsGetValue2(long)
 @ stdcall FlsSetValue(long ptr)
 @ stdcall FlushConsoleInputBuffer(long)
 @ stdcall FlushFileBuffers(long)
@@ -1652,6 +1653,7 @@
 @ stdcall TlsAlloc()
 @ stdcall TlsFree(long)
 @ stdcall TlsGetValue(long)
+@ stdcall TlsGetValue2(long)
 @ stdcall TlsSetValue(long ptr)
 @ stdcall TraceEvent(int64 ptr) ntdll.EtwLogTraceEvent
 @ varargs TraceMessage(int64 long ptr long) ntdll.EtwTraceMessage
diff --git a/dlls/kernelbase/thread.c b/dlls/kernelbase/thread.c
index 7470b43b12e..9a9be344fab 100644
--- a/dlls/kernelbase/thread.c
+++ b/dlls/kernelbase/thread.c
@@ -776,6 +776,22 @@ LPVOID WINAPI DECLSPEC_HOTPATCH TlsGetValue( DWORD index )
 }
 
 
+/**********************************************************************
+ *           TlsGetValue2   (kernelbase.@)
+ *
+ * TlsGetValue without setting the last error.
+ */
+LPVOID WINAPI DECLSPEC_HOTPATCH TlsGetValue2( DWORD index )
+{
+    if (index < TLS_MINIMUM_AVAILABLE) return NtCurrentTeb()->TlsSlots[index];
+
+    index -= TLS_MINIMUM_AVAILABLE;
+    if (index >= 8 * sizeof(NtCurrentTeb()->Peb->TlsExpansionBitmapBits)) return NULL;
+    if (!NtCurrentTeb()->TlsExpansionSlots) return NULL;
+    return NtCurrentTeb()->TlsExpansionSlots[index];
+}
+
+
 /**********************************************************************
  *           TlsSetValue   (kernelbase.@)
  */
@@ -1274,6 +1290,20 @@ PVOID WINAPI DECLSPEC_HOTPATCH FlsGetValue( DWORD index )
 }
 
 
+/***********************************************************************
+ *           FlsGetValue2   (kernelbase.@)
+ *
+ * FlsGetValue without setting the last error.
+ */
+PVOID WINAPI DECLSPEC_HOTPATCH FlsGetValue2( DWORD index )
+{
+    void *data;
+
+    if (RtlFlsGetValue( index, &data )) return NULL;
+    return data;
+}
+
+
 /***********************************************************************
  *           FlsSetValue   (kernelbase.@)
  */
