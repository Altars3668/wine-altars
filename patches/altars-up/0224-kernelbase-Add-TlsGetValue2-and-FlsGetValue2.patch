+WINBASEAPI void *WINAPI FlsGetValue2(DWORD);
 WINBASEAPI BOOL  WINAPI FlsSetValue(DWORD,void*);
 WINBASEAPI BOOL  WINAPI IsThreadAFiber(void);
 
