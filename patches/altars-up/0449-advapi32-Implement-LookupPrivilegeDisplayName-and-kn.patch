+/* the length asked for has the terminator, the length given has not; the text is in the user's language */
+static void test_lookupPrivilegeDisplayName(void)
+{
+    WCHAR buf[256], name[64];
+    char bufA[256];
+    DWORD len, lang, size, i;
+    LUID luid;
+    BOOL ret;
+
+    len = 0;
+    lang = 0xdead;
+    SetLastError( 0xdeadbeef );
+    ret = LookupPrivilegeDisplayNameW( NULL, L"SeDebugPrivilege", NULL, &len, &lang );
+    ok( !ret && GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %d, error %lu\n", ret, GetLastError() );
+    ok( len > 1, "got length %lu\n", len );
+    ok( lang != 0xdead, "got language %#lx\n", lang );
+    size = len;
+
+    len = ARRAY_SIZE(buf);
+    lang = 0xdead;
+    ret = LookupPrivilegeDisplayNameW( L"", L"sedebugprivilege", buf, &len, &lang );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ok( len == size - 1 && len == wcslen( buf ), "got length %lu, %s\n", len, wine_dbgstr_w(buf) );
+    if (PRIMARYLANGID( lang ) == LANG_ENGLISH)
+        ok( !wcscmp( buf, L"Debug programs" ), "got %s\n", wine_dbgstr_w(buf) );
+
+    len = 3;
+    SetLastError( 0xdeadbeef );
+    ret = LookupPrivilegeDisplayNameW( NULL, L"SeDebugPrivilege", buf, &len, &lang );
+    ok( !ret && GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %d, error %lu\n", ret, GetLastError() );
+    ok( len == size, "got length %lu\n", len );
+
+    len = ARRAY_SIZE(buf);
+    lang = 0xdead;
+    SetLastError( 0xdeadbeef );
+    ret = LookupPrivilegeDisplayNameW( NULL, L"SeBogusPrivilege", buf, &len, &lang );
+    ok( !ret && GetLastError() == ERROR_NO_SUCH_PRIVILEGE, "got %d, error %lu\n", ret, GetLastError() );
+    ok( len == ARRAY_SIZE(buf) && lang == 0xdead, "got length %lu, language %#lx\n", len, lang );
+    SetLastError( 0xdeadbeef );
+    ret = LookupPrivilegeDisplayNameW( NULL, NULL, buf, &len, &lang );
+    ok( !ret && GetLastError() == ERROR_NO_SUCH_PRIVILEGE, "got %d, error %lu\n", ret, GetLastError() );
+
+    /* every privilege has one */
+    for (i = SE_MIN_WELL_KNOWN_PRIVILEGE; i <= SE_MAX_WELL_KNOWN_PRIVILEGE; i++)
+    {
+        luid.LowPart = i;
+        luid.HighPart = 0;
+        len = ARRAY_SIZE(name);
+        if (!LookupPrivilegeNameW( NULL, &luid, name, &len )) continue;
+        len = ARRAY_SIZE(buf);
+        ret = LookupPrivilegeDisplayNameW( NULL, name, buf, &len, &lang );
+        ok( ret && len, "%s: got %d, error %lu\n", wine_dbgstr_w(name), ret, GetLastError() );
+    }
+
+    /* the ANSI call asks for the wide length, and gives the length in bytes */
+    len = 0;
+    SetLastError( 0xdeadbeef );
+    ret = LookupPrivilegeDisplayNameA( NULL, "SeDebugPrivilege", NULL, &len, &lang );
+    ok( !ret && GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %d, error %lu\n", ret, GetLastError() );
+    ok( len == size, "got length %lu\n", len );
+    len = sizeof(bufA);
+    ret = LookupPrivilegeDisplayNameA( NULL, "SeDebugPrivilege", bufA, &len, &lang );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ok( len == strlen( bufA ), "got length %lu, %s\n", len, debugstr_a(bufA) );
+}
