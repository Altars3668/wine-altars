-BOOL WINAPI LookupPrivilegeDisplayNameA( LPCSTR lpSystemName, LPCSTR lpName, LPSTR lpDisplayName,
+/* the privilege's text in the user's language when there is one, and that language */
+static int load_privilege_display_name( DWORD luid, const WCHAR **str, LANGID *lang )
+{
+    HMODULE module = GetModuleHandleW( L"advapi32.dll" );
+
+    *lang = GetUserDefaultUILanguage();
+    if (!FindResourceExW( module, (const WCHAR *)RT_STRING, MAKEINTRESOURCEW( (luid >> 4) + 1 ), *lang ))
+        *lang = MAKELANGID( LANG_ENGLISH, SUBLANG_DEFAULT );
+    return LoadStringW( module, luid, (WCHAR *)str, 0 );
+}
+
+/******************************************************************************
+ * LookupPrivilegeDisplayNameW			[ADVAPI32.@]
+ *
+ * As on Windows 11 (tools/privprobe, privnames.c): asked for its size, the text's length with its terminator and
+ * ERROR_INSUFFICIENT_BUFFER, with the language already given; then its length without; ERROR_NO_SUCH_PRIVILEGE for
+ * a name that is none.
+ */
+BOOL WINAPI LookupPrivilegeDisplayNameW( LPCWSTR lpSystemName, LPCWSTR lpName, LPWSTR lpDisplayName,
                                          LPDWORD cchDisplayName, LPDWORD lpLanguageId )
 {
-    FIXME("%s %s %s %p %p - stub\n", debugstr_a(lpSystemName), debugstr_a(lpName),
+    const WCHAR *str;
+    LANGID lang;
+    LUID luid;
+    int len;
+
+    TRACE("%s %s %p %p %p\n", debugstr_w(lpSystemName), debugstr_w(lpName),
           lpDisplayName, cchDisplayName, lpLanguageId);
 
-    return FALSE;
+    if (!ADVAPI_IsLocalComputer( lpSystemName ))
+    {
+        SetLastError( RPC_S_SERVER_UNAVAILABLE );
+        return FALSE;
+    }
+    if (!lpName || !LookupPrivilegeValueW( NULL, lpName, &luid ) ||
+        !(len = load_privilege_display_name( luid.LowPart, &str, &lang )))
+    {
+        SetLastError( ERROR_NO_SUCH_PRIVILEGE );
+        return FALSE;
+    }
+    if (!cchDisplayName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (lpLanguageId) *lpLanguageId = lang;
+    if (!lpDisplayName || *cchDisplayName <= len)
+    {
+        *cchDisplayName = len + 1;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    memcpy( lpDisplayName, str, len * sizeof(WCHAR) );
+    lpDisplayName[len] = 0;
+    *cchDisplayName = len;
+    return TRUE;
 }
 
-BOOL WINAPI LookupPrivilegeDisplayNameW( LPCWSTR lpSystemName, LPCWSTR lpName, LPWSTR lpDisplayName,
+/******************************************************************************
+ * LookupPrivilegeDisplayNameA			[ADVAPI32.@]
+ *
+ * Asked for its size, it gives the wide text's length, as Windows does; the text it gives is in the ANSI code page,
+ * and its length is in bytes.
+ */
+BOOL WINAPI LookupPrivilegeDisplayNameA( LPCSTR lpSystemName, LPCSTR lpName, LPSTR lpDisplayName,
                                          LPDWORD cchDisplayName, LPDWORD lpLanguageId )
 {
-    FIXME("%s %s %p %p %p - stub\n", debugstr_w(lpSystemName), debugstr_w(lpName),
+    UNICODE_STRING system, name;
+    WCHAR buf[256];
+    DWORD len = ARRAY_SIZE(buf);
+    BOOL ret;
+    int size;
+
+    TRACE("%s %s %p %p %p\n", debugstr_a(lpSystemName), debugstr_a(lpName),
           lpDisplayName, cchDisplayName, lpLanguageId);
 
-    return FALSE;
+    RtlCreateUnicodeStringFromAsciiz( &system, lpSystemName );
+    RtlCreateUnicodeStringFromAsciiz( &name, lpName );
+    ret = LookupPrivilegeDisplayNameW( system.Buffer, lpName ? name.Buffer : NULL, buf, &len, lpLanguageId );
+    RtlFreeUnicodeString( &system );
+    RtlFreeUnicodeString( &name );
+    if (!ret) return FALSE;
+
+    if (!cchDisplayName)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+    if (!lpDisplayName)
+    {
+        *cchDisplayName = len + 1;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    size = WideCharToMultiByte( CP_ACP, 0, buf, -1, NULL, 0, NULL, NULL );
+    if (*cchDisplayName < size)
+    {
+        *cchDisplayName = size;
+        SetLastError( ERROR_INSUFFICIENT_BUFFER );
+        return FALSE;
+    }
+    WideCharToMultiByte( CP_ACP, 0, buf, -1, lpDisplayName, *cchDisplayName, NULL, NULL );
+    *cchDisplayName = size - 1;
+    return TRUE;
 }
 
 /******************************************************************************
