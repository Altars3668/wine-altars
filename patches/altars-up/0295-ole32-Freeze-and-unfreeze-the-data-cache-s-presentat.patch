From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 22:08:19 -0400
Subject: [PATCH] ole32: Freeze and unfreeze the data cache's presentations.

IViewObject::Freeze() and Unfreeze() were E_NOTIMPL stubs.  A frozen
aspect keeps its presentation when the running object's data changes,
until it is unfrozen; only an aspect the cache has a presentation for
can be frozen, OLE_E_BLANK otherwise, as ole32's tests measured on
Windows.  As documented, freezing an aspect again gives the cookie it
was frozen with and VIEW_S_ALREADY_FROZEN, and a cookie that is not
frozen does not unfreeze, OLE_E_NOCONNECTION; the tests for those are
not measured yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ole32/datacache.c b/dlls/ole32/datacache.c
index 2c0d8d1c513..be0d6788892 100644
--- a/dlls/ole32/datacache.c
+++ b/dlls/ole32/datacache.c
@@ -165,10 +165,22 @@ struct DataCache
   BOOL dirty;
   /* running object set by OnRun */
   IDataObject *running_object;
+  /* presentations frozen by IViewObject::Freeze() */
+  struct list freezes;
+  DWORD last_freeze;
 };
 
 typedef struct DataCache DataCache;
 
+/* an aspect whose presentation the running object's changes leave alone until it is unfrozen */
+struct view_freeze
+{
+  struct list entry;
+  DWORD cookie;
+  DWORD aspect;
+  LONG lindex;
+};
+
 /*
  * Here, I define utility macros to help with the casting of the
  * "this" parameter.
@@ -262,6 +274,7 @@ static void DataCache_Destroy(
   DataCache* ptrToDestroy)
 {
   DataCacheEntry *cache_entry, *next_cache_entry;
+  struct view_freeze *freeze, *next_freeze;
 
   TRACE("()\n");
 
@@ -274,6 +287,9 @@ static void DataCache_Destroy(
   LIST_FOR_EACH_ENTRY_SAFE(cache_entry, next_cache_entry, &ptrToDestroy->cache_list, DataCacheEntry, entry)
     DataCacheEntry_Destroy(ptrToDestroy, cache_entry);
 
+  LIST_FOR_EACH_ENTRY_SAFE(freeze, next_freeze, &ptrToDestroy->freezes, struct view_freeze, entry)
+    free(freeze);
+
   if (ptrToDestroy->presentationStorage != NULL)
   {
     IStorage_Release(ptrToDestroy->presentationStorage);
@@ -2166,6 +2182,18 @@ static HRESULT WINAPI DataCache_GetColorSet(
   return E_NOTIMPL;
 }
 
+static BOOL is_frozen(DataCache *This, DWORD aspect, LONG lindex)
+{
+  struct view_freeze *freeze;
+
+  LIST_FOR_EACH_ENTRY(freeze, &This->freezes, struct view_freeze, entry)
+    if (freeze->aspect == aspect && freeze->lindex == lindex)
+      return TRUE;
+  return FALSE;
+}
+
+/* A frozen presentation stays as it is when the running object's data changes, until it is unfrozen;
+ * only a presentation the cache has can be frozen. */
 static HRESULT WINAPI DataCache_Freeze(
             IViewObject2*   iface,
 	    DWORD           dwDrawAspect,
@@ -2173,16 +2201,68 @@ static HRESULT WINAPI DataCache_Freeze(
 	    void*           pvAspect,
 	    DWORD*          pdwFreeze)
 {
-  FIXME("stub\n");
-  return E_NOTIMPL;
+  DataCache *This = impl_from_IViewObject2(iface);
+  DataCacheEntry *cache_entry;
+  struct view_freeze *freeze;
+
+  TRACE("%p, %#lx, %ld, %p, %p.\n", iface, dwDrawAspect, lindex, pvAspect, pdwFreeze);
+
+  if (!pdwFreeze)
+    return E_INVALIDARG;
+  if (dwDrawAspect != DVASPECT_CONTENT && dwDrawAspect != DVASPECT_THUMBNAIL &&
+      dwDrawAspect != DVASPECT_ICON && dwDrawAspect != DVASPECT_DOCPRINT)
+    return DV_E_DVASPECT;
+  if (lindex != -1)
+    return DV_E_LINDEX;
+
+  LIST_FOR_EACH_ENTRY(freeze, &This->freezes, struct view_freeze, entry)
+  {
+    if (freeze->aspect == dwDrawAspect && freeze->lindex == lindex)
+    {
+      *pdwFreeze = freeze->cookie;
+      return VIEW_S_ALREADY_FROZEN;
+    }
+  }
+
+  LIST_FOR_EACH_ENTRY(cache_entry, &This->cache_list, DataCacheEntry, entry)
+  {
+    if (cache_entry->fmtetc.dwAspect == dwDrawAspect && cache_entry->fmtetc.lindex == lindex &&
+        (cache_entry->stgmedium.tymed != TYMED_NULL || cache_entry->load_stream_num != STREAM_NUMBER_NOT_SET))
+      break;
+  }
+  if (&cache_entry->entry == &This->cache_list)
+    return OLE_E_BLANK;
+
+  if (!(freeze = malloc(sizeof(*freeze))))
+    return E_OUTOFMEMORY;
+  if (!++This->last_freeze) This->last_freeze++;
+  freeze->cookie = This->last_freeze;
+  freeze->aspect = dwDrawAspect;
+  freeze->lindex = lindex;
+  list_add_tail(&This->freezes, &freeze->entry);
+  *pdwFreeze = freeze->cookie;
+  return S_OK;
 }
 
 static HRESULT WINAPI DataCache_Unfreeze(
             IViewObject2*   iface,
 	    DWORD           dwFreeze)
 {
-  FIXME("stub\n");
-  return E_NOTIMPL;
+  DataCache *This = impl_from_IViewObject2(iface);
+  struct view_freeze *freeze;
+
+  TRACE("%p, %lu.\n", iface, dwFreeze);
+
+  LIST_FOR_EACH_ENTRY(freeze, &This->freezes, struct view_freeze, entry)
+  {
+    if (freeze->cookie == dwFreeze)
+    {
+      list_remove(&freeze->entry);
+      free(freeze);
+      return S_OK;
+    }
+  }
+  return OLE_E_NOCONNECTION;
 }
 
 /************************************************************************
@@ -2861,6 +2941,11 @@ static void WINAPI DataCache_OnDataChange(IAdviseSink *iface, FORMATETC *fmt, ST
 {
     DataCache *This = impl_from_IAdviseSink(iface);
     TRACE("(%p)->(%s, %p)\n", This, debugstr_formatetc(fmt), med);
+    if (is_frozen(This, fmt->dwAspect, fmt->lindex))
+    {
+        TRACE("aspect %#lx is frozen\n", fmt->dwAspect);
+        return;
+    }
     IOleCache2_SetData(&This->IOleCache2_iface, fmt, med, FALSE);
 }
 
@@ -3013,6 +3098,7 @@ static DataCache* DataCache_Construct(
   newObject->clsid_static = FALSE;
   newObject->presentationStorage = NULL;
   list_init(&newObject->cache_list);
+  list_init(&newObject->freezes);
   newObject->last_cache_id = 2;
   newObject->dirty = FALSE;
   newObject->running_object = NULL;
diff --git a/dlls/ole32/tests/ole2.c b/dlls/ole32/tests/ole2.c
index 6bfcc1fbb92..90da1c060a5 100644
--- a/dlls/ole32/tests/ole2.c
+++ b/dlls/ole32/tests/ole2.c
@@ -1573,7 +1573,7 @@ static void test_data_cache(void)
     FORMATETC fmtetc;
     STGMEDIUM stgmedium;
     DWORD dwConnection;
-    DWORD dwFreeze;
+    DWORD dwFreeze, dwFreeze2;
     RECTL rcBounds;
     HDC hdcMem;
     CLSID clsid;
@@ -1765,11 +1765,17 @@ static void test_data_cache(void)
     ReleaseStgMedium(&stgmedium);
 
     hr = IViewObject_Freeze(pViewObject, DVASPECT_ICON, -1, NULL, &dwFreeze);
-    todo_wine {
     ok_ole_success(hr, "IViewObject_Freeze");
-    hr = IViewObject_Freeze(pViewObject, DVASPECT_CONTENT, -1, NULL, &dwFreeze);
+    hr = IViewObject_Freeze(pViewObject, DVASPECT_CONTENT, -1, NULL, &dwFreeze2);
     ok(hr == OLE_E_BLANK, "IViewObject_Freeze with uncached aspect should have returned OLE_E_BLANK instead of 0x%08lx\n", hr);
-    }
+    dwFreeze2 = 0xdeadbeef;
+    hr = IViewObject_Freeze(pViewObject, DVASPECT_ICON, -1, NULL, &dwFreeze2);
+    ok(hr == VIEW_S_ALREADY_FROZEN, "Got hr %#lx.\n", hr);
+    ok(dwFreeze2 == dwFreeze, "Got freeze %lu, expected %lu.\n", dwFreeze2, dwFreeze);
+    hr = IViewObject_Unfreeze(pViewObject, dwFreeze);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    hr = IViewObject_Unfreeze(pViewObject, dwFreeze);
+    ok(hr == OLE_E_NOCONNECTION, "Got hr %#lx.\n", hr);
 
     rcBounds.left = 0;
     rcBounds.top = 0;
