+/* a child with the policies given at its creation, asked from outside while it waits to start */
+static void test_creation_policies(void)
+{
+    DWORD64 options[2] = { (1ull << 52) | (1ull << 56) | (2ull << 16), (1ull << 16) | (1ull << 24) };
+    STARTUPINFOEXA si = { { sizeof(si) } };
+    PROCESS_INFORMATION pi;
+    char **argv, cmdline[MAX_PATH + 64];
+    DWORD flags, child = PROCESS_CREATION_CHILD_PROCESS_RESTRICTED;
+    SIZE_T size = 0;
+    BOOL ret;
+
+    winetest_get_mainargs(&argv);
+    InitializeProcThreadAttributeList(NULL, 2, 0, &size);
+    si.lpAttributeList = malloc(size);
+    InitializeProcThreadAttributeList(si.lpAttributeList, 2, 0, &size);
+    ret = UpdateProcThreadAttribute(si.lpAttributeList, 0, PROC_THREAD_ATTRIBUTE_MITIGATION_POLICY, options,
+                                    sizeof(options), NULL, NULL);
+    ok(ret, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = UpdateProcThreadAttribute(si.lpAttributeList, 0, PROC_THREAD_ATTRIBUTE_CHILD_PROCESS_POLICY, options,
+                                    sizeof(DWORD64), NULL, NULL);
+    ok(!ret && GetLastError() == ERROR_BAD_LENGTH, "got %d, error %lu\n", ret, GetLastError());
+    ret = UpdateProcThreadAttribute(si.lpAttributeList, 0, PROC_THREAD_ATTRIBUTE_CHILD_PROCESS_POLICY, &child,
+                                    sizeof(child), NULL, NULL);
+    ok(ret, "got error %lu\n", GetLastError());
+
+    sprintf(cmdline, "\"%s\" process restricted", argv[0]);
+    ret = CreateProcessA(NULL, cmdline, NULL, NULL, FALSE, EXTENDED_STARTUPINFO_PRESENT | CREATE_SUSPENDED, NULL,
+                         NULL, &si.StartupInfo, &pi);
+    ok(ret, "got error %lu\n", GetLastError());
+    flags = 0xdeadbeef;
+    ret = GetProcessMitigationPolicy(pi.hProcess, ProcessImageLoadPolicy, &flags, sizeof(flags));
+    ok(ret && flags == 3, "got %d, flags %#lx\n", ret, flags);
+    /* high entropy ASLR goes with bottom-up ASLR */
+    flags = 0xdeadbeef;
+    ret = GetProcessMitigationPolicy(pi.hProcess, ProcessASLRPolicy, &flags, sizeof(flags));
+    ok(ret && !flags, "got %d, flags %#lx\n", ret, flags);
+    flags = 0xdeadbeef;
+    ret = GetProcessMitigationPolicy(pi.hProcess, ProcessSideChannelIsolationPolicy, &flags, sizeof(flags));
+    ok(ret && flags == 9, "got %d, flags %#lx\n", ret, flags);
+    flags = 0xdeadbeef;
+    ret = GetProcessMitigationPolicy(pi.hProcess, ProcessChildProcessPolicy, &flags, sizeof(flags));
+    ok(ret && flags == 1, "got %d, flags %#lx\n", ret, flags);
+    ResumeThread(pi.hThread);
+    wait_child_process(&pi);
+    CloseHandle(pi.hProcess);
+    CloseHandle(pi.hThread);
+    DeleteProcThreadAttributeList(si.lpAttributeList);
+    free(si.lpAttributeList);
+}
+
+/* a child that may not start processes of its own */
+static void test_restricted_child(void)
+{
+    STARTUPINFOA si = { sizeof(si) };
+    PROCESS_INFORMATION pi;
+    char cmdline[] = "cmd.exe /c exit 0";
+    BOOL ret;
+
+    SetLastError(0xdeadbeef);
+    ret = CreateProcessA(NULL, cmdline, NULL, NULL, FALSE, CREATE_NO_WINDOW, NULL, NULL, &si, &pi);
+    ok(!ret && GetLastError() == ERROR_CHILD_PROCESS_BLOCKED, "got %d, error %lu\n", ret, GetLastError());
+    if (ret)
+    {
+        WaitForSingleObject(pi.hProcess, 5000);
+        CloseHandle(pi.hProcess);
+        CloseHandle(pi.hThread);
+    }
+}
+
 static void run_child(const char *test)
 {
     STARTUPINFOA si = { sizeof(si) };
@@ -816,6 +896,11 @@ START_TEST(process)
         test_mitigation_policies();
         return;
     }
+    if (argc > 2 && !strcmp(argv[2], "restricted"))
+    {
+        test_restricted_child();
+        return;
+    }
 
     test_CompareObjectHandles();
     test_MapViewOfFile3();
@@ -830,4 +915,5 @@ START_TEST(process)
     test_GetMachineTypeAttributes();
     test_QueryThreadCycleTime();
     run_child("mitigation");
+    test_creation_policies();
 }
diff --git a/dlls/ntdll/unix/process.c b/dlls/ntdll/unix/process.c
index d66f190b5f1..693eeb1d67f 100644
--- a/dlls/ntdll/unix/process.c
+++ b/dlls/ntdll/unix/process.c
@@ -680,6 +680,153 @@ static NTSTATUS alloc_handle_list( const PS_ATTRIBUTE *handles_attr, obj_handle_
     return STATUS_SUCCESS;
 }
 
+/* The mitigation policies a process starts with, unless it is created with others: ASLR for everything and of
+ * high entropy for a 64-bit process, shadow stack APIs kept out of process, and SEH overwrite protection.
+ * Policies can be added to while the process runs, not taken back; ASLR cannot be changed at all.  The server
+ * keeps those that were set, so that other processes see them too. */
+static PROCESS_POWER_THROTTLING_STATE power_throttling = { PROCESS_POWER_THROTTLING_CURRENT_VERSION };
+
+static DWORD default_mitigation_flags( PROCESS_MITIGATION_POLICY policy, USHORT machine )
+{
+    switch (policy)
+    {
+    case ProcessASLRPolicy:
+        return 0x1 /* EnableBottomUpRandomization */ |
+               (machine == IMAGE_FILE_MACHINE_AMD64 || machine == IMAGE_FILE_MACHINE_ARM64 ? 0x4 /* EnableHighEntropy */ : 0);
+    case ProcessUserShadowStackPolicy:
+        return 0x100; /* CetDynamicApisOutOfProcOnly */
+    case ProcessSEHOPPolicy:
+        return 0x1; /* EnableSehop */
+    default:
+        return 0;
+    }
+}
+
+/* whether a handle names this process; the others are only asked of */
+static BOOL is_this_process( HANDLE handle )
+{
+    PROCESS_BASIC_INFORMATION pbi;
+
+    if (handle == NtCurrentProcess()) return TRUE;
+    if (NtQueryInformationProcess( handle, ProcessBasicInformation, &pbi, sizeof(pbi), NULL )) return FALSE;
+    return pbi.UniqueProcessId == HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+}
+
+static NTSTATUS get_mitigation_policy( HANDLE handle, PROCESS_MITIGATION_POLICY_INFORMATION *info )
+{
+    NTSTATUS status;
+
+    if (info->Policy >= MaxProcessMitigationPolicy || info->Policy == ProcessDEPPolicy ||
+        info->Policy == ProcessMitigationOptionsMask)
+        return STATUS_INVALID_PARAMETER;
+    SERVER_START_REQ( get_process_mitigation )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        req->policy = info->Policy;
+        if (!(status = wine_server_call( req )))
+        {
+            /* pointer authentication is an ARM64 feature */
+            if (info->Policy == ProcessUserPointerAuthPolicy && reply->machine != IMAGE_FILE_MACHINE_ARM64)
+                status = STATUS_NOT_SUPPORTED;
+            else if (reply->set) info->ASLRPolicy.Flags = reply->flags;
+            else info->ASLRPolicy.Flags = default_mitigation_flags( info->Policy, reply->machine );
+        }
+    }
+    SERVER_END_REQ;
+    return status;
+}
+
+static NTSTATUS put_mitigation_policy( HANDLE handle, PROCESS_MITIGATION_POLICY policy, DWORD flags )
+{
+    NTSTATUS status;
+
+    SERVER_START_REQ( set_process_mitigation )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        req->policy = policy;
+        req->flags  = flags;
+        status = wine_server_call( req );
+    }
+    SERVER_END_REQ;
+    return status;
+}
+
+static NTSTATUS set_mitigation_policy( HANDLE handle, const PROCESS_MITIGATION_POLICY_INFORMATION *info )
+{
+    PROCESS_MITIGATION_POLICY_INFORMATION current = { .Policy = info->Policy };
+    NTSTATUS status;
+
+    if (!is_this_process( handle )) return STATUS_ACCESS_DENIED;
+    if ((status = get_mitigation_policy( handle, &current ))) return status;
+    if (info->Policy == ProcessASLRPolicy) return STATUS_ACCESS_DENIED;
+    if (current.ASLRPolicy.Flags & ~info->ASLRPolicy.Flags) return STATUS_ACCESS_DENIED;
+    if (info->ASLRPolicy.Flags & ~current.ASLRPolicy.Flags)
+    {
+        static unsigned int once;
+        if (!once++) FIXME( "mitigation policy %u %#x is kept, not enforced\n", info->Policy, (int)info->ASLRPolicy.Flags );
+    }
+    return put_mitigation_policy( handle, info->Policy, info->ASLRPolicy.Flags );
+}
+
+/* the policies of a process created with mitigation options (PROCESS_CREATION_MITIGATION_POLICY_*) and a child
+ * process policy (PROCESS_CREATION_CHILD_PROCESS_*), as Windows 11 turns them into policies; each mitigation option
+ * is two bits, mostly on, off, or one more choice; the options left out change nothing that can be asked for */
+static void set_creation_mitigations( HANDLE process, USHORT machine, const ULONG64 options[2], DWORD child )
+{
+    DWORD flags[MaxProcessMitigationPolicy];
+    unsigned int i;
+
+#define OPTION(word,shift)  ((options[word] >> (shift)) & 3)
+#define TURN(option,policy,on,off)  do { if ((option) == 1) flags[policy] |= (on); \
+                                         else if ((option) == 2) flags[policy] &= ~(off); } while (0)
+
+    for (i = 0; i < MaxProcessMitigationPolicy; i++) flags[i] = default_mitigation_flags( i, machine );
+
+    if (options[0] & 0x4) flags[ProcessSEHOPPolicy] |= 0x1;                   /* SEHOP_ENABLE */
+    TURN( OPTION( 0, 8 ), ProcessASLRPolicy, 0x2, 0x2 );                     /* EnableForceRelocateImages */
+    if (OPTION( 0, 8 ) == 3) flags[ProcessASLRPolicy] |= 0x2 | 0x8;          /* and DisallowStrippedImages */
+    TURN( OPTION( 0, 16 ), ProcessASLRPolicy, 0x1, 0x1 );                    /* EnableBottomUpRandomization */
+    TURN( OPTION( 0, 20 ), ProcessASLRPolicy, 0x4, 0x4 );                    /* EnableHighEntropy */
+    if (!(flags[ProcessASLRPolicy] & 0x1)) flags[ProcessASLRPolicy] &= ~0x4; /* which needs bottom-up ASLR */
+    TURN( OPTION( 0, 24 ), ProcessStrictHandleCheckPolicy, 0x3, 0x3 );       /* raise on bad handles, for good */
+    TURN( OPTION( 0, 28 ), ProcessSystemCallDisablePolicy, 0x1, 0x1 );       /* DisallowWin32kSystemCalls */
+    TURN( OPTION( 0, 32 ), ProcessExtensionPointDisablePolicy, 0x1, 0x1 );
+    TURN( OPTION( 0, 36 ), ProcessDynamicCodePolicy, 0x1, 0x1 );             /* ProhibitDynamicCode */
+    if (OPTION( 0, 36 ) == 3) flags[ProcessDynamicCodePolicy] |= 0x1 | 0x2;  /* and AllowThreadOptOut */
+    TURN( OPTION( 0, 40 ), ProcessControlFlowGuardPolicy, 0x1, 0x1 );        /* EnableControlFlowGuard */
+    TURN( OPTION( 0, 44 ), ProcessSignaturePolicy, 0x5, 0x5 );               /* MicrosoftSignedOnly, opted in */
+    if (OPTION( 0, 44 ) == 3) flags[ProcessSignaturePolicy] |= 0x2 | 0x4;    /* StoreSignedOnly, opted in */
+    TURN( OPTION( 0, 48 ), ProcessFontDisablePolicy, 0x1, 0x1 );             /* DisableNonSystemFonts */
+    if (OPTION( 0, 48 ) == 3) flags[ProcessFontDisablePolicy] |= 0x2;        /* AuditNonSystemFontLoading */
+    TURN( OPTION( 0, 52 ), ProcessImageLoadPolicy, 0x1, 0x1 );               /* NoRemoteImages */
+    TURN( OPTION( 0, 56 ), ProcessImageLoadPolicy, 0x2, 0x2 );               /* NoLowMandatoryLabelImages */
+    TURN( OPTION( 0, 60 ), ProcessImageLoadPolicy, 0x4, 0x4 );               /* PreferSystem32Images */
+    TURN( OPTION( 1, 16 ), ProcessSideChannelIsolationPolicy, 0x1, 0x1 );    /* SmtBranchTargetIsolation */
+    TURN( OPTION( 1, 20 ), ProcessDynamicCodePolicy, 0x4, 0x4 );             /* AllowRemoteDowngrade */
+    TURN( OPTION( 1, 24 ), ProcessSideChannelIsolationPolicy, 0x8, 0x8 );    /* SpeculativeStoreBypassDisable */
+    TURN( OPTION( 1, 28 ), ProcessUserShadowStackPolicy, 0x5, 0x5 );         /* shadow stacks, context IPs checked */
+    TURN( OPTION( 1, 48 ), ProcessUserShadowStackPolicy, 0x100, 0x100 );     /* CetDynamicApisOutOfProcOnly */
+    TURN( OPTION( 1, 52 ), ProcessSideChannelIsolationPolicy, 0x10, 0x10 );  /* RestrictCoreSharing */
+    TURN( OPTION( 1, 56 ), ProcessSystemCallDisablePolicy, 0x4, 0x4 );       /* DisallowFsctlSystemCalls */
+
+#undef TURN
+#undef OPTION
+
+    /* PROCESS_CREATION_CHILD_PROCESS_RESTRICTED, and the exception for secure processes with it */
+    if (child & 0x1) flags[ProcessChildProcessPolicy] = 0x1 | (child & 0x4);
+
+    for (i = 0; i < MaxProcessMitigationPolicy; i++)
+        if (flags[i] != default_mitigation_flags( i, machine )) put_mitigation_policy( process, i, flags[i] );
+}
+
+/* whether this process may not create child processes */
+static BOOL child_processes_blocked(void)
+{
+    PROCESS_MITIGATION_POLICY_INFORMATION info = { .Policy = ProcessChildProcessPolicy };
+
+    return !get_mitigation_policy( NtCurrentProcess(), &info ) && info.ChildProcessPolicy.NoChildProcessCreation;
+}
+
