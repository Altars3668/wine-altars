+/* retrieve a mitigation policy of a process */
+DECL_HANDLER(get_process_mitigation)
+{
+    struct process *process;
+
+    if (req->policy >= ARRAY_SIZE(process->mitigation))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if (!(process = get_process_from_handle( req->handle, PROCESS_QUERY_LIMITED_INFORMATION ))) return;
+    reply->set = (process->mitigation_set >> req->policy) & 1;
+    reply->flags = reply->set ? process->mitigation[req->policy] : 0;
+    reply->machine = process->machine;
+    release_object( process );
+}
+
+/* set a mitigation policy of a process */
+DECL_HANDLER(set_process_mitigation)
+{
+    struct process *process;
+
+    if (req->policy >= ARRAY_SIZE(process->mitigation))
+    {
+        set_error( STATUS_INVALID_PARAMETER );
+        return;
+    }
+    if (!(process = get_process_from_handle( req->handle, PROCESS_SET_INFORMATION ))) return;
+    process->mitigation[req->policy] = req->flags;
+    process->mitigation_set |= 1u << req->policy;
+    release_object( process );
+}
+
