+    str = create_hstring( L"{\"a\":}" );
+    hr = IJsonObjectStatics_Parse( object_statics, str, &object );
+    ok( hr == WEB_E_INVALID_JSON_STRING, "got hr %#lx.\n", hr );
+    succeeded = TRUE;
+    hr = IJsonObjectStatics_TryParse( object_statics, str, &object, &succeeded );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( succeeded == FALSE, "got succeeded %d.\n", succeeded );
+    succeeded = TRUE;
+    value = (void *)0xdeadbeef;
+    hr = IJsonValueStatics_TryParse( value_statics, str, &value, &succeeded );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( succeeded == FALSE, "got succeeded %d.\n", succeeded );
+    ok( !value, "got value %p.\n", value );
+    WindowsDeleteString( str );
+
+    succeeded = TRUE;
+    hr = IJsonObjectStatics_TryParse( object_statics, NULL, &object, &succeeded );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( succeeded == FALSE, "got succeeded %d.\n", succeeded );
+
+    str = create_hstring( L" \"Wine\" " );
+    hr = IJsonValueStatics_TryParse( value_statics, str, NULL, &succeeded );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    succeeded = FALSE;
+    hr = IJsonValueStatics_TryParse( value_statics, str, &value, &succeeded );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( succeeded == TRUE, "got succeeded %d.\n", succeeded );
+    if (succeeded)
+    {
+        check_stringify( value, L"\"Wine\"" );
+        IJsonValue_Release( value );
+    }
+    WindowsDeleteString( str );
+
+    hr = IJsonValueStatics2_CreateNullValue( value_statics2, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    hr = IJsonValueStatics2_CreateNullValue( value_statics2, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IJsonValue_get_ValueType( value, &type );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( type == JsonValueType_Null, "got type %d.\n", type );
+    check_class_name( value, L"Windows.Data.Json.JsonValue" );
+    check_stringify( value, L"null" );
+    IJsonValue_Release( value );
+
+done:
+    if (object_statics) IJsonObjectStatics_Release( object_statics );
+    if (array_statics) IJsonArrayStatics_Release( array_statics );
+    if (value_statics) IJsonValueStatics_Release( value_statics );
+    if (value_statics2) IJsonValueStatics2_Release( value_statics2 );
+}
