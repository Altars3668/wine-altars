+static void test_JsonObjectCollection(void)
+{
+    IIterable_IKeyValuePair_HSTRING_IJsonValue *iterable;
+    IIterator_IKeyValuePair_HSTRING_IJsonValue *iterator;
+    IJsonObjectWithDefaultValues *defaults;
+    IMapView_HSTRING_IJsonValue *view, *first, *second;
+    IKeyValuePair_HSTRING_IJsonValue *pair;
+    IJsonValueStatics *value_statics;
+    IMap_HSTRING_IJsonValue *map;
+    IJsonValue *value, *one, *two;
+    IJsonObject *object, *other;
+    HSTRING a, b, x, key;
+    boolean found, replaced;
+    JsonValueType type;
+    UINT32 size;
+    DOUBLE number;
+    HRESULT hr;
+
+    if (!(value_statics = get_json_statics( L"Windows.Data.Json.JsonValue", &IID_IJsonValueStatics )))
+    {
+        win_skip( "JsonValue statics not available, skipping tests.\n" );
+        return;
+    }
+    if (!(object = activate_json( L"Windows.Data.Json.JsonObject", &IID_IJsonObject )))
+    {
+        IJsonValueStatics_Release( value_statics );
+        return;
+    }
+
+    check_interface( object, &IID_IMap_HSTRING_IJsonValue );
+    check_interface( object, &IID_IIterable_IKeyValuePair_HSTRING_IJsonValue );
+    check_interface( object, &IID_IJsonObjectWithDefaultValues );
+    check_interface( object, &IID_IStringable );
+    check_class_name( object, L"Windows.Data.Json.JsonObject" );
+    check_stringify( object, L"{}" );
+
+    /* the object is a value */
+    hr = IJsonObject_QueryInterface( object, &IID_IJsonValue, (void **)&value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IJsonValue_get_ValueType( value, &type );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( type == JsonValueType_Object, "got type %d.\n", type );
+    hr = IJsonValue_GetObject( value, &other );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( other == object, "got object %p, expected %p.\n", other, object );
+    IJsonObject_Release( other );
+    hr = IJsonValue_GetString( value, &key );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    hr = IJsonValue_GetNumber( value, &number );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    hr = IJsonValue_GetArray( value, NULL );
+    ok( hr == E_POINTER, "got hr %#lx.\n", hr );
+    IJsonValue_Release( value );
+
+    hr = IJsonObject_QueryInterface( object, &IID_IMap_HSTRING_IJsonValue, (void **)&map );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    a = create_hstring( L"a" );
+    b = create_hstring( L"b" );
+    x = create_hstring( L"x" );
+    hr = IJsonValueStatics_CreateNumberValue( value_statics, 1, &one );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IJsonValueStatics_CreateNumberValue( value_statics, 2, &two );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    replaced = TRUE;
+    hr = IMap_HSTRING_IJsonValue_Insert( map, b, one, &replaced );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( replaced == FALSE, "got replaced %d.\n", replaced );
+    replaced = TRUE;
+    hr = IMap_HSTRING_IJsonValue_Insert( map, a, two, &replaced );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( replaced == FALSE, "got replaced %d.\n", replaced );
+    replaced = FALSE;
+    hr = IMap_HSTRING_IJsonValue_Insert( map, b, two, &replaced );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( replaced == TRUE, "got replaced %d.\n", replaced );
+    hr = IMap_HSTRING_IJsonValue_get_Size( map, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( size == 2, "got size %u.\n", size );
+    check_stringify( object, L"{\"a\":2,\"b\":2}" );
+
+    hr = IMap_HSTRING_IJsonValue_Lookup( map, a, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( value == two, "got value %p, expected %p.\n", value, two );
+    IJsonValue_Release( value );
+    value = (void *)0xdeadbeef;
+    hr = IMap_HSTRING_IJsonValue_Lookup( map, x, &value );
+    ok( hr == E_BOUNDS, "got hr %#lx.\n", hr );
+    found = TRUE;
+    hr = IMap_HSTRING_IJsonValue_HasKey( map, x, &found );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( found == FALSE, "got found %d.\n", found );
+    hr = IMap_HSTRING_IJsonValue_HasKey( map, b, &found );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( found == TRUE, "got found %d.\n", found );
+
+    /* the members come in the order of their names */
+    hr = IJsonObject_QueryInterface( object, &IID_IIterable_IKeyValuePair_HSTRING_IJsonValue, (void **)&iterable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IIterable_IKeyValuePair_HSTRING_IJsonValue_First( iterable, &iterator );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IIterable_IKeyValuePair_HSTRING_IJsonValue_Release( iterable );
+    hr = IIterator_IKeyValuePair_HSTRING_IJsonValue_get_HasCurrent( iterator, &found );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( found == TRUE, "got found %d.\n", found );
+    hr = IIterator_IKeyValuePair_HSTRING_IJsonValue_get_Current( iterator, &pair );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IKeyValuePair_HSTRING_IJsonValue_get_Key( pair, &key );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_hstring( key, L"a" );
+    WindowsDeleteString( key );
+    IKeyValuePair_HSTRING_IJsonValue_Release( pair );
+    hr = IIterator_IKeyValuePair_HSTRING_IJsonValue_MoveNext( iterator, &found );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( found == TRUE, "got found %d.\n", found );
+    hr = IIterator_IKeyValuePair_HSTRING_IJsonValue_get_Current( iterator, &pair );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IKeyValuePair_HSTRING_IJsonValue_get_Key( pair, &key );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_hstring( key, L"b" );
+    WindowsDeleteString( key );
+    hr = IKeyValuePair_HSTRING_IJsonValue_get_Value( pair, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( value == two, "got value %p, expected %p.\n", value, two );
+    IJsonValue_Release( value );
+    IKeyValuePair_HSTRING_IJsonValue_Release( pair );
+    hr = IIterator_IKeyValuePair_HSTRING_IJsonValue_MoveNext( iterator, &found );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( found == FALSE, "got found %d.\n", found );
+    hr = IIterator_IKeyValuePair_HSTRING_IJsonValue_get_Current( iterator, &pair );
+    ok( hr == E_BOUNDS, "got hr %#lx.\n", hr );
+    IIterator_IKeyValuePair_HSTRING_IJsonValue_Release( iterator );
+
+    hr = IMap_HSTRING_IJsonValue_GetView( map, &view );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IMapView_HSTRING_IJsonValue_get_Size( view, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( size == 2, "got size %u.\n", size );
+    hr = IMapView_HSTRING_IJsonValue_Lookup( view, b, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IJsonValue_Release( value );
+    hr = IMapView_HSTRING_IJsonValue_Lookup( view, x, &value );
+    ok( hr == E_BOUNDS, "got hr %#lx.\n", hr );
+    hr = IMapView_HSTRING_IJsonValue_Split( view, &first, &second );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( first && second, "got first %p, second %p.\n", first, second );
+    if (first && second)
+    {
+        hr = IMapView_HSTRING_IJsonValue_HasKey( first, a, &found );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( found == TRUE, "got found %d.\n", found );
+        hr = IMapView_HSTRING_IJsonValue_HasKey( second, a, &found );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( found == FALSE, "got found %d.\n", found );
+        IMapView_HSTRING_IJsonValue_Release( first );
+        IMapView_HSTRING_IJsonValue_Release( second );
+    }
+
+    hr = IMap_HSTRING_IJsonValue_Remove( map, x );
+    ok( hr == E_BOUNDS, "got hr %#lx.\n", hr );
+    hr = IMap_HSTRING_IJsonValue_Remove( map, a );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IMap_HSTRING_IJsonValue_get_Size( map, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( size == 1, "got size %u.\n", size );
+    /* the view is what the object was */
+    hr = IMapView_HSTRING_IJsonValue_get_Size( view, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( size == 2, "got size %u.\n", size );
+    IMapView_HSTRING_IJsonValue_Release( view );
+
+    hr = IJsonObject_QueryInterface( object, &IID_IJsonObjectWithDefaultValues, (void **)&defaults );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IJsonObjectWithDefaultValues_GetNamedNumberOrDefault( defaults, x, 5, &number );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( number == 5, "got number %f.\n", number );
+    hr = IJsonObjectWithDefaultValues_GetNamedNumberOrDefault( defaults, b, 5, &number );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( number == 2, "got number %f.\n", number );
+    hr = IJsonObjectWithDefaultValues_GetNamedStringOrDefault( defaults, x, a, &key );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_hstring( key, L"a" );
+    WindowsDeleteString( key );
+    hr = IJsonObjectWithDefaultValues_GetNamedStringOrDefault( defaults, b, a, &key );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    hr = IJsonObjectWithDefaultValues_GetNamedValueOrDefault( defaults, x, one, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( value == one, "got value %p, expected %p.\n", value, one );
+    IJsonValue_Release( value );
+    hr = IJsonObjectWithDefaultValues_GetNamedObjectOrDefault( defaults, x, NULL, &other );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !other, "got object %p.\n", other );
+    IJsonObjectWithDefaultValues_Release( defaults );
+
+    hr = IMap_HSTRING_IJsonValue_Clear( map );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IMap_HSTRING_IJsonValue_get_Size( map, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( size == 0, "got size %u.\n", size );
+
+    /* objects nest */
+    hr = IJsonObject_SetNamedValue( object, a, one );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    other = activate_json( L"Windows.Data.Json.JsonObject", &IID_IJsonObject );
+    hr = IJsonObject_QueryInterface( object, &IID_IJsonValue, (void **)&value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IJsonObject_SetNamedValue( other, x, value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IJsonValue_Release( value );
+    check_stringify( other, L"{\"x\":{\"a\":1}}" );
+    hr = IJsonObject_GetNamedObject( other, x, &object );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IJsonObject_Release( object );
+    IJsonObject_Release( other );
+
+    WindowsDeleteString( a );
+    WindowsDeleteString( b );
+    WindowsDeleteString( x );
+    IJsonValue_Release( one );
+    IJsonValue_Release( two );
+    IMap_HSTRING_IJsonValue_Release( map );
+    IJsonObject_Release( object );
+    IJsonValueStatics_Release( value_statics );
+}
