+};
+
+static inline struct json_pair *impl_from_IKeyValuePair_HSTRING_IJsonValue( IKeyValuePair_HSTRING_IJsonValue *iface )
+{
+    return CONTAINING_RECORD( iface, struct json_pair, IKeyValuePair_HSTRING_IJsonValue_iface );
+}
