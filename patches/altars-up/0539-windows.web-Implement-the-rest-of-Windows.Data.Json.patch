+
+HRESULT json_array_append_json( struct strbuf *buf, struct json_array *array, UINT depth )
+{
+    IInspectable **items;
+    HRESULT hr = S_OK;
+    UINT32 count, i;
+
+    if (depth >= JSON_MAX_DEPTH) return JSON_E_IMPLEMENTATION_LIMIT;
+    if ((count = vector_snapshot( &array->vector, &items )) == ~0u) return E_OUTOFMEMORY;
+
+    strbuf_appendc( buf, '[' );
+    for (i = 0; i < count && SUCCEEDED(hr); i++)
+    {
+        if (i) strbuf_appendc( buf, ',' );
+        hr = json_append_value( buf, (IJsonValue *)items[i], depth + 1 );
+    }
+    strbuf_appendc( buf, ']' );
+
+    vector_free_snapshot( items, count );
+    return hr;
+}
+
+static HRESULT json_array_parse( HSTRING input, IJsonArray **array )
+{
+    JsonValueType type;
+    IJsonValue *value;
+    HRESULT hr;
+
+    if (FAILED(hr = json_parse( input, &value ))) return hr;
+    if (FAILED(hr = IJsonValue_get_ValueType( value, &type ))) ;
+    else if (type != JsonValueType_Array) hr = WEB_E_INVALID_JSON_STRING;
+    else hr = IJsonValue_GetArray( value, array );
+    IJsonValue_Release( value );
+    return hr;
+}
