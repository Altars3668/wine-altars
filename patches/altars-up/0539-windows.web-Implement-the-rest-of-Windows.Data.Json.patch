+}
+
+static ULONG WINAPI pair_Release( IKeyValuePair_HSTRING_IJsonValue *iface )
+{
+    struct json_pair *impl = impl_from_IKeyValuePair_HSTRING_IJsonValue( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
