+static HSTRING create_hstring( const WCHAR *str )
+{
+    HSTRING ret;
+    HRESULT hr;
+
+    hr = WindowsCreateString( str, wcslen( str ), &ret );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    return ret;
+}
+
+static void *get_json_statics( const WCHAR *class_name, const IID *iid )
+{
+    IActivationFactory *factory;
+    void *statics = NULL;
+    HSTRING str;
+    HRESULT hr;
+
+    str = create_hstring( class_name );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK || broken( hr == REGDB_E_CLASSNOTREG ), "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return NULL;
+    hr = IActivationFactory_QueryInterface( factory, iid, &statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IActivationFactory_Release( factory );
+    return statics;
+}
+
+static void *activate_json( const WCHAR *class_name, const IID *iid )
+{
+    IInspectable *inspectable;
+    void *out = NULL;
+    HSTRING str;
+    HRESULT hr;
+
+    str = create_hstring( class_name );
+    hr = RoActivateInstance( str, &inspectable );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return NULL;
+    hr = IInspectable_QueryInterface( inspectable, iid, &out );
