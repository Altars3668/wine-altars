+static void test_JsonStringify(void)
+{
+    static const struct
+    {
+        double value;
+        const WCHAR *json;
+    }
+    numbers[] =
+    {
+        {0, L"0"},
+        {-0.0, L"0"},
+        {1, L"1"},
+        {-1.5, L"-1.5"},
+        {0.1, L"0.1"},
+        {3.14159, L"3.14159"},
+        {1e21, L"1e+21"},
+        {123456789012345680000.0, L"123456789012345680000"},
+        {1e-6, L"0.000001"},
+        {1e-7, L"1e-7"},
+        {1.5e300, L"1.5e+300"},
+        {9007199254740993.0, L"9007199254740992"},
+    };
+    IJsonValueStatics *value_statics;
+    IJsonValue *value;
+    HSTRING str;
+    HRESULT hr;
+    UINT i;
+
+    if (!(value_statics = get_json_statics( L"Windows.Data.Json.JsonValue", &IID_IJsonValueStatics )))
+    {
+        win_skip( "JsonValue statics not available, skipping tests.\n" );
+        return;
+    }
+
+    hr = IJsonValueStatics_CreateBooleanValue( value_statics, TRUE, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_stringify( value, L"true" );
+    IJsonValue_Release( value );
+    hr = IJsonValueStatics_CreateBooleanValue( value_statics, FALSE, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_stringify( value, L"false" );
+    IJsonValue_Release( value );
+
+    for (i = 0; i < ARRAY_SIZE(numbers); i++)
+    {
+        winetest_push_context( "%u", i );
+        hr = IJsonValueStatics_CreateNumberValue( value_statics, numbers[i].value, &value );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        check_stringify( value, numbers[i].json );
+        IJsonValue_Release( value );
+        winetest_pop_context();
+    }
+
+    str = create_hstring( L"a\"b\\c/\b\f\n\r\t\x01\x1f\x7f\x00e9\x2028" );
+    hr = IJsonValueStatics_CreateStringValue( value_statics, str, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_stringify( value, L"\"a\\\"b\\\\c/\\b\\f\\n\\r\\t\\u0001\\u001f\x7f\x00e9\x2028\"" );
+    IJsonValue_Release( value );
+    WindowsDeleteString( str );
+
+    /* a string with a null character in it */
+    hr = WindowsCreateString( L"a\0b", 3, &str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IJsonValueStatics_CreateStringValue( value_statics, str, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_stringify( value, L"\"a\\u0000b\"" );
+    IJsonValue_Release( value );
+    WindowsDeleteString( str );
+
+    str = create_hstring( L"{\"z\" : 1, \"a\" : [true, false, null, \"x\", -2.5e3], \"m\" : {}, \"A\" : [], \"\" : \"e\\u0041\"}" );
+    hr = IJsonValueStatics_Parse( value_statics, str, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        check_stringify( value, L"{\"\":\"eA\",\"A\":[],\"a\":[true,false,null,\"x\",-2500],\"m\":{},\"z\":1}" );
+        IJsonValue_Release( value );
+    }
+    WindowsDeleteString( str );
+
+    /* a name given twice has the value given last */
+    str = create_hstring( L"{\"a\":1,\"a\":2}" );
+    hr = IJsonValueStatics_Parse( value_statics, str, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        check_stringify( value, L"{\"a\":2}" );
+        IJsonValue_Release( value );
+    }
+    WindowsDeleteString( str );
+
+    IJsonValueStatics_Release( value_statics );
+}
