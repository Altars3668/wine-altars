+#define check_hstring( str, expect ) check_hstring_( __LINE__, str, expect )
+static void check_hstring_( unsigned int line, HSTRING str, const WCHAR *expect )
+{
+    UINT32 len;
+    const WCHAR *data = WindowsGetStringRawBuffer( str, &len );
+
+    ok_(__FILE__, line)( len == wcslen( expect ) && !memcmp( data, expect, len * sizeof(WCHAR) ),
+                         "got %s, expected %s.\n", wine_dbgstr_hstring( str ), wine_dbgstr_w( expect ) );
+}
+
+#define check_stringify( obj, expect ) check_stringify_( __LINE__, (IUnknown *)(obj), expect )
+static void check_stringify_( unsigned int line, IUnknown *obj, const WCHAR *expect )
+{
+    IStringable *stringable;
+    IJsonValue *value;
+    HSTRING str;
+    HRESULT hr;
+
+    hr = IUnknown_QueryInterface( obj, &IID_IJsonValue, (void **)&value );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+    hr = IJsonValue_Stringify( value, &str );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        check_hstring_( line, str, expect );
+        WindowsDeleteString( str );
+    }
+    hr = IJsonValue_Stringify( value, NULL );
+    ok_(__FILE__, line)( hr == E_POINTER, "got hr %#lx.\n", hr );
+
+    hr = IJsonValue_QueryInterface( value, &IID_IStringable, (void **)&stringable );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        hr = IStringable_ToString( stringable, &str );
+        ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+        if (SUCCEEDED(hr))
+        {
+            check_hstring_( line, str, expect );
+            WindowsDeleteString( str );
+        }
+        IStringable_Release( stringable );
+    }
+    IJsonValue_Release( value );
+}
