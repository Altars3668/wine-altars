-struct json_object
+/*
+ * A JsonObject is a map of names to IJsonValue, kept in the ordinal order of the names, and a
+ * JSON value itself.  Its views and iterators see the members as they were when they were made.
+ */
+
+struct json_member
+{
+    HSTRING name;
+    IJsonValue *value;
+};
+
+/* the members as they were at some point, shared by views and iterators */
+struct json_members
+{
+    LONG ref;
+    UINT32 count;
+    struct json_member member[];
+};
+
+static void json_members_release( struct json_members *members )
+{
+    UINT32 i;
+
+    if (InterlockedDecrement( &members->ref )) return;
+    for (i = 0; i < members->count; i++)
+    {
+        WindowsDeleteString( members->member[i].name );
+        IJsonValue_Release( members->member[i].value );
+    }
+    free( members );
+}
+
+/* the index of the member of that name, or of where it would go; TRUE when it is there */
+static BOOL json_members_find( const struct json_member *member, UINT32 count, HSTRING name, UINT32 *index )
+{
+    UINT32 low = 0, high = count;
+
+    while (low < high)
+    {
+        UINT32 mid = low + (high - low) / 2;
+        INT32 order;
+
+        WindowsCompareStringOrdinal( member[mid].name, name, &order );
+        if (!order)
+        {
+            *index = mid;
+            return TRUE;
+        }
+        if (order < 0) low = mid + 1;
+        else high = mid;
+    }
+    *index = low;
+    return FALSE;
+}
+
+/*** key-value pairs ***/
+
+struct json_pair
+{
+    IKeyValuePair_HSTRING_IJsonValue IKeyValuePair_HSTRING_IJsonValue_iface;
+    LONG ref;
