+    IJsonErrorStatics2 *error_statics;
+    IJsonValueStatics *value_statics;
+    JsonErrorStatus status;
+    IJsonValue *value;
+    WCHAR *json;
+    HSTRING str;
+    HRESULT hr;
+    UINT i;
+
