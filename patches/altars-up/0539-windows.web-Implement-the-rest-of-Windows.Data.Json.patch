+    UINT32 index;
+    BOOL found;
+
+    AcquireSRWLockExclusive( &impl->lock );
+    if ((found = json_members_find( impl->members, impl->count, name, &index )))
+    {
+        removed = impl->members[index];
+        memmove( impl->members + index, impl->members + index + 1, (impl->count - index - 1) * sizeof(*impl->members) );
+        impl->count--;
+    }
+    ReleaseSRWLockExclusive( &impl->lock );
+
+    if (!found) return FALSE;
+    WindowsDeleteString( removed.name );
+    IJsonValue_Release( removed.value );
+    return TRUE;
+}
