+static HRESULT json_object_insert( struct json_object *impl, HSTRING name, IJsonValue *value, boolean *replaced )
+{
+    IJsonValue *old = NULL;
+    HRESULT hr = S_OK;
+    HSTRING copy;
+    UINT32 index;
+
+    if (FAILED(hr = WindowsDuplicateString( name, &copy ))) return hr;
+
+    AcquireSRWLockExclusive( &impl->lock );
+    if (json_members_find( impl->members, impl->count, name, &index ))
+    {
+        old = impl->members[index].value;
+        IJsonValue_AddRef( (impl->members[index].value = value) );
+        *replaced = TRUE;
+    }
+    else
+    {
+        if (impl->count == impl->capacity)
+        {
+            UINT32 capacity = max( 8, impl->capacity * 2 );
+            struct json_member *members;
+
+            if (!(members = realloc( impl->members, capacity * sizeof(*members) ))) hr = E_OUTOFMEMORY;
+            else
+            {
+                impl->members = members;
+                impl->capacity = capacity;
+            }
+        }
+        if (SUCCEEDED(hr))
+        {
+            memmove( impl->members + index + 1, impl->members + index, (impl->count - index) * sizeof(*impl->members) );
+            impl->members[index].name = copy;
+            IJsonValue_AddRef( (impl->members[index].value = value) );
+            impl->count++;
+            copy = NULL;
+            *replaced = FALSE;
+        }
+    }
+    ReleaseSRWLockExclusive( &impl->lock );
+
+    WindowsDeleteString( copy );
+    if (old) IJsonValue_Release( old );
+    return hr;
+}
