+static void test_JsonError(void)
+{
+    static const struct
+    {
+        HRESULT hr;
+        JsonErrorStatus status;
+    }
+    statuses[] =
+    {
+        {S_OK, JsonErrorStatus_Unknown},
+        {E_FAIL, JsonErrorStatus_Unknown},
+        {WEB_E_INVALID_JSON_STRING, JsonErrorStatus_InvalidJsonString},
+        {WEB_E_INVALID_JSON_NUMBER, JsonErrorStatus_InvalidJsonNumber},
+        {WEB_E_JSON_VALUE_NOT_FOUND, JsonErrorStatus_JsonValueNotFound},
