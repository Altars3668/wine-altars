From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 15:30:52 -0400
Subject: [PATCH] winex11: Do not exchange ole32's session-bound clipboard
 formats with other X clients.

"DataObject" holds the clipboard owner's window, "Wine Marshalled
DataObject" an IDataObject marshalled to this wineserver's RPC
endpoints, and "Ole Private Data" a FORMATETC list whose registered
format ids are atoms of this wineserver.  Exported through X11, a Wine
program in another session read the last as its own ids: with an
OleSetClipboard()'d object offering CF_UNICODETEXT, "Embed Source" and
a private format, OleGetClipboard() there enumerated the private format
as whatever format had that id locally ("OleMainThreadWndClass"),
GetData() failed with DV_E_FORMATETC, and the real private format was
not enumerated at all, before and after OleFlushClipboard().

Leave the three out of TARGETS, and ignore them when another session
that still exports them owns the selection; the formats that carry
plain data, "Embed Source" included, still go across.  ole32 and
winex11 share the three names from one header.

CrossOver filters a longer list of OLE names; measured across two
prefixes, the others (Embed Source among them) paste correctly and stay.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ole32/clipboard.c b/dlls/ole32/clipboard.c
index 9e63789aa8f..c6c169fbf14 100644
--- a/dlls/ole32/clipboard.c
+++ b/dlls/ole32/clipboard.c
@@ -76,6 +76,7 @@
 
 #include "storage32.h"
 
+#include "clipboard_formats.h"
 #include "compobj_private.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(ole);
@@ -205,16 +206,16 @@ static BOOL WINAPI register_clipboard_formats(INIT_ONCE *once, void *parameter,
     ownerlink_clipboard_format = RegisterClipboardFormatW(L"OwnerLink");
     filename_clipboard_format = RegisterClipboardFormatW(L"FileName");
     filenameW_clipboard_format = RegisterClipboardFormatW(L"FileNameW");
-    dataobject_clipboard_format = RegisterClipboardFormatW(L"DataObject");
+    dataobject_clipboard_format = RegisterClipboardFormatW(ole32_dataobject_format_name);
     embedded_object_clipboard_format = RegisterClipboardFormatW(L"Embedded Object");
     embed_source_clipboard_format = RegisterClipboardFormatW(L"Embed Source");
     custom_link_source_clipboard_format = RegisterClipboardFormatW(L"Custom Link Source");
     link_source_clipboard_format = RegisterClipboardFormatW(L"Link Source");
     object_descriptor_clipboard_format = RegisterClipboardFormatW(L"Object Descriptor");
     link_source_descriptor_clipboard_format = RegisterClipboardFormatW(L"Link Source Descriptor");
-    ole_private_data_clipboard_format = RegisterClipboardFormatW(L"Ole Private Data");
+    ole_private_data_clipboard_format = RegisterClipboardFormatW(ole32_private_data_format_name);
 
-    wine_marshal_clipboard_format = RegisterClipboardFormatW(L"Wine Marshalled DataObject");
+    wine_marshal_clipboard_format = RegisterClipboardFormatW(ole32_marshaled_dataobject_format_name);
     return TRUE;
 }
 
diff --git a/dlls/ole32/clipboard_formats.h b/dlls/ole32/clipboard_formats.h
new file mode 100644
index 00000000000..2a3b81d0c92
--- /dev/null
+++ b/dlls/ole32/clipboard_formats.h
@@ -0,0 +1,12 @@
+/* OLE clipboard formats whose contents are meaningful only to the owning wineserver. */
+#ifndef __WINE_OLE32_CLIPBOARD_FORMATS_H
+#define __WINE_OLE32_CLIPBOARD_FORMATS_H
+
+static const WCHAR ole32_dataobject_format_name[] =
+    {'D','a','t','a','O','b','j','e','c','t',0};
+static const WCHAR ole32_private_data_format_name[] =
+    {'O','l','e',' ','P','r','i','v','a','t','e',' ','D','a','t','a',0};
+static const WCHAR ole32_marshaled_dataobject_format_name[] =
+    {'W','i','n','e',' ','M','a','r','s','h','a','l','l','e','d',' ','D','a','t','a','O','b','j','e','c','t',0};
+
+#endif /* __WINE_OLE32_CLIPBOARD_FORMATS_H */
diff --git a/dlls/winex11.drv/clipboard.c b/dlls/winex11.drv/clipboard.c
index e2e07a636a4..7d5263fbf55 100644
--- a/dlls/winex11.drv/clipboard.c
+++ b/dlls/winex11.drv/clipboard.c
@@ -92,6 +92,7 @@
 #include "shlwapi.h"
 #include "wine/list.h"
 #include "wine/debug.h"
+#include "../ole32/clipboard_formats.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(clipboard);
 
@@ -293,6 +294,23 @@ static ATOM register_clipboard_format( const WCHAR *name )
 }
 
 
+/* ole32 fills these formats with data that only means something to this wineserver: the clipboard
+ * owner's window, a marshalled IDataObject and clipboard format ids.  Neither export them to other X
+ * clients nor import them from one (another Wine session that still exports them). */
+static BOOL is_session_bound_format( UINT id )
+{
+    static UINT ids[3];
+
+    if (!ids[0])
+    {
+        ids[0] = register_clipboard_format( ole32_dataobject_format_name );
+        ids[1] = register_clipboard_format( ole32_marshaled_dataobject_format_name );
+        ids[2] = register_clipboard_format( ole32_private_data_format_name );
+    }
+    return id && (id == ids[0] || id == ids[1] || id == ids[2]);
+}
+
+
 /**************************************************************************
  *		register_builtin_formats
  */
@@ -1106,7 +1124,7 @@ static void *import_targets( Atom type, const void *data, size_t size, size_t *r
     {
         for (i = 0; i < count; i++) if (properties[i] == format->atom) break;
         if (i == count) continue;
-        if (format->import && format->id)
+        if (format->import && format->id && !is_session_bound_format( format->id ))
         {
             struct set_clipboard_params params = { .data = NULL };
 
@@ -1599,6 +1617,7 @@ static BOOL export_targets( Display *display, Window win, Atom prop, Atom target
         if (!format->export) continue;
         /* formats with id==0 are always exported */
         if (format->id && !is_format_available( format->id, formats, count )) continue;
+        if (is_session_bound_format( format->id )) continue;
         TRACE( "%d: %s -> %s\n", pos, debugstr_format( format->id ), debugstr_xatom( format->atom ));
         targets[pos++] = format->atom;
     }
