From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 12:14:09 -0400
Subject: [PATCH] secur32, netapi32: give the account's full name, and map name
 formats as Windows does.

Word asks GetUserNameExW for NameDisplay, NameUserPrincipal and
NameDnsDomain, and each printed "not implemented".  tools/usernameprobe
measured Windows 11 for a user of a machine in no domain:

- NameDisplay is the account's full name, now WINEUSERFULLNAME; asked
  with no buffer it fails with ERROR_MORE_DATA and the size with the
  terminator.  An account without one maps to nothing.
- The names of a domain account, the user principal name and the DNS
  domain among them, map to nothing with ERROR_NONE_MAPPED; that is the
  right answer here, where there is no domain, and no longer a FIXME.
- The numbers between the formats (4, 5 and 11) map to nothing too,
  where Wine said ERROR_INVALID_PARAMETER; past NameSurname they are
  ERROR_INVALID_PARAMETER, as they were.

Windows also split the full name into NameGivenName and NameSurname,
which here is not known and maps to nothing.  NetUserGetInfo's level 10
gives the same full name for the current user.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 4573d8d8d64b6385e0d265b78a8a732cf8cc9084)

diff --git a/dlls/netapi32/netapi32.c b/dlls/netapi32/netapi32.c
index f58647b34c3..29884220756 100644
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -1274,6 +1274,9 @@ NetUserGetInfo(LPCWSTR servername, LPCWSTR username, DWORD level,
         comment_sz = 1;
         usr_comment_sz = 1;
         full_name_sz = 1;
+        /* the current account's full name, which ntdll finds in its GECOS */
+        if (NETAPI_IsCurrentUser(username))
+            full_name_sz = max(1, GetEnvironmentVariableW(L"WINEUSERFULLNAME", NULL, 0));
 
         /* get data */
         status = NetUserGetInfo(servername, username, 0, (LPBYTE *) &ui0);
@@ -1304,6 +1307,8 @@ NetUserGetInfo(LPCWSTR servername, LPCWSTR username, DWORD level,
         ui->usri10_comment[0] = 0;
         ui->usri10_usr_comment[0] = 0;
         ui->usri10_full_name[0] = 0;
+        if (full_name_sz > 1)
+            GetEnvironmentVariableW(L"WINEUSERFULLNAME", ui->usri10_full_name, full_name_sz);
         break;
     }
 
diff --git a/dlls/secur32/secur32.c b/dlls/secur32/secur32.c
index 008f4dd3611..aa28b64af0c 100644
--- a/dlls/secur32/secur32.c
+++ b/dlls/secur32/secur32.c
@@ -1156,21 +1156,43 @@ BOOLEAN WINAPI GetUserNameExW(
             return FALSE;
         }
 
-    case NameUnknown:
-    case NameFullyQualifiedDN:
     case NameDisplay:
-    case NameUniqueId:
-    case NameCanonical:
-    case NameUserPrincipal:
-    case NameCanonicalEx:
-    case NameServicePrincipal:
-    case NameDnsDomain:
-        FIXME("NameFormat %d not implemented\n", NameFormat);
+        {
+            /* the account's full name, which ntdll finds in its GECOS */
+            WCHAR name[UNLEN + 1];
+            DWORD len = GetEnvironmentVariableW(L"WINEUSERFULLNAME", name, ARRAY_SIZE(name));
+
+            if (!len || len >= ARRAY_SIZE(name))
+            {
+                SetLastError(ERROR_NONE_MAPPED);
+                return FALSE;
+            }
+            if (len < *nSize)
+            {
+                lstrcpyW(lpNameBuffer, name);
+                *nSize = len;
+                return TRUE;
+            }
+            SetLastError(ERROR_MORE_DATA);
+            *nSize = len + 1;
+            return FALSE;
+        }
+
+    case NameGivenName:
+    case NameSurname:
+        WARN("the parts of the account's name are not known\n");
         SetLastError(ERROR_NONE_MAPPED);
         return FALSE;
 
     default:
-        SetLastError(ERROR_INVALID_PARAMETER);
+        /* the other names are those of an account in a domain, and this machine is in none; the numbers in
+         * between name nothing, and Windows maps them to nothing too */
+        if (NameFormat > NameSurname)
+        {
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+        SetLastError(ERROR_NONE_MAPPED);
         return FALSE;
     }
 }
diff --git a/dlls/secur32/tests/secur32.c b/dlls/secur32/tests/secur32.c
index 9dfbbbb697d..da10bc99989 100644
--- a/dlls/secur32/tests/secur32.c
+++ b/dlls/secur32/tests/secur32.c
@@ -249,6 +249,37 @@ static void testGetUserNameExW(void)
     ok(! rc && GetLastError() == ERROR_MORE_DATA, "Expected fail with ERROR_MORE_DATA, got %d with %lu\n", rc, GetLastError());
     ok(1 < size, "Expected size to be set to required size\n");
     ok(nameW[0] == (WCHAR) 0xff, "Expected unchanged buffer\n");
+
+    /* the account's full name, where it has one */
+    size = ARRAY_SIZE(nameW);
+    SetLastError(0xdeadbeef);
+    rc = pGetUserNameExW(NameDisplay, nameW, &size);
+    if (rc)
+    {
+        ULONG len = size;
+
+        ok(len == lstrlenW(nameW), "got size %lu for %u characters\n", len, lstrlenW(nameW));
+        size = 0;
+        rc = pGetUserNameExW(NameDisplay, NULL, &size);
+        ok(!rc && GetLastError() == ERROR_MORE_DATA, "got %d, error %lu\n", rc, GetLastError());
+        ok(size == len + 1, "got size %lu\n", size);
+    }
+    else ok(GetLastError() == ERROR_NONE_MAPPED, "got error %lu\n", GetLastError());
+
+    /* numbers that name no format map to no name; past the last format they are wrong */
+    for (i = 4; i <= 11; i = (i == 5) ? 11 : i + 1)
+    {
+        size = ARRAY_SIZE(nameW);
+        SetLastError(0xdeadbeef);
+        rc = pGetUserNameExW(i, nameW, &size);
+        ok(!rc, "%u: GetUserNameExW succeeded\n", i);
+        ok(GetLastError() == ERROR_NONE_MAPPED, "%u: got error %lu\n", i, GetLastError());
+    }
+    size = ARRAY_SIZE(nameW);
+    SetLastError(0xdeadbeef);
+    rc = pGetUserNameExW(NameSurname + 1, nameW, &size);
+    ok(!rc, "GetUserNameExW succeeded\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError());
 }
 
 static void test_InitSecurityInterface(void)
