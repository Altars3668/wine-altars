From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 22:35:16 -0400
Subject: [PATCH] win32u: Pack WM_DPICHANGED's rectangle for other processes.

Its lParam points to the suggested window rectangle, which a window in another process could not
read.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 32d3921cebb..761fb887203 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -648,6 +648,9 @@ static BOOL unpack_message( HWND hwnd, UINT message, WPARAM *wparam, LPARAM *lpa
     case WM_GETMINMAXINFO:
         minsize = sizeof(MINMAXINFO);
         break;
+    case WM_DPICHANGED:
+        minsize = sizeof(RECT);
+        break;
     case WM_DRAWITEM:
     {
         DRAWITEMSTRUCT dis;
@@ -1043,6 +1046,9 @@ static size_t pack_message( HWND hwnd, UINT message, WPARAM wparam, LPARAM lpara
     case WM_GETMINMAXINFO:
         push_data( data, (MINMAXINFO *)lparam, sizeof(MINMAXINFO) );
         return sizeof(MINMAXINFO);
+    case WM_DPICHANGED:
+        push_data( data, (RECT *)lparam, sizeof(RECT) );
+        return sizeof(RECT);
     case WM_DRAWITEM:
     {
         DRAWITEMSTRUCT *dis = (DRAWITEMSTRUCT *)lparam;
@@ -1746,6 +1752,9 @@ size_t user_message_size( HWND hwnd, UINT message, WPARAM wparam, LPARAM lparam,
     case WM_GETMINMAXINFO:
         size = sizeof(MINMAXINFO);
         break;
+    case WM_DPICHANGED:
+        size = sizeof(RECT);
+        break;
     case WM_DRAWITEM:
         size = sizeof(DRAWITEMSTRUCT);
         break;
