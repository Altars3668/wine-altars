+/* Compares the canonical names, which both have to be host names. */
+static HRESULT WINAPI hostname_statics_Compare( IHostNameStatics *iface, HSTRING value1, HSTRING value2, INT32 *result )
+{
+    IHostName *name1, *name2;
+    HSTRING canonical1 = NULL, canonical2 = NULL;
+    INT32 order;
+    HRESULT hr;
+
+    TRACE( "iface %p, value1 %s, value2 %s, result %p.\n", iface, debugstr_hstring(value1), debugstr_hstring(value2), result );
+
+    if (!result) return E_POINTER;
+    if (!value1 || !value2) return E_INVALIDARG;
+    if (FAILED(hr = hostname_create( value1, &name1 ))) return hr;
+    if (FAILED(hr = hostname_create( value2, &name2 )))
+    {
+        IHostName_Release( name1 );
+        return hr;
+    }
+    IHostName_get_CanonicalName( name1, &canonical1 );
+    IHostName_get_CanonicalName( name2, &canonical2 );
+    if (SUCCEEDED(hr = WindowsCompareStringOrdinal( canonical1, canonical2, &order )))
+        *result = order < 0 ? -1 : order > 0 ? 1 : 0;
+    WindowsDeleteString( canonical1 );
+    WindowsDeleteString( canonical2 );
+    IHostName_Release( name1 );
+    IHostName_Release( name2 );
+    return hr;
+}
+
