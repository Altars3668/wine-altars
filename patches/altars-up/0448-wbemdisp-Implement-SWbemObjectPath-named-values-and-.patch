+static HRESULT WINAPI objectpath_put_RelPath( ISWbemObjectPath *iface, BSTR strRelPath )
+{
+    struct objectpath *objectpath = impl_from_ISWbemObjectPath( iface );
+    IWbemPath *path;
+    WCHAR *text;
+    BSTR prefix;
+    HRESULT hr;
+    UINT len;
+
+    TRACE( "%p, %s\n", objectpath, debugstr_w(strRelPath) );
+
+    if (objectpath->read_only) return WBEM_E_READ_ONLY;
+    if (FAILED(hr = get_path_text( objectpath->path, WBEMPATH_GET_SERVER_AND_NAMESPACE_ONLY, &prefix ))) return hr;
+    len = SysStringLen( prefix ) + (strRelPath ? lstrlenW( strRelPath ) : 0) + 2;
+    if (!(text = malloc( len * sizeof(WCHAR) )))
+    {
+        SysFreeString( prefix );
+        return E_OUTOFMEMORY;
+    }
+    swprintf( text, len, L"%s%s%s", prefix, prefix[0] ? L":" : L"", strRelPath ? strRelPath : L"" );
+    if (SUCCEEDED(hr = parse_path_text( text, &path ))) replace_path( objectpath, path );
+    free( text );
+    SysFreeString( prefix );
+    return hr;
