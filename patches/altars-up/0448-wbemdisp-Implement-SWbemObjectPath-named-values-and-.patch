+    check_bstr( hr, str, L"Win32_Process" );
+    hr = ISWbemObjectPath_get_DisplayName( path, &str );
+    check_bstr( hr, str, L"WINMGMTS:\\\\srv\\root\\cimv2:Win32_Process.Handle=\"4\"" );
+    boolean = VARIANT_TRUE;
+    hr = ISWbemObjectPath_get_IsClass( path, &boolean );
+    ok( hr == S_OK && !boolean, "got %#lx, %d\n", hr, boolean );
+
+    hr = ISWbemObjectPath_get_Keys( path, &keys );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    count = 0;
+    hr = ISWbemNamedValueSet_get_Count( keys, &count );
+    ok( hr == S_OK && count == 1, "got %#lx, %ld\n", hr, count );
+    str = SysAllocString( L"handle" );
+    hr = ISWbemNamedValueSet_Item( keys, str, 0, &value );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    hr = ISWbemNamedValue_get_Name( value, &str );
+    check_bstr( hr, str, L"handle" );
+    VariantInit( &var );
+    hr = ISWbemNamedValue_get_Value( value, &var );
+    ok( hr == S_OK && V_VT( &var ) == VT_BSTR && !lstrcmpW( V_BSTR( &var ), L"4" ), "got %#lx, %s\n", hr,
+        wine_dbgstr_variant(&var) );
+    VariantClear( &var );
+    /* a key's new value goes to the path, and is a failure */
+    V_VT( &var ) = VT_I4;
+    V_I4( &var ) = 9;
+    hr = ISWbemNamedValue_put_Value( value, &var );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+    ISWbemNamedValue_Release( value );
+    ISWbemNamedValueSet_Release( keys );
+    hr = ISWbemObjectPath_get_RelPath( path, &str );
+    check_bstr( hr, str, L"Win32_Process.Handle=9" );
+
+    /* what is no path leaves the path as it was */
+    hr = put_path( path, L"Class.A = 5" );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_RelPath( path, &str );
+    check_bstr( hr, str, L"Win32_Process.Handle=9" );
+
+    hr = put_path( path, L"root\\cimv2:Class" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_Path( path, &str );
+    check_bstr( hr, str, L"\\\\.\\root\\cimv2:Class" );
+    hr = ISWbemObjectPath_get_Server( path, &str );
+    check_bstr( hr, str, L"." );
+    boolean = VARIANT_FALSE;
+    hr = ISWbemObjectPath_get_IsClass( path, &boolean );
+    ok( hr == S_OK && boolean, "got %#lx, %d\n", hr, boolean );
+
+    /* the setters */
+    hr = put_path( path, L"\\\\srv\\root\\cimv2:Class.K=1" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    str = SysAllocString( L"Other" );
+    hr = ISWbemObjectPath_put_Class( path, str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    str = SysAllocString( L"srv2" );
+    hr = ISWbemObjectPath_put_Server( path, str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    str = SysAllocString( L"root\\default" );
+    hr = ISWbemObjectPath_put_Namespace( path, str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    hr = ISWbemObjectPath_get_Path( path, &str );
+    check_bstr( hr, str, L"\\\\srv2\\root\\default:Other.K=1" );
+    str = SysAllocString( L"Third.K=\"v\"" );
+    hr = ISWbemObjectPath_put_RelPath( path, str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    V_VT( &var ) = VT_I2;
+    V_I2( &var ) = 5;
+    hr = add_key( path, L"N", &var );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    V_VT( &var ) = VT_R8;
+    V_R8( &var ) = 1.5;
+    hr = add_key( path, L"D", &var );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_Path( path, &str );
+    check_bstr( hr, str, L"\\\\srv2\\root\\default:Third.K=\"v\",N=5" );
+    hr = ISWbemObjectPath_get_Keys( path, &keys );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    str = SysAllocString( L"nonesuch" );
+    hr = ISWbemNamedValueSet_Remove( keys, str, 0 );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+    SysFreeString( str );
+    ISWbemNamedValueSet_Release( keys );
+    hr = ISWbemObjectPath_SetAsSingleton( path );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_RelPath( path, &str );
+    check_bstr( hr, str, L"Third=@" );
+    boolean = VARIANT_FALSE;
+    hr = ISWbemObjectPath_get_IsSingleton( path, &boolean );
+    ok( hr == S_OK && boolean, "got %#lx, %d\n", hr, boolean );
+    hr = ISWbemObjectPath_SetAsClass( path );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_RelPath( path, &str );
+    check_bstr( hr, str, L"Third" );
+
+    /* what the display name has, in its order */
+    hr = ISWbemSecurity_put_ImpersonationLevel( security, wbemImpersonationLevelDelegate );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemSecurity_put_AuthenticationLevel( security, wbemAuthenticationLevelConnect );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    str = SysAllocString( L"kerberos:srv" );
+    hr = ISWbemObjectPath_put_Authority( path, str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    str = SysAllocString( L"ms_409" );
+    hr = ISWbemObjectPath_put_Locale( path, str );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    hr = ISWbemSecurity_get_Privileges( security, &privileges );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemPrivilegeSet_Add( privileges, wbemPrivilegeShutdown, VARIANT_FALSE, &privilege );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ISWbemPrivilege_Release( privilege );
+    hr = ISWbemPrivilegeSet_Add( privileges, wbemPrivilegeSecurity, VARIANT_TRUE, &privilege );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemPrivilege_get_Name( privilege, &str );
+    check_bstr( hr, str, L"SeSecurityPrivilege" );
+    ISWbemPrivilege_Release( privilege );
+    hr = ISWbemObjectPath_get_DisplayName( path, &str );
+    check_bstr( hr, str, L"WINMGMTS:{authenticationLevel=connect,impersonationLevel=delegate,authority=kerberos:srv,"
+                         L"(Security,!Shutdown)}[locale=ms_409]!\\\\srv2\\root\\default:Third" );
+
+    hr = ISWbemPrivilegeSet_Add( privileges, 0, VARIANT_TRUE, &privilege );
+    ok( hr == WBEM_E_INVALID_PARAMETER, "got %#lx\n", hr );
+    hr = ISWbemPrivilegeSet_Add( privileges, wbemPrivilegeManageVolume + 1, VARIANT_TRUE, &privilege );
+    ok( hr == WBEM_E_INVALID_PARAMETER, "got %#lx\n", hr );
+    str = SysAllocString( L"Shutdown" );
+    hr = ISWbemPrivilegeSet_AddAsString( privileges, str, VARIANT_TRUE, &privilege );
+    ok( hr == WBEM_E_INVALID_PARAMETER, "got %#lx\n", hr );
+    SysFreeString( str );
+    hr = ISWbemPrivilegeSet_Item( privileges, wbemPrivilegeDebug, &privilege );
+    ok( hr == WBEM_E_NOT_FOUND, "got %#lx\n", hr );
+    hr = ISWbemPrivilegeSet_Remove( privileges, wbemPrivilegeDebug );
+    ok( hr == WBEM_E_NOT_FOUND, "got %#lx\n", hr );
+    count = 0;
+    hr = ISWbemPrivilegeSet_get_Count( privileges, &count );
+    ok( hr == S_OK && count == 2, "got %#lx, %ld\n", hr, count );
+    ISWbemPrivilegeSet_Release( privileges );
+
+    hr = put_display_name( path, L"winmgmts:{impersonationLevel=impersonate,authenticationLevel=pktIntegrity,"
+                                 L"authority=ntlmdomain:dom,(Debug,!Shutdown)}[locale=ms_407]!\\\\srv\\root:C.K=2" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_DisplayName( path, &str );
+    check_bstr( hr, str, L"WINMGMTS:{authenticationLevel=pktIntegrity,impersonationLevel=impersonate,"
+                         L"authority=ntlmdomain:dom,(!Shutdown,Debug)}[locale=ms_407]!\\\\srv\\root:C.K=2" );
+    hr = ISWbemObjectPath_get_Locale( path, &str );
+    check_bstr( hr, str, L"ms_407" );
+    hr = ISWbemSecurity_get_ImpersonationLevel( security, &implevel );
+    ok( hr == S_OK && implevel == wbemImpersonationLevelImpersonate, "got %#lx, %d\n", hr, implevel );
+    hr = put_display_name( path, L"\\\\srv\\root:C.K=4" );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+    hr = put_display_name( path, L"winmgmts:{impersonationLevel=bogus}!\\\\srv\\root:C.K=5" );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+    hr = put_display_name( path, L"WinMgmts:\\\\srv\\root:C.K=3" );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_DisplayName( path, &str );
+    check_bstr( hr, str, L"WINMGMTS:\\\\srv\\root:C.K=3" );
+    hr = ISWbemSecurity_get_ImpersonationLevel( security, &implevel );
+    ok( hr == WBEM_E_FAILED, "got %#lx\n", hr );
+
+    ISWbemSecurity_Release( security );
+    ISWbemObjectPath_Release( path );
+}
