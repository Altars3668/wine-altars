+static HRESULT get_path_text( IWbemPath *path, LONG flags, BSTR *text )
+{
+    ULONG len = 0;
+    HRESULT hr;
+
+    if (!text) return E_INVALIDARG;
+    if (FAILED(hr = IWbemPath_GetText( path, flags, &len, NULL ))) return hr;
+    if (!(*text = SysAllocStringLen( NULL, len ? len - 1 : 0 ))) return E_OUTOFMEMORY;
+    if (len && FAILED(hr = IWbemPath_GetText( path, flags, &len, *text )))
+    {
+        SysFreeString( *text );
+        *text = NULL;
+    }
+    return hr;
+}
+
+/* a new path, or none when the text is not one */
+static HRESULT parse_path_text( const WCHAR *text, IWbemPath **ret )
+{
+    IWbemPath *path;
+    HRESULT hr;
+
+    if (FAILED(hr = CoCreateInstance( &CLSID_WbemDefPath, NULL, CLSCTX_INPROC_SERVER, &IID_IWbemPath,
+                                      (void **)&path ))) return hr;
+    if (FAILED(IWbemPath_SetText( path, WBEMPATH_CREATE_ACCEPT_ALL, text ? text : L"" )))
+    {
+        IWbemPath_Release( path );
+        return WBEM_E_FAILED;
+    }
+    *ret = path;
+    return S_OK;
+}
