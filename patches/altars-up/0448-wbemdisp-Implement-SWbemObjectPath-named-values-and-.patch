+/* an object's own path cannot be changed, and has its connection's settings; a query's results have their keys */
+static void test_object_path(void)
+{
+    ISWbemLocator *locator;
+    ISWbemServices *services;
+    ISWbemObjectSet *objects;
+    ISWbemPropertySet *props;
+    ISWbemSecurity *security;
+    ISWbemObjectPath *path;
+    ISWbemObjectEx *objectex;
+    ISWbemObject *object;
+    WbemImpersonationLevelEnum implevel;
+    WbemAuthenticationLevelEnum authlevel;
+    IEnumVARIANT *items;
+    IUnknown *unk;
+    VARIANT var;
+    LONG count;
+    HRESULT hr;
+    BSTR str, lang;
+
+    hr = CoCreateInstance( &CLSID_SWbemLocator, NULL, CLSCTX_INPROC_SERVER, &IID_ISWbemLocator, (void **)&locator );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    str = SysAllocString( L"root\\cimv2" );
+    hr = ISWbemLocator_ConnectServer( locator, NULL, str, NULL, NULL, NULL, NULL, 0, NULL, &services );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+
+    str = SysAllocString( L"SELECT Size FROM Win32_LogicalDisk" );
+    lang = SysAllocString( L"WQL" );
+    hr = ISWbemServices_ExecQuery( services, str, lang, 0, NULL, &objects );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    SysFreeString( lang );
+    hr = ISWbemObjectSet_get__NewEnum( objects, &unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUnknown_QueryInterface( unk, &IID_IEnumVARIANT, (void **)&items );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IUnknown_Release( unk );
+    VariantInit( &var );
+    hr = IEnumVARIANT_Next( items, 1, &var, NULL );
+    IEnumVARIANT_Release( items );
+    ISWbemObjectSet_Release( objects );
+    if (hr != S_OK)
+    {
+        skip( "no disks\n" );
+        ISWbemServices_Release( services );
+        ISWbemLocator_Release( locator );
+        return;
+    }
+    hr = IDispatch_QueryInterface( V_DISPATCH( &var ), &IID_ISWbemObject, (void **)&object );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    VariantClear( &var );
+
+    /* the key as well */
+    hr = ISWbemObject_get_Properties_( object, &props );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    count = 0;
+    hr = ISWbemPropertySet_get_Count( props, &count );
+    ok( hr == S_OK && count == 2, "got %#lx, %ld\n", hr, count );
+    ISWbemPropertySet_Release( props );
+
+    hr = ISWbemObject_QueryInterface( object, &IID_ISWbemObjectEx, (void **)&objectex );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemObjectEx_get_SystemProperties_( objectex, &props );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    count = 0;
+    hr = ISWbemPropertySet_get_Count( props, &count );
+    ok( hr == S_OK && count == 10, "got %#lx, %ld\n", hr, count );
+    ISWbemPropertySet_Release( props );
+    ISWbemObjectEx_Release( objectex );
+
+    hr = ISWbemObject_get_Path_( object, &path );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_RelPath( path, &str );
+    ok( hr == S_OK && !wcsncmp( str, L"Win32_LogicalDisk.DeviceID=", 27 ), "got %#lx, %s\n", hr, wine_dbgstr_w(str) );
+    SysFreeString( str );
+    hr = put_path( path, L"Win32_LogicalDisk.DeviceID=\"X:\"" );
+    ok( hr == WBEM_E_READ_ONLY, "got %#lx\n", hr );
+    str = SysAllocString( L"Other" );
+    hr = ISWbemObjectPath_put_Class( path, str );
+    ok( hr == WBEM_E_READ_ONLY, "got %#lx\n", hr );
+    SysFreeString( str );
+    V_VT( &var ) = VT_I4;
+    V_I4( &var ) = 1;
+    hr = add_key( path, L"X", &var );
+    ok( hr == WBEM_E_READ_ONLY, "got %#lx\n", hr );
+    hr = ISWbemObjectPath_get_Security_( path, &security );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemSecurity_get_ImpersonationLevel( security, &implevel );
+    ok( hr == S_OK && implevel == wbemImpersonationLevelImpersonate, "got %#lx, %d\n", hr, implevel );
+    hr = ISWbemSecurity_get_AuthenticationLevel( security, &authlevel );
+    ok( hr == S_OK && authlevel == wbemAuthenticationLevelPktPrivacy, "got %#lx, %d\n", hr, authlevel );
+    ISWbemSecurity_Release( security );
+    hr = ISWbemObjectPath_get_DisplayName( path, &str );
+    ok( hr == S_OK && !wcsncmp( str, L"WINMGMTS:{authenticationLevel=pktPrivacy,impersonationLevel=impersonate}!\\\\",
+                                75 ), "got %#lx, %s\n", hr, wine_dbgstr_w(str) );
+    SysFreeString( str );
+    ISWbemObjectPath_Release( path );
+
+    /* the connection's settings are its own, kept */
+    hr = ISWbemServices_get_Security_( services, &security );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemSecurity_put_ImpersonationLevel( security, wbemImpersonationLevelIdentify );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ISWbemSecurity_Release( security );
+    hr = ISWbemServices_get_Security_( services, &security );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = ISWbemSecurity_get_ImpersonationLevel( security, &implevel );
+    ok( hr == S_OK && implevel == wbemImpersonationLevelIdentify, "got %#lx, %d\n", hr, implevel );
+    ISWbemSecurity_Release( security );
+
+    ISWbemObject_Release( object );
+    ISWbemServices_Release( services );
+    ISWbemLocator_Release( locator );
+}
