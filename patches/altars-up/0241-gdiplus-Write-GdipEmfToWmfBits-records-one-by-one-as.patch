From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 23:11:02 -0400
Subject: [PATCH] gdiplus: Write GdipEmfToWmfBits() records one by one, as
 Windows does.

Windows writes the header with no size first, then each record that fits:
a record that does not fit fails the call, except the final META_EOF,
without which the rest is returned with its size in the header.  The
placeable header is written last, only when the call succeeds.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 4b7f6a9274906694a7ed357a7e61bd783a1f923f)

diff --git a/dlls/gdiplus/metafile.c b/dlls/gdiplus/metafile.c
index aeda7c2b00a..1e6b401ed58 100644
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -4638,10 +4638,10 @@ UINT WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE hemf, UINT cbData16,
     LPBYTE pData16, INT iMapMode, INT eFlags)
 {
     static const DWORD placeable_key = 0x9ac6cdd7;
-    ENHMETAHEADER header;
-    METAHEADER *mh;
+    UINT size, total, header_size, placeable_size, words, max_record;
     BYTE *bits, *src, *dst, *end;
-    UINT size, total, max_record = 0;
+    METAHEADER *mh, *out;
+    ENHMETAHEADER header;
     HDC hdc;
 
     TRACE("(%p, %d, %p, %d, %#x)\n", hemf, cbData16, pData16, iMapMode, eFlags);
@@ -4670,9 +4670,9 @@ UINT WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE hemf, UINT cbData16,
     end = bits + size;
     while (end - src >= 6)
     {
-        DWORD words = *(DWORD *)src;
         WORD function = *(WORD *)(src + 4);
 
+        words = *(DWORD *)src;
         if (words < 3 || words * 2 > end - src)
             break;
         if (!(eFlags & EmfToWmfBitsFlagsEmbedEmf) && function == META_ESCAPE && words >= 7
@@ -4682,46 +4682,68 @@ UINT WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE hemf, UINT cbData16,
             continue;
         }
         memmove(dst, src, words * 2);
-        max_record = max(max_record, words);
         dst += words * 2;
         src += words * 2;
     }
     size = dst - bits;
-    mh->mtSize = size / 2;
-    mh->mtMaxRecord = max_record;
 
-    total = size;
-    if (eFlags & EmfToWmfBitsFlagsIncludePlaceable)
-        total += 22;
-    if (pData16)
+    header_size = mh->mtHeaderSize * 2;
+    placeable_size = eFlags & EmfToWmfBitsFlagsIncludePlaceable ? 22 : 0;
+    if (!pData16)
     {
-        if (cbData16 < total)
+        free(bits);
+        return placeable_size + size;
+    }
+
+    /* As on Windows, the header goes first with no size, then each record that fits.  A record that does not fit
+     * fails the call, except the final META_EOF, without which the rest is returned; the placeable header, and
+     * the size in the header, are written last. */
+    if (cbData16 < placeable_size + header_size)
+    {
+        free(bits);
+        return 0;
+    }
+    out = (METAHEADER *)(pData16 + placeable_size);
+    memcpy(out, bits, header_size);
+    out->mtSize = 0;
+    out->mtMaxRecord = 0;
+    total = placeable_size + header_size;
+    max_record = 0;
+    for (src = bits + header_size; src < bits + size; src += words * 2)
+    {
+        words = *(DWORD *)src;
+        if (total + words * 2 > cbData16)
         {
+            if (*(WORD *)(src + 4) == 0 /* META_EOF */)
+                break;
             free(bits);
             return 0;
         }
-        dst = pData16;
-        if (eFlags & EmfToWmfBitsFlagsIncludePlaceable)
-        {
-            /* the frame, in 1/48 of an inch */
-            WORD placeable[11], checksum = 0;
-            unsigned int i;
-
-            memcpy(placeable, &placeable_key, sizeof(placeable_key));
-            placeable[2] = 0;
-            placeable[3] = header.rclFrame.left * 48 / 2540;
-            placeable[4] = header.rclFrame.top * 48 / 2540;
-            placeable[5] = header.rclFrame.right * 48 / 2540;
-            placeable[6] = header.rclFrame.bottom * 48 / 2540;
-            placeable[7] = 48;
-            placeable[8] = placeable[9] = 0;
-            for (i = 0; i < 10; i++)
-                checksum ^= placeable[i];
-            placeable[10] = checksum;
-            memcpy(dst, placeable, 22);
-            dst += 22;
-        }
-        memcpy(dst, bits, size);
+        memcpy(pData16 + total, src, words * 2);
+        max_record = max(max_record, words);
+        total += words * 2;
+    }
+    out->mtSize = (total - placeable_size) / 2;
+    out->mtMaxRecord = max_record;
+
+    if (placeable_size)
+    {
+        /* the frame, in 1/48 of an inch */
+        WORD placeable[11], checksum = 0;
+        unsigned int i;
+
+        memcpy(placeable, &placeable_key, sizeof(placeable_key));
+        placeable[2] = 0;
+        placeable[3] = header.rclFrame.left * 48 / 2540;
+        placeable[4] = header.rclFrame.top * 48 / 2540;
+        placeable[5] = header.rclFrame.right * 48 / 2540;
+        placeable[6] = header.rclFrame.bottom * 48 / 2540;
+        placeable[7] = 48;
+        placeable[8] = placeable[9] = 0;
+        for (i = 0; i < 10; i++)
+            checksum ^= placeable[i];
+        placeable[10] = checksum;
+        memcpy(pData16, placeable, placeable_size);
     }
     free(bits);
     return total;
diff --git a/dlls/gdiplus/tests/metafile.c b/dlls/gdiplus/tests/metafile.c
index f3b0afff5b7..cbbcbaa2ce9 100644
--- a/dlls/gdiplus/tests/metafile.c
+++ b/dlls/gdiplus/tests/metafile.c
@@ -4321,9 +4321,34 @@ static void test_emftowmfbits(void)
     ok(placeable_size == size + 22, "got %u, without the header %u\n", placeable_size, size);
 
     data = malloc(placeable_size);
-    ok(!GdipEmfToWmfBits(emf, size - 1, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault), "fits in a smaller buffer\n");
-    ok(GdipEmfToWmfBits(emf, size, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault) == size, "wrong size\n");
     mh = (const METAHEADER *)data;
+
+    /* A buffer too small only for the final META_EOF gets the rest; one too small for another record fails, with
+     * the header written, but with no size. */
+    memset(data, 0xcc, placeable_size);
+    ok(GdipEmfToWmfBits(emf, size - 1, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault) == size - 6, "wrong size\n");
+    ok(mh->mtSize * 2 == size - 6, "header size %lu words\n", mh->mtSize);
+    ok(*(const WORD *)(data + size - 10) != 0, "got META_EOF\n");
+    ok(data[size - 6] == 0xcc, "wrote past the records\n");
+    memset(data, 0xcc, placeable_size);
+    ok(!GdipEmfToWmfBits(emf, sizeof(METAHEADER) + 1, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault),
+            "fits in a smaller buffer\n");
+    ok(mh->mtType == 1 && mh->mtHeaderSize == 9, "got type %u, header %u words\n", mh->mtType, mh->mtHeaderSize);
+    ok(!mh->mtSize && !mh->mtMaxRecord, "got size %lu, largest record %lu\n", mh->mtSize, mh->mtMaxRecord);
+    memset(data, 0xcc, placeable_size);
+    ok(!GdipEmfToWmfBits(emf, sizeof(METAHEADER) - 1, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault),
+            "fits in a smaller buffer\n");
+    ok(*(const DWORD *)data == 0xcccccccc, "wrote %#lx\n", *(const DWORD *)data);
+    memset(data, 0xcc, placeable_size);
+    ok(GdipEmfToWmfBits(emf, placeable_size - 1, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsIncludePlaceable)
+            == placeable_size - 6, "wrong size\n");
+    ok(*(const DWORD *)data == 0x9ac6cdd7, "got key %#lx\n", *(const DWORD *)data);
+    memset(data, 0xcc, placeable_size);
+    ok(!GdipEmfToWmfBits(emf, 22 + sizeof(METAHEADER), data, MM_ANISOTROPIC, EmfToWmfBitsFlagsIncludePlaceable),
+            "fits in a smaller buffer\n");
+    ok(*(const DWORD *)data == 0xcccccccc, "wrote key %#lx\n", *(const DWORD *)data);
+
+    ok(GdipEmfToWmfBits(emf, size, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault) == size, "wrong size\n");
     ok(mh->mtSize * 2 == size, "header size %lu words, got %u bytes\n", mh->mtSize, size);
     for (p = data + mh->mtHeaderSize * 2, i = 0; p < data + size; p += words * 2, i++)
     {
