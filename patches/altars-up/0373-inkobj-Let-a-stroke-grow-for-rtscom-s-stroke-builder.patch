From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 09:34:18 -0400
Subject: [PATCH] inkobj: Let a stroke grow, for rtscom's stroke builder.

A stroke builder makes a stroke in its ink at the first packet and adds
the packets that follow as they come, so the stroke being drawn can be
shown; the automation interfaces have nothing that adds packets to a
stroke.  Strokes now also answer IWineInkStroke, whose AppendPackets
adds whole packets laid out as the stroke's description says.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/inkobj/ink.c b/dlls/inkobj/ink.c
index 550dae981a3..333c8ce5d25 100644
--- a/dlls/inkobj/ink.c
+++ b/dlls/inkobj/ink.c
@@ -471,6 +471,7 @@ static void ink_delete_stroke(struct ink *ink, struct stroke_data *data);
 struct stroke
 {
     IInkStrokeDisp IInkStrokeDisp_iface;
+    IWineInkStroke IWineInkStroke_iface;
     LONG refcount;
     struct ink *ink;
     struct stroke_data *data;
@@ -524,6 +525,12 @@ static HRESULT WINAPI stroke_QueryInterface(IInkStrokeDisp *iface, REFIID riid,
         IInkStrokeDisp_AddRef(iface);
         return S_OK;
     }
+    if (IsEqualGUID(riid, &IID_IWineInkStroke))
+    {
+        *out = &impl_from_IInkStrokeDisp(iface)->IWineInkStroke_iface;
+        IInkStrokeDisp_AddRef(iface);
+        return S_OK;
+    }
 
     WARN("Unsupported interface %s.\n", debugstr_guid(riid));
     *out = NULL;
@@ -1313,6 +1320,59 @@ static const IInkStrokeDispVtbl stroke_vtbl =
     stroke_ScaleTransform,
 };
 
+static inline struct stroke *impl_from_IWineInkStroke(IWineInkStroke *iface)
+{
+    return CONTAINING_RECORD(iface, struct stroke, IWineInkStroke_iface);
+}
+
+static HRESULT WINAPI wine_stroke_QueryInterface(IWineInkStroke *iface, REFIID riid, void **out)
+{
+    return stroke_QueryInterface(&impl_from_IWineInkStroke(iface)->IInkStrokeDisp_iface, riid, out);
+}
+
+static ULONG WINAPI wine_stroke_AddRef(IWineInkStroke *iface)
+{
+    return stroke_AddRef(&impl_from_IWineInkStroke(iface)->IInkStrokeDisp_iface);
+}
+
+static ULONG WINAPI wine_stroke_Release(IWineInkStroke *iface)
+{
+    return stroke_Release(&impl_from_IWineInkStroke(iface)->IInkStrokeDisp_iface);
+}
+
+/* whole packets, laid out as the stroke's description says */
+static HRESULT WINAPI wine_stroke_AppendPackets(IWineInkStroke *iface, ULONG count, const LONG *packets)
+{
+    struct stroke *stroke = impl_from_IWineInkStroke(iface);
+    struct stroke_data *data = stroke->data;
+    LONG *grown;
+    HRESULT hr;
+
+    TRACE("iface %p, count %lu, packets %p.\n", iface, count, packets);
+
+    if (!count) return S_OK;
+    if (!packets) return E_POINTER;
+    if (FAILED(hr = stroke_lock(stroke))) return hr;
+    if (!(grown = realloc(data->packets, (data->packet_count + count) * data->packet_size * sizeof(*grown))))
+    {
+        stroke_unlock(stroke, FALSE);
+        return E_OUTOFMEMORY;
+    }
+    memcpy(grown + data->packet_count * data->packet_size, packets, count * data->packet_size * sizeof(*grown));
+    data->packets = grown;
+    data->packet_count += count;
+    stroke_unlock(stroke, TRUE);
+    return S_OK;
+}
+
+static const IWineInkStrokeVtbl wine_stroke_vtbl =
+{
+    wine_stroke_QueryInterface,
+    wine_stroke_AddRef,
+    wine_stroke_Release,
+    wine_stroke_AppendPackets,
+};
+
 static HRESULT stroke_create(struct ink *ink, struct stroke_data *data, IInkStrokeDisp **out)
 {
     struct stroke *stroke;
@@ -1321,6 +1381,7 @@ static HRESULT stroke_create(struct ink *ink, struct stroke_data *data, IInkStro
         return E_OUTOFMEMORY;
 
     stroke->IInkStrokeDisp_iface.lpVtbl = &stroke_vtbl;
+    stroke->IWineInkStroke_iface.lpVtbl = &wine_stroke_vtbl;
     stroke->refcount = 1;
     stroke->ink = ink;
     IInkDisp_AddRef(&ink->IInkDisp_iface);
