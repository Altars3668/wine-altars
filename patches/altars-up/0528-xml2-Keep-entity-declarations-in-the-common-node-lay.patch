From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 21:07:49 -0400
Subject: [PATCH] xml2: Keep entity declarations in the common node layout.

Wine's extra application pointer is present in the other common node
headers, but was missing from xmlEntity. DTD entity declarations cast to
xmlNode therefore had a different type/doc offset and xmlFreeDtd could
free an invalid content pointer. Include the extra slot and update the
predefined entity initializers before rebuilding the static library.

Co-Authored-By: Claude Code <noreply@anthropic.com>

diff --git a/libs/xml2/entities.c b/libs/xml2/entities.c
index aec51441476..2273b76c1e2 100644
--- a/libs/xml2/entities.c
+++ b/libs/xml2/entities.c
@@ -33,35 +33,35 @@
  */
 
 static xmlEntity xmlEntityLt = {
-    NULL, XML_ENTITY_DECL, BAD_CAST "lt",
+    NULL, NULL, XML_ENTITY_DECL, BAD_CAST "lt",
     NULL, NULL, NULL, NULL, NULL, NULL,
     BAD_CAST "<", BAD_CAST "<", 1,
     XML_INTERNAL_PREDEFINED_ENTITY,
     NULL, NULL, NULL, NULL, 0, 0, 0
 };
 static xmlEntity xmlEntityGt = {
-    NULL, XML_ENTITY_DECL, BAD_CAST "gt",
+    NULL, NULL, XML_ENTITY_DECL, BAD_CAST "gt",
     NULL, NULL, NULL, NULL, NULL, NULL,
     BAD_CAST ">", BAD_CAST ">", 1,
     XML_INTERNAL_PREDEFINED_ENTITY,
     NULL, NULL, NULL, NULL, 0, 0, 0
 };
 static xmlEntity xmlEntityAmp = {
-    NULL, XML_ENTITY_DECL, BAD_CAST "amp",
+    NULL, NULL, XML_ENTITY_DECL, BAD_CAST "amp",
     NULL, NULL, NULL, NULL, NULL, NULL,
     BAD_CAST "&", BAD_CAST "&", 1,
     XML_INTERNAL_PREDEFINED_ENTITY,
     NULL, NULL, NULL, NULL, 0, 0, 0
 };
 static xmlEntity xmlEntityQuot = {
-    NULL, XML_ENTITY_DECL, BAD_CAST "quot",
+    NULL, NULL, XML_ENTITY_DECL, BAD_CAST "quot",
     NULL, NULL, NULL, NULL, NULL, NULL,
     BAD_CAST "\"", BAD_CAST "\"", 1,
     XML_INTERNAL_PREDEFINED_ENTITY,
     NULL, NULL, NULL, NULL, 0, 0, 0
 };
 static xmlEntity xmlEntityApos = {
-    NULL, XML_ENTITY_DECL, BAD_CAST "apos",
+    NULL, NULL, XML_ENTITY_DECL, BAD_CAST "apos",
     NULL, NULL, NULL, NULL, NULL, NULL,
     BAD_CAST "'", BAD_CAST "'", 1,
     XML_INTERNAL_PREDEFINED_ENTITY,
diff --git a/libs/xml2/include/libxml/entities.h b/libs/xml2/include/libxml/entities.h
index f679375321e..91978a2998b 100644
--- a/libs/xml2/include/libxml/entities.h
+++ b/libs/xml2/include/libxml/entities.h
@@ -39,6 +39,7 @@ typedef enum {
 
 struct _xmlEntity {
     void           *_private;	        /* application data */
+    void           *_private2;
     xmlElementType          type;       /* XML_ENTITY_DECL, must be second ! */
     const xmlChar          *name;	/* Entity name */
     struct _xmlNode    *children;	/* First child link */
