From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 19:02:46 -0400
Subject: [PATCH] iertutil: implement Uri_CREATE_CANONICALIZE_ABSOLUTE.

With it, and only in the absolute URI, every character beyond ASCII is
percent-encoded as UTF-8 in upper case hex, and for a known scheme so
is every forbidden character NO_DECODE_EXTRA_INFO left alone in the
query and fragment; the other properties, the display URI among them,
are as they were.  A file URI keeps its characters, and an unknown
scheme its forbidden ones.  All as measured on Windows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 8cdac8a8a649ecff3bd429515e6f4ae8e61902c5)

diff --git a/dlls/iertutil/uri.c b/dlls/iertutil/uri.c
index e8bfca72f8d..696e438bc5d 100644
--- a/dlls/iertutil/uri.c
+++ b/dlls/iertutil/uri.c
@@ -590,6 +590,52 @@ static DWORD decode_intl_char(const WCHAR *ptr, const WCHAR *end, URL_SCHEME sch
     return count * 3;
 }
 
+/* Uri_CREATE_CANONICALIZE_ABSOLUTE: the absolute URI with every character
+ * beyond ASCII percent encoded as UTF-8, and, for a known scheme, the
+ * forbidden characters NO_DECODE_EXTRA_INFO left in the query and fragment
+ * percent encoded too. */
+static inline BOOL needs_absolute_encoding(WCHAR c, BOOL known_scheme) {
+    if(!is_ascii(c))
+        return TRUE;
+    return known_scheme && !is_unreserved(c) && !is_reserved(c) && c != '%' && c != '\\';
+}
+
+static HRESULT canonicalize_absolute(BSTR *str, BOOL known_scheme) {
+    DWORD len = SysStringLen(*str), new_len = 0, i, j;
+    char utf8[4];
+    BSTR ret;
+    int n, k;
+
+    for(i = 0; i < len; i++) {
+        if(!needs_absolute_encoding((*str)[i], known_scheme))
+            new_len++;
+        else if(IS_HIGH_SURROGATE((*str)[i]) && i + 1 < len && IS_LOW_SURROGATE((*str)[i + 1]))
+            new_len += 12, i++;
+        else
+            new_len += 3 * WideCharToMultiByte(CP_UTF8, 0, *str + i, 1, NULL, 0, NULL, NULL);
+    }
+    if(new_len == len)
+        return S_OK;
+
+    if(!(ret = SysAllocStringLen(NULL, new_len)))
+        return E_OUTOFMEMORY;
+    for(i = 0, j = 0; i < len; i++) {
+        if(!needs_absolute_encoding((*str)[i], known_scheme)) {
+            ret[j++] = (*str)[i];
+            continue;
+        }
+        n = (IS_HIGH_SURROGATE((*str)[i]) && i + 1 < len && IS_LOW_SURROGATE((*str)[i + 1])) ? 2 : 1;
+        n = WideCharToMultiByte(CP_UTF8, 0, *str + i, n, utf8, sizeof(utf8), NULL, NULL);
+        for(k = 0; k < n; k++, j += 3)
+            pct_encode_val((BYTE)utf8[k], ret + j);
+        if(IS_HIGH_SURROGATE((*str)[i]) && i + 1 < len && IS_LOW_SURROGATE((*str)[i + 1]))
+            i++;
+    }
+    SysFreeString(*str);
+    *str = ret;
+    return S_OK;
+}
+
 /* Attempts to parse the domain name from the host.
  *
  * This function also includes the Top-level Domain (TLD) name
@@ -4099,6 +4145,9 @@ static HRESULT WINAPI Uri_GetPropertyBSTR(IUri *iface, Uri_PROPERTY uriProp, BST
 
         if(!(*pbstrProperty))
             hres = E_OUTOFMEMORY;
+        else if(hres == S_OK && This->create_flags & Uri_CREATE_CANONICALIZE_ABSOLUTE &&
+                This->scheme_type != URL_SCHEME_FILE)
+            hres = canonicalize_absolute(pbstrProperty, This->scheme_type != URL_SCHEME_UNKNOWN);
 
         break;
     case Uri_PROPERTY_AUTHORITY:
@@ -4405,6 +4454,16 @@ static HRESULT WINAPI Uri_GetPropertyLength(IUri *iface, Uri_PROPERTY uriProp, D
             hres = S_OK;
         }
 
+        if(hres == S_OK && This->create_flags & Uri_CREATE_CANONICALIZE_ABSOLUTE &&
+           This->scheme_type != URL_SCHEME_FILE) {
+            BSTR str;
+
+            if(FAILED(hres = IUri_GetPropertyBSTR(iface, uriProp, &str, dwFlags)))
+                return hres;
+            *pcchProperty = SysStringLen(str);
+            SysFreeString(str);
+        }
+
         break;
     case Uri_PROPERTY_AUTHORITY:
         if(This->port_offset > -1 &&
@@ -5522,7 +5581,7 @@ HRESULT WINAPI CreateUri(LPCWSTR pwzURI, DWORD dwFlags, DWORD_PTR dwReserved, IU
         Uri_CREATE_DECODE_EXTRA_INFO|Uri_CREATE_NO_DECODE_EXTRA_INFO|Uri_CREATE_CRACK_UNKNOWN_SCHEMES|
         Uri_CREATE_NO_CRACK_UNKNOWN_SCHEMES|Uri_CREATE_PRE_PROCESS_HTML_URI|Uri_CREATE_NO_PRE_PROCESS_HTML_URI|
         Uri_CREATE_NO_IE_SETTINGS|Uri_CREATE_NO_ENCODE_FORBIDDEN_CHARACTERS|Uri_CREATE_FILE_USE_DOS_PATH|
-        Uri_CREATE_NORMALIZE_INTL_CHARACTERS;
+        Uri_CREATE_NORMALIZE_INTL_CHARACTERS|Uri_CREATE_CANONICALIZE_ABSOLUTE;
     Uri *ret;
     HRESULT hr;
     parse_data data;
diff --git a/dlls/urlmon/tests/uri.c b/dlls/urlmon/tests/uri.c
index 86ec0cc4644..d92de50861a 100644
--- a/dlls/urlmon/tests/uri.c
+++ b/dlls/urlmon/tests/uri.c
@@ -8496,7 +8496,8 @@ static void test_CreateUri_InvalidArgs(void) {
 }
 
 /* Uri_CREATE_NORMALIZE_INTL_CHARACTERS decodes percent encoded UTF-8 into the
- * characters an IRI may have. */
+ * characters an IRI may have, and Uri_CREATE_CANONICALIZE_ABSOLUTE encodes
+ * them again in the absolute URI. */
 static const struct {
     const WCHAR *uri;
     DWORD flags;
@@ -8549,6 +8550,24 @@ static const struct {
      L"file:///c:/\x00e4\x00b8\x00ad/A?%e4%b8%ad#%e4%b8%ad"},
     {L"file:///c:/%e4%b8%ad/%41?%e4%b8%ad#%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI,
      L"file:///c:/\x00e4\x00b8\x00ad/A?%e4%b8%ad#%e4%b8%ad"},
+    {L"http://example.com/\x4e2d\x00e9?\x4e2d#\x4e2d", Uri_CREATE_CANONICALIZE_ABSOLUTE, Uri_PROPERTY_ABSOLUTE_URI,
+     L"http://example.com/%E4%B8%AD%C3%A9?%E4%B8%AD#%E4%B8%AD"},
+    {L"http://example.com/\x4e2d\x00e9?\x4e2d#\x4e2d", Uri_CREATE_CANONICALIZE_ABSOLUTE, Uri_PROPERTY_DISPLAY_URI,
+     L"http://example.com/\x4e2d\x00e9?\x4e2d#\x4e2d"},
+    {L"http://example.com/\x4e2d\x00e9?\x4e2d#\x4e2d", Uri_CREATE_CANONICALIZE_ABSOLUTE, Uri_PROPERTY_PATH,
+     L"/\x4e2d\x00e9"},
+    {L"http://example.com/p q?\x00e9#f g", Uri_CREATE_CANONICALIZE_ABSOLUTE|Uri_CREATE_NO_DECODE_EXTRA_INFO,
+     Uri_PROPERTY_ABSOLUTE_URI, L"http://example.com/p%20q?%C3%A9#f%20g"},
+    {L"http://example.com/p q?\x00e9#f g", Uri_CREATE_CANONICALIZE_ABSOLUTE|Uri_CREATE_NO_DECODE_EXTRA_INFO,
+     Uri_PROPERTY_DISPLAY_URI, L"http://example.com/p%20q?\x00e9#f g"},
+    {L"https://u:p@h\x00e9llo.example/\x4e2d?q=\x00e9", Uri_CREATE_CANONICALIZE_ABSOLUTE, Uri_PROPERTY_ABSOLUTE_URI,
+     L"https://u:p@h%C3%A9llo.example/%E4%B8%AD?q=%C3%A9"},
+    {L"http://%e4%b8%ad.example/%e4%b8%ad?%e4%b8%ad#%e4%b8%ad",
+     Uri_CREATE_CANONICALIZE_ABSOLUTE|Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI,
+     L"http://%E4%B8%AD.example/%E4%B8%AD?%E4%B8%AD#%E4%B8%AD"},
+    {L"file:///c:/a b/\x00e9", Uri_CREATE_CANONICALIZE_ABSOLUTE, Uri_PROPERTY_ABSOLUTE_URI, L"file:///c:/a%20b/\x00e9"},
+    {L"dummy:some thing/\x00e9?%41", Uri_CREATE_CANONICALIZE_ABSOLUTE, Uri_PROPERTY_ABSOLUTE_URI,
+     L"dummy:some thing/%C3%A9?%41"},
 };
 
 static void test_CreateUri_intl(void) {
