From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:18 -0400
Subject: [PATCH] xmllite: The properties of the reader and the writer, and
 ending elements as Windows 11 does.

The reader keeps its conformance level, random access and entity
expansion limit; the writer its multi-language object, conformance level
(one of the three) and CompactEmptyElement, which writes <b/> instead of
<b /> (tools/startupgapsprobe misc, misc3).  Ending an element when none
is open is E_INVALIDARG before anything else and changes nothing, and a
character entity outside an element is refused as text is; the tests
expect Windows 11's answers, older ones being broken.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/xmllite/reader.c b/dlls/xmllite/reader.c
index b9fba03bcbe..66ad979d102 100644
--- a/dlls/xmllite/reader.c
+++ b/dlls/xmllite/reader.c
@@ -281,6 +281,9 @@ typedef struct
     strval strvalues[StringValue_Last];
     UINT depth;
     UINT max_depth;
+    XmlConformanceLevel conformance;
+    BOOL random_access;
+    LONG_PTR max_entity_expansion;
     BOOL is_empty_element;
     struct element empty_element; /* used for empty elements without end tag <a />,
                                      and to keep <?xml reader position */
@@ -3121,8 +3124,18 @@ static HRESULT WINAPI xmlreader_GetProperty(IXmlReader* iface, UINT property, LO
         case XmlReaderProperty_MaxElementDepth:
             *value = This->max_depth;
             break;
+        case XmlReaderProperty_ConformanceLevel:
+            *value = This->conformance;
+            break;
+        case XmlReaderProperty_RandomAccess:
+            *value = This->random_access;
+            break;
+        case XmlReaderProperty_MaxEntityExpansion:
+            *value = This->max_entity_expansion;
+            break;
         default:
-            FIXME("Unimplemented property (%u)\n", property);
+            /* Windows has no others either */
+            WARN("Unknown property (%u)\n", property);
             return E_NOTIMPL;
     }
 
@@ -3158,8 +3171,18 @@ static HRESULT WINAPI xmlreader_SetProperty(IXmlReader* iface, UINT property, LO
         case XmlReaderProperty_MaxElementDepth:
             This->max_depth = value;
             break;
+        case XmlReaderProperty_ConformanceLevel:
+            if (value < XmlConformanceLevel_Auto || value > XmlConformanceLevel_Document) return E_INVALIDARG;
+            This->conformance = value;
+            break;
+        case XmlReaderProperty_RandomAccess:
+            This->random_access = !!value;
+            break;
+        case XmlReaderProperty_MaxEntityExpansion:
+            This->max_entity_expansion = value;
+            break;
         default:
-            FIXME("Unimplemented property (%u)\n", property);
+            WARN("Unknown property (%u)\n", property);
             return E_NOTIMPL;
     }
 
@@ -3945,6 +3968,8 @@ HRESULT WINAPI CreateXmlReader(REFIID riid, void **obj, IMalloc *imalloc)
     list_init(&reader->ns);
     list_init(&reader->elements);
     reader->max_depth = 256;
+    reader->conformance = XmlConformanceLevel_Document;
+    reader->max_entity_expansion = 100000;
 
     reader->chunk_read_off = 0;
     for (i = 0; i < StringValue_Last; i++)
diff --git a/dlls/xmllite/tests/writer.c b/dlls/xmllite/tests/writer.c
index 5e5fdd38acf..5536ef26660 100644
--- a/dlls/xmllite/tests/writer.c
+++ b/dlls/xmllite/tests/writer.c
@@ -170,14 +170,15 @@ static void check_writer_state(IXmlWriter *writer, HRESULT exp_hr)
     hr = IXmlWriter_WriteEndDocument(writer);
     ok(hr == exp_hr, "Unexpected hr %#lx, expected %#lx.\n", hr, exp_hr);
 
+    /* no element is open, which Windows 11 asks first */
     hr = IXmlWriter_WriteEndElement(writer);
-    ok(hr == exp_hr, "Unexpected hr %#lx, expected %#lx.\n", hr, exp_hr);
+    ok(hr == E_INVALIDARG || broken(hr == exp_hr), "Unexpected hr %#lx, expected %#lx.\n", hr, exp_hr);
 
     hr = IXmlWriter_WriteEntityRef(writer, L"a");
     ok(hr == exp_hr, "Unexpected hr %#lx, expected %#lx.\n", hr, exp_hr);
 
     hr = IXmlWriter_WriteFullEndElement(writer);
-    ok(hr == exp_hr, "Unexpected hr %#lx, expected %#lx.\n", hr, exp_hr);
+    ok(hr == E_INVALIDARG || broken(hr == exp_hr), "Unexpected hr %#lx, expected %#lx.\n", hr, exp_hr);
 
     hr = IXmlWriter_WriteName(writer, L"a");
     ok(hr == exp_hr, "Unexpected hr %#lx, expected %#lx.\n", hr, exp_hr);
@@ -368,6 +369,67 @@ static void test_writer_create(void)
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     ok(value == XmlConformanceLevel_Document, "got %Id.\n", value);
 
+    /* the conformance level is one of the three, as Windows 11 has it */
+    hr = IXmlWriter_SetProperty(writer, XmlWriterProperty_ConformanceLevel, XmlConformanceLevel_Fragment);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_GetProperty(writer, XmlWriterProperty_ConformanceLevel, &value);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(value == XmlConformanceLevel_Fragment, "got %Id.\n", value);
+    hr = IXmlWriter_SetProperty(writer, XmlWriterProperty_ConformanceLevel, 3);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_SetProperty(writer, XmlWriterProperty_ConformanceLevel, -1);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_GetProperty(writer, XmlWriterProperty_ConformanceLevel, &value);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(value == XmlConformanceLevel_Fragment, "got %Id.\n", value);
+
+    value = TRUE;
+    hr = IXmlWriter_GetProperty(writer, XmlWriterProperty_CompactEmptyElement, &value);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(value == FALSE, "got %Id.\n", value);
+    hr = IXmlWriter_SetProperty(writer, XmlWriterProperty_CompactEmptyElement, 2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_GetProperty(writer, XmlWriterProperty_CompactEmptyElement, &value);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(value == TRUE, "got %Id.\n", value);
+
+    IXmlWriter_Release(writer);
+}
+
+/* empty elements written without the space before the slash */
+static void test_compact_empty_element(void)
+{
+    IXmlWriter *writer;
+    IStream *stream;
+    HRESULT hr;
+
+    hr = CreateXmlWriter(&IID_IXmlWriter, (void **)&writer, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_SetProperty(writer, XmlWriterProperty_CompactEmptyElement, TRUE);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_SetProperty(writer, XmlWriterProperty_OmitXmlDeclaration, TRUE);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    stream = writer_set_output(writer);
+
+    hr = IXmlWriter_WriteStartElement(writer, NULL, L"a", NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_WriteStartElement(writer, NULL, L"b", NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_WriteEndElement(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_WriteStartElement(writer, NULL, L"c", NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_WriteFullEndElement(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_WriteElementString(writer, NULL, L"d", NULL, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_WriteEndElement(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlWriter_Flush(writer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    CHECK_OUTPUT(stream, "<a><b/><c></c><d/></a>");
+
+    IStream_Release(stream);
     IXmlWriter_Release(writer);
 }
 
@@ -411,13 +473,13 @@ static void test_invalid_output_encoding(IXmlWriter *writer, IUnknown *output)
     ok(hr == MX_E_ENCODING, "Unexpected hr %#lx.\n", hr);
 
     hr = IXmlWriter_WriteEndElement(writer);
-    ok(hr == MX_E_ENCODING, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG || broken(hr == MX_E_ENCODING), "Unexpected hr %#lx.\n", hr);
 
     hr = IXmlWriter_WriteEntityRef(writer, L"a");
     ok(hr == MX_E_ENCODING, "Unexpected hr %#lx.\n", hr);
 
     hr = IXmlWriter_WriteFullEndElement(writer);
-    ok(hr == MX_E_ENCODING, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG || broken(hr == MX_E_ENCODING), "Unexpected hr %#lx.\n", hr);
 
     hr = IXmlWriter_WriteName(writer, L"a");
     ok(hr == MX_E_ENCODING, "Unexpected hr %#lx.\n", hr);
@@ -1534,11 +1596,11 @@ static void test_writer_state(void)
     /* initial state */
     check_writer_state(writer, E_UNEXPECTED);
 
-    /* set output and call 'wrong' method, WriteEndElement */
+    /* set output and call 'wrong' method, WriteEndElement, which Windows 11 refuses without an element */
     stream = writer_set_output(writer);
 
     hr = IXmlWriter_WriteEndElement(writer);
-    ok(hr == WR_E_INVALIDACTION, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG || broken(hr == WR_E_INVALIDACTION), "Unexpected hr %#lx.\n", hr);
 
     check_writer_state(writer, WR_E_INVALIDACTION);
     IStream_Release(stream);
@@ -1565,7 +1627,7 @@ static void test_writer_state(void)
     stream = writer_set_output(writer);
 
     hr = IXmlWriter_WriteFullEndElement(writer);
-    ok(hr == WR_E_INVALIDACTION, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG || broken(hr == WR_E_INVALIDACTION), "Unexpected hr %#lx.\n", hr);
 
     check_writer_state(writer, WR_E_INVALIDACTION);
     IStream_Release(stream);
@@ -2232,12 +2294,12 @@ static void test_WriteRawChars(void)
 
     stream = writer_set_output(writer);
 
-    /* Force document close */
+    /* Force document close; Windows 11 refuses to end no element and leaves the document open */
     hr = IXmlWriter_WriteEndElement(writer);
-    ok(hr == WR_E_INVALIDACTION, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG || broken(hr == WR_E_INVALIDACTION), "Unexpected hr %#lx.\n", hr);
 
     hr = IXmlWriter_WriteRawChars(writer, L"a", 1);
-    ok(hr == WR_E_INVALIDACTION, "Unexpected hr %#lx.\n", hr);
+    ok(hr == S_OK || broken(hr == WR_E_INVALIDACTION), "Unexpected hr %#lx.\n", hr);
 
     IStream_Release(stream);
     IXmlWriter_Release(writer);
@@ -2288,7 +2350,7 @@ static void test_WriteSurrogateCharEntity(void)
     stream = writer_set_output(writer);
 
     hr = IXmlWriter_WriteEndElement(writer);
-    ok(hr == WR_E_INVALIDACTION, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG || broken(hr == WR_E_INVALIDACTION), "Unexpected hr %#lx.\n", hr);
 
     hr = IXmlWriter_WriteSurrogateCharEntity(writer, low, high);
     ok(hr == WR_E_INVALIDACTION, "Unexpected hr %#lx.\n", hr);
@@ -3564,6 +3626,7 @@ static void test_WriteQualifiedName(void)
 START_TEST(writer)
 {
     test_writer_create();
+    test_compact_empty_element();
     test_writer_state();
     test_writeroutput();
     test_writestartdocument();
diff --git a/dlls/xmllite/writer.c b/dlls/xmllite/writer.c
index 5567ff8cb8c..1bd6e012849 100644
--- a/dlls/xmllite/writer.c
+++ b/dlls/xmllite/writer.c
@@ -104,6 +104,8 @@ typedef struct _xmlwriter
     BOOL indent;
     BOOL bom;
     BOOL omitxmldecl;
+    BOOL compact_empty;
+    IUnknown *mlang;
     XmlConformanceLevel conformance;
     XmlWriterState state;
     struct list elements;
@@ -130,7 +132,8 @@ static const char *debugstr_writer_prop(XmlWriterProperty prop)
         "Indent",
         "ByteOrderMark",
         "OmitXmlDeclaration",
-        "ConformanceLevel"
+        "ConformanceLevel",
+        "CompactEmptyElement"
     };
 
     if (prop > _XmlWriterProperty_Last)
@@ -844,6 +847,7 @@ static ULONG WINAPI xmlwriter_Release(IXmlWriter *iface)
             IUnknown_Release(&writer->output->IXmlWriterOutput_iface);
 
         writer_free_element_stack(writer);
+        if (writer->mlang) IUnknown_Release(writer->mlang);
 
         writer_free(writer, writer);
         if (imalloc) IMalloc_Release(imalloc);
@@ -929,8 +933,16 @@ static HRESULT WINAPI xmlwriter_GetProperty(IXmlWriter *iface, UINT property, LO
         case XmlWriterProperty_ConformanceLevel:
             *value = This->conformance;
             break;
+        case XmlWriterProperty_MultiLanguage:
+            *value = (LONG_PTR)This->mlang;
+            if (This->mlang) IUnknown_AddRef(This->mlang);
+            break;
+        case XmlWriterProperty_CompactEmptyElement:
+            *value = This->compact_empty;
+            break;
         default:
-            FIXME("Unimplemented property (%u)\n", property);
+            /* Windows has no others either */
+            WARN("Unknown property (%u)\n", property);
             return E_NOTIMPL;
     }
 
@@ -954,8 +966,20 @@ static HRESULT WINAPI xmlwriter_SetProperty(IXmlWriter *iface, UINT property, LO
         case XmlWriterProperty_OmitXmlDeclaration:
             writer->omitxmldecl = !!value;
             break;
+        case XmlWriterProperty_MultiLanguage:
+            if (writer->mlang) IUnknown_Release(writer->mlang);
+            if ((writer->mlang = (IUnknown *)value)) IUnknown_AddRef(writer->mlang);
+            break;
+        case XmlWriterProperty_CompactEmptyElement:
+            writer->compact_empty = !!value;
+            break;
+        case XmlWriterProperty_ConformanceLevel:
+            if (value < XmlConformanceLevel_Auto || value > XmlConformanceLevel_Document)
+                return E_INVALIDARG;
+            writer->conformance = value;
+            break;
         default:
-            FIXME("Unimplemented property (%u)\n", property);
+            WARN("Unknown property (%u)\n", property);
             return E_NOTIMPL;
     }
 
@@ -1266,7 +1290,10 @@ static HRESULT WINAPI xmlwriter_WriteCharEntity(IXmlWriter *iface, WCHAR ch)
     case XmlWriterState_ElemStarted:
         hr = writer_close_starttag(writer);
         break;
+    /* character data is for an element, as it is for WriteString */
+    case XmlWriterState_Ready:
     case XmlWriterState_DocClosed:
+        writer->state = XmlWriterState_DocClosed;
         return WR_E_INVALIDACTION;
     default:
         ;
@@ -1571,6 +1598,8 @@ static HRESULT WINAPI xmlwriter_WriteElementString(IXmlWriter *iface, LPCWSTR pr
         write_output_qname(writer, prefix, prefix_len, local_name, local_len, &hr);
         write_output(writer, L">", 1, &hr);
     }
+    else if (writer->compact_empty)
+        write_output(writer, L"/>", 2, &hr);
     else
         write_output(writer, L" />", 3, &hr);
 
@@ -1588,7 +1617,10 @@ static HRESULT write_end_element(xmlwriter *writer, const struct element *elemen
     if (writer->starttagopen)
     {
         hr = writer_output_ns(writer, element);
-        write_output(writer, L" />", 3, &hr);
+        if (writer->compact_empty)
+            write_output(writer, L"/>", 2, &hr);
+        else
+            write_output(writer, L" />", 3, &hr);
         writer->starttagopen = 0;
     }
     else
@@ -1644,6 +1676,10 @@ static HRESULT WINAPI xmlwriter_WriteEndElement(IXmlWriter *iface)
 
     TRACE("%p.\n", iface);
 
+    /* Windows 11 asks for an element to end before anything else, and stays as it was */
+    if (list_empty(&writer->elements))
+        return E_INVALIDARG;
+
     switch (writer->state)
     {
     case XmlWriterState_Initial:
@@ -1714,6 +1750,10 @@ static HRESULT WINAPI xmlwriter_WriteFullEndElement(IXmlWriter *iface)
 
     TRACE("%p.\n", iface);
 
+    /* Windows 11 asks for an element to end before anything else, and stays as it was */
+    if (list_empty(&writer->elements))
+        return E_INVALIDARG;
+
     switch (writer->state)
     {
     case XmlWriterState_Initial:
@@ -2278,7 +2318,10 @@ static HRESULT WINAPI xmlwriter_WriteSurrogateCharEntity(IXmlWriter *iface, WCHA
     case XmlWriterState_ElemStarted:
         hr = writer_close_starttag(writer);
         break;
+    /* character data is for an element, as it is for WriteString */
+    case XmlWriterState_Ready:
     case XmlWriterState_DocClosed:
+        writer->state = XmlWriterState_DocClosed;
         return WR_E_INVALIDACTION;
     default:
         ;
diff --git a/include/xmllite.idl b/include/xmllite.idl
index b2de76e5630..bb32962bffe 100644
--- a/include/xmllite.idl
+++ b/include/xmllite.idl
@@ -249,7 +249,8 @@ typedef enum XmlWriterProperty
     XmlWriterProperty_ByteOrderMark,
     XmlWriterProperty_OmitXmlDeclaration,
     XmlWriterProperty_ConformanceLevel,
-    _XmlWriterProperty_Last = XmlWriterProperty_OmitXmlDeclaration
+    XmlWriterProperty_CompactEmptyElement,
+    _XmlWriterProperty_Last = XmlWriterProperty_CompactEmptyElement
 } XmlWriterProperty;
 
 /* IXmlWriter */
