From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 00:05:34 -0400
Subject: [PATCH] d3d11/tests: only unmap successful nonblocking maps

Keep the map retry test from dereferencing or unmapping an unexpected non-S_OK result.

Co-Authored-By: Claude Code <noreply@anthropic.com>
(cherry picked from commit 44bf2ca55095f957960c514cff7d64edd82d8e0c)

diff --git a/dlls/d3d11/tests/d3d11.c b/dlls/d3d11/tests/d3d11.c
index 26efad8988b..898c807fe2f 100644
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -15694,7 +15694,7 @@ static void test_map_do_not_wait(void)
                 hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &mapped);
                 ok(hr == S_OK, "Blocking map returned %#lx after busy.\n", hr);
             }
-            if (SUCCEEDED(hr))
+            if (hr == S_OK)
             {
                 ok(mapped.pData && *(DWORD *)mapped.pData == pixels[0], "Got data %p.\n", mapped.pData);
                 ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
@@ -15703,7 +15703,7 @@ static void test_map_do_not_wait(void)
             hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ,
                                         D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
             ok(hr == S_OK && mapped.pData, "Idle map returned %#lx, data %p.\n", hr, mapped.pData);
-            if (SUCCEEDED(hr)) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+            if (hr == S_OK) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
             ID3D11Texture2D_Release(staging);
         }
         ID3D11Texture2D_Release(source);
