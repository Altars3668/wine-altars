+/*
+ * HttpMethod is a name and nothing else, so it is implemented outright.
+ *
+ * HttpClient is the object the rest of the namespace hangs off.  Creating one,
+ * with or without a filter, and reaching the interfaces it promises is what a
+ * caller does before it ever sends anything, and that much works here.  The
+ * request methods need HttpRequestMessage, HttpResponseMessage and the
+ * asynchronous operations that carry them, none of which exist yet; they say
+ * so rather than handing back an operation that never completes, which is the
+ * one failure a caller cannot recover from.
+ */
+
+/*** HttpMethod ***/
+
+struct http_method
+{
+    IHttpMethod IHttpMethod_iface;
+    IStringable IStringable_iface;
+    LONG ref;
+    HSTRING method;
+};
+
+static inline struct http_method *impl_from_IHttpMethod( IHttpMethod *iface )
+{
+    return CONTAINING_RECORD( iface, struct http_method, IHttpMethod_iface );
+}
+
+static HRESULT WINAPI method_QueryInterface( IHttpMethod *iface, REFIID iid, void **out )
+{
+    struct http_method *impl = impl_from_IHttpMethod( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IHttpMethod ))
+    {
+        *out = &impl->IHttpMethod_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IStringable ))
+    {
+        *out = &impl->IStringable_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI method_AddRef( IHttpMethod *iface )
+{
+    struct http_method *impl = impl_from_IHttpMethod( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI method_Release( IHttpMethod *iface )
+{
+    struct http_method *impl = impl_from_IHttpMethod( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->method );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI method_GetIids( IHttpMethod *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI method_GetRuntimeClassName( IHttpMethod *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Web_Http_HttpMethod,
+                                ARRAY_SIZE(RuntimeClass_Windows_Web_Http_HttpMethod) - 1, class_name );
+}
+
+static HRESULT WINAPI method_GetTrustLevel( IHttpMethod *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI method_get_Method( IHttpMethod *iface, HSTRING *value )
+{
+    struct http_method *impl = impl_from_IHttpMethod( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl->method, value );
+}
+
+static const struct IHttpMethodVtbl method_vtbl =
+{
+    method_QueryInterface,
+    method_AddRef,
+    method_Release,
+    /* IInspectable methods */
+    method_GetIids,
+    method_GetRuntimeClassName,
+    method_GetTrustLevel,
+    /* IHttpMethod methods */
+    method_get_Method,
+};
+
+DEFINE_IINSPECTABLE_( method_stringable, IStringable, struct http_method, impl_from_method_IStringable,
+                      IStringable_iface, &impl->IHttpMethod_iface )
+
+static HRESULT WINAPI method_stringable_ToString( IStringable *iface, HSTRING *value )
+{
+    struct http_method *impl = impl_from_method_IStringable( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( impl->method, value );
+}
+
+static const struct IStringableVtbl method_stringable_vtbl =
+{
+    method_stringable_QueryInterface,
+    method_stringable_AddRef,
+    method_stringable_Release,
+    /* IInspectable methods */
+    method_stringable_GetIids,
+    method_stringable_GetRuntimeClassName,
+    method_stringable_GetTrustLevel,
+    /* IStringable methods */
+    method_stringable_ToString,
+};
+
+static HRESULT create_http_method( HSTRING name, IHttpMethod **out )
+{
+    struct http_method *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+
+    impl->IHttpMethod_iface.lpVtbl = &method_vtbl;
+    impl->IStringable_iface.lpVtbl = &method_stringable_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = WindowsDuplicateString( name, &impl->method )))
+    {
+        free( impl );
+        return hr;
+    }
+
+    *out = &impl->IHttpMethod_iface;
+    return S_OK;
+}
+
+static HRESULT create_http_method_from_ascii( const WCHAR *name, IHttpMethod **out )
+{
+    HSTRING str;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsCreateString( name, wcslen( name ), &str ))) return hr;
+    hr = create_http_method( str, out );
+    WindowsDeleteString( str );
+    return hr;
+}
+
+/*** HttpClient ***/
+
+struct http_client
+{
+    IHttpClient IHttpClient_iface;
+    IClosable IClosable_iface;
+    IStringable IStringable_iface;
+    LONG ref;
