+static inline struct client_statics *client_statics_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct client_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI client_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct client_statics *impl = client_statics_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IHttpClientFactory ))
+    {
+        *out = &impl->IHttpClientFactory_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI client_factory_AddRef( IActivationFactory *iface )
+{
+    struct client_statics *impl = client_statics_from_IActivationFactory( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI client_factory_Release( IActivationFactory *iface )
+{
+    struct client_statics *impl = client_statics_from_IActivationFactory( iface );
+    return InterlockedDecrement( &impl->ref );
+}
