+/* Sending needs HttpRequestMessage, HttpResponseMessage and the asynchronous
+ * operations that carry them.  Until those exist, say so here: an operation
+ * that is handed back and never completes leaves the caller waiting with
+ * nothing to blame. */
+#define CLIENT_SEND_NOT_IMPLEMENTED( name, ... )                                                   \
+    static HRESULT WINAPI client_##name( IHttpClient *iface, __VA_ARGS__ IInspectable **operation ) \
+    {                                                                                              \
+        FIXME( "iface %p: " #name " needs HttpRequestMessage/HttpResponseMessage.\n", iface );      \
+        if (operation) *operation = NULL;                                                          \
+        return E_NOTIMPL;                                                                          \
+    }
+
+CLIENT_SEND_NOT_IMPLEMENTED( DeleteAsync, IInspectable *uri, )
+CLIENT_SEND_NOT_IMPLEMENTED( GetAsync, IInspectable *uri, )
+CLIENT_SEND_NOT_IMPLEMENTED( GetWithOptionAsync, IInspectable *uri, HttpCompletionOption option, )
+CLIENT_SEND_NOT_IMPLEMENTED( GetBufferAsync, IInspectable *uri, )
+CLIENT_SEND_NOT_IMPLEMENTED( GetInputStreamAsync, IInspectable *uri, )
+CLIENT_SEND_NOT_IMPLEMENTED( GetStringAsync, IInspectable *uri, )
+CLIENT_SEND_NOT_IMPLEMENTED( PostAsync, IInspectable *uri, IInspectable *content, )
+CLIENT_SEND_NOT_IMPLEMENTED( PutAsync, IInspectable *uri, IInspectable *content, )
+CLIENT_SEND_NOT_IMPLEMENTED( SendRequestAsync, IInspectable *request, )
+CLIENT_SEND_NOT_IMPLEMENTED( SendRequestWithOptionAsync, IInspectable *request, HttpCompletionOption option, )
+
+static HRESULT WINAPI client_get_DefaultRequestHeaders( IHttpClient *iface, IInspectable **value )
+{
+    FIXME( "iface %p, value %p: HttpRequestHeaderCollection is not implemented.\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IHttpClientVtbl client_vtbl =
+{
+    client_QueryInterface,
+    client_AddRef,
+    client_Release,
+    /* IInspectable methods */
+    client_GetIids,
+    client_GetRuntimeClassName,
+    client_GetTrustLevel,
+    /* IHttpClient methods */
+    client_DeleteAsync,
+    client_GetAsync,
+    client_GetWithOptionAsync,
+    client_GetBufferAsync,
+    client_GetInputStreamAsync,
+    client_GetStringAsync,
+    client_PostAsync,
+    client_PutAsync,
+    client_SendRequestAsync,
+    client_SendRequestWithOptionAsync,
