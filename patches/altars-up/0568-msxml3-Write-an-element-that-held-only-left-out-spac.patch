From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 12:15:36 -0400
Subject: [PATCH] msxml3: Write an element that held only left-out spaces with
 an end tag, as Windows does.

A document that does not keep spaces leaves out the ones that are all an
element holds, and Windows still writes that element with its end tag
and the line break the spaces stand for, "<a>\r\n</a>", as its other
elements are written around spaces left out (Wine's own tests had it as
todo_wine; tools/msxmlmoreprobe in the wine-altars repository, its
spaces section, for elements declared EMPTY and #PCDATA).  Wine wrote
"<a/>".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 39c5a860cc0..706a5a07483 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -2110,7 +2110,9 @@ static void node_dump(struct domnode *node, struct node_dump_context *context)
             node_dump_append(context, L"<", 1);
             node_dump_qualified_name(context, node);
             node_dump_element_attributes(context, node);
-            if (list_empty(&node->children))
+            /* one that held only spaces, left out, is still written with an end tag, and the
+             * line break they stand for */
+            if (list_empty(&node->children) && !(node->flags & DOMNODE_IGNORED_WS_AFTER_STARTTAG))
             {
                 node_dump_append(context, L"/>", 2);
             }
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index 17e094a4833..83532454499 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -5035,7 +5035,6 @@ static void test_whitespace(void)
 
     hr = IXMLDOMElement_get_xml(element, &text);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
-    todo_wine
     ok(!wcscmp(text, L"<a>\r\n</a>"), "Unexpected text %s.\n", debugstr_w(text));
     SysFreeString(text);
 
@@ -10248,7 +10247,6 @@ static void test_get_xml(void)
 
     hr = IXMLDOMElement_get_xml(elem, &xml);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
-    todo_wine
     ok(!wcscmp(xml, L"<a>\r\n</a>"), "Unexpected text %s.\n", debugstr_w(xml));
     SysFreeString(xml);
 
@@ -10256,7 +10254,6 @@ static void test_get_xml(void)
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     hr = IXMLDOMElement_get_xml(elem, &xml);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
-    todo_wine
     ok(!wcscmp(xml, L"<a>\r\n</a>"), "Unexpected text %s.\n", debugstr_w(xml));
     SysFreeString(xml);
     IXMLDOMElement_Release(elem);
