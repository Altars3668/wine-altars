--- a/dlls/ole32/tests/marshal.c
+++ b/dlls/ole32/tests/marshal.c
@@ -3153,6 +3153,159 @@ static void test_message_filter_calls(void)
     ok_no_locks();
 }
 
+/* a filter that answers the first incoming call as it is told, and the calls it made that were rejected with the
+ * delays it is given */
+static DWORD filter_answer, filter_caller, filter_callee, filter_reject_type, filter_retry_tick;
+static LONG filter_delays[2], filter_delay_count, filter_incoming, filter_retries;
+
+static DWORD WINAPI AnsweringFilter_HandleInComingCall(IMessageFilter *iface, DWORD type, HTASK caller, DWORD tick,
+                                                       INTERFACEINFO *info)
+{
+    filter_caller = HandleToUlong(caller);
+    return filter_incoming++ ? SERVERCALL_ISHANDLED : filter_answer;
+}
+
+static DWORD WINAPI AnsweringFilter_RetryRejectedCall(IMessageFilter *iface, HTASK callee, DWORD tick, DWORD type)
+{
+    LONG i = filter_retries++;
+
+    filter_callee = HandleToUlong(callee);
+    filter_reject_type = type;
+    filter_retry_tick = tick;
+    return i < filter_delay_count ? filter_delays[i] : -1;
+}
+
+static const IMessageFilterVtbl AnsweringFilter_Vtbl =
+{
+    MessageFilter_QueryInterface,
+    MessageFilter_AddRef,
+    MessageFilter_Release,
+    AnsweringFilter_HandleInComingCall,
+    AnsweringFilter_RetryRejectedCall,
+    RecordingFilter_MessagePending
+};
+
+static IMessageFilter AnsweringFilter = { &AnsweringFilter_Vtbl };
+
+static const struct
+{
+    DWORD apartment;
+    BOOL filter;
+    DWORD answer;
+    LONG delay;
+    HRESULT hr;
+    LONG incoming, retries;
+}
+rejected_tests[] =
+{
+    { COINIT_APARTMENTTHREADED, TRUE, SERVERCALL_RETRYLATER, 0, E_NOINTERFACE, 2, 1 },
+    { COINIT_APARTMENTTHREADED, TRUE, SERVERCALL_RETRYLATER, 99, E_NOINTERFACE, 2, 1 },
+    { COINIT_APARTMENTTHREADED, TRUE, SERVERCALL_RETRYLATER, 150, E_NOINTERFACE, 2, 1 },
+    { COINIT_APARTMENTTHREADED, TRUE, SERVERCALL_RETRYLATER, -1, RPC_E_CALL_REJECTED, 1, 1 },
+    { COINIT_APARTMENTTHREADED, TRUE, SERVERCALL_REJECTED, 0, E_NOINTERFACE, 2, 1 },
+    { COINIT_APARTMENTTHREADED, TRUE, SERVERCALL_REJECTED, -1, RPC_E_CALL_REJECTED, 1, 1 },
+    { COINIT_APARTMENTTHREADED, FALSE, SERVERCALL_RETRYLATER, 0, RPC_E_CALL_REJECTED, 1, 0 },
+    { COINIT_APARTMENTTHREADED, FALSE, SERVERCALL_REJECTED, 0, RPC_E_CALL_REJECTED, 1, 0 },
+    { COINIT_MULTITHREADED, FALSE, SERVERCALL_RETRYLATER, 0, RPC_E_SERVERCALL_RETRYLATER, 1, 0 },
+    { COINIT_MULTITHREADED, FALSE, SERVERCALL_REJECTED, 0, RPC_E_CALL_REJECTED, 1, 0 },
+};
+
+struct rejected_client_params
+{
+    IStream *streams[ARRAY_SIZE(rejected_tests)];
+    DWORD main_tid;
+    HANDLE done;
+};
+
+static DWORD CALLBACK rejected_client_thread(void *arg)
+{
+    struct rejected_client_params *params = arg;
+    IMessageFilter *prev_filter;
+    IClassFactory *cf;
+    DWORD start, elapsed;
+    unsigned int i;
+    IUnknown *unk;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(rejected_tests); i++)
+    {
+        winetest_push_context("%u", i);
+        CoInitializeEx(NULL, rejected_tests[i].apartment);
+        if (rejected_tests[i].filter)
+        {
+            hr = CoRegisterMessageFilter(&AnsweringFilter, &prev_filter);
+            ok_ole_success(hr, CoRegisterMessageFilter);
+        }
+        hr = CoGetInterfaceAndReleaseStream(params->streams[i], &IID_IClassFactory, (void **)&cf);
+        ok_ole_success(hr, CoGetInterfaceAndReleaseStream);
+
+        filter_answer = rejected_tests[i].answer;
+        filter_delays[0] = rejected_tests[i].delay;
+        filter_delay_count = 1;
+        filter_incoming = filter_retries = 0;
+        filter_caller = filter_callee = 0xdeadbeef;
+        start = GetTickCount();
+        hr = IClassFactory_CreateInstance(cf, NULL, &IID_IOleWindow, (void **)&unk);
+        elapsed = GetTickCount() - start;
+        ok(hr == rejected_tests[i].hr, "got %#lx.\n", hr);
+        ok(filter_incoming == rejected_tests[i].incoming, "got %ld incoming calls.\n", filter_incoming);
+        ok(filter_retries == rejected_tests[i].retries, "got %ld retries.\n", filter_retries);
+        /* the called apartment is told the calling thread when it is a single-threaded apartment */
+        ok(filter_caller == (rejected_tests[i].apartment == COINIT_MULTITHREADED ? 0 : GetCurrentThreadId()),
+           "got caller %#lx.\n", filter_caller);
+        if (filter_retries)
+        {
+            ok(filter_callee == params->main_tid, "got callee %#lx.\n", filter_callee);
+            ok(filter_reject_type == rejected_tests[i].answer, "got type %lu.\n", filter_reject_type);
+            ok(filter_retry_tick < 1000, "got tick count %lu.\n", filter_retry_tick);
+        }
+        if (rejected_tests[i].delay >= 100 && rejected_tests[i].hr == E_NOINTERFACE)
+            ok(elapsed >= 100, "retried after %lu ms.\n", elapsed);
+
+        IClassFactory_Release(cf);
+        if (rejected_tests[i].filter) CoRegisterMessageFilter(prev_filter, NULL);
+        CoUninitialize();
+        winetest_pop_context();
+    }
+    SetEvent(params->done);
+    return 0;
+}
+
+/* A call the called apartment's message filter rejects, or asks to be made again later, goes back unmade; the
+ * calling apartment's own filter, when it is a single-threaded apartment that has one, decides whether and when
+ * to make it again. */
+static void test_rejected_calls(void)
+{
+    struct rejected_client_params params;
+    IMessageFilter *prev_filter;
+    HANDLE thread;
+    unsigned int i;
+    DWORD index;
+    HRESULT hr;
+
+    cLocks = 0;
+
+    hr = CoRegisterMessageFilter(&AnsweringFilter, &prev_filter);
+    ok_ole_success(hr, CoRegisterMessageFilter);
+    for (i = 0; i < ARRAY_SIZE(rejected_tests); i++)
+    {
+        hr = CoMarshalInterThreadInterfaceInStream(&IID_IClassFactory, (IUnknown *)&Test_ClassFactory,
+                                                   &params.streams[i]);
+        ok_ole_success(hr, CoMarshalInterThreadInterfaceInStream);
+    }
+    params.main_tid = GetCurrentThreadId();
+    params.done = CreateEventA(NULL, TRUE, FALSE, NULL);
+    thread = CreateThread(NULL, 0, rejected_client_thread, &params, 0, NULL);
+    hr = CoWaitForMultipleHandles(0, 30000, 1, &params.done, &index);
+    ok(hr == S_OK, "got %#lx.\n", hr);
+    ok(!WaitForSingleObject(thread, 10000), "wait failed.\n");
+    CloseHandle(thread);
+    CloseHandle(params.done);
+    hr = CoRegisterMessageFilter(prev_filter, NULL);
+    ok_ole_success(hr, CoRegisterMessageFilter);
+    ok_no_locks();
+}
