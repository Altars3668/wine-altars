+/* What becomes of a call the called apartment's message filter rejected, or asked to be made again later: a
+ * single-threaded apartment with a filter of its own asks it whether to make it again, and when (-1 gives up;
+ * under 100, at once; otherwise after that many milliseconds, taking calls and messages meanwhile); one without a
+ * filter gives up, and so does the multithreaded apartment, which alone tells which answer the call got. */
+static BOOL retry_rejected_call(struct apartment *apt, DWORD callee, HRESULT *rejected, DWORD start, HANDLE event)
+{
+    DWORD type = *rejected == RPC_E_SERVERCALL_RETRYLATER ? SERVERCALL_RETRYLATER : SERVERCALL_REJECTED;
+    DWORD delay, index;
+
+    if (!apt->multi_threaded)
+    {
+        *rejected = RPC_E_CALL_REJECTED;
+        if (apt->filter)
+        {
+            delay = IMessageFilter_RetryRejectedCall(apt->filter, UlongToHandle(callee), GetTickCount() - start, type);
+            TRACE("IMessageFilter_RetryRejectedCall returned %ld\n", delay);
+            if (delay != ~0u)
+            {
+                if (delay >= 100) CoWaitForMultipleHandles(0, delay, 1, &event, &index);
+                return TRUE;
+            }
+        }
+    }
+    WARN("thread %#lx rejected the call (%lu), which fails with %#lx\n", callee, type, *rejected);
+    return FALSE;
+}
