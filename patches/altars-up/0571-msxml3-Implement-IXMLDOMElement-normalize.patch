+/* adjacent text nodes become one, in the elements below too; empty ones stay (Windows 11) */
+static void test_element_normalize(void)
+{
+    static const struct { DOMNodeType type; const WCHAR *value; } expect[] =
+    {
+        { NODE_TEXT, L"ab" }, { NODE_CDATA_SECTION, L"c" }, { NODE_TEXT, L"d" }, { NODE_ELEMENT },
+        { NODE_ELEMENT }, { NODE_TEXT, L" " },
+    };
+    static const char *texts[] = { "a", "b", "", "c", "d", "e", "f", "", "", " " };
+    IXMLDOMNode *node, *added, *child;
+    IXMLDOMElement *r, *x, *y, *parent;
+    IXMLDOMNodeList *list;
+    IXMLDOMDocument *doc;
+    DOMNodeType type;
+    unsigned int i;
+    LONG length;
+    HRESULT hr;
+    VARIANT v;
+
+    doc = create_document(&IID_IXMLDOMDocument);
+    IXMLDOMDocument_createElement(doc, _bstr_("r"), &r);
+    IXMLDOMDocument_createElement(doc, _bstr_("x"), &x);
+    IXMLDOMDocument_createElement(doc, _bstr_("y"), &y);
+    for (i = 0; i < ARRAY_SIZE(texts); i++)
+    {
+        parent = i < 5 || i == 9 ? r : i < 7 ? x : y;
+        if (i == 3)
+            IXMLDOMDocument_createCDATASection(doc, _bstr_(texts[i]), (IXMLDOMCDATASection **)&node);
+        else
+            IXMLDOMDocument_createTextNode(doc, _bstr_(texts[i]), (IXMLDOMText **)&node);
+        if (i == 9)
+        {
+            IXMLDOMElement_appendChild(r, (IXMLDOMNode *)x, &added);
+            IXMLDOMNode_Release(added);
+            IXMLDOMElement_appendChild(r, (IXMLDOMNode *)y, &added);
+            IXMLDOMNode_Release(added);
+        }
+        IXMLDOMElement_appendChild(parent, node, &added);
+        IXMLDOMNode_Release(added);
+        IXMLDOMNode_Release(node);
+    }
+
+    hr = IXMLDOMElement_normalize(r);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IXMLDOMElement_get_childNodes(r, &list);
+    IXMLDOMNodeList_get_length(list, &length);
+    ok(length == ARRAY_SIZE(expect), "Unexpected length %ld.\n", length);
+    for (i = 0; i < ARRAY_SIZE(expect) && i < length; i++)
+    {
+        IXMLDOMNodeList_get_item(list, i, &child);
+        IXMLDOMNode_get_nodeType(child, &type);
+        ok(type == expect[i].type, "%u: unexpected type %d.\n", i, type);
+        if (expect[i].value)
+        {
+            IXMLDOMNode_get_nodeValue(child, &v);
+            ok(!wcscmp(V_BSTR(&v), expect[i].value), "%u: unexpected value %s.\n", i, debugstr_w(V_BSTR(&v)));
+            VariantClear(&v);
+        }
+        IXMLDOMNode_Release(child);
+    }
+    IXMLDOMNodeList_Release(list);
+
+    IXMLDOMElement_get_childNodes(x, &list);
+    IXMLDOMNodeList_get_length(list, &length);
+    ok(length == 1, "Unexpected length %ld.\n", length);
+    IXMLDOMNodeList_Release(list);
+    IXMLDOMElement_get_childNodes(y, &list);
+    IXMLDOMNodeList_get_length(list, &length);
+    ok(length == 1, "Unexpected length %ld.\n", length);
+    IXMLDOMNodeList_Release(list);
+
+    IXMLDOMElement_Release(y);
+    IXMLDOMElement_Release(x);
+    IXMLDOMElement_Release(r);
+    IXMLDOMDocument_Release(doc);
+    free_bstrs();
+}
