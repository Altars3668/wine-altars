+/* Adjacent text nodes in an element and in the elements below it become one. */
+HRESULT node_normalize(struct domnode *node)
+{
+    struct domnode *child, *next, *after;
+    UINT len, add;
+    BSTR str;
+    HRESULT hr;
+
+    for (child = domnode_get_first_child(node); child; child = next)
+    {
+        next = domnode_get_next_sibling(child);
+        if (child->type == NODE_ELEMENT)
+        {
+            if (FAILED(hr = node_normalize(child))) return hr;
+            continue;
+        }
+        if (child->type != NODE_TEXT) continue;
+
+        while (next && next->type == NODE_TEXT)
+        {
+            len = SysStringLen(child->data);
+            add = SysStringLen(next->data);
+            if (!(str = SysAllocStringLen(NULL, len + add))) return E_OUTOFMEMORY;
+            memcpy(str, child->data, len * sizeof(WCHAR));
+            memcpy(str + len, next->data, add * sizeof(WCHAR));
+            str[len + add] = 0;
+            SysFreeString(child->data);
+            child->data = str;
+            child->flags |= next->flags & DOMNODE_IGNORED_WS;
+
+            after = domnode_get_next_sibling(next);
+            domnode_unlink_child(next);
+            next = after;
+        }
+    }
+
+    return S_OK;
+}
