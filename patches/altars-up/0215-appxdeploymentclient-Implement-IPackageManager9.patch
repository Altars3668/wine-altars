From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 13:16:51 -0400
Subject: [PATCH] appxdeploymentclient: Implement IPackageManager9.

Excel asks the package manager for IPackageManager9 each time it
starts: it looks for the package family aimgr_8wekyb3d8bbwe and, not
finding it, adds root\Integration\Addons\aimgr.msix from the Office
installation with AddPackageByUriAsync, the sparse package that gives
Office's AI component a package identity.  Without the interface it got
E_NOINTERFACE and a C++/WinRT exception.  The deployments fail as the
others of this client do, with an operation that ends in
ERROR_NOT_SUPPORTED, since Wine has no package store, and the trace
names the package and its external location.

AddPackageAsync now rejects DeploymentOptions_DevelopmentMode with
E_INVALIDARG, as the application model test has it on Windows.  That
test had not followed the package queries answering with empty lists;
it now expects them to succeed, and marks what needs a package store.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 4b20d5a7e98475cfcce7db3848569542614a406a)

diff --git a/dlls/appxdeploymentclient/package.c b/dlls/appxdeploymentclient/package.c
index 2d995ee5cb6..afa3bfdaff9 100644
--- a/dlls/appxdeploymentclient/package.c
+++ b/dlls/appxdeploymentclient/package.c
@@ -27,6 +27,7 @@ struct package_manager
     IPackageManager IPackageManager_iface;
     IPackageManager2 IPackageManager2_iface;
     IPackageManager6 IPackageManager6_iface;
+    IPackageManager9 IPackageManager9_iface;
     LONG ref;
 };
 
@@ -65,6 +66,13 @@ static HRESULT WINAPI package_manager_QueryInterface( IPackageManager *iface, RE
         return S_OK;
     }
 
+    if (IsEqualGUID( iid, &IID_IPackageManager9 ))
+    {
+        *out = &impl->IPackageManager9_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -115,6 +123,8 @@ static HRESULT WINAPI package_manager_AddPackageAsync( IPackageManager *iface, I
     IIterable_Uri *dependencies, DeploymentOptions options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
 {
     TRACE( "iface %p, uri %p, dependencies %p, options %d, operation %p.\n", iface, uri, dependencies, options, operation );
+    /* development mode is for registering a package's files in place, not for adding a package */
+    if (options & DeploymentOptions_DevelopmentMode) return E_INVALIDARG;
     return deployment_not_supported( operation );
 }
 
@@ -415,6 +425,96 @@ static const struct IPackageManager6Vtbl package_manager6_vtbl =
     package_manager6_RequestAddPackageAsync,
 };
 
+DEFINE_IINSPECTABLE( package_manager9, IPackageManager9, struct package_manager, IPackageManager_iface );
+
+static const char *debugstr_uri( IUriRuntimeClass *uri )
+{
+    const char *ret;
+    HSTRING str;
+
+    if (!uri || FAILED(IUriRuntimeClass_get_AbsoluteUri( uri, &str ))) return "(null)";
+    ret = debugstr_hstring( str );
+    WindowsDeleteString( str );
+    return ret;
+}
+
+static HRESULT WINAPI package_manager9_FindProvisionedPackages( IPackageManager9 *iface, IVector_Package **packages )
+{
+    FIXME( "iface %p, packages %p stub!\n", iface, packages );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI package_manager9_AddPackageByUriAsync( IPackageManager9 *iface, IUriRuntimeClass *uri,
+    IAddPackageOptions *options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    IUriRuntimeClass *location = NULL;
+    IInspectable *value = NULL;
+
+    if (options && SUCCEEDED(IAddPackageOptions_get_ExternalLocationUri( options, &value )) && value)
+    {
+        IInspectable_QueryInterface( value, &IID_IUriRuntimeClass, (void **)&location );
+        IInspectable_Release( value );
+    }
+    TRACE( "iface %p, uri %s, options %p, external location %s, operation %p.\n", iface, debugstr_uri( uri ), options,
+           debugstr_uri( location ), operation );
+    if (location) IUriRuntimeClass_Release( location );
+    return deployment_not_supported( operation );
+}
+
+static HRESULT WINAPI package_manager9_StagePackageByUriAsync( IPackageManager9 *iface, IUriRuntimeClass *uri,
+    IInspectable *options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, uri %s, options %p, operation %p.\n", iface, debugstr_uri( uri ), options, operation );
+    return deployment_not_supported( operation );
+}
+
+static HRESULT WINAPI package_manager9_RegisterPackageByUriAsync( IPackageManager9 *iface, IUriRuntimeClass *uri,
+    IInspectable *options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, uri %s, options %p, operation %p.\n", iface, debugstr_uri( uri ), options, operation );
+    return deployment_not_supported( operation );
+}
+
+static HRESULT WINAPI package_manager9_RegisterPackagesByFullNameAsync( IPackageManager9 *iface, IIterable_HSTRING *names,
+    IInspectable *options, IAsyncOperationWithProgress_DeploymentResult_DeploymentProgress **operation )
+{
+    TRACE( "iface %p, names %p, options %p, operation %p.\n", iface, names, options, operation );
+    return deployment_not_supported( operation );
+}
+
+static HRESULT WINAPI package_manager9_SetPackageStubPreference( IPackageManager9 *iface, HSTRING family_name,
+                                                                 PackageStubPreference value )
+{
+    FIXME( "iface %p, family_name %s, value %d stub!\n", iface, debugstr_hstring( family_name ), value );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI package_manager9_GetPackageStubPreference( IPackageManager9 *iface, HSTRING family_name,
+                                                                 PackageStubPreference *value )
+{
+    FIXME( "iface %p, family_name %s, value %p stub!\n", iface, debugstr_hstring( family_name ), value );
+    return E_NOTIMPL;
+}
+
+static const struct IPackageManager9Vtbl package_manager9_vtbl =
+{
+    package_manager9_QueryInterface,
+    package_manager9_AddRef,
+    package_manager9_Release,
+    /* IInspectable methods */
+    package_manager9_GetIids,
+    package_manager9_GetRuntimeClassName,
+    package_manager9_GetTrustLevel,
+    /* IPackageManager9 methods */
+    package_manager9_FindProvisionedPackages,
+    package_manager9_AddPackageByUriAsync,
+    package_manager9_StagePackageByUriAsync,
+    package_manager9_RegisterPackageByUriAsync,
+    package_manager9_RegisterPackagesByFullNameAsync,
+    package_manager9_SetPackageStubPreference,
+    package_manager9_GetPackageStubPreference,
+};
+
 struct package_manager_statics
 {
     IActivationFactory IActivationFactory_iface;
@@ -499,6 +599,7 @@ static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInsp
     impl->IPackageManager_iface.lpVtbl = &package_manager_vtbl;
     impl->IPackageManager2_iface.lpVtbl = &package_manager2_vtbl;
     impl->IPackageManager6_iface.lpVtbl = &package_manager6_vtbl;
+    impl->IPackageManager9_iface.lpVtbl = &package_manager9_vtbl;
     impl->ref = 1;
 
     *instance = (IInspectable *)&impl->IPackageManager_iface;
diff --git a/dlls/windows.applicationmodel/tests/model.c b/dlls/windows.applicationmodel/tests/model.c
