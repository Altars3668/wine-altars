+/* the reason names what the error is about, in the words of the version */
+static void test_parse_error_reasons(void)
+{
+    static const struct
+    {
+        const GUID *clsid;
+        const char *name;
+        const char *xml;
+        const WCHAR *names[2];
+    }
+    tests[] =
+    {
+        { &_create(CLSID_DOMDocument30), "<a></b>", { L"'b'", L"'a'" } },
+        { &_create(CLSID_DOMDocument60), "<a></b>", { L"'b'", L"'a'" } },
+        { &_create(CLSID_DOMDocument60), "<!DOCTYPE r [<!ELEMENT r (a)><!ELEMENT a EMPTY><!ELEMENT b EMPTY>]><r><b/></r>",
+          { L"'r'", L"'b'" } },
+        { &_create(CLSID_DOMDocument60), "<!DOCTYPE r [<!ELEMENT r EMPTY><!ATTLIST r x CDATA #REQUIRED>]><r/>",
+          { L"'x'" } },
+    };
+    IXMLDOMParseError *error;
+    IXMLDOMDocument2 *doc;
+    VARIANT_BOOL loaded;
+    unsigned int i, j;
+    BSTR reason;
+    HRESULT hr;
+    VARIANT v;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context("%u", i);
+        doc = _create_object(tests[i].clsid, tests[i].name, &IID_IXMLDOMDocument2, __LINE__);
+        V_VT(&v) = VT_BOOL;
+        V_BOOL(&v) = VARIANT_FALSE;
+        IXMLDOMDocument2_setProperty(doc, _bstr_("ProhibitDTD"), v);
+        hr = IXMLDOMDocument2_loadXML(doc, _bstr_(tests[i].xml), &loaded);
+        ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+        IXMLDOMDocument2_get_parseError(doc, &error);
+        reason = NULL;
+        hr = IXMLDOMParseError_get_reason(error, &reason);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        for (j = 0; j < ARRAY_SIZE(tests[i].names) && tests[i].names[j]; j++)
+            ok(reason && wcsstr(reason, tests[i].names[j]), "Unexpected reason %s.\n", debugstr_w(reason));
+        ok(reason && SysStringLen(reason) > 2 && !wcscmp(reason + SysStringLen(reason) - 2, L"\r\n"),
+                "Unexpected reason %s.\n", debugstr_w(reason));
+        SysFreeString(reason);
+        IXMLDOMParseError_Release(error);
+        IXMLDOMDocument2_Release(doc);
+        winetest_pop_context();
+    }
+    free_bstrs();
+}
