From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 13:51:59 -0400
Subject: [PATCH] msxml3: Give the reasons for errors loading a document in the
 words of each version, with what they are about, as Windows does.

MSXML 3 and MSXML 6 word many reasons differently, and name the elements,
attributes, entities and values an error is about; for content that breaks
a content model they add a line with what it expected there.  The reader
and the validation keep those names for the DOM, which takes its reasons
from new message table entries; the Chinese ones are those of Windows 11.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/domdoc.c b/dlls/msxml3/domdoc.c
index 9547efa22bf..a54c8d8889b 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -354,13 +354,87 @@ static void parse_error_set_source_bytes(struct parse_error *error, const BYTE *
     free(text);
 }
 
+/* MSXML gives the reason for an error that stops loading a document in the words of its version,
+ * with what the error is about; NULL when it has no words of its own for it (Windows 11) */
+#define DOM_REASON_MSXML3   0xc00d0000
+#define DOM_REASON_MSXML6   0xc00e0000
+#define DOM_REASON_EXPECTED 0xf001
+#define DOM_REASON_ENTITY   0xf002
+
+static DWORD dom_format_message(DWORD id, const WCHAR *const *args, WCHAR *buffer, DWORD size)
+{
+    static const WCHAR *const none[3] = { L"", L"", L"" };
+
+    return FormatMessageW(FORMAT_MESSAGE_FROM_HMODULE | FORMAT_MESSAGE_ARGUMENT_ARRAY, MSXML_hInstance, id, 0,
+            buffer, size, (va_list *)(args ? args : none));
+}
+
+static BSTR dom_append_message(BSTR reason, DWORD id, const WCHAR *const *args)
+{
+    WCHAR buffer[1024];
+    UINT len = SysStringLen(reason);
+    DWORD add;
+    BSTR ret;
+
+    if (!(add = dom_format_message(id, args, buffer, ARRAY_SIZE(buffer)))) return reason;
+    if (!(ret = SysAllocStringLen(NULL, len + add))) return reason;
+    if (len) memcpy(ret, reason, len * sizeof(WCHAR));
+    memcpy(ret + len, buffer, add * sizeof(WCHAR));
+    SysFreeString(reason);
+    return ret;
+}
+
+static DWORD dom_reason_facility(MSXML_VERSION version)
+{
+    return version >= MSXML6 ? DOM_REASON_MSXML6 : DOM_REASON_MSXML3;
+}
+
+BSTR dom_error_reason(HRESULT code, MSXML_VERSION version, const WCHAR *const *args)
+{
+    if (HRESULT_FACILITY(code) != FACILITY_INTERNET || HRESULT_SEVERITY(code) != SEVERITY_ERROR) return NULL;
+    return dom_append_message(NULL, dom_reason_facility(version) | (code & 0xffff), args);
+}
+
+/* the line that says what the content model of an element expected where it was broken */
+BSTR dom_error_reason_expected(BSTR reason, MSXML_VERSION version, const WCHAR *expected)
+{
+    const WCHAR *args[3] = { expected, L"", L"" };
+
+    if (!reason || !expected || !*expected) return reason;
+    return dom_append_message(reason, dom_reason_facility(version) | DOM_REASON_EXPECTED, args);
+}
+
+/* an external entity that could not be loaded: which, from where, and why */
+BSTR dom_entity_load_reason(MSXML_VERSION version, const WCHAR *name, const WCHAR *sysid, HRESULT hr)
+{
+    const WCHAR *args[3] = { name ? name : L"", sysid ? sysid : L"", L"" };
+    WCHAR buffer[1024];
+    BSTR reason;
+
+    reason = dom_append_message(NULL, dom_reason_facility(version) | DOM_REASON_ENTITY, args);
+    if (FormatMessageW(FORMAT_MESSAGE_FROM_HMODULE | FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_IGNORE_INSERTS,
+            MSXML_hInstance, hr, 0, buffer, ARRAY_SIZE(buffer), NULL))
+    {
+        BSTR ret = SysAllocStringLen(NULL, SysStringLen(reason) + lstrlenW(buffer));
+        if (ret)
+        {
+            memcpy(ret, reason, SysStringLen(reason) * sizeof(WCHAR));
+            memcpy(ret + SysStringLen(reason), buffer, lstrlenW(buffer) * sizeof(WCHAR));
+            SysFreeString(reason);
+            reason = ret;
+        }
+    }
+    return reason;
+}
+
 /* nothing to parse: the parser's error for it, at no position, as on Windows */
 static void domdoc_set_missing_root_error(domdoc *doc)
 {
     struct parse_error error = { E_SAX_MISSINGROOT };
     WCHAR msg[1024];
 
-    if (FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_FROM_HMODULE, MSXML_hInstance,
+    if (!(error.reason = dom_error_reason(E_SAX_MISSINGROOT, doc->node->properties->version, NULL)) &&
+            FormatMessageW(FORMAT_MESSAGE_FROM_SYSTEM | FORMAT_MESSAGE_FROM_HMODULE, MSXML_hInstance,
             E_SAX_MISSINGROOT, 0, msg, ARRAY_SIZE(msg), NULL))
         error.reason = SysAllocString(msg);
     domdoc_set_parse_error(doc, &error);
