From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 07:29:35 -0400
Subject: [PATCH] combase: Fail a proxy's QueryInterface with the error of the
 call that could not be made.

When the remote QueryInterface call itself fails, the proxy manager
answered E_NOINTERFACE.  Windows passes the call's error on: asking a
proxy for another interface from inside an input-synchronous call, such
as ResizeBorder, fails with RPC_E_CANTCALLOUT_ININPUTSYNCCALL.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/combase/marshal.c b/dlls/combase/marshal.c
index 2f0fbbaa714..5ff9058737b 100644
--- a/dlls/combase/marshal.c
+++ b/dlls/combase/marshal.c
@@ -977,7 +977,8 @@ static HRESULT WINAPI ClientIdentity_QueryInterface(IMultiQI * iface, REFIID rii
     hr = IMultiQI_QueryMultipleInterfaces(iface, 1, &mqi);
     *ppv = mqi.pItf;
 
-    return hr;
+    /* a call that could not be made fails as that, not as a missing interface */
+    return FAILED(mqi.hr) ? mqi.hr : hr;
 }
 
 static ULONG WINAPI ClientIdentity_AddRef(IMultiQI *iface)
@@ -1050,7 +1051,11 @@ static HRESULT WINAPI ClientIdentity_QueryMultipleInterfaces(IMultiQI *iface, UL
                                                nonlocal_mqis, iids, &qiresults);
             IRemUnknown_Release(remunk);
             if (FAILED(hr))
+            {
                 WARN("IRemUnknown_RemQueryInterface failed with error %#lx\n", hr);
+                for (i = 0; i < nonlocal_mqis; i++)
+                    pMQIs[mapping[i]].hr = hr;
+            }
         }
 
         /* IRemUnknown_RemQueryInterface can return S_FALSE if only some of
diff --git a/dlls/ole32/tests/marshal.c b/dlls/ole32/tests/marshal.c
index ac33d9505e9..f85632294d9 100644
--- a/dlls/ole32/tests/marshal.c
+++ b/dlls/ole32/tests/marshal.c
@@ -4154,7 +4154,7 @@ static void test_call_as_methods(void)
     ok(EqualRect(&resize_border.rect, &rect), "got %s.\n", wine_dbgstr_rect(&resize_border.rect));
     ok(resize_border.frame && resize_border.window, "got frame %d, window %d.\n", resize_border.frame, resize_border.window);
     ok(resize_border.frame_qi == S_OK, "IOleInPlaceFrame: %#lx.\n", resize_border.frame_qi);
-    todo_wine ok(resize_border.uiwindow_qi == RPC_E_CANTCALLOUT_ININPUTSYNCCALL, "IOleInPlaceUIWindow: %#lx.\n",
+    ok(resize_border.uiwindow_qi == RPC_E_CANTCALLOUT_ININPUTSYNCCALL, "IOleInPlaceUIWindow: %#lx.\n",
        resize_border.uiwindow_qi);
     memset(&resize_border, 0, sizeof(resize_border));
     hr = IOleInPlaceActiveObject_ResizeBorder(active, &rect, (IOleInPlaceUIWindow *)&uiwindow.IOleInPlaceFrame_iface, FALSE);
@@ -4162,7 +4162,7 @@ static void test_call_as_methods(void)
     ok(resize_border.calls == 1, "object called %ld times.\n", resize_border.calls);
     ok(!resize_border.frame && resize_border.window, "got frame %d, window %d.\n", resize_border.frame,
        resize_border.window);
-    todo_wine ok(resize_border.frame_qi == RPC_E_CANTCALLOUT_ININPUTSYNCCALL, "IOleInPlaceFrame: %#lx.\n",
+    ok(resize_border.frame_qi == RPC_E_CANTCALLOUT_ININPUTSYNCCALL, "IOleInPlaceFrame: %#lx.\n",
        resize_border.frame_qi);
     ok(resize_border.uiwindow_qi == S_OK, "IOleInPlaceUIWindow: %#lx.\n", resize_border.uiwindow_qi);
     /* a window that is no frame cannot go as one */
