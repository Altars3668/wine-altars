+
+TRANSFORM_PROPERTY( IDCompositionSkewTransform, AngleX, 0 )
+TRANSFORM_PROPERTY( IDCompositionSkewTransform, AngleY, 1 )
+TRANSFORM_PROPERTY( IDCompositionSkewTransform, CenterX, 2 )
+TRANSFORM_PROPERTY( IDCompositionSkewTransform, CenterY, 3 )
+
+static const IDCompositionSkewTransformVtbl skew_vtbl =
+{
+    TRANSFORM_IUNKNOWN( IDCompositionSkewTransform ),
+    dc_IDCompositionSkewTransform_SetAngleXAnimation,
+    dc_IDCompositionSkewTransform_SetAngleX,
+    dc_IDCompositionSkewTransform_SetAngleYAnimation,
+    dc_IDCompositionSkewTransform_SetAngleY,
+    dc_IDCompositionSkewTransform_SetCenterXAnimation,
