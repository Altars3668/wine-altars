+static const IDCompositionRectangleClipVtbl clip_vtbl =
+{
+    clip_QueryInterface,
+    clip_AddRef,
+    clip_Release,
+    /* IDCompositionRectangleClip methods */
+    clip_SetLeftAnimation,
+    clip_SetLeft,
+    clip_SetTopAnimation,
