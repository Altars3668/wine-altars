+/* a visual can be a child of one visual, or the root of one target, but not both */
+static BOOL visual_is_attached( struct dc_visual *visual )
+{
+    return visual->parent || visual->root_of;
+}
+
+static HRESULT WINAPI visual_AddVisual( IDCompositionVisual2 *iface, IDCompositionVisual *visual, BOOL insert_above,
+                                        IDCompositionVisual *reference_visual )
+{
+    struct dc_visual *impl = impl_from_IDCompositionVisual2( iface );
+    struct dc_visual *child = unsafe_impl_from_IDCompositionVisual( visual ), *reference = NULL, *ancestor;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, visual %p, insert_above %d, reference_visual %p.\n", iface, visual, insert_above, reference_visual );
+
+    if (!child) return E_INVALIDARG;
+    if (reference_visual && !(reference = unsafe_impl_from_IDCompositionVisual( reference_visual ))) return E_INVALIDARG;
+
+    dc_lock();
+    for (ancestor = impl; ancestor; ancestor = ancestor->parent) if (ancestor == child) break;
+    if (ancestor || visual_is_attached( child ) || (reference && reference->parent != impl)) hr = E_INVALIDARG;
+    else
+    {
+        IDCompositionVisual_AddRef( visual );
+        child->parent = impl;
+        /* children are kept bottom first; with no reference, "above" no sibling is below them all */
+        if (reference && insert_above) list_add_after( &reference->entry, &child->entry );
+        else if (reference) list_add_before( &reference->entry, &child->entry );
+        else if (insert_above) list_add_head( &impl->children, &child->entry );
+        else list_add_tail( &impl->children, &child->entry );
+    }
+    dc_unlock();
+    return hr;
+}
+
+static HRESULT WINAPI visual_RemoveVisual( IDCompositionVisual2 *iface, IDCompositionVisual *visual )
+{
+    struct dc_visual *impl = impl_from_IDCompositionVisual2( iface );
+    struct dc_visual *child = unsafe_impl_from_IDCompositionVisual( visual );
+
+    TRACE( "iface %p, visual %p.\n", iface, visual );
+
+    if (!child) return E_INVALIDARG;
+    dc_lock();
+    if (child->parent != impl)
+    {
+        dc_unlock();
+        return E_INVALIDARG;
+    }
+    list_remove( &child->entry );
+    child->parent = NULL;
+    dc_unlock();
+    IDCompositionVisual_Release( visual );
+    return S_OK;
+}
+
+static HRESULT WINAPI visual_RemoveAllVisuals( IDCompositionVisual2 *iface )
+{
+    struct dc_visual *impl = impl_from_IDCompositionVisual2( iface ), *child;
+    struct list children = LIST_INIT( children );
+
+    TRACE( "iface %p.\n", iface );
+
+    dc_lock();
+    list_move_tail( &children, &impl->children );
+    LIST_FOR_EACH_ENTRY( child, &children, struct dc_visual, entry ) child->parent = NULL;
+    dc_unlock();
+
+    while (!list_empty( &children ))
+    {
+        child = LIST_ENTRY( list_head( &children ), struct dc_visual, entry );
+        list_remove( &child->entry );
+        IDCompositionVisual2_Release( &child->IDCompositionVisual2_iface );
+    }
+    return S_OK;
+}
