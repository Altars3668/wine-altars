+static const void *const transform_vtbls[] =
+{
+    [TRANSFORM_TRANSLATE]    = &translate_vtbl,
+    [TRANSFORM_SCALE]        = &scale_vtbl,
+    [TRANSFORM_ROTATE]       = &rotate_vtbl,
+    [TRANSFORM_SKEW]         = &skew_vtbl,
+    [TRANSFORM_MATRIX]       = &matrix_vtbl,
+    [TRANSFORM_GROUP]        = &group_vtbl,
+    [TRANSFORM_TRANSLATE_3D] = &translate_3d_vtbl,
+    [TRANSFORM_SCALE_3D]     = &scale_3d_vtbl,
+    [TRANSFORM_ROTATE_3D]    = &rotate_3d_vtbl,
+    [TRANSFORM_MATRIX_3D]    = &matrix_3d_vtbl,
+    [TRANSFORM_GROUP_3D]     = &group_3d_vtbl,
+    [EFFECT_GROUP]           = &effect_group_vtbl,
+};
+
+static struct dc_transform *unsafe_transform( IUnknown *iface )
+{
+    unsigned int i;
+
+    if (!iface) return NULL;
+    for (i = 0; i < ARRAY_SIZE(transform_vtbls); i++)
+        if (iface->lpVtbl == transform_vtbls[i]) return transform_from_iface( iface );
+    return NULL;
+}
+
+/* a transform of ours: a 2D one, or with_3d any */
+static BOOL is_transform( IUnknown *iface, BOOL with_3d )
+{
+    struct dc_transform *transform = unsafe_transform( iface );
+
+    if (!transform || transform->kind == EFFECT_GROUP) return FALSE;
+    return with_3d || transform->kind <= TRANSFORM_GROUP;
+}
+
+static HRESULT transform_create( enum dc_transform_kind kind, void **out )
+{
+    struct dc_transform *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IUnknown_iface.lpVtbl = transform_vtbls[kind];
+    impl->ref = 1;
+    impl->kind = kind;
+    switch (kind)
+    {
+    case TRANSFORM_SCALE:
+        impl->values[0] = impl->values[1] = 1;
+        break;
+    case TRANSFORM_MATRIX:
+        impl->values[0] = impl->values[3] = 1;
+        break;
+    case TRANSFORM_SCALE_3D:
+        impl->values[0] = impl->values[1] = impl->values[2] = 1;
+        break;
+    case TRANSFORM_ROTATE_3D:
+        impl->values[3] = 1;
+        break;
+    case TRANSFORM_MATRIX_3D:
+        impl->values[0] = impl->values[5] = impl->values[10] = impl->values[15] = 1;
+        break;
+    case EFFECT_GROUP:
+        impl->values[0] = 1;
+        if (!(impl->children = calloc( 1, sizeof(*impl->children) )))
+        {
+            free( impl );
+            return E_OUTOFMEMORY;
+        }
+        impl->count = 1;
+        break;
+    default:
+        break;
+    }
+    *out = &impl->IUnknown_iface;
+    return S_OK;
+}
+
+#define DEFINE_TRANSFORM_CREATE( name, type, kind ) \
+    HRESULT dc_create_##name( type **out ) \
+    { \
+        return transform_create( kind, (void **)out ); \
+    }
+
+DEFINE_TRANSFORM_CREATE( translate_transform, IDCompositionTranslateTransform, TRANSFORM_TRANSLATE )
+DEFINE_TRANSFORM_CREATE( scale_transform, IDCompositionScaleTransform, TRANSFORM_SCALE )
+DEFINE_TRANSFORM_CREATE( rotate_transform, IDCompositionRotateTransform, TRANSFORM_ROTATE )
+DEFINE_TRANSFORM_CREATE( skew_transform, IDCompositionSkewTransform, TRANSFORM_SKEW )
+DEFINE_TRANSFORM_CREATE( matrix_transform, IDCompositionMatrixTransform, TRANSFORM_MATRIX )
+DEFINE_TRANSFORM_CREATE( translate_transform_3d, IDCompositionTranslateTransform3D, TRANSFORM_TRANSLATE_3D )
+DEFINE_TRANSFORM_CREATE( scale_transform_3d, IDCompositionScaleTransform3D, TRANSFORM_SCALE_3D )
+DEFINE_TRANSFORM_CREATE( rotate_transform_3d, IDCompositionRotateTransform3D, TRANSFORM_ROTATE_3D )
+DEFINE_TRANSFORM_CREATE( matrix_transform_3d, IDCompositionMatrixTransform3D, TRANSFORM_MATRIX_3D )
+DEFINE_TRANSFORM_CREATE( effect_group, IDCompositionEffectGroup, EFFECT_GROUP )
+
+/* a group of transforms; with_3d, of 3D transforms */
+HRESULT dc_create_transform_group( IUnknown **transforms, UINT count, BOOL with_3d, void **out )
+{
+    struct dc_transform *impl;
+    HRESULT hr;
+    UINT i;
+
+    if (!transforms || !count) return E_INVALIDARG;
+    for (i = 0; i < count; i++) if (!is_transform( transforms[i], with_3d )) return E_INVALIDARG;
+    if (FAILED(hr = transform_create( with_3d ? TRANSFORM_GROUP_3D : TRANSFORM_GROUP, out ))) return hr;
+    impl = transform_from_iface( *out );
+    if (!(impl->children = calloc( count, sizeof(*impl->children) )))
+    {
+        IUnknown_Release( &impl->IUnknown_iface );
+        *out = NULL;
+        return E_OUTOFMEMORY;
+    }
+    for (i = 0; i < count; i++)
+    {
+        impl->children[i] = transforms[i];
+        IUnknown_AddRef( transforms[i] );
+    }
+    impl->count = count;
+    return S_OK;
+}
