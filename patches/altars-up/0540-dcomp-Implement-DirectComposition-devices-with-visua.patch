+static HRESULT device_create( IUnknown *rendering_device, REFIID iid, void **out )
+{
+    struct dc_device *device;
+    HRESULT hr;
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+
+    if (!(device = calloc( 1, sizeof(*device) ))) return E_OUTOFMEMORY;
+    device->IDCompositionDevice_iface.lpVtbl = &device_vtbl;
+    device->IDCompositionDevicePartner_iface.lpVtbl = &partner_vtbl;
+    device->ref = 1;
+    if ((device->rendering_device = rendering_device)) IUnknown_AddRef( rendering_device );
+    list_init( &device->targets );
+    list_init( &device->shared_visuals );
+
+    hr = IDCompositionDevice_QueryInterface( &device->IDCompositionDevice_iface, iid, out );
+    IDCompositionDevice_Release( &device->IDCompositionDevice_iface );
+    return hr;
+}
