+static HRESULT WINAPI partner_OpenSharedResourceHandle( IDCompositionDevicePartner *iface, IUnknown *resource, HANDLE *handle )
+{
+    struct dc_visual *visual;
+
+    TRACE( "iface %p, resource %p, handle %p.\n", iface, resource, handle );
+
+    if (!handle) return E_INVALIDARG;
+    *handle = NULL;
+    if (!(visual = unsafe_impl_from_IDCompositionVisual( (IDCompositionVisual *)resource )) || !visual->shared)
+        return E_INVALIDARG;
+    if (!DuplicateHandle( GetCurrentProcess(), visual->shared->section, GetCurrentProcess(), handle,
+                          0, FALSE, DUPLICATE_SAME_ACCESS ))
+        return HRESULT_FROM_WIN32( GetLastError() );
+    return S_OK;
+}
+
+static HRESULT WINAPI partner_OpenSharedResource( IDCompositionDevicePartner *iface, HANDLE handle, REFIID iid, void **out )
+{
+    struct dc_device *device = impl_from_IDCompositionDevicePartner( iface );
+    struct dc_shared *shared;
+    HRESULT hr;
+
+    TRACE( "iface %p, handle %p, iid %s, out %p.\n", iface, handle, debugstr_guid( iid ), out );
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IDCompositionTarget ))
+    {
+        FIXME( "shared resource as %s not implemented.\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+
+    if (FAILED(hr = shared_open( handle, FALSE, &shared ))) return hr;
+    if (FAILED(hr = dc_target_create( device, NULL, FALSE, shared, (IDCompositionTarget **)out )))
+        shared_close( shared );
+    return hr;
