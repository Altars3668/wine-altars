+
+static HRESULT WINAPI matrix_SetMatrix( IDCompositionMatrixTransform *iface, const D2D_MATRIX_3X2_F *matrix )
+{
+    struct dc_transform *impl = transform_from_iface( iface );
+
+    TRACE( "iface %p, matrix %p.\n", iface, matrix );
+
+    if (!matrix) return E_INVALIDARG;
+    dc_lock();
+    memcpy( impl->values, matrix, sizeof(*matrix) );
+    dc_unlock();
+    return S_OK;
+}
+
+static HRESULT WINAPI matrix_SetMatrixElementAnimation( IDCompositionMatrixTransform *iface, int row, int column,
+                                                        IDCompositionAnimation *animation )
+{
+    TRACE( "iface %p, row %d, column %d, animation %p.\n", iface, row, column, animation );
+    if (row < 0 || row > 2 || column < 0 || column > 1) return E_INVALIDARG;
+    return set_animation( iface, animation );
+}
+
+static HRESULT WINAPI matrix_SetMatrixElement( IDCompositionMatrixTransform *iface, int row, int column, float value )
+{
+    TRACE( "iface %p, row %d, column %d, value %f.\n", iface, row, column, value );
+    if (row < 0 || row > 2 || column < 0 || column > 1) return E_INVALIDARG;
+    return transform_set( iface, row * 2 + column, value );
+}
+
+static const IDCompositionMatrixTransformVtbl matrix_vtbl =
+{
+    TRANSFORM_IUNKNOWN( IDCompositionMatrixTransform ),
+    matrix_SetMatrix,
+    matrix_SetMatrixElementAnimation,
+    matrix_SetMatrixElement,
+};
+
+static const IDCompositionTransformVtbl group_vtbl =
+{
+    TRANSFORM_IUNKNOWN( IDCompositionTransform ),
+};
