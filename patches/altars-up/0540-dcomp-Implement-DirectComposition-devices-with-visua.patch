+static HRESULT WINAPI partner_CreateSharedResource( IDCompositionDevicePartner *iface, REFIID iid, void **out )
+{
+    struct dc_device *device = impl_from_IDCompositionDevicePartner( iface );
+    struct dc_visual *visual;
+    HRESULT hr;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_INVALIDARG;
+    *out = NULL;
+    if (!IsEqualGUID( iid, &IID_IDCompositionVisual ) && !IsEqualGUID( iid, &IID_IDCompositionVisual2 ))
+    {
+        FIXME( "shared %s not implemented.\n", debugstr_guid( iid ) );
+        return E_NOINTERFACE;
+    }
+
+    if (FAILED(hr = dc_visual_create( device, &visual ))) return hr;
+    if (FAILED(hr = shared_open( NULL, TRUE, &visual->shared )))
+    {
+        IDCompositionVisual2_Release( &visual->IDCompositionVisual2_iface );
+        return hr;
+    }
+    dc_lock();
+    list_add_tail( &device->shared_visuals, &visual->shared_entry );
+    dc_unlock();
+
+    *out = &visual->IDCompositionVisual2_iface;
+    return S_OK;
+}
