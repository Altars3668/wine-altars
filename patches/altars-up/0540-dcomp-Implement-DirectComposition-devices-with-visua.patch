+/*
+ * The objects of the DirectComposition API keep what they are given.  Visuals from any device
+ * can make up one tree, so all trees change under one lock.  What is drawn of them is up to
+ * the targets (device.c).
+ */
+
+static CRITICAL_SECTION dc_cs;
+static CRITICAL_SECTION_DEBUG dc_cs_debug =
+{
+    0, 0, &dc_cs,
+    { &dc_cs_debug.ProcessLocksList, &dc_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": dc_cs") }
+};
+static CRITICAL_SECTION dc_cs = { &dc_cs_debug, -1, 0, 0, 0, 0 };
+
+void dc_lock(void)
+{
+    EnterCriticalSection( &dc_cs );
+}
+
+void dc_unlock(void)
+{
+    LeaveCriticalSection( &dc_cs );
+}
+
+/* animations are not implemented, so none can be given */
+static HRESULT set_animation( void *iface, IDCompositionAnimation *animation )
+{
+    if (!animation) return E_INVALIDARG;
+    FIXME( "iface %p, animation %p: animations are not implemented.\n", iface, animation );
+    return E_NOTIMPL;
+}
+
+/*** window surfaces ***/
+
+/* what CreateSurfaceFromHwnd makes; identified by this private interface */
+static const GUID IID_dc_window_surface = {0x5d3a1e2b,0x8c41,0x4f0e,{0x9a,0x63,0x2d,0x41,0x7e,0x0b,0xc5,0x11}};
+
+struct dc_window_surface
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    HWND hwnd;
+};
+
+static inline struct dc_window_surface *window_surface_from_IUnknown( IUnknown *iface )
+{
+    return CONTAINING_RECORD( iface, struct dc_window_surface, IUnknown_iface );
+}
+
+static HRESULT WINAPI window_surface_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_dc_window_surface ))
+    {
+        IUnknown_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI window_surface_AddRef( IUnknown *iface )
+{
+    struct dc_window_surface *impl = window_surface_from_IUnknown( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI window_surface_Release( IUnknown *iface )
+{
+    struct dc_window_surface *impl = window_surface_from_IUnknown( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+static const IUnknownVtbl window_surface_vtbl =
+{
+    window_surface_QueryInterface,
+    window_surface_AddRef,
+    window_surface_Release,
+};
+
+HRESULT dc_window_surface_create( HWND hwnd, IUnknown **out )
+{
+    struct dc_window_surface *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IUnknown_iface.lpVtbl = &window_surface_vtbl;
+    impl->ref = 1;
+    impl->hwnd = hwnd;
+    *out = &impl->IUnknown_iface;
+    return S_OK;
+}
+
+HWND dc_window_surface_hwnd( IUnknown *content )
+{
+    if (!content || content->lpVtbl != &window_surface_vtbl) return 0;
+    return window_surface_from_IUnknown( content )->hwnd;
+}
