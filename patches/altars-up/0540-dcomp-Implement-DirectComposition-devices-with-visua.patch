+    clip_SetTopLeftRadiusYAnimation,
+    clip_SetTopLeftRadiusY,
+    clip_SetTopRightRadiusXAnimation,
+    clip_SetTopRightRadiusX,
+    clip_SetTopRightRadiusYAnimation,
