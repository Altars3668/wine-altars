+static void visual_destroy( struct dc_visual *visual )
+{
+    struct dc_visual *child, *next;
+
+    if (visual->shared) dc_shared_visual_destroy( visual );
+    LIST_FOR_EACH_ENTRY_SAFE( child, next, &visual->children, struct dc_visual, entry )
+    {
+        dc_lock();
+        list_remove( &child->entry );
+        child->parent = NULL;
+        dc_unlock();
+        IDCompositionVisual2_Release( &child->IDCompositionVisual2_iface );
+    }
+    if (visual->content) IUnknown_Release( visual->content );
+    if (visual->transform_object) IDCompositionTransform_Release( visual->transform_object );
+    if (visual->transform_parent) IDCompositionVisual_Release( visual->transform_parent );
+    if (visual->effect) IDCompositionEffect_Release( visual->effect );
+    if (visual->clip_object) IDCompositionClip_Release( visual->clip_object );
+    if (visual->device) dc_device_release( visual->device );
+    free( visual );
+}
