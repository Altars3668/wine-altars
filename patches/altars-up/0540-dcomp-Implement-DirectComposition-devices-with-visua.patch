+static void test_dcomp_device(void)
+{
+    HRESULT (WINAPI *pDCompositionCreateDevice2)( IUnknown *, REFIID, void ** );
+    IDCompositionVisual *visual, *child, *child2, *shared_visual;
+    IDCompositionTarget *target, *target2, *shared_target;
+    IDCompositionTranslateTransform3D *translate_3d;
+    DCOMPOSITION_FRAME_STATISTICS statistics;
+    IDCompositionMatrixTransform *matrix;
+    IDCompositionScaleTransform *scale;
+    IDCompositionRectangleClip *clip;
+    IDCompositionEffectGroup *effect;
+    IDCompositionTransform *group;
+    IDCompositionDevice *device;
+    LARGE_INTEGER before, after;
+    D2D_MATRIX_3X2_F m = {{{1, 0, 0, 1, 10, 20}}};
+    D2D_RECT_F rect = {0, 0, 100, 50};
+    IUnknown *surface, *partner;
+    HANDLE handle;
+    HMODULE dcomp;
+    BOOL valid;
+    HWND hwnd;
+    HRESULT hr;
+
+    dcomp = LoadLibraryA( "dcomp.dll" );
+    pDCompositionCreateDevice2 = (void *)GetProcAddress( dcomp, "DCompositionCreateDevice2" );
+    if (!pDCompositionCreateDevice2)
+    {
+        win_skip( "DCompositionCreateDevice2 not available.\n" );
+        return;
+    }
+
+    hr = pDCompositionCreateDevice2( NULL, &IID_IDCompositionDevice, NULL );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = pDCompositionCreateDevice2( NULL, &IID_IDCompositionDevice, (void **)&device );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr)) return;
+
+    valid = FALSE;
+    hr = IDCompositionDevice_CheckDeviceState( device, &valid );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( valid, "got valid %d.\n", valid );
+
+    QueryPerformanceCounter( &before );
+    hr = IDCompositionDevice_GetFrameStatistics( device, &statistics );
+    QueryPerformanceCounter( &after );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    QueryPerformanceFrequency( &before );
+    ok( statistics.timeFrequency.QuadPart == before.QuadPart, "got frequency %s.\n",
+        wine_dbgstr_longlong( statistics.timeFrequency.QuadPart ) );
+    ok( statistics.currentTime.QuadPart <= after.QuadPart, "got time %s.\n",
+        wine_dbgstr_longlong( statistics.currentTime.QuadPart ) );
+    ok( statistics.currentCompositionRate.Denominator, "got no rate.\n" );
+
+    hwnd = CreateWindowA( "static", "dcomp", WS_POPUP, 0, 0, 200, 100, NULL, NULL, NULL, NULL );
+    ok( !!hwnd, "CreateWindow failed, error %lu.\n", GetLastError() );
+
+    /* a window has one target above its children and one below them */
+    hr = IDCompositionDevice_CreateTargetForHwnd( device, hwnd, TRUE, &target );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionDevice_CreateTargetForHwnd( device, hwnd, TRUE, &target2 );
+    ok( hr == DCOMPOSITION_ERROR_WINDOW_ALREADY_COMPOSED, "got hr %#lx.\n", hr );
+    hr = IDCompositionDevice_CreateTargetForHwnd( device, hwnd, FALSE, &target2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IDCompositionTarget_Release( target2 );
+    hr = IDCompositionDevice_CreateTargetForHwnd( device, hwnd, FALSE, &target2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IDCompositionTarget_Release( target2 );
+    hr = IDCompositionDevice_CreateTargetForHwnd( device, NULL, FALSE, &target2 );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+
+    hr = IDCompositionDevice_CreateVisual( device, &visual );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionDevice_CreateVisual( device, &child );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionDevice_CreateVisual( device, &child2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_interface( visual, &IID_IDCompositionVisual2, TRUE );
+
+    hr = IDCompositionTarget_SetRoot( target, visual );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionTarget_SetRoot( target, visual );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    /* a visual is a child of one visual, or the root of a target */
+    hr = IDCompositionVisual_AddVisual( visual, NULL, FALSE, NULL );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_AddVisual( visual, child, FALSE, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_AddVisual( visual, child, FALSE, NULL );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_AddVisual( child2, child, FALSE, NULL );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_AddVisual( child, visual, FALSE, NULL );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IDCompositionTarget_SetRoot( target, child );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_RemoveVisual( visual, child2 );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_AddVisual( visual, child2, TRUE, child );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_RemoveVisual( visual, child );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_RemoveVisual( visual, child );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_RemoveAllVisuals( visual );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_AddVisual( child, child2, FALSE, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_AddVisual( visual, child, FALSE, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    hr = IDCompositionVisual_SetOffsetX( child, 10 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetOffsetY( child, 20 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetOffsetXAnimation( child, NULL );
+    ok( FAILED(hr), "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetTransform( child, &m );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetClip( child, &rect );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetBorderMode( child, DCOMPOSITION_BORDER_MODE_HARD );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetBitmapInterpolationMode( child, DCOMPOSITION_BITMAP_INTERPOLATION_MODE_LINEAR );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetCompositeMode( child, DCOMPOSITION_COMPOSITE_MODE_SOURCE_OVER );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    hr = IDCompositionDevice_CreateRectangleClip( device, &clip );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_interface( clip, &IID_IDCompositionClip, TRUE );
+    hr = IDCompositionRectangleClip_SetLeft( clip, 1 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionRectangleClip_SetBottomRightRadiusY( clip, 4 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetClipObject( child, (IDCompositionClip *)clip );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetClipObject( child, NULL );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IDCompositionRectangleClip_Release( clip );
+
+    hr = IDCompositionDevice_CreateScaleTransform( device, &scale );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_interface( scale, &IID_IDCompositionTransform, TRUE );
+    check_interface( scale, &IID_IDCompositionTransform3D, TRUE );
+    check_interface( scale, &IID_IDCompositionEffect, TRUE );
+    hr = IDCompositionScaleTransform_SetScaleX( scale, 2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetTransformObject( child, (IDCompositionTransform *)scale );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionDevice_CreateMatrixTransform( device, &matrix );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionMatrixTransform_SetMatrix( matrix, &m );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionMatrixTransform_SetMatrixElement( matrix, 2, 1, 5 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionDevice_CreateTransformGroup( device, (IDCompositionTransform **)&scale, 1, &group );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetTransformObject( child, group );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IDCompositionTransform_Release( group );
+    IDCompositionMatrixTransform_Release( matrix );
+    IDCompositionScaleTransform_Release( scale );
+
+    hr = IDCompositionDevice_CreateTranslateTransform3D( device, &translate_3d );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionTranslateTransform3D_SetOffsetZ( translate_3d, 3 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionDevice_CreateEffectGroup( device, &effect );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionEffectGroup_SetOpacity( effect, 0.5 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionEffectGroup_SetTransform3D( effect, (IDCompositionTransform3D *)translate_3d );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetEffect( child, (IDCompositionEffect *)effect );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IDCompositionEffectGroup_Release( effect );
+    IDCompositionTranslateTransform3D_Release( translate_3d );
+
+    hr = IDCompositionDevice_CreateSurfaceFromHwnd( device, hwnd, &surface );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionVisual_SetContent( child2, surface );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IUnknown_Release( surface );
+
+    hr = IDCompositionDevice_Commit( device );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDCompositionDevice_WaitForCommitCompletion( device );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IDCompositionVisual_Release( child ); /* its parent keeps it */
+
+    /* a visual shared with another process, which opens it as a target */
+    hr = IDCompositionDevice_QueryInterface( device, &IID_IDCompositionDevicePartner, (void **)&partner );
+    ok( hr == S_OK || broken( hr == E_NOINTERFACE ), "got hr %#lx.\n", hr );
+    if (SUCCEEDED(hr))
+    {
+        const struct partner_vtbl *vtbl = (const struct partner_vtbl *)partner->lpVtbl;
+
+        hr = vtbl->CreateSharedResource( partner, &IID_IDCompositionVisual, (void **)&shared_visual );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        hr = IDCompositionVisual_AddVisual( visual, shared_visual, FALSE, NULL );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        handle = NULL;
+        hr = vtbl->OpenSharedResourceHandle( partner, (IUnknown *)shared_visual, &handle );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        ok( !!handle, "got no handle.\n" );
+        hr = vtbl->OpenSharedResource( partner, handle, &IID_IDCompositionTarget, (void **)&shared_target );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        if (SUCCEEDED(hr))
+        {
+            hr = IDCompositionDevice_CreateVisual( device, &child );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = IDCompositionTarget_SetRoot( shared_target, child );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            hr = IDCompositionDevice_Commit( device );
+            ok( hr == S_OK, "got hr %#lx.\n", hr );
+            IDCompositionVisual_Release( child );
+            IDCompositionTarget_Release( shared_target );
+        }
+        CloseHandle( handle );
+        hr = IDCompositionVisual_RemoveVisual( visual, shared_visual );
+        ok( hr == S_OK, "got hr %#lx.\n", hr );
+        IDCompositionVisual_Release( shared_visual );
+        IUnknown_Release( partner );
+    }
+
+    IDCompositionVisual_Release( child2 );
+    IDCompositionVisual_Release( visual );
+    IDCompositionTarget_Release( target );
+    IDCompositionDevice_Release( device );
+    DestroyWindow( hwnd );
+}
