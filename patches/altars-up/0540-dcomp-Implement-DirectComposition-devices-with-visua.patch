+HRESULT dc_rectangle_clip_create( IDCompositionRectangleClip **out )
+{
+    struct dc_clip *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IDCompositionRectangleClip_iface.lpVtbl = &clip_vtbl;
+    impl->ref = 1;
+    /* a clip that clips nothing */
+    impl->left = impl->top = -FLT_MAX;
+    impl->right = impl->bottom = FLT_MAX;
+    *out = &impl->IDCompositionRectangleClip_iface;
+    return S_OK;
+}
+
+static BOOL is_rectangle_clip( IDCompositionClip *clip )
+{
+    return clip->lpVtbl == (const void *)&clip_vtbl;
+}
+
+/*** transforms and effects ***/
+
+enum dc_transform_kind
+{
+    TRANSFORM_TRANSLATE,
+    TRANSFORM_SCALE,
+    TRANSFORM_ROTATE,
+    TRANSFORM_SKEW,
+    TRANSFORM_MATRIX,
+    TRANSFORM_GROUP,
+    TRANSFORM_TRANSLATE_3D,
+    TRANSFORM_SCALE_3D,
+    TRANSFORM_ROTATE_3D,
+    TRANSFORM_MATRIX_3D,
+    TRANSFORM_GROUP_3D,
+    EFFECT_GROUP,
+};
+
+/* every transform and effect, through the vtbl of its kind's interface */
+struct dc_transform
+{
+    IUnknown IUnknown_iface;
+    LONG ref;
+    enum dc_transform_kind kind;
+    float values[16];           /* its properties, in the order of their setters */
+    IUnknown **children;        /* a group's transforms, an effect group's 3D transform */
+    UINT count;
+};
+
+static inline struct dc_transform *transform_from_iface( void *iface )
+{
+    return CONTAINING_RECORD( (IUnknown *)iface, struct dc_transform, IUnknown_iface );
+}
+
+static const IID *const transform_iids[][4] =
+{
+    [TRANSFORM_TRANSLATE]    = {&IID_IDCompositionTranslateTransform, &IID_IDCompositionTransform, &IID_IDCompositionTransform3D},
+    [TRANSFORM_SCALE]        = {&IID_IDCompositionScaleTransform, &IID_IDCompositionTransform, &IID_IDCompositionTransform3D},
+    [TRANSFORM_ROTATE]       = {&IID_IDCompositionRotateTransform, &IID_IDCompositionTransform, &IID_IDCompositionTransform3D},
+    [TRANSFORM_SKEW]         = {&IID_IDCompositionSkewTransform, &IID_IDCompositionTransform, &IID_IDCompositionTransform3D},
+    [TRANSFORM_MATRIX]       = {&IID_IDCompositionMatrixTransform, &IID_IDCompositionTransform, &IID_IDCompositionTransform3D},
+    [TRANSFORM_GROUP]        = {&IID_IDCompositionTransform, &IID_IDCompositionTransform3D},
+    [TRANSFORM_TRANSLATE_3D] = {&IID_IDCompositionTranslateTransform3D, &IID_IDCompositionTransform3D},
+    [TRANSFORM_SCALE_3D]     = {&IID_IDCompositionScaleTransform3D, &IID_IDCompositionTransform3D},
+    [TRANSFORM_ROTATE_3D]    = {&IID_IDCompositionRotateTransform3D, &IID_IDCompositionTransform3D},
+    [TRANSFORM_MATRIX_3D]    = {&IID_IDCompositionMatrixTransform3D, &IID_IDCompositionTransform3D},
+    [TRANSFORM_GROUP_3D]     = {&IID_IDCompositionTransform3D},
+    [EFFECT_GROUP]           = {&IID_IDCompositionEffectGroup},
+};
+
+static HRESULT WINAPI transform_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    struct dc_transform *impl = transform_from_iface( iface );
+    unsigned int i;
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    for (i = 0; i < ARRAY_SIZE(transform_iids[0]) && transform_iids[impl->kind][i]; i++)
+        if (IsEqualGUID( iid, transform_iids[impl->kind][i] )) break;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IDCompositionEffect ) ||
+        (i < ARRAY_SIZE(transform_iids[0]) && transform_iids[impl->kind][i]))
+    {
+        IUnknown_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI transform_AddRef( IUnknown *iface )
+{
+    struct dc_transform *impl = transform_from_iface( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI transform_Release( IUnknown *iface )
+{
+    struct dc_transform *impl = transform_from_iface( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    UINT i;
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        for (i = 0; i < impl->count; i++) if (impl->children[i]) IUnknown_Release( impl->children[i] );
+        free( impl->children );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT transform_set( void *iface, unsigned int index, float value )
+{
+    struct dc_transform *impl = transform_from_iface( iface );
+
+    TRACE( "iface %p, property %u, value %f.\n", iface, index, value );
+
+    dc_lock();
+    impl->values[index] = value;
+    dc_unlock();
+    return S_OK;
+}
+
+static HRESULT transform_set_animation( void *iface, IDCompositionAnimation *animation )
+{
+    TRACE( "iface %p, animation %p.\n", iface, animation );
+    return set_animation( iface, animation );
+}
+
+/* the setters of one property of an interface */
+#define TRANSFORM_PROPERTY( type, name, index ) \
+    static HRESULT WINAPI dc_##type##_Set##name##Animation( type *iface, IDCompositionAnimation *animation ) \
+    { \
+        return transform_set_animation( iface, animation ); \
+    } \
+    static HRESULT WINAPI dc_##type##_Set##name( type *iface, float value ) \
+    { \
+        return transform_set( iface, index, value ); \
+    }
+
+#define TRANSFORM_IUNKNOWN( type ) \
+    (void *)transform_QueryInterface, (void *)transform_AddRef, (void *)transform_Release
+
