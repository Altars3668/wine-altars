+    LARGE_INTEGER now, frequency;
+    LONGLONG period;
+
+    TRACE( "iface %p, statistics %p.\n", iface, statistics );
+
+    if (!statistics) return E_INVALIDARG;
+    QueryPerformanceCounter( &now );
+    QueryPerformanceFrequency( &frequency );
+    if (!EnumDisplaySettingsW( NULL, ENUM_CURRENT_SETTINGS, &mode ) || mode.dmDisplayFrequency <= 1)
+        mode.dmDisplayFrequency = 60;
+    period = frequency.QuadPart / mode.dmDisplayFrequency;
+
+    /* the frames of the display, the last one a whole number of periods ago */
+    statistics->timeFrequency = frequency;
+    statistics->currentTime = now;
+    statistics->currentCompositionRate.Numerator = mode.dmDisplayFrequency;
+    statistics->currentCompositionRate.Denominator = 1;
+    statistics->lastFrameTime.QuadPart = now.QuadPart - now.QuadPart % period;
+    statistics->nextEstimatedFrameTime.QuadPart = statistics->lastFrameTime.QuadPart + period;
+    return S_OK;
