+/*
+ * Wine composes no window into another: a window shown in a shared visual cannot be drawn in
+ * it.  What puts it there keeps it where the visual is on the screen, transparent, for input
+ * to fall through to the window under it, the one the visual is composed in; so it is shown
+ * instead, letting input through still, and kept above that window by having its top-level
+ * window own it.  Either process does this when it commits, since either can be the last.
+ */
+static void shared_show( HWND content, HWND host )
+{
+    DWORD pid, ex_style, new_ex_style;
+    HWND owner;
+
+    if (!content || !IsWindow( content )) return;
+    ex_style = GetWindowLongW( content, GWL_EXSTYLE );
+
+    if (!host || !IsWindow( host ))
+    {
+        /* composed nowhere, nothing of it is seen */
+        new_ex_style = (ex_style | WS_EX_LAYERED) & ~WS_EX_TRANSPARENT;
+        if (new_ex_style == ex_style) return;
+        TRACE( "hiding %p.\n", content );
+        SetWindowLongW( content, GWL_EXSTYLE, new_ex_style );
+        GetWindowThreadProcessId( content, &pid );
+        if (pid == GetCurrentProcessId()) SetLayeredWindowAttributes( content, 0, 0, LWA_ALPHA );
+        return;
+    }
+
+    owner = GetAncestor( host, GA_ROOT );
+    if (GetWindow( content, GW_OWNER ) != owner)
+    {
+        TRACE( "%p is shown over %p, owned by %p.\n", content, host, owner );
+        SetWindowLongPtrW( content, GWLP_HWNDPARENT, (LONG_PTR)owner );
+    }
+    new_ex_style = (ex_style & ~WS_EX_LAYERED) | WS_EX_TRANSPARENT;
+    if (new_ex_style != ex_style)
+    {
+        SetWindowLongW( content, GWL_EXSTYLE, new_ex_style );
+        SetWindowPos( content, HWND_TOP, 0, 0, 0, 0, SWP_NOMOVE | SWP_NOSIZE | SWP_NOACTIVATE );
