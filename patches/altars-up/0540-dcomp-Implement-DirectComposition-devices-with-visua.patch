+/*** rectangle clips ***/
+
+struct dc_clip
+{
+    IDCompositionRectangleClip IDCompositionRectangleClip_iface;
+    LONG ref;
+    float left, top, right, bottom;
+    float radii[8];             /* x and y of top left, top right, bottom left, bottom right */
+};
+
+static inline struct dc_clip *impl_from_IDCompositionRectangleClip( IDCompositionRectangleClip *iface )
+{
+    return CONTAINING_RECORD( iface, struct dc_clip, IDCompositionRectangleClip_iface );
+}
+
+static HRESULT WINAPI clip_QueryInterface( IDCompositionRectangleClip *iface, REFIID iid, void **out )
+{
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IDCompositionClip ) ||
+        IsEqualGUID( iid, &IID_IDCompositionRectangleClip ))
+    {
+        IDCompositionRectangleClip_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI clip_AddRef( IDCompositionRectangleClip *iface )
+{
+    struct dc_clip *impl = impl_from_IDCompositionRectangleClip( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI clip_Release( IDCompositionRectangleClip *iface )
+{
+    struct dc_clip *impl = impl_from_IDCompositionRectangleClip( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    if (!ref) free( impl );
+    return ref;
+}
+
+#define CLIP_PROPERTY( name, field ) \
+    static HRESULT WINAPI clip_Set##name##Animation( IDCompositionRectangleClip *iface, IDCompositionAnimation *animation ) \
+    { \
+        TRACE( "iface %p, animation %p.\n", iface, animation ); \
+        return set_animation( iface, animation ); \
+    } \
+    static HRESULT WINAPI clip_Set##name( IDCompositionRectangleClip *iface, float value ) \
+    { \
+        struct dc_clip *impl = impl_from_IDCompositionRectangleClip( iface ); \
+        TRACE( "iface %p, value %f.\n", iface, value ); \
+        dc_lock(); \
+        impl->field = value; \
+        dc_unlock(); \
+        return S_OK; \
+    }
+
+CLIP_PROPERTY( Left, left )
+CLIP_PROPERTY( Top, top )
+CLIP_PROPERTY( Right, right )
+CLIP_PROPERTY( Bottom, bottom )
+CLIP_PROPERTY( TopLeftRadiusX, radii[0] )
+CLIP_PROPERTY( TopLeftRadiusY, radii[1] )
+CLIP_PROPERTY( TopRightRadiusX, radii[2] )
+CLIP_PROPERTY( TopRightRadiusY, radii[3] )
+CLIP_PROPERTY( BottomLeftRadiusX, radii[4] )
+CLIP_PROPERTY( BottomLeftRadiusY, radii[5] )
+CLIP_PROPERTY( BottomRightRadiusX, radii[6] )
+CLIP_PROPERTY( BottomRightRadiusY, radii[7] )
