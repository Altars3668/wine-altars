+
+TRANSFORM_PROPERTY( IDCompositionRotateTransform, Angle, 0 )
+TRANSFORM_PROPERTY( IDCompositionRotateTransform, CenterX, 1 )
+TRANSFORM_PROPERTY( IDCompositionRotateTransform, CenterY, 2 )
+
+static const IDCompositionRotateTransformVtbl rotate_vtbl =
+{
+    TRANSFORM_IUNKNOWN( IDCompositionRotateTransform ),
+    dc_IDCompositionRotateTransform_SetAngleAnimation,
+    dc_IDCompositionRotateTransform_SetAngle,
+    dc_IDCompositionRotateTransform_SetCenterXAnimation,
+    dc_IDCompositionRotateTransform_SetCenterX,
+    dc_IDCompositionRotateTransform_SetCenterYAnimation,
