+#define COBJMACROS
+#include <stdarg.h>
+
+#include "windef.h"
+#include "initguid.h"
+#include "winbase.h"
+#include "winstring.h"
+#include "roapi.h"
+
+#define WIDL_using_Windows_Foundation
+#define WIDL_using_Windows_Foundation_Collections
+#include "windows.foundation.h"
+#define WIDL_using_Windows_System_Profile
+#include "windows.system.profile.h"
+
+#include "wine/test.h"
+
+static IActivationFactory *get_factory( const WCHAR *name )
+{
+    IActivationFactory *factory = NULL;
+    HSTRING str;
+    HRESULT hr;
+
+    WindowsCreateString( name, wcslen( name ), &str );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "%s: got hr %#lx.\n", debugstr_w( name ), hr );
+    return factory;
+}
+
+/* What a factory of a class with only statics answers for itself, as Windows' do. */
+static void check_statics_factory( IActivationFactory *factory, const IID *const *iids, ULONG iid_count )
+{
+    IInspectable *instance = (void *)0xdeadbeef;
+    HSTRING name = (void *)0xdeadbeef;
+    TrustLevel level = -1;
+    IID *list = NULL;
+    ULONG count = 0;
+    HRESULT hr;
+    ULONG i;
+
+    hr = IActivationFactory_GetRuntimeClassName( factory, &name );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    ok( !name, "got %p.\n", name );
+    hr = IActivationFactory_GetTrustLevel( factory, &level );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( level == BaseTrust, "got %d.\n", level );
+    hr = IActivationFactory_ActivateInstance( factory, &instance );
+    ok( hr == E_NOTIMPL, "got hr %#lx.\n", hr );
+    ok( !instance, "got %p.\n", instance );
+
+    /* Windows lists an internal interface of RetailInfo's after these */
+    hr = IActivationFactory_GetIids( factory, &count, &list );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( count >= iid_count, "got %lu.\n", count );
+    for (i = 0; i < iid_count && i < count; i++)
+        ok( IsEqualGUID( &list[i], iids[i] ), "%lu: got %s.\n", i, debugstr_guid( &list[i] ) );
+    CoTaskMemFree( list );
+}
+
+static void test_RetailInfo(void)
+{
+    static const IID *const iids[] = {&IID_IActivationFactory, &IID_IRetailInfoStatics};
+    IMapView_HSTRING_IInspectable *properties;
+    IActivationFactory *factory;
+    IRetailInfoStatics *statics;
+    IUnknown *unk;
+    boolean value;
+    UINT32 size;
+    HRESULT hr;
+
+    if (!(factory = get_factory( L"Windows.System.Profile.RetailInfo" ))) return;
+    check_statics_factory( factory, iids, ARRAY_SIZE(iids) );
+
+    /* agile, and marshaled free-threaded */
+    hr = IActivationFactory_QueryInterface( factory, &IID_IAgileObject, (void **)&unk );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (hr == S_OK) IUnknown_Release( unk );
+    hr = IActivationFactory_QueryInterface( factory, &IID_IMarshal, (void **)&unk );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (hr == S_OK) IUnknown_Release( unk );
+
+    /* not a demo unit, so no properties */
+    hr = IActivationFactory_QueryInterface( factory, &IID_IRetailInfoStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    value = 2;
+    hr = IRetailInfoStatics_get_IsDemoModeEnabled( statics, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !value, "got %d.\n", value );
+    hr = IRetailInfoStatics_get_Properties( statics, &properties );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    size = 0xdeadbeef;
+    IMapView_HSTRING_IInspectable_get_Size( properties, &size );
+    ok( !size, "got %u.\n", size );
+    IMapView_HSTRING_IInspectable_Release( properties );
+    IRetailInfoStatics_Release( statics );
+    IActivationFactory_Release( factory );
+}
+
+static void test_SharedModeSettings(void)
+{
+    static const IID *const iids[] = {&IID_IActivationFactory, &IID_ISharedModeSettingsStatics,
+                                      &IID_ISharedModeSettingsStatics2};
+    ISharedModeSettingsStatics2 *statics2;
+    ISharedModeSettingsStatics *statics;
+    IActivationFactory *factory;
+    HSTRING name;
+    IUnknown *unk;
+    boolean value;
+    HRESULT hr;
+
+    if (!(factory = get_factory( L"Windows.System.Profile.SharedModeSettings" ))) return;
+    check_statics_factory( factory, iids, ARRAY_SIZE(iids) );
+
+    /* unlike RetailInfo's, this factory is neither agile nor marshaled */
+    hr = IActivationFactory_QueryInterface( factory, &IID_IAgileObject, (void **)&unk );
+    ok( hr == E_NOINTERFACE, "got hr %#lx.\n", hr );
+    hr = IActivationFactory_QueryInterface( factory, &IID_IMarshal, (void **)&unk );
+    ok( hr == E_NOINTERFACE, "got hr %#lx.\n", hr );
+
+    /* not a shared PC */
+    hr = IActivationFactory_QueryInterface( factory, &IID_ISharedModeSettingsStatics, (void **)&statics );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    value = 2;
+    hr = ISharedModeSettingsStatics_get_IsEnabled( statics, &value );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !value, "got %d.\n", value );
+    hr = ISharedModeSettingsStatics_GetRuntimeClassName( statics, &name );
+    ok( hr == E_ILLEGAL_METHOD_CALL, "got hr %#lx.\n", hr );
+    ISharedModeSettingsStatics_Release( statics );
+
+    hr = IActivationFactory_QueryInterface( factory, &IID_ISharedModeSettingsStatics2, (void **)&statics2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    value = 2;
+    hr = ISharedModeSettingsStatics2_get_ShouldAvoidLocalStorage( statics2, &value );
