index 00000000000..9575bdf32c0
--- /dev/null
+++ b/dlls/windows.system.profile/sharedmode.c
@@ -0,0 +1,197 @@
+/* WinRT Windows.System.Profile.SharedModeSettings implementation
+ *
+ * Copyright 2026 AltarsCN
+ *
