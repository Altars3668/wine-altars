+/* the list IInspectable::GetIids hands out, allocated as the caller frees it */
+HRESULT iids_create( const IID *const *list, ULONG count, ULONG *iid_count, IID **iids )
+{
+    ULONG i;
+
+    if (!iid_count || !iids) return E_POINTER;
+    if (!(*iids = CoTaskMemAlloc( count * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < count; i++) (*iids)[i] = *list[i];
+    *iid_count = count;
+    return S_OK;
+}
