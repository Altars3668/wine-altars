+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(profile);
+
+/*
+ * Shared mode is a Windows edition's kiosk-like setting for devices many
+ * people use in turn (shared PCs in schools and libraries), under which
+ * applications are asked to keep nothing on the machine.  This is no such
+ * device, so it is off and local storage is fine, which is what Windows
+ * answers on every machine not set up that way.  The factory is as Windows'
+ * is: statics only, not agile, and no class name of its own.
+ */
+
+struct shared_mode_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    ISharedModeSettingsStatics ISharedModeSettingsStatics_iface;
+    ISharedModeSettingsStatics2 ISharedModeSettingsStatics2_iface;
+    LONG ref;
+};
+
+static inline struct shared_mode_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct shared_mode_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct shared_mode_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ISharedModeSettingsStatics ))
+    {
+        *out = &impl->ISharedModeSettingsStatics_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_ISharedModeSettingsStatics2 ))
+    {
+        *out = &impl->ISharedModeSettingsStatics2_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    TRACE( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    struct shared_mode_statics *impl = impl_from_IActivationFactory( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    struct shared_mode_statics *impl = impl_from_IActivationFactory( iface );
+    return InterlockedDecrement( &impl->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    static const IID *const factory_iids[] =
+    {
+        &IID_IActivationFactory,
+        &IID_ISharedModeSettingsStatics,
+        &IID_ISharedModeSettingsStatics2,
+    };
+
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+    return iids_create( factory_iids, ARRAY_SIZE(factory_iids), iid_count, iids );
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    if (class_name) *class_name = NULL;
+    return E_ILLEGAL_METHOD_CALL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* SharedModeSettings is reached through its statics; it has no constructor. */
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, ISharedModeSettingsStatics, struct shared_mode_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_get_IsEnabled( ISharedModeSettingsStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct ISharedModeSettingsStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable methods */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* ISharedModeSettingsStatics methods */
+    statics_get_IsEnabled,
+};
+
+DEFINE_IINSPECTABLE( statics2, ISharedModeSettingsStatics2, struct shared_mode_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI statics2_get_ShouldAvoidLocalStorage( ISharedModeSettingsStatics2 *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static const struct ISharedModeSettingsStatics2Vtbl statics2_vtbl =
+{
+    statics2_QueryInterface,
+    statics2_AddRef,
+    statics2_Release,
+    /* IInspectable methods */
+    statics2_GetIids,
+    statics2_GetRuntimeClassName,
+    statics2_GetTrustLevel,
+    /* ISharedModeSettingsStatics2 methods */
+    statics2_get_ShouldAvoidLocalStorage,
+};
+
+static struct shared_mode_statics shared_mode_statics =
+{
+    {&factory_vtbl},
+    {&statics_vtbl},
+    {&statics2_vtbl},
+    1,
+};
+
+IActivationFactory *shared_mode_settings_factory = &shared_mode_statics.IActivationFactory_iface;
