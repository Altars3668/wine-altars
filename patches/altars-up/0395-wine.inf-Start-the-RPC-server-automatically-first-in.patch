From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 08:25:51 -0400
Subject: [PATCH] wine.inf: Start the RPC server automatically, first, in "COM
 Infrastructure".

As on Windows, where RpcSs is an auto-start service of the "COM Infrastructure" group, which
ServiceGroupOrder lists before the groups of the network and the spooler.  Started on demand, it
was refused while services.exe was still starting the auto-start services: Excel, started with
the session, could not start the RPC server then, nor load a VSTO add-in.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/loader/wine.inf.in b/loader/wine.inf.in
index f39ef620fc1..e23091223da 100644
--- a/loader/wine.inf.in
+++ b/loader/wine.inf.in
@@ -610,7 +610,7 @@ HKLM,System\CurrentControlSet\Control\Lsa\MSV1_0,,16
 HKLM,System\CurrentControlSet\Control\Nls\Language,"Default",,"0409"
 HKLM,System\CurrentControlSet\Control\Nls\Language,"InstallLanguage",,"0409"
 HKLM,System\CurrentControlSet\Control\SecurityProviders\Schannel\Protocols\SSL 2.0\Client,"DisabledByDefault",0x10003,1
-HKLM,System\CurrentControlSet\Control\ServiceGroupOrder,"List",0x00010000,"TDI"
+HKLM,System\CurrentControlSet\Control\ServiceGroupOrder,"List",0x00010000,"System Bus Extender","COM Infrastructure","TDI","SpoolerGroup"
 HKLM,System\CurrentControlSet\Control\TimeZoneInformation,"StandardName",2,""
 HKLM,System\CurrentControlSet\Control\TimeZoneInformation,"TimeZoneKeyName",2,""
 HKLM,System\CurrentControlSet\Control\VirtualDeviceDrivers,,16
@@ -980,8 +980,9 @@ Description="RPC service"
 DisplayName="Remote Procedure Call (RPC)"
 ServiceBinary="%11%\rpcss.exe"
 ServiceType=32
-StartType=3
+StartType=2
 ErrorControl=1
+LoadOrderGroup="COM Infrastructure"
 
 [SamSsService]
 Description="Security Accounts Manager service"
