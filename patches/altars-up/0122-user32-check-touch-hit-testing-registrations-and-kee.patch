From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 11:56:33 -0400
Subject: [PATCH] user32: check touch hit testing registrations and keep window
 message filters.

RegisterTouchHitTestingWindow and ChangeWindowMessageFilterEx, which
Word calls for its windows, were stubs.

There is no touch input to test hits of, so a window of one's own takes
any value, as on Windows; NULL is ERROR_INVALID_WINDOW_HANDLE and a
window of another process ERROR_ACCESS_DENIED.

There is no UIPI here either, so every message gets through, as it does
on Windows between processes of the same integrity.  What
ChangeWindowMessageFilterEx checks and says back is as there: the
window, the action, that a reset names no message, the size of the
structure, and in ExtStatus whether the message was already let in or
already kept out, which a window now keeps as properties of its own and
a reset forgets.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit aafc0a633037521630e449f82db9a377dd809b4b)

diff --git a/dlls/user32/message.c b/dlls/user32/message.c
index 42f4a80778c..01a66767f8f 100644
--- a/dlls/user32/message.c
+++ b/dlls/user32/message.c
@@ -1212,8 +1212,62 @@ BOOL WINAPI ChangeWindowMessageFilter( UINT message, DWORD flag )
 /******************************************************************
  *      ChangeWindowMessageFilterEx (USER32.@)
  */
+static BOOL CALLBACK reset_message_filter( HWND hwnd, WCHAR *name, HANDLE data, ULONG_PTR param )
+{
+    if (!IS_INTRESOURCE( name ) && !wcsncmp( name, L"__wine_msgflt_", 14 )) RemovePropW( hwnd, name );
+    return TRUE;
+}
+
 BOOL WINAPI ChangeWindowMessageFilterEx( HWND hwnd, UINT message, DWORD action, CHANGEFILTERSTRUCT *changefilter )
 {
-    FIXME( "%p %x %ld %p\n", hwnd, message, action, changefilter );
+    DWORD pid, ext;
+
+    TRACE( "%p %x %ld %p\n", hwnd, message, action, changefilter );
+
+    /* There is no UIPI here, so no filter to change: every message gets through, as it does on Windows
+     * between processes of the same integrity.  What is checked, and said back, is as there. */
+    if (!GetWindowThreadProcessId( hwnd, &pid ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    if (pid != GetCurrentProcessId())
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
+    if ((action != MSGFLT_ALLOW && action != MSGFLT_DISALLOW && action != MSGFLT_RESET) ||
+        (action == MSGFLT_RESET && message) ||
+        (changefilter && changefilter->cbSize < sizeof(*changefilter)))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    /* the messages the window was told to let in, each a property of its own */
+    if (action == MSGFLT_RESET)
+    {
+        EnumPropsExW( hwnd, reset_message_filter, 0 );
+        ext = MSGFLTINFO_NONE;
+    }
+    else
+    {
+        WCHAR name[32];
+        BOOL allowed;
+
+        swprintf( name, ARRAY_SIZE(name), L"__wine_msgflt_%04x", message );
+        allowed = !!GetPropW( hwnd, name );
+        if (action == MSGFLT_ALLOW)
+        {
+            ext = allowed ? MSGFLTINFO_ALREADYALLOWED_FORWND : MSGFLTINFO_NONE;
+            SetPropW( hwnd, name, (HANDLE)1 );
+        }
+        else
+        {
+            ext = allowed ? MSGFLTINFO_NONE : MSGFLTINFO_ALREADYDISALLOWED_FORWND;
+            RemovePropW( hwnd, name );
+        }
+    }
+    if (changefilter) changefilter->ExtStatus = ext;
     return TRUE;
 }
diff --git a/dlls/user32/misc.c b/dlls/user32/misc.c
index 39f12257925..ab6d1f4d175 100644
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -491,7 +491,21 @@ BOOL WINAPI GetPointerDevices(UINT32 *device_count, POINTER_DEVICE_INFO *devices
  */
 BOOL WINAPI RegisterTouchHitTestingWindow(HWND hwnd, ULONG value)
 {
-    FIXME("(%p %ld): stub\n", hwnd, value);
+    DWORD pid;
+
+    TRACE("(%p %ld)\n", hwnd, value);
+
+    /* a window of one's own takes any value; there is no touch input to test hits of here */
+    if (!GetWindowThreadProcessId( hwnd, &pid ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+    if (pid != GetCurrentProcessId())
+    {
+        SetLastError( ERROR_ACCESS_DENIED );
+        return FALSE;
+    }
     return TRUE;
 }
 
diff --git a/dlls/user32/tests/win.c b/dlls/user32/tests/win.c
index 96727af0161..53a4beece1c 100644
--- a/dlls/user32/tests/win.c
+++ b/dlls/user32/tests/win.c
@@ -14666,6 +14666,109 @@ static LRESULT WINAPI print_window_proc(HWND hwnd, UINT msg, WPARAM wparam, LPAR
     return DefWindowProcA(hwnd, msg, wparam, lparam);
 }
 
+static void test_RegisterTouchHitTestingWindow(void)
+{
+    BOOL (WINAPI *pRegisterTouchHitTestingWindow)(HWND, ULONG);
+    HWND hwnd;
+    ULONG value;
+    BOOL ret;
+
+    pRegisterTouchHitTestingWindow = (void *)GetProcAddress( GetModuleHandleA( "user32.dll" ),
+                                                             "RegisterTouchHitTestingWindow" );
+    if (!pRegisterTouchHitTestingWindow)
+    {
+        win_skip( "RegisterTouchHitTestingWindow is not available\n" );
+        return;
+    }
+
+    hwnd = CreateWindowA( "static", NULL, WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL, NULL, NULL );
+    for (value = TOUCH_HIT_TESTING_DEFAULT; value <= 3; value++)
+    {
+        SetLastError( 0xdeadbeef );
+        ret = pRegisterTouchHitTestingWindow( hwnd, value );
+        ok( ret, "value %lu: got error %lu\n", value, GetLastError() );
+    }
+    SetLastError( 0xdeadbeef );
+    ret = pRegisterTouchHitTestingWindow( NULL, TOUCH_HIT_TESTING_CLIENT );
+    ok( !ret, "RegisterTouchHitTestingWindow succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_WINDOW_HANDLE, "got error %lu\n", GetLastError() );
+    /* a window of another process */
+    SetLastError( 0xdeadbeef );
+    ret = pRegisterTouchHitTestingWindow( GetDesktopWindow(), TOUCH_HIT_TESTING_CLIENT );
+    ok( !ret, "RegisterTouchHitTestingWindow succeeded\n" );
+    ok( GetLastError() == ERROR_ACCESS_DENIED, "got error %lu\n", GetLastError() );
+    DestroyWindow( hwnd );
+}
+
+static void test_ChangeWindowMessageFilterEx(void)
+{
+    BOOL (WINAPI *pChangeWindowMessageFilterEx)(HWND, UINT, DWORD, CHANGEFILTERSTRUCT *);
+    CHANGEFILTERSTRUCT filter;
+    DWORD action;
+    HWND hwnd;
+    BOOL ret;
+
+    pChangeWindowMessageFilterEx = (void *)GetProcAddress( GetModuleHandleA( "user32.dll" ),
+                                                           "ChangeWindowMessageFilterEx" );
+    if (!pChangeWindowMessageFilterEx)
+    {
+        win_skip( "ChangeWindowMessageFilterEx is not available\n" );
+        return;
+    }
+
+    hwnd = CreateWindowA( "static", NULL, WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL, NULL, NULL );
+    for (action = MSGFLT_RESET; action <= 4; action++)
+    {
+        filter.cbSize = sizeof(filter);
+        filter.ExtStatus = 0xdead;
+        SetLastError( 0xdeadbeef );
+        ret = pChangeWindowMessageFilterEx( hwnd, 0xc078, action, &filter );
+        if (action == MSGFLT_ALLOW || action == MSGFLT_DISALLOW)
+        {
+            ok( ret, "action %lu: got error %lu\n", action, GetLastError() );
+            ok( filter.ExtStatus == MSGFLTINFO_NONE, "action %lu: got %lu\n", action, filter.ExtStatus );
+        }
+        else
+        {
+            /* a reset takes no message */
+            ok( !ret, "action %lu: ChangeWindowMessageFilterEx succeeded\n", action );
+            ok( GetLastError() == ERROR_INVALID_PARAMETER, "action %lu: got error %lu\n", action, GetLastError() );
+            ok( filter.ExtStatus == 0xdead, "action %lu: got %lu\n", action, filter.ExtStatus );
+        }
+    }
+
+    ret = pChangeWindowMessageFilterEx( hwnd, WM_COPYDATA, MSGFLT_ALLOW, NULL );
+    ok( ret, "got error %lu\n", GetLastError() );
+    filter.cbSize = sizeof(DWORD);
+    SetLastError( 0xdeadbeef );
+    ret = pChangeWindowMessageFilterEx( hwnd, WM_COPYDATA, MSGFLT_ALLOW, &filter );
+    ok( !ret, "ChangeWindowMessageFilterEx succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+    filter.cbSize = sizeof(filter);
+    SetLastError( 0xdeadbeef );
+    ret = pChangeWindowMessageFilterEx( NULL, WM_COPYDATA, MSGFLT_ALLOW, &filter );
+    ok( !ret, "ChangeWindowMessageFilterEx succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_WINDOW_HANDLE, "got error %lu\n", GetLastError() );
+
+    /* a reset forgets what was let in */
+    filter.ExtStatus = 0xdead;
+    ret = pChangeWindowMessageFilterEx( hwnd, 0, MSGFLT_RESET, &filter );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ok( filter.ExtStatus == MSGFLTINFO_NONE, "got %lu\n", filter.ExtStatus );
+    ret = pChangeWindowMessageFilterEx( hwnd, WM_COPYDATA, MSGFLT_DISALLOW, &filter );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ok( filter.ExtStatus == MSGFLTINFO_ALREADYDISALLOWED_FORWND, "got %lu\n", filter.ExtStatus );
+
+    /* a window of another process */
+    filter.ExtStatus = 0xdead;
+    SetLastError( 0xdeadbeef );
+    ret = pChangeWindowMessageFilterEx( GetDesktopWindow(), WM_COPYDATA, MSGFLT_ALLOW, &filter );
+    ok( !ret, "ChangeWindowMessageFilterEx succeeded\n" );
+    ok( GetLastError() == ERROR_ACCESS_DENIED, "got error %lu\n", GetLastError() );
+    ok( filter.ExtStatus == 0xdead, "got %lu\n", filter.ExtStatus );
+    DestroyWindow( hwnd );
+}
+
 static void test_PrintWindow(void)
 {
     BITMAPINFO bmi = {{sizeof(BITMAPINFOHEADER), 200, -150, 1, 32, BI_RGB}};
@@ -14938,6 +15041,8 @@ START_TEST(win)
     test_map_points();
     test_update_region();
     test_PrintWindow();
+    test_RegisterTouchHitTestingWindow();
+    test_ChangeWindowMessageFilterEx();
     test_window_without_child_style();
     test_smresult();
     test_GetMessagePos();
