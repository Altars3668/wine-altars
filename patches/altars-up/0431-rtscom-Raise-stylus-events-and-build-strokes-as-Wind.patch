From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 07:54:04 -0400
Subject: [PATCH] rtscom: Raise stylus events and build strokes as Windows 11
 does for the mouse.

A drag across a window on build 29671 gives a synchronous plugin
StylusInRange, StylusDown at the point the button went down, Packets with
that same point, Packets for each move, and StylusUp; the stroke builder's
stroke is the point it came down at, then the packets, so the first point
is there twice and the last once.  The packets are himetric from the
window's client area, as Wine's already were.  Wine sent no Packets after
StylusDown, and the stroke builder appended the point it went up at once
more.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/rtscom/rtscom_main.c b/dlls/rtscom/rtscom_main.c
index 0a3140e99d1..fab6c8902f9 100644
--- a/dlls/rtscom/rtscom_main.c
+++ b/dlls/rtscom/rtscom_main.c
@@ -359,6 +359,13 @@ static void handle_mouse( struct rtstylus *This, UINT msg, POINT pt )
     {
     case WM_LBUTTONDOWN:
         if (!inside || This->down) return;
+        if (!This->in_range)
+        {
+            struct event range = {NOTIFY_IN_RANGE};
+
+            This->in_range = TRUE;
+            dispatch_event( This, &range, sizeof(range) );
+        }
         This->down = TRUE;
         event.type = NOTIFY_DOWN;
         break;
@@ -399,6 +406,12 @@ static void handle_mouse( struct rtstylus *This, UINT msg, POINT pt )
     event.count = mouse_packet( This, pt, This->down || msg == WM_LBUTTONUP, event.packet );
     TRACE( "%p, event %d at %ld, %ld.\n", This, event.type, event.packet[0], event.packet[1] );
     dispatch_event( This, &event, sizeof(event) );
+    /* the point the stylus came down at is the first of its packets too, on Windows 11 */
+    if (event.type == NOTIFY_DOWN)
+    {
+        event.type = NOTIFY_PACKETS;
+        dispatch_event( This, &event, sizeof(event) );
+    }
 }
 
 /* a stylus whose last reference is going may still be in the list for a moment; it is left alone */
@@ -1763,8 +1776,9 @@ static HRESULT WINAPI builder_plugin_StylusUp( IStylusPlugin *iface, IRealTimeSt
 
     TRACE( "%p, %p, %p, %lu, %p, %p\n", This, rts, info, count, packet, changed );
 
+    /* The point it went up at came as the last packet already: on Windows 11 a drag of four points makes a stroke
+     * of the point it came down at, then the four packets, and nothing more. */
     if (!info) return E_INVALIDARG;
-    IStrokeBuilder_AppendPackets( &This->IStrokeBuilder_iface, info->tcid, info->cid, count, packet );
     if (SUCCEEDED(hr = IStrokeBuilder_EndStroke( &This->IStrokeBuilder_iface, info->tcid, info->cid, &stroke, &dirty )))
         IInkStrokeDisp_Release( stroke );
     return hr;
