From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:25:27 -0400
Subject: [PATCH] kernelbase: Name the drive of a normalized final path in
 upper case.

As its mount point does on Windows, whatever case the path was opened with.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index f947166df4a..3517aa75d28 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -6011,6 +6011,18 @@ static void test_GetFinalPathNameByHandleW(void)
        wine_dbgstr_w(test_path), wine_dbgstr_w(result_path));
     CloseHandle(file);
 
+    /* the drive letter too */
+    wcscpy(result_path, temp_path);
+    wcscat(result_path, L"test.dat");
+    if (result_path[1] == ':') result_path[0] = towlower(result_path[0]);
+    file = CreateFileW(result_path, GENERIC_READ | GENERIC_WRITE, 0, NULL, OPEN_EXISTING, 0, 0);
+    ok(file != INVALID_HANDLE_VALUE, "CreateFileW error %lu\n", GetLastError());
+    count = pGetFinalPathNameByHandleW(file, result_path, ARRAY_SIZE(result_path), 0);
+    ok(count == lstrlenW(test_path) + 4, "Expected length %u, got %lu\n", lstrlenW(test_path), count);
+    ok(wcscmp(test_path, result_path + 4) == 0, "Expected %s, got %s\n",
+       wine_dbgstr_w(test_path), wine_dbgstr_w(result_path));
+    CloseHandle(file);
+
     wcscpy(result_path, temp_path);
     wcscat(result_path, L"test.dat");
     file = CreateFileW(result_path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL, CREATE_ALWAYS, 0, 0);
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 0375933c780..83c5c3c115e 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -2124,6 +2124,8 @@ static WCHAR *get_normalized_path( HANDLE file, const WCHAR *opened )
                                      sizeof(WCHAR) )))
     {
         memcpy( ret, opened, (rest - opened) * sizeof(WCHAR) );
+        /* a drive, as the volume's mount point names it */
+        if (rest - opened == 2 && opened[1] == ':') ret[0] = RtlUpcaseUnicodeChar( ret[0] );
         memcpy( ret + (rest - opened), info->FileName, info->FileNameLength );
         ret[(rest - opened) + info->FileNameLength / sizeof(WCHAR)] = 0;
     }
