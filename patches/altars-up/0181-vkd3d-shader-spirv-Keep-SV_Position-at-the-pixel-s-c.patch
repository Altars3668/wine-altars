From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 22:01:05 -0400
Subject: [PATCH] vkd3d-shader/spirv: Keep SV_Position at the pixel's centre in
 a shader run per sample.

In a pixel shader run for each sample -- reading SV_SampleIndex, or with
an input interpolated at the sample -- FragCoord is the sample's position,
but D3D gives the pixel's centre in SV_Position unless it is itself
interpolated at the sample (measured on Windows with wine-altars'
tools/d3d11sampleprobe).  SV_Position is now floor(FragCoord.xy) + 0.5
unless it is marked so; run per pixel, FragCoord is at the centre already
and this changes nothing.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 7a3e3e67e8d293916f2f9a3022ba6f98b12a1ebf)

diff --git a/libs/vkd3d/libs/vkd3d-shader/spirv.c b/libs/vkd3d/libs/vkd3d-shader/spirv.c
index 22af3f10ee7..13f0da7c992 100644
--- a/libs/vkd3d/libs/vkd3d-shader/spirv.c
+++ b/libs/vkd3d/libs/vkd3d-shader/spirv.c
@@ -5166,6 +5166,27 @@ static uint32_t frag_coord_fixup(struct spirv_compiler *compiler, uint32_t frag_
     return vkd3d_spirv_build_op_composite_insert1(builder, type_id, w_id, frag_coord_id, 3);
 }
 
+/* In a pixel shader run for each sample, SV_Position is still the pixel's centre, unless it is interpolated at
+ * the sample, where FragCoord is the sample's position. Elsewhere FragCoord is the centre already, and this
+ * leaves it be. */
+static uint32_t spirv_compiler_emit_frag_coord_centre(struct spirv_compiler *compiler, uint32_t frag_coord_id)
+{
+    static const uint32_t xy[] = {0, 1}, xyzw[] = {0, 1, 4, 5};
+    struct vkd3d_spirv_builder *builder = &compiler->spirv_builder;
+    uint32_t vec2_type_id, vec4_type_id, xy_id;
+
+    vec2_type_id = spirv_get_type_id(compiler, VSIR_DATA_F32, 2);
+    vec4_type_id = spirv_get_type_id(compiler, VSIR_DATA_F32, VKD3D_VEC4_SIZE);
+    xy_id = vkd3d_spirv_build_op_vector_shuffle(builder, vec2_type_id, frag_coord_id, frag_coord_id,
+            xy, ARRAY_SIZE(xy));
+    xy_id = vkd3d_spirv_build_op_ext_inst(builder, vec2_type_id, vkd3d_spirv_get_glsl_std450_instr_set(builder),
+            GLSLstd450Floor, &xy_id, 1);
+    xy_id = vkd3d_spirv_build_op_tr2(builder, &builder->function_stream, SpvOpFAdd, vec2_type_id,
+            xy_id, spirv_compiler_get_constant_float_vector(compiler, 0.5f, 2));
+    return vkd3d_spirv_build_op_vector_shuffle(builder, vec4_type_id, xy_id, frag_coord_id,
+            xyzw, ARRAY_SIZE(xyzw));
+}
+
 struct vkd3d_spirv_builtin
 {
     enum vsir_data_type data_type;
@@ -5692,6 +5713,10 @@ static void spirv_compiler_emit_input(struct spirv_compiler *compiler,
 
         if (builtin && builtin->fixup_pfn)
             val_id = builtin->fixup_pfn(compiler, val_id);
+        if (builtin && builtin->spirv_builtin == SpvBuiltInFragCoord
+                && signature_element->interpolation_mode != VKD3DSIM_LINEAR_SAMPLE
+                && signature_element->interpolation_mode != VKD3DSIM_LINEAR_NOPERSPECTIVE_SAMPLE)
+            val_id = spirv_compiler_emit_frag_coord_centre(compiler, val_id);
 
         if (data_type != VSIR_DATA_F32)
         {
