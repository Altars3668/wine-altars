From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 08:51:49 -0400
Subject: [PATCH] crypt32: Count the elements an array skips as decoded.

An element a decoder declines, as verify_and_copy_certificate does any
certificate choice that is no certificate, was not counted, so the
sequence went on from inside the array.  A Microsoft time stamp token's
certificates end with an attribute certificate, and the [1] it starts
with was then taken for the CRLs, which failed to decode, and so did the
message's certificate store.  And the elements kept are now decoded
where they are, not counted from the start, so one skipped among them
does not shift the rest.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/crypt32/decode.c b/dlls/crypt32/decode.c
index b175c0392f1..c0db949ed47 100644
--- a/dlls/crypt32/decode.c
+++ b/dlls/crypt32/decode.c
@@ -605,6 +605,7 @@ struct AsnArrayDescriptor
 
 struct AsnArrayItemSize
 {
+    DWORD offset;
     DWORD encodedLen;
     DWORD size;
 };
@@ -688,6 +689,7 @@ static BOOL CRYPT_AsnDecodeArray(const struct AsnArrayDescriptor *arrayDesc,
                             /* Ignore an item that failed to decode but the decoder doesn't want to fail the whole process */
                             if (!size)
                             {
+                                decoded += itemEncoded;
                                 ptr += itemEncoded;
                                 continue;
                             }
@@ -708,6 +710,7 @@ static BOOL CRYPT_AsnDecodeArray(const struct AsnArrayDescriptor *arrayDesc,
                             if (itemSizes)
                             {
                                 decoded += itemDecoded;
+                                itemSizes[cItems - 1].offset = ptr - pbEncoded;
                                 itemSizes[cItems - 1].encodedLen = itemEncoded;
                                 itemSizes[cItems - 1].size = size;
                                 bytesNeeded += size;
@@ -730,7 +733,6 @@ static BOOL CRYPT_AsnDecodeArray(const struct AsnArrayDescriptor *arrayDesc,
                 {
                     DWORD i, *pcItems;
                     BYTE *nextData;
-                    const BYTE *ptr;
                     void *rgItems;
 
                     if (dwFlags & CRYPT_DECODE_ALLOC_FLAG)
@@ -749,25 +751,21 @@ static BOOL CRYPT_AsnDecodeArray(const struct AsnArrayDescriptor *arrayDesc,
                         rgItems = *(void **)((BYTE *)pcItems -
                          arrayDesc->countOffset + arrayDesc->arrayOffset);
                     nextData = (BYTE *)rgItems + cItems * arrayDesc->itemSize;
-                    for (i = 0, ptr = pbEncoded + 1 + lenBytes; ret &&
-                     i < cItems && ptr - pbEncoded - 1 - lenBytes <
-                     dataLen; i++)
+                    /* the items that were kept, wherever they are among those skipped */
+                    for (i = 0; ret && i < cItems; i++)
                     {
                         DWORD itemDecoded;
 
                         if (arrayDesc->hasPointer)
                             *(BYTE **)((BYTE *)rgItems + i * arrayDesc->itemSize
                              + arrayDesc->pointerOffset) = nextData;
-                        ret = arrayDesc->decodeFunc(ptr,
+                        ret = arrayDesc->decodeFunc(pbEncoded + itemSizes[i].offset,
                          itemSizes[i].encodedLen,
                          dwFlags & ~CRYPT_DECODE_ALLOC_FLAG,
                          (BYTE *)rgItems + i * arrayDesc->itemSize,
                          &itemSizes[i].size, &itemDecoded);
                         if (ret)
-                        {
                             nextData += itemSizes[i].size - arrayDesc->itemSize;
-                            ptr += itemDecoded;
-                        }
                     }
                     if (!ret && (dwFlags & CRYPT_DECODE_ALLOC_FLAG))
                         CRYPT_FreeSpace(pDecodePara, pvStructInfo);
