diff --git a/dlls/twinapi/tests/virtualdesktop.c b/dlls/twinapi/tests/virtualdesktop.c
new file mode 100644
index 00000000000..386a33cfbe6
--- /dev/null
+++ b/dlls/twinapi/tests/virtualdesktop.c
@@ -0,0 +1,117 @@
+/*
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+#define COBJMACROS
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "objbase.h"
+#include "shobjidl.h"
+
+#include "wine/test.h"
+
+static void check_window_( unsigned int line, IVirtualDesktopManager *manager, HWND hwnd, HRESULT expect_on,
+                           HRESULT expect_id, const GUID *expect_desktop )
+{
+    BOOL on = 2;
+    GUID id;
+    HRESULT hr;
+
+    hr = IVirtualDesktopManager_IsWindowOnCurrentVirtualDesktop( manager, hwnd, &on );
+    ok_(__FILE__, line)( hr == expect_on, "Got hr %#lx.\n", hr );
+    ok_(__FILE__, line)( on == TRUE, "Got %d.\n", on );
+    memset( &id, 0xcc, sizeof(id) );
+    hr = IVirtualDesktopManager_GetWindowDesktopId( manager, hwnd, &id );
+    ok_(__FILE__, line)( hr == expect_id, "Got hr %#lx.\n", hr );
+    ok_(__FILE__, line)( IsEqualGUID( &id, expect_desktop ), "Got desktop %s.\n", wine_dbgstr_guid( &id ) );
+}
+#define check_window( a, b, c, d, e ) check_window_( __LINE__, a, b, c, d, e )
+
+static void test_VirtualDesktopManager(void)
+{
+    static const GUID other = {0x12345678, 0x1234, 0x1234, {1, 2, 3, 4, 5, 6, 7, 8}};
+    IVirtualDesktopManager *manager;
+    HWND visible, hidden, child;
+    GUID current;
+    IUnknown *unk;
+    HRESULT hr;
+
+    hr = CoCreateInstance( &CLSID_VirtualDesktopManager, NULL, CLSCTX_INPROC_SERVER, &IID_IVirtualDesktopManager,
+                           (void **)&manager );
+    if (hr == REGDB_E_CLASSNOTREG)
+    {
+        win_skip( "VirtualDesktopManager is not available.\n" );
+        return;
+    }
+    ok( hr == S_OK, "Got hr %#lx.\n", hr );
+    hr = IVirtualDesktopManager_QueryInterface( manager, &IID_IAgileObject, (void **)&unk );
+    ok( hr == S_OK, "Got hr %#lx.\n", hr );
+    IUnknown_Release( unk );
+    hr = IVirtualDesktopManager_QueryInterface( manager, &IID_IMarshal, (void **)&unk );
+    ok( hr == S_OK, "Got hr %#lx.\n", hr );
+    IUnknown_Release( unk );
+
+    visible = CreateWindowA( "static", "visible", WS_OVERLAPPEDWINDOW | WS_VISIBLE, 0, 0, 100, 100, NULL, NULL, NULL, NULL );
+    hidden = CreateWindowA( "static", "hidden", WS_OVERLAPPEDWINDOW, 0, 0, 100, 100, NULL, NULL, NULL, NULL );
+    child = CreateWindowA( "static", "child", WS_CHILD | WS_VISIBLE, 0, 0, 10, 10, visible, NULL, NULL, NULL );
+
+    /* a shown window of one's own has the desktop's id */
+    memset( &current, 0, sizeof(current) );
+    hr = IVirtualDesktopManager_GetWindowDesktopId( manager, visible, &current );
+    ok( hr == S_OK, "Got hr %#lx.\n", hr );
+    ok( !IsEqualGUID( &current, &GUID_NULL ), "Got no desktop.\n" );
+    check_window( manager, visible, S_OK, S_OK, &current );
+
+    /* everything else is on the current desktop, and has no id of one */
+    check_window( manager, hidden, S_OK, TYPE_E_ELEMENTNOTFOUND, &GUID_NULL );
+    check_window( manager, child, S_OK, TYPE_E_ELEMENTNOTFOUND, &GUID_NULL );
+    check_window( manager, GetDesktopWindow(), S_OK, TYPE_E_ELEMENTNOTFOUND, &GUID_NULL );
+    check_window( manager, (HWND)0xdeadbeef, S_OK, TYPE_E_ELEMENTNOTFOUND, &GUID_NULL );
+    check_window( manager, NULL, E_INVALIDARG, E_INVALIDARG, &GUID_NULL );
+
+    /* a window of one's own can go to the desktop it is on, and to no other */
+    hr = IVirtualDesktopManager_MoveWindowToDesktop( manager, visible, &current );
+    ok( hr == S_OK, "Got hr %#lx.\n", hr );
+    hr = IVirtualDesktopManager_MoveWindowToDesktop( manager, hidden, &current );
+    ok( hr == S_OK, "Got hr %#lx.\n", hr );
+    hr = IVirtualDesktopManager_MoveWindowToDesktop( manager, child, &current );
+    ok( hr == S_OK, "Got hr %#lx.\n", hr );
+    hr = IVirtualDesktopManager_MoveWindowToDesktop( manager, visible, &GUID_NULL );
+    ok( hr == TYPE_E_ELEMENTNOTFOUND, "Got hr %#lx.\n", hr );
+    hr = IVirtualDesktopManager_MoveWindowToDesktop( manager, visible, &other );
+    ok( hr == TYPE_E_ELEMENTNOTFOUND, "Got hr %#lx.\n", hr );
+    hr = IVirtualDesktopManager_MoveWindowToDesktop( manager, NULL, &current );
+    ok( hr == E_INVALIDARG, "Got hr %#lx.\n", hr );
+
+    /* shown, it has the id */
+    ShowWindow( hidden, SW_SHOW );
+    check_window( manager, hidden, S_OK, S_OK, &current );
+
+    DestroyWindow( child );
+    DestroyWindow( visible );
+    DestroyWindow( hidden );
+    IVirtualDesktopManager_Release( manager );
+}
+
+START_TEST(virtualdesktop)
+{
+    CoInitializeEx( NULL, COINIT_APARTMENTTHREADED );
+    test_VirtualDesktopManager();
+    CoUninitialize();
+}
