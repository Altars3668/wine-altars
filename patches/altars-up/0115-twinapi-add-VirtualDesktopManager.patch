diff --git a/dlls/twinapi/virtualdesktop.c b/dlls/twinapi/virtualdesktop.c
new file mode 100644
index 00000000000..538300666d3
--- /dev/null
+++ b/dlls/twinapi/virtualdesktop.c
@@ -0,0 +1,242 @@
+/*
+ * VirtualDesktopManager
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "winreg.h"
+#include "objbase.h"
+#include "shobjidl.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/*
+ * There is one virtual desktop here, the one every window is on.  As on
+ * Windows, a window is on the current desktop unless it is on another, so
+ * every handle is; the desktop has an id, kept where Windows keeps it, for
+ * the windows it tracks -- the shown top level windows of applications, and
+ * not the desktop's own, nor children, nor hidden ones -- and a window of
+ * one's own can be moved to it, and to no other.
+ */
+
+struct virtual_desktop_manager
+{
+    IVirtualDesktopManager IVirtualDesktopManager_iface;
+    LONG ref;
+    IUnknown *marshal;
+};
+
+static inline struct virtual_desktop_manager *impl_from_IVirtualDesktopManager( IVirtualDesktopManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct virtual_desktop_manager, IVirtualDesktopManager_iface );
+}
+
+/* the id of the one desktop, as explorer keeps it for the current user; made the first time it is asked for */
+static void current_desktop_id( GUID *id )
+{
+    static const WCHAR key_name[] = L"Software\\Microsoft\\Windows\\CurrentVersion\\Explorer\\VirtualDesktops";
+    DWORD size = sizeof(*id), type;
+    HKEY key;
+
+    memset( id, 0, sizeof(*id) );
+    if (RegCreateKeyExW( HKEY_CURRENT_USER, key_name, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &key, NULL )) return;
+    if (RegQueryValueExW( key, L"CurrentVirtualDesktop", NULL, &type, (BYTE *)id, &size ) || type != REG_BINARY
+        || size != sizeof(*id))
+    {
+        CoCreateGuid( id );
+        RegSetValueExW( key, L"CurrentVirtualDesktop", 0, REG_BINARY, (const BYTE *)id, sizeof(*id) );
+        RegSetValueExW( key, L"VirtualDesktopIDs", 0, REG_BINARY, (const BYTE *)id, sizeof(*id) );
+    }
+    RegCloseKey( key );
+}
+
+/* whether the desktop tracks a window: a shown top level one, of an application rather than of the desktop's */
+static BOOL is_tracked( HWND hwnd )
+{
+    DWORD desktop_pid = 0, pid = 0;
+
+    if (!IsWindow( hwnd ) || !IsWindowVisible( hwnd )) return FALSE;
+    if (GetAncestor( hwnd, GA_PARENT ) != GetDesktopWindow()) return FALSE;
+    GetWindowThreadProcessId( GetDesktopWindow(), &desktop_pid );
+    GetWindowThreadProcessId( hwnd, &pid );
+    return pid != desktop_pid;
+}
+
+static HRESULT WINAPI virtual_desktop_manager_QueryInterface( IVirtualDesktopManager *iface, REFIID iid, void **out )
+{
+    struct virtual_desktop_manager *impl = impl_from_IVirtualDesktopManager( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IVirtualDesktopManager ))
+    {
+        IVirtualDesktopManager_AddRef( (*out = &impl->IVirtualDesktopManager_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IMarshal ))
+        return IUnknown_QueryInterface( impl->marshal, iid, out );
+
+    TRACE( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI virtual_desktop_manager_AddRef( IVirtualDesktopManager *iface )
+{
+    struct virtual_desktop_manager *impl = impl_from_IVirtualDesktopManager( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI virtual_desktop_manager_Release( IVirtualDesktopManager *iface )
+{
+    struct virtual_desktop_manager *impl = impl_from_IVirtualDesktopManager( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        IUnknown_Release( impl->marshal );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI virtual_desktop_manager_IsWindowOnCurrentVirtualDesktop( IVirtualDesktopManager *iface,
+                                                                            HWND hwnd, BOOL *on_current )
+{
+    TRACE( "iface %p, hwnd %p, on_current %p.\n", iface, hwnd, on_current );
+
+    /* answered before the window is looked at, as on Windows, where a NULL result is not checked for either */
+    *on_current = TRUE;
+    return hwnd ? S_OK : E_INVALIDARG;
+}
+
+static HRESULT WINAPI virtual_desktop_manager_GetWindowDesktopId( IVirtualDesktopManager *iface, HWND hwnd, GUID *id )
+{
+    TRACE( "iface %p, hwnd %p, id %p.\n", iface, hwnd, id );
+
+    memset( id, 0, sizeof(*id) );
+    if (!hwnd) return E_INVALIDARG;
+    if (!is_tracked( hwnd )) return TYPE_E_ELEMENTNOTFOUND;
+    current_desktop_id( id );
+    return S_OK;
+}
+
+static HRESULT WINAPI virtual_desktop_manager_MoveWindowToDesktop( IVirtualDesktopManager *iface, HWND hwnd,
+                                                                REFGUID id )
+{
+    DWORD pid = 0;
+    GUID current;
+
+    TRACE( "iface %p, hwnd %p, id %s.\n", iface, hwnd, debugstr_guid( id ) );
+
+    if (!hwnd) return E_INVALIDARG;
+    GetWindowThreadProcessId( hwnd, &pid );
+    if (pid != GetCurrentProcessId()) return E_ACCESSDENIED;
+    current_desktop_id( &current );
+    /* it is there already */
+    if (!IsEqualGUID( id, &current )) return TYPE_E_ELEMENTNOTFOUND;
+    return S_OK;
+}
+
+static const IVirtualDesktopManagerVtbl virtual_desktop_manager_vtbl =
+{
+    virtual_desktop_manager_QueryInterface,
+    virtual_desktop_manager_AddRef,
+    virtual_desktop_manager_Release,
+    virtual_desktop_manager_IsWindowOnCurrentVirtualDesktop,
+    virtual_desktop_manager_GetWindowDesktopId,
+    virtual_desktop_manager_MoveWindowToDesktop,
+};
+
+static HRESULT virtual_desktop_manager_create( IUnknown *outer, REFIID iid, void **out )
+{
+    struct virtual_desktop_manager *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IVirtualDesktopManager_iface.lpVtbl = &virtual_desktop_manager_vtbl;
+    impl->ref = 1;
+    if (FAILED(hr = CoCreateFreeThreadedMarshaler( (IUnknown *)&impl->IVirtualDesktopManager_iface, &impl->marshal )))
+    {
+        free( impl );
+        return hr;
+    }
+
+    hr = IVirtualDesktopManager_QueryInterface( &impl->IVirtualDesktopManager_iface, iid, out );
+    IVirtualDesktopManager_Release( &impl->IVirtualDesktopManager_iface );
+    return hr;
+}
+
+static HRESULT WINAPI class_factory_QueryInterface( IClassFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IClassFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI class_factory_AddRef( IClassFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI class_factory_Release( IClassFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI class_factory_CreateInstance( IClassFactory *iface, IUnknown *outer, REFIID iid, void **out )
+{
+    TRACE( "iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid( iid ), out );
+    return virtual_desktop_manager_create( outer, iid, out );
+}
+
+static HRESULT WINAPI class_factory_LockServer( IClassFactory *iface, BOOL lock )
+{
+    TRACE( "iface %p, lock %d.\n", iface, lock );
+    return S_OK;
+}
+
+static const IClassFactoryVtbl class_factory_vtbl =
+{
+    class_factory_QueryInterface,
+    class_factory_AddRef,
+    class_factory_Release,
+    class_factory_CreateInstance,
+    class_factory_LockServer,
+};
+
+IClassFactory virtual_desktop_manager_factory = {&class_factory_vtbl};
diff --git a/include/shobjidl.idl b/include/shobjidl.idl
