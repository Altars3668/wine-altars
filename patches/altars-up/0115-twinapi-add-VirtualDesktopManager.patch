     }
 
+    [
+        uuid(aa509086-5ca9-4c25-8f95-589d3c07b48a)
+    ]
+    coclass VirtualDesktopManager
+    {
+        interface IVirtualDesktopManager;
+    }
+
     [
         uuid(3ad05575-8857-4850-9277-11b85bdb8e09)
     ]
