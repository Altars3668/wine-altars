+    HRESULT GetWindowDesktopId([in] HWND toplevel, [out] GUID *desktop_id);
+    HRESULT MoveWindowToDesktop([in] HWND toplevel, [in] REFGUID desktop_id);
+}
+
 /*****************************************************************************
