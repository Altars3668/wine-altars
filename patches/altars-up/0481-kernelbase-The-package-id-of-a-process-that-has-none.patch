From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:01 -0400
Subject: [PATCH] kernelbase: The package id of a process that has none, and
 version information in the user's language.

GetCurrentPackageId checks its arguments before saying the process has
no package.  GetFileVersionInfo(Size)Ex with FILE_VER_GET_LOCALISED reads
the MUI file for the thread's preferred UI languages when there is one,
as Windows 11 does (tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernelbase/version.c b/dlls/kernelbase/version.c
index adf724e2c0e..dfbd7626c87 100644
--- a/dlls/kernelbase/version.c
+++ b/dlls/kernelbase/version.c
@@ -731,6 +731,35 @@ static void print_vffi_debug(const VS_FIXEDFILEINFO *vffi)
     TRACE("filedate=0x%lx.0x%lx\n",vffi->dwFileDateMS,vffi->dwFileDateLS);
 }
 
+/* The file whose version information the user's language has: the file's resources in that language, in
+ * <directory>\<language>\<file>.mui, for each of the user's languages; or the file itself. */
+static const WCHAR *localised_file( const WCHAR *filename, WCHAR *buffer, DWORD size )
+{
+    WCHAR path[MAX_PATH], *languages, *lang, *name;
+    ULONG count = 0, len = 0;
+    DWORD ret;
+
+    if (!(ret = SearchPathW( NULL, filename, NULL, ARRAY_SIZE(path), path, &name )) || ret >= ARRAY_SIZE(path))
+        return filename;
+    if (!GetThreadPreferredUILanguages( MUI_LANGUAGE_NAME | MUI_MERGE_USER_FALLBACK | MUI_MERGE_SYSTEM_FALLBACK,
+                                        &count, NULL, &len ) ||
+        !(languages = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) )))
+        return filename;
+    if (GetThreadPreferredUILanguages( MUI_LANGUAGE_NAME | MUI_MERGE_USER_FALLBACK | MUI_MERGE_SYSTEM_FALLBACK,
+                                       &count, languages, &len ))
+    {
+        for (lang = languages; *lang; lang += wcslen( lang ) + 1)
+        {
+            if (swprintf( buffer, size, L"%.*s%s\\%s.mui", (int)(name - path), path, lang, name ) < 0) continue;
+            if (GetFileAttributesW( buffer ) == INVALID_FILE_ATTRIBUTES) continue;
+            HeapFree( GetProcessHeap(), 0, languages );
+            return buffer;
+        }
+    }
+    HeapFree( GetProcessHeap(), 0, languages );
+    return filename;
+}
+
 /***********************************************************************
  *           GetFileVersionInfoSizeW         (kernelbase.@)
  */
@@ -754,6 +783,7 @@ DWORD WINAPI GetFileVersionInfoSizeExW( DWORD flags, LPCWSTR filename, LPDWORD r
 {
     DWORD len, offset, magic = 1;
     HMODULE hModule;
+    WCHAR mui[MAX_PATH];
 
     TRACE("(0x%lx,%s,%p)\n", flags, debugstr_w(filename), ret_handle );
 
@@ -769,8 +799,9 @@ DWORD WINAPI GetFileVersionInfoSizeExW( DWORD flags, LPCWSTR filename, LPDWORD r
         SetLastError(ERROR_BAD_PATHNAME);
         return 0;
     }
-    if (flags & ~FILE_VER_GET_LOCALISED)
-        FIXME("flags 0x%lx ignored\n", flags & ~FILE_VER_GET_LOCALISED);
+    /* the localised information is the language's file's, which takes precedence over the neutral one; to be
+     * prefetched is a hint */
+    if (flags & FILE_VER_GET_LOCALISED) filename = localised_file( filename, mui, ARRAY_SIZE(mui) );
 
     if ((hModule = LoadLibraryExW( filename, 0, LOAD_LIBRARY_AS_IMAGE_RESOURCE )))
     {
@@ -865,6 +896,7 @@ BOOL WINAPI GetFileVersionInfoExW( DWORD flags, LPCWSTR filename, DWORD ignored,
     DWORD len, offset, magic = 1;
     HMODULE hModule;
     VS_VERSION_INFO_STRUCT32* vvis = data;
+    WCHAR mui[MAX_PATH];
 
     TRACE("(0x%lx,%s,%ld,size=%ld,data=%p)\n",
           flags, debugstr_w(filename), ignored, datasize, data );
@@ -874,8 +906,8 @@ BOOL WINAPI GetFileVersionInfoExW( DWORD flags, LPCWSTR filename, DWORD ignored,
         SetLastError(ERROR_INVALID_DATA);
         return FALSE;
     }
-    if (flags & ~FILE_VER_GET_LOCALISED)
-        FIXME("flags 0x%lx ignored\n", flags & ~FILE_VER_GET_LOCALISED);
+    if (filename && *filename && (flags & FILE_VER_GET_LOCALISED))
+        filename = localised_file( filename, mui, ARRAY_SIZE(mui) );
 
     if ((hModule = LoadLibraryExW( filename, 0, LOAD_LIBRARY_AS_IMAGE_RESOURCE )))
     {
@@ -1602,7 +1634,10 @@ LONG WINAPI FindPackagesByPackageFamily( const WCHAR *family_name, UINT32 filter
  */
 LONG WINAPI /* DECLSPEC_HOTPATCH */ GetCurrentPackageId( UINT32 *len, BYTE *buffer )
 {
-    FIXME( "(%p %p): stub\n", len, buffer );
+    TRACE( "(%p %p)\n", len, buffer );
+
+    /* no process here has a package */
+    if (!len || (*len && !buffer)) return ERROR_INVALID_PARAMETER;
     return APPMODEL_ERROR_NO_PACKAGE;
 }
 
