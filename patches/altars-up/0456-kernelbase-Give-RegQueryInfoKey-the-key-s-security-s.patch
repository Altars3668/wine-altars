From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 14:11:54 -0400
Subject: [PATCH] kernelbase: Give RegQueryInfoKey the key's security size, and
 leave a class buffer of no size alone.

Windows 11 reports the size of the key's owner, group and DACL when the
handle may read them and 0 when it may not, and a class buffer of no
size keeps its size of 0.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/advapi32/tests/registry.c b/dlls/advapi32/tests/registry.c
index 9b2a42bf606..ca7aed0603e 100644
--- a/dlls/advapi32/tests/registry.c
+++ b/dlls/advapi32/tests/registry.c
@@ -1918,7 +1918,7 @@ static void test_reg_query_info(void)
     DWORD classlen;
     DWORD subkeys, maxsubkeylen, maxclasslen;
     DWORD values, maxvaluenamelen, maxvaluelen;
-    DWORD sdlen;
+    DWORD sdlen, seclen;
     FILETIME lastwrite;
 
     ret = RegCreateKeyExA(hkey_main, "subkey", 0, subkey_class, 0, KEY_ALL_ACCESS, NULL, &subkey, NULL);
@@ -1960,7 +1960,7 @@ static void test_reg_query_info(void)
     ok(values == 0, "values = %lu\n", values);
     ok(maxvaluenamelen == 0, "maxvaluenamelen = %lu\n", maxvaluenamelen);
     ok(maxvaluelen == 0, "maxvaluelen = %lu\n", maxvaluelen);
-    todo_wine ok(sdlen != 0, "sdlen = %lu\n", sdlen);
+    ok(sdlen != 0, "sdlen = %lu\n", sdlen);
     ok(lastwrite.dwLowDateTime != 0, "lastwrite.dwLowDateTime = %lu\n", lastwrite.dwLowDateTime);
     ok(lastwrite.dwHighDateTime != 0, "lastwrite.dwHighDateTime = %lu\n", lastwrite.dwHighDateTime);
 
@@ -1974,10 +1974,30 @@ static void test_reg_query_info(void)
     ok(values == 0, "values = %lu\n", values);
     ok(maxvaluenamelen == 0, "maxvaluenamelen = %lu\n", maxvaluenamelen);
     ok(maxvaluelen == 0, "maxvaluelen = %lu\n", maxvaluelen);
-    todo_wine ok(sdlen != 0, "sdlen = %lu\n", sdlen);
+    ok(sdlen != 0, "sdlen = %lu\n", sdlen);
     ok(lastwrite.dwLowDateTime != 0, "lastwrite.dwLowDateTime = %lu\n", lastwrite.dwLowDateTime);
     ok(lastwrite.dwHighDateTime != 0, "lastwrite.dwHighDateTime = %lu\n", lastwrite.dwHighDateTime);
 
+    sdlen = 0;
+    ret = RegGetKeySecurity(subkey, OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION |
+                            DACL_SECURITY_INFORMATION, NULL, &sdlen);
+    ok(ret == ERROR_INSUFFICIENT_BUFFER, "ret = %ld\n", ret);
+    seclen = 0;
+    ret = RegQueryInfoKeyW(subkey, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &seclen, NULL);
+    ok(ret == ERROR_SUCCESS, "ret = %ld\n", ret);
+    ok(seclen == sdlen, "got %lu, expected %lu\n", seclen, sdlen);
+    ret = RegOpenKeyExA(hkey_main, "subkey", 0, KEY_QUERY_VALUE, &subsubkey);
+    ok(ret == ERROR_SUCCESS, "ret = %ld\n", ret);
+    sdlen = 0xdeadbeef;
+    ret = RegQueryInfoKeyA(subsubkey, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &sdlen, NULL);
+    ok(ret == ERROR_SUCCESS, "ret = %ld\n", ret);
+    ok(!sdlen, "sdlen = %lu\n", sdlen);
+    sdlen = 0xdeadbeef;
+    ret = RegQueryInfoKeyW(subsubkey, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, &sdlen, NULL);
+    ok(ret == ERROR_SUCCESS, "ret = %ld\n", ret);
+    ok(!sdlen, "sdlen = %lu\n", sdlen);
+    RegCloseKey(subsubkey);
+
     ret = RegCreateKeyExA(subkey, "subsubkey", 0, subsubkey_class, 0, KEY_ALL_ACCESS, NULL, &subsubkey, NULL);
     ok(ret == ERROR_SUCCESS, "Expected ERROR_SUCCESS, got %ld\n", ret);
 
@@ -1995,7 +2015,7 @@ static void test_reg_query_info(void)
     ok(values == 1, "values = %lu\n", values);
     ok(maxvaluenamelen == 0, "maxvaluenamelen = %lu\n", maxvaluenamelen);
     ok(maxvaluelen == sizeof("data") * sizeof(WCHAR), "maxvaluelen = %lu\n", maxvaluelen);
-    todo_wine ok(sdlen != 0, "sdlen = %lu\n", sdlen);
+    ok(sdlen != 0, "sdlen = %lu\n", sdlen);
     ok(lastwrite.dwLowDateTime != 0, "lastwrite.dwLowDateTime = %lu\n", lastwrite.dwLowDateTime);
     ok(lastwrite.dwHighDateTime != 0, "lastwrite.dwHighDateTime = %lu\n", lastwrite.dwHighDateTime);
 
@@ -2009,7 +2029,7 @@ static void test_reg_query_info(void)
     ok(values == 1, "values = %lu\n", values);
     ok(maxvaluenamelen == 0, "maxvaluenamelen = %lu\n", maxvaluenamelen);
     ok(maxvaluelen == sizeof("data") * sizeof(WCHAR), "maxvaluelen = %lu\n", maxvaluelen);
-    todo_wine ok(sdlen != 0, "sdlen = %lu\n", sdlen);
+    ok(sdlen != 0, "sdlen = %lu\n", sdlen);
     ok(lastwrite.dwLowDateTime != 0, "lastwrite.dwLowDateTime = %lu\n", lastwrite.dwLowDateTime);
     ok(lastwrite.dwHighDateTime != 0, "lastwrite.dwHighDateTime = %lu\n", lastwrite.dwHighDateTime);
 
@@ -2039,7 +2059,7 @@ static void test_reg_query_info(void)
     classlen = 0;
     ret = RegQueryInfoKeyA(subkey, classbuffer, &classlen, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
     ok(ret == ERROR_SUCCESS, "ret = %ld\n", ret);
-    todo_wine ok(classlen == 0, "classlen = %lu\n", classlen);
+    ok(classlen == 0, "classlen = %lu\n", classlen);
     memset(expectbuffer, 0x55, sizeof(expectbuffer));
     ok(!memcmp(classbuffer, expectbuffer, sizeof(classbuffer)), "classbuffer was modified\n");
 
@@ -2047,7 +2067,7 @@ static void test_reg_query_info(void)
     classlen = 0;
     ret = RegQueryInfoKeyW(subkey, classbufferW, &classlen, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL, NULL);
     ok(ret == ERROR_SUCCESS, "ret = %ld\n", ret);
-    todo_wine ok(classlen == 0, "classlen = %lu\n", classlen);
+    ok(classlen == 0, "classlen = %lu\n", classlen);
     memset(expectbufferW, 0x55, sizeof(expectbufferW));
     ok(!memcmp(classbufferW, expectbufferW, sizeof(classbufferW)), "classbufferW was modified\n");
 
diff --git a/dlls/kernelbase/registry.c b/dlls/kernelbase/registry.c
index 8b5516fbd8d..66533f1d656 100644
--- a/dlls/kernelbase/registry.c
+++ b/dlls/kernelbase/registry.c
@@ -1637,6 +1637,18 @@ LSTATUS WINAPI RegEnumKeyExA( HKEY hkey, DWORD index, LPSTR name, LPDWORD name_l
 }
 
 
+/* the size of a key's owner, group and DACL, as RegQueryInfoKey gives it: 0 when the handle cannot read them */
+static DWORD key_security_size( HKEY hkey )
+{
+    ULONG len = 0;
+
+    if (NtQuerySecurityObject( hkey, OWNER_SECURITY_INFORMATION | GROUP_SECURITY_INFORMATION |
+                               DACL_SECURITY_INFORMATION, NULL, 0, &len ) != STATUS_BUFFER_TOO_SMALL)
+        return 0;
+    return len;
+}
+
+
 /******************************************************************************
  * RegQueryInfoKeyW   (kernelbase.@)
  *
@@ -1711,7 +1723,8 @@ LSTATUS WINAPI RegQueryInfoKeyW( HKEY hkey, LPWSTR class, LPDWORD class_len, LPD
     }
     else status = STATUS_SUCCESS;
 
-    if (class_len) *class_len = info->ClassLength / sizeof(WCHAR);
+    /* a class buffer of no size leaves its size as it was */
+    if (class_len && !(class && !*class_len)) *class_len = info->ClassLength / sizeof(WCHAR);
     if (subkeys) *subkeys = info->SubKeys;
     if (max_subkey) *max_subkey = info->MaxNameLen / sizeof(WCHAR);
     if (max_class) *max_class = info->MaxClassLen / sizeof(WCHAR);
@@ -1721,11 +1734,7 @@ LSTATUS WINAPI RegQueryInfoKeyW( HKEY hkey, LPWSTR class, LPDWORD class_len, LPD
     if (modif) *modif = *(FILETIME *)&info->LastWriteTime;
     if (is_hkcr_key( hkey )) query_hkcr_info( hkey, subkeys, values, max_subkey, max_value, max_data );
 
-    if (security)
-    {
-        FIXME( "security argument not supported.\n");
-        *security = 0;
-    }
+    if (security) *security = key_security_size( unmark_hkcr_key( hkey ) );
 
  done:
     if (buf_ptr != buffer) HeapFree( GetProcessHeap(), 0, buf_ptr );
@@ -1802,7 +1811,7 @@ LSTATUS WINAPI RegQueryInfoKeyA( HKEY hkey, LPSTR class, LPDWORD class_len, LPDW
             }
             class[*class_len] = 0;
         }
-        else if (class_len)
+        else if (class_len && !class)
             RtlUnicodeToMultiByteSize( class_len,
                                        (WCHAR *)(buf_ptr + info->ClassOffset), info->ClassLength );
     }
@@ -1817,11 +1826,7 @@ LSTATUS WINAPI RegQueryInfoKeyA( HKEY hkey, LPSTR class, LPDWORD class_len, LPDW
     if (modif) *modif = *(FILETIME *)&info->LastWriteTime;
     if (is_hkcr_key( hkey )) query_hkcr_info( hkey, subkeys, values, max_subkey, max_value, max_data );
 
-    if (security)
-    {
-        FIXME( "security argument not supported.\n");
-        *security = 0;
-    }
+    if (security) *security = key_security_size( unmark_hkcr_key( hkey ) );
 
  done:
     if (buf_ptr != buffer) HeapFree( GetProcessHeap(), 0, buf_ptr );
