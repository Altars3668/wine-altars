From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 23:29:41 -0400
Subject: [PATCH] kernelbase: Add GetPackagePath().

IEAWSDC.DLL, which Excel loads, imports it from kernel32; without the export the loader points it at
a stub that aborts the process when called.  It answers as GetPackagePathByFullName() does for the
full name the id makes; what Windows answers for a package that is not installed is measured by
tools/win10apiprobe.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/kernel32.spec b/dlls/kernel32/kernel32.spec
index 7c1e9af0fd8..e1fe97c522a 100644
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -786,6 +786,7 @@
 @ stdcall GetPackageFamilyName(long ptr ptr) kernelbase.GetPackageFamilyName
 @ stdcall GetPackageFullName(long ptr ptr) kernelbase.GetPackageFullName
 @ stdcall GetPackagesByPackageFamily(wstr ptr ptr ptr ptr) kernelbase.GetPackagesByPackageFamily
+@ stdcall GetPackagePath(ptr long ptr ptr) kernelbase.GetPackagePath
 @ stdcall GetPackagePathByFullName(wstr ptr wstr) kernelbase.GetPackagePathByFullName
 @ stdcall -import GetPhysicallyInstalledSystemMemory(ptr)
 @ stdcall -import GetPriorityClass(long)
diff --git a/dlls/kernelbase/kernelbase.spec b/dlls/kernelbase/kernelbase.spec
index 2d6b5023db1..62853f229eb 100644
--- a/dlls/kernelbase/kernelbase.spec
+++ b/dlls/kernelbase/kernelbase.spec
@@ -638,7 +638,7 @@
 # @ stub GetPackageInfo
 # @ stub GetPackageInstallTime
 # @ stub GetPackageOSMaxVersionTested
-# @ stub GetPackagePath
+@ stdcall GetPackagePath(ptr long ptr ptr)
 @ stdcall GetPackagePathByFullName(wstr ptr wstr)
 # @ stub GetPackagePathOnVolume
 # @ stub GetPackageProperty
diff --git a/dlls/kernelbase/version.c b/dlls/kernelbase/version.c
index 6010b98a52f..adf724e2c0e 100644
--- a/dlls/kernelbase/version.c
+++ b/dlls/kernelbase/version.c
@@ -1673,6 +1673,24 @@ LONG WINAPI GetPackagePathByFullName(const WCHAR *name, UINT32 *len, WCHAR *path
     return APPMODEL_ERROR_NO_PACKAGE;
 }
 
+/***********************************************************************
+ *         GetPackagePath   (kernelbase.@)
+ *
+ * The path of the package an id names: the one of its full name.
+ */
+LONG WINAPI GetPackagePath(const PACKAGE_ID *id, const UINT32 reserved, UINT32 *len, WCHAR *path)
+{
+    WCHAR full_name[PACKAGE_FULL_NAME_MAX_LENGTH + 1];
+    UINT32 name_len = ARRAY_SIZE(full_name);
+    LONG ret;
+
+    TRACE("(%p %u %p %p)\n", id, reserved, len, path);
+
+    if (!len) return ERROR_INVALID_PARAMETER;
+    if ((ret = PackageFullNameFromId(id, &name_len, full_name))) return ret;
+    return GetPackagePathByFullName(full_name, len, path);
+}
+
 static const struct
 {
     UINT32 code;
