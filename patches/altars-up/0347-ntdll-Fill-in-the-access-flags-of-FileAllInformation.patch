From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:02:29 -0400
Subject: [PATCH] ntdll: Fill in the access flags of FileAllInformation.

[MS-FSA] fills them as FileAccessInformation does, with the access
granted to the handle, which the server keeps.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 2af179e60fb..fa94f6862f6 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -4761,6 +4761,7 @@ static void test_file_id_information(void)
 
 static void test_file_access_information(void)
 {
+    union { FILE_ALL_INFORMATION info; BYTE buffer[1024]; } all;
     FILE_ACCESS_INFORMATION info;
     IO_STATUS_BLOCK io;
     NTSTATUS status;
@@ -4779,6 +4780,11 @@ static void test_file_access_information(void)
     ok( status == STATUS_SUCCESS, "expected STATUS_SUCCESS, got %08lx\n", status );
     ok( info.AccessFlags == 0x13019f, "got %08lx\n", info.AccessFlags );
 
+    memset( &all, 0x11, sizeof(all) );
+    status = pNtQueryInformationFile( h, &io, &all, sizeof(all), FileAllInformation );
+    ok( status == STATUS_SUCCESS, "expected STATUS_SUCCESS, got %08lx\n", status );
+    ok( all.info.AccessInformation.AccessFlags == 0x13019f, "got %08lx\n", all.info.AccessInformation.AccessFlags );
+
     CloseHandle( h );
 }
 
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 4ec5cc14b4e..85c8fadd696 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5319,6 +5319,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
     case FileAllInformation:
         {
             FILE_ALL_INFORMATION *info = ptr;
+            IO_STATUS_BLOCK access_io;
 
             if (fd_get_file_info( handle, fd, options, &st, &attr, NULL ) == -1)
                 status = errno_to_status( errno );
@@ -5329,7 +5330,10 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                 fill_file_info( &st, attr, info, FileAllInformation );
                 info->StandardInformation.DeletePending = !st.st_nlink;
                 info->EaInformation.EaSize = 0;
-                info->AccessInformation.AccessFlags = 0;  /* FIXME */
+                /* the access granted to this handle, which only the server knows in full */
+                if (server_get_file_info( handle, &access_io, &info->AccessInformation,
+                                          sizeof(info->AccessInformation), FileAccessInformation ))
+                    info->AccessInformation.AccessFlags = 0;
                 info->PositionInformation.CurrentByteOffset.QuadPart = lseek( fd, 0, SEEK_CUR );
                 info->ModeInformation.Mode = options & (FILE_WRITE_THROUGH | FILE_SEQUENTIAL_ONLY |
                                                         FILE_NO_INTERMEDIATE_BUFFERING |
