From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 11:56:58 -0400
Subject: [PATCH] wtsapi32: check session notification registrations.

WTSRegisterSessionNotification succeeded for anything with a FIXME, and
WTSUnRegisterSessionNotification failed.  As on Windows, a window is
registered for its own session or for all of them, and a NULL window or
other flags fail with ERROR_INVALID_PARAMETER; unregistering succeeds.
Nothing is told the window later: Wine does not see the session it runs
in lock or unlock, connect or disconnect.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 1cc1ffa8300ccffccc03fd4b3c063adf375c0ed4)

diff --git a/dlls/wtsapi32/tests/Makefile.in b/dlls/wtsapi32/tests/Makefile.in
index a727a41157b..1035d80e90d 100644
--- a/dlls/wtsapi32/tests/Makefile.in
+++ b/dlls/wtsapi32/tests/Makefile.in
@@ -1,5 +1,5 @@
 TESTDLL   = wtsapi32.dll
-IMPORTS   = wtsapi32 advapi32 psapi
+IMPORTS   = wtsapi32 advapi32 psapi user32
 
 SOURCES = \
 	wtsapi.c
diff --git a/dlls/wtsapi32/tests/wtsapi.c b/dlls/wtsapi32/tests/wtsapi.c
index 66d8d01669c..b517db8e2cc 100644
--- a/dlls/wtsapi32/tests/wtsapi.c
+++ b/dlls/wtsapi32/tests/wtsapi.c
@@ -436,6 +436,36 @@ static void test_WTSEnumerateSessions(void)
     WTSFreeMemory(infoA);
 }
 
+static void test_WTSRegisterSessionNotification(void)
+{
+    HWND hwnd;
+    BOOL ret;
+
+    hwnd = CreateWindowA("static", NULL, WS_POPUP, 0, 0, 10, 10, NULL, NULL, NULL, NULL);
+
+    SetLastError(0xdeadbeef);
+    ret = WTSRegisterSessionNotification(hwnd, NOTIFY_FOR_THIS_SESSION);
+    ok(ret, "WTSRegisterSessionNotification failed, error %lu\n", GetLastError());
+    ret = WTSUnRegisterSessionNotification(hwnd);
+    ok(ret, "WTSUnRegisterSessionNotification failed, error %lu\n", GetLastError());
+
+    ret = WTSRegisterSessionNotificationEx(WTS_CURRENT_SERVER_HANDLE, hwnd, NOTIFY_FOR_THIS_SESSION);
+    ok(ret, "WTSRegisterSessionNotificationEx failed, error %lu\n", GetLastError());
+    ret = WTSUnRegisterSessionNotificationEx(WTS_CURRENT_SERVER_HANDLE, hwnd);
+    ok(ret, "WTSUnRegisterSessionNotificationEx failed, error %lu\n", GetLastError());
+
+    SetLastError(0xdeadbeef);
+    ret = WTSRegisterSessionNotification(hwnd, 7);
+    ok(!ret, "WTSRegisterSessionNotification succeeded\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = WTSRegisterSessionNotification(NULL, NOTIFY_FOR_THIS_SESSION);
+    ok(!ret, "WTSRegisterSessionNotification succeeded\n");
+    ok(GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError());
+
+    DestroyWindow(hwnd);
+}
+
 START_TEST (wtsapi)
 {
     pWTSEnumerateProcessesExW = (void *)GetProcAddress(GetModuleHandleA("wtsapi32"), "WTSEnumerateProcessesExW");
@@ -445,4 +475,5 @@ START_TEST (wtsapi)
     test_WTSQuerySessionInformation();
     test_WTSQueryUserToken();
     test_WTSEnumerateSessions();
+    test_WTSRegisterSessionNotification();
 }
diff --git a/dlls/wtsapi32/wtsapi32.c b/dlls/wtsapi32/wtsapi32.c
index 5a7e799a110..79450c7579b 100644
--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -683,8 +683,8 @@ BOOL WINAPI WTSQueryUserConfigW(LPWSTR pServerName, LPWSTR pUserName, WTS_CONFIG
  */
 BOOL WINAPI WTSRegisterSessionNotification(HWND hWnd, DWORD dwFlags)
 {
-    FIXME("Stub %p 0x%08lx\n", hWnd, dwFlags);
-    return TRUE;
+    TRACE("%p 0x%08lx\n", hWnd, dwFlags);
+    return WTSRegisterSessionNotificationEx(WTS_CURRENT_SERVER_HANDLE, hWnd, dwFlags);
 }
 
 /************************************************************
@@ -692,7 +692,15 @@ BOOL WINAPI WTSRegisterSessionNotification(HWND hWnd, DWORD dwFlags)
  */
 BOOL WINAPI WTSRegisterSessionNotificationEx(HANDLE hServer, HWND hWnd, DWORD dwFlags)
 {
-    FIXME("Stub %p %p 0x%08lx\n", hServer, hWnd, dwFlags);
+    TRACE("%p %p 0x%08lx\n", hServer, hWnd, dwFlags);
+
+    /* A window, for this session or for all of them, as on Windows.  Nothing is told it later: Wine does not see
+     * the session it runs in lock or unlock, connect or disconnect. */
+    if (!hWnd || (dwFlags != NOTIFY_FOR_THIS_SESSION && dwFlags != NOTIFY_FOR_ALL_SESSIONS))
+    {
+        SetLastError(ERROR_INVALID_PARAMETER);
+        return FALSE;
+    }
     return TRUE;
 }
 
@@ -785,8 +793,8 @@ BOOL WINAPI WTSTerminateProcess(HANDLE hServer, DWORD ProcessId, DWORD ExitCode)
  */
 BOOL WINAPI WTSUnRegisterSessionNotification(HWND hWnd)
 {
-    FIXME("Stub %p\n", hWnd);
-    return FALSE;
+    TRACE("%p\n", hWnd);
+    return WTSUnRegisterSessionNotificationEx(WTS_CURRENT_SERVER_HANDLE, hWnd);
 }
 
 /************************************************************
@@ -794,8 +802,8 @@ BOOL WINAPI WTSUnRegisterSessionNotification(HWND hWnd)
  */
 BOOL WINAPI WTSUnRegisterSessionNotificationEx(HANDLE hServer, HWND hWnd)
 {
-    FIXME("Stub %p %p\n", hServer, hWnd);
-    return FALSE;
+    TRACE("%p %p\n", hServer, hWnd);
+    return TRUE;
 }
 
 
