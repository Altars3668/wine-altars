From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 26 Sep 2026 13:18:39 -0400
Subject: [PATCH] ntdll: implement classic ETW ANSI provider registration

Co-Authored-By: Claude Code <noreply@anthropic.com>
(cherry picked from commit 2b06b12aa0e09be622fa898a6a0cbd5258dd6f74)

diff --git a/dlls/advapi32/tests/eventlog.c b/dlls/advapi32/tests/eventlog.c
index caba718bead..a241a38a677 100644
--- a/dlls/advapi32/tests/eventlog.c
+++ b/dlls/advapi32/tests/eventlog.c
@@ -1253,6 +1253,7 @@ static void test_event_provider(void)
     BYTE traits[64];
     BOOLEAN value;
     ULONG ret;
+    DWORD error;
 
     /* no session listens here: registrations, and events that go nowhere */
     ret = EventRegister(&provider, enable_callback, NULL, &handle);
@@ -1332,6 +1333,61 @@ static void test_event_provider(void)
     ok(!ret, "got %lu\n", ret);
     ret = UnregisterTraceGuids(trace_handle);
     ok(!ret, "got %lu\n", ret);
+
+    SetLastError(0xdeadbeef);
+    ret = RegisterTraceGuidsW(NULL, NULL, &provider, 2, classes, NULL, NULL, &trace_handle);
+    error = GetLastError();
+    ok(ret == ERROR_INVALID_PARAMETER && error == ERROR_INVALID_PARAMETER,
+       "got %lu, error %lu\n", ret, error);
+
+    trace_handle = 0xdead;
+    classes[0].RegHandle = classes[1].RegHandle = (HANDLE)0xdead;
+    SetLastError(0xdeadbeef);
+    ret = RegisterTraceGuidsA(trace_control_callback, NULL, &provider, 2, classes, NULL, NULL, &trace_handle);
+    error = GetLastError();
+    ok(!ret && trace_handle && trace_handle != 0xdead, "got %lu, handle %#I64x\n", ret, trace_handle);
+    ok(error == 0xdeadbeef, "got error %lu\n", error);
+    ok(classes[0].RegHandle && classes[0].RegHandle != (HANDLE)0xdead &&
+       classes[1].RegHandle && classes[1].RegHandle != (HANDLE)0xdead,
+       "got %p %p\n", classes[0].RegHandle, classes[1].RegHandle);
+    if (!ret && trace_handle && trace_handle != 0xdead)
+    {
+        ret = UnregisterTraceGuids(trace_handle);
+        ok(!ret, "got %lu\n", ret);
+    }
+
+    trace_handle = 0xdead;
+    SetLastError(0xdeadbeef);
+    ret = RegisterTraceGuidsA(trace_control_callback, NULL, &provider, 0, NULL,
+                              "nonexistent-etw-mof.dll", "1", &trace_handle);
+    error = GetLastError();
+    ok(!ret && trace_handle && trace_handle != 0xdead, "got %lu, handle %#I64x\n", ret, trace_handle);
+    ok(error == 0xdeadbeef, "got error %lu\n", error);
+    if (!ret && trace_handle && trace_handle != 0xdead)
+    {
+        ret = UnregisterTraceGuids(trace_handle);
+        ok(!ret, "got %lu\n", ret);
+    }
+
+    trace_handle = 0xdead;
+    classes[0].RegHandle = (HANDLE)0xdead;
+    SetLastError(0xdeadbeef);
+    ret = RegisterTraceGuidsA(NULL, NULL, &provider, 2, classes, NULL, NULL, &trace_handle);
+    error = GetLastError();
+    ok(ret == ERROR_INVALID_PARAMETER && error == ERROR_INVALID_PARAMETER &&
+       trace_handle == 0xdead && classes[0].RegHandle == (HANDLE)0xdead,
+       "got %lu, error %lu, handle %#I64x, class %p\n", ret, error, trace_handle, classes[0].RegHandle);
+    SetLastError(0xdeadbeef);
+    ret = RegisterTraceGuidsA(trace_control_callback, NULL, NULL, 2, classes, NULL, NULL, &trace_handle);
+    error = GetLastError();
+    ok(ret == ERROR_INVALID_PARAMETER && error == ERROR_INVALID_PARAMETER && trace_handle == 0xdead,
+       "got %lu, error %lu, handle %#I64x\n", ret, error, trace_handle);
+    SetLastError(0xdeadbeef);
+    ret = RegisterTraceGuidsA(trace_control_callback, NULL, &provider, 2, classes, NULL, NULL, NULL);
+    error = GetLastError();
+    ok(ret == ERROR_INVALID_PARAMETER && error == ERROR_INVALID_PARAMETER &&
+       classes[0].RegHandle == (HANDLE)0xdead, "got %lu, error %lu, class %p\n",
+       ret, error, classes[0].RegHandle);
 }
 
 static void test_start_trace(void)
diff --git a/dlls/ntdll/misc.c b/dlls/ntdll/misc.c
index bf5b6521c77..8b03c826ce0 100644
--- a/dlls/ntdll/misc.c
+++ b/dlls/ntdll/misc.c
@@ -685,8 +685,8 @@ ULONG WINAPI EtwEventWriteTransfer( REGHANDLE handle, PCEVENT_DESCRIPTOR descrip
  *  ControlGuid        [I]   GUID of the registering provider
  *  GuidCount          [I]   Number of elements in the TraceGuidReg array
  *  TraceGuidReg       [I/O] Array of TRACE_GUID_REGISTRATION structures
- *  MofImagePath       [I]   not supported, set to NULL
- *  MofResourceName    [I]   not supported, set to NULL
+ *  MofImagePath       [I]   Optional MOF DLL path (not loaded)
+ *  MofResourceName    [I]   Optional MOF resource name (not loaded)
  *  RegistrationHandle [O]   Provider's registration handle
  *
  * RETURNS
@@ -704,8 +704,16 @@ ULONG WINAPI EtwRegisterTraceGuidsW( WMIDPREQUEST RequestAddress,
           debugstr_guid(ControlGuid), GuidCount, TraceGuidReg, debugstr_w(MofImagePath),
           debugstr_w(MofResourceName), RegistrationHandle);
 
-    if (!RequestAddress || !ControlGuid || !RegistrationHandle) return ERROR_INVALID_PARAMETER;
-    if (!(*RegistrationHandle = add_etw_registration( ControlGuid, TRUE ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if (!RequestAddress || !ControlGuid || !RegistrationHandle)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return ERROR_INVALID_PARAMETER;
+    }
+    if (!(*RegistrationHandle = add_etw_registration( ControlGuid, TRUE )))
+    {
+        RtlSetLastWin32Error( ERROR_NOT_ENOUGH_MEMORY );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
 
     /* the classes are traced under the provider's registration */
     for (i = 0; i < GuidCount; i++)
@@ -724,10 +732,35 @@ ULONG WINAPI EtwRegisterTraceGuidsA( WMIDPREQUEST RequestAddress,
                 TRACE_GUID_REGISTRATION *TraceGuidReg, const char *MofImagePath,
                 const char *MofResourceName, TRACEHANDLE *RegistrationHandle )
 {
-    WARN("(%p, %p, %s, %lu, %p, %s, %s, %p): stub\n", RequestAddress, RequestContext,
+    UNICODE_STRING image = {0}, resource = {0};
+    ULONG ret;
+
+    TRACE("(%p, %p, %s, %lu, %p, %s, %s, %p)\n", RequestAddress, RequestContext,
           debugstr_guid(ControlGuid), GuidCount, TraceGuidReg, debugstr_a(MofImagePath),
           debugstr_a(MofResourceName), RegistrationHandle);
-    return ERROR_SUCCESS;
+
+    if (!RequestAddress || !ControlGuid || !RegistrationHandle)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return ERROR_INVALID_PARAMETER;
+    }
+    if (MofImagePath && !RtlCreateUnicodeStringFromAsciiz( &image, MofImagePath ))
+    {
+        RtlSetLastWin32Error( ERROR_NOT_ENOUGH_MEMORY );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    if (MofResourceName && !RtlCreateUnicodeStringFromAsciiz( &resource, MofResourceName ))
+    {
+        RtlFreeUnicodeString( &image );
+        RtlSetLastWin32Error( ERROR_NOT_ENOUGH_MEMORY );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+
+    ret = EtwRegisterTraceGuidsW( RequestAddress, RequestContext, ControlGuid, GuidCount,
+                                  TraceGuidReg, image.Buffer, resource.Buffer, RegistrationHandle );
+    RtlFreeUnicodeString( &image );
+    RtlFreeUnicodeString( &resource );
+    return ret;
 }
 
 /******************************************************************************
