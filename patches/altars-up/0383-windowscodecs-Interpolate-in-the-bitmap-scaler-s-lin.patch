index b73c0bc740c..2b14efb0c9b 100644
--- a/dlls/windowscodecs/tests/bitmap.c
+++ b/dlls/windowscodecs/tests/bitmap.c
@@ -1318,6 +1318,84 @@ static void test_bitmap_scaler(void)
     IWICBitmap_Release(bitmap);
 }
 
+static void test_bitmap_scaler_modes(void)
+{
+    static const WICBitmapInterpolationMode modes[] =
+    {
+        WICBitmapInterpolationModeLinear,
+        WICBitmapInterpolationModeCubic,
+        WICBitmapInterpolationModeFant,
+        WICBitmapInterpolationModeHighQualityCubic,
+    };
+    static const BYTE step[] = {0, 255};
+    static const BYTE checker[] =
+    {
+        0, 255, 0, 255,
+        255, 0, 255, 0,
+        0, 255, 0, 255,
+        255, 0, 255, 0,
+    };
+    BYTE flat[6 * 5], out[12 * 12];
+    IWICBitmapScaler *scaler;
+    IWICBitmap *bitmap;
+    unsigned int i, j;
+    HRESULT hr;
+
+    memset(flat, 77, sizeof(flat));
+    for (i = 0; i < ARRAY_SIZE(modes); i++)
+    {
+        winetest_push_context("mode %u", modes[i]);
+
+        /* an even colour stays even, enlarged or reduced */
+        hr = IWICImagingFactory_CreateBitmapFromMemory(factory, 6, 5, &GUID_WICPixelFormat8bppGray, 6,
+                sizeof(flat), flat, &bitmap);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IWICImagingFactory_CreateBitmapScaler(factory, &scaler);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IWICBitmapScaler_Initialize(scaler, (IWICBitmapSource *)bitmap, 11, 2, modes[i]);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        memset(out, 0xcd, sizeof(out));
+        hr = IWICBitmapScaler_CopyPixels(scaler, NULL, 11, 11 * 2, out);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        for (j = 0; j < 11 * 2; j++)
+            ok(out[j] == 77, "Unexpected pixel %u: %u.\n", j, out[j]);
+        IWICBitmapScaler_Release(scaler);
+        IWICBitmap_Release(bitmap);
+
+        /* an edge enlarged gets values in between */
+        hr = IWICImagingFactory_CreateBitmapFromMemory(factory, 2, 1, &GUID_WICPixelFormat8bppGray, 2,
+                sizeof(step), (BYTE *)step, &bitmap);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IWICImagingFactory_CreateBitmapScaler(factory, &scaler);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IWICBitmapScaler_Initialize(scaler, (IWICBitmapSource *)bitmap, 3, 1, modes[i]);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IWICBitmapScaler_CopyPixels(scaler, NULL, 3, 3, out);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(out[1] > 32 && out[1] < 224, "Unexpected middle pixel %u.\n", out[1]);
+        ok(out[0] <= out[1] && out[1] <= out[2], "Unexpected pixels %u %u %u.\n", out[0], out[1], out[2]);
+        IWICBitmapScaler_Release(scaler);
+        IWICBitmap_Release(bitmap);
+
+        /* a checkerboard halved is grey, not one of its colours */
+        hr = IWICImagingFactory_CreateBitmapFromMemory(factory, 4, 4, &GUID_WICPixelFormat8bppGray, 4,
+                sizeof(checker), (BYTE *)checker, &bitmap);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IWICImagingFactory_CreateBitmapScaler(factory, &scaler);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IWICBitmapScaler_Initialize(scaler, (IWICBitmapSource *)bitmap, 2, 2, modes[i]);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IWICBitmapScaler_CopyPixels(scaler, NULL, 2, 4, out);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        for (j = 0; j < 4; j++)
+            ok(out[j] > 64 && out[j] < 192, "Unexpected pixel %u: %u.\n", j, out[j]);
+        IWICBitmapScaler_Release(scaler);
+        IWICBitmap_Release(bitmap);
+
+        winetest_pop_context();
+    }
+}
