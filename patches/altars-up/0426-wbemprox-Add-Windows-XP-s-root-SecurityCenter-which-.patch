+    { L"companyName",                  CIM_STRING },
+    { L"displayName",                  CIM_STRING },
+    { L"instanceGuid",                 CIM_STRING|COL_FLAG_KEY },
+    { L"onAccessScanningEnabled",      CIM_BOOLEAN },
+    { L"pathToSignedProductExe",       CIM_STRING },
+    { L"productHasNotifiedUser",       CIM_BOOLEAN },
+    { L"productState",                 CIM_UINT8 },
+    { L"productUptoDate",              CIM_BOOLEAN },
+    { L"productWantsWscNotifications", CIM_BOOLEAN },
+    { L"versionNumber",                CIM_STRING },
+};
+static const struct column col_legacy_firewallproduct[] =
+{
+    { L"companyName",                  CIM_STRING },
+    { L"displayName",                  CIM_STRING },
+    { L"enabled",                      CIM_BOOLEAN },
+    { L"instanceGuid",                 CIM_STRING|COL_FLAG_KEY },
+    { L"pathToSignedProductExe",       CIM_STRING },
+    { L"productHasNotifiedUser",       CIM_BOOLEAN },
+    { L"productState",                 CIM_UINT8 },
+    { L"productWantsWscNotifications", CIM_BOOLEAN },
+    { L"versionNumber",                CIM_STRING },
+};
 static const struct column col_securityproduct[] =
 {
     { L"displayName",              CIM_STRING|COL_FLAG_DYNAMIC },
@@ -5219,6 +5258,13 @@ static enum fill_status fill_firewallproduct( struct table *table, const struct
     return fill_securityproduct( table, cond, WSC_SECURITY_PROVIDER_FIREWALL );
 }
 
+static struct table securitycenter_builtin_classes[] =
+{
+    { L"AntiSpywareProduct", C(col_legacy_antispywareproduct) },
+    { L"AntiVirusProduct", C(col_legacy_antivirusproduct) },
