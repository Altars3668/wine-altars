+
 static struct table securitycenter2_builtin_classes[] =
 {
     { L"AntiSpywareProduct", C(col_securityproduct), 0, 0, NULL, fill_antispywareproduct },
@@ -5239,6 +5285,7 @@ builtin_namespaces[WBEMPROX_NAMESPACE_LAST] =
 {
     {L"cimv2", cimv2_builtin_classes, ARRAY_SIZE(cimv2_builtin_classes)},
     {L"Microsoft\\Windows\\Storage", win_storage_builtin_classes, ARRAY_SIZE(win_storage_builtin_classes)},
+    {L"SecurityCenter", securitycenter_builtin_classes, ARRAY_SIZE(securitycenter_builtin_classes)},
     {L"SecurityCenter2", securitycenter2_builtin_classes, ARRAY_SIZE(securitycenter2_builtin_classes)},
     {L"StandardCimv2", NULL, 0},
     {L"wmi", wmi_builtin_classes, ARRAY_SIZE(wmi_builtin_classes)},
diff --git a/dlls/wbemprox/tests/query.c b/dlls/wbemprox/tests/query.c
index 4410bc12450..5e369196b49 100644
--- a/dlls/wbemprox/tests/query.c
+++ b/dlls/wbemprox/tests/query.c
@@ -2819,6 +2819,46 @@ done:
     if (list) IWSCProductList_Release( list );
 }
 
+/* Windows XP's namespace, still there on Windows 11, with the classes and no instances */
+static void test_SecurityCenter( IWbemLocator *locator )
+{
+    static const WCHAR *classes[] = { L"AntiSpywareProduct", L"AntiVirusProduct", L"FirewallProduct" };
+    BSTR path = SysAllocString( L"ROOT\\SecurityCenter" ), wql = SysAllocString( L"wql" ), query;
+    IEnumWbemClassObject *result;
+    IWbemServices *services;
+    IWbemClassObject *obj;
+    unsigned int i;
+    WCHAR buf[64];
+    HRESULT hr;
+    ULONG n;
+
+    hr = IWbemLocator_ConnectServer( locator, path, NULL, NULL, NULL, 0, NULL, NULL, &services );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( path );
+    if (hr != S_OK)
+    {
+        SysFreeString( wql );
+        return;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(classes); i++)
+    {
+        swprintf( buf, ARRAY_SIZE(buf), L"SELECT * FROM %s", classes[i] );
+        query = SysAllocString( buf );
+        hr = IWbemServices_ExecQuery( services, wql, query, 0, NULL, &result );
+        ok( hr == S_OK, "%s: got %#lx\n", debugstr_w(classes[i]), hr );
+        SysFreeString( query );
+        if (hr != S_OK) continue;
+        hr = IEnumWbemClassObject_Next( result, 10000, 1, &obj, &n );
+        ok( hr == WBEM_S_FALSE, "%s: got %#lx\n", debugstr_w(classes[i]), hr );
+        if (hr == S_OK) IWbemClassObject_Release( obj );
+        IEnumWbemClassObject_Release( result );
+    }
+
+    IWbemServices_Release( services );
+    SysFreeString( wql );
+}
+
 static void test_SecurityCenter2( IWbemLocator *locator )
 {
     BSTR path = SysAllocString( L"ROOT\\SecurityCenter2" );
@@ -2925,6 +2965,7 @@ START_TEST(query)
     test_empty_namespace( locator );
     test_MSSMBios_RawSMBiosTables( locator );
     test_MSFT_PhysicalDisk( locator );
+    test_SecurityCenter( locator );
     test_SecurityCenter2( locator );
 
     SysFreeString( path );
