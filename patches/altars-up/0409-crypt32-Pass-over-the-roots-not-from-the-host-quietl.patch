From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 10:15:58 -0400
Subject: [PATCH] crypt32: Pass over the roots not from the host quietly when
 checking new ones.

Only those imported from the host carry the mark, not the Microsoft roots added to the store here
nor one a program stored: that is no error, and every process logged one for each of them whenever the
host had a root that does not verify, which is then new again each time.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/crypt32/rootstore.c b/dlls/crypt32/rootstore.c
index d9d9f51c8a3..0e492a02dda 100644
--- a/dlls/crypt32/rootstore.c
+++ b/dlls/crypt32/rootstore.c
@@ -139,13 +139,9 @@ static void check_and_store_certs( HCERTSTORE cached, HKEY key, HKEY import_key
         int is_new;
         BOOL ret;
 
+        /* only those from the host have it: not the Microsoft roots added here, nor one stored by a program */
         size = sizeof(is_new);
-        if (!CertGetCertificateContextProperty( cert, CERT_FIRST_USER_PROP_ID, &is_new, &size ))
-        {
-            ERR( "CERT_FIRST_USER_PROP_ID property absent for cert %p.\n", cert );
-            continue;
-        }
-        if (!is_new)
+        if (!CertGetCertificateContextProperty( cert, CERT_FIRST_USER_PROP_ID, &is_new, &size ) || !is_new)
             continue;
 
         ret = CertGetCertificateChain( engine, cert, NULL, NULL, &chainPara, CERT_CHAIN_CACHE_ONLY_URL_RETRIEVAL, NULL, &chain );
