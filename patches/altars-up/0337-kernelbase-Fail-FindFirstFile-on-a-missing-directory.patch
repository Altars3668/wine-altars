From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 02:30:47 -0400
Subject: [PATCH] kernelbase: Fail FindFirstFile on a missing directory with
 ERROR_PATH_NOT_FOUND.

A name ending in a backslash gives nothing to search for, and Wine
answered ERROR_FILE_NOT_FOUND whatever came before it.  Windows fails
with ERROR_PATH_NOT_FOUND when that directory is not there, as the test
expects, so the directory is opened first and the failure is told as
the search itself would tell it.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index d72135f471a..79310f4e72d 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -2983,9 +2983,7 @@ static void test_FindFirstFileA(void)
     handle = FindFirstFileA(buffer2, &data);
     err = GetLastError();
     ok ( handle == INVALID_HANDLE_VALUE, "FindFirstFile on %s should fail\n", buffer2 );
-    todo_wine {
-        ok ( err == ERROR_PATH_NOT_FOUND, "Bad Error number %d\n", err );
-    }
+    ok ( err == ERROR_PATH_NOT_FOUND, "Bad Error number %d\n", err );
 
     /* try FindFirstFileA without trailing backslash */
     SetLastError( 0xdeadbeaf );
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 01f88147e4f..7623a35ad73 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -1518,7 +1518,20 @@ HANDLE WINAPI DECLSPEC_HOTPATCH FindFirstFileExW( LPCWSTR filename, FINDEX_INFO_
     }
     else if (!mask || !*mask)
     {
-        SetLastError( ERROR_FILE_NOT_FOUND );
+        HANDLE dir_handle;
+
+        /* nothing to look for, which is only the answer when the directory is there */
+        InitializeObjectAttributes( &attr, &nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+        status = NtOpenFile( &dir_handle, FILE_LIST_DIRECTORY | SYNCHRONIZE, &attr, &io,
+                             FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                             FILE_DIRECTORY_FILE | FILE_SYNCHRONOUS_IO_NONALERT | FILE_OPEN_FOR_BACKUP_INTENT );
+        if (!status)
+        {
+            NtClose( dir_handle );
+            SetLastError( ERROR_FILE_NOT_FOUND );
+        }
+        else if (status == STATUS_OBJECT_NAME_NOT_FOUND) SetLastError( ERROR_PATH_NOT_FOUND );
+        else SetLastError( RtlNtStatusToDosError( status ));
         goto error;
     }
     else
