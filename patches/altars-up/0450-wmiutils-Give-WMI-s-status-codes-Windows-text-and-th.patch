diff --git a/dlls/wmiutils/statuscode.c b/dlls/wmiutils/statuscode.c
index 2222d9bb6cb..0ec8bbeab60 100644
--- a/dlls/wmiutils/statuscode.c
+++ b/dlls/wmiutils/statuscode.c
@@ -85,6 +85,33 @@ static HRESULT WINAPI status_code_QueryInterface(
     return S_OK;
 }
 
+static HMODULE wmiutils_module( void )
+{
+    HMODULE module = NULL;
+
+    GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS | GET_MODULE_HANDLE_EX_FLAG_UNCHANGED_REFCOUNT,
+                        (const WCHAR *)wmiutils_module, &module );
+    return module;
+}
+
+/* WMI's own message for the code, or the system's (for a Win32 error, its code's); none is a failure */
+static WCHAR *format_status( HRESULT res, DWORD flags )
+{
+    WCHAR *msg = NULL;
+
+    flags |= FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_IGNORE_INSERTS;
+    if (FormatMessageW( flags | FORMAT_MESSAGE_FROM_HMODULE, wmiutils_module(), res, 0, (WCHAR *)&msg, 0, NULL ))
+        return msg;
+    if (HRESULT_FACILITY( res ) == FACILITY_WIN32) res = HRESULT_CODE( res );
+    if (FormatMessageW( flags | FORMAT_MESSAGE_FROM_SYSTEM, NULL, res, 0, (WCHAR *)&msg, 0, NULL ))
+        return msg;
+    return NULL;
+}
+
+/*
+ * In the user's language only, any other is an invalid parameter; WBEMSTATUS_FORMAT_NO_NEWLINE makes the line
+ * break a space (Windows 11, tools/winmgmtsprobe, statustext.c).
+ */
 static HRESULT WINAPI status_code_GetErrorCodeText(
     IWbemStatusCodeText *iface,
     HRESULT res,
@@ -92,15 +119,20 @@ static HRESULT WINAPI status_code_GetErrorCodeText(
     LONG flags,
     BSTR *text )
 {
-    WCHAR msg[32];
+    WCHAR *msg;
 
-    FIXME("%p, %#lx, %#lx, %#lx, %p\n", iface, res, lcid, flags, text);
+    TRACE("%p, %#lx, %#lx, %#lx, %p\n", iface, res, lcid, flags, text);
 
-    swprintf(msg, ARRAY_SIZE(msg), L"Error code: 0x%08x", res);
-    *text = SysAllocString(msg);
-    return WBEM_S_NO_ERROR;
+    if (lcid || !text) return WBEM_E_INVALID_PARAMETER;
+    *text = NULL;
+    if (!(msg = format_status( res, flags & WBEMSTATUS_FORMAT_NO_NEWLINE ? FORMAT_MESSAGE_MAX_WIDTH_MASK : 0 )))
+        return WBEM_E_FAILED;
+    *text = SysAllocString( msg );
+    LocalFree( msg );
+    return *text ? WBEM_S_NO_ERROR : WBEM_E_OUT_OF_MEMORY;
 }
 
+/* the facility's name, WMI for a code WMI has a message for */
 static HRESULT WINAPI status_code_GetFacilityCodeText(
     IWbemStatusCodeText *iface,
     HRESULT res,
@@ -108,13 +140,37 @@ static HRESULT WINAPI status_code_GetFacilityCodeText(
     LONG flags,
     BSTR *text )
 {
-    WCHAR msg[32];
+    const WCHAR *name;
+    WCHAR *msg;
 
-    FIXME("%p, %#lx, %#lx, %#lx, %p\n", iface, res, lcid, flags, text);
+    TRACE("%p, %#lx, %#lx, %#lx, %p\n", iface, res, lcid, flags, text);
 
-    swprintf(msg, ARRAY_SIZE(msg), L"Facility code: 0x%08x", res);
-    *text = SysAllocString(msg);
-    return WBEM_S_NO_ERROR;
+    if (!text) return WBEM_E_INVALID_PARAMETER;
+    switch (HRESULT_FACILITY( res ))
+    {
+    case FACILITY_NULL:     name = L"<Null>"; break;
+    case FACILITY_RPC:      name = L"RPC"; break;
+    case FACILITY_DISPATCH: name = L"Dispatch"; break;
+    case FACILITY_STORAGE:  name = L"Storage"; break;
+    case FACILITY_WIN32:    name = L"Win32"; break;
+    case FACILITY_WINDOWS:  name = L"Windows"; break;
+    case FACILITY_SSPI:     name = L"SSPI"; break;
+    case FACILITY_CONTROL:  name = L"Control"; break;
+    case FACILITY_CERT:     name = L"Cert"; break;
+    case FACILITY_INTERNET: name = L"Internet"; break;
+    case FACILITY_ITF:
+        name = L"Interface";
+        if (FormatMessageW( FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_IGNORE_INSERTS |
+                            FORMAT_MESSAGE_FROM_HMODULE, wmiutils_module(), res, 0, (WCHAR *)&msg, 0, NULL ))
+        {
+            name = L"WMI";
+            LocalFree( msg );
+        }
+        break;
+    default:                name = L"General"; break;
+    }
+    *text = SysAllocString( name );
+    return *text ? WBEM_S_NO_ERROR : WBEM_E_OUT_OF_MEMORY;
 }
 
 static const struct IWbemStatusCodeTextVtbl status_code_vtbl =
diff --git a/dlls/wmiutils/tests/path.c b/dlls/wmiutils/tests/path.c
index 1d80f37c9b4..e90f5b96569 100644
--- a/dlls/wmiutils/tests/path.c
+++ b/dlls/wmiutils/tests/path.c
@@ -1238,6 +1238,73 @@ static void test_IWbemPathKeyList_SetKey(void)
     IWbemPath_Release( path );
 }
 
+/* WMI's text for its codes, the system's for others; WBEMSTATUS_FORMAT_NO_NEWLINE makes the line break a space; the
+ * facility by its name (Windows 11, tools/winmgmtsprobe, statustext.c) */
+static void test_IWbemStatusCodeText(void)
+{
+    static const struct
+    {
+        HRESULT code;
+        const WCHAR *facility;
+    }
+    facilities[] =
+    {
+        { WBEM_E_NOT_FOUND, L"WMI" }, { WBEM_S_NO_MORE_DATA, L"WMI" }, { 0x80041fff, L"Interface" },
+        { E_ACCESSDENIED, L"Win32" }, { RPC_E_SERVERFAULT, L"RPC" }, { DISP_E_EXCEPTION, L"Dispatch" },
+        { STG_E_FILENOTFOUND, L"Storage" }, { CO_E_SERVER_EXEC_FAILURE, L"Windows" }, { 0x80090308, L"SSPI" },
+        { 0x800a01a8, L"Control" }, { 0x800b0109, L"Cert" }, { 0x800c0005, L"Internet" }, { E_FAIL, L"<Null>" },
+        { S_OK, L"<Null>" }, { 0x12345678, L"General" },
+    };
+    IWbemStatusCodeText *text;
+    unsigned int i, len;
+    HRESULT hr;
+    BSTR str;
+
+    hr = CoCreateInstance( &CLSID_WbemStatusCodeText, NULL, CLSCTX_INPROC_SERVER, &IID_IWbemStatusCodeText,
+                           (void **)&text );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    if (hr != S_OK) return;
+
+    str = NULL;
+    hr = IWbemStatusCodeText_GetErrorCodeText( text, WBEM_E_NOT_FOUND, 0, 0, &str );
+    ok( hr == S_OK && str, "got %#lx, %p\n", hr, str );
+    len = SysStringLen( str );
+    ok( len > 2 && str[len - 2] == '\r' && str[len - 1] == '\n', "got %s\n", wine_dbgstr_w(str) );
+    if (PRIMARYLANGID( GetUserDefaultUILanguage() ) == LANG_ENGLISH)
+        ok( !wcscmp( str, L"Not found\r\n" ), "got %s\n", wine_dbgstr_w(str) );
+    SysFreeString( str );
+
+    str = NULL;
+    hr = IWbemStatusCodeText_GetErrorCodeText( text, WBEM_E_NOT_FOUND, 0, WBEMSTATUS_FORMAT_NO_NEWLINE, &str );
+    ok( hr == S_OK && str, "got %#lx, %p\n", hr, str );
+    ok( SysStringLen( str ) == len - 1 && str[len - 2] == ' ', "got %s\n", wine_dbgstr_w(str) );
+    SysFreeString( str );
+
+    str = (BSTR)0xdeadbeef;
+    hr = IWbemStatusCodeText_GetErrorCodeText( text, WBEM_E_NOT_FOUND, MAKELCID( 0x409, SORT_DEFAULT ), 0, &str );
+    ok( hr == WBEM_E_INVALID_PARAMETER, "got %#lx\n", hr );
+
+    str = (BSTR)0xdeadbeef;
+    hr = IWbemStatusCodeText_GetErrorCodeText( text, 0x80041fff, 0, 0, &str );
+    ok( hr == WBEM_E_FAILED && !str, "got %#lx, %p\n", hr, str );
+
+    str = NULL;
+    hr = IWbemStatusCodeText_GetErrorCodeText( text, E_ACCESSDENIED, 0, 0, &str );
+    ok( hr == S_OK && str && str[0], "got %#lx, %s\n", hr, wine_dbgstr_w(str) );
+    SysFreeString( str );
+
+    for (i = 0; i < ARRAY_SIZE(facilities); i++)
+    {
+        str = NULL;
+        hr = IWbemStatusCodeText_GetFacilityCodeText( text, facilities[i].code, 0, 0, &str );
+        ok( hr == S_OK, "%#lx: got %#lx\n", facilities[i].code, hr );
+        ok( !wcscmp( str, facilities[i].facility ), "%#lx: got %s\n", facilities[i].code, wine_dbgstr_w(str) );
+        SysFreeString( str );
+    }
+
+    IWbemStatusCodeText_Release( text );
+}
+
 START_TEST (path)
 {
     CoInitialize( NULL );
@@ -1256,6 +1323,7 @@ START_TEST (path)
     test_IWbemPath_marshal();
     test_IWbemPathKeyList_GetKey();
     test_IWbemPathKeyList_SetKey();
+    test_IWbemStatusCodeText();
 
     CoUninitialize();
 }
