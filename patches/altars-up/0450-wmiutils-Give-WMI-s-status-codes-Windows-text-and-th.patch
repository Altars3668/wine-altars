+msgstr "需要为此操作加密客户端与 WINMGMT 的连接。请调整 IWbemServices 代理安全设置，然后重试。\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "A provider failed to report results within the specified timeout.\n"
+msgstr "提供程序无法在指定的超时期限内报告结果。\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Attempt to put an instance with no defined key.\n"
+msgstr "尝试放置一个没有已定义键的实例。\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Provider registration overlaps with system event domain\n"
+msgstr "提供程序注册与系统事件域重叠\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "'WITHIN' clause must be used in this query due to lack of event providers\n"
+msgstr "由于缺少事件提供程序，必须在此查询中使用 \"WITHIN\" 子句\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "This computer does not have the necessary domain permissions to support the security functions relating to the created subscription instance.  Contact the Domain Administrator to get this computer added to the Windows Authorization Access Group. \n"
+msgstr "此计算机没有必需的域权限，无法支持与已创建的订阅实例相关的安全功能。请与域管理员联系，以将此计算机添加到 Windows Authorization Access Group 中。\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Retry Later\n"
+msgstr "稍后重试\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Resource Contention\n"
+msgstr "资源争用\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected qualifier name, an identifier\n"
+msgstr "需要限定符名称(一个标识符)\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected semicolon or '='\n"
+msgstr "需要分号或 \"=\"\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected open brace\n"
+msgstr "需要左大括号\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Missing closing brace, or illegal array element\n"
+msgstr "缺少右大括号，或者数组元素非法\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected closing bracket\n"
+msgstr "需要右中括号\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected closing parenthesis\n"
+msgstr "需要右括号\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Illegal constant value. (Numeric value out of range or strings without quotes)\n"
+msgstr "常数值非法。(数值超出范围或字符串未带引号)\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected type identifier\n"
+msgstr "需要类型标识符\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected open parenthesis\n"
+msgstr "需要左括号\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Unexpected token at file scope\n"
+msgstr "在文件范围内存在意外标记\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Unrecognized or unsupported type identifier\n"
+msgstr "类型标识符无法识别或不受支持\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected property or method name\n"
+msgstr "需要属性或方法名称\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Typedefs and enumerated types are not currently supported\n"
+msgstr "当前不支持 Typedef 和枚举类型\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Unexpected alias. Only references to class object can take alias values\n"
+msgstr "意外的别名。只有对类对象的引用可以采用别名值\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Unexpected array initialization. Arrays must be declared with []\n"
+msgstr "意外的数组初始化。数组必须使用 [] 进行声明\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid namespace path syntax\n"
+msgstr "无效的命名空间路径语法\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Duplicate amendment specifiers\n"
+msgstr "修订说明符重复\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "#pragma must be followed by a valid keyword\n"
+msgstr "#pragma 必须后跟有效关键字\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Unexpected character in class name (must be an identifier)\n"
+msgstr "类名(必须是标识符)中存在意外字符\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Type mismatch. The value specified could not be coerced into the appropriate type\n"
+msgstr "类型不匹配。指定的值无法强制转换为相应的类型\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Dollar sign must be followed by an alias name (an identifier)\n"
+msgstr "美元符号必须后跟别名(一个标识符)\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid class declaration\n"
+msgstr "无效的类声明\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid instance declaration. Must start with 'instance of'\n"
+msgstr "无效的实例声明。必须以 \"instance of\" 开头\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected dollar sign. 'as' keyword must be followed by an alias, of the form '$name'\n"
+msgstr "需要美元符号。\"as\" 关键字必须后跟 \"$name\" 形式的别名\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "'CIMTYPE' qualifier may not be specified directly in a MOF file. Use standard type notation\n"
+msgstr "\"CIMTYPE\" 限定符不能在 MOF 文件中直接指定。请使用标准类型符号\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Duplicate property declaration unexpected\n"
+msgstr "意外的重复属性声明\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid namespace syntax. References to other servers are not allowed!\n"
+msgstr "无效的命名空间语法。不允许引用其他服务器!\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "This is not a valid MOF file\n"
+msgstr "这不是有效的 MOF 文件\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Embedded objects may not be aliases\n"
+msgstr "嵌入式对象不能是别名\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "NULL elements in array are not supported\n"
+msgstr "不支持数组中的 NULL 元素\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Duplicate qualifier declaration unexpected\n"
+msgstr "意外的重复限定符声明\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected a flavor type such as ToInstance, ToSubClass, EnableOverride, or DisableOverride\n"
+msgstr "需要 ToInstance、ToSubClass、EnableOverride 或 DisableOverride 等特色信息类型\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Combining Overridable, and NotOverridable is not legal\n"
+msgstr "将 Overridable 和 NotOverridable 结合使用不合法\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Alias cannot be used twice\n"
+msgstr "别名不能使用两次\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Combining \"Restricted\", and \"ToInstance\" or \"ToSubClass\" is not legal\n"
+msgstr "将 \"Restricted\" 和 \"ToInstance\" 或 \"ToSubClass\" 结合使用不合法\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Methods cannot return array values\n"
+msgstr "方法不能返回数组值\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Arguments must have an \"In\" and/or \"Out\" qualifier\n"
+msgstr "参数必须使用 \"In\" 和/或 \"Out\" 限定符\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid flags syntax\n"
+msgstr "无效的标志语法\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Expected brace or bad type\n"
+msgstr "需要大括号，或者类型错误\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "CIM V2.2 feature not currently supported for qualifier value\n"
+msgstr "限定符值当前不支持 CIM V2.2 功能\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "CIM V2.2 feature not currently supported; data type\n"
+msgstr "CIM V2.2 功能当前不受支持；数据类型\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid delete instance syntax, should be #pragma deleteinstance(\"instance path\", FAIL|NOFAIL)\n"
+msgstr "无效的删除范例语法，应为 #pragma deleteinstance(\"instance path\", FAIL|NOFAIL)\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid qualifier syntax.  Should be of the for Qualifier name:type=value,scope(class|instance), flavor(toinstance|etc);\n"
+msgstr "无效的限定符语法。应该是 Qualifier name:type=value,scope(class|instance), flavor(toinstance|etc);\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Qualifier is used outside of its scope\n"
+msgstr "在限定符作用域外使用了限定符\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Error creating temporary file\n"
+msgstr "创建临时文件时出错\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid include file\n"
+msgstr "无效的 include 文件\n"
+
+#: dlls/wmiutils/wmiutils.mc
+msgid "Invalid DeleteClass syntax\n"
+msgstr "无效的 DeleteClass 语法\n"
