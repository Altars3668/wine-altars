From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 08:52:46 -0400
Subject: [PATCH] wintrust: Verify a signature with no time stamp as of when
 WinVerifyTrust was called.

The file's creation time stood in for the time since 2007, so a file
whose certificate has expired passed when it had been created while the
certificate was valid.  Windows 11 verifies a signature with no time
stamp as of the call, whatever the file's creation time, measured with
tools/wintrustprobe on VSTOInstaller.exe with its time stamp cut out and
its creation time set inside the certificate's validity: CERT_E_EXPIRED.
And a certificate checked as of a time the caller gives is checked as of
that time, not of the zero the signer was left with.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wintrust/softpub.c b/dlls/wintrust/softpub.c
index 609d240a738..6d5f62bfc84 100644
--- a/dlls/wintrust/softpub.c
+++ b/dlls/wintrust/softpub.c
@@ -96,9 +96,6 @@ static DWORD SOFTPUB_OpenFile(CRYPT_PROVIDER_DATA *data)
         else
             err = GetLastError();
     }
-    if (!err)
-        GetFileTime(data->pWintrustData->pFile->hFile, &data->sftSystemTime,
-         NULL, NULL);
     TRACE("returning %ld\n", err);
     return err;
 }
@@ -485,7 +482,7 @@ static DWORD SOFTPUB_LoadCertMessage(CRYPT_PROVIDER_DATA *data)
             if (WVT_ISINSTRUCT(WINTRUST_CERT_INFO,
              data->pWintrustData->pCert->cbStruct, psftVerifyAsOf) &&
              data->pWintrustData->pCert->psftVerifyAsOf)
-                data->sftSystemTime = signer.sftVerifyAsOf;
+                signer.sftVerifyAsOf = *data->pWintrustData->pCert->psftVerifyAsOf;
             else
             {
                 SYSTEMTIME sysTime;
diff --git a/dlls/wintrust/wintrust_main.c b/dlls/wintrust/wintrust_main.c
index 44a61277967..3673d402ce5 100644
--- a/dlls/wintrust/wintrust_main.c
+++ b/dlls/wintrust/wintrust_main.c
@@ -186,6 +186,10 @@ static CRYPT_PROVIDER_DATA *WINTRUST_AllocateProviderData(void)
     if (!provData)
         goto oom;
     provData->cbStruct = sizeof(CRYPT_PROVIDER_DATA);
+    /* when it was called, which is what a signature with no time stamp is
+     * verified as of
+     */
+    GetSystemTimeAsFileTime(&provData->sftSystemTime);
 
     provData->padwTrustStepErrors = calloc(TRUSTERROR_MAX_STEPS, sizeof(DWORD));
     if (!provData->padwTrustStepErrors)
