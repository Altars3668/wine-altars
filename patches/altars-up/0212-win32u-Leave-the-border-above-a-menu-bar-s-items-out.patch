From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 10:52:12 -0400
Subject: [PATCH] win32u: Leave the border above a menu bar's items out of the
 bar's rectangle.

The room a window makes for its menu bar starts with a border of a
pixel above the items.  GetMenuBarInfo put the bar's rectangle at the
first item's top and gave it the height of that whole room, so it
reached a pixel into the client area; on Windows the bar is as high as
its items, a pixel less than the room made for it, as the todo in the
test and tools/menuprobe in the outer tree show.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit d4b9f9a09c8da122fb70213fed9214e1ab74ca8f)

diff --git a/dlls/user32/tests/menu.c b/dlls/user32/tests/menu.c
index 0171fd1523b..e104d1702e4 100644
--- a/dlls/user32/tests/menu.c
+++ b/dlls/user32/tests/menu.c
@@ -305,7 +305,7 @@ static void test_getmenubarinfo(void)
     ok(ret, "GetWindowRect failed.\n");
     ret = GetMenuItemRect(hwnd, hmenu, 0, &rci);
     ok(ret, "GetMenuItemRect failed.\n");
-    todo_wine ok(mbi.rcBar.left == rci.left && mbi.rcBar.top == rci.top &&
+    ok(mbi.rcBar.left == rci.left && mbi.rcBar.top == rci.top &&
             mbi.rcBar.bottom == rci.bottom && mbi.rcBar.right == rcw.right - rci.left + rcw.left,
             "rcBar: Got %s instead of (%ld,%ld)-(%ld,%ld)\n", wine_dbgstr_rect(&mbi.rcBar),
             rci.left, rci.top, rcw.right - rci.left + rcw.left, rci.bottom);
diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
index 2a488af53db..c39c0e0e0f5 100644
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -5133,9 +5133,10 @@ BOOL WINAPI NtUserGetMenuBarInfo( HWND hwnd, LONG id, LONG item, MENUBARINFO *in
     }
     else if (item == 0)
     {
+        /* the bar starts at its first item, below the border of a pixel it has above them */
         NtUserGetMenuItemRect( hwnd, hmenu, 0, &info->rcBar );
         info->rcBar.right = info->rcBar.left + menu->Width;
-        info->rcBar.bottom = info->rcBar.top + menu->Height;
+        info->rcBar.bottom = info->rcBar.top + menu->Height - 1;
     }
     else
     {
