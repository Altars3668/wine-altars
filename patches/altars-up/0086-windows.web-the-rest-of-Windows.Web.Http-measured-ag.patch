+/*
+ * The value of a header that can hold several values -- Accept, Cookie,
+ * User-Agent -- is a vector of value objects with ParseAdd and TryParseAdd,
+ * and it writes itself out the way the header is written: comma separated,
+ * except cookies, joined by "; ", and products, joined by spaces.
+ *
+ * A header collection holds on to the one it made and writes the header
+ * from it every time it is read, so a change to an element shows at once.
+ */
+
+struct list_info
+{
+    const WCHAR *class_name;
+    const GUID *collection;
+    const GUID *vector;
+    const GUID *view;
+    const GUID *iterable;
+    const GUID *iterator;
+    enum value_kind element;
+    const WCHAR *separator;
+};
+
+static const struct list_info list_infos[LIST_KIND_COUNT] =
+{
+    { L"Windows.Web.Http.Headers.HttpMediaTypeWithQualityHeaderValueCollection",
