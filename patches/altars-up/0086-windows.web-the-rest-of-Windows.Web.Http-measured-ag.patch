+static HRESULT client_send( struct http_client *impl, IHttpRequestMessage *request, HttpCompletionOption option,
+                            enum result_kind kind, BOOL try_result, void **operation )
+{
+    const struct async_type *type;
+    struct send_context *send;
+    IUriRuntimeClass *uri = NULL;
+    IHttpFilter *filter;
+    BOOL http;
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!request) return E_POINTER;
+    if ((UINT)option > HttpCompletionOption_ResponseHeadersRead) return E_INVALIDARG;
+
+    EnterCriticalSection( &impl->cs );
+    if ((filter = impl->filter)) IHttpFilter_AddRef( filter );
+    LeaveCriticalSection( &impl->cs );
+    if (!filter) return RO_E_CLOSED;
+
+    IHttpRequestMessage_get_RequestUri( request, &uri );
+    http = is_http_uri( uri );
+    if (uri) IUriRuntimeClass_Release( uri );
+    if (!http || !request_message_mark_sent( request ))
+    {
+        IHttpFilter_Release( filter );
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if (FAILED(hr = merge_default_headers( impl, request )) || !(send = calloc( 1, sizeof(*send) )))
+    {
+        IHttpFilter_Release( filter );
+        return FAILED(hr) ? hr : E_OUTOFMEMORY;
+    }
+    IHttpClient_AddRef( &(send->client = impl)->IHttpClient_iface );
+    send->filter = filter;
+    IHttpRequestMessage_AddRef( (send->request = request) );
+    send->option = option;
+    send->kind = kind;
+    send->try_result = try_result;
+
+    switch (kind)
+    {
+    case RESULT_STRING: type = try_result ? &async_string_result_type : &async_http_string_type; break;
+    case RESULT_BUFFER: type = try_result ? &async_buffer_result_type : &async_http_buffer_type; break;
+    case RESULT_STREAM: type = try_result ? &async_stream_result_type : &async_http_stream_type; break;
+    default: type = try_result ? &async_request_result_type : &async_response_type; break;
+    }
+    return async_op_create( type, send_work, send, free_send_context, operation );
+}
+
+static HRESULT client_send_uri( struct http_client *impl, const WCHAR *method_name, IUriRuntimeClass *uri,
+                                IHttpContent *content, HttpCompletionOption option, enum result_kind kind,
+                                BOOL try_result, void **operation )
+{
+    IHttpRequestMessage *request;
+    IHttpMethod *method;
+    HRESULT hr;
+
+    if (!operation) return E_POINTER;
+    *operation = NULL;
+    if (!uri) return E_POINTER;
+    if (FAILED(hr = http_method_get( method_name, &method ))) return hr;
+    hr = request_message_create( method, uri, &request );
+    IHttpMethod_Release( method );
+    if (FAILED(hr)) return hr;
+    if (content) IHttpRequestMessage_put_Content( request, content );
+    hr = client_send( impl, request, option, kind, try_result, operation );
+    IHttpRequestMessage_Release( request );
+    return hr;
+}
