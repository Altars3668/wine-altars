+/*** growable strings ***/
+
+void strbuf_init( struct strbuf *buf )
+{
+    buf->data = NULL;
+    buf->len = buf->size = 0;
+    buf->failed = FALSE;
+}
+
+void strbuf_free( struct strbuf *buf )
+{
+    free( buf->data );
+    strbuf_init( buf );
+}
+
+static BOOL strbuf_reserve( struct strbuf *buf, size_t len )
+{
+    WCHAR *data;
+    size_t size;
+
+    if (buf->failed) return FALSE;
+    if (buf->len + len + 1 <= buf->size) return TRUE;
+    size = max( 64, max( buf->size * 2, buf->len + len + 1 ) );
+    if (!(data = realloc( buf->data, size * sizeof(WCHAR) )))
+    {
+        buf->failed = TRUE;
+        return FALSE;
+    }
+    buf->data = data;
+    buf->size = size;
+    return TRUE;
+}
+
+void strbuf_append( struct strbuf *buf, const WCHAR *str, size_t len )
+{
+    if (!strbuf_reserve( buf, len )) return;
+    memcpy( buf->data + buf->len, str, len * sizeof(WCHAR) );
+    buf->len += len;
+    buf->data[buf->len] = 0;
+}
+
+void strbuf_appendw( struct strbuf *buf, const WCHAR *str )
+{
+    if (str) strbuf_append( buf, str, wcslen( str ) );
+}
+
+void strbuf_appendc( struct strbuf *buf, WCHAR c )
+{
+    strbuf_append( buf, &c, 1 );
+}
+
+void strbuf_appendf( struct strbuf *buf, const WCHAR *format, ... )
+{
+    WCHAR tmp[256];
+    va_list args;
+    int len;
+
+    va_start( args, format );
+    len = _vsnwprintf( tmp, ARRAY_SIZE(tmp), format, args );
+    va_end( args );
+    if (len < 0) len = ARRAY_SIZE(tmp) - 1;
+    strbuf_append( buf, tmp, len );
+}
+
+void strbuf_append_hstring( struct strbuf *buf, HSTRING str )
+{
+    UINT32 len;
+    const WCHAR *data = WindowsGetStringRawBuffer( str, &len );
+    strbuf_append( buf, data, len );
+}
+
+HRESULT strbuf_to_hstring( struct strbuf *buf, HSTRING *out )
+{
+    if (buf->failed) return E_OUTOFMEMORY;
+    return WindowsCreateString( buf->data, buf->len, out );
+}
+
+/*** HSTRING ***/
+
+WCHAR *hstring_dup( HSTRING str )
+{
+    const WCHAR *data;
+    UINT32 len;
+    WCHAR *ret;
+
+    data = WindowsGetStringRawBuffer( str, &len );
+    if (!(ret = malloc( (len + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, data, len * sizeof(WCHAR) );
+    ret[len] = 0;
+    return ret;
+}
+
+BOOL hstring_is_empty( HSTRING str )
+{
+    return !WindowsGetStringLen( str );
+}
+
+HRESULT hstring_create( const WCHAR *str, HSTRING *out )
+{
+    if (!str) { *out = NULL; return S_OK; }
+    return WindowsCreateString( str, wcslen( str ), out );
+}
+
+HRESULT hstring_create_len( const WCHAR *str, size_t len, HSTRING *out )
+{
+    return WindowsCreateString( str, len, out );
+}
+
+HRESULT hstring_replace( HSTRING *dst, HSTRING src )
+{
+    HSTRING copy;
+    HRESULT hr;
+
+    if (FAILED(hr = WindowsDuplicateString( src, &copy ))) return hr;
+    WindowsDeleteString( *dst );
+    *dst = copy;
+    return S_OK;
+}
+
+HRESULT class_name_create( const WCHAR *name, HSTRING *out )
+{
+    return WindowsCreateString( name, wcslen( name ), out );
+}
+
+/*** the tokens of RFC 7230 ***/
+
+BOOL is_token_char( WCHAR c )
+{
+    if (c >= 'a' && c <= 'z') return TRUE;
+    if (c >= 'A' && c <= 'Z') return TRUE;
+    if (c >= '0' && c <= '9') return TRUE;
+    return c && wcschr( L"!#$%&'*+-.^_`|~", c );
+}
+
+BOOL is_token( const WCHAR *str, size_t len )
+{
+    size_t i;
+    if (!str || !len) return FALSE;
+    for (i = 0; i < len; i++) if (!is_token_char( str[i] )) return FALSE;
+    return TRUE;
+}
+
+BOOL is_token_hstring( HSTRING str )
+{
+    UINT32 len;
+    const WCHAR *data = WindowsGetStringRawBuffer( str, &len );
+    return is_token( data, len );
+}
+
+BOOL is_ws( WCHAR c )
+{
+    return c == ' ' || c == '\t';
+}
+
+void skip_ws( const WCHAR **ptr )
+{
+    while (is_ws( **ptr )) (*ptr)++;
+}
+
+BOOL parse_token( const WCHAR **ptr, WCHAR **out )
+{
+    const WCHAR *start = *ptr, *end = start;
+
+    while (is_token_char( *end )) end++;
+    if (end == start) return FALSE;
+    if (out)
+    {
+        if (!(*out = malloc( (end - start + 1) * sizeof(WCHAR) ))) return FALSE;
+        memcpy( *out, start, (end - start) * sizeof(WCHAR) );
+        (*out)[end - start] = 0;
+    }
+    *ptr = end;
+    return TRUE;
+}
+
+BOOL parse_quoted_string( const WCHAR **ptr, WCHAR **out )
+{
+    const WCHAR *p = *ptr;
+    struct strbuf buf;
+
+    if (*p != '"') return FALSE;
+    strbuf_init( &buf );
+    strbuf_append( &buf, L"", 0 );
+    for (p++; *p && *p != '"'; p++)
+    {
+        if (*p == '\\' && p[1]) p++;
+        else if (*p == '\r' || *p == '\n') break;
+        strbuf_appendc( &buf, *p );
+    }
+    if (*p != '"' || buf.failed)
+    {
+        strbuf_free( &buf );
+        return FALSE;
+    }
+    *ptr = p + 1;
+    if (out) *out = buf.data;
+    else strbuf_free( &buf );
+    return TRUE;
+}
+
+BOOL parse_token_or_quoted( const WCHAR **ptr, WCHAR **out, BOOL *quoted )
+{
+    if (**ptr == '"')
+    {
+        if (quoted) *quoted = TRUE;
+        return parse_quoted_string( ptr, out );
+    }
+    if (quoted) *quoted = FALSE;
+    return parse_token( ptr, out );
+}
+
+/* A value is written as it is when it is a token, and quoted otherwise. */
+void format_token_or_quoted( struct strbuf *buf, const WCHAR *value, BOOL force_quotes )
+{
+    const WCHAR *p;
+
+    if (!force_quotes && is_token( value, wcslen( value ) ))
+    {
+        strbuf_appendw( buf, value );
+        return;
+    }
+    strbuf_appendc( buf, '"' );
+    for (p = value; *p; p++)
+    {
+        if (*p == '"' || *p == '\\') strbuf_appendc( buf, '\\' );
+        strbuf_appendc( buf, *p );
+    }
+    strbuf_appendc( buf, '"' );
+}
+
+/* "(text (nested) \) escaped)": the text is given back without its outer
+ * parentheses and with the escapes taken out. */
+BOOL parse_comment( const WCHAR **ptr, WCHAR **out )
+{
+    const WCHAR *p = *ptr;
+    struct strbuf buf;
+    int depth = 1;
+
+    if (*p != '(') return FALSE;
+    strbuf_init( &buf );
+    strbuf_append( &buf, L"", 0 );
+    for (p++; *p; p++)
+    {
+        if (*p == '\\' && p[1]) p++;
+        else if (*p == '(') depth++;
+        else if (*p == ')' && !--depth) break;
+        else if (*p == '\r' || *p == '\n') break;
+        strbuf_appendc( &buf, *p );
+    }
+    if (*p != ')' || depth || buf.failed)
+    {
+        strbuf_free( &buf );
+        return FALSE;
+    }
+    *ptr = p + 1;
+    if (out) *out = buf.data;
+    else strbuf_free( &buf );
+    return TRUE;
+}
+
+void format_comment( struct strbuf *buf, const WCHAR *comment )
+{
+    const WCHAR *p;
+
+    strbuf_appendc( buf, '(' );
+    for (p = comment; p && *p; p++)
+    {
+        if (*p == '(' || *p == ')' || *p == '\\') strbuf_appendc( buf, '\\' );
+        strbuf_appendc( buf, *p );
+    }
+    strbuf_appendc( buf, ')' );
+}
+
+BOOL parse_uint64( const WCHAR *str, size_t len, UINT64 *value )
+{
+    UINT64 ret = 0;
+    size_t i;
+
+    if (!len) return FALSE;
+    for (i = 0; i < len; i++)
+    {
+        if (str[i] < '0' || str[i] > '9') return FALSE;
+        if (ret > (~(UINT64)0 - (str[i] - '0')) / 10) return FALSE;
+        ret = ret * 10 + str[i] - '0';
+    }
+    *value = ret;
+    return TRUE;
+}
+
+/* A quality is a number from 0 to 1. */
+BOOL parse_quality( const WCHAR *str, double *value )
+{
+    const WCHAR *p = str;
+    double ret = 0, scale = 1;
+    BOOL digits = FALSE;
+
+    while (*p >= '0' && *p <= '9') { ret = ret * 10 + *p++ - '0'; digits = TRUE; }
+    if (*p == '.')
+    {
+        for (p++; *p >= '0' && *p <= '9'; p++)
+        {
+            scale /= 10;
+            ret += (*p - '0') * scale;
+            digits = TRUE;
+        }
+    }
+    if (*p || !digits || ret > 1) return FALSE;
+    *value = ret;
+    return TRUE;
+}
+
+/* 0.25 is written 0.25, 1 is 1, and more than three decimals are cut to three. */
+void format_quality( struct strbuf *buf, double value )
+{
+    WCHAR tmp[64], *end;
+
+    swprintf( tmp, ARRAY_SIZE(tmp), L"%.3f", value );
+    end = tmp + wcslen( tmp );
+    if (wcschr( tmp, '.' ))
+    {
+        while (end > tmp && end[-1] == '0') *--end = 0;
+        if (end > tmp && end[-1] == '.') *--end = 0;
+    }
+    strbuf_appendw( buf, tmp );
+}
+
+/*** dates: RFC 1123, RFC 850 and asctime, as HTTP has them ***/
+
+static const WCHAR *const month_names[] = { L"Jan", L"Feb", L"Mar", L"Apr", L"May", L"Jun",
+                                            L"Jul", L"Aug", L"Sep", L"Oct", L"Nov", L"Dec" };
+static const WCHAR *const day_names[] = { L"Sun", L"Mon", L"Tue", L"Wed", L"Thu", L"Fri", L"Sat" };
+
+static BOOL parse_number( const WCHAR **ptr, int min_digits, int max_digits, int *value )
+{
+    const WCHAR *p = *ptr;
+    int ret = 0, count = 0;
+
+    while (*p >= '0' && *p <= '9' && count < max_digits) { ret = ret * 10 + *p++ - '0'; count++; }
+    if (count < min_digits) return FALSE;
+    *value = ret;
+    *ptr = p;
+    return TRUE;
+}
+
+static BOOL parse_month( const WCHAR **ptr, int *month )
+{
+    int i;
+    for (i = 0; i < 12; i++)
+    {
+        if (!wcsnicmp( *ptr, month_names[i], 3 ))
+        {
+            *month = i + 1;
+            *ptr += 3;
+            return TRUE;
+        }
+    }
+    return FALSE;
+}
+
+static BOOL parse_time( const WCHAR **ptr, SYSTEMTIME *st )
+{
+    int hour, minute, second;
+
+    if (!parse_number( ptr, 1, 2, &hour ) || *(*ptr)++ != ':') return FALSE;
+    if (!parse_number( ptr, 1, 2, &minute ) || *(*ptr)++ != ':') return FALSE;
+    if (!parse_number( ptr, 1, 2, &second )) return FALSE;
+    if (hour > 23 || minute > 59 || second > 60) return FALSE;
+    st->wHour = hour;
+    st->wMinute = minute;
+    st->wSecond = min( second, 59 );
+    return TRUE;
+}
+
+static BOOL parse_zone( const WCHAR **ptr, LONGLONG *offset )
+{
+    const WCHAR *p = *ptr;
+    int value;
+
+    *offset = 0;
+    skip_ws( &p );
+    if (!*p) { *ptr = p; return TRUE; }
+    if (!wcsnicmp( p, L"GMT", 3 ) || !wcsnicmp( p, L"UTC", 3 )) p += 3;
+    else if (*p == 'Z' || *p == 'z') p++;
+    else if (*p == '+' || *p == '-')
+    {
+        int sign = *p++ == '-' ? -1 : 1;
+        if (!parse_number( &p, 4, 4, &value )) return FALSE;
+        *offset = sign * ((value / 100) * 60 + value % 100) * (LONGLONG)60 * 10000000;
+    }
+    else return FALSE;
+    skip_ws( &p );
+    if (*p) return FALSE;
+    *ptr = p;
+    return TRUE;
+}
+
+BOOL parse_http_date( const WCHAR *str, DateTime *value )
+{
+    const WCHAR *p = str;
+    SYSTEMTIME st = {0};
+    LONGLONG offset;
+    FILETIME ft;
+    int day, month, year;
+
+    skip_ws( &p );
+    /* the day of the week, which says nothing */
+    while ((*p >= 'a' && *p <= 'z') || (*p >= 'A' && *p <= 'Z')) p++;
+    if (p == str) return FALSE;
+    if (*p == ',') p++;
+    skip_ws( &p );
+
+    if (*p >= '0' && *p <= '9')
+    {
+        /* "06 Nov 1994 08:49:37 GMT" or "06-Nov-94 08:49:37 GMT" */
+        if (!parse_number( &p, 1, 2, &day )) return FALSE;
+        if (*p == '-') p++; else skip_ws( &p );
+        if (!parse_month( &p, &month )) return FALSE;
+        if (*p == '-') p++; else skip_ws( &p );
+        if (!parse_number( &p, 2, 4, &year )) return FALSE;
+        if (year < 100) year += year < 50 ? 2000 : 1900;
+        skip_ws( &p );
+        if (!parse_time( &p, &st )) return FALSE;
+    }
+    else
+    {
+        /* asctime: "Nov  6 08:49:37 1994" */
+        if (!parse_month( &p, &month )) return FALSE;
+        skip_ws( &p );
+        if (!parse_number( &p, 1, 2, &day )) return FALSE;
+        skip_ws( &p );
+        if (!parse_time( &p, &st )) return FALSE;
+        skip_ws( &p );
+        if (!parse_number( &p, 4, 4, &year )) return FALSE;
+    }
+    if (!parse_zone( &p, &offset )) return FALSE;
+    if (day < 1 || day > 31) return FALSE;
+
+    st.wYear = year;
+    st.wMonth = month;
+    st.wDay = day;
+    if (!SystemTimeToFileTime( &st, &ft )) return FALSE;
+    value->UniversalTime = (((LONGLONG)ft.dwHighDateTime << 32) | ft.dwLowDateTime) - offset;
+    return TRUE;
+}
+
+void format_http_date( struct strbuf *buf, DateTime value )
+{
+    SYSTEMTIME st;
+    FILETIME ft;
+
+    ft.dwLowDateTime = (DWORD)value.UniversalTime;
+    ft.dwHighDateTime = (DWORD)(value.UniversalTime >> 32);
+    if (!FileTimeToSystemTime( &ft, &st )) return;
+    strbuf_appendf( buf, L"%s, %02u %s %04u %02u:%02u:%02u GMT", day_names[st.wDayOfWeek], st.wDay,
+                    month_names[st.wMonth - 1], st.wYear, st.wHour, st.wMinute, st.wSecond );
+}
+
+/*** buffers ***/
+
+/* The buffers a content hands out: exactly as long as what they hold, and of
+ * a class Windows names after the interface, Windows.Storage.Streams.IBuffer. */
+struct buffer
+{
+    IBuffer IBuffer_iface;
+    IBufferByteAccess IBufferByteAccess_iface;
+    IUnknown *marshal;
+    LONG ref;
+    UINT32 capacity;
+    UINT32 length;
+    BYTE data[];
+};
+
+static inline struct buffer *impl_from_IBuffer( IBuffer *iface )
+{
+    return CONTAINING_RECORD( iface, struct buffer, IBuffer_iface );
+}
+
+static HRESULT WINAPI buffer_QueryInterface( IBuffer *iface, REFIID iid, void **out )
+{
+    struct buffer *impl = impl_from_IBuffer( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IBuffer ))
+    {
+        IInspectable_AddRef( (*out = &impl->IBuffer_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IBufferByteAccess ))
+    {
+        IInspectable_AddRef( (*out = &impl->IBufferByteAccess_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IMarshal ))
+    {
+        IUnknown *marshal;
+        HRESULT hr;
+
+        if (!impl->marshal)
+        {
+            if (FAILED(hr = CoCreateFreeThreadedMarshaler( (IUnknown *)&impl->IBuffer_iface, &marshal ))) return hr;
+            if (InterlockedCompareExchangePointer( (void **)&impl->marshal, marshal, NULL ))
+                IUnknown_Release( marshal );
+        }
+        return IUnknown_QueryInterface( impl->marshal, iid, out );
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI buffer_AddRef( IBuffer *iface )
+{
+    struct buffer *impl = impl_from_IBuffer( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI buffer_Release( IBuffer *iface )
+{
+    struct buffer *impl = impl_from_IBuffer( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->marshal) IUnknown_Release( impl->marshal );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI buffer_GetIids( IBuffer *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI buffer_GetRuntimeClassName( IBuffer *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return class_name_create( L"Windows.Storage.Streams.IBuffer", class_name );
+}
+
+static HRESULT WINAPI buffer_GetTrustLevel( IBuffer *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI buffer_get_Capacity( IBuffer *iface, UINT32 *value )
+{
+    struct buffer *impl = impl_from_IBuffer( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl->capacity;
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_get_Length( IBuffer *iface, UINT32 *value )
+{
+    struct buffer *impl = impl_from_IBuffer( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl->length;
+    return S_OK;
+}
+
+static HRESULT WINAPI buffer_put_Length( IBuffer *iface, UINT32 value )
+{
+    struct buffer *impl = impl_from_IBuffer( iface );
+    TRACE( "iface %p, value %u.\n", iface, value );
+    if (value > impl->capacity) return E_INVALIDARG;
+    impl->length = value;
+    return S_OK;
+}
+
+static const struct IBufferVtbl buffer_vtbl =
+{
+    buffer_QueryInterface,
+    buffer_AddRef,
+    buffer_Release,
+    /* IInspectable methods */
+    buffer_GetIids,
+    buffer_GetRuntimeClassName,
+    buffer_GetTrustLevel,
+    /* IBuffer methods */
+    buffer_get_Capacity,
+    buffer_get_Length,
+    buffer_put_Length,
+};
+
+static inline struct buffer *impl_from_IBufferByteAccess( IBufferByteAccess *iface )
+{
+    return CONTAINING_RECORD( iface, struct buffer, IBufferByteAccess_iface );
+}
