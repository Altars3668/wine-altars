+
+UINT codepage_from_charset( const WCHAR *charset )
+{
+    WCHAR name[64];
+    size_t len, i;
+
+    if (!charset) return 0;
+    while (is_ws( *charset )) charset++;
+    len = wcslen( charset );
+    if (len >= 2 && charset[0] == '"' && charset[len - 1] == '"') { charset++; len -= 2; }
+    if (!len || len >= ARRAY_SIZE(name)) return 0;
+    memcpy( name, charset, len * sizeof(WCHAR) );
+    name[len] = 0;
+    for (i = 0; i < ARRAY_SIZE(charsets); i++)
+        if (!wcsicmp( name, charsets[i].name )) return charsets[i].codepage;
+    return 0;
+}
+
+static HRESULT decode_utf16( const BYTE *data, UINT32 len, BOOL big_endian, HSTRING *out )
+{
+    HSTRING_BUFFER buffer;
+    WCHAR *chars;
+    UINT32 i;
+    HRESULT hr;
+
+    if (len % 2) return HRESULT_FROM_WIN32( ERROR_NO_UNICODE_TRANSLATION );
+    if (FAILED(hr = WindowsPreallocateStringBuffer( len / 2, &chars, &buffer ))) return hr;
+    for (i = 0; i < len / 2; i++)
+        chars[i] = big_endian ? (data[2 * i] << 8) | data[2 * i + 1] : data[2 * i] | (data[2 * i + 1] << 8);
+    return WindowsPromoteStringBuffer( buffer, out );
+}
+
+static HRESULT decode_codepage( const BYTE *data, UINT32 len, UINT codepage, BOOL strict, HSTRING *out )
+{
+    HSTRING_BUFFER buffer;
+    WCHAR *chars;
+    int count;
+    HRESULT hr;
+
+    if (codepage == 28591)
+    {
+        UINT32 i;
+        if (FAILED(hr = WindowsPreallocateStringBuffer( len, &chars, &buffer ))) return hr;
+        for (i = 0; i < len; i++) chars[i] = data[i];
+        return WindowsPromoteStringBuffer( buffer, out );
+    }
+    /* UTF-7 takes no flags */
+    if (codepage == CP_UTF7) strict = FALSE;
+    count = MultiByteToWideChar( codepage, strict ? MB_ERR_INVALID_CHARS : 0, (const char *)data, len, NULL, 0 );
+    if (count <= 0) return HRESULT_FROM_WIN32( ERROR_NO_UNICODE_TRANSLATION );
+    if (FAILED(hr = WindowsPreallocateStringBuffer( count, &chars, &buffer ))) return hr;
+    MultiByteToWideChar( codepage, strict ? MB_ERR_INVALID_CHARS : 0, (const char *)data, len, chars, count );
+    return WindowsPromoteStringBuffer( buffer, out );
+}
+
+/* How Windows turns a body into a string, as measured.  Without a charset
+ * a byte order mark says what it is, and otherwise JSON is UTF-8 and
+ * anything else ISO-8859-1, byte for byte.  A charset Windows does not know
+ * is E_FAIL.  UTF-16 without its mark is read as it comes, and an odd
+ * length of it does not decode.  Bytes that are not the UTF-8 they claim
+ * to be are read as UTF-16 when there is an even number of them, and do
+ * not decode when there is not. */
+HRESULT decode_text( const BYTE *data, UINT32 len, const WCHAR *charset, BOOL utf8, HSTRING *out )
+{
+    UINT codepage;
+
+    *out = NULL;
+    if (charset && *charset)
+    {
+        if (!(codepage = codepage_from_charset( charset ))) return E_FAIL;
+    }
+    else
+    {
+        if (len >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf)
+            return len > 3 ? decode_codepage( data + 3, len - 3, CP_UTF8, FALSE, out ) : S_OK;
+        if (len >= 2 && data[0] == 0xff && data[1] == 0xfe) return decode_utf16( data + 2, len - 2, FALSE, out );
+        if (len >= 2 && data[0] == 0xfe && data[1] == 0xff) return decode_utf16( data + 2, len - 2, TRUE, out );
+        codepage = utf8 ? CP_UTF8 : 28591;
+    }
+    if (!len) return S_OK;
+
+    switch (codepage)
+    {
+    case 1200: return decode_utf16( data, len, FALSE, out );
+    case 1201: return decode_utf16( data, len, TRUE, out );
+    case CP_UTF8:
+        if (len >= 3 && data[0] == 0xef && data[1] == 0xbb && data[2] == 0xbf) { data += 3; len -= 3; }
+        if (!len) return S_OK;
+        if (SUCCEEDED(decode_codepage( data, len, CP_UTF8, TRUE, out ))) return S_OK;
+        return decode_utf16( data, len, FALSE, out );
+    default:
+        return decode_codepage( data, len, codepage, TRUE, out );
+    }
+}
+
+HRESULT encode_text( HSTRING str, UnicodeEncoding encoding, BYTE **data, UINT32 *len )
+{
+    const WCHAR *chars;
+    UINT32 count, i;
+    int size;
+
+    chars = WindowsGetStringRawBuffer( str, &count );
+    *data = NULL;
+    *len = 0;
+    switch (encoding)
+    {
+    case UnicodeEncoding_Utf8:
+        size = count ? WideCharToMultiByte( CP_UTF8, 0, chars, count, NULL, 0, NULL, NULL ) : 0;
+        if (!(*data = malloc( max( size, 1 ) ))) return E_OUTOFMEMORY;
+        if (size) WideCharToMultiByte( CP_UTF8, 0, chars, count, (char *)*data, size, NULL, NULL );
+        *len = size;
+        return S_OK;
+    case UnicodeEncoding_Utf16LE:
+    case UnicodeEncoding_Utf16BE:
+        if (!(*data = malloc( max( count * 2, 1 ) ))) return E_OUTOFMEMORY;
+        for (i = 0; i < count; i++)
+        {
+            BYTE lo = chars[i] & 0xff, hi = chars[i] >> 8;
+            (*data)[2 * i] = encoding == UnicodeEncoding_Utf16LE ? lo : hi;
+            (*data)[2 * i + 1] = encoding == UnicodeEncoding_Utf16LE ? hi : lo;
+        }
+        *len = count * 2;
+        return S_OK;
+    default:
+        return E_INVALIDARG;
+    }
+}
+
+/*** base64 ***/
+
+static const char base64_chars[] = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+HRESULT base64_encode( const BYTE *data, UINT32 len, WCHAR **out )
+{
+    UINT32 i, j = 0;
+    WCHAR *ret;
+
+    if (!(ret = malloc( ((len + 2) / 3 * 4 + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    for (i = 0; i < len; i += 3)
+    {
+        UINT32 chunk = data[i] << 16;
+        if (i + 1 < len) chunk |= data[i + 1] << 8;
+        if (i + 2 < len) chunk |= data[i + 2];
+        ret[j++] = base64_chars[(chunk >> 18) & 0x3f];
+        ret[j++] = base64_chars[(chunk >> 12) & 0x3f];
+        ret[j++] = i + 1 < len ? base64_chars[(chunk >> 6) & 0x3f] : '=';
+        ret[j++] = i + 2 < len ? base64_chars[chunk & 0x3f] : '=';
+    }
+    ret[j] = 0;
+    *out = ret;
+    return S_OK;
+}
+
+/* Windows takes a lone trailing character as a whole byte: "1" is 0xd4. */
+BOOL base64_decode_lenient( const WCHAR *str, BYTE **data, UINT32 *len )
+{
+    UINT32 bits = 0, value = 0, count = 0;
+    const WCHAR *p;
+    BYTE *ret;
+
+    if (!(ret = malloc( wcslen( str ) + 1 ))) return FALSE;
+    for (p = str; *p; p++)
+    {
+        const char *pos;
+        if (*p == '=') break;
+        if (is_ws( *p )) continue;
+        if (*p > 0x7f || !(pos = strchr( base64_chars, (char)*p )))
+        {
+            free( ret );
+            return FALSE;
+        }
+        value = (value << 6) | (pos - base64_chars);
+        bits += 6;
+        if (bits >= 8)
+        {
+            bits -= 8;
+            ret[count++] = (value >> bits) & 0xff;
+        }
+    }
+    for (; *p; p++) if (*p != '=' && !is_ws( *p )) { free( ret ); return FALSE; }
+    if (bits >= 6) ret[count++] = (value << (8 - bits)) & 0xff;
+    *data = ret;
+    *len = count;
+    return TRUE;
+}
