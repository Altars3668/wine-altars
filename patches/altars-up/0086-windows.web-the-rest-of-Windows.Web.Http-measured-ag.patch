+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+/*
+ * The cookies a filter sends and keeps are WinINet's, as on Windows, so the
+ * cookie manager reads and writes WinINet's store.
+ */
+
+/*** HttpCookie ***/
+
+struct http_cookie
+{
+    IHttpCookie IHttpCookie_iface;
+    IStringable IStringable_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    HSTRING name;
+    HSTRING domain;
+    HSTRING path;
+    HSTRING value;
+    BOOL has_expires;
+    DateTime expires;
+    boolean http_only;
+    boolean secure;
+};
+
+static const struct IHttpCookieVtbl cookie_vtbl;
+
+static inline struct http_cookie *impl_from_IHttpCookie( IHttpCookie *iface )
+{
+    return CONTAINING_RECORD( iface, struct http_cookie, IHttpCookie_iface );
+}
+
+static HRESULT WINAPI cookie_QueryInterface( IHttpCookie *iface, REFIID iid, void **out )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IHttpCookie ))
+    {
+        IInspectable_AddRef( (*out = &impl->IHttpCookie_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IStringable ))
+    {
+        IInspectable_AddRef( (*out = &impl->IStringable_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI cookie_AddRef( IHttpCookie *iface )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI cookie_Release( IHttpCookie *iface )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( impl->name );
+        WindowsDeleteString( impl->domain );
+        WindowsDeleteString( impl->path );
+        WindowsDeleteString( impl->value );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI cookie_GetIids( IHttpCookie *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI cookie_GetRuntimeClassName( IHttpCookie *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return class_name_create( L"Windows.Web.Http.HttpCookie", class_name );
+}
+
+static HRESULT WINAPI cookie_GetTrustLevel( IHttpCookie *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+#define COOKIE_STRING_GET( prop, field )                                                           \
+    static HRESULT WINAPI cookie_get_##prop( IHttpCookie *iface, HSTRING *value )                  \
+    {                                                                                              \
+        struct http_cookie *impl = impl_from_IHttpCookie( iface );                                 \
+        HRESULT hr;                                                                                \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        EnterCriticalSection( &impl->cs );                                                         \
+        hr = WindowsDuplicateString( impl->field, value );                                         \
+        LeaveCriticalSection( &impl->cs );                                                         \
+        return hr;                                                                                 \
+    }
+
+COOKIE_STRING_GET( Name, name )
+COOKIE_STRING_GET( Domain, domain )
+COOKIE_STRING_GET( Path, path )
+COOKIE_STRING_GET( Value, value )
+
+static HRESULT WINAPI cookie_get_Expires( IHttpCookie *iface, IReference_DateTime **value )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    return impl->has_expires ? box_datetime( impl->expires, value ) : S_OK;
+}
+
+static HRESULT WINAPI cookie_put_Expires( IHttpCookie *iface, IReference_DateTime *value )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    EnterCriticalSection( &impl->cs );
+    if (!value) impl->has_expires = FALSE;
+    else if (SUCCEEDED(hr = IReference_DateTime_get_Value( value, &impl->expires ))) impl->has_expires = TRUE;
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI cookie_get_HttpOnly( IHttpCookie *iface, boolean *value )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl->http_only;
+    return S_OK;
+}
+
+static HRESULT WINAPI cookie_put_HttpOnly( IHttpCookie *iface, boolean value )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl->http_only = !!value;
+    return S_OK;
+}
+
+static HRESULT WINAPI cookie_get_Secure( IHttpCookie *iface, boolean *value )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    *value = impl->secure;
+    return S_OK;
+}
+
+static HRESULT WINAPI cookie_put_Secure( IHttpCookie *iface, boolean value )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    TRACE( "iface %p, value %d.\n", iface, value );
+    impl->secure = !!value;
+    return S_OK;
+}
+
+static HRESULT WINAPI cookie_put_Value( IHttpCookie *iface, HSTRING value )
+{
+    struct http_cookie *impl = impl_from_IHttpCookie( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, value %s.\n", iface, debugstr_hstring( value ) );
+
+    EnterCriticalSection( &impl->cs );
+    hr = hstring_replace( &impl->value, value );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static const struct IHttpCookieVtbl cookie_vtbl =
+{
+    cookie_QueryInterface,
+    cookie_AddRef,
+    cookie_Release,
+    /* IInspectable methods */
+    cookie_GetIids,
+    cookie_GetRuntimeClassName,
+    cookie_GetTrustLevel,
+    /* IHttpCookie methods */
+    cookie_get_Name,
+    cookie_get_Domain,
+    cookie_get_Path,
+    cookie_get_Expires,
+    cookie_put_Expires,
+    cookie_get_HttpOnly,
+    cookie_put_HttpOnly,
+    cookie_get_Secure,
+    cookie_put_Secure,
+    cookie_get_Value,
+    cookie_put_Value,
+};
+
+DEFINE_IINSPECTABLE( cookie_stringable, IStringable, struct http_cookie, IHttpCookie_iface )
+
+/* name=value, and the attributes a Set-Cookie header would have */
+static void format_cookie( struct http_cookie *impl, struct strbuf *buf, BOOL attributes )
+{
+    EnterCriticalSection( &impl->cs );
+    strbuf_append_hstring( buf, impl->name );
+    strbuf_appendc( buf, '=' );
+    strbuf_append_hstring( buf, impl->value );
+    if (attributes)
+    {
+        if (!hstring_is_empty( impl->domain ))
+        {
+            strbuf_appendw( buf, L"; domain=" );
+            strbuf_append_hstring( buf, impl->domain );
+        }
+        if (!hstring_is_empty( impl->path ))
+        {
+            strbuf_appendw( buf, L"; path=" );
+            strbuf_append_hstring( buf, impl->path );
+        }
+        if (impl->has_expires)
+        {
+            strbuf_appendw( buf, L"; expires=" );
+            format_http_date( buf, impl->expires );
+        }
+        if (impl->secure) strbuf_appendw( buf, L"; secure" );
+        if (impl->http_only) strbuf_appendw( buf, L"; httponly" );
+    }
+    LeaveCriticalSection( &impl->cs );
+}
+
+static HRESULT WINAPI cookie_stringable_ToString( IStringable *iface, HSTRING *value )
+{
+    struct http_cookie *impl = impl_from_IStringable( iface );
+    struct strbuf buf;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    strbuf_init( &buf );
+    format_cookie( impl, &buf, TRUE );
+    hr = strbuf_to_hstring( &buf, value );
+    strbuf_free( &buf );
+    return hr;
+}
+
+static const struct IStringableVtbl cookie_stringable_vtbl =
+{
+    cookie_stringable_QueryInterface,
+    cookie_stringable_AddRef,
+    cookie_stringable_Release,
+    /* IInspectable methods */
+    cookie_stringable_GetIids,
+    cookie_stringable_GetRuntimeClassName,
+    cookie_stringable_GetTrustLevel,
+    /* IStringable methods */
+    cookie_stringable_ToString,
+};
+
+static HRESULT cookie_create( HSTRING name, HSTRING domain, HSTRING path, IHttpCookie **out )
+{
+    struct http_cookie *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IHttpCookie_iface.lpVtbl = &cookie_vtbl;
+    impl->IStringable_iface.lpVtbl = &cookie_stringable_vtbl;
+    impl->ref = 1;
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": http_cookie.cs");
+    if (FAILED(hr = WindowsDuplicateString( name, &impl->name )) ||
+        FAILED(hr = WindowsDuplicateString( domain, &impl->domain )) ||
+        FAILED(hr = WindowsDuplicateString( path, &impl->path )))
+    {
+        cookie_Release( &impl->IHttpCookie_iface );
+        return hr;
+    }
+    *out = &impl->IHttpCookie_iface;
+    return S_OK;
+}
+
+/*** HttpCookieManager ***/
+
+struct cookie_manager
+{
+    IHttpCookieManager IHttpCookieManager_iface;
+    LONG ref;
+};
+
+static inline struct cookie_manager *impl_from_IHttpCookieManager( IHttpCookieManager *iface )
+{
+    return CONTAINING_RECORD( iface, struct cookie_manager, IHttpCookieManager_iface );
+}
+
+static HRESULT WINAPI manager_QueryInterface( IHttpCookieManager *iface, REFIID iid, void **out )
+{
