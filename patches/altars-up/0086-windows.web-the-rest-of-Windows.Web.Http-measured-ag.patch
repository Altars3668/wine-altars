+
+/*** waiting for another operation ***/
+
+struct waiter
+{
+    completed_handler completed_iface;
+    IUnknown IUnknown_progress_iface; /* stands in for a progress handler; its Invoke is at slot 3 */
+    LONG ref;
+    const IID *completed_iid;
+    const IID *progress_iid;
+    HANDLE done;
+    AsyncStatus status;
+    struct async_op *outer;
+};
+
+static HRESULT WINAPI waiter_QueryInterface( completed_handler *iface, REFIID iid, void **out )
+{
+    struct waiter *impl = CONTAINING_RECORD( iface, struct waiter, completed_iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        (impl->completed_iid && IsEqualGUID( iid, impl->completed_iid )))
+    {
+        InterlockedIncrement( &impl->ref );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI waiter_AddRef( completed_handler *iface )
+{
+    struct waiter *impl = CONTAINING_RECORD( iface, struct waiter, completed_iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI waiter_Release( completed_handler *iface )
+{
+    struct waiter *impl = CONTAINING_RECORD( iface, struct waiter, completed_iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    if (!ref)
+    {
+        CloseHandle( impl->done );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI waiter_Invoke( completed_handler *iface, IUnknown *operation, AsyncStatus status )
+{
+    struct waiter *impl = CONTAINING_RECORD( iface, struct waiter, completed_iface );
+    impl->status = status;
+    SetEvent( impl->done );
+    return S_OK;
+}
+
+static const completed_handlerVtbl waiter_vtbl =
+{
+    waiter_QueryInterface,
+    waiter_AddRef,
+    waiter_Release,
+    waiter_Invoke,
+};
+
+static HRESULT WINAPI waiter_progress_QueryInterface( IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress *iface,
+                                                      REFIID iid, void **out )
+{
+    struct waiter *impl = CONTAINING_RECORD( (IUnknown *)iface, struct waiter, IUnknown_progress_iface );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        (impl->progress_iid && IsEqualGUID( iid, impl->progress_iid )))
+    {
+        InterlockedIncrement( &impl->ref );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI waiter_progress_AddRef( IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress *iface )
+{
+    struct waiter *impl = CONTAINING_RECORD( (IUnknown *)iface, struct waiter, IUnknown_progress_iface );
+    return waiter_AddRef( &impl->completed_iface );
+}
+
+static ULONG WINAPI waiter_progress_Release( IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress *iface )
+{
+    struct waiter *impl = CONTAINING_RECORD( (IUnknown *)iface, struct waiter, IUnknown_progress_iface );
+    return waiter_Release( &impl->completed_iface );
+}
+
+static HRESULT WINAPI waiter_progress_Invoke( IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress *iface,
+                                              IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *operation,
+                                              HttpProgress progress )
+{
+    struct waiter *impl = CONTAINING_RECORD( (IUnknown *)iface, struct waiter, IUnknown_progress_iface );
+    async_op_progress_http( impl->outer, &progress );
+    return S_OK;
+}
+
+static const IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgressVtbl waiter_progress_vtbl =
+{
+    waiter_progress_QueryInterface,
+    waiter_progress_AddRef,
+    waiter_progress_Release,
+    waiter_progress_Invoke,
+};
+
+AsyncStatus async_wait( struct async_op *outer, IUnknown *inner, BOOL with_progress,
+                        const IID *completed_iid, const IID *progress_iid, HRESULT *error )
+{
+    struct waiter *waiter;
+    IAsyncInfo *info;
+    AsyncStatus status = Error;
+    HANDLE handles[2];
+    HRESULT hr;
+
+    *error = E_FAIL;
+    if (FAILED(hr = IUnknown_QueryInterface( inner, &IID_IAsyncInfo, (void **)&info )))
+    {
+        *error = hr;
+        return Error;
+    }
+    if (!(waiter = calloc( 1, sizeof(*waiter) )))
+    {
+        IAsyncInfo_Release( info );
+        *error = E_OUTOFMEMORY;
+        return Error;
+    }
+    waiter->completed_iface.lpVtbl = &waiter_vtbl;
+    waiter->IUnknown_progress_iface.lpVtbl = (IUnknownVtbl *)&waiter_progress_vtbl;
+    waiter->ref = 1;
+    waiter->completed_iid = completed_iid;
+    waiter->progress_iid = progress_iid;
+    waiter->done = CreateEventW( NULL, TRUE, FALSE, NULL );
+    waiter->status = Started;
+    waiter->outer = outer;
+
+    if (with_progress)
+    {
+        generic_op *op = (generic_op *)inner;
+        if (progress_iid && outer) op->lpVtbl->put_Progress( op, &waiter->IUnknown_progress_iface );
+        hr = op->lpVtbl->put_Completed( op, (IUnknown *)&waiter->completed_iface );
+    }
+    else
+    {
+        /* IAsyncOperation<T>: put_Completed is where put_Progress is in the other */
+        generic_op *op = (generic_op *)inner;
+        hr = op->lpVtbl->put_Progress( op, (IUnknown *)&waiter->completed_iface );
+    }
+
+    if (SUCCEEDED(hr))
+    {
+        handles[0] = waiter->done;
+        handles[1] = outer ? outer->cancel_event : NULL;
+        if (WaitForMultipleObjects( outer ? 2 : 1, handles, FALSE, INFINITE ) == WAIT_OBJECT_0 + 1)
+        {
+            IAsyncInfo_Cancel( info );
+            WaitForSingleObject( waiter->done, 5000 );
+        }
+    }
+    IAsyncInfo_get_Status( info, &status );
+    IAsyncInfo_get_ErrorCode( info, error );
+    if (FAILED(hr))
+    {
+        status = Error;
+        *error = hr;
+    }
+    IAsyncInfo_Release( info );
+    waiter_Release( &waiter->completed_iface );
+    return status;
+}
