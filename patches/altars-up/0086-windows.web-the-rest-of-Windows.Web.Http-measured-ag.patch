+/* sets the first parameter of that name, adds one at the end, or removes them all */
+HRESULT name_value_list_set( struct vector *params, const WCHAR *name, const WCHAR *value, BOOL remove )
+{
+    IHttpNameValueHeaderValue *added;
+    struct header_value *nv;
+    BOOL found = FALSE;
+    UINT32 i;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &params->cs );
+    for (i = 0; i < params->size; i++)
+    {
+        if (!(nv = unsafe_header_value( params->elements[i] ))) continue;
+        if (nv->str1 && !wcsicmp( nv->str1, name ))
+        {
+            if (remove)
+            {
+                IInspectable_Release( params->elements[i] );
+                memmove( params->elements + i, params->elements + i + 1, (params->size - i - 1) * sizeof(*params->elements) );
+                params->size--;
+                i--;
+                if (params->desc && params->desc->changed) params->desc->changed( params );
+            }
+            else if (!found) hr = set_string( nv, &nv->str2, value );
+            found = TRUE;
+        }
+        value_Release( &nv->IInspectable_iface );
+    }
+    LeaveCriticalSection( &params->cs );
+    if (found || remove || FAILED(hr)) return hr;
