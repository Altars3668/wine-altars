+/* One parameter: name [= value]; the value is required when value_required. */
+static HRESULT parse_name_value( const WCHAR **ptr, BOOL value_required, IInspectable **out )
+{
+    const WCHAR *p = *ptr;
+    WCHAR *name = NULL, *value = NULL;
+    IHttpNameValueHeaderValue *nv;
+    HRESULT hr;
+
+    skip_ws( &p );
+    if (!parse_token( &p, &name )) return E_INVALIDARG;
+    skip_ws( &p );
+    if (*p == '=')
+    {
+        p++;
+        skip_ws( &p );
+        if (!parse_token_or_quoted( &p, &value, NULL ))
+        {
+            free( name );
+            return E_INVALIDARG;
+        }
+    }
+    else if (value_required)
+    {
+        free( name );
+        return E_INVALIDARG;
+    }
+    skip_ws( &p );
+    hr = name_value_create( name, value, &nv );
+    free( name );
+    free( value );
+    if (FAILED(hr)) return hr;
+    *out = (IInspectable *)nv;
+    *ptr = p;
+    return S_OK;
+}
+
+/* ; name=value ; name=value ... up to anything that is not a ';' */
+HRESULT parse_parameters( const WCHAR **ptr, struct vector *params )
+{
+    const WCHAR *p = *ptr;
+    IInspectable *nv;
+    HRESULT hr;
+
+    skip_ws( &p );
+    while (*p == ';')
+    {
+        p++;
+        if (FAILED(hr = parse_name_value( &p, TRUE, &nv ))) return hr;
+        hr = vector_append( params, nv );
+        IInspectable_Release( nv );
+        if (FAILED(hr)) return hr;
+        skip_ws( &p );
+    }
+    *ptr = p;
+    return S_OK;
+}
+
+static void format_filename_star( struct strbuf *buf, const WCHAR *value )
+{
+    char *utf8;
+    int len, i;
+
+    strbuf_appendw( buf, L"UTF-8''" );
+    len = WideCharToMultiByte( CP_UTF8, 0, value, -1, NULL, 0, NULL, NULL );
+    if (!(utf8 = malloc( len ))) return;
+    WideCharToMultiByte( CP_UTF8, 0, value, -1, utf8, len, NULL, NULL );
+    for (i = 0; utf8[i]; i++)
+    {
+        unsigned char c = utf8[i];
+        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr( "!#$&+-.^_`|~", c ))
+            strbuf_appendc( buf, c );
+        else
+            strbuf_appendf( buf, L"%%%02X", c );
+    }
+    free( utf8 );
+}
+
+/* RFC 5987: charset'language'value, the value percent-encoded */
+static WCHAR *decode_filename_star( const WCHAR *str )
+{
+    const WCHAR *quote1, *quote2, *p;
+    char *bytes, *q;
+    UINT codepage;
+    WCHAR charset[32];
+    WCHAR *ret;
+    int len;
+
+    if (!(quote1 = wcschr( str, '\'' )) || !(quote2 = wcschr( quote1 + 1, '\'' ))) return NULL;
+    if (quote1 - str >= ARRAY_SIZE(charset)) return NULL;
+    memcpy( charset, str, (quote1 - str) * sizeof(WCHAR) );
+    charset[quote1 - str] = 0;
+    if (!(codepage = codepage_from_charset( charset ))) codepage = CP_UTF8;
+    if (!(bytes = malloc( wcslen( quote2 ) + 1 ))) return NULL;
+    for (p = quote2 + 1, q = bytes; *p; p++)
+    {
+        if (*p == '%' && iswxdigit( p[1] ) && iswxdigit( p[2] ))
+        {
+            WCHAR hex[3] = { p[1], p[2], 0 };
+            *q++ = (char)wcstoul( hex, NULL, 16 );
+            p += 2;
+        }
+        else if (*p < 0x80) *q++ = (char)*p;
+        else { free( bytes ); return NULL; }
+    }
+    len = MultiByteToWideChar( codepage, 0, bytes, q - bytes, NULL, 0 );
+    if ((ret = malloc( (len + 1) * sizeof(WCHAR) )))
+    {
+        MultiByteToWideChar( codepage, 0, bytes, q - bytes, ret, len );
+        ret[len] = 0;
+    }
+    free( bytes );
+    return ret;
+}
+
+void format_parameters( struct strbuf *buf, struct vector *params, const WCHAR *separator, BOOL disposition )
+{
+    IInspectable **items;
+    UINT32 count, i;
+
+    if (!params || (count = vector_snapshot( params, &items )) == ~0u) return;
+    for (i = 0; i < count; i++)
+    {
+        struct header_value *nv = unsafe_header_value( items[i] );
+
+        strbuf_appendw( buf, separator );
+        if (!nv)
+        {
+            header_value_format( items[i], buf );
+            continue;
+        }
+        AcquireSRWLockShared( &nv->lock );
+        strbuf_appendw( buf, nv->str1 );
+        if (disposition && nv->str1 && !wcscmp( nv->str1, L"filename*" ) && nv->str2)
+        {
+            strbuf_appendc( buf, '=' );
+            format_filename_star( buf, nv->str2 );
+        }
+        else if (nv->str2 && *nv->str2)
+        {
+            BOOL quote = disposition && nv->str1 && (!wcscmp( nv->str1, L"filename" ) || !wcscmp( nv->str1, L"name" ));
+            strbuf_appendc( buf, '=' );
+            format_token_or_quoted( buf, nv->str2, quote );
+        }
+        ReleaseSRWLockShared( &nv->lock );
+        value_Release( &nv->IInspectable_iface );
+    }
+    vector_free_snapshot( items, count );
+}
+
+/*** parsing each kind ***/
+
+static BOOL is_media_type( const WCHAR *str )
+{
+    const WCHAR *p = str;
+    if (!str || !parse_token( &p, NULL ) || *p++ != '/' || !parse_token( &p, NULL )) return FALSE;
+    return !*p;
+}
+
+static BOOL parse_media_type_name( const WCHAR **ptr, WCHAR **out )
+{
+    const WCHAR *p = *ptr, *start;
+
+    skip_ws( &p );
+    start = p;
+    if (!parse_token( &p, NULL )) return FALSE;
+    skip_ws( &p );
+    if (*p++ != '/') return FALSE;
+    skip_ws( &p );
+    if (!parse_token( &p, NULL )) return FALSE;
+    if (!(*out = malloc( (p - start + 1) * sizeof(WCHAR) ))) return FALSE;
+    /* written without the spaces around the slash */
+    {
+        const WCHAR *s;
+        WCHAR *d = *out;
+        for (s = start; s < p; s++) if (!is_ws( *s )) *d++ = *s;
+        *d = 0;
+    }
+    *ptr = p;
+    return TRUE;
+}
+
+static BOOL is_language_range( const WCHAR *str )
+{
+    const WCHAR *p = str;
+    int len;
+
+    if (!wcscmp( str, L"*" )) return TRUE;
+    for (;;)
+    {
+        for (len = 0; iswalnum( *p ) && *p < 0x80; p++) len++;
+        if (!len || len > 8) return FALSE;
+        if (!*p) return TRUE;
+        if (*p++ != '-') return FALSE;
+    }
+}
+
+static BOOL is_cookie_octet( WCHAR c )
+{
+    return c == 0x21 || (c >= 0x23 && c <= 0x2b) || (c >= 0x2d && c <= 0x3a) || (c >= 0x3c && c <= 0x5b) ||
+           (c >= 0x5d && c <= 0x7e);
+}
+
+static BOOL is_token68_char( WCHAR c )
+{
+    return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || (c && wcschr( L"-._~+/", c ));
+}
+
+static HRESULT parse_quality_param( const WCHAR **ptr, struct header_value *impl )
+{
+    const WCHAR *p = *ptr;
+    WCHAR *name = NULL, *value = NULL;
+    BOOL ok;
+
+    skip_ws( &p );
+    if (*p != ';') return S_OK;
+    p++;
+    skip_ws( &p );
+    if (!parse_token( &p, &name )) return E_INVALIDARG;
+    skip_ws( &p );
+    ok = !wcsicmp( name, L"q" ) && *p++ == '=';
+    free( name );
+    if (!ok) return E_INVALIDARG;
+    skip_ws( &p );
+    if (!parse_token( &p, &value )) return E_INVALIDARG;
+    ok = parse_quality( value, &impl->quality );
+    free( value );
+    if (!ok) return E_INVALIDARG;
+    impl->has_quality = TRUE;
+    skip_ws( &p );
+    *ptr = p;
+    return S_OK;
+}
+
+/* auth-params after a scheme, up to a comma that starts something else */
+static HRESULT parse_auth_params( const WCHAR **ptr, struct vector *params )
+{
+    const WCHAR *p = *ptr, *next;
+    IInspectable *nv;
+    HRESULT hr;
+
+    for (;;)
+    {
+        if (FAILED(hr = parse_name_value( &p, TRUE, &nv ))) return hr;
+        hr = vector_append( params, nv );
+        IInspectable_Release( nv );
+        if (FAILED(hr)) return hr;
+        skip_ws( &p );
+        *ptr = p;
+        if (*p != ',') return S_OK;
+        /* another parameter follows if the comma is followed by "name =" */
+        next = p + 1;
+        while (*next == ',' || is_ws( *next )) next++;
+        if (!parse_token( &next, NULL )) return S_OK;
+        skip_ws( &next );
+        if (*next != '=') return S_OK;
+        p++;
+        while (*p == ',' || is_ws( *p )) p++;
+    }
+}
+
+static HRESULT parse_scheme_value( const WCHAR **ptr, struct header_value *impl )
+{
+    const WCHAR *p = *ptr, *start, *after;
+
+    skip_ws( &p );
+    if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+    *ptr = p;
+    if (!is_ws( *p )) return S_OK;
+    skip_ws( &p );
+    if (!*p || *p == ',') { *ptr = p; return S_OK; }
+
+    /* token68, or name=value parameters */
+    start = p;
+    while (is_token68_char( *p )) p++;
+    if (p > start)
+    {
+        while (*p == '=') p++;
+        after = p;
+        skip_ws( &after );
+        if (!*after || *after == ',')
+        {
+            if (!(impl->str2 = malloc( (p - start + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+            memcpy( impl->str2, start, (p - start) * sizeof(WCHAR) );
+            impl->str2[p - start] = 0;
+            *ptr = after;
+            return S_OK;
+        }
+    }
+    p = start;
+    if (FAILED(parse_auth_params( &p, impl->params ))) return E_INVALIDARG;
+    *ptr = p;
+    return S_OK;
+}
+
+static HRESULT parse_value( struct header_value *impl, const WCHAR **ptr )
+{
+    const WCHAR *p = *ptr;
+    WCHAR *text = NULL;
+    HRESULT hr;
+
+    skip_ws( &p );
+    switch (impl->kind)
+    {
+    case VALUE_NAME_VALUE:
+    {
+        IInspectable *nv;
+        struct header_value *parsed;
+        if (FAILED(hr = parse_name_value( &p, FALSE, &nv ))) return hr;
+        parsed = impl_from_IInspectable( nv );
+        impl->str1 = parsed->str1;
+        impl->str2 = parsed->str2;
+        parsed->str1 = parsed->str2 = NULL;
+        IInspectable_Release( nv );
+        break;
+    }
+    case VALUE_MEDIA_TYPE:
+    case VALUE_MEDIA_TYPE_QUALITY:
+        if (!parse_media_type_name( &p, &impl->str1 )) return E_INVALIDARG;
+        if (FAILED(hr = parse_parameters( &p, impl->params ))) return hr;
+        break;
+    case VALUE_CONTENT_CODING:
+    case VALUE_CONNECTION_OPTION:
+        if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+        break;
+    case VALUE_CONTENT_CODING_QUALITY:
+        if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+        if (FAILED(hr = parse_quality_param( &p, impl ))) return hr;
+        break;
+    case VALUE_LANGUAGE_RANGE_QUALITY:
+        if (!parse_token( &p, &impl->str1 ) || !is_language_range( impl->str1 )) return E_INVALIDARG;
+        if (FAILED(hr = parse_quality_param( &p, impl ))) return hr;
+        break;
+    case VALUE_CONTENT_DISPOSITION:
+    {
+        IInspectable **items;
+        UINT32 count, i;
+        if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+        if (FAILED(hr = parse_parameters( &p, impl->params ))) return hr;
+        /* filename* is kept decoded */
+        if ((count = vector_snapshot( impl->params, &items )) != ~0u)
+        {
+            for (i = 0; i < count; i++)
+            {
+                struct header_value *nv = unsafe_header_value( items[i] );
+                if (!nv) continue;
+                if (nv->str1 && !wcsicmp( nv->str1, L"filename*" ) && nv->str2 && (text = decode_filename_star( nv->str2 )))
+                {
+                    free( nv->str2 );
+                    nv->str2 = text;
+                    text = NULL;
+                }
+                value_Release( &nv->IInspectable_iface );
+            }
+            vector_free_snapshot( items, count );
+        }
+        break;
+    }
+    case VALUE_CONTENT_RANGE:
+    {
+        const WCHAR *start;
+        if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+        skip_ws( &p );
+        if (*p == '*') p++;
+        else
+        {
+            for (start = p; *p >= '0' && *p <= '9'; p++) ;
+            if (!parse_uint64( start, p - start, &impl->first )) return E_INVALIDARG;
+            skip_ws( &p );
+            if (*p++ != '-') return E_INVALIDARG;
+            skip_ws( &p );
+            for (start = p; *p >= '0' && *p <= '9'; p++) ;
+            if (!parse_uint64( start, p - start, &impl->last )) return E_INVALIDARG;
+            if (impl->last < impl->first) return E_INVALIDARG;
+            impl->has_first = impl->has_last = TRUE;
+        }
+        skip_ws( &p );
+        if (*p++ != '/') return E_INVALIDARG;
+        skip_ws( &p );
+        if (*p == '*')
+        {
+            p++;
+            if (!impl->has_first) return E_INVALIDARG;
+        }
+        else
+        {
+            for (start = p; *p >= '0' && *p <= '9'; p++) ;
+            if (!parse_uint64( start, p - start, &impl->length )) return E_INVALIDARG;
+            if (impl->has_last && impl->last >= impl->length) return E_INVALIDARG;
+            impl->has_length = TRUE;
+        }
+        break;
+    }
+    case VALUE_COOKIE_PAIR:
+    {
+        const WCHAR *start;
+        if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+        skip_ws( &p );
+        if (*p++ != '=') return E_INVALIDARG;
+        skip_ws( &p );
+        if (*p == '"')
+        {
+            if (!parse_quoted_string( &p, &impl->str2 )) return E_INVALIDARG;
+        }
+        else
+        {
+            for (start = p; is_cookie_octet( *p ); p++) ;
+            if (!(impl->str2 = malloc( (p - start + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+            memcpy( impl->str2, start, (p - start) * sizeof(WCHAR) );
+            impl->str2[p - start] = 0;
+        }
+        break;
+    }
+    case VALUE_CREDENTIALS:
+    case VALUE_CHALLENGE:
+        if (FAILED(hr = parse_scheme_value( &p, impl ))) return hr;
+        break;
+    case VALUE_DATE_OR_DELTA:
+    {
+        const WCHAR *start = p, *end;
+        for (end = p; *end >= '0' && *end <= '9'; end++) ;
+        if (end > start)
+        {
+            const WCHAR *after = end;
+            UINT64 seconds;
+            skip_ws( &after );
+            if (*after && *after != ',') return E_INVALIDARG;
+            if (!parse_uint64( start, end - start, &seconds )) return E_INVALIDARG;
+            impl->delta.Duration = seconds * 10000000;
+            p = after;
+        }
+        else
+        {
+            /* a date has commas of its own: it is the rest of the string */
+            if (!parse_http_date( p, &impl->date )) return E_INVALIDARG;
+            impl->is_date = TRUE;
+            p += wcslen( p );
+        }
+        break;
+    }
+    case VALUE_EXPECTATION:
+        if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+        skip_ws( &p );
+        if (*p == '=')
+        {
+            p++;
+            skip_ws( &p );
+            if (!parse_token_or_quoted( &p, &impl->str2, NULL )) return E_INVALIDARG;
+        }
+        if (FAILED(hr = parse_parameters( &p, impl->params ))) return hr;
+        break;
+    case VALUE_PRODUCT:
+        if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+        if (*p == '/')
+        {
+            p++;
+            if (!parse_token( &p, &impl->str2 )) return E_INVALIDARG;
+        }
+        break;
+    case VALUE_PRODUCT_INFO:
+        if (*p == '(')
+        {
+            if (!parse_comment( &p, &impl->str2 )) return E_INVALIDARG;
+        }
+        else
+        {
+            struct header_value *product;
+            if (FAILED(hr = value_create( VALUE_PRODUCT, &product ))) return hr;
+            if (FAILED(hr = parse_value( product, &p )))
+            {
+                value_Release( &product->IInspectable_iface );
+                return hr;
+            }
+            impl->product = (IHttpProductHeaderValue *)&product->IInspectable_iface;
+        }
+        break;
+    case VALUE_TRANSFER_CODING:
+        if (!parse_token( &p, &impl->str1 )) return E_INVALIDARG;
+        if (FAILED(hr = parse_parameters( &p, impl->params ))) return hr;
+        break;
+    default:
+        return E_INVALIDARG;
+    }
+    skip_ws( &p );
+    *ptr = p;
+    return S_OK;
+}
+
+HRESULT header_value_parse( enum value_kind kind, const WCHAR **ptr, IInspectable **out )
+{
+    struct header_value *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (FAILED(hr = value_create( kind, &impl ))) return hr;
+    if (FAILED(hr = parse_value( impl, ptr )))
+    {
+        value_Release( &impl->IInspectable_iface );
+        return E_INVALIDARG;
+    }
+    *out = &impl->IInspectable_iface;
+    return S_OK;
+}
+
+HRESULT header_value_parse_all( enum value_kind kind, const WCHAR *str, IInspectable **out )
+{
+    const WCHAR *p = str;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!str) return E_INVALIDARG;
+    if (FAILED(hr = header_value_parse( kind, &p, out ))) return hr;
+    skip_ws( &p );
+    if (*p)
+    {
+        IInspectable_Release( *out );
+        *out = NULL;
+        return E_INVALIDARG;
+    }
+    return S_OK;
+}
+
+/*** writing each kind ***/
+
+static void format_scheme_value( struct strbuf *buf, struct header_value *impl )
+{
+    strbuf_appendw( buf, impl->str1 );
+    if (impl->str2)
+    {
+        strbuf_appendc( buf, ' ' );
+        strbuf_appendw( buf, impl->str2 );
+    }
+    if (impl->params->size)
+    {
+        struct strbuf params;
+        strbuf_init( &params );
+        format_parameters( &params, impl->params, L", ", FALSE );
+        if (params.len > 2)
+        {
+            strbuf_appendc( buf, ' ' );
+            strbuf_append( buf, params.data + 2, params.len - 2 );
+        }
+        strbuf_free( &params );
+    }
+}
+
+void header_value_format( IInspectable *value, struct strbuf *buf )
+{
+    struct header_value *impl = unsafe_header_value( value );
+
+    if (!impl)
+    {
+        IStringable *stringable;
+        HSTRING str;
+        if (SUCCEEDED(IInspectable_QueryInterface( value, &IID_IStringable, (void **)&stringable )))
+        {
+            if (SUCCEEDED(IStringable_ToString( stringable, &str )))
+            {
+                strbuf_append_hstring( buf, str );
+                WindowsDeleteString( str );
+            }
+            IStringable_Release( stringable );
+        }
+        return;
+    }
+
+    AcquireSRWLockShared( &impl->lock );
+    switch (impl->kind)
+    {
+    case VALUE_NAME_VALUE:
+        strbuf_appendw( buf, impl->str1 );
+        if (impl->str2 && *impl->str2)
+        {
+            strbuf_appendc( buf, '=' );
+            format_token_or_quoted( buf, impl->str2, FALSE );
+        }
+        break;
+    case VALUE_MEDIA_TYPE:
+    case VALUE_MEDIA_TYPE_QUALITY:
+    case VALUE_TRANSFER_CODING:
+        strbuf_appendw( buf, impl->str1 );
+        format_parameters( buf, impl->params, L"; ", FALSE );
+        break;
+    case VALUE_CONTENT_DISPOSITION:
+        strbuf_appendw( buf, impl->str1 );
+        format_parameters( buf, impl->params, L"; ", TRUE );
+        break;
+    case VALUE_CONTENT_CODING:
+    case VALUE_CONNECTION_OPTION:
+        strbuf_appendw( buf, impl->str1 );
+        break;
+    case VALUE_CONTENT_CODING_QUALITY:
+    case VALUE_LANGUAGE_RANGE_QUALITY:
+        strbuf_appendw( buf, impl->str1 );
+        if (impl->has_quality)
+        {
+            strbuf_appendw( buf, L"; q=" );
+            format_quality( buf, impl->quality );
+        }
+        break;
+    case VALUE_CONTENT_RANGE:
+        strbuf_appendw( buf, impl->str1 );
+        strbuf_appendc( buf, ' ' );
+        if (impl->has_first) strbuf_appendf( buf, L"%I64u-%I64u", impl->first, impl->last );
+        else strbuf_appendc( buf, '*' );
+        strbuf_appendc( buf, '/' );
+        if (impl->has_length) strbuf_appendf( buf, L"%I64u", impl->length );
+        else strbuf_appendc( buf, '*' );
+        break;
+    case VALUE_COOKIE_PAIR:
+        strbuf_appendw( buf, impl->str1 );
+        strbuf_appendc( buf, '=' );
+        strbuf_appendw( buf, impl->str2 );
+        break;
+    case VALUE_CREDENTIALS:
+    case VALUE_CHALLENGE:
+        format_scheme_value( buf, impl );
+        break;
+    case VALUE_DATE_OR_DELTA:
+        if (impl->is_date) format_http_date( buf, impl->date );
+        else strbuf_appendf( buf, L"%I64u", impl->delta.Duration / 10000000 );
+        break;
+    case VALUE_EXPECTATION:
+        strbuf_appendw( buf, impl->str1 );
+        if (impl->str2 && *impl->str2)
+        {
+            strbuf_appendc( buf, '=' );
+            format_token_or_quoted( buf, impl->str2, FALSE );
+        }
+        format_parameters( buf, impl->params, L"; ", FALSE );
+        break;
+    case VALUE_PRODUCT:
+        strbuf_appendw( buf, impl->str1 );
+        if (impl->str2 && *impl->str2)
+        {
+            strbuf_appendc( buf, '/' );
+            strbuf_appendw( buf, impl->str2 );
+        }
+        break;
+    case VALUE_PRODUCT_INFO:
+        if (impl->product) header_value_format( (IInspectable *)impl->product, buf );
+        else format_comment( buf, impl->str2 );
+        break;
+    default:
+        break;
+    }
+    ReleaseSRWLockShared( &impl->lock );
+    value_Release( &impl->IInspectable_iface );
+}
