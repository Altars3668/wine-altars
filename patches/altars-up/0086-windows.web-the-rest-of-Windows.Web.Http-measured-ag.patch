+static HRESULT append_hstrings( struct headers *impl, HSTRING name, HSTRING value )
+{
+    WCHAR *n = NULL, *v;
+    HRESULT hr;
+
+    if ((name && !(n = hstring_dup( name ))) || !(v = hstring_dup( value )))
+    {
+        free( n );
+        return E_OUTOFMEMORY;
+    }
+    hr = headers_append( impl, n, v );
+    free( n );
+    free( v );
+    return hr;
+}
+
+static HRESULT try_append_hstrings( struct headers *impl, HSTRING name, HSTRING value, boolean *result )
+{
+    WCHAR *n = NULL, *v;
+    HRESULT hr;
+
+    if ((name && !(n = hstring_dup( name ))) || !(v = hstring_dup( value )))
+    {
+        free( n );
+        return E_OUTOFMEMORY;
+    }
+    if (!n)
+    {
+        free( v );
+        if (!result) return E_POINTER;
+        *result = FALSE;
+        return S_OK;
+    }
+    hr = headers_try_append( impl, n, v, result );
+    free( n );
+    free( v );
+    return hr;
+}
