+static HRESULT WINAPI map_Lookup( IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING *value )
+{
+    struct headers *impl = impl_from_IMap_HSTRING_HSTRING( iface );
+    struct header_entry *entry;
+    WCHAR *name, *text = NULL;
+    HRESULT hr;
+
+    TRACE( "iface %p, key %s, value %p.\n", iface, debugstr_hstring( key ), value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(name = hstring_dup( key ))) return E_OUTOFMEMORY;
+    EnterCriticalSection( &impl->cs );
+    sync_lists( impl );
+    if ((entry = find_entry( impl, name ))) text = entry_text( entry );
+    LeaveCriticalSection( &impl->cs );
+    free( name );
+    if (!text) return E_BOUNDS;
+    hr = hstring_create( *text ? text : NULL, value );
+    free( text );
+    return hr;
+}
