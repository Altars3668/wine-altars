+static HRESULT WINAPI filter4_add_ServerCustomValidationRequested( IHttpBaseProtocolFilter4 *iface,
+        ITypedEventHandler_HttpBaseProtocolFilter_HttpServerCustomValidationRequestedEventArgs *handler,
+        EventRegistrationToken *token )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter4( iface );
+    struct validation_handler *entry;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!handler || !token) return E_POINTER;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    ITypedEventHandler_HttpBaseProtocolFilter_HttpServerCustomValidationRequestedEventArgs_AddRef( (entry->handler = handler) );
+    EnterCriticalSection( &impl->cs );
+    entry->token.value = ++impl->next_token;
+    list_add_tail( &impl->validation_handlers, &entry->entry );
+    LeaveCriticalSection( &impl->cs );
+    *token = entry->token;
+    /* a Certificate for its event arguments is not there to give */
+    FIXME( "the handler will not be called.\n" );
+    return S_OK;
+}
+
+static HRESULT WINAPI filter4_remove_ServerCustomValidationRequested( IHttpBaseProtocolFilter4 *iface,
+                                                                      EventRegistrationToken token )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter4( iface );
+    struct validation_handler *entry, *found = NULL;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( entry, &impl->validation_handlers, struct validation_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (found)
+    {
+        ITypedEventHandler_HttpBaseProtocolFilter_HttpServerCustomValidationRequestedEventArgs_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI filter4_ClearAuthenticationCache( IHttpBaseProtocolFilter4 *iface )
+{
+    struct filter *impl = impl_from_IHttpBaseProtocolFilter4( iface );
+    HINTERNET session;
+
+    TRACE( "iface %p.\n", iface );
+
+    /* credentials WinINet remembered belong to the session: start a new one */
+    EnterCriticalSection( &impl->cs );
+    session = impl->session;
+    impl->session = NULL;
+    LeaveCriticalSection( &impl->cs );
+    if (session) InternetCloseHandle( session );
+    return S_OK;
+}
