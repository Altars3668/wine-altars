+/* the default headers the request does not have already */
+static HRESULT merge_default_headers( struct http_client *impl, IHttpRequestMessage *request )
+{
+    IHttpRequestHeaderCollection *collection;
+    struct headers *headers;
+    WCHAR **names, **values;
+    UINT32 count, i;
+    HRESULT hr;
+
+    if (FAILED(hr = IHttpRequestMessage_get_Headers( request, &collection ))) return hr;
+    if ((headers = headers_from_request_collection( collection )) &&
+        (count = headers_snapshot( impl->default_headers, &names, &values )) != ~0u)
+    {
+        for (i = 0; i < count; i++)
+            if (!headers_has( headers, names[i] )) headers_set_parsed( headers, names[i], values[i] );
+        headers_free_snapshot( names, values, count );
+    }
+    IHttpRequestHeaderCollection_Release( collection );
+    return S_OK;
+}
+
+static HRESULT send_work( struct async_op *op, void *context, union async_value *result )
+{
+    struct send_context *send = context;
+    IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *inner;
+    IHttpResponseMessage *response = NULL;
+    IHttpContent *content = NULL;
+    union async_value value = {0};
+    AsyncStatus status;
+    HRESULT hr, error;
+
+    if (FAILED(hr = IHttpFilter_SendRequestAsync( send->filter, send->request, &inner ))) goto done;
+    status = async_wait( op, (IUnknown *)inner, TRUE,
+                         &IID_IAsyncOperationWithProgressCompletedHandler_HttpResponseMessage_HttpProgress,
+                         &IID_IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress, &error );
+    if (status == Completed) hr = IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress_GetResults( inner, &response );
+    else hr = status == Canceled ? E_ABORT : error;
+    IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress_Release( inner );
+    if (FAILED(hr)) goto done;
+    if (!response)
+    {
+        hr = E_UNEXPECTED;
+        goto done;
+    }
+
+    IHttpResponseMessage_get_Content( response, &content );
+    if (content && send->option == HttpCompletionOption_ResponseContentRead &&
+        FAILED(hr = content_buffer_all( content, op, NULL )))
+        goto done;
+
+    if (send->kind != RESULT_RESPONSE)
+    {
+        IHttpResponseMessage *checked;
+        if (FAILED(hr = IHttpResponseMessage_EnsureSuccessStatusCode( response, &checked ))) goto done;
+        IHttpResponseMessage_Release( checked );
+        if (!content) hr = E_UNEXPECTED;
+        else if (send->kind == RESULT_STRING)
+        {
+            IAsyncOperationWithProgress_HSTRING_UINT64 *string_op;
+            if (SUCCEEDED(hr = IHttpContent_ReadAsStringAsync( content, &string_op )))
+            {
+                status = async_wait( op, (IUnknown *)string_op, TRUE,
+                                     &IID_IAsyncOperationWithProgressCompletedHandler_HSTRING_UINT64, NULL, &error );
+                if (status == Completed) hr = IAsyncOperationWithProgress_HSTRING_UINT64_GetResults( string_op, &value.string );
+                else hr = status == Canceled ? E_ABORT : error;
+                IAsyncOperationWithProgress_HSTRING_UINT64_Release( string_op );
+            }
+        }
+        else if (send->kind == RESULT_BUFFER)
+        {
+            IAsyncOperationWithProgress_IBuffer_UINT64 *buffer_op;
+            if (SUCCEEDED(hr = IHttpContent_ReadAsBufferAsync( content, &buffer_op )))
+            {
+                status = async_wait( op, (IUnknown *)buffer_op, TRUE,
+                                     &IID_IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT64, NULL, &error );
+                if (status == Completed)
+                    hr = IAsyncOperationWithProgress_IBuffer_UINT64_GetResults( buffer_op, (IBuffer **)&value.object );
+                else hr = status == Canceled ? E_ABORT : error;
+                IAsyncOperationWithProgress_IBuffer_UINT64_Release( buffer_op );
+            }
+        }
+        else
+        {
+            IAsyncOperationWithProgress_IInputStream_UINT64 *stream_op;
+            if (SUCCEEDED(hr = IHttpContent_ReadAsInputStreamAsync( content, &stream_op )))
+            {
+                status = async_wait( op, (IUnknown *)stream_op, TRUE,
+                                     &IID_IAsyncOperationWithProgressCompletedHandler_IInputStream_UINT64, NULL, &error );
+                if (status == Completed)
+                    hr = IAsyncOperationWithProgress_IInputStream_UINT64_GetResults( stream_op, (IInputStream **)&value.object );
+                else hr = status == Canceled ? E_ABORT : error;
+                IAsyncOperationWithProgress_IInputStream_UINT64_Release( stream_op );
+            }
+        }
+    }
+
+done:
+    if (content) IHttpContent_Release( content );
+    if (send->try_result)
+    {
+        /* the Try methods complete, and say what went wrong in the result */
+        HRESULT result_hr = result_create( send->kind, hr, send->request, response, SUCCEEDED(hr) ? &value : NULL,
+                                           &result->object );
+        if (send->kind == RESULT_STRING) WindowsDeleteString( value.string );
+        else if (value.object) IUnknown_Release( value.object );
+        if (response) IHttpResponseMessage_Release( response );
+        return result_hr;
+    }
+    if (FAILED(hr))
+    {
+        if (send->kind == RESULT_STRING) WindowsDeleteString( value.string );
+        else if (value.object) IUnknown_Release( value.object );
+        if (response) IHttpResponseMessage_Release( response );
+        return hr;
+    }
+    if (send->kind == RESULT_RESPONSE) result->object = (IUnknown *)response;
+    else
+    {
+        *result = value;
+        IHttpResponseMessage_Release( response );
+    }
+    return S_OK;
+}
