+HRESULT buffer_create( const BYTE *data, UINT32 len, IBuffer **out )
+{
+    struct buffer *impl;
+
+    if (!(impl = calloc( 1, offsetof( struct buffer, data[len] ) ))) return E_OUTOFMEMORY;
+    impl->IBuffer_iface.lpVtbl = &buffer_vtbl;
+    impl->IBufferByteAccess_iface.lpVtbl = &byte_access_vtbl;
+    impl->ref = 1;
+    impl->capacity = impl->length = len;
