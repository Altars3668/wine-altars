+    struct strbuf buf;
+    double quality;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return name_value_list_set( impl->params, L"q", NULL, TRUE );
+    if (FAILED(hr = IReference_DOUBLE_get_Value( value, &quality ))) return hr;
+    strbuf_init( &buf );
+    format_quality( &buf, quality );
+    hr = buf.failed ? E_OUTOFMEMORY : name_value_list_set( impl->params, L"q", buf.data, FALSE );
+    strbuf_free( &buf );
+    return hr;
