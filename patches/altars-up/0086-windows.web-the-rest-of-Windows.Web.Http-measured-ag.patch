+    impl->validate = validate;
+    *out = (IInspectable *)&impl->IVector_ChainValidationResult_iface;
+    return S_OK;
+}
+
+HRESULT enum_vector_view_create( const UINT32 *values, UINT32 count, IInspectable **out )
+{
+    struct enum_vector *impl;
+    HRESULT hr;
+
+    if (FAILED(hr = enum_vector_alloc( &impl ))) return hr;
+    impl->is_view = TRUE;
+    if (count && !enum_vector_grow( impl, count ))
+    {
+        enum_vector_Release( &impl->IVector_ChainValidationResult_iface );
+        return E_OUTOFMEMORY;
+    }
+    if (count) memcpy( impl->values, values, count * sizeof(*values) );
+    impl->size = count;
+    *out = (IInspectable *)&impl->IVectorView_ChainValidationResult_iface;
+    return S_OK;
+}
+
+/* the values of one of our vectors or views, as they are now */
+UINT32 enum_vector_snapshot( IInspectable *vector, UINT32 **values )
+{
+    struct enum_vector *impl;
+    UINT32 count;
+
+    if (((IVector_ChainValidationResult *)vector)->lpVtbl == &enum_vector_vtbl)
+        impl = impl_from_IVector_ChainValidationResult( (IVector_ChainValidationResult *)vector );
+    else if (((IVectorView_ChainValidationResult *)vector)->lpVtbl == &enum_view_vtbl)
+        impl = impl_from_IVectorView_ChainValidationResult( (IVectorView_ChainValidationResult *)vector );
+    else
+    {
+        *values = NULL;
+        return 0;
+    }
+
+    EnterCriticalSection( &impl->cs );
+    count = impl->size;
+    if ((*values = malloc( max( count, 1 ) * sizeof(**values) ))) memcpy( *values, impl->values, count * sizeof(**values) );
+    else count = 0;
+    LeaveCriticalSection( &impl->cs );
+    return count;
+}
