+/* the URL WinINet files a cookie under */
+static WCHAR *cookie_url( struct http_cookie *impl )
+{
+    struct strbuf buf;
+    const WCHAR *domain;
+
+    strbuf_init( &buf );
+    strbuf_appendw( &buf, impl->secure ? L"https://" : L"http://" );
+    domain = WindowsGetStringRawBuffer( impl->domain, NULL );
+    while (*domain == '.') domain++;
+    strbuf_appendw( &buf, domain );
+    if (hstring_is_empty( impl->path )) strbuf_appendc( &buf, '/' );
+    else strbuf_append_hstring( &buf, impl->path );
+    if (buf.failed) strbuf_free( &buf );
+    return buf.data;
+}
+
+static BOOL cookie_exists( const WCHAR *url, HSTRING name )
+{
+    DWORD size = 0;
+    return InternetGetCookieExW( url, WindowsGetStringRawBuffer( name, NULL ), NULL, &size, INTERNET_COOKIE_HTTPONLY, NULL )
+           && size;
+}
+
+static HRESULT set_cookie( IHttpCookie *cookie, BOOL third_party, BOOL remove, boolean *replaced )
+{
+    struct http_cookie *impl;
+    struct strbuf data;
+    WCHAR *url;
+    DWORD flags = INTERNET_COOKIE_HTTPONLY;
+    HRESULT hr = S_OK;
+
+    if (!cookie) return E_POINTER;
+    if (cookie->lpVtbl != &cookie_vtbl) return E_INVALIDARG;
+    impl = impl_from_IHttpCookie( cookie );
+    if (third_party) flags |= INTERNET_COOKIE_THIRD_PARTY;
+    if (!(url = cookie_url( impl ))) return E_OUTOFMEMORY;
+    if (replaced) *replaced = cookie_exists( url, impl->name );
+
+    strbuf_init( &data );
+    EnterCriticalSection( &impl->cs );
+    strbuf_append_hstring( &data, impl->value );
+    if (!hstring_is_empty( impl->path ))
+    {
+        strbuf_appendw( &data, L"; path=" );
+        strbuf_append_hstring( &data, impl->path );
+    }
+    if (!hstring_is_empty( impl->domain ) && *WindowsGetStringRawBuffer( impl->domain, NULL ) == '.')
+    {
+        strbuf_appendw( &data, L"; domain=" );
+        strbuf_append_hstring( &data, impl->domain );
+    }
+    if (remove) strbuf_appendw( &data, L"; expires=Thu, 01 Jan 1970 00:00:00 GMT" );
+    else if (impl->has_expires)
+    {
+        strbuf_appendw( &data, L"; expires=" );
+        format_http_date( &data, impl->expires );
+    }
+    if (impl->secure) strbuf_appendw( &data, L"; secure" );
+    if (impl->http_only) strbuf_appendw( &data, L"; httponly" );
+    LeaveCriticalSection( &impl->cs );
+
+    if (data.failed) hr = E_OUTOFMEMORY;
+    else if (!InternetSetCookieExW( url, WindowsGetStringRawBuffer( impl->name, NULL ), data.data ? data.data : L"", flags, 0 ))
+    {
+        WARN( "InternetSetCookieEx %s failed, error %lu.\n", debugstr_w( url ), GetLastError() );
+        if (!remove) hr = HRESULT_FROM_WIN32( GetLastError() ? GetLastError() : ERROR_INVALID_PARAMETER );
+    }
+    strbuf_free( &data );
+    free( url );
+    return hr;
+}
