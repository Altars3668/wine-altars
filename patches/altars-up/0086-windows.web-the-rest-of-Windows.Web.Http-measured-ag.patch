+      &IID_IIterator_HttpProductInfoHeaderValue, VALUE_PRODUCT_INFO, L" " },
+    { L"Windows.Web.Http.Headers.HttpMethodHeaderValueCollection",
+      &IID_IHttpMethodHeaderValueCollection, &IID_IVector_HttpMethod,
+      &IID_IVectorView_HttpMethod, &IID_IIterable_HttpMethod,
+      &IID_IIterator_HttpMethod, VALUE_KIND_COUNT, L", " },
+    { L"Windows.Web.Http.Headers.HttpChallengeHeaderValueCollection",
+      &IID_IHttpChallengeHeaderValueCollection, &IID_IVector_HttpChallengeHeaderValue,
+      &IID_IVectorView_HttpChallengeHeaderValue, &IID_IIterable_HttpChallengeHeaderValue,
+      &IID_IIterator_HttpChallengeHeaderValue, VALUE_CHALLENGE, L", " },
