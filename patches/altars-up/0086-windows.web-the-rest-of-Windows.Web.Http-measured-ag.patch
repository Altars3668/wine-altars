+
+static HRESULT WINAPI manager_GetCookies( IHttpCookieManager *iface, IUriRuntimeClass *uri, IVectorView_HttpCookie **value )
+{
+    HSTRING host = NULL, path = NULL, name, str;
+    IInspectable **items = NULL;
+    IHttpCookie *cookie;
+    UINT32 count = 0, capacity = 0;
+    WCHAR *url, *data = NULL, *p, *next, *eq;
+    DWORD size = 0;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, uri %p, value %p.\n", iface, uri, value );
+
+    if (!uri || !value) return E_POINTER;
+    *value = NULL;
+    if (!(url = uri_to_string( uri ))) return E_OUTOFMEMORY;
+    if (InternetGetCookieExW( url, NULL, NULL, &size, INTERNET_COOKIE_HTTPONLY, NULL ) && size &&
+        (data = malloc( (size + 1) * sizeof(WCHAR) )) &&
+        !InternetGetCookieExW( url, NULL, data, &size, INTERNET_COOKIE_HTTPONLY, NULL ))
+    {
+        free( data );
+        data = NULL;
+    }
+    free( url );
+    IUriRuntimeClass_get_Host( uri, &host );
+    hstring_create( L"/", &path );
+
+    for (p = data; p && *p && SUCCEEDED(hr); p = next)
+    {
+        while (*p == ' ') p++;
+        if (!(next = wcschr( p, ';' ))) next = p + wcslen( p );
+        else *next++ = 0;
+        if (!*p) continue;
+        if ((eq = wcschr( p, '=' ))) *eq++ = 0;
+        if (FAILED(hr = hstring_create( p, &name ))) break;
+        hr = cookie_create( name, host, path, &cookie );
+        WindowsDeleteString( name );
+        if (FAILED(hr)) break;
+        if (eq && SUCCEEDED(hstring_create( eq, &str )))
+        {
+            cookie_put_Value( cookie, str );
+            WindowsDeleteString( str );
+        }
+        if (count == capacity)
+        {
+            IInspectable **tmp;
+            capacity = max( 8, capacity * 2 );
+            if (!(tmp = realloc( items, capacity * sizeof(*items) )))
+            {
+                IHttpCookie_Release( cookie );
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            items = tmp;
+        }
+        items[count++] = (IInspectable *)cookie;
+    }
+    free( data );
+    WindowsDeleteString( host );
+    WindowsDeleteString( path );
+    if (FAILED(hr))
+    {
+        vector_free_snapshot( items, count );
+        return hr;
+    }
+    if (!items && !(items = malloc( sizeof(*items) ))) return E_OUTOFMEMORY;
+    return vector_view_create( &cookie_collection_desc, items, count, (IInspectable **)value );
+}
