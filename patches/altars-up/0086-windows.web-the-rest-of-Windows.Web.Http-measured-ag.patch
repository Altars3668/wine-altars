-#include "private.h"
-#include "wine/debug.h"
-#include "wine/list.h"
-
-WINE_DEFAULT_DEBUG_CHANNEL(web);
-
-/*
- * The request, response and content header collections are each an
- * IMap<HSTRING, HSTRING> with typed accessors layered on top, and a caller
- * that just wants to read or set a header reaches them as the map.  That map
- * is what this is.  wintypes has one for IInspectable values, which is the
- * wrong value type and not exported besides, so this is the string one, kept
- * in one place rather than written out three times.
- *
- * Header names are compared without regard to case, as the protocol says, but
- * the name a caller inserted is the name given back.
- */
-
-struct entry
-{
-    struct list link;
-    HSTRING key;
-    HSTRING value;
-};
-
-struct string_map
-{
-    IMap_HSTRING_HSTRING IMap_HSTRING_HSTRING_iface;
-    IIterable_IKeyValuePair_HSTRING_HSTRING IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
-    LONG ref;
-    CRITICAL_SECTION cs;
-    struct list entries;
-};
-
-static inline struct string_map *impl_from_IMap_HSTRING_HSTRING( IMap_HSTRING_HSTRING *iface )
-{
-    return CONTAINING_RECORD( iface, struct string_map, IMap_HSTRING_HSTRING_iface );
-}
-
-static struct entry *find_entry( struct string_map *impl, HSTRING key )
-{
-    const WCHAR *name = WindowsGetStringRawBuffer( key, NULL );
-    struct entry *entry;
-
-    if (!name) return NULL;
-    LIST_FOR_EACH_ENTRY( entry, &impl->entries, struct entry, link )
-        if (!wcsicmp( WindowsGetStringRawBuffer( entry->key, NULL ), name )) return entry;
-    return NULL;
-}
-
-static HRESULT WINAPI map_QueryInterface( IMap_HSTRING_HSTRING *iface, REFIID iid, void **out )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-
-    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
-
-    if (IsEqualGUID( iid, &IID_IUnknown ) ||
-        IsEqualGUID( iid, &IID_IInspectable ) ||
-        IsEqualGUID( iid, &IID_IAgileObject ) ||
-        IsEqualGUID( iid, &IID_IMap_HSTRING_HSTRING ))
-    {
-        *out = &impl->IMap_HSTRING_HSTRING_iface;
-        IInspectable_AddRef( (*out) );
-        return S_OK;
-    }
-
-    if (IsEqualGUID( iid, &IID_IIterable_IKeyValuePair_HSTRING_HSTRING ))
-    {
-        *out = &impl->IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
-        IInspectable_AddRef( (*out) );
-        return S_OK;
-    }
-
-    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
-    *out = NULL;
-    return E_NOINTERFACE;
-}
-
-static ULONG WINAPI map_AddRef( IMap_HSTRING_HSTRING *iface )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-    return InterlockedIncrement( &impl->ref );
-}
-
-static ULONG WINAPI map_Release( IMap_HSTRING_HSTRING *iface )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-    ULONG ref = InterlockedDecrement( &impl->ref );
-
-    if (!ref)
-    {
-        struct entry *entry, *next;
-
-        LIST_FOR_EACH_ENTRY_SAFE( entry, next, &impl->entries, struct entry, link )
-        {
-            list_remove( &entry->link );
-            WindowsDeleteString( entry->key );
-            WindowsDeleteString( entry->value );
-            free( entry );
-        }
-        impl->cs.DebugInfo->Spare[0] = 0;
-        DeleteCriticalSection( &impl->cs );
-        free( impl );
-    }
-    return ref;
-}
-
-static HRESULT WINAPI map_GetIids( IMap_HSTRING_HSTRING *iface, ULONG *iid_count, IID **iids )
-{
-    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
-    return E_NOTIMPL;
-}
-
-static HRESULT WINAPI map_GetRuntimeClassName( IMap_HSTRING_HSTRING *iface, HSTRING *class_name )
-{
-    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
-    return E_NOTIMPL;
-}
-
-static HRESULT WINAPI map_GetTrustLevel( IMap_HSTRING_HSTRING *iface, TrustLevel *trust_level )
-{
-    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
-    return E_NOTIMPL;
-}
-
-static HRESULT WINAPI map_Lookup( IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING *value )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-    struct entry *entry;
-    HRESULT hr;
-
-    TRACE( "iface %p, key %s, value %p.\n", iface, debugstr_hstring( key ), value );
-
-    if (!value) return E_POINTER;
-    *value = NULL;
-
-    EnterCriticalSection( &impl->cs );
-    if ((entry = find_entry( impl, key ))) hr = WindowsDuplicateString( entry->value, value );
-    else hr = E_BOUNDS;
-    LeaveCriticalSection( &impl->cs );
-    return hr;
-}
-
-static HRESULT WINAPI map_get_Size( IMap_HSTRING_HSTRING *iface, UINT32 *value )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-
-    TRACE( "iface %p, value %p.\n", iface, value );
-
-    if (!value) return E_POINTER;
-    EnterCriticalSection( &impl->cs );
-    *value = list_count( &impl->entries );
-    LeaveCriticalSection( &impl->cs );
-    return S_OK;
-}
-
-static HRESULT WINAPI map_HasKey( IMap_HSTRING_HSTRING *iface, HSTRING key, boolean *value )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-
-    TRACE( "iface %p, key %s, value %p.\n", iface, debugstr_hstring( key ), value );
-
-    if (!value) return E_POINTER;
-    EnterCriticalSection( &impl->cs );
-    *value = find_entry( impl, key ) != NULL;
-    LeaveCriticalSection( &impl->cs );
-    return S_OK;
-}
-
-static HRESULT WINAPI map_GetView( IMap_HSTRING_HSTRING *iface, IMapView_HSTRING_HSTRING **value )
-{
-    FIXME( "iface %p, value %p: a read-only view is not implemented.\n", iface, value );
-    if (value) *value = NULL;
-    return E_NOTIMPL;
-}
-
-static HRESULT WINAPI map_Insert( IMap_HSTRING_HSTRING *iface, HSTRING key, HSTRING value, boolean *replaced )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-    struct entry *entry;
-    HSTRING copy = NULL;
-    HRESULT hr;
-
-    TRACE( "iface %p, key %s, value %s, replaced %p.\n", iface, debugstr_hstring( key ),
-           debugstr_hstring( value ), replaced );
-
-    if (!key || !WindowsGetStringLen( key )) return E_INVALIDARG;
-    if (FAILED(hr = WindowsDuplicateString( value, &copy ))) return hr;
-
-    EnterCriticalSection( &impl->cs );
-    if ((entry = find_entry( impl, key )))
-    {
-        WindowsDeleteString( entry->value );
-        entry->value = copy;
-        if (replaced) *replaced = TRUE;
-        hr = S_OK;
-    }
-    else if (!(entry = calloc( 1, sizeof(*entry) )))
-    {
-        WindowsDeleteString( copy );
-        hr = E_OUTOFMEMORY;
-    }
-    else if (FAILED(hr = WindowsDuplicateString( key, &entry->key )))
-    {
-        WindowsDeleteString( copy );
-        free( entry );
-    }
-    else
-    {
-        entry->value = copy;
-        list_add_tail( &impl->entries, &entry->link );
-        if (replaced) *replaced = FALSE;
-    }
-    LeaveCriticalSection( &impl->cs );
-    return hr;
-}
-
-static HRESULT WINAPI map_Remove( IMap_HSTRING_HSTRING *iface, HSTRING key )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-    struct entry *entry;
-    HRESULT hr = E_BOUNDS;
-
-    TRACE( "iface %p, key %s.\n", iface, debugstr_hstring( key ) );
-
-    EnterCriticalSection( &impl->cs );
-    if ((entry = find_entry( impl, key )))
-    {
-        list_remove( &entry->link );
-        WindowsDeleteString( entry->key );
-        WindowsDeleteString( entry->value );
-        free( entry );
-        hr = S_OK;
-    }
-    LeaveCriticalSection( &impl->cs );
-    return hr;
-}
-
-static HRESULT WINAPI map_Clear( IMap_HSTRING_HSTRING *iface )
-{
-    struct string_map *impl = impl_from_IMap_HSTRING_HSTRING( iface );
-    struct entry *entry, *next;
-
-    TRACE( "iface %p.\n", iface );
-
-    EnterCriticalSection( &impl->cs );
-    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &impl->entries, struct entry, link )
-    {
-        list_remove( &entry->link );
-        WindowsDeleteString( entry->key );
-        WindowsDeleteString( entry->value );
-        free( entry );
-    }
-    LeaveCriticalSection( &impl->cs );
-    return S_OK;
-}
-
-static const struct IMap_HSTRING_HSTRINGVtbl map_vtbl =
-{
-    map_QueryInterface,
-    map_AddRef,
-    map_Release,
-    /* IInspectable methods */
-    map_GetIids,
-    map_GetRuntimeClassName,
-    map_GetTrustLevel,
-    /* IMap<HSTRING, HSTRING> methods */
-    map_Lookup,
