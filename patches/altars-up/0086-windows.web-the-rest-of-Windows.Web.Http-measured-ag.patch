+static HRESULT WINAPI map_Clear( IMap_HSTRING_HSTRING *iface )
+{
+    struct headers *impl = impl_from_IMap_HSTRING_HSTRING( iface );
+    struct header_entry *entry, *next;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, &impl->entries, struct header_entry, entry )
+        free_entry( impl, entry );
+    /* an emptied map starts over with as many bins as a new one */
+    free( impl->bins );
+    impl->bins = NULL;
+    impl->bin_count = pick_bin_count( 0 );
+    update_thresholds( impl );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
