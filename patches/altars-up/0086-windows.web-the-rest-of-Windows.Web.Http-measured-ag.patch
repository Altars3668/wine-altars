+/* Makes sure the whole body is in memory. */
+static HRESULT content_load( struct http_content *impl, struct async_op *op )
+{
+    BYTE *data = NULL, *bytes;
+    UINT64 size = 0;
+    UINT32 len;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->loaded)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return S_OK;
+    }
+    switch (impl->kind)
+    {
+    case CONTENT_BUFFER:
+        bytes = buffer_data( impl->buffer, &len );
+        if (impl->offset + impl->count > len) hr = E_BOUNDS;
+        else if (!(data = malloc( max( impl->count, 1 ) ))) hr = E_OUTOFMEMORY;
+        else
+        {
+            memcpy( data, bytes + impl->offset, impl->count );
+            size = impl->count;
+        }
+        break;
+    case CONTENT_STREAM:
+        if (!impl->stream) hr = RO_E_CLOSED;
+        else hr = load_stream( impl, op, &data, &size );
+        break;
+    case CONTENT_MULTIPART:
+        hr = load_multipart( impl, op, &data, &size );
+        break;
+    case CONTENT_RESPONSE:
+        if (impl->streamed || !impl->body) hr = E_ILLEGAL_METHOD_CALL;
+        else hr = load_network( impl, op, &data, &size );
+        break;
+    default:
+        break;
+    }
+    if (SUCCEEDED(hr))
+    {
+        free( impl->data );
+        impl->data = data;
+        impl->size = size;
+        impl->loaded = TRUE;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+/* a copy of the body of any content, ours or not */
+static HRESULT read_part( IHttpContent *part, struct async_op *op, BYTE **data, UINT64 *len )
+{
+    struct http_content *impl = unsafe_content( part );
+    IAsyncOperationWithProgress_IBuffer_UINT64 *buffer_op;
+    IBuffer *buffer = NULL;
+    AsyncStatus status;
+    HRESULT hr, error;
+    UINT32 size;
+    BYTE *bytes;
+
+    *data = NULL;
+    *len = 0;
+    if (impl)
+    {
+        if (FAILED(hr = content_load( impl, op ))) return hr;
+        EnterCriticalSection( &impl->cs );
+        if ((*data = malloc( max( impl->size, 1 ) ))) memcpy( *data, impl->data, impl->size );
+        *len = impl->size;
+        LeaveCriticalSection( &impl->cs );
+        return *data ? S_OK : E_OUTOFMEMORY;
+    }
+
+    if (FAILED(hr = IHttpContent_ReadAsBufferAsync( part, &buffer_op ))) return hr;
+    status = async_wait( op, (IUnknown *)buffer_op, TRUE, &IID_IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT64,
+                         NULL, &error );
+    if (status == Completed) hr = IAsyncOperationWithProgress_IBuffer_UINT64_GetResults( buffer_op, &buffer );
+    else hr = status == Canceled ? E_ABORT : error;
+    IAsyncOperationWithProgress_IBuffer_UINT64_Release( buffer_op );
+    if (FAILED(hr)) return hr;
+    if (!buffer) return S_OK;
+    bytes = buffer_data( buffer, &size );
+    if ((*data = malloc( max( size, 1 ) ))) memcpy( *data, bytes, size );
+    *len = size;
+    IBuffer_Release( buffer );
+    return *data ? S_OK : E_OUTOFMEMORY;
+}
+
+HRESULT content_read_all( IHttpContent *content, struct async_op *op, BYTE **data, UINT64 *len )
+{
+    return read_part( content, op, data, len );
+}
+
+HRESULT content_buffer_all( IHttpContent *content, struct async_op *op, IBuffer **out )
+{
+    struct http_content *impl = unsafe_content( content );
+    IAsyncOperationWithProgress_UINT64_UINT64 *all_op;
+    AsyncStatus status;
+    HRESULT hr, error;
+
+    if (out) *out = NULL;
+    if (impl) return content_load( impl, op );
+    if (FAILED(hr = IHttpContent_BufferAllAsync( content, &all_op ))) return hr;
+    status = async_wait( op, (IUnknown *)all_op, TRUE, &IID_IAsyncOperationWithProgressCompletedHandler_UINT64_UINT64,
+                         NULL, &error );
+    IAsyncOperationWithProgress_UINT64_UINT64_Release( all_op );
+    if (status == Completed) return S_OK;
+    return status == Canceled ? E_ABORT : error;
+}
+
+/* the length the body will have, when it can be told without reading it */
+static BOOL compute_length( struct http_content *impl, UINT64 *length )
+{
+    IRandomAccessStream *stream;
+    struct part *part;
+    UINT64 size, position, total;
+    boolean ok;
+    BOOL ret = FALSE;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->loaded)
+    {
+        *length = impl->size;
+        ret = TRUE;
+    }
+    else if (impl->kind == CONTENT_BUFFER)
+    {
+        *length = impl->count;
+        ret = TRUE;
+    }
+    else if (impl->kind == CONTENT_STREAM && impl->stream &&
+             SUCCEEDED(IInputStream_QueryInterface( impl->stream, &IID_IRandomAccessStream, (void **)&stream )))
+    {
+        if (SUCCEEDED(IRandomAccessStream_get_Size( stream, &size )) &&
+            SUCCEEDED(IRandomAccessStream_get_Position( stream, &position )))
+        {
+            *length = size > position ? size - position : 0;
+            ret = TRUE;
+        }
+        IRandomAccessStream_Release( stream );
+    }
+    else if (impl->kind == CONTENT_MULTIPART)
+    {
+        struct strbuf buf;
+        total = 0;
+        ret = TRUE;
+        LIST_FOR_EACH_ENTRY( part, &impl->parts, struct part, entry )
+        {
+            strbuf_init( &buf );
+            strbuf_appendw( &buf, L"--" );
+            strbuf_appendw( &buf, impl->boundary );
+            strbuf_appendw( &buf, L"\r\n" );
+            append_part_headers( &buf, part->content );
+            strbuf_appendw( &buf, L"\r\n\r\n" );
+            total += WideCharToMultiByte( CP_UTF8, 0, buf.data, buf.len, NULL, 0, NULL, NULL );
+            strbuf_free( &buf );
+            if (FAILED(IHttpContent_TryComputeLength( part->content, &size, &ok )) || !ok)
+            {
+                ret = FALSE;
+                break;
+            }
+            total += size;
+        }
+        total += wcslen( impl->boundary ) + 6;
+        *length = total;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return ret;
+}
