+HRESULT headers_create( enum headers_kind kind, struct headers **out )
+{
+    struct headers *impl;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IMap_HSTRING_HSTRING_iface.lpVtbl = &map_vtbl;
+    impl->IIterable_IKeyValuePair_HSTRING_HSTRING_iface.lpVtbl = &iterable_vtbl;
+    impl->IStringable_iface.lpVtbl = &stringable_vtbl;
+    impl->IHttpRequestHeaderCollection_iface.lpVtbl = &request_vtbl;
+    impl->IHttpResponseHeaderCollection_iface.lpVtbl = &response_vtbl;
+    impl->IHttpContentHeaderCollection_iface.lpVtbl = &content_vtbl;
+    impl->ref = 1;
+    impl->kind = kind;
+    list_init( &impl->entries );
+    impl->bin_count = pick_bin_count( 0 );
+    update_thresholds( impl );
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": headers.cs");
+    *out = impl;
+    return S_OK;
+}
+
+/* the collection's own interface, which is what it is handed out as */
+IInspectable *headers_inspectable( struct headers *impl )
+{
+    switch (impl->kind)
+    {
+    case HEADERS_REQUEST: return (IInspectable *)&impl->IHttpRequestHeaderCollection_iface;
+    case HEADERS_RESPONSE: return (IInspectable *)&impl->IHttpResponseHeaderCollection_iface;
+    default: return (IInspectable *)&impl->IHttpContentHeaderCollection_iface;
+    }
+}
