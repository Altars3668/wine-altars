+struct value_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    IInspectable factory_iface;
+    IInspectable statics_iface;
+    enum value_kind kind;
+    const IID *factory_iid;
+    const IID *statics_iid;
+};
+
+static inline struct value_factory *factory_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct value_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI value_factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct value_factory *impl = factory_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        return S_OK;
+    }
+    if (impl->factory_iid && IsEqualGUID( iid, impl->factory_iid ))
+    {
+        *out = &impl->factory_iface;
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, impl->statics_iid ))
+    {
+        *out = &impl->statics_iface;
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
