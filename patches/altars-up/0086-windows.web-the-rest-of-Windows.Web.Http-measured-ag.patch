+/* Reads from memory, or off the network: a read that may stop short is one
+ * chunk of what arrived, as on Windows, which gives 8192 bytes at a time. */
+static HRESULT body_stream_read( struct async_op *op, void *context, union async_value *result )
+{
+    struct read_context *read = context;
+    struct body_stream *impl = read->stream;
+    UINT32 capacity = 0, done = 0, len;
+    BYTE *dst;
+    HRESULT hr = S_OK;
+
+    IBuffer_get_Capacity( read->buffer, &capacity );
+    if (!(dst = buffer_data( read->buffer, NULL )) && capacity) return E_POINTER;
+    read->count = min( read->count, capacity );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (impl->content)
+    {
+        struct http_content *content = impl->content;
+        EnterCriticalSection( &content->cs );
+        if (impl->position < content->size)
+        {
+            done = min( read->count, content->size - impl->position );
+            memcpy( dst, content->data + impl->position, done );
+            impl->position += done;
+        }
+        LeaveCriticalSection( &content->cs );
+    }
+    else while (done < read->count)
+    {
+        if (FAILED(hr = network_body_read( impl->body, dst + done, min( read->count - done, 8192 ), &len ))) break;
+        done += len;
+        if (!len || read->options == InputStreamOptions_Partial) break;
+        if (async_op_canceled( op )) break;
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (FAILED(hr)) return hr;
+
+    IBuffer_put_Length( read->buffer, done );
+    IBuffer_AddRef( read->buffer );
+    result->object = (IUnknown *)read->buffer;
+    return S_OK;
+}
