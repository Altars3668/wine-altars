+/* Parse and TryParse have the same shape in every class's statics */
+static HRESULT WINAPI statics_Parse( IInspectable *iface, HSTRING input, IInspectable **value )
+{
+    struct value_factory *impl = statics_part_factory( iface );
+    WCHAR *str;
+    HRESULT hr;
+
+    TRACE( "iface %p, input %s, value %p.\n", iface, debugstr_hstring( input ), value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!input || !(str = hstring_dup( input ))) return input ? E_OUTOFMEMORY : E_INVALIDARG;
+    hr = header_value_parse_all( impl->kind, str, value );
+    free( str );
+    return hr;
+}
+
+static HRESULT WINAPI statics_TryParse( IInspectable *iface, HSTRING input, IInspectable **value, boolean *succeeded )
+{
+    HRESULT hr;
+
+    TRACE( "iface %p, input %s, value %p, succeeded %p.\n", iface, debugstr_hstring( input ), value, succeeded );
+
+    if (!value || !succeeded) return E_POINTER;
+    hr = statics_Parse( iface, input, value );
+    if (hr == E_OUTOFMEMORY) return hr;
+    *succeeded = SUCCEEDED(hr);
+    return S_OK;
+}
+
+typedef struct statics_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IInspectable *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( IInspectable *iface );
+    ULONG (WINAPI *Release)( IInspectable *iface );
+    HRESULT (WINAPI *GetIids)( IInspectable *iface, ULONG *iid_count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( IInspectable *iface, HSTRING *class_name );
+    HRESULT (WINAPI *GetTrustLevel)( IInspectable *iface, TrustLevel *trust_level );
+    HRESULT (WINAPI *Parse)( IInspectable *iface, HSTRING input, IInspectable **value );
+    HRESULT (WINAPI *TryParse)( IInspectable *iface, HSTRING input, IInspectable **value, boolean *succeeded );
+} statics_vtbl;
