 /*
- * HttpBaseProtocolFilter is the settings object an HttpClient is built on: how
- * many connections to open per server, whether to follow redirects, which
- * credentials to offer.  Every one of those is a value the caller stores and
- * reads back, and that much is implemented here.
+ * HttpBaseProtocolFilter sends over WinINet, as it does on Windows, where
+ * its errors are WinINet's: a refused connection is 0x80072efd, a name that
+ * does not resolve 0x80072ee7.  What it does was measured there against a
+ * server in the test process, and is done the same way here:
  *
- * What is not implemented is the part that needs the rest of Windows.Web.Http:
- * SendRequestAsync, and the members handing back a cookie manager, a
- * certificate or a credential.  Those report that they are not implemented
- * rather than answering with an empty object -- a caller that is given one
- * cannot tell it apart from a real one, and the failure surfaces somewhere
- * else entirely.
+ * - the request goes out with the request's headers, then the content's,
+ *   with WinINet's Host, Connection and Content-Length, no User-Agent of its
+ *   own, and "Accept-Encoding: gzip, deflate" added to the request itself
+ *   while decompression is on; WinINet then decodes gzip and raw deflate and
+ *   takes Content-Encoding and Content-Length out, as Windows does;
+ * - redirects are followed here, not by WinINet: a POST answered by 301, 302
+ *   or 303 becomes a GET without its body, a 307 or 308 to anything but GET
+ *   or HEAD fails with ERROR_HTTP_REDIRECT_NEEDS_CONFIRMATION, the eleventh
+ *   redirect with ERROR_HTTP_REDIRECT_FAILED, and the request's RequestUri
+ *   becomes the last URI while its method stays what it was;
+ * - a response header whose name is not a token fails the request with
+ *   ERROR_HTTP_INVALID_HEADER; the others are kept as their text, joined by
+ *   ", " when repeated, and a relative Location reads as an absolute URI;
+ * - the operation completes with the headers: the content reads the body off
+ *   the connection when it is asked for, and HttpClient asks at once unless
+ *   told to stop at the headers;
+ * - nothing is written to the cache, and a GET is not answered from it.
  */
 
+/*** the body of a response, on its connection ***/
+
+struct network_body
+{
+    LONG ref;
+    CRITICAL_SECTION cs;
+    HINTERNET connect;
+    HINTERNET request;
+    BOOL has_length;
+    UINT64 length;
+    UINT64 sent;
+    UINT64 to_send;
+    BOOL finished;
+};
+
+void network_body_addref( struct network_body *body )
+{
+    InterlockedIncrement( &body->ref );
+}
+
+void network_body_release( struct network_body *body )
+{
+    if (InterlockedDecrement( &body->ref )) return;
+    if (body->request) InternetCloseHandle( body->request );
+    if (body->connect) InternetCloseHandle( body->connect );
+    body->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &body->cs );
+    free( body );
+}
+
+HRESULT network_body_read( struct network_body *body, BYTE *buffer, UINT32 size, UINT32 *read )
+{
+    DWORD done = 0;
+    HRESULT hr = S_OK;
+
+    *read = 0;
+    EnterCriticalSection( &body->cs );
+    if (!body->finished && size)
+    {
+        if (!InternetReadFile( body->request, buffer, size, &done ))
+        {
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+            WARN( "InternetReadFile failed, hr %#lx.\n", hr );
+        }
+        else if (!done) body->finished = TRUE;
+        *read = done;
+    }
+    LeaveCriticalSection( &body->cs );
+    return hr;
+}
+
+BOOL network_body_length( struct network_body *body, UINT64 *length )
+{
+    *length = body->length;
+    return body->has_length;
+}
+
+static void report_progress( struct async_op *op, HttpProgressStage stage, UINT64 sent, UINT64 to_send,
+                             UINT64 received, BOOL has_length, UINT64 length )
+{
+    HttpProgress progress = {0};
+
+    if (!op) return;
+    progress.Stage = stage;
+    progress.BytesSent = sent;
+    box_uint64( to_send, &progress.TotalBytesToSend );
+    progress.BytesReceived = received;
+    if (has_length) box_uint64( length, &progress.TotalBytesToReceive );
+    async_op_progress_http( op, &progress );
+    if (progress.TotalBytesToSend) IReference_UINT64_Release( progress.TotalBytesToSend );
+    if (progress.TotalBytesToReceive) IReference_UINT64_Release( progress.TotalBytesToReceive );
+}
+
+void network_body_report( struct network_body *body, struct async_op *op, UINT64 received )
+{
+    report_progress( op, HttpProgressStage_ReceivingContent, body->sent, body->to_send, received,
+                     body->has_length, body->length );
+}
