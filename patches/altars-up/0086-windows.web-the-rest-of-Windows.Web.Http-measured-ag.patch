+static HRESULT create_media_quality( HSTRING media_type, BOOL has_quality, double quality, IInspectable **value )
+{
+    struct header_value *impl;
+    struct strbuf buf;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (FAILED(hr = value_create( VALUE_MEDIA_TYPE_QUALITY, &impl ))) return hr;
+    if (media_type && !(impl->str1 = hstring_dup( media_type ))) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr) && has_quality)
+    {
+        strbuf_init( &buf );
+        format_quality( &buf, quality );
+        hr = buf.failed ? E_OUTOFMEMORY : name_value_list_set( impl->params, L"q", buf.data, FALSE );
+        strbuf_free( &buf );
+    }
+    if (FAILED(hr))
+    {
+        value_Release( &impl->IInspectable_iface );
+        return hr;
+    }
+    *value = &impl->IInspectable_iface;
+    return S_OK;
