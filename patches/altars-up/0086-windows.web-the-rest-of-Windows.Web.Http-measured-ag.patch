+      &IID_IVectorView_Language, &IID_IIterable_Language,
+      &IID_IIterator_Language, VALUE_KIND_COUNT, L", " },
+};
+
+struct header_list
+{
+    struct vector vector;
+    IInspectable IInspectable_collection_iface;
+    enum list_kind kind;
+    struct vector_desc desc;
+    /* when it last changed, and whether it has been empty since it was last
+     * looked at: a header collection takes its place among the headers when
+     * it gains a value, and gives it up when it loses its last one */
+    LONG changed;
+    BOOL emptied;
+};
+
+static LONG change_count;
+
+static void list_changed( struct vector *vector )
+{
+    struct header_list *list = CONTAINING_RECORD( vector, struct header_list, vector );
+    if (!vector->size) list->emptied = TRUE;
+    list->changed = InterlockedIncrement( &change_count );
+}
+
+static inline struct header_list *list_from_vector( struct vector *vector )
+{
+    return CONTAINING_RECORD( vector, struct header_list, vector );
+}
+
+static inline struct header_list *list_from_collection( IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct header_list, IInspectable_collection_iface );
+}
+
+/*** elements ***/
+
+static HRESULT parse_language( const WCHAR **ptr, IInspectable **out )
+{
+    static ILanguageFactory *factory;
+    const WCHAR *p = *ptr, *start;
+    ILanguage *language;
+    HSTRING tag;
+    HRESULT hr;
+
+    if (!factory)
+    {
+        ILanguageFactory *tmp;
+        HSTRING name;
+        if (FAILED(hr = class_name_create( L"Windows.Globalization.Language", &name ))) return hr;
+        hr = RoGetActivationFactory( name, &IID_ILanguageFactory, (void **)&tmp );
+        WindowsDeleteString( name );
+        if (FAILED(hr)) return hr;
+        if (InterlockedCompareExchangePointer( (void **)&factory, tmp, NULL )) ILanguageFactory_Release( tmp );
+    }
+
+    skip_ws( &p );
+    for (start = p; iswalnum( *p ) || *p == '-'; p++) ;
+    if (p == start) return E_INVALIDARG;
+    if (FAILED(hr = hstring_create_len( start, p - start, &tag ))) return hr;
+    hr = ILanguageFactory_CreateLanguage( factory, tag, &language );
+    WindowsDeleteString( tag );
+    if (FAILED(hr)) return E_INVALIDARG;
+    skip_ws( &p );
+    *out = (IInspectable *)language;
+    *ptr = p;
+    return S_OK;
+}
+
+static HRESULT parse_method( const WCHAR **ptr, IInspectable **out )
+{
+    const WCHAR *p = *ptr;
+    IHttpMethod *method;
+    WCHAR *name;
+    HRESULT hr;
+
+    skip_ws( &p );
+    if (!parse_token( &p, &name )) return E_INVALIDARG;
+    hr = http_method_create( name, &method );
+    free( name );
+    if (FAILED(hr)) return hr;
+    skip_ws( &p );
+    *out = (IInspectable *)method;
+    *ptr = p;
+    return S_OK;
+}
+
+static HRESULT parse_element( enum list_kind kind, const WCHAR **ptr, IInspectable **out )
+{
+    if (kind == LIST_LANGUAGE) return parse_language( ptr, out );
+    if (kind == LIST_METHOD) return parse_method( ptr, out );
+    return header_value_parse( list_infos[kind].element, ptr, out );
+}
+
+static void format_element( enum list_kind kind, IInspectable *item, struct strbuf *buf )
+{
+    HSTRING str;
+
+    if (kind == LIST_LANGUAGE)
+    {
+        ILanguage *language;
+        if (FAILED(IInspectable_QueryInterface( item, &IID_ILanguage, (void **)&language ))) return;
+        if (SUCCEEDED(ILanguage_get_LanguageTag( language, &str )))
+        {
+            strbuf_append_hstring( buf, str );
+            WindowsDeleteString( str );
+        }
+        ILanguage_Release( language );
+    }
+    else if (kind == LIST_METHOD)
+    {
+        IHttpMethod *method;
+        if (FAILED(IInspectable_QueryInterface( item, &IID_IHttpMethod, (void **)&method ))) return;
+        if (SUCCEEDED(IHttpMethod_get_Method( method, &str )))
+        {
+            strbuf_append_hstring( buf, str );
+            WindowsDeleteString( str );
+        }
+        IHttpMethod_Release( method );
+    }
+    else header_value_format( item, buf );
+}
+
+/* Parses a whole header value into elements; nothing is kept when any fails. */
+static HRESULT parse_elements( enum list_kind kind, const WCHAR *str, struct vector *out )
+{
+    const WCHAR *p = str;
+    IInspectable *item;
+    HRESULT hr;
+
+    if (!str) return S_OK;
+    for (;;)
+    {
+        if (kind == LIST_COOKIE_PAIR) while (*p == ';' || is_ws( *p )) p++;
+        else if (kind == LIST_PRODUCT_INFO) skip_ws( &p );
+        else while (*p == ',' || is_ws( *p )) p++;
+        if (!*p) return S_OK;
+
+        if (FAILED(hr = parse_element( kind, &p, &item ))) return E_INVALIDARG;
+        hr = vector_append( out, item );
+        IInspectable_Release( item );
+        if (FAILED(hr)) return hr;
+
+        skip_ws( &p );
+        if (!*p) return S_OK;
+        if (kind == LIST_COOKIE_PAIR) { if (*p != ';') return E_INVALIDARG; }
+        else if (kind == LIST_PRODUCT_INFO) { if (!is_ws( p[-1] ) && *p != '(' && p[-1] != ')') return E_INVALIDARG; }
+        else if (*p != ',') return E_INVALIDARG;
+    }
+}
+
+/*** the collection interface: ParseAdd and TryParseAdd ***/
+
+/* where elements are gathered before they are known to be good */
+static const struct vector_desc parsed_desc =
+{
+    L"", NULL, &IID_IVector_IInspectable, &IID_IVectorView_IInspectable, &IID_IIterable_IInspectable, &IID_IIterator_IInspectable,
+};
+
+static HRESULT list_parse_add( struct header_list *list, HSTRING input )
+{
+    struct vector *parsed;
+    IInspectable **items;
+    UINT32 count, i;
+    WCHAR *str;
+    HRESULT hr;
+
+    if (!(str = hstring_dup( input ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = vector_create( &parsed_desc, sizeof(struct vector), &parsed )))
+    {
+        free( str );
+        return hr;
+    }
+    hr = parse_elements( list->kind, str, parsed );
+    free( str );
+    if (SUCCEEDED(hr) && (count = vector_snapshot( parsed, &items )) != ~0u)
+    {
+        for (i = 0; i < count && SUCCEEDED(hr); i++) hr = vector_append( &list->vector, items[i] );
+        vector_free_snapshot( items, count );
+    }
+    IVector_IInspectable_Release( &parsed->IVector_IInspectable_iface );
+    return hr;
+}
+
+static HRESULT WINAPI collection_QueryInterface( IInspectable *iface, REFIID iid, void **out )
+{
+    struct header_list *list = list_from_collection( iface );
+    return IVector_IInspectable_QueryInterface( &list->vector.IVector_IInspectable_iface, iid, out );
+}
+
+static ULONG WINAPI collection_AddRef( IInspectable *iface )
+{
+    struct header_list *list = list_from_collection( iface );
+    return IVector_IInspectable_AddRef( &list->vector.IVector_IInspectable_iface );
+}
+
+static ULONG WINAPI collection_Release( IInspectable *iface )
+{
+    struct header_list *list = list_from_collection( iface );
+    return IVector_IInspectable_Release( &list->vector.IVector_IInspectable_iface );
+}
+
+static HRESULT WINAPI collection_GetIids( IInspectable *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI collection_GetRuntimeClassName( IInspectable *iface, HSTRING *class_name )
+{
+    struct header_list *list = list_from_collection( iface );
+    return class_name_create( list_infos[list->kind].class_name, class_name );
+}
+
+static HRESULT WINAPI collection_GetTrustLevel( IInspectable *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI collection_ParseAdd( IInspectable *iface, HSTRING input )
+{
+    struct header_list *list = list_from_collection( iface );
+
+    TRACE( "iface %p, input %s.\n", iface, debugstr_hstring( input ) );
+
+    return list_parse_add( list, input );
+}
+
+static HRESULT WINAPI collection_TryParseAdd( IInspectable *iface, HSTRING input, boolean *result )
+{
+    struct header_list *list = list_from_collection( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, input %s, result %p.\n", iface, debugstr_hstring( input ), result );
+
+    if (!result) return E_POINTER;
+    hr = list_parse_add( list, input );
+    if (hr == E_OUTOFMEMORY) return hr;
+    *result = SUCCEEDED(hr);
+    return S_OK;
+}
+
+typedef struct collection_vtbl
+{
+    HRESULT (WINAPI *QueryInterface)( IInspectable *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( IInspectable *iface );
+    ULONG (WINAPI *Release)( IInspectable *iface );
+    HRESULT (WINAPI *GetIids)( IInspectable *iface, ULONG *iid_count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( IInspectable *iface, HSTRING *class_name );
+    HRESULT (WINAPI *GetTrustLevel)( IInspectable *iface, TrustLevel *trust_level );
+    HRESULT (WINAPI *ParseAdd)( IInspectable *iface, HSTRING input );
+    HRESULT (WINAPI *TryParseAdd)( IInspectable *iface, HSTRING input, boolean *result );
+} collection_vtbl;
+
+static const collection_vtbl list_collection_vtbl =
+{
+    collection_QueryInterface,
+    collection_AddRef,
+    collection_Release,
+    collection_GetIids,
+    collection_GetRuntimeClassName,
+    collection_GetTrustLevel,
+    collection_ParseAdd,
+    collection_TryParseAdd,
+};
+
+/*** HttpCacheDirectiveHeaderValueCollection: the directives as properties ***/
+
+static HRESULT cache_get_seconds( IHttpCacheDirectiveHeaderValueCollection *iface, const WCHAR *name, IReference_TimeSpan **value )
+{
+    struct header_list *list = list_from_collection( (IInspectable *)iface );
+    UINT64 seconds;
+    TimeSpan span;
+    WCHAR *str;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(str = name_value_list_get( &list->vector, name ))) return S_OK;
+    if (parse_uint64( str, wcslen( str ), &seconds ))
+    {
+        span.Duration = seconds * 10000000;
+        box_timespan( span, value );
+    }
+    free( str );
+    return S_OK;
+}
+
+static HRESULT cache_put_seconds( IHttpCacheDirectiveHeaderValueCollection *iface, const WCHAR *name, IReference_TimeSpan *value )
+{
+    struct header_list *list = list_from_collection( (IInspectable *)iface );
+    WCHAR str[32];
+    TimeSpan span;
+    HRESULT hr;
+
+    if (!value) return name_value_list_set( &list->vector, name, NULL, TRUE );
+    if (FAILED(hr = IReference_TimeSpan_get_Value( value, &span ))) return hr;
+    swprintf( str, ARRAY_SIZE(str), L"%I64d", span.Duration / 10000000 );
+    return name_value_list_set( &list->vector, name, str, FALSE );
+}
+
+static HRESULT WINAPI cache_QueryInterface( IHttpCacheDirectiveHeaderValueCollection *iface, REFIID iid, void **out )
+{
+    return collection_QueryInterface( (IInspectable *)iface, iid, out );
+}
+
+static ULONG WINAPI cache_AddRef( IHttpCacheDirectiveHeaderValueCollection *iface )
+{
+    return collection_AddRef( (IInspectable *)iface );
+}
+
+static ULONG WINAPI cache_Release( IHttpCacheDirectiveHeaderValueCollection *iface )
+{
+    return collection_Release( (IInspectable *)iface );
+}
+
+static HRESULT WINAPI cache_GetIids( IHttpCacheDirectiveHeaderValueCollection *iface, ULONG *iid_count, IID **iids )
+{
+    return collection_GetIids( (IInspectable *)iface, iid_count, iids );
+}
+
+static HRESULT WINAPI cache_GetRuntimeClassName( IHttpCacheDirectiveHeaderValueCollection *iface, HSTRING *class_name )
+{
+    return collection_GetRuntimeClassName( (IInspectable *)iface, class_name );
+}
+
+static HRESULT WINAPI cache_GetTrustLevel( IHttpCacheDirectiveHeaderValueCollection *iface, TrustLevel *trust_level )
+{
+    return collection_GetTrustLevel( (IInspectable *)iface, trust_level );
+}
+
+#define CACHE_PROPERTY( prop, name )                                                                        \
+    static HRESULT WINAPI cache_get_##prop( IHttpCacheDirectiveHeaderValueCollection *iface, IReference_TimeSpan **value ) \
+    {                                                                                                       \
+        TRACE( "iface %p, value %p.\n", iface, value );                                                     \
+        return cache_get_seconds( iface, name, value );                                                     \
+    }                                                                                                       \
+    static HRESULT WINAPI cache_put_##prop( IHttpCacheDirectiveHeaderValueCollection *iface, IReference_TimeSpan *value ) \
+    {                                                                                                       \
+        TRACE( "iface %p, value %p.\n", iface, value );                                                     \
+        return cache_put_seconds( iface, name, value );                                                     \
+    }
+
+CACHE_PROPERTY( MaxAge, L"max-age" )
+CACHE_PROPERTY( MaxStale, L"max-stale" )
+CACHE_PROPERTY( MinFresh, L"min-fresh" )
+CACHE_PROPERTY( SharedMaxAge, L"s-maxage" )
+
+static HRESULT WINAPI cache_ParseAdd( IHttpCacheDirectiveHeaderValueCollection *iface, HSTRING input )
+{
+    return collection_ParseAdd( (IInspectable *)iface, input );
+}
+
+static HRESULT WINAPI cache_TryParseAdd( IHttpCacheDirectiveHeaderValueCollection *iface, HSTRING input, boolean *result )
+{
+    return collection_TryParseAdd( (IInspectable *)iface, input, result );
+}
+
+static const struct IHttpCacheDirectiveHeaderValueCollectionVtbl cache_collection_vtbl =
+{
+    cache_QueryInterface,
+    cache_AddRef,
+    cache_Release,
+    /* IInspectable methods */
+    cache_GetIids,
+    cache_GetRuntimeClassName,
+    cache_GetTrustLevel,
+    /* IHttpCacheDirectiveHeaderValueCollection methods */
+    cache_get_MaxAge,
+    cache_put_MaxAge,
+    cache_get_MaxStale,
+    cache_put_MaxStale,
+    cache_get_MinFresh,
+    cache_put_MinFresh,
+    cache_get_SharedMaxAge,
+    cache_put_SharedMaxAge,
+    cache_ParseAdd,
+    cache_TryParseAdd,
+};
+
+/*** the vector part ***/
+
+static HRESULT list_query_interface( struct vector *vector, REFIID iid, void **out )
+{
+    struct header_list *list = list_from_vector( vector );
+
+    if (IsEqualGUID( iid, &IID_IInspectable ) || IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, list_infos[list->kind].collection ))
+    {
+        IInspectable_AddRef( (*out = &list->IInspectable_collection_iface) );
+        return S_OK;
+    }
+    return E_NOINTERFACE;
+}
+
+static HRESULT list_to_string( struct vector *vector, HSTRING *out )
+{
+    struct strbuf buf;
+    HRESULT hr;
+
+    strbuf_init( &buf );
+    header_list_format( (IInspectable *)&list_from_vector( vector )->IInspectable_collection_iface, &buf );
+    hr = strbuf_to_hstring( &buf, out );
+    strbuf_free( &buf );
+    return hr;
+}
+
+HRESULT header_list_create( enum list_kind kind, IInspectable **out )
+{
+    const struct list_info *info = &list_infos[kind];
+    struct header_list *list;
+    struct vector *vector;
+    HRESULT hr;
+
+    if (FAILED(hr = vector_create( NULL, sizeof(*list), &vector ))) return hr;
+    list = list_from_vector( vector );
+    list->kind = kind;
+    list->desc.class_name = info->class_name;
+    list->desc.view_class_name = NULL;
+    list->desc.vector = info->vector;
+    list->desc.view = info->view;
+    list->desc.iterable = info->iterable;
+    list->desc.iterator = info->iterator;
+    list->desc.query_interface = list_query_interface;
+    list->desc.to_string = list_to_string;
+    list->desc.changed = list_changed;
+    vector->desc = &list->desc;
+    if (kind == LIST_CACHE_DIRECTIVE) list->IInspectable_collection_iface.lpVtbl = (void *)&cache_collection_vtbl;
+    else list->IInspectable_collection_iface.lpVtbl = (void *)&list_collection_vtbl;
+
+    *out = &list->IInspectable_collection_iface;
+    return S_OK;
+}
+
+HRESULT header_list_parse( IInspectable *iface, const WCHAR *str )
+{
+    struct header_list *list = list_from_collection( iface );
+    return parse_elements( list->kind, str, &list->vector );
+}
+
+HRESULT header_list_parse_new( enum list_kind kind, const WCHAR *str, IInspectable **out )
+{
+    HRESULT hr;
+
+    if (FAILED(hr = header_list_create( kind, out ))) return hr;
+    if (FAILED(hr = header_list_parse( *out, str )))
+    {
+        IInspectable_Release( *out );
+        *out = NULL;
+    }
+    return hr;
+}
+
+/* Whether the collection has values; and when it last changed, and whether
+ * it has been empty since the last time that was asked, when emptied is set. */
+BOOL header_list_state( IInspectable *iface, LONG *changed, BOOL *emptied )
+{
+    struct header_list *list = list_from_collection( iface );
+    BOOL ret;
+
+    EnterCriticalSection( &list->vector.cs );
+    ret = list->vector.size != 0;
+    if (emptied)
+    {
+        *changed = list->changed;
+        *emptied = list->emptied;
+        list->emptied = FALSE;
+    }
+    LeaveCriticalSection( &list->vector.cs );
+    return ret;
+}
+
+/* FALSE when there is nothing to write: the header is not there. */
+BOOL header_list_format( IInspectable *iface, struct strbuf *buf )
+{
+    struct header_list *list = list_from_collection( iface );
+    IInspectable **items;
+    UINT32 count, i;
+
+    if ((count = vector_snapshot( &list->vector, &items )) == ~0u || !count)
+    {
+        if (count != ~0u) vector_free_snapshot( items, count );
+        return FALSE;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (i) strbuf_appendw( buf, list_infos[list->kind].separator );
+        format_element( list->kind, items[i], buf );
+    }
+    vector_free_snapshot( items, count );
+    return TRUE;
+}
