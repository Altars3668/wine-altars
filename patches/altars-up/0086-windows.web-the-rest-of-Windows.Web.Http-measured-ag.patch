+        if (!append_data( data, size, &capacity, bytes, len ) || !append_data( data, size, &capacity, (BYTE *)"\r\n", 2 ))
+            hr = E_OUTOFMEMORY;
+        free( bytes );
+        if (FAILED(hr)) break;
+    }
+    if (SUCCEEDED(hr))
+    {
+        strbuf_init( &buf );
+        strbuf_appendw( &buf, L"--" );
+        strbuf_appendw( &buf, impl->boundary );
+        strbuf_appendw( &buf, L"--\r\n" );
+        if (buf.failed || !append_ascii( data, size, &capacity, buf.data, buf.len )) hr = E_OUTOFMEMORY;
+        strbuf_free( &buf );
+    }
+    if (FAILED(hr))
+    {
+        free( *data );
+        *data = NULL;
+        *size = 0;
+    }
+    return hr;
+}
