+static HINTERNET get_session( struct filter *impl )
+{
+    HINTERNET session;
+    BOOL proxy = impl->use_proxy;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->session && impl->session_proxy != proxy)
+    {
+        InternetCloseHandle( impl->session );
+        impl->session = NULL;
+    }
+    if (!impl->session)
+    {
+        /* no agent: Windows sends no User-Agent of its own */
+        impl->session = InternetOpenW( NULL, proxy ? INTERNET_OPEN_TYPE_PRECONFIG : INTERNET_OPEN_TYPE_DIRECT, NULL, NULL, 0 );
+        impl->session_proxy = proxy;
+    }
+    session = impl->session;
+    LeaveCriticalSection( &impl->cs );
+    return session;
+}
+
+static DWORD security_flags( struct filter *impl )
+{
+    UINT32 *values, count, i;
+    DWORD flags = 0;
+
+    count = enum_vector_snapshot( impl->ignorable_errors, &values );
+    for (i = 0; i < count; i++)
+    {
+        switch (values[i])
+        {
+        case ChainValidationResult_Untrusted:
+        case ChainValidationResult_IncompleteChain:
+            flags |= SECURITY_FLAG_IGNORE_UNKNOWN_CA;
+            break;
+        case ChainValidationResult_Expired:
+            flags |= SECURITY_FLAG_IGNORE_CERT_DATE_INVALID;
+            break;
+        case ChainValidationResult_InvalidName:
+            flags |= SECURITY_FLAG_IGNORE_CERT_CN_INVALID;
+            break;
+        case ChainValidationResult_WrongUsage:
+            flags |= SECURITY_FLAG_IGNORE_WRONG_USAGE;
+            break;
+        case ChainValidationResult_RevocationInformationMissing:
+        case ChainValidationResult_RevocationFailure:
+            flags |= SECURITY_FLAG_IGNORE_REVOCATION;
+            break;
+        default:
+            break;
+        }
+    }
+    free( values );
+    return flags;
+}
+
+static void set_credential( HINTERNET request, IPasswordCredential *credential, DWORD user_option, DWORD password_option )
+{
+    HSTRING user = NULL, password = NULL;
+    UINT32 len;
+    const WCHAR *data;
+
+    if (!credential) return;
+    if (SUCCEEDED(IPasswordCredential_get_UserName( credential, &user )) && user)
+    {
+        data = WindowsGetStringRawBuffer( user, &len );
+        InternetSetOptionW( request, user_option, (void *)data, len );
+    }
+    if (SUCCEEDED(IPasswordCredential_get_Password( credential, &password )) && password)
+    {
+        data = WindowsGetStringRawBuffer( password, &len );
+        InternetSetOptionW( request, password_option, (void *)data, len );
+    }
+    WindowsDeleteString( user );
+    WindowsDeleteString( password );
+}
+
+struct filter_send
+{
+    struct filter *filter;
+    IHttpRequestMessage *request;
+};
+
+static void free_filter_send( void *context )
+{
+    struct filter_send *send = context;
+    IHttpBaseProtocolFilter_Release( &send->filter->IHttpBaseProtocolFilter_iface );
+    IHttpRequestMessage_Release( send->request );
+    free( send );
+}
+
+static HttpVersion parse_version( const WCHAR *text )
+{
+    if (!text) return HttpVersion_None;
+    if (!wcscmp( text, L"HTTP/1.0" )) return HttpVersion_Http10;
+    if (!wcscmp( text, L"HTTP/1.1" )) return HttpVersion_Http11;
+    if (!wcsncmp( text, L"HTTP/2", 6 )) return HttpVersion_Http20;
+    return HttpVersion_Http11;
+}
+
+static HRESULT send_work( struct async_op *op, void *context, union async_value *result )
+{
+    struct filter_send *send = context;
+    struct filter *impl = send->filter;
+    struct send_state state = {0};
+    struct headers *request_headers = NULL, *content_headers = NULL, *response_headers, *response_content_headers = NULL;
+    IHttpRequestHeaderCollection *request_collection = NULL;
+    IHttpContentHeaderCollection *content_collection = NULL;
+    IHttpResponseMessage *response = NULL;
+    IHttpContent *content = NULL, *response_content = NULL;
+    IUriRuntimeClass *uri = NULL;
+    struct network_body *body = NULL;
+    HINTERNET session, connect = NULL, request = NULL;
+    WCHAR *url = NULL, *verb = NULL, *location, *text;
+    BYTE *data = NULL;
+    UINT64 data_len = 0;
+    DWORD status = 0, size, flags, value;
+    UINT32 redirects = 0;
+    BOOL no_cache = FALSE;
+    struct strbuf headers;
+    HSTRING reason;
+    HRESULT hr = S_OK;
+
+    state.filter = impl;
+    state.request = send->request;
+    state.op = op;
+
+    IHttpRequestMessage_get_RequestUri( send->request, &uri );
+    if (!uri || !(url = uri_to_string( uri )))
+    {
+        hr = E_ILLEGAL_METHOD_CALL;
+        goto done;
+    }
+    {
+        IHttpMethod *method;
+        IHttpRequestMessage_get_Method( send->request, &method );
+        verb = method ? http_method_name( method ) : wcsdup( L"GET" );
+        if (method) IHttpMethod_Release( method );
+    }
+
+    IHttpRequestMessage_get_Headers( send->request, &request_collection );
+    request_headers = headers_from_request_collection( request_collection );
+    if (impl->automatic_decompression && request_headers && !headers_has( request_headers, L"Accept-Encoding" ))
+        headers_set_parsed( request_headers, L"Accept-Encoding", L"gzip, deflate" );
+
+    IHttpRequestMessage_get_Content( send->request, &content );
+    if (content)
+    {
+        IHttpContent_get_Headers( content, &content_collection );
+        content_headers = headers_from_content_collection( content_collection );
+        if (FAILED(hr = content_read_all( content, op, &data, &data_len ))) goto done;
+        if (data_len > 0xffffffff)
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+    }
+
+    if (!(session = get_session( impl )))
+    {
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        goto done;
+    }
+
+    for (;;)
+    {
+        URL_COMPONENTSW parts = {sizeof(parts)};
+        WCHAR host[INTERNET_MAX_HOST_NAME_LENGTH + 1];
+        WCHAR *path;
+
+        if (async_op_canceled( op ))
+        {
+            hr = E_ABORT;
+            goto done;
+        }
+        if (redirects) send_report( &state, HttpProgressStage_None );
+        state.to_send = data ? data_len : 0;
+        state.sent = 0;
+        send_report( &state, HttpProgressStage_DetectingProxy );
+
+        parts.lpszHostName = host;
+        parts.dwHostNameLength = ARRAY_SIZE(host);
+        parts.dwUrlPathLength = 1;
+        parts.dwExtraInfoLength = 1;
+        if (!InternetCrackUrlW( url, 0, 0, &parts ) ||
+            (parts.nScheme != INTERNET_SCHEME_HTTP && parts.nScheme != INTERNET_SCHEME_HTTPS))
+        {
+            hr = E_ILLEGAL_METHOD_CALL;
+            goto done;
+        }
+        state.secure = parts.nScheme == INTERNET_SCHEME_HTTPS;
+        if (!(path = malloc( (parts.dwUrlPathLength + parts.dwExtraInfoLength + 2) * sizeof(WCHAR) )))
+        {
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+        if (parts.dwUrlPathLength) memcpy( path, parts.lpszUrlPath, parts.dwUrlPathLength * sizeof(WCHAR) );
+        else path[parts.dwUrlPathLength++] = '/';
+        memcpy( path + parts.dwUrlPathLength, parts.lpszExtraInfo, parts.dwExtraInfoLength * sizeof(WCHAR) );
+        path[parts.dwUrlPathLength + parts.dwExtraInfoLength] = 0;
+        /* the fragment is not sent */
+        if ((text = wcschr( path, '#' ))) *text = 0;
+
+        flags = INTERNET_FLAG_NO_AUTO_REDIRECT | INTERNET_FLAG_NO_UI | INTERNET_FLAG_KEEP_CONNECTION |
+                INTERNET_FLAG_NO_CACHE_WRITE;
+        if (state.secure) flags |= INTERNET_FLAG_SECURE;
+        if (impl->cookie_usage == HttpCookieUsageBehavior_NoCookies) flags |= INTERNET_FLAG_NO_COOKIES;
+        switch (impl->cache_control->read)
+        {
+        case HttpCacheReadBehavior_OnlyFromCache: flags |= INTERNET_FLAG_FROM_CACHE; break;
+        case HttpCacheReadBehavior_NoCache: flags |= INTERNET_FLAG_RELOAD | INTERNET_FLAG_PRAGMA_NOCACHE; break;
+        default: flags |= INTERNET_FLAG_RELOAD; break;
+        }
+
+        connect = InternetConnectW( session, host, parts.nPort, NULL, NULL, INTERNET_SERVICE_HTTP, 0, (DWORD_PTR)&state );
+        if (connect) request = HttpOpenRequestW( connect, verb, path, L"HTTP/1.1", NULL, NULL, flags, (DWORD_PTR)&state );
+        free( path );
+        if (!connect || !request)
+        {
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+            goto done;
+        }
+        InternetSetStatusCallbackW( request, status_callback );
+        value = impl->automatic_decompression;
+        InternetSetOptionW( request, INTERNET_OPTION_HTTP_DECODING, &value, sizeof(value) );
+        if ((value = security_flags( impl )))
+        {
+            DWORD current = 0;
+            size = sizeof(current);
+            InternetQueryOptionW( request, INTERNET_OPTION_SECURITY_FLAGS, &current, &size );
+            current |= value;
+            InternetSetOptionW( request, INTERNET_OPTION_SECURITY_FLAGS, &current, sizeof(current) );
+        }
+        EnterCriticalSection( &impl->cs );
+        set_credential( request, impl->server_credential, INTERNET_OPTION_USERNAME, INTERNET_OPTION_PASSWORD );
+        set_credential( request, impl->proxy_credential, INTERNET_OPTION_PROXY_USERNAME, INTERNET_OPTION_PROXY_PASSWORD );
+        LeaveCriticalSection( &impl->cs );
+
+        strbuf_init( &headers );
+        append_headers( &headers, request_headers, NULL );
+        if (data) append_headers( &headers, content_headers, &data_len );
+        /* WinINet adds "Cache-Control: no-cache" to a request other than GET,
+         * and on Windows it follows redirects with the same request, so a
+         * GET a POST was redirected to still says it */
+        if (wcscmp( verb, L"GET" )) no_cache = TRUE;
+        else if (no_cache && !headers_has( request_headers, L"Cache-Control" ))
+            strbuf_appendw( &headers, L"Cache-Control: no-cache\r\n" );
+        if (headers.failed)
+        {
+            strbuf_free( &headers );
+            hr = E_OUTOFMEMORY;
+            goto done;
+        }
+
+        TRACE( "%s %s\n", debugstr_w( verb ), debugstr_w( url ) );
+        if (!HttpSendRequestW( request, headers.data, headers.len, data, data ? data_len : 0 ))
+        {
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+            strbuf_free( &headers );
+            WARN( "HttpSendRequest failed, hr %#lx.\n", hr );
+            goto done;
+        }
+        strbuf_free( &headers );
+        InternetSetStatusCallbackW( request, NULL );
+        send_report( &state, HttpProgressStage_ReceivingHeaders );
+
+        size = sizeof(status);
+        HttpQueryInfoW( request, HTTP_QUERY_STATUS_CODE | HTTP_QUERY_FLAG_NUMBER, &status, &size, NULL );
+        if (!impl->allow_auto_redirect || (status != 301 && status != 302 && status != 303 && status != 307 && status != 308))
+            break;
+        if (!(location = query_string( request, HTTP_QUERY_LOCATION ))) break;
+
+        if (++redirects > 10)
+        {
+            free( location );
+            hr = HRESULT_FROM_WIN32( ERROR_HTTP_REDIRECT_FAILED );
+            goto done;
+        }
+        if ((status == 307 || status == 308) && wcscmp( verb, L"GET" ) && wcscmp( verb, L"HEAD" ))
+        {
+            free( location );
+            hr = HRESULT_FROM_WIN32( ERROR_HTTP_REDIRECT_NEEDS_CONFIRMATION );
+            goto done;
+        }
+        if ((status == 303 && wcscmp( verb, L"HEAD" )) || ((status == 301 || status == 302) && !wcscmp( verb, L"POST" )))
+        {
+            free( verb );
+            verb = wcsdup( L"GET" );
+            free( data );
+            data = NULL;
+            data_len = 0;
+        }
+
+        /* the request goes on to where it was sent, and says so */
+        {
+            IUriRuntimeClass *next;
+            if (FAILED(hr = uri_create_relative( uri, location, &next )))
+            {
+                free( location );
+                hr = HRESULT_FROM_WIN32( ERROR_HTTP_INVALID_HEADER );
+                goto done;
+            }
+            free( location );
+            IHttpRequestMessage_put_RequestUri( send->request, next );
+            IUriRuntimeClass_Release( uri );
+            uri = next;
+            free( url );
+            if (!(url = uri_to_string( uri )))
+            {
+                hr = E_OUTOFMEMORY;
+                goto done;
+            }
+        }
+        InternetCloseHandle( request );
+        InternetCloseHandle( connect );
+        request = connect = NULL;
+    }
+
+    /* the response, with its body left on the connection */
+    if (FAILED(hr = response_message_create( &response ))) goto done;
+    response_headers = response_message_headers( response );
+    headers_set_base_uri( response_headers, uri );
+    if (FAILED(hr = headers_create( HEADERS_CONTENT, &response_content_headers ))) goto done;
+    if (FAILED(hr = add_response_headers( request, response_headers, response_content_headers ))) goto done;
+
+    IHttpResponseMessage_put_StatusCode( response, status );
+    if ((text = query_string( request, HTTP_QUERY_STATUS_TEXT )))
+    {
+        if (*text && SUCCEEDED(hstring_create( text, &reason )))
+        {
+            IHttpResponseMessage_put_ReasonPhrase( response, reason );
+            WindowsDeleteString( reason );
+        }
+        free( text );
+    }
+    text = query_string( request, HTTP_QUERY_VERSION );
+    IHttpResponseMessage_put_Version( response, parse_version( text ) );
+    free( text );
+    IHttpResponseMessage_put_Source( response, HttpResponseMessageSource_Network );
+    IHttpResponseMessage_put_RequestMessage( response, send->request );
+
+    if (!(body = calloc( 1, sizeof(*body) )))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    body->ref = 1;
+    InitializeCriticalSectionEx( &body->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    body->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": network_body.cs");
+    body->connect = connect;
+    body->request = request;
+    connect = request = NULL;
+    body->sent = state.sent;
+    body->to_send = state.to_send;
+    if ((text = headers_get( response_content_headers, L"Content-Length" )))
+    {
+        body->has_length = parse_uint64( text, wcslen( text ), &body->length );
+        free( text );
+    }
+
+    hr = response_content_create( body, response_content_headers, &response_content );
+    network_body_release( body );
+    if (FAILED(hr)) goto done;
+    IHttpResponseMessage_put_Content( response, response_content );
+    IHttpContent_Release( response_content );
+
+    result->object = (IUnknown *)response;
+    response = NULL;
+
+done:
+    if (response_content_headers) headers_release( response_content_headers );
+    if (request) InternetCloseHandle( request );
+    if (connect) InternetCloseHandle( connect );
+    if (response) IHttpResponseMessage_Release( response );
+    if (content_collection) IHttpContentHeaderCollection_Release( content_collection );
+    if (request_collection) IHttpRequestHeaderCollection_Release( request_collection );
+    if (content) IHttpContent_Release( content );
+    if (uri) IUriRuntimeClass_Release( uri );
+    free( data );
+    free( url );
+    free( verb );
+    return hr;
+}
