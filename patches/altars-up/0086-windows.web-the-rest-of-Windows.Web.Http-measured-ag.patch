+static IPropertyValueStatics *property_value_statics(void)
+{
+    static IPropertyValueStatics *statics;
+    IPropertyValueStatics *tmp;
+    HSTRING name;
+    HRESULT hr;
+
+    if (statics) return statics;
+    if (FAILED(class_name_create( L"Windows.Foundation.PropertyValue", &name ))) return NULL;
+    hr = RoGetActivationFactory( name, &IID_IPropertyValueStatics, (void **)&tmp );
+    WindowsDeleteString( name );
+    if (FAILED(hr)) return NULL;
+    if (InterlockedCompareExchangePointer( (void **)&statics, tmp, NULL )) IPropertyValueStatics_Release( tmp );
+    return statics;
+}
+
+#define DEFINE_BOX( name, type, create, iid )                                                      \
+    HRESULT box_##name( type value, void *out_ )                                                   \
+    {                                                                                              \
+        IPropertyValueStatics *statics = property_value_statics();                                 \
+        IInspectable *inspectable;                                                                 \
+        HRESULT hr;                                                                                \
+        if (!statics) return E_FAIL;                                                               \
+        if (FAILED(hr = IPropertyValueStatics_##create( statics, value, &inspectable ))) return hr; \
+        hr = IInspectable_QueryInterface( inspectable, &iid, out_ );                               \
+        IInspectable_Release( inspectable );                                                       \
+        return hr;                                                                                 \
+    }
