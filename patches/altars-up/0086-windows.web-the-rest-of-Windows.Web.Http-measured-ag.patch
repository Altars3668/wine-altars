+static ULONG WINAPI map_Release( IMap_HSTRING_HSTRING *iface )
+{
+    struct headers *impl = impl_from_IMap_HSTRING_HSTRING( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    struct header_entry *entry, *next;
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( entry, next, &impl->entries, struct header_entry, entry )
+            free_entry( impl, entry );
+        free( impl->bins );
+        if (impl->base_uri) IUriRuntimeClass_Release( impl->base_uri );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
