+/*** HttpMediaTypeHeaderValue and HttpMediaTypeWithQualityHeaderValue ***/
+
+static HRESULT media_get_charset( struct header_value *impl, HSTRING *value )
+{
+    WCHAR *charset;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    charset = name_value_list_get( impl->params, L"charset" );
+    hr = hstring_create( charset && *charset ? charset : NULL, value );
+    free( charset );
+    return hr;
+}
+
+static HRESULT media_put_charset( struct header_value *impl, HSTRING value )
+{
+    WCHAR *charset;
+    HRESULT hr;
+
+    if (hstring_is_empty( value )) return name_value_list_set( impl->params, L"charset", NULL, TRUE );
+    if (!(charset = hstring_dup( value ))) return E_OUTOFMEMORY;
+    hr = name_value_list_set( impl->params, L"charset", charset, FALSE );
+    free( charset );
+    return hr;
+}
+
+static HRESULT media_put_media_type( struct header_value *impl, HSTRING value )
+{
+    WCHAR *str;
+    HRESULT hr;
+
+    if (!(str = hstring_dup( value ))) return E_OUTOFMEMORY;
+    if (!is_media_type( str ))
+    {
+        free( str );
+        return E_INVALIDARG;
+    }
+    hr = set_string( impl, &impl->str1, str );
+    free( str );
+    return hr;
+}
