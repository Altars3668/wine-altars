+/* The collection a header is kept as, made the first time it is asked for;
+ * one that does not parse is an empty collection, the text left as it was. */
+static HRESULT get_list( struct headers *impl, const WCHAR *name, void **value )
+{
+    const struct known_header *known = find_known( name );
+    struct header_entry *entry;
+    IInspectable *list;
+    HRESULT hr = S_OK;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    EnterCriticalSection( &impl->cs );
+    sync_lists( impl );
+    if ((entry = find_entry( impl, name )) && entry->object)
+        IInspectable_AddRef( (list = entry->object) );
+    else if (entry)
+    {
+        if (SUCCEEDED(header_list_parse_new( known->kind, entry->raw, &list )))
+        {
+            free( entry->raw );
+            entry->raw = NULL;
+        }
+        else hr = header_list_create( known->kind, &list );
+        if (SUCCEEDED(hr))
+        {
+            IInspectable_AddRef( (entry->object = list) );
+            place_entry( impl, entry );
+        }
+    }
+    else if (SUCCEEDED(hr = header_list_create( known->kind, &list )))
+    {
+        /* an empty collection, which is no header until it has a value */
+        IInspectable_AddRef( list );
+        hr = add_entry( impl, known->name, known, NULL, list );
+    }
+    LeaveCriticalSection( &impl->cs );
+    if (SUCCEEDED(hr)) *value = list;
+    else if (list) IInspectable_Release( list );
+    return hr;
+}
+
+static HRESULT get_single( struct headers *impl, const WCHAR *name, void **value )
+{
+    const struct known_header *known = find_known( name );
+    struct header_entry *entry;
+    IInspectable *object = NULL;
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if ((entry = find_entry( impl, name )))
+    {
+        if (entry->object) IInspectable_AddRef( (object = entry->object) );
+        else if (entry->raw && SUCCEEDED(header_value_parse_all( known->kind, entry->raw, &object )))
+        {
+            free( entry->raw );
+            entry->raw = NULL;
+            IInspectable_AddRef( (entry->object = object) );
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    *value = object;
+    return S_OK;
+}
