+/* The charset the Content-Type header names, or NULL; and whether the media
+ * type is JSON, which Windows reads as UTF-8 when it names none:
+ * application/json and anything "+json", not text/json or x-json. */
+WCHAR *headers_charset( struct headers *impl, BOOL *json )
+{
+    IInspectable *type = NULL;
+    HSTRING str = NULL;
+    WCHAR *ret = NULL;
+    const WCHAR *media;
+    UINT32 len;
+
+    *json = FALSE;
+    get_single( impl, L"Content-Type", (void **)&type );
+    if (!type) return NULL;
+    if (SUCCEEDED(IHttpMediaTypeHeaderValue_get_CharSet( (IHttpMediaTypeHeaderValue *)type, &str )) && str)
+        ret = hstring_dup( str );
+    WindowsDeleteString( str );
+    str = NULL;
+    if (SUCCEEDED(IHttpMediaTypeHeaderValue_get_MediaType( (IHttpMediaTypeHeaderValue *)type, &str )))
+    {
