+static BOOL is_http_uri( IUriRuntimeClass *uri )
+{
+    HSTRING scheme = NULL;
+    BOOL ret;
+
+    if (!uri || FAILED(IUriRuntimeClass_get_SchemeName( uri, &scheme ))) return FALSE;
+    ret = !wcsicmp( WindowsGetStringRawBuffer( scheme, NULL ), L"http" ) ||
+          !wcsicmp( WindowsGetStringRawBuffer( scheme, NULL ), L"https" );
+    WindowsDeleteString( scheme );
+    return ret;
+}
