+    if (!(handler = get_progress_handler( op ))) return;
+    IAsyncOperationProgressHandler_UINT64_UINT64_Invoke( (IAsyncOperationProgressHandler_UINT64_UINT64 *)handler,
+            (IAsyncOperationWithProgress_UINT64_UINT64 *)&op->generic_op_iface, progress );
+    IUnknown_Release( handler );
