+/* A typed property set: the header keeps its place if it has one, and takes
+ * one at the head of its bin if not; set to nothing, it is no header. */
+static HRESULT put_value( struct headers *impl, const WCHAR *name, WCHAR *raw, IInspectable *object )
+{
+    const struct known_header *known = find_known( name );
+    struct header_entry *entry;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    sync_lists( impl );
+    entry = find_entry( impl, name );
+    if (!raw && !object)
+    {
+        if (entry) free_entry( impl, entry );
+    }
+    else if (entry) set_entry( impl, entry, raw, object );
+    else hr = add_entry( impl, known ? known->name : name, known, raw, object );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT put_single( struct headers *impl, const WCHAR *name, IInspectable *object )
+{
+    if (object) IInspectable_AddRef( object );
+    return put_value( impl, name, NULL, object );
+}
