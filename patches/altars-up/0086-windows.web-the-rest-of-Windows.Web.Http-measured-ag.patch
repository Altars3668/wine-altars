+WCHAR *headers_get( struct headers *impl, const WCHAR *name )
+{
+    return get_text( impl, name );
+}
+
+BOOL headers_has( struct headers *impl, const WCHAR *name )
+{
+    WCHAR *text = get_text( impl, name );
+    free( text );
+    return text != NULL;
+}
+
+void headers_remove( struct headers *impl, const WCHAR *name )
+{
+    put_text( impl, name, NULL );
+}
+
+UINT32 headers_snapshot( struct headers *impl, WCHAR ***names, WCHAR ***values )
+{
+    struct header_entry **entries;
+    UINT32 count = 0, size, i;
+    WCHAR *text;
+
+    EnterCriticalSection( &impl->cs );
+    sync_lists( impl );
+    if ((size = ordered_entries( impl, &entries )) == ~0u)
+    {
+        LeaveCriticalSection( &impl->cs );
+        return ~0u;
+    }
+    *names = calloc( max( size, 1 ), sizeof(**names) );
+    *values = calloc( max( size, 1 ), sizeof(**values) );
+    if (!*names || !*values)
+    {
+        LeaveCriticalSection( &impl->cs );
+        free( entries );
+        free( *names );
+        free( *values );
+        return ~0u;
+    }
+    for (i = 0; i < size; i++)
+    {
+        if (!(text = entry_text( entries[i] ))) continue;
+        (*names)[count] = wcsdup( entries[i]->name );
+        (*values)[count] = text;
+        count++;
+    }
+    LeaveCriticalSection( &impl->cs );
+    free( entries );
+    return count;
+}
+
+void headers_free_snapshot( WCHAR **names, WCHAR **values, UINT32 count )
+{
+    UINT32 i;
+    for (i = 0; i < count; i++)
+    {
+        free( names[i] );
+        free( values[i] );
+    }
+    free( names );
+    free( values );
+}
+
+/* "{\r\n  Name: value\r\n}", as Windows writes a collection out */
+void headers_format( struct headers *impl, struct strbuf *buf )
+{
+    WCHAR **names, **values;
+    UINT32 count, i;
+
+    strbuf_appendw( buf, L"{\r\n" );
+    if ((count = headers_snapshot( impl, &names, &values )) != ~0u)
+    {
+        for (i = 0; i < count; i++)
+        {
+            strbuf_appendw( buf, L"  " );
+            strbuf_appendw( buf, names[i] );
+            strbuf_appendw( buf, L": " );
+            strbuf_appendw( buf, values[i] );
+            strbuf_appendw( buf, L"\r\n" );
+        }
+        headers_free_snapshot( names, values, count );
+    }
+    strbuf_appendc( buf, '}' );
+}
+
+void headers_set_base_uri( struct headers *impl, IUriRuntimeClass *uri )
+{
+    EnterCriticalSection( &impl->cs );
+    if (impl->base_uri) IUriRuntimeClass_Release( impl->base_uri );
+    if ((impl->base_uri = uri)) IUriRuntimeClass_AddRef( uri );
+    LeaveCriticalSection( &impl->cs );
+}
