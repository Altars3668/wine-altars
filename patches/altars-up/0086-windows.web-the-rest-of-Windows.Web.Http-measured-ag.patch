+    DateTime date;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(text = get_text( impl, name ))) return S_OK;
+    if (parse_http_date( text, &date )) box_datetime( date, value );
+    free( text );
+    return S_OK;
+}
+
+static HRESULT put_date( struct headers *impl, const WCHAR *name, IReference_DateTime *value )
+{
+    struct strbuf buf;
+    DateTime date;
+    HRESULT hr;
+
+    if (!value) return put_text( impl, name, NULL );
+    if (FAILED(hr = IReference_DateTime_get_Value( value, &date ))) return hr;
+    strbuf_init( &buf );
+    format_http_date( &buf, date );
+    hr = buf.failed ? E_OUTOFMEMORY : put_text( impl, name, buf.data );
+    strbuf_free( &buf );
+    return hr;
+}
+
+static BOOL get_number( struct headers *impl, const WCHAR *name, UINT64 *number )
+{
+    WCHAR *text;
+    BOOL ret;
+
+    if (!(text = get_text( impl, name ))) return FALSE;
+    ret = parse_uint64( text, wcslen( text ), number );
+    free( text );
+    return ret;
+}
+
+static HRESULT put_number( struct headers *impl, const WCHAR *name, UINT64 number )
+{
+    WCHAR text[32];
+    swprintf( text, ARRAY_SIZE(text), L"%I64u", number );
+    return put_text( impl, name, text );
+}
