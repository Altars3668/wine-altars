+static HRESULT value_create( enum value_kind kind, struct header_value **out )
+{
+    struct header_value *impl;
+    HRESULT hr;
+
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IInspectable_iface.lpVtbl = class_vtbls[kind];
+    impl->IStringable_iface.lpVtbl = &value_stringable_vtbl;
+    impl->ref = 1;
+    impl->kind = kind;
+    InitializeSRWLock( &impl->lock );
+
+    switch (kind)
+    {
+    case VALUE_MEDIA_TYPE:
+    case VALUE_MEDIA_TYPE_QUALITY:
+    case VALUE_CONTENT_DISPOSITION:
+    case VALUE_CREDENTIALS:
+    case VALUE_CHALLENGE:
+    case VALUE_EXPECTATION:
+    case VALUE_TRANSFER_CODING:
+        if (FAILED(hr = name_value_list_create( &impl->params )))
+        {
+            free( impl );
+            return hr;
+        }
+        break;
+    default:
+        break;
+    }
+
+    *out = impl;
+    return S_OK;
+}
+
+HRESULT media_type_create_raw( const WCHAR *media_type, const WCHAR *charset, IHttpMediaTypeHeaderValue **out )
+{
+    struct header_value *impl;
+    HRESULT hr;
+
+    if (FAILED(hr = value_create( VALUE_MEDIA_TYPE, &impl ))) return hr;
+    if (media_type && !(impl->str1 = wcsdup( media_type ))) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr) && charset) hr = name_value_list_set( impl->params, L"charset", charset, FALSE );
+    if (FAILED(hr))
+    {
+        value_Release( &impl->IInspectable_iface );
+        return hr;
+    }
+    *out = (IHttpMediaTypeHeaderValue *)&impl->IInspectable_iface;
+    return S_OK;
+}
