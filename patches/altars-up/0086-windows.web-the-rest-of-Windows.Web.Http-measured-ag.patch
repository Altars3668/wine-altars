+      &IID_IVectorView_HttpConnectionOptionHeaderValue, &IID_IIterable_HttpConnectionOptionHeaderValue,
+      &IID_IIterator_HttpConnectionOptionHeaderValue, VALUE_CONNECTION_OPTION, L", " },
+    { L"Windows.Web.Http.Headers.HttpCookiePairHeaderValueCollection",
+      &IID_IHttpCookiePairHeaderValueCollection, &IID_IVector_HttpCookiePairHeaderValue,
+      &IID_IVectorView_HttpCookiePairHeaderValue, &IID_IIterable_HttpCookiePairHeaderValue,
+      &IID_IIterator_HttpCookiePairHeaderValue, VALUE_COOKIE_PAIR, L"; " },
+    { L"Windows.Web.Http.Headers.HttpExpectationHeaderValueCollection",
+      &IID_IHttpExpectationHeaderValueCollection, &IID_IVector_HttpExpectationHeaderValue,
+      &IID_IVectorView_HttpExpectationHeaderValue, &IID_IIterable_HttpExpectationHeaderValue,
+      &IID_IIterator_HttpExpectationHeaderValue, VALUE_EXPECTATION, L", " },
+    { L"Windows.Web.Http.Headers.HttpTransferCodingHeaderValueCollection",
+      &IID_IHttpTransferCodingHeaderValueCollection, &IID_IVector_HttpTransferCodingHeaderValue,
+      &IID_IVectorView_HttpTransferCodingHeaderValue, &IID_IIterable_HttpTransferCodingHeaderValue,
