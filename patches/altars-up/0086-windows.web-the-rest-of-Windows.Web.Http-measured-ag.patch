+
+static IUriRuntimeClassFactory *uri_factory(void)
+{
+    static IUriRuntimeClassFactory *factory;
+    IUriRuntimeClassFactory *tmp;
+    HSTRING name;
+    HRESULT hr;
+
+    if (factory) return factory;
+    if (FAILED(class_name_create( L"Windows.Foundation.Uri", &name ))) return NULL;
+    hr = RoGetActivationFactory( name, &IID_IUriRuntimeClassFactory, (void **)&tmp );
+    WindowsDeleteString( name );
+    if (FAILED(hr)) return NULL;
+    if (InterlockedCompareExchangePointer( (void **)&factory, tmp, NULL )) IUriRuntimeClassFactory_Release( tmp );
+    return factory;
+}
+
+/* Only an absolute http-style URI is one: "/relative" is not. */
+HRESULT uri_create( const WCHAR *str, IUriRuntimeClass **out )
+{
+    IUriRuntimeClassFactory *factory = uri_factory();
+    HSTRING hstr, scheme = NULL;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!factory) return E_FAIL;
+    if (!str || !*str || !wcschr( str, ':' )) return E_INVALIDARG;
+    if (FAILED(hr = hstring_create( str, &hstr ))) return hr;
+    hr = IUriRuntimeClassFactory_CreateUri( factory, hstr, out );
+    WindowsDeleteString( hstr );
+    if (FAILED(hr)) return E_INVALIDARG;
+    if (FAILED(IUriRuntimeClass_get_SchemeName( *out, &scheme )) || hstring_is_empty( scheme ))
+    {
+        IUriRuntimeClass_Release( *out );
+        *out = NULL;
+        hr = E_INVALIDARG;
+    }
+    WindowsDeleteString( scheme );
+    return hr;
+}
+
+HRESULT uri_create_relative( IUriRuntimeClass *base, const WCHAR *str, IUriRuntimeClass **out )
+{
+    WCHAR *base_str, *combined;
+    DWORD len = 0;
+    HRESULT hr;
+
+    *out = NULL;
+    if (SUCCEEDED(uri_create( str, out ))) return S_OK;
+    if (!base || !(base_str = uri_to_string( base ))) return E_INVALIDARG;
+    InternetCombineUrlW( base_str, str, NULL, &len, ICU_NO_ENCODE );
+    if (!len || !(combined = malloc( (len + 1) * sizeof(WCHAR) )))
+    {
+        free( base_str );
+        return E_INVALIDARG;
+    }
+    if (InternetCombineUrlW( base_str, str, combined, &len, ICU_NO_ENCODE )) hr = uri_create( combined, out );
+    else hr = E_INVALIDARG;
+    free( combined );
+    free( base_str );
+    return hr;
+}
+
+WCHAR *uri_to_string( IUriRuntimeClass *uri )
+{
+    HSTRING str = NULL;
+    WCHAR *ret;
+
+    if (FAILED(IUriRuntimeClass_get_AbsoluteUri( uri, &str )) || !str)
+    {
+        WindowsDeleteString( str );
+        if (FAILED(IUriRuntimeClass_get_RawUri( uri, &str ))) return NULL;
+    }
+    ret = hstring_dup( str );
+    WindowsDeleteString( str );
+    return ret;
+}
