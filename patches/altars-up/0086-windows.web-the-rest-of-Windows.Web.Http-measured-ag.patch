+static IUnknown *get_progress_handler( struct async_op *op )
+{
+    IUnknown *handler;
+
+    EnterCriticalSection( &op->cs );
+    if (op->status != Started) handler = NULL;
+    else if ((handler = op->progress)) IUnknown_AddRef( handler );
+    LeaveCriticalSection( &op->cs );
+    return handler;
+}
+
+void async_op_progress_http( struct async_op *op, const HttpProgress *progress )
+{
+    IUnknown *handler;
+
+    if (!op || op->type->progress != ASYNC_PROGRESS_HTTP) return;
+    if (!(handler = get_progress_handler( op ))) return;
+    IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress_Invoke(
+            (IAsyncOperationProgressHandler_HttpResponseMessage_HttpProgress *)handler,
+            (IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress *)&op->generic_op_iface, *progress );
+    IUnknown_Release( handler );
