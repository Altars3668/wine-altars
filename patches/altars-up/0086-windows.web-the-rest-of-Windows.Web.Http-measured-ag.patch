+HRESULT content_disposition_create( const WCHAR *type, const WCHAR *name, const WCHAR *file_name,
+                                    IHttpContentDispositionHeaderValue **out )
+{
+    struct header_value *impl;
+    HRESULT hr;
+
+    if (FAILED(hr = value_create( VALUE_CONTENT_DISPOSITION, &impl ))) return hr;
+    if (!(impl->str1 = wcsdup( type ))) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr) && name) hr = name_value_list_set( impl->params, L"name", name, FALSE );
+    if (SUCCEEDED(hr) && file_name) hr = name_value_list_set( impl->params, L"filename", file_name, FALSE );
+    if (SUCCEEDED(hr) && file_name) hr = name_value_list_set( impl->params, L"filename*", file_name, FALSE );
+    if (FAILED(hr))
+    {
+        value_Release( &impl->IInspectable_iface );
+        return hr;
+    }
+    *out = (IHttpContentDispositionHeaderValue *)&impl->IInspectable_iface;
+    return S_OK;
+}
