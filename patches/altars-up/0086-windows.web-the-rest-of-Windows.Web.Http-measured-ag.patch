+static HRESULT WINAPI body_stream_ReadAsync( IInputStream *iface, IBuffer *buffer, UINT32 count, InputStreamOptions options,
+                                             IAsyncOperationWithProgress_IBuffer_UINT32 **operation )
+{
+    struct body_stream *impl = impl_from_IInputStream( iface );
+    struct read_context *read;
+
+    TRACE( "iface %p, buffer %p, count %u, options %d, operation %p.\n", iface, buffer, count, options, operation );
+
+    if (!buffer || !operation) return E_POINTER;
+    *operation = NULL;
+    if (impl->closed) return RO_E_CLOSED;
+    if (!(read = calloc( 1, sizeof(*read) ))) return E_OUTOFMEMORY;
+    IInputStream_AddRef( (IInputStream *)(read->stream = impl) );
+    IBuffer_AddRef( (read->buffer = buffer) );
+    read->count = count;
+    read->options = options;
+    return async_op_create( &async_read_type, body_stream_read, read, free_read_context, (void **)operation );
+}
