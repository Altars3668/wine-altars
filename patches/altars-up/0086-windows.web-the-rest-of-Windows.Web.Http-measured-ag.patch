+/* The quality of a media range is its "q" parameter, kept as text. */
+static HRESULT WINAPI media_quality_get_Quality( IHttpMediaTypeWithQualityHeaderValue *iface, IReference_DOUBLE **value )
+{
+    struct header_value *impl = media_quality_impl( iface );
+    WCHAR *text, *end;
+    double quality;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(text = name_value_list_get( impl->params, L"q" ))) return S_OK;
+    quality = wcstod( text, &end );
+    if (*text && !*end && (iswdigit( *text ) || *text == '.')) box_double( quality, value );
+    free( text );
+    return S_OK;
+}
