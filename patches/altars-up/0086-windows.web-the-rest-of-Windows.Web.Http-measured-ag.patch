+static HRESULT create_range( BOOL has_range, UINT64 from, UINT64 to, BOOL has_length, UINT64 length, IInspectable **value )
+{
+    struct header_value *impl;
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (has_range && from > to) return E_INVALIDARG;
+    if (has_range && has_length && to >= length) return E_INVALIDARG;
+    if (FAILED(hr = value_create( VALUE_CONTENT_RANGE, &impl ))) return hr;
+    if (!(impl->str1 = wcsdup( L"bytes" )))
+    {
+        value_Release( &impl->IInspectable_iface );
+        return E_OUTOFMEMORY;
+    }
+    impl->has_first = impl->has_last = has_range;
+    impl->first = from;
+    impl->last = to;
+    impl->has_length = has_length;
+    impl->length = length;
+    *value = &impl->IInspectable_iface;
+    return S_OK;
+}
