+    if (index >= impl->size) hr = E_BOUNDS;
+    else
+    {
+        IInspectable_AddRef( value );
+        IInspectable_Release( impl->elements[index] );
+        impl->elements[index] = value;
+        vector_changed( impl );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
