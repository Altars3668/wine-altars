+static HRESULT create_named( enum value_kind kind, HSTRING first, HSTRING second, BOOL second_required, IInspectable **out )
+{
+    struct header_value *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (!is_token_hstring( first )) return E_INVALIDARG;
+    if (second_required && hstring_is_empty( second )) return E_INVALIDARG;
+    if (FAILED(hr = value_create( kind, &impl ))) return hr;
+    if (!(impl->str1 = hstring_dup( first )) || (!hstring_is_empty( second ) && !(impl->str2 = hstring_dup( second ))))
+    {
+        value_Release( &impl->IInspectable_iface );
+        return E_OUTOFMEMORY;
+    }
+    *out = &impl->IInspectable_iface;
+    return S_OK;
+}
+
+static HRESULT create_with_quality( enum value_kind kind, HSTRING value, BOOL has_quality, double quality, IInspectable **out )
+{
+    struct header_value *impl;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (has_quality && (quality < 0 || quality > 1)) return E_INVALIDARG;
+    if (FAILED(hr = create_named( kind, value, NULL, FALSE, out ))) return hr;
+    impl = impl_from_IInspectable( *out );
+    if (kind == VALUE_LANGUAGE_RANGE_QUALITY && !is_language_range( impl->str1 ))
+    {
+        IInspectable_Release( *out );
+        *out = NULL;
+        return E_INVALIDARG;
+    }
+    impl->has_quality = has_quality;
+    impl->quality = quality;
+    return S_OK;
+}
