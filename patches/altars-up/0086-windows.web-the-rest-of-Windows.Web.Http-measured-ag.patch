+    if ((count = vector_snapshot( params, &items )) == ~0u) return NULL;
+    for (i = 0; i < count; i++)
+    {
+        struct header_value *nv = unsafe_header_value( items[i] );
+        if (!nv) continue;
+        AcquireSRWLockShared( &nv->lock );
+        if (nv->str1 && !wcsicmp( nv->str1, name ))
+        {
