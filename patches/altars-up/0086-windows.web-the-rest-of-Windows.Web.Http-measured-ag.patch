+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+/*
+ * Every IAsyncOperationWithProgress<T, P> has the same slots, and the ones
+ * this namespace hands out differ only in the interface id, the class name,
+ * whether T is an object, a string or a number, and whether P is an
+ * HttpProgress or a number.  So there is one implementation, told which it
+ * is by a struct async_type.
+ *
+ * The work runs on the thread pool as soon as the operation is made, as it
+ * does on Windows, and progress and completion are reported from there.
+ * Cancelling completes the operation at once, from another thread, with
+ * status Canceled and no error; the work is told through an event and its
+ * result, whenever it comes, is dropped.
+ */
+
+#define Closed 4
+#define HANDLER_NOT_SET ((void *)~(ULONG_PTR)0)
+
+#define DEFINE_ASYNC_TYPE( name, iid, class_name, result, progress ) \
+    const struct async_type name = { &iid, class_name, result, progress }
+
+DEFINE_ASYNC_TYPE( async_response_type, IID_IAsyncOperationWithProgress_HttpResponseMessage_HttpProgress,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Web.Http.HttpResponseMessage, Windows.Web.Http.HttpProgress>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_HTTP );
+DEFINE_ASYNC_TYPE( async_request_result_type, IID_IAsyncOperationWithProgress_HttpRequestResult_HttpProgress,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Web.Http.HttpRequestResult, Windows.Web.Http.HttpProgress>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_HTTP );
+DEFINE_ASYNC_TYPE( async_string_result_type, IID_IAsyncOperationWithProgress_HttpGetStringResult_HttpProgress,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Web.Http.HttpGetStringResult, Windows.Web.Http.HttpProgress>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_HTTP );
+DEFINE_ASYNC_TYPE( async_buffer_result_type, IID_IAsyncOperationWithProgress_HttpGetBufferResult_HttpProgress,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Web.Http.HttpGetBufferResult, Windows.Web.Http.HttpProgress>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_HTTP );
+DEFINE_ASYNC_TYPE( async_stream_result_type, IID_IAsyncOperationWithProgress_HttpGetInputStreamResult_HttpProgress,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Web.Http.HttpGetInputStreamResult, Windows.Web.Http.HttpProgress>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_HTTP );
+DEFINE_ASYNC_TYPE( async_http_string_type, IID_IAsyncOperationWithProgress_HSTRING_HttpProgress,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<String, Windows.Web.Http.HttpProgress>",
+                   ASYNC_RESULT_STRING, ASYNC_PROGRESS_HTTP );
+DEFINE_ASYNC_TYPE( async_http_buffer_type, IID_IAsyncOperationWithProgress_IBuffer_HttpProgress,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Storage.Streams.IBuffer, Windows.Web.Http.HttpProgress>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_HTTP );
+DEFINE_ASYNC_TYPE( async_http_stream_type, IID_IAsyncOperationWithProgress_IInputStream_HttpProgress,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Storage.Streams.IInputStream, Windows.Web.Http.HttpProgress>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_HTTP );
+DEFINE_ASYNC_TYPE( async_uint64_type, IID_IAsyncOperationWithProgress_UINT64_UINT64,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<UInt64, UInt64>",
+                   ASYNC_RESULT_UINT64, ASYNC_PROGRESS_UINT64 );
+DEFINE_ASYNC_TYPE( async_string_type, IID_IAsyncOperationWithProgress_HSTRING_UINT64,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<String, UInt64>",
+                   ASYNC_RESULT_STRING, ASYNC_PROGRESS_UINT64 );
+DEFINE_ASYNC_TYPE( async_buffer_type, IID_IAsyncOperationWithProgress_IBuffer_UINT64,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Storage.Streams.IBuffer, UInt64>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_UINT64 );
+DEFINE_ASYNC_TYPE( async_read_type, IID_IAsyncOperationWithProgress_IBuffer_UINT32,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Storage.Streams.IBuffer, UInt32>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_UINT32 );
+DEFINE_ASYNC_TYPE( async_stream_type, IID_IAsyncOperationWithProgress_IInputStream_UINT64,
+                   L"Windows.Foundation.IAsyncOperationWithProgress`2<Windows.Storage.Streams.IInputStream, UInt64>",
+                   ASYNC_RESULT_OBJECT, ASYNC_PROGRESS_UINT64 );
+
+/* the slots every IAsyncOperationWithProgress<T, P> has, T and P left out */
+typedef struct generic_op generic_op;
+typedef struct generic_opVtbl
+{
+    HRESULT (WINAPI *QueryInterface)( generic_op *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( generic_op *iface );
+    ULONG (WINAPI *Release)( generic_op *iface );
+    HRESULT (WINAPI *GetIids)( generic_op *iface, ULONG *iid_count, IID **iids );
+    HRESULT (WINAPI *GetRuntimeClassName)( generic_op *iface, HSTRING *class_name );
+    HRESULT (WINAPI *GetTrustLevel)( generic_op *iface, TrustLevel *trust_level );
+    HRESULT (WINAPI *put_Progress)( generic_op *iface, IUnknown *handler );
+    HRESULT (WINAPI *get_Progress)( generic_op *iface, IUnknown **handler );
+    HRESULT (WINAPI *put_Completed)( generic_op *iface, IUnknown *handler );
+    HRESULT (WINAPI *get_Completed)( generic_op *iface, IUnknown **handler );
+    HRESULT (WINAPI *GetResults)( generic_op *iface, void *results );
+} generic_opVtbl;
+struct generic_op { const generic_opVtbl *lpVtbl; };
+
+/* both kinds of completion handler: Invoke(operation, status) */
+typedef struct completed_handler completed_handler;
+typedef struct completed_handlerVtbl
+{
+    HRESULT (WINAPI *QueryInterface)( completed_handler *iface, REFIID iid, void **out );
+    ULONG (WINAPI *AddRef)( completed_handler *iface );
+    ULONG (WINAPI *Release)( completed_handler *iface );
+    HRESULT (WINAPI *Invoke)( completed_handler *iface, IUnknown *operation, AsyncStatus status );
+} completed_handlerVtbl;
+struct completed_handler { const completed_handlerVtbl *lpVtbl; };
+
+struct async_op
+{
+    generic_op generic_op_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    LONG ref;
+    const struct async_type *type;
+
+    CRITICAL_SECTION cs;
+    AsyncStatus status;
+    HRESULT error;
+    HRESULT results_error;
+    union async_value result;
+    completed_handler *completed;
+    IUnknown *progress;
+    UINT32 id;
+
+    async_work work;
+    void *context;
+    void (*free_context)( void *context );
+    HANDLE cancel_event;
+};
+
+static inline struct async_op *impl_from_generic_op( generic_op *iface )
+{
+    return CONTAINING_RECORD( iface, struct async_op, generic_op_iface );
+}
+
+static void release_value( const struct async_type *type, union async_value *value )
+{
+    if (type->result == ASYNC_RESULT_OBJECT && value->object) IUnknown_Release( value->object );
+    if (type->result == ASYNC_RESULT_STRING) WindowsDeleteString( value->string );
+    memset( value, 0, sizeof(*value) );
+}
+
+static HRESULT WINAPI async_op_QueryInterface( generic_op *iface, REFIID iid, void **out )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, impl->type->iid ))
+    {
+        IInspectable_AddRef( (IInspectable *)(*out = &impl->generic_op_iface) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IAsyncInfo ))
+    {
+        IInspectable_AddRef( (IInspectable *)(*out = &impl->IAsyncInfo_iface) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI async_op_AddRef( generic_op *iface )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI async_op_Release( generic_op *iface )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->completed && impl->completed != HANDLER_NOT_SET) impl->completed->lpVtbl->Release( impl->completed );
+        if (impl->progress) IUnknown_Release( impl->progress );
+        release_value( impl->type, &impl->result );
+        if (impl->free_context) impl->free_context( impl->context );
+        CloseHandle( impl->cancel_event );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI async_op_GetIids( generic_op *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI async_op_GetRuntimeClassName( generic_op *iface, HSTRING *class_name )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return class_name_create( impl->type->class_name, class_name );
+}
+
+static HRESULT WINAPI async_op_GetTrustLevel( generic_op *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI async_op_put_Progress( generic_op *iface, IUnknown *handler )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+    IUnknown *old;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Closed) hr = E_ILLEGAL_METHOD_CALL;
+    else
+    {
+        old = impl->progress;
+        if ((impl->progress = handler)) IUnknown_AddRef( handler );
+        if (old) IUnknown_Release( old );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI async_op_get_Progress( generic_op *iface, IUnknown **handler )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (!handler) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Closed) hr = E_ILLEGAL_METHOD_CALL;
+    if ((*handler = impl->progress)) IUnknown_AddRef( *handler );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI async_op_put_Completed( generic_op *iface, IUnknown *handler )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+    completed_handler *completed = (completed_handler *)handler;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Closed) hr = E_ILLEGAL_METHOD_CALL;
+    else if (impl->completed != HANDLER_NOT_SET) hr = E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    else if ((impl->completed = completed))
+    {
+        completed->lpVtbl->AddRef( completed );
+        if (impl->status > Started)
+        {
+            AsyncStatus status = impl->status;
+            impl->completed = NULL; /* invoked once */
+            LeaveCriticalSection( &impl->cs );
+            completed->lpVtbl->Invoke( completed, (IUnknown *)&impl->generic_op_iface, status );
+            completed->lpVtbl->Release( completed );
+            return S_OK;
+        }
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI async_op_get_Completed( generic_op *iface, IUnknown **handler )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (!handler) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Closed) hr = E_ILLEGAL_METHOD_CALL;
+    if (impl->completed == NULL || impl->completed == HANDLER_NOT_SET) *handler = NULL;
+    else
+    {
+        impl->completed->lpVtbl->AddRef( impl->completed );
+        *handler = (IUnknown *)impl->completed;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI async_op_GetResults( generic_op *iface, void *results )
+{
+    struct async_op *impl = impl_from_generic_op( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, results %p.\n", iface, results );
+
+    if (!results) return E_POINTER;
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Error) hr = impl->error;
+    else if (impl->status != Completed) hr = E_ILLEGAL_METHOD_CALL;
+    else if (FAILED(hr = impl->results_error)) ;
+    else switch (impl->type->result)
+    {
+    case ASYNC_RESULT_OBJECT:
+        if ((*(IUnknown **)results = impl->result.object)) IUnknown_AddRef( impl->result.object );
+        break;
+    case ASYNC_RESULT_STRING:
+        hr = WindowsDuplicateString( impl->result.string, (HSTRING *)results );
+        break;
+    case ASYNC_RESULT_UINT64:
+        *(UINT64 *)results = impl->result.uint64;
+        break;
+    }
+    if (impl->status == Error)
+    {
+        if (impl->type->result == ASYNC_RESULT_UINT64) *(UINT64 *)results = 0;
+        else *(void **)results = NULL;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static const generic_opVtbl async_op_vtbl =
+{
+    async_op_QueryInterface,
+    async_op_AddRef,
+    async_op_Release,
+    async_op_GetIids,
+    async_op_GetRuntimeClassName,
+    async_op_GetTrustLevel,
+    async_op_put_Progress,
+    async_op_get_Progress,
+    async_op_put_Completed,
+    async_op_get_Completed,
+    async_op_GetResults,
+};
+
+DEFINE_IINSPECTABLE( async_info, IAsyncInfo, struct async_op, generic_op_iface )
+
+static HRESULT WINAPI async_info_get_Id( IAsyncInfo *iface, UINT32 *id )
+{
+    struct async_op *impl = impl_from_IAsyncInfo( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, id %p.\n", iface, id );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Closed) hr = E_ILLEGAL_METHOD_CALL;
+    *id = impl->id;
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI async_info_get_Status( IAsyncInfo *iface, AsyncStatus *status )
+{
+    struct async_op *impl = impl_from_IAsyncInfo( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, status %p.\n", iface, status );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Closed) hr = E_ILLEGAL_METHOD_CALL;
+    *status = impl->status;
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT WINAPI async_info_get_ErrorCode( IAsyncInfo *iface, HRESULT *error_code )
+{
+    struct async_op *impl = impl_from_IAsyncInfo( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, error_code %p.\n", iface, error_code );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Closed) *error_code = hr = E_ILLEGAL_METHOD_CALL;
+    else *error_code = impl->status == Error ? impl->error : S_OK;
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static void CALLBACK invoke_completed( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct async_op *impl = context;
+    completed_handler *completed;
+
+    EnterCriticalSection( &impl->cs );
+    completed = impl->completed;
+    if (completed == HANDLER_NOT_SET) completed = NULL;
+    impl->completed = NULL;
+    LeaveCriticalSection( &impl->cs );
+
+    if (completed)
+    {
+        completed->lpVtbl->Invoke( completed, (IUnknown *)&impl->generic_op_iface, Canceled );
+        completed->lpVtbl->Release( completed );
+    }
+    async_op_Release( &impl->generic_op_iface );
+}
+
+static HRESULT WINAPI async_info_Cancel( IAsyncInfo *iface )
+{
+    struct async_op *impl = impl_from_IAsyncInfo( iface );
+    BOOL canceled = FALSE;
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Closed) hr = E_ILLEGAL_METHOD_CALL;
+    else if (impl->status == Started)
+    {
+        impl->status = Canceled;
+        canceled = TRUE;
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    if (canceled)
+    {
+        SetEvent( impl->cancel_event );
+        /* Windows calls the handler from the thread pool, not from Cancel */
+        async_op_AddRef( &impl->generic_op_iface );
+        if (!TrySubmitThreadpoolCallback( invoke_completed, impl, NULL )) invoke_completed( NULL, impl );
+    }
+    return hr;
+}
+
+static HRESULT WINAPI async_info_Close( IAsyncInfo *iface )
+{
+    struct async_op *impl = impl_from_IAsyncInfo( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Started) hr = E_ILLEGAL_STATE_CHANGE;
+    else if (impl->status != Closed)
+    {
+        impl->status = Closed;
+        release_value( impl->type, &impl->result );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static const struct IAsyncInfoVtbl async_info_vtbl =
+{
+    async_info_QueryInterface,
+    async_info_AddRef,
+    async_info_Release,
+    /* IInspectable methods */
+    async_info_GetIids,
+    async_info_GetRuntimeClassName,
+    async_info_GetTrustLevel,
+    /* IAsyncInfo methods */
+    async_info_get_Id,
+    async_info_get_Status,
+    async_info_get_ErrorCode,
+    async_info_Cancel,
+    async_info_Close,
+};
+
+static void CALLBACK async_op_run( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct async_op *impl = context;
+    union async_value result = {0};
+    completed_handler *completed = NULL;
+    AsyncStatus status;
+    HRESULT hr;
+
+    hr = impl->work( impl, impl->context, &result );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->status == Started)
+    {
+        impl->status = FAILED(hr) ? Error : Completed;
+        impl->error = hr;
+        if (SUCCEEDED(hr)) impl->result = result;
+        else release_value( impl->type, &result );
+        if (impl->completed != HANDLER_NOT_SET)
+        {
+            completed = impl->completed;
+            impl->completed = NULL;
+        }
+    }
+    else release_value( impl->type, &result );
+    status = impl->status;
+    LeaveCriticalSection( &impl->cs );
+
+    TRACE( "operation %p finished, status %u, hr %#lx.\n", impl, status, hr );
+
+    if (completed)
+    {
+        completed->lpVtbl->Invoke( completed, (IUnknown *)&impl->generic_op_iface, status );
+        completed->lpVtbl->Release( completed );
+    }
+    async_op_Release( &impl->generic_op_iface );
+}
+
+HRESULT async_op_create( const struct async_type *type, async_work work, void *context,
+                         void (*free_context)( void *context ), void **out )
+{
+    static LONG last_id;
+    struct async_op *impl;
+
+    *out = NULL;
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        if (free_context) free_context( context );
+        return E_OUTOFMEMORY;
+    }
+    impl->generic_op_iface.lpVtbl = &async_op_vtbl;
+    impl->IAsyncInfo_iface.lpVtbl = &async_info_vtbl;
+    impl->ref = 1;
+    impl->type = type;
+    impl->status = Started;
+    impl->completed = HANDLER_NOT_SET;
+    impl->id = InterlockedIncrement( &last_id );
+    impl->work = work;
+    impl->context = context;
+    impl->free_context = free_context;
+    impl->cancel_event = CreateEventW( NULL, TRUE, FALSE, NULL );
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": async_op.cs");
+
+    /* the work holds the operation until it is done */
+    async_op_AddRef( &impl->generic_op_iface );
+    if (!TrySubmitThreadpoolCallback( async_op_run, impl, NULL ))
+    {
+        HRESULT hr = HRESULT_FROM_WIN32( GetLastError() );
+        async_op_Release( &impl->generic_op_iface );
+        async_op_Release( &impl->generic_op_iface );
+        return hr;
+    }
+
+    TRACE( "created %s operation %p.\n", debugstr_w( type->class_name ), impl );
+    *out = &impl->generic_op_iface;
+    return S_OK;
+}
+
+void async_op_fail_results( struct async_op *op, HRESULT hr )
+{
+    op->results_error = hr;
+}
+
+BOOL async_op_canceled( struct async_op *op )
+{
+    return WaitForSingleObject( op->cancel_event, 0 ) == WAIT_OBJECT_0;
+}
+
+HANDLE async_op_cancel_event( struct async_op *op )
+{
+    return op->cancel_event;
+}
