+#include <wctype.h>
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(web);
+
+/*
+ * The request, response and content headers: a map from name to value, and
+ * typed properties over the same headers.  How the two see each other was
+ * measured on Windows and is kept here:
+ *
+ * - Insert and Append parse the value of a header they know and keep what
+ *   they parsed, so "gzip,deflate;q=0.5" reads back as "gzip, deflate; q=0.5";
+ *   a value that does not parse is refused with E_INVALIDARG, and Insert has
+ *   removed the old one by then.  Append parses the old value and the new one
+ *   together, and a header that can only have one value refuses a second
+ *   with E_ILLEGAL_METHOD_CALL.
+ * - TryAppendWithoutValidation keeps the text as it is.
+ * - A typed property hands out the object the header is kept as, the same
+ *   object every time, and the header is written from it whenever it is
+ *   read: changing the object changes the header.  Replacing or removing the
+ *   header lets go of the object; a collection left empty is no header.
+ * - Content headers belong only in the content's collection and nothing
+ *   else does: E_ILLEGAL_METHOD_CALL either way.
+ * - A missing header is E_BOUNDS, an empty value a NULL string.
+ * - The headers are kept, and listed, the way ATL's CAtlMap keeps them:
+ *   in 17 bins at first, by the FNV-1a hash of the name's UTF-16 in upper
+ *   case, a new header at the head of its bin; more than 2.25 headers a bin
+ *   and they are spread over the next prime number of bins that leaves
+ *   them 0.75 a bin, which reverses the order within each bin.  Insert puts
+ *   the header it replaces at the head of its bin again; Append, a typed
+ *   property and TryAppendWithoutValidation leave it where it is.  A typed
+ *   collection takes its place when it gains its first value, and gives it
+ *   up when it loses its last.  All as ordered on Windows.
+ */
+
+enum header_type
+{
+    TYPE_LIST,      /* a collection of values */
+    TYPE_SINGLE,    /* one value object */
+    TYPE_DATE,
+    TYPE_SECONDS,   /* Age */
+    TYPE_UINT32,
+    TYPE_UINT64,
+    TYPE_URI,
+    TYPE_HOST,
+    TYPE_BASE64,
+    TYPE_STRING,
+};
+
+struct known_header
+{
+    const WCHAR *name;
+    enum header_type type;
+    int kind;        /* enum list_kind or enum value_kind */
+    BOOL content;
+};
+
+static const struct known_header known_headers[] =
+{
+    { L"Accept", TYPE_LIST, LIST_MEDIA_TYPE_QUALITY },
+    { L"Accept-Encoding", TYPE_LIST, LIST_CONTENT_CODING_QUALITY },
+    { L"Accept-Language", TYPE_LIST, LIST_LANGUAGE_RANGE_QUALITY },
+    { L"Age", TYPE_SECONDS },
+    { L"Allow", TYPE_LIST, LIST_METHOD },
+    { L"Authorization", TYPE_SINGLE, VALUE_CREDENTIALS },
+    { L"Cache-Control", TYPE_LIST, LIST_CACHE_DIRECTIVE },
+    { L"Connection", TYPE_LIST, LIST_CONNECTION_OPTION },
+    { L"Content-Disposition", TYPE_SINGLE, VALUE_CONTENT_DISPOSITION, TRUE },
+    { L"Content-Encoding", TYPE_LIST, LIST_CONTENT_CODING, TRUE },
+    { L"Content-Language", TYPE_LIST, LIST_LANGUAGE, TRUE },
+    { L"Content-Length", TYPE_UINT64, 0, TRUE },
+    { L"Content-Location", TYPE_URI, 0, TRUE },
+    { L"Content-MD5", TYPE_BASE64, 0, TRUE },
+    { L"Content-Range", TYPE_SINGLE, VALUE_CONTENT_RANGE, TRUE },
+    { L"Content-Type", TYPE_SINGLE, VALUE_MEDIA_TYPE, TRUE },
+    { L"Cookie", TYPE_LIST, LIST_COOKIE_PAIR },
+    { L"Date", TYPE_DATE },
+    { L"Expect", TYPE_LIST, LIST_EXPECTATION },
+    { L"Expires", TYPE_DATE, 0, TRUE },
+    { L"From", TYPE_STRING },
+    { L"Host", TYPE_HOST },
+    { L"If-Modified-Since", TYPE_DATE },
+    { L"If-Unmodified-Since", TYPE_DATE },
+    { L"Last-Modified", TYPE_DATE, 0, TRUE },
+    { L"Location", TYPE_URI },
+    { L"Max-Forwards", TYPE_UINT32 },
+    { L"Proxy-Authenticate", TYPE_LIST, LIST_CHALLENGE },
+    { L"Proxy-Authorization", TYPE_SINGLE, VALUE_CREDENTIALS },
+    { L"Referer", TYPE_URI },
+    { L"Retry-After", TYPE_SINGLE, VALUE_DATE_OR_DELTA },
+    { L"Transfer-Encoding", TYPE_LIST, LIST_TRANSFER_CODING },
+    { L"User-Agent", TYPE_LIST, LIST_PRODUCT_INFO },
+    { L"WWW-Authenticate", TYPE_LIST, LIST_CHALLENGE },
+};
+
+static const struct known_header *find_known( const WCHAR *name )
+{
+    UINT32 i;
+    for (i = 0; i < ARRAY_SIZE(known_headers); i++)
+        if (!wcsicmp( known_headers[i].name, name )) return &known_headers[i];
+    return NULL;
+}
+
+static const WCHAR *list_separator( const struct known_header *known )
+{
+    if (known && known->type == TYPE_LIST && known->kind == LIST_COOKIE_PAIR) return L"; ";
+    if (known && known->type == TYPE_LIST && known->kind == LIST_PRODUCT_INFO) return L" ";
+    return L", ";
+}
+
+struct header_entry
+{
+    struct list entry;              /* every header the collection holds */
+    struct header_entry *next;      /* the next in its bin, when it has a value */
+    BOOL linked;
+    UINT32 hash;
+    LONG changed;                   /* when a typed collection last changed */
+    WCHAR *name;
+    const struct known_header *known;
+    WCHAR *raw;
+    IInspectable *object;
+};
+
+struct headers
+{
+    IMap_HSTRING_HSTRING IMap_HSTRING_HSTRING_iface;
+    IIterable_IKeyValuePair_HSTRING_HSTRING IIterable_IKeyValuePair_HSTRING_HSTRING_iface;
+    IStringable IStringable_iface;
+    IHttpRequestHeaderCollection IHttpRequestHeaderCollection_iface;
+    IHttpResponseHeaderCollection IHttpResponseHeaderCollection_iface;
+    IHttpContentHeaderCollection IHttpContentHeaderCollection_iface;
+    LONG ref;
+    enum headers_kind kind;
+    CRITICAL_SECTION cs;
+    struct list entries;
+    struct header_entry **bins;
+    UINT32 bin_count;
+    UINT32 count;
+    UINT32 hi_threshold;
+    UINT32 lo_threshold;
+    IUriRuntimeClass *base_uri;
+};
+
+/*** the order Windows keeps headers in ***/
+
+static UINT32 hash_name( const WCHAR *name )
+{
+    UINT32 hash = 2166136261u;
+    WCHAR c;
+
+    for (; *name; name++)
+    {
+        c = towupper( *name );
+        hash = (hash ^ (c & 0xff)) * 16777619u;
+        hash = (hash ^ (c >> 8)) * 16777619u;
+    }
+    return hash;
+}
+
+static UINT32 pick_bin_count( UINT32 count )
+{
+    static const UINT32 primes[] =
+    {
+        17, 23, 29, 37, 41, 53, 67, 83, 103, 131, 163, 211, 257, 331, 409, 521, 647, 821, 1031, 1291, 1627, 2053,
+        2591, 3251, 4099, 5167, 6521, 8209, 10331, 13007, 16411, 20663, 26017, 32771, 41299, 52021, 65537,
+    };
+    UINT32 estimate = (UINT32)(count / 0.75f), i;
+
+    for (i = 0; i < ARRAY_SIZE(primes); i++) if (estimate <= primes[i]) return primes[i];
+    return estimate;
+}
+
+static void update_thresholds( struct headers *impl )
+{
+    impl->hi_threshold = (UINT32)(2.25f * impl->bin_count);
+    impl->lo_threshold = (UINT32)(0.25f * impl->bin_count);
+    if (impl->lo_threshold < 17) impl->lo_threshold = 0;
+}
+
+static void rehash( struct headers *impl, UINT32 bin_count )
+{
+    struct header_entry **bins, *entry, *next;
+    UINT32 i, bin;
+
+    if (bin_count == impl->bin_count || !(bins = calloc( bin_count, sizeof(*bins) ))) return;
+    for (i = 0; i < impl->bin_count; i++)
+    {
+        for (entry = impl->bins[i]; entry; entry = next)
+        {
+            next = entry->next;
+            bin = entry->hash % bin_count;
+            entry->next = bins[bin];
+            bins[bin] = entry;
+        }
+    }
+    free( impl->bins );
+    impl->bins = bins;
+    impl->bin_count = bin_count;
+    update_thresholds( impl );
+}
+
+static void link_entry( struct headers *impl, struct header_entry *entry )
+{
+    UINT32 bin;
+
+    if (entry->linked) return;
+    if (!impl->bins && !(impl->bins = calloc( impl->bin_count, sizeof(*impl->bins) ))) return;
+    bin = entry->hash % impl->bin_count;
+    entry->next = impl->bins[bin];
+    impl->bins[bin] = entry;
+    entry->linked = TRUE;
+    if (++impl->count > impl->hi_threshold) rehash( impl, pick_bin_count( impl->count ) );
+}
+
+static void unlink_entry( struct headers *impl, struct header_entry *entry )
+{
+    struct header_entry **ptr;
+
+    if (!entry->linked) return;
+    for (ptr = &impl->bins[entry->hash % impl->bin_count]; *ptr; ptr = &(*ptr)->next)
+    {
+        if (*ptr != entry) continue;
+        *ptr = entry->next;
+        break;
+    }
+    entry->next = NULL;
+    entry->linked = FALSE;
+    if (--impl->count < impl->lo_threshold) rehash( impl, pick_bin_count( impl->count ) );
+}
+
+/* the headers with values, in their order; ~0u when out of memory */
+static UINT32 ordered_entries( struct headers *impl, struct header_entry ***out )
+{
+    struct header_entry *entry;
+    UINT32 i, count = 0;
+
+    if (!(*out = malloc( max( impl->count, 1 ) * sizeof(**out) ))) return ~0u;
+    for (i = 0; impl->bins && i < impl->bin_count; i++)
+        for (entry = impl->bins[i]; entry; entry = entry->next) (*out)[count++] = entry;
+    return count;
+}
+
+static void free_entry( struct headers *impl, struct header_entry *entry )
+{
+    unlink_entry( impl, entry );
+    list_remove( &entry->entry );
+    free( entry->name );
+    free( entry->raw );
+    if (entry->object) IInspectable_Release( entry->object );
+    free( entry );
+}
+
+static struct header_entry *find_entry( struct headers *impl, const WCHAR *name )
+{
+    struct header_entry *entry;
+    LIST_FOR_EACH_ENTRY( entry, &impl->entries, struct header_entry, entry )
+        if (!wcsicmp( entry->name, name )) return entry;
+    return NULL;
+}
+
+static BOOL is_list( const struct header_entry *entry )
+{
+    return entry->known && entry->known->type == TYPE_LIST;
+}
+
+/* A Uri reads as its AbsoluteCanonicalUri, a host name as its canonical
+ * name, an IPv6 address in brackets. */
+static void format_object( const struct header_entry *entry, struct strbuf *buf )
+{
+    IUriRuntimeClassWithAbsoluteCanonicalUri *canonical;
+    HostNameType type;
+    HSTRING str = NULL;
+
+    switch (entry->known->type)
+    {
+    case TYPE_URI:
+        if (SUCCEEDED(IInspectable_QueryInterface( entry->object, &IID_IUriRuntimeClassWithAbsoluteCanonicalUri,
+                                                   (void **)&canonical )))
+        {
+            IUriRuntimeClassWithAbsoluteCanonicalUri_get_AbsoluteCanonicalUri( canonical, &str );
+            IUriRuntimeClassWithAbsoluteCanonicalUri_Release( canonical );
+        }
+        strbuf_appendw( buf, WindowsGetStringRawBuffer( str, NULL ) );
+        break;
+    case TYPE_HOST:
+        IHostName_get_CanonicalName( (IHostName *)entry->object, &str );
+        if (SUCCEEDED(IHostName_get_Type( (IHostName *)entry->object, &type )) && type == HostNameType_Ipv6)
+        {
+            strbuf_appendc( buf, '[' );
+            strbuf_appendw( buf, WindowsGetStringRawBuffer( str, NULL ) );
+            strbuf_appendc( buf, ']' );
+        }
+        else strbuf_appendw( buf, WindowsGetStringRawBuffer( str, NULL ) );
+        break;
+    default:
+        header_value_format( entry->object, buf );
+        break;
+    }
+    WindowsDeleteString( str );
+}
+
+/* The value of a header as it reads: NULL when it is not there. */
+static WCHAR *entry_text( struct header_entry *entry )
+{
+    struct strbuf buf;
+
+    if (entry->raw) return wcsdup( entry->raw );
+    if (!entry->object) return NULL;
+    strbuf_init( &buf );
+    if (is_list( entry ))
+    {
+        if (!header_list_format( entry->object, &buf ))
+        {
+            strbuf_free( &buf );
+            return NULL;
+        }
+    }
+    else format_object( entry, &buf );
+    if (!buf.data) return wcsdup( L"" );
+    return buf.data;
+}
+
+/* whether the header has a value, which a typed collection has only when
+ * it is not empty */
+static BOOL entry_has_value( struct header_entry *entry )
+{
+    if (entry->raw) return TRUE;
+    if (!entry->object) return FALSE;
+    if (!is_list( entry )) return TRUE;
+    return header_list_state( entry->object, NULL, NULL );
+}
+
+/* after a header changed in place: it takes a place if it has a value now,
+ * and gives it up if it has none */
+static void place_entry( struct headers *impl, struct header_entry *entry )
+{
+    if (entry_has_value( entry )) link_entry( impl, entry );
+    else unlink_entry( impl, entry );
+}
+
+static int __cdecl compare_changed( const void *a, const void *b )
+{
+    const struct header_entry *first = *(struct header_entry **)a, *second = *(struct header_entry **)b;
+    return first->changed < second->changed ? -1 : first->changed > second->changed ? 1 : 0;
+}
+
+/* The typed collections changed since last time take or give up their
+ * places now, in the order they changed in: a collection that lost its
+ * last value gives up its place, and one that gained its first takes one
+ * at the head of its bin, as it would have had it been told at once. */
+static void sync_lists( struct headers *impl )
+{
+    struct header_entry *entry, **gained = NULL;
+    UINT32 count = 0, size = 0, i;
+    BOOL has_value, emptied;
+
+    LIST_FOR_EACH_ENTRY( entry, &impl->entries, struct header_entry, entry )
+    {
+        if (!is_list( entry ) || !entry->object || entry->raw) continue;
+        has_value = header_list_state( entry->object, &entry->changed, &emptied );
+        if (!has_value || emptied) unlink_entry( impl, entry );
+        if (!has_value || entry->linked) continue;
+        if (count == size)
+        {
+            struct header_entry **tmp = realloc( gained, max( 4, size * 2 ) * sizeof(*gained) );
+            if (!tmp) break;
+            gained = tmp;
+            size = max( 4, size * 2 );
+        }
+        gained[count++] = entry;
+    }
+    if (count > 1) qsort( gained, count, sizeof(*gained), compare_changed );
+    for (i = 0; i < count; i++) link_entry( impl, gained[i] );
+    free( gained );
+}
+
+/*** values of the kinds a header can be kept as ***/
+
+/* A Windows.Networking.HostName, which is what a Host header is kept as. */
+static HRESULT hostname_create( const WCHAR *str, size_t len, IHostName **out )
+{
+    static IHostNameFactory *factory;
+    HSTRING name;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!factory)
+    {
+        IHostNameFactory *tmp;
+        if (FAILED(hr = class_name_create( L"Windows.Networking.HostName", &name ))) return hr;
+        hr = RoGetActivationFactory( name, &IID_IHostNameFactory, (void **)&tmp );
+        WindowsDeleteString( name );
+        if (FAILED(hr)) return hr;
+        if (InterlockedCompareExchangePointer( (void **)&factory, tmp, NULL )) IHostNameFactory_Release( tmp );
+    }
+    if (FAILED(hr = hstring_create_len( str, len, &name ))) return hr;
+    hr = IHostNameFactory_CreateHostName( factory, name, out );
+    WindowsDeleteString( name );
+    return FAILED(hr) ? E_INVALIDARG : S_OK;
+}
+
+/* the object a Uri or Host header is kept as, from its text */
+static HRESULT parse_object( struct headers *impl, const struct known_header *known, const WCHAR *str,
+                             IInspectable **object )
+{
+    size_t len;
+    WCHAR *copy;
+    HRESULT hr;
+
+    while (is_ws( *str )) str++;
+    len = wcslen( str );
+    while (len && is_ws( str[len - 1] )) len--;
+    if (known->type == TYPE_HOST) return hostname_create( str, len, (IHostName **)object );
+
+    if (!(copy = malloc( (len + 1) * sizeof(WCHAR) ))) return E_OUTOFMEMORY;
+    memcpy( copy, str, len * sizeof(WCHAR) );
+    copy[len] = 0;
+    hr = uri_create_relative( impl->base_uri, copy, (IUriRuntimeClass **)object );
+    free( copy );
+    return FAILED(hr) ? E_INVALIDARG : S_OK;
+}
+
+/* Parses the text of a header it knows into what it is kept as: an object,
+ * or text written the way Windows writes that kind of value. */
+static HRESULT parse_known( struct headers *impl, const struct known_header *known, const WCHAR *str,
+                            WCHAR **raw, IInspectable **object )
+{
+    struct strbuf buf;
+    const WCHAR *p;
+    DateTime date;
+    UINT64 number;
+    HRESULT hr;
+
+    *raw = NULL;
+    *object = NULL;
+    switch (known->type)
+    {
+    case TYPE_LIST:
+        return header_list_parse_new( known->kind, str, object );
+    case TYPE_SINGLE:
+        return header_value_parse_all( known->kind, str, object );
+    case TYPE_STRING:
+        return (*raw = wcsdup( str )) ? S_OK : E_OUTOFMEMORY;
+    case TYPE_URI:
+    case TYPE_HOST:
+        return parse_object( impl, known, str, object );
+    default:
+        break;
+    }
+
+    strbuf_init( &buf );
+    for (p = str; is_ws( *p ); p++) ;
+    switch (known->type)
+    {
+    case TYPE_DATE:
+        if (!parse_http_date( p, &date )) return E_INVALIDARG;
+        format_http_date( &buf, date );
+        break;
+    case TYPE_SECONDS:
+    case TYPE_UINT64:
+    case TYPE_UINT32:
+    {
+        size_t len = wcslen( p );
+        while (len && is_ws( p[len - 1] )) len--;
+        if (!parse_uint64( p, len, &number )) return E_INVALIDARG;
+        if (known->type == TYPE_UINT32 && number > 0xffffffff) return E_INVALIDARG;
+        strbuf_appendf( &buf, L"%I64u", number );
+        break;
+    }
+    case TYPE_BASE64:
+    {
+        BYTE *data;
+        UINT32 len;
+        if (!base64_decode_lenient( p, &data, &len )) return E_INVALIDARG;
+        hr = base64_encode( data, len, raw );
+        free( data );
+        return hr;
+    }
+    default:
+        break;
+    }
+    if (buf.failed || !buf.data)
+    {
+        strbuf_free( &buf );
+        return E_OUTOFMEMORY;
+    }
+    *raw = buf.data;
+    return S_OK;
+}
+
+static BOOL is_single_valued( const struct known_header *known )
+{
+    return known && known->type != TYPE_LIST;
+}
+
+static HRESULT check_name( struct headers *impl, const WCHAR *name, const struct known_header **known )
+{
+    if (!name || !is_token( name, wcslen( name ) )) return E_INVALIDARG;
+    *known = find_known( name );
+    if (impl->kind == HEADERS_CONTENT) return (*known && (*known)->content) ? S_OK : E_ILLEGAL_METHOD_CALL;
+    return (*known && (*known)->content) ? E_ILLEGAL_METHOD_CALL : S_OK;
+}
+
+static BOOL check_value( const WCHAR *value )
+{
+    return !value || (!wcschr( value, '\r' ) && !wcschr( value, '\n' ));
+}
+
+/* A new header, which takes its place at the head of its bin if it has a value. */
+static HRESULT add_entry( struct headers *impl, const WCHAR *name, const struct known_header *known,
+                          WCHAR *raw, IInspectable *object )
+{
+    struct header_entry *entry;
+
+    if (!(entry = calloc( 1, sizeof(*entry) )) || !(entry->name = wcsdup( name )))
+    {
+        free( entry );
+        free( raw );
+        if (object) IInspectable_Release( object );
+        return E_OUTOFMEMORY;
+    }
+    entry->known = known;
+    entry->raw = raw;
+    entry->object = object;
+    entry->hash = hash_name( name );
+    list_add_tail( &impl->entries, &entry->entry );
+    place_entry( impl, entry );
+    return S_OK;
+}
+
+/* the header's value replaced in place */
+static void set_entry( struct headers *impl, struct header_entry *entry, WCHAR *raw, IInspectable *object )
+{
+    free( entry->raw );
+    if (entry->object) IInspectable_Release( entry->object );
+    entry->raw = raw;
+    entry->object = object;
+    place_entry( impl, entry );
+}
+
+static HRESULT headers_insert( struct headers *impl, const WCHAR *name, const WCHAR *value, boolean *replaced )
+{
+    const struct known_header *known;
+    struct header_entry *entry;
+    IInspectable *object = NULL;
+    WCHAR *raw = NULL;
+    HRESULT hr;
+
+    if (replaced) *replaced = FALSE;
+    if (FAILED(hr = check_name( impl, name, &known ))) return hr;
+    if (!check_value( value )) return E_INVALIDARG;
+
+    EnterCriticalSection( &impl->cs );
+    sync_lists( impl );
+    if ((entry = find_entry( impl, name )))
+    {
+        if (replaced) *replaced = entry_has_value( entry );
+        free_entry( impl, entry );
+    }
+    if (known) hr = parse_known( impl, known, value ? value : L"", &raw, &object );
+    else if (!(raw = wcsdup( value ? value : L"" ))) hr = E_OUTOFMEMORY;
+    if (SUCCEEDED(hr)) hr = add_entry( impl, name, known, raw, object );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT headers_append( struct headers *impl, const WCHAR *name, const WCHAR *value )
+{
+    const struct known_header *known;
+    struct header_entry *entry;
+    IInspectable *object = NULL;
+    WCHAR *raw = NULL, *old;
+    struct strbuf buf;
+    HRESULT hr;
+
+    if (FAILED(hr = check_name( impl, name, &known ))) return hr;
+    if (!check_value( value )) return E_INVALIDARG;
+    if (!value) value = L"";
+
+    EnterCriticalSection( &impl->cs );
+    sync_lists( impl );
+    entry = find_entry( impl, name );
+    old = entry ? entry_text( entry ) : NULL;
+    if (old && is_single_valued( known ))
+    {
+        LeaveCriticalSection( &impl->cs );
+        free( old );
+        return E_ILLEGAL_METHOD_CALL;
+    }
+
+    strbuf_init( &buf );
+    if (old)
+    {
+        strbuf_appendw( &buf, old );
+        strbuf_appendw( &buf, list_separator( known ) );
+    }
+    strbuf_appendw( &buf, value );
+    free( old );
+    if (buf.failed) hr = E_OUTOFMEMORY;
+    else if (known) hr = parse_known( impl, known, buf.data ? buf.data : L"", &raw, &object );
+    else if (!(raw = wcsdup( buf.data ? buf.data : L"" ))) hr = E_OUTOFMEMORY;
+    strbuf_free( &buf );
+
+    if (SUCCEEDED(hr))
+    {
+        if (entry) set_entry( impl, entry, raw, object );
+        else hr = add_entry( impl, name, known, raw, object );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+/* joins the text to whatever the header has, as the text it is */
+static HRESULT headers_append_raw( struct headers *impl, const WCHAR *name, const WCHAR *value )
+{
+    const struct known_header *known = find_known( name );
+    struct header_entry *entry;
+    struct strbuf buf;
+    WCHAR *old, *copy;
+    HRESULT hr = S_OK;
+
+    EnterCriticalSection( &impl->cs );
+    sync_lists( impl );
+    if ((entry = find_entry( impl, name )) && (old = entry_text( entry )))
+    {
+        strbuf_init( &buf );
+        strbuf_appendw( &buf, old );
+        strbuf_appendw( &buf, L", " );
+        strbuf_appendw( &buf, value );
+        free( old );
+        if (buf.failed) hr = E_OUTOFMEMORY;
+        else
+        {
+            set_entry( impl, entry, buf.data, NULL );
+            buf.data = NULL;
+        }
+        strbuf_free( &buf );
+    }
+    else if (!(copy = wcsdup( value ))) hr = E_OUTOFMEMORY;
+    else if (entry) set_entry( impl, entry, copy, NULL );
+    else hr = add_entry( impl, name, known, copy, NULL );
+    LeaveCriticalSection( &impl->cs );
+    return hr;
+}
+
+static HRESULT headers_try_append( struct headers *impl, const WCHAR *name, const WCHAR *value, boolean *result )
+{
+    const struct known_header *known;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    *result = FALSE;
+    if (FAILED(check_name( impl, name, &known ))) return S_OK;
+    if (FAILED(hr = headers_append_raw( impl, name, value ? value : L"" ))) return hr;
+    *result = TRUE;
+    return S_OK;
+}
