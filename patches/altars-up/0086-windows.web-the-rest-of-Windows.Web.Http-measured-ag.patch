+      &IID_IHttpLanguageRangeWithQualityHeaderValueCollection, &IID_IVector_HttpLanguageRangeWithQualityHeaderValue,
+      &IID_IVectorView_HttpLanguageRangeWithQualityHeaderValue, &IID_IIterable_HttpLanguageRangeWithQualityHeaderValue,
+      &IID_IIterator_HttpLanguageRangeWithQualityHeaderValue, VALUE_LANGUAGE_RANGE_QUALITY, L", " },
