+/*** sending ***/
+
+struct send_state
+{
+    struct filter *filter;
+    IHttpRequestMessage *request;
+    struct async_op *op;
+    UINT64 to_send;
+    UINT64 sent;
+    BOOL secure;
+    HttpProgressStage stage;
+};
+
+static void send_report( struct send_state *state, HttpProgressStage stage )
+{
+    state->stage = stage;
+    report_progress( state->op, stage, state->sent, state->to_send, 0, FALSE, 0 );
+}
+
+static void CALLBACK status_callback( HINTERNET handle, DWORD_PTR context, DWORD status, void *info, DWORD len )
+{
+    struct send_state *state = (struct send_state *)context;
+
+    switch (status)
+    {
+    case INTERNET_STATUS_RESOLVING_NAME:
+        send_report( state, HttpProgressStage_ResolvingName );
+        break;
+    case INTERNET_STATUS_CONNECTING_TO_SERVER:
+        send_report( state, HttpProgressStage_ConnectingToServer );
+        break;
+    case INTERNET_STATUS_CONNECTED_TO_SERVER:
+        if (state->secure) send_report( state, HttpProgressStage_NegotiatingSsl );
+        break;
+    case INTERNET_STATUS_SENDING_REQUEST:
+        send_report( state, HttpProgressStage_SendingHeaders );
+        break;
+    case INTERNET_STATUS_REQUEST_SENT:
+        if (state->to_send)
+        {
+            state->sent = state->to_send;
+            send_report( state, HttpProgressStage_SendingContent );
+        }
+        send_report( state, HttpProgressStage_WaitingForResponse );
+        break;
+    default:
+        break;
+    }
+}
+
+static BOOL is_content_header( const WCHAR *name )
+{
+    static const WCHAR *names[] = { L"Content-Disposition", L"Content-Encoding", L"Content-Language", L"Content-Length",
+                                    L"Content-Location", L"Content-MD5", L"Content-Range", L"Content-Type",
+                                    L"Expires", L"Last-Modified" };
+    UINT32 i;
+    for (i = 0; i < ARRAY_SIZE(names); i++) if (!wcsicmp( names[i], name )) return TRUE;
+    return FALSE;
+}
+
+/* The headers go to WinINet in their order, a content's Content-Length among
+ * them as Windows sends it -- unless it is not the length of what is sent,
+ * which WinINet then says itself. */
+static void append_headers( struct strbuf *buf, struct headers *headers, const UINT64 *length )
+{
+    WCHAR **names, **values;
+    UINT32 count, i;
+    UINT64 value;
+
+    if (!headers || (count = headers_snapshot( headers, &names, &values )) == ~0u) return;
+    for (i = 0; i < count; i++)
+    {
+        if (length && !wcsicmp( names[i], L"Content-Length" ) &&
+            (!parse_uint64( values[i], wcslen( values[i] ), &value ) || value != *length))
+            continue;
+        strbuf_appendw( buf, names[i] );
+        strbuf_appendw( buf, L": " );
+        strbuf_appendw( buf, values[i] );
+        strbuf_appendw( buf, L"\r\n" );
+    }
+    headers_free_snapshot( names, values, count );
+}
+
+static WCHAR *query_string( HINTERNET request, DWORD level )
+{
+    DWORD size = 0;
+    WCHAR *ret;
+
+    HttpQueryInfoW( request, level, NULL, &size, NULL );
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || !(ret = malloc( size + sizeof(WCHAR) ))) return NULL;
+    if (!HttpQueryInfoW( request, level, ret, &size, NULL ))
+    {
+        free( ret );
+        return NULL;
+    }
+    return ret;
+}
+
+/* the headers of a response as it came, each where it belongs */
+static HRESULT add_response_headers( HINTERNET request, struct headers *response_headers, struct headers *content_headers )
+{
+    WCHAR *raw, *line, *next, *colon, *value, *end;
+    HRESULT hr = S_OK;
+
+    if (!(raw = query_string( request, HTTP_QUERY_RAW_HEADERS_CRLF ))) return S_OK;
+    /* the status line first */
+    if (!(line = wcsstr( raw, L"\r\n" )))
+    {
+        free( raw );
+        return S_OK;
+    }
+    for (line += 2; *line && SUCCEEDED(hr); line = next)
+    {
+        if (!(next = wcsstr( line, L"\r\n" ))) next = line + wcslen( line );
+        else *next++ = 0, next++;
+        if (!*line) break;
+        if (!(colon = wcschr( line, ':' ))) continue;
+        for (end = colon; end > line && is_ws( end[-1] ); end--) ;
+        *end = 0;
+        if (!is_token( line, wcslen( line ) ))
+        {
+            WARN( "invalid header name %s.\n", debugstr_w( line ) );
+            hr = HRESULT_FROM_WIN32( ERROR_HTTP_INVALID_HEADER );
+            break;
+        }
+        for (value = colon + 1; is_ws( *value ); value++) ;
+        for (end = value + wcslen( value ); end > value && is_ws( end[-1] ); end--) ;
+        *end = 0;
+        hr = headers_add_raw( is_content_header( line ) ? content_headers : response_headers, line, value );
+    }
+    free( raw );
+    return hr;
+}
