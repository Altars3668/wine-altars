+static HRESULT get_string( struct header_value *impl, WCHAR *const *field, HSTRING *value )
+{
+    HRESULT hr;
+
+    if (!value) return E_POINTER;
+    AcquireSRWLockShared( &impl->lock );
+    hr = hstring_create( *field, value );
+    ReleaseSRWLockShared( &impl->lock );
+    return hr;
+}
+
+static HRESULT set_string( struct header_value *impl, WCHAR **field, const WCHAR *str )
+{
+    WCHAR *copy = NULL;
+
+    if (str && !(copy = wcsdup( str ))) return E_OUTOFMEMORY;
+    AcquireSRWLockExclusive( &impl->lock );
+    free( *field );
+    *field = copy;
+    ReleaseSRWLockExclusive( &impl->lock );
+    return S_OK;
+}
+
+static HRESULT set_hstring( struct header_value *impl, WCHAR **field, HSTRING str )
+{
+    WCHAR *copy;
+    HRESULT hr;
+
+    if (hstring_is_empty( str )) return set_string( impl, field, NULL );
+    if (!(copy = hstring_dup( str ))) return E_OUTOFMEMORY;
+    hr = set_string( impl, field, copy );
+    free( copy );
+    return hr;
+}
