+    xml = malloc(20000);
+    strcpy(xml, "<?xml version=\"1.0\" encoding=\"GB2312\"?><a>");
+    for (i = start = strlen(xml); i < 16000; i += 2)
+    {
+        xml[i] = '\xd6';
+        xml[i + 1] = '\xd0';
+    }
+    strcpy(xml + i, "</a>");
+    stream = create_stream_on_data(xml, strlen(xml));
