+static HRESULT read_declared_text(const char *encoding, const char *text, IUnknown *mlang, WCHAR *value, UINT size)
+{
+    IXmlReader *reader;
+    const WCHAR *str;
+    XmlNodeType type;
+    IStream *stream;
+    char xml[256];
+    HRESULT hr;
+    UINT len;
+
+    sprintf(xml, "<?xml version=\"1.0\" encoding=\"%s\"?><a>%s</a>", encoding, text);
+    stream = create_stream_on_data(xml, strlen(xml));
+    hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (mlang)
+    {
+        hr = IXmlReader_SetProperty(reader, XmlReaderProperty_MultiLanguage, (LONG_PTR)mlang);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    }
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    *value = 0;
+    while ((hr = IXmlReader_Read(reader, &type)) == S_OK)
+    {
+        if (type != XmlNodeType_Text) continue;
+        IXmlReader_GetValue(reader, &str, &len);
+        lstrcpynW(value, str, min(len + 1, size));
+    }
+    IXmlReader_Release(reader);
+    IStream_Release(stream);
+    return hr;
+}
