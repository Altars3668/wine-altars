+    ok(len == (i - start) / 2, "Got %u characters.\n", len);
+    IStream_Release(stream);
+    free(xml);
+
+    IXmlReader_Release(reader);
+    IMultiLanguage2_Release(mlang);
+    CoUninitialize();
+}
