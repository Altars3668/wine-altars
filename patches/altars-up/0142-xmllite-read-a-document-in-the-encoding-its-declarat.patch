+    /* convert all of it if so, and stop before that character if not */
     return len - 1 + need <= buffer->written ? buffer->written : len - 1;
 }
 
 /* Returns byte length of complete char sequence for buffer code page,
    it's relative to current buffer position which is currently used for BOM handling
    only. */
+/* the same for a code page of one or two bytes a character, or of EUC's three */
+static int readerinput_get_mbcs_convlen(xmlreaderinput *readerinput)
+{
+    encoded_buffer *buffer = &readerinput->buffer->encoded;
+    UINT cp = readerinput->buffer->code_page;
+    unsigned char *data = (unsigned char *)buffer->data;
+    unsigned int pos = buffer->cur, size;
+    BOOL euc = cp == 20932 || cp == 51932;
+    CPINFO info;
+
+    if (!euc && (!GetCPInfo(cp, &info) || info.MaxCharSize == 1)) return buffer->written;
+
+    while (pos < buffer->written)
+    {
+        if (euc) size = data[pos] == 0x8f ? 3 : data[pos] >= 0x80 ? 2 : 1;
+        else size = IsDBCSLeadByteEx(cp, data[pos]) ? 2 : 1;
+        if (pos + size > buffer->written) break;
+        pos += size;
+    }
+    return pos;
+}
