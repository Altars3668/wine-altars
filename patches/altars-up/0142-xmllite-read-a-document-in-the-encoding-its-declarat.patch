 static int readerinput_get_convlen(xmlreaderinput *readerinput)
 {
     encoded_buffer *buffer = &readerinput->buffer->encoded;
@@ -964,6 +995,8 @@ static int readerinput_get_convlen(xmlreaderinput *readerinput)
 
     if (readerinput->buffer->code_page == CP_UTF8)
         len = readerinput_get_utf8_convlen(readerinput);
+    else if (readerinput->buffer->code_page != 1200)
+        len = readerinput_get_mbcs_convlen(readerinput);
     else
         len = buffer->written;
 
@@ -982,9 +1015,8 @@ static void readerinput_shrinkraw(xmlreaderinput *readerinput, int len)
         len = readerinput_get_convlen(readerinput);
 
     assert(len >= 0);
-    /* len 是已经转换掉的字节数，要留下的是它后面那段还不成整字符的尾巴：
-       起点 cur + len，长度 written - cur - len。原先按"末尾 len 字节"搬运，
-       当多字节字符恰好跨在读取块边界上时留错字节，解析随后报 NC_E_QNAMECHARACTER。 */
+    /* len bytes from cur were converted; what stays is the incomplete character after them,
+       written - cur - len bytes from cur + len */
     memmove(buffer->data, buffer->data + buffer->cur + len, buffer->written - buffer->cur - len);
     /* everything below cur is lost too */
     buffer->written -= len + buffer->cur;
@@ -1021,6 +1053,69 @@ static void fixup_buffer_cr(encoded_buffer *buffer, int off)
     *dest = 0;
 }
 
+/* UTF-8 with each byte that is not part of a character made U+FFFF, which is not an XML
+ * character either, so that the reader fails there */
+static int utf8_to_wide(const unsigned char *src, int len, WCHAR *dest)
+{
+    unsigned int ch, i, size, ret = 0;
+    const unsigned char *end = src + len;
+
+    while (src < end)
+    {
+        if (*src < 0x80) { ch = *src; size = 1; }
+        else if ((*src & 0xe0) == 0xc0) { ch = *src & 0x1f; size = 2; }
+        else if ((*src & 0xf0) == 0xe0) { ch = *src & 0x0f; size = 3; }
+        else if ((*src & 0xf8) == 0xf0) { ch = *src & 0x07; size = 4; }
+        else { ch = 0xffff; size = 0; }
+
+        for (i = 1; i < size; i++)
+        {
+            if (src + i >= end || (src[i] & 0xc0) != 0x80) break;
+            ch = (ch << 6) | (src[i] & 0x3f);
+        }
+        if (!size || i < size || (size == 2 && ch < 0x80) || (size == 3 && ch < 0x800) ||
+            (size == 4 && (ch < 0x10000 || ch > 0x10ffff)) || (ch >= 0xd800 && ch <= 0xdfff))
+        {
+            ch = 0xffff;
+            size = 1;
+        }
+        src += size;
+
+        if (ch >= 0x10000)
+        {
+            if (dest)
+            {
+                dest[ret] = 0xd800 | ((ch - 0x10000) >> 10);
+                dest[ret + 1] = 0xdc00 | (ch & 0x3ff);
+            }
+            ret += 2;
+        }
+        else
+        {
+            if (dest) dest[ret] = ch;
+            ret++;
+        }
+    }
+    return ret;
+}
+
+/* converts len bytes of the input's code page, or asks for the size with no dest */
+static int readerinput_convert(xmlreaderinput *readerinput, const char *src, int len, WCHAR *dest, int dest_len)
+{
+    input_buffer *buffer = readerinput->buffer;
+    INT src_len = len, ret = dest ? dest_len : 0;
+    DWORD mode = buffer->mlang_mode;
+
+    if (buffer->code_page == CP_UTF8) return utf8_to_wide((const unsigned char *)src, len, dest);
+    if (!buffer->mlang) return MultiByteToWideChar(buffer->code_page, 0, src, len, dest, dest_len);
+
+    if (FAILED(IMultiLanguage2_ConvertStringToUnicode(buffer->mlang, &mode, buffer->code_page,
+                                                      (CHAR *)src, (UINT *)&src_len, dest, (UINT *)&ret)))
+        return 0;
+    if (dest) buffer->mlang_mode = mode;
+    return ret;
+}
