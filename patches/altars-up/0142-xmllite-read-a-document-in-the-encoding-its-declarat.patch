+    IStream_Release(stream);
+
+    stream = create_stream_on_data(crlf_1252, sizeof(crlf_1252) - 1);
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    while ((hr = IXmlReader_Read(reader, &type)) == S_OK && type != XmlNodeType_Text);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IXmlReader_GetValue(reader, &str, &len);
+    ok(len == 1 && str[0] == 0xe9, "Unexpected value %s.\n", debugstr_wn(str, len));
+    IStream_Release(stream);
+
+    stream = create_stream_on_data(wide_1252, sizeof(wide_1252) - sizeof(WCHAR));
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlReader_Read(reader, &type);
+    ok(hr == MX_E_ENCODINGSWITCH, "Unexpected hr %#lx.\n", hr);
+    IStream_Release(stream);
+
+    stream = create_stream_on_data(wide_utf8, sizeof(wide_utf8) - sizeof(WCHAR));
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlReader_Read(reader, &type);
+    ok(hr == MX_E_ENCODINGSWITCH, "Unexpected hr %#lx.\n", hr);
+    IStream_Release(stream);
+
+    /* a byte that is not UTF-8 is not a character */
+    stream = create_stream_on_data(bad_utf8, sizeof(bad_utf8) - 1);
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    while ((hr = IXmlReader_Read(reader, &type)) == S_OK);
+    ok(hr == WC_E_XMLCHARACTER, "Unexpected hr %#lx.\n", hr);
+    IStream_Release(stream);
+
+    stream = create_stream_on_data(space, sizeof(space) - 1);
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXmlReader_Read(reader, &type);
+    ok(hr == WC_E_ENCNAME, "Unexpected hr %#lx.\n", hr);
+    IStream_Release(stream);
