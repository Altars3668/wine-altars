+/* 8-bit encodings a reader knows by itself, sorted as wcsicmp() sorts them */
+static const struct
+{
+    const WCHAR *name;
+    UINT cp;
+}
+reader_encodings[] =
+{
+    { L"ISO-8859-1", 28591 }, { L"ISO-8859-2", 28592 }, { L"ISO-8859-3", 28593 },
+    { L"ISO-8859-4", 28594 }, { L"ISO-8859-5", 28595 }, { L"ISO-8859-6", 28596 },
+    { L"ISO-8859-7", 28597 }, { L"ISO-8859-8", 28598 }, { L"ISO-8859-9", 28599 },
+    { L"US-ASCII",   20127 }, { L"UTF-8", CP_UTF8 },
+    { L"windows-1250", 1250 }, { L"windows-1251", 1251 }, { L"windows-1252", 1252 },
+    { L"windows-1253", 1253 }, { L"windows-1254", 1254 }, { L"windows-1255", 1255 },
+    { L"windows-1256", 1256 }, { L"windows-1257", 1257 }, { L"windows-1258", 1258 },
+};
+
+/* and those of wider characters, which a document of bytes cannot switch to */
+static const WCHAR *wide_encodings[] =
+{
+    L"UCS-2", L"UCS-4", L"UTF-16", L"UTF-16BE", L"UTF-16LE", L"UTF-32", L"unicode",
+};
+
+/* the code page of a declared encoding: 1200 for those of wide characters, the reader's own
+ * 8-bit ones, and whatever the MultiLanguage object knows */
+static HRESULT reader_get_encoding_code_page(xmlreader *reader, const WCHAR *name, UINT *cp,
+                                             IMultiLanguage2 **mlang)
+{
+    IMultiLanguage2 *ml;
+    MIMECSETINFO info;
+    unsigned int i;
+    HRESULT hr;
+    BSTR str;
+
+    *mlang = NULL;
+    for (i = 0; i < ARRAY_SIZE(reader_encodings); i++)
+    {
+        if (wcsicmp(reader_encodings[i].name, name)) continue;
+        *cp = reader_encodings[i].cp;
+        return S_OK;
+    }
+    for (i = 0; i < ARRAY_SIZE(wide_encodings); i++)
+    {
+        if (wcsicmp(wide_encodings[i], name)) continue;
+        *cp = 1200;
+        return S_OK;
+    }
+
+    if (!reader->mlang) return MX_E_ENCODINGSIGNATURE;
+    if (FAILED(IUnknown_QueryInterface(reader->mlang, &IID_IMultiLanguage2, (void **)&ml)))
+        return MX_E_ENCODING;
+
+    str = SysAllocString(name);
+    hr = IMultiLanguage2_GetCharsetInfo(ml, str, &info);
+    SysFreeString(str);
+    if (FAILED(hr))
+    {
+        IMultiLanguage2_Release(ml);
+        return MX_E_ENCODING;
+    }
+
+    TRACE("%s is code page %u\n", debugstr_w(name), info.uiInternetEncoding);
+    switch ((*cp = info.uiInternetEncoding))
+    {
+    case 1200: case 1201: case 12000: case 12001:
+        *cp = 1200;
+        IMultiLanguage2_Release(ml);
+        return S_OK;
+    case CP_UTF7:
+        IMultiLanguage2_Release(ml);
+        return MX_E_ENCODINGSWITCH;
+    }
+    if (IsValidCodePage(*cp) || *cp == CP_UTF8)
+        IMultiLanguage2_Release(ml);
+    else if (IMultiLanguage2_IsConvertible(ml, *cp, 1200) == S_OK)
+        *mlang = ml;
+    else
+    {
+        IMultiLanguage2_Release(ml);
+        return MX_E_ENCODING;
+    }
+    return S_OK;
+}
+
+/* A document of bytes is read, from the end of its declaration on, in the encoding the
+ * declaration names; one of wide characters cannot name an encoding of bytes. */
+static HRESULT reader_switch_declared_encoding(xmlreader *reader)
+{
+    xmlreaderinput *input = reader->input;
+    encoded_buffer *src = &input->buffer->encoded, *dest = &input->buffer->utf16;
+    IMultiLanguage2 *mlang;
+    WCHAR name[64];
+    const char *ptr;
+    int len, dest_len;
+    HRESULT hr;
+    UINT cp;
+
+    if (!reader->encoding.len) return S_OK;
+    if (reader->encoding.len >= ARRAY_SIZE(name))
+        return reader->mlang ? MX_E_ENCODING : MX_E_ENCODINGSIGNATURE;
+    memcpy(name, (WCHAR *)dest->data + reader->encoding.start, reader->encoding.len * sizeof(WCHAR));
+    name[reader->encoding.len] = 0;
+
+    if (FAILED(hr = reader_get_encoding_code_page(reader, name, &cp, &mlang))) return hr;
+    if (cp == input->buffer->code_page) goto done;
+    if (cp == 1200 || input->buffer->code_page == 1200)
+    {
+        hr = MX_E_ENCODINGSWITCH;
+        goto done;
+    }
+
+    /* the declaration is ASCII in anything read as bytes: convert again from its end */
+    for (ptr = src->data + src->cur; ptr + 1 < src->data + src->written; ptr++)
+        if (ptr[0] == '?' && ptr[1] == '>') break;
+    if (ptr + 1 >= src->data + src->written)
+    {
+        hr = MX_E_ENCODING;
+        goto done;
+    }
+
+    TRACE("switching to code page %u\n", cp);
+    input->buffer->code_page = cp;
+    if (input->buffer->mlang) IMultiLanguage2_Release(input->buffer->mlang);
+    input->buffer->mlang = mlang;
+    input->buffer->mlang_mode = 0;
+    mlang = NULL;
+
+    dest->written = reader_get_cur(reader) * sizeof(WCHAR);
+    dest->prev_cr = FALSE;
+    src->cur = ptr + 2 - src->data;
+    len = readerinput_get_convlen(input);
+    dest_len = readerinput_convert(input, src->data + src->cur, len, NULL, 0);
+    readerinput_grow(input, dest_len);
+    readerinput_convert(input, src->data + src->cur, len, (WCHAR *)(dest->data + dest->written), dest_len);
+    ((WCHAR *)(dest->data + dest->written))[dest_len] = 0;
+    dest->written += dest_len * sizeof(WCHAR);
+    fixup_buffer_cr(dest, reader_get_cur(reader));
+
+done:
+    if (mlang) IMultiLanguage2_Release(mlang);
+    return hr;
+}
