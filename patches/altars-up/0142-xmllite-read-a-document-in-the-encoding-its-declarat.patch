+        { "ISO-8859-7", "\xe9", S_FALSE, S_FALSE, L"\x03b9", L"\x03b9" },
+        { "US-ASCII", "e", S_FALSE, S_FALSE, L"e", L"e" },
+        { "GB2312", "\xd6\xd0", MX_E_ENCODINGSIGNATURE, S_FALSE, NULL, L"\x4e2d" },
+        { "koi8-r", "\xc1", MX_E_ENCODINGSIGNATURE, S_FALSE, NULL, L"\x0430" },
+        { "Shift_JIS", "\x93\xfa", MX_E_ENCODINGSIGNATURE, S_FALSE, NULL, L"\x65e5" },
+        { "euc-jp", "\xc6\xfc", MX_E_ENCODINGSIGNATURE, S_FALSE, NULL, L"\x65e5" },
