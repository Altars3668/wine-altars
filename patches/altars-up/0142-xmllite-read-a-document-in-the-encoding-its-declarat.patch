+    UINT len;
+
+    CoInitialize(NULL);
+    hr = CoCreateInstance(&CLSID_CMultiLanguage, NULL, CLSCTX_INPROC_SERVER, &IID_IMultiLanguage2, (void **)&mlang);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        hr = read_declared_text(tests[i].encoding, tests[i].text, NULL, value, ARRAY_SIZE(value));
+        ok(hr == tests[i].hr, "%s: got hr %#lx.\n", tests[i].encoding, hr);
+        if (tests[i].value)
