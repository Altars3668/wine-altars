+        if (tests[i].value_mlang)
+            ok(!wcscmp(value, tests[i].value_mlang), "%s: got %s with MultiLanguage.\n", tests[i].encoding, debugstr_w(value));
+    }
+
+    hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* the declaration of an encoding of bytes wins over a UTF-8 BOM, and not over UTF-16 */
+    stream = create_stream_on_data(bom_1252, sizeof(bom_1252) - 1);
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    while ((hr = IXmlReader_Read(reader, &type)) == S_OK && type != XmlNodeType_Text);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IXmlReader_GetValue(reader, &str, &len);
