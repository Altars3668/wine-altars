+        { "utf", "e", MX_E_ENCODINGSIGNATURE, MX_E_ENCODING },
+        { "UTF-7", "e", MX_E_ENCODINGSIGNATURE, MX_E_ENCODINGSWITCH },
+        { "UTF-16", "e", MX_E_ENCODINGSWITCH, MX_E_ENCODINGSWITCH },
+        { "UTF-16LE", "e", MX_E_ENCODINGSWITCH, MX_E_ENCODINGSWITCH },
+        { "unicode", "e", MX_E_ENCODINGSWITCH, MX_E_ENCODINGSWITCH },
+        { "UCS-2", "e", MX_E_ENCODINGSWITCH, MX_E_ENCODINGSWITCH },
+        { "utf-32", "e", MX_E_ENCODINGSWITCH, MX_E_ENCODINGSWITCH },
+    };
+    static const char bom_1252[] = "\xef\xbb\xbf<?xml version=\"1.0\" encoding=\"windows-1252\"?><a>\xe9</a>";
+    static const char crlf_1252[] = "<?xml version=\"1.0\"\r\n encoding='windows-1252'?>\r\n<a>\xe9</a>";
+    static const WCHAR wide_1252[] = L"<?xml version=\"1.0\" encoding=\"windows-1252\"?><a/>";
+    static const WCHAR wide_utf8[] = L"<?xml version=\"1.0\" encoding=\"utf-8\"?><a/>";
+    static const char bad_utf8[] = "<a>\xe9</a>";
+    static const char space[] = "<?xml version=\"1.0\" encoding=\"iso-8859-1 \"?><a/>";
+    IMultiLanguage2 *mlang;
+    IXmlReader *reader;
