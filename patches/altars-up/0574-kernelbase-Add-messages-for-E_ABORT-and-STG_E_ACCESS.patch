From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 13:51:59 -0400
Subject: [PATCH] kernelbase: Add messages for E_ABORT and STG_E_ACCESSDENIED.

Windows has both; FormatMessage() found neither.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/kernelbase/winerror.mc b/dlls/kernelbase/winerror.mc
index 66137528784..f624f4d8f4a 100644
--- a/dlls/kernelbase/winerror.mc
+++ b/dlls/kernelbase/winerror.mc
@@ -20,6 +20,7 @@ LanguageNames=(ENU=0x409:winerr)
 SeverityNames=(CoError=0x2:STATUS_SEVERITY_COERROR)
 FacilityNames=(Trust=0xb:FACILITY_CERT
     Security=0x9:FACILITY_SECURITY
+    Storage=0x3:FACILITY_STORAGE
 )
 
 MessageId=0
@@ -3969,3 +3970,17 @@ SymbolicName=E_FAIL
 Language=ENU
 Call failed.
 .
+MessageId=0x4004
+Severity=CoError
+Facility=Null
+SymbolicName=E_ABORT
+Language=ENU
+Operation aborted
+.
+MessageId=0x5
+Severity=CoError
+Facility=Storage
+SymbolicName=STG_E_ACCESSDENIED
+Language=ENU
+Access Denied.
+.
diff --git a/po/zh_CN.po b/po/zh_CN.po
index 9614bc49415..e06b37979bb 100644
--- a/po/zh_CN.po
+++ b/po/zh_CN.po
@@ -4223,6 +4223,14 @@ msgstr "格鲁吉亚语"
 msgid "Armenian"
 msgstr "亚美尼亚语"
 
+#: dlls/kernelbase/winerror.mc
+msgid "Operation aborted\n"
+msgstr "已中止操作\n"
+
+#: dlls/kernelbase/winerror.mc
+msgid "Access Denied.\n"
+msgstr "拒绝访问。\n"
+
 #: dlls/kernelbase/winerror.mc:30
 msgid "Success.\n"
 msgstr "成功。\n"
