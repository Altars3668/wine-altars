diff --git a/include/shobjidl.idl b/include/shobjidl.idl
index e62ef6f003d..c7728cc2fab 100644
--- a/include/shobjidl.idl
+++ b/include/shobjidl.idl
@@ -3892,6 +3892,44 @@ interface IPreviewHandlerVisuals : IUnknown
     HRESULT SetTextColor([in] COLORREF color);
 }
 
+cpp_quote("#if 0")
+typedef HANDLE HMONITOR;
+cpp_quote("#endif")
+
+typedef [v1_enum] enum MONITOR_APP_VISIBILITY
+{
+    MAV_UNKNOWN        = 0,
+    MAV_NO_APP_VISIBLE = 1,
+    MAV_APP_VISIBLE    = 2,
+} MONITOR_APP_VISIBILITY;
+
+[
+    local,
+    object,
+    uuid(6584ce6b-7d82-49c2-89c9-c6bc02ba8c38),
+    pointer_default(unique)
+]
+interface IAppVisibilityEvents : IUnknown
+{
+    HRESULT AppVisibilityOnMonitorChanged([in] HMONITOR monitor, [in] MONITOR_APP_VISIBILITY previous,
+                                          [in] MONITOR_APP_VISIBILITY current);
+    HRESULT LauncherVisibilityChange([in] BOOL visible);
+}
+
+[
+    local,
+    object,
+    uuid(2246ea2d-caea-4444-a3c4-6de827e44313),
+    pointer_default(unique)
+]
