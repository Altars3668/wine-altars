diff --git a/dlls/twinapi/appvisibility.c b/dlls/twinapi/appvisibility.c
new file mode 100644
index 00000000000..e684ecad1d6
--- /dev/null
+++ b/dlls/twinapi/appvisibility.c
@@ -0,0 +1,283 @@
+/*
+ * AppVisibility
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#define COBJMACROS
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "objbase.h"
+#include "shobjidl.h"
+
+#include "wine/debug.h"
+#include "wine/list.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(twinapi);
+
+/*
+ * Whether the Start screen of Windows 8 ("the launcher"), or an app of its,
+ * is showing on a monitor.  Nothing here ever shows either, so the launcher
+ * is never visible, no monitor has an app on it, and no change is ever
+ * reported to those who ask to be told; which is what Windows answers on a
+ * desktop with the Start menu closed.  As there, each instance is a new,
+ * agile object, and a bad monitor, cookie or callback is E_INVALIDARG.
+ */
+
+struct advise
+{
+    struct list entry;
+    DWORD cookie;
+    IAppVisibilityEvents *events;
+};
+
+struct app_visibility
+{
+    IAppVisibility IAppVisibility_iface;
+    LONG ref;
+    IUnknown *marshal;
+    CRITICAL_SECTION cs;
+    struct list advises;
+};
+
+static LONG next_cookie;
+
+static inline struct app_visibility *impl_from_IAppVisibility( IAppVisibility *iface )
+{
+    return CONTAINING_RECORD( iface, struct app_visibility, IAppVisibility_iface );
+}
+
+static HRESULT WINAPI app_visibility_QueryInterface( IAppVisibility *iface, REFIID iid, void **out )
+{
+    struct app_visibility *impl = impl_from_IAppVisibility( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IAppVisibility ))
+    {
+        IAppVisibility_AddRef( (*out = &impl->IAppVisibility_iface) );
+        return S_OK;
+    }
+    if (IsEqualGUID( iid, &IID_IMarshal ))
+        return IUnknown_QueryInterface( impl->marshal, iid, out );
+
+    TRACE( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI app_visibility_AddRef( IAppVisibility *iface )
+{
+    struct app_visibility *impl = impl_from_IAppVisibility( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI app_visibility_Release( IAppVisibility *iface )
+{
+    struct app_visibility *impl = impl_from_IAppVisibility( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+    struct advise *advise, *next;
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( advise, next, &impl->advises, struct advise, entry )
+        {
+            list_remove( &advise->entry );
+            IAppVisibilityEvents_Release( advise->events );
+            free( advise );
+        }
+        IUnknown_Release( impl->marshal );
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI app_visibility_GetAppVisibilityOnMonitor( IAppVisibility *iface, HMONITOR monitor,
+                                                                MONITOR_APP_VISIBILITY *mode )
+{
+    MONITORINFO info = {.cbSize = sizeof(info)};
+
+    TRACE( "iface %p, monitor %p, mode %p.\n", iface, monitor, mode );
+
+    if (!mode) return E_INVALIDARG;
+    if (!monitor || !GetMonitorInfoW( monitor, &info ))
+    {
+        *mode = MAV_UNKNOWN;
+        return E_INVALIDARG;
+    }
+    *mode = MAV_NO_APP_VISIBLE;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_visibility_IsLauncherVisible( IAppVisibility *iface, BOOL *visible )
+{
+    TRACE( "iface %p, visible %p.\n", iface, visible );
+
+    if (!visible) return E_INVALIDARG;
+    *visible = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_visibility_Advise( IAppVisibility *iface, IAppVisibilityEvents *callback, DWORD *cookie )
+{
+    struct app_visibility *impl = impl_from_IAppVisibility( iface );
+    struct advise *advise;
+    HRESULT hr;
+
+    TRACE( "iface %p, callback %p, cookie %p.\n", iface, callback, cookie );
+
+    if (!callback || !cookie) return E_INVALIDARG;
+    if (!(advise = calloc( 1, sizeof(*advise) ))) return E_OUTOFMEMORY;
+    if (FAILED(hr = IAppVisibilityEvents_QueryInterface( callback, &IID_IAppVisibilityEvents, (void **)&advise->events )))
+    {
+        free( advise );
+        return E_INVALIDARG;
+    }
+    while (!(advise->cookie = InterlockedIncrement( &next_cookie )));
+
+    EnterCriticalSection( &impl->cs );
+    list_add_tail( &impl->advises, &advise->entry );
+    LeaveCriticalSection( &impl->cs );
+
+    *cookie = advise->cookie;
+    return S_OK;
+}
+
+static HRESULT WINAPI app_visibility_Unadvise( IAppVisibility *iface, DWORD cookie )
+{
+    struct app_visibility *impl = impl_from_IAppVisibility( iface );
+    struct advise *advise;
+
+    TRACE( "iface %p, cookie %#lx.\n", iface, cookie );
+
+    EnterCriticalSection( &impl->cs );
+    LIST_FOR_EACH_ENTRY( advise, &impl->advises, struct advise, entry )
+    {
+        if (advise->cookie != cookie) continue;
+        list_remove( &advise->entry );
+        LeaveCriticalSection( &impl->cs );
+        IAppVisibilityEvents_Release( advise->events );
+        free( advise );
+        return S_OK;
+    }
+    LeaveCriticalSection( &impl->cs );
+    return E_INVALIDARG;
+}
+
+static const IAppVisibilityVtbl app_visibility_vtbl =
+{
+    app_visibility_QueryInterface,
+    app_visibility_AddRef,
+    app_visibility_Release,
+    app_visibility_GetAppVisibilityOnMonitor,
+    app_visibility_IsLauncherVisible,
+    app_visibility_Advise,
+    app_visibility_Unadvise,
+};
+
+static HRESULT app_visibility_create( IUnknown *outer, REFIID iid, void **out )
+{
+    struct app_visibility *impl;
+    HRESULT hr;
+
+    *out = NULL;
+    if (outer) return CLASS_E_NOAGGREGATION;
+    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
+    impl->IAppVisibility_iface.lpVtbl = &app_visibility_vtbl;
+    impl->ref = 1;
+    list_init( &impl->advises );
+    InitializeCriticalSectionEx( &impl->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    impl->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": app_visibility.cs");
+    if (FAILED(hr = CoCreateFreeThreadedMarshaler( (IUnknown *)&impl->IAppVisibility_iface, &impl->marshal )))
+    {
+        impl->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &impl->cs );
+        free( impl );
+        return hr;
+    }
+
+    hr = IAppVisibility_QueryInterface( &impl->IAppVisibility_iface, iid, out );
+    IAppVisibility_Release( &impl->IAppVisibility_iface );
+    return hr;
+}
+
+static HRESULT WINAPI class_factory_QueryInterface( IClassFactory *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IClassFactory ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI class_factory_AddRef( IClassFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI class_factory_Release( IClassFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI class_factory_CreateInstance( IClassFactory *iface, IUnknown *outer, REFIID iid, void **out )
+{
+    TRACE( "iface %p, outer %p, iid %s, out %p.\n", iface, outer, debugstr_guid( iid ), out );
+    return app_visibility_create( outer, iid, out );
+}
+
+static HRESULT WINAPI class_factory_LockServer( IClassFactory *iface, BOOL lock )
+{
+    TRACE( "iface %p, lock %d.\n", iface, lock );
+    return S_OK;
+}
+
+static const IClassFactoryVtbl class_factory_vtbl =
+{
+    class_factory_QueryInterface,
+    class_factory_AddRef,
+    class_factory_Release,
+    class_factory_CreateInstance,
+    class_factory_LockServer,
+};
+
+static IClassFactory app_visibility_factory = {&class_factory_vtbl};
+
+HRESULT WINAPI DllGetClassObject( REFCLSID clsid, REFIID iid, void **out )
+{
+    TRACE( "clsid %s, iid %s, out %p.\n", debugstr_guid( clsid ), debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( clsid, &CLSID_AppVisibility ))
+        return IClassFactory_QueryInterface( &app_visibility_factory, iid, out );
+
+    FIXME( "class %s not available.\n", debugstr_guid( clsid ) );
+    *out = NULL;
+    return CLASS_E_CLASSNOTAVAILABLE;
+}
