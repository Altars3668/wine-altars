+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+#define COBJMACROS
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winuser.h"
+#include "objbase.h"
+#include "shobjidl.h"
+
+#include "wine/test.h"
+
+static LONG events_ref = 1;
+
+static HRESULT WINAPI events_QueryInterface( IAppVisibilityEvents *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAppVisibilityEvents ))
+    {
+        *out = iface;
+        IAppVisibilityEvents_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI events_AddRef( IAppVisibilityEvents *iface )
+{
+    return InterlockedIncrement( &events_ref );
+}
+
+static ULONG WINAPI events_Release( IAppVisibilityEvents *iface )
+{
+    return InterlockedDecrement( &events_ref );
+}
+
+static HRESULT WINAPI events_AppVisibilityOnMonitorChanged( IAppVisibilityEvents *iface, HMONITOR monitor,
+                                                            MONITOR_APP_VISIBILITY previous, MONITOR_APP_VISIBILITY current )
+{
+    ok( 0, "unexpected change %d -> %d.\n", previous, current );
+    return S_OK;
+}
+
+static HRESULT WINAPI events_LauncherVisibilityChange( IAppVisibilityEvents *iface, BOOL visible )
+{
+    ok( 0, "unexpected change %d.\n", visible );
+    return S_OK;
+}
+
+static const IAppVisibilityEventsVtbl events_vtbl =
+{
+    events_QueryInterface,
+    events_AddRef,
+    events_Release,
+    events_AppVisibilityOnMonitorChanged,
+    events_LauncherVisibilityChange,
+};
+
+static IAppVisibilityEvents events = {&events_vtbl};
+
+static void test_AppVisibility( DWORD model )
+{
+    HMONITOR monitor = MonitorFromPoint( (POINT){0, 0}, MONITOR_DEFAULTTOPRIMARY );
+    IAppVisibility *visibility, *other;
+    MONITOR_APP_VISIBILITY mode;
+    DWORD cookie, cookie2;
+    IUnknown *unk;
+    BOOL visible;
+    HRESULT hr;
+    ULONG ref;
+
+    CoInitializeEx( NULL, model );
+
+    hr = CoCreateInstance( &CLSID_AppVisibility, NULL, CLSCTX_INPROC_SERVER, &IID_IAppVisibility, (void **)&visibility );
+    if (hr == 0xc0000022)
+    {
+        win_skip( "not an interactive session.\n" );
+        CoUninitialize();
+        return;
+    }
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    /* a new object every time, and an agile one */
+    hr = CoCreateInstance( &CLSID_AppVisibility, NULL, CLSCTX_INPROC_SERVER, &IID_IAppVisibility, (void **)&other );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( other != visibility, "got the same object.\n" );
+    IAppVisibility_Release( other );
+    hr = IAppVisibility_QueryInterface( visibility, &IID_IAgileObject, (void **)&unk );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (hr == S_OK) IUnknown_Release( unk );
+    hr = IAppVisibility_QueryInterface( visibility, &IID_IMarshal, (void **)&unk );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (hr == S_OK) IUnknown_Release( unk );
+    hr = IAppVisibility_QueryInterface( visibility, &IID_IClassFactory, (void **)&unk );
+    ok( hr == E_NOINTERFACE, "got hr %#lx.\n", hr );
+
+    /* with the Start menu closed, nothing shows */
+    visible = 2;
+    hr = IAppVisibility_IsLauncherVisible( visibility, &visible );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !visible, "got %d.\n", visible );
+    mode = -1;
+    hr = IAppVisibility_GetAppVisibilityOnMonitor( visibility, monitor, &mode );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( mode == MAV_NO_APP_VISIBLE, "got %d.\n", mode );
+    mode = -1;
+    hr = IAppVisibility_GetAppVisibilityOnMonitor( visibility, NULL, &mode );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ok( mode == MAV_UNKNOWN, "got %d.\n", mode );
+    mode = -1;
+    hr = IAppVisibility_GetAppVisibilityOnMonitor( visibility, (HMONITOR)0x12345, &mode );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    ok( mode == MAV_UNKNOWN, "got %d.\n", mode );
+
+    /* each advice holds the callback until it is taken back */
+    cookie = 0;
+    hr = IAppVisibility_Advise( visibility, &events, &cookie );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( cookie, "got no cookie.\n" );
+    ok( events_ref == 2, "got %ld references.\n", events_ref );
+    cookie2 = 0;
+    hr = IAppVisibility_Advise( visibility, &events, &cookie2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( cookie2 && cookie2 != cookie, "got %#lx and %#lx.\n", cookie, cookie2 );
+    ok( events_ref == 3, "got %ld references.\n", events_ref );
+    hr = IAppVisibility_Unadvise( visibility, cookie );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( events_ref == 2, "got %ld references.\n", events_ref );
+    hr = IAppVisibility_Unadvise( visibility, cookie );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IAppVisibility_Unadvise( visibility, cookie2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( events_ref == 1, "got %ld references.\n", events_ref );
+    hr = IAppVisibility_Unadvise( visibility, 0 );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+    hr = IAppVisibility_Advise( visibility, NULL, &cookie );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+
+    ref = IAppVisibility_Release( visibility );
+    ok( !ref, "got %lu.\n", ref );
+    CoUninitialize();
+}
+
+START_TEST(appvisibility)
+{
+    test_AppVisibility( COINIT_APARTMENTTHREADED );
+    test_AppVisibility( COINIT_MULTITHREADED );
+}
