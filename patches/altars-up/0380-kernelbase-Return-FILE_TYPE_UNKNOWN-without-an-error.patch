From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 14:22:30 -0400
Subject: [PATCH] kernelbase: Return FILE_TYPE_UNKNOWN without an error for a
 mailslot in GetFileType().

A known device type that is neither a disk, a character device nor a
pipe is reported as unknown with the last error cleared, as the
function documents and the test measured on Windows.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 3ae96aff30d..f947166df4a 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -3497,8 +3497,14 @@ static void test_GetFileType(void)
     SetLastError( 12345678 );
     type = GetFileType( h );
     ok( type == FILE_TYPE_UNKNOWN, "expected type unknown got %ld\n", type );
-    todo_wine
     ok( GetLastError() == NO_ERROR, "expected ERROR_NO_ERROR got %lx\n", GetLastError() );
+    h2 = CreateFileW( L"\\\\.\\mailslot\\wine_test", GENERIC_WRITE, FILE_SHARE_READ, NULL, OPEN_EXISTING, 0, NULL );
+    ok( h2 != INVALID_HANDLE_VALUE, "opening the mailslot failed, error %lu\n", GetLastError() );
+    SetLastError( 12345678 );
+    type = GetFileType( h2 );
+    ok( type == FILE_TYPE_UNKNOWN, "expected type unknown got %ld\n", type );
+    ok( GetLastError() == NO_ERROR, "expected ERROR_NO_ERROR got %lx\n", GetLastError() );
+    CloseHandle( h2 );
     CloseHandle( h );
 
     SetLastError( 12345678 );
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 7623a35ad73..0375933c780 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -3606,6 +3606,10 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetFileType( HANDLE file )
         return FILE_TYPE_CHAR;
     case FILE_DEVICE_NAMED_PIPE:
         return FILE_TYPE_PIPE;
+    case FILE_DEVICE_MAILSLOT:
+        /* a type of its own: known, so no error */
+        SetLastError( NO_ERROR );
+        return FILE_TYPE_UNKNOWN;
     default:
         return FILE_TYPE_DISK;
     }
