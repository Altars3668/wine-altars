From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 22:10:46 -0400
Subject: [PATCH] ole32: Let go of the delegates of an embedded object that
 never ran.

An embedding helper for an in-process server creates the object at once
and asks it for IPersistStorage and IDataObject; an object without
IDataObject is not taken as running, but the handler kept the other two
references, and as stopping only undoes a run, destroying the handler
left them behind.  ole32's tests count two references outstanding after
such a helper goes, none on Windows.  The handler now releases what it
holds when it is destroyed, run or not.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ole32/defaulthandler.c b/dlls/ole32/defaulthandler.c
index 894c962e8a4..89cdafec8a2 100644
--- a/dlls/ole32/defaulthandler.c
+++ b/dlls/ole32/defaulthandler.c
@@ -2193,8 +2193,9 @@ static void DefaultHandler_Destroy(
    * the reference count. */
   This->ref = 10000;
 
-  /* release delegates */
+  /* release delegates, also the ones of an object that never got to run */
   DefaultHandler_Stop(This);
+  release_delegates(This);
 
   HeapFree( GetProcessHeap(), 0, This->containerApp );
   This->containerApp = NULL;
diff --git a/dlls/ole32/tests/ole2.c b/dlls/ole32/tests/ole2.c
index 90da1c060a5..38508fba383 100644
--- a/dlls/ole32/tests/ole2.c
+++ b/dlls/ole32/tests/ole2.c
@@ -3007,7 +3007,7 @@ static void test_default_handler(void)
         }
 
         CHECK_NO_EXTRA_METHODS();
-        todo_wine ok(!ole_object_refcount, "Got outstanding refcount %ld.\n", ole_object_refcount);
+        ok(!ole_object_refcount, "Got outstanding refcount %ld.\n", ole_object_refcount);
 
         hr = CoRevokeClassObject(dwRegister);
         ok_ole_success(hr, "CoRevokeClassObject");
@@ -3038,21 +3038,21 @@ static void test_runnable(void)
     ret = OleIsRunning(object);
     ok(ret == TRUE, "Object should be running\n");
     CHECK_NO_EXTRA_METHODS();
-    todo_wine ok(!ole_object_refcount, "Got outstanding refcount %ld.\n", ole_object_refcount);
+    ok(!ole_object_refcount, "Got outstanding refcount %ld.\n", ole_object_refcount);
 
     g_isRunning = FALSE;
     expected_method_list = methods_query_runnable;
     ret = OleIsRunning(object);
     ok(ret == FALSE, "Object should not be running\n");
     CHECK_NO_EXTRA_METHODS();
-    todo_wine ok(!ole_object_refcount, "Got outstanding refcount %ld.\n", ole_object_refcount);
+    ok(!ole_object_refcount, "Got outstanding refcount %ld.\n", ole_object_refcount);
 
     g_showRunnable = FALSE;  /* QueryInterface(IID_IRunnableObject, ...) will fail */
     expected_method_list = methods_no_runnable;
     ret = OleIsRunning(object);
     ok(ret == TRUE, "Object without IRunnableObject should be running\n");
     CHECK_NO_EXTRA_METHODS();
-    todo_wine ok(!ole_object_refcount, "Got outstanding refcount %ld.\n", ole_object_refcount);
+    ok(!ole_object_refcount, "Got outstanding refcount %ld.\n", ole_object_refcount);
 
     g_isRunning = TRUE;
     g_showRunnable = TRUE;
