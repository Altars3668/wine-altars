+    IUriRuntimeClass_Release(uri);
+
+    WindowsCreateString(L"a b&c=d/e?f#g%h+i~j*k'l(m)n!o\x00e9\x4e2d", wcslen(L"a b&c=d/e?f#g%h+i~j*k'l(m)n!o\x00e9\x4e2d"), &name);
+    hr = IUriEscapeStatics_EscapeComponent(escape, name, &str);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    check_hstring(str, L"a%20b%26c%3Dd%2Fe%3Ff%23g%25h%2Bi~j%2Ak%27l%28m%29n%21o%C3%A9%E4%B8%AD");
+    WindowsDeleteString(name);
+    WindowsCreateString(L"%41%zz%4+%E4%B8%AD", wcslen(L"%41%zz%4+%E4%B8%AD"), &name);
