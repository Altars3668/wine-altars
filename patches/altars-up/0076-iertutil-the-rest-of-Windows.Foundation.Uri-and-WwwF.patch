+    else if (!wcscmp(name, RuntimeClass_Windows_Foundation_WwwFormUrlDecoder)) *factory = www_form_url_decoder_factory;
+    if (!*factory) return CLASS_E_CLASSNOTAVAILABLE;
     IUnknown_AddRef(*factory);
     return S_OK;
 }
