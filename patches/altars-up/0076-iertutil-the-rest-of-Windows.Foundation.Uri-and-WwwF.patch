+DEFINE_IINSPECTABLE(uri_escape, IUriEscapeStatics, struct iertutil, IActivationFactory_iface)
+
+/* Everything but unreserved ASCII is written as UTF-8 %XX. */
+static HRESULT STDMETHODCALLTYPE uri_escape_EscapeComponent(IUriEscapeStatics *iface, HSTRING to_escape, HSTRING *value)
+{
+    const WCHAR *str;
+    WCHAR *buf, *out;
+    UINT32 len;
+    char *utf8;
+    int n, j;
+    HRESULT hr;
+
+    TRACE("iface %p, to_escape %s, value %p.\n", iface, debugstr_hstring(to_escape), value);
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    str = WindowsGetStringRawBuffer(to_escape, &len);
+    if (!len) return S_OK;
+    n = WideCharToMultiByte(CP_UTF8, 0, str, len, NULL, 0, NULL, NULL);
+    if (!(utf8 = malloc(n)) || !(buf = malloc((n * 3 + 1) * sizeof(WCHAR))))
+    {
+        free(utf8);
+        return E_OUTOFMEMORY;
+    }
+    WideCharToMultiByte(CP_UTF8, 0, str, len, utf8, n, NULL, NULL);
+    for (j = 0, out = buf; j < n; j++)
+    {
+        BYTE c = utf8[j];
+        if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || strchr("-._~", c)) *out++ = c;
+        else out += swprintf(out, 4, L"%%%02X", c);
+    }
+    hr = WindowsCreateString(buf, out - buf, value);
+    free(buf);
+    free(utf8);
+    return hr;
+}
+
+/* %XX becomes the byte, and the bytes UTF-8; what is not a %XX stays. */
+static HRESULT STDMETHODCALLTYPE uri_escape_UnescapeComponent(IUriEscapeStatics *iface, HSTRING to_unescape, HSTRING *value)
+{
+    const WCHAR *str;
+    WCHAR *buf;
+    UINT32 len, i;
+    char *bytes;
+    int n = 0, count;
+    HRESULT hr;
+
+    TRACE("iface %p, to_unescape %s, value %p.\n", iface, debugstr_hstring(to_unescape), value);
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    str = WindowsGetStringRawBuffer(to_unescape, &len);
+    if (!len) return S_OK;
+    if (!(bytes = malloc(len * 3))) return E_OUTOFMEMORY;
+    for (i = 0; i < len; i++)
+    {
+        if (str[i] == '%' && i + 2 < len && iswxdigit(str[i + 1]) && iswxdigit(str[i + 2]))
+        {
+            WCHAR hex[3] = {str[i + 1], str[i + 2], 0};
+            bytes[n++] = (char)wcstoul(hex, NULL, 16);
+            i += 2;
+        }
+        else n += WideCharToMultiByte(CP_UTF8, 0, str + i, 1, bytes + n, 3, NULL, NULL);
+    }
+    count = MultiByteToWideChar(CP_UTF8, 0, bytes, n, NULL, 0);
+    if (!(buf = malloc((count + 1) * sizeof(WCHAR))))
+    {
+        free(bytes);
+        return E_OUTOFMEMORY;
+    }
+    MultiByteToWideChar(CP_UTF8, 0, bytes, n, buf, count);
+    hr = WindowsCreateString(buf, count, value);
+    free(buf);
+    free(bytes);
+    return hr;
+}
