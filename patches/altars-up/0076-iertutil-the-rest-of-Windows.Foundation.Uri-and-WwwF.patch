+        IWwwFormUrlDecoderRuntimeClass_QueryInterface(decoder, &IID_IVectorView_IWwwFormUrlDecoderEntry, (void **)&view);
+        hr = IVectorView_IWwwFormUrlDecoderEntry_get_Size(view, &size);
+        ok(hr == S_OK && size == decoder_tests[i].count, "got hr %#lx, size %u.\n", hr, size);
+        for (j = 0; j < size && j < decoder_tests[i].count; j++)
