+static IUriRuntimeClass *create_uri(IUriRuntimeClassFactory *factory, const WCHAR *text)
+{
+    IUriRuntimeClass *uri = NULL;
+    HSTRING str;
+    HRESULT hr;
+
+    WindowsCreateString(text, wcslen(text), &str);
+    hr = IUriRuntimeClassFactory_CreateUri(factory, str, &uri);
+    ok(hr == S_OK, "CreateUri %s returned %#lx.\n", debugstr_w(text), hr);
+    WindowsDeleteString(str);
+    return uri;
+}
+
+#define check_hstring(a, b) check_hstring_(__LINE__, a, b)
+static void check_hstring_(int line, HSTRING str, const WCHAR *expect)
+{
+    const WCHAR *buffer = WindowsGetStringRawBuffer(str, NULL);
+    ok_(__FILE__, line)(!wcscmp(buffer, expect ? expect : L""), "got %s, expected %s.\n", debugstr_hstring(str),
+                        debugstr_w(expect));
+    ok_(__FILE__, line)(!expect == !str, "got %p.\n", str);
+    WindowsDeleteString(str);
+}
+
+static void test_Uri_members(void)
+{
+    static const struct
+    {
+        const WCHAR *other;
+        BOOL equal;
+    }
+    equals_tests[] =
+    {
+        {L"http://example.com/a/b/c?q#f", TRUE},
+        {L"HTTP://EXAMPLE.COM/a/b/c?q#f", TRUE},
+        {L"http://example.com:80/a/b/c?q#f", TRUE},
+        {L"http://example.com/a/b/c?q#g", FALSE},
+        {L"http://example.com/a/b/c?Q#f", FALSE},
+        {L"http://example.com/A/b/c?q#f", FALSE},
+        {L"http://example.com/a/./b/c?q#f", TRUE},
+        {L"http://example.com/a/%62/c?q#f", TRUE},
+    };
+    static const struct
+    {
+        const WCHAR *relative;
+        const WCHAR *result;
+    }
+    combine_tests[] =
+    {
+        {L"d", L"http://example.com/a/b/d"},
+        {L"../d", L"http://example.com/a/d"},
+        {L"/d", L"http://example.com/d"},
+        {L"?x", L"http://example.com/a/b/c?x"},
+        {L"#y", L"http://example.com/a/b/c?q#y"},
+        {L"//other.com/p", L"http://other.com/p"},
+        {L"https://third.com/", L"https://third.com/"},
+        {L"g;x?y#s", L"http://example.com/a/b/g;x?y#s"},
+    };
+    static const struct
+    {
+        const WCHAR *query;
+        const WCHAR *entries[6][2];
+        UINT32 count;
+    }
+    decoder_tests[] =
+    {
+        {L"?a=1&b=2", {{L"a", L"1"}, {L"b", L"2"}}, 2},
+        {L"a=1&b=%20x+y", {{L"a", L"1"}, {L"b", L" x y"}}, 2},
+        {L"&&a", {{NULL, NULL}, {NULL, NULL}, {L"a", NULL}}, 3},
+        {L"a==b", {{L"a", L"=b"}}, 1},
+        {L"q=\x00e9", {{NULL}}, 0},
+    };
+    IUriRuntimeClassWithAbsoluteCanonicalUri *canonical;
+    IWwwFormUrlDecoderRuntimeClassFactory *decoder_factory;
+    IVectorView_IWwwFormUrlDecoderEntry *view;
+    IWwwFormUrlDecoderRuntimeClass *decoder;
