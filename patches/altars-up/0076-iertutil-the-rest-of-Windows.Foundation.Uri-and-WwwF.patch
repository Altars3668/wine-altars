+HRESULT www_form_url_decoder_create(const WCHAR *query, UINT32 len, IWwwFormUrlDecoderRuntimeClass **out)
+{
+    const WCHAR *p, *end, *next;
+    struct decoder *impl;
+    UINT32 capacity = 0;
+    HRESULT hr = S_OK;
+
+    if (!(impl = calloc(1, sizeof(*impl)))) return E_OUTOFMEMORY;
+    impl->IWwwFormUrlDecoderRuntimeClass_iface.lpVtbl = &decoder_vtbl;
+    impl->IVectorView_IWwwFormUrlDecoderEntry_iface.lpVtbl = &decoder_view_vtbl;
+    impl->IIterable_IWwwFormUrlDecoderEntry_iface.lpVtbl = &decoder_iterable_vtbl;
+    impl->ref = 1;
+
+    p = query;
+    end = query + len;
+    if (p < end && *p == '?') p++;
+    /* a query with characters that are not ASCII gives Windows no entries */
+    for (next = p; next < end; next++) if (*next >= 0x80) p = end;
+    while (p < end && SUCCEEDED(hr))
+    {
+        if (!(next = find_char(p, '&', end - p))) next = end;
+        if (impl->count == capacity)
+        {
+            IWwwFormUrlDecoderEntry **entries;
+            capacity = max(8, capacity * 2);
+            if (!(entries = realloc(impl->entries, capacity * sizeof(*entries))))
+            {
+                hr = E_OUTOFMEMORY;
+                break;
+            }
+            impl->entries = entries;
+        }
+        if (SUCCEEDED(hr = entry_create(p, next - p, &impl->entries[impl->count]))) impl->count++;
+        p = next < end ? next + 1 : end;
+    }
+    if (FAILED(hr))
+    {
+        decoder_Release(&impl->IWwwFormUrlDecoderRuntimeClass_iface);
+        return hr;
+    }
+    *out = &impl->IWwwFormUrlDecoderRuntimeClass_iface;
+    return S_OK;
+}
