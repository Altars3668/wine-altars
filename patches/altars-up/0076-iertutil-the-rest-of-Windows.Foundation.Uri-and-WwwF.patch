+    IWwwFormUrlDecoderRuntimeClassFactory_Release(decoder_factory);
+
+    IUriEscapeStatics_Release(escape);
+    IUriRuntimeClassFactory_Release(uri_factory);
+    RoUninitialize();
+}
+
 START_TEST(iertutil)
 {
     test_IUriRuntimeClassFactory();
     test_IUriRuntimeClass();
+    test_Uri_members();
 }
