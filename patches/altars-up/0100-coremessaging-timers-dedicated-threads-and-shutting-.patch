+/*
+ * A timer ticks through a window timer on its queue's window, named by its
+ * own address.  The queue holds no reference to it -- as on Windows, a timer
+ * released while running stops -- so a tick only goes to a timer that is still
+ * in the list of live ones.
+ */
+struct timer_handler
+{
+    struct list entry;
+    EventRegistrationToken token;
+    ITypedEventHandler_DispatcherQueueTimer_IInspectable *handler;
+};
+
+struct dispatcher_queue_timer
+{
+    IDispatcherQueueTimer IDispatcherQueueTimer_iface;
+    LONG ref;
+    struct list entry;              /* in the live timers */
+
+    struct dispatcher_queue *queue;
+    TimeSpan interval;
+    boolean repeating;
+    boolean running;
+    boolean ticking;                /* its handlers are being called */
+    LONG generation;                /* counts starts and stops, for a tick to tell it was stopped or restarted */
+    struct list handlers;
+    UINT64 next_token;
+};
+
+static struct list live_timers = LIST_INIT( live_timers );
+static CRITICAL_SECTION timers_cs;
+static CRITICAL_SECTION_DEBUG timers_cs_debug =
+{
+    0, 0, &timers_cs,
+    { &timers_cs_debug.ProcessLocksList, &timers_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": timers_cs") }
+};
+static CRITICAL_SECTION timers_cs = { &timers_cs_debug, -1, 0, 0, 0, 0 };
+
+static void timer_tick( UINT_PTR id );
+static void queue_shutdown_start( struct dispatcher_queue *queue );
+static void queue_shutdown_finish( struct dispatcher_queue *queue );
+
 static LRESULT CALLBACK queue_wndproc( HWND hwnd, UINT msg, WPARAM wparam, LPARAM lparam )
 {
     IDispatcherQueueHandler *handler;
 
-    if (msg != WM_DISPATCHER_QUEUE_INVOKE) return DefWindowProcW( hwnd, msg, wparam, lparam );
-
-    if ((handler = (IDispatcherQueueHandler *)lparam))
+    switch (msg)
     {
-        IDispatcherQueueHandler_Invoke( handler );
-        IDispatcherQueueHandler_Release( handler );
+    case WM_DISPATCHER_QUEUE_INVOKE:
+        if ((handler = (IDispatcherQueueHandler *)lparam))
+        {
+            IDispatcherQueueHandler_Invoke( handler );
+            IDispatcherQueueHandler_Release( handler );
+        }
+        return 0;
+    case WM_DISPATCHER_QUEUE_TIMER:
+        /* wparam is the timer's id, lparam its interval in ms, or -1 to stop it */
+        if (lparam == -1) KillTimer( hwnd, wparam );
+        else SetTimer( hwnd, wparam, lparam, NULL );
+        return 0;
+    case WM_TIMER:
+        timer_tick( wparam );
+        return 0;
+    case WM_DISPATCHER_QUEUE_SHUTDOWN:
+        queue_shutdown_start( (struct dispatcher_queue *)lparam );
+        return 0;
+    case WM_DISPATCHER_QUEUE_SHUTDOWN_CONTINUE:
