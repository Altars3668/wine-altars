+
+    hr = IDispatcherQueue_CreateTimer( queue, &timer );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDispatcherQueue_CreateTimer( queue, &timer2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( timer != timer2, "got the same timer.\n" );
+    check_interface( timer, &IID_IAgileObject );
+    hr = IDispatcherQueueTimer_QueryInterface( timer, &IID_IInspectable, (void **)&inspectable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IInspectable_GetRuntimeClassName( inspectable, &name );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !wcscmp( WindowsGetStringRawBuffer( name, NULL ), L"Windows.System.DispatcherQueueTimer" ), "got class %s.\n",
+        debugstr_hstring( name ) );
+    WindowsDeleteString( name );
+    IInspectable_Release( inspectable );
+
+    interval.Duration = -1;
+    hr = IDispatcherQueueTimer_get_Interval( timer, &interval );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !interval.Duration, "got interval %I64d.\n", interval.Duration );
+    value = 2;
+    IDispatcherQueueTimer_get_IsRepeating( timer, &value );
+    ok( value == TRUE, "got IsRepeating %d.\n", value );
+    value = 2;
+    IDispatcherQueueTimer_get_IsRunning( timer, &value );
+    ok( value == FALSE, "got IsRunning %d.\n", value );
+    interval.Duration = -10000;
+    hr = IDispatcherQueueTimer_put_Interval( timer, interval );
+    ok( hr == E_INVALIDARG, "got hr %#lx.\n", hr );
+
+    hr = IDispatcherQueueTimer_add_Tick( timer, &handler.ITypedEventHandler_DispatcherQueueTimer_IInspectable_iface, &token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDispatcherQueueTimer_add_Tick( timer2, &handler.ITypedEventHandler_DispatcherQueueTimer_IInspectable_iface, &token2 );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    /* once, at 50ms, with the timer not running while its handlers run */
+    interval.Duration = 500000;
+    hr = IDispatcherQueueTimer_put_Interval( timer, interval );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDispatcherQueueTimer_put_IsRepeating( timer, FALSE );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDispatcherQueueTimer_Start( timer );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    value = FALSE;
+    IDispatcherQueueTimer_get_IsRunning( timer, &value );
+    ok( value == TRUE, "got IsRunning %d.\n", value );
+    ok( !handler.ticks, "ticked before the message loop ran.\n" );
+    wait_messages( 400 );
+    ok( handler.ticks == 1, "got %ld ticks.\n", handler.ticks );
+    ok( handler.running == FALSE, "got IsRunning %d while ticking.\n", handler.running );
+    value = 2;
+    IDispatcherQueueTimer_get_IsRunning( timer, &value );
+    ok( value == FALSE, "got IsRunning %d.\n", value );
+
+    /* repeating until stopped */
+    handler.ticks = 0;
+    IDispatcherQueueTimer_put_IsRepeating( timer, TRUE );
+    IDispatcherQueueTimer_Start( timer );
+    wait_messages( 500 );
+    ok( handler.ticks >= 3, "got %ld ticks.\n", handler.ticks );
+    hr = IDispatcherQueueTimer_Stop( timer );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDispatcherQueueTimer_Stop( timer );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    handler.ticks = 0;
+    wait_messages( 200 );
+    ok( !handler.ticks, "got %ld ticks after Stop.\n", handler.ticks );
