+        return 0;
     }
-    return 0;
+    return DefWindowProcW( hwnd, msg, wparam, lparam );
 }
 
 static BOOL WINAPI queue_init_once( INIT_ONCE *once, void *param, void **context )
@@ -82,6 +166,946 @@ static void queue_init( void )
     InitOnceExecuteOnce( &once, queue_init_once, NULL, NULL );
 }
 
+
+/*** DispatcherQueueTimer ***/
+
+static inline struct dispatcher_queue_timer *impl_from_IDispatcherQueueTimer( IDispatcherQueueTimer *iface )
+{
+    return CONTAINING_RECORD( iface, struct dispatcher_queue_timer, IDispatcherQueueTimer_iface );
+}
+
+static UINT timer_ms( const struct dispatcher_queue_timer *timer )
+{
+    INT64 ms = (timer->interval.Duration + 9999) / 10000;
+    return ms > USER_TIMER_MAXIMUM ? USER_TIMER_MAXIMUM : ms;
+}
+
+/* called with timers_cs held */
+static void timer_set( struct dispatcher_queue_timer *timer, BOOL start )
+{
+    HWND hwnd = timer->queue->hwnd;
+    UINT_PTR id = (UINT_PTR)timer;
+
+    if (!hwnd) return;
+    if (timer->queue->thread_id == GetCurrentThreadId())
+    {
+        if (start) SetTimer( hwnd, id, timer_ms( timer ), NULL );
+        else KillTimer( hwnd, id );
+    }
+    else PostMessageW( hwnd, WM_DISPATCHER_QUEUE_TIMER, id, start ? timer_ms( timer ) : -1 );
+}
+
+static void timer_tick( UINT_PTR id )
+{
+    ITypedEventHandler_DispatcherQueueTimer_IInspectable **handlers = NULL;
+    struct dispatcher_queue_timer *timer, *found = NULL;
+    struct timer_handler *entry;
+    unsigned int count = 0, i;
+    LONG generation;
+
+    EnterCriticalSection( &timers_cs );
+    LIST_FOR_EACH_ENTRY( timer, &live_timers, struct dispatcher_queue_timer, entry )
+    {
+        if ((UINT_PTR)timer != id) continue;
+        found = timer;
+        break;
+    }
+    if (!found || !found->running)
+    {
+        LeaveCriticalSection( &timers_cs );
+        return;
+    }
+    timer = found;
+    IDispatcherQueueTimer_AddRef( &timer->IDispatcherQueueTimer_iface );
+    /* while its handlers run, a timer does not count as running */
+    timer->running = FALSE;
+    timer->ticking = TRUE;
+    generation = timer->generation;
+    if (!timer->repeating) KillTimer( timer->queue->hwnd, id );
+    if ((handlers = calloc( list_count( &timer->handlers ) + 1, sizeof(*handlers) )))
+    {
+        LIST_FOR_EACH_ENTRY( entry, &timer->handlers, struct timer_handler, entry )
+        {
+            handlers[count] = entry->handler;
+            ITypedEventHandler_DispatcherQueueTimer_IInspectable_AddRef( handlers[count++] );
+        }
+    }
+    LeaveCriticalSection( &timers_cs );
+
+    TRACE( "timer %p ticks, %u handlers.\n", timer, count );
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_DispatcherQueueTimer_IInspectable_Invoke( handlers[i], &timer->IDispatcherQueueTimer_iface, NULL );
+        ITypedEventHandler_DispatcherQueueTimer_IInspectable_Release( handlers[i] );
+    }
+    free( handlers );
+
+    EnterCriticalSection( &timers_cs );
+    timer->ticking = FALSE;
+    /* a repeating timer goes on unless a handler stopped or restarted it */
+    if (timer->repeating && timer->generation == generation) timer->running = TRUE;
+    LeaveCriticalSection( &timers_cs );
+    IDispatcherQueueTimer_Release( &timer->IDispatcherQueueTimer_iface );
+}
+
+static HRESULT WINAPI timer_QueryInterface( IDispatcherQueueTimer *iface, REFIID iid, void **out )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IDispatcherQueueTimer ))
+    {
+        *out = &timer->IDispatcherQueueTimer_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI timer_AddRef( IDispatcherQueueTimer *iface )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+    ULONG ref = InterlockedIncrement( &timer->ref );
+    TRACE( "iface %p increasing ref to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI timer_Release( IDispatcherQueueTimer *iface )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+    ULONG ref = InterlockedDecrement( &timer->ref );
+    struct timer_handler *entry, *next;
+
+    TRACE( "iface %p decreasing ref to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        EnterCriticalSection( &timers_cs );
+        list_remove( &timer->entry );
+        timer_set( timer, FALSE );
+        LeaveCriticalSection( &timers_cs );
+        LIST_FOR_EACH_ENTRY_SAFE( entry, next, &timer->handlers, struct timer_handler, entry )
+        {
+            list_remove( &entry->entry );
+            ITypedEventHandler_DispatcherQueueTimer_IInspectable_Release( entry->handler );
+            free( entry );
+        }
+        IDispatcherQueue_Release( &timer->queue->IDispatcherQueue_iface );
+        free( timer );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI timer_GetIids( IDispatcherQueueTimer *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI timer_GetRuntimeClassName( IDispatcherQueueTimer *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.System.DispatcherQueueTimer";
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
+}
+
+static HRESULT WINAPI timer_GetTrustLevel( IDispatcherQueueTimer *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_get_Interval( IDispatcherQueueTimer *iface, TimeSpan *value )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &timers_cs );
+    *value = timer->interval;
+    LeaveCriticalSection( &timers_cs );
+    return S_OK;
+}
+
+/* a running timer goes on at the new interval */
+static HRESULT WINAPI timer_put_Interval( IDispatcherQueueTimer *iface, TimeSpan value )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+
+    TRACE( "iface %p, value %I64d.\n", iface, value.Duration );
+
+    if (value.Duration < 0) return E_INVALIDARG;
+    EnterCriticalSection( &timers_cs );
+    timer->interval = value;
+    if (timer->running) timer_set( timer, TRUE );
+    LeaveCriticalSection( &timers_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_get_IsRunning( IDispatcherQueueTimer *iface, boolean *value )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &timers_cs );
+    *value = timer->running;
+    LeaveCriticalSection( &timers_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_get_IsRepeating( IDispatcherQueueTimer *iface, boolean *value )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    EnterCriticalSection( &timers_cs );
+    *value = timer->repeating;
+    LeaveCriticalSection( &timers_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_put_IsRepeating( IDispatcherQueueTimer *iface, boolean value )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+
+    EnterCriticalSection( &timers_cs );
+    timer->repeating = !!value;
+    LeaveCriticalSection( &timers_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_Start( IDispatcherQueueTimer *iface )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &timers_cs );
+    timer->generation++;
+    timer->running = TRUE;
+    timer_set( timer, TRUE );
+    LeaveCriticalSection( &timers_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_Stop( IDispatcherQueueTimer *iface )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &timers_cs );
+    timer->generation++;
+    if (timer->running || timer->ticking) timer_set( timer, FALSE );
+    timer->running = FALSE;
+    LeaveCriticalSection( &timers_cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_add_Tick( IDispatcherQueueTimer *iface,
+                                      ITypedEventHandler_DispatcherQueueTimer_IInspectable *handler,
+                                      EventRegistrationToken *token )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+    struct timer_handler *entry;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    if (!token) return E_POINTER;
+    if (!handler) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->handler = handler;
+    ITypedEventHandler_DispatcherQueueTimer_IInspectable_AddRef( handler );
+    EnterCriticalSection( &timers_cs );
+    entry->token.value = ++timer->next_token;
+    list_add_tail( &timer->handlers, &entry->entry );
+    LeaveCriticalSection( &timers_cs );
+    *token = entry->token;
+    return S_OK;
+}
+
+static HRESULT WINAPI timer_remove_Tick( IDispatcherQueueTimer *iface, EventRegistrationToken token )
+{
+    struct dispatcher_queue_timer *timer = impl_from_IDispatcherQueueTimer( iface );
+    struct timer_handler *entry, *found = NULL;
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    EnterCriticalSection( &timers_cs );
+    LIST_FOR_EACH_ENTRY( entry, &timer->handlers, struct timer_handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        found = entry;
+        break;
+    }
+    LeaveCriticalSection( &timers_cs );
+    if (found)
+    {
+        ITypedEventHandler_DispatcherQueueTimer_IInspectable_Release( found->handler );
+        free( found );
+    }
+    return S_OK;
+}
