+{
+    struct shutdown_action *action = impl_from_IAsyncAction( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IAsyncAction ))
+        *out = &action->IAsyncAction_iface;
+    else if (IsEqualGUID( iid, &IID_IAsyncInfo )) *out = &action->IAsyncInfo_iface;
+    else
+    {
+        FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IInspectable_AddRef( (IInspectable *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI shutdown_action_AddRef( IAsyncAction *iface )
+{
+    struct shutdown_action *action = impl_from_IAsyncAction( iface );
+    return InterlockedIncrement( &action->ref );
+}
+
+static ULONG WINAPI shutdown_action_Release( IAsyncAction *iface )
+{
+    struct shutdown_action *action = impl_from_IAsyncAction( iface );
+    ULONG ref = InterlockedDecrement( &action->ref );
+
+    if (!ref)
+    {
+        if (action->handler) IAsyncActionCompletedHandler_Release( action->handler );
+        action->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &action->cs );
+        free( action );
+    }
+    return ref;
+}
