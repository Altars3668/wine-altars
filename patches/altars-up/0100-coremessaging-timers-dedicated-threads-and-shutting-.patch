+static struct shutdown_action *shutdown_action_create(void)
+{
+    struct shutdown_action *action;
+
+    if (!(action = calloc( 1, sizeof(*action) ))) return NULL;
+    action->IAsyncAction_iface.lpVtbl = &shutdown_action_vtbl;
+    action->IAsyncInfo_iface.lpVtbl = &shutdown_info_vtbl;
+    action->ref = 1;
+    action->status = Started;
+    InitializeCriticalSectionEx( &action->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    action->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": shutdown_action.cs");
+    return action;
+}
+
+static void shutdown_action_complete( struct shutdown_action *action )
+{
+    IAsyncActionCompletedHandler *handler;
+
+    EnterCriticalSection( &action->cs );
+    if (action->status == Started) action->status = Completed;
+    if ((handler = action->handler)) IAsyncActionCompletedHandler_AddRef( handler );
+    LeaveCriticalSection( &action->cs );
+    if (handler)
+    {
+        IAsyncActionCompletedHandler_Invoke( handler, &action->IAsyncAction_iface, Completed );
+        IAsyncActionCompletedHandler_Release( handler );
+    }
+}
