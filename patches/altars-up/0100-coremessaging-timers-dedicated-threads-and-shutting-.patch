+/* the handlers of an event, as they are when it is raised */
+static IUnknown **handlers_snapshot( struct dispatcher_queue *queue, struct list *list, unsigned int *count )
+{
+    struct queue_handler *entry;
+    IUnknown **handlers;
+
+    *count = 0;
+    EnterCriticalSection( &queue->cs );
+    if ((handlers = calloc( list_count( list ) + 1, sizeof(*handlers) )))
+    {
+        LIST_FOR_EACH_ENTRY( entry, list, struct queue_handler, entry )
+        {
+            handlers[(*count)++] = entry->handler;
+            IUnknown_AddRef( entry->handler );
+        }
+    }
+    LeaveCriticalSection( &queue->cs );
+    return handlers;
+}
+
+/* on the queue's thread, once what was queued before the shutdown has run */
+static void queue_shutdown_start( struct dispatcher_queue *queue )
+{
+    struct shutdown_args *args;
+    unsigned int count, i;
+    IUnknown **handlers;
+
+    TRACE( "queue %p.\n", queue );
+
+    /* the handlers' deferrals, and one of the queue's own while it calls them */
+    InterlockedIncrement( &queue->deferrals );
+    if ((args = calloc( 1, sizeof(*args) )))
+    {
+        args->IDispatcherQueueShutdownStartingEventArgs_iface.lpVtbl = &shutdown_args_vtbl;
+        args->ref = 1;
+        args->queue = queue;
+        IDispatcherQueue_AddRef( &queue->IDispatcherQueue_iface );
+        handlers = handlers_snapshot( queue, &queue->starting_handlers, &count );
+        for (i = 0; i < count; i++)
+        {
+            ITypedEventHandler_DispatcherQueue_DispatcherQueueShutdownStartingEventArgs_Invoke(
+                    (ITypedEventHandler_DispatcherQueue_DispatcherQueueShutdownStartingEventArgs *)handlers[i],
+                    &queue->IDispatcherQueue_iface, &args->IDispatcherQueueShutdownStartingEventArgs_iface );
+            IUnknown_Release( handlers[i] );
+        }
+        free( handlers );
+        IDispatcherQueueShutdownStartingEventArgs_Release( &args->IDispatcherQueueShutdownStartingEventArgs_iface );
+    }
+    if (!InterlockedDecrement( &queue->deferrals )) queue_shutdown_finish( queue );
+}
+
+/* nothing more is queued; the operation completes, and ShutdownCompleted is raised */
+static void queue_shutdown_finish( struct dispatcher_queue *queue )
+{
+    struct shutdown_action *action;
+    unsigned int count, i;
+    IUnknown **handlers;
+
+    TRACE( "queue %p.\n", queue );
+
+    EnterCriticalSection( &queue->cs );
+    queue->shut_down = TRUE;
+    action = queue->shutdown;
+    LeaveCriticalSection( &queue->cs );
+
+    if (action) shutdown_action_complete( action );
+    handlers = handlers_snapshot( queue, &queue->completed_handlers, &count );
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_DispatcherQueue_IInspectable_Invoke( (ITypedEventHandler_DispatcherQueue_IInspectable *)handlers[i],
+                                                                &queue->IDispatcherQueue_iface, NULL );
+        IUnknown_Release( handlers[i] );
+    }
+    free( handlers );
+
+    /* a thread of the queue's own has nothing more to do */
+    if (queue->dedicated) PostQuitMessage( 0 );
+}
+
+/* ShutdownQueueAsync: the operation of the one shutdown there is */
+HRESULT dispatcher_queue_shutdown( IDispatcherQueue *iface, IAsyncAction **operation )
+{
+    struct dispatcher_queue *queue = impl_from_IDispatcherQueue( iface );
+    struct shutdown_action *action;
+    BOOL start = FALSE;
+
+    EnterCriticalSection( &queue->cs );
+    if (!(action = queue->shutdown))
+    {
+        if (!(action = queue->shutdown = shutdown_action_create()))
+        {
+            LeaveCriticalSection( &queue->cs );
+            return E_OUTOFMEMORY;
+        }
+        start = TRUE;
+    }
+    IAsyncAction_AddRef( &action->IAsyncAction_iface );
+    LeaveCriticalSection( &queue->cs );
+
+    if (start && !PostMessageW( queue->hwnd, WM_DISPATCHER_QUEUE_SHUTDOWN, 0, (LPARAM)queue ))
+    {
+        WARN( "queue %p has no window to shut down.\n", queue );
+        queue_shutdown_finish( queue );
+    }
+    *operation = &action->IAsyncAction_iface;
+    return S_OK;
+}
