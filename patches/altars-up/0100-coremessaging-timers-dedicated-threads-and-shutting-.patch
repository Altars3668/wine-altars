+static HRESULT dispatcher_queue_controller_create( DISPATCHERQUEUE_THREAD_TYPE thread_type,
+                                                   DISPATCHERQUEUE_THREAD_APARTMENTTYPE apartment_type,
+                                                   IDispatcherQueueController **out )
+{
+    struct dispatcher_queue_controller *impl;
+    struct dedicated_thread params;
+    HANDLE thread;
+    HRESULT hr;
 
+    if (!(impl = calloc( 1, sizeof( *impl ) ))) return E_OUTOFMEMORY;
     impl->IDispatcherQueueController_iface.lpVtbl = &dispatcher_queue_controller_vtbl;
     impl->ref = 1;
 
-    if (FAILED(hr = dispatcher_queue_create_for_current_thread( &impl->queue )))
+    if (thread_type == DQTYPE_THREAD_CURRENT)
+        hr = dispatcher_queue_create_for_current_thread( FALSE, &impl->queue );
+    else
+    {
+        params.apartment_type = apartment_type;
+        params.ready = CreateEventW( NULL, TRUE, FALSE, NULL );
+        params.queue = NULL;
+        params.hr = E_FAIL;
+        if (!(thread = CreateThread( NULL, 0, dedicated_thread_proc, &params, 0, NULL )))
+            hr = HRESULT_FROM_WIN32( GetLastError() );
+        else
+        {
+            WaitForSingleObject( params.ready, INFINITE );
+            CloseHandle( thread );
+            impl->queue = params.queue;
+            hr = params.hr;
+        }
+        CloseHandle( params.ready );
+    }
+    if (FAILED(hr))
     {
         free( impl );
