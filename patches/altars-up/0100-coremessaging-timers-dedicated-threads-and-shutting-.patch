+    handler.stop = FALSE;
+
+    hr = IDispatcherQueueTimer_remove_Tick( timer, token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDispatcherQueueTimer_remove_Tick( timer, token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
