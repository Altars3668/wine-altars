+
+static HRESULT WINAPI shutdown_action_put_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler *handler )
+{
+    struct shutdown_action *action = impl_from_IAsyncAction( iface );
+    AsyncStatus status;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    EnterCriticalSection( &action->cs );
+    if (action->status == Closed)
+    {
+        LeaveCriticalSection( &action->cs );
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if (action->handler_set)
+    {
+        LeaveCriticalSection( &action->cs );
+        return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    }
+    action->handler_set = TRUE;
+    if ((action->handler = handler)) IAsyncActionCompletedHandler_AddRef( handler );
+    status = action->status;
+    LeaveCriticalSection( &action->cs );
+
+    /* a handler set once it has completed is called at once */
+    if (handler && status != Started) IAsyncActionCompletedHandler_Invoke( handler, iface, status );
+    return S_OK;
+}
+
+static HRESULT WINAPI shutdown_action_get_Completed( IAsyncAction *iface, IAsyncActionCompletedHandler **handler )
+{
+    struct shutdown_action *action = impl_from_IAsyncAction( iface );
+    HRESULT hr = S_OK;
+
+    TRACE( "iface %p, handler %p.\n", iface, handler );
+
+    if (!handler) return E_POINTER;
+    EnterCriticalSection( &action->cs );
+    if (action->status == Closed) hr = E_ILLEGAL_METHOD_CALL;
+    else if ((*handler = action->handler)) IAsyncActionCompletedHandler_AddRef( *handler );
+    LeaveCriticalSection( &action->cs );
+    return hr;
+}
+
+static HRESULT WINAPI shutdown_action_GetResults( IAsyncAction *iface )
+{
+    struct shutdown_action *action = impl_from_IAsyncAction( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &action->cs );
+    hr = action->status == Completed ? S_OK : E_ILLEGAL_METHOD_CALL;
+    LeaveCriticalSection( &action->cs );
+    return hr;
+}
