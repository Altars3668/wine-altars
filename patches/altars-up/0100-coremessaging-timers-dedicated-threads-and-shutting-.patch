+struct tick_handler
+{
+    ITypedEventHandler_DispatcherQueueTimer_IInspectable ITypedEventHandler_DispatcherQueueTimer_IInspectable_iface;
+    LONG ref;
+    LONG ticks;
+    boolean running;            /* what IsRunning said during the last tick */
+    BOOL stop;                  /* stop the timer from its tick */
+    DWORD thread_id;
+};
+
+static struct tick_handler *impl_from_ITypedEventHandler_DispatcherQueueTimer_IInspectable( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface )
+{
+    return CONTAINING_RECORD( iface, struct tick_handler, ITypedEventHandler_DispatcherQueueTimer_IInspectable_iface );
+}
+
+static HRESULT WINAPI tick_handler_QueryInterface( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_ITypedEventHandler_DispatcherQueueTimer_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IUnknown ))
+    {
+        *out = iface;
+        ITypedEventHandler_DispatcherQueueTimer_IInspectable_AddRef( iface );
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI tick_handler_AddRef( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface )
+{
+    struct tick_handler *handler = impl_from_ITypedEventHandler_DispatcherQueueTimer_IInspectable( iface );
+    return InterlockedIncrement( &handler->ref );
+}
+
+static ULONG WINAPI tick_handler_Release( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface )
+{
+    struct tick_handler *handler = impl_from_ITypedEventHandler_DispatcherQueueTimer_IInspectable( iface );
+    return InterlockedDecrement( &handler->ref );
+}
+
+static HRESULT WINAPI tick_handler_Invoke( ITypedEventHandler_DispatcherQueueTimer_IInspectable *iface,
+                                           IDispatcherQueueTimer *timer, IInspectable *args )
+{
+    struct tick_handler *handler = impl_from_ITypedEventHandler_DispatcherQueueTimer_IInspectable( iface );
+
+    ok( !args, "got args %p.\n", args );
+    ok( GetCurrentThreadId() == handler->thread_id, "ticked on thread %#lx.\n", GetCurrentThreadId() );
+    handler->ticks++;
+    handler->running = 2;
+    IDispatcherQueueTimer_get_IsRunning( timer, &handler->running );
+    if (handler->stop) IDispatcherQueueTimer_Stop( timer );
+    return S_OK;
+}
+
+static const ITypedEventHandler_DispatcherQueueTimer_IInspectableVtbl tick_handler_vtbl =
+{
+    tick_handler_QueryInterface,
+    tick_handler_AddRef,
+    tick_handler_Release,
+    tick_handler_Invoke,
+};
+
+static void test_DispatcherQueueTimer(void)
+{
+    struct tick_handler handler = {{&tick_handler_vtbl}, 1};
+    IDispatcherQueueController *controller = NULL;
+    struct DispatcherQueueOptions options = {sizeof(options), DQTYPE_THREAD_CURRENT, DQTAT_COM_NONE};
+    IDispatcherQueueTimer *timer, *timer2;
+    IDispatcherQueue *queue;
+    EventRegistrationToken token, token2;
+    IInspectable *inspectable;
+    TimeSpan interval;
+    HSTRING name;
+    boolean value;
