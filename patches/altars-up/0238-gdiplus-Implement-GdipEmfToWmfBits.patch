From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 21:18:15 -0400
Subject: [PATCH] gdiplus: Implement GdipEmfToWmfBits().

PowerPoint exports a slide as WMF by rendering it to an EMF and calling
GdipEmfToWmfBits(emf, 0, NULL, MM_ANISOTROPIC, 0) for the size, then
for the bits.  The stub returned NotImplemented, which as a size is 6,
and PowerPoint wrote no file and reported no error.

Measured on Windows 11 build 29671 (tools/emftowmfprobe in the outer
repository): the result is what GetWinMetaFileBits() gives for the same
metafile -- the GDI records, the EMF+ ones left out -- without the
MFCOMMENT escapes carrying the EMF unless EmfToWmfBitsFlagsEmbedEmf is
given, and after a 22-byte placeable header, bounds in 1/48 inch, when
EmfToWmfBitsFlagsIncludePlaceable is; a buffer too small gives 0.  For a
GDI metafile the records and sizes now match Windows with every flag.
The function returns a size, so it is declared UINT, as in the SDK.

Windows derives the placeable bounds from the reference device and can
differ from these by one.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 94ff49cf47c69bc6eb401c82efd30dbd827c3322)

diff --git a/dlls/gdiplus/metafile.c b/dlls/gdiplus/metafile.c
index cc8a2a333a4..feb2735a7f0 100644
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -4467,11 +4467,100 @@ GpStatus WINGDIPAPI GdipConvertToEmfPlus(const GpGraphics* ref,
     return NotImplemented;
 }
 
-GpStatus WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE hemf, UINT cbData16,
+/* The records GetWinMetaFileBits() writes, without the comments that carry the metafile itself unless asked for,
+ * and after a placeable header if asked for.  Like Windows, this converts the GDI records of the metafile and leaves
+ * EMF+ records out; the result is its size, or 0 when that does not fit. */
+UINT WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE hemf, UINT cbData16,
     LPBYTE pData16, INT iMapMode, INT eFlags)
 {
-    FIXME("(%p, %d, %p, %d, %d): stub\n", hemf, cbData16, pData16, iMapMode, eFlags);
-    return NotImplemented;
+    static const DWORD placeable_key = 0x9ac6cdd7;
+    ENHMETAHEADER header;
+    METAHEADER *mh;
+    BYTE *bits, *src, *dst, *end;
+    UINT size, total, max_record = 0;
+    HDC hdc;
+
+    TRACE("(%p, %d, %p, %d, %#x)\n", hemf, cbData16, pData16, iMapMode, eFlags);
+
+    if (!hemf || !GetEnhMetaFileHeader(hemf, sizeof(header), &header))
+        return 0;
+
+    hdc = GetDC(0);
+    size = GetWinMetaFileBits(hemf, 0, NULL, iMapMode, hdc);
+    if (!size || !(bits = malloc(size)))
+    {
+        ReleaseDC(0, hdc);
+        return 0;
+    }
+    size = GetWinMetaFileBits(hemf, size, bits, iMapMode, hdc);
+    ReleaseDC(0, hdc);
+    if (size < sizeof(*mh))
+    {
+        free(bits);
+        return 0;
+    }
+
+    /* drop the MFCOMMENT escapes GetWinMetaFileBits() carries the EMF in */
+    mh = (METAHEADER *)bits;
+    src = dst = bits + mh->mtHeaderSize * 2;
+    end = bits + size;
+    while (end - src >= 6)
+    {
+        DWORD words = *(DWORD *)src;
+        WORD function = *(WORD *)(src + 4);
+
+        if (words < 3 || words * 2 > end - src)
+            break;
+        if (!(eFlags & EmfToWmfBitsFlagsEmbedEmf) && function == META_ESCAPE && words >= 7
+                && *(WORD *)(src + 6) == MFCOMMENT && *(DWORD *)(src + 10) == 0x43464d57 /* WMFC */)
+        {
+            src += words * 2;
+            continue;
+        }
+        memmove(dst, src, words * 2);
+        max_record = max(max_record, words);
+        dst += words * 2;
+        src += words * 2;
+    }
+    size = dst - bits;
+    mh->mtSize = size / 2;
+    mh->mtMaxRecord = max_record;
+
+    total = size;
+    if (eFlags & EmfToWmfBitsFlagsIncludePlaceable)
+        total += 22;
+    if (pData16)
+    {
+        if (cbData16 < total)
+        {
+            free(bits);
+            return 0;
+        }
+        dst = pData16;
+        if (eFlags & EmfToWmfBitsFlagsIncludePlaceable)
+        {
+            /* the frame, in 1/48 of an inch */
+            WORD placeable[11], checksum = 0;
+            unsigned int i;
+
+            memcpy(placeable, &placeable_key, sizeof(placeable_key));
+            placeable[2] = 0;
+            placeable[3] = header.rclFrame.left * 48 / 2540;
+            placeable[4] = header.rclFrame.top * 48 / 2540;
+            placeable[5] = header.rclFrame.right * 48 / 2540;
+            placeable[6] = header.rclFrame.bottom * 48 / 2540;
+            placeable[7] = 48;
+            placeable[8] = placeable[9] = 0;
+            for (i = 0; i < 10; i++)
+                checksum ^= placeable[i];
+            placeable[10] = checksum;
+            memcpy(dst, placeable, 22);
+            dst += 22;
+        }
+        memcpy(dst, bits, size);
+    }
+    free(bits);
+    return total;
 }
 
 GpStatus WINGDIPAPI GdipRecordMetafileFileName(GDIPCONST WCHAR* fileName,
diff --git a/dlls/gdiplus/tests/metafile.c b/dlls/gdiplus/tests/metafile.c
index 5dc2dd25bdc..5b3adad413e 100644
--- a/dlls/gdiplus/tests/metafile.c
+++ b/dlls/gdiplus/tests/metafile.c
@@ -4191,6 +4191,59 @@ static void test_pen(void)
     expect(Ok, stat);
 }
 
+/* GdipEmfToWmfBits() gives the records GetWinMetaFileBits() does, leaving out the comment carrying the EMF unless
+ * asked for it, after a placeable header if asked for one. */
+static void test_emftowmfbits(void)
+{
+    static const RECT frame = { 0, 0, 2000, 2000 };
+    UINT size, embed_size, placeable_size, gdi_size, words, i;
+    HDC hdc = GetDC(0), mfdc;
+    const METAHEADER *mh;
+    HENHMETAFILE emf;
+    const BYTE *p;
+    WORD checksum;
+    BYTE *data;
+
+    mfdc = CreateEnhMetaFileW(hdc, NULL, &frame, NULL);
+    Rectangle(mfdc, 10, 10, 60, 50);
+    emf = CloseEnhMetaFile(mfdc);
+
+    size = GdipEmfToWmfBits(emf, 0, NULL, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault);
+    embed_size = GdipEmfToWmfBits(emf, 0, NULL, MM_ANISOTROPIC, EmfToWmfBitsFlagsEmbedEmf);
+    placeable_size = GdipEmfToWmfBits(emf, 0, NULL, MM_ANISOTROPIC, EmfToWmfBitsFlagsIncludePlaceable);
+    gdi_size = GetWinMetaFileBits(emf, 0, NULL, MM_ANISOTROPIC, hdc);
+    ok(size > sizeof(METAHEADER), "got %u\n", size);
+    ok(embed_size == gdi_size, "got %u, GetWinMetaFileBits %u\n", embed_size, gdi_size);
+    ok(embed_size > size, "got %u, without the EMF %u\n", embed_size, size);
+    ok(placeable_size == size + 22, "got %u, without the header %u\n", placeable_size, size);
+
+    data = malloc(placeable_size);
+    ok(!GdipEmfToWmfBits(emf, size - 1, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault), "fits in a smaller buffer\n");
+    ok(GdipEmfToWmfBits(emf, size, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsDefault) == size, "wrong size\n");
+    mh = (const METAHEADER *)data;
+    ok(mh->mtSize * 2 == size, "header size %lu words, got %u bytes\n", mh->mtSize, size);
+    for (p = data + mh->mtHeaderSize * 2, i = 0; p < data + size; p += words * 2, i++)
+    {
+        words = *(const DWORD *)p;
+        if (words < 3) break;
+        ok(*(const WORD *)(p + 4) != META_ESCAPE, "record %u is an escape\n", i);
+    }
+
+    ok(GdipEmfToWmfBits(emf, placeable_size, data, MM_ANISOTROPIC, EmfToWmfBitsFlagsIncludePlaceable)
+            == placeable_size, "wrong size\n");
+    ok(*(const DWORD *)data == 0x9ac6cdd7, "got key %#lx\n", *(const DWORD *)data);
+    ok(*(const SHORT *)(data + 10) == 37 && *(const SHORT *)(data + 12) == 37, "got bounds %d,%d\n",
+            *(const SHORT *)(data + 10), *(const SHORT *)(data + 12));
+    ok(*(const WORD *)(data + 14) == 48, "got %u units an inch\n", *(const WORD *)(data + 14));
+    for (checksum = 0, i = 0; i < 10; i++)
+        checksum ^= ((const WORD *)data)[i];
+    ok(checksum == ((const WORD *)data)[10], "got checksum %#x, expected %#x\n", ((const WORD *)data)[10], checksum);
+
+    free(data);
+    DeleteEnhMetaFile(emf);
+    ReleaseDC(0, hdc);
+}
+
 START_TEST(metafile)
 {
     struct GdiplusStartupInput gdiplusStartupInput;
@@ -4225,6 +4278,7 @@ START_TEST(metafile)
     test_empty();
     test_getdc();
     test_emfonly();
+    test_emftowmfbits();
     test_fillrect();
     test_clear();
     test_nullframerect();
diff --git a/include/gdiplusenums.h b/include/gdiplusenums.h
index 522c82f67be..4f16c94abcb 100644
--- a/include/gdiplusenums.h
+++ b/include/gdiplusenums.h
@@ -234,6 +234,14 @@ enum EmfType
     EmfTypeEmfPlusDual = MetafileTypeEmfPlusDual
 };
 
+enum EmfToWmfBitsFlags
+{
+    EmfToWmfBitsFlagsDefault          = 0x00000000,
+    EmfToWmfBitsFlagsEmbedEmf         = 0x00000001,
+    EmfToWmfBitsFlagsIncludePlaceable = 0x00000002,
+    EmfToWmfBitsFlagsNoXORClip        = 0x00000004
+};
+
 enum CompositingMode
 {
     CompositingModeSourceOver,
@@ -775,6 +783,7 @@ typedef enum WrapMode WrapMode;
 typedef enum MetafileType MetafileType;
 typedef enum LinearGradientMode LinearGradientMode;
 typedef enum EmfType EmfType;
+typedef enum EmfToWmfBitsFlags EmfToWmfBitsFlags;
 typedef enum CompositingMode CompositingMode;
 typedef enum TextRenderingHint TextRenderingHint;
 typedef enum StringAlignment StringAlignment;
diff --git a/include/gdiplusflat.h b/include/gdiplusflat.h
index fa0638b6d30..46ac4aa35c1 100644
--- a/include/gdiplusflat.h
+++ b/include/gdiplusflat.h
@@ -400,7 +400,7 @@ GpStatus WINGDIPAPI GdipGetHatchStyle(GpHatch*,GpHatchStyle*);
 GpStatus WINGDIPAPI GdipCloneImage(GpImage*, GpImage**);
 GpStatus WINGDIPAPI GdipCloneImageAttributes(GDIPCONST GpImageAttributes*,GpImageAttributes**);
 GpStatus WINGDIPAPI GdipDisposeImage(GpImage*);
-GpStatus WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE,UINT,LPBYTE,INT,INT);
+UINT WINGDIPAPI GdipEmfToWmfBits(HENHMETAFILE,UINT,LPBYTE,INT,INT);
 GpStatus WINGDIPAPI GdipFindFirstImageItem(GpImage*,ImageItemData*);
 GpStatus WINGDIPAPI GdipFindNextImageItem(GpImage*,ImageItemData*);
 GpStatus WINGDIPAPI GdipGetAllPropertyItems(GpImage*,UINT,UINT,PropertyItem*);
