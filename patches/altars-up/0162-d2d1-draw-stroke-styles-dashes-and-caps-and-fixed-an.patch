+/* The values follow from the documentation: dashes are in stroke widths, a square cap goes half a width on, a
+ * round one is a circle of half a width. */
+static void test_stroke_styles(BOOL d3d11)
+{
+    static const float custom_dashes[] = {1.0f, 3.0f};
+    static const struct
+    {
+        D2D1_POINT_2F p0, p1;
+        float width;
+        D2D1_STROKE_STYLE_PROPERTIES1 desc;
+        const float *dashes;
+        unsigned int dash_count;
+        struct { unsigned int x, y; DWORD colour; } pixels[4];
+    }
+    tests[] =
+    {
+        /* eight on, eight off */
+        {{10.0f, 20.0f}, {110.0f, 20.0f}, 4.0f, {D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT,
+                D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_DASH, 0.0f}, NULL, 0,
+         {{14, 20, 0xffff0000}, {22, 20, 0xffffffff}, {30, 20, 0xffff0000}, {38, 20, 0xffffffff}}},
+        /* a width into the pattern */
+        {{10.0f, 20.0f}, {110.0f, 20.0f}, 4.0f, {D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT,
+                D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_DASH, 1.0f}, NULL, 0,
+         {{12, 20, 0xffff0000}, {18, 20, 0xffffffff}, {26, 20, 0xffff0000}, {34, 20, 0xffffffff}}},
+        /* four on, twelve off */
+        {{10.0f, 20.0f}, {110.0f, 20.0f}, 4.0f, {D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT,
+                D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_CUSTOM, 0.0f}, custom_dashes, 2,
+         {{12, 20, 0xffff0000}, {20, 20, 0xffffffff}, {28, 20, 0xffff0000}, {36, 20, 0xffffffff}}},
+        /* square caps two on at either end */
+        {{10.0f, 20.0f}, {50.0f, 20.0f}, 4.0f, {D2D1_CAP_STYLE_SQUARE, D2D1_CAP_STYLE_SQUARE, D2D1_CAP_STYLE_FLAT,
+                D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_SOLID, 0.0f}, NULL, 0,
+         {{8, 20, 0xffff0000}, {51, 20, 0xffff0000}, {6, 20, 0xffffffff}, {53, 20, 0xffffffff}}},
+        /* round caps, circles of five */
+        {{10.0f, 20.0f}, {50.0f, 20.0f}, 10.0f, {D2D1_CAP_STYLE_ROUND, D2D1_CAP_STYLE_ROUND, D2D1_CAP_STYLE_FLAT,
+                D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_SOLID, 0.0f}, NULL, 0,
+         {{6, 20, 0xffff0000}, {7, 17, 0xffff0000}, {5, 14, 0xffffffff}, {57, 20, 0xffffffff}}},
+        /* dots of no length, round, every eight */
+        {{10.0f, 20.0f}, {110.0f, 20.0f}, 4.0f, {D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_ROUND,
+                D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_DOT, 0.0f}, NULL, 0,
+         {{18, 20, 0xffff0000}, {26, 20, 0xffff0000}, {14, 20, 0xffffffff}, {22, 20, 0xffffffff}}},
+        /* a hairline is a pixel, whatever the width */
+        {{10.0f, 20.0f}, {110.0f, 20.0f}, 10.0f, {D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT, D2D1_CAP_STYLE_FLAT,
+                D2D1_LINE_JOIN_MITER, 10.0f, D2D1_DASH_STYLE_SOLID, 0.0f, D2D1_STROKE_TRANSFORM_TYPE_HAIRLINE}, NULL, 0,
+         {{30, 23, 0xffffffff}, {30, 16, 0xffffffff}, {60, 24, 0xffffffff}, {60, 15, 0xffffffff}}},
+    };
+    D2D1_STROKE_STYLE_PROPERTIES1 desc;
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    ID2D1StrokeStyle1 *style;
+    ID2D1SolidColorBrush *brush;
+    D2D1_COLOR_F red, white;
+    unsigned int i, j;
+    D2D1_RECT_F rect;
+    DWORD colour;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    if (!ctx.factory1)
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    set_color(&red, 1.0f, 0.0f, 0.0f, 1.0f);
+    set_color(&white, 1.0f, 1.0f, 1.0f, 1.0f);
+    hr = ID2D1DeviceContext_CreateSolidColorBrush(ctx.context, &red, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        winetest_push_context("Test %u", i);
+
+        hr = ID2D1Factory1_CreateStrokeStyle(ctx.factory1, &tests[i].desc, tests[i].dashes, tests[i].dash_count,
+                &style);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ID2D1DeviceContext_BeginDraw(ctx.context);
+        ID2D1DeviceContext_Clear(ctx.context, &white);
+        ID2D1DeviceContext_DrawLine(ctx.context, tests[i].p0, tests[i].p1, (ID2D1Brush *)brush, tests[i].width,
+                (ID2D1StrokeStyle *)style);
+        hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        get_surface_readback(&ctx, &rb);
+        for (j = 0; j < ARRAY_SIZE(tests[i].pixels); ++j)
+        {
+            colour = get_readback_colour(&rb, tests[i].pixels[j].x, tests[i].pixels[j].y);
+            ok(colour == tests[i].pixels[j].colour, "Got unexpected colour %#lx at (%u, %u).\n",
+                    colour, tests[i].pixels[j].x, tests[i].pixels[j].y);
+        }
+        release_resource_readback(&rb);
+        ID2D1StrokeStyle1_Release(style);
+
+        winetest_pop_context();
+    }
+
+    /* A closed figure is dashed all the way round. */
+    desc = tests[0].desc;
+    hr = ID2D1Factory1_CreateStrokeStyle(ctx.factory1, &desc, NULL, 0, &style);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_rect(&rect, 60.0f, 150.0f, 100.0f, 190.0f);
+    ID2D1DeviceContext_BeginDraw(ctx.context);
+    ID2D1DeviceContext_Clear(ctx.context, &white);
+    ID2D1DeviceContext_DrawRectangle(ctx.context, &rect, (ID2D1Brush *)brush, 2.0f, (ID2D1StrokeStyle *)style);
+    hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    check_effect_pixel(&ctx, 62, 150, 0xffff0000, 0);
+    check_effect_pixel(&ctx, 66, 150, 0xffffffff, 0);
+    check_effect_pixel(&ctx, 70, 150, 0xffff0000, 0);
+    ID2D1StrokeStyle1_Release(style);
+
+    ID2D1SolidColorBrush_Release(brush);
+    release_test_context(&ctx);
+}
