From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 15:36:39 -0400
Subject: [PATCH] d2d1: draw stroke styles' dashes and caps, and fixed and
 hairline widths

DrawGeometry ignored stroke styles: every stroke was solid with flat ends.
A styled stroke is now the geometry flattened as finely as it is drawn,
cut into the pieces its dashes keep (dash lengths and the offset in
multiples of the stroke width, an odd dash array gone through twice),
stroked with flat ends, and the caps filled: square caps draw a piece
half a width further, round caps are circles and triangle caps
triangles.  A fixed stroke keeps its width whatever the world transform,
a hairline is one pixel wide.

The tests were written against what the D2D documentation says and have
not been run on Windows.  Joins other than miter are still drawn as a
miter, and round and triangle caps are filled over the stroke, so a
translucent brush draws them twice.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 36fd8d0a216c46f7108d4e01ab14601f94d7dc53)

diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index a9661ede39b..9248ac4207b 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -443,6 +443,8 @@ struct d2d_stroke_style
 
 HRESULT d2d_stroke_style_init(struct d2d_stroke_style *style, ID2D1Factory *factory,
         const D2D1_STROKE_STYLE_PROPERTIES1 *desc, const float *dashes, UINT32 dash_count);
+HRESULT d2d_stroke_style_apply(const struct d2d_stroke_style *style, ID2D1Factory *factory, ID2D1Geometry *geometry,
+        float width, float tolerance, ID2D1PathGeometry **stroke, ID2D1PathGeometry **caps);
 struct d2d_stroke_style *unsafe_impl_from_ID2D1StrokeStyle(ID2D1StrokeStyle *iface);
 
 struct d2d_layer
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index ab1c85b3490..30351e1c692 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -1029,6 +1029,41 @@ static void d2d_device_context_draw_geometry(struct d2d_device_context *render_t
     }
 }
 
+static void d2d_device_context_fill_geometry(struct d2d_device_context *render_target,
+        const struct d2d_geometry *geometry, struct d2d_brush *brush, struct d2d_brush *opacity_brush);
+
+/* A stroke with dashes or caps is the pieces the dashes keep, stroked, and the caps, filled. */
+static void d2d_device_context_draw_styled_geometry(struct d2d_device_context *context, ID2D1Geometry *geometry,
+        struct d2d_brush *brush, float stroke_width, const struct d2d_stroke_style *style)
+{
+    const D2D1_MATRIX_3X2_F *m = &context->drawing_state.transform;
+    ID2D1PathGeometry *stroke, *caps;
+    float scale, tolerance;
+    HRESULT hr;
+
+    /* flattened as finely as it is drawn */
+    scale = sqrtf(fabsf(m->_11 * m->_22 - m->_12 * m->_21)) * context->desc.dpiX / 96.0f;
+    tolerance = scale > 0.0f ? D2D1_DEFAULT_FLATTENING_TOLERANCE / scale : D2D1_DEFAULT_FLATTENING_TOLERANCE;
+    if (FAILED(hr = d2d_stroke_style_apply(style, context->factory, geometry, stroke_width, tolerance,
+            &stroke, &caps)))
+    {
+        WARN("Failed to apply stroke style %p, hr %#lx.\n", style, hr);
+        return;
+    }
+    if (stroke)
+    {
+        d2d_device_context_draw_geometry(context, unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)stroke),
+                brush, stroke_width);
+        ID2D1PathGeometry_Release(stroke);
+    }
+    if (caps)
+    {
+        d2d_device_context_fill_geometry(context, unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)caps),
+                brush, NULL);
+        ID2D1PathGeometry_Release(caps);
+    }
+}
+
 static void STDMETHODCALLTYPE d2d_device_context_DrawGeometry(ID2D1DeviceContext6 *iface,
         ID2D1Geometry *geometry, ID2D1Brush *brush, float stroke_width, ID2D1StrokeStyle *stroke_style)
 {
@@ -1056,13 +1091,26 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawGeometry(ID2D1DeviceContext
         return;
     }
 
-    if (stroke_style)
-        FIXME("Ignoring stroke style %p.\n", stroke_style);
-
     if (stroke_style_impl)
     {
-        if (stroke_style_impl->desc.transformType == D2D1_STROKE_TRANSFORM_TYPE_FIXED)
-            stroke_width /= context->drawing_state.transform.m11;
+        const D2D1_MATRIX_3X2_F *m = &context->drawing_state.transform;
+        const D2D1_STROKE_STYLE_PROPERTIES1 *desc = &stroke_style_impl->desc;
+        float scale = sqrtf(fabsf(m->_11 * m->_22 - m->_12 * m->_21));
+
+        /* a fixed stroke is as wide whatever the world transform, a hairline is a pixel wide */
+        if (desc->transformType == D2D1_STROKE_TRANSFORM_TYPE_FIXED && scale > 0.0f)
+            stroke_width /= scale;
+        else if (desc->transformType == D2D1_STROKE_TRANSFORM_TYPE_HAIRLINE && scale > 0.0f)
+            stroke_width = 96.0f / context->desc.dpiX / scale;
+
+        if (desc->lineJoin != D2D1_LINE_JOIN_MITER && desc->lineJoin != D2D1_LINE_JOIN_MITER_OR_BEVEL)
+            FIXME("Line join %#x is drawn as a miter.\n", desc->lineJoin);
+        if (stroke_style_impl->dash_count || desc->startCap != D2D1_CAP_STYLE_FLAT
+                || desc->endCap != D2D1_CAP_STYLE_FLAT || desc->dashCap != D2D1_CAP_STYLE_FLAT)
+        {
+            d2d_device_context_draw_styled_geometry(context, geometry, brush_impl, stroke_width, stroke_style_impl);
+            return;
+        }
     }
 
     d2d_device_context_draw_geometry(context, geometry_impl, brush_impl, stroke_width);
