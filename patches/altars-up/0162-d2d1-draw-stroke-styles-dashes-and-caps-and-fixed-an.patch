     style->ID2D1StrokeStyle1_iface.lpVtbl = &d2d_stroke_style_vtbl;
     style->refcount = 1;
 
@@ -250,3 +247,460 @@ HRESULT d2d_stroke_style_init(struct d2d_stroke_style *style, ID2D1Factory *fact
 
     return S_OK;
 }
+
+/* The figures of a geometry as polylines, as Simplify hands them out. */
+struct d2d_polyline
+{
+    D2D1_POINT_2F *points;
+    size_t size;
+    size_t count;
+    BOOL closed;
+};
+
+struct d2d_flattener
+{
+    ID2D1SimplifiedGeometrySink ID2D1SimplifiedGeometrySink_iface;
+    struct d2d_polyline *lines;
+    size_t size;
+    size_t count;
+    HRESULT hr;
+};
+
+static inline struct d2d_flattener *impl_from_ID2D1SimplifiedGeometrySink(ID2D1SimplifiedGeometrySink *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_flattener, ID2D1SimplifiedGeometrySink_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_flattener_QueryInterface(ID2D1SimplifiedGeometrySink *iface,
+        REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_ID2D1SimplifiedGeometrySink) || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_flattener_AddRef(ID2D1SimplifiedGeometrySink *iface)
+{
+    return 2;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_flattener_Release(ID2D1SimplifiedGeometrySink *iface)
+{
+    return 1;
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_SetFillMode(ID2D1SimplifiedGeometrySink *iface, D2D1_FILL_MODE mode)
+{
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_SetSegmentFlags(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_PATH_SEGMENT flags)
+{
+}
+
+static void d2d_flattener_add_point(struct d2d_flattener *flattener, D2D1_POINT_2F point)
+{
+    struct d2d_polyline *line;
+
+    if (!flattener->count)
+        return;
+    line = &flattener->lines[flattener->count - 1];
+    if (!d2d_array_reserve((void **)&line->points, &line->size, line->count + 1, sizeof(*line->points)))
+    {
+        flattener->hr = E_OUTOFMEMORY;
+        return;
+    }
+    line->points[line->count++] = point;
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_BeginFigure(ID2D1SimplifiedGeometrySink *iface,
+        D2D1_POINT_2F start, D2D1_FIGURE_BEGIN begin)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+
+    if (!d2d_array_reserve((void **)&flattener->lines, &flattener->size, flattener->count + 1,
+            sizeof(*flattener->lines)))
+    {
+        flattener->hr = E_OUTOFMEMORY;
+        return;
+    }
+    memset(&flattener->lines[flattener->count++], 0, sizeof(*flattener->lines));
+    d2d_flattener_add_point(flattener, start);
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_AddLines(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_POINT_2F *points, UINT32 count)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+    UINT32 i;
+
+    for (i = 0; i < count; ++i)
+        d2d_flattener_add_point(flattener, points[i]);
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_AddBeziers(ID2D1SimplifiedGeometrySink *iface,
+        const D2D1_BEZIER_SEGMENT *beziers, UINT32 count)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+    UINT32 i;
+
+    /* not asked for; the ends are as near as it gets */
+    for (i = 0; i < count; ++i)
+        d2d_flattener_add_point(flattener, beziers[i].point3);
+}
+
+static void STDMETHODCALLTYPE d2d_flattener_EndFigure(ID2D1SimplifiedGeometrySink *iface, D2D1_FIGURE_END end)
+{
+    struct d2d_flattener *flattener = impl_from_ID2D1SimplifiedGeometrySink(iface);
+
+    if (flattener->count)
+        flattener->lines[flattener->count - 1].closed = end == D2D1_FIGURE_END_CLOSED;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_flattener_Close(ID2D1SimplifiedGeometrySink *iface)
+{
+    return S_OK;
+}
+
+static const struct ID2D1SimplifiedGeometrySinkVtbl d2d_flattener_vtbl =
+{
+    d2d_flattener_QueryInterface,
+    d2d_flattener_AddRef,
+    d2d_flattener_Release,
+    d2d_flattener_SetFillMode,
+    d2d_flattener_SetSegmentFlags,
+    d2d_flattener_BeginFigure,
+    d2d_flattener_AddLines,
+    d2d_flattener_AddBeziers,
+    d2d_flattener_EndFigure,
+    d2d_flattener_Close,
+};
+
+static void d2d_flattener_cleanup(struct d2d_flattener *flattener)
+{
+    size_t i;
+
+    for (i = 0; i < flattener->count; ++i)
+        free(flattener->lines[i].points);
+    free(flattener->lines);
+}
+
+/* What a stroke style makes of a geometry: the pieces its dashes keep, and the caps of their ends. */
+struct d2d_stroke_builder
+{
+    const struct d2d_stroke_style *style;
+    float width;
+    ID2D1GeometrySink *stroke;
+    ID2D1GeometrySink *caps;
+    unsigned int stroke_figures;
+    unsigned int cap_figures;
+    /* the piece being made */
+    D2D1_POINT_2F *points;
+    size_t points_size;
+    size_t point_count;
+    D2D1_POINT_2F start_tangent, end_tangent;
+    D2D1_CAP_STYLE start_cap;
+};
+
+static D2D1_POINT_2F d2d_point_along(D2D1_POINT_2F p, D2D1_POINT_2F direction, float distance)
+{
+    D2D1_POINT_2F r;
+
+    r.x = p.x + direction.x * distance;
+    r.y = p.y + direction.y * distance;
+    return r;
+}
+
+/* A cap that is not the stroke drawn further: a circle, or a triangle pointing along the tangent. */
+static void d2d_stroke_builder_add_cap(struct d2d_stroke_builder *builder, D2D1_POINT_2F p,
+        D2D1_POINT_2F tangent, D2D1_CAP_STYLE cap)
+{
+    float h = builder->width / 2.0f;
+    D2D1_POINT_2F normal, points[2];
+    D2D1_ARC_SEGMENT arc;
+
+    normal.x = -tangent.y;
+    normal.y = tangent.x;
+    if (cap == D2D1_CAP_STYLE_ROUND)
+    {
+        ID2D1GeometrySink_BeginFigure(builder->caps, d2d_point_along(p, normal, h), D2D1_FIGURE_BEGIN_FILLED);
+        arc.size.width = arc.size.height = h;
+        arc.rotationAngle = 0.0f;
+        arc.sweepDirection = D2D1_SWEEP_DIRECTION_CLOCKWISE;
+        arc.arcSize = D2D1_ARC_SIZE_SMALL;
+        arc.point = d2d_point_along(p, normal, -h);
+        ID2D1GeometrySink_AddArc(builder->caps, &arc);
+        arc.point = d2d_point_along(p, normal, h);
+        ID2D1GeometrySink_AddArc(builder->caps, &arc);
+        ID2D1GeometrySink_EndFigure(builder->caps, D2D1_FIGURE_END_CLOSED);
+        ++builder->cap_figures;
+    }
+    else if (cap == D2D1_CAP_STYLE_TRIANGLE)
+    {
+        ID2D1GeometrySink_BeginFigure(builder->caps, d2d_point_along(p, normal, h), D2D1_FIGURE_BEGIN_FILLED);
+        points[0] = d2d_point_along(p, tangent, h);
+        points[1] = d2d_point_along(p, normal, -h);
+        ID2D1GeometrySink_AddLines(builder->caps, points, 2);
+        ID2D1GeometrySink_EndFigure(builder->caps, D2D1_FIGURE_END_CLOSED);
+        ++builder->cap_figures;
+    }
+}
+
+static void d2d_stroke_builder_point(struct d2d_stroke_builder *builder, D2D1_POINT_2F p)
+{
+    if (builder->point_count && builder->points[builder->point_count - 1].x == p.x
+            && builder->points[builder->point_count - 1].y == p.y)
+        return;
+    if (!d2d_array_reserve((void **)&builder->points, &builder->points_size, builder->point_count + 1,
+            sizeof(*builder->points)))
+        return;
+    builder->points[builder->point_count++] = p;
+}
+
+static void d2d_stroke_builder_begin(struct d2d_stroke_builder *builder, D2D1_POINT_2F p, D2D1_POINT_2F tangent,
+        D2D1_CAP_STYLE cap)
+{
+    builder->point_count = 0;
+    builder->start_tangent = builder->end_tangent = tangent;
+    builder->start_cap = cap;
+    d2d_stroke_builder_point(builder, p);
+}
+
+/* A piece ends: square caps draw it further, others are shapes of their own; one of no length is only its caps. */
+static void d2d_stroke_builder_end(struct d2d_stroke_builder *builder, D2D1_POINT_2F tangent, D2D1_CAP_STYLE cap)
+{
+    D2D1_POINT_2F start = builder->points[0], end;
+    float h = builder->width / 2.0f;
+
+    builder->end_tangent = tangent;
+    end = builder->points[builder->point_count - 1];
+    if (builder->start_cap == D2D1_CAP_STYLE_SQUARE)
+        builder->points[0] = d2d_point_along(start, builder->start_tangent, -h);
+    if (cap == D2D1_CAP_STYLE_SQUARE)
+    {
+        if (builder->point_count == 1)
+            d2d_stroke_builder_point(builder, d2d_point_along(end, tangent, h));
+        else
+            builder->points[builder->point_count - 1] = d2d_point_along(end, tangent, h);
+    }
+
+    if (builder->point_count > 1)
+    {
+        ID2D1GeometrySink_BeginFigure(builder->stroke, builder->points[0], D2D1_FIGURE_BEGIN_HOLLOW);
+        ID2D1GeometrySink_AddLines(builder->stroke, builder->points + 1, builder->point_count - 1);
+        ID2D1GeometrySink_EndFigure(builder->stroke, D2D1_FIGURE_END_OPEN);
+        ++builder->stroke_figures;
+    }
+    /* a dot with round caps is one circle; the same figure twice over is no shape a fill takes well */
+    if (builder->start_cap != D2D1_CAP_STYLE_SQUARE && builder->start_cap != D2D1_CAP_STYLE_FLAT
+            && !(builder->start_cap == D2D1_CAP_STYLE_ROUND && cap == D2D1_CAP_STYLE_ROUND
+            && start.x == end.x && start.y == end.y))
+    {
+        D2D1_POINT_2F back = {-builder->start_tangent.x, -builder->start_tangent.y};
+        d2d_stroke_builder_add_cap(builder, start, back, builder->start_cap);
+    }
+    if (cap != D2D1_CAP_STYLE_SQUARE && cap != D2D1_CAP_STYLE_FLAT)
+        d2d_stroke_builder_add_cap(builder, end, tangent, cap);
+    builder->point_count = 0;
+}
+
+static D2D1_POINT_2F d2d_direction(D2D1_POINT_2F a, D2D1_POINT_2F b, float *length)
+{
+    D2D1_POINT_2F d = {b.x - a.x, b.y - a.y};
+
+    if ((*length = sqrtf(d.x * d.x + d.y * d.y)) > 0.0f)
+    {
+        d.x /= *length;
+        d.y /= *length;
+    }
+    return d;
+}
+
+/* The length of dash k of a pattern; an odd number of dashes is gone through twice, so the dashes and gaps take
+ * turns. */
+static float d2d_dash_length(const struct d2d_stroke_builder *builder, unsigned int k)
+{
+    return max(builder->style->dashes[k % builder->style->dash_count], 0.0f) * builder->width;
+}
+
+/* One figure, dashed from the start of it; the dash offset is where in the pattern that is.  A dash or a gap of no
+ * length takes no room: a dash of none is only its caps. */
+static void d2d_stroke_builder_dash(struct d2d_stroke_builder *builder, const struct d2d_polyline *line)
+{
+    const D2D1_STROKE_STYLE_PROPERTIES1 *desc = &builder->style->desc;
+    unsigned int k = 0, n = builder->style->dash_count, i, count = line->count;
+    float pattern = 0.0f, offset, left, length, used;
+    D2D1_POINT_2F a, b, dir = {1.0f, 0.0f}, p;
+    BOOL started = FALSE;
+
+    if (n & 1)
+        n *= 2;
+    for (i = 0; i < n; ++i)
+        pattern += d2d_dash_length(builder, i);
+    if (count < 2 || pattern <= 0.0f)
+        return;
+    if (line->closed && (line->points[0].x != line->points[count - 1].x
+            || line->points[0].y != line->points[count - 1].y))
+        ++count;
+
+    /* where in the pattern the figure starts */
+    offset = fmodf(desc->dashOffset * builder->width, pattern);
+    if (offset < 0.0f)
+        offset += pattern;
+    while (offset >= d2d_dash_length(builder, k) && offset > 0.0f)
+    {
+        offset -= d2d_dash_length(builder, k);
+        k = (k + 1) % n;
+    }
+    left = d2d_dash_length(builder, k) - offset;
+
+    for (i = 1; i < count; ++i)
+    {
+        a = line->points[i - 1];
+        b = line->points[i < line->count ? i : 0];
+        dir = d2d_direction(a, b, &length);
+        if (!(k & 1) && !started)
+        {
+            d2d_stroke_builder_begin(builder, a, dir, line->closed ? desc->dashCap : desc->startCap);
+            started = TRUE;
+        }
+        used = 0.0f;
+        while (length - used >= left)
+        {
+            used += left;
+            p = d2d_point_along(a, dir, used);
+            if (started)
+            {
+                d2d_stroke_builder_point(builder, p);
+                d2d_stroke_builder_end(builder, dir, desc->dashCap);
+                started = FALSE;
+            }
+            k = (k + 1) % n;
+            left = d2d_dash_length(builder, k);
+            if (!(k & 1))
+            {
+                d2d_stroke_builder_begin(builder, p, dir, desc->dashCap);
+                started = TRUE;
+            }
+        }
+        left -= length - used;
+        if (started)
+            d2d_stroke_builder_point(builder, b);
+    }
+    if (started)
+        d2d_stroke_builder_end(builder, dir, line->closed ? desc->dashCap : desc->endCap);
+}
+
+/* A figure without dashes: only an open one has caps. */
+static void d2d_stroke_builder_solid(struct d2d_stroke_builder *builder, const struct d2d_polyline *line)
+{
+    const D2D1_STROKE_STYLE_PROPERTIES1 *desc = &builder->style->desc;
+    D2D1_POINT_2F start_dir, end_dir;
+    float length;
+    size_t i;
+
+    if (!line->count)
+        return;
+    if (line->closed)
+    {
+        if (line->count < 2)
+            return;
+        ID2D1GeometrySink_BeginFigure(builder->stroke, line->points[0], D2D1_FIGURE_BEGIN_HOLLOW);
+        ID2D1GeometrySink_AddLines(builder->stroke, line->points + 1, line->count - 1);
+        ID2D1GeometrySink_EndFigure(builder->stroke, D2D1_FIGURE_END_CLOSED);
+        ++builder->stroke_figures;
+        return;
+    }
+
+    start_dir.x = 1.0f;
+    start_dir.y = 0.0f;
+    for (i = 1; i < line->count; ++i)
+    {
+        start_dir = d2d_direction(line->points[0], line->points[i], &length);
+        if (length > 0.0f)
+            break;
+    }
+    end_dir = start_dir;
+    for (i = line->count - 1; i > 0; --i)
+    {
+        end_dir = d2d_direction(line->points[i - 1], line->points[line->count - 1], &length);
+        if (length > 0.0f)
+            break;
+    }
+    d2d_stroke_builder_begin(builder, line->points[0], start_dir, desc->startCap);
+    for (i = 1; i < line->count; ++i)
+        d2d_stroke_builder_point(builder, line->points[i]);
+    d2d_stroke_builder_end(builder, end_dir, desc->endCap);
+}
+
+static HRESULT d2d_open_path(ID2D1Factory *factory, ID2D1PathGeometry **path, ID2D1GeometrySink **sink)
+{
+    HRESULT hr;
+
+    if (FAILED(hr = ID2D1Factory_CreatePathGeometry(factory, path)))
+        return hr;
+    if (FAILED(hr = ID2D1PathGeometry_Open(*path, sink)))
+    {
+        ID2D1PathGeometry_Release(*path);
+        *path = NULL;
+    }
+    return hr;
+}
+
+/*
+ * What a stroke of a geometry comes to with a style's dashes and caps: the pieces the dashes keep, to be stroked
+ * with flat ends, and the caps that are not the stroke drawn further, to be filled.  The geometry is flattened to
+ * within tolerance first.  Either result may be NULL.
+ */
+HRESULT d2d_stroke_style_apply(const struct d2d_stroke_style *style, ID2D1Factory *factory, ID2D1Geometry *geometry,
+        float width, float tolerance, ID2D1PathGeometry **stroke, ID2D1PathGeometry **caps)
+{
+    struct d2d_flattener flattener = {{&d2d_flattener_vtbl}};
+    struct d2d_stroke_builder builder = {style, width};
+    ID2D1PathGeometry *stroke_path = NULL, *caps_path = NULL;
+    HRESULT hr;
+    size_t i;
+
+    *stroke = *caps = NULL;
+    if (FAILED(hr = ID2D1Geometry_Simplify(geometry, D2D1_GEOMETRY_SIMPLIFICATION_OPTION_LINES, NULL, tolerance,
+            &flattener.ID2D1SimplifiedGeometrySink_iface)) || FAILED(hr = flattener.hr))
+        goto done;
+
+    if (FAILED(hr = d2d_open_path(factory, &stroke_path, &builder.stroke))
+            || FAILED(hr = d2d_open_path(factory, &caps_path, &builder.caps)))
+        goto done;
+    ID2D1GeometrySink_SetFillMode(builder.caps, D2D1_FILL_MODE_WINDING);
+
+    for (i = 0; i < flattener.count; ++i)
+    {
+        if (style->dash_count)
+            d2d_stroke_builder_dash(&builder, &flattener.lines[i]);
+        else
+            d2d_stroke_builder_solid(&builder, &flattener.lines[i]);
+    }
+
+    if (SUCCEEDED(hr = ID2D1GeometrySink_Close(builder.stroke)) && SUCCEEDED(hr = ID2D1GeometrySink_Close(builder.caps)))
+    {
+        if (builder.stroke_figures)
+            ID2D1PathGeometry_AddRef(*stroke = stroke_path);
+        if (builder.cap_figures)
+            ID2D1PathGeometry_AddRef(*caps = caps_path);
+    }
+
+done:
+    if (builder.stroke)
+        ID2D1GeometrySink_Release(builder.stroke);
+    if (builder.caps)
+        ID2D1GeometrySink_Release(builder.caps);
+    if (stroke_path)
+        ID2D1PathGeometry_Release(stroke_path);
+    if (caps_path)
+        ID2D1PathGeometry_Release(caps_path);
+    free(builder.points);
+    d2d_flattener_cleanup(&flattener);
+    return hr;
+}
