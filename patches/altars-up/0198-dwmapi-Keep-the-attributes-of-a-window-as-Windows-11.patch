From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 01:41:38 -0400
Subject: [PATCH] dwmapi: Keep the attributes of a window as Windows 11 does.

DwmSetWindowAttribute took everything and kept nothing, and
DwmGetWindowAttribute knew only the extended frame bounds.  A window now
keeps what is written to it, and each attribute answers as on Windows
11: the ones only read or only written, booleans read back as such, the
corner preferences and system backdrops there are, colours of the size
of one and text never without, cloaking seen as the application's,
child windows with hardly any attribute, and the caption buttons where
the window's style puts them.

The corner preference is what Office asks for to choose its frame.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 5d52423ebc371cc31a358e4783b8a78f0dbddc93)

diff --git a/dlls/dwmapi/dwmapi_main.c b/dlls/dwmapi/dwmapi_main.c
index 49e05cd207e..417a4e634e9 100644
--- a/dlls/dwmapi/dwmapi_main.c
+++ b/dlls/dwmapi/dwmapi_main.c
@@ -98,12 +98,102 @@ HRESULT WINAPI DwmInvalidateIconicBitmaps(HWND hwnd)
 /**********************************************************************
  *           DwmSetWindowAttribute         (DWMAPI.@)
  */
-HRESULT WINAPI DwmSetWindowAttribute(HWND hwnd, DWORD attributenum, LPCVOID attribute, DWORD size)
+/* What each window attribute is, as Windows 11 answers for it. */
+enum attribute_kind
 {
-    static BOOL once;
+    ATTRIBUTE_NONE,     /* neither read nor written */
+    ATTRIBUTE_READ,     /* read only */
+    ATTRIBUTE_WRITE,    /* written only, and kept */
+    ATTRIBUTE_BOOL,     /* written, and read back as 0 or 1 */
+    ATTRIBUTE_VALUE,    /* written, and read back as it was */
+    ATTRIBUTE_RECT,     /* a rectangle, read only */
+};
+
+static const struct
+{
+    BYTE kind;
+    BYTE exact;         /* its value is exactly a DWORD */
+    BYTE refused;       /* written, it is refused before the window is looked at */
+    BYTE child;         /* a child window has it too */
+}
+attributes[] =
+{
+    [DWMWA_NCRENDERING_ENABLED]            = { ATTRIBUTE_READ },
+    [DWMWA_NCRENDERING_POLICY]             = { ATTRIBUTE_WRITE },
+    [DWMWA_TRANSITIONS_FORCEDISABLED]      = { ATTRIBUTE_WRITE },
+    [DWMWA_ALLOW_NCPAINT]                  = { ATTRIBUTE_WRITE },
+    [DWMWA_CAPTION_BUTTON_BOUNDS]          = { ATTRIBUTE_RECT },
+    [DWMWA_NONCLIENT_RTL_LAYOUT]           = { ATTRIBUTE_WRITE },
+    [DWMWA_FORCE_ICONIC_REPRESENTATION]    = { ATTRIBUTE_WRITE },
+    [DWMWA_EXTENDED_FRAME_BOUNDS]          = { ATTRIBUTE_RECT },
+    [DWMWA_HAS_ICONIC_BITMAP]              = { ATTRIBUTE_WRITE },
+    [DWMWA_DISALLOW_PEEK]                  = { ATTRIBUTE_WRITE },
+    [DWMWA_EXCLUDED_FROM_PEEK]             = { ATTRIBUTE_WRITE },
+    [DWMWA_CLOAK]                          = { ATTRIBUTE_WRITE },
+    [DWMWA_CLOAKED]                        = { ATTRIBUTE_READ, 0, 0, 1 },
+    [DWMWA_FREEZE_REPRESENTATION]          = { ATTRIBUTE_READ, 0, 1 },
+    [DWMWA_PASSIVE_UPDATE_MODE]            = { ATTRIBUTE_BOOL },
+    [DWMWA_USE_HOSTBACKDROPBRUSH]          = { ATTRIBUTE_WRITE, 1 },
+    [DWMWA_USE_IMMERSIVE_DARK_MODE - 1]    = { ATTRIBUTE_BOOL },   /* before Windows 10 20H1 */
+    [DWMWA_USE_IMMERSIVE_DARK_MODE]        = { ATTRIBUTE_BOOL },
+    [DWMWA_WINDOW_CORNER_PREFERENCE]       = { ATTRIBUTE_VALUE },
+    [DWMWA_BORDER_COLOR]                   = { ATTRIBUTE_WRITE, 1 },
+    [DWMWA_CAPTION_COLOR]                  = { ATTRIBUTE_WRITE, 1 },
+    [DWMWA_TEXT_COLOR]                     = { ATTRIBUTE_WRITE, 1 },
+    [DWMWA_VISIBLE_FRAME_BORDER_THICKNESS] = { ATTRIBUTE_READ, 1, 1, 1 },
+    [DWMWA_SYSTEMBACKDROP_TYPE]            = { ATTRIBUTE_VALUE },
+    [DWMWA_SYSTEMBACKDROP_TYPE + 1]        = { ATTRIBUTE_WRITE },
+};
+
+static enum attribute_kind attribute_kind(DWORD attribute)
+{
+    return attribute < ARRAY_SIZE(attributes) ? attributes[attribute].kind : ATTRIBUTE_NONE;
+}
+
+/* Written attributes are kept with the window, where every process that has it finds them. */
+static const WCHAR *attribute_prop(DWORD attribute, WCHAR *buffer)
+{
+    swprintf(buffer, 32, L"__wine_dwm_attribute_%lu", attribute);
+    return buffer;
+}
+
+/* What was written, or 0, which is what each attribute starts as. */
+static DWORD get_attribute_value(HWND hwnd, DWORD attribute)
+{
+    WCHAR name[32];
+
+    return HandleToUlong(GetPropW(hwnd, attribute_prop(attribute, name)));
+}
+
+HRESULT WINAPI DwmSetWindowAttribute(HWND hwnd, DWORD attribute, LPCVOID value, DWORD size)
+{
+    enum attribute_kind kind = attribute_kind(attribute);
+    WCHAR name[32];
+    DWORD data;
 
-    if (!once++) FIXME("(%p, %lx, %p, %lx) stub\n", hwnd, attributenum, attribute, size);
+    TRACE("(%p, %lu, %p, %lu)\n", hwnd, attribute, value, size);
 
+    if (kind == ATTRIBUTE_NONE || attributes[attribute].refused || !value) return E_INVALIDARG;
+    if (size < sizeof(DWORD) || (attributes[attribute].exact && size != sizeof(DWORD))) return E_INVALIDARG;
+    if (kind == ATTRIBUTE_RECT && size < sizeof(RECT)) return E_NOT_SUFFICIENT_BUFFER;
+    if (!IsWindow(hwnd) || (GetWindowLongW(hwnd, GWL_STYLE) & WS_CHILD)) return E_HANDLE;
+    if (kind == ATTRIBUTE_READ || kind == ATTRIBUTE_RECT) return E_INVALIDARG;
+
+    data = *(const DWORD *)value;
+    switch (attribute)
+    {
+    case DWMWA_WINDOW_CORNER_PREFERENCE:
+        /* the four there are, and one more Windows 11 takes */
+        if (data > DWMWCP_ROUNDSMALL + 1) return E_INVALIDARG;
+        break;
+    case DWMWA_TEXT_COLOR:
+        /* text is drawn in some colour */
+        if (data == DWMWA_COLOR_NONE) return E_INVALIDARG;
+        break;
+    }
+    if (kind == ATTRIBUTE_BOOL) data = !!data;
+
+    if (!SetPropW(hwnd, attribute_prop(attribute, name), ULongToHandle(data))) return E_HANDLE;
     return S_OK;
 }
 
@@ -182,17 +272,41 @@ BOOL WINAPI DwmDefWindowProc(HWND hWnd, UINT Msg, WPARAM wParam, LPARAM lParam,
 /**********************************************************************
  *           DwmGetWindowAttribute         (DWMAPI.@)
  */
+/* The caption buttons the window's style gives it, at the right of its caption. */
+static void get_caption_button_bounds(HWND hwnd, RECT *rect)
+{
+    LONG style = GetWindowLongW(hwnd, GWL_STYLE);
+    UINT dpi = GetDpiForWindow(hwnd), buttons = 0;
+    RECT window;
+
+    GetWindowRect(hwnd, &window);
+    SetRectEmpty(rect);
+    if ((style & WS_CAPTION) != WS_CAPTION) return;
+    if (style & WS_SYSMENU) buttons++;
+    if (style & (WS_MINIMIZEBOX | WS_MAXIMIZEBOX)) buttons += 2;
+
+    rect->right = window.right - window.left - GetSystemMetricsForDpi(SM_CXSIZEFRAME, dpi);
+    rect->left = rect->right - buttons * GetSystemMetricsForDpi(SM_CXSIZE, dpi);
+    rect->bottom = GetSystemMetricsForDpi(SM_CYSIZEFRAME, dpi) + GetSystemMetricsForDpi(SM_CYCAPTION, dpi);
+}
+
 HRESULT WINAPI DwmGetWindowAttribute(HWND hwnd, DWORD attribute, PVOID pv_attribute, DWORD size)
 {
+    enum attribute_kind kind = attribute_kind(attribute);
     BOOL enabled = FALSE;
+    DWORD value;
     HRESULT hr;
 
     TRACE("(%p %ld %p %ld)\n", hwnd, attribute, pv_attribute, size);
 
     if (DwmIsCompositionEnabled(&enabled) == S_OK && !enabled)
         return E_HANDLE;
-    if (!IsWindow(hwnd))
-        return E_HANDLE;
+
+    if (kind == ATTRIBUTE_NONE || kind == ATTRIBUTE_WRITE || !pv_attribute) return E_INVALIDARG;
+    if (kind == ATTRIBUTE_RECT && size < sizeof(RECT)) return E_NOT_SUFFICIENT_BUFFER;
+    if (size < sizeof(DWORD) || (attributes[attribute].exact && size != sizeof(DWORD))) return E_INVALIDARG;
+    if (!IsWindow(hwnd)) return E_HANDLE;
+    if (!attributes[attribute].child && (GetWindowLongW(hwnd, GWL_STYLE) & WS_CHILD)) return E_HANDLE;
 
     switch (attribute) {
     case DWMWA_EXTENDED_FRAME_BOUNDS:
@@ -200,13 +314,6 @@ HRESULT WINAPI DwmGetWindowAttribute(HWND hwnd, DWORD attribute, PVOID pv_attrib
         RECT *rect = (RECT *)pv_attribute;
         DPI_AWARENESS_CONTEXT context;
 
-        if (!rect)
-            return E_INVALIDARG;
-        if (size < sizeof(*rect))
-            return E_NOT_SUFFICIENT_BUFFER;
-        if (GetWindowLongW(hwnd, GWL_STYLE) & WS_CHILD)
-            return E_HANDLE;
-
         /* DWM frame bounds are always in physical coords */
         context = SetThreadDpiAwarenessContext(DPI_AWARENESS_CONTEXT_PER_MONITOR_AWARE);
         if (GetWindowRect(hwnd, rect))
@@ -215,15 +322,30 @@ HRESULT WINAPI DwmGetWindowAttribute(HWND hwnd, DWORD attribute, PVOID pv_attrib
             hr = HRESULT_FROM_WIN32(GetLastError());
 
         SetThreadDpiAwarenessContext(context);
-        break;
+        return hr;
     }
+    case DWMWA_CAPTION_BUTTON_BOUNDS:
+        get_caption_button_bounds(hwnd, pv_attribute);
+        return S_OK;
+    case DWMWA_NCRENDERING_ENABLED:
+        value = get_attribute_value(hwnd, DWMWA_NCRENDERING_POLICY) != DWMNCRP_DISABLED;
+        break;
+    case DWMWA_CLOAKED:
+        value = get_attribute_value(hwnd, DWMWA_CLOAK) ? DWM_CLOAKED_APP : 0;
+        break;
+    case DWMWA_FREEZE_REPRESENTATION:
+        value = 0;
+        break;
+    case DWMWA_VISIBLE_FRAME_BORDER_THICKNESS:
+        value = max(1, MulDiv(1, GetDpiForWindow(hwnd), USER_DEFAULT_SCREEN_DPI));
+        break;
     default:
-        FIXME("attribute %ld not implemented.\n", attribute);
-        hr = E_NOTIMPL;
+        value = get_attribute_value(hwnd, attribute);
         break;
     }
 
-    return hr;
+    *(DWORD *)pv_attribute = value;
+    return S_OK;
 }
 
 /**********************************************************************
diff --git a/dlls/dwmapi/tests/dwmapi.c b/dlls/dwmapi/tests/dwmapi.c
index 6c5cf509357..074c298cd55 100644
--- a/dlls/dwmapi/tests/dwmapi.c
+++ b/dlls/dwmapi/tests/dwmapi.c
@@ -170,10 +170,156 @@ static void test_DwmFlush(void)
     ok(apc_count == 1, "got apc_count %d.\n", apc_count);
 }
 
+/* The attributes a window has, as Windows 11 keeps and answers them. */
+static void test_window_attributes(void)
+{
+    static const struct
+    {
+        DWORD attribute;
+        HRESULT get, set;
+        DWORD start;
+    }
+    tests[] =
+    {
+        { 0, E_INVALIDARG, E_INVALIDARG },
+        { DWMWA_NCRENDERING_ENABLED, S_OK, E_INVALIDARG, TRUE },
+        { DWMWA_NCRENDERING_POLICY, E_INVALIDARG, S_OK },
+        { DWMWA_TRANSITIONS_FORCEDISABLED, E_INVALIDARG, S_OK },
+        { DWMWA_FLIP3D_POLICY, E_INVALIDARG, E_INVALIDARG },
+        { DWMWA_CLOAKED, S_OK, E_INVALIDARG, 0 },
+        { DWMWA_CLOAK, E_INVALIDARG, S_OK },
+        { DWMWA_FREEZE_REPRESENTATION, S_OK, E_INVALIDARG, 0 },
+        { DWMWA_PASSIVE_UPDATE_MODE, S_OK, S_OK, 0 },
+        { DWMWA_USE_HOSTBACKDROPBRUSH, E_INVALIDARG, S_OK },
+        { 18, E_INVALIDARG, E_INVALIDARG },
+        { DWMWA_USE_IMMERSIVE_DARK_MODE, S_OK, S_OK, 0 },
+        { 21, E_INVALIDARG, E_INVALIDARG },
+        { DWMWA_WINDOW_CORNER_PREFERENCE, S_OK, S_OK, DWMWCP_DEFAULT },
+        { DWMWA_BORDER_COLOR, E_INVALIDARG, S_OK },
+        { DWMWA_CAPTION_COLOR, E_INVALIDARG, S_OK },
+        { DWMWA_TEXT_COLOR, E_INVALIDARG, S_OK },
+        { DWMWA_SYSTEMBACKDROP_TYPE, S_OK, S_OK, DWMSBT_AUTO },
+    };
+    DWORD value, buffer[4];
+    HWND hwnd, child;
+    BOOL enabled;
+    unsigned int i;
+    RECT rect;
+    HRESULT hr;
+
+    hwnd = CreateWindowW(L"static", L"static", WS_OVERLAPPEDWINDOW | WS_VISIBLE, 10, 10, 200, 200, NULL, NULL, NULL, NULL);
+    child = CreateWindowW(L"static", L"child", WS_CHILD | WS_VISIBLE, 0, 0, 50, 50, hwnd, NULL, NULL, NULL);
+
+    DwmIsCompositionEnabled(&enabled);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    if (!enabled || hr == E_HANDLE)
+    {
+        skip("DWM is disabled.\n");
+        goto done;
+    }
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        winetest_push_context("attribute %lu", tests[i].attribute);
+        value = 0xdeadbeef;
+        hr = DwmGetWindowAttribute(hwnd, tests[i].attribute, &value, sizeof(value));
+        ok(hr == tests[i].get, "get: got hr %#lx.\n", hr);
+        if (hr == S_OK) ok(value == tests[i].start, "got %#lx.\n", value);
+        value = 1;
+        hr = DwmSetWindowAttribute(hwnd, tests[i].attribute, &value, sizeof(value));
+        ok(hr == tests[i].set, "set: got hr %#lx.\n", hr);
+        winetest_pop_context();
+    }
+
+    /* booleans are read back as such, other values as they were */
+    value = 7;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, &value, sizeof(value));
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_USE_IMMERSIVE_DARK_MODE, &value, sizeof(value));
+    ok(hr == S_OK && value == 1, "got hr %#lx, %lu.\n", hr, value);
+    value = 0xfffffffe;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_SYSTEMBACKDROP_TYPE, &value, sizeof(value));
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_SYSTEMBACKDROP_TYPE, &value, sizeof(value));
+    ok(hr == S_OK && value == 0xfffffffe, "got hr %#lx, %#lx.\n", hr, value);
+
+    value = DWMWCP_ROUNDSMALL;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    value = 5;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    ok(hr == S_OK && value == DWMWCP_ROUNDSMALL, "got hr %#lx, %lu.\n", hr, value);
+
+    /* text is drawn in some colour, a border need not be */
+    value = DWMWA_COLOR_NONE;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_BORDER_COLOR, &value, sizeof(value));
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_TEXT_COLOR, &value, sizeof(value));
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+
+    /* a cloak is seen as the application's */
+    value = TRUE;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_CLOAK, &value, sizeof(value));
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, &value, sizeof(value));
+    ok(hr == S_OK && value == DWM_CLOAKED_APP, "got hr %#lx, %#lx.\n", hr, value);
+    value = FALSE;
+    DwmSetWindowAttribute(hwnd, DWMWA_CLOAK, &value, sizeof(value));
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CLOAKED, &value, sizeof(value));
+    ok(hr == S_OK && !value, "got hr %#lx, %#lx.\n", hr, value);
+
+    /* sizes */
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, buffer, 2);
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+    buffer[0] = buffer[1] = DWMWCP_ROUND;
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, buffer, 8);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_BORDER_COLOR, buffer, 8);
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+    memset(buffer, 0xcc, sizeof(buffer));
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, buffer, sizeof(buffer));
+    ok(hr == S_OK && buffer[0] == DWMWCP_ROUND && buffer[1] == 0xcccccccc, "got hr %#lx, %#lx %#lx.\n", hr,
+       buffer[0], buffer[1]);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_VISIBLE_FRAME_BORDER_THICKNESS, &value, sizeof(value));
+    ok(hr == S_OK && value >= 1, "got hr %#lx, %lu.\n", hr, value);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_VISIBLE_FRAME_BORDER_THICKNESS, buffer, sizeof(buffer));
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CAPTION_BUTTON_BOUNDS, &value, sizeof(value));
+    ok(hr == E_NOT_SUFFICIENT_BUFFER, "got hr %#lx.\n", hr);
+    /* empty until the frame has been drawn */
+    hr = DwmGetWindowAttribute(hwnd, DWMWA_CAPTION_BUTTON_BOUNDS, &rect, sizeof(rect));
+    ok(hr == S_OK && rect.right >= rect.left && !rect.top && rect.bottom >= 0, "got hr %#lx, %s.\n", hr,
+       wine_dbgstr_rect(&rect));
+    hr = DwmSetWindowAttribute(hwnd, DWMWA_WINDOW_CORNER_PREFERENCE, NULL, sizeof(value));
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+
+    /* a child window has hardly any */
+    value = 1;
+    hr = DwmSetWindowAttribute(child, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    ok(hr == E_HANDLE, "got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(child, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    ok(hr == E_HANDLE, "got hr %#lx.\n", hr);
+    hr = DwmGetWindowAttribute(child, DWMWA_CLOAKED, &value, sizeof(value));
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = DwmSetWindowAttribute(child, DWMWA_NCRENDERING_ENABLED, &value, sizeof(value));
+    ok(hr == E_HANDLE, "got hr %#lx.\n", hr);
+    hr = DwmSetWindowAttribute(child, DWMWA_FREEZE_REPRESENTATION, &value, sizeof(value));
+    ok(hr == E_INVALIDARG, "got hr %#lx.\n", hr);
+    hr = DwmSetWindowAttribute(NULL, DWMWA_WINDOW_CORNER_PREFERENCE, &value, sizeof(value));
+    ok(hr == E_HANDLE, "got hr %#lx.\n", hr);
+
+done:
+    DestroyWindow(child);
+    DestroyWindow(hwnd);
+}
+
 START_TEST(dwmapi)
 {
     test_DwmIsCompositionEnabled();
     test_DwmGetCompositionTimingInfo();
     test_DWMWA_EXTENDED_FRAME_BOUNDS();
+    test_window_attributes();
     test_DwmFlush();
 }
diff --git a/include/dwmapi.h b/include/dwmapi.h
index 54f0534a294..ddd9e189fe6 100644
--- a/include/dwmapi.h
+++ b/include/dwmapi.h
@@ -69,6 +69,24 @@ enum DWMWINDOWATTRIBUTE {
     DWMWA_LAST
 };
 
+#define DWMWA_COLOR_DEFAULT 0xffffffff
+#define DWMWA_COLOR_NONE    0xfffffffe
+
+typedef enum DWM_WINDOW_CORNER_PREFERENCE {
+    DWMWCP_DEFAULT,
+    DWMWCP_DONOTROUND,
+    DWMWCP_ROUND,
+    DWMWCP_ROUNDSMALL
+} DWM_WINDOW_CORNER_PREFERENCE;
+
+typedef enum DWM_SYSTEMBACKDROP_TYPE {
+    DWMSBT_AUTO,
+    DWMSBT_NONE,
+    DWMSBT_MAINWINDOW,
+    DWMSBT_TRANSIENTWINDOW,
+    DWMSBT_TABBEDWINDOW
+} DWM_SYSTEMBACKDROP_TYPE;
+
 enum DWMNCRENDERINGPOLICY {
     DWMNCRP_USEWINDOWSTYLE,
     DWMNCRP_DISABLED,
