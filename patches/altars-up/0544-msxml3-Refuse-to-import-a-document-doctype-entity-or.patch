From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 07:00:12 -0400
Subject: [PATCH] msxml3: Refuse to import a document, doctype, entity or
 notation with E_INVALIDARG.

As MSXML 6 does on Windows 11 (build 29671), for each of the four, deep
or shallow, leaving the clone NULL; E_FAIL was a guess.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 651bc0dca12..7d6e2cd0657 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -1524,13 +1524,14 @@ HRESULT node_import_domnode(struct domnode *node, bool deep, struct domnode *doc
 {
     *cloned = NULL;
 
+    /* what belongs to a document of its own cannot be imported (Windows 11, MSXML 6) */
     switch (node->type)
     {
     case NODE_DOCUMENT:
     case NODE_DOCUMENT_TYPE:
     case NODE_ENTITY:
     case NODE_NOTATION:
-        return E_FAIL;
+        return E_INVALIDARG;
     default:
         return clone_domnode(node, deep, doc, cloned);
     }
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index b74c20fe821..6796eec05a9 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -6819,7 +6819,7 @@ static void test_importNode(void)
     /* documents cannot be imported */
     clone = (void *)0xdeadbeef;
     hr = IXMLDOMDocument3_importNode(doc2, (IXMLDOMNode *)doc, VARIANT_TRUE, &clone);
-    ok(hr == E_FAIL, "Unexpected hr %#lx.\n", hr);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
     ok(!clone, "Unexpected clone %p.\n", clone);
 
     hr = IXMLDOMDocument3_importNode(doc2, NULL, VARIANT_TRUE, &clone);
