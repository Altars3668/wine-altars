From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 21:07:49 -0400
Subject: [PATCH] mountmgr: Query backing storage attributes and match
 descriptor buffers.

Read Linux block-device attributes, including directory-backed DOS
volumes, rather than labeling every device as a fake SCSI disk. Devices
with no physical mapping identify themselves as Wine virtual disks.
Report hardware seek/trim capabilities where available.

Match native input-size errors, property existence, invalid query types
and partial device descriptor copies. Seek/trim descriptors require a
header-sized output and return only the header when the rest does not fit.
Native isolated tests and the Wine volume suite pass.

Co-Authored-By: Claude Code <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/volume.c b/dlls/kernel32/tests/volume.c
index 05a6ef123bc..c82fb4bf25e 100644
--- a/dlls/kernel32/tests/volume.c
+++ b/dlls/kernel32/tests/volume.c
@@ -668,7 +668,7 @@ static void test_disk_query_property(void)
     DWORD size;
     BOOL ret;
 
-    handle = CreateFileA("\\\\.\\PhysicalDrive0", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
+    handle = CreateFileA("\\\\.\\PhysicalDrive0", 0, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL, OPEN_EXISTING,
                          0, 0);
     if (handle == INVALID_HANDLE_VALUE)
     {
@@ -761,6 +761,35 @@ static void test_disk_query_property(void)
         ok(trim_descriptor.Size == sizeof(trim_descriptor), "got descriptor.Size %ld\n", trim_descriptor.Size);
     }
 
+    {
+        static const DWORD lengths[] = {0, 1, 7, 8, 9, 16, 39, 40, 64, 1024};
+        BYTE buffer[1024];
+        unsigned int i;
+
+        query.PropertyId = StorageDeviceProperty;
+        query.QueryType = PropertyStandardQuery;
+        for (i = 0; i < ARRAY_SIZE(lengths); ++i)
+        {
+            size = 0xdeadbeef;
+            SetLastError(0xdeadbeef);
+            ret = DeviceIoControl(handle, IOCTL_STORAGE_QUERY_PROPERTY, &query, sizeof(query), buffer, lengths[i], &size, NULL);
+            ok(ret, "length %lu: error %lu.\n", lengths[i], GetLastError());
+            ok(size == min(lengths[i], descriptor.Size), "length %lu: got %lu.\n", lengths[i], size);
+        }
+        ret = DeviceIoControl(handle, IOCTL_STORAGE_QUERY_PROPERTY, &query, sizeof(query) - 1, buffer, sizeof(buffer), &size, NULL);
+        ok(!ret && GetLastError() == ERROR_BAD_LENGTH, "Got %u, error %lu.\n", ret, GetLastError());
+        query.QueryType = PropertyExistsQuery;
+        size = 0xdeadbeef;
+        ret = DeviceIoControl(handle, IOCTL_STORAGE_QUERY_PROPERTY, &query, sizeof(query), buffer, 0, &size, NULL);
+        ok(ret && !size, "Got %u, size %lu, error %lu.\n", ret, size, GetLastError());
+        query.QueryType = 0x7fffffff;
+        ret = DeviceIoControl(handle, IOCTL_STORAGE_QUERY_PROPERTY, &query, sizeof(query), buffer, sizeof(buffer), &size, NULL);
+        ok(!ret && GetLastError() == ERROR_NOT_SUPPORTED, "Got %u, error %lu.\n", ret, GetLastError());
+        query.QueryType = PropertyStandardQuery;
+        query.PropertyId = 0x7fffffff;
+        ret = DeviceIoControl(handle, IOCTL_STORAGE_QUERY_PROPERTY, &query, sizeof(query), buffer, sizeof(buffer), &size, NULL);
+        ok(!ret && GetLastError() == ERROR_INVALID_FUNCTION, "Got %u, error %lu.\n", ret, GetLastError());
+    }
     CloseHandle(handle);
 }
 
@@ -2226,6 +2255,15 @@ static void test_GetDiskSpaceInformationA(void)
 
