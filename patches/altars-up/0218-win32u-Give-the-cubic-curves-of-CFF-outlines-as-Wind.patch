+    lf.lfHeight = -1000;
+    strcpy(lf.lfFaceName, "Wine Test CFF");
+    hfont = CreateFontIndirectA(&lf);
+    hdc = CreateCompatibleDC(0);
+    old = SelectObject(hdc, hfont);
+    GetTextFaceA(hdc, sizeof(face), face);
+    ok(!strcmp(face, "Wine Test CFF"), "got face %s\n", face);
+
+    /* at 1000 pixels unhinted every point is a whole pixel: GGO_BEZIER gives the cubic curves as they are, a record
+       each, and GGO_NATIVE splits them into 1, 2, 3, 4 and 2 quadratic ones */
+    size = GetGlyphOutlineA(hdc, 'a', GGO_BEZIER | GGO_UNHINTED, &gm, 0, NULL, &mat);
+    ok(size == 196, "got size %lu\n", size);
+    ret = GetGlyphOutlineA(hdc, 'a', GGO_BEZIER | GGO_UNHINTED, &gm, sizeof(buf), buf, &mat);
+    ok(ret == size, "got %lu\n", ret);
+    winetest_push_context("GGO_BEZIER");
