+    static const struct outline_contour native[] =
+    {
+        { {100, 0}, 5, {
+            { TT_PRIM_LINE, 1, { {500, 0} } },
+            { TT_PRIM_QSPLINE, 2, { {800, 0}, {800, 300} } },
+            { TT_PRIM_QSPLINE, 3, { {800, 376.25}, {725, 513.75}, {650, 560} } },
+            { TT_PRIM_QSPLINE, 4, { {574.074074, 605.555556}, {400, 630}, {225.925926, 574.444444}, {150, 500} } },
+            { TT_PRIM_QSPLINE, 5, { {95.117188, 460.9375}, {62.695313, 326.5625}, {74.804688, 173.4375},
+                                    {98.632813, 39.0625}, {100, 0} } } } },
+        { {300, 200}, 2, {
+            { TT_PRIM_QSPLINE, 3, { {339.0625, 201.5625}, {398.4375, 260.9375}, {400, 300} } },
+            { TT_PRIM_LINE, 1, { {300, 300} } } } },
+    };
+    GLYPHMETRICS gm, gm2;
+    BYTE buf[1024], buf2[1024];
+    DWORD count, size, ret, i;
+    HFONT hfont, old;
+    char face[LF_FACESIZE];
