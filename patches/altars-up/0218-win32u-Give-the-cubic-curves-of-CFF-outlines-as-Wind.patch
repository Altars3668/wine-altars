+/* Whether the curve at point is a cubic one, as in CFF outlines: two cubic control points, then its end, which is the
+   start of the contour if the contour ends there. */
+static BOOL is_cubic_curve( const FT_Outline *outline, unsigned int point, unsigned int last )
+{
+    return point + 1 <= last && FT_CURVE_TAG( outline->tags[point] ) == FT_CURVE_TAG_CUBIC &&
+           FT_CURVE_TAG( outline->tags[point + 1] ) == FT_CURVE_TAG_CUBIC;
+}
+
+static void get_cubic_curve( const FT_Outline *outline, unsigned int point, unsigned int last, unsigned int first,
+                             POINTFX *pts )
+{
+    FTVectorToPOINTFX( &outline->points[point - 1], &pts[0] );
+    FTVectorToPOINTFX( &outline->points[point], &pts[1] );
+    FTVectorToPOINTFX( &outline->points[point + 1], &pts[2] );
+    FTVectorToPOINTFX( &outline->points[point + 2 <= last ? point + 2 : first], &pts[3] );
+}
+
+static double fixed_to_double( FIXED f )
+{
+    return f.value + f.fract / 65536.0;
+}
+
+static FIXED double_to_fixed( double d )
+{
+    LONG v = d * 65536.0 + (d < 0 ? -0.5 : 0.5);
+    FIXED f;
+
+    f.value = v >> 16;
+    f.fract = v & 0xffff;
+    return f;
+}
+
+/* GGO_NATIVE gives a cubic curve as quadratic ones, as many as Windows makes of it: one if its third difference
+   p3 - 3 p2 + 3 p1 - p0 is at most a pixel in both directions, otherwise the fewest pieces, at least two, for which
+   it is at most ten pixels times their number cubed.  The pieces cover equal ranges of the curve's parameter, and
+   each one's control point is (3 (a1 + a2) - a0 - a3) / 4 of the cubic piece a0 a1 a2 a3.  Returns the number of
+   pieces and, when pieces isn't NULL, puts their control points there followed by the end of the curve. */
+static unsigned int get_quadratic_pieces( const POINTFX *pts, POINTFX *pieces )
+{
+    double x[4], y[4], ax, bx, cx, ay, by, cy, dx, dy;
+    unsigned int i, count;
+
+    for (i = 0; i < 4; i++)
+    {
+        x[i] = fixed_to_double( pts[i].x );
+        y[i] = fixed_to_double( pts[i].y );
+    }
+    /* the curve is a t^3 + b t^2 + c t + p0 */
+    ax = x[3] - 3 * x[2] + 3 * x[1] - x[0];
+    ay = y[3] - 3 * y[2] + 3 * y[1] - y[0];
+    bx = 3 * (x[2] - 2 * x[1] + x[0]);
+    by = 3 * (y[2] - 2 * y[1] + y[0]);
+    cx = 3 * (x[1] - x[0]);
+    cy = 3 * (y[1] - y[0]);
+
+    dx = ax < 0 ? -ax : ax;
+    dy = ay < 0 ? -ay : ay;
+    if (dy > dx) dx = dy;
+    if (dx <= 1.0) count = 1;
+    else for (count = 2; dx > 10.0 * count * count * count; count++) ;
+    if (!pieces) return count;
+
+    for (i = 0; i < count; i++)
+    {
+        double t0 = (double)i / count, t1 = (double)(i + 1) / count, h = t1 - t0;
+        double x0 = ((ax * t0 + bx) * t0 + cx) * t0 + x[0], y0 = ((ay * t0 + by) * t0 + cy) * t0 + y[0];
+        double x1 = ((ax * t1 + bx) * t1 + cx) * t1 + x[0], y1 = ((ay * t1 + by) * t1 + cy) * t1 + y[0];
+        double dx0 = (3 * ax * t0 + 2 * bx) * t0 + cx, dy0 = (3 * ay * t0 + 2 * by) * t0 + cy;
+        double dx1 = (3 * ax * t1 + 2 * bx) * t1 + cx, dy1 = (3 * ay * t1 + 2 * by) * t1 + cy;
+
+        /* with a1 = a0 + h/3 B'(t0) and a2 = a3 - h/3 B'(t1) */
+        pieces[i].x = double_to_fixed( (x0 + x1) / 2 + h * (dx0 - dx1) / 4 );
+        pieces[i].y = double_to_fixed( (y0 + y1) / 2 + h * (dy0 - dy1) / 4 );
+    }
+    pieces[count] = pts[3];
+    return count;
+}
