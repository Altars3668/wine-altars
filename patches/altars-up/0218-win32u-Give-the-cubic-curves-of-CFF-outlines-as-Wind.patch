+        { {100, 0}, 5, {
+            { TT_PRIM_LINE, 1, { {500, 0} } },
+            { TT_PRIM_CSPLINE, 3, { {700, 0}, {800, 100}, {800, 300} } },
+            { TT_PRIM_CSPLINE, 3, { {800, 400}, {750, 500}, {650, 560} } },
+            { TT_PRIM_CSPLINE, 3, { {500, 650}, {300, 650}, {150, 500} } },
+            { TT_PRIM_CSPLINE, 3, { {0, 400}, {100, 100}, {100, 0} } } } },
