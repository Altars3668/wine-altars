+
+struct outline_curve
+{
+    WORD type;
+    WORD count;
+    double points[5][2];
+};
+
+struct outline_contour
+{
+    double start[2];
+    unsigned int count;
+    struct outline_curve curves[5];
+};
+
+static double fixed_to_double(FIXED f)
+{
+    return f.value + f.fract / 65536.0;
+}
+
+static BOOL points_match(POINTFX point, const double *expect, double tolerance)
+{
+    double dx = fixed_to_double(point.x) - expect[0], dy = fixed_to_double(point.y) - expect[1];
+    return dx <= tolerance && -dx <= tolerance && dy <= tolerance && -dy <= tolerance;
+}
+
+static BOOL points_negated(POINTFX point, POINTFX negated)
+{
+    return fixed_to_double(negated.x) == -fixed_to_double(point.x) && fixed_to_double(negated.y) == -fixed_to_double(point.y);
+}
+
+static void check_outline(const BYTE *buf, DWORD size, const struct outline_contour *contours, unsigned int count,
+                          double tolerance)
+{
+    DWORD at = 0;
+    unsigned int i, j, k;
+
+    for (i = 0; i < count && at + sizeof(TTPOLYGONHEADER) <= size; i++)
+    {
+        const TTPOLYGONHEADER *header = (const TTPOLYGONHEADER *)(buf + at);
+        DWORD curve_at = at + sizeof(*header);
+
+        winetest_push_context("contour %u", i);
+        ok(header->dwType == TT_POLYGON_TYPE, "got type %lu\n", header->dwType);
+        ok(points_match(header->pfxStart, contours[i].start, 0), "got start (%.5f,%.5f)\n",
+           fixed_to_double(header->pfxStart.x), fixed_to_double(header->pfxStart.y));
+        for (j = 0; j < contours[i].count && curve_at < at + header->cb; j++)
+        {
+            const TTPOLYCURVE *curve = (const TTPOLYCURVE *)(buf + curve_at);
+            const struct outline_curve *expect = &contours[i].curves[j];
+
+            winetest_push_context("curve %u", j);
+            ok(curve->wType == expect->type && curve->cpfx == expect->count, "got type %u with %u points\n",
+               curve->wType, curve->cpfx);
+            if (curve->wType == expect->type && curve->cpfx == expect->count)
+            {
+                for (k = 0; k < curve->cpfx; k++)
+                    ok(points_match(curve->apfx[k], expect->points[k], tolerance), "point %u: got (%.5f,%.5f)\n", k,
+                       fixed_to_double(curve->apfx[k].x), fixed_to_double(curve->apfx[k].y));
+            }
+            curve_at += sizeof(*curve) + (curve->cpfx - 1) * sizeof(POINTFX);
+            winetest_pop_context();
+        }
+        ok(j == contours[i].count && curve_at == at + header->cb, "got %u curves in %lu bytes\n", j, header->cb);
+        at += header->cb;
+        winetest_pop_context();
+    }
+    ok(i == count && at == size, "got %u contours in %lu of %lu bytes\n", i, at, size);
+}
+
