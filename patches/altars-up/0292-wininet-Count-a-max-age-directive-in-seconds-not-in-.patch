From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 20:32:46 -0400
Subject: [PATCH] wininet: Count a max-age directive in seconds, not in tenths
 of a second.

A cache entry's expiry was put max-age hundred-nanosecond units times a
million after now, where the comment next to it says seconds times ten
million are meant; a response to be kept for an hour was cached for six
minutes.  tools/wininetexpprobe showed 358 seconds left on an entry
cached with max-age=3600 a moment before; the new test does the same
against the test server.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wininet/http.c b/dlls/wininet/http.c
index 4d24537017f..fe68860bbd2 100644
--- a/dlls/wininet/http.c
+++ b/dlls/wininet/http.c
@@ -4840,7 +4840,7 @@ static void HTTP_ProcessExpires(http_request_t *request)
                         /* Age is in seconds, FILETIME resolution is in
                          * 100 nanosecond intervals.
                          */
-                        ft.QuadPart += age * (ULONGLONG)1000000;
+                        ft.QuadPart += age * (ULONGLONG)10000000;
                         request->expires.dwLowDateTime = ft.u.LowPart;
                         request->expires.dwHighDateTime = ft.u.HighPart;
                         expirationFound = TRUE;
diff --git a/dlls/wininet/tests/http.c b/dlls/wininet/tests/http.c
index bb791e13d7b..d0da3db4654 100644
--- a/dlls/wininet/tests/http.c
+++ b/dlls/wininet/tests/http.c
@@ -2849,6 +2849,12 @@ static DWORD CALLBACK server_thread(LPVOID param)
             else
                 send(c, okmsg, sizeof(okmsg)-1, 0);
         }
+        if (strstr(buffer, "GET /test_cache_max_age"))
+        {
+            static const char max_age_response[] = "HTTP/1.1 200 OK\r\nCache-Control: max-age=3600\r\n"
+                                                    "Content-Length: 12\r\n\r\nsome content";
+            send(c, max_age_response, sizeof(max_age_response)-1, 0);
+        }
         if (strstr(buffer, "GET /test_cache_control_no_store"))
         {
             static const char no_cache_response[] = "HTTP/1.1 200 OK\r\nCache-Control: junk, \t No-StOrE\r\n\r\nsome content";
@@ -4238,6 +4244,56 @@ static void test_no_cache(int port)
     InternetCloseHandle(ses);
 }
 
+/* a response kept for an hour is cached with an hour to go */
+static void test_cache_max_age(int port)
+{
+    static const char path[] = "/test_cache_max_age";
+    char cache_url[256], buf[256], info_buf[4096];
+    INTERNET_CACHE_ENTRY_INFOA *info = (INTERNET_CACHE_ENTRY_INFOA *)info_buf;
+    HINTERNET ses, con, req;
+    ULARGE_INTEGER expires, now;
+    FILETIME ft;
+    DWORD read, size;
+    LONGLONG left;
+    BOOL ret;
+
+    ses = InternetOpenA("winetest", INTERNET_OPEN_TYPE_DIRECT, NULL, NULL, 0);
+    ok(ses != NULL,"InternetOpen failed with error %lu\n", GetLastError());
+    con = InternetConnectA(ses, "localhost", port, NULL, NULL, INTERNET_SERVICE_HTTP, 0, 0);
+    ok(con != NULL, "InternetConnect failed with error %lu\n", GetLastError());
+    req = HttpOpenRequestA(con, NULL, path, NULL, NULL, NULL, 0, 0);
+    ok(req != NULL, "HttpOpenRequest failed\n");
+
+    sprintf(cache_url, "http://localhost:%d%s", port, path);
+    DeleteUrlCacheEntryA(cache_url);
+
+    ret = HttpSendRequestA(req, NULL, 0, NULL, 0);
+    ok(ret, "HttpSendRequest failed with error %lu\n", GetLastError());
+    size = 0;
+    while(InternetReadFile(req, buf, sizeof(buf), &read) && read)
+        size += read;
+    ok(size == 12, "read %ld bytes of data\n", size);
+    InternetCloseHandle(req);
+
+    size = sizeof(info_buf);
+    ret = GetUrlCacheEntryInfoA(cache_url, info, &size);
+    ok(ret, "GetUrlCacheEntryInfo failed with error %lu\n", GetLastError());
+    if (ret)
+    {
+        GetSystemTimeAsFileTime(&ft);
+        now.LowPart = ft.dwLowDateTime;
+        now.HighPart = ft.dwHighDateTime;
+        expires.LowPart = info->ExpireTime.dwLowDateTime;
+        expires.HighPart = info->ExpireTime.dwHighDateTime;
+        left = ((LONGLONG)expires.QuadPart - (LONGLONG)now.QuadPart) / 10000000;
+        ok(left > 3500 && left <= 3600, "entry expires in %I64d s\n", left);
+    }
+    DeleteUrlCacheEntryA(cache_url);
+
+    InternetCloseHandle(con);
+    InternetCloseHandle(ses);
+}
+
 static void test_cache_read_gzipped(int port)
 {
     static const char cache_url_fmt[] = "http://localhost:%d%s";
@@ -7036,6 +7092,7 @@ static void test_http_connection(void)
     test_large_header(si.port);
     test_conn_close(si.port);
     test_no_cache(si.port);
+    test_cache_max_age(si.port);
     test_cache_read_gzipped(si.port);
     test_http_status(si.port);
     test_premature_disconnect(si.port);
