index 36390a3840e..4f42af53558 100644
--- a/include/Makefile.in
+++ b/include/Makefile.in
@@ -1084,6 +1084,7 @@ SOURCES = \
 	windows.security.authorization.appcapabilityaccess.idl \
 	windows.security.credentials.idl \
