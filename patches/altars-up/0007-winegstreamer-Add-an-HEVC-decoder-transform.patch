@@ -444,6 +446,7 @@ IMFMediaType *mf_media_type_from_wg_format(const struct wg_format *format)
         case WG_MAJOR_TYPE_VIDEO:
             return mf_media_type_from_wg_format_video(format);
 
+        case WG_MAJOR_TYPE_VIDEO_HEVC:
         case WG_MAJOR_TYPE_VIDEO_H264:
             return mf_media_type_from_wg_format_h264(format);
 
@@ -725,6 +728,25 @@ static void mf_media_type_to_wg_format_audio_wma(IMFMediaType *type, const GUID
