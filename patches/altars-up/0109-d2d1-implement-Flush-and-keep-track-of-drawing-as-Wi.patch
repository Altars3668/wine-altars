@@ -6947,6 +6945,126 @@ static void test_dc_target(BOOL d3d11)
     release_test_context(&ctx);
 }
 
+static void check_draw_result_(unsigned int line, ID2D1DCRenderTarget *rt, BOOL end, HRESULT expected_hr,
+        D2D1_TAG expected_tag1, D2D1_TAG expected_tag2)
+{
+    D2D1_TAG tag1 = 0xdead, tag2 = 0xbeef;
+    HRESULT hr;
+
+    if (end)
+        hr = ID2D1DCRenderTarget_EndDraw(rt, &tag1, &tag2);
+    else
+        hr = ID2D1DCRenderTarget_Flush(rt, &tag1, &tag2);
+    ok_(__FILE__, line)(hr == expected_hr, "Got unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(tag1 == expected_tag1 && tag2 == expected_tag2, "Got unexpected tags %s %s.\n",
+            wine_dbgstr_longlong(tag1), wine_dbgstr_longlong(tag2));
+}
+#define check_flush(a, b, c, d) check_draw_result_(__LINE__, a, FALSE, b, c, d)
+#define check_end_draw(a, b, c, d) check_draw_result_(__LINE__, a, TRUE, b, c, d)
+
+static void test_flush_and_draw_state(BOOL d3d11)
+{
+    static const D2D1_COLOR_F red = {1.0f, 0.0f, 0.0f, 1.0f}, green = {0.0f, 1.0f, 0.0f, 1.0f};
+    BITMAPINFO bmi = {{sizeof(BITMAPINFOHEADER), 8, -8, 1, 32, BI_RGB}};
+    D2D1_RENDER_TARGET_PROPERTIES desc;
+    D2D1_RECT_F clip = {0, 0, 4, 4};
+    struct d2d1_test_context ctx;
+    RECT rect = {0, 0, 8, 8};
+    ID2D1DCRenderTarget *rt;
+    HBITMAP dib;
+    DWORD *bits;
+    HRESULT hr;
+    HDC hdc;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    desc.type = D2D1_RENDER_TARGET_TYPE_DEFAULT;
+    desc.pixelFormat.format = DXGI_FORMAT_B8G8R8A8_UNORM;
+    desc.pixelFormat.alphaMode = D2D1_ALPHA_MODE_IGNORE;
+    desc.dpiX = 96.0f;
+    desc.dpiY = 96.0f;
+    desc.usage = D2D1_RENDER_TARGET_USAGE_NONE;
+    desc.minLevel = D2D1_FEATURE_LEVEL_DEFAULT;
+    hr = ID2D1Factory_CreateDCRenderTarget(ctx.factory, &desc, &rt);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hdc = CreateCompatibleDC(NULL);
+    dib = CreateDIBSection(hdc, &bmi, DIB_RGB_COLORS, (void **)&bits, NULL, 0);
+    SelectObject(hdc, dib);
+    hr = ID2D1DCRenderTarget_BindDC(rt, hdc, &rect);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    /* Outside BeginDraw, Flush and EndDraw are in the wrong state, with the tags set now. */
+    check_flush(rt, D2DERR_WRONG_STATE, 0, 0);
+    ID2D1DCRenderTarget_SetTags(rt, 9, 10);
+    check_flush(rt, D2DERR_WRONG_STATE, 9, 10);
+    check_end_draw(rt, D2DERR_WRONG_STATE, 9, 10);
+
+    /* Flush reports no error and presents nothing: the DC gets the pixels at EndDraw. */
+    memset(bits, 0, 8 * 8 * 4);
+    ID2D1DCRenderTarget_BeginDraw(rt);
+    ID2D1DCRenderTarget_SetTags(rt, 1, 2);
+    ID2D1DCRenderTarget_Clear(rt, &red);
+    check_flush(rt, S_OK, 0, 0);
+    ok(!(bits[0] & 0xffffff), "Got unexpected colour 0x%08lx.\n", bits[0]);
+    check_end_draw(rt, S_OK, 0, 0);
+    ok((bits[0] & 0xffffff) == 0xff0000, "Got unexpected colour 0x%08lx.\n", bits[0]);
+
+    /* Flush reports an error with the tags it was found with, and clears it. */
+    ID2D1DCRenderTarget_BeginDraw(rt);
+    ID2D1DCRenderTarget_SetTags(rt, 3, 4);
+    ID2D1DCRenderTarget_PopAxisAlignedClip(rt);
+    ID2D1DCRenderTarget_SetTags(rt, 5, 6);
+    check_flush(rt, D2DERR_PUSH_POP_UNBALANCED, 3, 4);
+    check_flush(rt, S_OK, 0, 0);
+    check_end_draw(rt, S_OK, 0, 0);
+
+    /* The first error stands, and drawing stops at it. */
+    ID2D1DCRenderTarget_BeginDraw(rt);
+    ID2D1DCRenderTarget_SetTags(rt, 15, 16);
+    ID2D1DCRenderTarget_PopAxisAlignedClip(rt);
+    ID2D1DCRenderTarget_SetTags(rt, 17, 18);
+    ID2D1DCRenderTarget_PopAxisAlignedClip(rt);
+    ID2D1DCRenderTarget_Clear(rt, &green);
+    check_end_draw(rt, D2DERR_PUSH_POP_UNBALANCED, 15, 16);
+    ok((bits[0] & 0xffffff) == 0xff0000, "Got unexpected colour 0x%08lx.\n", bits[0]);
+
+    /* A pop has to be of the kind pushed, and what is pushed has to be popped. */
+    ID2D1DCRenderTarget_BeginDraw(rt);
+    ID2D1DCRenderTarget_PushAxisAlignedClip(rt, &clip, D2D1_ANTIALIAS_MODE_ALIASED);
+    ID2D1DCRenderTarget_PopAxisAlignedClip(rt);
+    check_end_draw(rt, S_OK, 0, 0);
+    ID2D1DCRenderTarget_BeginDraw(rt);
+    ID2D1DCRenderTarget_PushAxisAlignedClip(rt, &clip, D2D1_ANTIALIAS_MODE_ALIASED);
