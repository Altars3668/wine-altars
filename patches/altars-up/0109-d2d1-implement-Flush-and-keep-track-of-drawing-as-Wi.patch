     {
         d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
         return;
@@ -1589,12 +1635,12 @@ static void d2d_device_context_draw_glyph_run_bitmap(struct d2d_device_context *
         for (i = 0; i < opacity_values_size; ++i)
             if (((const unsigned char *)opacity_values)[i]) ++set;
 
-        TRACE("altars-glyphfill run_rect %s, bounds %s, transform {%.2f %.2f %.2f %.2f %.2f %.2f}, "
