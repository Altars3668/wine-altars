     }
     d2d_device_context_fill_geometry(context, unsafe_impl_from_ID2D1Geometry((ID2D1Geometry *)geometry),
             unsafe_impl_from_ID2D1Brush(brush), unsafe_impl_from_ID2D1Brush((ID2D1Brush *)opacity_brush));
@@ -1698,7 +1744,7 @@ static void d2d_device_context_draw_glyph_run(struct d2d_device_context *context
     if (FAILED(context->error.code))
         return;
 
-    if (context->target.type == D2D_TARGET_UNKNOWN)
+    if (context->target.type == D2D_TARGET_UNKNOWN || !context->drawing)
     {
         d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
         return;
@@ -1876,6 +1922,7 @@ static void STDMETHODCALLTYPE d2d_device_context_PushLayer(ID2D1DeviceContext6 *
 
     FIXME("iface %p, layer_parameters %p, layer %p stub!\n", iface, layer_parameters, layer);
 
+    d2d_device_context_push(context, D2D_PUSH_LAYER);
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
     {
         D2D1_LAYER_PARAMETERS1 parameters;
@@ -1892,6 +1939,9 @@ static void STDMETHODCALLTYPE d2d_device_context_PopLayer(ID2D1DeviceContext6 *i
 
     FIXME("iface %p stub!\n", iface);
 
+    if (!d2d_device_context_pop(context, D2D_PUSH_LAYER))
+        return;
+
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
         d2d_command_list_pop_layer(context->target.command_list);
 }
@@ -1899,13 +1949,30 @@ static void STDMETHODCALLTYPE d2d_device_context_PopLayer(ID2D1DeviceContext6 *i
 static HRESULT STDMETHODCALLTYPE d2d_device_context_Flush(ID2D1DeviceContext6 *iface, D2D1_TAG *tag1, D2D1_TAG *tag2)
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    HRESULT hr;
 
-    FIXME("iface %p, tag1 %p, tag2 %p stub!\n", iface, tag1, tag2);
+    TRACE("iface %p, tag1 %p, tag2 %p.\n", iface, tag1, tag2);
 
-    if (context->ops && context->ops->device_context_present)
-        context->ops->device_context_present(context->outer_unknown);
+    /* Measured on Windows: outside BeginDraw it is a wrong state, with the tags set now; inside, what is drawn
+     * has gone to the device already, and it reports the error there is and clears it, as EndDraw does. It
+     * presents nothing: a DC render target's DC is untouched until EndDraw. */
+    if (!context->drawing)
+    {
+        if (tag1)
+            *tag1 = context->drawing_state.tag1;
+        if (tag2)
+            *tag2 = context->drawing_state.tag2;
+        return D2DERR_WRONG_STATE;
+    }
 
-    return S_OK;
+    if (tag1)
+        *tag1 = context->error.tag1;
+    if (tag2)
+        *tag2 = context->error.tag2;
+    hr = context->error.code;
+    memset(&context->error, 0, sizeof(context->error));
+
+    return hr;
 }
 
 static void STDMETHODCALLTYPE d2d_device_context_SaveDrawingState(ID2D1DeviceContext6 *iface,
@@ -1966,6 +2033,7 @@ static void STDMETHODCALLTYPE d2d_device_context_PushAxisAlignedClip(ID2D1Device
 
     TRACE("iface %p, clip_rect %s, antialias_mode %#x.\n", iface, debug_d2d_rect_f(clip_rect), antialias_mode);
 
+    d2d_device_context_push(context, D2D_PUSH_CLIP);
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
         d2d_command_list_push_clip(context->target.command_list, clip_rect, antialias_mode);
 
@@ -1997,6 +2065,9 @@ static void STDMETHODCALLTYPE d2d_device_context_PopAxisAlignedClip(ID2D1DeviceC
 
     TRACE("iface %p.\n", iface);
 
+    if (!d2d_device_context_pop(context, D2D_PUSH_CLIP))
+        return;
+
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
         d2d_command_list_pop_clip(context->target.command_list);
 
@@ -2018,7 +2089,7 @@ static void STDMETHODCALLTYPE d2d_device_context_Clear(ID2D1DeviceContext6 *ifac
     if (FAILED(context->error.code))
         return;
 
-    if (context->target.type == D2D_TARGET_UNKNOWN)
+    if (context->target.type == D2D_TARGET_UNKNOWN || !context->drawing)
     {
         d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
         return;
@@ -2095,10 +2166,16 @@ static void STDMETHODCALLTYPE d2d_device_context_BeginDraw(ID2D1DeviceContext6 *
 
     TRACE("iface %p.\n", iface);
 
+    /* An error found before BeginDraw, drawing outside it for one, stands until EndDraw reports it. */
+    if (context->drawing)
+    {
+        d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
+        return;
+    }
+    context->drawing = TRUE;
+
     if (context->target.type == D2D_TARGET_COMMAND_LIST)
         d2d_command_list_begin_draw(context->target.command_list, context);
-
-    memset(&context->error, 0, sizeof(context->error));
 }
 
 static HRESULT STDMETHODCALLTYPE d2d_device_context_EndDraw(ID2D1DeviceContext6 *iface,
@@ -2109,19 +2186,39 @@ static HRESULT STDMETHODCALLTYPE d2d_device_context_EndDraw(ID2D1DeviceContext6
 
     TRACE("iface %p, tag1 %p, tag2 %p.\n", iface, tag1, tag2);
 
-    /* what is drawn to a command list is recorded as it is drawn */
-    if (tag1)
-        *tag1 = context->error.tag1;
-    if (tag2)
-        *tag2 = context->error.tag2;
+    if (!context->drawing)
+    {
+        if (tag1)
+            *tag1 = context->drawing_state.tag1;
+        if (tag2)
+            *tag2 = context->drawing_state.tag2;
+        return D2DERR_WRONG_STATE;
+    }
+
+    /* what is left pushed was never popped */
+    if (context->push_count)
+        d2d_device_context_set_error(context, D2DERR_PUSH_POP_UNBALANCED);
+    context->push_count = 0;
+    context->clip_stack.count = 0;
 
+    /* what is drawn to a command list is recorded as it is drawn */
+    /* A failure to present is not the drawing's: it comes without tags, as it does on Windows. */
     if (context->ops && context->ops->device_context_present)
     {
-        if (FAILED(hr = context->ops->device_context_present(context->outer_unknown)))
+        if (FAILED(hr = context->ops->device_context_present(context->outer_unknown))
+                && SUCCEEDED(context->error.code))
             context->error.code = hr;
     }
 
-    return context->error.code;
+    if (tag1)
+        *tag1 = context->error.tag1;
+    if (tag2)
+        *tag2 = context->error.tag2;
+    hr = context->error.code;
+    memset(&context->error, 0, sizeof(context->error));
+    context->drawing = FALSE;
+
+    return hr;
 }
 
 static D2D1_PIXEL_FORMAT * STDMETHODCALLTYPE d2d_device_context_GetPixelFormat(ID2D1DeviceContext6 *iface,
@@ -3114,7 +3211,7 @@ static void STDMETHODCALLTYPE d2d_device_context_DrawImage(ID2D1DeviceContext6 *
     if (FAILED(context->error.code))
         return;
 
-    if (context->target.type == D2D_TARGET_UNKNOWN)
+    if (context->target.type == D2D_TARGET_UNKNOWN || !context->drawing)
     {
         d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
         return;
@@ -3169,7 +3266,7 @@ static void STDMETHODCALLTYPE d2d_device_context_ID2D1DeviceContext_DrawBitmap(I
     if (FAILED(context->error.code))
         return;
 
-    if (context->target.type == D2D_TARGET_UNKNOWN)
+    if (context->target.type == D2D_TARGET_UNKNOWN || !context->drawing)
     {
         d2d_device_context_set_error(context, D2DERR_WRONG_STATE);
         return;
