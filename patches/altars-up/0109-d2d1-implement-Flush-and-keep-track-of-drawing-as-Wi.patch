+/* As on Windows, the first error stands until Flush or EndDraw report it; drawing stops at it. */
 static void d2d_device_context_set_error(struct d2d_device_context *context, HRESULT code)
 {
     WARN("code %#lx.\n", code);
+    if (FAILED(context->error.code))
+        return;
     context->error.code = code;
     context->error.tag1 = context->drawing_state.tag1;
     context->error.tag2 = context->drawing_state.tag2;
 }
 
+enum d2d_push
+{
+    D2D_PUSH_CLIP,
+    D2D_PUSH_LAYER,
+};
+
+static void d2d_device_context_push(struct d2d_device_context *context, enum d2d_push kind)
+{
+    if (!d2d_array_reserve((void **)&context->pushes, &context->pushes_size, context->push_count + 1,
+            sizeof(*context->pushes)))
+    {
+        ERR("Failed to grow the push stack.\n");
+        return;
+    }
+    context->pushes[context->push_count++] = kind;
+}
+
+/* A pop has to have a push to pop, and of its own kind, a clip for a clip and a layer for a layer. */
+static BOOL d2d_device_context_pop(struct d2d_device_context *context, enum d2d_push kind)
+{
+    if (!context->push_count)
+    {
+        WARN("Nothing pushed to pop.\n");
+        d2d_device_context_set_error(context, D2DERR_PUSH_POP_UNBALANCED);
+        return FALSE;
+    }
+    if (context->pushes[context->push_count - 1] != kind)
+    {
+        WARN("Pop of kind %u does not match a push of kind %u.\n", kind, context->pushes[context->push_count - 1]);
+        d2d_device_context_set_error(context, D2DERR_POP_CALL_DID_NOT_MATCH_PUSH);
+        return FALSE;
+    }
+    --context->push_count;
+    return TRUE;
+}
+
 static inline struct d2d_device_context *impl_from_IUnknown(IUnknown *iface)
 {
     return CONTAINING_RECORD(iface, struct d2d_device_context, IUnknown_iface);
@@ -215,6 +254,12 @@ static inline struct d2d_device_context *impl_from_ID2D1DeviceContext(ID2D1Devic
     return CONTAINING_RECORD(iface, struct d2d_device_context, ID2D1DeviceContext6_iface);
 }
 
+/* whether one of ours is between BeginDraw and EndDraw */
+BOOL d2d_device_context_is_drawing(ID2D1DeviceContext *iface)
+{
+    return impl_from_ID2D1DeviceContext((ID2D1DeviceContext6 *)iface)->drawing;
+}
