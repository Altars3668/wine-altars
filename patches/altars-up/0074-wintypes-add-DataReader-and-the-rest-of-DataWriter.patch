+static HRESULT WINAPI data_reader_LoadAsync(IDataReader *iface, UINT32 count, IAsyncOperation_UINT32 **operation)
+{
+    static LONG next_id;
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    struct load_operation *load;
+    IBuffer *buffer;
+    HRESULT hr;
+
+    TRACE("iface %p, count %u, operation %p.\n", iface, count, operation);
+
+    *operation = NULL;
+    if (impl->closed) return RO_E_CLOSED;
+    if (!impl->stream) return HRESULT_FROM_WIN32(ERROR_INVALID_OPERATION);
+
+    if (!(load = calloc(1, sizeof(*load)))) return E_OUTOFMEMORY;
+    load->IAsyncOperation_UINT32_iface.lpVtbl = &load_operation_vtbl;
+    load->IAsyncInfo_iface.lpVtbl = &load_operation_info_vtbl;
+    load->IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32_iface.lpVtbl = &load_operation_handler_vtbl;
+    load->ref = 1;
+    load->status = Started;
+    load->id = InterlockedIncrement(&next_id);
+    InitializeCriticalSectionEx(&load->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO);
+    load->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": load_operation.cs");
+    load->reader = impl;
+    IDataReader_AddRef(iface);
+
+    if (FAILED(hr = buffer_create(count, &buffer))
+            || (FAILED(hr = IInputStream_ReadAsync(impl->stream, buffer, count, impl->options, &load->inner))
+                && (IBuffer_Release(buffer), TRUE)))
+    {
+        IAsyncOperation_UINT32_Release(&load->IAsyncOperation_UINT32_iface);
+        return hr;
+    }
+    IBuffer_Release(buffer);
+
+    *operation = &load->IAsyncOperation_UINT32_iface;
+    IAsyncOperation_UINT32_AddRef(*operation);
+    if (FAILED(hr = IAsyncOperationWithProgress_IBuffer_UINT32_put_Completed(load->inner,
+            &load->IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32_iface)))
+    {
+        IAsyncOperation_UINT32_Release(*operation);
+        IAsyncOperation_UINT32_Release(*operation);
+        *operation = NULL;
+        return hr;
+    }
+    IAsyncOperation_UINT32_Release(&load->IAsyncOperation_UINT32_iface);
+    return S_OK;
+}
