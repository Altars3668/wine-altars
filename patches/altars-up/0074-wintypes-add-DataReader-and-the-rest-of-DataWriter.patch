+static HRESULT WINAPI data_reader_DetachBuffer(IDataReader *iface, IBuffer **buffer)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    UINT32 left;
+
+    TRACE("iface %p, buffer %p.\n", iface, buffer);
+
+    *buffer = NULL;
+    if (impl->closed) return RO_E_CLOSED;
+    EnterCriticalSection(&impl->cs);
+    if (!impl->buffer && buffer_create(0, &impl->buffer) == S_OK) buffer_get_data(impl->buffer, &impl->data);
+    if (impl->buffer)
+    {
+        left = impl->end - impl->pos;
+        memmove(impl->data, impl->data + impl->pos, left);
+        IBuffer_put_Length(impl->buffer, left);
+        *buffer = impl->buffer;
+    }
+    impl->buffer = NULL;
+    impl->data = NULL;
+    impl->pos = impl->end = 0;
+    LeaveCriticalSection(&impl->cs);
+    return *buffer ? S_OK : E_OUTOFMEMORY;
+}
