+/*
+ * The operation LoadAsync() hands out: an IAsyncOperation<UInt32> of its own,
+ * which Windows names after that interface, over the stream's ReadAsync().  It
+ * is complete once the bytes are in the reader, not when the stream's read is:
+ * one who waits on it and reads at once finds them there.
+ */
+struct load_operation
+{
+    IAsyncOperation_UINT32 IAsyncOperation_UINT32_iface;
+    IAsyncInfo IAsyncInfo_iface;
+    IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    struct data_reader *reader;
+    IAsyncOperationWithProgress_IBuffer_UINT32 *inner;
+    IAsyncOperationCompletedHandler_UINT32 *handler;
+    AsyncStatus status;
+    HRESULT error;
+    UINT32 result;
+    UINT32 id;
+    BOOL handler_invoked;
+    BOOL closed;
+};
+
+static inline struct load_operation *load_operation_from_IAsyncOperation_UINT32(IAsyncOperation_UINT32 *iface)
+{
+    return CONTAINING_RECORD(iface, struct load_operation, IAsyncOperation_UINT32_iface);
+}
