+/* Room for count more bytes after what is still unread, in the reader's own
+ * buffer: the unread part is moved to the start, and the buffer grows if that
+ * is not enough. */
+static HRESULT data_reader_make_room(struct data_reader *impl, UINT32 count)
+{
+    UINT32 left = impl->end - impl->pos, capacity = 0;
+    IBuffer *buffer;
+    HRESULT hr;
+    BYTE *data;
+
+    if (count > UINT_MAX - left) return E_OUTOFMEMORY;
+    if (impl->buffer) IBuffer_get_Capacity(impl->buffer, &capacity);
+    if (impl->buffer && left + count <= capacity)
+    {
+        memmove(impl->data, impl->data + impl->pos, left);
+    }
+    else
+    {
+        if (FAILED(hr = buffer_create(max(left + count, capacity + capacity / 2), &buffer))) return hr;
+        if (FAILED(hr = buffer_get_data(buffer, &data)))
+        {
+            IBuffer_Release(buffer);
+            return hr;
+        }
+        if (impl->buffer)
+        {
+            memcpy(data, impl->data + impl->pos, left);
+            IBuffer_Release(impl->buffer);
+        }
+        impl->buffer = buffer;
+        impl->data = data;
+    }
+    impl->pos = 0;
+    impl->end = left;
+    IBuffer_put_Length(impl->buffer, left);
+    return S_OK;
+}
+
+static HRESULT data_reader_take(struct data_reader *impl, UINT32 size, const BYTE **data)
+{
+    if (impl->closed) return RO_E_CLOSED;
+    if (impl->end - impl->pos < size) return E_BOUNDS;
+    *data = impl->data + impl->pos;
+    impl->pos += size;
+    return S_OK;
+}
+
+static HRESULT data_reader_read(struct data_reader *impl, void *value, UINT32 size)
+{
+    const BYTE *data;
+    HRESULT hr;
+
+    EnterCriticalSection(&impl->cs);
+    if (SUCCEEDED(hr = data_reader_take(impl, size, &data))) memcpy(value, data, size);
+    LeaveCriticalSection(&impl->cs);
+    return hr;
+}
+
+/* a value of 2, 4 or 8 bytes in the reader's byte order; anything that is not
+ * little-endian is taken as big-endian, the default */
+static HRESULT data_reader_read_ordered(struct data_reader *impl, UINT32 size, UINT64 *value)
+{
+    BYTE bytes[8];
+    HRESULT hr;
+    UINT32 i;
+
+    if (FAILED(hr = data_reader_read(impl, bytes, size))) return hr;
+    *value = 0;
+    for (i = 0; i < size; i++)
+    {
+        UINT32 shift = impl->byte_order == ByteOrder_LittleEndian ? i : size - 1 - i;
+        *value |= (UINT64)bytes[i] << (shift * 8);
+    }
+    return S_OK;
+}
