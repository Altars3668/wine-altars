+/* The string in the writer's encoding, and its length in the units of that
+ * encoding -- bytes of UTF-8, or 16-bit units of UTF-16 -- which is what
+ * WriteString() and MeasureString() report. */
+static HRESULT data_writer_encode(struct data_writer *impl, HSTRING value, BYTE **data, UINT32 *size, UINT32 *code_units)
+{
+    const WCHAR *str;
+    UINT32 len, i;
+    int n;
+
+    *data = NULL;
+    *size = *code_units = 0;
+    /* an encoding outside the enumeration fails whatever the string, an empty one too */
+    if (impl->encoding != UnicodeEncoding_Utf8 && impl->encoding != UnicodeEncoding_Utf16LE
+            && impl->encoding != UnicodeEncoding_Utf16BE)
+        return E_UNEXPECTED;
+    str = WindowsGetStringRawBuffer(value, &len);
+    if (!len) return S_OK;
+
+    if (impl->encoding == UnicodeEncoding_Utf16LE || impl->encoding == UnicodeEncoding_Utf16BE)
+    {
+        if (!(*data = malloc(len * sizeof(WCHAR)))) return E_OUTOFMEMORY;
+        for (i = 0; i < len; i++)
+        {
+            BYTE lo = str[i] & 0xff, hi = str[i] >> 8;
+            (*data)[2 * i] = impl->encoding == UnicodeEncoding_Utf16LE ? lo : hi;
+            (*data)[2 * i + 1] = impl->encoding == UnicodeEncoding_Utf16LE ? hi : lo;
+        }
+        *size = len * sizeof(WCHAR);
+        *code_units = len;
+        return S_OK;
+    }
+
+    if (!(n = WideCharToMultiByte(CP_UTF8, 0, str, len, NULL, 0, NULL, NULL))) return HRESULT_FROM_WIN32(GetLastError());
+    if (!(*data = malloc(n))) return E_OUTOFMEMORY;
+    WideCharToMultiByte(CP_UTF8, 0, str, len, (char *)*data, n, NULL, NULL);
+    *size = *code_units = n;
+    return S_OK;
 }
 
