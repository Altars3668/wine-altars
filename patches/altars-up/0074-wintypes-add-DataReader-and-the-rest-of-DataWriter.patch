+static IDataReader *create_reader_from_buffer(IBuffer *buffer)
+{
+    IActivationFactory *factory;
+    IDataReaderStatics *statics;
+    IDataReader *reader = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = get_activation_factory(L"Windows.Storage.Streams.DataReader", &factory))) return NULL;
+    hr = IActivationFactory_QueryInterface(factory, &IID_IDataReaderStatics, (void **)&statics);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IActivationFactory_Release(factory);
+    hr = IDataReaderStatics_FromBuffer(statics, buffer, &reader);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IDataReaderStatics_Release(statics);
+    return reader;
+}
