+        count = 0xdeadbeef;
+        hr = IDataWriter_WriteString(writer, str, &count);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        ok(count == strings[i].count, "got count %u.\n", count);
+        hr = IDataWriter_DetachBuffer(writer, &buffer);
