+/*
+ * DataReader
+ *
+ * A reader made from a buffer reads the caller's buffer in place, up to the
+ * length it had when the reader was made, and hands the same buffer back from
+ * DetachBuffer() with the unread bytes moved to its start.  One made on a
+ * stream keeps what LoadAsync() brings in in a buffer of its own.  Letting go
+ * of a reader, or closing it, closes its stream.
+ */
+
+struct data_reader
+{
+    IDataReader IDataReader_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    IInputStream *stream;
+    IBuffer *buffer;
+    BYTE *data;
+    UINT32 pos;
+    UINT32 end;
+    UnicodeEncoding encoding;
+    ByteOrder byte_order;
+    InputStreamOptions options;
+    BOOL closed;
+};
+
+static inline struct data_reader *impl_from_IDataReader(IDataReader *iface)
+{
+    return CONTAINING_RECORD(iface, struct data_reader, IDataReader_iface);
+}
+
+static void close_stream(IInputStream *stream)
+{
+    IClosable *closable;
+
+    if (SUCCEEDED(IInputStream_QueryInterface(stream, &IID_IClosable, (void **)&closable)))
+    {
+        IClosable_Close(closable);
+        IClosable_Release(closable);
+    }
