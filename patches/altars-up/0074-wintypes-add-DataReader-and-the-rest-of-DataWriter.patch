+/* code_unit_count is in the reader's encoding: bytes of UTF-8, or 16-bit units
+ * of UTF-16.  A count that ends inside a UTF-8 sequence, or bytes that are not
+ * UTF-8, fail with ERROR_NO_UNICODE_TRANSLATION and consume nothing. */
+static HRESULT WINAPI data_reader_ReadString(IDataReader *iface, UINT32 code_unit_count, HSTRING *value)
+{
+    struct data_reader *impl = impl_from_IDataReader(iface);
+    BOOL utf16 = impl->encoding == UnicodeEncoding_Utf16LE || impl->encoding == UnicodeEncoding_Utf16BE;
+    UINT32 size = code_unit_count, i;
+    const BYTE *src = NULL;
+    HRESULT hr;
+    WCHAR *str;
+    int len;
+
+    TRACE("iface %p, code_unit_count %u, value %p.\n", iface, code_unit_count, value);
+
+    *value = NULL;
+    if (utf16 && size > UINT_MAX / 2) return E_BOUNDS;
+    if (utf16) size *= 2;
+
+    EnterCriticalSection(&impl->cs);
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (!size) hr = S_OK;
+    else if (!utf16 && impl->encoding != UnicodeEncoding_Utf8) hr = E_UNEXPECTED;
+    else if (impl->end - impl->pos < size) hr = E_BOUNDS;
+    else if (utf16)
+    {
+        if (!(str = malloc(size))) hr = E_OUTOFMEMORY;
+        else
+        {
+            data_reader_take(impl, size, &src);
+            for (i = 0; i < code_unit_count; i++)
+            {
+                if (impl->encoding == UnicodeEncoding_Utf16LE) str[i] = src[2 * i] | (src[2 * i + 1] << 8);
+                else str[i] = (src[2 * i] << 8) | src[2 * i + 1];
+            }
+            hr = WindowsCreateString(str, code_unit_count, value);
+            free(str);
+        }
+    }
+    else
+    {
+        src = impl->data + impl->pos;
+        if (!(len = MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (const char *)src, size, NULL, 0)))
+            hr = HRESULT_FROM_WIN32(ERROR_NO_UNICODE_TRANSLATION);
+        else if (!(str = malloc(len * sizeof(WCHAR)))) hr = E_OUTOFMEMORY;
+        else
+        {
+            MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, (const char *)src, size, str, len);
+            if (SUCCEEDED(hr = WindowsCreateString(str, len, value))) impl->pos += size;
+            free(str);
+        }
+    }
+    LeaveCriticalSection(&impl->cs);
+    return hr;
+}
