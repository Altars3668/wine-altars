+    *buffer = NULL;
+    EnterCriticalSection(&impl->cs);
+    if (impl->closed) hr = RO_E_CLOSED;
+    else if (impl->end - impl->pos < length) hr = E_BOUNDS;
+    else if (SUCCEEDED(hr = buffer_create(length, buffer)))
+    {
