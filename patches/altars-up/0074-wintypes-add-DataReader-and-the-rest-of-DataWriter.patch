+#define check_read_string(a, b, c, d, e) check_read_string_(__LINE__, a, b, c, d, e)
+static void check_read_string_(int line, IDataReader *reader, UINT32 count, HRESULT expect_hr,
+                               const WCHAR *expect, UINT32 expect_left)
+{
+    HSTRING str = (void *)0xdeadbeef;
+    const WCHAR *buffer;
+    UINT32 len, left;
+    HRESULT hr;
+
+    hr = IDataReader_ReadString(reader, count, &str);
+    ok_(__FILE__, line)(hr == expect_hr, "got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        buffer = WindowsGetStringRawBuffer(str, &len);
+        ok_(__FILE__, line)(len == wcslen(expect) && !memcmp(buffer, expect, len * sizeof(WCHAR)),
+                            "got %s.\n", debugstr_wn(buffer, len));
+        WindowsDeleteString(str);
+    }
+    else ok_(__FILE__, line)(!str, "got string %p.\n", str);
+    hr = IDataReader_get_UnconsumedBufferLength(reader, &left);
+    ok_(__FILE__, line)(hr == S_OK, "got hr %#lx.\n", hr);
+    ok_(__FILE__, line)(left == expect_left, "got %u left, expected %u.\n", left, expect_left);
+}
