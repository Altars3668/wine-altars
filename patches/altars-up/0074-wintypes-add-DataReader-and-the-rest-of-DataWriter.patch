+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(!count, "got count %u.\n", count);
+
+    /* values outside the enumerations are taken: an encoding like that fails
+     * every string, and a byte order like that is big-endian */
+    hr = IDataWriter_put_UnicodeEncoding(writer, 7);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    count = 0xdeadbeef;
+    hr = IDataWriter_WriteString(writer, NULL, &count);
+    ok(hr == E_UNEXPECTED, "got hr %#lx.\n", hr);
+    ok(!count, "got count %u.\n", count);
+    hr = IDataWriter_MeasureString(writer, NULL, &count);
+    ok(hr == E_UNEXPECTED, "got hr %#lx.\n", hr);
+    hr = IDataWriter_put_ByteOrder(writer, 7);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_WriteUInt16(writer, 0x0102);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_DetachBuffer(writer, &buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    check_buffer(buffer, src_data, 2);
+    IBuffer_Release(buffer);
+
+    src = create_buffer(src_data, sizeof(src_data), 16);
+    hr = IDataWriter_WriteBuffer(writer, src);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_WriteBufferRange(writer, src, 2, 3);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_WriteBufferRange(writer, src, 9, 0);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_WriteBuffer(writer, NULL);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataWriter_DetachBuffer(writer, &buffer);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    check_buffer(buffer, range, sizeof(range));
