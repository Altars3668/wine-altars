+    IDataReader_Release(reader);
+    IBuffer_Release(buffer);
+    buffer = create_buffer(utf16le, sizeof(utf16le), sizeof(utf16le));
+    reader = create_reader_from_buffer(buffer);
+    IDataReader_put_UnicodeEncoding(reader, UnicodeEncoding_Utf16LE);
+    check_read_string(reader, 3, S_OK, L"hi\x00e9", 8);
+    check_read_string(reader, 4, S_OK, L"\x4e2d\xd83d\xde00z", 0);
+    IDataReader_Release(reader);
+    IBuffer_Release(buffer);
+    buffer = create_buffer(utf16be, sizeof(utf16be), sizeof(utf16be));
+    reader = create_reader_from_buffer(buffer);
+    IDataReader_put_UnicodeEncoding(reader, UnicodeEncoding_Utf16BE);
+    check_read_string(reader, 7, S_OK, L"hi\x00e9\x4e2d\xd83d\xde00z", 0);
+    IDataReader_Release(reader);
+    IBuffer_Release(buffer);
+    buffer = create_buffer(bad_utf8, sizeof(bad_utf8), sizeof(bad_utf8));
+    reader = create_reader_from_buffer(buffer);
+    check_read_string(reader, 4, HRESULT_FROM_WIN32(ERROR_NO_UNICODE_TRANSLATION), NULL, 4);
+    hr = IDataReader_put_UnicodeEncoding(reader, 7);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    check_read_string(reader, 2, E_UNEXPECTED, NULL, 4);
+    check_read_string(reader, 0, S_OK, L"", 4);
+    hr = IDataReader_put_ByteOrder(reader, 7);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IDataReader_ReadUInt16(reader, &u16);
+    ok(hr == S_OK && u16 == 0x61ff, "got hr %#lx, %#x.\n", hr, u16);
+    IDataReader_Release(reader);
+    IBuffer_Release(buffer);
+
+    /* the reader reads the caller's buffer in place, and gives it back from DetachBuffer() */
+    buffer = create_buffer(sample, 4, 12);
+    reader = create_reader_from_buffer(buffer);
+    buffer_get_data(buffer)[0] = 0x55;
+    buffer_get_data(buffer)[1] = 0x66;
+    IBuffer_put_Length(buffer, 2);
+    hr = IDataReader_ReadByte(reader, &b);
+    ok(hr == S_OK && b == 0x55, "got hr %#lx, %#x.\n", hr, b);
+    hr = IDataReader_get_UnconsumedBufferLength(reader, &left);
+    ok(hr == S_OK && left == 3, "got hr %#lx, left %u.\n", hr, left);
+    hr = IDataReader_DetachBuffer(reader, &result);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    ok(result == buffer, "got a different buffer.\n");
+    check_buffer(result, rest, sizeof(rest));
+    IBuffer_Release(result);
+    hr = IDataReader_ReadByte(reader, &b);
+    ok(hr == E_BOUNDS, "got hr %#lx.\n", hr);
+    hr = IDataReader_QueryInterface(reader, &IID_IClosable, (void **)&closable);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    hr = IClosable_Close(closable);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IClosable_Release(closable);
+    hr = IDataReader_ReadByte(reader, &b);
+    ok(hr == RO_E_CLOSED, "got hr %#lx.\n", hr);
+    hr = IDataReader_get_UnconsumedBufferLength(reader, &left);
+    ok(hr == RO_E_CLOSED, "got hr %#lx.\n", hr);
+    IDataReader_Release(reader);
+    IBuffer_Release(buffer);
+
+    /* a reader on a stream loads what it is asked for, at most what the stream has left */
+    if ((stream = create_memory_stream(sample, 10)))
+    {
+        hr = IRandomAccessStream_QueryInterface(stream, &IID_IInputStream, (void **)&input);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IDataReaderFactory_CreateDataReader(factory, input, &reader);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IDataReader_ReadByte(reader, &b);
+        ok(hr == E_BOUNDS, "got hr %#lx.\n", hr);
+        u32 = load(reader, 4);
+        ok(u32 == 4, "got %u.\n", u32);
+        hr = IDataReader_ReadBytes(reader, 3, bytes);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        u32 = load(reader, 4);
+        ok(u32 == 4, "got %u.\n", u32);
+        hr = IDataReader_get_UnconsumedBufferLength(reader, &left);
+        ok(hr == S_OK && left == 5, "got hr %#lx, left %u.\n", hr, left);
+        hr = IDataReader_ReadBytes(reader, 4, bytes);
+        ok(hr == S_OK && !memcmp(bytes, sample + 3, 4), "got hr %#lx.\n", hr);
+        u32 = load(reader, 4);
+        ok(u32 == 2, "got %u.\n", u32);
+        u32 = load(reader, 4);
+        ok(u32 == 0, "got %u.\n", u32);
+        hr = IDataReader_get_UnconsumedBufferLength(reader, &left);
+        ok(hr == S_OK && left == 3, "got hr %#lx, left %u.\n", hr, left);
+        hr = IDataReader_DetachStream(reader, &detached);
+        ok(hr == S_OK && detached == input, "got hr %#lx, stream %p.\n", hr, detached);
+        IInputStream_Release(detached);
+        hr = IDataReader_LoadAsync(reader, 1, &operation);
+        ok(hr == HRESULT_FROM_WIN32(ERROR_INVALID_OPERATION), "got hr %#lx.\n", hr);
+        IDataReader_Release(reader);
+
+        /* letting go of a reader closes its stream */
+        hr = IDataReaderFactory_CreateDataReader(factory, input, &reader);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        IDataReader_Release(reader);
+        buffer = create_buffer(NULL, 0, 4);
+        read = (void *)0xdeadbeef;
+        hr = IInputStream_ReadAsync(input, buffer, 2, InputStreamOptions_None, &read);
+        ok(hr == RO_E_CLOSED, "got hr %#lx.\n", hr);
+        IBuffer_Release(buffer);
+        IInputStream_Release(input);
+        IRandomAccessStream_Release(stream);
+    }
+
+    IDataReaderFactory_Release(factory);
+    IActivationFactory_Release(activation);
+    RoUninitialize();
+}
