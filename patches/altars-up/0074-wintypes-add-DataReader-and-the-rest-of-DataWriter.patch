+static IRandomAccessStream *create_memory_stream(const BYTE *data, UINT32 length)
+{
+    IAsyncOperationWithProgress_UINT32_UINT32 *write;
+    IActivationFactory *factory;
+    IRandomAccessStream *stream;
+    IInspectable *inspectable;
+    IOutputStream *output;
+    AsyncStatus status;
+    IAsyncInfo *info;
+    IBuffer *buffer;
+    HRESULT hr;
+    int i;
+
+    if (FAILED(hr = get_activation_factory(L"Windows.Storage.Streams.InMemoryRandomAccessStream", &factory)))
+        return NULL;
+    hr = IActivationFactory_ActivateInstance(factory, &inspectable);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IActivationFactory_Release(factory);
+    hr = IInspectable_QueryInterface(inspectable, &IID_IRandomAccessStream, (void **)&stream);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IInspectable_Release(inspectable);
+
+    hr = IRandomAccessStream_QueryInterface(stream, &IID_IOutputStream, (void **)&output);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    buffer = create_buffer(data, length, length);
+    hr = IOutputStream_WriteAsync(output, buffer, &write);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IAsyncOperationWithProgress_UINT32_UINT32_QueryInterface(write, &IID_IAsyncInfo, (void **)&info);
+    for (i = 0; i < 500; i++)
+    {
+        IAsyncInfo_get_Status(info, &status);
+        if (status != Started) break;
+        Sleep(10);
+    }
+    ok(status == Completed, "got status %u.\n", status);
+    IAsyncInfo_Release(info);
+    IAsyncOperationWithProgress_UINT32_UINT32_Release(write);
+    IBuffer_Release(buffer);
+    IOutputStream_Release(output);
+    IRandomAccessStream_Seek(stream, 0);
+    return stream;
+}
+
+static UINT32 load(IDataReader *reader, UINT32 count)
+{
+    IAsyncOperation_UINT32 *operation;
+    AsyncStatus status = Started;
+    UINT32 loaded = 0xdeadbeef;
+    IAsyncInfo *info;
+    HRESULT hr;
+    int i;
+
+    hr = IDataReader_LoadAsync(reader, count, &operation);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    if (FAILED(hr)) return 0;
+    check_runtime_class(operation, L"Windows.Foundation.IAsyncOperation`1<UInt32>");
+    hr = IAsyncOperation_UINT32_QueryInterface(operation, &IID_IAsyncInfo, (void **)&info);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    for (i = 0; i < 500; i++)
+    {
+        IAsyncInfo_get_Status(info, &status);
+        if (status != Started) break;
+        Sleep(10);
+    }
+    ok(status == Completed, "got status %u.\n", status);
+    IAsyncInfo_Release(info);
+    hr = IAsyncOperation_UINT32_GetResults(operation, &loaded);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    IAsyncOperation_UINT32_Release(operation);
+    return loaded;
+}
