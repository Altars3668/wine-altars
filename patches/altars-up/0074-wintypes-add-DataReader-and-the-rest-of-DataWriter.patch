+/* The stream's read is done: put what it read into the reader, then complete. */
+static HRESULT WINAPI load_operation_handler_Invoke(IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32 *iface,
+        IAsyncOperationWithProgress_IBuffer_UINT32 *operation, AsyncStatus status)
+{
+    struct load_operation *impl = load_operation_from_handler(iface);
+    struct data_reader *reader = impl->reader;
+    IAsyncOperationCompletedHandler_UINT32 *invoke;
+    IBuffer *buffer = NULL;
+    HRESULT hr = S_OK;
+    UINT32 length = 0;
+    IAsyncInfo *info;
+    BYTE *data;
+
+    TRACE("iface %p, operation %p, status %u.\n", iface, operation, status);
+
+    if (status == Completed)
+    {
+        if (SUCCEEDED(hr = IAsyncOperationWithProgress_IBuffer_UINT32_GetResults(operation, &buffer))
+                && SUCCEEDED(hr = IBuffer_get_Length(buffer, &length))
+                && SUCCEEDED(hr = buffer_get_data(buffer, &data)))
+        {
+            EnterCriticalSection(&reader->cs);
+            if (SUCCEEDED(hr = data_reader_make_room(reader, length)))
+            {
+                memcpy(reader->data + reader->end, data, length);
+                reader->end += length;
+                IBuffer_put_Length(reader->buffer, reader->end);
+            }
+            LeaveCriticalSection(&reader->cs);
+        }
+        if (buffer) IBuffer_Release(buffer);
+    }
+    else if (status == Error && SUCCEEDED(IAsyncOperationWithProgress_IBuffer_UINT32_QueryInterface(operation,
+            &IID_IAsyncInfo, (void **)&info)))
+    {
+        IAsyncInfo_get_ErrorCode(info, &hr);
+        IAsyncInfo_Release(info);
+    }
+
+    EnterCriticalSection(&impl->cs);
+    if (status == Completed && FAILED(hr)) status = Error;
+    impl->error = hr;
+    impl->result = status == Completed ? length : 0;
+    impl->status = status;
+    invoke = load_operation_take_handler(impl);
+    LeaveCriticalSection(&impl->cs);
+
+    if (invoke)
+    {
+        IAsyncOperationCompletedHandler_UINT32_Invoke(invoke, &impl->IAsyncOperation_UINT32_iface, status);
+        IAsyncOperationCompletedHandler_UINT32_Release(invoke);
+    }
+    return S_OK;
+}
+
+static const struct IAsyncOperationWithProgressCompletedHandler_IBuffer_UINT32Vtbl load_operation_handler_vtbl =
+{
+    load_operation_handler_QueryInterface,
+    load_operation_handler_AddRef,
+    load_operation_handler_Release,
+    load_operation_handler_Invoke,
+};
