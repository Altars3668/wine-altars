+/* Called with the lock held: the handler is invoked once, outside it. */
+static IAsyncOperationCompletedHandler_UINT32 *load_operation_take_handler(struct load_operation *impl)
+{
+    IAsyncOperationCompletedHandler_UINT32 *handler = NULL;
+
+    if (impl->status != Started && impl->handler && !impl->handler_invoked)
+    {
+        handler = impl->handler;
+        IAsyncOperationCompletedHandler_UINT32_AddRef(handler);
+        impl->handler_invoked = TRUE;
+    }
+    return handler;
+}
+
+static HRESULT WINAPI load_operation_put_Completed(IAsyncOperation_UINT32 *iface,
+        IAsyncOperationCompletedHandler_UINT32 *handler)
+{
+    struct load_operation *impl = load_operation_from_IAsyncOperation_UINT32(iface);
+    IAsyncOperationCompletedHandler_UINT32 *invoke;
+    AsyncStatus status;
+
+    TRACE("iface %p, handler %p.\n", iface, handler);
+
+    EnterCriticalSection(&impl->cs);
+    if (impl->closed)
+    {
+        LeaveCriticalSection(&impl->cs);
+        return E_ILLEGAL_METHOD_CALL;
+    }
+    if (impl->handler)
+    {
+        LeaveCriticalSection(&impl->cs);
+        return E_ILLEGAL_DELEGATE_ASSIGNMENT;
+    }
+    if ((impl->handler = handler)) IAsyncOperationCompletedHandler_UINT32_AddRef(handler);
+    invoke = load_operation_take_handler(impl);
+    status = impl->status;
+    LeaveCriticalSection(&impl->cs);
+
+    if (invoke)
+    {
+        IAsyncOperationCompletedHandler_UINT32_Invoke(invoke, iface, status);
+        IAsyncOperationCompletedHandler_UINT32_Release(invoke);
+    }
+    return S_OK;
+}
+
+static HRESULT WINAPI load_operation_get_Completed(IAsyncOperation_UINT32 *iface,
+        IAsyncOperationCompletedHandler_UINT32 **handler)
+{
+    struct load_operation *impl = load_operation_from_IAsyncOperation_UINT32(iface);
+
+    TRACE("iface %p, handler %p.\n", iface, handler);
+
+    EnterCriticalSection(&impl->cs);
+    if ((*handler = impl->handler)) IAsyncOperationCompletedHandler_UINT32_AddRef(*handler);
+    LeaveCriticalSection(&impl->cs);
+    return S_OK;
+}
+
+static HRESULT WINAPI load_operation_GetResults(IAsyncOperation_UINT32 *iface, UINT32 *results)
+{
+    struct load_operation *impl = load_operation_from_IAsyncOperation_UINT32(iface);
+    HRESULT hr;
+
+    TRACE("iface %p, results %p.\n", iface, results);
+
+    EnterCriticalSection(&impl->cs);
+    if (impl->status == Completed)
+    {
+        *results = impl->result;
+        hr = S_OK;
+    }
+    else if (impl->status == Error) hr = impl->error;
