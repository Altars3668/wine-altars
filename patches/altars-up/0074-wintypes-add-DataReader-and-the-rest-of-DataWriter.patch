+static HRESULT data_writer_write(struct data_writer *impl, const void *value, UINT32 size)
+{
+    UINT32 pos = 0;
+    HRESULT hr;
+
+    if (impl->closed) return RO_E_CLOSED;
+    if (FAILED(hr = data_writer_init_buffer(impl, size)))
+        return hr;
+
+    IBuffer_get_Length(impl->buffer, &pos);
+    memcpy(&impl->data[pos], value, size);
+    IBuffer_put_Length(impl->buffer, pos + size);
+    return S_OK;
+}
+
+/* a value of 2, 4 or 8 bytes in the writer's byte order */
+static HRESULT data_writer_write_ordered(struct data_writer *impl, UINT64 value, UINT32 size)
+{
+    BYTE bytes[8];
+    UINT32 i;
+
+    for (i = 0; i < size; i++)
+    {
+        UINT32 shift = impl->byte_order == ByteOrder_LittleEndian ? i : size - 1 - i;
+        bytes[i] = value >> (shift * 8);
+    }
+    return data_writer_write(impl, bytes, size);
 }
 
