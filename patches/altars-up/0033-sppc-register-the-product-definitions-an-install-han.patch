+
 #endif
diff --git a/include/slerror.h b/include/slerror.h
index 1fb76cbd1a9..ac12814a75d 100644
--- a/include/slerror.h
+++ b/include/slerror.h
@@ -26,6 +26,7 @@
 #define SL_E_PKEY_NOT_INSTALLED       0xC004F014
 #define SL_E_PRODUCT_SKU_NOT_INSTALLED 0xC004F015
 #define SL_E_NOT_SUPPORT              0xC004F016
+#define SL_E_INVALID_LICENSE          0xC004F017
 #define SL_E_DATATYPE_MISMATCHED      0xC004F01E
 #define SL_E_APPLICATION_POLICIES_MISSING 0xC004F072
 
