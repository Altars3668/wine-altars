From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 23:01:48 -0400
Subject: [PATCH] combase: Report why an in-process server could not be loaded.

A server that could not be loaded was always E_ACCESSDENIED.  Windows (build 29671)
returns what the loader said: HRESULT_FROM_WIN32(ERROR_MOD_NOT_FOUND) for one that is
not there, whether the registry or an activation context names it, and
ERROR_BAD_EXE_FORMAT for a file that is not a DLL.  OfficeClickToRun.exe's manifest
declares InfoPath's XML MIME filter in its own folder, where there is none, precisely
to keep it from being loaded into the service.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 048eaafc58f40d9d56de99c8e901c96ff584083f)

diff --git a/dlls/combase/apartment.c b/dlls/combase/apartment.c
index 85e06a6fd57..d7aca645970 100644
--- a/dlls/combase/apartment.c
+++ b/dlls/combase/apartment.c
@@ -130,9 +130,11 @@ static HRESULT apartment_add_dll(const WCHAR *library_name, struct opendll **ret
     hLibrary = LoadLibraryExW(library_name, 0, LOAD_WITH_ALTERED_SEARCH_PATH);
     if (!hLibrary)
     {
-        ERR("couldn't load in-process dll %s\n", debugstr_w(library_name));
-        /* failure: DLL could not be loaded */
-        return E_ACCESSDENIED; /* FIXME: or should this be CO_E_DLLNOTFOUND? */
+        DWORD error = GetLastError();
+
+        /* The server is missing or not a DLL; Windows reports what the loader said. */
+        ERR("couldn't load in-process dll %s, error %lu\n", debugstr_w(library_name), error);
+        return HRESULT_FROM_WIN32(error);
     }
 
     /* DllCanUnloadNow is optional */
diff --git a/dlls/ole32/tests/compobj.c b/dlls/ole32/tests/compobj.c
index 3a51dbd0c04..c9bef098a85 100644
--- a/dlls/ole32/tests/compobj.c
+++ b/dlls/ole32/tests/compobj.c
@@ -837,6 +837,38 @@ struct comclassredirect_data
     DWORD miscstatusdocprint;
 };
 
+/* A server declared by an activation context that is not there: what the loader says, as for one in the
+ * registry.  OfficeClickToRun.exe's manifest declares InfoPath's XML MIME filter this way to keep it out. */
+static void test_missing_server(void)
+{
+    static const char manifest[] =
+        "<assembly xmlns=\"urn:schemas-microsoft-com:asm.v1\" manifestVersion=\"1.0\">"
+        "<assemblyIdentity version=\"1.2.3.4\" name=\"Wine.Test.Missing\" type=\"win32\" />"
+        "<file name=\"wine_missing_server.dll\">"
+        "    <comClass clsid=\"{6d0f3a52-2c1e-4b8a-9f3d-517a0e2b4491}\" threadingModel=\"Apartment\" />"
+        "</file>"
+        "</assembly>";
+    static const CLSID clsid = {0x6d0f3a52, 0x2c1e, 0x4b8a, {0x9f, 0x3d, 0x51, 0x7a, 0x0e, 0x2b, 0x44, 0x91}};
+    IUnknown *unk = (IUnknown *)0xdeadbeef;
+    ULONG_PTR cookie;
+    HANDLE handle;
+    HRESULT hr;
+
+    CoInitialize(NULL);
+    if ((handle = activate_context(manifest, &cookie)))
+    {
+        hr = CoCreateInstance(&clsid, NULL, CLSCTX_INPROC_SERVER, &IID_IUnknown, (void **)&unk);
+        ok(hr == HRESULT_FROM_WIN32(ERROR_MOD_NOT_FOUND), "Unexpected hr %#lx.\n", hr);
+        ok(!unk, "Unexpected pointer %p.\n", unk);
+        unk = (IUnknown *)0xdeadbeef;
+        hr = CoGetClassObject(&clsid, CLSCTX_INPROC_SERVER, NULL, &IID_IClassFactory, (void **)&unk);
+        ok(hr == HRESULT_FROM_WIN32(ERROR_MOD_NOT_FOUND), "Unexpected hr %#lx.\n", hr);
+        ok(!unk, "Unexpected pointer %p.\n", unk);
+        deactivate_context(handle, cookie);
+    }
+    CoUninitialize();
+}
+
 static void test_CoGetClassObject(void)
 {
     HRESULT hr;
@@ -4927,6 +4959,7 @@ START_TEST(compobj)
     test_CoCreateInstance();
     test_ole_menu();
     test_CoGetClassObject();
+    test_missing_server();
     test_CoCreateInstanceEx();
     test_CoRegisterMessageFilter();
     test_CoRegisterPSClsid();
