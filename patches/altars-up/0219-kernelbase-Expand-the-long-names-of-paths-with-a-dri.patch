From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 14:18:40 -0400
Subject: [PATCH] kernelbase: Expand the long names of \\?\ paths with a drive
 letter.

GetLongPathNameW gave any path that starts with two backslashes back as
it was, with a FIXME, whether it existed or not; the Click-to-Run
service asks it about five \\?\C:\ directories each time an Office
application starts.  Such a path is now expanded as the path after the
prefix is, the prefix kept, and fails with ERROR_FILE_NOT_FOUND when it
does not exist, which removes a todo_wine; UNC paths still come back as
they are.  The path is built in a buffer as long as an NT path may be,
where it overran one of 1024 characters before.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit a4c1a795437f4455afbd50791549b1312518afa5)

diff --git a/dlls/kernel32/tests/path.c b/dlls/kernel32/tests/path.c
index 4629786ddb5..bfe409b9251 100644
--- a/dlls/kernel32/tests/path.c
+++ b/dlls/kernel32/tests/path.c
@@ -1252,6 +1252,7 @@ static void test_GetLongPathNameW(void)
     WCHAR tempdir[MAX_PATH], name[200];
     WCHAR dirpath[4 + MAX_PATH + 200]; /* To ease removal */
     WCHAR shortpath[4 + MAX_PATH + 200 + 1 + 200];
+    WCHAR *longpath, *expected;
     static const WCHAR prefix[] = { '\\','\\','?','\\', 0};
     static const WCHAR backslash[] = { '\\', 0};
     static const WCHAR letterX[] = { 'X', 0};
@@ -1298,12 +1299,9 @@ static void test_GetLongPathNameW(void)
     /* With prefix */
     SetLastError(0xdeadbeef);
     length = GetLongPathNameW(shortpath, NULL, 0);
-    todo_wine
-    {
     ok(length == 0, "Expected 0, got %ld\n", length);
     ok(GetLastError() == ERROR_FILE_NOT_FOUND,
        "Expected ERROR_PATH_NOT_FOUND, got %ld\n", GetLastError());
-    }
 
     file = CreateFileW(shortpath, GENERIC_READ|GENERIC_WRITE, 0, NULL,
                        CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
@@ -1327,6 +1325,20 @@ static void test_GetLongPathNameW(void)
     length = GetLongPathNameW(shortpath, NULL, 0);
     ok(length == expanded, "Expected %ld, got %ld\n", expanded, length);
 
+    /* the prefix stays, and the temporary directory, which may be given with short names, is expanded */
+    longpath = malloc(expanded * sizeof(WCHAR));
+    expected = malloc(expanded * sizeof(WCHAR));
+    lstrcpyW(expected, prefix);
+    GetLongPathNameW(tempdir, expected + 4, expanded - 4);
+    lstrcatW(expected, name);
+    lstrcatW(expected, backslash);
+    lstrcatW(expected, name);
+    length = GetLongPathNameW(shortpath, longpath, expanded);
+    ok(length == expanded - 1, "Expected %ld, got %ld\n", expanded - 1, length);
+    ok(!lstrcmpiW(longpath, expected), "got %s, expected %s\n", wine_dbgstr_w(longpath), wine_dbgstr_w(expected));
+    free(longpath);
+    free(expected);
+
     /* NULL buffer with length crashes on Windows */
     if (0)
         GetLongPathNameW(shortpath, NULL, 20);
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index cf4924d349a..3b4bfc165da 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -2141,7 +2141,8 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetLongPathNameA( LPCSTR shortpath, LPSTR longpat
  */
 DWORD WINAPI DECLSPEC_HOTPATCH GetLongPathNameW( LPCWSTR shortpath, LPWSTR longpath, DWORD longlen )
 {
-    WCHAR tmplongpath[1024];
+    static const DWORD tmpsize = 32768;
+    WCHAR *tmplongpath;
     DWORD sp = 0, lp = 0, tmplen;
     WIN32_FIND_DATAW wfd;
     UNICODE_STRING nameW;
@@ -2161,7 +2162,11 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetLongPathNameW( LPCWSTR shortpath, LPWSTR longp
         return 0;
     }
 
-    if (shortpath[0] == '\\' && shortpath[1] == '\\')
+    /* \\?\C:\... is expanded as C:\... is, and keeps its prefix */
+    if (shortpath[0] == '\\' && shortpath[1] == '\\' && shortpath[2] == '?' && shortpath[3] == '\\' &&
+        shortpath[4] && shortpath[5] == ':')
+        sp = 4;
+    else if (shortpath[0] == '\\' && shortpath[1] == '\\')
     {
         FIXME( "UNC pathname %s\n", debugstr_w(shortpath) );
         tmplen = lstrlenW( shortpath );
@@ -2173,16 +2178,25 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetLongPathNameW( LPCWSTR shortpath, LPWSTR longp
         return tmplen + 1;
     }
 
+    if (!(tmplongpath = HeapAlloc( GetProcessHeap(), 0, tmpsize * sizeof(WCHAR) )))
+    {
+        SetLastError( ERROR_NOT_ENOUGH_MEMORY );
+        return 0;
+    }
+    memcpy( tmplongpath, shortpath, sp * sizeof(WCHAR) );
+    lp = sp;
+
     /* check for drive letter */
-    if (shortpath[0] != '/' && shortpath[1] == ':' )
+    if (shortpath[sp] != '/' && shortpath[sp + 1] == ':' )
     {
-        tmplongpath[0] = shortpath[0];
-        tmplongpath[1] = ':';
-        lp = sp = 2;
+        tmplongpath[lp++] = shortpath[sp++];
+        tmplongpath[lp++] = ':';
+        sp++;
     }
 
     if (wcspbrk( shortpath + sp, L"*?" ))
     {
+        HeapFree( GetProcessHeap(), 0, tmplongpath );
         SetLastError( ERROR_INVALID_NAME );
         return 0;
     }
@@ -2192,6 +2206,7 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetLongPathNameW( LPCWSTR shortpath, LPWSTR longp
         /* check for path delimiters and reproduce them */
         if (shortpath[sp] == '\\' || shortpath[sp] == '/')
         {
+            if (lp + 2 > tmpsize) goto too_long;
             tmplongpath[lp++] = shortpath[sp++];
             tmplongpath[lp] = 0; /* terminate string */
             continue;
@@ -2199,6 +2214,7 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetLongPathNameW( LPCWSTR shortpath, LPWSTR longp
 
         for (p = shortpath + sp; *p && *p != '/' && *p != '\\'; p++);
         tmplen = p - (shortpath + sp);
+        if (lp + max( tmplen, MAX_PATH ) + 2 > tmpsize) goto too_long;
         lstrcpynW( tmplongpath + lp, shortpath + sp, tmplen + 1 );
 
         if (tmplongpath[lp] == '.')
@@ -2216,6 +2232,7 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetLongPathNameW( LPCWSTR shortpath, LPWSTR longp
         if (handle == INVALID_HANDLE_VALUE)
         {
             TRACE( "not found %s\n", debugstr_w( tmplongpath ));
+            HeapFree( GetProcessHeap(), 0, tmplongpath );
             SetLastError ( ERROR_FILE_NOT_FOUND );
             return 0;
         }
@@ -2240,7 +2257,13 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetLongPathNameW( LPCWSTR shortpath, LPWSTR longp
         TRACE("returning %s\n", debugstr_w( longpath ));
         tmplen--; /* length without 0 */
     }
+    HeapFree( GetProcessHeap(), 0, tmplongpath );
     return tmplen;
+
+too_long:
+    HeapFree( GetProcessHeap(), 0, tmplongpath );
+    SetLastError( ERROR_FILENAME_EXCED_RANGE );
+    return 0;
 }
 
 
