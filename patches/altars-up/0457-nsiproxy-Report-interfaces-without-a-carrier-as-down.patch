From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 14:41:08 -0400
Subject: [PATCH] nsiproxy: Report interfaces without a carrier as down, and
 changes of links and routes.

An interface that is up but not running, its cable out or its radio not
associated, is down to Windows.  Link messages now notify the interface
tables and route messages of the main table the forward table, apart
from the scans and the like wireless drivers send as link messages.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/nsiproxy.sys/ndis.c b/dlls/nsiproxy.sys/ndis.c
index 5dde17244d9..e21326dcb97 100644
--- a/dlls/nsiproxy.sys/ndis.c
+++ b/dlls/nsiproxy.sys/ndis.c
@@ -351,7 +351,9 @@ static void ifinfo_fill_dynamic( struct if_entry *entry, struct nsi_ndis_ifinfo_
 
     if (!ioctl( fd, SIOCGIFFLAGS, &req ))
     {
-        if (req.ifr_flags & IFF_UP) data->oper_status = IfOperStatusUp;
+        /* an interface that is up but not running, a cable out or a radio not associated, is down to Windows */
+        if (!(req.ifr_flags & IFF_UP)) data->oper_status = IfOperStatusDown;
+        else if (req.ifr_flags & IFF_RUNNING) data->oper_status = IfOperStatusUp;
 #ifdef IFF_DORMANT
         else if (req.ifr_flags & IFF_DORMANT) data->oper_status = IfOperStatusDormant;
 #endif
diff --git a/dlls/nsiproxy.sys/nsi.c b/dlls/nsiproxy.sys/nsi.c
index 09ced8f814e..2c6ff9c81be 100644
--- a/dlls/nsiproxy.sys/nsi.c
+++ b/dlls/nsiproxy.sys/nsi.c
@@ -206,7 +206,7 @@ static NTSTATUS poll_events(void)
 
         memset( &addr, 0, sizeof(addr) );
         addr.nl_family = AF_NETLINK;
-        addr.nl_groups = RTMGRP_IPV4_IFADDR | RTMGRP_IPV6_IFADDR;
+        addr.nl_groups = RTMGRP_LINK | RTMGRP_IPV4_IFADDR | RTMGRP_IPV6_IFADDR | RTMGRP_IPV4_ROUTE | RTMGRP_IPV6_ROUTE;
         if (bind( netlink_fd, (struct sockaddr *)&addr, sizeof(addr) ) == -1)
         {
             close( netlink_fd );
@@ -242,6 +242,35 @@ static NTSTATUS poll_events(void)
                 }
                 if ((status = add_notification( module, NSI_IP_UNICAST_TABLE))) return status;
             }
+            else if (nlh->nlmsg_type == RTM_NEWLINK || nlh->nlmsg_type == RTM_DELLINK)
+            {
+                struct ifinfomsg *ifinfo = (struct ifinfomsg *)(nlh + 1);
+                int attr_len = IFLA_PAYLOAD( nlh );
+                struct rtattr *attr;
+                BOOL wireless = FALSE;
+
+                /* wireless drivers report scans and the like as link messages; those change nothing here */
+                for (attr = IFLA_RTA( ifinfo ); RTA_OK( attr, attr_len ); attr = RTA_NEXT( attr, attr_len ))
+                    if (attr->rta_type == IFLA_WIRELESS) wireless = TRUE;
+                if (wireless) continue;
+                /* an interface came, went or changed its state: the interface tables changed */
+                if ((status = add_notification( &NPI_MS_NDIS_MODULEID, NSI_NDIS_IFINFO_TABLE ))) return status;
+                if ((status = add_notification( &NPI_MS_IPV4_MODULEID, NSI_IP_INTERFACE_TABLE ))) return status;
+                if ((status = add_notification( &NPI_MS_IPV6_MODULEID, NSI_IP_INTERFACE_TABLE ))) return status;
+            }
+            else if (nlh->nlmsg_type == RTM_NEWROUTE || nlh->nlmsg_type == RTM_DELROUTE)
+            {
+                struct rtmsg *rtmsg = (struct rtmsg *)(nlh + 1);
+                const NPI_MODULEID *module;
+
+                /* only the main table is reported as the forward table, and cached routes come and go on
+                 * their own */
+                if (rtmsg->rtm_table != RT_TABLE_MAIN || (rtmsg->rtm_flags & RTM_F_CLONED)) continue;
+                if (rtmsg->rtm_family == AF_INET)       module = &NPI_MS_IPV4_MODULEID;
+                else if (rtmsg->rtm_family == AF_INET6) module = &NPI_MS_IPV6_MODULEID;
+                else continue;
+                if ((status = add_notification( module, NSI_IP_FORWARD_TABLE ))) return status;
+            }
         }
         if (queued_notification_count) break;
     }
