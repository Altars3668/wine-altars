From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:01:39 -0400
Subject: [PATCH] server: Fill the IOSB of a request that fails after going
 pending on a synchronous file too.

Current Windows 10 and 11 do, as the ntoskrnl tests show for a blocking
IRP and for every status a driver returns; only older Windows 10 left
the IOSB alone.  A request that fails at once still leaves it as it was.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntoskrnl.exe/tests/ntoskrnl.c b/dlls/ntoskrnl.exe/tests/ntoskrnl.c
index c9b99154c8b..8ec570f4e68 100644
--- a/dlls/ntoskrnl.exe/tests/ntoskrnl.c
+++ b/dlls/ntoskrnl.exe/tests/ntoskrnl.c
@@ -943,14 +943,12 @@ static void do_return_status(ULONG ioctl, struct return_status_params *params)
     }
     else
     {
-        todo_wine_if (NT_ERROR(params->iosb_status) && params->pending)
-            ok(io.Status == params->iosb_status /* newer win10/11 */
-                    || broken(NT_ERROR(params->iosb_status) && params->pending && io.Status == 0xdeadf00d), /* older win10 */
-                    "got %#lx\n", io.Status);
-        todo_wine_if (NT_ERROR(params->iosb_status) && params->pending)
-            ok(io.Information == 3 /* newer win10/11 */
-                    || broken(NT_ERROR(params->iosb_status) && params->pending && io.Information == 0xdeadf00d), /* older win10 */
-                    "got size %Iu\n", io.Information);
+        ok(io.Status == params->iosb_status /* newer win10/11 */
+                || broken(NT_ERROR(params->iosb_status) && params->pending && io.Status == 0xdeadf00d), /* older win10 */
+                "got %#lx\n", io.Status);
+        ok(io.Information == 3 /* newer win10/11 */
+                || broken(NT_ERROR(params->iosb_status) && params->pending && io.Information == 0xdeadf00d), /* older win10 */
+                "got size %Iu\n", io.Information);
     }
     ok(!strcmp(buffer, expect_buffer), "got buffer %s\n", buffer);
 
@@ -1397,9 +1395,9 @@ static void test_blocking_irp(void)
     io.Information = 0xdeadf00d;
     status = NtQueryVolumeInformationFile(file, &io, buffer, sizeof(buffer), FileFsFullSizeInformation);
     ok(status == STATUS_DEVICE_NOT_READY, "got %#lx\n", status);
-    todo_wine ok(io.Status == STATUS_DEVICE_NOT_READY || broken(io.Status == 0xdeadf00d), /* older win10 */
+    ok(io.Status == STATUS_DEVICE_NOT_READY || broken(io.Status == 0xdeadf00d), /* older win10 */
             "got iosb status %#lx\n", io.Status);
-    todo_wine ok(io.Information == 0 || broken(io.Information == 0xdeadf00d), /* older win10 */
+    ok(io.Information == 0 || broken(io.Information == 0xdeadf00d), /* older win10 */
             "got information %#Ix\n", io.Information);
 
     CloseHandle(file);
diff --git a/server/async.c b/server/async.c
index ca9bf69de32..2da5daf0a23 100644
--- a/server/async.c
+++ b/server/async.c
@@ -237,9 +237,10 @@ void async_terminate( struct async *async, unsigned int status )
 
         /* this can happen if the initial status was unknown (i.e. for device
          * files). the client should not fill the IOSB in this case; pass it as
-         * NULL to communicate that.
+         * NULL to communicate that.  a request that went pending fills it even
+         * on a synchronous file, as current Windows does.
          * note that we check the IOSB status and not the initial status */
-        if (NT_ERROR( status ) && (!is_fd_overlapped( async->fd ) || !async->pending))
+        if (NT_ERROR( status ) && !async->pending)
             data.async_io.sb = 0;
         else
             data.async_io.sb = async->data.iosb;
