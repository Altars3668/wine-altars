From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:01 -0400
Subject: [PATCH] winhttp: Check the IPv6 fast fallback option.

WINHTTP_OPTION_IPV6_FAST_FALLBACK takes a BOOL on a session and nothing
else, and is not one of a request's (tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/winhttp/session.c b/dlls/winhttp/session.c
index 0fb35f99250..6cb01f69010 100644
--- a/dlls/winhttp/session.c
+++ b/dlls/winhttp/session.c
@@ -347,12 +347,13 @@ static BOOL session_set_option( struct object_header *hdr, DWORD option, void *b
         return TRUE;
 
     case WINHTTP_OPTION_IPV6_FAST_FALLBACK:
+        /* connections try the addresses one after another as they are; it is not asked back */
         if (buflen != sizeof(BOOL))
         {
-            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            SetLastError( ERROR_INVALID_PARAMETER );
             return FALSE;
         }
-        FIXME( "WINHTTP_OPTION_IPV6_FAST_FALLBACK: %d\n", *(BOOL *)buffer );
+        TRACE( "WINHTTP_OPTION_IPV6_FAST_FALLBACK: %d\n", *(BOOL *)buffer );
         return TRUE;
 
     case WINHTTP_OPTION_ASSURED_NON_BLOCKING_CALLBACKS:
@@ -1438,6 +1439,11 @@ static BOOL request_set_option( struct object_header *hdr, DWORD option, void *b
         request->hdr.decompression = decompression;
         return TRUE;
     }
+    case WINHTTP_OPTION_IPV6_FAST_FALLBACK:
+        /* the session's */
+        SetLastError( ERROR_WINHTTP_INCORRECT_HANDLE_TYPE );
+        return FALSE;
+
     default:
         FIXME( "unimplemented option %lu\n", option );
         SetLastError( ERROR_WINHTTP_INVALID_OPTION );
