+DEFINE_IINSPECTABLE_( control_base2, IWebSocketControl2, struct websocket_control, impl_from_IWebSocketControl2,
+                      IWebSocketControl2_iface, &impl->IMessageWebSocketControl_iface )
+
+static HRESULT WINAPI control_base2_get_IgnorableServerCertificateErrors( IWebSocketControl2 *iface, IInspectable **value )
+{
