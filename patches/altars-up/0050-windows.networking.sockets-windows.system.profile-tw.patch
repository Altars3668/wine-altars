+    if (!token) return E_POINTER;
+    if (!handler) return E_INVALIDARG;
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed) ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_Release( impl->closed );
+    ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_AddRef( handler );
+    impl->closed = handler;
+    token->value = ++impl->next_token;
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
