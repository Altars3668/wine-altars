+/*
+ * MessageWebSocket itself.
+ *
+ * The transport is winhttp, which already speaks the protocol: the upgrade
+ * handshake, the framing, the close.  What this adds is the WinRT shape around
+ * it -- the request headers collected before the connection, the control
+ * object, the two events -- and a receive loop that turns frames back into
+ * MessageReceived.
+ */
+
+struct request_header
+{
+    struct list entry;
+    HSTRING name;
+    HSTRING value;
+};
+
+struct message_websocket
+{
+    IMessageWebSocket IMessageWebSocket_iface;
+    IWebSocket IWebSocket_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    struct list request_headers;
+    IMessageWebSocketControl *control;
+    struct websocket_transport transport;
+
+    ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs *message_received;
+    ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs *closed;
+    LONG64 next_token;
+
+    HANDLE receive_thread;
+    BOOL closing;
+};
+
+static inline struct message_websocket *impl_from_IMessageWebSocket( IMessageWebSocket *iface )
+{
+    return CONTAINING_RECORD( iface, struct message_websocket, IMessageWebSocket_iface );
+}
+
+static void transport_close( struct websocket_transport *transport )
+{
+    if (transport->socket) WinHttpCloseHandle( transport->socket );
+    if (transport->request) WinHttpCloseHandle( transport->request );
+    if (transport->connect) WinHttpCloseHandle( transport->connect );
+    if (transport->session) WinHttpCloseHandle( transport->session );
+    memset( transport, 0, sizeof(*transport) );
+}
+
+static HRESULT WINAPI socket_QueryInterface( IMessageWebSocket *iface, REFIID iid, void **out )
+{
+    struct message_websocket *impl = impl_from_IMessageWebSocket( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IMessageWebSocket ))
+    {
+        *out = &impl->IMessageWebSocket_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IWebSocket ))
+    {
+        *out = &impl->IWebSocket_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IClosable ))
+    {
+        *out = &impl->IClosable_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
