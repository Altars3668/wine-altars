+
+    TRACE( "iface %p, token %I64d.\n", iface, token.value );
+
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed)
+    {
+        ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_Release( impl->closed );
+        impl->closed = NULL;
+    }
