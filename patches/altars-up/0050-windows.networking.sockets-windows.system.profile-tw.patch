+++ b/dlls/windows.system.profile/retailinfo.c
@@ -0,0 +1,187 @@
+/* WinRT Windows.System.Profile.RetailInfo implementation
+ *
+ * Copyright 2026 AltarsCN
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ *
+ * This library is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the GNU
+ * Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public
+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(profile);
+
+/*
+ * RetailInfo describes a retail demo device: one of the machines standing on a
+ * shop floor running a canned demonstration.  This is not one, and there is no
+ * way for it to become one, so demo mode is off and the property bag that goes
+ * with it is empty.  That is the answer Windows gives on every machine that
+ * was not put into demo mode, not a placeholder for a real one.
+ *
+ * The empty bag is a PropertySet's view rather than a private map: the
+ * collection next door in wintypes is already written and already tested, and
+ * a second one here would only be a second thing to get wrong.
+ */
+
+struct retail_info_statics
+{
+    IActivationFactory IActivationFactory_iface;
+    IRetailInfoStatics IRetailInfoStatics_iface;
+    LONG ref;
+};
+
+static inline struct retail_info_statics *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct retail_info_statics, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct retail_info_statics *impl = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IActivationFactory ))
+    {
+        *out = &impl->IActivationFactory_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IRetailInfoStatics ))
+    {
+        *out = &impl->IRetailInfoStatics_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    struct retail_info_statics *impl = impl_from_IActivationFactory( iface );
+    return InterlockedIncrement( &impl->ref );
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    struct retail_info_statics *impl = impl_from_IActivationFactory( iface );
+    return InterlockedDecrement( &impl->ref );
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    FIXME( "iface %p, class_name %p stub!\n", iface, class_name );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    /* RetailInfo is reached through its statics; it has no constructor. */
+    TRACE( "iface %p, instance %p.\n", iface, instance );
+    if (instance) *instance = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    /* IInspectable methods */
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    /* IActivationFactory methods */
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( statics, IRetailInfoStatics, struct retail_info_statics, IActivationFactory_iface )
+
+static HRESULT WINAPI statics_get_IsDemoModeEnabled( IRetailInfoStatics *iface, boolean *value )
+{
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = FALSE;
+    return S_OK;
+}
+
+static HRESULT WINAPI statics_get_Properties( IRetailInfoStatics *iface, IMapView_HSTRING_IInspectable **value )
+{
+    static const WCHAR *property_set = RuntimeClass_Windows_Foundation_Collections_PropertySet;
+    IMap_HSTRING_IInspectable *map;
+    IInspectable *inspectable;
+    HSTRING classid;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+
+    if (FAILED(hr = WindowsCreateString( property_set, wcslen( property_set ), &classid ))) return hr;
+    hr = RoActivateInstance( classid, &inspectable );
+    WindowsDeleteString( classid );
+    if (FAILED(hr)) return hr;
+
+    hr = IInspectable_QueryInterface( inspectable, &IID_IMap_HSTRING_IInspectable, (void **)&map );
+    IInspectable_Release( inspectable );
+    if (FAILED(hr)) return hr;
+
+    hr = IMap_HSTRING_IInspectable_GetView( map, value );
+    IMap_HSTRING_IInspectable_Release( map );
+    return hr;
+}
+
+static const struct IRetailInfoStaticsVtbl statics_vtbl =
+{
+    statics_QueryInterface,
+    statics_AddRef,
+    statics_Release,
+    /* IInspectable methods */
+    statics_GetIids,
+    statics_GetRuntimeClassName,
+    statics_GetTrustLevel,
+    /* IRetailInfoStatics methods */
+    statics_get_IsDemoModeEnabled,
+    statics_get_Properties,
+};
+
+static struct retail_info_statics retail_info_statics =
+{
+    {&factory_vtbl},
+    {&statics_vtbl},
+    1,
+};
+
+IActivationFactory *retail_info_factory = &retail_info_statics.IActivationFactory_iface;
