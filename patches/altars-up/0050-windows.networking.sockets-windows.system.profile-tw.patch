+
+WINE_DEFAULT_DEBUG_CHANNEL(sockets);
+
+/*
+ * MessageWebSocketControl is a settings object: everything on it is a value
+ * the caller sets before connecting and reads back afterwards, so it is
+ * implemented outright.  The two credential slots and the certificate slots
+ * carry types from namespaces that are not here; they hold whatever they are
+ * given and hand it back, which is what the property contract asks for, and
+ * the transport ignores them until those types exist to be honoured.
+ */
+
+struct websocket_control
+{
+    IMessageWebSocketControl IMessageWebSocketControl_iface;
+    IMessageWebSocketControl2 IMessageWebSocketControl2_iface;
+    IWebSocketControl IWebSocketControl_iface;
+    IWebSocketControl2 IWebSocketControl2_iface;
+    LONG ref;
+
+    UINT32 outbound_buffer_size;
+    UINT32 max_message_size;
+    SocketMessageType message_type;
+    MessageWebSocketReceiveMode receive_mode;
+    TimeSpan desired_pong_interval;
+    IInspectable *server_credential;
+    IInspectable *proxy_credential;
+    IInspectable *client_certificate;
+};
+
+static inline struct websocket_control *impl_from_IMessageWebSocketControl( IMessageWebSocketControl *iface )
+{
+    return CONTAINING_RECORD( iface, struct websocket_control, IMessageWebSocketControl_iface );
+}
+
+static HRESULT WINAPI control_QueryInterface( IMessageWebSocketControl *iface, REFIID iid, void **out )
+{
+    struct websocket_control *impl = impl_from_IMessageWebSocketControl( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IMessageWebSocketControl ))
+    {
+        *out = &impl->IMessageWebSocketControl_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IMessageWebSocketControl2 ))
+    {
+        *out = &impl->IMessageWebSocketControl2_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IWebSocketControl ))
+    {
+        *out = &impl->IWebSocketControl_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    if (IsEqualGUID( iid, &IID_IWebSocketControl2 ))
+    {
+        *out = &impl->IWebSocketControl2_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI control_AddRef( IMessageWebSocketControl *iface )
+{
+    struct websocket_control *impl = impl_from_IMessageWebSocketControl( iface );
+    ULONG ref = InterlockedIncrement( &impl->ref );
+    TRACE( "iface %p increasing refcount to %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI control_Release( IMessageWebSocketControl *iface )
+{
+    struct websocket_control *impl = impl_from_IMessageWebSocketControl( iface );
+    ULONG ref = InterlockedDecrement( &impl->ref );
+
+    TRACE( "iface %p decreasing refcount to %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (impl->server_credential) IInspectable_Release( impl->server_credential );
+        if (impl->proxy_credential) IInspectable_Release( impl->proxy_credential );
+        if (impl->client_certificate) IInspectable_Release( impl->client_certificate );
+        free( impl );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI control_GetIids( IMessageWebSocketControl *iface, ULONG *iid_count, IID **iids )
+{
+    FIXME( "iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI control_GetRuntimeClassName( IMessageWebSocketControl *iface, HSTRING *class_name )
+{
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+    return WindowsCreateString( RuntimeClass_Windows_Networking_Sockets_MessageWebSocketControl,
+                                ARRAY_SIZE(RuntimeClass_Windows_Networking_Sockets_MessageWebSocketControl) - 1,
+                                class_name );
+}
+
+static HRESULT WINAPI control_GetTrustLevel( IMessageWebSocketControl *iface, TrustLevel *trust_level )
+{
+    FIXME( "iface %p, trust_level %p stub!\n", iface, trust_level );
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI control_get_MaxMessageSize( IMessageWebSocketControl *iface, UINT32 *value )
+{
