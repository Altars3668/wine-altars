+
+static HRESULT WINAPI socket_base_Close( IWebSocket *iface, UINT16 code, HSTRING reason )
+{
+    struct message_websocket *impl = impl_from_IWebSocket( iface );
+    const WCHAR *text = WindowsGetStringRawBuffer( reason, NULL );
+    char utf8[123];
+    int len = 0;
+
+    TRACE( "iface %p, code %u, reason %s.\n", iface, code, debugstr_hstring( reason ) );
+
+    EnterCriticalSection( &impl->cs );
+    impl->closing = TRUE;
+    if (impl->transport.socket)
+    {
+        /* The close reason travels as UTF-8 and the protocol caps it at 123
+         * bytes; anything longer is the caller's to shorten, not ours to
+         * truncate silently into a different message. */
+        if (text) len = WideCharToMultiByte( CP_UTF8, 0, text, -1, utf8, sizeof(utf8), NULL, NULL );
+        WinHttpWebSocketClose( impl->transport.socket, code, len > 0 ? utf8 : NULL, len > 0 ? len - 1 : 0 );
+        transport_close( &impl->transport );
+    }
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
