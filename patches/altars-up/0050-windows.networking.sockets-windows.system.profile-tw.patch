+static DWORD WINAPI receive_thread_proc( void *arg );
+static HRESULT create_closed_event_args( UINT16 code, const WCHAR *reason, IWebSocketClosedEventArgs **out );
+static HRESULT create_message_event_args( SocketMessageType type, boolean complete, BYTE *data, SIZE_T size,
+                                          IMessageWebSocketMessageReceivedEventArgs **out );
