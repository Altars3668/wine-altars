+static HRESULT WINAPI socket_base_SetRequestHeader( IWebSocket *iface, HSTRING name, HSTRING value )
+{
+    struct message_websocket *impl = impl_from_IWebSocket( iface );
+    struct request_header *header;
+    HRESULT hr;
+
+    TRACE( "iface %p, name %s, value %s.\n", iface, debugstr_hstring( name ), debugstr_hstring( value ) );
+
+    if (!name || !WindowsGetStringLen( name )) return E_INVALIDARG;
+    if (!(header = calloc( 1, sizeof(*header) ))) return E_OUTOFMEMORY;
+
+    if (FAILED(hr = WindowsDuplicateString( name, &header->name )) ||
+        FAILED(hr = WindowsDuplicateString( value, &header->value )))
+    {
+        WindowsDeleteString( header->name );
+        free( header );
+        return hr;
+    }
+
+    EnterCriticalSection( &impl->cs );
+    list_add_tail( &impl->request_headers, &header->entry );
+    LeaveCriticalSection( &impl->cs );
+    return S_OK;
+}
