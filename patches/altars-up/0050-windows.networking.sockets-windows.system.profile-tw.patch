+static HRESULT connect_async( IUnknown *invoker, IUnknown *param, PROPVARIANT *result )
+{
+    struct message_websocket *impl = impl_from_IMessageWebSocket( (IMessageWebSocket *)invoker );
+    IUriRuntimeClass *uri_class;
+    HSTRING raw = NULL;
+    HRESULT hr;
+
+    if (FAILED(hr = IUnknown_QueryInterface( param, &IID_IUriRuntimeClass, (void **)&uri_class )))
+    {
+        FIXME( "ConnectAsync needs a Windows.Foundation.Uri; got %p.\n", param );
+        return hr;
+    }
+    hr = IUriRuntimeClass_get_RawUri( uri_class, &raw );
+    IUriRuntimeClass_Release( uri_class );
+    if (FAILED(hr)) return hr;
+
+    hr = websocket_connect( impl, WindowsGetStringRawBuffer( raw, NULL ) );
+    WindowsDeleteString( raw );
+    return hr;
+}
