+static HRESULT websocket_connect( struct message_websocket *impl, const WCHAR *uri )
+{
+    WCHAR host[256], path[1024];
+    INTERNET_PORT port = 0;
+    struct request_header *header;
+    BOOL secure = FALSE;
+    HRESULT hr;
+
+    if (FAILED(hr = split_uri( uri, host, ARRAY_SIZE(host), &port, path, ARRAY_SIZE(path), &secure )))
+    {
+        WARN( "cannot parse %s.\n", debugstr_w( uri ) );
+        return hr;
+    }
+
+    TRACE( "connecting to %s port %u path %s%s.\n", debugstr_w( host ), port, debugstr_w( path ),
+           secure ? " (tls)" : "" );
+
+    if (!(impl->transport.session = WinHttpOpen( NULL, WINHTTP_ACCESS_TYPE_AUTOMATIC_PROXY,
+                                                 WINHTTP_NO_PROXY_NAME, WINHTTP_NO_PROXY_BYPASS, 0 )))
+        goto failed;
+    if (!(impl->transport.connect = WinHttpConnect( impl->transport.session, host, port, 0 )))
+        goto failed;
+    if (!(impl->transport.request = WinHttpOpenRequest( impl->transport.connect, L"GET", path, NULL,
+                                                        WINHTTP_NO_REFERER, WINHTTP_DEFAULT_ACCEPT_TYPES,
+                                                        secure ? WINHTTP_FLAG_SECURE : 0 )))
+        goto failed;
+
+    /* Whatever the caller asked to be sent with the handshake. */
+    LIST_FOR_EACH_ENTRY( header, &impl->request_headers, struct request_header, entry )
+    {
+        const WCHAR *name = WindowsGetStringRawBuffer( header->name, NULL );
+        const WCHAR *value = WindowsGetStringRawBuffer( header->value, NULL );
+        WCHAR *line;
+        SIZE_T len;
+
+        len = wcslen( name ) + wcslen( value ) + 3;
+        if (!(line = malloc( len * sizeof(WCHAR) ))) continue;
+        swprintf( line, len, L"%s: %s", name, value );
+        WinHttpAddRequestHeaders( impl->transport.request, line, -1, WINHTTP_ADDREQ_FLAG_ADD );
+        free( line );
+    }
+
+    if (!WinHttpSetOption( impl->transport.request, WINHTTP_OPTION_UPGRADE_TO_WEB_SOCKET, NULL, 0 ))
+        goto failed;
+    if (!WinHttpSendRequest( impl->transport.request, WINHTTP_NO_ADDITIONAL_HEADERS, 0,
+                             WINHTTP_NO_REQUEST_DATA, 0, 0, 0 ))
+        goto failed;
+    if (!WinHttpReceiveResponse( impl->transport.request, NULL ))
+        goto failed;
+    if (!(impl->transport.socket = WinHttpWebSocketCompleteUpgrade( impl->transport.request, 0 )))
+        goto failed;
+
+    /* The request handle has done its job once the upgrade is through. */
+    WinHttpCloseHandle( impl->transport.request );
+    impl->transport.request = NULL;
+
+    /* The thread holds a reference so the socket cannot go away under it. */
+    IMessageWebSocket_AddRef( &impl->IMessageWebSocket_iface );
+    if (!(impl->receive_thread = CreateThread( NULL, 0, receive_thread_proc, impl, 0, NULL )))
+    {
+        IMessageWebSocket_Release( &impl->IMessageWebSocket_iface );
+        hr = HRESULT_FROM_WIN32( GetLastError() );
+        transport_close( &impl->transport );
+        return hr;
+    }
+    return S_OK;
+
+failed:
+    hr = HRESULT_FROM_WIN32( GetLastError() );
+    WARN( "connect failed, hr %#lx.\n", hr );
+    transport_close( &impl->transport );
+    return hr;
+}
+
+/*
+ * One frame at a time out of winhttp, gathered into a message.
+ *
+ * winhttp reports each frame's type and whether it ends the message, which is
+ * what both receive modes need: FullMessage waits for the last fragment before
+ * raising the event, PartialMessage raises one per fragment.  A close frame
+ * ends the loop and raises Closed with the code and reason the peer sent, so a
+ * caller learns why rather than watching the socket go quiet.
+ */
+static DWORD WINAPI receive_thread_proc( void *arg )
+{
+    struct message_websocket *impl = arg;
+    BYTE *message = NULL;
+    SIZE_T message_size = 0;
+    SocketMessageType message_type = SocketMessageType_Binary;
+
+    for (;;)
+    {
+        WINHTTP_WEB_SOCKET_BUFFER_TYPE type;
+        BYTE frame[4096];
+        DWORD read = 0, err;
+        BOOL last, is_close;
+        void *grown;
+
+        err = WinHttpWebSocketReceive( impl->transport.socket, frame, sizeof(frame), &read, &type );
+        if (err)
+        {
+            TRACE( "receive ended, error %lu.\n", err );
+            break;
+        }
+
+        is_close = (type == WINHTTP_WEB_SOCKET_CLOSE_BUFFER_TYPE);
+        if (is_close) break;
+
+        last = (type == WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE ||
+                type == WINHTTP_WEB_SOCKET_BINARY_MESSAGE_BUFFER_TYPE);
+        if (type == WINHTTP_WEB_SOCKET_UTF8_MESSAGE_BUFFER_TYPE ||
+            type == WINHTTP_WEB_SOCKET_UTF8_FRAGMENT_BUFFER_TYPE)
+            message_type = SocketMessageType_Utf8;
+        else
+            message_type = SocketMessageType_Binary;
+
+        if (!(grown = realloc( message, message_size + read )))
+        {
+            ERR( "out of memory assembling a %Iu byte message.\n", message_size + read );
+            break;
+        }
+        message = grown;
+        memcpy( message + message_size, frame, read );
+        message_size += read;
+
+        EnterCriticalSection( &impl->cs );
+        if (impl->message_received)
+        {
+            MessageWebSocketReceiveMode mode = MessageWebSocketReceiveMode_FullMessage;
+            IMessageWebSocketControl2 *control2;
+
+            if (SUCCEEDED(IMessageWebSocketControl_QueryInterface( impl->control, &IID_IMessageWebSocketControl2,
+                                                                   (void **)&control2 )))
+            {
+                IMessageWebSocketControl2_get_ReceiveMode( control2, &mode );
+                IMessageWebSocketControl2_Release( control2 );
+            }
+
+            if (last || mode == MessageWebSocketReceiveMode_PartialMessage)
+            {
+                IMessageWebSocketMessageReceivedEventArgs *args;
+                ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs *handler;
+
+                handler = impl->message_received;
+                ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs_AddRef( handler );
+                /* The args take the buffer; the loop starts a fresh one. */
+                if (SUCCEEDED(create_message_event_args( message_type, last, message, message_size, &args )))
+                {
+                    message = NULL;
+                    message_size = 0;
+                    LeaveCriticalSection( &impl->cs );
+                    ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs_Invoke(
+                            handler, &impl->IMessageWebSocket_iface, args );
+                    IMessageWebSocketMessageReceivedEventArgs_Release( args );
+                    ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs_Release( handler );
+                    continue;
+                }
+                ITypedEventHandler_MessageWebSocket_MessageWebSocketMessageReceivedEventArgs_Release( handler );
+            }
+        }
+        LeaveCriticalSection( &impl->cs );
+    }
+
+    free( message );
+
+    /* Whatever ended the loop, the socket is done: say so, with the peer's own
+     * code and reason when it left one. */
+    EnterCriticalSection( &impl->cs );
+    if (impl->closed && !impl->closing)
+    {
+        ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs *handler = impl->closed;
+        IWebSocketClosedEventArgs *args;
+        USHORT code = 1006; /* closed abnormally: no close frame was seen */
+        WCHAR reason[124] = {0};
+        BYTE raw[123];
+        DWORD len = 0;
+
+        if (impl->transport.socket &&
+            !WinHttpWebSocketQueryCloseStatus( impl->transport.socket, &code, raw, sizeof(raw), &len ))
+            MultiByteToWideChar( CP_UTF8, 0, (char *)raw, len, reason, ARRAY_SIZE(reason) - 1 );
+
+        ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_AddRef( handler );
+        if (SUCCEEDED(create_closed_event_args( code, reason, &args )))
+        {
+            LeaveCriticalSection( &impl->cs );
+            ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_Invoke(
+                    handler, &impl->IWebSocket_iface, args );
+            IWebSocketClosedEventArgs_Release( args );
+            ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_Release( handler );
+            IMessageWebSocket_Release( &impl->IMessageWebSocket_iface );
+            return 0;
+        }
+        ITypedEventHandler_IWebSocket_WebSocketClosedEventArgs_Release( handler );
+    }
+    LeaveCriticalSection( &impl->cs );
+
+    IMessageWebSocket_Release( &impl->IMessageWebSocket_iface );
+    return 0;
+}
