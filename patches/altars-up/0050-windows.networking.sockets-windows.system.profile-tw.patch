+static const struct IMessageWebSocketControlVtbl control_vtbl =
+{
+    control_QueryInterface,
+    control_AddRef,
+    control_Release,
+    /* IInspectable methods */
+    control_GetIids,
+    control_GetRuntimeClassName,
+    control_GetTrustLevel,
+    /* IMessageWebSocketControl methods */
+    control_get_MaxMessageSize,
+    control_put_MaxMessageSize,
+    control_get_MessageType,
+    control_put_MessageType,
+};
+
+DEFINE_IINSPECTABLE_( control_base, IWebSocketControl, struct websocket_control, impl_from_IWebSocketControl,
+                      IWebSocketControl_iface, &impl->IMessageWebSocketControl_iface )
+
+static HRESULT WINAPI control_base_get_OutboundBufferSizeInBytes( IWebSocketControl *iface, UINT32 *value )
+{
+    struct websocket_control *impl = impl_from_IWebSocketControl( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->outbound_buffer_size;
+    return S_OK;
+}
+
+static HRESULT WINAPI control_base_put_OutboundBufferSizeInBytes( IWebSocketControl *iface, UINT32 value )
+{
+    struct websocket_control *impl = impl_from_IWebSocketControl( iface );
+
+    TRACE( "iface %p, value %u.\n", iface, value );
+
+    impl->outbound_buffer_size = value;
+    return S_OK;
+}
+
+/* The credential and certificate slots hold what they are given: the types
+ * belong to namespaces that are not here, and a property that refuses to
+ * remember what was set is worse than one that remembers something opaque. */
+#define CONTROL_OBJECT_PROPERTY( pfx, iface_type, name, field )                                    \
+    static HRESULT WINAPI pfx##_get_##name( iface_type *iface, IInspectable **value )              \
+    {                                                                                              \
+        struct websocket_control *impl = impl_from_##iface_type( iface );                          \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (!value) return E_POINTER;                                                              \
+        if ((*value = impl->field)) IInspectable_AddRef( *value );                                 \
+        return S_OK;                                                                               \
+    }                                                                                              \
+    static HRESULT WINAPI pfx##_put_##name( iface_type *iface, IInspectable *value )               \
+    {                                                                                              \
+        struct websocket_control *impl = impl_from_##iface_type( iface );                          \
+        TRACE( "iface %p, value %p.\n", iface, value );                                            \
+        if (value) IInspectable_AddRef( value );                                                   \
+        if (impl->field) IInspectable_Release( impl->field );                                      \
+        impl->field = value;                                                                       \
+        return S_OK;                                                                               \
+    }
+
+CONTROL_OBJECT_PROPERTY( control_base, IWebSocketControl, ServerCredential, server_credential )
+CONTROL_OBJECT_PROPERTY( control_base, IWebSocketControl, ProxyCredential, proxy_credential )
+
+static HRESULT WINAPI control_base_get_SupportedProtocols( IWebSocketControl *iface, IVector_HSTRING **value )
+{
+    FIXME( "iface %p, value %p: subprotocol negotiation is not implemented.\n", iface, value );
+    if (value) *value = NULL;
+    return E_NOTIMPL;
+}
+
+static const struct IWebSocketControlVtbl control_base_vtbl =
+{
+    control_base_QueryInterface,
+    control_base_AddRef,
+    control_base_Release,
+    /* IInspectable methods */
+    control_base_GetIids,
+    control_base_GetRuntimeClassName,
+    control_base_GetTrustLevel,
+    /* IWebSocketControl methods */
+    control_base_get_OutboundBufferSizeInBytes,
+    control_base_put_OutboundBufferSizeInBytes,
+    control_base_get_ServerCredential,
+    control_base_put_ServerCredential,
+    control_base_get_ProxyCredential,
+    control_base_put_ProxyCredential,
+    control_base_get_SupportedProtocols,
+};
