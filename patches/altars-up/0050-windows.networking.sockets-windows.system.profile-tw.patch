+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = impl->max_message_size;
+    return S_OK;
+}
+
+static HRESULT WINAPI control_put_MaxMessageSize( IMessageWebSocketControl *iface, UINT32 value )
+{
