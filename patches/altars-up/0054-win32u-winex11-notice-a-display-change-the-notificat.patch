@@ -1305,6 +1315,7 @@ static const struct user_driver_funcs lazy_load_driver =
     /* display modes */
     loaderdrv_ChangeDisplaySettings,
     loaderdrv_UpdateDisplayDevices,
+    loaderdrv_GetHostDisplayKey,
     /* windowing functions */
