+static HMENU create_menu( BOOL is_popup );
+static BOOL set_menu_info( HMENU handle, const MENUINFO *info );
+
+/* A menu of another process that this one draws and tracks, as the menu bar of a window of its own or as a popup, is
+ * drawn and tracked through a copy made here: the items as they are over there, with the handles of their submenus
+ * as they are, so that what the application hears of are the menus it knows.  A copy is brought up to date when the
+ * menu becomes a window's menu, when the menu bar is laid out or DrawMenuBar is called, and when the application has
+ * been told the menu is about to be shown. */
+struct menu_copy
+{
+    struct list entry;
+    HMENU       remote;  /* the menu of the other process */
+    HMENU       local;   /* the copy made here */
+};
+
+static struct list menu_copies = LIST_INIT( menu_copies );
+static pthread_mutex_t menu_copies_lock = PTHREAD_MUTEX_INITIALIZER;
+
+static HMENU find_menu_copy( HMENU remote )
+{
+    struct menu_copy *copy;
+    HMENU local = 0;
+
+    pthread_mutex_lock( &menu_copies_lock );
+    LIST_FOR_EACH_ENTRY( copy, &menu_copies, struct menu_copy, entry )
+    {
+        if (copy->remote != remote) continue;
+        local = copy->local;
+        break;
+    }
+    pthread_mutex_unlock( &menu_copies_lock );
+    return local;
+}
+
+/* forget the copy of a menu that is gone, and destroy it, which leaves its submenus alone */
+static void drop_menu_copy( HMENU remote )
+{
+    struct menu_copy *copy;
+    HMENU local = 0;
+
+    pthread_mutex_lock( &menu_copies_lock );
+    LIST_FOR_EACH_ENTRY( copy, &menu_copies, struct menu_copy, entry )
+    {
+        if (copy->remote != remote) continue;
+        local = copy->local;
+        list_remove( &copy->entry );
+        free( copy );
+        break;
+    }
+    pthread_mutex_unlock( &menu_copies_lock );
+    if (local) NtUserDestroyMenu( local );
+}
+
+/* bring a copy up to date with the menu of the other process */
+static BOOL refresh_menu_copy( HMENU local, HMENU remote, BOOL popup )
+{
+    MENUITEMINFOW info;
+    MENUINFO menu_info;
+    struct menu *menu;
+    WCHAR *text = NULL;
+    INT i, count;
+
+    if ((count = get_menu_item_count( remote )) < 0) return FALSE;
+    while (NtUserRemoveMenu( local, 0, MF_BYPOSITION )) ;  /* the submenus are not the copy's to destroy */
+
+    for (i = 0; i < count; i++)
+    {
+        memset( &info, 0, sizeof(info) );
+        info.cbSize = sizeof(info);
+        info.fMask = MIIM_FTYPE | MIIM_STATE | MIIM_ID | MIIM_SUBMENU | MIIM_CHECKMARKS | MIIM_DATA |
+                     MIIM_BITMAP | MIIM_STRING;
+        if (!NtUserThunkedMenuItemInfo( remote, i, MF_BYPOSITION, NtUserGetMenuItemInfoW, &info, NULL )) break;
+        if (info.cch)
+        {
+            UINT len = info.cch + 1;
+            WCHAR *new_text;
+
+            if (!(new_text = realloc( text, len * sizeof(WCHAR) ))) break;
+            text = new_text;
+            info.dwTypeData = text;
+            info.cch = len;
+            if (!NtUserThunkedMenuItemInfo( remote, i, MF_BYPOSITION, NtUserGetMenuItemInfoW, &info, NULL )) break;
+        }
+        else
+        {
+            info.fMask &= ~MIIM_STRING;
+            info.dwTypeData = NULL;
+        }
+        NtUserThunkedMenuItemInfo( local, i, MF_BYPOSITION, NtUserInsertMenuItem, &info, NULL );
+    }
+    free( text );
+
+    memset( &menu_info, 0, sizeof(menu_info) );
+    menu_info.cbSize = sizeof(menu_info);
+    menu_info.fMask = MIM_HELPID | MIM_MAXHEIGHT | MIM_MENUDATA | MIM_STYLE;  /* the brush is the other process's */
+    if (get_menu_info( remote, &menu_info )) set_menu_info( local, &menu_info );
+
+    if ((menu = grab_menu_ptr( local )))
+    {
+        if (popup) menu->wFlags |= MF_POPUP;
+        else menu->wFlags &= ~MF_POPUP;
+        menu->Height = 0;  /* laid out again */
+        release_menu_ptr( menu );
+    }
+    return TRUE;
+}
+
+/* the menu this process draws and tracks for one, itself or a copy of a menu of another process, made if needed
+ * and brought up to date if asked */
+static HMENU display_menu( HMENU handle, BOOL refresh, BOOL popup )
+{
+    struct menu_copy *copy, *other;
+    struct menu *menu;
+    HMENU local;
+
+    if (!handle || !is_other_process_menu( handle ))
+    {
+        if (handle && !is_menu( handle )) drop_menu_copy( handle );
+        return handle;
+    }
+    if (!(local = find_menu_copy( handle )))
+    {
+        if (!(local = create_menu( popup ))) return 0;
+        if ((menu = grab_menu_ptr( local )))
+        {
+            menu->remote = handle;
+            release_menu_ptr( menu );
+        }
+        if (!(copy = malloc( sizeof(*copy) )))
+        {
+            NtUserDestroyMenu( local );
+            return 0;
+        }
+        copy->remote = handle;
+        copy->local = local;
+        pthread_mutex_lock( &menu_copies_lock );
+        LIST_FOR_EACH_ENTRY( other, &menu_copies, struct menu_copy, entry )
+        {
+            if (other->remote != handle) continue;
+            free( copy );
+            copy = NULL;
+            break;
+        }
+        if (copy) list_add_tail( &menu_copies, &copy->entry );
+        pthread_mutex_unlock( &menu_copies_lock );
+        if (!copy)  /* another thread made one meanwhile */
+        {
+            NtUserDestroyMenu( local );
+            if (!(local = find_menu_copy( handle ))) return 0;
+        }
+        refresh = TRUE;
+    }
+    if (refresh && !refresh_menu_copy( local, handle, popup ))
+    {
+        drop_menu_copy( handle );
+        return 0;
+    }
+    return local;
+}
+
+/* the menu this process draws for one, without making a copy of a menu of another process */
+static HMENU shown_menu( HMENU handle )
+{
+    HMENU local;
+
+    if (handle && is_other_process_menu( handle ) && (local = find_menu_copy( handle ))) return local;
+    return handle;
+}
+
+/* the menu the application knows for one this process draws: a copy's menu of another process */
+static HMENU app_menu( HMENU handle )
+{
+    struct menu *menu;
+    HMENU ret = handle;
+
+    if (!handle || !(menu = grab_menu_ptr( handle ))) return handle;
+    if (menu->remote) ret = menu->remote;
+    release_menu_ptr( menu );
+    return ret;
+}
