From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 15:14:11 -0400
Subject: [PATCH] winegstreamer: Let the media sink place markers and ask for
 samples.

PlaceMarker() was a stub, so the sink writer could not mark a stream's
ticks and ends of segment, and the sink asked for no sample once it had
started, so a writer that waits for requests never delivered any.  A
marker now goes through the sink's command queue, keeping its place
among the samples, and is reported when reached; starting and
processing a sample each ask for the next one.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/winegstreamer/media_sink.c b/dlls/winegstreamer/media_sink.c
index 4933d6f666f..9c325394626 100644
--- a/dlls/winegstreamer/media_sink.c
+++ b/dlls/winegstreamer/media_sink.c
@@ -32,6 +32,7 @@ enum async_op
     ASYNC_STOP,
     ASYNC_PAUSE,
     ASYNC_PROCESS,
+    ASYNC_MARKER,
     ASYNC_FINALIZE,
 };
 
@@ -50,6 +51,11 @@ struct async_command
             UINT32 stream_id;
         } process;
         struct
+        {
+            DWORD stream_id;
+            PROPVARIANT context;
+        } marker;
+        struct
         {
             IMFAsyncResult *result;
         } finalize;
@@ -162,6 +168,8 @@ static ULONG WINAPI async_command_Release(IUnknown *iface)
     {
         if (command->op == ASYNC_PROCESS && command->u.process.sample)
             IMFSample_Release(command->u.process.sample);
+        else if (command->op == ASYNC_MARKER)
+            PropVariantClear(&command->u.marker.context);
         else if (command->op == ASYNC_FINALIZE && command->u.finalize.result)
             IMFAsyncResult_Release(command->u.finalize.result);
         free(command);
@@ -364,10 +372,27 @@ static HRESULT WINAPI stream_sink_ProcessSample(IMFStreamSink *iface, IMFSample
 static HRESULT WINAPI stream_sink_PlaceMarker(IMFStreamSink *iface, MFSTREAMSINK_MARKER_TYPE marker_type,
         const PROPVARIANT *marker_value, const PROPVARIANT *context_value)
 {
-    FIXME("iface %p, marker_type %d, marker_value %p, context_value %p stub!\n",
+    struct stream_sink *stream_sink = impl_from_IMFStreamSink(iface);
+    struct media_sink *media_sink = impl_from_IMFFinalizableMediaSink(stream_sink->media_sink);
+    struct async_command *command;
+    HRESULT hr;
+
+    TRACE("iface %p, marker_type %d, marker_value %p, context_value %p.\n",
             iface, marker_type, marker_value, context_value);
 
-    return E_NOTIMPL;
+    EnterCriticalSection(&media_sink->cs);
+    if (media_sink->state == STATE_SHUTDOWN)
+        hr = MF_E_SHUTDOWN;
+    else if (SUCCEEDED(hr = async_command_create(ASYNC_MARKER, &command)))
+    {
+        command->u.marker.stream_id = stream_sink->id;
+        if (!context_value || SUCCEEDED(hr = PropVariantCopy(&command->u.marker.context, context_value)))
+            hr = MFPutWorkItem(MFASYNC_CALLBACK_QUEUE_STANDARD,
+                    &media_sink->async_callback, &command->IUnknown_iface);
+        IUnknown_Release(&command->IUnknown_iface);
+    }
+    LeaveCriticalSection(&media_sink->cs);
+    return hr;
 }
 
 static HRESULT WINAPI stream_sink_Flush(IMFStreamSink *iface)
@@ -601,7 +626,9 @@ static HRESULT media_sink_start(struct media_sink *media_sink)
 
     media_sink->state = STATE_STARTED;
 
-    return media_sink_queue_stream_event(media_sink, MEStreamSinkStarted);
+    if (FAILED(hr = media_sink_queue_stream_event(media_sink, MEStreamSinkStarted)))
+        return hr;
+    return media_sink_queue_stream_event(media_sink, MEStreamSinkRequestSample);
 }
 
 static HRESULT media_sink_stop(struct media_sink *media_sink)
@@ -651,6 +678,16 @@ static HRESULT media_sink_process(struct media_sink *media_sink, IMFSample *samp
     hr = wg_muxer_push_sample(muxer, wg_sample, stream_id);
     wg_sample_release(wg_sample);
 
+    if (SUCCEEDED(hr))
+    {
+        struct stream_sink *stream_sink = media_sink_get_stream_sink_by_id(media_sink, stream_id);
+
+        if (stream_sink)
+            hr = IMFMediaEventQueue_QueueEventParamVar(stream_sink->event_queue,
+                    MEStreamSinkRequestSample, &GUID_NULL, S_OK, NULL);
+        else
+            hr = MF_E_SHUTDOWN;
+    }
     return hr;
 }
 
@@ -1258,6 +1295,14 @@ static HRESULT WINAPI media_sink_callback_Invoke(IMFAsyncCallback *iface, IMFAsy
             if (FAILED(hr = media_sink_process(media_sink, command->u.process.sample, command->u.process.stream_id)))
                 WARN("Failed to process sample, hr %#lx.\n", hr);
             break;
+        case ASYNC_MARKER:
+        {
+            struct stream_sink *stream_sink = media_sink_get_stream_sink_by_id(media_sink, command->u.marker.stream_id);
+
+            hr = stream_sink ? IMFMediaEventQueue_QueueEventParamVar(stream_sink->event_queue,
+                    MEStreamSinkMarker, &GUID_NULL, S_OK, &command->u.marker.context) : MF_E_SHUTDOWN;
+            break;
+        }
         case ASYNC_FINALIZE:
             if (FAILED(hr = media_sink_finalize(media_sink, command->u.finalize.result)))
                 WARN("Failed to finalize, hr %#lx.\n", hr);
