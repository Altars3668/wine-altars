From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 07:14:12 -0400
Subject: [PATCH] wbemdisp: Implement SWbemProperty's IsArray, and give an
 array the type of its elements.

IsArray was a stub, and CIMType failed for any array, since the array flag
is not a type of its own; a script listing a class's properties got error
445 for every one.  Windows 11 says Win32_SystemEnclosure's ChassisTypes is
a uint16 array and Manufacturer a string that is not one.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wbemdisp/locator.c b/dlls/wbemdisp/locator.c
index 8cb96344cfa..a81d2d2a7ba 100644
--- a/dlls/wbemdisp/locator.c
+++ b/dlls/wbemdisp/locator.c
@@ -333,7 +333,8 @@ static HRESULT WINAPI property_get_CIMType( ISWbemProperty *iface, WbemCimtypeEn
     hr = IWbemClassObject_Get( property->object, property->name, 0, &dummy, &type, NULL );
     if (SUCCEEDED( hr ))
     {
-        hr = map_cim_type( type, &cim_type );
+        /* an array's is the type of its elements */
+        hr = map_cim_type( type & ~CIM_FLAG_ARRAY, &cim_type );
         if (SUCCEEDED( hr )) *ret_type = cim_type;
         VariantClear( &dummy );
     }
@@ -346,10 +347,22 @@ static HRESULT WINAPI property_get_Qualifiers_( ISWbemProperty *iface, ISWbemQua
     return E_NOTIMPL;
 }
 
-static HRESULT WINAPI property_get_IsArray( ISWbemProperty *iface, VARIANT_BOOL *bIsArray )
+static HRESULT WINAPI property_get_IsArray( ISWbemProperty *iface, VARIANT_BOOL *ret )
 {
-    FIXME( "\n" );
-    return E_NOTIMPL;
+    struct property *property = impl_from_ISWbemProperty( iface );
+    VARIANT dummy;
+    CIMTYPE type;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", iface, ret );
+
+    hr = IWbemClassObject_Get( property->object, property->name, 0, &dummy, &type, NULL );
+    if (SUCCEEDED( hr ))
+    {
+        *ret = type & CIM_FLAG_ARRAY ? VARIANT_TRUE : VARIANT_FALSE;
+        VariantClear( &dummy );
+    }
+    return hr;
 }
 
 static const ISWbemPropertyVtbl property_vtbl =
diff --git a/dlls/wbemdisp/tests/wbemdisp.c b/dlls/wbemdisp/tests/wbemdisp.c
index 4fc59dfc67f..5d396ddd25e 100644
--- a/dlls/wbemdisp/tests/wbemdisp.c
+++ b/dlls/wbemdisp/tests/wbemdisp.c
@@ -634,6 +634,87 @@ todo_wine {
     ISWbemNamedValueSet_Release(set);
 }
 
+/* what a property says about its type: an array's CIM type is that of its elements */
+static void test_property_types(void)
+{
+    static const struct
+    {
+        const WCHAR *name;
+        WbemCimtypeEnum type;
+        VARIANT_BOOL array;
+    }
+    tests[] =
+    {
+        { L"ChassisTypes", wbemCimtypeUint16, VARIANT_TRUE },
+        { L"Manufacturer", wbemCimtypeString, VARIANT_FALSE },
+    };
+    ISWbemPropertySet *props;
+    ISWbemObjectSet *objects;
+    ISWbemServices *services;
+    ISWbemLocator *locator;
+    WbemCimtypeEnum type;
+    ISWbemProperty *prop;
+    ISWbemObject *object;
+    IEnumVARIANT *items;
+    VARIANT_BOOL array;
+    unsigned int i;
+    IUnknown *unk;
+    VARIANT var;
+    BSTR str, lang;
+    HRESULT hr;
+
+    hr = CoCreateInstance( &CLSID_SWbemLocator, NULL, CLSCTX_INPROC_SERVER, &IID_ISWbemLocator, (void **)&locator );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    str = SysAllocString( L"root\\CIMV2" );
+    hr = ISWbemLocator_ConnectServer( locator, NULL, str, NULL, NULL, NULL, NULL, 0, NULL, &services );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( str );
+    str = SysAllocString( L"SELECT * FROM Win32_SystemEnclosure" );
+    lang = SysAllocString( L"WQL" );
+    hr = ISWbemServices_ExecQuery( services, str, lang, wbemFlagForwardOnly, NULL, &objects );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    SysFreeString( lang );
+    SysFreeString( str );
+    hr = ISWbemObjectSet_get__NewEnum( objects, &unk );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUnknown_QueryInterface( unk, &IID_IEnumVARIANT, (void **)&items );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    IUnknown_Release( unk );
+    VariantInit( &var );
+    hr = IEnumVARIANT_Next( items, 1, &var, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IDispatch_QueryInterface( V_DISPATCH(&var), &IID_ISWbemObject, (void **)&object );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    VariantClear( &var );
+    hr = ISWbemObject_get_Properties_( object, &props );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    for (i = 0; i < ARRAY_SIZE( tests ); i++)
+    {
+        str = SysAllocString( tests[i].name );
+        hr = ISWbemPropertySet_Item( props, str, 0, &prop );
+        ok( hr == S_OK, "%s: got %#lx\n", debugstr_w(tests[i].name), hr );
+        SysFreeString( str );
+        if (FAILED( hr )) continue;
+        type = 0xdeadbeef;
+        hr = ISWbemProperty_get_CIMType( prop, &type );
+        ok( hr == S_OK, "%s: got %#lx\n", debugstr_w(tests[i].name), hr );
+        ok( type == tests[i].type, "%s: got type %d\n", debugstr_w(tests[i].name), type );
+        array = 0xdead;
+        hr = ISWbemProperty_get_IsArray( prop, &array );
+        ok( hr == S_OK, "%s: got %#lx\n", debugstr_w(tests[i].name), hr );
+        ok( array == tests[i].array, "%s: got %#x\n", debugstr_w(tests[i].name), array );
+        ISWbemProperty_Release( prop );
+    }
+
+    ISWbemPropertySet_Release( props );
+    ISWbemObject_Release( object );
+    IEnumVARIANT_Release( items );
+    ISWbemObjectSet_Release( objects );
+    ISWbemServices_Release( services );
+    ISWbemLocator_Release( locator );
+}
+
 /* The class object has no IParseDisplayName, in any context; MkParseDisplayName gets one from an instance. */
 static void test_class_object(void)
 {
@@ -684,6 +765,7 @@ START_TEST(wbemdisp)
     test_ParseDisplayName();
     test_class_object();
     test_locator();
+    test_property_types();
     test_namedvalueset();
 
     CoUninitialize();
