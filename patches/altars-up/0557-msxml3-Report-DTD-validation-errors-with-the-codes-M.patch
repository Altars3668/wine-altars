From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 10:49:26 -0400
Subject: [PATCH] msxml3: Report DTD validation errors with the codes MSXML
 gives them.

Validation through libxml2 reported every DTD error as E_XML_INVALID, or
E_XML_EMPTY_NOT_ALLOWED when the root element had no children.  MSXML
has a code for each, and Wine's tests know ten of them from Windows.
Catch the first error libxml2 raises with a structured error handler and
name it: an undeclared element, an IDREF to no ID, the root element not
the DOCTYPE's, an undeclared attribute, a value other than the #FIXED one
or not one of those allowed, a #REQUIRED attribute missing; and for
content the DTD does not allow, text where only elements may be, no
elements where some must be, or the wrong elements.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 77d2c8d2637..3dc9ec4c0d5 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -5203,6 +5203,45 @@ static void LIBXML2_LOG_CALLBACK validate_warning(void* ctx, char const* msg, ..
     va_end(ap);
 }
 
+/* the first error DTD validation raises, as MSXML names it */
+static void dtd_validation_error(void *ctx, const xmlError *error)
+{
+    HRESULT *code = ctx;
+    xmlNodePtr child, node = error->node;
+    BOOL elements = FALSE, text = FALSE;
+
+    TRACE("%d: %s", error->code, debugstr_a(error->message));
+    if (*code || error->domain != XML_FROM_VALID || error->level < XML_ERR_ERROR) return;
+    switch (error->code)
+    {
+    case XML_DTD_UNKNOWN_ELEM: *code = E_XML_ELEMENT_UNDECLARED; break;
+    case XML_DTD_UNKNOWN_ID: *code = E_XML_ELEMENT_ID_NOT_FOUND; break;
+    case XML_DTD_ROOT_NAME: *code = E_XML_ROOT_NAME_MISMATCH; break;
+    case XML_DTD_UNKNOWN_ATTRIBUTE: *code = E_XML_ATTRIBUTE_NOT_DEFINED; break;
+    case XML_DTD_ATTRIBUTE_DEFAULT: *code = E_XML_ATTRIBUTE_FIXED; break;
+    case XML_DTD_ATTRIBUTE_VALUE: *code = E_XML_ATTRIBUTE_VALUE; break;
+    case XML_DTD_MISSING_ATTRIBUTE: *code = E_XML_REQUIRED_ATTRIBUTE_MISSING; break;
+    case XML_DTD_CONTENT_MODEL:
+    case XML_DTD_NOT_EMPTY:
+    case XML_DTD_NOT_PCDATA:
+        /* MSXML tells apart text where only elements may be, no elements where some must be,
+         * and the wrong elements */
+        for (child = node && node->type == XML_ELEMENT_NODE ? node->children : NULL; child; child = child->next)
+        {
+            if (child->type == XML_ELEMENT_NODE) elements = TRUE;
+            else if ((child->type == XML_TEXT_NODE || child->type == XML_CDATA_SECTION_NODE) &&
+                    !xmlIsBlankNode(child)) text = TRUE;
+        }
+        if (error->code == XML_DTD_CONTENT_MODEL && text) *code = E_XML_ILLEGAL_TEXT;
+        else if (error->code == XML_DTD_CONTENT_MODEL && !elements) *code = E_XML_EMPTY_NOT_ALLOWED;
+        else *code = E_XML_INVALID_CONTENT;
+        break;
+    default:
+        *code = E_XML_INVALID;
+        break;
+    }
+}
+
 static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, struct parse_error *error)
 {
     IXMLDOMSchemaCollection2 *schema = doc->properties->schemaCache;
@@ -5221,17 +5260,21 @@ static HRESULT node_validate_tree(struct domnode *doc, struct domnode *node, str
     if (!doc->properties->new_parser && (xmldoc->intSubset || xmldoc->extSubset))
     {
         xmlValidCtxtPtr context = xmlNewValidCtxt();
+        xmlStructuredErrorFunc handler = xmlStructuredError;
+        void *handler_context = xmlStructuredErrorContext;
+        HRESULT code = S_OK;
         int valid;
 
         if (!context) { xmlFreeDoc(xmldoc); return E_OUTOFMEMORY; }
         context->error = validate_error;
         context->warning = validate_warning;
         ++validated;
+        xmlSetStructuredErrorFunc(&code, dtd_validation_error);
         valid = node == doc ? xmlValidateDocument(context, xmldoc) : xmlValidateElement(context, xmldoc, xmlnode);
+        xmlSetStructuredErrorFunc(handler_context, handler);
         if (!valid)
         {
-            xmlNodePtr root = node == doc ? xmlDocGetRootElement(xmldoc) : xmlnode;
-            error->code = root && !root->children ? E_XML_EMPTY_NOT_ALLOWED : E_XML_INVALID;
+            error->code = code ? code : E_XML_INVALID;
             hr = S_FALSE;
         }
         xmlFreeValidCtxt(context);
