@@ -306,6 +308,21 @@ static void test_ink(void)
     n = read_longs(&v, values, ARRAY_SIZE(values));
     ok(n == 2 && values[0] == 1010 && values[1] == 990, "Got %ld %ld.\n", values[0], values[1]);
 
+    /* where scaling to a rectangle puts the points: whether the box it maps is the one GetBoundingBox gives */
+    if ((box = create(&CLSID_InkRectangle, &IID_IInkRectangle)))
+    {
+        unsigned int i;
+
+        IInkRectangle_SetRectangle(box, 0, 0, 500, 1000);
+        hr = IInkStrokeDisp_ScaleToRectangle(stroke2, box);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        IInkRectangle_Release(box);
+        hr = IInkStrokeDisp_GetPoints(stroke2, 0, -1, &v);
+        ok(hr == S_OK, "Got hr %#lx.\n", hr);
+        n = read_longs(&v, values, ARRAY_SIZE(values));
+        for (i = 0; i + 1 < n; i += 2) trace("scaled point %ld,%ld.\n", values[i], values[i + 1]);
+    }
+
     hr = IInkDisp_get_Strokes(ink, &strokes);
     ok(hr == S_OK, "Got hr %#lx.\n", hr);
     hr = IInkStrokes_get_Count(strokes, &count);
