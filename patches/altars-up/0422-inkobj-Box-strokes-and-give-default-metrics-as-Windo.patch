     {
@@ -291,7 +292,8 @@ static void test_ink(void)
 
         hr = IInkStrokeDisp_GetPacketDescriptionPropertyMetrics(stroke, name, &minimum, &maximum, &units, &resolution);
         ok(hr == S_OK, "Got hr %#lx.\n", hr);
-        trace("X metrics %ld..%ld, units %d, resolution %f.\n", minimum, maximum, units, resolution);
+        ok(minimum == INT_MIN && maximum == INT_MAX && units == TPMU_Centimeters && resolution == 1000.0f,
+                "Got X metrics %ld..%ld, units %d, resolution %f.\n", minimum, maximum, units, resolution);
         SysFreeString(name);
