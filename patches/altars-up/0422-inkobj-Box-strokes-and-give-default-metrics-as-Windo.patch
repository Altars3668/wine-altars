From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 06:55:09 -0400
Subject: [PATCH] inkobj: Box strokes and give default metrics as Windows 11
 does.

GetBoundingBox's rectangle ends one past the last point, and the pen widens
it by half its width, rounded down: points from 1000 to 3000 box as
1000-3001, and with the default pen, 53 wide, as 974-3027.  The bounds a
stroke is scaled to a rectangle by are left as they were; the test traces
where scaling puts the points.  A stroke made without a packet description
has its X and Y anywhere, INT_MIN to INT_MAX in himetric.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/inkobj/ink.c b/dlls/inkobj/ink.c
index 0d13c2100ea..2bbdd3e3035 100644
--- a/dlls/inkobj/ink.c
+++ b/dlls/inkobj/ink.c
@@ -137,8 +137,10 @@ static void default_metrics(const GUID *guid, struct property_metrics *metrics)
 {
     metrics->minimum = 0;
     metrics->maximum = INT_MAX;
+    /* a position may be anywhere: Windows 11 gives INT_MIN..INT_MAX in himetric */
     if (IsEqualGUID(guid, &GUID_PACKETPROPERTY_GUID_X) || IsEqualGUID(guid, &GUID_PACKETPROPERTY_GUID_Y))
     {
+        metrics->minimum = INT_MIN;
         metrics->units = TPMU_Centimeters;
         metrics->resolution = 1000.0f;
     }
@@ -193,9 +195,11 @@ static void stroke_data_transform(struct stroke_data *data, const XFORM *xform,
     }
 }
 
-/* the bounds of the points, or of the pen's trace over them, through a transform */
+/* The bounds of the points, or of the pen's trace over them, through a transform.  The box GetBoundingBox
+ * gives ends one past the last point, as rectangles do, and the pen widens it by half its width, rounded
+ * down: Windows 11 boxes points from 1000 to 3000 as 1000-3001, and 974-3027 with its pen 53 wide. */
 HRESULT stroke_data_bounds(const struct stroke_data *data, IInkDrawingAttributes *attributes,
-        InkBoundingBoxMode mode, const XFORM *xform, BOOL scale_width, RECT *rect)
+        InkBoundingBoxMode mode, const XFORM *xform, BOOL scale_width, BOOL box, RECT *rect)
 {
     float left = FLT_MAX, top = FLT_MAX, right = -FLT_MAX, bottom = -FLT_MAX;
     float width = 0.0f, height = 0.0f;
@@ -237,6 +241,14 @@ HRESULT stroke_data_bounds(const struct stroke_data *data, IInkDrawingAttributes
         }
     }
 
+    if (box)
+    {
+        rect->left = floorf(left) - (LONG)(width / 2.0f);
+        rect->top = floorf(top) - (LONG)(height / 2.0f);
+        rect->right = floorf(right) + 1 + (LONG)(width / 2.0f);
+        rect->bottom = floorf(bottom) + 1 + (LONG)(height / 2.0f);
+        return S_OK;
+    }
     rect->left = floorf(left - width / 2.0f);
     rect->top = floorf(top - height / 2.0f);
     rect->right = ceilf(right + width / 2.0f);
@@ -855,7 +867,7 @@ static HRESULT WINAPI stroke_GetBoundingBox(IInkStrokeDisp *iface, InkBoundingBo
 
     if (!out) return E_POINTER;
     if (FAILED(hr = stroke_lock(stroke))) return hr;
-    hr = stroke_data_bounds(stroke->data, NULL, mode, NULL, FALSE, &rect);
+    hr = stroke_data_bounds(stroke->data, NULL, mode, NULL, FALSE, TRUE, &rect);
     stroke_unlock(stroke, FALSE);
     if (FAILED(hr)) return hr;
     return rectangle_create(&rect, out);
@@ -1273,7 +1285,7 @@ static HRESULT WINAPI stroke_ScaleToRectangle(IInkStrokeDisp *iface, IInkRectang
 
     if (FAILED(hr = rectangle_get(rectangle, &target))) return hr;
     if (FAILED(hr = stroke_lock(stroke))) return hr;
-    stroke_data_bounds(stroke->data, NULL, IBBM_PointsOnly, NULL, FALSE, &bounds);
+    stroke_data_bounds(stroke->data, NULL, IBBM_PointsOnly, NULL, FALSE, FALSE, &bounds);
     scale_to_rectangle(&bounds, &target, &xform);
     stroke_data_transform(stroke->data, &xform, FALSE);
     stroke_unlock(stroke, TRUE);
@@ -1835,7 +1847,7 @@ static HRESULT WINAPI strokes_ModifyDrawingAttributes(IInkStrokes *iface, IInkDr
 }
 
 static HRESULT strokes_bounds(struct stroke_data **items, unsigned int count, InkBoundingBoxMode mode,
-        const XFORM *xform, BOOL scale_width, RECT *rect)
+        const XFORM *xform, BOOL scale_width, BOOL box, RECT *rect)
 {
     BOOL first = TRUE;
     unsigned int i;
@@ -1847,7 +1859,7 @@ static HRESULT strokes_bounds(struct stroke_data **items, unsigned int count, In
         RECT bounds;
 
         if (items[i]->deleted || !items[i]->packet_count) continue;
-        if (FAILED(hr = stroke_data_bounds(items[i], NULL, mode, xform, scale_width, &bounds)))
+        if (FAILED(hr = stroke_data_bounds(items[i], NULL, mode, xform, scale_width, box, &bounds)))
             return hr;
         if (first) *rect = bounds;
         else
@@ -1872,7 +1884,7 @@ static HRESULT WINAPI strokes_GetBoundingBox(IInkStrokes *iface, InkBoundingBoxM
 
     if (!out) return E_POINTER;
     EnterCriticalSection(&strokes->ink->cs);
-    hr = strokes_bounds(strokes->items, strokes->count, mode, NULL, FALSE, &rect);
+    hr = strokes_bounds(strokes->items, strokes->count, mode, NULL, FALSE, TRUE, &rect);
     LeaveCriticalSection(&strokes->ink->cs);
     if (FAILED(hr)) return hr;
     return rectangle_create(&rect, out);
@@ -1912,7 +1924,7 @@ static HRESULT WINAPI strokes_ScaleToRectangle(IInkStrokes *iface, IInkRectangle
 
     if (FAILED(hr = rectangle_get(rectangle, &target))) return hr;
     EnterCriticalSection(&strokes->ink->cs);
-    strokes_bounds(strokes->items, strokes->count, IBBM_PointsOnly, NULL, FALSE, &bounds);
+    strokes_bounds(strokes->items, strokes->count, IBBM_PointsOnly, NULL, FALSE, FALSE, &bounds);
     scale_to_rectangle(&bounds, &target, &xform);
     strokes_transform(strokes, &xform, FALSE);
     LeaveCriticalSection(&strokes->ink->cs);
@@ -2464,7 +2476,7 @@ static HRESULT WINAPI ink_GetBoundingBox(IInkDisp *iface, InkBoundingBoxMode mod
 
     if (!out) return E_POINTER;
     if (FAILED(hr = ink_get_data(ink, &data, &count))) return hr;
-    hr = strokes_bounds(data, count, mode, NULL, FALSE, &rect);
+    hr = strokes_bounds(data, count, mode, NULL, FALSE, TRUE, &rect);
     strokes_free_data(data, count);
     if (FAILED(hr)) return hr;
     return rectangle_create(&rect, out);
@@ -2912,7 +2924,7 @@ static HRESULT WINAPI ink_AddStrokesAtRectangle(IInkDisp *iface, IInkStrokes *st
 
     if (FAILED(hr = rectangle_get(rectangle, &target))) return hr;
     if (FAILED(hr = strokes_get_data(strokes, &data, &count))) return hr;
-    strokes_bounds(data, count, IBBM_PointsOnly, NULL, FALSE, &bounds);
+    strokes_bounds(data, count, IBBM_PointsOnly, NULL, FALSE, FALSE, &bounds);
     scale_to_rectangle(&bounds, &target, &xform);
     for (i = 0; SUCCEEDED(hr) && i < count; ++i)
     {
diff --git a/dlls/inkobj/inkobj_private.h b/dlls/inkobj/inkobj_private.h
index 2f33fc9621a..4e5f2cc8f5f 100644
--- a/dlls/inkobj/inkobj_private.h
+++ b/dlls/inkobj/inkobj_private.h
@@ -164,7 +164,7 @@ HRESULT strokes_get_data(IInkStrokes *iface, struct stroke_data ***data, unsigne
 void strokes_free_data(struct stroke_data **data, unsigned int count);
 void stroke_data_release(struct stroke_data *data);
 HRESULT stroke_data_bounds(const struct stroke_data *data, IInkDrawingAttributes *attributes,
-        InkBoundingBoxMode mode, const XFORM *xform, BOOL scale_width, RECT *rect);
+        InkBoundingBoxMode mode, const XFORM *xform, BOOL scale_width, BOOL box, RECT *rect);
 
 /* InkRenderer */
 HRESULT renderer_create(IInkRenderer **out);
diff --git a/dlls/inkobj/renderer.c b/dlls/inkobj/renderer.c
index 3bd605b2670..687caf02d83 100644
--- a/dlls/inkobj/renderer.c
+++ b/dlls/inkobj/renderer.c
@@ -426,7 +426,7 @@ static HRESULT WINAPI renderer_Measure(IInkRenderer *iface, IInkStrokes *strokes
     for (i = 0; SUCCEEDED(hr) && i < count; ++i)
     {
         if (data[i]->deleted || !data[i]->packet_count) continue;
-        if (FAILED(hr = stroke_data_bounds(data[i], NULL, IBBM_Default, &renderer->object, FALSE, &bounds)))
+        if (FAILED(hr = stroke_data_bounds(data[i], NULL, IBBM_Default, &renderer->object, FALSE, FALSE, &bounds)))
             break;
         if (first) rect = bounds;
         else UnionRect(&rect, &rect, &bounds);
@@ -449,7 +449,7 @@ static HRESULT WINAPI renderer_MeasureStroke(IInkRenderer *iface, IInkStrokeDisp
 
     if (!out) return E_POINTER;
     if (!(data = stroke_data_from_IInkStrokeDisp(stroke))) return E_INVALIDARG;
-    if (FAILED(hr = stroke_data_bounds(data, attributes, IBBM_Default, &renderer->object, FALSE, &rect)))
+    if (FAILED(hr = stroke_data_bounds(data, attributes, IBBM_Default, &renderer->object, FALSE, FALSE, &rect)))
         return hr;
     return rectangle_create(&rect, out);
 }
diff --git a/dlls/inkobj/tests/inkobj.c b/dlls/inkobj/tests/inkobj.c
index e0dd7e506ef..39aeb94a9c2 100644
--- a/dlls/inkobj/tests/inkobj.c
+++ b/dlls/inkobj/tests/inkobj.c
@@ -272,15 +272,16 @@ static void test_ink(void)
     hr = IInkStrokeDisp_GetBoundingBox(stroke, IBBM_PointsOnly, &box);
     ok(hr == S_OK, "Got hr %#lx.\n", hr);
