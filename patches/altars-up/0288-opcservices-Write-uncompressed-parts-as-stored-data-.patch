From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 18:29:42 -0400
Subject: [PATCH] opcservices: Write uncompressed parts as stored data, and fix
 the ZIP64 records.

A part with OPC_COMPRESSION_NONE went through deflate at level 0 and was
then labelled stored: its entry held deflate's stored blocks, five bytes
longer than the part, and every reader saw a corrupt entry.  It is now
copied as it is.  The central directory repeats each entry's own flags
(the compression option bits), the ZIP64 extra field's size no longer
counts its own header, the ZIP64 end of central directory's offset is
taken where it is written, after the directory, and the locator counts
one disk.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/opcservices/compress.c b/dlls/opcservices/compress.c
index 591f0a0bd01..a03d7b18387 100644
--- a/dlls/opcservices/compress.c
+++ b/dlls/opcservices/compress.c
@@ -242,7 +242,7 @@ HRESULT compress_finalize_archive(struct zip_archive *archive)
     {
         struct zip64_end_of_central_directory_locator locator;
         struct zip64_end_of_central_directory eocd64;
-        uint64_t eocd64_offset = archive->position;
+        uint64_t eocd64_offset;
         struct zip64_extra_field extra_field;
 
         for (i = 0; i < archive->file_count; ++i)
@@ -252,7 +252,7 @@ HRESULT compress_finalize_archive(struct zip_archive *archive)
             cdh.signature = ZIP32_CDFH;
             cdh.version = ZIP64_VERSION;
             cdh.min_version = ZIP64_VERSION;
-            cdh.flags = USE_DATA_DESCRIPTOR;
+            cdh.flags = file->flags;
             cdh.method = file->method;
             cdh.mtime = archive->mtime;
             cdh.crc32 = file->crc32;
@@ -272,7 +272,7 @@ HRESULT compress_finalize_archive(struct zip_archive *archive)
 
             /* Extra field */
             extra_field.id = 1;
-            extra_field.size = sizeof(extra_field);
+            extra_field.size = sizeof(extra_field) - 4;
             extra_field.uncompressed_size = file->uncompressed_size;
             extra_field.compressed_size = file->compressed_size;
             extra_field.offset = file->offset;
@@ -283,6 +283,7 @@ HRESULT compress_finalize_archive(struct zip_archive *archive)
         }
 
         /* ZIP64 end of central directory */
+        eocd64_offset = archive->position;
         eocd64.signature = ZIP64_EOCD64;
         eocd64.size = sizeof(eocd64) - 12;
         eocd64.version = ZIP64_VERSION;
@@ -299,12 +300,14 @@ HRESULT compress_finalize_archive(struct zip_archive *archive)
         locator.signature = ZIP64_EOCD64_LOCATOR;
         locator.eocd64_disk = 0;
         locator.eocd64_offset = eocd64_offset;
-        locator.disk_num = 0;
+        locator.disk_num = 1;
         compress_write(archive, &locator, sizeof(locator));
 
         /* End of central directory */
         memset(&dir_end, 0xff, sizeof(dir_end));
         dir_end.signature = ZIP32_EOCD;
+        dir_end.diskid = 0;
+        dir_end.firstdisk = 0;
         dir_end.comment_length = 0;
         compress_write(archive, &dir_end, sizeof(dir_end));
     }
@@ -317,7 +320,7 @@ HRESULT compress_finalize_archive(struct zip_archive *archive)
             cdh.signature = ZIP32_CDFH;
             cdh.version = ZIP32_VERSION;
             cdh.min_version = ZIP32_VERSION;
-            cdh.flags = USE_DATA_DESCRIPTOR;
+            cdh.flags = file->flags;
             cdh.method = file->method;
             cdh.mtime = archive->mtime;
             cdh.crc32 = file->crc32;
@@ -392,7 +395,27 @@ static void compress_write_content(struct zip_archive *archive, IStream *content
     file->compressed_size = file->uncompressed_size = 0;
 
     move.QuadPart = 0;
-    IStream_Seek(content, move, STREAM_SEEK_SET, NULL);
+    if (FAILED(archive->status = IStream_Seek(content, move, STREAM_SEEK_SET, NULL)))
+        return;
+
+    if (options == OPC_COMPRESSION_NONE)
+    {
+        while (SUCCEEDED(archive->status))
+        {
+            if (FAILED(hr = IStream_Read(content, archive->input_buffer, sizeof(archive->input_buffer), &num_read)))
+            {
+                archive->status = hr;
+                break;
+            }
+            if (!num_read)
+                break;
+            file->crc32 = RtlComputeCrc32(file->crc32, archive->input_buffer, num_read);
+            file->compressed_size += num_read;
+            file->uncompressed_size += num_read;
+            compress_write(archive, archive->input_buffer, num_read);
+        }
+        return;
+    }
 
     switch (options)
     {
