From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 20:15:51 -0400
Subject: [PATCH] ntdll: A heap's performance figures, and all heaps together.

Word asks for HeapExtendedInformation at level 0x80000000, which Windows
11 answers with 160 bytes for the heap (or for each heap in turn when
none is named): its address, reserved and committed sizes, segments,
the committed bytes in use and free (which make up what is committed),
the free blocks and what is in blocks of their own.  Levels 0 to 2 give
the heap, or with no heap the reserved and committed sizes of all of
them and how many there are; a buffer that holds the request alone is
an invalid parameter, one too small for the answer says how big it must
be (tools/startupgapsprobe misc5).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/heap.c b/dlls/kernel32/tests/heap.c
index bbf76421501..f34f3e3878b 100644
--- a/dlls/kernel32/tests/heap.c
+++ b/dlls/kernel32/tests/heap.c
@@ -846,6 +846,41 @@ static void test_HeapCreate(void)
     ok( ret, "HeapQueryInformation failed, error %lu\n", GetLastError() );
     ok( compat_info == 0, "got compat_info %lu\n", compat_info );
 
+    if (sizeof(void *) == 8)
+    {
+        /* HeapExtendedInformation: a request of 40 bytes, then the answer; at level 0x80000000 a heap's
+         * figures, 160 bytes for each, its busy and free committed bytes making up what it has committed */
+        ULONG64 buffer[128] = { 0 }, *perf = buffer + 5;
+
+        buffer[0] = (ULONG_PTR)GetCurrentProcess();
+        buffer[1] = (ULONG_PTR)heap;
+        buffer[2] = 0x80000000;
+        SetLastError( 0xdeadbeef );
+        ret = pHeapQueryInformation( heap, 2, buffer, 40, &size );
+        ok( !ret && GetLastError() == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, GetLastError() );
+        size = 0;
+        SetLastError( 0xdeadbeef );
+        ret = pHeapQueryInformation( heap, 2, buffer, 88, &size );
+        ok( !ret && GetLastError() == ERROR_INSUFFICIENT_BUFFER, "got %d, error %lu\n", ret, GetLastError() );
+        ok( size == 200, "got size %Iu\n", size );
+        ret = pHeapQueryInformation( heap, 2, buffer, sizeof(buffer), &size );
+        ok( ret, "HeapQueryInformation failed, error %lu\n", GetLastError() );
+        ok( size == 200, "got size %Iu\n", size );
+        ok( perf[0] == 0x100000000, "got %#I64x\n", perf[0] );
+        ok( perf[2] == (ULONG_PTR)heap, "got address %#I64x\n", perf[2] );
+        ok( perf[4] && perf[3] >= perf[4], "got reserve %#I64x, commit %#I64x\n", perf[3], perf[4] );
+        ok( perf[8] + perf[9] == perf[4], "got busy %#I64x, free %#I64x, commit %#I64x\n", perf[8], perf[9], perf[4] );
+
+        /* and with no heap, all of them together at level 1 */
+        memset( buffer, 0, sizeof(buffer) );
+        buffer[0] = (ULONG_PTR)GetCurrentProcess();
+        buffer[2] = 1;
+        ret = pHeapQueryInformation( NULL, 2, buffer, sizeof(buffer), &size );
+        ok( ret, "HeapQueryInformation failed, error %lu\n", GetLastError() );
+        ok( size == 72, "got size %Iu\n", size );
+        ok( (ULONG)buffer[7] == GetProcessHeaps( 0, NULL ), "got %lu heaps\n", (ULONG)buffer[7] );
+    }
+
     ret = HeapDestroy( heap );
     ok( ret, "HeapDestroy failed, error %lu\n", GetLastError() );
 
diff --git a/dlls/ntdll/heap.c b/dlls/ntdll/heap.c
index 294070976dc..a6bf646f11e 100644
--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -2564,33 +2564,118 @@ static LONG terminate_on_corruption = TRUE;
 static LONG terminate_on_corruption;
 #endif
 
-/* HeapExtendedInformation (2): what to ask of which heap of which process, then what a heap is */
-struct heap_extended_information
+/* HeapExtendedInformation (2): what to ask of which heap of which process, then the answer, as Windows 11 has
+ * them: at levels 0 to 2 a heap (or with no heap, all of them together), at 0x80000000 its performance figures
+ * (or those of each heap in turn); the levels from 3 on list regions, ranges and blocks */
+struct heap_extended_request
 {
     HANDLE    process;
     ULONG_PTR heap;
     ULONG     level;
     void     *callback;
     void     *context;
-    struct
-    {
-        ULONG64 address;
-        ULONG   mode;
-        ULONG64 reserve_size;
-        ULONG64 commit_size;
-        ULONG64 first_region;
-        ULONG64 version;
-    } info;
 };
 
-static NTSTATUS query_extended_information( struct heap_extended_information *ext, SIZE_T size_in,
-                                            SIZE_T *size_out )
+struct heap_extended_heap
+{
+    ULONG64 address;
+    ULONG   mode;
+    ULONG64 reserve_size;
+    ULONG64 commit_size;
+    ULONG64 first_region;
+    ULONG64 next_heap;
+};
+
+struct heap_extended_process
+{
+    ULONG64 reserve_size;
+    ULONG64 commit_size;
+    ULONG   count;
+    ULONG64 first_heap;
+};
+
+struct heap_extended_performance
+{
+    ULONG   unknown1;
+    ULONG   version;           /* 1 */
+    ULONG64 unknown2;
+    ULONG64 address;
+    ULONG64 reserve_size;
+    ULONG64 commit_size;
+    ULONG64 segment_count;
+    ULONG64 unknown3;
+    ULONG64 unknown4;          /* 1 */
+    ULONG64 busy_size;         /* committed and in use, headers counted */
+    ULONG64 free_size;         /* committed and free */
+    ULONG64 free_count;
+    ULONG   large_size;        /* in blocks of their own */
+    ULONG   unknown5;
+    ULONG64 unknown6[8];
+};
+
+C_ASSERT( sizeof(struct heap_extended_request) == 40 || sizeof(void *) == 4 );
+C_ASSERT( sizeof(struct heap_extended_performance) == 160 );
+
+static void get_heap_sizes( struct heap *heap, ULONG64 *reserve, ULONG64 *commit )
 {
-    struct heap *heap;
     SUBHEAP *subheap;
-    ULONG flags;
 
-    if (!ext || size_in < sizeof(*ext)) return STATUS_INVALID_PARAMETER;
+    LIST_FOR_EACH_ENTRY( subheap, &heap->subheap_list, SUBHEAP, entry )
+    {
+        *reserve += subheap_size( subheap );
+        *commit += (char *)subheap_commit_end( subheap ) - (char *)subheap_base( subheap );
+    }
+}
+
+static void get_heap_performance( struct heap *heap, struct heap_extended_performance *info )
+{
+    ULONG64 reserve = 0, commit = 0, free = 0, count = 0, large = 0, segments = 0;
+    struct block *block;
+    ARENA_LARGE *arena;
+    SUBHEAP *subheap;
+
+    heap_lock( heap, 0 );
+    get_heap_sizes( heap, &reserve, &commit );
+    LIST_FOR_EACH_ENTRY( subheap, &heap->subheap_list, SUBHEAP, entry )
+    {
+        const char *end = subheap_commit_end( subheap );
+
+        segments++;
+        for (block = first_block( subheap ); block; block = next_block( subheap, block ))
+        {
+            const char *start = (const char *)block, *block_end = start + block_get_size( block );
+
+            if (start >= end) break;
+            if (!(block_get_flags( block ) & BLOCK_FLAG_FREE)) continue;
+            free += min( block_end, end ) - start;
+            count++;
+        }
+    }
+    LIST_FOR_EACH_ENTRY( arena, &heap->large_list, ARENA_LARGE, entry ) large += arena->block_size;
+    heap_unlock( heap, 0 );
+
+    memset( info, 0, sizeof(*info) );
+    info->version = 1;
+    info->address = (ULONG_PTR)heap;
+    info->reserve_size = reserve;
+    info->commit_size = commit;
+    info->segment_count = segments;
+    info->unknown4 = 1;
+    info->busy_size = commit - free;
+    info->free_size = free;
+    info->free_count = count;
+    info->large_size = large;
+}
+
+static NTSTATUS query_extended_information( void *ptr, SIZE_T size_in, SIZE_T *size_out )
+{
+    struct heap_extended_request *ext = ptr;
+    struct heap *heap = NULL, *iter;
+    SIZE_T needed;
+    ULONG flags, count;
+
+    /* the request alone is not enough */
+    if (!ext || size_in <= sizeof(*ext)) return STATUS_INVALID_PARAMETER;
     /* the process's own heaps only */
     if (ext->process != NtCurrentProcess() &&
         (!ext->process || HandleToULong( ext->process ) != HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess )))
@@ -2605,25 +2690,80 @@ static NTSTATUS query_extended_information( struct heap_extended_information *ex
             return STATUS_NOT_SUPPORTED;
         }
     }
-    if (ext->level != 1)
-    {
-        FIXME( "level %lu not supported\n", ext->level );
+    if (ext->heap && !(heap = unsafe_heap_from_handle( (HANDLE)ext->heap, 0, &flags )))
         return STATUS_INVALID_PARAMETER;
+
+    if (ext->level <= 2)
+    {
+        if (heap)
+        {
+            struct heap_extended_heap *info = (struct heap_extended_heap *)(ext + 1);
+
+            needed = sizeof(*ext) + sizeof(*info);
+            if (size_out) *size_out = needed;
+            if (size_in < needed) return STATUS_BUFFER_TOO_SMALL;
+            memset( info, 0, sizeof(*info) );
+            info->address = (ULONG_PTR)heap;
+            info->mode = heap->compat_info;
+            heap_lock( heap, flags );
+            get_heap_sizes( heap, &info->reserve_size, &info->commit_size );
+            heap_unlock( heap, flags );
+        }
+        else
+        {
+            struct heap_extended_process *info = (struct heap_extended_process *)(ext + 1);
+
+            needed = sizeof(*ext) + sizeof(*info);
+            if (size_out) *size_out = needed;
+            if (size_in < needed) return STATUS_BUFFER_TOO_SMALL;
+            memset( info, 0, sizeof(*info) );
+            RtlEnterCriticalSection( &process_heap->cs );
+            get_heap_sizes( process_heap, &info->reserve_size, &info->commit_size );
+            count = 1;
+            LIST_FOR_EACH_ENTRY( iter, &process_heap->entry, struct heap, entry )
+            {
+                get_heap_sizes( iter, &info->reserve_size, &info->commit_size );
+                count++;
+            }
+            RtlLeaveCriticalSection( &process_heap->cs );
+            info->count = count;
+        }
+        return STATUS_SUCCESS;
     }
-    if (!(heap = unsafe_heap_from_handle( (HANDLE)ext->heap, 0, &flags ))) return STATUS_INVALID_PARAMETER;
 
-    memset( &ext->info, 0, sizeof(ext->info) );
-    ext->info.address = (ULONG_PTR)heap;
-    ext->info.mode = heap->compat_info;
-    heap_lock( heap, flags );
-    LIST_FOR_EACH_ENTRY( subheap, &heap->subheap_list, SUBHEAP, entry )
+    if (ext->level == 0x80000000)
     {
-        ext->info.reserve_size += subheap_size( subheap );
-        ext->info.commit_size += (char *)subheap_commit_end( subheap ) - (char *)subheap_base( subheap );
+        struct heap_extended_performance *info = (struct heap_extended_performance *)(ext + 1);
+
+        if (heap)
+        {
+            needed = sizeof(*ext) + sizeof(*info);
+            if (size_out) *size_out = needed;
+            if (size_in < needed) return STATUS_BUFFER_TOO_SMALL;
+            get_heap_performance( heap, info );
+            return STATUS_SUCCESS;
+        }
+
+        /* the process heap, then the others from the oldest */
+        RtlEnterCriticalSection( &process_heap->cs );
+        count = 1;
+        LIST_FOR_EACH_ENTRY( iter, &process_heap->entry, struct heap, entry ) count++;
+        needed = sizeof(*ext) + count * sizeof(*info);
+        if (size_out) *size_out = needed;
+        if (size_in < needed)
+        {
+            RtlLeaveCriticalSection( &process_heap->cs );
+            return STATUS_BUFFER_TOO_SMALL;
+        }
+        get_heap_performance( process_heap, info++ );
+        LIST_FOR_EACH_ENTRY_REV( iter, &process_heap->entry, struct heap, entry )
+            get_heap_performance( iter, info++ );
+        RtlLeaveCriticalSection( &process_heap->cs );
+        return STATUS_SUCCESS;
     }
-    heap_unlock( heap, flags );
-    if (size_out) *size_out = sizeof(*ext);
-    return STATUS_SUCCESS;
+
+    FIXME( "level %#lx not supported\n", ext->level );
+    return STATUS_INVALID_PARAMETER;
 }
 
 NTSTATUS WINAPI RtlQueryHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS info_class,
