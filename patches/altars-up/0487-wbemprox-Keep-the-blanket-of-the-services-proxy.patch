From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:01 -0400
Subject: [PATCH] wbemprox: Keep the blanket of the services' proxy.

IClientSecurity reports the authentication Windows 11 reports, and keeps
what is set; the locator answers other interfaces without a FIXME
(tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wbemprox/services.c b/dlls/wbemprox/services.c
index f1655ff4641..fce8b6a4889 100644
--- a/dlls/wbemprox/services.c
+++ b/dlls/wbemprox/services.c
@@ -63,20 +63,38 @@ static HRESULT WINAPI client_security_QueryInterface(
     return S_OK;
 }
 
+/* the one object answers for every proxy */
 static ULONG WINAPI client_security_AddRef(
     IClientSecurity *iface )
 {
-    FIXME("%p\n", iface);
+    TRACE("%p\n", iface);
     return 2;
 }
 
 static ULONG WINAPI client_security_Release(
     IClientSecurity *iface )
 {
-    FIXME("%p\n", iface);
+    TRACE("%p\n", iface);
     return 1;
 }
 
+/* What a proxy of the services was told to authenticate with.  The connection is local, its packets private
+ * whatever level is asked for, as Windows reports it. */
+struct blanket
+{
+    DWORD authn_svc;
+    DWORD authz_svc;
+    DWORD imp_level;
+    DWORD capabilities;
+};
+
+static const struct blanket default_blanket =
+{
+    RPC_C_AUTHN_WINNT, RPC_C_AUTHZ_NONE, RPC_C_IMP_LEVEL_IMPERSONATE, EOAC_NONE
+};
+
+static struct blanket *services_blanket( IUnknown *proxy );
+
 static HRESULT WINAPI client_security_QueryBlanket(
     IClientSecurity *iface,
     IUnknown *pProxy,
@@ -88,22 +106,25 @@ static HRESULT WINAPI client_security_QueryBlanket(
     void **pAuthInfo,
     DWORD *pCapabilities )
 {
-    FIXME("semi-stub.\n");
+    const struct blanket *blanket = services_blanket( pProxy );
 
+    TRACE( "%p, %p\n", iface, pProxy );
+
+    if (!blanket) blanket = &default_blanket;
     if (pAuthnSvc)
-        *pAuthnSvc = RPC_C_AUTHN_NONE;
+        *pAuthnSvc = blanket->authn_svc;
     if (pAuthzSvc)
-        *pAuthzSvc = RPC_C_AUTHZ_NONE;
+        *pAuthzSvc = blanket->authz_svc;
     if (pServerPrincName)
         *pServerPrincName = NULL;
     if (pAuthnLevel)
-        *pAuthnLevel = RPC_C_AUTHN_LEVEL_NONE;
+        *pAuthnLevel = RPC_C_AUTHN_LEVEL_PKT_PRIVACY;
     if (pImpLevel)
-        *pImpLevel = RPC_C_IMP_LEVEL_DEFAULT;
+        *pImpLevel = blanket->imp_level;
     if (pAuthInfo)
         *pAuthInfo = NULL;
     if (pCapabilities)
-        *pCapabilities = 0;
+        *pCapabilities = blanket->capabilities;
 
     return WBEM_NO_ERROR;
 }
@@ -122,8 +143,18 @@ static HRESULT WINAPI client_security_SetBlanket(
     const OLECHAR *princname = (pServerPrincName == COLE_DEFAULT_PRINCIPAL) ?
                                L"<COLE_DEFAULT_PRINCIPAL>" : pServerPrincName;
 
-    FIXME( "%p, %p, %lu, %lu, %s, %lu, %lu, %p, %#lx\n", iface, pProxy, AuthnSvc, AuthzSvc,
+    struct blanket *blanket = services_blanket( pProxy );
+
+    TRACE( "%p, %p, %lu, %lu, %s, %lu, %lu, %p, %#lx\n", iface, pProxy, AuthnSvc, AuthzSvc,
            debugstr_w(princname), AuthnLevel, ImpLevel, pAuthInfo, Capabilities );
+
+    if (blanket)
+    {
+        if (AuthnSvc != RPC_C_AUTHN_DEFAULT) blanket->authn_svc = AuthnSvc;
+        if (AuthzSvc != RPC_C_AUTHZ_DEFAULT) blanket->authz_svc = AuthzSvc;
+        if (ImpLevel != RPC_C_IMP_LEVEL_DEFAULT) blanket->imp_level = ImpLevel;
+        if (Capabilities != EOAC_DEFAULT) blanket->capabilities = Capabilities;
+    }
     return WBEM_NO_ERROR;
 }
 
@@ -213,8 +244,19 @@ struct wbem_services
     enum wbm_namespace ns;
     struct async_header *async;
     IWbemContext *context;
+    struct blanket blanket;
 };
 
+static const IWbemServicesVtbl wbem_services_vtbl;
+
+static struct blanket *services_blanket( IUnknown *proxy )
+{
+    IWbemServices *services = (IWbemServices *)proxy;
+
+    if (!proxy || services->lpVtbl != &wbem_services_vtbl) return NULL;
+    return &CONTAINING_RECORD( services, struct wbem_services, IWbemServices_iface )->blanket;
+}
+
 static inline struct wbem_services *impl_from_IWbemServices( IWbemServices *iface )
 {
     return CONTAINING_RECORD( iface, struct wbem_services, IWbemServices_iface );
@@ -1020,6 +1062,7 @@ HRESULT WbemServices_create( const WCHAR *namespace, IWbemContext *context, LPVO
     if (!(ws = calloc( 1, sizeof(*ws) ))) return E_OUTOFMEMORY;
 
     ws->IWbemServices_iface.lpVtbl = &wbem_services_vtbl;
+    ws->blanket = default_blanket;
     ws->refs      = 1;
     ws->ns        = ns;
     InitializeCriticalSectionEx( &ws->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
diff --git a/dlls/wbemprox/wbemlocator.c b/dlls/wbemprox/wbemlocator.c
index 6e5bddea156..9fc8c1b8111 100644
--- a/dlls/wbemprox/wbemlocator.c
+++ b/dlls/wbemprox/wbemlocator.c
@@ -77,7 +77,9 @@ static HRESULT WINAPI wbem_locator_QueryInterface(
     }
     else
     {
-        FIXME("interface %s not implemented\n", debugstr_guid(riid));
+        /* Windows' locator has no other interface, IMarshal among them */
+        WARN("interface %s not implemented\n", debugstr_guid(riid));
+        *ppvObject = NULL;
         return E_NOINTERFACE;
     }
     IWbemLocator_AddRef( iface );
