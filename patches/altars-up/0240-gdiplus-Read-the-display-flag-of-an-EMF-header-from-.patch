From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 23:11:02 -0400
Subject: [PATCH] gdiplus: Read the display flag of an EMF+ header from bit 0,
 where it is written.

GdipRecordMetafile() writes EmfPlusFlags as 1 for a display, and Windows
reads bit 0 back: a metafile with it set plays UnitDisplay as pixels, one
without it as 1/100 inch, as for a printer.  Reading bit 31 instead made
every metafile recorded for a display, by Windows or by Wine, play 4% too
small at 96 dpi when drawn in UnitDisplay, the default page unit of a
metafile's graphics.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 31f4f36415222ddbc4b81877d2c64354547a92fe)

diff --git a/dlls/gdiplus/metafile.c b/dlls/gdiplus/metafile.c
index c108283c62f..aeda7c2b00a 100644
--- a/dlls/gdiplus/metafile.c
+++ b/dlls/gdiplus/metafile.c
@@ -4447,9 +4447,9 @@ GpStatus WINGDIPAPI GdipCreateMetafileFromEmf(HENHMETAFILE hemf, BOOL delete,
     (*metafile)->metafile_type = header.Type;
     (*metafile)->hemf = hemf;
     (*metafile)->preserve_hemf = !delete;
-    /* If the 31th bit of EmfPlusFlags was set, metafile was recorded with a DC for a video display.
-     * If clear, metafile was recorded with a DC for a printer */
-    (*metafile)->printer_display = !(header.EmfPlusFlags & (1u << 31));
+    /* If bit 0 of EmfPlusFlags is set, the metafile was recorded with a DC for a video display,
+     * whose UnitDisplay is a pixel; if clear, with a DC for a printer, whose UnitDisplay is 1/100 inch. */
+    (*metafile)->printer_display = !(header.EmfPlusFlags & 1);
     (*metafile)->logical_dpix = header.LogicalDpiX;
     (*metafile)->logical_dpiy = header.LogicalDpiY;
     list_init(&(*metafile)->containers);
diff --git a/dlls/gdiplus/tests/metafile.c b/dlls/gdiplus/tests/metafile.c
index 055f6e16860..f3b0afff5b7 100644
--- a/dlls/gdiplus/tests/metafile.c
+++ b/dlls/gdiplus/tests/metafile.c
@@ -1655,6 +1655,109 @@ static const emfplus_record worldtransform_records[] = {
     { 0 }
 };
 
+/* Bit 0 of the header's EmfPlusFlags says the metafile was recorded for a display, where UnitDisplay is a pixel;
+ * without it, UnitDisplay is 1/100 inch, as on a printer. */
+static void test_display_flag(void)
+{
+    static const DWORD flags[] = { 0x1, 0x80000001, 0x0, 0x80000000, 0x2 };
+    static const GpRectF frame = { 0.0, 0.0, 100.0, 100.0 };
+    GpMetafile *metafile, *copy;
+    MetafileHeader header;
+    GpGraphics *graphics;
+    DWORD *emfplus_flags = NULL;
+    HENHMETAFILE hemf;
+    GpBitmap *bitmap;
+    GpBrush *brush;
+    UINT size, pos, i;
+    GpStatus stat;
+    ARGB color;
+    BYTE *bits;
+    HDC hdc;
+
+    hdc = GetDC(0);
+    stat = GdipRecordMetafile(hdc, EmfTypeEmfPlusDual, &frame, MetafileFrameUnitPixel, description, &metafile);
+    expect(Ok, stat);
+    ReleaseDC(0, hdc);
+    stat = GdipGetImageGraphicsContext((GpImage *)metafile, &graphics);
+    expect(Ok, stat);
+    stat = GdipSetPageUnit(graphics, UnitDisplay);
+    expect(Ok, stat);
+    stat = GdipCreateSolidFill(0xffff0000, (GpSolidFill **)&brush);
+    expect(Ok, stat);
+    stat = GdipFillRectangleI(graphics, brush, 25, 25, 50, 50);
+    expect(Ok, stat);
+    GdipDeleteBrush(brush);
+    GdipDeleteGraphics(graphics);
+    stat = GdipGetHemfFromMetafile(metafile, &hemf);
+    expect(Ok, stat);
+    GdipDisposeImage((GpImage *)metafile);
+
+    size = GetEnhMetaFileBits(hemf, 0, NULL);
+    bits = malloc(size);
+    GetEnhMetaFileBits(hemf, size, bits);
+    DeleteEnhMetaFile(hemf);
+    for (pos = 0; pos + sizeof(EMR) <= size && ((EMR *)(bits + pos))->nSize; pos += ((EMR *)(bits + pos))->nSize)
+    {
+        EMRGDICOMMENT *comment = (EMRGDICOMMENT *)(bits + pos);
+
+        if (comment->emr.iType == EMR_GDICOMMENT && comment->cbData >= 32 && !memcmp(comment->Data, "EMF+", 4)
+                && *(WORD *)(comment->Data + 4) == EmfPlusRecordTypeHeader)
+        {
+            emfplus_flags = (DWORD *)(comment->Data + 20);
+            break;
+        }
+    }
+    ok(emfplus_flags != NULL, "No EMF+ header.\n");
+    if (!emfplus_flags)
+    {
+        free(bits);
+        return;
+    }
+    ok(*emfplus_flags == 1, "Got EmfPlusFlags %#lx.\n", *emfplus_flags);
+
+    for (i = 0; i < ARRAY_SIZE(flags); i++)
+    {
+        BOOL display = flags[i] & 1;
+
+        winetest_push_context("flags %#lx", flags[i]);
+        *emfplus_flags = flags[i];
+        hemf = SetEnhMetaFileBits(size, bits);
+        ok(hemf != NULL, "SetEnhMetaFileBits failed.\n");
+        stat = GdipCreateMetafileFromEmf(hemf, TRUE, &copy);
+        expect(Ok, stat);
+        stat = GdipGetMetafileHeaderFromMetafile(copy, &header);
+        expect(Ok, stat);
+        expect(flags[i], header.EmfPlusFlags);
+
+        stat = GdipCreateBitmapFromScan0(100, 100, 0, PixelFormat32bppARGB, NULL, &bitmap);
+        expect(Ok, stat);
+        stat = GdipGetImageGraphicsContext((GpImage *)bitmap, &graphics);
+        expect(Ok, stat);
+        stat = GdipDrawImageRectI(graphics, (GpImage *)copy, 0, 0, 100, 100);
+        expect(Ok, stat);
+        GdipDeleteGraphics(graphics);
+
+        stat = GdipBitmapGetPixel(bitmap, 25, 50, &color);
+        expect(Ok, stat);
+        if (display)
+            expect(0xffff0000, color);
+        stat = GdipBitmapGetPixel(bitmap, 74, 50, &color);
+        expect(Ok, stat);
+        if (display)
+            expect(0xffff0000, color);
+        else if (header.LogicalDpiX == 96)
+            expect(0, color); /* drawn from 24 to 71 */
+        stat = GdipBitmapGetPixel(bitmap, 75, 50, &color);
+        expect(Ok, stat);
+        expect(0, color);
+
+        GdipDisposeImage((GpImage *)bitmap);
+        GdipDisposeImage((GpImage *)copy);
+        winetest_pop_context();
+    }
+    free(bits);
+}
+
 static void test_worldtransform(void)
 {
     GpStatus stat;
@@ -4331,6 +4434,7 @@ START_TEST(metafile)
     test_clear();
     test_nullframerect();
     test_pagetransform();
+    test_display_flag();
     test_worldtransform();
     test_converttoemfplus();
     test_frameunit();
