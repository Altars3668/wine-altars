From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:01 -0400
Subject: [PATCH] netapi32, wkscli: The join information of a machine in a
 workgroup.

NetGetJoinInformation says WORKGROUP, and NetGetAadJoinInformation that
the machine is not joined to Azure AD, after checking its argument
(tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/netapi32/netapi32.c b/dlls/netapi32/netapi32.c
index 29884220756..6e79378e758 100644
--- a/dlls/netapi32/netapi32.c
+++ b/dlls/netapi32/netapi32.c
@@ -2710,11 +2710,15 @@ void __RPC_USER ATSVC_HANDLE_unbind(ATSVC_HANDLE ServerName, handle_t rpc_handle
  */
 HRESULT WINAPI NetGetAadJoinInformation(LPCWSTR tenant_id, PDSREG_JOIN_INFO *join_info)
 {
-    FIXME("(%s, %p): stub\n", debugstr_w(tenant_id), join_info);
-    return ERROR_CALL_NOT_IMPLEMENTED;
+    TRACE("(%s, %p)\n", debugstr_w(tenant_id), join_info);
+
+    if (!join_info) return E_INVALIDARG;
+    /* the device is joined to no Entra ID tenant, nor registered with one */
+    *join_info = NULL;
+    return S_OK;
 }
 
 void NET_API_FUNCTION NetFreeAadJoinInformation(DSREG_JOIN_INFO *join_info)
 {
-    FIXME("%p): stub\n", join_info);
+    TRACE("%p\n", join_info);
 }
diff --git a/dlls/wkscli/wkscli.c b/dlls/wkscli/wkscli.c
index 016a751a967..5326fbd0d0a 100644
--- a/dlls/wkscli/wkscli.c
+++ b/dlls/wkscli/wkscli.c
@@ -35,9 +35,10 @@ NET_API_STATUS NET_API_FUNCTION NetGetJoinInformation(
     LPWSTR *Name,
     PNETSETUP_JOIN_STATUS type)
 {
-    static const WCHAR workgroupW[] = L"Workgroup";
+    /* a computer in no domain is in the workgroup Windows puts it in */
+    static const WCHAR workgroupW[] = L"WORKGROUP";
 
-    FIXME("Semi-stub %s %p %p\n", wine_dbgstr_w(Server), Name, type);
+    TRACE("%s %p %p\n", wine_dbgstr_w(Server), Name, type);
 
     if (!Name || !type)
         return ERROR_INVALID_PARAMETER;
