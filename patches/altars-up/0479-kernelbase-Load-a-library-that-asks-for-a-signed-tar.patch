From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:01 -0400
Subject: [PATCH] kernelbase: Load a library that asks for a signed target as
 Windows 11 does.

LOAD_LIBRARY_REQUIRE_SIGNED_TARGET was a FIXME.  A module already
loaded is returned; otherwise a process whose own image carries no
signature cannot load one (ERROR_INVALID_IMAGE_HASH), signed or not,
except that a relative name with LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR is
refused as before (tools/startupgapsprobe misc, misc2).  A signed image
loads its libraries as usual, as WINWORD.EXE loads its own.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernelbase/loader.c b/dlls/kernelbase/loader.c
index 2057b1f41ad..aaf079a3ea3 100644
--- a/dlls/kernelbase/loader.c
+++ b/dlls/kernelbase/loader.c
@@ -148,12 +148,25 @@ failed:
 }
 
 
+/* whether an image carries a signature of its own */
+static BOOL has_signature( HMODULE module )
+{
+    const IMAGE_NT_HEADERS *nt = RtlImageNtHeader( module );
+    const IMAGE_DATA_DIRECTORY *dir;
+
+    if (!nt) return FALSE;
+    if (nt->OptionalHeader.Magic == IMAGE_NT_OPTIONAL_HDR64_MAGIC)
+        dir = &((const IMAGE_NT_HEADERS64 *)nt)->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_SECURITY];
+    else
+        dir = &((const IMAGE_NT_HEADERS32 *)nt)->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_SECURITY];
+    return dir->VirtualAddress && dir->Size;
+}
+
 /******************************************************************
  *      load_library
  */
 static HMODULE load_library( const UNICODE_STRING *libname, DWORD flags )
 {
-    const DWORD unsupported_flags = LOAD_IGNORE_CODE_AUTHZ_LEVEL | LOAD_LIBRARY_REQUIRE_SIGNED_TARGET;
     const ULONG load_library_search_flags = LOAD_WITH_ALTERED_SEARCH_PATH | LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR
                 | LOAD_LIBRARY_SEARCH_APPLICATION_DIR | LOAD_LIBRARY_SEARCH_USER_DIRS
                 | LOAD_LIBRARY_SEARCH_SYSTEM32 | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS;
@@ -162,7 +175,27 @@ static HMODULE load_library( const UNICODE_STRING *libname, DWORD flags )
     WCHAR *load_path, *dummy;
     DWORD load_flags = 0, search_flags;
 
-    if (flags & unsupported_flags) FIXME( "unsupported flag(s) used %#08lx\n", flags );
+    /* LOAD_IGNORE_CODE_AUTHZ_LEVEL means nothing any more. */
+
+    /* A module loaded already is had again.  One that is not has to be signed as the process is: a process
+     * that is not signed loads none (Windows 11 fails with ERROR_INVALID_IMAGE_HASH even for Microsoft's own),
+     * and one that is, as Office is, its own. */
+    if ((flags & LOAD_LIBRARY_REQUIRE_SIGNED_TARGET) &&
+        !(flags & (LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_DATAFILE_EXCLUSIVE | LOAD_LIBRARY_AS_IMAGE_RESOURCE)))
+    {
+        if (!LdrGetDllHandleEx( 0, NULL, NULL, libname, &module ))
+        {
+            if (!set_ntstatus( LdrAddRefDll( 0, module ))) return 0;
+            return module;
+        }
+        if (!has_signature( NtCurrentTeb()->Peb->ImageBaseAddress ) &&
+            (!(flags & LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR) ||
+             RtlDetermineDosPathNameType_U( libname->Buffer ) != RtlPathTypeRelative))
+        {
+            SetLastError( ERROR_INVALID_IMAGE_HASH );
+            return 0;
+        }
+    }
 
     if (flags & (LOAD_LIBRARY_AS_DATAFILE | LOAD_LIBRARY_AS_DATAFILE_EXCLUSIVE |
                  LOAD_LIBRARY_AS_IMAGE_RESOURCE))
