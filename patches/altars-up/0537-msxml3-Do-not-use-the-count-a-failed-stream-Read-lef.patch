From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 04:46:35 -0400
Subject: [PATCH] msxml3: Do not use the count a failed stream Read left unset.

Loading a document from a stream copied each block with the count Read
returned, whatever Read said.  A document's own stream fails Read
without setting the count while it is written to, and when the document
is empty; Word loads a document from an empty one when the References
tab opens, and the uninitialized count made the copy run off the end of
the buffer and kill Word.

Copy only what a successful Read returned, and never more than the
buffer.  XMLView's data callback had the same loop.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/domdoc.c b/dlls/msxml3/domdoc.c
index 541f4fc7417..872d0389e8a 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -293,13 +293,17 @@ static HRESULT domdoc_load_from_stream(domdoc *doc, ISequentialStream *stream)
 
     do
     {
-        ISequentialStream_Read(stream, buf, sizeof(buf), &read);
-        hr = IStream_Write(hstream, buf, read, &written);
+        /* A failing Read need not set the count: a document's stream does not while it is
+         * written to, and Word loads documents from empty ones. */
+        read = 0;
+        if (FAILED(hr = ISequentialStream_Read(stream, buf, sizeof(buf), &read)))
+            break;
+        hr = IStream_Write(hstream, buf, min(read, sizeof(buf)), &written);
     } while (SUCCEEDED(hr) && written != 0 && read != 0);
 
     if (FAILED(hr))
     {
-        ERR("failed to copy stream, hr %#lx.\n", hr);
+        WARN("failed to copy stream, hr %#lx.\n", hr);
         IStream_Release(hstream);
         return hr;
     }
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index 48d5d0840b2..b74c20fe821 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -19842,6 +19842,53 @@ static void test_new_parser_validation(void)
     }
 }
 
+/* Loading a document from another document goes through that document's stream.  Its Read fails
+ * without setting the count while the stream is written to (see test_document_stream), and Word
+ * loads documents from empty ones: none of this may read the count. */
+static void test_load_from_document_stream(void)
+{
+    IXMLDOMDocument *src, *doc;
+    IXMLDOMElement *root;
+    VARIANT_BOOL loaded;
+    IStream *stream;
+    ULONG length;
+    HRESULT hr;
+    VARIANT v;
+
+    /* from a stream that is being written to */
+    src = create_document(&IID_IXMLDOMDocument);
+    hr = IXMLDOMDocument_QueryInterface(src, &IID_IStream, (void **)&stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IStream_Write(stream, "<b>", 3, &length);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    doc = create_document(&IID_IXMLDOMDocument);
+    V_VT(&v) = VT_UNKNOWN;
+    V_UNKNOWN(&v) = (IUnknown *)stream;
+    loaded = VARIANT_TRUE;
+    hr = IXMLDOMDocument_load(doc, v, &loaded);
+    ok(hr != S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(loaded == VARIANT_FALSE, "Unexpected result %d.\n", loaded);
+    hr = IXMLDOMDocument_get_documentElement(doc, &root);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    IXMLDOMDocument_Release(doc);
+    IStream_Release(stream);
+    IXMLDOMDocument_Release(src);
+
+    /* from an empty document */
+    src = create_document(&IID_IXMLDOMDocument);
+    doc = create_document(&IID_IXMLDOMDocument);
+    V_VT(&v) = VT_UNKNOWN;
+    V_UNKNOWN(&v) = (IUnknown *)src;
+    loaded = VARIANT_TRUE;
+    hr = IXMLDOMDocument_load(doc, v, &loaded);
+    trace("load from an empty document: hr %#lx, loaded %d.\n", hr, loaded);
+    hr = IXMLDOMDocument_get_documentElement(doc, &root);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    IXMLDOMDocument_Release(doc);
+    IXMLDOMDocument_Release(src);
+}
+
 START_TEST(domdoc)
 {
     HRESULT hr;
@@ -19977,6 +20024,7 @@ START_TEST(domdoc)
     test_dtd_entity();
     test_element_setNamedItem();
     test_document_stream();
+    test_load_from_document_stream();
 
     if (is_clsid_supported(&CLSID_MXNamespaceManager40, &IID_IMXNamespaceManager))
     {
diff --git a/dlls/msxml3/xmlview.c b/dlls/msxml3/xmlview.c
index 9505eead03f..7584f0e9e16 100644
--- a/dlls/msxml3/xmlview.c
+++ b/dlls/msxml3/xmlview.c
@@ -526,8 +526,12 @@ static HRESULT WINAPI XMLView_BindStatusCallback_OnDataAvailable(
         return E_FAIL;
 
     do {
+        size = 0;
         hres = IStream_Read(pstgmed->pstm, buf, sizeof(buf), &size);
-        IStream_Write(This->stream, buf, size, &size);
+        /* E_PENDING may come with what was read before it; other failures with nothing */
+        if (FAILED(hres) && hres != E_PENDING)
+            break;
+        IStream_Write(This->stream, buf, min(size, sizeof(buf)), &size);
     } while(hres==S_OK && size);
 
     if(FAILED(hres) && hres!=E_PENDING)
