From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 11:33:44 -0400
Subject: [PATCH] win32u: Report WPF_RESTORETOMAXIMIZED as Windows does.

tools/ownerprobe in the wine-altars repository tried eighteen ways a
window gets to and leaves the flag on Windows 11.  GetWindowPlacement
reports it while the window is maximized, and otherwise only when the
window was minimized from maximized, or SetWindowPlacement minimized it
with the flag; any other SetWindowPlacement clears it, and restoring
and maximizing leave it as it is.  That is what Wine's own ShowWindow
tests in user32/tests/msg.c show as well.

Wine reported it after maximizing from normal and restoring, because
maximizing set it, and kept it through a SetWindowPlacement that
minimized the window without it.  Report a maximized window with the
flag instead, here and for the other processes that read the
placement, set it on maximizing only from minimized as before, and let
SetWindowPlacement set or clear it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/user32/tests/win.c b/dlls/user32/tests/win.c
index fc7a3924bb9..4325f4314cf 100644
--- a/dlls/user32/tests/win.c
+++ b/dlls/user32/tests/win.c
@@ -12746,6 +12746,76 @@ static void placement_screen_to_workarea(HWND hwnd, WINDOWPLACEMENT *wp, const R
     OffsetRect(&wp->rcNormalPosition, -work_rect->left, -work_rect->top);
 }
 
+/* WPF_RESTORETOMAXIMIZED is reported while a window is maximized, and otherwise only after it was
+ * minimized from maximized or SetWindowPlacement() minimized it with the flag; any other
+ * SetWindowPlacement() clears it, and restoring does not */
+static void test_restore_to_maximized_flag(void)
+{
+    static const struct
+    {
+        int prep[2];        /* ShowWindow commands after showing the window normally, -1 for none */
+        UINT cmd, flags;    /* SetWindowPlacement */
+        UINT before, after, restored;   /* the flags; restored: then ShowWindow(SW_RESTORE), ~0 for none */
+        BOOL zoomed;        /* then */
+    }
+    tests[] =
+    {
+        { { SW_MAXIMIZE, SW_RESTORE }, SW_SHOWMINIMIZED, WPF_RESTORETOMAXIMIZED, 0, WPF_RESTORETOMAXIMIZED,
+          WPF_RESTORETOMAXIMIZED, TRUE },
+        { { SW_MAXIMIZE, SW_RESTORE }, SW_SHOWMINIMIZED, 0, 0, 0, 0, FALSE },
+        { { SW_MAXIMIZE, -1 }, SW_SHOWNOACTIVATE, WPF_RESTORETOMAXIMIZED, WPF_RESTORETOMAXIMIZED, 0, ~0u },
+        { { SW_MAXIMIZE, SW_MINIMIZE }, SW_SHOWMINIMIZED, 0, WPF_RESTORETOMAXIMIZED, 0, 0, FALSE },
+        { { SW_MAXIMIZE, SW_MINIMIZE }, SW_SHOWMINNOACTIVE, 0, WPF_RESTORETOMAXIMIZED, 0, 0, FALSE },
+        { { SW_MINIMIZE, -1 }, SW_SHOWMINIMIZED, WPF_RESTORETOMAXIMIZED, 0, WPF_RESTORETOMAXIMIZED,
+          WPF_RESTORETOMAXIMIZED, TRUE },
+        { { -1, -1 }, SW_SHOWNOACTIVATE, WPF_RESTORETOMAXIMIZED, 0, 0, ~0u },
+        { { -1, -1 }, SW_SHOWMAXIMIZED, 0, 0, WPF_RESTORETOMAXIMIZED, ~0u },
+    };
+    WINDOWPLACEMENT wp;
+    unsigned int i, j;
+    HWND hwnd;
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context("%u", i);
+        hwnd = CreateWindowA("MainWindowClass", "placement", WS_OVERLAPPEDWINDOW, 100, 120, 300, 200,
+                0, 0, 0, NULL);
+        ok(!!hwnd, "CreateWindow failed.\n");
+        ShowWindow(hwnd, SW_SHOWNOACTIVATE);
+        for (j = 0; j < 2; j++) if (tests[i].prep[j] >= 0) ShowWindow(hwnd, tests[i].prep[j]);
+        wp.length = sizeof(wp);
+        GetWindowPlacement(hwnd, &wp);
+        ok(wp.flags == tests[i].before, "Unexpected flags %#x before.\n", wp.flags);
+        wp.flags = tests[i].flags;
+        wp.showCmd = tests[i].cmd;
+        ok(SetWindowPlacement(hwnd, &wp), "SetWindowPlacement failed, error %lu.\n", GetLastError());
+        GetWindowPlacement(hwnd, &wp);
+        ok(wp.flags == tests[i].after, "Unexpected flags %#x after.\n", wp.flags);
+        if (tests[i].restored != ~0u)
+        {
+            ShowWindow(hwnd, SW_RESTORE);
+            GetWindowPlacement(hwnd, &wp);
+            ok(wp.flags == tests[i].restored, "Unexpected flags %#x restored.\n", wp.flags);
+            ok(!!IsZoomed(hwnd) == tests[i].zoomed, "Unexpected zoomed state.\n");
+        }
+        DestroyWindow(hwnd);
+        winetest_pop_context();
+    }
+
+    /* maximized and restored, it is not restored maximized */
+    hwnd = CreateWindowA("MainWindowClass", "placement", WS_OVERLAPPEDWINDOW, 100, 120, 300, 200, 0, 0, 0, NULL);
+    ShowWindow(hwnd, SW_SHOWNOACTIVATE);
+    ShowWindow(hwnd, SW_MAXIMIZE);
+    ShowWindow(hwnd, SW_RESTORE);
+    wp.length = sizeof(wp);
+    GetWindowPlacement(hwnd, &wp);
+    ok(!wp.flags, "Unexpected flags %#x.\n", wp.flags);
+    ShowWindow(hwnd, SW_MINIMIZE);
+    ShowWindow(hwnd, SW_RESTORE);
+    ok(!IsZoomed(hwnd), "Restored maximized.\n");
+    DestroyWindow(hwnd);
+}
+
 static void test_window_placement(void)
 {
     RECT orig = {300, 400, 500, 600}, orig2 = {200, 300, 400, 500}, rect, work_rect;
@@ -15176,6 +15246,7 @@ START_TEST(win)
     test_destroy_quit();
     test_IsWindowEnabled();
     test_window_placement();
+    test_restore_to_maximized_flag();
     test_arrange_iconic_windows();
     test_other_process_window(argv[0]);
     test_SC_SIZE();
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index c050a162092..37fc5513d98 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -3293,7 +3293,7 @@ static BOOL get_other_process_placement( HWND hwnd, WINDOWPLACEMENT *placement )
     placement->length  = sizeof(*placement);
     if (style & WS_MINIMIZE) placement->showCmd = SW_SHOWMINIMIZED;
     else placement->showCmd = (style & WS_MAXIMIZE) ? SW_SHOWMAXIMIZED : SW_SHOWNORMAL;
-    placement->flags = flags;
+    placement->flags = flags | ((style & WS_MAXIMIZE) ? WPF_RESTORETOMAXIMIZED : 0);
     placement->ptMinPosition = empty_point( min_pos ) ? min_pos : map_dpi_point( min_pos, win_dpi, get_thread_dpi() );
     placement->ptMaxPosition = empty_point( max_pos ) ? max_pos : map_dpi_point( max_pos, win_dpi, get_thread_dpi() );
     placement->rcNormalPosition = map_dpi_rect( normal, win_dpi, get_thread_dpi() );
@@ -3370,7 +3370,8 @@ BOOL get_window_placement( HWND hwnd, WINDOWPLACEMENT *placement )
         placement->showCmd = SW_SHOWMINIMIZED;
     else
         placement->showCmd = ( win->dwStyle & WS_MAXIMIZE ) ? SW_SHOWMAXIMIZED : SW_SHOWNORMAL ;
-    if (win->flags & WIN_RESTORE_MAX)
+    /* a maximized window is restored maximized from minimized, and says so at once */
+    if ((win->flags & WIN_RESTORE_MAX) || (win->dwStyle & WS_MAXIMIZE))
         placement->flags = WPF_RESTORETOMAXIMIZED;
     else
         placement->flags = 0;
@@ -3530,11 +3531,12 @@ BOOL set_window_placement( HWND hwnd, const WINDOWPLACEMENT *wndpl, UINT flags )
 
     NtUserShowWindow( hwnd, wndpl->showCmd );
 
-    if (is_iconic( hwnd ))
-    {
-        if (wndpl->flags & WPF_RESTORETOMAXIMIZED)
-            win_set_flags( hwnd, WIN_RESTORE_MAX, 0 );
-    }
+    /* WPF_RESTORETOMAXIMIZED is what a minimized window is restored to, and is taken from the
+     * caller then; any other placement clears it, as on Windows */
+    if (is_iconic( hwnd ) && (wndpl->flags & WPF_RESTORETOMAXIMIZED))
+        win_set_flags( hwnd, WIN_RESTORE_MAX, 0 );
+    else
+        win_set_flags( hwnd, 0, WIN_RESTORE_MAX );
     sync_window_placement_hwnd( hwnd );
     return TRUE;
 }
@@ -5091,8 +5093,8 @@ static UINT window_min_maximize( HWND hwnd, UINT cmd, RECT *rect )
         minmax = get_min_max_info( hwnd );
 
         old_style = set_window_style_bits( hwnd, WS_MAXIMIZE, WS_MINIMIZE );
-        /* minimized from here it is restored maximized, and its placement says so at once */
-        win_set_flags( hwnd, WIN_RESTORE_MAX, 0 );
+        if (old_style & WS_MINIMIZE)
+            win_set_flags( hwnd, WIN_RESTORE_MAX, 0 );
 
         if (!(old_style & WS_MAXIMIZE)) swp_flags |= SWP_STATECHANGED;
         SetRect( rect, minmax.ptMaxPosition.x, minmax.ptMaxPosition.y,
