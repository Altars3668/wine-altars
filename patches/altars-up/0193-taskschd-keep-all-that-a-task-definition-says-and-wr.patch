+/* An xs:dateTime: 2004-01-01T00:00:00, with fractions of a second and a time zone if it likes. */
+static BOOL is_valid_date(const WCHAR *str)
+{
+    unsigned int value;
+
+    if (!parse_digits(&str, 4, 9999, &value) || *str++ != '-' ||
+        !parse_digits(&str, 2, 12, &value) || !value || *str++ != '-' ||
+        !parse_digits(&str, 2, 31, &value) || !value || *str++ != 'T' ||
+        !parse_digits(&str, 2, 24, &value) || *str++ != ':' ||
+        !parse_digits(&str, 2, 59, &value) || *str++ != ':' ||
+        !parse_digits(&str, 2, 60, &value))
+        return FALSE;
+    if (*str == '.')
+    {
+        if (*++str < '0' || *str > '9') return FALSE;
+        while (*str >= '0' && *str <= '9') ++str;
+    }
+    if (*str == 'Z') ++str;
+    else if (*str == '+' || *str == '-')
+    {
+        ++str;
+        if (!parse_digits(&str, 2, 14, &value) || *str++ != ':' || !parse_digits(&str, 2, 59, &value))
+            return FALSE;
+    }
+    return !*str;
+}
