+/* The XML a task written through the object model has, as Windows writes it, and the same XML read back. */
+static void test_XmlText(void)
+{
+    static const WCHAR expected[] =
+        L"<?xml version=\"1.0\" encoding=\"UTF-16\"?>\r\n"
+        "<Task version=\"1.2\" xmlns=\"http://schemas.microsoft.com/windows/2004/02/mit/task\">\r\n"
+        "  <RegistrationInfo>\r\n"
+        "    <Author>Wine</Author>\r\n"
+        "    <Description>written &amp; read</Description>\r\n"
+        "  </RegistrationInfo>\r\n"
+        "  <Triggers>\r\n"
+        "    <CalendarTrigger>\r\n"
+        "      <StartBoundary>2020-01-02T03:04:05</StartBoundary>\r\n"
+        "      <Enabled>true</Enabled>\r\n"
+        "      <RandomDelay>PT4H</RandomDelay>\r\n"
+        "      <ScheduleByDay>\r\n"
+        "        <DaysInterval>2</DaysInterval>\r\n"
+        "      </ScheduleByDay>\r\n"
+        "    </CalendarTrigger>\r\n"
+        "    <CalendarTrigger>\r\n"
+        "      <StartBoundary>2020-01-02T03:04:05</StartBoundary>\r\n"
+        "      <Enabled>true</Enabled>\r\n"
+        "      <ScheduleByWeek>\r\n"
+        "        <DaysOfWeek>\r\n"
+        "          <Monday />\r\n"
+        "          <Wednesday />\r\n"
+        "          <Friday />\r\n"
+        "        </DaysOfWeek>\r\n"
+        "        <WeeksInterval>3</WeeksInterval>\r\n"
+        "      </ScheduleByWeek>\r\n"
+        "    </CalendarTrigger>\r\n"
+        "    <LogonTrigger>\r\n"
+        "      <Enabled>false</Enabled>\r\n"
+        "      <Delay>PT5M</Delay>\r\n"
+        "    </LogonTrigger>\r\n"
+        "  </Triggers>\r\n"
+        "  <Principals>\r\n"
+        "    <Principal>\r\n"
+        "      <GroupId>S-1-5-32-545</GroupId>\r\n"
+        "      <RunLevel>HighestAvailable</RunLevel>\r\n"
+        "    </Principal>\r\n"
+        "  </Principals>\r\n"
+        "  <Settings>\r\n"
+        "    <MultipleInstancesPolicy>IgnoreNew</MultipleInstancesPolicy>\r\n"
+        "    <DisallowStartIfOnBatteries>true</DisallowStartIfOnBatteries>\r\n"
+        "    <StopIfGoingOnBatteries>true</StopIfGoingOnBatteries>\r\n"
+        "    <AllowHardTerminate>true</AllowHardTerminate>\r\n"
+        "    <StartWhenAvailable>true</StartWhenAvailable>\r\n"
+        "    <RunOnlyIfNetworkAvailable>false</RunOnlyIfNetworkAvailable>\r\n"
+        "    <IdleSettings>\r\n"
+        "      <Duration>PT10M</Duration>\r\n"
+        "      <WaitTimeout>PT1H</WaitTimeout>\r\n"
+        "      <StopOnIdleEnd>true</StopOnIdleEnd>\r\n"
+        "      <RestartOnIdle>false</RestartOnIdle>\r\n"
+        "    </IdleSettings>\r\n"
+        "    <AllowStartOnDemand>true</AllowStartOnDemand>\r\n"
+        "    <Enabled>true</Enabled>\r\n"
+        "    <Hidden>false</Hidden>\r\n"
+        "    <RunOnlyIfIdle>false</RunOnlyIfIdle>\r\n"
+        "    <WakeToRun>false</WakeToRun>\r\n"
+        "    <ExecutionTimeLimit>PT72H</ExecutionTimeLimit>\r\n"
+        "    <Priority>7</Priority>\r\n"
+        "    <RestartOnFailure>\r\n"
+        "      <Interval>PT30M</Interval>\r\n"
+        "      <Count>3</Count>\r\n"
+        "    </RestartOnFailure>\r\n"
+        "  </Settings>\r\n"
+        "  <Actions Context=\"Author\">\r\n"
+        "    <Exec id=\"first\">\r\n"
+        "      <Command>C:\\windows\\notepad.exe</Command>\r\n"
+        "      <Arguments>\"quoted &lt;arg&gt;\" &amp; more</Arguments>\r\n"
+        "    </Exec>\r\n"
+        "  </Actions>\r\n"
+        "</Task>";
+    ITaskDefinition *taskdef, *reread;
+    IDailyTrigger *daily;
+    IWeeklyTrigger *weekly;
+    ILogonTrigger *logon;
+    ITriggerCollection *triggers;
+    IActionCollection *actions;
+    IRegistrationInfo *info;
+    ITaskSettings *settings;
+    IPrincipal *principal;
+    ITaskService *service;
+    IExecAction *exec;
+    ITrigger *trigger;
+    IAction *action;
+    VARIANT v_null;
+    BSTR xml, again;
+    HRESULT hr;
+
+    hr = CoCreateInstance(&CLSID_TaskScheduler, NULL, CLSCTX_INPROC_SERVER, &IID_ITaskService, (void **)&service);
+    ok(hr == S_OK, "CoCreateInstance error %#lx\n", hr);
+    V_VT(&v_null) = VT_NULL;
+    hr = ITaskService_Connect(service, v_null, v_null, v_null, v_null);
+    ok(hr == S_OK, "Connect error %#lx\n", hr);
+    hr = ITaskService_NewTask(service, 0, &taskdef);
+    ok(hr == S_OK, "NewTask error %#lx\n", hr);
+
+    ITaskDefinition_get_RegistrationInfo(taskdef, &info);
+    IRegistrationInfo_put_Author(info, (BSTR)L"Wine");
+    IRegistrationInfo_put_Description(info, (BSTR)L"written & read");
+    IRegistrationInfo_Release(info);
+
+    ITaskDefinition_get_Principal(taskdef, &principal);
+    hr = IPrincipal_put_GroupId(principal, (BSTR)L"S-1-5-32-545");
+    ok(hr == S_OK, "put_GroupId error %#lx\n", hr);
+    hr = IPrincipal_put_RunLevel(principal, TASK_RUNLEVEL_HIGHEST);
+    ok(hr == S_OK, "put_RunLevel error %#lx\n", hr);
+    IPrincipal_Release(principal);
+
+    ITaskDefinition_get_Settings(taskdef, &settings);
+    ITaskSettings_put_StartWhenAvailable(settings, VARIANT_TRUE);
+    ITaskSettings_put_RestartCount(settings, 3);
+    ITaskSettings_put_RestartInterval(settings, (BSTR)L"PT30M");
+    ITaskSettings_Release(settings);
+
+    ITaskDefinition_get_Triggers(taskdef, &triggers);
+    hr = ITriggerCollection_Create(triggers, TASK_TRIGGER_DAILY, &trigger);
+    ok(hr == S_OK, "Create error %#lx\n", hr);
+    ITrigger_put_StartBoundary(trigger, (BSTR)L"2020-01-02T03:04:05");
+    hr = ITrigger_QueryInterface(trigger, &IID_IDailyTrigger, (void **)&daily);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+    IDailyTrigger_put_DaysInterval(daily, 2);
+    IDailyTrigger_put_RandomDelay(daily, (BSTR)L"PT4H");
+    IDailyTrigger_Release(daily);
+    ITrigger_Release(trigger);
+
+    hr = ITriggerCollection_Create(triggers, TASK_TRIGGER_WEEKLY, &trigger);
+    ok(hr == S_OK, "Create error %#lx\n", hr);
+    ITrigger_put_StartBoundary(trigger, (BSTR)L"2020-01-02T03:04:05");
+    hr = ITrigger_QueryInterface(trigger, &IID_IWeeklyTrigger, (void **)&weekly);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+    /* a bit a day from Sunday: Monday, Wednesday and Friday */
+    IWeeklyTrigger_put_DaysOfWeek(weekly, 0x2a);
+    IWeeklyTrigger_put_WeeksInterval(weekly, 3);
+    IWeeklyTrigger_Release(weekly);
+    ITrigger_Release(trigger);
+
+    hr = ITriggerCollection_Create(triggers, TASK_TRIGGER_LOGON, &trigger);
+    ok(hr == S_OK, "Create error %#lx\n", hr);
+    ITrigger_put_Enabled(trigger, VARIANT_FALSE);
+    hr = ITrigger_QueryInterface(trigger, &IID_ILogonTrigger, (void **)&logon);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+    ILogonTrigger_put_Delay(logon, (BSTR)L"PT5M");
+    ILogonTrigger_Release(logon);
+    ITrigger_Release(trigger);
+    ITriggerCollection_Release(triggers);
+
+    ITaskDefinition_get_Actions(taskdef, &actions);
+    IActionCollection_put_Context(actions, (BSTR)L"Author");
+    hr = IActionCollection_Create(actions, TASK_ACTION_EXEC, &action);
+    ok(hr == S_OK, "Create error %#lx\n", hr);
+    IAction_put_Id(action, (BSTR)L"first");
+    IAction_QueryInterface(action, &IID_IExecAction, (void **)&exec);
+    IExecAction_put_Path(exec, (BSTR)L"C:\\windows\\notepad.exe");
+    IExecAction_put_Arguments(exec, (BSTR)L"\"quoted <arg>\" & more");
+    IExecAction_Release(exec);
+    IAction_Release(action);
+    IActionCollection_Release(actions);
+
+    xml = NULL;
+    hr = ITaskDefinition_get_XmlText(taskdef, &xml);
+    ok(hr == S_OK, "get_XmlText error %#lx\n", hr);
+    ok(xml && !wcscmp(xml, expected), "got %s\n", wine_dbgstr_w(xml));
+
+    /* and what it reads is what it wrote */
+    hr = ITaskService_NewTask(service, 0, &reread);
+    ok(hr == S_OK, "NewTask error %#lx\n", hr);
+    hr = ITaskDefinition_put_XmlText(reread, xml);
+    ok(hr == S_OK, "put_XmlText error %#lx\n", hr);
+    again = NULL;
+    hr = ITaskDefinition_get_XmlText(reread, &again);
+    ok(hr == S_OK, "get_XmlText error %#lx\n", hr);
+    ok(again && !wcscmp(again, expected), "got %s\n", wine_dbgstr_w(again));
+
+    ITaskDefinition_get_Triggers(reread, &triggers);
+    hr = ITriggerCollection_get_Item(triggers, 2, &trigger);
+    ok(hr == S_OK, "get_Item error %#lx\n", hr);
+    hr = ITrigger_QueryInterface(trigger, &IID_IWeeklyTrigger, (void **)&weekly);
+    ok(hr == S_OK, "QueryInterface error %#lx\n", hr);
+    IWeeklyTrigger_Release(weekly);
+    ITrigger_Release(trigger);
+    ITriggerCollection_Release(triggers);
+
+    SysFreeString(again);
+    SysFreeString(xml);
+    ITaskDefinition_Release(reread);
+    ITaskDefinition_Release(taskdef);
+    ITaskService_Release(service);
+}
