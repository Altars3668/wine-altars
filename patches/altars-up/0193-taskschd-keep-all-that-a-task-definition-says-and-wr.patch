-typedef struct {
+static BOOL array_reserve(void **elements, SIZE_T *capacity, SIZE_T count, SIZE_T size)
+{
+    SIZE_T max_capacity, new_capacity;
+    void *new_elements;
+
+    if (count <= *capacity) return TRUE;
+
+    max_capacity = ~(SIZE_T)0 / size;
+    if (count > max_capacity) return FALSE;
+
+    new_capacity = max(4, *capacity);
+    while (new_capacity < count && new_capacity <= max_capacity / 2) new_capacity *= 2;
+    if (new_capacity < count) new_capacity = max_capacity;
+
+    if (!(new_elements = realloc(*elements, new_capacity * size))) return FALSE;
+
+    *elements = new_elements;
+    *capacity = new_capacity;
+    return TRUE;
+}
+
+static HRESULT get_string(const WCHAR *value, BSTR *out)
+{
+    if (!out) return E_POINTER;
+    if (!value) *out = NULL;
+    else if (!(*out = SysAllocString(value))) return E_OUTOFMEMORY;
+    return S_OK;
+}
+
+static HRESULT put_string(WCHAR **field, const WCHAR *value)
+{
+    WCHAR *str = NULL;
+
+    if (value && !(str = wcsdup(value))) return E_OUTOFMEMORY;
+    free(*field);
+    *field = str;
+    return S_OK;
+}
+
+static HRESULT get_bool(BOOL value, VARIANT_BOOL *out)
+{
+    if (!out) return E_POINTER;
+    *out = value ? VARIANT_TRUE : VARIANT_FALSE;
+    return S_OK;
+}
+
+/* Tasks keep accounts as SID strings, and give back the names of the accounts they are. */
+static WCHAR *account_from_sid_string(const WCHAR *str)
+{
+    WCHAR name[256], domain[256], *ret = NULL;
+    DWORD name_len = ARRAY_SIZE(name), domain_len = ARRAY_SIZE(domain);
+    SID_NAME_USE use;
+    PSID sid;
+
+    if (wcsnicmp(str, L"S-1-", 4) || !ConvertStringSidToSidW(str, &sid)) return NULL;
+    if (LookupAccountSidW(NULL, sid, name, &name_len, domain, &domain_len, &use))
+    {
+        if (use == SidTypeUser && *domain && (ret = malloc((domain_len + name_len + 2) * sizeof(WCHAR))))
+            swprintf(ret, domain_len + name_len + 2, L"%s\\%s", domain, name);
+        else if (use != SidTypeUser || !*domain)
+            ret = wcsdup(name);
+    }
+    LocalFree(sid);
+    return ret;
+}
+
+static WCHAR *sid_string_from_account(const WCHAR *account)
+{
+    WCHAR domain[256], *str, *ret;
+    DWORD sid_size = SECURITY_MAX_SID_SIZE, domain_len = ARRAY_SIZE(domain);
+    BYTE sid[SECURITY_MAX_SID_SIZE];
+    SID_NAME_USE use;
+
+    if (!wcsnicmp(account, L"S-1-", 4)) return wcsdup(account);
+    if (!LookupAccountNameW(NULL, account, sid, &sid_size, domain, &domain_len, &use) ||
+        !ConvertSidToStringSidW(sid, &str))
+        return wcsdup(account);
+    ret = wcsdup(str);
+    LocalFree(str);
+    return ret;
+}
+
+static BOOL is_service_account(const WCHAR *account)
+{
+    WCHAR *sid = sid_string_from_account(account);
+    BOOL ret = sid && (!wcsicmp(sid, L"S-1-5-18") || !wcsicmp(sid, L"S-1-5-19") || !wcsicmp(sid, L"S-1-5-20"));
+
+    free(sid);
+    return ret;
+}
+
+/* How a principal logs on when nothing says otherwise: as the group it names, as the service
+ * account it is, or with the interactive token of whoever is logged on. */
+static TASK_LOGON_TYPE implied_logon_type(const WCHAR *user_id, const WCHAR *group_id)
+{
+    if (group_id) return TASK_LOGON_GROUP;
+    if (user_id && is_service_account(user_id)) return TASK_LOGON_SERVICE_ACCOUNT;
+    return TASK_LOGON_INTERACTIVE_TOKEN;
+}
+
+static HRESULT get_account(const WCHAR *value, BSTR *out)
+{
+    WCHAR *account;
+    HRESULT hr;
+
+    if (!out) return E_POINTER;
+    if (!value || !(account = account_from_sid_string(value))) return get_string(value, out);
+    hr = get_string(account, out);
+    free(account);
+    return hr;
+}
