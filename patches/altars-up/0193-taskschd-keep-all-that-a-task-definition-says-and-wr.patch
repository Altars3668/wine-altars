+/* An xs:duration: PT1H, P30D, P1Y2M3DT4H5M6.7S. */
+static BOOL is_valid_duration(const WCHAR *str)
+{
+    const WCHAR *units = L"YMD", *unit;
+    BOOL any = FALSE, time = FALSE, fraction;
+
+    if (*str == '-') ++str;
+    if (*str++ != 'P') return FALSE;
+
+    while (*str)
+    {
+        const WCHAR *digits = str;
+
+        if (*str == 'T')
+        {
+            if (time || !str[1]) return FALSE;
+            time = TRUE;
+            units = L"HMS";
+            ++str;
+            continue;
+        }
+        fraction = FALSE;
+        while ((*str >= '0' && *str <= '9') || (*str == '.' && time && !fraction))
+            fraction |= *str++ == '.';
+        if (str == digits || !*str || !(unit = wcschr(units, *str))) return FALSE;
+        if (fraction && *str != 'S') return FALSE;
+        /* the units that may still follow */
+        units = unit + 1;
+        ++str;
+        any = TRUE;
+    }
+    return any;
