+            lsd.packed = (lsd.packed & ~7) | (bits & 7);
+            gif_get_byte(writer, L"BackgroundColorIndex", &lsd.background_color_index);
+            gif_get_byte(writer, L"PixelAspectRatio", &lsd.pixel_aspect_ratio);
+            if (SUCCEEDED(gif_get_value(writer, L"Signature", &value)))
