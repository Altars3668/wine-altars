             hr = IStream_Write(This->encoder->stream, &lsd, sizeof(lsd), NULL);
-            if (hr == S_OK && This->encoder->colors)
+            if (hr == S_OK && (lsd.packed & 0x80))
             {
                 UINT i;
 
                 /* Global Color Table */
                 memset(gif_palette, 0, sizeof(gif_palette));
-                for (i = 0; i < This->encoder->colors; i++)
