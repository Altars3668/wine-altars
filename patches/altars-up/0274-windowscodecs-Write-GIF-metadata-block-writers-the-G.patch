+struct gif_metadata_field
+{
+    const WCHAR *name;
+    VARTYPE type;
+};
+
+static const struct gif_metadata_field lsd_fields[] =
+{
+    { L"Signature", VT_UI1 | VT_VECTOR }, { L"Width", VT_UI2 }, { L"Height", VT_UI2 },
+    { L"GlobalColorTableFlag", VT_BOOL }, { L"ColorResolution", VT_UI1 },
+    { L"SortFlag", VT_BOOL }, { L"GlobalColorTableSize", VT_UI1 },
+    { L"BackgroundColorIndex", VT_UI1 }, { L"PixelAspectRatio", VT_UI1 },
+};
+
+static const struct gif_metadata_field imd_fields[] =
+{
+    { L"Left", VT_UI2 }, { L"Top", VT_UI2 }, { L"Width", VT_UI2 }, { L"Height", VT_UI2 },
+    { L"LocalColorTableFlag", VT_BOOL }, { L"InterlaceFlag", VT_BOOL },
+    { L"SortFlag", VT_BOOL }, { L"LocalColorTableSize", VT_UI1 },
+};
+
+static const struct gif_metadata_field gce_fields[] =
+{
+    { L"Disposal", VT_UI1 }, { L"UserInputFlag", VT_BOOL }, { L"TransparencyFlag", VT_BOOL },
+    { L"Delay", VT_UI2 }, { L"TransparentColorIndex", VT_UI1 },
+};
+
+static const struct gif_metadata_field ape_fields[] =
+{
+    { L"Application", VT_UI1 | VT_VECTOR }, { L"Data", VT_UI1 | VT_VECTOR },
+};
+
+static const struct gif_metadata_field comment_fields[] = { { L"TextEntry", VT_LPSTR } };
+
+static void gif_metadata_fields(const GUID *clsid, const struct gif_metadata_field **fields, UINT *count)
+{
+    if (IsEqualGUID(clsid, &CLSID_WICLSDMetadataWriter))
+        *fields = lsd_fields, *count = ARRAY_SIZE(lsd_fields);
+    else if (IsEqualGUID(clsid, &CLSID_WICIMDMetadataWriter))
+        *fields = imd_fields, *count = ARRAY_SIZE(imd_fields);
+    else if (IsEqualGUID(clsid, &CLSID_WICGCEMetadataWriter))
+        *fields = gce_fields, *count = ARRAY_SIZE(gce_fields);
+    else if (IsEqualGUID(clsid, &CLSID_WICAPEMetadataWriter))
+        *fields = ape_fields, *count = ARRAY_SIZE(ape_fields);
+    else
+        *fields = comment_fields, *count = ARRAY_SIZE(comment_fields);
+}
+
+static HRESULT validate_gif_metadata(MetadataHandler *handler, const PROPVARIANT *id, const PROPVARIANT *value)
+{
+    const struct gif_metadata_field *fields;
+    UINT count, i;
+
+    gif_metadata_fields(handler->vtable->clsid, &fields, &count);
+    if (id->vt != VT_LPWSTR) return WINCODEC_ERR_PROPERTYNOTFOUND;
+
+    for (i = 0; i < count; ++i)
+    {
+        if (lstrcmpiW(id->pwszVal, fields[i].name)) continue;
+        if (value->vt != fields[i].type) return WINCODEC_ERR_PROPERTYUNEXPECTEDTYPE;
+        if (value->vt == (VT_UI1 | VT_VECTOR) &&
+                ((IsEqualGUID(handler->vtable->clsid, &CLSID_WICAPEMetadataWriter) && !i &&
+                    value->caub.cElems != 11) ||
+                 (IsEqualGUID(handler->vtable->clsid, &CLSID_WICLSDMetadataWriter) && !i &&
+                    value->caub.cElems != 6)))
+            return E_INVALIDARG;
+        if (IsEqualGUID(handler->vtable->clsid, &CLSID_WICIMDMetadataWriter) && i == 5 && value->boolVal)
+            return WINCODEC_ERR_UNSUPPORTEDOPERATION; /* Interlaced LZW rows are not implemented. */
+        return S_OK;
+    }
+    return WINCODEC_ERR_PROPERTYNOTFOUND;
+}
+
+static HRESULT create_gif_writer_items(MetadataHandler *handler)
+{
+    const struct gif_metadata_field *fields;
+    UINT count, i;
+    HRESULT hr;
+
+    gif_metadata_fields(handler->vtable->clsid, &fields, &count);
+    if (IsEqualGUID(handler->vtable->clsid, &CLSID_WICLSDMetadataWriter) ||
+            IsEqualGUID(handler->vtable->clsid, &CLSID_WICIMDMetadataWriter))
+        return S_OK;
+    if (IsEqualGUID(handler->vtable->clsid, &CLSID_WICGifCommentMetadataWriter))
+        return CreateGifCommentHandler(handler);
+
+    if (!(handler->items = calloc(count, sizeof(*handler->items)))) return E_OUTOFMEMORY;
+    handler->item_count = count;
+    for (i = 0; i < count; ++i)
+    {
+        hr = init_propvar_from_string(fields[i].name, &handler->items[i].id);
+        if (FAILED(hr)) return hr;
+        handler->items[i].value.vt = fields[i].type;
+    }
+    if (IsEqualGUID(handler->vtable->clsid, &CLSID_WICAPEMetadataWriter))
+        handler->items[0].value.vt = VT_EMPTY;
+    return S_OK;
+}
+
+static const MetadataHandlerVtbl LSDWriter_Vtbl =
+{
+    METADATAHANDLER_IS_WRITER, &CLSID_WICLSDMetadataWriter, load_LSD_metadata,
+    create_gif_writer_items, validate_gif_metadata,
+};
