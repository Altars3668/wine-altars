+static IWICMetadataWriter *gif_get_writer(const struct gif_metadata_blocks *blocks, const GUID *format)
+{
+    GUID writer_format;
+    size_t i;
+
+    for (i = 0; i < blocks->count; ++i)
+    {
+        if (SUCCEEDED(IWICMetadataWriter_GetMetadataFormat(blocks->writers[i], &writer_format)) &&
+                IsEqualGUID(&writer_format, format))
+            return blocks->writers[i];
+    }
+    return NULL;
+}
+
+static HRESULT gif_get_value(IWICMetadataWriter *writer, const WCHAR *name, PROPVARIANT *value)
+{
+    PROPVARIANT id;
+
+    if (!writer) return WINCODEC_ERR_PROPERTYNOTFOUND;
+    PropVariantInit(value);
+    id.vt = VT_LPWSTR;
+    id.pwszVal = (WCHAR *)name;
+    return IWICMetadataWriter_GetValue(writer, NULL, &id, value);
+}
+
+static void gif_get_byte(IWICMetadataWriter *writer, const WCHAR *name, BYTE *byte)
+{
+    PROPVARIANT value;
+
+    if (SUCCEEDED(gif_get_value(writer, name, &value)))
+    {
+        if (value.vt == VT_UI1) *byte = value.bVal;
+        PropVariantClear(&value);
+    }
+}
+
+static void gif_get_word(IWICMetadataWriter *writer, const WCHAR *name, USHORT *word)
+{
+    PROPVARIANT value;
+
+    if (SUCCEEDED(gif_get_value(writer, name, &value)))
+    {
+        if (value.vt == VT_UI2) *word = value.uiVal;
+        PropVariantClear(&value);
+    }
+}
+
+static void gif_get_flag(IWICMetadataWriter *writer, const WCHAR *name, BYTE *packed, BYTE mask)
+{
+    PROPVARIANT value;
+
+    if (SUCCEEDED(gif_get_value(writer, name, &value)))
+    {
+        if (value.vt == VT_BOOL)
+            *packed = (*packed & ~mask) | (value.boolVal ? mask : 0);
+        PropVariantClear(&value);
+    }
+}
+
+static HRESULT gif_write_extension(IStream *stream, IWICMetadataWriter *writer, const GUID *format)
+{
+    static const BYTE ape_header[] = { 0x21, 0xff, 0x0b };
+    static const BYTE gce_header[] = { 0x21, 0xf9, 0x04 };
+    static const BYTE comment_header[] = { 0x21, 0xfe };
+    PROPVARIANT application, data, value;
+    BYTE gce[4] = { 0 }, terminator = 0;
+    USHORT delay = 0;
+    UINT offset, size, data_size;
+    HRESULT hr;
+
+    if (IsEqualGUID(format, &GUID_MetadataFormatGCE))
+    {
+        gif_get_byte(writer, L"Disposal", &gce[0]);
+        gce[0] = (gce[0] & 7) << 2;
+        gif_get_flag(writer, L"UserInputFlag", &gce[0], 2);
+        gif_get_flag(writer, L"TransparencyFlag", &gce[0], 1);
+        gif_get_word(writer, L"Delay", &delay);
+        gce[1] = delay & 0xff;
+        gce[2] = delay >> 8;
+        gif_get_byte(writer, L"TransparentColorIndex", &gce[3]);
+        if (FAILED(hr = IStream_Write(stream, gce_header, sizeof(gce_header), NULL))) return hr;
+        if (FAILED(hr = IStream_Write(stream, gce, sizeof(gce), NULL))) return hr;
+        return IStream_Write(stream, &terminator, 1, NULL);
+    }
+
+    if (IsEqualGUID(format, &GUID_MetadataFormatAPE))
+    {
+        hr = gif_get_value(writer, L"Application", &application);
+        if (FAILED(hr)) return hr;
+        if (application.vt != (VT_UI1 | VT_VECTOR) || application.caub.cElems != 11)
+        {
+            PropVariantClear(&application);
+            return WINCODEC_ERR_PROPERTYUNEXPECTEDTYPE;
+        }
+        hr = gif_get_value(writer, L"Data", &data);
+        if (FAILED(hr))
+        {
+            PropVariantClear(&application);
+            return hr;
+        }
+        data_size = data.caub.cElems;
+        if (data.vt != (VT_UI1 | VT_VECTOR)) hr = WINCODEC_ERR_PROPERTYUNEXPECTEDTYPE;
+        else
+        {
+            for (offset = 0; offset < data_size; offset += size + 1)
+            {
+                size = data.caub.pElems[offset];
+                if (!size && offset == data_size - 1)
+                {
+                    data_size = offset;
+                    break;
+                }
+                if (!size || size >= data_size - offset)
+                {
+                    hr = E_INVALIDARG;
+                    break;
+                }
+            }
+        }
+        if (SUCCEEDED(hr)) hr = IStream_Write(stream, ape_header, sizeof(ape_header), NULL);
+        if (SUCCEEDED(hr)) hr = IStream_Write(stream, application.caub.pElems, 11, NULL);
+        if (SUCCEEDED(hr))
+        {
+            if (data_size) hr = IStream_Write(stream, data.caub.pElems, data_size, NULL);
+        }
+        if (SUCCEEDED(hr)) hr = IStream_Write(stream, &terminator, 1, NULL);
+        PropVariantClear(&application);
+        PropVariantClear(&data);
+        return hr;
+    }
+
+    hr = gif_get_value(writer, L"TextEntry", &value);
+    if (FAILED(hr)) return hr;
+    if (value.vt != VT_LPSTR)
+    {
+        PropVariantClear(&value);
+        return WINCODEC_ERR_PROPERTYUNEXPECTEDTYPE;
+    }
+    hr = IStream_Write(stream, comment_header, sizeof(comment_header), NULL);
+    size = strlen(value.pszVal);
+    for (offset = 0; SUCCEEDED(hr) && offset < size; offset += 255)
+    {
+        BYTE length = min(size - offset, 255);
+        hr = IStream_Write(stream, &length, 1, NULL);
+        if (SUCCEEDED(hr)) hr = IStream_Write(stream, value.pszVal + offset, length, NULL);
+    }
+    if (SUCCEEDED(hr)) hr = IStream_Write(stream, &terminator, 1, NULL);
+    PropVariantClear(&value);
+    return hr;
+}
+
+static HRESULT gif_write_extensions(IStream *stream, const struct gif_metadata_blocks *blocks)
+{
+    const GUID *first = blocks->frame ? &GUID_MetadataFormatGCE : &GUID_MetadataFormatAPE;
+    GUID format;
+    UINT pass;
+    size_t i;
+    HRESULT hr;
+
+    for (pass = 0; pass < 2; ++pass)
+    {
+        for (i = 0; i < blocks->count; ++i)
+        {
+            if (FAILED(hr = IWICMetadataWriter_GetMetadataFormat(blocks->writers[i], &format))) return hr;
+            if (IsEqualGUID(&format, pass ? &GUID_MetadataFormatGifComment : first))
+                if (FAILED(hr = gif_write_extension(stream, blocks->writers[i], &format))) return hr;
+        }
+    }
+    return S_OK;
+}
