+        ok(value.vt == VT_UI1 && value.bVal == expected, "%s: got type %u, byte %u\n",
+                wine_dbgstr_w(name), value.vt, value.bVal);
+        PropVariantClear(&value);
+    }
+}
+
+static void check_gif_query_word(IWICMetadataQueryReader *reader, const WCHAR *name, USHORT expected)
+{
+    PROPVARIANT value;
+    HRESULT hr;
+
+    PropVariantInit(&value);
+    hr = IWICMetadataQueryReader_GetMetadataByName(reader, name, &value);
+    ok(hr == S_OK, "%s: GetMetadataByName failed %#lx\n", wine_dbgstr_w(name), hr);
+    if (SUCCEEDED(hr))
+    {
+        ok(value.vt == VT_UI2 && value.uiVal == expected, "%s: got type %u, word %u\n",
+                wine_dbgstr_w(name), value.vt, value.uiVal);
+        PropVariantClear(&value);
+    }
+}
+
+static void test_gif_metadata_writers(void)
+{
+    static const struct
+    {
+        const GUID *format;
+        const CLSID *clsid;
+        UINT count;
+    } writers[] =
+    {
+        { &GUID_MetadataFormatLSD, &CLSID_WICLSDMetadataWriter, 0 },
+        { &GUID_MetadataFormatIMD, &CLSID_WICIMDMetadataWriter, 0 },
+        { &GUID_MetadataFormatGCE, &CLSID_WICGCEMetadataWriter, 5 },
+        { &GUID_MetadataFormatAPE, &CLSID_WICAPEMetadataWriter, 2 },
+        { &GUID_MetadataFormatGifComment, &CLSID_WICGifCommentMetadataWriter, 1 },
+    };
+    IWICComponentFactory *component_factory;
+    IWICMetadataWriter *writer;
+    IWICMetadataQueryWriter *query;
+    PROPVARIANT value;
+    UINT count, i;
+    HRESULT hr;
+
+    hr = IWICImagingFactory_QueryInterface(factory, &IID_IWICComponentFactory, (void **)&component_factory);
+    ok(hr == S_OK, "QueryInterface failed %#lx\n", hr);
+    if (FAILED(hr)) return;
+    for (i = 0; i < ARRAY_SIZE(writers); ++i)
+    {
+        hr = IWICComponentFactory_CreateMetadataWriter(component_factory, writers[i].format, NULL, 0, &writer);
+        ok(hr == S_OK, "writer %u: CreateMetadataWriter failed %#lx\n", i, hr);
+        if (FAILED(hr)) continue;
+        hr = IWICMetadataWriter_GetCount(writer, &count);
+        /* UNMEASURED: new LSD/IMD writers start empty; GCE/APE/comment have default items. */
+        ok(hr == S_OK && count == writers[i].count, "writer %u: count %u, hr %#lx\n", i, count, hr);
+        IWICMetadataWriter_Release(writer);
+        hr = CoCreateInstance(writers[i].clsid, NULL, CLSCTX_INPROC_SERVER,
+                &IID_IWICMetadataWriter, (void **)&writer);
+        ok(hr == S_OK, "writer %u: CoCreateInstance failed %#lx\n", i, hr);
+        if (SUCCEEDED(hr)) IWICMetadataWriter_Release(writer);
+    }
+
+    hr = IWICImagingFactory_CreateQueryWriter(factory, &GUID_MetadataFormatGCE, NULL, &query);
+    ok(hr == S_OK, "CreateQueryWriter failed %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        value.vt = VT_UI2;
+        value.uiVal = 41;
+        hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/Delay", &value);
+        ok(hr == S_OK, "generic SetMetadataByName failed %#lx\n", hr);
+        check_gif_query_word((IWICMetadataQueryReader *)query, L"/Delay", 41);
+        value.vt = VT_UI1;
+        /* UNMEASURED: wrong type is rejected on Set rather than on Commit. */
+        hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/Delay", &value);
+        ok(hr == WINCODEC_ERR_PROPERTYUNEXPECTEDTYPE, "wrong type: hr %#lx\n", hr);
+        /* UNMEASURED: unknown fields cannot be added to a GIF metadata block. */
+        hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/Missing", &value);
+        ok(hr == WINCODEC_ERR_PROPERTYNOTFOUND, "missing item: hr %#lx\n", hr);
+        IWICMetadataQueryWriter_Release(query);
+    }
+    IWICComponentFactory_Release(component_factory);
+}
+
+static void test_gif_encode_metadata(void)
+{
+    static BYTE application[] = "NETSCAPE2.0";
+    static BYTE loop_data[] = { 3, 1, 0, 0, 0 }; /* optional trailing terminator */
+    static const BYTE ape[] = { 0x21, 0xff, 0x0b, 'N','E','T','S','C','A','P','E','2','.','0', 3,1,0,0,0 };
+    static const BYTE comment[] = { 0x21, 0xfe, 3, 'g','i','f', 0 };
+    static const BYTE gce0[] = { 0x21, 0xf9, 4, 9, 50, 0, 1, 0 };
+    static const BYTE frame_comment[] = { 0x21, 0xfe, 3, 'o','n','e', 0 };
+    static const BYTE gce1[] = { 0x21, 0xf9, 4, 8, 75, 0, 0, 0 };
+    IWICBitmapEncoder *encoder;
+    IWICBitmapFrameEncode *frame;
+    IWICMetadataBlockWriter *blocks;
+    IWICMetadataBlockReader *reader_blocks;
+    IWICMetadataQueryWriter *query;
+    IWICMetadataQueryReader *reader_query;
+    IWICBitmapDecoder *decoder;
+    IWICBitmapFrameDecode *decoded_frame;
+    IWICMetadataWriter *block_writer;
+    IWICMetadataReader *block_reader;
+    IWICPalette *palette;
+    IEnumUnknown *enumerator;
+    IUnknown *unknown;
+    PROPVARIANT value;
+    LARGE_INTEGER zero = { 0 };
+    WICColor colors[] = { 0xff000000, 0xffffffff };
+    GUID format, container;
+    HGLOBAL hglobal;
+    IStream *stream;
+    BYTE pixel = 0, *bytes;
+    SIZE_T length, offset;
+    ULONG fetched;
+    UINT count, i;
+    HRESULT hr;
+
+    hr = CreateStreamOnHGlobal(NULL, TRUE, &stream);
+    ok(hr == S_OK, "CreateStreamOnHGlobal failed %#lx\n", hr);
+    if (FAILED(hr)) return;
+    hr = IWICImagingFactory_CreateEncoder(factory, &GUID_ContainerFormatGif, NULL, &encoder);
+    ok(hr == S_OK, "CreateEncoder failed %#lx\n", hr);
+    if (FAILED(hr)) { IStream_Release(stream); return; }
+    hr = IWICBitmapEncoder_GetMetadataQueryWriter(encoder, &query);
+    ok(hr == WINCODEC_ERR_NOTINITIALIZED, "GetMetadataQueryWriter before Initialize: %#lx\n", hr);
+    hr = IWICBitmapEncoder_Initialize(encoder, stream, WICBitmapEncoderNoCache);
+    ok(hr == S_OK, "Initialize failed %#lx\n", hr);
+    hr = IWICBitmapEncoder_QueryInterface(encoder, &IID_IWICMetadataBlockWriter, (void **)&blocks);
+    /* UNMEASURED: GIF encoder exposes IWICMetadataBlockWriter. */
+    ok(hr == S_OK, "encoder block QueryInterface failed %#lx\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IWICMetadataBlockWriter_GetContainerFormat(blocks, &container);
+    ok(hr == S_OK && IsEqualGUID(&container, &GUID_ContainerFormatGif), "container format %#lx\n", hr);
+    hr = IWICMetadataBlockWriter_GetCount(blocks, &count);
+    /* UNMEASURED: the new encoder has no blocks until a metadata query creates one. */
+    ok(hr == S_OK && !count, "new encoder block count %u, hr %#lx\n", count, hr);
+    hr = IWICMetadataBlockWriter_GetEnumerator(blocks, &enumerator);
+    ok(hr == S_OK, "GetEnumerator failed %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IEnumUnknown_Next(enumerator, 1, &unknown, &fetched);
+        ok(hr == S_FALSE && !fetched, "empty enumerator: %#lx, count %lu\n", hr, fetched);
+        IEnumUnknown_Release(enumerator);
+    }
+    hr = IWICBitmapEncoder_GetMetadataQueryWriter(encoder, &query);
+    ok(hr == S_OK, "GetMetadataQueryWriter failed %#lx\n", hr);
+    if (FAILED(hr)) { IWICMetadataBlockWriter_Release(blocks); goto done; }
+
+    value.vt = VT_UI1 | VT_VECTOR;
+    value.caub.cElems = 11;
+    value.caub.pElems = application;
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/appext/Application", &value);
+    ok(hr == S_OK, "Set Application failed %#lx\n", hr);
+    value.caub.cElems = sizeof(loop_data);
+    value.caub.pElems = loop_data;
+    /* UNMEASURED: accept an optional trailing zero without doubling the terminator. */
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/appext/Data", &value);
+    ok(hr == S_OK, "Set Data failed %#lx\n", hr);
+    value.caub.cElems = 6;
+    value.caub.pElems = (BYTE *)"GIF89a";
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/Signature", &value);
+    ok(hr == S_OK, "Set Signature failed %#lx\n", hr);
+    value.vt = VT_LPSTR;
+    value.pszVal = (char *)"gif";
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/commentext/TextEntry", &value);
+    ok(hr == S_OK, "Set comment failed %#lx\n", hr);
+    value.vt = VT_UI2;
+    value.uiVal = 2;
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/Width", &value);
+    ok(hr == S_OK, "Set screen width failed %#lx\n", hr);
+    value.uiVal = 1;
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/Height", &value);
+    ok(hr == S_OK, "Set screen height failed %#lx\n", hr);
+    value.vt = VT_UI1;
+    value.bVal = 1;
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/BackgroundColorIndex", &value);
+    ok(hr == S_OK, "Set background failed %#lx\n", hr);
+    value.bVal = 27;
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/PixelAspectRatio", &value);
+    ok(hr == S_OK, "Set aspect ratio failed %#lx\n", hr);
+    value.bVal = 6;
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/ColorResolution", &value);
+    ok(hr == S_OK, "Set color resolution failed %#lx\n", hr);
+    value.bVal = 7;
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/GlobalColorTableSize", &value);
+    ok(hr == S_OK, "Set global table size failed %#lx\n", hr);
+    value.vt = VT_BOOL;
+    value.boolVal = VARIANT_TRUE;
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/SortFlag", &value);
+    ok(hr == S_OK, "Set sort flag failed %#lx\n", hr);
+    hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/logscrdesc/GlobalColorTableFlag", &value);
+    ok(hr == S_OK, "Set global table flag failed %#lx\n", hr);
+    check_gif_query_word((IWICMetadataQueryReader *)query, L"/logscrdesc/Width", 2);
+    PropVariantInit(&value);
+    hr = IWICMetadataQueryWriter_GetMetadataByName(query, L"/appext/Data", &value);
+    ok(hr == S_OK && value.vt == (VT_UI1 | VT_VECTOR) && value.caub.cElems == sizeof(loop_data) &&
+            !memcmp(value.caub.pElems, loop_data, sizeof(loop_data)), "writer Data read-back %#lx\n", hr);
+    if (SUCCEEDED(hr)) PropVariantClear(&value);
+    IWICMetadataQueryWriter_Release(query);
+    hr = IWICMetadataBlockWriter_GetCount(blocks, &count);
+    ok(hr == S_OK && count == 3, "encoder blocks %u, hr %#lx\n", count, hr);
+    hr = IWICMetadataBlockWriter_GetWriterByIndex(blocks, 0, &block_writer);
+    ok(hr == S_OK, "GetWriterByIndex failed %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IWICMetadataBlockWriter_SetWriterByIndex(blocks, 0, block_writer);
+        ok(hr == S_OK, "SetWriterByIndex failed %#lx\n", hr);
+        IWICMetadataWriter_Release(block_writer);
+    }
+    hr = IWICMetadataBlockWriter_GetReaderByIndex(blocks, 0, &block_reader);
+    ok(hr == S_OK, "GetReaderByIndex failed %#lx\n", hr);
+    if (SUCCEEDED(hr)) IWICMetadataReader_Release(block_reader);
+    hr = IWICMetadataBlockWriter_GetEnumerator(blocks, &enumerator);
+    ok(hr == S_OK, "GetEnumerator failed %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IEnumUnknown_Next(enumerator, 1, &unknown, &fetched);
+        ok(hr == S_OK && fetched == 1, "enumerator Next failed %#lx, %lu\n", hr, fetched);
+        if (SUCCEEDED(hr)) IUnknown_Release(unknown);
+        IEnumUnknown_Release(enumerator);
+    }
+    IWICMetadataBlockWriter_Release(blocks);
+
+    hr = IWICImagingFactory_CreatePalette(factory, &palette);
+    ok(hr == S_OK, "CreatePalette failed %#lx\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IWICPalette_InitializeCustom(palette, colors, ARRAY_SIZE(colors));
+    ok(hr == S_OK, "InitializeCustom failed %#lx\n", hr);
+    hr = IWICBitmapEncoder_SetPalette(encoder, palette);
+    ok(hr == S_OK, "SetPalette failed %#lx\n", hr);
+    IWICPalette_Release(palette);
+
+    for (i = 0; i < 2; ++i)
+    {
+        hr = IWICBitmapEncoder_CreateNewFrame(encoder, &frame, NULL);
+        ok(hr == S_OK, "CreateNewFrame %u failed %#lx\n", i, hr);
+        if (FAILED(hr)) break;
+        hr = IWICBitmapFrameEncode_Initialize(frame, NULL);
+        ok(hr == S_OK, "frame Initialize failed %#lx\n", hr);
+        hr = IWICBitmapFrameEncode_SetSize(frame, 1, 1);
+        ok(hr == S_OK, "SetSize failed %#lx\n", hr);
+        format = GUID_WICPixelFormat8bppIndexed;
+        hr = IWICBitmapFrameEncode_SetPixelFormat(frame, &format);
+        ok(hr == S_OK, "SetPixelFormat failed %#lx\n", hr);
+        hr = IWICBitmapFrameEncode_QueryInterface(frame, &IID_IWICMetadataBlockWriter, (void **)&blocks);
+        ok(hr == S_OK, "frame block QI failed %#lx\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IWICMetadataBlockWriter_GetCount(blocks, &count);
+            /* UNMEASURED: an empty frame has no metadata blocks. */
+            ok(hr == S_OK && !count, "empty frame blocks %u, hr %#lx\n", count, hr);
+            IWICMetadataBlockWriter_Release(blocks);
+        }
+        hr = IWICBitmapFrameEncode_GetMetadataQueryWriter(frame, &query);
+        ok(hr == S_OK, "frame GetMetadataQueryWriter failed %#lx\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            value.vt = VT_LPWSTR;
+            value.pwszVal = (WCHAR *)L"bad";
+            /* UNMEASURED: an unsupported GIF block is rejected. */
+            hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/xmp/dc:title", &value);
+            ok(hr == WINCODEC_ERR_UNSUPPORTEDOPERATION, "unsupported frame block: hr %#lx\n", hr);
+            value.vt = VT_UI2;
+            value.uiVal = i ? 75 : 50;
+            hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/grctlext/Delay", &value);
+            ok(hr == S_OK, "Set Delay failed %#lx\n", hr);
+            value.vt = VT_UI1;
+            value.bVal = 2;
+            hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/grctlext/Disposal", &value);
+            ok(hr == S_OK, "Set Disposal failed %#lx\n", hr);
+            if (!i)
+            {
+                value.vt = VT_BOOL;
+                value.boolVal = VARIANT_TRUE;
+                hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/grctlext/TransparencyFlag", &value);
+                ok(hr == S_OK, "Set transparency failed %#lx\n", hr);
+                value.vt = VT_UI1;
+                value.bVal = 1;
+                hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/grctlext/TransparentColorIndex", &value);
+                ok(hr == S_OK, "Set transparent index failed %#lx\n", hr);
+                value.vt = VT_UI2;
+                value.uiVal = 1;
+                hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/imgdesc/Left", &value);
+                ok(hr == S_OK, "Set image Left failed %#lx\n", hr);
+                value.vt = VT_BOOL;
+                value.boolVal = VARIANT_TRUE;
+                hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/imgdesc/InterlaceFlag", &value);
+                /* UNMEASURED: refuse interlacing until GIF LZW row reordering is implemented. */
+                ok(hr == WINCODEC_ERR_UNSUPPORTEDOPERATION, "InterlaceFlag: hr %#lx\n", hr);
+                hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/imgdesc/SortFlag", &value);
+                ok(hr == S_OK, "Set image SortFlag failed %#lx\n", hr);
+            }
+            else
+            {
+                /* a comment before the first image is the file's, as the decoder reads it; this one is the
+                 * second frame's */
+                value.vt = VT_LPSTR;
+                value.pszVal = (char *)"one";
+                hr = IWICMetadataQueryWriter_SetMetadataByName(query, L"/commentext/TextEntry", &value);
+                ok(hr == S_OK, "Set frame comment failed %#lx\n", hr);
+            }
+            IWICMetadataQueryWriter_Release(query);
+        }
+        hr = IWICBitmapFrameEncode_WritePixels(frame, 1, 1, 1, &pixel);
+        ok(hr == S_OK, "WritePixels failed %#lx\n", hr);
+        hr = IWICBitmapFrameEncode_Commit(frame);
+        ok(hr == S_OK, "frame Commit failed %#lx\n", hr);
+        IWICBitmapFrameEncode_Release(frame);
+    }
+    hr = IWICBitmapEncoder_Commit(encoder);
+    ok(hr == S_OK, "encoder Commit failed %#lx\n", hr);
+    hr = GetHGlobalFromStream(stream, &hglobal);
+    ok(hr == S_OK, "GetHGlobalFromStream failed %#lx\n", hr);
+    if (FAILED(hr)) goto done;
+    bytes = GlobalLock(hglobal);
+    length = GlobalSize(hglobal);
+    ok(length > 13 + 768 + sizeof(ape) + sizeof(comment) + sizeof(gce0), "GIF too short: %Iu\n", length);
+    if (length > 13 + 768 + sizeof(ape) + sizeof(comment) + sizeof(gce0))
+    {
+        ok(!memcmp(bytes, "GIF89a", 6) && bytes[6] == 2 && bytes[8] == 1,
+                "wrong screen descriptor\n");
+        ok(bytes[10] == 0xef && bytes[11] == 1 && bytes[12] == 27,
+                "wrong flags/background/aspect: %#x/%u/%u\n", bytes[10], bytes[11], bytes[12]);
+        offset = 13 + 768;
+        ok(!memcmp(bytes + offset, ape, sizeof(ape)), "NETSCAPE2.0 extension bytes differ\n");
+        offset += sizeof(ape);
+        ok(!memcmp(bytes + offset, comment, sizeof(comment)), "comment extension bytes differ\n");
+        offset += sizeof(comment);
+        ok(!memcmp(bytes + offset, gce0, sizeof(gce0)), "frame 0 GCE bytes differ\n");
+        offset += sizeof(gce0);
+        ok(bytes[offset] == 0x2c && bytes[offset + 1] == 1 && bytes[offset + 9] == 0x20,
+                "frame 0 image position/flags differ\n");
+        offset += 10 + 1; /* image descriptor and LZW minimum code size */
+        while (offset < length && bytes[offset]) offset += 1 + bytes[offset];
+        ++offset; /* image data terminator */
+        ok(offset + sizeof(gce1) < length && !memcmp(bytes + offset, gce1, sizeof(gce1)),
+                "frame 1 GCE bytes differ at %Iu\n", offset);
+        offset += sizeof(gce1);
+        ok(offset + sizeof(frame_comment) < length && !memcmp(bytes + offset, frame_comment, sizeof(frame_comment)),
+                "frame comment bytes differ at %Iu\n", offset);
+        ok(bytes[length - 1] == 0x3b, "GIF trailer missing\n");
+    }
+    GlobalUnlock(hglobal);
+
+    IStream_Seek(stream, zero, STREAM_SEEK_SET, NULL);
+    hr = IWICImagingFactory_CreateDecoderFromStream(factory, stream, NULL, WICDecodeMetadataCacheOnDemand, &decoder);
+    ok(hr == S_OK, "decode encoded GIF failed %#lx\n", hr);
+    if (FAILED(hr)) goto done;
+    hr = IWICBitmapDecoder_GetFrameCount(decoder, &count);
+    ok(hr == S_OK && count == 2, "decoded frames %u, hr %#lx\n", count, hr);
+    hr = IWICBitmapDecoder_GetMetadataQueryReader(decoder, &reader_query);
+    ok(hr == S_OK, "file query reader failed %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        check_gif_query_word(reader_query, L"/logscrdesc/Width", 2);
+        check_gif_query_byte(reader_query, L"/logscrdesc/BackgroundColorIndex", 1);
+        check_gif_query_byte(reader_query, L"/logscrdesc/PixelAspectRatio", 27);
+        check_gif_query_byte(reader_query, L"/logscrdesc/ColorResolution", 6);
+        check_gif_query_byte(reader_query, L"/logscrdesc/GlobalColorTableSize", 7);
+        PropVariantInit(&value);
+        hr = IWICMetadataQueryReader_GetMetadataByName(reader_query, L"/appext/Data", &value);
+        ok(hr == S_OK && value.vt == (VT_UI1 | VT_VECTOR) && value.caub.cElems == 4 &&
+                !memcmp(value.caub.pElems, loop_data, 4), "loop data read-back hr %#lx, type %u\n", hr, value.vt);
+        if (SUCCEEDED(hr)) PropVariantClear(&value);
+        PropVariantInit(&value);
+        hr = IWICMetadataQueryReader_GetMetadataByName(reader_query, L"/commentext/TextEntry", &value);
+        ok(hr == S_OK && value.vt == VT_LPSTR && !strcmp(value.pszVal, "gif"), "comment read-back %#lx\n", hr);
+        if (SUCCEEDED(hr)) PropVariantClear(&value);
+        IWICMetadataQueryReader_Release(reader_query);
+    }
+    for (i = 0; i < 2; ++i)
+    {
+        hr = IWICBitmapDecoder_GetFrame(decoder, i, &decoded_frame);
+        ok(hr == S_OK, "GetFrame %u failed %#lx\n", i, hr);
+        if (FAILED(hr)) break;
+        hr = IWICBitmapFrameDecode_GetMetadataQueryReader(decoded_frame, &reader_query);
+        ok(hr == S_OK, "frame query reader failed %#lx\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            check_gif_query_word(reader_query, L"/grctlext/Delay", i ? 75 : 50);
+            check_gif_query_byte(reader_query, L"/grctlext/Disposal", 2);
+            check_gif_query_word(reader_query, L"/imgdesc/Left", i ? 0 : 1);
+            if (i)
+            {
+                PropVariantInit(&value);
+                hr = IWICMetadataQueryReader_GetMetadataByName(reader_query, L"/commentext/TextEntry", &value);
+                ok(hr == S_OK && value.vt == VT_LPSTR && !strcmp(value.pszVal, "one"),
+                        "frame comment read-back %#lx\n", hr);
+                if (SUCCEEDED(hr)) PropVariantClear(&value);
+            }
+            IWICMetadataQueryReader_Release(reader_query);
+        }
+        IWICBitmapFrameDecode_Release(decoded_frame);
+    }
+    hr = IWICBitmapDecoder_QueryInterface(decoder, &IID_IWICMetadataBlockReader, (void **)&reader_blocks);
+    ok(hr == S_OK, "decoder block reader QI failed %#lx\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        IWICBitmapEncoder *copy_encoder;
+        IWICMetadataBlockWriter *copy_blocks;
+        IStream *copy_stream;
+
+        hr = CreateStreamOnHGlobal(NULL, TRUE, &copy_stream);
+        ok(hr == S_OK, "CreateStreamOnHGlobal failed %#lx\n", hr);
+        hr = IWICImagingFactory_CreateEncoder(factory, &GUID_ContainerFormatGif, NULL, &copy_encoder);
+        ok(hr == S_OK, "CreateEncoder failed %#lx\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IWICBitmapEncoder_Initialize(copy_encoder, copy_stream, WICBitmapEncoderNoCache);
+            ok(hr == S_OK, "copy Initialize failed %#lx\n", hr);
+            hr = IWICBitmapEncoder_QueryInterface(copy_encoder, &IID_IWICMetadataBlockWriter, (void **)&copy_blocks);
+            ok(hr == S_OK, "copy block QI failed %#lx\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                hr = IWICMetadataBlockWriter_InitializeFromBlockReader(copy_blocks, reader_blocks);
+                ok(hr == S_OK, "InitializeFromBlockReader failed %#lx\n", hr);
+                hr = IWICMetadataBlockWriter_GetCount(copy_blocks, &count);
+                ok(hr == S_OK && count == 3, "copied block count %u, hr %#lx\n", count, hr);
+                hr = IWICMetadataBlockWriter_RemoveWriterByIndex(copy_blocks, 1);
+                ok(hr == S_OK, "RemoveWriterByIndex failed %#lx\n", hr);
+                hr = IWICMetadataBlockWriter_GetCount(copy_blocks, &count);
+                ok(hr == S_OK && count == 2, "remaining block count %u, hr %#lx\n", count, hr);
+                IWICMetadataBlockWriter_Release(copy_blocks);
+            }
+            IWICBitmapEncoder_Release(copy_encoder);
+        }
+        IStream_Release(copy_stream);
+        IWICMetadataBlockReader_Release(reader_blocks);
+    }
+    IWICBitmapDecoder_Release(decoder);
+
+done:
+    IWICBitmapEncoder_Release(encoder);
+    IStream_Release(stream);
+}
