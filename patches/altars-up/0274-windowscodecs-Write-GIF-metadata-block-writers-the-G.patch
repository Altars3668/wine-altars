+static HRESULT WINAPI GifEncoderFrame_Block_InitializeFromBlockReader(IWICMetadataBlockWriter *iface,
+        IWICMetadataBlockReader *block_reader)
+{
+    struct gif_metadata_blocks *blocks = impl_from_gif_block(iface), copy = *blocks;
+    IWICMetadataReader *reader;
+    IWICMetadataWriter *writer;
+    GUID format;
+    UINT count, i;
+    HRESULT hr;
+
+    if (!block_reader) return E_INVALIDARG;
+    if (FAILED(hr = IWICMetadataBlockReader_GetContainerFormat(block_reader, &format))) return hr;
+    if (!IsEqualGUID(&format, &GUID_ContainerFormatGif)) return WINCODEC_ERR_UNSUPPORTEDOPERATION;
+    if (FAILED(hr = IWICMetadataBlockReader_GetCount(block_reader, &count))) return hr;
+
+    copy.writers = NULL;
+    copy.count = copy.capacity = 0;
+    for (i = 0; i < count; ++i)
+    {
+        if (FAILED(hr = IWICMetadataBlockReader_GetReaderByIndex(block_reader, i, &reader))) break;
+        hr = create_metadata_writer_from_reader(reader, &GUID_VendorMicrosoft, &writer);
+        IWICMetadataReader_Release(reader);
+        if (FAILED(hr)) break;
+        hr = GifEncoderFrame_Block_AddWriter(&copy.IWICMetadataBlockWriter_iface, writer);
+        IWICMetadataWriter_Release(writer);
+        if (FAILED(hr)) break;
+    }
+    if (SUCCEEDED(hr))
+    {
+        EnterCriticalSection(blocks->lock);
+        gif_metadata_blocks_cleanup(blocks);
+        blocks->writers = copy.writers;
+        blocks->count = copy.count;
+        blocks->capacity = copy.capacity;
+        LeaveCriticalSection(blocks->lock);
+    }
+    else
+        gif_metadata_blocks_cleanup(&copy);
+    return hr;
 }
 
