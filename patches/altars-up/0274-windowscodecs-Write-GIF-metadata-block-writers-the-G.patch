+            bits = lsd.packed >> 4 & 7;
+            gif_get_byte(writer, L"ColorResolution", &bits);
+            lsd.packed = (lsd.packed & ~0x70) | ((bits & 7) << 4);
+            bits = lsd.packed & 7;
