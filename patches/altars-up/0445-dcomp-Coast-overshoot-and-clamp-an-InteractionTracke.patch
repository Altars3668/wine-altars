+/* whether a custom animation has left it past its bounds */
+static BOOL tracker_past_bounds( struct tracker *tracker )
+{
+    Vector3 low, high;
+    float low_scale, high_scale;
+
+    tracker_bounds( tracker, &low, &high, &low_scale, &high_scale );
+    return tracker->position.X < low.X || tracker->position.X > max( low.X, high.X ) ||
+           tracker->position.Y < low.Y || tracker->position.Y > max( low.Y, high.Y ) ||
+           tracker->scale < low_scale || tracker->scale > max( low_scale, high_scale );
+}
