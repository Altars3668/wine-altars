-/* one axis of inertia -- x, y, or the logarithm of scale -- slowing as its decay rate says */
+/*
+ * One axis of inertia -- x, y or scale -- coasting until it is too slow to go
+ * on, and springing back to a bound it coasted past, or was past when it
+ * started.
+ */
 struct inertia_axis
 {
