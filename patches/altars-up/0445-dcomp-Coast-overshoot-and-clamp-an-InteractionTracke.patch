-    float rest;                     /* where it comes to rest: naturally, or where a modifier says, within bounds */
+    float k;                        /* how fast that decays: -ln(1 - the decay rate) */
+    float stop;                     /* the speed it stops at */
+    float rest;                     /* where it stops */
+    float low, high;                /* its bounds */
+    BOOL spring;                    /* springing back to a bound */
+    float target, x0, v0, t0;       /* the bound, how far past it and how fast it was, and when */
     float at, speed;                /* where the latest frame put it, and how fast it went there */
     BOOL moving;
