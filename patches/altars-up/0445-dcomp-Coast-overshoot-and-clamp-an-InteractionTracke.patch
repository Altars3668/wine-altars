@@ -1896,39 +1917,73 @@ static void tracker_enter( struct tracker *tracker, enum tracker_state state, IN
 /*** inertia ***/
 
 /*
- * An axis in inertia loses the same fraction of its velocity every second, the
- * decay rate: after t seconds it goes at v * (1 - rate)^t, and it has covered
- * v * (1 - (1 - rate)^t) / k of the v / k it covers in all, k being
- * -ln(1 - rate).  Where it comes to rest can be moved -- by an inertia modifier,
- * or by a bound in the way -- and then the same curve is stretched to end there.
- * Scale coasts the same way in its logarithm: its velocity is a fraction of
- * itself per second.
+ * What Windows 11 does, frame by frame (tools/trackerprobe, inertia.c): an
+ * axis in inertia loses the same fraction of its velocity every second, the
+ * decay rate -- after t seconds it goes at v * exp(-k * t), k being
+ * -ln(1 - rate), and it has gone v / k * (1 - exp(-k * t)) -- until it goes
+ * slower than 30 pixels a second, and so comes to rest (v - 30) / k from where
+ * it started.  Scale coasts the same way, stopping below 0.05 a second, and
+ * goes no faster than 5.  A bound in its way it overshoots, and a spring,
+ * damped not quite critically, brings it back onto the bound; so it does when
+ * it starts past one.  Where a modifier says it rests, the same curve starts
+ * as fast as it takes to stop there.
  */
 #define DEFAULT_DECAY_RATE 0.95f
+#define POSITION_STOP_SPEED 30.0f
+#define SCALE_STOP_SPEED 0.05f
+#define SCALE_MAX_SPEED 5.0f
+#define SPRING_DAMPING 0.9f
+#define SPRING_FREQUENCY 15.0f          /* radians per second */
+#define SPRING_SETTLED 0.05f            /* the swing left when it is done */
 
-static void inertia_axis_at( struct inertia_axis *axis, float t, float epsilon )
+/* switches an axis to the spring that brings it back to a bound */
+static void inertia_axis_spring( struct inertia_axis *axis, float target, float t )
 {
-    float k, f;
+    axis->spring = TRUE;
+    axis->target = target;
+    axis->x0 = axis->at - target;
+    axis->v0 = axis->speed;
+    axis->t0 = t;
+}
+
+/* where an axis is t seconds after inertia started */
+static void inertia_axis_at( struct inertia_axis *axis, float t )
+{
+    float f, zw, wd, tau, b, c, s;
 
     if (!axis->moving) return;
-    if (axis->rate <= 0.0f)
+    if (!axis->spring)
     {
-        /* nothing slows it: it goes on at its speed until it gets where it rests, which is a bound */
-        axis->at = axis->from + axis->velocity * t;
-        axis->speed = axis->velocity;
-        if (axis->velocity > 0.0f ? axis->at >= axis->rest : axis->at <= axis->rest) axis->moving = FALSE;
+        f = axis->k > 0.0f ? expf( -axis->k * t ) : 1.0f;
+        axis->speed = axis->velocity * f;
+        if (axis->k > 0.0f) axis->at = axis->from + axis->velocity / axis->k * (1.0f - f);
+        else axis->at = axis->from + axis->velocity * t;
+        if (axis->at > axis->high) inertia_axis_spring( axis, axis->high, t );
+        else if (axis->at < axis->low) inertia_axis_spring( axis, axis->low, t );
+        else if (fabsf( axis->speed ) < axis->stop)
+        {
+            axis->at = axis->rest;
+            axis->speed = 0.0f;
+            axis->moving = FALSE;
+        }
+        return;
     }
-    else
+
+    zw = SPRING_DAMPING * SPRING_FREQUENCY;
+    wd = SPRING_FREQUENCY * sqrtf( 1.0f - SPRING_DAMPING * SPRING_DAMPING );
+    tau = t - axis->t0;
+    f = expf( -zw * tau );
+    c = cosf( wd * tau );
+    s = sinf( wd * tau );
+    b = (axis->v0 + zw * axis->x0) / wd;
+    axis->at = axis->target + f * (axis->x0 * c + b * s);
+    axis->speed = f * ((b * wd - zw * axis->x0) * c - (axis->x0 * wd + zw * b) * s);
+    if (sqrtf( axis->x0 * axis->x0 + b * b ) * f < SPRING_SETTLED)
     {
-        k = -logf( 1.0f - min( axis->rate, 0.999999f ) );
-        f = expf( -k * t );
-        axis->at = axis->from + (axis->rest - axis->from) * (1.0f - f);
-        axis->speed = (axis->rest - axis->from) * k * f;
-        if (fabsf( axis->rest - axis->at ) < epsilon) axis->moving = FALSE;
+        axis->at = axis->target;
+        axis->speed = 0.0f;
+        axis->moving = FALSE;
     }
-    if (axis->moving) return;
-    axis->at = axis->rest;
-    axis->speed = 0.0f;
 }
 
