     tracker->position.Z = clampf( tracker->position.Z, low.Z, max( low.Z, high.Z ) );
 }
 
+/* keeps scale within its bounds */
+static void tracker_clamp_scale( struct tracker *tracker )
+{
+    Vector3 low, high;
+    float low_scale, high_scale;
+
+    tracker_bounds( tracker, &low, &high, &low_scale, &high_scale );
+    tracker->scale = clampf( tracker->scale, low_scale, max( low_scale, high_scale ) );
+}
+
 /*
- * Keeps an idle tracker within its bounds as they change.  A position a request
- * asked for without clamping is kept: the bounds clamp where the tracker is,
- * and it goes there once they allow it.  Office scrolls so, to where the bounds
- * its content's size animates will reach, and waits for the tracker to get there.
+ * Keeps an idle tracker within its bounds as they change, telling the owner
+ * when they move it -- with the latest request's id.  It keeps no memory of
+ * where a request asked it to be: on Windows a position asked for past the
+ * bounds, clamping disabled or not, is clamped there and then, and stays where
+ * that put it when the bounds move away (tools/trackerprobe, clamp.c).
  */
-static void tracker_clamp_idle( struct tracker *tracker )
+static void tracker_clamp_idle( struct tracker *tracker, BOOL in_frame )
 {
-    if (tracker->position_unclamped) tracker->position = tracker->unclamped_position;
-    tracker_clamp( tracker, FALSE );
-    if (tracker->position_unclamped &&
-        !memcmp( &tracker->position, &tracker->unclamped_position, sizeof(tracker->position) ))
-        tracker->position_unclamped = FALSE;
+    Vector3 position = tracker->position;
+    float scale = tracker->scale;
+
+    if (tracker->state != TRACKER_IDLE) return;
+    tracker_clamp( tracker );
+    if (!memcmp( &position, &tracker->position, sizeof(position) ) && scale == tracker->scale) return;
+    tracker->natural_resting_position = tracker->position;
+    tracker->natural_resting_scale = tracker->scale;
+    /* in a frame there is a frame already: another would make them run back to back */
+    if (!in_frame) tracker_values_changed( tracker, tracker->request_id );
+    else
+    {
+        tracker_tell_owner( tracker, CALLBACK_VALUES_CHANGED, tracker->request_id );
+        tracker_follow_binding( tracker );
+    }
 }
 
