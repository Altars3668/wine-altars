 static void test_WTSQueryUserToken(void)
 {
+    TOKEN_PRIVILEGES privs, prev;
+    DWORD console, session, size;
+    TOKEN_STATISTICS stats;
+    HANDLE token, process_token;
     BOOL ret;
 
     SetLastError(0xdeadbeef);
     ret = WTSQueryUserToken(WTS_CURRENT_SESSION, NULL);
     ok(!ret, "expected WTSQueryUserToken to fail\n");
     ok(GetLastError()==ERROR_INVALID_PARAMETER, "expected ERROR_INVALID_PARAMETER got: %ld\n", GetLastError());
+
+    /* for a caller with SeTcbPrivilege enabled only, which is to say services running as SYSTEM */
+    console = WTSGetActiveConsoleSessionId();
+    SetLastError(0xdeadbeef);
+    token = (HANDLE)0xdeadbeef;
+    ret = WTSQueryUserToken(console, &token);
+    ok(!ret, "expected WTSQueryUserToken to fail\n");
+    ok(GetLastError() == ERROR_PRIVILEGE_NOT_HELD, "got error %lu\n", GetLastError());
+    if (ret) CloseHandle(token);
+
+    ret = OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY | TOKEN_ADJUST_PRIVILEGES, &process_token);
+    ok(ret, "got error %lu\n", GetLastError());
+    privs.PrivilegeCount = 1;
+    ret = LookupPrivilegeValueA(NULL, "SeTcbPrivilege", &privs.Privileges[0].Luid);
+    ok(ret, "got error %lu\n", GetLastError());
+    privs.Privileges[0].Attributes = SE_PRIVILEGE_ENABLED;
+    ret = AdjustTokenPrivileges(process_token, FALSE, &privs, sizeof(prev), &prev, &size);
+    ok(ret, "got error %lu\n", GetLastError());
+    if (GetLastError() == ERROR_NOT_ALL_ASSIGNED)
+    {
+        skip("SeTcbPrivilege is not held.\n");
+        CloseHandle(process_token);
+        return;
+    }
+
+    /* the token of the user signed in to the session: a primary token in that session */
+    token = NULL;
+    ret = WTSQueryUserToken(console, &token);
+    ok(ret, "got error %lu\n", GetLastError());
+    if (ret)
+    {
+        session = 0xdeadbeef;
+        ret = GetTokenInformation(token, TokenSessionId, &session, sizeof(session), &size);
+        ok(ret, "got error %lu\n", GetLastError());
+        ok(session == console, "got session %lu, expected %lu\n", session, console);
+        ret = GetTokenInformation(token, TokenStatistics, &stats, sizeof(stats), &size);
+        ok(ret, "got error %lu\n", GetLastError());
+        ok(stats.TokenType == TokenPrimary, "got type %u\n", stats.TokenType);
+        CloseHandle(token);
+    }
+
+    /* no one signs in to the services' session */
+    SetLastError(0xdeadbeef);
+    token = (HANDLE)0xdeadbeef;
+    ret = WTSQueryUserToken(0, &token);
+    ok(!ret, "expected WTSQueryUserToken to fail\n");
+    ok(GetLastError() == ERROR_NO_TOKEN, "got error %lu\n", GetLastError());
+
+    ret = AdjustTokenPrivileges(process_token, FALSE, &prev, 0, NULL, NULL);
+    ok(ret, "got error %lu\n", GetLastError());
+    CloseHandle(process_token);
 }
 
 static void test_WTSEnumerateSessions(void)
@@ -407,7 +462,7 @@ static void test_WTSEnumerateSessions(void)
 
     bret = WTSEnumerateSessionsW(WTS_CURRENT_SERVER_HANDLE, 0, 1, &info, &count);
     ok(bret, "got error %lu.\n", GetLastError());
-    todo_wine_if(count == 1) ok(count >= 2, "got %lu.\n", count);
+    ok(count >= 2, "got %lu.\n", count);
 
     bret = WTSEnumerateSessionsA(WTS_CURRENT_SERVER_HANDLE, 0, 1, &infoA, &count2);
     ok(bret, "got error %lu.\n", GetLastError());
@@ -430,7 +485,7 @@ static void test_WTSEnumerateSessions(void)
         }
     }
     ok(console_found, "Console session not found.\n");
-    todo_wine ok(services_found, "Services session not found.\n");
+    ok(services_found, "Services session not found.\n");
 
     WTSFreeMemory(info);
     WTSFreeMemory(infoA);
diff --git a/dlls/wtsapi32/wtsapi32.c b/dlls/wtsapi32/wtsapi32.c
index 79450c7579b..59d3e4f1b3f 100644
--- a/dlls/wtsapi32/wtsapi32.c
+++ b/dlls/wtsapi32/wtsapi32.c
@@ -24,10 +24,23 @@
 #include "winnls.h"
 #include "lmcons.h"
 #include "wtsapi32.h"
+#include "winsta.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(wtsapi);
 
+static DWORD get_session_id( DWORD session_id )
+{
+    if (session_id == WTS_CURRENT_SESSION) ProcessIdToSessionId( GetCurrentProcessId(), &session_id );
+    return session_id;
+}
+
+/* the user signs in to the console session; session 0 is the services', never connected to anything */
+static WTS_CONNECTSTATE_CLASS get_session_state( DWORD session_id )
+{
+    return session_id && session_id == WTSGetActiveConsoleSessionId() ? WTSActive : WTSDisconnected;
+}
+
 
 /************************************************************
  *                WTSCloseServer  (WTSAPI32.@)
@@ -347,27 +360,37 @@ BOOL WINAPI WTSEnumerateSessionsA(HANDLE server, DWORD reserved, DWORD version,
 BOOL WINAPI WTSEnumerateSessionsW(HANDLE server, DWORD reserved, DWORD version,
         PWTS_SESSION_INFOW *session_info, DWORD *count)
 {
-    static const WCHAR session_name[] = L"Console";
+    SESSIONIDW *sessions;
+    ULONG total, size, i;
+    WCHAR *name;
 
-    FIXME("%p 0x%08lx 0x%08lx %p %p semi-stub.\n", server, reserved, version, session_info, count);
+    TRACE("%p 0x%08lx 0x%08lx %p %p.\n", server, reserved, version, session_info, count);
 
     if (!session_info || !count) return FALSE;
 
-    if (!(*session_info = malloc(sizeof(**session_info) + sizeof(session_name))))
