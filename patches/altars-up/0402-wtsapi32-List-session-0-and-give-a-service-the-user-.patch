+    if (!(*session_info = malloc(size)))
     {
+        WinStationFreeMemory(sessions);
         SetLastError(ERROR_OUTOFMEMORY);
         return FALSE;
     }
-    if (!ProcessIdToSessionId( GetCurrentProcessId(), &(*session_info)->SessionId))
+
+    name = (WCHAR *)(*session_info + total);
+    for (i = 0; i < total; ++i)
     {
-        WTSFreeMemory(*session_info);
-        return FALSE;
+        (*session_info)[i].SessionId = sessions[i].SessionId;
+        /* the same states in the same order */
+        (*session_info)[i].State = (WTS_CONNECTSTATE_CLASS)sessions[i].State;
+        (*session_info)[i].pWinStationName = name;
+        wcscpy(name, sessions[i].WinStationName);
+        name += wcslen(name) + 1;
     }
-    *count = 1;
-    (*session_info)->State = WTSActive;
-    (*session_info)->pWinStationName = (WCHAR *)((char *)*session_info + sizeof(**session_info));
-    memcpy((*session_info)->pWinStationName, session_name, sizeof(session_name));
-
+    *count = total;
+    WinStationFreeMemory(sessions);
     return TRUE;
 }
 
@@ -559,7 +582,7 @@ BOOL WINAPI WTSQuerySessionInformationW(HANDLE server, DWORD session_id, WTS_INF
         WTS_CONNECTSTATE_CLASS *state;
 
         if (!(state = malloc(sizeof(*state)))) return FALSE;
-        *state = WTSActive;
