@@ -642,19 +661,82 @@ BOOL WINAPI WTSQuerySessionInformationW(HANDLE server, DWORD session_id, WTS_INF
 /************************************************************
  *                WTSQueryUserToken (WTSAPI32.@)
  */
+/* whether the caller has SeTcbPrivilege enabled, as SYSTEM does */
+static BOOL has_tcb_privilege(void)
+{
+    TOKEN_PRIVILEGES *privs;
+    HANDLE token;
+    DWORD size, i;
+    BOOL ret = FALSE;
+
+    if (!OpenThreadToken(GetCurrentThread(), TOKEN_QUERY, TRUE, &token) &&
+        !OpenProcessToken(GetCurrentProcess(), TOKEN_QUERY, &token))
+        return FALSE;
+    if (!GetTokenInformation(token, TokenPrivileges, NULL, 0, &size) && GetLastError() == ERROR_INSUFFICIENT_BUFFER &&
+        (privs = malloc(size)))
+    {
+        if (GetTokenInformation(token, TokenPrivileges, privs, size, &size))
+        {
+            for (i = 0; i < privs->PrivilegeCount; i++)
+                if (privs->Privileges[i].Luid.LowPart == SE_TCB_PRIVILEGE && !privs->Privileges[i].Luid.HighPart)
+                    ret = !!(privs->Privileges[i].Attributes & SE_PRIVILEGE_ENABLED);
+        }
+        free(privs);
+    }
+    CloseHandle(token);
+    return ret;
+}
+
 BOOL WINAPI WTSQueryUserToken(ULONG session_id, PHANDLE token)
 {
-    FIXME("%lu %p semi-stub!\n", session_id, token);
+    TOKEN_PRIVILEGES privs = { .PrivilegeCount = 1 };
+    HANDLE process_token, user_token;
+
+    TRACE("%lu %p\n", session_id, token);
 
     if (!token)
     {
         SetLastError(ERROR_INVALID_PARAMETER);
         return FALSE;
     }
+    if (!has_tcb_privilege())
+    {
+        SetLastError(ERROR_PRIVILEGE_NOT_HELD);
+        return FALSE;
+    }
 
-    return DuplicateHandle(GetCurrentProcess(), GetCurrentProcessToken(),
-                           GetCurrentProcess(), token,
-                           0, FALSE, DUPLICATE_SAME_ACCESS);
+    /* the user is signed in to the console session only; to session 0, the services', no one is */
+    session_id = get_session_id(session_id);
+    if (!session_id)
+    {
+        SetLastError(ERROR_NO_TOKEN);
+        return FALSE;
+    }
+    if (session_id != WTSGetActiveConsoleSessionId())
+    {
+        SetLastError(ERROR_FILE_NOT_FOUND);
+        return FALSE;
+    }
+
+    /* there is one user, the caller's, whose token it then is, in that session and without SeTcbPrivilege
+     * enabled: the user's own does not have it */
+    if (!OpenProcessToken(GetCurrentProcess(), TOKEN_DUPLICATE, &process_token)) return FALSE;
+    if (!DuplicateTokenEx(process_token, TOKEN_ALL_ACCESS, NULL, SecurityImpersonation, TokenPrimary, &user_token))
+    {
+        CloseHandle(process_token);
+        return FALSE;
+    }
+    CloseHandle(process_token);
+    privs.Privileges[0].Luid.LowPart = SE_TCB_PRIVILEGE;
+    privs.Privileges[0].Attributes = 0;
+    if (!SetTokenInformation(user_token, TokenSessionId, &session_id, sizeof(session_id)) ||
+        !AdjustTokenPrivileges(user_token, FALSE, &privs, 0, NULL, NULL))
+    {
+        CloseHandle(user_token);
+        return FALSE;
+    }
+    *token = user_token;
+    return TRUE;
 }
 
