     const unsigned int replace = flags & FILE_RENAME_REPLACE_IF_EXISTS;
 
     if (!fd->inode || !fd->unix_name)
@@ -3015,11 +3042,12 @@ static void set_fd_name( struct fd *fd, struct fd *root, const char *nameptr, da
 
     free( fd->nt_name );
     fd->nt_name = dup_nt_name( root, nt_name, &fd->nt_namelen );
-    free( fd->unix_name );
+    old_name = fd->unix_name;
     fd->closed->unix_name = fd->unix_name = realpath( name, NULL );
     free( name );
-    if (!fd->unix_name)
-        set_error( STATUS_NO_MEMORY );
+    if (fd->unix_name) rename_other_opens( fd, old_name );
+    else set_error( STATUS_NO_MEMORY );
+    free( old_name );
     return;
 
