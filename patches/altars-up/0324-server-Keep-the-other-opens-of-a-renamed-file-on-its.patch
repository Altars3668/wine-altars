+/* the other opens of a renamed file by the name it had, and the deletes pending on that name, follow it */
+static void rename_other_opens( struct fd *fd, const char *old_name )
+{
+    struct closed_fd *closed;
+    struct fd *fd_ptr;
+    char *name;
+
+    LIST_FOR_EACH_ENTRY( fd_ptr, &fd->inode->open, struct fd, inode_entry )
+    {
+        if (fd_ptr == fd || !fd_ptr->unix_name || strcmp( fd_ptr->unix_name, old_name )) continue;
+        if (!(name = strdup( fd->unix_name ))) continue;
+        free( fd_ptr->unix_name );
+        fd_ptr->unix_name = name;
+        if (fd_ptr->closed) fd_ptr->closed->unix_name = name;
+        free( fd_ptr->nt_name );
+        fd_ptr->nt_namelen = 0;
+        if ((fd_ptr->nt_name = memdup( fd->nt_name, fd->nt_namelen ))) fd_ptr->nt_namelen = fd->nt_namelen;
+    }
+    LIST_FOR_EACH_ENTRY( closed, &fd->inode->closed, struct closed_fd, entry )
+    {
+        if (!closed->unix_name || strcmp( closed->unix_name, old_name )) continue;
+        if (!(name = strdup( fd->unix_name ))) continue;
+        free( closed->unix_name );
+        closed->unix_name = name;
+    }
+}
+
