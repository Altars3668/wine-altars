--- a/server/fd.c
+++ b/server/fd.c
@@ -2885,13 +2885,40 @@ static void set_fd_disposition( struct fd *fd, unsigned int flags )
         ((fd->options & FILE_DELETE_ON_CLOSE) ? FILE_DISPOSITION_DELETE : 0);
