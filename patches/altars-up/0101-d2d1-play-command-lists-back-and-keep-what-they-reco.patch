@@ -219,6 +219,12 @@ struct d2d_command_draw_sprite_batch
     D2D1_SPRITE_OPTIONS sprite_options;
 };
 
+/* the variable data a command keeps is where it is from the command; see d2d_command_list_write_field() */
+static inline const void *d2d_command_field(const void *command, const void *field)
+{
+    return field ? (const BYTE *)command + (ULONG_PTR)field : NULL;
+}
+
 static inline struct d2d_command_list *impl_from_ID2D1CommandList(ID2D1CommandList *iface)
 {
     return CONTAINING_RECORD(iface, struct d2d_command_list, ID2D1CommandList_iface);
@@ -387,7 +393,21 @@ static HRESULT STDMETHODCALLTYPE d2d_command_list_Stream(ID2D1CommandList *iface
             case D2D_COMMAND_DRAW_GLYPH_RUN:
             {
                 const struct d2d_command_draw_glyph_run *c = data;
-                hr = ID2D1CommandSink_DrawGlyphRun(sink, c->origin, &c->run, c->run_desc, c->brush, c->measuring_mode);
+                const DWRITE_GLYPH_RUN_DESCRIPTION *d = d2d_command_field(c, c->run_desc);
+                DWRITE_GLYPH_RUN_DESCRIPTION desc;
+                DWRITE_GLYPH_RUN run = c->run;
+
+                run.glyphIndices = d2d_command_field(c, c->run.glyphIndices);
+                run.glyphAdvances = d2d_command_field(c, c->run.glyphAdvances);
+                run.glyphOffsets = d2d_command_field(c, c->run.glyphOffsets);
+                if (d)
+                {
+                    desc = *d;
+                    desc.localeName = d2d_command_field(c, d->localeName);
+                    desc.string = d2d_command_field(c, d->string);
+                    desc.clusterMap = d2d_command_field(c, d->clusterMap);
+                }
+                hr = ID2D1CommandSink_DrawGlyphRun(sink, c->origin, &run, d ? &desc : NULL, c->brush, c->measuring_mode);
                 break;
             }
             case D2D_COMMAND_DRAW_LINE:
@@ -414,15 +434,16 @@ static HRESULT STDMETHODCALLTYPE d2d_command_list_Stream(ID2D1CommandList *iface
             case D2D_COMMAND_DRAW_BITMAP:
             {
                 const struct d2d_command_draw_bitmap *c = data;
-                hr = ID2D1CommandSink_DrawBitmap(sink, c->bitmap, c->dst_rect, c->opacity,
-                        c->interpolation_mode, c->src_rect, c->perspective_transform);
+                hr = ID2D1CommandSink_DrawBitmap(sink, c->bitmap, d2d_command_field(c, c->dst_rect), c->opacity,
+                        c->interpolation_mode, d2d_command_field(c, c->src_rect),
+                        d2d_command_field(c, c->perspective_transform));
                 break;
             }
             case D2D_COMMAND_DRAW_IMAGE:
             {
                 const struct d2d_command_draw_image *c = data;
-                hr = ID2D1CommandSink_DrawImage(sink, c->image, c->target_offset, c->image_rect,
-                        c->interpolation_mode, c->composite_mode);
+                hr = ID2D1CommandSink_DrawImage(sink, c->image, d2d_command_field(c, c->target_offset),
+                        d2d_command_field(c, c->image_rect), c->interpolation_mode, c->composite_mode);
                 break;
             }
             case D2D_COMMAND_DRAW_SPRITE_BATCH:
@@ -452,7 +473,8 @@ static HRESULT STDMETHODCALLTYPE d2d_command_list_Stream(ID2D1CommandList *iface
             case D2D_COMMAND_FILL_OPACITY_MASK:
             {
                 const struct d2d_command_fill_opacity_mask *c = data;
-                hr = ID2D1CommandSink_FillOpacityMask(sink, c->bitmap, c->brush, c->dst_rect, c->src_rect);
+                hr = ID2D1CommandSink_FillOpacityMask(sink, c->bitmap, c->brush, d2d_command_field(c, c->dst_rect),
+                        d2d_command_field(c, c->src_rect));
                 break;
             }
             case D2D_COMMAND_FILL_GEOMETRY:
@@ -502,14 +524,17 @@ static HRESULT STDMETHODCALLTYPE d2d_command_list_Close(ID2D1CommandList *iface)
 {
     struct d2d_command_list *command_list = impl_from_ID2D1CommandList(iface);
 
-    FIXME("iface %p stub.\n", iface);
+    TRACE("iface %p.\n", iface);
 
-    if (command_list->state != D2D_COMMAND_LIST_STATE_OPEN)
+    /* A list never drawn to closes empty; one closed already, or broken, does not. */
+    if (command_list->state != D2D_COMMAND_LIST_STATE_OPEN && command_list->state != D2D_COMMAND_LIST_STATE_INITIAL)
         return D2DERR_WRONG_STATE;
 
     command_list->state = D2D_COMMAND_LIST_STATE_CLOSED;
 
-    /* FIXME: reset as a target */
+    /* It stops being the target of the context it was set on. */
+    if (command_list->context)
+        d2d_device_context_detach_command_list(command_list->context);
 
     return S_OK;
 }
@@ -550,6 +575,8 @@ static void * d2d_command_list_require_space(struct d2d_command_list *command_li
 {
     struct d2d_command *command;
 
+    /* the next command starts aligned */
+    size = (size + 7) & ~(size_t)7;
     if (!d2d_array_reserve(&command_list->data, &command_list->capacity, command_list->size + size, 1))
     {
         command_list->state = D2D_COMMAND_LIST_STATE_ERROR;
@@ -949,7 +976,11 @@ void d2d_command_list_set_text_rendering_params(struct d2d_command_list *command
     d2d_command_list_set_text_rendering_params_internal(command_list, FALSE, params);
 }
 
-static inline void d2d_command_list_write_field(BYTE **data, void *dst, const void *src, size_t size)
+/* The list's buffer moves as it grows, so what a command keeps of its variable
+ * data is where that is from the command, turned back into a pointer when the
+ * command is played. */
+static inline void d2d_command_list_write_field(const void *command, BYTE **data, void *dst, const void *src,
+        size_t size)
 {
     void **ptr = dst;
 
@@ -959,11 +990,12 @@ static inline void d2d_command_list_write_field(BYTE **data, void *dst, const vo
         return;
     }
 
-    *ptr = *data;
+    *ptr = (void *)(ULONG_PTR)(*data - (const BYTE *)command);
     memcpy(*data, src, size);
     *data = *data + size;
 }
 
+
 void d2d_command_list_draw_glyph_run(struct d2d_command_list *command_list,
         const struct d2d_device_context *context, D2D1_POINT_2F origin, const DWRITE_GLYPH_RUN *run,
         const DWRITE_GLYPH_RUN_DESCRIPTION *run_desc, ID2D1Brush *orig_brush,
@@ -1023,21 +1055,22 @@ void d2d_command_list_draw_glyph_run(struct d2d_command_list *command_list,
 
     data = (BYTE *)(command + 1);
 
-    d2d_command_list_write_field(&data, &r->glyphIndices, run->glyphIndices, glyph_count * sizeof(*r->glyphIndices));
-    d2d_command_list_write_field(&data, &r->glyphAdvances, run->glyphAdvances, glyph_count * sizeof(*r->glyphAdvances));
-    d2d_command_list_write_field(&data, &r->glyphOffsets, run->glyphOffsets, glyph_count * sizeof(*r->glyphOffsets));
+    d2d_command_list_write_field(command, &data, &r->glyphIndices, run->glyphIndices, glyph_count * sizeof(*r->glyphIndices));
+    d2d_command_list_write_field(command, &data, &r->glyphAdvances, run->glyphAdvances, glyph_count * sizeof(*r->glyphAdvances));
+    d2d_command_list_write_field(command, &data, &r->glyphOffsets, run->glyphOffsets, glyph_count * sizeof(*r->glyphOffsets));
 
     command->run_desc = NULL;
     if (run_desc)
     {
-        d = command->run_desc = (DWRITE_GLYPH_RUN_DESCRIPTION *)data;
+        d = (DWRITE_GLYPH_RUN_DESCRIPTION *)data;
+        command->run_desc = (void *)(ULONG_PTR)(data - (BYTE *)command);
         memset(d, 0, sizeof(*d));
         data += sizeof(*d);
 
-        d2d_command_list_write_field(&data, &d->localeName, run_desc->localeName, locale_name_size);
-        d2d_command_list_write_field(&data, &d->string, run_desc->string, run_desc->stringLength * sizeof(*run_desc->string));
+        d2d_command_list_write_field(command, &data, &d->localeName, run_desc->localeName, locale_name_size);
+        d2d_command_list_write_field(command, &data, &d->string, run_desc->string, run_desc->stringLength * sizeof(*run_desc->string));
         d->stringLength = run_desc->stringLength;
-        d2d_command_list_write_field(&data, &d->clusterMap, run_desc->clusterMap, run_desc->stringLength * sizeof(*run_desc->clusterMap));
+        d2d_command_list_write_field(command, &data, &d->clusterMap, run_desc->clusterMap, run_desc->stringLength * sizeof(*run_desc->clusterMap));
         d->textPosition = run_desc->textPosition;
     }
 
@@ -1070,9 +1103,9 @@ void d2d_command_list_draw_bitmap(struct d2d_command_list *command_list, ID2D1Bi
 
         data = (BYTE *)(command + 1);
 
-        d2d_command_list_write_field(&data, &command->dst_rect, dst_rect, sizeof(*dst_rect));
-        d2d_command_list_write_field(&data, &command->src_rect, src_rect, sizeof(*src_rect));
-        d2d_command_list_write_field(&data, &command->perspective_transform, perspective_transform,
+        d2d_command_list_write_field(command, &data, &command->dst_rect, dst_rect, sizeof(*dst_rect));
+        d2d_command_list_write_field(command, &data, &command->src_rect, src_rect, sizeof(*src_rect));
+        d2d_command_list_write_field(command, &data, &command->perspective_transform, perspective_transform,
                 sizeof(*perspective_transform));
     }
 }
@@ -1100,8 +1133,8 @@ void d2d_command_list_draw_image(struct d2d_command_list *command_list, ID2D1Ima
 
         data = (BYTE *)(command + 1);
 
-        d2d_command_list_write_field(&data, &command->target_offset, target_offset, sizeof(*target_offset));
-        d2d_command_list_write_field(&data, &command->image_rect, image_rect, sizeof(*image_rect));
+        d2d_command_list_write_field(command, &data, &command->target_offset, target_offset, sizeof(*target_offset));
+        d2d_command_list_write_field(command, &data, &command->image_rect, image_rect, sizeof(*image_rect));
     }
 }
 
@@ -1173,7 +1206,7 @@ void d2d_command_list_fill_opacity_mask(struct d2d_command_list *command_list, c
 
         data = (BYTE *)(command + 1);
 
-        d2d_command_list_write_field(&data, &command->dst_rect, dst_rect, sizeof(*dst_rect));
-        d2d_command_list_write_field(&data, &command->src_rect, src_rect, sizeof(*src_rect));
+        d2d_command_list_write_field(command, &data, &command->dst_rect, dst_rect, sizeof(*dst_rect));
+        d2d_command_list_write_field(command, &data, &command->src_rect, src_rect, sizeof(*src_rect));
     }
 }
diff --git a/dlls/d2d1/d2d1_private.h b/dlls/d2d1/d2d1_private.h
index f652d912304..f9654ee8c5a 100644
--- a/dlls/d2d1/d2d1_private.h
+++ b/dlls/d2d1/d2d1_private.h
@@ -936,6 +936,8 @@ struct d2d_command_list
     LONG refcount;
 
     ID2D1Factory *factory;
+    struct d2d_device *device;              /* what it was made by, the only one it records for */
+    struct d2d_device_context *context;     /* the context it is the target of */
     enum d2d_command_list_state state;
     unsigned int flags;
 
@@ -950,6 +952,8 @@ struct d2d_command_list
 
 HRESULT d2d_command_list_create(ID2D1Factory *factory, struct d2d_command_list **command_list);
 struct d2d_command_list *unsafe_impl_from_ID2D1CommandList(ID2D1CommandList *iface);
+void d2d_device_context_detach_command_list(struct d2d_device_context *context);
+BOOL d2d_dxgi_format_supported(DXGI_FORMAT format);
 void d2d_command_list_begin_draw(struct d2d_command_list *command_list, const struct d2d_device_context *context);
 void d2d_command_list_set_antialias_mode(struct d2d_command_list *command_list, D2D1_ANTIALIAS_MODE mode);
 void d2d_command_list_set_primitive_blend(struct d2d_command_list *command_list,
diff --git a/dlls/d2d1/device.c b/dlls/d2d1/device.c
index bb63aa0f14e..4a58fdadd79 100644
--- a/dlls/d2d1/device.c
+++ b/dlls/d2d1/device.c
@@ -2109,12 +2109,7 @@ static HRESULT STDMETHODCALLTYPE d2d_device_context_EndDraw(ID2D1DeviceContext6
 
     TRACE("iface %p, tag1 %p, tag2 %p.\n", iface, tag1, tag2);
 
-    if (context->target.type == D2D_TARGET_COMMAND_LIST)
-    {
-        FIXME("Unimplemented for command list target.\n");
-        return E_NOTIMPL;
-    }
-
+    /* what is drawn to a command list is recorded as it is drawn */
     if (tag1)
         *tag1 = context->error.tag1;
     if (tag2)
@@ -2417,16 +2412,27 @@ static HRESULT STDMETHODCALLTYPE d2d_device_context_CreateCommandList(ID2D1Devic
     TRACE("iface %p, command_list %p.\n", iface, command_list);
 
     if (SUCCEEDED(hr = d2d_command_list_create(context->factory, &object)))
+    {
+        object->device = context->device;
         *command_list = &object->ID2D1CommandList_iface;
+    }
 
     return hr;
 }
 
 static BOOL STDMETHODCALLTYPE d2d_device_context_IsDxgiFormatSupported(ID2D1DeviceContext6 *iface, DXGI_FORMAT format)
 {
-    FIXME("iface %p, format %#x stub!\n", iface, format);
+    struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
+    UINT support = 0;
 
-    return FALSE;
+    TRACE("iface %p, format %#x.\n", iface, format);
+
+    /* a format of Direct2D's own that the device can sample */
+    if (!d2d_dxgi_format_supported(format))
+        return FALSE;
+    if (FAILED(ID3D11Device1_CheckFormatSupport(context->d3d_device, format, &support)))
+        return FALSE;
+    return !!(support & D3D11_FORMAT_SUPPORT_TEXTURE2D);
 }
 
 static BOOL STDMETHODCALLTYPE d2d_device_context_IsBufferPrecisionSupported(ID2D1DeviceContext6 *iface,
@@ -2583,6 +2589,8 @@ static void d2d_device_context_reset_target(struct d2d_device_context *context)
     if (!context->target.object)
         return;
 
+    if (context->target.type == D2D_TARGET_COMMAND_LIST && context->target.command_list->context == context)
+        context->target.command_list->context = NULL;
     IUnknown_Release(context->target.object);
     memset(&context->target, 0, sizeof(context->target));
 
@@ -2595,6 +2603,12 @@ static void d2d_device_context_reset_target(struct d2d_device_context *context)
     context->bs = NULL;
 }
 
+/* a command list closed while it is the target stops being it */
+void d2d_device_context_detach_command_list(struct d2d_device_context *context)
+{
+    d2d_device_context_reset_target(context);
+}
+
 static void STDMETHODCALLTYPE d2d_device_context_SetTarget(ID2D1DeviceContext6 *iface, ID2D1Image *target)
 {
     struct d2d_device_context *context = impl_from_ID2D1DeviceContext(iface);
@@ -2650,11 +2664,20 @@ static void STDMETHODCALLTYPE d2d_device_context_SetTarget(ID2D1DeviceContext6 *
     {
         command_list_impl = unsafe_impl_from_ID2D1CommandList(command_list);
 
+        /* a list records for the device that made it */
+        if (command_list_impl->device && command_list_impl->device != context->device)
+        {
+            WARN("Command list %p belongs to another device.\n", command_list);
+            ID2D1CommandList_Release(command_list);
+            return;
+        }
+
         d2d_device_context_reset_target(context);
 
         context->target.command_list = command_list_impl;
         context->target.object = target;
         context->target.type = D2D_TARGET_COMMAND_LIST;
+        command_list_impl->context = context;
     }
     else
     {
@@ -2752,11 +2775,336 @@ static void STDMETHODCALLTYPE d2d_device_context_ID2D1DeviceContext_DrawGlyphRun
     d2d_device_context_draw_glyph_run(context, baseline_origin, glyph_run, glyph_run_desc, brush, measuring_mode);
 }
 
+/* Plays a closed command list back onto a device context, under the
+ * transform DrawImage was called with. */
+struct d2d_command_player
+{
+    ID2D1CommandSink1 ID2D1CommandSink1_iface;
+    struct d2d_device_context *context;
+    D2D1_MATRIX_3X2_F base;
+};
+
+static inline struct d2d_command_player *impl_from_ID2D1CommandSink1(ID2D1CommandSink1 *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_command_player, ID2D1CommandSink1_iface);
+}
+
+static inline ID2D1DeviceContext6 *player_context(ID2D1CommandSink1 *iface)
+{
+    return &impl_from_ID2D1CommandSink1(iface)->context->ID2D1DeviceContext6_iface;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_QueryInterface(ID2D1CommandSink1 *iface, REFIID iid, void **out)
+{
+    if (IsEqualGUID(iid, &IID_IUnknown) || IsEqualGUID(iid, &IID_ID2D1CommandSink)
+            || IsEqualGUID(iid, &IID_ID2D1CommandSink1))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+/* the player lives on the stack of the call playing the list */
+static ULONG STDMETHODCALLTYPE d2d_command_player_AddRef(ID2D1CommandSink1 *iface)
+{
+    return 2;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_command_player_Release(ID2D1CommandSink1 *iface)
+{
+    return 1;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_BeginDraw(ID2D1CommandSink1 *iface)
+{
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_EndDraw(ID2D1CommandSink1 *iface)
+{
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_SetAntialiasMode(ID2D1CommandSink1 *iface,
+        D2D1_ANTIALIAS_MODE mode)
+{
+    ID2D1DeviceContext6_SetAntialiasMode(player_context(iface), mode);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_SetTags(ID2D1CommandSink1 *iface, D2D1_TAG tag1, D2D1_TAG tag2)
+{
+    ID2D1DeviceContext6_SetTags(player_context(iface), tag1, tag2);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_SetTextAntialiasMode(ID2D1CommandSink1 *iface,
+        D2D1_TEXT_ANTIALIAS_MODE mode)
+{
+    ID2D1DeviceContext6_SetTextAntialiasMode(player_context(iface), mode);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_SetTextRenderingParams(ID2D1CommandSink1 *iface,
+        IDWriteRenderingParams *params)
+{
+    ID2D1DeviceContext6_SetTextRenderingParams(player_context(iface), params);
+    return S_OK;
+}
+
+/* what was recorded is placed where the list is drawn */
+static HRESULT STDMETHODCALLTYPE d2d_command_player_SetTransform(ID2D1CommandSink1 *iface,
+        const D2D1_MATRIX_3X2_F *transform)
+{
+    struct d2d_command_player *player = impl_from_ID2D1CommandSink1(iface);
+    D2D1_MATRIX_3X2_F m = *transform;
+
+    d2d_matrix_multiply(&m, &player->base);
+    ID2D1DeviceContext6_SetTransform(player_context(iface), &m);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_SetPrimitiveBlend(ID2D1CommandSink1 *iface,
+        D2D1_PRIMITIVE_BLEND blend)
+{
+    ID2D1DeviceContext6_SetPrimitiveBlend(player_context(iface), blend);
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_command_player_SetUnitMode(ID2D1CommandSink1 *iface, D2D1_UNIT_MODE mode)
+{
+    ID2D1DeviceContext6_SetUnitMode(player_context(iface), mode);
+    return S_OK;
+}
+
+/* A clear in a list colors all of the list: drawn over the target, that is a fill of where it may draw. */
+static HRESULT STDMETHODCALLTYPE d2d_command_player_Clear(ID2D1CommandSink1 *iface, const D2D1_COLOR_F *color)
+{
+    static const D2D1_RECT_F everywhere = {-1.0e6f, -1.0e6f, 1.0e6f, 1.0e6f};
+    ID2D1DeviceContext6 *context = player_context(iface);
