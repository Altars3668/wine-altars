+static void test_command_list_playback(BOOL d3d11)
+{
+    static const D2D1_COLOR_F red = {1.0f, 0.0f, 0.0f, 1.0f}, green = {0.0f, 1.0f, 0.0f, 1.0f};
+    static const D2D1_COLOR_F blue = {0.0f, 0.0f, 1.0f, 1.0f};
+    static const struct
+    {
+        unsigned int x, y;
+        DWORD colour;
+    }
+    points[] =
+    {
+        /* the whole list at (30, 40) */
+        {35, 45, 0xffff0000},
+        {45, 45, 0xff00ff00},
+        {55, 45, 0xff0000ff},
+        {35, 55, 0xff0000ff},
+        /* its part (10, 0)-(20, 10) at (100, 40) */
+        {95, 45, 0xff0000ff},
+        {105, 45, 0xff00ff00},
+        {115, 45, 0xff0000ff},
+        /* a bitmap's top right pixel stretched over (30, 60)-(50, 80), recorded before the list grew */
+        {40, 70, 0xff00ff00},
+    };
+    static const DWORD bitmap_data[] = {0xffff0000, 0xff00ff00, 0xff0000ff, 0xffffffff};
+    D2D1_BITMAP_PROPERTIES1 bitmap_props = {{DXGI_FORMAT_B8G8R8A8_UNORM, D2D1_ALPHA_MODE_PREMULTIPLIED}, 96.0f, 96.0f};
+    D2D1_RECT_F dst = {0.0f, 20.0f, 20.0f, 40.0f}, src = {1.0f, 0.0f, 2.0f, 1.0f};
+    ID2D1Bitmap1 *bitmap;
+    D2D1_SIZE_U size;
+    D2D1_RECT_F rect, part = {10.0f, 0.0f, 20.0f, 10.0f};
+    D2D1_POINT_2F offset = {30.0f, 40.0f};
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    ID2D1CommandList *command_list;
+    ID2D1SolidColorBrush *brush;
+    ID2D1Image *target;
+    unsigned int i;
+    DWORD colour;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+    if (!ctx.factory1)
+    {
+        win_skip("ID2D1Factory1 is not supported.\n");
+        release_test_context(&ctx);
+        return;
+    }
+
+    hr = ID2D1DeviceContext_CreateCommandList(ctx.context, &command_list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_GetTarget(ctx.context, &target);
+    ID2D1DeviceContext_SetTarget(ctx.context, (ID2D1Image *)command_list);
+    hr = ID2D1DeviceContext_CreateSolidColorBrush(ctx.context, &red, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    set_size_u(&size, 2, 2);
+    hr = ID2D1DeviceContext_CreateBitmap(ctx.context, size, bitmap_data, 2 * sizeof(*bitmap_data), &bitmap_props, &bitmap);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1DeviceContext_BeginDraw(ctx.context);
+    ID2D1DeviceContext_DrawBitmap(ctx.context, (ID2D1Bitmap *)bitmap, &dst, 1.0f,
+            D2D1_INTERPOLATION_MODE_NEAREST_NEIGHBOR, &src, NULL);
+    set_rect(&rect, 0.0f, 0.0f, 10.0f, 10.0f);
+    ID2D1DeviceContext_FillRectangle(ctx.context, &rect, (ID2D1Brush *)brush);
+    ID2D1SolidColorBrush_SetColor(brush, &green);
+    set_rect(&rect, 10.0f, 0.0f, 20.0f, 10.0f);
+    ID2D1DeviceContext_FillRectangle(ctx.context, &rect, (ID2D1Brush *)brush);
+    /* enough more for the list to have to grow */
+    set_rect(&rect, 300.0f, 200.0f, 301.0f, 201.0f);
+    for (i = 0; i < 200; ++i)
+        ID2D1DeviceContext_FillRectangle(ctx.context, &rect, (ID2D1Brush *)brush);
+    hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    hr = ID2D1CommandList_Close(command_list);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    /* what the list recorded is drawn where it is drawn, and only the part asked for */
+    ID2D1DeviceContext_SetTarget(ctx.context, target);
+    ID2D1DeviceContext_BeginDraw(ctx.context);
+    ID2D1DeviceContext_Clear(ctx.context, &blue);
+    ID2D1DeviceContext_DrawImage(ctx.context, (ID2D1Image *)command_list, &offset, NULL,
+            D2D1_INTERPOLATION_MODE_LINEAR, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    offset.x = 100.0f;
+    ID2D1DeviceContext_DrawImage(ctx.context, (ID2D1Image *)command_list, &offset, &part,
+            D2D1_INTERPOLATION_MODE_LINEAR, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    get_surface_readback(&ctx, &rb);
+    for (i = 0; i < ARRAY_SIZE(points); ++i)
+    {
+        colour = get_readback_colour(&rb, points[i].x, points[i].y);
+        ok(compare_colour(colour, points[i].colour, 1), "Point %u: got unexpected colour 0x%08lx.\n", i, colour);
+    }
+    release_resource_readback(&rb);
+
+    ID2D1SolidColorBrush_Release(brush);
+    ID2D1Bitmap1_Release(bitmap);
+    ID2D1Image_Release(target);
+    ID2D1CommandList_Release(command_list);
+    release_test_context(&ctx);
+}
