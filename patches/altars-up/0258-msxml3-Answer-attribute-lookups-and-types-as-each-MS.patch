     return saxlocator_return_string(attr->value, value, length);
 }
@@ -1742,10 +1787,12 @@ static HRESULT WINAPI isaxattributes_getValueFromName(ISAXAttributes *iface, con
     TRACE("%p, %s, %d, %s, %d, %p, %p.\n", iface, debugstr_w(uri), uri_length,
             debugstr_w(name), name_length, value, length);
 
-    if (!uri || !name)
-        return E_POINTER;
+    saxlocator_clear_string(locator, value, length);
+    if (!value || !length) return E_POINTER;
+    if (ISAXAttributes_getIndexFromName(iface, uri, uri_length, name, name_length, &index) != S_OK)
+        return E_INVALIDARG;
 
-    attr = saxlocator_get_attribute_by_name(locator, uri, uri_length, name, name_length, &index);
+    attr = saxlocator_get_attribute(locator, index);
     if (attr)
         return saxlocator_return_string(attr->value, value, length);
 
@@ -1761,8 +1808,9 @@ static HRESULT WINAPI isaxattributes_getValueFromQName(ISAXAttributes *iface,
 
     TRACE("%p, %s, %d, %p, %p.\n", iface, debugstr_w(name), name_length, value, length);
 
+    saxlocator_clear_string(locator, value, length);
     if (!name)
-        return E_POINTER;
+        return locator->saxreader->version >= MSXML4 ? E_INVALIDARG : E_POINTER;
 
     attr = saxlocator_get_attribute_by_qname(locator, name, name_length, &index);
     if (attr)
@@ -1809,6 +1857,7 @@ static void saxreader_clear_attributes(struct saxlocator *locator)
         saxreader_free_bstr(&attr->local);
         saxreader_free_bstr(&attr->value);
         saxreader_free_bstr(&attr->qname);
+        saxreader_free_bstr(&attr->type);
         saxreader_free_bstr(&attr->prefix);
     }
 
@@ -3862,7 +3911,39 @@ static bool saxreader_has_attribute(struct saxlocator *locator, BSTR name)
     return false;
 }
 
-static void saxreader_add_attribute(struct saxlocator *locator, const struct parsed_name *name, BSTR value, bool nsdef)
+static BSTR saxreader_get_attribute_type(struct saxlocator *locator, struct element *element, BSTR name)
+{
+    static const WCHAR *const types[] =
+    {
+        NULL, L"CDATA", L"ID", L"IDREF", L"IDREFS", L"ENTITY", L"ENTITIES", L"NMTOKEN", L"NMTOKENS"
+    };
+    struct attlist_decl *decl;
+
+    if (locator->dtd)
+    {
+        LIST_FOR_EACH_ENTRY(decl, &locator->dtd->attr_decls, struct attlist_decl, entry)
+        {
+            if (!bstr_equal(decl->name, element->name.qname)) continue;
+
+            for (size_t i = 0; i < decl->count; ++i)
+            {
+                struct attlist_attr *attr = &decl->attributes[i];
+
+                if (!bstr_equal(attr->name.qname, name)) continue;
+                if (attr->type == ATTR_TYPE_NOTATION || attr->type == ATTR_TYPE_ENUMERATION)
+                    return saxreader_attribute_type_stringify(locator, attr);
+                if (attr->type < ARRAY_SIZE(types))
+                    return saxreader_alloc_string(locator, types[attr->type]);
+                break;
+            }
+        }
+    }
+
+    return saxreader_alloc_string(locator, L"CDATA");
+}
+
+static void saxreader_add_attribute(struct saxlocator *locator, struct element *element,
+        const struct parsed_name *name, BSTR value, bool nsdef)
 {
     struct attribute *attr;
 
@@ -3883,6 +3964,7 @@ static void saxreader_add_attribute(struct saxlocator *locator, const struct par
     attr->local = saxreader_alloc_string(locator, nsdef ? L"" : name->local);
     attr->qname = saxreader_alloc_string(locator, name->qname);
     attr->value = saxreader_alloc_string(locator, value);
+    attr->type = saxreader_get_attribute_type(locator, element, name->qname);
     attr->nsdef = nsdef;
 }
 
@@ -3905,7 +3987,7 @@ static void saxreader_add_default_attributes(struct saxlocator *locator, struct
                     continue;
 
                 if (!saxreader_has_attribute(locator, attr->name.qname))
-                    saxreader_add_attribute(locator, &attr->name, attr->value, false);
+                    saxreader_add_attribute(locator, element, &attr->name, attr->value, false);
             }
         }
     }
@@ -4204,7 +4286,7 @@ static void saxreader_parse_attribute(struct saxlocator *locator, struct element
     value = saxreader_parse_attvalue(locator);
 
     ns = saxreader_add_namespace_attribute(locator, element, &name, value);
-    saxreader_add_attribute(locator, &name, value, ns);
+    saxreader_add_attribute(locator, element, &name, value, ns);
 
     saxreader_free_name(&name);
     SysFreeString(value);
diff --git a/dlls/msxml3/tests/saxreader.c b/dlls/msxml3/tests/saxreader.c
index 6df3ca92627..573ac1400f3 100644
--- a/dlls/msxml3/tests/saxreader.c
+++ b/dlls/msxml3/tests/saxreader.c
@@ -3843,6 +3843,450 @@ static void test_mxwriter_properties(void)
     free_bstrs();
 }
 
+/* the attributes the reader hands to startElement, and how they answer lookups */
+struct attr_entry
+{
+    const WCHAR *uri, *local, *qname, *value, *type;
+};
+
+struct attr_handler
+{
+    ISAXContentHandler ISAXContentHandler_iface;
+    const struct attr_entry *expect;
+    void (*check)(ISAXAttributes *attributes, BOOL modern);
+    BOOL modern;
+    int elements;
+};
+
+static inline struct attr_handler *impl_from_attr_handler(ISAXContentHandler *iface)
+{
+    return CONTAINING_RECORD(iface, struct attr_handler, ISAXContentHandler_iface);
+}
+
+static HRESULT WINAPI attr_handler_QueryInterface(ISAXContentHandler *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_ISAXContentHandler))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI attr_handler_AddRef(ISAXContentHandler *iface) { return 2; }
+static ULONG WINAPI attr_handler_Release(ISAXContentHandler *iface) { return 1; }
+static HRESULT WINAPI attr_handler_putDocumentLocator(ISAXContentHandler *iface, ISAXLocator *locator)
+{
+    return S_OK;
+}
+static HRESULT WINAPI attr_handler_startDocument(ISAXContentHandler *iface) { return S_OK; }
+static HRESULT WINAPI attr_handler_endDocument(ISAXContentHandler *iface) { return S_OK; }
+static HRESULT WINAPI attr_handler_startPrefixMapping(ISAXContentHandler *iface, const WCHAR *prefix,
+        int prefix_len, const WCHAR *uri, int uri_len)
+{
+    return S_OK;
+}
+static HRESULT WINAPI attr_handler_endPrefixMapping(ISAXContentHandler *iface, const WCHAR *prefix, int len)
+{
+    return S_OK;
+}
+
+static const WCHAR *untouched_str = (const WCHAR *)(ULONG_PTR)0xdeadbeef;
+
+static void check_attr_str(unsigned int line, const WCHAR *str, int len, const WCHAR *expect)
+{
+    ok_(__FILE__, line)(str != NULL, "got NULL string\n");
+    ok_(__FILE__, line)(len == wcslen(expect) && !memcmp(str, expect, len * sizeof(WCHAR)), "got %s, expected %s\n",
+            wine_dbgstr_wn(str, len), debugstr_w(expect));
+}
+
+static HRESULT WINAPI attr_handler_startElement(ISAXContentHandler *iface, const WCHAR *uri, int uri_len,
+        const WCHAR *local, int local_len, const WCHAR *qname, int qname_len, ISAXAttributes *attributes)
+{
+    struct attr_handler *handler = impl_from_attr_handler(iface);
+    const WCHAR *str, *str2, *str3;
+    int i, count, len, len2, len3;
+    HRESULT hr;
+
+    /* an element without a namespace has an empty one */
+    ok(uri != NULL && uri_len == wcslen(uri), "got uri %p, length %d\n", uri, uri_len);
+    if (handler->elements++) return S_OK;
+
+    for (count = 0; handler->expect[count].qname; count++)
+        ;
+    len = -1;
+    hr = ISAXAttributes_getLength(attributes, &len);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(len == count, "got %d attributes, expected %d\n", len, count);
+    for (i = 0; i < count && i < len; i++)
+    {
+        const struct attr_entry *expect = &handler->expect[i];
+
+        winetest_push_context("attribute %d", i);
+        hr = ISAXAttributes_getName(attributes, i, &str, &len, &str2, &len2, &str3, &len3);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_attr_str(__LINE__, str, len, expect->uri);
+        check_attr_str(__LINE__, str2, len2, expect->local);
+        check_attr_str(__LINE__, str3, len3, expect->qname);
+        hr = ISAXAttributes_getURI(attributes, i, &str, &len);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_attr_str(__LINE__, str, len, expect->uri);
+        hr = ISAXAttributes_getValue(attributes, i, &str, &len);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_attr_str(__LINE__, str, len, expect->value);
+        hr = ISAXAttributes_getType(attributes, i, &str, &len);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_attr_str(__LINE__, str, len, expect->type);
+        hr = ISAXAttributes_getTypeFromQName(attributes, expect->qname, wcslen(expect->qname), &str, &len);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        check_attr_str(__LINE__, str, len, expect->type);
+        winetest_pop_context();
+    }
+
+    /* MSXML 4 and 6 clear outputs on failure; MSXML 3 leaves them untouched. */
+    str = str2 = str3 = untouched_str;
+    len = len2 = len3 = -1;
+    hr = ISAXAttributes_getName(attributes, count, &str, &len, &str2, &len2, &str3, &len3);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(handler->modern ? (!str && !len && !str2 && !len2 && !str3 && !len3) :
+            (str == untouched_str && len == -1 && str2 == untouched_str && len2 == -1 &&
+             str3 == untouched_str && len3 == -1),
+            "got %p %d %p %d %p %d\n", str, len, str2, len2, str3, len3);
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getType(attributes, count, &str, &len);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(handler->modern ? (!str && !len) : (str == untouched_str && len == -1), "got %p, %d\n", str, len);
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getType(attributes, -1, &str, &len);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(handler->modern ? (!str && !len) : (str == untouched_str && len == -1), "got %p, %d\n", str, len);
+    hr = ISAXAttributes_getType(attributes, 0, NULL, &len);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    str = untouched_str;
+    hr = ISAXAttributes_getType(attributes, 0, &str, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    ok(handler->modern ? !str : str == untouched_str, "got %p\n", str);
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getTypeFromQName(attributes, L"nope", 4, &str, &len);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(handler->modern ? (!str && !len) : (str == untouched_str && len == -1), "got %p, %d\n", str, len);
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getTypeFromQName(attributes, NULL, 0, &str, &len);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(handler->modern ? (!str && !len) : (str == untouched_str && len == -1), "got %p, %d\n", str, len);
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getTypeFromQName(attributes, handler->expect[0].qname, 0, &str, &len);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(handler->modern ? (!str && !len) : (str == untouched_str && len == -1), "got %p, %d\n", str, len);
+    i = -1;
+    hr = ISAXAttributes_getIndexFromQName(attributes, NULL, 0, &i);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(i == (handler->modern ? 0 : -1), "got index %d\n", i);
+    hr = ISAXAttributes_getIndexFromQName(attributes, handler->expect[0].qname, wcslen(handler->expect[0].qname), NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+
+    handler->check(attributes, handler->modern);
+    return S_OK;
+}
+
+static HRESULT WINAPI attr_handler_endElement(ISAXContentHandler *iface, const WCHAR *uri, int uri_len,
+        const WCHAR *local, int local_len, const WCHAR *qname, int qname_len)
+{
+    return S_OK;
+}
+static HRESULT WINAPI attr_handler_characters(ISAXContentHandler *iface, const WCHAR *chars, int len)
+{
+    return S_OK;
+}
+static HRESULT WINAPI attr_handler_ignorableWhitespace(ISAXContentHandler *iface, const WCHAR *chars, int len)
+{
+    return S_OK;
+}
+static HRESULT WINAPI attr_handler_processingInstruction(ISAXContentHandler *iface, const WCHAR *target,
+        int target_len, const WCHAR *data, int data_len)
+{
+    return S_OK;
+}
+static HRESULT WINAPI attr_handler_skippedEntity(ISAXContentHandler *iface, const WCHAR *name, int len)
+{
+    return S_OK;
+}
+
+static const ISAXContentHandlerVtbl attr_handler_vtbl =
+{
+    attr_handler_QueryInterface,
+    attr_handler_AddRef,
+    attr_handler_Release,
+    attr_handler_putDocumentLocator,
+    attr_handler_startDocument,
+    attr_handler_endDocument,
+    attr_handler_startPrefixMapping,
+    attr_handler_endPrefixMapping,
+    attr_handler_startElement,
+    attr_handler_endElement,
+    attr_handler_characters,
+    attr_handler_ignorableWhitespace,
+    attr_handler_processingInstruction,
+    attr_handler_skippedEntity,
+};
+
+#define check_index_from_name(a, b, c, d, e, f, g) check_index_from_name_(__LINE__, a, b, c, d, e, f, g)
+static void check_index_from_name_(unsigned int line, ISAXAttributes *attributes, const WCHAR *uri, int uri_len,
+        const WCHAR *local, int local_len, HRESULT expect_hr, int expect_index)
+{
+    const WCHAR *str;
+    HRESULT hr;
+    int index, len;
+
+    index = -1;
+    hr = ISAXAttributes_getIndexFromName(attributes, uri, uri_len, local, local_len, &index);
+    ok_(__FILE__, line)(hr == expect_hr, "Unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(index == expect_index, "got index %d, expected %d\n", index, expect_index);
+
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getTypeFromName(attributes, uri, uri_len, local, local_len, &str, &len);
+    ok_(__FILE__, line)(hr == expect_hr, "Unexpected hr %#lx.\n", hr);
+    if (hr == S_OK)
+        ok_(__FILE__, line)(len == 5 && !memcmp(str, L"CDATA", 5 * sizeof(WCHAR)), "got type %s\n",
+                wine_dbgstr_wn(str, len));
+    else
+        ok_(__FILE__, line)(str == untouched_str && len == -1, "got %p, %d\n", str, len);
+}
