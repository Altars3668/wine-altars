+static void check_attr_lookups(ISAXAttributes *attributes, BOOL modern)
+{
+    const WCHAR *str;
+    HRESULT hr;
+    int len;
+
+    /* MSXML 3 finds no attribute in a missing namespace, while an empty one is any of that length */
+    check_index_from_name(attributes, NULL, 0, L"uri", 3, E_INVALIDARG, -1);
+    check_index_from_name(attributes, L"", 0, L"uri", 3, S_OK, 2);
+    check_index_from_name(attributes, L"zz", 0, L"uri", 3, S_OK, 2);
+    check_index_from_name(attributes, NULL, 0, L"b", 1, E_INVALIDARG, -1);
+    check_index_from_name(attributes, L"urn:p", 5, L"b", 1, S_OK, 0);
+    check_index_from_name(attributes, L"urn:p", 0, L"b", 1, E_INVALIDARG, -1);
+    /* namespace declarations have neither a namespace nor a local name */
+    check_index_from_name(attributes, L"", 0, L"", 0, S_OK, 1);
+    check_index_from_name(attributes, L"http://www.w3.org/2000/xmlns/", 29, L"", 0, E_INVALIDARG, -1);
+    check_index_from_name(attributes, L"urn:p", 5, NULL, 0, E_INVALIDARG, -1);
+    check_index_from_name(attributes, NULL, 0, NULL, 0, E_INVALIDARG, -1);
+
+    hr = ISAXAttributes_getIndexFromName(attributes, NULL, 0, L"uri", 3, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getValueFromName(attributes, NULL, 0, L"uri", 3, &str, &len);
+    ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+    ok(str == untouched_str && len == -1, "got %p, %d\n", str, len);
+    hr = ISAXAttributes_getValueFromName(attributes, L"", 0, L"uri", 3, &str, &len);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(len == 1 && *str == 'x', "got %s\n", wine_dbgstr_wn(str, len));
+}
