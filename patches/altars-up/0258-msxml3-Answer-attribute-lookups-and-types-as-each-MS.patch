 {
-    FIXME("%p, %s, %d, %s, %d, %p, %p stub\n", iface, debugstr_w(uri), uri_length, debugstr_w(name),
-            name_length, type, type_length);
+    struct saxlocator *locator = impl_from_ISAXAttributes(iface);
+    const struct attribute *attr;
