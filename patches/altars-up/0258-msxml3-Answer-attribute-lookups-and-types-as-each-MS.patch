@@ -1654,6 +1667,9 @@ static HRESULT WINAPI isaxattributes_getName(ISAXAttributes *iface, int index,
     TRACE("%p, %d, %p, %p, %p, %p, %p, %p.\n", iface, index, uri, uri_length, local, local_length,
