+    check_index_from_name6(attributes, L"", 0, L"uri", 3, S_OK, 1);
+    check_index_from_name6(attributes, L"zz", 0, L"uri", 3, S_OK, 1);
+    check_index_from_name6(attributes, NULL, 0, L"b", 1, E_INVALIDARG, 0);
+    check_index_from_name6(attributes, L"urn:p", 5, L"b", 1, S_OK, 0);
+    check_index_from_name6(attributes, L"urn:p", 0, L"b", 1, E_INVALIDARG, 0);
+    check_index_from_name6(attributes, L"", 0, L"", 0, E_INVALIDARG, 0);
+    check_index_from_name6(attributes, L"http://www.w3.org/2000/xmlns/", 29, L"", 0, S_OK, 2);
+    check_index_from_name6(attributes, L"urn:p", 5, NULL, 0, E_INVALIDARG, 0);
+    check_index_from_name6(attributes, NULL, 0, NULL, 0, E_INVALIDARG, 0);
+
+    hr = ISAXAttributes_getIndexFromName(attributes, NULL, 0, L"uri", 3, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    hr = ISAXAttributes_getValueFromName(attributes, NULL, 0, L"uri", 3, &str, &len);
+    ok(hr == S_OK && len == 1 && *str == 'x', "Unexpected value %#lx, %s.\n", hr,
+            wine_dbgstr_wn(str, len));
+    str = untouched_str;
+    len = -1;
+    hr = ISAXAttributes_getValueFromName(attributes, NULL, 0, L"b", 1, &str, &len);
+    ok(hr == E_INVALIDARG && !str && !len, "Unexpected outputs %#lx, %p, %d.\n", hr, str, len);
+}
