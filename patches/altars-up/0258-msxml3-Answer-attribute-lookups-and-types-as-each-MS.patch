+static void test_saxreader_attributes(void)
+{
+    static const CLSID saxreader60 = {0x88d96a0c, 0xf192, 0x11d4, {0xa6, 0x5f, 0, 0x40, 0x96, 0x32, 0x51, 0xe5}};
+    static const struct { const CLSID *clsid; const char *name; BOOL modern; } readers[] =
+    {
+        { &CLSID_SAXXMLReader, "SAXXMLReader", FALSE },
+        { &CLSID_SAXXMLReader30, "SAXXMLReader30", FALSE },
+        { &saxreader60, "SAXXMLReader60", TRUE },
+    };
+    static const struct
+    {
+        const WCHAR *xml;
+        const struct attr_entry *attrs, *modern_attrs;
+        void (*check)(ISAXAttributes *attributes, BOOL modern);
+        void (*modern_check)(ISAXAttributes *attributes, BOOL modern);
+    }
+    docs[] =
+    {
+        /* MSXML 3 has the namespace declarations where the tag has them */
+        { L"<a p:b=\"y\" xmlns:p=\"urn:p\" uri=\"x\" xmlns=\"urn:d\"><c/></a>",
+          attr_lookup_attrs, attr_lookup_attrs6, check_attr_lookups, check_attr_lookups6 },
+        /* the types the DTD declares, and the defaulted attributes after the specified ones */
+        { L"<!DOCTYPE a [<!NOTATION gif SYSTEM \"image/gif\"><!ENTITY pic SYSTEM \"pic.gif\" NDATA gif>"
+          "<!ATTLIST a id ID #IMPLIED r IDREF #IMPLIED rs IDREFS #IMPLIED en ENTITY #IMPLIED ens ENTITIES #IMPLIED"
+          " ns NMTOKENS #IMPLIED no NOTATION (gif) #IMPLIED e ( x | y ) #IMPLIED f CDATA \"d\" fx CDATA #FIXED \"q\""
+          " xmlns:p CDATA #IMPLIED p:t ID #IMPLIED id CDATA #IMPLIED>]>"
+          "<a id=\"i\" r=\"i\" rs=\"i i\" en=\"pic\" ens=\"pic\" ns=\"t u\" no=\"gif\" e=\"x\" u=\"z\""
+          " xmlns:p=\"urn:p\" p:t=\"k\"><c/></a>",
+          attr_types_attrs, attr_types_attrs6, check_attr_types, check_attr_types6 },
+    };
+    struct attr_handler handler;
+    ISAXXMLReader *reader;
+    VARIANT source;
+    unsigned int i, j;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(readers); i++)
+    {
+        for (j = 0; j < ARRAY_SIZE(docs); j++)
+        {
+            winetest_push_context("%s doc %u", readers[i].name, j);
+            hr = CoCreateInstance(readers[i].clsid, NULL, CLSCTX_INPROC_SERVER, &IID_ISAXXMLReader, (void **)&reader);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+            memset(&handler, 0, sizeof(handler));
+            handler.ISAXContentHandler_iface.lpVtbl = &attr_handler_vtbl;
+            handler.modern = readers[i].modern;
+            handler.expect = handler.modern ? docs[j].modern_attrs : docs[j].attrs;
+            handler.check = handler.modern ? docs[j].modern_check : docs[j].check;
+            hr = ISAXXMLReader_putContentHandler(reader, &handler.ISAXContentHandler_iface);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            hr = ISAXXMLReader_putFeature(reader, L"prohibit-dtd", VARIANT_FALSE);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+            V_VT(&source) = VT_BSTR;
+            V_BSTR(&source) = SysAllocString(docs[j].xml);
+            hr = ISAXXMLReader_parse(reader, source);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            VariantClear(&source);
+            ok(handler.elements == 2, "got %d elements\n", handler.elements);
+
+            ISAXXMLReader_Release(reader);
+            winetest_pop_context();
+        }
+    }
+}
