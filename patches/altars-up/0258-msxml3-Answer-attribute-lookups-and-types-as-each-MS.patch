+#define check_index_from_name6(a, b, c, d, e, f, g) check_index_from_name6_(__LINE__, a, b, c, d, e, f, g)
+static void check_index_from_name6_(unsigned int line, ISAXAttributes *attributes, const WCHAR *uri, int uri_len,
+        const WCHAR *local, int local_len, HRESULT expect_hr, int expect_index)
+{
+    const WCHAR *str = untouched_str;
+    int index = -1, len = -1;
+    HRESULT hr;
+
+    hr = ISAXAttributes_getIndexFromName(attributes, uri, uri_len, local, local_len, &index);
+    ok_(__FILE__, line)(hr == expect_hr && index == expect_index, "Unexpected hr %#lx, index %d.\n", hr, index);
+    hr = ISAXAttributes_getTypeFromName(attributes, uri, uri_len, local, local_len, &str, &len);
+    ok_(__FILE__, line)(hr == expect_hr, "Unexpected hr %#lx.\n", hr);
+    if (hr == S_OK)
+        ok_(__FILE__, line)(len == 5 && !memcmp(str, L"CDATA", 5 * sizeof(WCHAR)),
+                "Unexpected type %s.\n", wine_dbgstr_wn(str, len));
+    else
+        ok_(__FILE__, line)(!str && !len, "Unexpected outputs %p, %d.\n", str, len);
+}
