From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 04:24:54 -0400
Subject: [PATCH] mfplat: Wait for a D3D12 surface buffer's copies before
 releasing it.

Unlocking a D3D12 surface buffer after a write copies the data to the
texture on the buffer's own copy queue, and nothing waited for that copy:
releasing the buffer right after Unlock2D released the upload resource,
the command list and its allocators while the copy was still running.
Mesa's lavapipe then dereferenced a null pointer on its worker thread,
which killed the mfplat tests on an Xvfb display.  On Windows 11 the
written data reaches the texture all the same; the test now reads it
back after the buffer is gone.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/mfplat/buffer.c b/dlls/mfplat/buffer.c
index fed2fa5dc64..6ba85c99e82 100644
--- a/dlls/mfplat/buffer.c
+++ b/dlls/mfplat/buffer.c
@@ -196,6 +196,9 @@ static ULONG WINAPI memory_buffer_Release(IMFMediaBuffer *iface)
         }
         if (buffer->d3d12_surface.resource)
         {
+            if (buffer->d3d12_surface.fence)
+                ID3D12Fence_SetEventOnCompletion(buffer->d3d12_surface.fence,
+                        buffer->d3d12_surface.fence_value, NULL);
             ID3D12Device_Release(buffer->d3d12_surface.device);
             ID3D12Resource_Release(buffer->d3d12_surface.resource);
             if (buffer->d3d12_surface.sync_obj) IMFD3D12SynchronizationObject_Release(buffer->d3d12_surface.sync_obj);
diff --git a/dlls/mfplat/tests/mfplat.c b/dlls/mfplat/tests/mfplat.c
index 48be98908c5..822442349f5 100644
--- a/dlls/mfplat/tests/mfplat.c
+++ b/dlls/mfplat/tests/mfplat.c
@@ -12394,6 +12394,12 @@ if (SUCCEEDED(hr))
 
     hr = IMFMediaBuffer_QueryInterface(buffer, &IID_IMF2DBuffer2, (void **)&_2dbuffer2);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMFMediaBuffer_QueryInterface(buffer, &IID_IMFDXGIBuffer, (void **)&dxgi_buffer);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IMFDXGIBuffer_GetUnknown(dxgi_buffer, &MF_D3D12_SYNCHRONIZATION_OBJECT,
+            &IID_IMFD3D12SynchronizationObjectCommands, (void **)&sync_cmd);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    IMFDXGIBuffer_Release(dxgi_buffer);
 
     hr = IMF2DBuffer2_Lock2DSize(_2dbuffer2, MF2DBuffer_LockFlags_Write, &data, &pitch, &data2, &length);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
@@ -12402,6 +12408,7 @@ if (SUCCEEDED(hr))
     hr = IMF2DBuffer2_GetScanline0AndPitch(_2dbuffer2, &data2, &pitch2);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
     ok(data2 == data && pitch2 == pitch, "Unexpected data/pitch.\n");
+    *(DWORD *)data = 0xff123456;
 
     hr = IMF2DBuffer2_Unlock2D(_2dbuffer2);
     ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
@@ -12409,6 +12416,9 @@ if (SUCCEEDED(hr))
     IMF2DBuffer2_Release(_2dbuffer2);
     IMFMediaBuffer_Release(buffer);
 
+    color = get_d3d12_texture_color(resource, sync_cmd, 0, 0, 0);
+    ok(color == 0xff123456, "Unexpected color after releasing the buffer %#lx.\n", color);
+    IMFD3D12SynchronizationObjectCommands_Release(sync_cmd);
     ID3D12Resource_Release(resource);
 
     /* creation tests */
