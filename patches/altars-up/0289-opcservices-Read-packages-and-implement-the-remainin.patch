+HRESULT opc_normalize_part_uri(IUri *uri, IUri **normalized)
+{
+    WCHAR *path, *segment, *out, *end;
+    BSTR raw;
+    HRESULT hr;
+
+    if (FAILED(hr = IUri_GetRawUri(uri, &raw)))
+        return hr;
+    if (!(path = malloc((wcslen(raw) + 2) * sizeof(WCHAR))))
+    {
+        SysFreeString(raw);
+        return E_OUTOFMEMORY;
+    }
+
+    out = path;
+    *out++ = '/';
+    segment = raw;
+    while (*segment)
+    {
+        while (*segment == '/')
+            segment++;
+        if (!*segment)
+            break;
+        end = wcschr(segment, '/');
+        if (!end)
+            end = segment + wcslen(segment);
+        if (end - segment == 1 && segment[0] == '.')
+        {
+            segment = end;
+            continue;
+        }
+        if (end - segment == 2 && segment[0] == '.' && segment[1] == '.')
+        {
+            if (out > path + 1)
+            {
+                --out;
+                while (out > path + 1 && out[-1] != '/')
+                    --out;
+            }
+        }
+        else
+        {
+            memcpy(out, segment, (end - segment) * sizeof(WCHAR));
+            out += end - segment;
+            *out++ = '/';
+        }
+        segment = end;
+    }
+    if (out > path + 1 && raw[wcslen(raw) - 1] != '/')
+        --out;
+    *out = 0;
+
+    hr = CreateUri(path, Uri_CREATE_ALLOW_RELATIVE, 0, normalized);
+    free(path);
+    SysFreeString(raw);
+    return hr;
 }
 
