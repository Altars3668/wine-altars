From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 18:29:53 -0400
Subject: [PATCH] opcservices: Read packages, and implement the remaining
 stubs.

ReadPackageFromStream() reads ZIP32 and ZIP64 archives, stored and
deflated entries (checking sizes and CRCs), gives every part the content
type [Content_Types].xml declares (an Override before a Default, both
case-insensitive) and the compression option its entry records, and
loads every relationships part into its source's set, TargetMode
included; the relationships parts and the content types are not parts.

The relationship set deletes relationships, enumerates by type and gives
its relationships part as a read-only stream, written by the same code
as the package's; the part set deletes parts and finds them without
regard to case; part URIs compare without regard to case, give the
relative reference to another part (empty to themselves) and are
normalized when created or combined; content and file streams implement
the rest of IStream, with Clone sharing the data and keeping its own
position.  The existing tests' todo_wines all pass now.

Not yet run on Windows: the error codes for invalid packages (they only
test that reading fails), CopyTo's S_FALSE at the end of the data,
LockRegion's STG_E_INVALIDFUNCTION, the content stream's grfMode and
STG_E_ACCESSDENIED for a write to the relationships stream;
tools/opcprobe prints what Windows answers.  CreateDigitalSignatureManager
stays a stub.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/opcservices/compress.c b/dlls/opcservices/compress.c
index a03d7b18387..5c442a90936 100644
--- a/dlls/opcservices/compress.c
+++ b/dlls/opcservices/compress.c
@@ -583,3 +583,388 @@ HRESULT compress_add_file(struct zip_archive *archive, const WCHAR *path,
 
     return S_OK;
 }
+
+struct zip_read_archive
+{
+    IStream *input;
+    uint64_t size, directory_offset;
+    struct zip_read_file *files;
+    size_t count;
+};
+
+static HRESULT zip_read_at(struct zip_read_archive *archive, uint64_t offset, void *data, ULONG size)
+{
+    LARGE_INTEGER pos;
+    ULONG got;
+    HRESULT hr;
+
+    if (offset > archive->size || size > archive->size - offset || offset > INT64_MAX)
+        return OPC_E_ZIP_COMPRESSION_FAILED;
+    pos.QuadPart = offset;
+    if (FAILED(hr = IStream_Seek(archive->input, pos, STREAM_SEEK_SET, NULL)))
+        return hr;
+    while (size)
+    {
+        got = 0;
+        hr = IStream_Read(archive->input, data, size, &got);
+        if (FAILED(hr))
+            return hr;
+        if (!got)
+            return OPC_E_ZIP_COMPRESSION_FAILED;
+        data = (BYTE *)data + got;
+        size -= got;
+    }
+    return S_OK;
+}
+
+size_t compress_read_count(const struct zip_read_archive *archive)
+{
+    return archive->count;
+}
+
+const struct zip_read_file *compress_read_entry(const struct zip_read_archive *archive, size_t index)
+{
+    return &archive->files[index];
+}
+
+void compress_release_read_archive(struct zip_read_archive *archive)
+{
+    size_t i;
+
+    if (!archive)
+        return;
+    for (i = 0; i < archive->count; ++i)
+        free(archive->files[i].name);
+    free(archive->files);
+    IStream_Release(archive->input);
+    free(archive);
+}
+
+static HRESULT zip_read_central_entry(struct zip_read_archive *archive, size_t index, uint64_t *position,
+        uint64_t directory_end)
+{
+    struct zip32_central_directory_header header;
+    struct zip_read_file *file = &archive->files[index];
+    BYTE *extra = NULL;
+    char *name = NULL;
+    uint64_t end, offset;
+    size_t cursor;
+    int length, codepage;
+    HRESULT hr;
+
+    if (*position > directory_end || directory_end - *position < sizeof(header) ||
+            FAILED(hr = zip_read_at(archive, *position, &header, sizeof(header))))
+        return OPC_E_ZIP_COMPRESSION_FAILED;
+    if (header.signature != ZIP32_CDFH || header.diskid || (header.flags & 1) ||
+            (header.method != 0 && header.method != Z_DEFLATED))
+        return OPC_E_ZIP_COMPRESSION_FAILED;
+    end = *position + sizeof(header) + header.name_length + header.extra_length + header.comment_length;
+    if (end > directory_end || !header.name_length)
+        return OPC_E_ZIP_COMPRESSION_FAILED;
+    if (!(name = malloc(header.name_length + 1)) ||
+            (header.extra_length && !(extra = malloc(header.extra_length))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (FAILED(hr = zip_read_at(archive, *position + sizeof(header), name, header.name_length)))
+        goto done;
+    name[header.name_length] = 0;
+    if (memchr(name, 0, header.name_length))
+    {
+        hr = OPC_E_ZIP_COMPRESSION_FAILED;
+        goto done;
+    }
+    if (header.extra_length && FAILED(hr = zip_read_at(archive, *position + sizeof(header) +
+            header.name_length, extra, header.extra_length)))
+        goto done;
+
+    file->uncompressed_size = header.uncompressed_size;
+    file->compressed_size = header.compressed_size;
+    file->offset = header.local_file_offset;
+    file->crc32 = header.crc32;
+    file->flags = header.flags;
+    file->method = header.method;
+    for (cursor = 0; cursor + 4 <= header.extra_length; )
+    {
+        uint16_t id, size;
+
+        memcpy(&id, extra + cursor, sizeof(id));
+        memcpy(&size, extra + cursor + 2, sizeof(size));
+        cursor += 4;
+        if (size > header.extra_length - cursor)
+        {
+            /* Older archives generated here counted the four-byte extra header. */
+            if (id == 1 && size == header.extra_length)
+                size = header.extra_length - cursor;
+            else
+            {
+                hr = OPC_E_ZIP_COMPRESSION_FAILED;
+                goto done;
+            }
+        }
+        if (id == 1)
+        {
+            offset = cursor;
+            if (header.uncompressed_size == ~0u)
+            {
+                if (size < offset - cursor + 8)
+                    break;
+                memcpy(&file->uncompressed_size, extra + offset, 8);
+                offset += 8;
+            }
+            if (header.compressed_size == ~0u)
+            {
+                if (size < offset - cursor + 8)
+                    break;
+                memcpy(&file->compressed_size, extra + offset, 8);
+                offset += 8;
+            }
+            if (header.local_file_offset == ~0u)
+            {
+                if (size < offset - cursor + 8)
+                    break;
+                memcpy(&file->offset, extra + offset, 8);
+                offset += 8;
+            }
+            break;
+        }
+        cursor += size;
+    }
+    if ((header.uncompressed_size == ~0u && file->uncompressed_size == ~0u) ||
+            (header.compressed_size == ~0u && file->compressed_size == ~0u) ||
+            (header.local_file_offset == ~0u && file->offset == ~0u))
+    {
+        hr = OPC_E_ZIP_COMPRESSION_FAILED;
+        goto done;
+    }
+
+    codepage = (header.flags & 0x800) ? CP_UTF8 : CP_ACP;
+    length = MultiByteToWideChar(codepage, codepage == CP_UTF8 ? MB_ERR_INVALID_CHARS : 0,
+            name, header.name_length, NULL, 0);
+    if (!length || !(file->name = malloc((length + 1) * sizeof(WCHAR))))
+    {
+        hr = length ? E_OUTOFMEMORY : OPC_E_ZIP_COMPRESSION_FAILED;
+        goto done;
+    }
+    MultiByteToWideChar(codepage, codepage == CP_UTF8 ? MB_ERR_INVALID_CHARS : 0,
+            name, header.name_length, file->name, length);
+    file->name[length] = 0;
+    file->options = header.method == 0 ? OPC_COMPRESSION_NONE :
+            (header.flags & 6) == DEFLATE_MAX ? OPC_COMPRESSION_MAXIMUM :
+            (header.flags & 6) == DEFLATE_FAST ? OPC_COMPRESSION_FAST :
+            (header.flags & 6) == DEFLATE_SUPERFAST ? OPC_COMPRESSION_SUPERFAST : OPC_COMPRESSION_NORMAL;
+    *position = end;
+    hr = S_OK;
+done:
+    free(name);
+    free(extra);
+    return hr;
+}
+
+HRESULT compress_read_archive(IStream *input, struct zip_read_archive **out)
+{
+    struct zip_read_archive *archive;
+    struct zip32_end_of_central_directory end32;
+    struct zip64_end_of_central_directory end64;
+    struct zip64_end_of_central_directory_locator locator;
+    LARGE_INTEGER zero = {0};
+    ULARGE_INTEGER length;
+    BYTE *tail = NULL;
+    uint64_t directory_size, records, position, end_offset;
+    ULONG tail_size;
+    size_t i;
+    HRESULT hr;
+
+    *out = NULL;
+    if (!(archive = calloc(1, sizeof(*archive))))
+        return E_OUTOFMEMORY;
+    archive->input = input;
+    IStream_AddRef(input);
+    if (FAILED(hr = IStream_Seek(input, zero, STREAM_SEEK_END, &length)))
+        goto done;
+    archive->size = length.QuadPart;
+    tail_size = min(archive->size, (uint64_t)(0xffff + sizeof(end32)));
+    if (tail_size < sizeof(end32))
+    {
+        hr = OPC_E_ZIP_COMPRESSION_FAILED;
+        goto done;
+    }
+    if (!(tail = malloc(tail_size)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if (FAILED(hr = zip_read_at(archive, archive->size - tail_size, tail, tail_size)))
+        goto done;
+    for (i = tail_size - sizeof(end32); ; --i)
+    {
+        memcpy(&end32, tail + i, sizeof(end32));
+        if (end32.signature == ZIP32_EOCD && i + sizeof(end32) + end32.comment_length == tail_size)
+            break;
+        if (!i)
+        {
+            hr = OPC_E_ZIP_COMPRESSION_FAILED;
+            goto done;
+        }
+    }
+    end_offset = archive->size - tail_size + i;
+    if ((end32.diskid && (end32.diskid != 0xffff || end32.records_total != 0xffff)) ||
+            (end32.firstdisk && (end32.firstdisk != 0xffff || end32.records_total != 0xffff)) ||
+            end32.records_num != end32.records_total)
+    {
+        hr = OPC_E_ZIP_COMPRESSION_FAILED;
+        goto done;
+    }
+    records = end32.records_total;
+    directory_size = end32.directory_size;
+    archive->directory_offset = end32.directory_offset;
+    if (records == 0xffff || directory_size == ~0u || archive->directory_offset == ~0u)
+    {
+        if (end_offset < sizeof(locator) || FAILED(hr = zip_read_at(archive, end_offset - sizeof(locator),
+                &locator, sizeof(locator))) || locator.signature != ZIP64_EOCD64_LOCATOR ||
+                locator.eocd64_disk || locator.disk_num > 1)
+        {
+            hr = OPC_E_ZIP_COMPRESSION_FAILED;
+            goto done;
+        }
+        hr = zip_read_at(archive, locator.eocd64_offset, &end64, sizeof(end64));
+        if (FAILED(hr) || end64.signature != ZIP64_EOCD64)
+            hr = zip_read_at(archive, end_offset - sizeof(locator) - sizeof(end64), &end64, sizeof(end64));
+        if (FAILED(hr) || end64.signature != ZIP64_EOCD64 || end64.diskid || end64.directory_diskid ||
+                end64.records_num != end64.records_total || end64.size < sizeof(end64) - 12)
+        {
+            hr = OPC_E_ZIP_COMPRESSION_FAILED;
+            goto done;
+        }
+        records = end64.records_total;
+        directory_size = end64.directory_size;
+        archive->directory_offset = end64.directory_offset;
+    }
+    if (archive->directory_offset > end_offset || directory_size > end_offset - archive->directory_offset ||
+            records > SIZE_MAX / sizeof(*archive->files) || records > directory_size / sizeof(struct zip32_central_directory_header))
+    {
+        hr = OPC_E_ZIP_COMPRESSION_FAILED;
+        goto done;
+    }
+    archive->count = records;
+    if (!(archive->files = calloc(max(archive->count, 1), sizeof(*archive->files))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    position = archive->directory_offset;
+    for (i = 0; i < archive->count; ++i)
+    {
+        if (FAILED(hr = zip_read_central_entry(archive, i, &position, archive->directory_offset + directory_size)))
+            goto done;
+    }
+    if (position != archive->directory_offset + directory_size)
+        hr = OPC_E_ZIP_COMPRESSION_FAILED;
+    if (SUCCEEDED(hr))
+        *out = archive;
+done:
+    free(tail);
+    if (FAILED(hr))
+        compress_release_read_archive(archive);
+    return hr;
+}
+
+HRESULT compress_read_file(struct zip_read_archive *archive, size_t index, IStream **out)
+{
+    struct zip_read_file *file = &archive->files[index];
+    struct local_file_header header;
+    uint64_t offset, left, produced = 0;
+    BYTE input[0x8000], output[0x8000];
+    DWORD crc = 0;
+    z_stream zstr = {0};
+    LARGE_INTEGER zero = {0};
+    ULONG got, written;
+    IStream *content;
+    HRESULT hr;
+    int ret = Z_OK;
+
+    *out = NULL;
+    if (file->offset > archive->directory_offset ||
+            archive->directory_offset - file->offset < sizeof(header))
+        return OPC_E_ZIP_COMPRESSION_FAILED;
+    hr = zip_read_at(archive, file->offset, &header, sizeof(header));
+    if (FAILED(hr) || header.signature != LOCAL_HEADER_SIGNATURE || header.method != file->method ||
+            (header.flags & 1))
+        return OPC_E_ZIP_COMPRESSION_FAILED;
+    offset = file->offset + sizeof(header) + header.name_length + header.extra_length;
+    if (offset > archive->directory_offset || file->compressed_size > archive->directory_offset - offset)
+        return OPC_E_ZIP_COMPRESSION_FAILED;
+    if (FAILED(hr = CreateStreamOnHGlobal(NULL, TRUE, &content)))
+        return hr;
+    zstr.zalloc = zalloc;
+    zstr.zfree = zfree;
+    if (file->method == Z_DEFLATED && (ret = inflateInit2(&zstr, -MAX_WBITS)) != Z_OK)
+    {
+        hr = OPC_E_ZIP_COMPRESSION_FAILED;
+        goto done;
+    }
+    left = file->compressed_size;
+    while (left)
+    {
+        got = min(left, (uint64_t)sizeof(input));
+        if (FAILED(hr = zip_read_at(archive, offset, input, got)))
+            break;
+        offset += got;
+        left -= got;
+        if (file->method == 0)
+        {
+            if (produced + got > file->uncompressed_size)
+            {
+                hr = OPC_E_ZIP_COMPRESSION_FAILED;
+                break;
+            }
+            crc = RtlComputeCrc32(crc, input, got);
+            hr = IStream_Write(content, input, got, &written);
+            if (SUCCEEDED(hr) && written != got)
+                hr = STG_E_WRITEFAULT;
+            produced += got;
+        }
+        else
+        {
+            zstr.next_in = input;
+            zstr.avail_in = got;
+            do
+            {
+                zstr.next_out = output;
+                zstr.avail_out = sizeof(output);
+                ret = inflate(&zstr, Z_NO_FLUSH);
+                written = sizeof(output) - zstr.avail_out;
+                if ((ret != Z_OK && ret != Z_STREAM_END) || written > file->uncompressed_size - produced)
+                {
+                    hr = OPC_E_ZIP_COMPRESSION_FAILED;
+                    break;
+                }
+                crc = RtlComputeCrc32(crc, output, written);
+                produced += written;
+                hr = IStream_Write(content, output, written, &got);
+                if (SUCCEEDED(hr) && got != written)
+                    hr = STG_E_WRITEFAULT;
+            } while (SUCCEEDED(hr) && (zstr.avail_in || !zstr.avail_out) && ret != Z_STREAM_END);
+            if (ret == Z_STREAM_END && (left || zstr.avail_in))
+                hr = OPC_E_ZIP_COMPRESSION_FAILED;
+        }
+        if (FAILED(hr) || ret == Z_STREAM_END)
+            break;
+    }
+    if (file->method == Z_DEFLATED)
+        inflateEnd(&zstr);
+    if (SUCCEEDED(hr) && (produced != file->uncompressed_size || crc != file->crc32 ||
+            (file->method == Z_DEFLATED && ret != Z_STREAM_END)))
+        hr = OPC_E_ZIP_COMPRESSION_FAILED;
+    if (SUCCEEDED(hr))
+        hr = IStream_Seek(content, zero, STREAM_SEEK_SET, NULL);
+    if (SUCCEEDED(hr))
+    {
+        *out = content;
+        return S_OK;
+    }
+done:
+    IStream_Release(content);
+    return hr;
+}
