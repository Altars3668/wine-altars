+static void test_file_stream_ops(void)
+{
+    IOpcFactory *factory = create_factory();
+    WCHAR path[MAX_PATH], temp[MAX_PATH];
+    IStream *stream, *clone, *dest;
+    LARGE_INTEGER start = {0};
+    ULARGE_INTEGER size, pos, read, written;
+    STATSTG stat;
+    char buffer[8];
+    HRESULT hr;
+    ULONG got;
+
+    GetTempPathW(ARRAY_SIZE(temp), temp);
+    lstrcpyW(path, temp);
+    lstrcatW(path, L"opcfileops.ext");
+    DeleteFileW(path);
+    hr = IOpcFactory_CreateStreamOnFile(factory, path, OPC_STREAM_IO_WRITE, NULL, 0, &stream);
+    ok(hr == S_OK, "CreateStreamOnFile failed, hr %#lx.\n", hr);
+    if (FAILED(hr))
+        goto done;
+    hr = IStream_Write(stream, "abc", 3, NULL);
+    ok(hr == S_OK, "Write failed, hr %#lx.\n", hr);
+    hr = IStream_Clone(stream, &clone);
+    ok(hr == S_OK, "Clone failed, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IStream_Seek(clone, start, STREAM_SEEK_SET, &pos);
+        ok(hr == S_OK && !pos.QuadPart, "Clone seek failed, hr %#lx.\n", hr);
+        hr = IStream_Write(clone, "X", 1, NULL);
+        ok(hr == S_OK, "Clone write failed, hr %#lx.\n", hr);
+        IStream_Release(clone);
+    }
+    hr = IStream_Seek(stream, start, STREAM_SEEK_CUR, &pos);
+    ok(hr == S_OK && pos.QuadPart == 3, "Clone changed original position %s.\n",
+            wine_dbgstr_longlong(pos.QuadPart));
+    size.QuadPart = 5;
+    hr = IStream_SetSize(stream, size);
+    ok(hr == S_OK, "SetSize failed, hr %#lx.\n", hr);
+    hr = IStream_Stat(stream, &stat, STATFLAG_NONAME);
+    ok(hr == S_OK && stat.cbSize.QuadPart == 5, "Unexpected file size %s.\n",
+            wine_dbgstr_longlong(stat.cbSize.QuadPart));
+    hr = IStream_Commit(stream, 0);
+    ok(hr == S_OK, "Commit failed, hr %#lx.\n", hr);
+    hr = IStream_Revert(stream);
+    ok(hr == S_OK, "Revert failed, hr %#lx.\n", hr);
+    hr = IStream_LockRegion(stream, size, size, LOCK_WRITE);
+    ok(hr == STG_E_INVALIDFUNCTION, "LockRegion returned %#lx.\n", hr);
+    hr = IStream_UnlockRegion(stream, size, size, LOCK_WRITE);
+    ok(hr == STG_E_INVALIDFUNCTION, "UnlockRegion returned %#lx.\n", hr);
+    IStream_Release(stream);
+
+    hr = IOpcFactory_CreateStreamOnFile(factory, path, OPC_STREAM_IO_READ, NULL, 0, &stream);
+    ok(hr == S_OK, "Read stream failed, hr %#lx.\n", hr);
+    if (FAILED(hr))
+        goto done;
+    hr = CreateStreamOnHGlobal(NULL, TRUE, &dest);
+    ok(hr == S_OK, "Destination stream failed, hr %#lx.\n", hr);
+    size.QuadPart = 5;
+    hr = IStream_CopyTo(stream, dest, size, &read, &written);
+    ok(hr == S_OK && read.QuadPart == 5 && written.QuadPart == 5,
+            "File CopyTo failed, hr %#lx, read %s, written %s.\n", hr,
+            wine_dbgstr_longlong(read.QuadPart), wine_dbgstr_longlong(written.QuadPart));
+    hr = IStream_Seek(dest, start, STREAM_SEEK_SET, NULL);
+    ok(hr == S_OK, "Destination seek failed, hr %#lx.\n", hr);
+    got = 0;
+    hr = IStream_Read(dest, buffer, 5, &got);
+    ok(hr == S_OK && got == 5 && !memcmp(buffer, "Xbc\0\0", 5),
+            "Unexpected copied file data, hr %#lx, size %lu.\n", hr, got);
+    IStream_Release(dest);
+    IStream_Release(stream);
+done:
+    DeleteFileW(path);
+    IOpcFactory_Release(factory);
+}
