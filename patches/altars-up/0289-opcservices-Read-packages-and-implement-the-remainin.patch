+        else if (i >= 2)
+            IStream_Write(stream, no_content_types, sizeof(no_content_types) - (i == 3), NULL);
+        package = (void *)0xdeadbeef;
+        hr = IOpcFactory_ReadPackageFromStream(factory, stream, OPC_READ_DEFAULT, &package);
+        ok(FAILED(hr) && !package, "Unexpected invalid ZIP result %#lx, %p.\n", hr, package);
+        IStream_Release(stream);
+    }
+    IOpcFactory_Release(factory);
+}
