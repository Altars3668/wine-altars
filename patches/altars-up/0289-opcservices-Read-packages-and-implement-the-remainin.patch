+struct opc_read_type
+{
+    WCHAR *key, *value;
+    BOOL is_override;
+};
+
+struct opc_read_types
+{
+    struct opc_read_type *items;
+    size_t count, capacity;
+};
+
+static WCHAR *opc_read_strdup(const WCHAR *value)
+{
+    WCHAR *copy;
+    size_t size = (wcslen(value) + 1) * sizeof(WCHAR);
+
+    if ((copy = malloc(size)))
+        memcpy(copy, value, size);
+    return copy;
+}
+
+static void opc_read_free_types(struct opc_read_types *types)
+{
+    size_t i;
+
+    for (i = 0; i < types->count; ++i)
+    {
+        free(types->items[i].key);
+        free(types->items[i].value);
+    }
+    free(types->items);
+}
+
+static HRESULT opc_read_add_type(struct opc_read_types *types, const WCHAR *key, const WCHAR *value,
+        BOOL is_override)
+{
+    struct opc_read_type *item;
+
+    if (!opc_array_reserve((void **)&types->items, &types->capacity, types->count + 1,
+            sizeof(*types->items)))
+        return E_OUTOFMEMORY;
+    item = &types->items[types->count];
+    item->key = opc_read_strdup(key);
+    item->value = opc_read_strdup(value);
+    if (!item->key || !item->value)
+    {
+        free(item->key);
+        free(item->value);
+        return E_OUTOFMEMORY;
+    }
+    item->is_override = is_override;
+    types->count++;
+    return S_OK;
+}
+
+static const WCHAR *opc_read_find_type(const struct opc_read_types *types, const WCHAR *name)
+{
+    const WCHAR *extension = wcsrchr(name, '.');
+    const WCHAR *slash = wcsrchr(name, '/');
+    const WCHAR *def = NULL;
+    size_t i;
+
+    if (slash && extension && extension < slash)
+        extension = NULL;
+    for (i = 0; i < types->count; ++i)
+    {
+        const struct opc_read_type *type = &types->items[i];
+
+        if (type->is_override && type->key[0] == '/' && !wcsicmp(type->key + 1, name))
+            return type->value;
+        if (!type->is_override && extension && !wcsicmp(type->key, extension + 1))
+            def = type->value;
+    }
+    return def;
+}
+
+static HRESULT opc_read_xml(IStream *stream, struct opc_read_types *types, IOpcRelationshipSet *rels)
+{
+    IXmlReader *reader;
+    XmlNodeType node;
+    const WCHAR *name, *value, *ns;
+    WCHAR *key = NULL, *content_type = NULL, *id = NULL, *target = NULL, *mode = NULL;
+    BOOL root = FALSE;
+    HRESULT hr;
+
+    if (FAILED(hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL)))
+        return hr;
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    while (hr == S_OK && (hr = IXmlReader_Read(reader, &node)) == S_OK)
+    {
+        BOOL entry = FALSE, is_override = FALSE;
+
+        if (node != XmlNodeType_Element)
+            continue;
+        if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)))
+            break;
+        if (!root)
+        {
+            hr = IXmlReader_GetNamespaceUri(reader, &ns, NULL);
+            if (SUCCEEDED(hr) && (wcscmp(name, types ? L"Types" : L"Relationships") ||
+                    wcscmp(ns, types ? L"http://schemas.openxmlformats.org/package/2006/content-types" :
+                            L"http://schemas.openxmlformats.org/package/2006/relationships")))
+                hr = OPC_E_ZIP_COMPRESSION_FAILED;
+            if (SUCCEEDED(hr))
+                root = TRUE;
+            continue;
+        }
+        if (types)
+        {
+            is_override = !wcscmp(name, L"Override");
+            entry = is_override || !wcscmp(name, L"Default");
+        }
+        else
+            entry = !wcscmp(name, L"Relationship");
+        if (!entry)
+            continue;
+
+        if (IXmlReader_MoveToFirstAttribute(reader) == S_OK)
+        {
+            do
+            {
+                if (FAILED(hr = IXmlReader_GetLocalName(reader, &name, NULL)) ||
+                        FAILED(hr = IXmlReader_GetValue(reader, &value, NULL)))
+                    break;
+                if (types)
+                {
+                    if (!wcscmp(name, is_override ? L"PartName" : L"Extension"))
+                    {
+                        free(key);
+                        key = opc_read_strdup(value);
+                    }
+                    else if (!wcscmp(name, L"ContentType"))
+                    {
+                        free(content_type);
+                        content_type = opc_read_strdup(value);
+                    }
+                }
+                else
+                {
+                    WCHAR **field = NULL;
+
+                    if (!wcscmp(name, L"Id"))
+                        field = &id;
+                    else if (!wcscmp(name, L"Type"))
+                        field = &content_type;
+                    else if (!wcscmp(name, L"Target"))
+                        field = &target;
+                    else if (!wcscmp(name, L"TargetMode"))
+                        field = &mode;
+                    if (field)
+                    {
+                        free(*field);
+                        *field = opc_read_strdup(value);
+                    }
+                }
+            } while (SUCCEEDED(hr) && IXmlReader_MoveToNextAttribute(reader) == S_OK);
+            if (SUCCEEDED(hr))
+                hr = IXmlReader_MoveToElement(reader);
+        }
+        if (FAILED(hr))
+            break;
+        if (types)
+        {
+            if (!key || !content_type || !*key || !*content_type || (is_override && key[0] != '/'))
+                hr = OPC_E_ZIP_COMPRESSION_FAILED;
+            else
+                hr = opc_read_add_type(types, key, content_type, is_override);
+        }
+        else
+        {
+            IUri *uri;
+            IOpcRelationship *rel;
+            OPC_URI_TARGET_MODE target_mode = OPC_URI_TARGET_MODE_INTERNAL;
+
+            if (!id || !content_type || !target || !*id || !*content_type ||
+                    (mode && wcscmp(mode, L"Internal") && wcscmp(mode, L"External")))
+                hr = OPC_E_ZIP_COMPRESSION_FAILED;
+            else
+            {
+                if (mode && !wcscmp(mode, L"External"))
+                    target_mode = OPC_URI_TARGET_MODE_EXTERNAL;
+                hr = CreateUri(target, Uri_CREATE_ALLOW_RELATIVE, 0, &uri);
+                if (SUCCEEDED(hr))
+                {
+                    hr = IOpcRelationshipSet_CreateRelationship(rels, id, content_type, uri, target_mode, &rel);
+                    if (SUCCEEDED(hr))
+                        IOpcRelationship_Release(rel);
+                    IUri_Release(uri);
+                }
+            }
+        }
+        free(key); key = NULL;
+        free(id); id = NULL;
+        free(content_type); content_type = NULL;
+        free(target); target = NULL;
+        free(mode); mode = NULL;
+    }
+    if (hr == S_FALSE)
+        hr = root ? S_OK : OPC_E_ZIP_COMPRESSION_FAILED;
+    free(key);
+    free(id);
+    free(content_type);
+    free(target);
+    free(mode);
+    IXmlReader_Release(reader);
+    return hr;
+}
+
+static BOOL opc_read_is_rels(const WCHAR *name, WCHAR **source)
+{
+    const WCHAR *folder = wcsstr(name, L"_rels/");
+    const WCHAR *end = name + wcslen(name);
+    const WCHAR *last = folder ? folder + 6 : NULL;
+    size_t prefix;
+
+    *source = NULL;
+    if (!folder || (folder != name && folder[-1] != '/') || end - last < 5 ||
+            wcscmp(end - 5, L".rels") || wcschr(last, '/'))
+        return FALSE;
+    if (folder == name && !wcscmp(last, L".rels"))
+        return TRUE;
+    if (last == end - 5)
+        return FALSE;
+    prefix = folder - name;
+    if (!(*source = malloc((prefix + (end - 5 - last) + 2) * sizeof(WCHAR))))
+        return TRUE;
+    (*source)[0] = '/';
+    memcpy(*source + 1, name, prefix * sizeof(WCHAR));
+    memcpy(*source + 1 + prefix, last, (end - 5 - last) * sizeof(WCHAR));
+    (*source)[1 + prefix + (end - 5 - last)] = 0;
+    return TRUE;
+}
+
+static HRESULT opc_read_load_parts(IOpcFactory *factory, struct zip_read_archive *archive,
+        struct opc_read_types *types, IOpcPackage *package)
+{
+    IOpcPartSet *set;
+    HRESULT hr;
+    size_t i;
+
+    if (FAILED(hr = IOpcPackage_GetPartSet(package, &set)))
+        return hr;
+    for (i = 0; i < compress_read_count(archive); ++i)
+    {
+        const struct zip_read_file *entry = compress_read_entry(archive, i);
+        const WCHAR *type;
+        IOpcPartUri *uri = NULL;
+        IOpcPart *part = NULL;
+        IStream *input = NULL, *output = NULL;
+        ULARGE_INTEGER size;
+        WCHAR *source = NULL;
+        WCHAR *path;
+
+        if (!wcscmp(entry->name, L"[Content_Types].xml") ||
+                opc_read_is_rels(entry->name, &source))
+        {
+            free(source);
+            continue;
+        }
+        if (!*entry->name)
+        {
+            hr = OPC_E_ZIP_COMPRESSION_FAILED;
+            break;
+        }
+        if (entry->name[wcslen(entry->name) - 1] == '/')
+        {
+            hr = compress_read_file(archive, i, &input);
+            if (SUCCEEDED(hr))
+                IStream_Release(input);
+            if (FAILED(hr))
+                break;
+            continue;
+        }
+        if (!(type = opc_read_find_type(types, entry->name)))
+        {
+            hr = OPC_E_ZIP_COMPRESSION_FAILED;
+            break;
+        }
+        if (!(path = malloc((wcslen(entry->name) + 2) * sizeof(WCHAR))))
+        {
+            hr = E_OUTOFMEMORY;
+            break;
+        }
+        path[0] = '/';
+        wcscpy(path + 1, entry->name);
+        hr = IOpcFactory_CreatePartUri(factory, path, &uri);
+        free(path);
+        if (SUCCEEDED(hr))
+            hr = IOpcPartSet_CreatePart(set, uri, type, entry->options, &part);
+        if (SUCCEEDED(hr))
+            hr = compress_read_file(archive, i, &input);
+        if (SUCCEEDED(hr))
+            hr = IOpcPart_GetContentStream(part, &output);
+        if (SUCCEEDED(hr))
+        {
+            size.QuadPart = entry->uncompressed_size;
+            hr = IStream_CopyTo(input, output, size, NULL, NULL);
+        }
+        if (output)
+            IStream_Release(output);
+        if (input)
+            IStream_Release(input);
+        if (part)
+            IOpcPart_Release(part);
+        if (uri)
+            IOpcPartUri_Release(uri);
+        if (FAILED(hr))
+            break;
+    }
+    IOpcPartSet_Release(set);
+    return hr;
+}
+
+static HRESULT opc_read_load_rels(IOpcFactory *factory, struct zip_read_archive *archive, IOpcPackage *package)
+{
+    HRESULT hr = S_OK;
+    size_t i;
+
+    for (i = 0; i < compress_read_count(archive); ++i)
+    {
+        const struct zip_read_file *entry = compress_read_entry(archive, i);
+        IOpcRelationshipSet *set = NULL;
+        IOpcPartSet *parts = NULL;
+        IOpcPartUri *uri = NULL;
+        IOpcPart *part = NULL;
+        IStream *xml = NULL;
+        WCHAR *source;
+
+        if (!opc_read_is_rels(entry->name, &source))
+            continue;
+        if (!source && wcscmp(entry->name, L"_rels/.rels"))
+            return E_OUTOFMEMORY;
+        if (source)
+        {
+            hr = IOpcFactory_CreatePartUri(factory, source, &uri);
+            if (SUCCEEDED(hr))
+                hr = IOpcPackage_GetPartSet(package, &parts);
+            if (SUCCEEDED(hr))
+                hr = IOpcPartSet_GetPart(parts, uri, &part);
+            if (SUCCEEDED(hr))
+                hr = IOpcPart_GetRelationshipSet(part, &set);
+        }
+        else
+            hr = IOpcPackage_GetRelationshipSet(package, &set);
+        if (SUCCEEDED(hr))
+            hr = compress_read_file(archive, i, &xml);
+        if (SUCCEEDED(hr))
+            hr = opc_read_xml(xml, NULL, set);
+        free(source);
+        if (xml)
+            IStream_Release(xml);
+        if (set)
+            IOpcRelationshipSet_Release(set);
+        if (part)
+            IOpcPart_Release(part);
+        if (parts)
+            IOpcPartSet_Release(parts);
+        if (uri)
+            IOpcPartUri_Release(uri);
+        if (FAILED(hr))
+            break;
+    }
+    return hr;
+}
