+    IOpcRelationshipEnumerator_MoveNext(enumerator, &next);
+    ok(!next, "Unfiltered relationship included.\n");
+    IOpcRelationshipEnumerator_Release(enumerator);
+    hr = IOpcRelationshipSet_DeleteRelationship(rels, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    hr = IOpcRelationshipSet_DeleteRelationship(rels, L"missing");
+    ok(hr == OPC_E_NO_SUCH_RELATIONSHIP, "Unexpected hr %#lx.\n", hr);
+    hr = IOpcRelationshipSet_DeleteRelationship(rels, L"first");
+    ok(hr == S_OK, "DeleteRelationship failed, hr %#lx.\n", hr);
