+static void check_relationship(IOpcRelationshipSet *set, const WCHAR *id, const WCHAR *type,
+        const WCHAR *target, OPC_URI_TARGET_MODE expected_mode)
+{
+    OPC_URI_TARGET_MODE mode;
+    IOpcRelationship *rel;
+    IUri *target_uri;
+    WCHAR *value;
+    HRESULT hr;
+    BSTR raw;
+
+    hr = IOpcRelationshipSet_GetRelationship(set, id, &rel);
+    ok(hr == S_OK, "GetRelationship(%s) failed, hr %#lx.\n", wine_dbgstr_w(id), hr);
+    if (FAILED(hr))
+        return;
+    hr = IOpcRelationship_GetId(rel, &value);
+    ok(hr == S_OK && !wcscmp(value, id), "Unexpected id %s, hr %#lx.\n", wine_dbgstr_w(value), hr);
+    CoTaskMemFree(value);
+    hr = IOpcRelationship_GetRelationshipType(rel, &value);
+    ok(hr == S_OK && !wcscmp(value, type), "Unexpected type %s, hr %#lx.\n", wine_dbgstr_w(value), hr);
+    CoTaskMemFree(value);
+    hr = IOpcRelationship_GetTargetUri(rel, &target_uri);
+    ok(hr == S_OK, "GetTargetUri failed, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        hr = IUri_GetRawUri(target_uri, &raw);
+        ok(hr == S_OK && !wcscmp(raw, target), "Unexpected target %s, hr %#lx.\n", wine_dbgstr_w(raw), hr);
+        SysFreeString(raw);
+        IUri_Release(target_uri);
+    }
+    hr = IOpcRelationship_GetTargetMode(rel, &mode);
+    ok(hr == S_OK && mode == expected_mode, "Unexpected mode %d, hr %#lx.\n", mode, hr);
+    IOpcRelationship_Release(rel);
+}
