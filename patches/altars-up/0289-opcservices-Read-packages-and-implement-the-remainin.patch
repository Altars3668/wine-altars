+static void test_edit_package(void)
+{
+    IOpcFactory *factory = create_factory();
+    IOpcPackage *package;
+    IOpcPartSet *parts;
+    IOpcPartUri *uri, *other_uri;
+    IOpcPart *part, *other_part;
+    IOpcRelationshipSet *rels;
+    IOpcRelationshipEnumerator *enumerator;
+    IOpcRelationship *rel;
+    IStream *content, *clone, *dest;
+    IUri *target;
+    WCHAR *type;
+    ULARGE_INTEGER size, count, written, pos;
+    LARGE_INTEGER move = {0};
+    STATSTG stat;
+    HRESULT hr;
+    INT32 order;
+    BOOL next, exists;
+    char buffer[16];
+
+    IOpcFactory_CreatePackage(factory, &package);
+    IOpcPackage_GetPartSet(package, &parts);
+    IOpcFactory_CreatePartUri(factory, L"/word/document.xml", &uri);
+    IOpcFactory_CreatePartUri(factory, L"/WORD/DOCUMENT.XML", &other_uri);
+    hr = IOpcPartUri_ComparePartUri(uri, other_uri, &order);
+    ok(hr == S_OK && !order, "Expected equal part URIs, hr %#lx, order %d.\n", hr, order);
+    hr = IOpcPartUri_ComparePartUri(uri, NULL, &order);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    hr = IOpcPartUri_ComparePartUri(uri, other_uri, NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    IOpcPartUri_Release(other_uri);
+    IOpcFactory_CreatePartUri(factory, L"/word/earlier.xml", &other_uri);
+    hr = IOpcPartUri_ComparePartUri(uri, other_uri, &order);
+    ok(hr == S_OK && order < 0, "Unexpected ordering %d, hr %#lx.\n", order, hr);
+    IOpcPartUri_Release(other_uri);
+
+    IOpcPartSet_CreatePart(parts, uri, L"application/xml", OPC_COMPRESSION_NORMAL, &part);
+    IOpcFactory_CreatePartUri(factory, L"/WORD/DOCUMENT.XML", &other_uri);
+    other_part = (void *)0xdeadbeef;
+    hr = IOpcPartSet_CreatePart(parts, other_uri, L"application/xml", OPC_COMPRESSION_NORMAL, &other_part);
+    ok(hr == OPC_E_DUPLICATE_PART && other_part == NULL, "Case-variant duplicate accepted, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        IOpcPart_Release(other_part);
+    hr = IOpcPartSet_GetPart(parts, other_uri, &other_part);
+    ok(hr == S_OK && other_part == part, "Case-variant lookup failed, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        IOpcPart_Release(other_part);
+    IOpcPartUri_Release(other_uri);
+    IOpcPart_GetContentStream(part, &content);
+    size.QuadPart = 4;
+    hr = IStream_SetSize(content, size);
+    ok(hr == S_OK, "SetSize failed, hr %#lx.\n", hr);
+    hr = IStream_Stat(content, &stat, STATFLAG_NONAME);
+    ok(hr == S_OK && stat.cbSize.QuadPart == 4 && stat.grfMode == STGM_READWRITE,
+            "Unexpected stream stat, hr %#lx, size %s.\n", hr, wine_dbgstr_longlong(stat.cbSize.QuadPart));
+    hr = IStream_Write(content, "data", 4, NULL);
+    ok(hr == S_OK, "Write failed, hr %#lx.\n", hr);
+    hr = IStream_Clone(content, &clone);
+    ok(hr == S_OK, "Clone failed, hr %#lx.\n", hr);
+    hr = IStream_Seek(clone, move, STREAM_SEEK_SET, &pos);
+    ok(hr == S_OK && pos.QuadPart == 0, "Seek clone failed, hr %#lx.\n", hr);
+    hr = IStream_Read(clone, buffer, 4, NULL);
+    ok(hr == S_OK && !memcmp(buffer, "data", 4), "Clone did not share content.\n");
+    hr = IStream_Seek(content, move, STREAM_SEEK_CUR, &pos);
+    ok(hr == S_OK && pos.QuadPart == 4, "Clone changed original position.\n");
+    IStream_Release(clone);
+    hr = CreateStreamOnHGlobal(NULL, TRUE, &dest);
+    ok(hr == S_OK, "CreateStreamOnHGlobal failed, hr %#lx.\n", hr);
+    IStream_Seek(content, move, STREAM_SEEK_SET, NULL);
+    size.QuadPart = 4;
+    hr = IStream_CopyTo(content, dest, size, &count, &written);
+    ok(hr == S_OK && count.QuadPart == 4 && written.QuadPart == 4,
+            "CopyTo failed, hr %#lx, counts %s / %s.\n", hr,
+            wine_dbgstr_longlong(count.QuadPart), wine_dbgstr_longlong(written.QuadPart));
+    IStream_Release(dest);
+    hr = IStream_Commit(content, 0);
+    ok(hr == S_OK, "Commit failed, hr %#lx.\n", hr);
+    hr = IStream_Revert(content);
+    ok(hr == S_OK, "Revert failed, hr %#lx.\n", hr);
+    hr = IStream_LockRegion(content, size, size, LOCK_WRITE);
+    ok(hr == STG_E_INVALIDFUNCTION, "LockRegion returned %#lx.\n", hr);
+    hr = IStream_UnlockRegion(content, size, size, LOCK_WRITE);
+    ok(hr == STG_E_INVALIDFUNCTION, "UnlockRegion returned %#lx.\n", hr);
+    IStream_Release(content);
+
+    IOpcPart_GetRelationshipSet(part, &rels);
+    hr = IOpcRelationshipSet_GetRelationshipsContentStream(rels, &content);
+    ok(hr == S_OK, "Empty relationships stream failed, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        char xml_buf[256];
+        ULONG got = 0;
+        hr = IStream_Read(content, xml_buf, sizeof(xml_buf) - 1, &got);
+        ok(hr == S_OK, "Read empty relationships failed, hr %#lx.\n", hr);
+        xml_buf[got] = 0;
+        ok(strstr(xml_buf, "<Relationships xmlns=") != NULL && strstr(xml_buf, "<Relationship ") == NULL,
+                "Unexpected empty relationships XML %s.\n", xml_buf);
+        IStream_Release(content);
+    }
+    CreateUri(L"target", Uri_CREATE_ALLOW_RELATIVE, 0, &target);
+    hr = IOpcRelationshipSet_CreateRelationship(rels, L"first", L"urn:one", target,
+            OPC_URI_TARGET_MODE_INTERNAL, &rel);
+    ok(hr == S_OK, "CreateRelationship failed, hr %#lx.\n", hr);
+    IOpcRelationship_Release(rel);
+    hr = IOpcRelationshipSet_CreateRelationship(rels, L"second", L"urn:two", target,
+            OPC_URI_TARGET_MODE_INTERNAL, &rel);
+    ok(hr == S_OK, "CreateRelationship failed, hr %#lx.\n", hr);
+    IOpcRelationship_Release(rel);
+    IUri_Release(target);
+    hr = IOpcRelationshipSet_GetEnumeratorForType(rels, NULL, &enumerator);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    hr = IOpcRelationshipSet_GetEnumeratorForType(rels, L"urn:one", NULL);
+    ok(hr == E_POINTER, "Unexpected hr %#lx.\n", hr);
+    hr = IOpcRelationshipSet_GetEnumeratorForType(rels, L"urn:one", &enumerator);
