+static void test_roundtrip_package(void)
+{
+    static const WCHAR content_type[] = L"application/vnd.test+xml";
+    static const WCHAR internal_type[] = L"urn:test:internal";
+    static const WCHAR external_type[] = L"urn:test:external";
+    static const WCHAR package_type[] = L"urn:test:package";
+    static const char rels_xml[] = "<?xml version=\"1.0\" encoding=\"UTF-8\" standalone=\"yes\"?>"
+            "<Relationships xmlns=\"http://schemas.openxmlformats.org/package/2006/relationships\">"
+            "<Relationship Target=\"media/image.bin\" Id=\"internal\" Type=\"urn:test:internal\" />"
+            "<Relationship Target=\"https://example.com/\" Id=\"external\" Type=\"urn:test:external\" TargetMode=\"External\" />"
+            "</Relationships>";
+    IOpcFactory *factory = create_factory();
+    IOpcPackage *package = NULL, *read_package = NULL;
+    IOpcPartSet *parts = NULL, *read_parts = NULL;
+    IOpcPartUri *uri = NULL;
+    IOpcPart *part = NULL, *read_part = NULL;
+    IOpcRelationshipSet *rels = NULL, *package_rels = NULL, *read_rels = NULL;
+    IOpcRelationship *rel;
+    IOpcPartEnumerator *enumerator;
+    IStream *content = NULL, *zip = NULL, *xml = NULL;
+    IUri *target = NULL;
+    WCHAR *type;
+    OPC_COMPRESSION_OPTIONS options;
+    LARGE_INTEGER zero = {0};
+    HRESULT hr;
+    ULONG got;
+    BOOL next;
+    char buffer[1024];
+    unsigned int i;
+
+    hr = IOpcFactory_CreatePackage(factory, &package);
+    ok(hr == S_OK, "CreatePackage failed, hr %#lx.\n", hr);
+    hr = IOpcFactory_CreatePartUri(factory, L"/word/document.xml", &uri);
+    ok(hr == S_OK, "CreatePartUri failed, hr %#lx.\n", hr);
+    hr = IOpcPackage_GetPartSet(package, &parts);
+    ok(hr == S_OK, "GetPartSet failed, hr %#lx.\n", hr);
+    hr = IOpcPartSet_CreatePart(parts, uri, content_type, OPC_COMPRESSION_FAST, &part);
+    ok(hr == S_OK, "CreatePart failed, hr %#lx.\n", hr);
+    hr = IOpcPart_GetContentStream(part, &content);
+    ok(hr == S_OK, "GetContentStream failed, hr %#lx.\n", hr);
+    hr = IStream_Write(content, "document data", 13, NULL);
+    ok(hr == S_OK, "Write failed, hr %#lx.\n", hr);
+    IStream_Release(content);
+
+    hr = IOpcPart_GetRelationshipSet(part, &rels);
+    ok(hr == S_OK, "GetRelationshipSet failed, hr %#lx.\n", hr);
+    hr = CreateUri(L"media/image.bin", Uri_CREATE_ALLOW_RELATIVE, 0, &target);
+    ok(hr == S_OK, "CreateUri failed, hr %#lx.\n", hr);
+    hr = IOpcRelationshipSet_CreateRelationship(rels, L"internal", internal_type, target,
+            OPC_URI_TARGET_MODE_INTERNAL, &rel);
+    ok(hr == S_OK, "CreateRelationship failed, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        IOpcRelationship_Release(rel);
+    IUri_Release(target);
+    hr = CreateUri(L"https://example.com/", 0, 0, &target);
+    ok(hr == S_OK, "CreateUri failed, hr %#lx.\n", hr);
+    hr = IOpcRelationshipSet_CreateRelationship(rels, L"external", external_type, target,
+            OPC_URI_TARGET_MODE_EXTERNAL, &rel);
+    ok(hr == S_OK, "CreateRelationship failed, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        IOpcRelationship_Release(rel);
+    IUri_Release(target);
+    hr = IOpcPackage_GetRelationshipSet(package, &package_rels);
+    ok(hr == S_OK, "GetRelationshipSet failed, hr %#lx.\n", hr);
+    hr = CreateUri(L"word/document.xml", Uri_CREATE_ALLOW_RELATIVE, 0, &target);
+    ok(hr == S_OK, "CreateUri failed, hr %#lx.\n", hr);
+    hr = IOpcRelationshipSet_CreateRelationship(package_rels, L"package", package_type, target,
+            OPC_URI_TARGET_MODE_INTERNAL, &rel);
+    ok(hr == S_OK, "CreateRelationship failed, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        IOpcRelationship_Release(rel);
+    IUri_Release(target);
+
+    hr = IOpcRelationshipSet_GetRelationshipsContentStream(rels, &xml);
+    ok(hr == S_OK, "GetRelationshipsContentStream failed, hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        got = 0;
+        hr = IStream_Read(xml, buffer, sizeof(buffer) - 1, &got);
+        ok(hr == S_OK, "Read relationships XML failed, hr %#lx.\n", hr);
+        buffer[got] = 0;
+        ok(!strcmp(buffer, rels_xml), "Unexpected relationships XML: %s.\n", buffer);
+        hr = IStream_Write(xml, "x", 1, NULL);
+        ok(hr == STG_E_ACCESSDENIED, "Expected read-only stream, hr %#lx.\n", hr);
+        IStream_Release(xml);
+    }
+
+    for (i = 0; i < 2; ++i)
+    {
+        winetest_push_context("ZIP%u", i ? 64 : 32);
+        hr = CreateStreamOnHGlobal(NULL, TRUE, &zip);
+        ok(hr == S_OK, "CreateStreamOnHGlobal failed, hr %#lx.\n", hr);
+        hr = IOpcFactory_WritePackageToStream(factory, package,
+                i ? OPC_WRITE_DEFAULT : OPC_WRITE_FORCE_ZIP32, zip);
+        ok(hr == S_OK, "WritePackageToStream failed, hr %#lx.\n", hr);
+        hr = IStream_Seek(zip, zero, STREAM_SEEK_SET, NULL);
+        ok(hr == S_OK, "Seek failed, hr %#lx.\n", hr);
+        hr = IOpcFactory_ReadPackageFromStream(factory, zip,
+                i ? OPC_CACHE_ON_ACCESS : OPC_READ_DEFAULT, &read_package);
+        ok(hr == S_OK, "ReadPackageFromStream failed, hr %#lx.\n", hr);
+        IStream_Release(zip);
+        if (FAILED(hr))
+        {
+            winetest_pop_context();
+            continue;
+        }
+
+        hr = IOpcPackage_GetPartSet(read_package, &read_parts);
+        ok(hr == S_OK, "GetPartSet failed, hr %#lx.\n", hr);
+        hr = IOpcPartSet_GetPart(read_parts, uri, &read_part);
+        ok(hr == S_OK, "GetPart failed, hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            hr = IOpcPart_GetContentType(read_part, &type);
+            ok(hr == S_OK && !wcscmp(type, content_type), "Unexpected content type %s.\n", wine_dbgstr_w(type));
+            CoTaskMemFree(type);
+            hr = IOpcPart_GetCompressionOptions(read_part, &options);
+            ok(hr == S_OK && options == OPC_COMPRESSION_FAST, "Unexpected compression %d.\n", options);
+            hr = IOpcPart_GetContentStream(read_part, &content);
+            ok(hr == S_OK, "GetContentStream failed, hr %#lx.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                got = 0;
+                hr = IStream_Read(content, buffer, sizeof(buffer), &got);
+                ok(hr == S_OK && got == 13 && !memcmp(buffer, "document data", 13),
+                        "Unexpected content length %lu, hr %#lx.\n", got, hr);
+                IStream_Release(content);
+            }
+            hr = IOpcPart_GetRelationshipSet(read_part, &read_rels);
+            ok(hr == S_OK, "GetRelationshipSet failed, hr %#lx.\n", hr);
+            if (SUCCEEDED(hr))
+            {
+                check_relationship(read_rels, L"internal", internal_type, L"media/image.bin",
+                        OPC_URI_TARGET_MODE_INTERNAL);
+                check_relationship(read_rels, L"external", external_type, L"https://example.com/",
+                        OPC_URI_TARGET_MODE_EXTERNAL);
+                IOpcRelationshipSet_Release(read_rels);
+            }
+            IOpcPart_Release(read_part);
+        }
+        hr = IOpcPartSet_GetEnumerator(read_parts, &enumerator);
+        ok(hr == S_OK, "GetEnumerator failed, hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            IOpcPartEnumerator_MoveNext(enumerator, &next);
+            ok(next, "Missing part.\n");
+            IOpcPartEnumerator_MoveNext(enumerator, &next);
+            ok(!next, "Metadata was exposed as a part.\n");
+            IOpcPartEnumerator_Release(enumerator);
+        }
+        IOpcPartSet_Release(read_parts);
+        hr = IOpcPackage_GetRelationshipSet(read_package, &read_rels);
+        ok(hr == S_OK, "GetRelationshipSet failed, hr %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            check_relationship(read_rels, L"package", package_type, L"word/document.xml",
+                    OPC_URI_TARGET_MODE_INTERNAL);
+            IOpcRelationshipSet_Release(read_rels);
+        }
+        IOpcPackage_Release(read_package);
+        winetest_pop_context();
+    }
+    IOpcRelationshipSet_Release(package_rels);
+    IOpcRelationshipSet_Release(rels);
+    IOpcPart_Release(part);
+    IOpcPartUri_Release(uri);
+    IOpcPartSet_Release(parts);
+    IOpcPackage_Release(package);
+    IOpcFactory_Release(factory);
+}
