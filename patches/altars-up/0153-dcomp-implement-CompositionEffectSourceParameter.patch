+
+#include "private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(dcomp);
+
+struct effect_source_parameter
+{
+    ICompositionEffectSourceParameter ICompositionEffectSourceParameter_iface;
+    IGraphicsEffectSource IGraphicsEffectSource_iface;
+    LONG ref;
+    HSTRING name;
+};
+
+static inline struct effect_source_parameter *impl_from_ICompositionEffectSourceParameter(
+        ICompositionEffectSourceParameter *iface )
+{
+    return CONTAINING_RECORD( iface, struct effect_source_parameter, ICompositionEffectSourceParameter_iface );
+}
+
+static HRESULT WINAPI parameter_QueryInterface( ICompositionEffectSourceParameter *iface, REFIID iid, void **out )
+{
+    struct effect_source_parameter *parameter = impl_from_ICompositionEffectSourceParameter( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_ICompositionEffectSourceParameter ))
+        *out = &parameter->ICompositionEffectSourceParameter_iface;
+    else if (IsEqualGUID( iid, &IID_IGraphicsEffectSource ))
+        *out = &parameter->IGraphicsEffectSource_iface;
+    else
+        return E_NOINTERFACE;
+
+    ICompositionEffectSourceParameter_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI parameter_AddRef( ICompositionEffectSourceParameter *iface )
+{
+    struct effect_source_parameter *parameter = impl_from_ICompositionEffectSourceParameter( iface );
+    return InterlockedIncrement( &parameter->ref );
+}
+
+static ULONG WINAPI parameter_Release( ICompositionEffectSourceParameter *iface )
+{
+    struct effect_source_parameter *parameter = impl_from_ICompositionEffectSourceParameter( iface );
+    ULONG ref = InterlockedDecrement( &parameter->ref );
+
+    if (!ref)
+    {
+        WindowsDeleteString( parameter->name );
+        free( parameter );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI parameter_GetIids( ICompositionEffectSourceParameter *iface, ULONG *iid_count, IID **iids )
+{
+    IID *list;
+
+    if (!iid_count || !iids) return E_POINTER;
+    *iid_count = 0;
+    *iids = NULL;
+    if (!(list = CoTaskMemAlloc( 2 * sizeof(*list) ))) return E_OUTOFMEMORY;
+    list[0] = IID_ICompositionEffectSourceParameter;
+    list[1] = IID_IGraphicsEffectSource;
+    *iids = list;
+    *iid_count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI parameter_GetRuntimeClassName( ICompositionEffectSourceParameter *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Composition_CompositionEffectSourceParameter;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI parameter_GetTrustLevel( ICompositionEffectSourceParameter *iface, TrustLevel *trust_level )
+{
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI parameter_get_Name( ICompositionEffectSourceParameter *iface, HSTRING *value )
+{
+    struct effect_source_parameter *parameter = impl_from_ICompositionEffectSourceParameter( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+    if (!value) return E_POINTER;
+    return WindowsDuplicateString( parameter->name, value );
+}
+
+static const struct ICompositionEffectSourceParameterVtbl parameter_vtbl =
+{
+    parameter_QueryInterface,
+    parameter_AddRef,
+    parameter_Release,
+    parameter_GetIids,
+    parameter_GetRuntimeClassName,
+    parameter_GetTrustLevel,
+    parameter_get_Name,
+};
+
+DEFINE_IINSPECTABLE( parameter_source, IGraphicsEffectSource, struct effect_source_parameter,
+                     ICompositionEffectSourceParameter_iface )
+
+static const struct IGraphicsEffectSourceVtbl parameter_source_vtbl =
+{
+    parameter_source_QueryInterface,
+    parameter_source_AddRef,
+    parameter_source_Release,
+    parameter_source_GetIids,
+    parameter_source_GetRuntimeClassName,
+    parameter_source_GetTrustLevel,
+};
+
+struct effect_source_parameter_factory
+{
+    IActivationFactory IActivationFactory_iface;
+    ICompositionEffectSourceParameterFactory ICompositionEffectSourceParameterFactory_iface;
+};
+
+static inline struct effect_source_parameter_factory *impl_from_IActivationFactory( IActivationFactory *iface )
+{
+    return CONTAINING_RECORD( iface, struct effect_source_parameter_factory, IActivationFactory_iface );
+}
+
+static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID iid, void **out )
+{
+    struct effect_source_parameter_factory *factory = impl_from_IActivationFactory( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+    if (!out) return E_POINTER;
+    *out = NULL;
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IActivationFactory ))
+        *out = &factory->IActivationFactory_iface;
+    else if (IsEqualGUID( iid, &IID_ICompositionEffectSourceParameterFactory ))
+        *out = &factory->ICompositionEffectSourceParameterFactory_iface;
+    else
+        return E_NOINTERFACE;
+
+    IActivationFactory_AddRef( iface );
+    return S_OK;
+}
+
+static ULONG WINAPI factory_AddRef( IActivationFactory *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI factory_Release( IActivationFactory *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI factory_GetIids( IActivationFactory *iface, ULONG *iid_count, IID **iids )
+{
+    IID *list;
+
+    if (!iid_count || !iids) return E_POINTER;
+    *iid_count = 0;
+    *iids = NULL;
+    if (!(list = CoTaskMemAlloc( sizeof(*list) ))) return E_OUTOFMEMORY;
+    *list = IID_ICompositionEffectSourceParameterFactory;
+    *iids = list;
+    *iid_count = 1;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_GetRuntimeClassName( IActivationFactory *iface, HSTRING *class_name )
+{
+    const WCHAR *name = RuntimeClass_Windows_UI_Composition_CompositionEffectSourceParameter;
+    return WindowsCreateString( name, wcslen( name ), class_name );
+}
+
+static HRESULT WINAPI factory_GetTrustLevel( IActivationFactory *iface, TrustLevel *trust_level )
+{
+    if (!trust_level) return E_POINTER;
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI factory_ActivateInstance( IActivationFactory *iface, IInspectable **instance )
+{
+    if (!instance) return E_POINTER;
+    *instance = NULL;
+    return E_NOTIMPL; /* This runtime class requires a name at construction. */
+}
+
+static const struct IActivationFactoryVtbl factory_vtbl =
+{
+    factory_QueryInterface,
+    factory_AddRef,
+    factory_Release,
+    factory_GetIids,
+    factory_GetRuntimeClassName,
+    factory_GetTrustLevel,
+    factory_ActivateInstance,
+};
+
+DEFINE_IINSPECTABLE( parameter_factory, ICompositionEffectSourceParameterFactory,
+                     struct effect_source_parameter_factory, IActivationFactory_iface )
+
+static HRESULT WINAPI parameter_factory_Create( ICompositionEffectSourceParameterFactory *iface,
+                                                  HSTRING name, ICompositionEffectSourceParameter **value )
+{
+    struct effect_source_parameter *parameter;
+    HRESULT hr;
+
+    TRACE( "iface %p, name %s, value %p.\n", iface, debugstr_hstring( name ), value );
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!(parameter = calloc( 1, sizeof(*parameter) ))) return E_OUTOFMEMORY;
+    parameter->ICompositionEffectSourceParameter_iface.lpVtbl = &parameter_vtbl;
+    parameter->IGraphicsEffectSource_iface.lpVtbl = &parameter_source_vtbl;
+    parameter->ref = 1;
+    if (FAILED(hr = WindowsDuplicateString( name, &parameter->name )))
+    {
+        free( parameter );
+        return hr;
+    }
+    *value = &parameter->ICompositionEffectSourceParameter_iface;
+    return S_OK;
+}
+
+static const struct ICompositionEffectSourceParameterFactoryVtbl parameter_factory_vtbl =
+{
+    parameter_factory_QueryInterface,
+    parameter_factory_AddRef,
+    parameter_factory_Release,
+    parameter_factory_GetIids,
+    parameter_factory_GetRuntimeClassName,
+    parameter_factory_GetTrustLevel,
+    parameter_factory_Create,
+};
+
+static struct effect_source_parameter_factory parameter_statics =
+{
+    {&factory_vtbl}, {&parameter_factory_vtbl},
+};
+
+IActivationFactory *effect_source_parameter_factory = &parameter_statics.IActivationFactory_iface;
diff --git a/dlls/dcomp/main.c b/dlls/dcomp/main.c
index d488d9ac470..4cfe2e18cbe 100644
--- a/dlls/dcomp/main.c
+++ b/dlls/dcomp/main.c
@@ -38,6 +38,8 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
         IActivationFactory_QueryInterface( compositor_controller_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Compositor ))
         IActivationFactory_QueryInterface( compositor_factory, &IID_IActivationFactory, (void **)factory );
+    else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_CompositionEffectSourceParameter ))
+        IActivationFactory_QueryInterface( effect_source_parameter_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Interactions_VisualInteractionSource ))
         IActivationFactory_QueryInterface( interaction_source_factory, &IID_IActivationFactory, (void **)factory );
     else if (!wcscmp( name, RuntimeClass_Windows_UI_Composition_Interactions_InteractionTracker ))
diff --git a/dlls/dcomp/private.h b/dlls/dcomp/private.h
index 011cc184b2e..fb723381c9f 100644
--- a/dlls/dcomp/private.h
+++ b/dlls/dcomp/private.h
@@ -101,6 +101,7 @@
 
 extern IActivationFactory *compositor_controller_factory;
 extern IActivationFactory *compositor_factory;
+extern IActivationFactory *effect_source_parameter_factory;
 
 struct compositor;
 struct object;
diff --git a/dlls/dcomp/tests/composition.c b/dlls/dcomp/tests/composition.c
index 9cc19388510..79d731f9824 100644
--- a/dlls/dcomp/tests/composition.c
+++ b/dlls/dcomp/tests/composition.c
@@ -171,6 +171,51 @@ static void test_activation(void)
     CloseHandle( thread );
 }
 
+static void test_effect_source_parameter(void)
+{
+    static const WCHAR name[] = L"PowerPointEffectSource";
+    ICompositionEffectSourceParameterFactory *factory = NULL;
+    ICompositionEffectSourceParameter *parameter = NULL;
+    IGraphicsEffectSource *source = NULL;
+    IActivationFactory *activation = NULL;
+    HSTRING class_name, value = NULL, input;
+    HRESULT hr;
+
+    class_name = hstring( RuntimeClass_Windows_UI_Composition_CompositionEffectSourceParameter );
+    hr = RoGetActivationFactory( class_name, &IID_ICompositionEffectSourceParameterFactory, (void **)&factory );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    WindowsDeleteString( class_name );
+    if (!factory) return;
+
+    hr = ICompositionEffectSourceParameterFactory_QueryInterface( factory, &IID_IActivationFactory,
+                                                                   (void **)&activation );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (activation)
+    {
+        check_class( activation, RuntimeClass_Windows_UI_Composition_CompositionEffectSourceParameter );
+        IActivationFactory_Release( activation );
+    }
+
+    input = hstring( name );
+    hr = ICompositionEffectSourceParameterFactory_Create( factory, input, &parameter );
+    ok( hr == S_OK && !!parameter, "got hr %#lx, parameter %p.\n", hr, parameter );
+    WindowsDeleteString( input );
+    if (parameter)
+    {
+        check_class( parameter, RuntimeClass_Windows_UI_Composition_CompositionEffectSourceParameter );
+        hr = ICompositionEffectSourceParameter_get_Name( parameter, &value );
+        ok( hr == S_OK && value && !wcscmp( WindowsGetStringRawBuffer( value, NULL ), name ),
+            "got hr %#lx, name %s.\n", hr, debugstr_hstring( value ) );
+        WindowsDeleteString( value );
+        hr = ICompositionEffectSourceParameter_QueryInterface( parameter, &IID_IGraphicsEffectSource,
+                                                                (void **)&source );
+        ok( hr == S_OK && !!source, "got hr %#lx, source %p.\n", hr, source );
+        if (source) IGraphicsEffectSource_Release( source );
+        ICompositionEffectSourceParameter_Release( parameter );
+    }
+    ICompositionEffectSourceParameterFactory_Release( factory );
+}
+
 /*** CommitNeeded ***/
 
 struct commit_needed
@@ -2048,6 +2093,7 @@ START_TEST(composition)
     test_activation();
 
     RoInitialize( RO_INIT_SINGLETHREADED );
+    test_effect_source_parameter();
     queue = create_queue( DQTAT_COM_STA );
     test_compositor();
     if (queue) IDispatcherQueueController_Release( queue );
