index 00000000000..c8df51fb017
--- /dev/null
+++ b/dlls/dcomp/effect_source.c
@@ -0,0 +1,256 @@
+/*
+ * Windows.UI.Composition.CompositionEffectSourceParameter
+ *
+ * Copyright 2026 AltarsCN
