+/* a lock asked for on a handle for overlapped I/O that has to wait: the request completes when it is granted */
+struct pending_lock
+{
+    struct list         entry;       /* entry in the inode's list of pending locks */
+    struct async       *async;       /* the request */
+    struct fd          *fd;          /* fd the lock is for */
+    struct process     *process;     /* process asking for it */
+    int                 shared;      /* shared lock? */
+    file_pos_t          start;       /* region to lock is interval [start;end) */
+    file_pos_t          end;
+    struct timeout_user *retry;      /* to look again while a lock outside Wine is in the way */
+};
+
+static void grant_pending_locks( struct inode *inode );
+
+/* the lock someone holds that a lock of the region would conflict with */
+static struct file_lock *find_conflicting_lock( struct fd *fd, file_pos_t start, file_pos_t end, int shared )
+{
+    struct file_lock *lock;
+
+    LIST_FOR_EACH_ENTRY( lock, &fd->inode->locks, struct file_lock, inode_entry )
+    {
+        if (!lock_overlaps( lock, start, end )) continue;
+        if (shared && (lock->shared || lock->fd == fd)) continue;
+        return lock;
+    }
+    return NULL;
+}
+
 /* create a new lock on a fd */
-static struct file_lock *add_lock( struct fd *fd, int shared, file_pos_t start, file_pos_t end )
+static struct file_lock *add_lock( struct fd *fd, int shared, file_pos_t start, file_pos_t end,
+                                   struct process *process )
 {
     struct file_lock *lock;
 
@@ -1394,7 +1426,7 @@ static struct file_lock *add_lock( struct fd *fd, int shared, file_pos_t start,
     lock->start   = start;
     lock->end     = end;
     lock->fd      = fd;
-    lock->process = current->process;
+    lock->process = process;
 
     if (!(lock->sync = create_internal_sync( 1, 0 ))) goto error;
     /* now try to set a Unix lock */
@@ -1418,10 +1450,99 @@ static void remove_lock( struct file_lock *lock, int remove_unix )
     list_remove( &lock->inode_entry );
     list_remove( &lock->proc_entry );
     if (remove_unix) remove_unix_locks( lock->fd, lock->start, lock->end );
-    if (list_empty( &inode->locks )) inode_close_pending( inode, 1 );
     lock->process = NULL;
     signal_sync( lock->sync );
     release_object( lock );
+    grant_pending_locks( inode );
+    if (list_empty( &inode->locks )) inode_close_pending( inode, 1 );
+}
+
+/* a pending lock's request completed, whether granted, cancelled or given up */
+static void pending_lock_completed( void *private )
+{
+    struct pending_lock *pending = private;
+
+    if (pending->retry) remove_timeout_user( pending->retry );
+    list_remove( &pending->entry );
+    release_object( pending->process );
+    release_object( pending->async );
+    free( pending );
+}
+
+static void retry_pending_locks( void *private )
+{
+    struct pending_lock *pending = private;
+
+    pending->retry = NULL;
+    grant_pending_locks( pending->fd->inode );
+}
+
+/* grant the locks waiting on the inode that nothing is in the way of any more, in the order asked for */
+static void grant_pending_locks( struct inode *inode )
+{
+    struct pending_lock *pending, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( pending, next, &inode->pending_locks, struct pending_lock, entry )
+    {
+        struct iosb *iosb = async_get_iosb( pending->async );
+        int waiting = iosb->status == STATUS_PENDING;
+
+        release_object( iosb );
+        if (!waiting) continue;  /* cancelled: its completion takes it off the list */
+        if (find_conflicting_lock( pending->fd, pending->start, pending->end, pending->shared )) continue;
+        if (!add_lock( pending->fd, pending->shared, pending->start, pending->end, pending->process ))
