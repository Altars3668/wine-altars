From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 08:02:52 -0400
Subject: [PATCH] server, ntdll, kernelbase: Complete a lock as any I/O, and
 grant one that waits when the lock in its way goes.

NtLockFile refused a status block, an APC or a completion port, set the
event only on success, and a lock on a handle for overlapped I/O that had
to wait returned STATUS_PENDING and was then forgotten: it was never
granted, and nothing ever completed it.  LockFileEx passed no status block,
so its OVERLAPPED was never written.

Measured on Windows (tools/fileinfoprobe/lockiocp in the outer tree), a
lock granted or refused at once writes the status block (the OVERLAPPED;
STATUS_LOCK_NOT_GRANTED for a refusal, Information 0), sets the event, and
posts a completion packet, a refusal too, unless the handle skips the port
for what did not wait, refusals included.  One that has to wait returns
STATUS_PENDING with Internal STATUS_PENDING and InternalHigh untouched, and
completes when the lock in its way is unlocked or its handle closed
(STATUS_SUCCESS), when it is cancelled (STATUS_CANCELLED), or when its own
handle's last handle is closed (STATUS_RANGE_NOT_LOCKED), each time with
the event and a packet.  NtLockFile without a status block fails with
STATUS_ACCESS_VIOLATION before locking anything.

The lock_file request now carries the async parameters, with the count as
data for lack of room.  The server queues a lock that has to wait on a
handle for overlapped I/O as a request async on the inode, and grants the
queued locks in order whenever a lock of the inode goes; while a Unix lock
outside Wine is in the way, it looks again every 100 ms, as a client
waiting on a handle without overlapped I/O does.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 6057e5fef97aa2e06220cc8bf745248b3fcc561e)

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 140c9e3d4e3..515af04148c 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -2328,6 +2328,13 @@ static void test_LockFile(void)
     ok( iosb.Status == status, "got %lu.\n", iosb.Status);
     ok( !iosb.Information, "got %Iu.\n", iosb.Information);
 
+    /* no status block, nothing locked */
+    count.QuadPart = 1;
+    status = NtLockFile( handle, NULL, NULL, NULL, NULL, &offset, &count, NULL, TRUE, TRUE );
+    ok( status == STATUS_ACCESS_VIOLATION, "got %#lx.\n", status );
+    ok( LockFile( handle2, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+    ok( UnlockFile( handle2, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+
     ok( WriteFile( handle, sillytext, strlen(sillytext), &written, NULL ), "write failed\n" );
 
     ok( LockFile( handle, 0, 0, 0, 0 ), "LockFile failed\n" );
@@ -2451,6 +2458,160 @@ cleanup:
     DeleteFileA( filename );
 }
 
+#define check_lock_packet(a,b,c) check_lock_packet_(__LINE__,a,b,c)
+static void check_lock_packet_( unsigned int line, HANDLE port, OVERLAPPED *expect, DWORD error )
+{
+    OVERLAPPED *ov = NULL;
+    ULONG_PTR key = 0;
+    DWORD size = 0xdeadbeef;
+    BOOL ret;
+
+    SetLastError( 0xdeadbeef );
+    ret = GetQueuedCompletionStatus( port, &size, &key, &ov, 0 );
+    if (!expect)
+    {
+        ok_(__FILE__, line)( !ret && !ov && GetLastError() == WAIT_TIMEOUT, "got a packet, ret %d, error %lu, ov %p.\n",
+                             ret, GetLastError(), ov );
+        return;
+    }
+    ok_(__FILE__, line)( ov == expect, "got ov %p, error %lu.\n", ov, GetLastError() );
+    ok_(__FILE__, line)( ret == !error, "got ret %d.\n", ret );
+    if (error) ok_(__FILE__, line)( GetLastError() == error, "got error %lu.\n", GetLastError() );
+    ok_(__FILE__, line)( key == 0x1234, "got key %#Ix.\n", key );
+    ok_(__FILE__, line)( !size, "got size %lu.\n", size );
+}
+
+#define lock_overlapped(a,b,c,d) lock_overlapped_(__LINE__,a,b,c,d)
+static BOOL lock_overlapped_( unsigned int line, HANDLE file, DWORD flags, OVERLAPPED *ov, HANDLE event )
+{
+    ResetEvent( event );
+    memset( ov, 0x55, sizeof(*ov) );
+    ov->Offset = ov->OffsetHigh = 0;
+    ov->hEvent = event;
+    SetLastError( 0xdeadbeef );
+    return LockFileEx( file, flags, 0, 1, 0, ov );
+}
+
+/* a lock of a handle for overlapped I/O completes as any I/O does: its status block, its event, and a completion
+ * port; one that has to wait completes when it is granted, cancelled, or its handle closed */
+static void test_LockFile_overlapped(void)
+{
+    HANDLE file, other, holder, port, event;
+    ULONG_PTR pattern;
+    OVERLAPPED ov;
+    BOOL ret;
+
+    file = CreateFileA( filename, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                        CREATE_ALWAYS, FILE_FLAG_OVERLAPPED, 0 );
+    ok( file != INVALID_HANDLE_VALUE, "got error %lu.\n", GetLastError() );
+    other = CreateFileA( filename, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                         OPEN_EXISTING, 0, 0 );
+    ok( other != INVALID_HANDLE_VALUE, "got error %lu.\n", GetLastError() );
+    port = CreateIoCompletionPort( file, NULL, 0x1234, 0 );
+    ok( !!port, "got error %lu.\n", GetLastError() );
+    event = CreateEventA( NULL, TRUE, FALSE, NULL );
+    memset( &pattern, 0x55, sizeof(pattern) );
+
+    ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK, &ov, event );
+    ok( ret, "got error %lu.\n", GetLastError() );
+    ok( (NTSTATUS)ov.Internal == STATUS_SUCCESS, "got status %#Ix.\n", ov.Internal );
+    ok( !ov.InternalHigh, "got information %#Ix.\n", ov.InternalHigh );
+    ok( !WaitForSingleObject( event, 0 ), "event not set.\n" );
+    check_lock_packet( port, &ov, 0 );
+    ok( UnlockFile( file, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+
+    ok( LockFile( other, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+    ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY, &ov, event );
+    ok( !ret && GetLastError() == ERROR_LOCK_VIOLATION, "got ret %d, error %lu.\n", ret, GetLastError() );
+    ok( (NTSTATUS)ov.Internal == STATUS_LOCK_NOT_GRANTED, "got status %#Ix.\n", ov.Internal );
+    ok( !ov.InternalHigh, "got information %#Ix.\n", ov.InternalHigh );
+    ok( !WaitForSingleObject( event, 0 ), "event not set.\n" );
+    check_lock_packet( port, &ov, ERROR_LOCK_VIOLATION );
+
+    ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK, &ov, event );
+    ok( !ret && GetLastError() == ERROR_IO_PENDING, "got ret %d, error %lu.\n", ret, GetLastError() );
+    ok( (NTSTATUS)ov.Internal == STATUS_PENDING, "got status %#Ix.\n", ov.Internal );
+    ok( ov.InternalHigh == pattern, "got information %#Ix.\n", ov.InternalHigh );
+    ok( WaitForSingleObject( event, 0 ) == WAIT_TIMEOUT, "event set.\n" );
+    check_lock_packet( port, NULL, 0 );
+    ok( UnlockFile( other, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+    ok( !WaitForSingleObject( event, 1000 ), "event not set.\n" );
+    ok( (NTSTATUS)ov.Internal == STATUS_SUCCESS, "got status %#Ix.\n", ov.Internal );
+    ok( !ov.InternalHigh, "got information %#Ix.\n", ov.InternalHigh );
+    check_lock_packet( port, &ov, 0 );
+    ok( !LockFile( other, 0, 0, 1, 0 ), "the waiting lock was not granted.\n" );
+    ok( UnlockFile( file, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+
+    ok( LockFile( other, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+    ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK, &ov, event );
+    ok( !ret && GetLastError() == ERROR_IO_PENDING, "got ret %d, error %lu.\n", ret, GetLastError() );
+    ok( CancelIoEx( file, &ov ), "got error %lu.\n", GetLastError() );
+    ok( !WaitForSingleObject( event, 1000 ), "event not set.\n" );
+    ok( (NTSTATUS)ov.Internal == STATUS_CANCELLED, "got status %#Ix.\n", ov.Internal );
+    ok( !ov.InternalHigh, "got information %#Ix.\n", ov.InternalHigh );
+    check_lock_packet( port, &ov, ERROR_OPERATION_ABORTED );
+    ok( UnlockFile( other, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+    ok( !UnlockFile( file, 0, 0, 1, 0 ), "the cancelled lock was granted.\n" );
+
+    /* the handle whose lock is in the way closed */
+    holder = CreateFileA( filename, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, NULL,
+                          OPEN_EXISTING, 0, 0 );
+    ok( holder != INVALID_HANDLE_VALUE, "got error %lu.\n", GetLastError() );
+    ok( LockFile( holder, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+    ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK, &ov, event );
+    ok( !ret && GetLastError() == ERROR_IO_PENDING, "got ret %d, error %lu.\n", ret, GetLastError() );
+    CloseHandle( holder );
+    ok( !WaitForSingleObject( event, 1000 ), "event not set.\n" );
+    ok( (NTSTATUS)ov.Internal == STATUS_SUCCESS, "got status %#Ix.\n", ov.Internal );
+    check_lock_packet( port, &ov, 0 );
+    ok( UnlockFile( file, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+
+    if (pSetFileCompletionNotificationModes)
+    {
+        /* what does not wait posts nothing, a refusal as little as a lock granted */
+        ret = pSetFileCompletionNotificationModes( file, FILE_SKIP_COMPLETION_PORT_ON_SUCCESS );
+        ok( ret, "got error %lu.\n", GetLastError() );
+        ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK, &ov, event );
+        ok( ret, "got error %lu.\n", GetLastError() );
+        ok( (NTSTATUS)ov.Internal == STATUS_SUCCESS, "got status %#Ix.\n", ov.Internal );
+        ok( !WaitForSingleObject( event, 0 ), "event not set.\n" );
+        check_lock_packet( port, NULL, 0 );
+        ok( UnlockFile( file, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+
+        ok( LockFile( other, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+        ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK | LOCKFILE_FAIL_IMMEDIATELY, &ov, event );
+        ok( !ret && GetLastError() == ERROR_LOCK_VIOLATION, "got ret %d, error %lu.\n", ret, GetLastError() );
+        ok( (NTSTATUS)ov.Internal == STATUS_LOCK_NOT_GRANTED, "got status %#Ix.\n", ov.Internal );
+        ok( !WaitForSingleObject( event, 0 ), "event not set.\n" );
+        check_lock_packet( port, NULL, 0 );
+
+        ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK, &ov, event );
+        ok( !ret && GetLastError() == ERROR_IO_PENDING, "got ret %d, error %lu.\n", ret, GetLastError() );
+        ok( UnlockFile( other, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+        ok( !WaitForSingleObject( event, 1000 ), "event not set.\n" );
+        ok( (NTSTATUS)ov.Internal == STATUS_SUCCESS, "got status %#Ix.\n", ov.Internal );
+        check_lock_packet( port, &ov, 0 );
+        ok( UnlockFile( file, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+    }
+    else win_skip( "SetFileCompletionNotificationModes not available.\n" );
+
+    /* a lock still waiting when the handle is closed is not granted */
+    ok( LockFile( other, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+    ret = lock_overlapped( file, LOCKFILE_EXCLUSIVE_LOCK, &ov, event );
+    ok( !ret && GetLastError() == ERROR_IO_PENDING, "got ret %d, error %lu.\n", ret, GetLastError() );
+    CloseHandle( file );
+    ok( !WaitForSingleObject( event, 1000 ), "event not set.\n" );
+    ok( (NTSTATUS)ov.Internal == STATUS_RANGE_NOT_LOCKED, "got status %#Ix.\n", ov.Internal );
+    ok( !ov.InternalHigh, "got information %#Ix.\n", ov.InternalHigh );
+    check_lock_packet( port, &ov, ERROR_NOT_LOCKED );
+    ok( UnlockFile( other, 0, 0, 1, 0 ), "got error %lu.\n", GetLastError() );
+
+    CloseHandle( other );
+    CloseHandle( port );
+    CloseHandle( event );
+    DeleteFileA( filename );
+}
+
 static BOOL create_fake_dll( LPCSTR filename )
 {
     IMAGE_DOS_HEADER *dos;
@@ -7154,6 +7315,7 @@ START_TEST(file)
     test_FindFirstFileExA(FindExInfoStandard, FindExSearchLimitToDirectories, FIND_FIRST_EX_LARGE_FETCH);
     test_FindFirstFileExA(FindExInfoBasic, FindExSearchLimitToDirectories, 0);
     test_LockFile();
+    test_LockFile_overlapped();
     test_file_sharing();
     test_offset_in_overlapped_structure();
     test_MapFile();
