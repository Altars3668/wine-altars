From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 08:55:52 -0400
Subject: [PATCH] vbscript: Give an object a site also when the host is no
 service provider.

CreateObject() handed an object with IObjectWithSite a site that forwards
to the host's IServiceProvider, and failed the call when the host has
none.  Wine's cscript has none, so not even Msxml2.DOMDocument.6.0 could
be created from a script.  The site now offers no services then, as
jscript's already does, and it releases the host's service provider when
it goes away.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/vbscript/tests/createobj.c b/dlls/vbscript/tests/createobj.c
index 7065b5b9c81..b972c10832b 100644
--- a/dlls/vbscript/tests/createobj.c
+++ b/dlls/vbscript/tests/createobj.c
@@ -132,9 +132,12 @@ static ULONG WINAPI ObjectWithSite_Release(IObjectWithSite *iface)
     return 1;
 }
 
+static BOOL host_is_service_provider = TRUE;
+
 static HRESULT WINAPI ObjectWithSite_SetSite(IObjectWithSite *iface, IUnknown *pUnkSite)
 {
     IServiceProvider *sp;
+    IUnknown *service;
     HRESULT hres;
 
 
@@ -143,6 +146,13 @@ static HRESULT WINAPI ObjectWithSite_SetSite(IObjectWithSite *iface, IUnknown *p
 
     hres = IUnknown_QueryInterface(pUnkSite, &IID_IServiceProvider, (void**)&sp);
     ok(hres == S_OK, "Could not get IServiceProvider iface: %08lx\n", hres);
+    if(!host_is_service_provider) {
+        service = (void *)0xdeadbeef;
+        hres = IServiceProvider_QueryService(sp, &SID_SInternetHostSecurityManager,
+                &IID_IInternetHostSecurityManager, (void **)&service);
+        ok(FAILED(hres), "QueryService returned %08lx\n", hres);
+        ok(!service, "service = %p\n", service);
+    }
     IServiceProvider_Release(sp);
 
     return SetSite_hres;
@@ -564,7 +574,7 @@ static HRESULT WINAPI ActiveScriptSite_QueryInterface(IActiveScriptSite *iface,
         *ppv = iface;
     }else if(IsEqualGUID(&IID_IActiveScriptSite, riid)) {
         *ppv = iface;
-    }else if(IsEqualGUID(&IID_IServiceProvider, riid)) {
+    }else if(IsEqualGUID(&IID_IServiceProvider, riid) && host_is_service_provider) {
         *ppv = &ServiceProvider;
     }else {
         *ppv = NULL;
@@ -946,6 +956,24 @@ static void test_CreateObject(void)
     CHECK_CALLED(SetSite);
 
     IActiveScriptParse_Release(parser);
+
+    /* a host that is no service provider, as cscript is: the object still gets a site */
+    SetSite_hres = S_OK;
+    host_is_service_provider = FALSE;
+    parser = create_script(FALSE);
+
+    SET_EXPECT(CreateInstance);
+    SET_EXPECT(QI_IObjectWithSite);
+    SET_EXPECT(SetSite);
+    SET_EXPECT(reportSuccess);
+    parse_script(parser, L"Call CreateObject(\"Wine.Test\").reportSuccess()");
+    CHECK_CALLED(CreateInstance);
+    CHECK_CALLED(QI_IObjectWithSite);
+    CHECK_CALLED(SetSite);
+    CHECK_CALLED(reportSuccess);
+
+    IActiveScriptParse_Release(parser);
+    host_is_service_provider = TRUE;
 }
 
 static void test_GetObject(void)
diff --git a/dlls/vbscript/vbscript.c b/dlls/vbscript/vbscript.c
index 9a42f7009bd..fcf8ebd868a 100644
--- a/dlls/vbscript/vbscript.c
+++ b/dlls/vbscript/vbscript.c
@@ -1447,8 +1447,11 @@ static ULONG WINAPI AXSite_Release(IServiceProvider *iface)
 
     TRACE("(%p) ref=%ld\n", This, ref);
 
-    if(!ref)
+    if(!ref) {
+        if(This->sp)
+            IServiceProvider_Release(This->sp);
         free(This);
+    }
 
     return ref;
 }
@@ -1460,6 +1463,11 @@ static HRESULT WINAPI AXSite_QueryService(IServiceProvider *iface,
 
     TRACE("(%p)->(%s %s %p)\n", This, debugstr_guid(guidService), debugstr_guid(riid), ppv);
 
+    if(!This->sp) {
+        *ppv = NULL;
+        return E_NOINTERFACE;
+    }
+
     return IServiceProvider_QueryService(This->sp, guidService, riid, ppv);
 }
 
@@ -1472,19 +1480,19 @@ static IServiceProviderVtbl AXSiteVtbl = {
 
 IUnknown *create_ax_site(script_ctx_t *ctx)
 {
-    IServiceProvider *sp;
+    IServiceProvider *sp = NULL;
     AXSite *ret;
     HRESULT hres;
 
+    /* a host that is no service provider still gives the object a site, one that offers nothing */
     hres = IActiveScriptSite_QueryInterface(ctx->site, &IID_IServiceProvider, (void**)&sp);
-    if(FAILED(hres)) {
-        ERR("Could not get IServiceProvider iface: %08lx\n", hres);
-        return NULL;
-    }
+    if(FAILED(hres))
+        TRACE("Could not get IServiceProvider iface: %08lx\n", hres);
 
     ret = malloc(sizeof(*ret));
     if(!ret) {
-        IServiceProvider_Release(sp);
+        if(sp)
+            IServiceProvider_Release(sp);
         return NULL;
     }
 
