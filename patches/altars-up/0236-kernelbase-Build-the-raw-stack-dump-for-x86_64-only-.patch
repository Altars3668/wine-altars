From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 20:21:42 -0400
Subject: [PATCH] kernelbase: Build the raw stack dump for x86_64 only, where
 it is called.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 606e8b8ddc6197289fb6b9e9d0554d143fe190df)

diff --git a/dlls/kernelbase/debug.c b/dlls/kernelbase/debug.c
index a3466220ce4..5cfeef8fb63 100644
--- a/dlls/kernelbase/debug.c
+++ b/dlls/kernelbase/debug.c
@@ -562,9 +562,9 @@ static void dump_registers( const EXCEPTION_POINTERS *ptr )
  * value is not a code address at all, the interesting part is the raw words
  * around it and what sits next to them.
  */
+#ifdef __x86_64__
 static void dump_stack_raw( const EXCEPTION_POINTERS *ptr )
 {
-#ifdef __x86_64__
     const NT_TIB *tib = (const NT_TIB *)NtCurrentTeb();
     const ULONG_PTR *sp;
     int i;
@@ -576,8 +576,8 @@ static void dump_stack_raw( const EXCEPTION_POINTERS *ptr )
     MESSAGE( "wine: stack words at the fault:\n" );
     for (i = 0; i < 32 && sp + i + 1 < (const ULONG_PTR *)tib->StackBase; i += 2)
         MESSAGE( "wine:   rsp+0x%02x: %p %p\n", i * 8, (void *)sp[i], (void *)sp[i + 1] );
-#endif
 }
+#endif
 
 static void dump_stack_scan( const EXCEPTION_POINTERS *ptr )
 {
