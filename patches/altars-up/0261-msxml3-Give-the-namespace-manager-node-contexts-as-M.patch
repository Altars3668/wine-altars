+    /* first allocated prefix is always 'xml' */
+    ctxt->ns[0].prefix = SysAllocString(L"xml");
+    ctxt->ns[0].uri = SysAllocString(xml_uri);
+    ctxt->count++;
+    if (!ctxt->ns[0].prefix || !ctxt->ns[0].uri)
