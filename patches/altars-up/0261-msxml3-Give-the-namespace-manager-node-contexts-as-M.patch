 {
     struct domnode *n, *next;
@@ -3366,6 +3390,79 @@ HRESULT node_select_singlenode(struct domnode *node, BSTR query, IXMLDOMNode **r
     return hr;
 }
 
+static HRESULT report_name_binding(struct domnode *node, namespace_binding_callback callback, void *ctx)
+{
+    return callback(ctx, node->prefix ? node->prefix : L"", node->uri && *node->uri ? node->uri : NULL);
+}
+
+static HRESULT report_element_bindings(struct domnode *node, namespace_binding_callback callback, void *ctx)
+{
+    struct domnode *attr;
+    HRESULT hr;
+    BSTR uri;
+
+    if (FAILED(hr = report_name_binding(node, callback, ctx))) return hr;
+
+    LIST_FOR_EACH_ENTRY(attr, &node->attributes, struct domnode, entry)
+    {
+        if (!domnode_is_namespace_declaration(attr)) continue;
+        if (FAILED(hr = node_get_text(attr, &uri))) return hr;
+        hr = callback(ctx, !wcscmp(attr->qname, L"xmlns") ? L"" : attr->name,
+                uri && *uri ? uri : NULL);
+        SysFreeString(uri);
+        if (FAILED(hr)) return hr;
+    }
+
+    return S_OK;
+}
+
+HRESULT node_get_namespace_bindings(IXMLDOMNode *iface, BOOL deep, namespace_binding_callback callback, void *ctx)
+{
+    struct domnode *node;
+    HRESULT hr = S_OK;
+
+    if (!iface || !(node = get_node_obj(iface))) return E_INVALIDARG;
+
+    switch (node->type)
+    {
+        case NODE_ELEMENT:
+            hr = report_element_bindings(node, callback, ctx);
+            break;
+        case NODE_ATTRIBUTE:
+        case NODE_PROCESSING_INSTRUCTION:
+            hr = report_name_binding(node, callback, ctx);
+            break;
+        default:
+            break;
+    }
+
+    if (!deep) return hr;
+
+    for (node = node->parent; node && SUCCEEDED(hr); node = node->parent)
+        if (node->type == NODE_ELEMENT)
+            hr = report_element_bindings(node, callback, ctx);
+
+    return hr;
+}
+
+HRESULT node_lookup_namespace(IXMLDOMNode *iface, const WCHAR *prefix, BSTR *uri)
+{
+    struct domnode *node;
+    HRESULT hr;
+
+    if (!iface || !(node = get_node_obj(iface))) return E_INVALIDARG;
+    if (!uri) return E_POINTER;
+
+    hr = domnode_lookup_namespace_uri(node, prefix, uri);
+    if (hr == S_FALSE) return S_OK;
+    if (SUCCEEDED(hr) && *uri && !**uri)
+    {
+        SysFreeString(*uri);
+        *uri = NULL;
+    }
+    return hr;
+}
