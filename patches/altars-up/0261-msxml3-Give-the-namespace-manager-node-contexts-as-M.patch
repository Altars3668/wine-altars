diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index 709f3a7a60f..cfa44500a14 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -566,6 +566,30 @@ static void domnode_add_refs(struct domnode *node, unsigned int count)
     }
 }
 
+static HRESULT domnode_lookup_namespace_uri(struct domnode *node, const WCHAR *prefix, BSTR *uri)
+{
+    struct domnode *attr;
+
+    *uri = NULL;
+    for (; node; node = node->parent)
+    {
+        if (node->type != NODE_ELEMENT) continue;
+
+        LIST_FOR_EACH_ENTRY(attr, &node->attributes, struct domnode, entry)
+        {
+            if (prefix && *prefix)
+            {
+                if (attr->prefix && !wcscmp(attr->prefix, L"xmlns") && !wcscmp(attr->name, prefix))
+                    return node_get_text(attr, uri);
+            }
+            else if (!wcscmp(attr->qname, L"xmlns"))
+                return node_get_text(attr, uri);
+        }
+    }
+
+    return S_FALSE;
+}
+
