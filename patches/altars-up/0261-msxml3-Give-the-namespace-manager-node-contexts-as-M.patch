+static HRESULT push_node_binding(void *ctx, const WCHAR *prefix, const WCHAR *uri)
+{
+    struct nscontext *ctxt = ctx;
+
+    /* the binding nearest to the node wins */
+    if (find_prefix(ctxt, prefix)) return S_OK;
+    return add_prefix(ctxt, prefix, uri);
+}
