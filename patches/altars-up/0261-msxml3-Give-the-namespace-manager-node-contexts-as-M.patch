+static void test_mxnamespace_node_context(void)
+{
+    IXMLDOMDocument2 *doc;
+    IXMLDOMElement *root;
+    IMXNamespaceManager *manager;
+    IXMLDOMNode *inner;
+    VARIANT_BOOL loaded;
+    WCHAR uri[64];
+    HRESULT hr;
+    int length;
+
+    if (!is_clsid_supported(&CLSID_DOMDocument60, &IID_IXMLDOMDocument2)) return;
+
+    doc = create_document_version(60, &IID_IXMLDOMDocument2);
+    hr = IXMLDOMDocument2_loadXML(doc, _bstr_("<outer xmlns:psk='urn:outer'><inner xmlns:psk='urn:inner'/></outer>"), &loaded);
+    ok(hr == S_OK && loaded == VARIANT_TRUE, "Unexpected load %#lx, %d.\n", hr, loaded);
+    hr = IXMLDOMDocument2_get_documentElement(doc, &root);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMElement_get_firstChild(root, &inner);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = CoCreateInstance(&CLSID_MXNamespaceManager40, NULL, CLSCTX_INPROC_SERVER,
+            &IID_IMXNamespaceManager, (void **)&manager);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    hr = IMXNamespaceManager_pushNodeContext(manager, inner, VARIANT_TRUE);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    length = ARRAY_SIZE(uri);
+    hr = IMXNamespaceManager_getURI(manager, L"psk", NULL, uri, &length);
+    ok(hr == S_OK && !wcscmp(uri, L"urn:inner"), "Unexpected URI %#lx, %s.\n", hr, debugstr_w(uri));
+    length = ARRAY_SIZE(uri);
+    hr = IMXNamespaceManager_getURI(manager, L"psk", (IXMLDOMNode *)root, uri, &length);
+    ok(hr == S_OK && !wcscmp(uri, L"urn:outer"), "Unexpected node URI %#lx, %s.\n", hr, debugstr_w(uri));
+    length = wcslen(L"urn:inner");
+    hr = IMXNamespaceManager_getURI(manager, L"psk", NULL, uri, &length);
+    ok(hr == E_XML_BUFFERTOOSMALL, "Unexpected hr %#lx.\n", hr);
+
+    hr = IMXNamespaceManager_popContext(manager);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    length = ARRAY_SIZE(uri);
+    hr = IMXNamespaceManager_getURI(manager, L"psk", NULL, uri, &length);
+    ok(hr == S_FALSE && !length, "Unexpected URI %#lx, length %d.\n", hr, length);
+    hr = IMXNamespaceManager_reset(manager);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    length = ARRAY_SIZE(uri);
+    hr = IMXNamespaceManager_getURI(manager, L"xml", NULL, uri, &length);
+    ok(hr == S_OK && !wcscmp(uri, L"http://www.w3.org/XML/1998/namespace"),
+            "Unexpected URI %#lx, %s.\n", hr, debugstr_w(uri));
+
+    IMXNamespaceManager_Release(manager);
+    IXMLDOMNode_Release(inner);
+    IXMLDOMElement_Release(root);
+    IXMLDOMDocument2_Release(doc);
+    free_bstrs();
+}
