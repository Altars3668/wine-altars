+
+    if (!node) return E_INVALIDARG;
+
+    if (!(ctxt = alloc_ns_context())) return E_OUTOFMEMORY;
+
+    if (FAILED(hr = node_get_namespace_bindings(node, !!deep, push_node_binding, ctxt)))
+    {
