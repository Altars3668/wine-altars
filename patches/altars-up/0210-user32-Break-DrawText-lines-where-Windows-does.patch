From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 10:48:46 -0400
Subject: [PATCH] user32: Break DrawText lines where Windows does.

DrawText broke a line at the white space of the line breaking algorithm,
and at any break that algorithm allows where the text stopped fitting.
Windows breaks at spaces, tabs and ideographic spaces, dropping the one at
the break, and next to East Asian wide characters, but not before the
punctuation that may not start a line nor after the single guillemets;
not at a no-break space, a vertical tab, an en space or a zero-width
space, nor after a hyphen, and it lets an opening bracket end a line and
the prolonged sound mark or a small kana start one.

The existing uiLengthDrawn test only passed because a tab was as wide as
the font's default glyph; a tab takes no room on Windows, and with that a
line broke before the word the tab ends instead of after the tab.  The
characters that may not start a line are those measured on a Chinese
(PRC) Windows; the new test checks the rules there and here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit b0d674aa53dc039d99d4877c61d8a5090258664c)

diff --git a/dlls/user32/tests/text.c b/dlls/user32/tests/text.c
index 73c37d7456f..3569643e1e7 100644
--- a/dlls/user32/tests/text.c
+++ b/dlls/user32/tests/text.c
@@ -726,6 +726,82 @@ static void strfmt( const char *str, char *strout)
 } \
 
 
+/* the number of characters DrawText uses for the first line, where str just fits up to its fit_chars-th character */
+static UINT first_line_length( HDC hdc, const WCHAR *str, int fit_chars, UINT flags )
+{
+    DRAWTEXTPARAMS dtp = { sizeof(dtp) };
+    TEXTMETRICW tm;
+    INT extents[32];
+    SIZE size;
+    RECT rect;
+
+    GetTextMetricsW( hdc, &tm );
+    GetTextExtentExPointW( hdc, str, lstrlenW( str ), 0, NULL, extents, &size );
+    SetRect( &rect, 0, 0, extents[fit_chars - 1], tm.tmHeight );
+    DrawTextExW( hdc, (WCHAR *)str, -1, &rect, flags | DT_WORDBREAK | DT_NOPREFIX | DT_EDITCONTROL, &dtp );
+    return dtp.uiLengthDrawn;
+}
+
+static void test_DrawText_breaks(void)
+{
+    static const struct
+    {
+        const WCHAR *str;
+        int fit_chars;
+        UINT length;
+    }
+    tests[] =
+    {
+        /* a line breaks after spaces and tabs, dropping the one at the break */
+        { L"Hello World wide", 8, 6 },
+        { L"Hello\tWorld wide", 8, 6 },
+        { L"Hello\tWorld wide", 5, 6 },
+        { L"Hello\t\tWorld wide", 9, 7 },
+        { L"Hello \tWorld wide", 9, 7 },
+        { L"Hello\x3000World wide", 8, 6 },
+        /* not at other white space, a zero-width space or after a hyphen */
+        { L"Hello\x00a0World wide", 8, 8 },
+        { L"Hello\x000bWorld wide", 8, 8 },
+        { L"Hello\x2002World wide", 8, 8 },
+        { L"Hello\x200bWorld wide", 8, 8 },
+        { L"Hello\x200bWorld wide", 6, 6 },
+        { L"well-known words", 7, 7 },
+        { L"well-known words", 5, 5 },
+        /* next to a wide character, but not before one of the characters that may not start a line */
+        { L"\x6587\x4ef6\x7f16\x8f91\x89c6\x56fe", 3, 3 },
+        { L"\x6587\x4ef6(F) \x7f16\x8f91(E)", 4, 2 },
+        { L"\x6587\x4ef6\xff0c\x7f16\x8f91", 2, 1 },
+        { L"\x6587\x4ef6\x3002\x7f16\x8f91", 2, 1 },
+        { L"\x6587\x4ef6)\x7f16\x8f91", 2, 1 },
+        { L"\x6587\x4ef6\x300c\x7f16\x8f91\x300d", 3, 3 },
+        { L"\x6587\x4ef6\x300c\x7f16\x8f91\x300d", 2, 2 },
+        { L"\x30d5\x30a1\x30a4\x30eb\x30fc\x7de8\x96c6", 4, 4 },
+        { L"\x6587\x2039\x7f16\x8f91\x89c6", 2, 1 },
+    };
+    HWND hwnd = CreateWindowExA( 0, "static", NULL, WS_POPUP, 0, 0, 200, 200, 0, 0, 0, NULL );
+    HDC hdc = GetDC( hwnd );
+    HFONT font, old_font;
+    LOGFONTA lf;
+    unsigned int i;
+
+    memset( &lf, 0, sizeof(lf) );
+    lf.lfCharSet = DEFAULT_CHARSET;
+    strcpy( lf.lfFaceName, "Arial" );
+    lf.lfHeight = -12;
+    font = CreateFontIndirectA( &lf );
+    old_font = SelectObject( hdc, font );
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        UINT length = first_line_length( hdc, tests[i].str, tests[i].fit_chars, 0 );
+        ok( length == tests[i].length, "%u: %s, %d fitting: got %u, expected %u\n", i, debugstr_w(tests[i].str),
+            tests[i].fit_chars, length, tests[i].length );
+    }
+    SelectObject( hdc, old_font );
+    DeleteObject( font );
+    ReleaseDC( hwnd, hdc );
+    DestroyWindow( hwnd );
+}
+
 static void test_TabbedText(void)
 {
     HWND hwnd;
@@ -930,6 +1006,7 @@ START_TEST(text)
 {
     test_TabbedText();
     test_DrawTextCalcRect();
+    test_DrawText_breaks();
     test_DrawState();
     test_CharToOem_OemToChar();
 }
diff --git a/dlls/user32/text.c b/dlls/user32/text.c
index 114d0695ac8..0f8406358c3 100644
--- a/dlls/user32/text.c
+++ b/dlls/user32/text.c
@@ -347,6 +347,61 @@ static void TEXT_PathEllipsify (HDC hdc, WCHAR *str, unsigned int max_len,
  *     DT_PATH_ELLIPSIS is
  */
 
+/* The characters DrawText breaks a line at, and drops when the break leaves one at the start of the next line.  As on
+ * Windows, the other white space the line breaking algorithm allows a break at (the zero-width space, vertical tab,
+ * form feed and line and paragraph separators) does not break a word, and the tab, which it does not take for white
+ * space, does. */
+static BOOL is_break_space( WCHAR ch )
+{
+    return ch == SPACE || ch == TAB || ch == 0x3000;
+}
+
+/* Whether a character is East Asian wide, the ideographs, kana, hangul and full-width forms.  Other than at the
+ * characters above, DrawText only breaks a line next to one of these; not, for instance, after a hyphen or a
+ * zero-width space, where the line breaking algorithm would. */
+static BOOL is_wide_char( WCHAR ch )
+{
+    return (ch >= 0x1100 && ch <= 0x115f) || (ch >= 0x2e80 && ch <= 0x303e) || (ch >= 0x3041 && ch <= 0x33ff) ||
+           (ch >= 0x3400 && ch <= 0x4dbf) || (ch >= 0x4e00 && ch <= 0x9fff) || (ch >= 0xa000 && ch <= 0xa4cf) ||
+           (ch >= 0xac00 && ch <= 0xd7a3) || (ch >= 0xf900 && ch <= 0xfaff) || (ch >= 0xfe30 && ch <= 0xfe4f) ||
+           (ch >= 0xff00 && ch <= 0xff60) || (ch >= 0xffe0 && ch <= 0xffe6);
+}
+
+/* The characters DrawText does not start a line with when it breaks one next to a wide character, as measured on
+ * a Chinese (PRC) Windows; opening brackets, the prolonged sound mark and small kana may start one.  Sorted. */
+static const WCHAR no_line_start[] =
+{
+    0x0021, 0x0025, 0x0029, 0x002c, 0x002e, 0x003a, 0x003b, 0x003e, 0x003f, 0x005d, 0x007d, 0x00a8, 0x00b0, 0x00b7,
+    0x02c7, 0x02c9, 0x2014, 0x2015, 0x2016, 0x2018, 0x2019, 0x201d, 0x2022, 0x2025, 0x2026, 0x2027, 0x2032, 0x2033,
+    0x2103, 0x2236, 0x3001, 0x3002, 0x3003, 0x3005, 0x3009, 0x300b, 0x300d, 0x300f, 0x3011, 0x3015, 0x3017, 0x301e,
+    0x309b, 0x309c, 0xfe36, 0xfe3a, 0xfe3e, 0xfe40, 0xfe44, 0xfe50, 0xfe51, 0xfe52, 0xfe54, 0xfe55, 0xfe56, 0xfe57,
+    0xfe5a, 0xfe5c, 0xfe5e, 0xff01, 0xff02, 0xff05, 0xff07, 0xff09, 0xff0c, 0xff0d, 0xff0e, 0xff1a, 0xff1b, 0xff1f,
+    0xff3d, 0xff5c, 0xff5d, 0xff5e, 0xff61, 0xff63, 0xff64, 0xff9e, 0xff9f, 0xffe0, 0xffe1, 0xffe5,
+};
+
+static int compare_wchar( const void *a, const void *b )
+{
+    return *(const WCHAR *)a - *(const WCHAR *)b;
+}
+
+/* whether DrawText may break a line before str[pos] because of a wide character next to it */
+static BOOL can_break_wide( const WCHAR *str, int pos )
+{
+    if (!is_wide_char( str[pos - 1] ) && !is_wide_char( str[pos] )) return FALSE;
+    /* a break after white space is left to the white space */
+    if (is_break_space( str[pos - 1] )) return FALSE;
+    /* the single guillemets end no line */
+    if (str[pos - 1] == 0x2039 || str[pos - 1] == 0x203a) return FALSE;
+    return !bsearch( &str[pos], no_line_start, ARRAY_SIZE(no_line_start), sizeof(WCHAR), compare_wchar );
+}
+
+/* whether DrawText may end a line with str[pos - 1] when str[pos] no longer fits */
+static BOOL can_break_before( const WCHAR *str, const SCRIPT_LOGATTR *sla, int pos )
+{
+    if (is_break_space( str[pos - 1] )) return sla[pos].fSoftBreak;
+    return can_break_wide( str, pos );
+}
+
 static void TEXT_WordBreak (HDC hdc, WCHAR *str, unsigned int max_str,
                             unsigned int *len_str,
                             int width, int format, unsigned int chars_fit,
@@ -376,16 +431,23 @@ static void TEXT_WordBreak (HDC hdc, WCHAR *str, unsigned int max_str,
     word_fits = TRUE;
     if (!chars_fit)
         word_fits = FALSE;
-    else if (sla[i].fSoftBreak) /* chars_fit < *len_str so this is valid */
+    else if (can_break_before( str, sla, i )) /* chars_fit < *len_str so this is valid */
     {
          /* the word just fitted */
         p--;
     }
     else
     {
-        while (i > 0 && !sla[(--i)+1].fWhiteSpace) p--;
+        BOOL found = FALSE;
+
+        while (i > 0 && !found)
+        {
+            --i;
+            if (is_break_space( str[i + 1] ) || can_break_wide( str, i + 1 )) found = TRUE;
+            else p--;
+        }
         p--;
-        word_fits = (i != 0 || sla[i+1].fWhiteSpace );
+        word_fits = found;
     }
 
     /* If there was one. */
@@ -395,7 +457,7 @@ static void TEXT_WordBreak (HDC hdc, WCHAR *str, unsigned int max_str,
         /* break the line before/after that character */
         if (!(format & (DT_RIGHT | DT_CENTER)) || *p != SPACE)
             p++;
-        next_is_space = (p - str) < *len_str && *p == SPACE;
+        next_is_space = (p - str) < *len_str && is_break_space( *p );
         *len_str = p - str;
         /* and if the next character is a space then discard it. */
         *chars_used = *len_str;
