From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 22:13:04 -0400
Subject: [PATCH] ole32: Run an embedded object to update it, and name one
 whose class is gone.

The default handler's IOleObject::Update() was an E_NOTIMPL stub while
the object was not running; like DoVerb() it now runs the object first,
so an object whose server is not registered answers REGDB_E_CLASSNOTREG
as on Windows.  GetUserType() of an object that is not running only
asked the registry, which fails for a class that is not registered --
the case of a document embedding an object from an application that is
not installed; it now falls back to the user type the object's storage
recorded, and to "Unknown", which is what ole32's tests get on
Windows.  Whether that last string is translated on other languages'
Windows is not measured yet.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ole32/defaulthandler.c b/dlls/ole32/defaulthandler.c
index 89cdafec8a2..6e444839e74 100644
--- a/dlls/ole32/defaulthandler.c
+++ b/dlls/ole32/defaulthandler.c
@@ -726,11 +726,9 @@ static HRESULT WINAPI DefaultHandler_Update(
 
     TRACE("(%p)\n", iface);
 
-    if (!object_is_running(This))
-    {
-        FIXME("Should run object\n");
-        return E_NOTIMPL;
-    }
+    /* an object that is not running is run to be brought up to date */
+    hr = IRunnableObject_Run(&This->IRunnableObject_iface, NULL);
+    if (FAILED(hr)) return hr;
 
     start_object_call( This );
     hr = IOleObject_Update(This->pOleDelegate);
@@ -820,7 +818,18 @@ static HRESULT WINAPI DefaultHandler_GetUserType(
     return hr;
   }
 
-  return OleRegGetUserType(&This->clsid, dwFormOfType, pszUserType);
+  /* A class that is not registered is named by what its storage recorded, and failing that, is unknown. */
+  hr = OleRegGetUserType(&This->clsid, dwFormOfType, pszUserType);
+  if (SUCCEEDED(hr) || !pszUserType)
+    return hr;
+
+  if (This->storage && SUCCEEDED(ReadFmtUserTypeStg(This->storage, NULL, pszUserType)) && *pszUserType)
+    return S_OK;
+
+  if (!(*pszUserType = CoTaskMemAlloc(sizeof(L"Unknown"))))
+    return E_OUTOFMEMORY;
+  lstrcpyW(*pszUserType, L"Unknown");
+  return S_OK;
 }
 
 /************************************************************************
diff --git a/dlls/ole32/tests/ole2.c b/dlls/ole32/tests/ole2.c
index 38508fba383..25ad58b6349 100644
--- a/dlls/ole32/tests/ole2.c
+++ b/dlls/ole32/tests/ole2.c
@@ -2886,10 +2886,8 @@ static void test_default_handler(void)
     ok(IsEqualCLSID(&clsid, &CLSID_WineTest), "clsid != CLSID_WineTest\n");
 
     hr = IOleObject_GetUserType(pObject, USERCLASSTYPE_FULL, &pszUserType);
-    todo_wine {
     ok_ole_success(hr, "IOleObject_GetUserType");
     ok(!lstrcmpW(pszUserType, wszUnknown), "Retrieved user type was wrong\n");
-    }
 
     hr = IOleObject_InitFromData(pObject, NULL, TRUE, 0);
     ok(hr == OLE_E_NOTRUNNING, "IOleObject_InitFromData should have returned OLE_E_NOTRUNNING instead of 0x%08lx\n", hr);
@@ -2920,7 +2918,6 @@ static void test_default_handler(void)
     ok(hr == E_FAIL, "IOleObject_GetMoniker should have returned E_FAIL instead of 0x%08lx\n", hr);
 
     hr = IOleObject_Update(pObject);
-    todo_wine
     ok(hr == REGDB_E_CLASSNOTREG, "IOleObject_Update should have returned REGDB_E_CLASSNOTREG instead of 0x%08lx\n", hr);
 
     hr = IOleObject_QueryInterface(pObject, &IID_IDataObject, (void **)&pDataObject);
