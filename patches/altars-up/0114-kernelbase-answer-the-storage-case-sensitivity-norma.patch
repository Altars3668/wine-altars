From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 10:34:06 -0400
Subject: [PATCH] kernelbase: answer the storage, case sensitivity, normalized
 name and remote protocol classes.

GetFileInformationByHandleEx failed with ERROR_CALL_NOT_IMPLEMENTED for
FileStorageInfo, which Word asks for on the files it opens, and for
FileCaseSensitiveInfo, FileNormalizedNameInfo and FileRemoteProtocolInfo.
What Windows 11 answers, for a file and a directory on a local NTFS volume
(tools/fileinfoprobe in the wine-altars tree):

- FileStorageInfo, NtQueryVolumeInformationFile's FileFsSectorSizeInformation:
  the logical and physical sector sizes and the device's flags; a buffer a
  byte short fails with ERROR_BAD_LENGTH.  Here the logical size is the one
  FileFsSizeInformation gives, and the physical one, whether the device has
  a seek penalty or takes trims, and how its partition is aligned come from
  the block device the file is on, as sysfs describes it: the device of the
  file, or for btrfs and the like, the one its mount is from.
- FileCaseSensitiveInfo: no flag, for a file as for a directory, as names
  are compared regardless of case in every directory.
- FileNormalizedNameInfo: the name FileNameInfo gives, ERROR_MORE_DATA with
  the length when it does not fit; the names here are long names already.
- FileRemoteProtocolInfo: ERROR_INVALID_PARAMETER for a local file, and
  every file is one here.
- FileDispositionInfoEx and FileRenameInfoEx, which are for setting:
  ERROR_INVALID_PARAMETER, as FileDispositionInfo and FileRenameInfo.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit d1b0398a7507722a6e2d4bd4cba02ff6b208507f)

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index fec9154b6c7..140c9e3d4e3 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -4656,6 +4656,102 @@ static void test_CreateFile(void)
     DeleteFileA(file_name);
 }
 
+/* The classes GetFileInformationByHandleEx answers with what a volume, and its device, are like. */
+static void test_GetFileInformationByHandleEx_volume(void)
+{
+    char temp_path[MAX_PATH], file_name[MAX_PATH];
+    union { FILE_NAME_INFO info; char buffer[1024]; } name, normalized;
+    FILE_REMOTE_PROTOCOL_INFO remote;
+    FILE_CASE_SENSITIVE_INFO cs;
+    FILE_STORAGE_INFO storage;
+    HANDLE file, directory;
+    char buffer[1024];
+    BOOL ret;
+
+    if (!pGetFileInformationByHandleEx)
+    {
+        win_skip("GetFileInformationByHandleEx is missing.\n");
+        return;
+    }
+
+    GetTempPathA(sizeof(temp_path), temp_path);
+    GetTempFileNameA(temp_path, "wfi", 0, file_name);
+    file = CreateFileA(file_name, GENERIC_READ | GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, FILE_FLAG_DELETE_ON_CLOSE, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "Failed to create a file, error %lu.\n", GetLastError());
+    directory = CreateFileA(temp_path, GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                            OPEN_EXISTING, FILE_FLAG_BACKUP_SEMANTICS, NULL);
+    ok(directory != INVALID_HANDLE_VALUE, "Failed to open a directory, error %lu.\n", GetLastError());
+
+    memset(&storage, 0xcc, sizeof(storage));
+    SetLastError(0xdeadbeef);
+    ret = pGetFileInformationByHandleEx(file, FileStorageInfo, &storage, sizeof(storage));
+    if (!ret && GetLastError() == ERROR_INVALID_PARAMETER)
+    {
+        win_skip("FileStorageInfo is not supported.\n");
+        goto done;
+    }
+    ok(ret, "Got error %lu.\n", GetLastError());
+    ok(storage.LogicalBytesPerSector >= 512 && !(storage.LogicalBytesPerSector & (storage.LogicalBytesPerSector - 1)),
+       "Got logical sector size %lu.\n", storage.LogicalBytesPerSector);
+    ok(storage.PhysicalBytesPerSectorForAtomicity >= storage.LogicalBytesPerSector
+       && !(storage.PhysicalBytesPerSectorForAtomicity & (storage.PhysicalBytesPerSectorForAtomicity - 1)),
+       "Got physical sector size %lu.\n", storage.PhysicalBytesPerSectorForAtomicity);
+    ok(storage.PhysicalBytesPerSectorForPerformance >= storage.LogicalBytesPerSector,
+       "Got physical sector size for performance %lu.\n", storage.PhysicalBytesPerSectorForPerformance);
+    ok(storage.FileSystemEffectivePhysicalBytesPerSectorForAtomicity >= storage.LogicalBytesPerSector,
+       "Got effective physical sector size %lu.\n", storage.FileSystemEffectivePhysicalBytesPerSectorForAtomicity);
+    ok(!(storage.Flags & ~0x1f), "Got flags %#lx.\n", storage.Flags);
+    SetLastError(0xdeadbeef);
+    ret = pGetFileInformationByHandleEx(file, FileStorageInfo, &storage, sizeof(storage) - 1);
+    ok(!ret && GetLastError() == ERROR_BAD_LENGTH, "Got %d, error %lu.\n", ret, GetLastError());
+    ret = pGetFileInformationByHandleEx(directory, FileStorageInfo, &storage, sizeof(storage));
+    ok(ret, "Got error %lu.\n", GetLastError());
+
+    /* Names here are compared regardless of case. */
+    cs.Flags = 0xdeadbeef;
+    ret = pGetFileInformationByHandleEx(file, FileCaseSensitiveInfo, &cs, sizeof(cs));
+    ok(ret || broken(GetLastError() == ERROR_INVALID_PARAMETER) /* before Windows 10 1803 */,
+       "Got error %lu.\n", GetLastError());
+    if (ret) ok(!cs.Flags, "Got flags %#lx.\n", cs.Flags);
+    cs.Flags = 0xdeadbeef;
+    ret = pGetFileInformationByHandleEx(directory, FileCaseSensitiveInfo, &cs, sizeof(cs));
+    if (ret) ok(!cs.Flags, "Got flags %#lx.\n", cs.Flags);
+
+    /* The normalized name is the name, long names all the way. */
+    ret = pGetFileInformationByHandleEx(file, FileNameInfo, &name, sizeof(name));
+    ok(ret, "Got error %lu.\n", GetLastError());
+    memset(&normalized, 0xcc, sizeof(normalized));
+    ret = pGetFileInformationByHandleEx(file, FileNormalizedNameInfo, &normalized, sizeof(normalized));
+    ok(ret || broken(GetLastError() == ERROR_INVALID_PARAMETER) /* before Windows 8 */,
+       "Got error %lu.\n", GetLastError());
+    if (ret)
+    {
+        ok(normalized.info.FileNameLength == name.info.FileNameLength
+           && !memcmp(normalized.info.FileName, name.info.FileName, name.info.FileNameLength),
+           "Got name %s.\n", debugstr_wn(normalized.info.FileName, normalized.info.FileNameLength / sizeof(WCHAR)));
+        SetLastError(0xdeadbeef);
+        ret = pGetFileInformationByHandleEx(file, FileNormalizedNameInfo, &normalized, 8);
+        ok(!ret && GetLastError() == ERROR_MORE_DATA, "Got %d, error %lu.\n", ret, GetLastError());
+        ok(normalized.info.FileNameLength == name.info.FileNameLength, "Got length %lu.\n",
+           normalized.info.FileNameLength);
+    }
+
+    /* A local file has no remote protocol, and the Ex classes are there to set. */
+    SetLastError(0xdeadbeef);
+    ret = pGetFileInformationByHandleEx(file, FileRemoteProtocolInfo, &remote, sizeof(remote));
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "Got %d, error %lu.\n", ret, GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = pGetFileInformationByHandleEx(file, FileDispositionInfoEx, buffer, sizeof(buffer));
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "Got %d, error %lu.\n", ret, GetLastError());
+    SetLastError(0xdeadbeef);
+    ret = pGetFileInformationByHandleEx(file, FileRenameInfoEx, buffer, sizeof(buffer));
+    ok(!ret && GetLastError() == ERROR_INVALID_PARAMETER, "Got %d, error %lu.\n", ret, GetLastError());
+
+done:
+    CloseHandle(directory);
+    CloseHandle(file);
+}
+
 static void test_GetFileInformationByHandleEx(void)
 {
     int i;
@@ -7070,6 +7166,7 @@ START_TEST(file)
     test_ReplaceFileA();
     test_ReplaceFileW();
     test_GetFileInformationByHandleEx();
+    test_GetFileInformationByHandleEx_volume();
     test_OpenFileById();
     test_SetFileValidData();
     test_WriteFileGather();
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 911eda816ff..459776f2998 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -3194,13 +3194,25 @@ BOOL WINAPI DECLSPEC_HOTPATCH GetFileInformationByHandleEx( HANDLE handle, FILE_
     switch (class)
     {
     case FileRemoteProtocolInfo:
+        status = NtQueryInformationFile( handle, &io, info, size, FileRemoteProtocolInformation );
+        break;
+
     case FileStorageInfo:
-    case FileDispositionInfoEx:
-    case FileRenameInfoEx:
+        status = NtQueryVolumeInformationFile( handle, &io, info, size, FileFsSectorSizeInformation );
+        break;
+
     case FileCaseSensitiveInfo:
+        status = NtQueryInformationFile( handle, &io, info, size, FileCaseSensitiveInformation );
+        break;
+
     case FileNormalizedNameInfo:
-        FIXME( "%p, %u, %p, %lu\n", handle, class, info, size );
-        SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+        status = NtQueryInformationFile( handle, &io, info, size, FileNormalizedNameInformation );
+        break;
+
+    case FileDispositionInfoEx:
+    case FileRenameInfoEx:
+        /* ways to set, not to query */
+        SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
 
     case FileStreamInfo:
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 1bfec7a4307..c3a94d40602 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2252,6 +2252,113 @@ static NTSTATUS get_full_size_info(int fd, FILE_FS_FULL_SIZE_INFORMATION *info)
     return STATUS_SUCCESS;
 }
 
+#ifdef linux
+/* a number from a file of the block device's in sysfs, relative to its directory */
+static BOOL read_block_device_value( const char *dir, const char *name, ULONGLONG *value )
+{
+    char path[PATH_MAX], buf[32];
+    ssize_t size;
+    int fd;
+
+    if (snprintf( path, sizeof(path), "%s/%s", dir, name ) >= sizeof(path)) return FALSE;
+    if ((fd = open( path, O_RDONLY )) == -1) return FALSE;
+    size = read( fd, buf, sizeof(buf) - 1 );
+    close( fd );
+    if (size <= 0) return FALSE;
+    buf[size] = 0;
+    *value = strtoull( buf, NULL, 10 );
+    return TRUE;
+}
+
+/* the sysfs directory of the block device a file is on: its own, or the one of what is mounted from */
+static BOOL get_block_device_dir( const struct stat *st, char *dir, size_t size )
+{
+    char line[4096], dev[32], *p, *source = NULL;
+    struct stat dir_st;
+    FILE *mounts;
+
+    snprintf( dir, size, "/sys/dev/block/%u:%u", major( st->st_dev ), minor( st->st_dev ) );
+    if (!stat( dir, &dir_st )) return TRUE;
+
+    /* btrfs and the like give their files a device number of their own; the mount says what it is on */
+    if (!(mounts = fopen( "/proc/self/mountinfo", "r" ))) return FALSE;
+    snprintf( dev, sizeof(dev), "%u:%u", major( st->st_dev ), minor( st->st_dev ) );
+    while (fgets( line, sizeof(line), mounts ))
+    {
+        char *fields[10];
+        int count = 0;
+
+        for (p = strtok( line, " " ); p && count < ARRAY_SIZE(fields); p = strtok( NULL, " " ))
+        {
+            fields[count++] = p;
+            if (!strcmp( p, "-" )) break;
+        }
+        if (count < 3 || strcmp( fields[2], dev )) continue;
+        /* after the separator: the file system type, then the source */
+        if (!(p = strtok( NULL, " " )) || !(p = strtok( NULL, " \n" ))) break;
+        if (!strncmp( p, "/dev/", 5 )) source = p + 5;
+        break;
+    }
+    if (source)
+    {
+        if ((p = strrchr( source, '/' ))) source = p + 1;
+        snprintf( dir, size, "/sys/class/block/%s", source );
+    }
+    fclose( mounts );
+    return source && !stat( dir, &dir_st );
+}
+#endif
+
+/*
+ * The sector sizes of the device a file is on, and whether it is aligned to them, as the block device says;
+ * the logical size is the one FileFsSizeInformation gives.
+ */
+static NTSTATUS get_sector_size_info( int fd, FILE_FS_SECTOR_SIZE_INFORMATION *info )
+{
+    FILE_FS_FULL_SIZE_INFORMATION full_info;
+    ULONG physical, flags = SSINFO_FLAGS_ALIGNED_DEVICE | SSINFO_FLAGS_PARTITION_ALIGNED_ON_DEVICE;
+    ULONG sector_offset = 0, partition_offset = 0;
+    NTSTATUS status;
+#ifdef linux
+    char dir[PATH_MAX], queue[PATH_MAX + 16];
+    ULONGLONG value;
+    struct stat st;
+#endif
+
+    if ((status = get_full_size_info( fd, &full_info ))) return status;
+    physical = full_info.BytesPerSector;
+
+#ifdef linux
+    if (!fstat( fd, &st ) && get_block_device_dir( &st, dir, sizeof(dir) ))
+    {
+        /* a partition has its queue in the disk's directory */
+        snprintf( queue, sizeof(queue), "%s/queue", dir );
+        if (read_block_device_value( dir, "partition", &value ))
+            snprintf( queue, sizeof(queue), "%s/../queue", dir );
+        if (read_block_device_value( queue, "physical_block_size", &value ) && value > physical)
+            physical = value;
+        if (read_block_device_value( queue, "rotational", &value ) && !value)
+            flags |= SSINFO_FLAGS_NO_SEEK_PENALTY;
+        if (read_block_device_value( queue, "discard_max_bytes", &value ) && value)
+            flags |= SSINFO_FLAGS_TRIM_ENABLED;
+        if (read_block_device_value( dir, "alignment_offset", &value ) && value)
+        {
+            flags &= ~SSINFO_FLAGS_PARTITION_ALIGNED_ON_DEVICE;
+            partition_offset = value;
+        }
+    }
+#endif
+
+    info->LogicalBytesPerSector = full_info.BytesPerSector;
+    info->PhysicalBytesPerSectorForAtomicity = physical;
+    info->PhysicalBytesPerSectorForPerformance = physical;
+    info->FileSystemEffectivePhysicalBytesPerSectorForAtomicity = physical;
+    info->Flags = flags;
+    info->ByteOffsetForSectorAlignment = sector_offset;
+    info->ByteOffsetForPartitionAlignment = partition_offset;
+    return STATUS_SUCCESS;
+}
+
 static NTSTATUS get_full_size_info_ex(int fd, FILE_FS_FULL_SIZE_INFORMATION_EX *info)
 {
     FILE_FS_FULL_SIZE_INFORMATION full_info;
@@ -4993,7 +5100,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         0,                                             /* FileSfioVolumeInformation */
         0,                                             /* FileHardLinkInformation */
         0,                                             /* FileProcessIdsUsingFileInformation */
-        0,                                             /* FileNormalizedNameInformation */
+        sizeof(FILE_NAME_INFORMATION),                 /* FileNormalizedNameInformation */
         0,                                             /* FileNetworkPhysicalNameInformation */
         0,                                             /* FileIdGlobalTxDirectoryInformation */
         0,                                             /* FileIsRemoteDeviceInformation */
@@ -5016,7 +5123,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         sizeof(FILE_STAT_INFORMATION),                 /* FileStatInformation */
         0,                                             /* FileMemoryPartitionInformation */
         0,                                             /* FileStatLxInformation */
-        0,                                             /* FileCaseSensitiveInformation */
+        sizeof(FILE_CASE_SENSITIVE_INFORMATION),       /* FileCaseSensitiveInformation */
         0,                                             /* FileLinkInformationEx */
         0,                                             /* FileLinkInformationExBypassAccessCheck */
         0,                                             /* FileStorageReserveIdInformation */
@@ -5039,6 +5146,9 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         return server_get_file_info( handle, io, ptr, len, class );
     if (class <= 0 || class >= FileMaximumInformation)
         return io->Status = STATUS_INVALID_INFO_CLASS;
+    /* every file here is a local one, and a local file has no remote protocol */
+    if (class == FileRemoteProtocolInformation)
+        return io->Status = STATUS_INVALID_PARAMETER;
     if (!info_sizes[class])
         return server_get_file_info( handle, io, ptr, len, class );
     if (len < info_sizes[class])
@@ -5122,6 +5232,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         }
         break;
     case FileNameInformation:
+    case FileNormalizedNameInformation:  /* the names here are long names already */
         {
             LONG name_len = len - FIELD_OFFSET(FILE_NAME_INFORMATION, FileName);
             status = server_get_name_info( handle, ptr, &name_len );
@@ -5186,6 +5297,10 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             info->EffectiveAccess = FILE_ALL_ACCESS; /* FIXME */
         }
         break;
+    case FileCaseSensitiveInformation:
+        /* names are matched regardless of case in every directory, as on Windows without the flag */
+        ((FILE_CASE_SENSITIVE_INFORMATION *)ptr)->Flags = 0;
+        break;
     default:
         FIXME("Unsupported class (%d)\n", class);
         status = STATUS_NOT_IMPLEMENTED;
@@ -7656,6 +7771,17 @@ NTSTATUS WINAPI NtQueryVolumeInformationFile( HANDLE handle, IO_STATUS_BLOCK *io
         }
         break;
 
+    case FileFsSectorSizeInformation:
+        if (length < sizeof(FILE_FS_SECTOR_SIZE_INFORMATION))
+            status = STATUS_INFO_LENGTH_MISMATCH;
+        else
+        {
+            FILE_FS_SECTOR_SIZE_INFORMATION *info = buffer;
+            if ((status = get_sector_size_info( fd, info )) == STATUS_SUCCESS)
+                io->Information = sizeof(*info);
+        }
+        break;
+
     case FileFsObjectIdInformation:
         FIXME( "%p: object id info not supported\n", handle );
         status = STATUS_NOT_IMPLEMENTED;
