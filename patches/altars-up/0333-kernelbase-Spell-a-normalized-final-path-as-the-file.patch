From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 02:14:06 -0400
Subject: [PATCH] kernelbase: Spell a normalized final path as the file is
 named on disk.

GetFinalPathNameByHandle answered with the name the file was opened by
for either flag, which is what FILE_NAME_OPENED asks for; the default,
FILE_NAME_NORMALIZED, gives each component in the case it has on disk,
as two tests expect of a file opened as "test.dat" and stored as
"Test.Dat".  FileNormalizedNameInformation now reads the name the server
keeps from realpath, and the final path takes the rest of the path from
it after the volume.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/file.c b/dlls/kernel32/tests/file.c
index 1849090d1f1..d953a069ce6 100644
--- a/dlls/kernel32/tests/file.c
+++ b/dlls/kernel32/tests/file.c
@@ -6022,7 +6022,7 @@ static void test_GetFinalPathNameByHandleW(void)
     ok(file != INVALID_HANDLE_VALUE, "CreateFileW error %lu\n", GetLastError());
     count = pGetFinalPathNameByHandleW(file, result_path, ARRAY_SIZE(result_path), 0);
     ok(count == lstrlenW(test_path) + 4, "Expected length %u, got %lu\n", lstrlenW(test_path), count);
-    todo_wine ok(wcscmp(test_path, result_path + 4) == 0, "Expected %s, got %s\n",
+    ok(wcscmp(test_path, result_path + 4) == 0, "Expected %s, got %s\n",
        wine_dbgstr_w(test_path), wine_dbgstr_w(result_path));
     CloseHandle(file);
 
@@ -6032,7 +6032,7 @@ static void test_GetFinalPathNameByHandleW(void)
     ok(file != INVALID_HANDLE_VALUE, "CreateFileW error %lu\n", GetLastError());
     count = pGetFinalPathNameByHandleW(file, result_path, ARRAY_SIZE(result_path), 0);
     ok(count == lstrlenW(test_path) + 4, "Expected length %u, got %lu\n", lstrlenW(test_path), count);
-    todo_wine ok(wcscmp(test_path, result_path + 4) == 0, "Expected %s, got %s\n",
+    ok(wcscmp(test_path, result_path + 4) == 0, "Expected %s, got %s\n",
        wine_dbgstr_w(test_path), wine_dbgstr_w(result_path));
     wcscpy(test_path, temp_path);
     wcscat(test_path, L"test_renamed.dat");
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
index 3d0b94e2b3c..aa80f7b316a 100644
--- a/dlls/kernelbase/file.c
+++ b/dlls/kernelbase/file.c
@@ -1947,6 +1947,37 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetFinalPathNameByHandleA( HANDLE file, LPSTR pat
 }
 
 
+/* the volume of a path as opened, followed by the rest of it as the file is named on disk */
+static WCHAR *get_normalized_path( HANDLE file, const WCHAR *opened )
+{
+    const WCHAR *rest = wcschr( opened, '\\' );
+    FILE_NAME_INFORMATION *info;
+    ULONG size = 1024;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    WCHAR *ret = NULL;
+
+    if (!rest) return NULL;
+    for (;;)
+    {
+        if (!(info = HeapAlloc( GetProcessHeap(), 0, size ))) return NULL;
+        status = NtQueryInformationFile( file, &io, info, size, FileNormalizedNameInformation );
+        if (status != STATUS_BUFFER_OVERFLOW) break;
+        size = offsetof( FILE_NAME_INFORMATION, FileName ) + info->FileNameLength;
+        HeapFree( GetProcessHeap(), 0, info );
+    }
+    if (!status && (ret = HeapAlloc( GetProcessHeap(), 0, (rest - opened) * sizeof(WCHAR) + info->FileNameLength +
+                                     sizeof(WCHAR) )))
+    {
+        memcpy( ret, opened, (rest - opened) * sizeof(WCHAR) );
+        memcpy( ret + (rest - opened), info->FileName, info->FileNameLength );
+        ret[(rest - opened) + info->FileNameLength / sizeof(WCHAR)] = 0;
+    }
+    HeapFree( GetProcessHeap(), 0, info );
+    return ret;
+}
+
+
 /***********************************************************************
  *	GetFinalPathNameByHandleW   (kernelbase.@)
  */
@@ -1955,7 +1986,7 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetFinalPathNameByHandleW( HANDLE file, LPWSTR pa
 {
     WCHAR buffer[sizeof(OBJECT_NAME_INFORMATION) + MAX_PATH + 1];
     OBJECT_NAME_INFORMATION *info = (OBJECT_NAME_INFORMATION*)&buffer;
-    WCHAR drive_part[MAX_PATH];
+    WCHAR drive_part[MAX_PATH], *normalized = NULL;
     DWORD drive_part_len = 0;
     NTSTATUS status;
     DWORD result = 0;
@@ -2001,12 +2032,13 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetFinalPathNameByHandleW( HANDLE file, LPWSTR pa
     for (ULONG i = 0; i < info->Name.Length / sizeof(WCHAR); i++)
         if (info->Name.Buffer[i] == '/') info->Name.Buffer[i] = '\\';
 
-    /* FILE_NAME_OPENED is not supported yet, and would require Wineserver changes */
-    if (flags & FILE_NAME_OPENED)
+    /* the object's name is the one it was opened by; a normalized name is spelled as on disk */
+    if (!(flags & FILE_NAME_OPENED) && (normalized = get_normalized_path( file, info->Name.Buffer )))
     {
-        FIXME("FILE_NAME_OPENED not supported\n");
-        flags &= ~FILE_NAME_OPENED;
+        info->Name.Buffer = normalized;
+        info->Name.Length = lstrlenW( normalized ) * sizeof(WCHAR);
     }
+    flags &= ~FILE_NAME_OPENED;
 
     /* Get information required for VOLUME_NAME_NONE, VOLUME_NAME_GUID and VOLUME_NAME_NT */
     if (flags == VOLUME_NAME_NONE || flags == VOLUME_NAME_GUID || flags == VOLUME_NAME_NT)
@@ -2093,6 +2125,7 @@ DWORD WINAPI DECLSPEC_HOTPATCH GetFinalPathNameByHandleW( HANDLE file, LPWSTR pa
 
  done:
     if ((WCHAR *)info != buffer) HeapFree( GetProcessHeap(), 0, info );
+    HeapFree( GetProcessHeap(), 0, normalized );
     return result;
 }
 
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 3d432c02ab7..94da5e3d802 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2176,6 +2176,42 @@ static NTSTATUS server_get_name_info( HANDLE handle, FILE_NAME_INFORMATION *info
 }
 
 
+/* the name a file is stored under: long names, each in the case it has on disk */
+static NTSTATUS get_normalized_name_info( HANDLE handle, FILE_NAME_INFORMATION *info, LONG *name_len )
+{
+    const WCHAR *ptr, *end;
+    char *unix_name;
+    NTSTATUS status;
+    WCHAR *nt_name;
+
+    if (server_get_unix_name( handle, &unix_name )) return server_get_name_info( handle, info, name_len );
+    /* a reparse point is stored under another name */
+    if (unix_name[strlen( unix_name ) - 1] == '?')
+    {
+        free( unix_name );
+        return server_get_name_info( handle, info, name_len );
+    }
+    status = unix_to_nt_file_name( unix_name, &nt_name, FILE_OPEN );
+    free( unix_name );
+    if (status) return status;
+
+    /* Skip the volume mount point (if any). */
+    ptr = nt_name;
+    end = ptr + wcslen( nt_name );
+    while (ptr != end && *ptr == '\\') ++ptr;
+    while (ptr != end && *ptr != '\\') ++ptr;
+    while (ptr != end && *ptr == '\\') ++ptr;
+    while (ptr != end && *ptr != '\\') ++ptr;
+
+    info->FileNameLength = (end - ptr) * sizeof(WCHAR);
+    if (*name_len < info->FileNameLength) status = STATUS_BUFFER_OVERFLOW;
+    else *name_len = info->FileNameLength;
+    if (info->FileNameLength) memcpy( info->FileName, ptr, *name_len );
+    free( nt_name );
+    return status;
+}
+
+
 #ifdef __APPLE__
 static LONGLONG get_free_bytes_for_important_data(int fd)
 {
@@ -5288,13 +5324,19 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         }
         break;
     case FileNameInformation:
-    case FileNormalizedNameInformation:  /* the names here are long names already */
         {
             LONG name_len = len - FIELD_OFFSET(FILE_NAME_INFORMATION, FileName);
             status = server_get_name_info( handle, ptr, &name_len );
             io->Information = offsetof( FILE_NAME_INFORMATION, FileName ) + name_len;
         }
         break;
+    case FileNormalizedNameInformation:
+        {
+            LONG name_len = len - FIELD_OFFSET(FILE_NAME_INFORMATION, FileName);
+            status = get_normalized_name_info( handle, ptr, &name_len );
+            io->Information = offsetof( FILE_NAME_INFORMATION, FileName ) + name_len;
+        }
+        break;
     case FileNetworkOpenInformation:
         if (fd_get_file_info( handle, fd, options, &st, &attr, NULL ) == -1)
             status = errno_to_status( errno );
