From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:18 -0400
Subject: [PATCH] wined3d: Say what is lost only when something is.

Presenting part of the back buffer through GDI is how such a present
is done when the swap would show all of it; the FIXME is for the window
that has no GL context or Vulkan swapchain of its own.  A line pattern
lost in a core context gets its FIXME when one is set, not for solid
lines.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/wined3d/ffp_gl.c b/dlls/wined3d/ffp_gl.c
index 8bba21cb7f8..44cd910be89 100644
--- a/dlls/wined3d/ffp_gl.c
+++ b/dlls/wined3d/ffp_gl.c
@@ -828,9 +828,16 @@ static void state_linepattern(struct wined3d_context *context, const struct wine
 
 static void state_linepattern_w(struct wined3d_context *context, const struct wined3d_state *state, DWORD state_id)
 {
+    union
+    {
+        DWORD d;
+        struct wined3d_line_pattern lp;
+    } pattern;
     static unsigned int once;
 
-    if (!once++)
+    /* only a pattern that is set is lost; solid lines are drawn as they should be */
+    pattern.d = state->render_states[WINED3D_RS_LINEPATTERN];
+    if (pattern.lp.repeat_factor && !once++)
         FIXME("Setting line patterns is not supported in OpenGL core contexts.\n");
 }
 
diff --git a/dlls/wined3d/swapchain.c b/dlls/wined3d/swapchain.c
index 757b80b755b..112f26ffc6e 100644
--- a/dlls/wined3d/swapchain.c
+++ b/dlls/wined3d/swapchain.c
@@ -459,10 +459,11 @@ HRESULT CDECL wined3d_swapchain_get_gamma_ramp(const struct wined3d_swapchain *s
     return wined3d_output_get_gamma_ramp(output, ramp);
 }
 
-/* The is a fallback for cases where we e.g. can't create a GL context or
- * Vulkan swapchain for the swapchain window. */
+/* Presents through GDI: what a present that copies only part of the back buffer comes to when the swap
+ * would show all of it, and the fallback for a window we cannot create a GL context or Vulkan swapchain
+ * for, which is the one that loses something (the speed of presenting on the GPU). */
 static void swapchain_blit_gdi(struct wined3d_swapchain *swapchain,
-        struct wined3d_context *context, const RECT *src_rect, const RECT *dst_rect)
+        struct wined3d_context *context, const RECT *src_rect, const RECT *dst_rect, BOOL fallback)
 {
     struct wined3d_texture *back_buffer = swapchain->back_buffers[0];
     D3DKMT_DESTROYDCFROMMEMORY destroy_desc;
@@ -475,11 +476,11 @@ static void swapchain_blit_gdi(struct wined3d_swapchain *swapchain,
 
     static unsigned int once;
 
-    TRACE("swapchain %p, context %p, src_rect %s, dst_rect %s.\n",
-            swapchain, context, wine_dbgstr_rect(src_rect), wine_dbgstr_rect(dst_rect));
+    TRACE("swapchain %p, context %p, src_rect %s, dst_rect %s, fallback %d.\n",
+            swapchain, context, wine_dbgstr_rect(src_rect), wine_dbgstr_rect(dst_rect), fallback);
 
-    if (!once++)
-        FIXME("Using GDI present.\n");
+    if (fallback && !once++)
+        FIXME("Presenting through GDI, the window has no GL context or Vulkan swapchain of its own.\n");
 
     format = back_buffer->resource.format;
     if (!format->ddi_format)
@@ -675,7 +676,8 @@ static void swapchain_gl_present(struct wined3d_swapchain *swapchain,
             || (pixel_format->swap_method != WGL_SWAP_COPY_ARB
             && swapchain_present_is_partial_copy(swapchain, dst_rect)))
     {
-        swapchain_blit_gdi(swapchain, context, src_rect, dst_rect);
+        swapchain_blit_gdi(swapchain, context, src_rect, dst_rect,
+                context_gl->dc == wined3d_device_gl(swapchain->device)->backup_dc);
     }
     else
     {
@@ -1303,7 +1305,7 @@ static void swapchain_vk_present(struct wined3d_swapchain *swapchain, const RECT
 
     if (!swapchain_vk->vk_swapchain || swapchain_present_is_partial_copy(swapchain, dst_rect))
     {
-        swapchain_blit_gdi(swapchain, &context_vk->c, src_rect, dst_rect);
+        swapchain_blit_gdi(swapchain, &context_vk->c, src_rect, dst_rect, !swapchain_vk->vk_swapchain);
     }
     else
     {
