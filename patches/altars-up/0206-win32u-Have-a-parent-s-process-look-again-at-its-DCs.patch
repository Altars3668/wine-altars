From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 07:25:41 -0400
Subject: [PATCH] win32u: Have a parent's process look again at its DCs when a
 child in another process moves.

A window whose parent is in another process moved, or was shown or hidden,
and only the DCs of its own process were made to look at their visible
regions again: the parent's process went on clipping with what its DCs had
last seen.  The parent's window is now sent WM_WINE_INVALIDATEDCE, and its
thread marks the DCs of the window and of its descendants dirty.

Word's composition presents its document through a DC of the pane that
hosts an Excel worksheet active in place, clipping the worksheet's window
out; the clip stayed where the worksheet had been before Word moved it, so
the document covered the top of the worksheet and the worksheet's old
pixels showed below it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 4dee4a13e7fefe21c783243ece7fda2322b08d93)

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 73f45c6c09d..e4d1170e625 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -1223,6 +1223,33 @@ void invalidate_dce( WND *win, const RECT *old_rect )
         }
     }
     set_thread_dpi_awareness_context( context );
+
+    /* the DCs of a parent in another process, such as a document hosting an object active in place, cannot see
+     * this; its process is told to look again */
+    if (win->parent != get_desktop_window() && win->parent != get_hwnd_message_parent() &&
+        !is_current_process_window( win->parent ))
+        NtUserPostMessage( win->parent, WM_WINE_INVALIDATEDCE, 0, 0 );
+}
+
+/***********************************************************************
+ *           invalidate_child_dces
+ *
+ * A child of the window, in another process, moved or changed its visibility:
+ * the DCs of the window and of its descendants here clip with what they last saw.
+ */
+void invalidate_child_dces( HWND hwnd )
+{
+    struct dce *dce;
+
+    TRACE( "%p\n", hwnd );
+
+    user_lock();
+    LIST_FOR_EACH_ENTRY( dce, &dce_list, struct dce, entry )
+    {
+        if (!dce->hwnd) continue;
+        if (dce->hwnd == hwnd || is_child( hwnd, dce->hwnd )) make_dc_dirty( dce );
+    }
+    user_unlock();
 }
 
 /***********************************************************************
diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index 588c0f5f8d9..1bd4efbaa8d 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -2274,6 +2274,9 @@ static LRESULT handle_internal_message( HWND hwnd, UINT msg, WPARAM wparam, LPAR
         /* a display change another process noticed, for the desktop to take up */
         if (hwnd == get_desktop_window()) NtUserCallNoParam( NtUserCallNoParam_DisplayModeChanged );
         return 0;
+    case WM_WINE_INVALIDATEDCE:
+        invalidate_child_dces( hwnd );
+        return 0;
     case WM_WINE_SETPIXELFORMAT:
         set_window_pixel_format( hwnd, wparam, lparam );
         return 0;
diff --git a/dlls/win32u/ntuser_private.h b/dlls/win32u/ntuser_private.h
index 26bab84b2e7..e540f92ddf3 100644
--- a/dlls/win32u/ntuser_private.h
+++ b/dlls/win32u/ntuser_private.h
@@ -204,6 +204,7 @@ HICON alloc_cursoricon_handle( BOOL is_icon );
 /* dce.c */
 extern void free_dce( struct dce *dce, HWND hwnd, struct list *drawables );
 extern void invalidate_dce( WND *win, const RECT *old_rect );
+extern void invalidate_child_dces( HWND hwnd );
 extern BOOL is_cache_dc( HDC hdc );
 
 /* message.c */
diff --git a/include/ntuser.h b/include/ntuser.h
index c6470315157..7bf0e3fc71f 100644
--- a/include/ntuser.h
+++ b/include/ntuser.h
@@ -643,6 +643,7 @@ enum wine_internal_message
     WM_WINE_TRACKMOUSEEVENT,
     WM_WINE_SETPIXELFORMAT,
     WM_WINE_DISPLAYMODECHANGED,
+    WM_WINE_INVALIDATEDCE,
     WM_WINE_FIRST_DRIVER_MSG = 0x80001000,  /* range of messages reserved for the USER driver */
     WM_WINE_CLIPCURSOR = 0x80001ff0, /* internal driver notification messages */
     WM_WINE_SETCURSOR,
