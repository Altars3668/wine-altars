From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 23:08:47 -0400
Subject: [PATCH] include: Add ITaskSettings2, and IMonthlyTrigger's
 DaysOfMonth is a LONG.

A day of the month is one of 31 bits.  ITaskSettings2 carries the
DisallowStartOnRemoteAppSession and UseUnifiedSchedulingEngine settings that the Office
Click-to-Run tasks use.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 6b0f8bda928db28dbcde87f549ad9cce9a997b2b)

diff --git a/include/taskschd.idl b/include/taskschd.idl
index eaa71da4d45..7da1d95d367 100644
--- a/include/taskschd.idl
+++ b/include/taskschd.idl
@@ -350,6 +350,19 @@ interface ITaskSettings : IDispatch
     [propput] HRESULT NetworkSettings([in] INetworkSettings *settings);
 }
 
+[
+    object,
+    oleautomation,
+    uuid(2c05c3f0-6eed-4c05-a15f-ed7d7a98a369)
+]
+interface ITaskSettings2 : IDispatch
+{
+    [propget] HRESULT DisallowStartOnRemoteAppSession([out, retval] VARIANT_BOOL *disallow);
+    [propput] HRESULT DisallowStartOnRemoteAppSession([in] VARIANT_BOOL disallow);
+    [propget] HRESULT UseUnifiedSchedulingEngine([out, retval] VARIANT_BOOL *use);
+    [propput] HRESULT UseUnifiedSchedulingEngine([in] VARIANT_BOOL use);
+}
+
 [
     object,
     oleautomation,
@@ -557,8 +570,8 @@ interface IWeeklyTrigger : ITrigger
 ]
 interface IMonthlyTrigger : ITrigger
 {
-    [propget] HRESULT DaysOfMonth([out, retval] short *pDays);
-    [propput] HRESULT DaysOfMonth([in] short days);
+    [propget] HRESULT DaysOfMonth([out, retval] LONG *pDays);
+    [propput] HRESULT DaysOfMonth([in] LONG days);
     [propget] HRESULT MonthsOfYear([out, retval] short *pMonths);
     [propput] HRESULT MonthsOfYear([in] short months);
     [propget] HRESULT RunOnLastDayOfMonth([out, retval] VARIANT_BOOL *pLastDay);
