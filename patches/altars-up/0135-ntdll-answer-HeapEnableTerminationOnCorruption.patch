From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 13:16:30 -0400
Subject: [PATCH] ntdll: answer HeapEnableTerminationOnCorruption.

Word asks it, and Wine said the class was not implemented.  It is for
the whole process, a 64-bit process has it from the start, and
HeapSetInformation turns it on for any process: as Windows answers,
TRUE in a ULONG.  A corrupt heap here is still reported rather than the
end of the process.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 8ac455ac55cdf2b9060f2626a5e114541b269141)

diff --git a/dlls/kernel32/tests/heap.c b/dlls/kernel32/tests/heap.c
index 0b57bec4056..bbf76421501 100644
--- a/dlls/kernel32/tests/heap.c
+++ b/dlls/kernel32/tests/heap.c
@@ -867,6 +867,21 @@ static void test_HeapCreate(void)
     ok( ret, "HeapQueryInformation failed, error %lu\n", GetLastError() );
     ok( compat_info == 2, "got HeapCompatibilityInformation %lu\n", compat_info );
 
+    /* termination on corruption is for the whole process; a 64-bit process has it from the start */
+    compat_info = 0xdead;
+    size = 0;
+    ret = pHeapQueryInformation( GetProcessHeap(), HeapEnableTerminationOnCorruption, &compat_info,
+                                 sizeof(compat_info), &size );
+    ok( ret, "HeapQueryInformation failed, error %lu\n", GetLastError() );
+    ok( size == sizeof(compat_info), "got size %Iu\n", size );
+    if (sizeof(void *) == 8) ok( compat_info == 1, "got %lu\n", compat_info );
+    ret = pHeapSetInformation( NULL, HeapEnableTerminationOnCorruption, NULL, 0 );
+    ok( ret, "HeapSetInformation failed, error %lu\n", GetLastError() );
+    compat_info = 0xdead;
+    ret = pHeapQueryInformation( heap, HeapEnableTerminationOnCorruption, &compat_info, sizeof(compat_info), &size );
+    ok( ret, "HeapQueryInformation failed, error %lu\n", GetLastError() );
+    ok( compat_info == 1, "got %lu\n", compat_info );
+
     /* cannot be undone */
 
     compat_info = 0;
diff --git a/dlls/ntdll/heap.c b/dlls/ntdll/heap.c
index feee54e0285..ee89b5a2981 100644
--- a/dlls/ntdll/heap.c
+++ b/dlls/ntdll/heap.c
@@ -2556,6 +2556,14 @@ ULONG WINAPI RtlGetProcessHeaps( ULONG count, HANDLE *heaps )
 /***********************************************************************
  *           RtlQueryHeapInformation    (NTDLL.@)
  */
+/* Termination on corruption is for the whole process, and a 64-bit process has it from the start, as on
+ * Windows; it is kept and answered, but a corrupt heap here is reported, not the end of the process. */
+#ifdef _WIN64
+static LONG terminate_on_corruption = TRUE;
+#else
+static LONG terminate_on_corruption;
+#endif
+
 NTSTATUS WINAPI RtlQueryHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS info_class,
                                          void *info, SIZE_T size_in, SIZE_T *size_out )
 {
@@ -2573,6 +2581,12 @@ NTSTATUS WINAPI RtlQueryHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS i
         *(ULONG *)info = ReadNoFence( &heap->compat_info );
         return STATUS_SUCCESS;
 
+    case HeapEnableTerminationOnCorruption:
+        if (size_out) *size_out = sizeof(ULONG);
+        if (size_in < sizeof(ULONG)) return STATUS_BUFFER_TOO_SMALL;
+        *(ULONG *)info = ReadNoFence( &terminate_on_corruption );
+        return STATUS_SUCCESS;
+
     default:
         FIXME( "HEAP_INFORMATION_CLASS %u not implemented!\n", info_class );
         return STATUS_INVALID_INFO_CLASS;
@@ -2619,6 +2633,10 @@ NTSTATUS WINAPI RtlSetHeapInformation( HANDLE handle, HEAP_INFORMATION_CLASS inf
         return STATUS_SUCCESS;
     }
 
+    case HeapEnableTerminationOnCorruption:
+        WriteNoFence( &terminate_on_corruption, TRUE );
+        return STATUS_SUCCESS;
+
     default:
         FIXME( "HEAP_INFORMATION_CLASS %u not implemented!\n", info_class );
         return STATUS_SUCCESS;
