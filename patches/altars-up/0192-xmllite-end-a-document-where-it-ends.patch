-        if (buffer->written < 3) return MX_E_INPUTEND;
     }
 
     ptrW = (WCHAR *)buffer->data;
@@ -931,6 +930,9 @@ static HRESULT readerinput_detectencoding(xmlreaderinput *readerinput, xml_encod
         buffer->cur += sizeof(utf16lebom);
