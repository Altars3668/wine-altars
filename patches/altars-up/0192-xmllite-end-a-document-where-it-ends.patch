     hr = IXmlReader_Read(reader, &nodetype);
-    todo_wine
     ok(FAILED(hr), "Unexpected hr %#lx.\n", hr);
     ok(nodetype == XmlNodeType_None, "Unexpected node type %d\n", nodetype);
 
-    todo_wine
     TEST_READER_STATE(reader, XmlReadState_Error);
 
     nodetype = XmlNodeType_Element;
     hr = IXmlReader_Read(reader, &nodetype);
-    todo_wine
     ok(FAILED(hr), "Unexpected hr %#lx.\n", hr);
     ok(nodetype == XmlNodeType_None, "Unexpected node type %d\n", nodetype);
 
@@ -2976,6 +2973,182 @@ static void test_utf16_chunks(void)
     free(xml);
 }
 
+/* Where a document ends: the nodes before the end, then what Read says there, again on every later call. */
+static void test_document_end(void)
+{
+    static const struct
+    {
+        const char *xml;
+        XmlNodeType types[5];
+        HRESULT hr;
+        const WCHAR *text;
+    }
+    tests[] =
+    {
+        { "<a><b>", { XmlNodeType_Element, XmlNodeType_Element }, MX_E_INPUTEND },
+        { "<a><b/>", { XmlNodeType_Element, XmlNodeType_Element }, MX_E_INPUTEND },
+        { "<a>text", { XmlNodeType_Element, XmlNodeType_Text }, MX_E_INPUTEND, L"text" },
+        { "<a><b></b>", { XmlNodeType_Element, XmlNodeType_Element, XmlNodeType_EndElement }, MX_E_INPUTEND },
+        { "<a>&amp;", { XmlNodeType_Element, XmlNodeType_Text }, MX_E_INPUTEND, L"&" },
+        { "<a>t<", { XmlNodeType_Element, XmlNodeType_Text }, MX_E_INPUTEND, L"t" },
+        { "<a><!-- c -->", { XmlNodeType_Element, XmlNodeType_Comment }, MX_E_INPUTEND },
+        { "<?xml version=\"1.0\"?><a>", { XmlNodeType_XmlDeclaration, XmlNodeType_Element }, MX_E_INPUTEND },
+        { "<a><b x=\"1\"", { XmlNodeType_Element }, MX_E_INPUTEND },
+        { "<a/><", { XmlNodeType_Element }, MX_E_INPUTEND },
+        { "<a", { XmlNodeType_None }, NC_E_QNAMECHARACTER },
+        { "<a></b", { XmlNodeType_Element }, NC_E_QNAMECHARACTER },
+        { "<a></a", { XmlNodeType_Element }, NC_E_QNAMECHARACTER },
+        { "<a><![CDATA[x", { XmlNodeType_Element }, WC_E_CDSECT },
+        { "<a><!-- c", { XmlNodeType_Element }, WC_E_COMMENT },
+        { "<a><?p x", { XmlNodeType_Element }, WC_E_PI },
+        { "", { XmlNodeType_None }, WC_E_ROOTELEMENT },
+        { " ", { XmlNodeType_Whitespace }, WC_E_ROOTELEMENT },
+        { "<?xml version=\"1.0\"?>", { XmlNodeType_XmlDeclaration }, WC_E_ROOTELEMENT },
+        { "<!-- c -->", { XmlNodeType_Comment }, WC_E_ROOTELEMENT },
+        { "<a></a><b/>", { XmlNodeType_Element, XmlNodeType_EndElement }, WC_E_ROOTELEMENT },
+        { "<a></a><![CDATA[x]]>", { XmlNodeType_Element, XmlNodeType_EndElement }, WC_E_ROOTELEMENT },
+        { "<a></a></b>", { XmlNodeType_Element, XmlNodeType_EndElement }, NC_E_QNAMECHARACTER },
+        { "<a></a>trailing", { XmlNodeType_Element, XmlNodeType_EndElement }, WC_E_SYNTAX },
+        { "x<a/>", { XmlNodeType_None }, WC_E_SYNTAX },
+        { "<a/><?xml version=\"1.0\"?>", { XmlNodeType_Element }, WC_E_TEXTXMLDECL },
+        { "<a><?xml version=\"1.0\"?></a>", { XmlNodeType_Element }, WC_E_TEXTXMLDECL },
+        { "<!-- c --><?xml version=\"1.0\"?><a/>", { XmlNodeType_Comment }, WC_E_TEXTXMLDECL },
+        { "<a><?XML x?></a>", { XmlNodeType_Element }, WC_E_TEXTXMLDECL },
+        { "<a/>", { XmlNodeType_Element }, S_FALSE },
+        { "<a></a><!-- c --><?p?> ", { XmlNodeType_Element, XmlNodeType_EndElement, XmlNodeType_Comment,
+                XmlNodeType_ProcessingInstruction, XmlNodeType_Whitespace }, S_FALSE },
+    };
+    unsigned int i, j, n, len;
+    const WCHAR *value;
+    IXmlReader *reader;
+    XmlNodeType type;
+    IStream *stream;
+    WCHAR *wide;
+    HRESULT hr;
+
+    hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        for (j = 0; j < 2; ++j)
+        {
+            /* without a byte order mark, UTF-16 is told by the '<' the document starts with */
+            if (j && tests[i].xml[0] != '<') continue;
+            winetest_push_context("%s %s", j ? "UTF-16" : "UTF-8", debugstr_a(tests[i].xml));
+
+            len = strlen(tests[i].xml);
+            if (j)
+            {
+                wide = malloc((len + 1) * sizeof(WCHAR));
+                MultiByteToWideChar(CP_UTF8, 0, tests[i].xml, len + 1, wide, len + 1);
+                stream = create_stream_on_data(wide, len * sizeof(WCHAR));
+                free(wide);
+            }
+            else stream = create_stream_on_data(tests[i].xml, len);
+
+            hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+            for (n = 0; n < ARRAY_SIZE(tests[i].types) && tests[i].types[n] != XmlNodeType_None; ++n)
+            {
+                type = XmlNodeType_None;
+                hr = IXmlReader_Read(reader, &type);
+                ok(hr == S_OK, "Node %u: unexpected hr %#lx.\n", n, hr);
+                ok(type == tests[i].types[n], "Node %u: got type %d, expected %d.\n", n, type, tests[i].types[n]);
+                if (type == XmlNodeType_Text)
+                {
+                    hr = IXmlReader_GetValue(reader, &value, NULL);
+                    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+                    ok(!wcscmp(value, tests[i].text), "Got text %s.\n", debugstr_w(value));
+                }
+            }
+            /* the end, and the same end again */
+            for (n = 0; n < 2; ++n)
+            {
+                type = XmlNodeType_Element;
+                hr = IXmlReader_Read(reader, &type);
+                ok(hr == tests[i].hr, "Got hr %#lx, expected %#lx.\n", hr, tests[i].hr);
+                ok(type == XmlNodeType_None, "Got type %d.\n", type);
+            }
+
+            IXmlReader_SetInput(reader, NULL);
+            IStream_Release(stream);
+            winetest_pop_context();
+        }
+    }
+
+    IXmlReader_Release(reader);
+}
+
+/* The markup that ends a comment, a section or an instruction can lie across two of the chunks read from the
+ * stream: the characters before the boundary do not end it by themselves. */
+static void test_markup_end_chunk_boundary(void)
+{
+    static const struct
+    {
+        const char *start, *end;
+        XmlNodeType type;
+    }
+    tests[] =
+    {
+        { "<a><!--", "--></a>", XmlNodeType_Comment },
+        { "<a><![CDATA[", "]]></a>", XmlNodeType_CDATA },
+        { "<a><?p ", "?></a>", XmlNodeType_ProcessingInstruction },
+    };
+    /* what the first read asks for, and so how far the first chunk goes */
+    const unsigned int chunk = 8188;
+    unsigned int i, j, k, size, filler, len;
+    const WCHAR *value;
+    IXmlReader *reader;
+    XmlNodeType type;
+    IStream *stream;
+    HRESULT hr;
+    char *xml;
+
+    hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        /* the first character of the end markup is the last of the chunk, and then the one before it */
+        for (j = 0; j < 2; ++j)
+        {
+            winetest_push_context("%s %u", debugstr_a(tests[i].start), j);
+
+            filler = chunk - 1 - j - strlen(tests[i].start);
+            size = strlen(tests[i].start) + filler + strlen(tests[i].end);
+            xml = malloc(size);
+            strcpy(xml, tests[i].start);
+            memset(xml + strlen(tests[i].start), 'x', filler);
+            memcpy(xml + strlen(tests[i].start) + filler, tests[i].end, strlen(tests[i].end));
+
+            stream = create_stream_on_data(xml, size);
+            hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+            k = 0;
+            while ((hr = IXmlReader_Read(reader, &type)) == S_OK)
+            {
+                if (type != tests[i].type) continue;
+                hr = IXmlReader_GetValue(reader, &value, &len);
+                ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+                ok(len == filler, "Got %u characters, expected %u.\n", len, filler);
+                k++;
+            }
+            ok(hr == S_FALSE, "Got hr %#lx.\n", hr);
+            ok(k == 1, "Got %u nodes.\n", k);
+
+            IXmlReader_SetInput(reader, NULL);
+            IStream_Release(stream);
+            free(xml);
+            winetest_pop_context();
+        }
+    }
+
+    IXmlReader_Release(reader);
+}
+
 START_TEST(reader)
 {
     test_reader_create();
@@ -3007,4 +3180,6 @@ START_TEST(reader)
     test_attribute_by_name();
     test_multibyte_chunk_boundary();
     test_utf16_chunks();
+    test_document_end();
+    test_markup_end_chunk_boundary();
 }
