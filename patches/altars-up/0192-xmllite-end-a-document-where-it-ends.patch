 }
 
-/* note that raw buffer content is kept */
-static void readerinput_switchencoding(xmlreaderinput *readerinput, xml_encoding enc)
+/* Converts all that the raw buffer holds, from where the data begins, in place of what was
+   converted before: until the declaration has been read the raw data is kept, since the
+   encoding it names may have to convert it again. */
+static void readerinput_convert_all(xmlreaderinput *readerinput)
 {
     encoded_buffer *src = &readerinput->buffer->encoded;
     encoded_buffer *dest = &readerinput->buffer->utf16;
     int len, dest_len;
-    UINT cp = ~0u;
-    HRESULT hr;
     WCHAR *ptr;
 
-    hr = get_code_page(enc, &cp);
-    if (FAILED(hr)) return;
-
-    readerinput->buffer->code_page = cp;
     len = readerinput_get_convlen(readerinput);
-
-    TRACE("switching to cp %d\n", cp);
+    dest->written = 0;
+    dest->prev_cr = FALSE;
 
     /* just copy in this case */
-    if (enc == XmlEncoding_UTF16)
+    if (readerinput->buffer->code_page == 1200)
     {
         readerinput_grow(readerinput, len);
         memcpy(dest->data, src->data + src->cur, len);
-        dest->written += len;
+        dest->written = len;
     }
     else
     {
@@ -1149,12 +1147,23 @@ static void readerinput_switchencoding(xmlreaderinput *readerinput, xml_encoding
         ptr = (WCHAR*)dest->data;
         readerinput_convert(readerinput, src->data + src->cur, len, ptr, dest_len);
         ptr[dest_len] = 0;
-        dest->written += dest_len*sizeof(WCHAR);
+        dest->written = dest_len*sizeof(WCHAR);
     }
 
     fixup_buffer_cr(dest, 0);
 }
 
+static void readerinput_switchencoding(xmlreaderinput *readerinput, xml_encoding enc)
+{
+    UINT cp = ~0u;
+
+    if (FAILED(get_code_page(enc, &cp))) return;
+
+    TRACE("switching to cp %d\n", cp);
+    readerinput->buffer->code_page = cp;
+    readerinput_convert_all(readerinput);
+}
+
 /* shrinks parsed data a buffer begins with */
 static void reader_shrink(xmlreader *reader)
 {
@@ -1186,6 +1195,13 @@ static HRESULT reader_more(xmlreader *reader)
     if (FAILED(hr = readerinput_growraw(readerinput)))
         return hr;
 
+    /* what was read before is still there and was converted already; do it again whole */
+    if (reader->instate == XmlReadInState_Initial)
+    {
+        readerinput_convert_all(readerinput);
+        return hr;
+    }
+
     len = readerinput_get_convlen(readerinput);
     prev_len = dest->written / sizeof(WCHAR);
 
@@ -1685,39 +1701,36 @@ static HRESULT reader_parse_comment(xmlreader *reader)
         reader_set_strvalue(reader, StringValue_Value, NULL);
     }
 
-    /* will exit when there's no more data, it won't attempt to
-       read more from stream */
+    /* will exit when there's no more data now; the end of the markup may be in what comes next */
     while (*ptr)
     {
-        if (ptr[0] == '-')
+        if (ptr[0] == '-' && !reader_cmp(reader, L"--"))
         {
-            if (ptr[1] == '-')
+            if (!reader_cmp(reader, L"-->"))
             {
-                if (ptr[2] == '>')
-                {
-                    strval value;
+                strval value;
 
-                    reader_init_strvalue(start, reader_get_cur(reader)-start, &value);
-                    TRACE("%s\n", debug_strval(reader, &value));
+                reader_init_strvalue(start, reader_get_cur(reader)-start, &value);
+                TRACE("%s\n", debug_strval(reader, &value));
 
-                    /* skip rest of markup '->' */
-                    reader_skipn(reader, 3);
+                /* skip rest of markup '->' */
+                reader_skipn(reader, 3);
 
-                    reader_set_strvalue(reader, StringValue_Value, &value);
-                    reader->resume[XmlReadResume_Body] = 0;
-                    reader->resumestate = XmlReadResumeState_Initial;
-                    return S_OK;
-                }
-                else
-                    return WC_E_COMMENT;
+                reader_set_strvalue(reader, StringValue_Value, &value);
+                reader->resume[XmlReadResume_Body] = 0;
+                reader->resumestate = XmlReadResumeState_Initial;
+                return S_OK;
             }
+            else
+                return WC_E_COMMENT;
         }
 
         reader_skipn(reader, 1);
-        ptr++;
+        ptr = reader_get_ptr(reader);
     }
 
-    return S_OK;
+    /* the document ends in the comment */
+    return is_reader_pending(reader) ? S_OK : WC_E_COMMENT;
 }
 
 /* [13] PubidChar ::= #x20 | #xD | #xA | [a-zA-Z0-9] | [-'()+,./:=?;!*#@$_%] */
@@ -1841,7 +1854,6 @@ static HRESULT reader_parse_name(xmlreader *reader, strval *name)
 /* [17] PITarget ::= Name - (('X' | 'x') ('M' | 'm') ('L' | 'l')) */
 static HRESULT reader_parse_pitarget(xmlreader *reader, strval *target)
 {
-    static const strval xmlval = { (WCHAR *)L"xml", 3 };
     strval name;
     WCHAR *ptr;
     HRESULT hr;
@@ -1850,9 +1862,10 @@ static HRESULT reader_parse_pitarget(xmlreader *reader, strval *target)
     hr = reader_parse_name(reader, &name);
     if (FAILED(hr)) return is_reader_pending(reader) ? E_PENDING : WC_E_PI;
 
-    /* now that we got name check for illegal content */
-    if (strval_eq(reader, &name, &xmlval))
-        return WC_E_LEADINGXML;
+    /* now that we got name check for illegal content: in any case, it is a declaration somewhere
+       other than at the start */
+    if (name.len == 3 && !wcsnicmp(reader_get_strptr(reader, &name), L"xml", 3))
+        return WC_E_TEXTXMLDECL;
 
     /* PITarget can't be a qualified name */
     ptr = reader_get_strptr(reader, &name);
@@ -1898,7 +1911,7 @@ static HRESULT reader_parse_pi(xmlreader *reader)
     {
         if (ptr[0] == '?')
         {
-            if (ptr[1] == '>')
+            if (!reader_cmp(reader, L"?>"))
             {
                 UINT cur = reader_get_cur(reader);
                 strval value;
@@ -1928,7 +1941,8 @@ static HRESULT reader_parse_pi(xmlreader *reader)
         ptr = reader_get_ptr(reader);
     }
 
-    return S_OK;
+    /* the document ends in the instruction */
+    return is_reader_pending(reader) ? S_OK : WC_E_PI;
 }
 
 /* This one is used to parse significant whitespace nodes, like in Misc production */
@@ -2192,6 +2206,8 @@ static HRESULT reader_parse_local(xmlreader *reader, strval *local, BOOL check_f
     else
          reader->resume[XmlReadResume_Local] = 0;
 
+    if (!*ptr) return NC_E_QNAMECHARACTER;
+
     reader_init_strvalue(start, reader_get_cur(reader)-start, local);
 
     return S_OK;
@@ -2217,6 +2233,7 @@ static HRESULT reader_parse_qname(xmlreader *reader, strval *prefix, strval *loc
         ptr = reader_get_ptr(reader);
         start = reader_get_cur(reader);
         reader->resume[XmlReadResume_Name] = start;
+        if (!*ptr) return is_reader_pending(reader) ? E_PENDING : MX_E_INPUTEND;
         if (!is_ncnamechar(*ptr)) return NC_E_QNAMECHARACTER;
     }
 
@@ -2239,6 +2256,8 @@ static HRESULT reader_parse_qname(xmlreader *reader, strval *prefix, strval *loc
         }
 
         if (is_reader_pending(reader)) return E_PENDING;
+        /* a name ends in something, not in the end of the document */
+        if (!*ptr) return NC_E_QNAMECHARACTER;
 
         /* got a qualified name */
         if (*ptr == ':')
@@ -2648,7 +2667,7 @@ static HRESULT reader_parse_cdata(xmlreader *reader)
 
     while (*ptr)
     {
-        if (*ptr == ']' && *(ptr+1) == ']' && *(ptr+2) == '>')
+        if (*ptr == ']' && !reader_cmp(reader, L"]]>"))
         {
             strval value;
 
@@ -2670,7 +2689,8 @@ static HRESULT reader_parse_cdata(xmlreader *reader)
         }
     }
 
-    return S_OK;
+    /* the document ends in the section */
+    return is_reader_pending(reader) ? S_OK : WC_E_CDSECT;
 }
 
 /* [14] CharData ::= [^<&]* - ([^<&]* ']]>' [^<&]*) */
@@ -2702,7 +2722,7 @@ static HRESULT reader_parse_chardata(xmlreader *reader)
     while (*ptr)
     {
         /* CDATA closing sequence ']]>' is not allowed */
-        if (ptr[0] == ']' && ptr[1] == ']' && ptr[2] == '>')
+        if (ptr[0] == ']' && !reader_cmp(reader, L"]]>"))
             return WC_E_CDSECTEND;
 
         /* Found next markup part */
@@ -2731,6 +2751,18 @@ static HRESULT reader_parse_chardata(xmlreader *reader)
         ptr = reader_get_ptr(reader);
     }
 
+    /* the document ends in the text, so this is all of it; the next read finds the end */
+    if (!is_reader_pending(reader))
+    {
+        strval value;
+
+        reader->empty_element.position = position;
+        reader_init_strvalue(start, reader_get_cur(reader)-start, &value);
+        reader_set_strvalue(reader, StringValue_Value, &value);
+        reader->resume[XmlReadResume_Body] = 0;
+        reader->resumestate = XmlReadResumeState_Initial;
+    }
+
     return S_OK;
 }
 
@@ -2757,6 +2789,10 @@ static HRESULT reader_parse_content(xmlreader *reader)
 
     reader_shrink(reader);
 
+    /* the document ended with elements still open */
+    if (!*reader_get_ptr(reader))
+        return is_reader_pending(reader) ? E_PENDING : MX_E_INPUTEND;
+
     /* handle end tag here, it indicates end of content as well */
     if (!reader_cmp(reader, L"</"))
         return reader_parse_endtag(reader);
@@ -2818,6 +2854,8 @@ static HRESULT reader_parse_nextnode(xmlreader *reader)
                 xml_encoding enc;
 
                 hr = readerinput_growraw(reader->input);
+                /* nothing at all, so no root element */
+                if (hr == MX_E_INPUTEND) return WC_E_ROOTELEMENT;
                 if (FAILED(hr)) return hr;
 
                 reader->position.line_number = 1;
@@ -2874,7 +2912,11 @@ static HRESULT reader_parse_nextnode(xmlreader *reader)
                 return hr;
             break;
         case XmlReadInState_Element:
-            return reader_parse_element(reader);
+            hr = reader_parse_element(reader);
+            if (hr != S_FALSE) return hr;
+            if (is_reader_pending(reader)) return E_PENDING;
+            /* no root element, or something else where it should be */
+            return *reader_get_ptr(reader) ? WC_E_SYNTAX : WC_E_ROOTELEMENT;
         case XmlReadInState_Content:
             return reader_parse_content(reader);
         case XmlReadInState_MiscEnd:
@@ -2884,7 +2926,11 @@ static HRESULT reader_parse_nextnode(xmlreader *reader)
             if (*reader_get_ptr(reader))
             {
                 WARN("found garbage in the end of XML\n");
-                return WC_E_SYNTAX;
+                if (reader_cmp(reader, L"<")) return WC_E_SYNTAX;
+                /* markup, but the document had its element: an end tag without a start, or another one */
+                if (!reader_cmp(reader, L"</")) return NC_E_QNAMECHARACTER;
+                if (!reader_get_ptr(reader)[1]) return is_reader_pending(reader) ? E_PENDING : MX_E_INPUTEND;
+                return WC_E_ROOTELEMENT;
             }
 
             reader->instate = XmlReadInState_Eof;
diff --git a/dlls/xmllite/tests/reader.c b/dlls/xmllite/tests/reader.c
