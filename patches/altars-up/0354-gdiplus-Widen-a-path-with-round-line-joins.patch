From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:48:45 -0400
Subject: [PATCH] gdiplus: Widen a path with round line joins.

An arc around the outer side of the corner, from where one edge ends to
where the next starts, in Bezier curves of at most 90 degrees as the
round cap has them; the inner side keeps its bevel.  Office widens paths
with round joins, which came out bevelled.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/gdiplus/graphicspath.c b/dlls/gdiplus/graphicspath.c
index 33128f9e48c..9c48534c27c 100644
--- a/dlls/gdiplus/graphicspath.c
+++ b/dlls/gdiplus/graphicspath.c
@@ -2041,6 +2041,38 @@ static void widen_joint(const GpPointF *p1, const GpPointF *p2, const GpPointF *
         add_bevel_point(p2, p1, pen_width, 1, last_point);
         add_bevel_point(p2, p3, pen_width, 0, last_point);
         break;
+    case LineJoinRound:
+        if ((p2->X - p1->X) * (p3->Y - p1->Y) > (p2->Y - p1->Y) * (p3->X - p1->X))
+        {
+            /* an arc around the corner from where the edge before it ends to where the next one
+             * starts, in Bezier curves of at most 90 degrees */
+            REAL radius = pen_width / 2.0, start, sweep, k, a0, a1;
+            int i, count;
+
+            start = atan2f(p1->X - p2->X, p2->Y - p1->Y);
+            sweep = atan2f(p2->X - p3->X, p3->Y - p2->Y) - start;
+            if (sweep > M_PI) sweep -= 2 * M_PI;
+            else if (sweep <= -M_PI) sweep += 2 * M_PI;
+            count = ceilf(fabsf(sweep) / (M_PI / 2));
+            add_bevel_point(p2, p1, pen_width, 1, last_point);
+            if (!count) break;
+            k = 4.0f / 3.0f * tanf(sweep / count / 4) * radius;
+            for (i = 0; i < count; i++)
+            {
+                a0 = start + sweep * i / count;
+                a1 = start + sweep * (i + 1) / count;
+                *last_point = add_path_list_node(*last_point, p2->X + radius * cosf(a0) - k * sinf(a0),
+                    p2->Y + radius * sinf(a0) + k * cosf(a0), PathPointTypeBezier);
+                *last_point = add_path_list_node(*last_point, p2->X + radius * cosf(a1) + k * sinf(a1),
+                    p2->Y + radius * sinf(a1) - k * cosf(a1), PathPointTypeBezier);
+                *last_point = add_path_list_node(*last_point, p2->X + radius * cosf(a1),
+                    p2->Y + radius * sinf(a1), PathPointTypeBezier);
+            }
+            break;
+        }
+        add_bevel_point(p2, p1, pen_width, 1, last_point);
+        add_bevel_point(p2, p3, pen_width, 0, last_point);
+        break;
     }
 }
 
@@ -2739,9 +2771,6 @@ GpStatus WINGDIPAPI GdipWidenPath(GpPath *path, GpPen *pen, GpMatrix *matrix,
         if (pen->dashcap != DashCapFlat)
             FIXME("unimplemented dash cap %d\n", pen->dashcap);
 
-        if (pen->join == LineJoinRound)
-            FIXME("unimplemented line join %d\n", pen->join);
-
         if (pen->align != PenAlignmentCenter)
             FIXME("unimplemented pen alignment %d\n", pen->align);
 
