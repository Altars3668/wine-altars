From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 22:56:12 -0400
Subject: [PATCH] kernel32: Answer that user-mode CET is not available.

GFX.DLL, and MSO.DLL next to the settings of its protected-view sandbox, look up
IsUserCetAvailableInEnvironment() in kernel32.  Wine keeps no shadow stacks, neither for a process
nor for an enclave, so the answer is FALSE for every environment; what Windows does with the last
error for a value that is no environment is measured by tools/win10apiprobe.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/kernel32/kernel32.spec b/dlls/kernel32/kernel32.spec
index a94c9ac8510..7c1e9af0fd8 100644
--- a/dlls/kernel32/kernel32.spec
+++ b/dlls/kernel32/kernel32.spec
@@ -1021,6 +1021,7 @@
 @ stdcall -import IsThreadAFiber()
 @ stdcall IsThreadpoolTimerSet(ptr) NTDLL.TpIsTimerSet
 # @ stub IsTimeZoneRedirectionEnabled
+@ stdcall IsUserCetAvailableInEnvironment(long)
 # @ stub IsValidCalDateTime
 @ stdcall -import IsValidCodePage(long)
 @ stdcall -import IsValidLanguageGroup(long long)
diff --git a/dlls/kernel32/process.c b/dlls/kernel32/process.c
index 9bbb18d89dc..17c69f43307 100644
--- a/dlls/kernel32/process.c
+++ b/dlls/kernel32/process.c
@@ -885,6 +885,17 @@ BOOL WINAPI GetProcessDEPPolicy(HANDLE process, LPDWORD flags, PBOOL permanent)
     return TRUE;
 }
 
+/**********************************************************************
+ *           IsUserCetAvailableInEnvironment     (KERNEL32.@)
+ *
+ * Wine keeps no shadow stacks, neither for a process nor for an enclave.
+ */
+BOOL WINAPI IsUserCetAvailableInEnvironment( DWORD environment )
+{
+    TRACE( "%#lx\n", environment );
+    return FALSE;
+}
+
 /***********************************************************************
  *           UnregisterApplicationRestart       (KERNEL32.@)
  */
diff --git a/include/winbase.h b/include/winbase.h
index b6b908ed372..f6022614126 100644
--- a/include/winbase.h
+++ b/include/winbase.h
@@ -1213,6 +1213,11 @@ typedef enum _DEP_SYSTEM_POLICY_TYPE {
 #define PROCESS_DEP_ENABLE 1
 #define PROCESS_DEP_DISABLE_ATL_THUNK_EMULATION 2
 
+#define USER_CET_ENVIRONMENT_WIN32_PROCESS     0x00000000
+#define USER_CET_ENVIRONMENT_SGX2_ENCLAVE      0x00000002
+#define USER_CET_ENVIRONMENT_VBS_ENCLAVE       0x00000010
+#define USER_CET_ENVIRONMENT_VBS_BASIC_ENCLAVE 0x00000011
+
 /* Event Logging */
 
 #define EVENTLOG_FULL_INFO          0
@@ -2047,6 +2052,7 @@ WINADVAPI  BOOL        WINAPI ImpersonateLoggedOnUser(HANDLE);
 WINADVAPI  BOOL        WINAPI ImpersonateNamedPipeClient(HANDLE);
 WINADVAPI  BOOL        WINAPI ImpersonateSelf(SECURITY_IMPERSONATION_LEVEL);
 WINBASEAPI BOOL        WINAPI IsProcessInJob(HANDLE,HANDLE,PBOOL);
+WINBASEAPI BOOL        WINAPI IsUserCetAvailableInEnvironment(DWORD);
 WINBASEAPI void        WINAPI LeaveCriticalSection(CRITICAL_SECTION *lpCrit);
 WINBASEAPI HMODULE     WINAPI LoadLibraryA(LPCSTR);
 WINBASEAPI HMODULE     WINAPI LoadLibraryW(LPCWSTR);
