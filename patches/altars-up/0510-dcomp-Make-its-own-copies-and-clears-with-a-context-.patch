index df8b6b76f14..383059b8be0 100644
--- a/dlls/dcomp/private.h
+++ b/dlls/dcomp/private.h
@@ -32,7 +32,7 @@
 #include "activation.h"
 #include "roapi.h"
 
-#include "d3d11.h"
+#include "d3d11_1.h"
 #include "dxgi1_2.h"
 #include "d2d1_3.h"
 
@@ -472,6 +472,7 @@ struct graphics_device
     ICompositionGraphicsDeviceInterop ICompositionGraphicsDeviceInterop_iface;
     IUnknown *rendering_device;     /* as the application gave it */
     ID3D11Device *d3d_device;
+    ID3DDeviceContextState *d3d_state;  /* what the calls of our own on it are made with */
     ID2D1Device *d2d_device;
     ID2D1Multithread *multithread;  /* the lock of the device's Direct2D factory */
     ID2D1DeviceContext *context;    /* what BeginDraw hands out, one surface at a time */
@@ -492,8 +493,13 @@ struct mirror
     ID3D11Texture2D *texture;
     ID3D11Device *device;
     UINT version;
+    ID3DDeviceContextState *own_state, *state;  /* for the calls on the source's device and on this one */
 };
 
+extern ID3D11DeviceContext1 *begin_d3d_calls( ID3D11Device *device, ID3DDeviceContextState **state,
+                                              ID3DDeviceContextState **prev );
+extern void end_d3d_calls( ID3D11DeviceContext1 *context, ID3DDeviceContextState *prev );
+
 extern HRESULT mirror_texture( struct mirror *mirror, ID3D11Texture2D *source, UINT version, ID3D11Device *device,
                                ID3D11Texture2D **out );
 extern void mirror_release( struct mirror *mirror );
diff --git a/dlls/dcomp/surface.c b/dlls/dcomp/surface.c
index 61f26b45c00..28d8d223333 100644
--- a/dlls/dcomp/surface.c
+++ b/dlls/dcomp/surface.c
@@ -87,16 +87,65 @@ static HRESULT texture_create( ID3D11Device *device, UINT width, UINT height, Di
     return hr;
 }
 
-static void texture_clear( ID3D11Device *device, ID3D11Texture2D *texture )
+/*
+ * The D3D11 calls of our own go through a state of our own: an application's device may have a state emulating
+ * ID3D10Device active, which drops them.  The state is made the first time, and again for another device.
+ */
+ID3D11DeviceContext1 *begin_d3d_calls( ID3D11Device *device, ID3DDeviceContextState **state,
+                                       ID3DDeviceContextState **prev )
+{
+    ID3D11DeviceContext1 *context;
+    ID3D11Device1 *device1;
+    ID3D11Device *owner;
+
+    *prev = NULL;
+    if (FAILED(ID3D11Device_QueryInterface( device, &IID_ID3D11Device1, (void **)&device1 ))) return NULL;
+    if (*state)
+    {
+        ID3DDeviceContextState_GetDevice( *state, &owner );
+        ID3D11Device_Release( owner );
+        if (owner != device)
+        {
+            ID3DDeviceContextState_Release( *state );
+            *state = NULL;
+        }
+    }
+    if (!*state)
+    {
+        D3D_FEATURE_LEVEL level = ID3D11Device1_GetFeatureLevel( device1 );
+
+        if (FAILED(ID3D11Device1_CreateDeviceContextState( device1, 0, &level, 1, D3D11_SDK_VERSION,
+                                                            &IID_ID3D11Device1, NULL, state )))
+            *state = NULL;
+    }
+    ID3D11Device1_GetImmediateContext1( device1, &context );
+    ID3D11Device1_Release( device1 );
+    if (*state) ID3D11DeviceContext1_SwapDeviceContextState( context, *state, prev );
+    return context;
+}
+
+void end_d3d_calls( ID3D11DeviceContext1 *context, ID3DDeviceContextState *prev )
+{
+    if (!context) return;
+    if (prev)
+    {
+        ID3D11DeviceContext1_SwapDeviceContextState( context, prev, NULL );
+        ID3DDeviceContextState_Release( prev );
+    }
+    ID3D11DeviceContext1_Release( context );
+}
+
+static void texture_clear( struct graphics_device *device, ID3D11Texture2D *texture )
 {
     static const float zero[4];
+    ID3DDeviceContextState *prev;
     ID3D11RenderTargetView *view;
-    ID3D11DeviceContext *context;
+    ID3D11DeviceContext1 *context;
 
-    if (FAILED(ID3D11Device_CreateRenderTargetView( device, (ID3D11Resource *)texture, NULL, &view ))) return;
-    ID3D11Device_GetImmediateContext( device, &context );
-    ID3D11DeviceContext_ClearRenderTargetView( context, view, zero );
-    ID3D11DeviceContext_Release( context );
+    if (FAILED(ID3D11Device_CreateRenderTargetView( device->d3d_device, (ID3D11Resource *)texture, NULL, &view ))) return;
+    if ((context = begin_d3d_calls( device->d3d_device, &device->d3d_state, &prev )))
+        ID3D11DeviceContext1_ClearRenderTargetView( context, view, zero );
+    end_d3d_calls( context, prev );
     ID3D11RenderTargetView_Release( view );
 }
 
@@ -106,8 +155,11 @@ void mirror_release( struct mirror *mirror )
 {
     if (mirror->texture) ID3D11Texture2D_Release( mirror->texture );
     if (mirror->device) ID3D11Device_Release( mirror->device );
+    if (mirror->own_state) ID3DDeviceContextState_Release( mirror->own_state );
+    if (mirror->state) ID3DDeviceContextState_Release( mirror->state );
     mirror->texture = NULL;
     mirror->device = NULL;
+    mirror->own_state = mirror->state = NULL;
 }
 
