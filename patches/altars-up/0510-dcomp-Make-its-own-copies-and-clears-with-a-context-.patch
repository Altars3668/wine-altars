     ID3D11Texture2D *staging;
@@ -156,18 +209,22 @@ HRESULT mirror_texture( struct mirror *mirror, ID3D11Texture2D *source, UINT ver
         hr = ID3D11Device_CreateTexture2D( own, &desc, NULL, &staging );
         if (SUCCEEDED(hr))
         {
-            ID3D11Device_GetImmediateContext( own, &own_context );
-            ID3D11DeviceContext_CopyResource( own_context, (ID3D11Resource *)staging, (ID3D11Resource *)source );
-            if (SUCCEEDED(hr = ID3D11DeviceContext_Map( own_context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map )))
+            if (!(own_context = begin_d3d_calls( own, &mirror->own_state, &own_prev ))) hr = E_FAIL;
+            else
             {
-                ID3D11Device_GetImmediateContext( device, &context );
-                ID3D11DeviceContext_UpdateSubresource( context, (ID3D11Resource *)mirror->texture, 0, NULL, map.pData,
-                                                       map.RowPitch, 0 );
-                ID3D11DeviceContext_Release( context );
-                ID3D11DeviceContext_Unmap( own_context, (ID3D11Resource *)staging, 0 );
-                mirror->version = version;
+                ID3D11DeviceContext1_CopyResource( own_context, (ID3D11Resource *)staging, (ID3D11Resource *)source );
+                if (SUCCEEDED(hr = ID3D11DeviceContext1_Map( own_context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ,
+                                                             0, &map )))
+                {
+                    if ((context = begin_d3d_calls( device, &mirror->state, &prev )))
+                        ID3D11DeviceContext1_UpdateSubresource( context, (ID3D11Resource *)mirror->texture, 0, NULL,
+                                                                map.pData, map.RowPitch, 0 );
+                    end_d3d_calls( context, prev );
+                    ID3D11DeviceContext1_Unmap( own_context, (ID3D11Resource *)staging, 0 );
+                    mirror->version = version;
+                }
             }
-            ID3D11DeviceContext_Release( own_context );
+            end_d3d_calls( own_context, own_prev );
             ID3D11Texture2D_Release( staging );
         }
         ID3D11Device_Release( own );
@@ -252,10 +309,11 @@ static HRESULT surface_get_tile( struct drawing_surface *surface, int x, int y,
 /* copies the part of the surface in rect to (x, y) of texture; where no tile is, texture is left as it was */
 static void surface_read( struct drawing_surface *surface, const RECT *rect, ID3D11Resource *texture, int x, int y )
 {
-    ID3D11DeviceContext *context;
+    ID3DDeviceContextState *prev;
+    ID3D11DeviceContext1 *context;
     struct tile *tile;
 
-    ID3D11Device_GetImmediateContext( surface->device->d3d_device, &context );
+    if (!(context = begin_d3d_calls( surface->device->d3d_device, &surface->device->d3d_state, &prev ))) return;
     LIST_FOR_EACH_ENTRY( tile, &surface->tiles, struct tile, entry )
     {
         D3D11_BOX box;
@@ -268,21 +326,23 @@ static void surface_read( struct drawing_surface *surface, const RECT *rect, ID3
         box.bottom = part.bottom - tile->rect.top;
         box.front = 0;
         box.back = 1;
-        ID3D11DeviceContext_CopySubresourceRegion( context, texture, 0, x + part.left - rect->left,
-                                                   y + part.top - rect->top, 0, (ID3D11Resource *)tile->texture,
-                                                   0, &box );
+        ID3D11DeviceContext1_CopySubresourceRegion( context, texture, 0, x + part.left - rect->left,
+                                                    y + part.top - rect->top, 0, (ID3D11Resource *)tile->texture,
+                                                    0, &box );
     }
-    ID3D11DeviceContext_Release( context );
+    end_d3d_calls( context, prev );
 }
 
 /* copies what is at (x, y) of texture into the part of the surface in rect, making the tiles it needs */
 static HRESULT surface_write( struct drawing_surface *surface, const RECT *rect, ID3D11Resource *texture, int x, int y )
 {
-    ID3D11DeviceContext *context;
+    ID3DDeviceContextState *prev;
+    ID3D11DeviceContext1 *context;
     HRESULT hr = S_OK;
     int tx, ty;
 
-    ID3D11Device_GetImmediateContext( surface->device->d3d_device, &context );
+    if (!(context = begin_d3d_calls( surface->device->d3d_device, &surface->device->d3d_state, &prev )))
+        return E_FAIL;
     for (ty = rect->top; ty < rect->bottom && SUCCEEDED(hr); ty = (ty - ty % TILE_SIZE) + TILE_SIZE)
     {
         for (tx = rect->left; tx < rect->right; tx = (tx - tx % TILE_SIZE) + TILE_SIZE)
@@ -299,15 +359,15 @@ static HRESULT surface_write( struct drawing_surface *surface, const RECT *rect,
             box.bottom = box.top + part.bottom - part.top;
             box.front = 0;
             box.back = 1;
-            ID3D11DeviceContext_CopySubresourceRegion( context, (ID3D11Resource *)tile->texture, 0,
-                                                       part.left - tile->rect.left, part.top - tile->rect.top, 0,
-                                                       texture, 0, &box );
+            ID3D11DeviceContext1_CopySubresourceRegion( context, (ID3D11Resource *)tile->texture, 0,
+                                                        part.left - tile->rect.left, part.top - tile->rect.top, 0,
+                                                        texture, 0, &box );
             tile->version++;
             if (!surface->is_virtual) break;
