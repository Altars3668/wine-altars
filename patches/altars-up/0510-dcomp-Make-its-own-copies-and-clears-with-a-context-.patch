-    ID3D11DeviceContext_Release( context );
+    end_d3d_calls( context, prev );
     return hr;
 }
 
@@ -320,7 +380,7 @@ static HRESULT surface_scratch( struct drawing_surface *surface, UINT width, UIN
         ID3D11Texture2D_GetDesc( surface->scratch, &desc );
         if (desc.Width >= width && desc.Height >= height)
