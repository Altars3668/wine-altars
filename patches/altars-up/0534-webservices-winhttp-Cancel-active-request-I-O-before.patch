From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 4 Oct 2026 03:38:48 -0400
Subject: [PATCH] webservices, winhttp: Cancel active request I/O before
 waiting for call locks.

Implement proxy abort and faulted channel states. Interrupt the active
HTTP request before acquiring locks held by blocking calls. Match native
synchronous cancellation errors and reset/close behaviour.

Add the WinHTTP request closing hook, protect netconn publication and
release, and only interrupt active I/O so idle or upgraded WebSocket
connections remain usable. Native loopback probes and full HTTP,
notification, proxy and channel regressions verify both paths.

Co-Authored-By: Claude Code <noreply@anthropic.com>

diff --git a/dlls/webservices/channel.c b/dlls/webservices/channel.c
index 73b109565c1..25d4896282b 100644
--- a/dlls/webservices/channel.c
+++ b/dlls/webservices/channel.c
@@ -198,6 +198,7 @@ enum session_state
 struct channel
 {
     ULONG                   magic;
+    LONG                    aborted;
     CRITICAL_SECTION        cs;
     WS_CHANNEL_TYPE         type;
     WS_CHANNEL_BINDING      binding;
@@ -322,16 +323,26 @@ HRESULT WINAPI WsAbortChannel( WS_CHANNEL *handle, WS_ERROR *error )
     struct channel *channel = (struct channel *)handle;
 
     TRACE( "%p %p\n", handle, error );
+    if (!channel || channel->magic != CHANNEL_MAGIC) return E_INVALIDARG;
 
-    EnterCriticalSection( &channel->cs );
-
-    if (channel->magic != CHANNEL_MAGIC)
+    /* 阻塞 I/O 持有 channel->cs，必须先中断传输，再等待该锁。 */
+    InterlockedExchange( &channel->aborted, TRUE );
+    if (channel->binding == WS_HTTP_CHANNEL_BINDING)
     {
-        LeaveCriticalSection( &channel->cs );
-        return E_INVALIDARG;
+        HINTERNET request = InterlockedExchangePointer( (void **)&channel->u.http.request, NULL );
+        if (request) WinHttpCloseHandle( request );
     }
+    else if (channel->binding == WS_TCP_CHANNEL_BINDING)
+        shutdown( channel->u.tcp.socket, SD_BOTH );
+    else if (channel->binding == WS_UDP_CHANNEL_BINDING)
+        shutdown( channel->u.udp.socket, SD_BOTH );
 
+    EnterCriticalSection( &channel->cs );
     abort_channel( channel );
+    if (channel->state != WS_CHANNEL_STATE_CREATED && channel->state != WS_CHANNEL_STATE_CLOSED)
+        channel->state = WS_CHANNEL_STATE_FAULTED;
+    else
+        InterlockedExchange( &channel->aborted, FALSE );
 
     LeaveCriticalSection( &channel->cs );
     return S_OK;
@@ -340,6 +351,7 @@ HRESULT WINAPI WsAbortChannel( WS_CHANNEL *handle, WS_ERROR *error )
 static void reset_channel( struct channel *channel )
 {
     channel->state         = WS_CHANNEL_STATE_CREATED;
+    InterlockedExchange( &channel->aborted, FALSE );
     channel->session_state = SESSION_STATE_UNINITIALIZED;
     clear_addr( &channel->addr );
     init_dict( &channel->dict_send, channel->dict_size );
@@ -351,8 +363,7 @@ static void reset_channel( struct channel *channel )
     switch (channel->binding)
     {
     case WS_HTTP_CHANNEL_BINDING:
-        WinHttpCloseHandle( channel->u.http.request );
-        channel->u.http.request = NULL;
+        WinHttpCloseHandle( InterlockedExchangePointer( (void **)&channel->u.http.request, NULL ));
         WinHttpCloseHandle( channel->u.http.connect );
         channel->u.http.connect = NULL;
         WinHttpCloseHandle( channel->u.http.session );
@@ -1780,14 +1791,22 @@ static HRESULT send_message_bytes( struct channel *channel, WS_MESSAGE *msg )
     switch (channel->binding)
     {
     case WS_HTTP_CHANNEL_BINDING:
-        if (channel->u.http.request)
+    {
+        HINTERNET request, previous;
+
+        previous = InterlockedExchangePointer( (void **)&channel->u.http.request, NULL );
+        if (previous) WinHttpCloseHandle( previous );
+        if ((hr = open_http_request( channel, &request )) != S_OK) return hr;
+        InterlockedExchangePointer( (void **)&channel->u.http.request, request );
+        if (channel->aborted)
         {
-            WinHttpCloseHandle( channel->u.http.request );
-            channel->u.http.request = NULL;
+            request = InterlockedExchangePointer( (void **)&channel->u.http.request, NULL );
+            if (request) WinHttpCloseHandle( request );
+            return WS_E_OPERATION_ABORTED;
         }
-        if ((hr = open_http_request( channel, &channel->u.http.request )) != S_OK) return hr;
-        if ((hr = message_insert_http_headers( msg, channel->u.http.request, channel->encoding )) != S_OK) return hr;
-        return send_message_http( channel->u.http.request, buf.bytes, buf.length );
+        if ((hr = message_insert_http_headers( msg, request, channel->encoding )) != S_OK) return hr;
+        return send_message_http( request, buf.bytes, buf.length );
+    }
 
     case WS_TCP_CHANNEL_BINDING:
         if (channel->type & WS_CHANNEL_TYPE_SESSION)
@@ -1837,6 +1856,7 @@ HRESULT channel_send_message( WS_CHANNEL *handle, WS_MESSAGE *msg )
     }
 
     hr = send_message_bytes( channel, msg );
+    if (channel->aborted) hr = WS_E_OPERATION_ABORTED;
     if (hr != S_OK) channel->state = WS_CHANNEL_STATE_FAULTED;
 
     LeaveCriticalSection( &channel->cs );
@@ -2554,6 +2574,7 @@ HRESULT channel_receive_message( WS_CHANNEL *handle, WS_MESSAGE *msg )
     }
 
     if ((hr = receive_message_bytes( channel, msg )) == S_OK) hr = init_reader( channel );
+    if (channel->aborted) hr = WS_E_OPERATION_ABORTED;
     if (hr != S_OK) channel->state = WS_CHANNEL_STATE_FAULTED;
 
     LeaveCriticalSection( &channel->cs );
diff --git a/dlls/webservices/proxy.c b/dlls/webservices/proxy.c
index cefb7decc54..a33802eb4a4 100644
--- a/dlls/webservices/proxy.c
+++ b/dlls/webservices/proxy.c
@@ -453,8 +453,21 @@ HRESULT WINAPI WsCloseServiceProxy( WS_SERVICE_PROXY *handle, const WS_ASYNC_CON
  */
 HRESULT WINAPI WsAbortServiceProxy( WS_SERVICE_PROXY *handle, WS_ERROR *error )
 {
-    FIXME( "%p %p\n", handle, error );
-    return E_NOTIMPL;
+    struct proxy *proxy = (struct proxy *)handle;
+    HRESULT hr;
+
+    TRACE( "%p %p\n", handle, error );
+    if (!proxy || proxy->magic != PROXY_MAGIC) return E_INVALIDARG;
+
+    /* WsCall 持有 proxy->cs；先中断它的 channel 才能等到锁。 */
+    hr = WsAbortChannel( proxy->channel, error );
+    EnterCriticalSection( &proxy->cs );
+    if (hr == S_OK && proxy->state != WS_SERVICE_PROXY_STATE_CREATED &&
+        proxy->state != WS_SERVICE_PROXY_STATE_CLOSED)
+        proxy->state = WS_SERVICE_PROXY_STATE_FAULTED;
+
+    LeaveCriticalSection( &proxy->cs );
+    return hr;
 }
 
 static HRESULT set_send_context( WS_MESSAGE *msg, const WS_CALL_PROPERTY *props, ULONG count )
diff --git a/dlls/webservices/tests/channel.c b/dlls/webservices/tests/channel.c
