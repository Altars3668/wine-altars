+static void set_request_netconn( struct request *request, struct netconn *netconn )
+{
+    AcquireSRWLockExclusive( &request->netconn_lock );
+    request->netconn = netconn;
+    if (request->handle_closed && netconn) netconn_cancel_io( netconn );
+    ReleaseSRWLockExclusive( &request->netconn_lock );
+}
+
+static struct netconn *detach_request_netconn( struct request *request )
+{
+    struct netconn *netconn;
+
+    AcquireSRWLockExclusive( &request->netconn_lock );
+    netconn = request->netconn;
+    request->netconn = NULL;
+    ReleaseSRWLockExclusive( &request->netconn_lock );
+    return netconn;
+}
