@@ -1451,9 +1451,20 @@ static BOOL request_set_option( struct object_header *hdr, DWORD option, void *b
     }
 }
 
+static void request_handle_closing( struct object_header *hdr )
+{
+    struct request *request = (struct request *)hdr;
+
+    InterlockedExchange( &request->handle_closed, TRUE );
+    AcquireSRWLockExclusive( &request->netconn_lock );
+    if (request->netconn && request->io_in_progress) netconn_cancel_io( request->netconn );
+    ReleaseSRWLockExclusive( &request->netconn_lock );
+    cancel_queue( &request->queue );
+}
