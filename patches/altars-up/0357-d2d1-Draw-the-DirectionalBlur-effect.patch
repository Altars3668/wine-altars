From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:58:01 -0400
Subject: [PATCH] d2d1: Draw the DirectionalBlur effect.

One pass of the Gaussian blur's shader, along the angle, counterclockwise
from the x axis with y going down; the standard deviation is taken along
the line.  Excel draws with it, and got nothing where the effect was.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/d2d1/effect.c b/dlls/d2d1/effect.c
index 7e39fc25d36..04901744fbf 100644
--- a/dlls/d2d1/effect.c
+++ b/dlls/d2d1/effect.c
@@ -2811,6 +2811,63 @@ static const D2D1_PROPERTY_BINDING directional_blur_bindings[] =
     { L"BorderMode", BINDING_RW(directional_blur, border_mode) },
 };
 
+/* One pass of the Gaussian blur, along the angle. */
+static HRESULT directional_blur_init(struct d2d_effect_impl *effect)
+{
+    return d2d_effect_impl_init_single(effect, 1, &blur_transform_ops, &d2d_blur_shader, blur_ps_code);
+}
+
+static HRESULT directional_blur_prepare(struct d2d_effect_impl *effect)
+{
+    const struct directional_blur_properties *props = (void *)(effect + 1);
+    struct d2d_effect_transform *transform = effect->transforms[0];
+    struct
+    {
+        float blur[4];
+        D2D_VECTOR_4F colour;
+        UINT32 colourise;
+        UINT32 padding[3];
+    } constants;
+    float scale_x, scale_y, angle, dx, dy, length, sigma;
+    LONG radius;
+
+    if (props->optimization != D2D1_DIRECTIONALBLUR_OPTIMIZATION_BALANCED)
+        TRACE("Ignoring optimization %#x.\n", props->optimization);
+
+    /* the angle goes counterclockwise from the x axis, and y goes down in pixels */
+    d2d_effect_impl_get_scale(effect, &scale_x, &scale_y);
+    angle = props->angle * M_PI / 180.0f;
+    dx = cosf(angle) * scale_x;
+    dy = -sinf(angle) * scale_y;
+    length = sqrtf(dx * dx + dy * dy);
+    if (length > 0.0f)
+    {
+        dx /= length;
+        dy /= length;
+    }
+    /* the standard deviation in DIPs along the line, in pixels */
+    sigma = max(props->standard_deviation, 0.0f) * length;
+    radius = min(ceilf(3.0f * sigma), 2048.0f);
+    transform->radius_x = ceilf(radius * fabsf(dx));
+    transform->radius_y = ceilf(radius * fabsf(dy));
+    transform->hard = props->border_mode == D2D1_BORDER_MODE_HARD;
+    d2d_effect_transform_set_sampling(transform, D2D1_FILTER_MIN_MAG_MIP_LINEAR,
+            transform->hard ? D2D_EFFECT_ADDRESS_MIRROR : D2D_EFFECT_ADDRESS_TRANSPARENT);
+
+    memset(&constants, 0, sizeof(constants));
+    constants.blur[0] = sigma;
+    constants.blur[1] = radius;
+    constants.blur[2] = dx;
+    constants.blur[3] = dy;
+    return d2d_effect_transform_set_constants(transform, &constants, sizeof(constants));
+}
+
+static const struct d2d_effect_impl_ops directional_blur_effect_ops =
+{
+    directional_blur_init,
+    directional_blur_prepare,
+};
+
 static HRESULT __stdcall directional_blur_factory(IUnknown **effect)
 {
     static const struct directional_blur_properties properties =
@@ -2818,7 +2875,7 @@ static HRESULT __stdcall directional_blur_factory(IUnknown **effect)
         .standard_deviation = 3.0f,
         .optimization = D2D1_DIRECTIONALBLUR_OPTIMIZATION_BALANCED,
     };
-    return d2d_effect_create_impl(effect, NULL, &properties, sizeof(properties));
+    return d2d_effect_create_impl(effect, &directional_blur_effect_ops, &properties, sizeof(properties));
 }
 
 static const WCHAR hue_rotation_description[] =
diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index 2ef5d9cb9b1..ad9665eaa50 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -19281,6 +19281,34 @@ static void test_effect_rendering(BOOL d3d11)
     release_resource_readback(&rb);
     ID2D1Effect_Release(blur);
 
+    /* A directional blur softens the edges along its angle only, counterclockwise from across. */
+    hr = ID2D1DeviceContext_CreateEffect(context, &CLSID_D2D1DirectionalBlur, &blur);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    ID2D1Effect_SetInput(blur, 0, (ID2D1Image *)white, FALSE);
+    f = 1.0f;
+    hr = ID2D1Effect_SetValue(blur, D2D1_DIRECTIONALBLUR_PROP_STANDARD_DEVIATION, D2D1_PROPERTY_TYPE_FLOAT,
+            (const BYTE *)&f, sizeof(f));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, blur, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 8, 8, 0xffffffff, 1);
+    check_effect_pixel(&ctx, 8, 16, 0x00000000, 0);
+    get_surface_readback(&ctx, &rb);
+    colour = get_readback_colour(&rb, 16, 8);
+    ok(colour >> 24 > 0x20 && colour >> 24 < 0xa0, "Got unexpected colour %#lx.\n", colour);
+    release_resource_readback(&rb);
+    f = 90.0f;
+    hr = ID2D1Effect_SetValue(blur, D2D1_DIRECTIONALBLUR_PROP_ANGLE, D2D1_PROPERTY_TYPE_FLOAT,
+            (const BYTE *)&f, sizeof(f));
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+    draw_effect(&ctx, blur, NULL, NULL, D2D1_COMPOSITE_MODE_SOURCE_OVER);
+    check_effect_pixel(&ctx, 8, 8, 0xffffffff, 1);
+    check_effect_pixel(&ctx, 16, 8, 0x00000000, 0);
+    get_surface_readback(&ctx, &rb);
+    colour = get_readback_colour(&rb, 8, 16);
+    ok(colour >> 24 > 0x20 && colour >> 24 < 0xa0, "Got unexpected colour %#lx.\n", colour);
+    release_resource_readback(&rb);
+    ID2D1Effect_Release(blur);
+
     /* A command list is drawn into what the effect takes. */
     hr = ID2D1DeviceContext_CreateCommandList(context, &list);
     ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
