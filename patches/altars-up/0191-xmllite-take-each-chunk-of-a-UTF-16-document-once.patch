From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 00:05:31 -0400
Subject: [PATCH] xmllite: take each chunk of a UTF-16 document once.

A UTF-16 document was copied from the raw buffer without discarding what
had been copied, so every later read appended the whole buffer again and
the reader met elements twice, out of order, or not at all. Discard the
copied bytes as for every other encoding, and copy whole characters only,
leaving half of one for the next read.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit edba3c99e4c028e24b0394e545a9a0b4af341b27)

diff --git a/dlls/xmllite/reader.c b/dlls/xmllite/reader.c
index a73dc511586..b276ba1b37f 100644
--- a/dlls/xmllite/reader.c
+++ b/dlls/xmllite/reader.c
@@ -998,7 +998,8 @@ static int readerinput_get_convlen(xmlreaderinput *readerinput)
     else if (readerinput->buffer->code_page != 1200)
         len = readerinput_get_mbcs_convlen(readerinput);
     else
-        len = buffer->written;
+        /* whole characters; the half of one a read ended in waits for the rest */
+        len = buffer->cur + ((buffer->written - buffer->cur) & ~1);
 
     TRACE("%d\n", len - buffer->cur);
     return len - buffer->cur;
@@ -1203,9 +1204,9 @@ static HRESULT reader_more(xmlreader *reader)
         readerinput_convert(readerinput, src->data + src->cur, len, ptr, dest_len);
         ptr[dest_len] = 0;
         dest->written += dest_len*sizeof(WCHAR);
-        /* get rid of processed data */
-        readerinput_shrinkraw(readerinput, len);
     }
+    /* get rid of processed data; copied UTF-16 too, or the next chunk comes after it all over again */
+    readerinput_shrinkraw(readerinput, len);
 
     fixup_buffer_cr(dest, prev_len);
     return hr;
diff --git a/dlls/xmllite/tests/reader.c b/dlls/xmllite/tests/reader.c
index 45f638317e5..46b19eae883 100644
--- a/dlls/xmllite/tests/reader.c
+++ b/dlls/xmllite/tests/reader.c
@@ -2923,6 +2923,59 @@ static void test_multibyte_chunk_boundary(void)
     IXmlReader_Release(reader);
 }
 
+/* A UTF-16 document read in more than a few chunks, with CRLF line ends as Windows writes them:
+ * each element comes once, in order, and the document ends where it does. */
+static void test_utf16_chunks(void)
+{
+    static const WCHAR start[] = L"<?xml version=\"1.0\" encoding=\"UTF-16\"?>\r\n<a>";
+    static const WCHAR item[] = L"\r\n  <b n=\"%u\">text</b>";
+    static const WCHAR end[] = L"\r\n</a>";
+    unsigned int i, count = 3000, elements, expected, bad;
+    IXmlReader *reader;
+    const WCHAR *value;
+    XmlNodeType type;
+    WCHAR *xml, *p;
+    IStream *stream;
+    HRESULT hr;
+
+    hr = CreateXmlReader(&IID_IXmlReader, (void **)&reader, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    xml = malloc((wcslen(start) + count * (wcslen(item) + 8) + wcslen(end) + 1) * sizeof(WCHAR));
+    p = xml + swprintf(xml, wcslen(start) + 1, L"%s", start);
+    for (i = 0; i < count; ++i)
+        p += swprintf(p, wcslen(item) + 8, item, i);
+    wcscpy(p, end);
+
+    stream = create_stream_on_data(xml, wcslen(xml) * sizeof(WCHAR));
+    hr = IXmlReader_SetInput(reader, (IUnknown *)stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    elements = expected = bad = 0;
+    while ((hr = IXmlReader_Read(reader, &type)) == S_OK)
+    {
+        if (type != XmlNodeType_Element) continue;
+        if (elements++)
+        {
+            hr = IXmlReader_MoveToFirstAttribute(reader);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            hr = IXmlReader_GetValue(reader, &value, NULL);
+            ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+            if (wcstoul(value, NULL, 10) != expected) bad++;
+            expected++;
+            IXmlReader_MoveToElement(reader);
+        }
+    }
+    ok(hr == S_FALSE, "Parsing stopped early, hr %#lx.\n", hr);
+    ok(elements == count + 1, "Got %u elements, expected %u.\n", elements, count + 1);
+    ok(!bad, "%u elements came out of order.\n", bad);
+
+    IXmlReader_SetInput(reader, NULL);
+    IStream_Release(stream);
+    IXmlReader_Release(reader);
+    free(xml);
+}
+
 START_TEST(reader)
 {
     test_reader_create();
@@ -2953,4 +3006,5 @@ START_TEST(reader)
     test_string_pointers();
     test_attribute_by_name();
     test_multibyte_chunk_boundary();
+    test_utf16_chunks();
 }
