diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index e01fe1fe4ec..c68421a79ff 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -5216,7 +5216,9 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
             else
             {
                 fill_file_info( &st, attr, info, class );
-                info->DeletePending = FALSE; /* FIXME */
+                /* a file without a name left is deleted; one whose name is only to be deleted
+                 * would take a server call on every query, and is not told */
+                info->DeletePending = !st.st_nlink;
             }
         }
         break;
@@ -5257,7 +5259,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
                 LONG name_len = len - FIELD_OFFSET(FILE_ALL_INFORMATION, NameInformation.FileName);
 
                 fill_file_info( &st, attr, info, FileAllInformation );
-                info->StandardInformation.DeletePending = FALSE; /* FIXME */
+                info->StandardInformation.DeletePending = !st.st_nlink;
                 info->EaInformation.EaSize = 0;
                 info->AccessInformation.AccessFlags = 0;  /* FIXME */
                 info->PositionInformation.CurrentByteOffset.QuadPart = lseek( fd, 0, SEEK_CUR );
diff --git a/server/fd.c b/server/fd.c
index ac24a3e4547..d89f775d52d 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -154,6 +154,7 @@ struct fd
     unsigned int         no_fd_status;/* status to return when unix_fd is -1 */
     unsigned int         cacheable :1;/* can the fd be cached on the client side? */
     unsigned int         fs_locks :1; /* can we use filesystem locks for this fd? */
+    unsigned int         link_deleted :1; /* is the name it was opened by to be deleted? */
     int                  poll_index;  /* index of fd in poll array */
     struct async_queue   read_q;      /* async readers of this fd */
     struct async_queue   write_q;     /* async writers of this fd */
@@ -1145,6 +1146,22 @@ static struct inode *get_inode( dev_t dev, ino_t ino, int unix_fd )
     return inode;
 }
 
+/* whether a name of the file is to be deleted, by a disposition set through any open of it by that name
+ * or by an open for delete on close that has been closed */
+static int is_link_deleted( struct inode *inode, const char *name )
+{
+    struct closed_fd *closed;
+    struct fd *fd;
+
+    if (!name) return 0;
+    LIST_FOR_EACH_ENTRY( fd, &inode->open, struct fd, inode_entry )
+        if (fd->link_deleted && fd->unix_name && !strcmp( fd->unix_name, name )) return 1;
+    LIST_FOR_EACH_ENTRY( closed, &inode->closed, struct closed_fd, entry )
+        if ((closed->disp_flags & FILE_DISPOSITION_DELETE) && closed->unix_name && !strcmp( closed->unix_name, name ))
+            return 1;
+    return 0;
+}
+
 static int inode_has_pending_close( struct inode *inode, const char *path )
 {
     struct closed_fd *fd;
@@ -1806,6 +1823,7 @@ static struct fd *alloc_fd_object(void)
     fd->nt_namelen = 0;
     fd->cacheable  = 0;
     fd->fs_locks   = 1;
+    fd->link_deleted = 0;
     fd->poll_index = -1;
     fd->completion = NULL;
     fd->comp_flags = 0;
@@ -1848,6 +1866,7 @@ struct fd *alloc_pseudo_fd( const struct fd_ops *fd_user_ops, struct object *use
     fd->unix_fd    = -1;
     fd->cacheable  = 0;
     fd->fs_locks   = 0;
+    fd->link_deleted = 0;
     fd->poll_index = -1;
     fd->completion = NULL;
     fd->comp_flags = 0;
@@ -1876,6 +1895,7 @@ struct fd *dup_fd_object( struct fd *orig, unsigned int access, unsigned int sha
 
     fd->options    = options;
     fd->cacheable  = orig->cacheable;
+    fd->link_deleted = orig->link_deleted;
 
     if (orig->unix_name)
     {
@@ -2118,6 +2138,13 @@ struct fd *open_fd( struct fd *root, const char *name, struct unicode_str nt_nam
         list_add_head( &inode->open, &fd->inode_entry );
         closed_fd = NULL;
 
+        /* a name that is to be deleted cannot be opened again */
+        if (is_link_deleted( inode, fd->unix_name ))
+        {
+            set_error( STATUS_DELETE_PENDING );
+            goto error;
+        }
+
         /* check directory options */
         if ((options & FILE_DIRECTORY_FILE) && !S_ISDIR(st.st_mode))
         {
@@ -2813,6 +2840,8 @@ static struct fd *get_handle_fd_obj( struct process *process, obj_handle_t handl
 /* set disposition for the fd */
 static void set_fd_disposition( struct fd *fd, unsigned int flags )
 {
+    struct closed_fd *closed;
+    struct fd *fd_ptr;
     struct stat st;
 
     if (!fd->inode)
@@ -2833,8 +2862,6 @@ static void set_fd_disposition( struct fd *fd, unsigned int flags )
 
     if (flags & FILE_DISPOSITION_DELETE)
     {
-        struct fd *fd_ptr;
-
         LIST_FOR_EACH_ENTRY( fd_ptr, &fd->inode->open, struct fd, inode_entry )
         {
             if (fd_ptr->access & FILE_MAPPING_ACCESS)
@@ -2880,9 +2907,28 @@ static void set_fd_disposition( struct fd *fd, unsigned int flags )
     if (flags & FILE_DISPOSITION_ON_CLOSE)
         fd->options &= ~FILE_DELETE_ON_CLOSE;
 
+    fd->link_deleted = !!(flags & FILE_DISPOSITION_DELETE);
     fd->closed->disp_flags =
         (flags & (FILE_DISPOSITION_DELETE | FILE_DISPOSITION_POSIX_SEMANTICS)) |
         ((fd->options & FILE_DELETE_ON_CLOSE) ? FILE_DISPOSITION_DELETE : 0);
+
+    /* the delete belongs to the name, which every open of the file by that name shares; removing
+     * the name at once is still for the close of this open only */
+    if (fd->unix_name)
+        LIST_FOR_EACH_ENTRY( fd_ptr, &fd->inode->open, struct fd, inode_entry )
+        {
+            unsigned int posix = fd_ptr->closed->disp_flags & FILE_DISPOSITION_POSIX_SEMANTICS;
+
+            if (fd_ptr == fd || !fd_ptr->unix_name || strcmp( fd_ptr->unix_name, fd->unix_name )) continue;
+            fd_ptr->link_deleted = fd->link_deleted;
+            fd_ptr->closed->disp_flags = (fd->link_deleted ? FILE_DISPOSITION_DELETE | posix : 0) |
+                ((fd_ptr->options & FILE_DELETE_ON_CLOSE) ? FILE_DISPOSITION_DELETE : 0);
+        }
+    /* and keeping the name takes back the delete left by an open closed meanwhile */
+    if (!(flags & FILE_DISPOSITION_DELETE) && fd->unix_name)
+        LIST_FOR_EACH_ENTRY( closed, &fd->inode->closed, struct closed_fd, entry )
+            if (closed->unix_name && !strcmp( closed->unix_name, fd->unix_name ))
+                closed->disp_flags &= ~FILE_DISPOSITION_DELETE;
 }
 
 /* whether anything beneath a directory is open, which keeps it from being renamed */
@@ -2959,6 +3005,12 @@ static void set_fd_name( struct fd *fd, struct fd *root, const char *nameptr, da
         set_error( STATUS_OBJECT_PATH_SYNTAX_BAD );
         return;
     }
+    /* a name that is to be deleted can be neither renamed nor linked to */
+    if (is_link_deleted( fd->inode, fd->unix_name ))
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        return;
+    }
     if (!(name = mem_alloc( len + 2 ))) return;
     memcpy( name, nameptr, len );
     if (fd->unix_name[strlen( fd->unix_name ) - 1] == '?' && name[len - 1] != '?')
