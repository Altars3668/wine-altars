+    EVENT_NETWORK_DELETED,
+    EVENT_NETWORK_CONNECTIVITY,
+    EVENT_NETWORK_PROPERTY,
+    EVENT_CONNECTION_CONNECTIVITY,
+};
+
+struct event
+{
+    struct list entry;
+    enum event_type type;
+    GUID id;
+    DWORD value;
+};
+
+static void add_event( struct list *events, enum event_type type, const GUID *id, DWORD value )
+{
+    struct event *event;
+
+    if (!events || !(event = malloc( sizeof(*event) ))) return;
+    event->type = type;
+    if (id) event->id = *id;
+    else memset( &event->id, 0, sizeof(event->id) );
+    event->value = value;
+    list_add_tail( events, &event->entry );
+}
+
+static IP_ADAPTER_ADDRESSES *get_network_adapters(void)
+{
+    ULONG err, size = 4096, flags = GAA_FLAG_SKIP_ANYCAST | GAA_FLAG_SKIP_MULTICAST |
+                                    GAA_FLAG_SKIP_DNS_SERVER | GAA_FLAG_INCLUDE_GATEWAYS;
+    IP_ADAPTER_ADDRESSES *tmp, *ret;
+
+    if (!(ret = malloc( size ))) return NULL;
+    err = GetAdaptersAddresses( AF_UNSPEC, flags, NULL, ret, &size );
+    while (err == ERROR_BUFFER_OVERFLOW)
+    {
+        if (!(tmp = realloc( ret, size ))) break;
+        ret = tmp;
+        err = GetAdaptersAddresses( AF_UNSPEC, flags, NULL, ret, &size );
+    }
+    if (err == ERROR_SUCCESS) return ret;
+    free( ret );
+    return NULL;
+}
+
+static const SOCKADDR *find_gateway( const IP_ADAPTER_ADDRESSES *aa, ADDRESS_FAMILY family )
+{
+    const IP_ADAPTER_GATEWAY_ADDRESS *gw;
+
+    for (gw = aa->FirstGatewayAddress; gw; gw = gw->Next)
+        if (gw->Address.lpSockaddr->sa_family == family) return gw->Address.lpSockaddr;
+    return NULL;
+}
+
+/* What an interface reaches, as Windows tells it: the internet through a gateway, the subnet of an address
+ * without one, nothing with no address or only a link-local or autoconfigured one. */
+static NLM_CONNECTIVITY get_connectivity( const IP_ADAPTER_ADDRESSES *aa )
+{
+    const IP_ADAPTER_UNICAST_ADDRESS *addr;
+    BOOL v4 = FALSE, v6 = FALSE;
+    NLM_CONNECTIVITY ret = 0;
+
+    for (addr = aa->FirstUnicastAddress; addr; addr = addr->Next)
+    {
+        const SOCKADDR *sa = addr->Address.lpSockaddr;
+
+        if (sa->sa_family == AF_INET)
+        {
+            const BYTE *b = (const BYTE *)&((const SOCKADDR_IN *)sa)->sin_addr;
+            if (b[0] != 169 || b[1] != 254) v4 = TRUE;
+        }
+        else if (sa->sa_family == AF_INET6)
+        {
+            const struct in6_addr *a6 = &((const SOCKADDR_IN6 *)sa)->sin6_addr;
+            if (!IN6_IS_ADDR_LINKLOCAL( a6 ) && !IN6_IS_ADDR_UNSPECIFIED( a6 ) && !IN6_IS_ADDR_LOOPBACK( a6 ))
+                v6 = TRUE;
+        }
+    }
+    if (!v4) ret |= NLM_CONNECTIVITY_IPV4_NOTRAFFIC;
+    else if (find_gateway( aa, AF_INET )) ret |= NLM_CONNECTIVITY_IPV4_INTERNET;
+    else ret |= NLM_CONNECTIVITY_IPV4_SUBNET;
+    if (!v6) ret |= NLM_CONNECTIVITY_IPV6_NOTRAFFIC;
+    else if (find_gateway( aa, AF_INET6 )) ret |= NLM_CONNECTIVITY_IPV6_INTERNET;
+    else ret |= NLM_CONNECTIVITY_IPV6_SUBNET;
+    return ret;
+}
+
+static void format_guid( WCHAR *buf, const GUID *id )
+{
+    swprintf( buf, 39, L"{%08X-%04X-%04X-%02X%02X-%02X%02X%02X%02X%02X%02X}", id->Data1, id->Data2, id->Data3,
+              id->Data4[0], id->Data4[1], id->Data4[2], id->Data4[3], id->Data4[4], id->Data4[5], id->Data4[6],
+              id->Data4[7] );
+}
+
+static void now_as_systemtime( BYTE *buf )
+{
+    SYSTEMTIME st;
+    GetLocalTime( &st );
+    memcpy( buf, &st, sizeof(st) );
+}
+
+static void systemtime_to_filetime( const BYTE *buf, DWORD size, FILETIME *ft )
+{
+    SYSTEMTIME local, utc;
+
+    memset( ft, 0, sizeof(*ft) );
+    if (size < sizeof(local)) return;
+    memcpy( &local, buf, sizeof(local) );
+    if (TzSpecificLocalTimeToSystemTime( NULL, &local, &utc )) SystemTimeToFileTime( &utc, ft );
+}
+
+static WCHAR *load_name( UINT id, unsigned int number )
+{
+    WCHAR format[64], *ret;
+    DWORD_PTR args[1] = { number };
+
+    if (!LoadStringW( netprofm_instance, id, format, ARRAY_SIZE(format) )) return NULL;
+    if (!FormatMessageW( FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_ARGUMENT_ARRAY,
+                         format, 0, 0, (WCHAR *)&ret, 0, (va_list *)args ))
+        return NULL;
+    return ret;
+}
+
+/* "Network", or "Network 2" and so on, the first one no profile has */
+static WCHAR *new_profile_name( HKEY profiles )
+{
+    WCHAR subkey[64], name[256], *candidate;
+    unsigned int number;
+    DWORD i, size;
+    BOOL taken;
+
+    for (number = 1; number < 10000; number++)
+    {
+        if (!(candidate = number == 1 ? load_name( IDS_NETWORK, 0 ) : load_name( IDS_NETWORK_NUMBERED, number )))
+            return NULL;
+        taken = FALSE;
+        for (i = 0; !taken && !RegEnumKeyW( profiles, i, subkey, ARRAY_SIZE(subkey) ); i++)
+        {
+            size = sizeof(name);
+            if (!RegGetValueW( profiles, subkey, L"ProfileName", RRF_RT_REG_SZ, NULL, name, &size ) &&
+                !wcsicmp( name, candidate ))
+                taken = TRUE;
+        }
+        if (!taken)
+        {
+            WCHAR *ret = strdupW( candidate );
+            LocalFree( candidate );
+            return ret;
+        }
+        LocalFree( candidate );
+    }
+    return NULL;
+}
+
+/* the profile a network signature belongs to, made the first time the network is seen */
+static BOOL get_profile( const WCHAR *signature, const WCHAR *other_signature, DWORD if_type, const BYTE *mac,
+                         GUID *id )
+{
+    WCHAR path[512], guid_str[39], *name;
+    HKEY list, profiles, profile, sig;
+    BYTE date[16];
+    DWORD value, size;
+    BOOL ret = FALSE;
+
+    if (RegCreateKeyExW( HKEY_LOCAL_MACHINE, network_list_keyW, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &list, NULL ))
+        return FALSE;
+
+    /* by the gateway's hardware address, or by its IP address before that was known */
+    swprintf( path, ARRAY_SIZE(path), L"Signatures\\Unmanaged\\%s", signature );
+    size = sizeof(guid_str);
+    if (!RegGetValueW( list, path, L"ProfileGuid", RRF_RT_REG_SZ, NULL, guid_str, &size ) &&
+        SUCCEEDED(CLSIDFromString( guid_str, id )))
+        ret = TRUE;
+    else if (other_signature)
+    {
+        swprintf( path, ARRAY_SIZE(path), L"Signatures\\Unmanaged\\%s", other_signature );
+        size = sizeof(guid_str);
+        if (!RegGetValueW( list, path, L"ProfileGuid", RRF_RT_REG_SZ, NULL, guid_str, &size ) &&
+            SUCCEEDED(CLSIDFromString( guid_str, id )))
+        {
+            ret = TRUE;
+            /* the network is known by its hardware address from now on as well */
+            swprintf( path, ARRAY_SIZE(path), L"Signatures\\Unmanaged\\%s", signature );
+            if (!RegCreateKeyExW( list, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &sig, NULL ))
+            {
+                RegSetValueExW( sig, L"ProfileGuid", 0, REG_SZ, (BYTE *)guid_str, sizeof(guid_str) );
+                if (mac) RegSetValueExW( sig, L"DefaultGatewayMac", 0, REG_BINARY, mac, 6 );
+                RegCloseKey( sig );
+            }
+        }
+    }
+    if (ret)
+    {
+        RegCloseKey( list );
+        return TRUE;
+    }
+
+    if (RegCreateKeyExW( list, L"Profiles", 0, NULL, 0, KEY_ALL_ACCESS, NULL, &profiles, NULL ))
+    {
+        RegCloseKey( list );
+        return FALSE;
+    }
+    if (FAILED(CoCreateGuid( id )) || !(name = new_profile_name( profiles )))
+    {
+        RegCloseKey( profiles );
+        RegCloseKey( list );
+        return FALSE;
+    }
+    format_guid( guid_str, id );
+    if (!RegCreateKeyExW( profiles, guid_str, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &profile, NULL ))
+    {
+        RegSetValueExW( profile, L"ProfileName", 0, REG_SZ, (BYTE *)name, (wcslen( name ) + 1) * sizeof(WCHAR) );
+        RegSetValueExW( profile, L"Description", 0, REG_SZ, (BYTE *)name, (wcslen( name ) + 1) * sizeof(WCHAR) );
+        value = 0;
+        RegSetValueExW( profile, L"Managed", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+        RegSetValueExW( profile, L"Category", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+        RegSetValueExW( profile, L"CategoryType", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+        value = if_type;
+        RegSetValueExW( profile, L"NameType", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+        now_as_systemtime( date );
+        RegSetValueExW( profile, L"DateCreated", 0, REG_BINARY, date, sizeof(date) );
+        RegSetValueExW( profile, L"DateLastConnected", 0, REG_BINARY, date, sizeof(date) );
+        RegCloseKey( profile );
+        swprintf( path, ARRAY_SIZE(path), L"Signatures\\Unmanaged\\%s", signature );
+        if (!RegCreateKeyExW( list, path, 0, NULL, 0, KEY_ALL_ACCESS, NULL, &sig, NULL ))
+        {
+            RegSetValueExW( sig, L"ProfileGuid", 0, REG_SZ, (BYTE *)guid_str, sizeof(guid_str) );
+            RegSetValueExW( sig, L"Description", 0, REG_SZ, (BYTE *)name, (wcslen( name ) + 1) * sizeof(WCHAR) );
+            RegSetValueExW( sig, L"FirstNetwork", 0, REG_SZ, (BYTE *)name, (wcslen( name ) + 1) * sizeof(WCHAR) );
+            RegSetValueExW( sig, L"DnsSuffix", 0, REG_SZ, (BYTE *)L"<none>", sizeof(L"<none>") );
+            value = 8;
+            RegSetValueExW( sig, L"Source", 0, REG_DWORD, (BYTE *)&value, sizeof(value) );
+            if (mac) RegSetValueExW( sig, L"DefaultGatewayMac", 0, REG_BINARY, mac, 6 );
+            RegCloseKey( sig );
+        }
+        ret = TRUE;
+        TRACE( "new profile %s %s\n", debugstr_w(guid_str), debugstr_w(name) );
+    }
+    free( name );
+    RegCloseKey( profiles );
+    RegCloseKey( list );
+    return ret;
+}
+
+/* the network an interface with a gateway is on, known by the gateway's hardware address */
+static BOOL get_gateway_network( const IP_ADAPTER_ADDRESSES *aa, GUID *id )
+{
+    const SOCKADDR *gateway = find_gateway( aa, AF_INET );
+    WCHAR mac_sig[64], ip_sig[96], addr[64];
+    MIB_IPNET_ROW2 row;
+    DWORD len = ARRAY_SIZE(addr);
+    const BYTE *mac = NULL;
+    BOOL have_mac = FALSE;
+
+    if (!gateway) gateway = find_gateway( aa, AF_INET6 );
+    if (!gateway) return FALSE;
+
+    memset( &row, 0, sizeof(row) );
+    row.InterfaceLuid = aa->Luid;
+    if (gateway->sa_family == AF_INET) row.Address.Ipv4 = *(const SOCKADDR_IN *)gateway;
+    else row.Address.Ipv6 = *(const SOCKADDR_IN6 *)gateway;
+    if (!GetIpNetEntry2( &row ) && row.PhysicalAddressLength == 6 && memcmp( row.PhysicalAddress, "\0\0\0\0\0\0", 6 ))
+    {
+        mac = row.PhysicalAddress;
+        swprintf( mac_sig, ARRAY_SIZE(mac_sig), L"%02X%02X%02X%02X%02X%02X%04X", mac[0], mac[1], mac[2], mac[3],
+                  mac[4], mac[5], aa->IfType );
+        have_mac = TRUE;
+    }
+    if (WSAAddressToStringW( (SOCKADDR *)gateway, gateway->sa_family == AF_INET ? sizeof(SOCKADDR_IN) :
+                             sizeof(SOCKADDR_IN6), NULL, addr, &len ))
+        wcscpy( addr, L"?" );
+    swprintf( ip_sig, ARRAY_SIZE(ip_sig), L"%s-%04X", addr, aa->IfType );
+    if (have_mac) return get_profile( mac_sig, ip_sig, aa->IfType, mac, id );
+    return get_profile( ip_sig, NULL, aa->IfType, NULL, id );
+}
+
+/* make the networks from the profiles: their names and so on, and mark them seen */
+static void read_profiles( struct state *state, struct list *events )
+{
+    WCHAR subkey[64], buf[256];
+    struct network *network;
+    HKEY profiles;
+    DWORD i, size, category;
+    BYTE date[16];
+    GUID id;
+
+    if (RegOpenKeyExW( HKEY_LOCAL_MACHINE, L"Software\\Microsoft\\Windows NT\\CurrentVersion\\NetworkList\\Profiles",
+                       0, KEY_READ, &profiles ))
+        return;
+
+    for (i = 0; !RegEnumKeyW( profiles, i, subkey, ARRAY_SIZE(subkey) ); i++)
+    {
+        DWORD changed = 0;
+
+        if (FAILED(CLSIDFromString( subkey, &id ))) continue;
+        if (!(network = find_network( state, &id )))
+        {
+            if (!(network = create_network( state, &id ))) continue;
+            network->listed = TRUE;
+            network->kept = TRUE;
+            list_add_tail( &state->networks, &network->entry );
+            if (state->refreshed) add_event( events, EVENT_NETWORK_ADDED, &id, 0 );
+        }
+        network->seen = TRUE;
+        size = sizeof(buf);
+        if (!RegGetValueW( profiles, subkey, L"ProfileName", RRF_RT_REG_SZ, NULL, buf, &size ) &&
+            (!network->name || wcscmp( network->name, buf )))
+        {
+            if (network->name) changed |= NLM_NETWORK_PROPERTY_CHANGE_NAME;
+            free( network->name );
+            network->name = strdupW( buf );
+        }
+        size = sizeof(buf);
+        if (!RegGetValueW( profiles, subkey, L"Description", RRF_RT_REG_SZ, NULL, buf, &size ) &&
+            (!network->description || wcscmp( network->description, buf )))
+        {
+            if (network->description) changed |= NLM_NETWORK_PROPERTY_CHANGE_DESCRIPTION;
+            free( network->description );
+            network->description = strdupW( buf );
+        }
+        if (!network->description) network->description = strdupW( network->name );
+        size = sizeof(category);
+        if (!RegGetValueW( profiles, subkey, L"Category", RRF_RT_REG_DWORD, NULL, &category, &size ) &&
+            category != network->category)
+        {
+            changed |= NLM_NETWORK_PROPERTY_CHANGE_CATEGORY_VALUE;
+            network->category = category;
+        }
+        size = sizeof(date);
+        if (!RegGetValueW( profiles, subkey, L"DateCreated", RRF_RT_REG_BINARY, NULL, date, &size ))
+            systemtime_to_filetime( date, size, &network->created );
+        size = sizeof(date);
+        if (!RegGetValueW( profiles, subkey, L"DateLastConnected", RRF_RT_REG_BINARY, NULL, date, &size ))
+            systemtime_to_filetime( date, size, &network->connected );
+        if (changed && state->refreshed) add_event( events, EVENT_NETWORK_PROPERTY, &id, changed );
+    }
+    RegCloseKey( profiles );
+}
+
+/* the profile's last connection is now */
+static void touch_profile( struct network *network )
+{
+    BYTE date[16];
+    HKEY key;
+
+    if (!network->kept || !(key = open_profile( &network->id, KEY_SET_VALUE ))) return;
+    now_as_systemtime( date );
+    RegSetValueExW( key, L"DateLastConnected", 0, REG_BINARY, date, sizeof(date) );
+    RegCloseKey( key );
+    systemtime_to_filetime( date, sizeof(date), &network->connected );
+}
+
+static void unlist_network( struct network *network )
+{
+    network->listed = FALSE;
+    list_remove( &network->entry );
+    INetwork_Release( &network->INetwork_iface );
+}
+
+static void unlist_connection( struct connection *connection )
+{
+    connection->listed = FALSE;
+    list_remove( &connection->entry );
+    INetworkConnection_Release( &connection->INetworkConnection_iface );
+}
+
+/* Bring the networks and connections up to date with the host, noting what changed in events for the sinks.  The
+ * lock is held. */
+static void refresh( struct state *state, struct list *events )
+{
+    struct network *network, *next_network;
+    struct connection *connection, *next_connection;
+    NLM_CONNECTIVITY connectivity = 0;
+    IP_ADAPTER_ADDRESSES *buf, *aa;
+    BOOL first = !state->refreshed;
+    GUID adapter_id, network_id;
+
+    LIST_FOR_EACH_ENTRY( network, &state->networks, struct network, entry )
+    {
+        network->seen = FALSE;
+        network->connection_count = 0;
+    }
+    LIST_FOR_EACH_ENTRY( connection, &state->connections, struct connection, entry )
+        connection->seen = FALSE;
+
+    read_profiles( state, events );
+
+    buf = get_network_adapters();
+    for (aa = buf; aa; aa = aa->Next)
+    {
+        NLM_CONNECTIVITY conn;
+        BOOL unidentified = FALSE;
+
+        if (aa->IfType == IF_TYPE_SOFTWARE_LOOPBACK || aa->IfType == IF_TYPE_TUNNEL) continue;
+        if (aa->OperStatus != IfOperStatusUp) continue;
+        if (ConvertInterfaceLuidToGuid( &aa->Luid, &adapter_id )) continue;
+        conn = get_connectivity( aa );
+
+        if (!get_gateway_network( aa, &network_id ))
+        {
+            /* an unidentified network of the interface's own */
+            network_id = adapter_id;
+            network_id.Data1 ^= 0x554e4944;
+            unidentified = TRUE;
+        }
+        if (!(network = find_network( state, &network_id )))
+        {
+            if (!(network = create_network( state, &network_id ))) continue;
+            network->listed = TRUE;
+            network->kept = !unidentified;
+            network->category = NLM_NETWORK_CATEGORY_PUBLIC;
+            if (unidentified)
+            {
+                network->name = load_name( IDS_UNIDENTIFIED, 0 );
+                if (network->name)
+                {
+                    WCHAR *name = strdupW( network->name );
+                    LocalFree( network->name );
+                    network->name = name;
+                }
+                network->description = strdupW( network->name );
+                GetSystemTimeAsFileTime( &network->created );
+                network->connected = network->created;
+            }
+            list_add_tail( &state->networks, &network->entry );
+            if (!first) add_event( events, EVENT_NETWORK_ADDED, &network_id, 0 );
+        }
+        network->seen = TRUE;
+        network->connection_count++;
+
+        LIST_FOR_EACH_ENTRY( connection, &state->connections, struct connection, entry )
+            if (IsEqualGUID( &connection->adapter_id, &adapter_id )) break;
+        if (&connection->entry == &state->connections)
+        {
+            if (!(connection = create_connection( state, &adapter_id ))) continue;
+            connection->listed = TRUE;
+            list_add_tail( &state->connections, &connection->entry );
+        }
+        else if (!IsEqualGUID( &connection->network_id, &network_id ) && !first)
+        {
+            /* it moved to another network: both lost or got a connection */
+            add_event( events, EVENT_NETWORK_PROPERTY, &connection->network_id, NLM_NETWORK_PROPERTY_CHANGE_CONNECTION );
+            add_event( events, EVENT_NETWORK_PROPERTY, &network_id, NLM_NETWORK_PROPERTY_CHANGE_CONNECTION );
+        }
+        connection->seen = TRUE;
+        connection->network_id = network_id;
+        if (connection->connectivity != conn)
+        {
+            if (!first) add_event( events, EVENT_CONNECTION_CONNECTIVITY, &connection->id, conn );
+            connection->connectivity = conn;
+        }
+    }
+    free( buf );
+
+    /* the connections that went */
+    LIST_FOR_EACH_ENTRY_SAFE( connection, next_connection, &state->connections, struct connection, entry )
+    {
+        if (connection->seen) continue;
+        connection->connectivity = NLM_CONNECTIVITY_DISCONNECTED;
+        add_event( events, EVENT_CONNECTION_CONNECTIVITY, &connection->id, NLM_CONNECTIVITY_DISCONNECTED );
+        add_event( events, EVENT_NETWORK_PROPERTY, &connection->network_id, NLM_NETWORK_PROPERTY_CHANGE_CONNECTION );
+        unlist_connection( connection );
+    }
+
+    /* each network reaches what its connections reach together */
+    LIST_FOR_EACH_ENTRY_SAFE( network, next_network, &state->networks, struct network, entry )
+    {
+        NLM_CONNECTIVITY conn = 0;
+
+        LIST_FOR_EACH_ENTRY( connection, &state->connections, struct connection, entry )
+            if (IsEqualGUID( &connection->network_id, &network->id )) conn |= connection->connectivity;
+        if (conn != network->connectivity)
+        {
+            if (!first) add_event( events, EVENT_NETWORK_CONNECTIVITY, &network->id, conn );
+            if (!is_connected( network->connectivity ) && is_connected( conn )) touch_profile( network );
+            network->connectivity = conn;
+        }
+        connectivity |= conn;
+        if (!network->seen)
+        {
+            /* an unidentified network whose interface went, or a profile deleted */
+            add_event( events, EVENT_NETWORK_DELETED, &network->id, 0 );
+            unlist_network( network );
+        }
+    }
+
+    /* the networks connected come first */
+    {
+        struct list connected = LIST_INIT( connected );
+        LIST_FOR_EACH_ENTRY_SAFE( network, next_network, &state->networks, struct network, entry )
+        {
+            if (!is_connected( network->connectivity )) continue;
+            list_remove( &network->entry );
+            list_add_tail( &connected, &network->entry );
+        }
+        list_move_head( &state->networks, &connected );
+    }
+
+    if (connectivity != state->connectivity && !first)
+        add_event( events, EVENT_CONNECTIVITY, NULL, connectivity );
+    state->connectivity = connectivity;
+    state->refreshed = TRUE;
+}
+
+/* the sinks */
+
+static HRESULT call_sink( IUnknown *unk, const struct event *event )
+{
+    HRESULT hr = S_OK;
+
+    switch (event->type)
+    {
+    case EVENT_CONNECTIVITY:
+        hr = INetworkListManagerEvents_ConnectivityChanged( (INetworkListManagerEvents *)unk, event->value );
+        break;
+    case EVENT_NETWORK_ADDED:
+        hr = INetworkEvents_NetworkAdded( (INetworkEvents *)unk, event->id );
+        break;
+    case EVENT_NETWORK_DELETED:
+        hr = INetworkEvents_NetworkDeleted( (INetworkEvents *)unk, event->id );
+        break;
+    case EVENT_NETWORK_CONNECTIVITY:
+        hr = INetworkEvents_NetworkConnectivityChanged( (INetworkEvents *)unk, event->id, event->value );
+        break;
+    case EVENT_NETWORK_PROPERTY:
+        hr = INetworkEvents_NetworkPropertyChanged( (INetworkEvents *)unk, event->id, event->value );
+        break;
+    case EVENT_CONNECTION_CONNECTIVITY:
+        hr = INetworkConnectionEvents_NetworkConnectionConnectivityChanged( (INetworkConnectionEvents *)unk,
+                                                                            event->id, event->value );
+        break;
+    }
+    return hr;
+}
+
+static unsigned int event_cp( const struct event *event )
+{
+    switch (event->type)
+    {
+    case EVENT_CONNECTIVITY: return CP_LIST_MANAGER_EVENTS;
+    case EVENT_CONNECTION_CONNECTIVITY: return CP_CONNECTION_EVENTS;
+    default: return CP_NETWORK_EVENTS;
+    }
+}
+
+/* tell the sinks, from the global interface table so that they are called in their own apartments */
+static void deliver_events( struct state *state, struct list *events )
+{
+    IGlobalInterfaceTable *git = NULL;
+    struct event *event, *next;
+
+    if (list_empty( events )) return;
+    CoCreateInstance( &CLSID_StdGlobalInterfaceTable, NULL, CLSCTX_INPROC_SERVER, &IID_IGlobalInterfaceTable,
+                      (void **)&git );
+    LIST_FOR_EACH_ENTRY_SAFE( event, next, events, struct event, entry )
+    {
+        unsigned int cp = event_cp( event ), i, count = 0;
+        struct sink *sink;
+        IUnknown **unks;
+
+        TRACE( "event %u %s %#lx\n", event->type, debugstr_guid(&event->id), event->value );
+        EnterCriticalSection( &state->cs );
+        unks = malloc( list_count( &state->sinks[cp] ) * sizeof(*unks) + 1 );
+        LIST_FOR_EACH_ENTRY( sink, &state->sinks[cp], struct sink, entry )
+        {
+            IUnknown *unk = NULL;
+
+            if (!unks) break;
+            if (sink->git_cookie && git)
+                IGlobalInterfaceTable_GetInterfaceFromGlobal( git, sink->git_cookie, cp_iids[cp], (void **)&unk );
+            else if ((unk = sink->unk))
+                IUnknown_AddRef( unk );
+            if (unk) unks[count++] = unk;
+        }
+        LeaveCriticalSection( &state->cs );
+        for (i = 0; i < count; i++)
+        {
+            call_sink( unks[i], event );
+            IUnknown_Release( unks[i] );
+        }
+        free( unks );
+        list_remove( &event->entry );
+        free( event );
+    }
+    if (git) IGlobalInterfaceTable_Release( git );
+}
+
+static void CALLBACK change_callback( void *context, void *row, MIB_NOTIFICATION_TYPE type )
+{
+    struct state *state = context;
+
+    if (type != MibInitialNotification) SetEvent( state->changed );
+}
+
+static void CALLBACK unicast_callback( void *context, MIB_UNICASTIPADDRESS_ROW *row, MIB_NOTIFICATION_TYPE type )
+{
+    change_callback( context, row, type );
+}
+
+static void CALLBACK interface_callback( void *context, MIB_IPINTERFACE_ROW *row, MIB_NOTIFICATION_TYPE type )
+{
+    change_callback( context, row, type );
+}
+
+static void CALLBACK route_callback( void *context, MIB_IPFORWARD_ROW2 *row, MIB_NOTIFICATION_TYPE type )
+{
+    change_callback( context, row, type );
+}
+
+/* refresh on the host's changes while someone listens, and tell them */
+static DWORD WINAPI monitor_proc( void *arg )
+{
+    struct state *state = arg;
+    HANDLE handles[2] = { state->stop, state->changed };
+    HMODULE module = NULL;
+
+    SetThreadDescription( GetCurrentThread(), L"wine_netprofm_monitor" );
+    GetModuleHandleExW( GET_MODULE_HANDLE_EX_FLAG_FROM_ADDRESS, (const WCHAR *)monitor_proc, &module );
+    CoInitializeEx( NULL, COINIT_MULTITHREADED );
+
+    while (WaitForMultipleObjects( 2, handles, FALSE, INFINITE ) == WAIT_OBJECT_0 + 1)
+    {
+        /* changes come in bursts; let the burst end */
+        while (!WaitForSingleObject( state->changed, 200 ));
+        if (!WaitForSingleObject( state->stop, 0 )) break;
+        refresh_and_deliver( state, TRUE );
+    }
+
+    CoUninitialize();
+    state_release( state );
+    if (module) FreeLibraryAndExitThread( module, 0 );
+    return 0;
+}
+
+static void start_monitor( struct state *state )
+{
+    if (state->thread) return;
+    state->changed = CreateEventW( NULL, FALSE, FALSE, NULL );
+    state->stop = CreateEventW( NULL, TRUE, FALSE, NULL );
+    state_addref( state );
+    if (!(state->thread = CreateThread( NULL, 0, monitor_proc, state, 0, NULL )))
+    {
+        state_release( state );
+        return;
+    }
+    NotifyUnicastIpAddressChange( AF_UNSPEC, unicast_callback, state, FALSE, &state->notify[0] );
+    NotifyIpInterfaceChange( AF_UNSPEC, interface_callback, state, FALSE, &state->notify[1] );
+    NotifyRouteChange2( AF_UNSPEC, route_callback, state, FALSE, &state->notify[2] );
+}
+
+static void stop_monitor( struct state *state )
+{
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(state->notify); i++)
+    {
+        if (state->notify[i]) CancelMibChangeNotify2( state->notify[i] );
+        state->notify[i] = NULL;
+    }
+    if (!state->thread) return;
+    SetEvent( state->stop );
+    /* the thread goes on its own; it may be the one releasing the manager from a sink */
+    CloseHandle( state->thread );
+    state->thread = NULL;
+}
+
+static void state_release( struct state *state )
+{
+    struct network *network, *next_network;
+    struct connection *connection, *next_connection;
+
+    if (InterlockedDecrement( &state->refs )) return;
+    TRACE( "destroying state %p\n", state );
+    LIST_FOR_EACH_ENTRY_SAFE( connection, next_connection, &state->connections, struct connection, entry )
+        unlist_connection( connection );
+    LIST_FOR_EACH_ENTRY_SAFE( network, next_network, &state->networks, struct network, entry )
+        unlist_network( network );
+    if (state->changed) CloseHandle( state->changed );
+    if (state->stop) CloseHandle( state->stop );
+    state->cs.DebugInfo->Spare[0] = 0;
+    DeleteCriticalSection( &state->cs );
+    free( state );
+}
