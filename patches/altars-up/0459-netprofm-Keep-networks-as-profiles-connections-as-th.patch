+            hr = IConnectionPoint_GetConnectionInterface( pt2, &iid );
+            ok( hr == S_OK, "got %08lx\n", hr );
+            if (i < ARRAY_SIZE(iids))
+                ok( IsEqualIID( &iid, iids[i] ), "%u: got %s\n", i, wine_dbgstr_guid(&iid) );
+            IConnectionPoint_Release( pt2 );
+            i++;
+        }
+        ok( i == ARRAY_SIZE(iids), "got %u points\n", i );
+        IEnumConnectionPoints_Release( points );
+    }
+
     hr = IConnectionPointContainer_FindConnectionPoint( cpc, &IID_INetworkListManagerEvents, &pt2 );
     ok( hr == S_OK, "got %08lx\n", hr );
     ok( pt == pt2, "pt != pt2\n");
