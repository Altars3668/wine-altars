+/* Refresh the state, telling those who listen what changed.  While the monitor runs the host's changes keep it
+ * current; otherwise a question refreshes it, at most once a second. */
+static void refresh_and_deliver( struct state *state, BOOL force )
 {
-    FIXME( "%p, %s\n", iface, debugstr_w(szNetworkNewName) );
-    return E_NOTIMPL;
+    struct list events = LIST_INIT( events );
+
+    EnterCriticalSection( &state->cs );
+    if (force || !state->refreshed || (!state->thread && GetTickCount() - state->last_refresh >= 1000))
+    {
+        refresh( state, &events );
+        state->last_refresh = GetTickCount();
+    }
+    LeaveCriticalSection( &state->cs );
+    deliver_events( state, &events );
 }
 
