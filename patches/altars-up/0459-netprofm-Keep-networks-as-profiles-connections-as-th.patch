+struct connections
+{
+    IEnumConnections IEnumConnections_iface;
+    LONG refs;
+    CONNECTDATA *data;
+    ULONG count, pos;
+};
+
+static inline struct connections *impl_from_IEnumConnections( IEnumConnections *iface )
+{
+    return CONTAINING_RECORD( iface, struct connections, IEnumConnections_iface );
+}
+
+static HRESULT WINAPI enum_connections_QueryInterface( IEnumConnections *iface, REFIID riid, void **obj )
+{
+    if (IsEqualGUID( riid, &IID_IEnumConnections ) || IsEqualGUID( riid, &IID_IUnknown ))
+    {
+        *obj = iface;
+        IEnumConnections_AddRef( iface );
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI enum_connections_AddRef( IEnumConnections *iface )
+{
+    struct connections *iter = impl_from_IEnumConnections( iface );
+    return InterlockedIncrement( &iter->refs );
+}
+
+static ULONG WINAPI enum_connections_Release( IEnumConnections *iface )
+{
+    struct connections *iter = impl_from_IEnumConnections( iface );
+    ULONG refs = InterlockedDecrement( &iter->refs ), i;
+
+    if (!refs)
+    {
+        for (i = 0; i < iter->count; i++) IUnknown_Release( iter->data[i].pUnk );
+        free( iter->data );
+        free( iter );
+    }
+    return refs;
+}
+
+static HRESULT WINAPI enum_connections_Next( IEnumConnections *iface, ULONG count, CONNECTDATA *ret, ULONG *fetched )
+{
+    struct connections *iter = impl_from_IEnumConnections( iface );
+    ULONG i = 0;
+
+    if (!ret) return E_POINTER;
+    while (i < count && iter->pos < iter->count)
+    {
+        ret[i] = iter->data[iter->pos++];
+        IUnknown_AddRef( ret[i].pUnk );
+        i++;
+    }
+    if (fetched) *fetched = i;
+    return i == count ? S_OK : S_FALSE;
+}
+
+static HRESULT WINAPI enum_connections_Skip( IEnumConnections *iface, ULONG count )
+{
+    struct connections *iter = impl_from_IEnumConnections( iface );
+
+    if (count > iter->count - iter->pos)
+    {
+        iter->pos = iter->count;
+        return S_FALSE;
+    }
+    iter->pos += count;
+    return S_OK;
+}
+
+static HRESULT WINAPI enum_connections_Reset( IEnumConnections *iface )
+{
+    struct connections *iter = impl_from_IEnumConnections( iface );
+    iter->pos = 0;
+    return S_OK;
+}
+
+static HRESULT create_enum_connections( const CONNECTDATA *data, ULONG count, ULONG pos, IEnumConnections **ret );
+
+static HRESULT WINAPI enum_connections_Clone( IEnumConnections *iface, IEnumConnections **ret )
+{
+    struct connections *iter = impl_from_IEnumConnections( iface );
+    return create_enum_connections( iter->data, iter->count, iter->pos, ret );
+}
+
+static const IEnumConnectionsVtbl enum_connections_vtbl =
+{
+    enum_connections_QueryInterface,
+    enum_connections_AddRef,
+    enum_connections_Release,
+    enum_connections_Next,
+    enum_connections_Skip,
+    enum_connections_Reset,
+    enum_connections_Clone
+};
+
+static HRESULT create_enum_connections( const CONNECTDATA *data, ULONG count, ULONG pos, IEnumConnections **ret )
+{
+    struct connections *iter;
+    ULONG i;
+
+    if (!(iter = calloc( 1, sizeof(*iter) ))) return E_OUTOFMEMORY;
+    if (count && !(iter->data = malloc( count * sizeof(*data) )))
+    {
+        free( iter );
+        return E_OUTOFMEMORY;
+    }
+    iter->IEnumConnections_iface.lpVtbl = &enum_connections_vtbl;
+    iter->refs = 1;
+    iter->count = count;
+    iter->pos = pos;
+    for (i = 0; i < count; i++)
+    {
+        iter->data[i] = data[i];
+        IUnknown_AddRef( iter->data[i].pUnk );
+    }
+    *ret = &iter->IEnumConnections_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI connection_point_EnumConnections( IConnectionPoint *iface, IEnumConnections **ret )
+{
+    struct connection_point *cp = impl_from_IConnectionPoint( iface );
+    struct state *state = cp->mgr->state;
+    IGlobalInterfaceTable *git = NULL;
+    CONNECTDATA *data;
+    struct sink *sink;
+    ULONG count = 0, i;
+    HRESULT hr;
+
+    TRACE( "%p, %p\n", cp, ret );
+
+    if (!ret) return E_POINTER;
+    CoCreateInstance( &CLSID_StdGlobalInterfaceTable, NULL, CLSCTX_INPROC_SERVER, &IID_IGlobalInterfaceTable,
+                      (void **)&git );
+    EnterCriticalSection( &state->cs );
+    if (!(data = calloc( list_count( &state->sinks[cp->index] ) + 1, sizeof(*data) )))
+    {
+        LeaveCriticalSection( &state->cs );
+        if (git) IGlobalInterfaceTable_Release( git );
+        return E_OUTOFMEMORY;
+    }
+    LIST_FOR_EACH_ENTRY( sink, &state->sinks[cp->index], struct sink, entry )
+    {
+        IUnknown *unk = NULL;
+
+        if (sink->git_cookie && git)
+            IGlobalInterfaceTable_GetInterfaceFromGlobal( git, sink->git_cookie, &IID_IUnknown, (void **)&unk );
+        else if ((unk = sink->unk))
+            IUnknown_AddRef( unk );
+        if (!unk) continue;
+        data[count].pUnk = unk;
+        data[count++].dwCookie = sink->cookie;
+    }
+    LeaveCriticalSection( &state->cs );
+    hr = create_enum_connections( data, count, 0, ret );
+    for (i = 0; i < count; i++) IUnknown_Release( data[i].pUnk );
+    free( data );
+    if (git) IGlobalInterfaceTable_Release( git );
+    return hr;
+}
+
+static const IConnectionPointVtbl connection_point_vtbl =
+{
+    connection_point_QueryInterface,
+    connection_point_AddRef,
+    connection_point_Release,
+    connection_point_GetConnectionInterface,
+    connection_point_GetConnectionPointContainer,
+    connection_point_Advise,
+    connection_point_Unadvise,
+    connection_point_EnumConnections
 };
 
