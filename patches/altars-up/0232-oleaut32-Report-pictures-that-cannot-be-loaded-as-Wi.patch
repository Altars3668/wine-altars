From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 19:14:46 -0400
Subject: [PATCH] oleaut32: Report pictures that cannot be loaded as Windows
 does.

Measured on Windows 11 (build 29671): OleLoadPicture of data that is no
picture answers CTL_E_INVALIDPICTURE, while a metafile without a
placeable header is still refused with E_FAIL; OleLoadPictureFile of a
path whose folder is not there answers CTL_E_PATHNOTFOUND, and of an
empty name succeeds with an empty picture (PICTYPE_NONE).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 3622d349dc6b79edcc47bdcb680541adb2b9439c)

diff --git a/dlls/oleaut32/olepicture.c b/dlls/oleaut32/olepicture.c
index b2d6092e11c..f0c0cba3b7e 100644
--- a/dlls/oleaut32/olepicture.c
+++ b/dlls/oleaut32/olepicture.c
@@ -1558,7 +1558,11 @@ static HRESULT WINAPI OLEPictureImpl_Load(IPersistStream* iface, IStream *pStm)
     if (hr == S_OK) break;
 
     FIXME("Unknown magic %04x, %ld read bytes:\n", magic, xread);
-    hr=E_FAIL;
+    /* a metafile without a placeable header is refused, anything else is no picture */
+    if ((magic == 1 || magic == 2) && xread >= 4 && xbuf[2] == 9 && !xbuf[3])
+        hr=E_FAIL;
+    else
+        hr=CTL_E_INVALIDPICTURE;
     for (i=0;i<xread+8;i++) {
 	if (i<8) FIXME("%02x ",((unsigned char*)header)[i]);
 	else FIXME("%02x ",xbuf[i-8]);
@@ -2613,11 +2617,20 @@ HRESULT WINAPI OleLoadPictureFile(VARIANT filename, IDispatch **picture)
     if (V_VT(&filename) != VT_BSTR)
         return CTL_E_FILENOTFOUND;
 
+    /* no name is an empty picture */
+    if (!SysStringLen(V_BSTR(&filename)))
+    {
+        PICTDESC desc = { sizeof(desc), PICTYPE_NONE };
+        return OleCreatePictureIndirect(&desc, &IID_IDispatch, TRUE, (void **)picture);
+    }
+
     hr = create_stream(V_BSTR(&filename), &stream);
     if (hr != S_OK)
     {
         if (hr == HRESULT_FROM_WIN32(ERROR_FILE_NOT_FOUND))
             return CTL_E_FILENOTFOUND;
+        if (hr == HRESULT_FROM_WIN32(ERROR_PATH_NOT_FOUND))
+            return CTL_E_PATHNOTFOUND;
 
         return CTL_E_PATHFILEACCESSERROR;
     }
diff --git a/dlls/oleaut32/tests/olepicture.c b/dlls/oleaut32/tests/olepicture.c
index 614020a1026..61bb3172759 100644
--- a/dlls/oleaut32/tests/olepicture.c
+++ b/dlls/oleaut32/tests/olepicture.c
@@ -1050,6 +1050,73 @@ static void test_get_Type(void)
     IPicture_Release(pic);
 }
 
+static void test_OleLoadPictureFile_errors(void)
+{
+    static const char garbage[] = "this is no picture at all, just some text in a stream\r\n";
+    WCHAR path[MAX_PATH];
+    IPicture *pic;
+    IDispatch *disp;
+    IStream *stream;
+    HGLOBAL mem;
+    HANDLE file;
+    VARIANT var;
+    HRESULT hr;
+    DWORD size;
+    short type;
+
+    /* data that is no picture */
+    mem = GlobalAlloc(GMEM_MOVEABLE, sizeof(garbage));
+    memcpy(GlobalLock(mem), garbage, sizeof(garbage));
+    GlobalUnlock(mem);
+    hr = CreateStreamOnHGlobal(mem, TRUE, &stream);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    pic = (void *)0xdeadbeef;
+    hr = OleLoadPicture(stream, 0, FALSE, &IID_IPicture, (void **)&pic);
+    ok(hr == CTL_E_INVALIDPICTURE, "got %#lx\n", hr);
+    ok(!pic, "got %p\n", pic);
+    IStream_Release(stream);
+
+    GetTempPathW(ARRAY_SIZE(path), path);
+    lstrcatW(path, L"wine-olepicture.txt");
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    WriteFile(file, garbage, sizeof(garbage) - 1, &size, NULL);
+    CloseHandle(file);
+    V_VT(&var) = VT_BSTR;
+    V_BSTR(&var) = SysAllocString(path);
+    disp = (void *)0xdeadbeef;
+    hr = OleLoadPictureFile(var, &disp);
+    ok(hr == CTL_E_INVALIDPICTURE, "got %#lx\n", hr);
+    VariantClear(&var);
+    DeleteFileW(path);
+
+    /* a directory that is not there */
+    V_VT(&var) = VT_BSTR;
+    V_BSTR(&var) = SysAllocString(L"C:\\wine-no-such-dir\\picture.bmp");
+    hr = OleLoadPictureFile(var, &disp);
+    ok(hr == CTL_E_PATHNOTFOUND, "got %#lx\n", hr);
+    VariantClear(&var);
+
+    /* no name at all is an empty picture */
+    V_VT(&var) = VT_BSTR;
+    V_BSTR(&var) = SysAllocString(L"");
+    disp = NULL;
+    hr = OleLoadPictureFile(var, &disp);
+    ok(hr == S_OK, "got %#lx\n", hr);
+    ok(disp != NULL, "got no picture\n");
+    VariantClear(&var);
+    if (disp)
+    {
+        hr = IDispatch_QueryInterface(disp, &IID_IPicture, (void **)&pic);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        type = -1;
+        hr = IPicture_get_Type(pic, &type);
+        ok(hr == S_OK, "got %#lx\n", hr);
+        ok(type == PICTYPE_NONE, "got type %d\n", type);
+        IPicture_Release(pic);
+        IDispatch_Release(disp);
+    }
+}
+
 static void test_OleLoadPicturePath(void)
 {
     static WCHAR emptyW[] = {0};
@@ -1835,6 +1902,7 @@ START_TEST(olepicture)
     test_get_Handle();
     test_get_Type();
     test_OleLoadPicturePath();
+    test_OleLoadPictureFile_errors();
     test_himetric();
     test_load_save_bmp();
     test_load_save_dib();
