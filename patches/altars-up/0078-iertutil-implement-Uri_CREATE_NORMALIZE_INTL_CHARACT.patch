From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 19:02:27 -0400
Subject: [PATCH] iertutil: implement Uri_CREATE_NORMALIZE_INTL_CHARACTERS.
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The flag decodes percent-encoded UTF-8 into the characters it stands
for, in the host, the user info, the path, and, unless
NO_DECODE_EXTRA_INFO is set, the query and fragment.  It is what
Windows.Foundation.Uri parses with, so "http://example.com/%e4%b8%ad"
has "/中" for its path there.

What it decodes was measured code point by code point on Windows: a
well formed sequence of a character from RFC 3987's ucschar, less what
RFC 3454 keeps out of an internationalized name (non-ASCII spaces,
controls, bidirectional and other formatting characters), less the
halfwidth and fullwidth forms, private use characters and
noncharacters, and less U+xFFFD of the supplementary planes but the
fourteenth.  Anything else, a truncated or overlong sequence among
them, stays encoded as it was, while the sequences around it decode.

Only the schemes Windows does it for: http, https, ftp, gopher, nntp,
news, snews, telnet, wais, mailto and the wildcard scheme; not res,
about, javascript or an unknown scheme.  A host made of such
characters is an IDN.

A file URI decodes each percent-encoded byte beyond ASCII in its path
into the character with that value, flag or not, as Windows does:
"file:///c:/%e4%b8%ad" has "/c:/\u00e4\u00b8\u00ad".

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit f82d8ac273e660a67b0902fb680af53708718a83)

diff --git a/dlls/iertutil/uri.c b/dlls/iertutil/uri.c
index 4b93ad053fa..e8bfca72f8d 100644
--- a/dlls/iertutil/uri.c
+++ b/dlls/iertutil/uri.c
@@ -480,6 +480,116 @@ static inline void pct_encode_val(WCHAR val, WCHAR *dest) {
     dest[2] = hexDigits[val & 0xf];
 }
 
+/* Whether a character may appear decoded in an IRI, as Windows has it:
+ * RFC 3987's ucschar, less the characters RFC 3454 keeps out of an
+ * internationalized name (spaces, controls, formatting characters), and less
+ * the fullwidth and halfwidth forms.
+ */
+static BOOL is_iri_char(unsigned int c) {
+    static const struct { unsigned int first, last; } excluded[] = {
+        {0x0340, 0x0341}, {0x06dd, 0x06dd}, {0x070f, 0x070f}, {0x1680, 0x1680}, {0x180e, 0x180e},
+        {0x2000, 0x200f}, {0x2028, 0x202f}, {0x205f, 0x2063}, {0x206a, 0x206f}, {0x2ff0, 0x2ffb},
+        {0x3000, 0x3000}
+    };
+    DWORD i;
+
+    if(c <= 0xa0)
+        return FALSE;
+    if(c <= 0xd7ff) {
+        for(i = 0; i < ARRAY_SIZE(excluded); i++)
+            if(c >= excluded[i].first && c <= excluded[i].last)
+                return FALSE;
+        return TRUE;
+    }
+    if((c >= 0xf900 && c <= 0xfdcf) || (c >= 0xfdf0 && c <= 0xfefe))
+        return TRUE;
+    if(c >= 0xe1000 && c <= 0xefffd)
+        return TRUE;
+    return c >= 0x10000 && c < 0xe0000 && (c & 0xffff) < 0xfffd;
+}
+
+/* The schemes Uri_CREATE_NORMALIZE_INTL_CHARACTERS decodes characters in. */
+static BOOL normalizes_intl_chars(URL_SCHEME scheme) {
+    switch(scheme) {
+    case URL_SCHEME_HTTP:
+    case URL_SCHEME_HTTPS:
+    case URL_SCHEME_FTP:
+    case URL_SCHEME_GOPHER:
+    case URL_SCHEME_NNTP:
+    case URL_SCHEME_NEWS:
+    case URL_SCHEME_SNEWS:
+    case URL_SCHEME_TELNET:
+    case URL_SCHEME_WAIS:
+    case URL_SCHEME_MAILTO:
+    case URL_SCHEME_WILDCARD:
+        return TRUE;
+    default:
+        return FALSE;
+    }
+}
+
+/* With Uri_CREATE_NORMALIZE_INTL_CHARACTERS, a percent encoded UTF-8
+ * sequence of a character that may appear in an IRI is decoded to it.  If
+ * 'ptr' starts one, this writes the character to 'out' (when it's not NULL),
+ * its length to 'out_len', and returns how much of the URI it took.  Anything
+ * else is left for the caller: a sequence that is not well formed UTF-8, or a
+ * character Windows does not decode, stays as it is.
+ */
+static DWORD decode_intl_char(const WCHAR *ptr, const WCHAR *end, URL_SCHEME scheme, DWORD flags,
+                              WCHAR *out, DWORD *out_len) {
+    BYTE bytes[4];
+    DWORD count, i;
+    unsigned int c;
+
+    if(!(flags & Uri_CREATE_NORMALIZE_INTL_CHARACTERS) || !normalizes_intl_chars(scheme))
+        return 0;
+    if(end - ptr < 6 || *ptr != '%' || !is_hexdigit(ptr[1]) || !is_hexdigit(ptr[2]))
+        return 0;
+
+    bytes[0] = decode_pct_val(ptr);
+    if(bytes[0] >= 0xc2 && bytes[0] <= 0xdf)
+        count = 2;
+    else if(bytes[0] >= 0xe0 && bytes[0] <= 0xef)
+        count = 3;
+    else if(bytes[0] >= 0xf0 && bytes[0] <= 0xf4)
+        count = 4;
+    else
+        return 0;
+    if(end - ptr < count * 3)
+        return 0;
+    for(i = 1; i < count; i++) {
+        const WCHAR *p = ptr + i * 3;
+        if(p[0] != '%' || !is_hexdigit(p[1]) || !is_hexdigit(p[2]))
+            return 0;
+        bytes[i] = decode_pct_val(p);
+        if((bytes[i] & 0xc0) != 0x80)
+            return 0;
+    }
+
+    if(count == 2)
+        c = ((bytes[0] & 0x1f) << 6) | (bytes[1] & 0x3f);
+    else if(count == 3)
+        c = ((bytes[0] & 0x0f) << 12) | ((bytes[1] & 0x3f) << 6) | (bytes[2] & 0x3f);
+    else
+        c = ((bytes[0] & 0x07) << 18) | ((bytes[1] & 0x3f) << 12) | ((bytes[2] & 0x3f) << 6) | (bytes[3] & 0x3f);
+    /* overlong, surrogate and out of range sequences are not characters */
+    if((count == 3 && c < 0x800) || (count == 4 && (c < 0x10000 || c > 0x10ffff)) || !is_iri_char(c))
+        return 0;
+
+    if(c >= 0x10000) {
+        if(out) {
+            out[0] = 0xd800 | ((c - 0x10000) >> 10);
+            out[1] = 0xdc00 | ((c - 0x10000) & 0x3ff);
+        }
+        *out_len = 2;
+    } else {
+        if(out)
+            out[0] = c;
+        *out_len = 1;
+    }
+    return count * 3;
+}
+
 /* Attempts to parse the domain name from the host.
  *
  * This function also includes the Top-level Domain (TLD) name
@@ -1845,6 +1955,15 @@ static BOOL canonicalize_username(const parse_data *data, Uri *uri, DWORD flags,
 
     uri->userinfo_start = uri->canon_len;
     for(ptr = data->username; ptr < data->username+data->username_len; ++ptr) {
+        DWORD taken, decoded_len;
+
+        if((taken = decode_intl_char(ptr, data->username+data->username_len, data->scheme_type, flags,
+                                     computeOnly ? NULL : uri->canon_uri+uri->canon_len, &decoded_len))) {
+            uri->canon_len += decoded_len;
+            ptr += taken - 1;
+            continue;
+        }
+
         if(*ptr == '%') {
             /* Only decode % encoded values for known scheme types. */
             if(data->scheme_type != URL_SCHEME_UNKNOWN) {
@@ -1903,6 +2022,15 @@ static BOOL canonicalize_password(const parse_data *data, Uri *uri, DWORD flags,
     ++uri->canon_len;
 
     for(ptr = data->password; ptr < data->password+data->password_len; ++ptr) {
+        DWORD taken, decoded_len;
+
+        if((taken = decode_intl_char(ptr, data->password+data->password_len, data->scheme_type, flags,
+                                     computeOnly ? NULL : uri->canon_uri+uri->canon_len, &decoded_len))) {
+            uri->canon_len += decoded_len;
+            ptr += taken - 1;
+            continue;
+        }
+
         if(*ptr == '%') {
             /* Only decode % encoded values for known scheme types. */
             if(data->scheme_type != URL_SCHEME_UNKNOWN) {
@@ -2023,6 +2151,21 @@ static BOOL canonicalize_reg_name(const parse_data *data, Uri *uri,
     uri->host_start = uri->canon_len;
 
     for(ptr = data->host; ptr < data->host+data->host_len; ++ptr) {
+        WCHAR decoded[2];
+        DWORD taken, decoded_len;
+
+        if((taken = decode_intl_char(ptr, data->host+data->host_len, data->scheme_type, flags, decoded, &decoded_len))) {
+            if(!computeOnly) {
+                /* Lower cased like the rest of the host. */
+                if(decoded_len == 1 && !(flags & Uri_CREATE_NO_CANONICALIZE))
+                    decoded[0] = towlower(decoded[0]);
+                memcpy(uri->canon_uri+uri->canon_len, decoded, decoded_len*sizeof(WCHAR));
+            }
+            uri->canon_len += decoded_len;
+            ptr += taken - 1;
+            continue;
+        }
+
         if(*ptr == '%' && known_scheme) {
             WCHAR val = decode_pct_val(ptr);
             if(is_unreserved(val)) {
@@ -2227,6 +2370,17 @@ static BOOL canonicalize_host(const parse_data *data, Uri *uri, DWORD flags, BOO
             if(!canonicalize_reg_name(data, uri, flags, computeOnly))
                 return FALSE;
 
+            /* Characters Uri_CREATE_NORMALIZE_INTL_CHARACTERS decoded make it an IDN. */
+            if(!computeOnly) {
+                DWORD i;
+
+                for(i = 0; i < uri->host_len; i++) {
+                    if(!is_ascii(uri->canon_uri[uri->host_start+i])) {
+                        uri->host_type = Uri_HOST_IDN;
+                        break;
+                    }
+                }
+            }
             break;
         case Uri_HOST_IPV4:
             uri->host_type = Uri_HOST_IPV4;
@@ -2443,6 +2597,13 @@ static DWORD canonicalize_path_hierarchical(const WCHAR *path, DWORD path_len, U
 
     for(; ptr < path+path_len; ++ptr) {
         BOOL do_default_action = TRUE;
+        DWORD taken, decoded_len;
+
+        if((taken = decode_intl_char(ptr, path+path_len, scheme_type, flags, ret_path ? ret_path+len : NULL, &decoded_len))) {
+            len += decoded_len;
+            ptr += taken - 1;
+            continue;
+        }
 
         if(*ptr == '%' && !is_res) {
             const WCHAR *tmp = ptr;
@@ -2459,7 +2620,7 @@ static DWORD canonicalize_path_hierarchical(const WCHAR *path, DWORD path_len, U
                 len += 3;
                 do_default_action = FALSE;
             } else if((is_unreserved(val) && known_scheme) ||
-                      (is_file && !is_implicit_scheme && (is_unreserved(val) || is_reserved(val) ||
+                      (is_file && !is_implicit_scheme && (is_unreserved(val) || is_reserved(val) || val >= 0x80 ||
                       (val && flags&Uri_CREATE_FILE_USE_DOS_PATH && !is_forbidden_dos_path_char(val))))) {
                 if(ret_path)
                     ret_path[len] = val;
@@ -2581,6 +2742,14 @@ static BOOL canonicalize_path_opaque(const parse_data *data, Uri *uri, DWORD fla
 
     for(ptr = data->path; ptr < data->path+data->path_len; ++ptr) {
         BOOL do_default_action = TRUE;
+        DWORD taken, decoded_len;
+
+        if((taken = decode_intl_char(ptr, data->path+data->path_len, data->scheme_type, flags,
+                                     computeOnly ? NULL : uri->canon_uri+uri->canon_len, &decoded_len))) {
+            uri->canon_len += decoded_len;
+            ptr += taken - 1;
+            continue;
+        }
 
         if(*ptr == '%' && known_scheme) {
             WCHAR val = decode_pct_val(ptr);
@@ -2750,6 +2919,16 @@ static BOOL canonicalize_query(const parse_data *data, Uri *uri, DWORD flags, BO
 
     end = data->query+data->query_len;
     for(ptr = data->query; ptr < end; ++ptr) {
+        DWORD taken, decoded_len;
+
+        if(!(flags & Uri_CREATE_NO_DECODE_EXTRA_INFO) &&
+           (taken = decode_intl_char(ptr, end, data->scheme_type, flags,
+                                     computeOnly ? NULL : uri->canon_uri+uri->canon_len, &decoded_len))) {
+            uri->canon_len += decoded_len;
+            ptr += taken - 1;
+            continue;
+        }
+
         if(*ptr == '%') {
             if(known_scheme && !(flags & Uri_CREATE_NO_DECODE_EXTRA_INFO)) {
                 WCHAR val = decode_pct_val(ptr);
@@ -2800,6 +2979,16 @@ static BOOL canonicalize_fragment(const parse_data *data, Uri *uri, DWORD flags,
 
     end = data->fragment + data->fragment_len;
     for(ptr = data->fragment; ptr < end; ++ptr) {
+        DWORD taken, decoded_len;
+
+        if(!(flags & Uri_CREATE_NO_DECODE_EXTRA_INFO) &&
+           (taken = decode_intl_char(ptr, end, data->scheme_type, flags,
+                                     computeOnly ? NULL : uri->canon_uri+uri->canon_len, &decoded_len))) {
+            uri->canon_len += decoded_len;
+            ptr += taken - 1;
+            continue;
+        }
+
         if(*ptr == '%') {
             if(known_scheme && !(flags & Uri_CREATE_NO_DECODE_EXTRA_INFO)) {
                 WCHAR val = decode_pct_val(ptr);
@@ -5332,7 +5521,8 @@ HRESULT WINAPI CreateUri(LPCWSTR pwzURI, DWORD dwFlags, DWORD_PTR dwReserved, IU
         Uri_CREATE_ALLOW_IMPLICIT_FILE_SCHEME|Uri_CREATE_NO_CANONICALIZE|Uri_CREATE_CANONICALIZE|
         Uri_CREATE_DECODE_EXTRA_INFO|Uri_CREATE_NO_DECODE_EXTRA_INFO|Uri_CREATE_CRACK_UNKNOWN_SCHEMES|
         Uri_CREATE_NO_CRACK_UNKNOWN_SCHEMES|Uri_CREATE_PRE_PROCESS_HTML_URI|Uri_CREATE_NO_PRE_PROCESS_HTML_URI|
-        Uri_CREATE_NO_IE_SETTINGS|Uri_CREATE_NO_ENCODE_FORBIDDEN_CHARACTERS|Uri_CREATE_FILE_USE_DOS_PATH;
+        Uri_CREATE_NO_IE_SETTINGS|Uri_CREATE_NO_ENCODE_FORBIDDEN_CHARACTERS|Uri_CREATE_FILE_USE_DOS_PATH|
+        Uri_CREATE_NORMALIZE_INTL_CHARACTERS;
     Uri *ret;
     HRESULT hr;
     parse_data data;
diff --git a/dlls/urlmon/tests/uri.c b/dlls/urlmon/tests/uri.c
index 7d939ef5dee..86ec0cc4644 100644
--- a/dlls/urlmon/tests/uri.c
+++ b/dlls/urlmon/tests/uri.c
@@ -8495,6 +8495,90 @@ static void test_CreateUri_InvalidArgs(void) {
     ok(uri == NULL, "Error: Expected the IUri to be NULL, but it was %p instead\n", uri);
 }
 
+/* Uri_CREATE_NORMALIZE_INTL_CHARACTERS decodes percent encoded UTF-8 into the
+ * characters an IRI may have. */
+static const struct {
+    const WCHAR *uri;
+    DWORD flags;
+    Uri_PROPERTY property;
+    const WCHAR *expected;
+} intl_tests[] = {
+    {L"http://example.com/%e4%b8%ad", 0, Uri_PROPERTY_ABSOLUTE_URI, L"http://example.com/%e4%b8%ad"},
+    {L"http://example.com/%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI,
+     L"http://example.com/\x4e2d"},
+    {L"http://example.com/%C3%A9?%C3%A9#%C3%A9", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI,
+     L"http://example.com/\x00e9?\x00e9#\x00e9"},
+    {L"http://example.com/%C3%A9?%C3%A9#%C3%A9", Uri_CREATE_NORMALIZE_INTL_CHARACTERS|Uri_CREATE_NO_DECODE_EXTRA_INFO,
+     Uri_PROPERTY_ABSOLUTE_URI, L"http://example.com/\x00e9?%C3%A9#%C3%A9"},
+    {L"http://example.com/%E4%B8?q=%ff#%c3", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI,
+     L"http://example.com/%E4%B8?q=%ff#%c3"},
+    {L"http://%e4%b8%ad.example/", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_HOST, L"\x4e2d.example"},
+    {L"http://example.com/%f0%9f%98%80", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH, L"/\xd83d\xde00"},
+    {L"http://example.com/%ed%a0%80%c0%af%e0%80%af%f4%90%80%80", Uri_CREATE_NORMALIZE_INTL_CHARACTERS,
+     Uri_PROPERTY_PATH, L"/%ed%a0%80%c0%af%e0%80%af%f4%90%80%80"},
+    {L"http://example.com/%e4%b8%ad%ff", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH, L"/\x4e2d%ff"},
+    {L"http://example.com/%e2%80%ae%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH,
+     L"/%e2%80%ae\x4e2d"},
+    {L"http://example.com/%E4%b8%Ad%41%2f%20", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH,
+     L"/\x4e2d" L"A%2f%20"},
+    /* spaces, controls, formatting, private use, noncharacters and fullwidth forms stay encoded */
+    {L"http://example.com/%c2%a0%c2%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH, L"/%c2%a0\x00ad"},
+    {L"http://example.com/%e2%80%8b%e2%81%a6", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH,
+     L"/%e2%80%8b\x2066"},
+    {L"http://example.com/%ef%bc%81%ef%b9%92", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH,
+     L"/%ef%bc%81\xfe52"},
+    {L"http://example.com/%ee%80%80%ef%b7%90%ef%bb%bf", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH,
+     L"/%ee%80%80%ef%b7%90%ef%bb%bf"},
+    {L"http://example.com/%f0%9f%bf%bd%f0%9f%bf%bc", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH,
+     L"/%f0%9f%bf%bd\xd83f\xdffc"},
+    {L"http://example.com/%f3%a0%80%81%f3%a1%80%80", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_PATH,
+     L"/%f3%a0%80%81\xdb44\xdc00"},
+    /* only in some schemes */
+    {L"ftp://h/%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI, L"ftp://h/\x4e2d"},
+    {L"dummy://h/%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI, L"dummy://h/%e4%b8%ad"},
+    {L"res://x.dll/%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI,
+     L"res://x.dll/%e4%b8%ad"},
+    {L"about:%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI, L"about:%e4%b8%ad"},
+    {L"mailto:%e4%b8%ad@x.com?subject=%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI,
+     L"mailto:\x4e2d@x.com?subject=\x4e2d"},
+    {L"http://%e4%b8%ad:%e4%b8%ad@h/", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_USER_INFO, L"\x4e2d:\x4e2d"},
+    {L"http://example.com/%e4%b8%ad/%2e%2e/b", Uri_CREATE_NORMALIZE_INTL_CHARACTERS|Uri_CREATE_NO_CANONICALIZE,
+     Uri_PROPERTY_PATH, L"/\x4e2d/../b"},
+    /* a file URI takes each byte as a character, whether or not it is asked to */
+    {L"file:///c:/%e4%b8%ad/%41?%e4%b8%ad#%e4%b8%ad", 0, Uri_PROPERTY_ABSOLUTE_URI,
+     L"file:///c:/\x00e4\x00b8\x00ad/A?%e4%b8%ad#%e4%b8%ad"},
+    {L"file:///c:/%e4%b8%ad/%41?%e4%b8%ad#%e4%b8%ad", Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI,
+     L"file:///c:/\x00e4\x00b8\x00ad/A?%e4%b8%ad#%e4%b8%ad"},
+};
+
+static void test_CreateUri_intl(void) {
+    DWORD i, len;
+    HRESULT hr;
+    IUri *uri;
+    BSTR str;
+
+    for(i = 0; i < ARRAY_SIZE(intl_tests); ++i) {
+        winetest_push_context("%lu %s", i, debugstr_w(intl_tests[i].uri));
+        uri = NULL;
+        hr = pCreateUri(intl_tests[i].uri, intl_tests[i].flags, 0, &uri);
+        ok(hr == S_OK, "CreateUri returned %#lx.\n", hr);
+        if(SUCCEEDED(hr)) {
+            str = NULL;
+            hr = IUri_GetPropertyBSTR(uri, intl_tests[i].property, &str, 0);
+            ok(hr == S_OK, "GetPropertyBSTR returned %#lx.\n", hr);
+            ok(str && !wcscmp(str, intl_tests[i].expected), "got %s, expected %s.\n", debugstr_w(str),
+               debugstr_w(intl_tests[i].expected));
+            SysFreeString(str);
+            len = 0;
+            hr = IUri_GetPropertyLength(uri, intl_tests[i].property, &len, 0);
+            ok(hr == S_OK, "GetPropertyLength returned %#lx.\n", hr);
+            ok(len == wcslen(intl_tests[i].expected), "got length %lu.\n", len);
+            IUri_Release(uri);
+        }
+        winetest_pop_context();
+    }
+}
+
 static void test_CreateUri_InvalidUri(void) {
     DWORD i;
 
@@ -12400,6 +12484,9 @@ START_TEST(uri) {
     trace("test CreateUri invalid URIs...\n");
     test_CreateUri_InvalidUri();
 
+    trace("test CreateUri international characters...\n");
+    test_CreateUri_intl();
+
     trace("test IUri_GetPropertyBSTR...\n");
     test_IUri_GetPropertyBSTR();
 
