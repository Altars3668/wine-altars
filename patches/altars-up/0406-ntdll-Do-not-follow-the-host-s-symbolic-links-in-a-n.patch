From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:25:27 -0400
Subject: [PATCH] ntdll: Do not follow the host's symbolic links in a
 normalized file name.

FileNormalizedNameInformation read the name the server keeps from realpath(), which follows the host's
symbolic links too: the user's Documents, a link to the home directory, came out relative to Z: while
GetFinalPathNameByHandle put it on the drive it was opened on, as C:\home\<user>\Documents, which does
not exist.  Outlook makes the folder of a new PST from it and gave up on the path.  To a Windows
program such a link is a plain directory, not a reparse point: look the name the file was opened by
up again instead, which went through any reparse point already, and take each component as it is
stored on disk.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index 85c8fadd696..bf9ed7c0e36 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2176,10 +2176,18 @@ static NTSTATUS server_get_name_info( HANDLE handle, FILE_NAME_INFORMATION *info
 }
 
 
-/* the name a file is stored under: long names, each in the case it has on disk */
+/* The name a file is stored under: long names, each in the case it has on disk.  It is looked up again from the
+ * name the file was opened by, which already went through any reparse point, rather than taken from the host's
+ * real path: a symbolic link of the host, such as the user's Documents leading to the home directory, is no
+ * reparse point to Windows programs, and following it would put the file on another drive, under a path a
+ * program then builds on. */
 static NTSTATUS get_normalized_name_info( HANDLE handle, FILE_NAME_INFORMATION *info, LONG *name_len )
 {
+    OBJECT_NAME_INFORMATION *name;
+    UNICODE_STRING nt_name_str;
+    OBJECT_ATTRIBUTES attr;
     const WCHAR *ptr, *end;
+    ULONG size = 1024;
     char *unix_name;
     NTSTATUS status;
     WCHAR *nt_name;
@@ -2191,9 +2199,27 @@ static NTSTATUS get_normalized_name_info( HANDLE handle, FILE_NAME_INFORMATION *
         free( unix_name );
         return server_get_name_info( handle, info, name_len );
     }
-    status = unix_to_nt_file_name( unix_name, &nt_name, FILE_OPEN );
     free( unix_name );
-    if (status) return status;
+
+    for (;;)
+    {
+        if (!(name = malloc( size ))) return STATUS_NO_MEMORY;
+        if (!(status = NtQueryObject( handle, ObjectNameInformation, name, size, &size ))) break;
+        free( name );
+        if (status != STATUS_INFO_LENGTH_MISMATCH && status != STATUS_BUFFER_OVERFLOW) return status;
+    }
+    InitializeObjectAttributes( &attr, &name->Name, OBJ_CASE_INSENSITIVE, 0, NULL );
+    status = get_nt_and_unix_names( &attr, &nt_name_str, &unix_name, FILE_OPEN, FALSE );
+    free( nt_name_str.Buffer );
+    free( name );
+    if (!status)
+    {
+        status = unix_to_nt_file_name( unix_name, &nt_name, FILE_OPEN );
+        free( unix_name );
+    }
+    else free( unix_name );
+    /* gone since it was opened, say */
+    if (status) return server_get_name_info( handle, info, name_len );
 
     /* Skip the volume mount point (if any). */
     ptr = nt_name;
