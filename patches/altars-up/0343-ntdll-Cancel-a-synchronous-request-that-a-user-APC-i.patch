diff --git a/dlls/ntdll/unix/server.c b/dlls/ntdll/unix/server.c
index ca2671852e1..2ce5f430b2f 100644
--- a/dlls/ntdll/unix/server.c
+++ b/dlls/ntdll/unix/server.c
@@ -833,6 +833,41 @@ unsigned int server_wait_for_object( HANDLE handle, BOOL alertable, const LARGE_
 }
 
 
+/***********************************************************************
+ *              wait_async
+ *
+ * Wait for a synchronous request on a file to finish.  When a user APC ends the wait of a file opened for
+ * alertable I/O, the request is cancelled unless it is done and waited for, as Windows does: the caller
+ * gets the status of the request and the APC runs on the way out.
+ */
+NTSTATUS wait_async( HANDLE handle, BOOL alertable, HANDLE file, IO_STATUS_BLOCK *io )
+{
+    union select_op select_op;
+    struct user_apc apc;
+    unsigned int ret;
+
+    if (!alertable) return server_wait_for_object( handle, FALSE, NULL );
+
+    select_op.wait.op = SELECT_WAIT;
+    select_op.wait.handles[0] = wine_server_obj_handle( handle );
+    ret = server_select( &select_op, offsetof( union select_op, wait.handles[1] ),
+                         SELECT_INTERRUPTIBLE | SELECT_ALERTABLE, TIMEOUT_INFINITE, NULL, &apc );
+    if (ret != STATUS_USER_APC) return ret;
+
+    SERVER_START_REQ( cancel_async )
+    {
+        req->handle      = wine_server_obj_handle( file );
+        req->iosb        = iosb_client_ptr( io );
+        req->only_thread = TRUE;
+        if (!wine_server_call( req ) && reply->cancel_handle)
+            NtClose( wine_server_ptr_handle( reply->cancel_handle ) );
+    }
+    SERVER_END_REQ;
+    ret = server_wait_for_object( handle, FALSE, NULL );
+    return invoke_user_apc( NULL, &apc, ret );
+}
+
+
 /***********************************************************************
  *              NtContinue  (NTDLL.@)
  */
