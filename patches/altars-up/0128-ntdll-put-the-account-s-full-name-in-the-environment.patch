From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 12:14:09 -0400
Subject: [PATCH] ntdll: put the account's full name in the environment.

Windows keeps a local account's full name and gives it as the display
name of the user; the Unix account's is the first field of its GECOS.
The process started from Unix looks it up once, with the account the
other WINE* variables describe, and puts it in WINEUSERFULLNAME; the
processes it starts inherit it.  An account with no full name gets no
variable.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 65b0ecb915f77cadceca46baf4180acb2ce186b9)

diff --git a/dlls/ntdll/unix/env.c b/dlls/ntdll/unix/env.c
index bd888b9928b..bf1c816b1c3 100644
--- a/dlls/ntdll/unix/env.c
+++ b/dlls/ntdll/unix/env.c
@@ -1023,6 +1023,26 @@ static void add_system_dll_path_var( WCHAR **env, SIZE_T *pos, SIZE_T *size )
 }
 
 
+/*************************************************************************
+ *		add_user_full_name
+ *
+ * The account's full name, the first field of its GECOS, as GetUserNameEx and NetUserGetInfo give it.  It is
+ * looked up once, for the processes started from Unix, and the others inherit it.
+ */
+static void add_user_full_name( WCHAR **env, SIZE_T *pos, SIZE_T *size )
+{
+#ifdef HAVE_PWD_H
+    struct passwd *pwd = getpwuid( getuid() );
+    char *name;
+
+    if (!pwd || !pwd->pw_gecos || !pwd->pw_gecos[0] || pwd->pw_gecos[0] == ',') return;
+    if (!(name = strndup( pwd->pw_gecos, strcspn( pwd->pw_gecos, "," )))) return;
+    append_envA( env, pos, size, "WINEUSERFULLNAME", name );
+    free( name );
+#endif
+}
+
+
 /*************************************************************************
  *		add_dynamic_environment
  *
@@ -1892,6 +1912,7 @@ static RTL_USER_PROCESS_PARAMETERS *build_initial_params(void)
     /* store the initial PATH value */
     path = get_env_var( env, env_pos, pathW, 4 );
     add_dynamic_environment( &env, &env_pos, &env_size );
+    add_user_full_name( &env, &env_pos, &env_size );
     add_registry_environment( &env, &env_pos, &env_size );
     bootstrap = get_env_var( env, env_pos, bootstrapW, ARRAY_SIZE(bootstrapW) );
     set_env_var( &env, &env_pos, &env_size, bootstrapW, ARRAY_SIZE(bootstrapW), valueW );
