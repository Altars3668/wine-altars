From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 17:34:19 -0400
Subject: [PATCH] opcservices: Keep and write the target mode of a
 relationship.

CreateRelationship() dropped its target mode, so GetTargetMode() always
answered internal, and the relationships part never had a TargetMode
attribute.  An external target written as an internal one is an invalid
part name: Word rejects such a package as corrupt, and Word's PDF import,
which builds the converted document with IOpcFactory, failed with it for
every PDF with a web link.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/opcservices/package.c b/dlls/opcservices/package.c
index b5a8537bb3d..c01b794ef25 100644
--- a/dlls/opcservices/package.c
+++ b/dlls/opcservices/package.c
@@ -1194,6 +1194,7 @@ static HRESULT opc_relationship_create(struct opc_relationship_set *set, const W
 
     relationship->target = target_uri;
     IUri_AddRef(relationship->target);
+    relationship->target_mode = target_mode;
     relationship->source_uri = set->source_uri;
     IOpcUri_AddRef(relationship->source_uri);
 
@@ -1833,6 +1834,7 @@ static HRESULT opc_package_write_contenttypes(IOpcPackage *package, struct zip_a
 
 static HRESULT opc_package_write_rel(IOpcRelationship *rel, IXmlWriter *writer)
 {
+    OPC_URI_TARGET_MODE target_mode;
     BSTR target_uri;
     HRESULT hr;
     WCHAR *str;
@@ -1868,6 +1870,14 @@ static HRESULT opc_package_write_rel(IOpcRelationship *rel, IXmlWriter *writer)
     if (FAILED(hr))
         return hr;
 
+    if (FAILED(hr = IOpcRelationship_GetTargetMode(rel, &target_mode)))
+        return hr;
+
+    /* Internal is the default, only an external target is marked. */
+    if (target_mode == OPC_URI_TARGET_MODE_EXTERNAL
+            && FAILED(hr = IXmlWriter_WriteAttributeString(writer, NULL, L"TargetMode", NULL, L"External")))
+        return hr;
+
     return IXmlWriter_WriteEndElement(writer);
 }
 
diff --git a/dlls/opcservices/tests/opcservices.c b/dlls/opcservices/tests/opcservices.c
index 9ead97f9c62..6336b22862b 100644
--- a/dlls/opcservices/tests/opcservices.c
+++ b/dlls/opcservices/tests/opcservices.c
@@ -371,6 +371,23 @@ static void test_relationship(void)
     ok(hr == OPC_E_INVALID_RELATIONSHIP_TARGET, "Unexpected hr %#lx.\n", hr);
     ok(rel == NULL, "Unexpected instance %p.\n", rel);
 
+    /* External targets, absolute or relative, keep their mode */
+    hr = IOpcRelationshipSet_CreateRelationship(rels, NULL, typeW, target_uri2, OPC_URI_TARGET_MODE_EXTERNAL, &rel);
+    ok(hr == S_OK, "Failed to create relationship, hr %#lx.\n", hr);
+    mode = OPC_URI_TARGET_MODE_INTERNAL;
+    hr = IOpcRelationship_GetTargetMode(rel, &mode);
+    ok(hr == S_OK, "Failed to get target mode, hr %#lx.\n", hr);
+    ok(mode == OPC_URI_TARGET_MODE_EXTERNAL, "Unexpected mode %d.\n", mode);
+    IOpcRelationship_Release(rel);
+
+    hr = IOpcRelationshipSet_CreateRelationship(rels, NULL, typeW, target_uri, OPC_URI_TARGET_MODE_EXTERNAL, &rel);
+    ok(hr == S_OK, "Failed to create relationship, hr %#lx.\n", hr);
+    mode = OPC_URI_TARGET_MODE_INTERNAL;
+    hr = IOpcRelationship_GetTargetMode(rel, &mode);
+    ok(hr == S_OK, "Failed to get target mode, hr %#lx.\n", hr);
+    ok(mode == OPC_URI_TARGET_MODE_EXTERNAL, "Unexpected mode %d.\n", mode);
+    IOpcRelationship_Release(rel);
+
     hr = IOpcRelationshipSet_CreateRelationship(rels, NULL, typeW, target_uri, OPC_URI_TARGET_MODE_INTERNAL, &rel);
     ok(hr == S_OK, "Failed to create relationship, hr %#lx.\n", hr);
 
