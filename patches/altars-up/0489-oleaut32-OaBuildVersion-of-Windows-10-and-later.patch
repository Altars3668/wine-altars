From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 19:47:18 -0400
Subject: [PATCH] oleaut32: OaBuildVersion of Windows 10 and later.

Windows 11 build 29671 says 50.5014 whatever version the program is
told it runs on (tools/startupgapsprobe misc).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/oleaut32/oleaut.c b/dlls/oleaut32/oleaut.c
index 1ba638597f8..1d0459d22db 100644
--- a/dlls/oleaut32/oleaut.c
+++ b/dlls/oleaut32/oleaut.c
@@ -31,6 +31,7 @@
 #include "wingdi.h"
 #include "winuser.h"
 #include "winerror.h"
+#include "winternl.h"
 
 #include "ole2.h"
 #include "olectl.h"
@@ -642,6 +643,12 @@ HRESULT WINAPI DECLSPEC_HOTPATCH GetActiveObject(REFCLSID rcid,LPVOID preserved,
  */
 ULONG WINAPI OaBuildVersion(void)
 {
+    RTL_OSVERSIONINFOEXW info = { sizeof(info) };
+
+    /* Windows 10 and later give their own build of oleaut32, whatever version the program is told it runs on;
+     * Windows 11 build 29671 says 50.5014 */
+    if (!RtlGetVersion( &info ) && info.dwMajorVersion >= 10) return MAKELONG(5014, 50);
+
     switch(GetVersion() & 0x8000ffff)  /* mask off build number */
     {
     case 0x80000a03:  /* WIN31 */
