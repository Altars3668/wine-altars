+/* whether a character that takes no room goes with the one before it when counting the characters that fit;
+ * the others fit only before the extent, not at it, as does one that starts the text */
+static BOOL fits_with_previous_char( WCHAR ch )
+{
+    return ch == 0x034f || (ch >= 0x200b && ch <= 0x200d) || (ch >= 0xfe00 && ch <= 0xfe0f) || ch == 0xfeff;
+}
