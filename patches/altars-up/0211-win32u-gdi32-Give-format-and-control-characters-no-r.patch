+/* leaves out the glyphs that take no room and draw nothing */
+static UINT remove_zero_width_glyphs( WORD *glyphs, UINT count, const BYTE *zero_width )
+{
+    UINT i, shown = 0;
+
+    if (!zero_width) return count;
+    for (i = 0; i < count; i++) if (!zero_width[i]) glyphs[shown++] = glyphs[i];
+    return shown;
+}
+
+/* takes the advances of the glyphs that take no room out of their extents */
+static void remove_zero_width_advances( INT *dxs, int count, const BYTE *zero_width, SIZE *size )
+{
+    int i, prev = 0, removed = 0;
+
+    if (!zero_width) return;
+    for (i = 0; i < count; i++)
+    {
+        int pos = dxs[i];
+
+        if (zero_width[i]) removed += pos - prev;
+        prev = pos;
+        dxs[i] = pos - removed;
+    }
+    size->cx -= removed;
+}
