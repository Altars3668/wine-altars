From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 10:49:19 -0400
Subject: [PATCH] win32u, gdi32: Give format and control characters no room and
 draw nothing, as Windows' language processing does.

On Windows the language processing gdi32 does (the LPK, with Uniscribe)
gives a set of format and control characters no room and draws nothing
for them, whatever glyph the font has: the tab, line feed, carriage
return and separators U+001C-U+001F, the C1 controls, the grapheme
joiner, the zero-width space and joiners, the direction marks and
embeddings, the paragraph separator, the invisible operators, the
deprecated format characters, the variation selectors and the byte order
mark.  In a symbol font it is only the first four kinds, the zero-width
space and joiners, the variation selectors and the byte order mark.
Here they were measured and drawn with the font's glyph, most often its
default one, and the names Office gives the menu groups it merges during
in-place activation, which end in zero-width spaces, showed boxes.

Text measured with that processing now leaves them out, and ExtTextOut
draws the rest without them: it keeps a width the caller passes for one,
but drops it for the zero-width space and joiners, the byte order mark
and the Arabic letter mark.  GetTextExtentExPoint counts one among the
characters that fit only when it ends before the limit, but the
zero-width space and joiners and the combining ones go with the
character before them.  None of this happens with a character extra,
with ETO_IGNORELANGUAGE or with glyph indices; gdi32 now passes
ETO_IGNORELANGUAGE down only when it did the processing itself.

In bidirectional text the glyphs Uniscribe marks zero-width are left out
the same way, text in a symbol font gets no bidirectional processing, as
on Windows, and GetTextExtentExPoint there fills in the extents whatever
the limit when not asked what fits, and spreads a cluster's extent over
its characters.

tools/textprobe/zwspprobe in the outer tree measured all of it on
Windows; the test checks it.  Widths passed for the right-to-left marks
remain dropped, as for any bidirectional text here.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 9b5bdeaf9b7c0a5815667a923f9a8aa30ac42ec6)

diff --git a/dlls/gdi32/tests/font.c b/dlls/gdi32/tests/font.c
index c56180b1ce6..5758cf70cde 100644
--- a/dlls/gdi32/tests/font.c
+++ b/dlls/gdi32/tests/font.c
@@ -1577,6 +1577,159 @@ static void *load_font(const char *font_name, DWORD *font_size)
     return font;
 }
 
+#define IGNORABLE_WIDTH  128
+#define IGNORABLE_HEIGHT 32
+
+static void draw_ignorable_text( HDC hdc, const DWORD *bits, DWORD *copy, UINT flags,
+                                 const WCHAR *str, int count, const INT *dx )
+{
+    PatBlt( hdc, 0, 0, IGNORABLE_WIDTH, IGNORABLE_HEIGHT, WHITENESS );
+    ExtTextOutW( hdc, 2, 2, flags, NULL, str, count, dx );
+    GdiFlush();
+    memcpy( copy, bits, IGNORABLE_WIDTH * IGNORABLE_HEIGHT * sizeof(*copy) );
+}
+
+static void test_ignorable_chars(void)
+{
+    /* the format and control characters that text gets no room for and that draw nothing, whatever glyphs the font
+     * has for them; ExtTextOut drops a width passed for the zero-width space and joiners, the byte order mark and
+     * the Arabic letter mark, and leaves the others' empty */
+    static const WCHAR ignorable[] =
+    {
+        0x0009, 0x000a, 0x000d, 0x001c, 0x001f, 0x0080, 0x0085, 0x009f, 0x034f, 0x061c, 0x200b, 0x200c, 0x200d,
+        0x200e, 0x200f, 0x2029, 0x202a, 0x202e, 0x2061, 0x2064, 0x206a, 0x206f, 0xfe00, 0xfe0f, 0xfeff,
+    };
+    static const WCHAR shown[] = { 0x0000, 0x0001, 0x001b, 0x2028, 0x2065, 0x2066, 0xfffb };
+    static const WCHAR symbol_ignorable[] = { 0x0009, 0x000a, 0x001f, 0x200b, 0x200d, 0xfe00, 0xfeff };
+    static const WCHAR symbol_shown[] = { 0x0080, 0x061c, 0x200e, 0x200f, 0x202a, 0x2029 };
+    BITMAPINFO info = {{ sizeof(info.bmiHeader), IGNORABLE_WIDTH, -IGNORABLE_HEIGHT, 1, 32, BI_RGB }};
+    static DWORD first[IGNORABLE_WIDTH * IGNORABLE_HEIGHT], second[IGNORABLE_WIDTH * IGNORABLE_HEIGHT];
+    INT a_width, ext[8], fit, pass_dx[3], kept_dx[2], dropped_dx[2];
+    HFONT font, old_font;
+    HBITMAP dib, old_dib;
+    SIZE aa_size, size;
+    LOGFONTA lf;
+    DWORD *bits;
+    unsigned int i;
+    HDC hdc;
+
+    if (!is_font_installed("Tahoma"))
+    {
+        skip("Tahoma is not installed\n");
+        return;
+    }
+    hdc = CreateCompatibleDC( 0 );
+    dib = CreateDIBSection( hdc, &info, DIB_RGB_COLORS, (void **)&bits, NULL, 0 );
+    old_dib = SelectObject( hdc, dib );
+    SetBkMode( hdc, TRANSPARENT );
+    memset( &lf, 0, sizeof(lf) );
+    strcpy( lf.lfFaceName, "Tahoma" );
+    lf.lfHeight = -16;
+    font = CreateFontIndirectA( &lf );
+    old_font = SelectObject( hdc, font );
+
+    GetCharWidth32W( hdc, 'a', 'a', &a_width );
+    GetTextExtentPoint32W( hdc, L"aa", 2, &aa_size );
+    for (i = 0; i < ARRAY_SIZE(ignorable); i++)
+    {
+        WCHAR str[3] = { 'a', ignorable[i], 'a' };
+
+        winetest_push_context( "U+%04x", ignorable[i] );
+        GetTextExtentPoint32W( hdc, str, 3, &size );
+        ok( size.cx == aa_size.cx, "got width %ld, expected %ld\n", size.cx, aa_size.cx );
+        /* a variation selector or the grapheme joiner forms a cluster with the character before it */
+        if (ignorable[i] != 0x034f && (ignorable[i] < 0xfe00 || ignorable[i] > 0xfe0f))
+        {
+            GetTextExtentExPointW( hdc, str, 3, 0, NULL, ext, &size );
+            ok( ext[1] == ext[0], "got extents %d %d\n", ext[0], ext[1] );
+        }
+
+        draw_ignorable_text( hdc, bits, first, 0, L"aa", 2, NULL );
+        draw_ignorable_text( hdc, bits, second, 0, str, 3, NULL );
+        ok( !memcmp( first, second, sizeof(first) ), "drawn differently from \"aa\"\n" );
+
+        pass_dx[0] = pass_dx[2] = a_width;
+        pass_dx[1] = 7;
+        kept_dx[0] = a_width + 7;
+        dropped_dx[0] = kept_dx[1] = dropped_dx[1] = a_width;
+        draw_ignorable_text( hdc, bits, first, 0, str, 3, pass_dx );
+        if (ignorable[i] == 0x061c || (ignorable[i] >= 0x200b && ignorable[i] <= 0x200d) || ignorable[i] == 0xfeff)
+            draw_ignorable_text( hdc, bits, second, 0, L"aa", 2, dropped_dx );
+        else
+            draw_ignorable_text( hdc, bits, second, 0, L"aa", 2, kept_dx );
+        /* the right-to-left marks are processed as bidirectional text, which does not take the widths yet */
+        todo_wine_if( ignorable[i] == 0x061c || ignorable[i] == 0x200f || ignorable[i] == 0x202e )
+        ok( !memcmp( first, second, sizeof(first) ), "width passed for it not handled\n" );
+
+        /* none of this is done with a character extra */
+        SetTextCharacterExtra( hdc, 1 );
+        GetTextExtentPoint32W( hdc, str, 3, &size );
+        ok( size.cx > aa_size.cx + 2, "got width %ld with a character extra, \"aa\" %ld\n", size.cx, aa_size.cx );
+        SetTextCharacterExtra( hdc, 0 );
+        winetest_pop_context();
+    }
+    for (i = 0; i < ARRAY_SIZE(shown); i++)
+    {
+        WCHAR str[3] = { 'a', shown[i], 'a' };
+
+        GetTextExtentPoint32W( hdc, str, 3, &size );
+        ok( size.cx > aa_size.cx, "U+%04x: got width %ld, \"aa\" %ld\n", shown[i], size.cx, aa_size.cx );
+    }
+
+    /* nor with ETO_IGNORELANGUAGE */
+    draw_ignorable_text( hdc, bits, first, ETO_IGNORELANGUAGE, L"aa", 2, NULL );
+    draw_ignorable_text( hdc, bits, second, ETO_IGNORELANGUAGE, L"a\ta", 3, NULL );
+    ok( memcmp( first, second, sizeof(first) ), "tab not drawn with ETO_IGNORELANGUAGE\n" );
+
+    /* a zero-width space fits with the character before it, the others only before the limit */
+    GetTextExtentExPointW( hdc, L"One\x200btwo", 7, 0, NULL, ext, &size );
+    GetTextExtentExPointW( hdc, L"One\x200btwo", 7, ext[3], &fit, NULL, &size );
+    ok( fit == 4, "got %d fitting\n", fit );
+    GetTextExtentExPointW( hdc, L"One\x200etwo", 7, ext[3], &fit, NULL, &size );
+    ok( fit == 3, "got %d fitting\n", fit );
+    GetTextExtentExPointW( hdc, L"One\x200etwo", 7, ext[3] + 1, &fit, NULL, &size );
+    ok( fit == 4, "got %d fitting\n", fit );
+    GetTextExtentExPointW( hdc, L"\x200bOne", 4, 0, &fit, NULL, &size );
+    ok( fit == 0, "got %d fitting\n", fit );
+    GetTextExtentExPointW( hdc, L"\x200bOne", 4, 1, &fit, NULL, &size );
+    ok( fit == 1, "got %d fitting\n", fit );
+
+    SelectObject( hdc, old_font );
+    DeleteObject( font );
+
+    /* a symbol font has fewer of them */
+    if (is_font_installed("Wingdings"))
+    {
+        lf.lfCharSet = SYMBOL_CHARSET;
+        strcpy( lf.lfFaceName, "Wingdings" );
+        font = CreateFontIndirectA( &lf );
+        old_font = SelectObject( hdc, font );
+        GetTextExtentPoint32W( hdc, L"aa", 2, &aa_size );
+        for (i = 0; i < ARRAY_SIZE(symbol_ignorable); i++)
+        {
+            WCHAR str[3] = { 'a', symbol_ignorable[i], 'a' };
+
+            GetTextExtentPoint32W( hdc, str, 3, &size );
+            ok( size.cx == aa_size.cx, "U+%04x: got width %ld, expected %ld\n", symbol_ignorable[i], size.cx,
+                aa_size.cx );
+        }
+        for (i = 0; i < ARRAY_SIZE(symbol_shown); i++)
+        {
+            WCHAR str[3] = { 'a', symbol_shown[i], 'a' };
+
+            GetTextExtentPoint32W( hdc, str, 3, &size );
+            ok( size.cx > aa_size.cx, "U+%04x: got width %ld, \"aa\" %ld\n", symbol_shown[i], size.cx, aa_size.cx );
+        }
+        SelectObject( hdc, old_font );
+        DeleteObject( font );
+    }
+    else skip("Wingdings is not installed\n");
+
+    SelectObject( hdc, old_dib );
+    DeleteObject( dib );
+    DeleteDC( hdc );
+}
+
 static void test_GetGlyphIndices(void)
 {
     HDC      hdc;
@@ -8036,6 +8189,7 @@ START_TEST(font)
     test_GdiGetCharDimensions();
     test_GetCharABCWidths();
     test_text_extents();
+    test_ignorable_chars();
     test_GetGlyphIndices();
     test_GetKerningPairs();
     test_GetOutlineTextMetrics();
