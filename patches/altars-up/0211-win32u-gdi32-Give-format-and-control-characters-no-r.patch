+/* The format and control characters that the language processing gdi32 does on Windows (the LPK, with Uniscribe)
+ * neither draws nor gives any room, whatever glyph and advance the font has for them.  A symbol font has fewer of
+ * them.  None of this is done with a character extra, nor for ExtTextOut with ETO_IGNORELANGUAGE or glyph indices. */
+static BOOL is_ignorable_char( WCHAR ch, BOOL symbol )
+{
+    switch (ch)
+    {
