From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 12:08:50 -0400
Subject: [PATCH] crypt32: say a structure has no encoder or decoder only when
 nothing has one.

Word decodes SPC_INDIRECT_DATA_OBJID, which wintrust registers for the
CryptDllDecodeObject function set only.  CryptDecodeObjectEx found it
there, and decoded it, but first said "Unsupported decoder", and left
ERROR_FILE_NOT_FOUND from looking for the other set as the last error
of a call that succeeded; the encoder side said it for every structure
not built into crypt32, before looking in any DLL at all.

Now either says so only when no DLL has one either, and a function found
in the other set clears the error, as Windows leaves it after success
(tools/oidfuncprobe: 0 for both).  A structure nothing knows fails with
ERROR_FILE_NOT_FOUND, as there, for all four calls.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit f8c4a8614aef71829de7e9a247666a75aa0e7ba6)

diff --git a/dlls/crypt32/decode.c b/dlls/crypt32/decode.c
index 1c6d15f84ed..8a933cd4fcc 100644
--- a/dlls/crypt32/decode.c
+++ b/dlls/crypt32/decode.c
@@ -7038,13 +7038,6 @@ BOOL WINAPI CryptDecodeObjectEx(DWORD dwCertEncodingType, LPCSTR lpszStructType,
          debugstr_a(lpszStructType));
         decodeFunc = CRYPT_LoadDecoderExFunc(dwCertEncodingType, lpszStructType,
          &hFunc);
-        if (!decodeFunc)
-        {
-            if (IS_INTOID(lpszStructType))
-                FIXME("Unimplemented decoder for lpszStructType OID %d\n", LOWORD(lpszStructType));
-            else
-                FIXME("Unsupported decoder for lpszStructType %s\n", lpszStructType);
-        }
     }
     if (decodeFunc)
         ret = decodeFunc(dwCertEncodingType, lpszStructType, pbEncoded,
@@ -7055,10 +7048,20 @@ BOOL WINAPI CryptDecodeObjectEx(DWORD dwCertEncodingType, LPCSTR lpszStructType,
          CRYPT_LoadDecoderFunc(dwCertEncodingType, lpszStructType, &hFunc);
 
         /* Try CryptDecodeObject function.  Don't call CryptDecodeObject
-         * directly, as that could cause an infinite loop.
+         * directly, as that could cause an infinite loop.  A DLL may register
+         * only that, as wintrust does for its structures; not finding the
+         * other one is no error.
          */
-        if (pCryptDecodeObject)
+        if (!pCryptDecodeObject)
+        {
+            if (IS_INTOID(lpszStructType))
+                FIXME("Unimplemented decoder for lpszStructType OID %d\n", LOWORD(lpszStructType));
+            else
+                FIXME("Unsupported decoder for lpszStructType %s\n", lpszStructType);
+        }
+        else
         {
+            SetLastError(NOERROR);
             if (dwFlags & CRYPT_DECODE_ALLOC_FLAG)
             {
                 ret = pCryptDecodeObject(dwCertEncodingType, lpszStructType,
diff --git a/dlls/crypt32/encode.c b/dlls/crypt32/encode.c
index ecec1bffa96..6390810c137 100644
--- a/dlls/crypt32/encode.c
+++ b/dlls/crypt32/encode.c
@@ -4819,8 +4819,6 @@ static CryptEncodeObjectExFunc CRYPT_GetBuiltinEncoder(DWORD dwCertEncodingType,
         case LOWORD(OCSP_SIGNED_REQUEST):
             encodeFunc = CRYPT_AsnEncodeOCSPSignedRequest;
             break;
-        default:
-            FIXME("Unimplemented encoder for lpszStructType OID %d\n", LOWORD(lpszStructType));
         }
     }
     else if (!strcmp(lpszStructType, szOID_CERT_EXTENSIONS))
@@ -4877,9 +4875,16 @@ static CryptEncodeObjectExFunc CRYPT_GetBuiltinEncoder(DWORD dwCertEncodingType,
         encodeFunc = CRYPT_AsnEncodePolicyQualifierUserNotice;
     else if (!strcmp(lpszStructType, szOID_CTL))
         encodeFunc = CRYPT_AsnEncodeCTL;
+    return encodeFunc;
+}
+
+/* after looking everywhere, a DLL's registrations included */
+static void encoder_not_found(LPCSTR lpszStructType)
+{
+    if (IS_INTOID(lpszStructType))
+        FIXME("Unimplemented encoder for lpszStructType OID %d\n", LOWORD(lpszStructType));
     else
         FIXME("Unsupported encoder for lpszStructType %s\n", lpszStructType);
-    return encodeFunc;
 }
 
 static CryptEncodeObjectFunc CRYPT_LoadEncoderFunc(DWORD dwCertEncodingType,
@@ -4943,6 +4948,8 @@ BOOL WINAPI CryptEncodeObject(DWORD dwCertEncodingType, LPCSTR lpszStructType,
     else if (pCryptEncodeObjectEx)
         ret = pCryptEncodeObjectEx(dwCertEncodingType, lpszStructType,
          pvStructInfo, 0, NULL, pbEncoded, pcbEncoded);
+    else
+        encoder_not_found(lpszStructType);
     if (hFunc)
         CryptFreeOIDFunctionAddress(hFunc, 0);
     TRACE_(crypt)("returning %d\n", ret);
@@ -4991,8 +4998,13 @@ BOOL WINAPI CryptEncodeObjectEx(DWORD dwCertEncodingType, LPCSTR lpszStructType,
         CryptEncodeObjectFunc pCryptEncodeObject =
          CRYPT_LoadEncoderFunc(dwCertEncodingType, lpszStructType, &hFunc);
 
-        if (pCryptEncodeObject)
+        /* a DLL may register only that, as wintrust does for its structures;
+         * not finding the other one is no error */
+        if (!pCryptEncodeObject)
+            encoder_not_found(lpszStructType);
+        else
         {
+            SetLastError(NOERROR);
             if (dwFlags & CRYPT_ENCODE_ALLOC_FLAG)
             {
                 ret = pCryptEncodeObject(dwCertEncodingType, lpszStructType,
diff --git a/dlls/wintrust/tests/asn.c b/dlls/wintrust/tests/asn.c
index 5f75ec3298e..2aaa39524b1 100644
--- a/dlls/wintrust/tests/asn.c
+++ b/dlls/wintrust/tests/asn.c
@@ -584,6 +584,17 @@ static void test_encodeSPCIndirectDataContent(void)
              "Unexpected value\n");
         LocalFree(buf);
     }
+    /* by its OID, which wintrust registers for CryptEncodeObject only */
+    SetLastError(0xdeadbeef);
+    ret = pCryptEncodeObjectEx(X509_ASN_ENCODING, SPC_INDIRECT_DATA_OBJID,
+     &indirectData, CRYPT_ENCODE_ALLOC_FLAG, NULL, &buf, &size);
+    ok(ret, "CryptEncodeObjectEx failed: %08lx\n", GetLastError());
+    ok(GetLastError() == ERROR_SUCCESS, "Unexpected error %08lx\n", GetLastError());
+    if (ret)
+    {
+        ok(size == sizeof(emptyIndirectData), "Unexpected size %ld\n", size);
+        LocalFree(buf);
+    }
     /* With only digest */
     indirectData.Digest.cbData = sizeof(fakeDigest);
     indirectData.Digest.pbData = fakeDigest;
@@ -675,6 +686,15 @@ static void test_decodeSPCIndirectDataContent(void)
         return;
     }
 
+    /* by its OID, which wintrust registers for CryptDecodeObject only */
+    SetLastError(0xdeadbeef);
+    ret = pCryptDecodeObjectEx(X509_ASN_ENCODING, SPC_INDIRECT_DATA_OBJID,
+     emptyIndirectData, sizeof(emptyIndirectData),
+     CRYPT_DECODE_ALLOC_FLAG, NULL, &buf, &size);
+    ok(ret, "CryptDecodeObjectEx failed: %08lx\n", GetLastError());
+    ok(GetLastError() == ERROR_SUCCESS, "Unexpected error %08lx\n", GetLastError());
+    if (ret) LocalFree(buf);
+
     ret = pCryptDecodeObjectEx(X509_ASN_ENCODING, SPC_INDIRECT_DATA_CONTENT_STRUCT,
      emptyIndirectData, sizeof(emptyIndirectData),
      CRYPT_DECODE_ALLOC_FLAG, NULL, &buf, &size);
