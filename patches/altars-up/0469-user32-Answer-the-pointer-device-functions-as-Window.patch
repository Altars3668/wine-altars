-# @ stub GetPointerDevice
-# @ stub GetPointerDeviceCursors
+@ stdcall GetPointerDevice(ptr ptr)
+@ stdcall GetPointerDeviceCursors(ptr ptr ptr)
 # @ stub GetPointerDeviceInputSpace
 # @ stub GetPointerDeviceOrientation
 @ stdcall GetPointerDeviceProperties(ptr ptr ptr)
diff --git a/dlls/win32u/input.c b/dlls/win32u/input.c
index 682aa93395e..e8fdfc0dec1 100644
--- a/dlls/win32u/input.c
+++ b/dlls/win32u/input.c
@@ -3182,10 +3182,10 @@ BOOL WINAPI NtUserGetPointerDeviceRects( HANDLE handle, RECT *device_rect, RECT
 {
     RECT rect;
 
+    /* there are no pointer devices to have rectangles of */
     if (handle != INVALID_HANDLE_VALUE)
     {
-        FIXME( "Pointer devices are not implemented!\n" );
-        RtlSetLastWin32Error( ERROR_NO_DATA );
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
         return FALSE;
     }
 
