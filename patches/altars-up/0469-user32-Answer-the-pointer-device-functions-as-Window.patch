From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 16:18:54 -0400
Subject: [PATCH] user32: Answer the pointer device functions as Windows does
 on a machine with no touch screen, pen or touchpad.

As measured on Windows 11 build 29671 without such devices, interactively and in a service session alike:
- GetPointerDevices gives a count of 0 when asked for the count, but with an array fails with
  ERROR_SYSTEM_DEVICE_NOT_FOUND and leaves the count alone, and without a count is ERROR_INVALID_PARAMETER;
- GetPointerDevice, GetPointerDeviceProperties and GetPointerDeviceCursors fail with ERROR_INVALID_HANDLE for a
  handle and ERROR_INVALID_PARAMETER for none, and GetPointerDeviceRects with ERROR_INVALID_PARAMETER;
- RegisterPointerDeviceNotifications takes a window of any thread once, failing the second time without an
  error, and anything that is not a window with ERROR_INVALID_WINDOW_HANDLE.

GetPointerDevice and GetPointerDeviceCursors were missing; a call ended the process.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/user32/input.c b/dlls/user32/input.c
index 051f4e48ec9..c273093f7fd 100644
--- a/dlls/user32/input.c
+++ b/dlls/user32/input.c
@@ -745,8 +745,10 @@ BOOL WINAPI SetGestureConfig( HWND hwnd, DWORD reserved, UINT count,
 BOOL WINAPI GetPointerDeviceProperties( HANDLE device, UINT32 *count,
                                         POINTER_DEVICE_PROPERTY *properties)
 {
-    FIXME( "device %p, count %p, info %p stub!\n", device, count, properties );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+    TRACE( "device %p, count %p, info %p\n", device, count, properties );
+
+    /* there are no pointer devices, so no handle is one */
+    SetLastError( device ? ERROR_INVALID_HANDLE : ERROR_INVALID_PARAMETER );
     return FALSE;
 }
 
diff --git a/dlls/user32/misc.c b/dlls/user32/misc.c
index 66af4126741..19786508028 100644
--- a/dlls/user32/misc.c
+++ b/dlls/user32/misc.c
@@ -424,13 +424,64 @@ BOOL WINAPI IsWindowRedirectedForPrint( HWND hwnd )
     return GetPropW( hwnd, L"__wine_print_redirected" ) ? -1 : FALSE;
 }
 
+/* The pointer devices Windows lists are touch screens, pens and touchpads, never a mouse; there are none here,
+ * and a machine without any answers as follows. */
+
+static HWND *pointer_notify_windows;
+static unsigned int pointer_notify_count, pointer_notify_size;
+
+static CRITICAL_SECTION pointer_cs;
+static CRITICAL_SECTION_DEBUG pointer_cs_debug =
+{
+    0, 0, &pointer_cs,
+    { &pointer_cs_debug.ProcessLocksList, &pointer_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": pointer_cs") }
+};
+static CRITICAL_SECTION pointer_cs = { &pointer_cs_debug, -1, 0, 0, 0, 0 };
+
 /**********************************************************************
  * RegisterPointerDeviceNotifications [USER32.@]
+ *
+ * With no devices there is nothing to tell the window of, but the registration holds: a window is registered
+ * once, the second time failing without an error.
  */
 BOOL WINAPI RegisterPointerDeviceNotifications(HWND hwnd, BOOL notifyrange)
 {
-    FIXME("(%p %d): stub\n", hwnd, notifyrange);
-    return TRUE;
+    unsigned int i;
+    BOOL ret = TRUE;
+
+    TRACE("(%p %d)\n", hwnd, notifyrange);
+
+    if (!IsWindow( hwnd ))
+    {
+        SetLastError( ERROR_INVALID_WINDOW_HANDLE );
+        return FALSE;
+    }
+
+    EnterCriticalSection( &pointer_cs );
+    /* forget the windows gone since */
+    for (i = 0; i < pointer_notify_count;)
+    {
+        if (IsWindow( pointer_notify_windows[i] )) i++;
+        else pointer_notify_windows[i] = pointer_notify_windows[--pointer_notify_count];
+    }
+    for (i = 0; i < pointer_notify_count; i++)
+        if (pointer_notify_windows[i] == hwnd) ret = FALSE;
+    if (ret && pointer_notify_count == pointer_notify_size)
+    {
+        unsigned int size = max( 8, pointer_notify_size * 2 );
+        HWND *windows = realloc( pointer_notify_windows, size * sizeof(*windows) );
+
+        if (windows)
+        {
+            pointer_notify_windows = windows;
+            pointer_notify_size = size;
+        }
+        else ret = FALSE;
+    }
+    if (ret) pointer_notify_windows[pointer_notify_count++] = hwnd;
+    LeaveCriticalSection( &pointer_cs );
+    return ret;
 }
 
 /**********************************************************************
@@ -438,18 +489,52 @@ BOOL WINAPI RegisterPointerDeviceNotifications(HWND hwnd, BOOL notifyrange)
  */
 BOOL WINAPI GetPointerDevices(UINT32 *device_count, POINTER_DEVICE_INFO *devices)
 {
-    FIXME("(%p %p): partial stub\n", device_count, devices);
+    TRACE("(%p %p)\n", device_count, devices);
 
     if (!device_count)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
         return FALSE;
+    }
 
+    /* how many there are is answered; the devices themselves are not found, and the count stays */
     if (devices)
+    {
+        SetLastError( ERROR_SYSTEM_DEVICE_NOT_FOUND );
         return FALSE;
+    }
 
     *device_count = 0;
     return TRUE;
 }
 
+/* no handle is one of a device */
+static BOOL no_pointer_device( HANDLE device )
+{
+    SetLastError( device ? ERROR_INVALID_HANDLE : ERROR_INVALID_PARAMETER );
+    return FALSE;
+}
+
+/**********************************************************************
+ * GetPointerDevice [USER32.@]
+ */
+BOOL WINAPI GetPointerDevice(HANDLE device, POINTER_DEVICE_INFO *info)
+{
+    TRACE("(%p %p)\n", device, info);
+
+    return no_pointer_device( device );
+}
+
+/**********************************************************************
+ * GetPointerDeviceCursors [USER32.@]
+ */
+BOOL WINAPI GetPointerDeviceCursors(HANDLE device, UINT32 *count, POINTER_DEVICE_CURSOR_INFO *cursors)
+{
+    TRACE("(%p %p %p)\n", device, count, cursors);
+
+    return no_pointer_device( device );
+}
+
 /**********************************************************************
  * RegisterTouchHitTestingWindow [USER32.@]
  */
diff --git a/dlls/user32/tests/input.c b/dlls/user32/tests/input.c
index 7e555f2aa70..5dda5d8e8b7 100644
--- a/dlls/user32/tests/input.c
+++ b/dlls/user32/tests/input.c
@@ -6134,6 +6134,98 @@ static void test_GetPointerInfo( BOOL mouse_in_pointer_enabled )
     ok( ret, "UnregisterClassW failed: %lu\n", GetLastError() );
 }
 
+static DWORD WINAPI pointer_window_thread( void *arg )
+{
+    HWND *hwnd = arg;
+    MSG msg;
+
+    *hwnd = CreateWindowExW( 0, L"static", L"other", WS_POPUP, 0, 0, 10, 10, NULL, NULL, NULL, NULL );
+    while (GetMessageW( &msg, NULL, 0, 0 )) DispatchMessageW( &msg );
+    DestroyWindow( *hwnd );
+    return 0;
+}
+
+/* What a machine without touch screens, pens or touchpads answers; a mouse is not a pointer device. */
+static void test_pointer_devices(void)
+{
+    POINTER_DEVICE_CURSOR_INFO cursors[4];
+    POINTER_DEVICE_PROPERTY properties[4];
+    POINTER_DEVICE_INFO devices[4];
+    RECT device_rect, display_rect;
+    HWND hwnd, other = NULL;
+    UINT32 count;
+    HANDLE thread;
+    BOOL ret;
+
+    SetLastError( 0xdeadbeef );
+    ret = GetPointerDevices( NULL, NULL );
+    ok( !ret, "GetPointerDevices succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+    count = 0xdeadbeef;
+    ret = GetPointerDevices( &count, NULL );
+    ok( ret, "GetPointerDevices failed, error %lu\n", GetLastError() );
+    if (count)
+    {
+        skip( "%u pointer devices\n", count );
+        return;
+    }
+    count = ARRAY_SIZE(devices);
+    SetLastError( 0xdeadbeef );
+    ret = GetPointerDevices( &count, devices );
+    ok( !ret, "GetPointerDevices succeeded\n" );
+    ok( GetLastError() == ERROR_SYSTEM_DEVICE_NOT_FOUND, "got error %lu\n", GetLastError() );
+    ok( count == ARRAY_SIZE(devices), "got count %u\n", count );
+
+    SetLastError( 0xdeadbeef );
+    ret = GetPointerDevice( NULL, devices );
+    ok( !ret, "GetPointerDevice succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = GetPointerDevice( (HANDLE)0xdead, devices );
+    ok( !ret, "GetPointerDevice succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
+    count = 0;
+    SetLastError( 0xdeadbeef );
+    ret = GetPointerDeviceProperties( (HANDLE)0xdead, &count, NULL );
+    ok( !ret, "GetPointerDeviceProperties succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
+    count = ARRAY_SIZE(properties);
+    ret = GetPointerDeviceProperties( (HANDLE)0xdead, &count, properties );
+    ok( !ret, "GetPointerDeviceProperties succeeded\n" );
+    count = ARRAY_SIZE(cursors);
+    ret = GetPointerDeviceCursors( (HANDLE)0xdead, &count, cursors );
+    ok( !ret, "GetPointerDeviceCursors succeeded\n" );
+    SetLastError( 0xdeadbeef );
+    ret = GetPointerDeviceRects( (HANDLE)0xdead, &device_rect, &display_rect );
+    ok( !ret, "GetPointerDeviceRects succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_PARAMETER, "got error %lu\n", GetLastError() );
+
+    /* a window is registered once, from any thread */
+    hwnd = CreateWindowExW( 0, L"static", L"pointer", WS_POPUP, 0, 0, 10, 10, NULL, NULL, NULL, NULL );
+    thread = CreateThread( NULL, 0, pointer_window_thread, &other, 0, NULL );
+    while (!other) Sleep( 10 );
+    ret = RegisterPointerDeviceNotifications( hwnd, FALSE );
+    ok( ret, "RegisterPointerDeviceNotifications failed, error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = RegisterPointerDeviceNotifications( hwnd, TRUE );
+    ok( !ret, "RegisterPointerDeviceNotifications succeeded\n" );
+    ok( GetLastError() == 0xdeadbeef, "got error %lu\n", GetLastError() );
+    ret = RegisterPointerDeviceNotifications( other, FALSE );
+    ok( ret, "RegisterPointerDeviceNotifications failed, error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = RegisterPointerDeviceNotifications( NULL, FALSE );
+    ok( !ret, "RegisterPointerDeviceNotifications succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_WINDOW_HANDLE, "got error %lu\n", GetLastError() );
+    SetLastError( 0xdeadbeef );
+    ret = RegisterPointerDeviceNotifications( (HWND)0xdead, FALSE );
+    ok( !ret, "RegisterPointerDeviceNotifications succeeded\n" );
+    ok( GetLastError() == ERROR_INVALID_WINDOW_HANDLE, "got error %lu\n", GetLastError() );
+    PostThreadMessageW( GetThreadId( thread ), WM_QUIT, 0, 0 );
+    WaitForSingleObject( thread, 5000 );
+    CloseHandle( thread );
+    DestroyWindow( hwnd );
+}
+
 static void test_EnableMouseInPointer( const char *arg )
 {
     DWORD enable = strtoul( arg, 0, 10 );
@@ -6958,6 +7050,7 @@ START_TEST(input)
         win_skip( "GetPointerType is not available\n" );
 
     test_UnregisterDeviceNotification();
+    test_pointer_devices();
 
     if (!pEnableMouseInPointer)
         win_skip( "EnableMouseInPointer not found, skipping tests\n" );
