From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 24 Sep 2026 19:02:54 -0400
Subject: [PATCH] iertutil: parse as Windows.Foundation.Uri does, international
 characters and all.
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Windows parses with Uri_CREATE_NORMALIZE_INTL_CHARACTERS besides the
flags this had, so percent-encoded UTF-8 in the host and path reads as
the characters it stands for: "http://example.com/%e4%b8%ad" has
AbsoluteUri "http://example.com/中".

AbsoluteCanonicalUri and DisplayIri are no longer worked out here by
hand.  They are what urlmon makes of the raw URI with the query and
fragment canonicalized as well: the first with CANONICALIZE_ABSOLUTE
and the host in punycode, the second as it displays.  That escapes a
space in the fragment as Windows does, and every forbidden character
in the query, which the hand-made version did not, and keeps a file
URI's characters as they are.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit cab55e4f664f2ff2b128108242e7fb8d794e1a87)

diff --git a/dlls/iertutil/main.c b/dlls/iertutil/main.c
index 0370613f070..e2e88d129bc 100644
--- a/dlls/iertutil/main.c
+++ b/dlls/iertutil/main.c
@@ -25,6 +25,10 @@ HRESULT WINAPI PrivateCoInternetCombineIUri(IUri *base, IUri *relative, DWORD fl
 
 WINE_DEFAULT_DEBUG_CHANNEL(iertutil);
 
+/* how Windows.Foundation.Uri has urlmon parse a URI */
+#define URI_CREATE_FLAGS (Uri_CREATE_ALLOW_IMPLICIT_FILE_SCHEME | Uri_CREATE_NO_DECODE_EXTRA_INFO | \
+                          Uri_CREATE_NORMALIZE_INTL_CHARACTERS)
+
 struct uri
 {
     IUriRuntimeClass IUriRuntimeClass_iface;
@@ -327,8 +331,7 @@ static HRESULT STDMETHODCALLTYPE uri_Equals(IUriRuntimeClass *iface, IUriRuntime
         return hr;
     }
     if (FAILED(hr = IUriRuntimeClass_get_RawUri(uri, &str))) return hr;
-    hr = CreateUri(WindowsGetStringRawBuffer(str, NULL), Uri_CREATE_ALLOW_IMPLICIT_FILE_SCHEME | Uri_CREATE_NO_DECODE_EXTRA_INFO,
-                   0, &parsed);
+    hr = CreateUri(WindowsGetStringRawBuffer(str, NULL), URI_CREATE_FLAGS, 0, &parsed);
     WindowsDeleteString(str);
     if (FAILED(hr)) return S_OK;
     if (SUCCEEDED(hr = IUri_IsEqual(impl->uri, parsed, &equal))) *value = equal;
@@ -402,78 +405,26 @@ static struct uri *unsafe_uri(IUriRuntimeClass *iface)
 
 DEFINE_IINSPECTABLE(uri_canonical, IUriRuntimeClassWithAbsoluteCanonicalUri, struct uri, IUriRuntimeClass_iface)
 
-/* Every character that is not unreserved ASCII percent-encoded as UTF-8, a
- * percent-encoded unreserved one decoded, and the host in punycode. */
-static HRESULT canonicalize(struct uri *impl, Uri_PROPERTY prop, BOOL escape, HSTRING *value)
+/* The canonical forms are what urlmon makes of the raw URI with its query and
+ * fragment canonicalized as well: AbsoluteCanonicalUri with everything
+ * beyond ASCII percent-encoded as UTF-8 and the host in punycode,
+ * DisplayIri as it displays. */
+static HRESULT canonical_property(struct uri *impl, DWORD flags, Uri_PROPERTY prop, DWORD prop_flags, HSTRING *value)
 {
-    BSTR str = NULL, host = NULL;
-    WCHAR *buf, *out, ascii_host[256];
-    const WCHAR *p;
-    char utf8[4];
+    BSTR raw = NULL, str = NULL;
+    IUri *uri;
     HRESULT hr;
-    UINT len;
-    int i, n;
 
     if (!value) return E_POINTER;
     *value = NULL;
-    if (FAILED(hr = IUri_GetPropertyBSTR(impl->uri, prop, &str, 0))) return hr;
-    if (hr == S_FALSE || !(len = SysStringLen(str)))
-    {
-        SysFreeString(str);
-        return S_OK;
-    }
-    if (escape && SUCCEEDED(IUri_GetPropertyBSTR(impl->uri, Uri_PROPERTY_HOST, &host, 0)) && host && SysStringLen(host) &&
-        (n = IdnToAscii(0, host, SysStringLen(host), ascii_host, ARRAY_SIZE(ascii_host) - 1)))
-    {
-        WCHAR *found = wcsstr(str, host);
-        ascii_host[n] = 0;
-        if (found)
-        {
-            BSTR replaced = SysAllocStringLen(NULL, len - SysStringLen(host) + n);
-            if (replaced)
-            {
-                memcpy(replaced, str, (found - str) * sizeof(WCHAR));
-                memcpy(replaced + (found - str), ascii_host, n * sizeof(WCHAR));
-                wcscpy(replaced + (found - str) + n, found + SysStringLen(host));
-                SysFreeString(str);
-                str = replaced;
-                len = SysStringLen(str);
-            }
-        }
-    }
-    SysFreeString(host);
-
-    if (!(buf = malloc((len * 9 + 1) * sizeof(WCHAR))))
-    {
-        SysFreeString(str);
-        return E_OUTOFMEMORY;
-    }
-    for (p = str, out = buf; *p; p++)
-    {
-        if (*p == '%' && iswxdigit(p[1]) && iswxdigit(p[2]))
-        {
-            WCHAR hex[3] = {p[1], p[2], 0};
-            WCHAR c = wcstoul(hex, NULL, 16);
-            if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z') || (c >= '0' && c <= '9') || wcschr(L"-._~", c))
-            {
-                *out++ = c;
-                p += 2;
-                continue;
-            }
-        }
-        if (escape && *p >= 0x80)
-        {
-            n = WideCharToMultiByte(CP_UTF8, 0, p, IS_HIGH_SURROGATE(*p) && p[1] ? 2 : 1, utf8, sizeof(utf8), NULL, NULL);
-            for (i = 0; i < n; i++) out += swprintf(out, 4, L"%%%02X", (BYTE)utf8[i]);
-            if (IS_HIGH_SURROGATE(*p) && p[1]) p++;
-            continue;
-        }
-        *out++ = *p;
-    }
-    *out = 0;
+    if (FAILED(hr = IUri_GetPropertyBSTR(impl->uri, Uri_PROPERTY_RAW_URI, &raw, 0))) return hr;
+    hr = CreateUri(raw, flags, 0, &uri);
+    SysFreeString(raw);
+    if (FAILED(hr)) return hr;
+    hr = IUri_GetPropertyBSTR(uri, prop, &str, prop_flags);
+    IUri_Release(uri);
+    if (SUCCEEDED(hr)) hr = WindowsCreateString(str, SysStringLen(str), value);
     SysFreeString(str);
-    hr = WindowsCreateString(buf, out - buf, value);
-    free(buf);
     return hr;
 }
 
@@ -482,7 +433,8 @@ static HRESULT STDMETHODCALLTYPE uri_canonical_get_AbsoluteCanonicalUri(IUriRunt
 {
     struct uri *impl = impl_from_IUriRuntimeClassWithAbsoluteCanonicalUri(iface);
     TRACE("iface %p, value %p.\n", iface, value);
-    return canonicalize(impl, Uri_PROPERTY_ABSOLUTE_URI, TRUE, value);
+    return canonical_property(impl, Uri_CREATE_ALLOW_IMPLICIT_FILE_SCHEME | Uri_CREATE_CANONICALIZE_ABSOLUTE |
+                              Uri_CREATE_NORMALIZE_INTL_CHARACTERS, Uri_PROPERTY_ABSOLUTE_URI, Uri_PUNYCODE_IDN_HOST, value);
 }
 
 static HRESULT STDMETHODCALLTYPE uri_canonical_get_DisplayIri(IUriRuntimeClassWithAbsoluteCanonicalUri *iface,
@@ -490,7 +442,8 @@ static HRESULT STDMETHODCALLTYPE uri_canonical_get_DisplayIri(IUriRuntimeClassWi
 {
     struct uri *impl = impl_from_IUriRuntimeClassWithAbsoluteCanonicalUri(iface);
     TRACE("iface %p, value %p.\n", iface, value);
-    return canonicalize(impl, Uri_PROPERTY_DISPLAY_URI, FALSE, value);
+    return canonical_property(impl, Uri_CREATE_ALLOW_IMPLICIT_FILE_SCHEME | Uri_CREATE_NORMALIZE_INTL_CHARACTERS,
+                              Uri_PROPERTY_DISPLAY_URI, 0, value);
 }
 
 static const struct IUriRuntimeClassWithAbsoluteCanonicalUriVtbl uri_canonical_vtbl =
@@ -665,7 +618,7 @@ static HRESULT STDMETHODCALLTYPE uri_factory_CreateUri(IUriRuntimeClassFactory *
         return E_POINTER;
 
     raw_buffer = WindowsGetStringRawBuffer(uri_string, NULL);
-    hr = CreateUri(raw_buffer, Uri_CREATE_ALLOW_IMPLICIT_FILE_SCHEME | Uri_CREATE_NO_DECODE_EXTRA_INFO, 0, &uri);
+    hr = CreateUri(raw_buffer, URI_CREATE_FLAGS, 0, &uri);
     if (FAILED(hr))
     {
         *instance = NULL;
@@ -691,8 +644,7 @@ static HRESULT STDMETHODCALLTYPE uri_factory_CreateWithRelativeUri(IUriRuntimeCl
     if (!instance) return E_POINTER;
     *instance = NULL;
     if (!base_uri) return E_POINTER;
-    if (FAILED(CreateUri(WindowsGetStringRawBuffer(base_uri, NULL),
-                         Uri_CREATE_ALLOW_IMPLICIT_FILE_SCHEME | Uri_CREATE_NO_DECODE_EXTRA_INFO, 0, &base)))
+    if (FAILED(CreateUri(WindowsGetStringRawBuffer(base_uri, NULL), URI_CREATE_FLAGS, 0, &base)))
         return E_INVALIDARG;
     hr = combine(base, relative_uri, instance);
     IUri_Release(base);
diff --git a/dlls/iertutil/tests/iertutil.c b/dlls/iertutil/tests/iertutil.c
index 8a33d5850cb..3e16ceebfe9 100644
--- a/dlls/iertutil/tests/iertutil.c
+++ b/dlls/iertutil/tests/iertutil.c
@@ -387,6 +387,74 @@ static void check_hstring_(int line, HSTRING str, const WCHAR *expect)
     WindowsDeleteString(str);
 }
 
+static void test_Uri_canonical(void)
+{
+    static const struct
+    {
+        const WCHAR *uri;
+        const WCHAR *absolute;
+        const WCHAR *canonical;
+        const WCHAR *display_iri;
+    }
+    tests[] =
+    {
+        {L"http://example.com/p q?\x00e9#f g", L"http://example.com/p%20q?\x00e9#f g",
+         L"http://example.com/p%20q?%C3%A9#f%20g", L"http://example.com/p%20q?\x00e9#f%20g"},
+        {L"http://%e4%b8%ad.example/%e4%b8%ad?%e4%b8%ad#%e4%b8%ad",
+         L"http://\x4e2d.example/\x4e2d?%e4%b8%ad#%e4%b8%ad",
+         L"http://xn--fiq.example/%E4%B8%AD?%E4%B8%AD#%E4%B8%AD", L"http://\x4e2d.example/\x4e2d?\x4e2d#\x4e2d"},
+        {L"http://example.com/%C3%A9?%C3%A9#%C3%A9", L"http://example.com/\x00e9?%C3%A9#%C3%A9",
+         L"http://example.com/%C3%A9?%C3%A9#%C3%A9", L"http://example.com/\x00e9?\x00e9#\x00e9"},
+        {L"http://example.com/%e4%b8%ad%ff?%41", L"http://example.com/\x4e2d%ff?%41",
+         L"http://example.com/%E4%B8%AD%ff?A", L"http://example.com/\x4e2d%ff?A"},
+        {L"http://example.com/%7e%41%2F?%41#%42", L"http://example.com/~A%2F?%41#%42",
+         L"http://example.com/~A%2F?A#B", L"http://example.com/~A%2F?A#B"},
+        {L"http://example.com/a?b c\"d<e>f\\g^h`i{j|k}l", L"http://example.com/a?b c\"d<e>f\\g^h`i{j|k}l",
+         L"http://example.com/a?b%20c%22d%3Ce%3Ef\\g%5Eh%60i%7Bj%7Ck%7Dl",
+         L"http://example.com/a?b%20c%22d%3Ce%3Ef\\g%5Eh%60i%7Bj%7Ck%7Dl"},
+        {L"https://u:p@h\x00e9llo.example/\x4e2d?q=\x00e9", L"https://u:p@h\x00e9llo.example/\x4e2d?q=\x00e9",
+         L"https://u:p@xn--hllo-bpa.example/%E4%B8%AD?q=%C3%A9", L"https://h\x00e9llo.example/\x4e2d?q=\x00e9"},
+        {L"file:///c:/a b/\x00e9", L"file:///c:/a%20b/\x00e9", L"file:///c:/a%20b/\x00e9", L"file:///c:/a%20b/\x00e9"},
+        {L"dummy:some thing/\x00e9?%41", L"dummy:some thing/\x00e9?%41", L"dummy:some thing/%C3%A9?%41",
+         L"dummy:some thing/\x00e9?%41"},
+    };
+    IUriRuntimeClassWithAbsoluteCanonicalUri *canonical;
+    IUriRuntimeClassFactory *factory;
+    IUriRuntimeClass *uri;
+    HSTRING str, name;
+    HRESULT hr;
+    UINT32 i;
+
+    RoInitialize(RO_INIT_MULTITHREADED);
+    WindowsCreateString(L"Windows.Foundation.Uri", wcslen(L"Windows.Foundation.Uri"), &name);
+    hr = RoGetActivationFactory(name, &IID_IUriRuntimeClassFactory, (void **)&factory);
+    ok(hr == S_OK, "got hr %#lx.\n", hr);
+    WindowsDeleteString(name);
+
+    for (i = 0; i < ARRAY_SIZE(tests); i++)
+    {
+        winetest_push_context("%u", i);
+        uri = create_uri(factory, tests[i].uri);
+        hr = IUriRuntimeClass_get_AbsoluteUri(uri, &str);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        check_hstring(str, tests[i].absolute);
+        hr = IUriRuntimeClass_QueryInterface(uri, &IID_IUriRuntimeClassWithAbsoluteCanonicalUri, (void **)&canonical);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        hr = IUriRuntimeClassWithAbsoluteCanonicalUri_get_AbsoluteCanonicalUri(canonical, &str);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        check_hstring(str, tests[i].canonical);
+        hr = IUriRuntimeClassWithAbsoluteCanonicalUri_get_DisplayIri(canonical, &str);
+        ok(hr == S_OK, "got hr %#lx.\n", hr);
+        check_hstring(str, tests[i].display_iri);
+        IUriRuntimeClassWithAbsoluteCanonicalUri_Release(canonical);
+        IUriRuntimeClass_Release(uri);
+        winetest_pop_context();
+    }
+
+    IUriRuntimeClassFactory_Release(factory);
+    RoUninitialize();
+}
+
 static void test_Uri_members(void)
 {
     static const struct
@@ -643,4 +711,5 @@ START_TEST(iertutil)
     test_IUriRuntimeClassFactory();
     test_IUriRuntimeClass();
     test_Uri_members();
+    test_Uri_canonical();
 }
