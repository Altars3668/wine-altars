+/*
+ * An item is what a session captures.  Only composition visuals can be one
+ * here, and a visual does not go while its item holds it, so Closed is never
+ * raised.
+ */
+struct item
+{
+    IGraphicsCaptureItem IGraphicsCaptureItem_iface;
+    LONG ref;
+    IWineCompositionVisualCapture *visual;
+    CRITICAL_SECTION cs;
+    struct list closed_handlers;
+    INT64 next_token;
+};
+
+static inline struct item *impl_from_IGraphicsCaptureItem( IGraphicsCaptureItem *iface )
+{
+    return CONTAINING_RECORD( iface, struct item, IGraphicsCaptureItem_iface );
+}
+
+static HRESULT WINAPI item_QueryInterface( IGraphicsCaptureItem *iface, REFIID iid, void **out )
+{
+    struct item *item = impl_from_IGraphicsCaptureItem( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IGraphicsCaptureItem ))
+    {
+        *out = &item->IGraphicsCaptureItem_iface;
+        IGraphicsCaptureItem_AddRef( &item->IGraphicsCaptureItem_iface );
+        return S_OK;
+    }
+
+    WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI item_AddRef( IGraphicsCaptureItem *iface )
+{
+    struct item *item = impl_from_IGraphicsCaptureItem( iface );
+    ULONG ref = InterlockedIncrement( &item->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI item_Release( IGraphicsCaptureItem *iface )
+{
+    struct item *item = impl_from_IGraphicsCaptureItem( iface );
+    ULONG ref = InterlockedDecrement( &item->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        handlers_clear( &item->closed_handlers );
+        IWineCompositionVisualCapture_Release( item->visual );
+        item->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &item->cs );
+        free( item );
+    }
+    return ref;
+}
