+static HRESULT WINAPI session_QueryInterface( IGraphicsCaptureSession *iface, REFIID iid, void **out )
+{
+    struct session *session = impl_from_IGraphicsCaptureSession( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IGraphicsCaptureSession ))
+        *out = &session->IGraphicsCaptureSession_iface;
+    else if (IsEqualGUID( iid, &IID_IGraphicsCaptureSession2 ))
+        *out = &session->IGraphicsCaptureSession2_iface;
+    else if (IsEqualGUID( iid, &IID_IGraphicsCaptureSession3 ))
+        *out = &session->IGraphicsCaptureSession3_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &session->IClosable_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI session_AddRef( IGraphicsCaptureSession *iface )
+{
+    struct session *session = impl_from_IGraphicsCaptureSession( iface );
+    ULONG ref = InterlockedIncrement( &session->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI session_Release( IGraphicsCaptureSession *iface )
+{
+    struct session *session = impl_from_IGraphicsCaptureSession( iface );
+    ULONG ref = InterlockedDecrement( &session->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        if (session->capture) IUnknown_Release( session->capture );
+        IGraphicsCaptureItem_Release( session->item );
+        IDirect3D11CaptureFramePool_Release( session->pool );
+        session->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &session->cs );
+        free( session );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI session_GetIids( IGraphicsCaptureSession *iface, ULONG *iid_count, IID **iids )
+{
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    if (!(*iids = CoTaskMemAlloc( 4 * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IGraphicsCaptureSession;
+    (*iids)[1] = IID_IGraphicsCaptureSession2;
+    (*iids)[2] = IID_IGraphicsCaptureSession3;
+    (*iids)[3] = IID_IClosable;
+    *iid_count = 4;
+    return S_OK;
+}
