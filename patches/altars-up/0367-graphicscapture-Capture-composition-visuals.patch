@@ -24,6 +24,46 @@
 
 WINE_DEFAULT_DEBUG_CHANNEL(capture);
 
+HRESULT handlers_add( struct list *list, INT64 *next_token, IUnknown *handler, EventRegistrationToken *token )
+{
+    struct handler *entry;
+
+    if (!handler || !token) return E_INVALIDARG;
+    if (!(entry = calloc( 1, sizeof(*entry) ))) return E_OUTOFMEMORY;
+    entry->token.value = ++*next_token;
+    entry->handler = handler;
+    IUnknown_AddRef( handler );
+    list_add_tail( list, &entry->entry );
+    *token = entry->token;
+    return S_OK;
+}
+
+void handlers_remove( struct list *list, EventRegistrationToken token )
+{
+    struct handler *entry;
+
+    LIST_FOR_EACH_ENTRY( entry, list, struct handler, entry )
+    {
+        if (entry->token.value != token.value) continue;
+        list_remove( &entry->entry );
+        IUnknown_Release( entry->handler );
+        free( entry );
+        return;
+    }
+}
+
+void handlers_clear( struct list *list )
+{
+    struct handler *entry, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( entry, next, list, struct handler, entry )
+    {
+        list_remove( &entry->entry );
+        IUnknown_Release( entry->handler );
+        free( entry );
+    }
+}
