+#include "private.h"
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(capture);
+
+/*
+ * A pool keeps the textures frames are drawn into.  A buffer is free, being
+ * drawn into by the composition, ready (drawn, waiting in the queue
+ * TryGetNextFrame takes from), or held by a frame until the frame is closed
+ * or released.  With no buffer free no frame is drawn.  FrameArrived is raised
+ * once for each frame drawn: on a thread of the thread pool for a pool made
+ * free-threaded, on the thread the pool was made on otherwise, through its
+ * dispatcher queue.
+ */
+enum buffer_state
+{
+    BUFFER_FREE,
+    BUFFER_DRAWING,
+    BUFFER_READY,
+    BUFFER_HELD,
+};
+
+struct buffer
+{
+    ID3D11Texture2D *texture;
+    enum buffer_state state;
+    struct list entry;          /* in the ready queue */
+    UINT width, height;         /* of what was drawn */
+    LONGLONG time;
+};
+
+struct frame_pool
+{
+    IDirect3D11CaptureFramePool IDirect3D11CaptureFramePool_iface;
+    IClosable IClosable_iface;
+    IWineCompositionCaptureSink IWineCompositionCaptureSink_iface;
+    LONG ref;
+
+    CRITICAL_SECTION cs;
+    BOOL closed;
+    BOOL free_threaded;
+    IDispatcherQueue *queue;    /* of the thread a pool that is not free-threaded was made on */
+    IDirect3DDevice *device;
+    ID3D11Device *d3d;
+    DirectXPixelFormat format;
+    SizeInt32 size;
+    struct buffer *buffers;
+    UINT buffer_count;
+    UINT generation;            /* counts the times the buffers were made again */
+    struct list ready;          /* oldest first */
+    struct list arrived_handlers;
+    INT64 next_token;
+};
+
+static inline struct frame_pool *impl_from_IDirect3D11CaptureFramePool( IDirect3D11CaptureFramePool *iface )
+{
+    return CONTAINING_RECORD( iface, struct frame_pool, IDirect3D11CaptureFramePool_iface );
+}
+
+/*** frames ***/
+
+struct frame
+{
+    IDirect3D11CaptureFrame IDirect3D11CaptureFrame_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    struct frame_pool *pool;
+    UINT index, generation;     /* the pool's buffer it holds, until closed */
+    BOOL closed;
+    ID3D11Texture2D *texture;
+    UINT width, height;
+    LONGLONG time;
+};
+
+static inline struct frame *impl_from_IDirect3D11CaptureFrame( IDirect3D11CaptureFrame *iface )
+{
+    return CONTAINING_RECORD( iface, struct frame, IDirect3D11CaptureFrame_iface );
+}
+
+/* the buffer goes back to the pool, if the pool still has it */
+static void frame_close( struct frame *frame )
+{
+    struct frame_pool *pool = frame->pool;
+
+    EnterCriticalSection( &pool->cs );
+    if (!frame->closed && !pool->closed && frame->generation == pool->generation)
+        pool->buffers[frame->index].state = BUFFER_FREE;
+    frame->closed = TRUE;
+    LeaveCriticalSection( &pool->cs );
+}
+
+static HRESULT WINAPI frame_QueryInterface( IDirect3D11CaptureFrame *iface, REFIID iid, void **out )
+{
+    struct frame *frame = impl_from_IDirect3D11CaptureFrame( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDirect3D11CaptureFrame ))
+        *out = &frame->IDirect3D11CaptureFrame_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &frame->IClosable_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI frame_AddRef( IDirect3D11CaptureFrame *iface )
+{
+    struct frame *frame = impl_from_IDirect3D11CaptureFrame( iface );
+    ULONG ref = InterlockedIncrement( &frame->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI frame_Release( IDirect3D11CaptureFrame *iface )
+{
+    struct frame *frame = impl_from_IDirect3D11CaptureFrame( iface );
+    ULONG ref = InterlockedDecrement( &frame->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        frame_close( frame );
+        ID3D11Texture2D_Release( frame->texture );
+        IDirect3D11CaptureFramePool_Release( &frame->pool->IDirect3D11CaptureFramePool_iface );
+        free( frame );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI frame_GetIids( IDirect3D11CaptureFrame *iface, ULONG *iid_count, IID **iids )
+{
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IDirect3D11CaptureFrame;
+    (*iids)[1] = IID_IClosable;
+    *iid_count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI frame_GetRuntimeClassName( IDirect3D11CaptureFrame *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.Graphics.Capture.Direct3D11CaptureFrame";
+
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
+}
+
+static HRESULT WINAPI frame_GetTrustLevel( IDirect3D11CaptureFrame *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI frame_get_Surface( IDirect3D11CaptureFrame *iface, IDirect3DSurface **value )
+{
+    struct frame *frame = impl_from_IDirect3D11CaptureFrame( iface );
+    IInspectable *inspectable;
+    IDXGISurface *surface;
+    HRESULT hr;
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (frame->closed) return RO_E_CLOSED;
+    if (FAILED(hr = ID3D11Texture2D_QueryInterface( frame->texture, &IID_IDXGISurface, (void **)&surface ))) return hr;
+    hr = CreateDirect3D11SurfaceFromDXGISurface( surface, &inspectable );
+    IDXGISurface_Release( surface );
+    if (FAILED(hr)) return hr;
+    hr = IInspectable_QueryInterface( inspectable, &IID_IDirect3DSurface, (void **)value );
+    IInspectable_Release( inspectable );
+    return hr;
+}
+
+static HRESULT WINAPI frame_get_SystemRelativeTime( IDirect3D11CaptureFrame *iface, TimeSpan *value )
+{
+    struct frame *frame = impl_from_IDirect3D11CaptureFrame( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    value->Duration = frame->time;
+    return S_OK;
+}
+
+static HRESULT WINAPI frame_get_ContentSize( IDirect3D11CaptureFrame *iface, SizeInt32 *value )
+{
+    struct frame *frame = impl_from_IDirect3D11CaptureFrame( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    value->Width = frame->width;
+    value->Height = frame->height;
+    return S_OK;
+}
+
+static const struct IDirect3D11CaptureFrameVtbl frame_vtbl =
+{
+    frame_QueryInterface,
+    frame_AddRef,
+    frame_Release,
+    /* IInspectable methods */
+    frame_GetIids,
+    frame_GetRuntimeClassName,
+    frame_GetTrustLevel,
+    /* IDirect3D11CaptureFrame methods */
+    frame_get_Surface,
+    frame_get_SystemRelativeTime,
+    frame_get_ContentSize,
+};
+
+DEFINE_IINSPECTABLE_( frame_closable, IClosable, struct frame, frame_from_IClosable, IClosable_iface,
+                      &impl->IDirect3D11CaptureFrame_iface )
+
+static HRESULT WINAPI frame_closable_Close( IClosable *iface )
+{
+    struct frame *frame = frame_from_IClosable( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    frame_close( frame );
+    return S_OK;
+}
+
+static const struct IClosableVtbl frame_closable_vtbl =
+{
+    frame_closable_QueryInterface,
+    frame_closable_AddRef,
+    frame_closable_Release,
+    /* IInspectable methods */
+    frame_closable_GetIids,
+    frame_closable_GetRuntimeClassName,
+    frame_closable_GetTrustLevel,
+    /* IClosable methods */
+    frame_closable_Close,
+};
+
+/*** raising FrameArrived ***/
+
+static void frame_pool_raise_arrived( struct frame_pool *pool )
+{
+    ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable **handlers;
+    unsigned int count = 0, i;
+    struct handler *entry;
+
+    EnterCriticalSection( &pool->cs );
+    if (pool->closed || !(handlers = calloc( list_count( &pool->arrived_handlers ) + 1, sizeof(*handlers) )))
+    {
+        LeaveCriticalSection( &pool->cs );
+        return;
+    }
+    LIST_FOR_EACH_ENTRY( entry, &pool->arrived_handlers, struct handler, entry )
+    {
+        handlers[count] = (ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable *)entry->handler;
+        ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable_AddRef( handlers[count] );
+        count++;
+    }
+    LeaveCriticalSection( &pool->cs );
+
+    for (i = 0; i < count; i++)
+    {
+        ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable_Invoke( handlers[i],
+                &pool->IDirect3D11CaptureFramePool_iface, NULL );
+        ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable_Release( handlers[i] );
+    }
+    free( handlers );
+}
+
+static void CALLBACK arrived_callback( TP_CALLBACK_INSTANCE *instance, void *context )
+{
+    struct frame_pool *pool = context;
+
+    frame_pool_raise_arrived( pool );
+    IDirect3D11CaptureFramePool_Release( &pool->IDirect3D11CaptureFramePool_iface );
+}
+
+/* what a pool that is not free-threaded queues on its thread's dispatcher queue */
+struct arrived_work
+{
+    IDispatcherQueueHandler IDispatcherQueueHandler_iface;
+    LONG ref;
+    struct frame_pool *pool;
+};
+
+static inline struct arrived_work *impl_from_IDispatcherQueueHandler( IDispatcherQueueHandler *iface )
+{
+    return CONTAINING_RECORD( iface, struct arrived_work, IDispatcherQueueHandler_iface );
+}
+
+static HRESULT WINAPI arrived_work_QueryInterface( IDispatcherQueueHandler *iface, REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IDispatcherQueueHandler ))
+    {
+        IDispatcherQueueHandler_AddRef( iface );
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI arrived_work_AddRef( IDispatcherQueueHandler *iface )
+{
+    struct arrived_work *work = impl_from_IDispatcherQueueHandler( iface );
+    return InterlockedIncrement( &work->ref );
+}
+
+static ULONG WINAPI arrived_work_Release( IDispatcherQueueHandler *iface )
+{
+    struct arrived_work *work = impl_from_IDispatcherQueueHandler( iface );
+    ULONG ref = InterlockedDecrement( &work->ref );
+
+    if (!ref)
+    {
+        IDirect3D11CaptureFramePool_Release( &work->pool->IDirect3D11CaptureFramePool_iface );
+        free( work );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI arrived_work_Invoke( IDispatcherQueueHandler *iface )
+{
+    struct arrived_work *work = impl_from_IDispatcherQueueHandler( iface );
+
+    frame_pool_raise_arrived( work->pool );
+    return S_OK;
+}
+
+static const struct IDispatcherQueueHandlerVtbl arrived_work_vtbl =
+{
+    arrived_work_QueryInterface,
+    arrived_work_AddRef,
+    arrived_work_Release,
+    /* IDispatcherQueueHandler methods */
+    arrived_work_Invoke,
+};
+
+/* called with no lock held that raising the event could need */
+static void frame_pool_queue_arrived( struct frame_pool *pool )
+{
+    struct arrived_work *work;
+    boolean queued = FALSE;
+
+    IDirect3D11CaptureFramePool_AddRef( &pool->IDirect3D11CaptureFramePool_iface );
+    if (pool->free_threaded)
+    {
+        if (!TrySubmitThreadpoolCallback( arrived_callback, pool, NULL ))
+        {
+            WARN( "could not raise FrameArrived, error %lu.\n", GetLastError() );
+            IDirect3D11CaptureFramePool_Release( &pool->IDirect3D11CaptureFramePool_iface );
+        }
+        return;
+    }
+    if (!(work = calloc( 1, sizeof(*work) )))
+    {
+        IDirect3D11CaptureFramePool_Release( &pool->IDirect3D11CaptureFramePool_iface );
+        return;
+    }
+    work->IDispatcherQueueHandler_iface.lpVtbl = &arrived_work_vtbl;
+    work->ref = 1;
+    work->pool = pool;
+    if (FAILED(IDispatcherQueue_TryEnqueue( pool->queue, &work->IDispatcherQueueHandler_iface, &queued )) || !queued)
+        WARN( "could not queue FrameArrived on the dispatcher queue.\n" );
+    IDispatcherQueueHandler_Release( &work->IDispatcherQueueHandler_iface );
+}
+
+/*** buffers ***/
+
+static void frame_pool_drop_buffers( struct frame_pool *pool )
+{
+    UINT i;
+
+    for (i = 0; i < pool->buffer_count; i++) ID3D11Texture2D_Release( pool->buffers[i].texture );
+    free( pool->buffers );
+    pool->buffers = NULL;
+    pool->buffer_count = 0;
+    list_init( &pool->ready );
+    pool->generation++;
+}
+
+static HRESULT get_d3d_device( IDirect3DDevice *device, ID3D11Device **out )
+{
+    IDirect3DDxgiInterfaceAccess *access;
+    HRESULT hr;
+
+    if (FAILED(hr = IDirect3DDevice_QueryInterface( device, &IID_IDirect3DDxgiInterfaceAccess, (void **)&access )))
+    {
+        WARN( "device %p cannot give its Direct3D device, hr %#lx.\n", device, hr );
+        return E_INVALIDARG;
+    }
+    hr = IDirect3DDxgiInterfaceAccess_GetInterface( access, &IID_ID3D11Device, (void **)out );
+    IDirect3DDxgiInterfaceAccess_Release( access );
+    return hr;
+}
+
+static BOOL format_supported( DirectXPixelFormat format )
+{
+    return format == DirectXPixelFormat_B8G8R8A8UIntNormalized || format == DirectXPixelFormat_R16G16B16A16Float;
+}
+
+/* called with the pool's lock held */
+static HRESULT frame_pool_set( struct frame_pool *pool, IDirect3DDevice *device, DirectXPixelFormat format,
+                               INT32 count, SizeInt32 size )
+{
+    D3D11_TEXTURE2D_DESC desc = {0};
+    struct buffer *buffers;
+    ID3D11Device *d3d;
+    HRESULT hr;
+    INT32 i;
+
+    if (!device) return E_INVALIDARG;
+    if (!format_supported( format ) || count <= 0 || size.Width <= 0 || size.Height <= 0)
+    {
+        WARN( "format %u, %d buffers of %dx%d.\n", format, count, size.Width, size.Height );
+        return E_INVALIDARG;
+    }
+    if (FAILED(hr = get_d3d_device( device, &d3d ))) return hr;
+    if (!(buffers = calloc( count, sizeof(*buffers) )))
+    {
+        ID3D11Device_Release( d3d );
+        return E_OUTOFMEMORY;
+    }
+
+    desc.Width = size.Width;
+    desc.Height = size.Height;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Format = format;
+    desc.SampleDesc.Count = 1;
+    desc.Usage = D3D11_USAGE_DEFAULT;
+    desc.BindFlags = D3D11_BIND_RENDER_TARGET | D3D11_BIND_SHADER_RESOURCE;
+    for (i = 0; i < count; i++)
+    {
+        if (FAILED(hr = ID3D11Device_CreateTexture2D( d3d, &desc, NULL, &buffers[i].texture )))
+        {
+            WARN( "failed to create a %dx%d buffer, format %u, hr %#lx.\n", size.Width, size.Height, format, hr );
+            while (i--) ID3D11Texture2D_Release( buffers[i].texture );
+            free( buffers );
+            ID3D11Device_Release( d3d );
+            return hr;
+        }
+    }
+
+    frame_pool_drop_buffers( pool );
+    if (pool->d3d) ID3D11Device_Release( pool->d3d );
+    if (pool->device) IDirect3DDevice_Release( pool->device );
+    pool->d3d = d3d;
+    pool->device = device;
+    IDirect3DDevice_AddRef( device );
+    pool->format = format;
+    pool->size = size;
+    pool->buffers = buffers;
+    pool->buffer_count = count;
+    return S_OK;
+}
+
+/*** IDirect3D11CaptureFramePool ***/
+
+static HRESULT WINAPI frame_pool_QueryInterface( IDirect3D11CaptureFramePool *iface, REFIID iid, void **out )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) || IsEqualGUID( iid, &IID_IDirect3D11CaptureFramePool ))
+        *out = &pool->IDirect3D11CaptureFramePool_iface;
+    else if (IsEqualGUID( iid, &IID_IClosable ))
+        *out = &pool->IClosable_iface;
+    else if (IsEqualGUID( iid, &IID_IWineCompositionCaptureSink ))
+        *out = &pool->IWineCompositionCaptureSink_iface;
+    else
+    {
+        WARN( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+        *out = NULL;
+        return E_NOINTERFACE;
+    }
+    IUnknown_AddRef( (IUnknown *)*out );
+    return S_OK;
+}
+
+static ULONG WINAPI frame_pool_AddRef( IDirect3D11CaptureFramePool *iface )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+    ULONG ref = InterlockedIncrement( &pool->ref );
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+    return ref;
+}
+
+static ULONG WINAPI frame_pool_Release( IDirect3D11CaptureFramePool *iface )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+    ULONG ref = InterlockedDecrement( &pool->ref );
+
+    TRACE( "iface %p, ref %lu.\n", iface, ref );
+
+    if (!ref)
+    {
+        frame_pool_drop_buffers( pool );
+        handlers_clear( &pool->arrived_handlers );
+        if (pool->d3d) ID3D11Device_Release( pool->d3d );
+        if (pool->device) IDirect3DDevice_Release( pool->device );
+        if (pool->queue) IDispatcherQueue_Release( pool->queue );
+        pool->cs.DebugInfo->Spare[0] = 0;
+        DeleteCriticalSection( &pool->cs );
+        free( pool );
+    }
+    return ref;
+}
+
+static HRESULT WINAPI frame_pool_GetIids( IDirect3D11CaptureFramePool *iface, ULONG *iid_count, IID **iids )
+{
+    TRACE( "iface %p, iid_count %p, iids %p.\n", iface, iid_count, iids );
+
+    if (!(*iids = CoTaskMemAlloc( 2 * sizeof(**iids) ))) return E_OUTOFMEMORY;
+    (*iids)[0] = IID_IDirect3D11CaptureFramePool;
+    (*iids)[1] = IID_IClosable;
+    *iid_count = 2;
+    return S_OK;
+}
+
+static HRESULT WINAPI frame_pool_GetRuntimeClassName( IDirect3D11CaptureFramePool *iface, HSTRING *class_name )
+{
+    static const WCHAR name[] = L"Windows.Graphics.Capture.Direct3D11CaptureFramePool";
+
+    TRACE( "iface %p, class_name %p.\n", iface, class_name );
+
+    return WindowsCreateString( name, ARRAY_SIZE(name) - 1, class_name );
+}
+
+static HRESULT WINAPI frame_pool_GetTrustLevel( IDirect3D11CaptureFramePool *iface, TrustLevel *trust_level )
+{
+    TRACE( "iface %p, trust_level %p.\n", iface, trust_level );
+
+    *trust_level = BaseTrust;
+    return S_OK;
+}
+
+static HRESULT WINAPI frame_pool_Recreate( IDirect3D11CaptureFramePool *iface, IDirect3DDevice *device,
+                                           DirectXPixelFormat format, INT32 count, SizeInt32 size )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, device %p, format %u, count %d, size %dx%d.\n", iface, device, format, count,
+           size.Width, size.Height );
+
+    EnterCriticalSection( &pool->cs );
+    if (pool->closed) hr = RO_E_CLOSED;
+    else hr = frame_pool_set( pool, device, format, count, size );
+    LeaveCriticalSection( &pool->cs );
+    return hr;
+}
+
+static HRESULT WINAPI frame_pool_TryGetNextFrame( IDirect3D11CaptureFramePool *iface, IDirect3D11CaptureFrame **result )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+    struct buffer *buffer;
+    struct frame *frame;
+    struct list *head;
+
+    TRACE( "iface %p, result %p.\n", iface, result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+
+    EnterCriticalSection( &pool->cs );
+    if (pool->closed)
+    {
+        LeaveCriticalSection( &pool->cs );
+        return RO_E_CLOSED;
+    }
+    if (!(head = list_head( &pool->ready )))
+    {
+        LeaveCriticalSection( &pool->cs );
+        return S_OK;
+    }
+    if (!(frame = calloc( 1, sizeof(*frame) )))
+    {
+        LeaveCriticalSection( &pool->cs );
+        return E_OUTOFMEMORY;
+    }
+    buffer = LIST_ENTRY( head, struct buffer, entry );
+    list_remove( &buffer->entry );
+    buffer->state = BUFFER_HELD;
+    frame->IDirect3D11CaptureFrame_iface.lpVtbl = &frame_vtbl;
+    frame->IClosable_iface.lpVtbl = &frame_closable_vtbl;
+    frame->ref = 1;
+    frame->pool = pool;
+    IDirect3D11CaptureFramePool_AddRef( iface );
+    frame->index = buffer - pool->buffers;
+    frame->generation = pool->generation;
+    frame->texture = buffer->texture;
+    ID3D11Texture2D_AddRef( frame->texture );
+    frame->width = buffer->width;
+    frame->height = buffer->height;
+    frame->time = buffer->time;
+    LeaveCriticalSection( &pool->cs );
+
+    *result = &frame->IDirect3D11CaptureFrame_iface;
+    return S_OK;
+}
+
+static HRESULT WINAPI frame_pool_add_FrameArrived( IDirect3D11CaptureFramePool *iface,
+        ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable *handler, EventRegistrationToken *token )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+    HRESULT hr;
+
+    TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
+
+    EnterCriticalSection( &pool->cs );
+    hr = handlers_add( &pool->arrived_handlers, &pool->next_token, (IUnknown *)handler, token );
+    LeaveCriticalSection( &pool->cs );
+    return hr;
+}
+
+static HRESULT WINAPI frame_pool_remove_FrameArrived( IDirect3D11CaptureFramePool *iface, EventRegistrationToken token )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+
+    TRACE( "iface %p, token %#I64x.\n", iface, token.value );
+
+    EnterCriticalSection( &pool->cs );
+    handlers_remove( &pool->arrived_handlers, token );
+    LeaveCriticalSection( &pool->cs );
+    return S_OK;
+}
+
+static HRESULT WINAPI frame_pool_CreateCaptureSession( IDirect3D11CaptureFramePool *iface, IGraphicsCaptureItem *item,
+                                                       IGraphicsCaptureSession **result )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+    BOOL closed;
+
+    TRACE( "iface %p, item %p, result %p.\n", iface, item, result );
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!item) return E_INVALIDARG;
+    EnterCriticalSection( &pool->cs );
+    closed = pool->closed;
+    LeaveCriticalSection( &pool->cs );
+    if (closed) return RO_E_CLOSED;
+    return session_create( iface, item, result );
+}
+
+static HRESULT WINAPI frame_pool_get_DispatcherQueue( IDirect3D11CaptureFramePool *iface, IDispatcherQueue **value )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    if ((*value = pool->queue)) IDispatcherQueue_AddRef( *value );
+    return S_OK;
+}
+
+static const struct IDirect3D11CaptureFramePoolVtbl frame_pool_vtbl =
+{
+    frame_pool_QueryInterface,
+    frame_pool_AddRef,
+    frame_pool_Release,
+    /* IInspectable methods */
+    frame_pool_GetIids,
+    frame_pool_GetRuntimeClassName,
+    frame_pool_GetTrustLevel,
+    /* IDirect3D11CaptureFramePool methods */
+    frame_pool_Recreate,
+    frame_pool_TryGetNextFrame,
+    frame_pool_add_FrameArrived,
+    frame_pool_remove_FrameArrived,
+    frame_pool_CreateCaptureSession,
+    frame_pool_get_DispatcherQueue,
+};
+
+DEFINE_IINSPECTABLE_( pool_closable, IClosable, struct frame_pool, pool_from_IClosable, IClosable_iface,
+                      &impl->IDirect3D11CaptureFramePool_iface )
+
+/* the buffers go, and nothing more is drawn into the pool nor taken from it */
+static HRESULT WINAPI pool_closable_Close( IClosable *iface )
+{
+    struct frame_pool *pool = pool_from_IClosable( iface );
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &pool->cs );
+    if (!pool->closed)
+    {
+        pool->closed = TRUE;
+        frame_pool_drop_buffers( pool );
+        handlers_clear( &pool->arrived_handlers );
+    }
+    LeaveCriticalSection( &pool->cs );
+    return S_OK;
+}
+
+static const struct IClosableVtbl pool_closable_vtbl =
+{
+    pool_closable_QueryInterface,
+    pool_closable_AddRef,
+    pool_closable_Release,
+    /* IInspectable methods */
+    pool_closable_GetIids,
+    pool_closable_GetRuntimeClassName,
+    pool_closable_GetTrustLevel,
+    /* IClosable methods */
+    pool_closable_Close,
+};
