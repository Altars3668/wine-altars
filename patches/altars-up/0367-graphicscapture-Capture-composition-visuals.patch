+
+static HRESULT WINAPI session_StartCapture( IGraphicsCaptureSession *iface )
+{
+    struct session *session = impl_from_IGraphicsCaptureSession( iface );
+    IUnknown *capture;
+    HRESULT hr;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &session->cs );
+    if (session->closed) hr = RO_E_CLOSED;
+    else if (session->capture) hr = S_OK;
+    else if (SUCCEEDED(hr = frame_pool_start( session->pool, session->item, &capture )))
+        session->capture = capture;
+    LeaveCriticalSection( &session->cs );
+    return hr;
