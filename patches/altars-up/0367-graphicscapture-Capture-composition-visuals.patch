+
+static HRESULT current_dispatcher_queue( IDispatcherQueue **queue )
+{
+    static const WCHAR name[] = L"Windows.System.DispatcherQueue";
+    IDispatcherQueueStatics *statics;
+    HSTRING str;
+    HRESULT hr;
+
+    *queue = NULL;
+    if (FAILED(hr = WindowsCreateString( name, ARRAY_SIZE(name) - 1, &str ))) return hr;
+    hr = RoGetActivationFactory( str, &IID_IDispatcherQueueStatics, (void **)&statics );
+    WindowsDeleteString( str );
+    if (FAILED(hr)) return hr;
+    hr = IDispatcherQueueStatics_GetForCurrentThread( statics, queue );
+    IDispatcherQueueStatics_Release( statics );
+    return hr;
+}
+
+static HRESULT frame_pool_create( IDirect3DDevice *device, DirectXPixelFormat format, INT32 count, SizeInt32 size,
+                                  BOOL free_threaded, IDirect3D11CaptureFramePool **result )
+{
+    IDispatcherQueue *queue = NULL;
+    struct frame_pool *pool;
+    HRESULT hr;
+
+    if (!result) return E_POINTER;
+    *result = NULL;
+    /* the events of a pool that is not free-threaded are raised on this thread's dispatcher queue */
+    if (!free_threaded && (FAILED(hr = current_dispatcher_queue( &queue )) || !queue))
+    {
+        WARN( "no dispatcher queue on this thread, hr %#lx.\n", hr );
+        return RPC_E_WRONG_THREAD;
+    }
+
+    if (!(pool = calloc( 1, sizeof(*pool) )))
+    {
+        if (queue) IDispatcherQueue_Release( queue );
+        return E_OUTOFMEMORY;
+    }
+    pool->IDirect3D11CaptureFramePool_iface.lpVtbl = &frame_pool_vtbl;
+    pool->IClosable_iface.lpVtbl = &pool_closable_vtbl;
+    pool->IWineCompositionCaptureSink_iface.lpVtbl = &sink_vtbl;
+    pool->ref = 1;
+    pool->free_threaded = free_threaded;
+    pool->queue = queue;
+    InitializeCriticalSectionEx( &pool->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    pool->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": frame_pool.cs");
+    list_init( &pool->ready );
+    list_init( &pool->arrived_handlers );
+
+    if (FAILED(hr = frame_pool_set( pool, device, format, count, size )))
+    {
+        IDirect3D11CaptureFramePool_Release( &pool->IDirect3D11CaptureFramePool_iface );
+        return hr;
+    }
+
+    TRACE( "created pool %p.\n", pool );
+    *result = &pool->IDirect3D11CaptureFramePool_iface;
+    return S_OK;
+}
+
+DEFINE_IINSPECTABLE( frame_pool_statics, IDirect3D11CaptureFramePoolStatics, struct frame_pool_statics,
+                     IActivationFactory_iface )
+
+static HRESULT WINAPI frame_pool_statics_Create( IDirect3D11CaptureFramePoolStatics *iface, IDirect3DDevice *device,
+                                                 DirectXPixelFormat format, INT32 count, SizeInt32 size,
+                                                 IDirect3D11CaptureFramePool **result )
