+/*
+ * A session draws what its item shows into its pool's buffers from
+ * StartCapture on, until it is closed.  Only visuals are items here, and
+ * neither the cursor nor a border is drawn into a visual's frames, whatever
+ * the properties say.
+ */
+struct session
+{
+    IGraphicsCaptureSession IGraphicsCaptureSession_iface;
+    IGraphicsCaptureSession2 IGraphicsCaptureSession2_iface;
+    IGraphicsCaptureSession3 IGraphicsCaptureSession3_iface;
+    IClosable IClosable_iface;
+    LONG ref;
+    CRITICAL_SECTION cs;
+    IDirect3D11CaptureFramePool *pool;
+    IGraphicsCaptureItem *item;
+    IUnknown *capture;          /* while capturing */
+    BOOL closed;
+    boolean cursor_capture;
+    boolean border_required;
+};
+
+static inline struct session *impl_from_IGraphicsCaptureSession( IGraphicsCaptureSession *iface )
+{
+    return CONTAINING_RECORD( iface, struct session, IGraphicsCaptureSession_iface );
+}
