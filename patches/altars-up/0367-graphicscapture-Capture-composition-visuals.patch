+/*** IWineCompositionCaptureSink, called by the composition ***/
+
+static inline struct frame_pool *impl_from_IWineCompositionCaptureSink( IWineCompositionCaptureSink *iface )
+{
+    return CONTAINING_RECORD( iface, struct frame_pool, IWineCompositionCaptureSink_iface );
