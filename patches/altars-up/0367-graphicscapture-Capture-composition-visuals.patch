+static HRESULT WINAPI sink_QueryInterface( IWineCompositionCaptureSink *iface, REFIID iid, void **out )
+{
+    struct frame_pool *pool = impl_from_IWineCompositionCaptureSink( iface );
+    return frame_pool_QueryInterface( &pool->IDirect3D11CaptureFramePool_iface, iid, out );
+}
