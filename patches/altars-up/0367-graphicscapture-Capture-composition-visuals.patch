+    struct session *session = impl_from_IGraphicsCaptureSession3( iface );
+
+    TRACE( "iface %p, value %p.\n", iface, value );
+
+    if (!value) return E_POINTER;
+    *value = session->border_required;
+    return S_OK;
+}
+
+static HRESULT WINAPI session3_put_IsBorderRequired( IGraphicsCaptureSession3 *iface, boolean value )
+{
+    struct session *session = impl_from_IGraphicsCaptureSession3( iface );
+
+    TRACE( "iface %p, value %d.\n", iface, value );
+
+    session->border_required = value;
+    return S_OK;
+}
+
+static const struct IGraphicsCaptureSession3Vtbl session3_vtbl =
+{
+    session3_QueryInterface,
+    session3_AddRef,
+    session3_Release,
+    /* IInspectable methods */
+    session3_GetIids,
+    session3_GetRuntimeClassName,
+    session3_GetTrustLevel,
+    /* IGraphicsCaptureSession3 methods */
+    session3_get_IsBorderRequired,
+    session3_put_IsBorderRequired,
+};
+
+DEFINE_IINSPECTABLE( session_closable, IClosable, struct session, IGraphicsCaptureSession_iface )
+
+static HRESULT WINAPI session_closable_Close( IClosable *iface )
+{
+    struct session *session = impl_from_IClosable( iface );
+    IUnknown *capture;
+
+    TRACE( "iface %p.\n", iface );
+
+    EnterCriticalSection( &session->cs );
+    session->closed = TRUE;
+    capture = session->capture;
+    session->capture = NULL;
+    LeaveCriticalSection( &session->cs );
+    /* not with the session's lock held: this takes the composition's */
+    if (capture) IUnknown_Release( capture );
+    return S_OK;
+}
+
+static const struct IClosableVtbl session_closable_vtbl =
+{
+    session_closable_QueryInterface,
+    session_closable_AddRef,
+    session_closable_Release,
+    /* IInspectable methods */
+    session_closable_GetIids,
+    session_closable_GetRuntimeClassName,
+    session_closable_GetTrustLevel,
+    /* IClosable methods */
+    session_closable_Close,
+};
+
+HRESULT session_create( IDirect3D11CaptureFramePool *pool, IGraphicsCaptureItem *item, IGraphicsCaptureSession **out )
+{
+    struct session *session;
+
+    if (!item_visual( item ))
+    {
+        WARN( "item %p is not one of ours.\n", item );
+        return E_INVALIDARG;
+    }
+    if (!(session = calloc( 1, sizeof(*session) ))) return E_OUTOFMEMORY;
+    session->IGraphicsCaptureSession_iface.lpVtbl = &session_vtbl;
+    session->IGraphicsCaptureSession2_iface.lpVtbl = &session2_vtbl;
+    session->IGraphicsCaptureSession3_iface.lpVtbl = &session3_vtbl;
+    session->IClosable_iface.lpVtbl = &session_closable_vtbl;
+    session->ref = 1;
+    InitializeCriticalSectionEx( &session->cs, 0, RTL_CRITICAL_SECTION_FLAG_FORCE_DEBUG_INFO );
+    session->cs.DebugInfo->Spare[0] = (DWORD_PTR)(__FILE__ ": session.cs");
+    session->pool = pool;
+    IDirect3D11CaptureFramePool_AddRef( pool );
+    session->item = item;
+    IGraphicsCaptureItem_AddRef( item );
+    session->cursor_capture = TRUE;
+    session->border_required = TRUE;
+
+    TRACE( "created session %p.\n", session );
+    *out = &session->IGraphicsCaptureSession_iface;
+    return S_OK;
+}
