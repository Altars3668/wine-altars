+static ULONG WINAPI sink_AddRef( IWineCompositionCaptureSink *iface )
+{
+    struct frame_pool *pool = impl_from_IWineCompositionCaptureSink( iface );
+    return frame_pool_AddRef( &pool->IDirect3D11CaptureFramePool_iface );
+}
+
+static ULONG WINAPI sink_Release( IWineCompositionCaptureSink *iface )
+{
+    struct frame_pool *pool = impl_from_IWineCompositionCaptureSink( iface );
+    return frame_pool_Release( &pool->IDirect3D11CaptureFramePool_iface );
+}
+
+static HRESULT WINAPI sink_get_buffer( IWineCompositionCaptureSink *iface, ID3D11Texture2D **texture )
+{
+    struct frame_pool *pool = impl_from_IWineCompositionCaptureSink( iface );
+    HRESULT hr = S_FALSE;
+    UINT i;
+
+    *texture = NULL;
+    EnterCriticalSection( &pool->cs );
+    for (i = 0; !pool->closed && i < pool->buffer_count; i++)
+    {
+        if (pool->buffers[i].state != BUFFER_FREE) continue;
+        pool->buffers[i].state = BUFFER_DRAWING;
+        *texture = pool->buffers[i].texture;
+        ID3D11Texture2D_AddRef( *texture );
+        hr = S_OK;
+        break;
+    }
+    LeaveCriticalSection( &pool->cs );
+    if (hr != S_OK) TRACE( "pool %p: no buffer free.\n", pool );
+    return hr;
+}
+
+static void WINAPI sink_frame_drawn( IWineCompositionCaptureSink *iface, ID3D11Texture2D *texture, UINT width,
+                                     UINT height, LONGLONG time )
+{
+    struct frame_pool *pool = impl_from_IWineCompositionCaptureSink( iface );
+    BOOL arrived = FALSE;
+    UINT i;
+
+    TRACE( "pool %p, texture %p, %ux%u.\n", pool, texture, width, height );
+
+    EnterCriticalSection( &pool->cs );
+    for (i = 0; !pool->closed && i < pool->buffer_count; i++)
+    {
+        struct buffer *buffer = &pool->buffers[i];
+
+        if (buffer->texture != texture || buffer->state != BUFFER_DRAWING) continue;
+        buffer->state = BUFFER_READY;
+        buffer->width = width;
+        buffer->height = height;
+        buffer->time = time;
+        list_add_tail( &pool->ready, &buffer->entry );
+        arrived = TRUE;
+        break;
+    }
+    LeaveCriticalSection( &pool->cs );
+    if (arrived) frame_pool_queue_arrived( pool );
+}
+
+static const struct IWineCompositionCaptureSinkVtbl sink_vtbl =
+{
+    sink_QueryInterface,
+    sink_AddRef,
+    sink_Release,
+    /* IWineCompositionCaptureSink methods */
+    sink_get_buffer,
+    sink_frame_drawn,
+};
+
+HRESULT frame_pool_start( IDirect3D11CaptureFramePool *iface, IGraphicsCaptureItem *item, IUnknown **capture )
+{
+    struct frame_pool *pool = impl_from_IDirect3D11CaptureFramePool( iface );
+    IWineCompositionVisualCapture *visual;
+    ID3D11Device *d3d;
+    HRESULT hr;
+
+    if (!(visual = item_visual( item ))) return E_INVALIDARG;
+    EnterCriticalSection( &pool->cs );
+    if ((d3d = pool->closed ? NULL : pool->d3d)) ID3D11Device_AddRef( d3d );
+    LeaveCriticalSection( &pool->cs );
+    if (!d3d) return RO_E_CLOSED;
+    /* not with the pool's lock held: the composition takes its own, and holds it when it calls the sink */
+    hr = IWineCompositionVisualCapture_start( visual, d3d, &pool->IWineCompositionCaptureSink_iface, capture );
+    ID3D11Device_Release( d3d );
+    return hr;
+}
