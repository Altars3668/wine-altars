+/*** capturing a composition visual ***/
+
+struct arrived
+{
+    ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable_iface;
+    HANDLE event;
+    LONG count;
+};
+
+static HRESULT WINAPI arrived_QueryInterface( ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable *iface,
+                                              REFIID iid, void **out )
+{
+    if (IsEqualGUID( iid, &IID_IUnknown ) || IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable ))
+    {
+        *out = iface;
+        return S_OK;
+    }
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI arrived_AddRef( ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable *iface )
+{
+    return 2;
+}
+
+static ULONG WINAPI arrived_Release( ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable *iface )
+{
+    return 1;
+}
+
+static HRESULT WINAPI arrived_Invoke( ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable *iface,
+                                      IDirect3D11CaptureFramePool *sender, IInspectable *args )
+{
+    struct arrived *arrived = CONTAINING_RECORD( iface, struct arrived,
+            ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable_iface );
+
+    ok( !!sender, "got no sender.\n" );
+    ok( !args, "got args %p.\n", args );
+    InterlockedIncrement( &arrived->count );
+    SetEvent( arrived->event );
+    return S_OK;
+}
+
+static const ITypedEventHandler_Direct3D11CaptureFramePool_IInspectableVtbl arrived_vtbl =
+{
+    arrived_QueryInterface,
+    arrived_AddRef,
+    arrived_Release,
+    arrived_Invoke,
+};
+
+/* the composition draws on this thread, through its dispatcher queue */
+static DWORD wait_arrived( struct arrived *arrived, DWORD ms )
+{
+    DWORD end = GetTickCount() + ms, ret;
+    MSG msg;
+
+    for (;;)
+    {
+        while (PeekMessageW( &msg, NULL, 0, 0, PM_REMOVE )) DispatchMessageW( &msg );
+        ret = MsgWaitForMultipleObjects( 1, &arrived->event, FALSE, 10, QS_ALLINPUT );
+        if (ret == WAIT_OBJECT_0 || (int)(end - GetTickCount()) <= 0) return ret;
+    }
+}
+
+static HSTRING hstring( const WCHAR *s )
+{
+    HSTRING str = NULL;
+    WindowsCreateString( s, wcslen( s ), &str );
+    return str;
+}
+
+static ISpriteVisual *create_sprite( ICompositor *compositor, float width, float height, float x, float y,
+                                     Color colour, ICompositionColorBrush **out )
+{
+    Vector2 size = {width, height};
+    Vector3 offset = {x, y, 0.0f};
+    ICompositionColorBrush *brush;
+    ICompositionBrush *base;
+    ISpriteVisual *sprite;
+    IVisual *visual;
+
+    ICompositor_CreateSpriteVisual( compositor, &sprite );
+    ISpriteVisual_QueryInterface( sprite, &IID_IVisual, (void **)&visual );
+    IVisual_put_Size( visual, size );
+    IVisual_put_Offset( visual, offset );
+    IVisual_Release( visual );
+    ICompositor_CreateColorBrushWithColor( compositor, colour, &brush );
+    ICompositionColorBrush_QueryInterface( brush, &IID_ICompositionBrush, (void **)&base );
+    ISpriteVisual_put_Brush( sprite, base );
+    ICompositionBrush_Release( base );
+    if (out) *out = brush;
+    else ICompositionColorBrush_Release( brush );
+    return sprite;
+}
+
+#define check_frame( pool, device, colour, child ) check_frame_( __LINE__, pool, device, colour, child )
+static void check_frame_( unsigned int line, IDirect3D11CaptureFramePool *pool, ID3D11Device *device,
+                          DWORD colour, DWORD child )
+{
+    IDirect3DDxgiInterfaceAccess *access;
+    Direct3DSurfaceDescription desc;
+    ID3D11DeviceContext *immediate;
+    IDirect3D11CaptureFrame *frame;
+    D3D11_TEXTURE2D_DESC tex_desc;
+    ID3D11Texture2D *texture, *staging;
+    D3D11_MAPPED_SUBRESOURCE map;
+    IDirect3DSurface *surface;
+    SizeInt32 size;
+    IClosable *closable;
+    HRESULT hr;
+
+    frame = NULL;
+    hr = IDirect3D11CaptureFramePool_TryGetNextFrame( pool, &frame );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    ok_(__FILE__, line)( !!frame, "got no frame.\n" );
+    if (!frame) return;
+    hr = IDirect3D11CaptureFrame_get_ContentSize( frame, &size );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    ok_(__FILE__, line)( size.Width == 64 && size.Height == 32, "got size %dx%d.\n", size.Width, size.Height );
+    hr = IDirect3D11CaptureFrame_get_Surface( frame, &surface );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDirect3DSurface_get_Description( surface, &desc );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    ok_(__FILE__, line)( desc.Width == 64 && desc.Height == 32, "got size %dx%d.\n", desc.Width, desc.Height );
+    ok_(__FILE__, line)( desc.Format == DirectXPixelFormat_B8G8R8A8UIntNormalized, "got format %u.\n", desc.Format );
+    hr = IDirect3DSurface_QueryInterface( surface, &IID_IDirect3DDxgiInterfaceAccess, (void **)&access );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDirect3DDxgiInterfaceAccess_GetInterface( access, &IID_ID3D11Texture2D, (void **)&texture );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    IDirect3DDxgiInterfaceAccess_Release( access );
+    IDirect3DSurface_Release( surface );
+
+    ID3D11Texture2D_GetDesc( texture, &tex_desc );
+    tex_desc.Usage = D3D11_USAGE_STAGING;
+    tex_desc.BindFlags = 0;
+    tex_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ;
+    tex_desc.MiscFlags = 0;
+    hr = ID3D11Device_CreateTexture2D( device, &tex_desc, NULL, &staging );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    ID3D11Device_GetImmediateContext( device, &immediate );
+    ID3D11DeviceContext_CopyResource( immediate, (ID3D11Resource *)staging, (ID3D11Resource *)texture );
+    hr = ID3D11DeviceContext_Map( immediate, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    if (hr == S_OK)
+    {
+        DWORD *row = (DWORD *)((BYTE *)map.pData + map.RowPitch);
+        ok_(__FILE__, line)( row[1] == colour, "got %08lx at (1,1).\n", row[1] );
+        row = (DWORD *)((BYTE *)map.pData + map.RowPitch * 12);
+        ok_(__FILE__, line)( row[12] == child, "got %08lx at (12,12).\n", row[12] );
+        ok_(__FILE__, line)( row[40] == colour, "got %08lx at (40,12).\n", row[40] );
+        ID3D11DeviceContext_Unmap( immediate, (ID3D11Resource *)staging, 0 );
+    }
+    ID3D11DeviceContext_Release( immediate );
+    ID3D11Texture2D_Release( staging );
+    ID3D11Texture2D_Release( texture );
+
+    hr = IDirect3D11CaptureFrame_QueryInterface( frame, &IID_IClosable, (void **)&closable );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IClosable_Close( closable );
+    ok_(__FILE__, line)( hr == S_OK, "got hr %#lx.\n", hr );
+    IClosable_Release( closable );
+    IDirect3D11CaptureFrame_Release( frame );
+}
+
+static void test_capture_visual(void)
+{
+    static const Color red = {255, 255, 0, 0}, green = {255, 0, 255, 0}, blue = {255, 0, 0, 255};
+    struct DispatcherQueueOptions options = {sizeof(options), DQTYPE_THREAD_CURRENT, DQTAT_COM_NONE};
+    struct arrived arrived = {{&arrived_vtbl}};
+    HRESULT (WINAPI *create_queue)(struct DispatcherQueueOptions, IDispatcherQueueController **);
+    HRESULT (WINAPI *create_device)(IDXGIDevice *, IInspectable **);
+    IDirect3D11CaptureFramePoolStatics2 *pool_statics;
+    IDispatcherQueueController *controller = NULL;
+    IDirect3D11CaptureFramePool *pool = NULL;
+    IGraphicsCaptureSession *session = NULL;
+    IGraphicsCaptureItemStatics *item_statics;
+    IDirect3DDxgiInterfaceAccess *access;
+    IGraphicsCaptureItem *item = NULL;
+    ICompositionColorBrush *brush;
+    IDirect3DDevice *device = NULL;
+    IDirect3D11CaptureFrame *frame;
+    IVisualCollection *children;
+    IContainerVisual *container;
+    ICompositor *compositor;
+    ISpriteVisual *root, *child;
+    IInspectable *inspectable;
+    EventRegistrationToken token;
+    IVisual *visual, *child_visual;
+    IDXGIDevice *dxgi, *back;
+    ID3D11Device *d3d;
+    IClosable *closable;
+    SizeInt32 size;
+    HSTRING str;
+    HRESULT hr;
+
+    create_queue = (void *)GetProcAddress( LoadLibraryW( L"coremessaging.dll" ), "CreateDispatcherQueueController" );
+    create_device = (void *)GetProcAddress( LoadLibraryW( L"d3d11.dll" ), "CreateDirect3D11DeviceFromDXGIDevice" );
+    if (!create_queue || !create_device)
+    {
+        win_skip( "no dispatcher queues or Direct3D devices for WinRT.\n" );
+        return;
+    }
+    hr = create_queue( options, &controller );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    str = hstring( L"Windows.UI.Composition.Compositor" );
+    hr = RoActivateInstance( str, &inspectable );
+    WindowsDeleteString( str );
+    ok( hr == S_OK || broken( hr == REGDB_E_CLASSNOTREG ), "got hr %#lx.\n", hr );
+    if (FAILED(hr)) goto done;
+    IInspectable_QueryInterface( inspectable, &IID_ICompositor, (void **)&compositor );
+    IInspectable_Release( inspectable );
+
+    str = hstring( L"Windows.Graphics.Capture.GraphicsCaptureItem" );
+    hr = RoGetActivationFactory( str, &IID_IGraphicsCaptureItemStatics, (void **)&item_statics );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr))
+    {
+        ICompositor_Release( compositor );
+        goto done;
+    }
+    str = hstring( L"Windows.Graphics.Capture.Direct3D11CaptureFramePool" );
+    hr = RoGetActivationFactory( str, &IID_IDirect3D11CaptureFramePoolStatics2, (void **)&pool_statics );
+    WindowsDeleteString( str );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (FAILED(hr))
+    {
+        IGraphicsCaptureItemStatics_Release( item_statics );
+        ICompositor_Release( compositor );
+        goto done;
+    }
+
+    hr = D3D11CreateDevice( NULL, D3D_DRIVER_TYPE_HARDWARE, NULL, D3D11_CREATE_DEVICE_BGRA_SUPPORT, NULL, 0,
+                            D3D11_SDK_VERSION, &d3d, NULL, NULL );
+    if (FAILED(hr))
+        hr = D3D11CreateDevice( NULL, D3D_DRIVER_TYPE_WARP, NULL, D3D11_CREATE_DEVICE_BGRA_SUPPORT, NULL, 0,
+                                D3D11_SDK_VERSION, &d3d, NULL, NULL );
+    if (FAILED(hr))
+    {
+        skip( "no Direct3D 11 device, hr %#lx.\n", hr );
+        IGraphicsCaptureItemStatics_Release( item_statics );
+        IDirect3D11CaptureFramePoolStatics2_Release( pool_statics );
+        ICompositor_Release( compositor );
+        goto done;
+    }
+    ID3D11Device_QueryInterface( d3d, &IID_IDXGIDevice, (void **)&dxgi );
+    hr = create_device( dxgi, &inspectable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IInspectable_QueryInterface( inspectable, &IID_IDirect3DDevice, (void **)&device );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_interface( inspectable, &IID_IClosable );
+    hr = IInspectable_QueryInterface( inspectable, &IID_IDirect3DDxgiInterfaceAccess, (void **)&access );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDirect3DDxgiInterfaceAccess_GetInterface( access, &IID_IDXGIDevice, (void **)&back );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( back == dxgi, "got another device.\n" );
+    IDXGIDevice_Release( back );
+    IDirect3DDxgiInterfaceAccess_Release( access );
+    IInspectable_Release( inspectable );
+
+    /* red, with a green square in it */
+    root = create_sprite( compositor, 64.0f, 32.0f, 0.0f, 0.0f, red, &brush );
+    child = create_sprite( compositor, 16.0f, 16.0f, 8.0f, 8.0f, green, NULL );
+    ISpriteVisual_QueryInterface( root, &IID_IVisual, (void **)&visual );
+    ISpriteVisual_QueryInterface( child, &IID_IVisual, (void **)&child_visual );
+    ISpriteVisual_QueryInterface( root, &IID_IContainerVisual, (void **)&container );
+    IContainerVisual_get_Children( container, &children );
+    IVisualCollection_InsertAtTop( children, child_visual );
+
+    hr = IGraphicsCaptureItemStatics_CreateFromVisual( item_statics, visual, &item );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    if (!item) goto release;
+    check_interface( item, &IID_IGraphicsCaptureItem );
+    check_interface( item, &IID_IAgileObject );
+    hr = IGraphicsCaptureItem_get_Size( item, &size );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( size.Width == 64 && size.Height == 32, "got size %dx%d.\n", size.Width, size.Height );
+
+    hr = IDirect3D11CaptureFramePoolStatics2_CreateFreeThreaded( pool_statics, device,
+            DirectXPixelFormat_B8G8R8A8UIntNormalized, 1, size, &pool );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    check_interface( pool, &IID_IClosable );
+    arrived.event = CreateEventW( NULL, FALSE, FALSE, NULL );
+    hr = IDirect3D11CaptureFramePool_add_FrameArrived( pool,
+            &arrived.ITypedEventHandler_Direct3D11CaptureFramePool_IInspectable_iface, &token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IDirect3D11CaptureFramePool_CreateCaptureSession( pool, item, &session );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+
+    /* nothing is drawn before the capture starts */
+    frame = (void *)0xdeadbeef;
+    hr = IDirect3D11CaptureFramePool_TryGetNextFrame( pool, &frame );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !frame, "got frame %p.\n", frame );
+
+    hr = IGraphicsCaptureSession_StartCapture( session );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( wait_arrived( &arrived, 5000 ) == WAIT_OBJECT_0, "no frame arrived.\n" );
+    check_frame( pool, d3d, 0xffff0000, 0xff00ff00 );
+    /* the only buffer was taken, and nothing changed since */
+    frame = (void *)0xdeadbeef;
+    hr = IDirect3D11CaptureFramePool_TryGetNextFrame( pool, &frame );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( !frame, "got frame %p.\n", frame );
+
+    /* a change brings a frame, with no commit asked for */
+    hr = ICompositionColorBrush_put_Color( brush, blue );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    ok( wait_arrived( &arrived, 5000 ) == WAIT_OBJECT_0, "no frame arrived.\n" );
+    check_frame( pool, d3d, 0xff0000ff, 0xff00ff00 );
+
+    hr = IDirect3D11CaptureFramePool_remove_FrameArrived( pool, token );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IGraphicsCaptureSession_QueryInterface( session, &IID_IClosable, (void **)&closable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IClosable_Close( closable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IClosable_Release( closable );
+    hr = IDirect3D11CaptureFramePool_QueryInterface( pool, &IID_IClosable, (void **)&closable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    hr = IClosable_Close( closable );
+    ok( hr == S_OK, "got hr %#lx.\n", hr );
+    IClosable_Release( closable );
+    CloseHandle( arrived.event );
+
+    IGraphicsCaptureSession_Release( session );
+    IDirect3D11CaptureFramePool_Release( pool );
+    IGraphicsCaptureItem_Release( item );
+release:
+    ICompositionColorBrush_Release( brush );
+    IVisualCollection_Release( children );
+    IContainerVisual_Release( container );
+    IVisual_Release( child_visual );
+    IVisual_Release( visual );
+    ISpriteVisual_Release( child );
+    ISpriteVisual_Release( root );
+    IDirect3DDevice_Release( device );
+    IDXGIDevice_Release( dxgi );
+    ID3D11Device_Release( d3d );
+    IGraphicsCaptureItemStatics_Release( item_statics );
+    IDirect3D11CaptureFramePoolStatics2_Release( pool_statics );
+    ICompositor_Release( compositor );
+done:
+    if (controller) IDispatcherQueueController_Release( controller );
+}
