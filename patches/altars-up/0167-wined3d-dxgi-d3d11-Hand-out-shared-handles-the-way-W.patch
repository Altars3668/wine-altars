+struct wined3d_resource * CDECL wined3d_resource_from_nt_shared_handle(struct wined3d_device *device,
+        HANDLE handle)
+{
+    D3DKMT_OPENRESOURCEFROMNTHANDLE open = {0};
+    D3DKMT_DESTROYALLOCATION2 destroy = {0};
+    D3DKMT_CREATEDEVICE create_device = {0};
+    D3DKMT_DESTROYDEVICE destroy_device = {0};
+    struct wined3d_shared_runtime_data runtime_data = {0};
+    D3DDDI_OPENALLOCATIONINFO2 allocation = {0};
+    struct wined3d_shared_resource *shared;
+    struct wined3d_resource *resource = NULL;
+    char driver_data[16];
+    NTSTATUS status;
+
+    TRACE("device %p, handle %p.\n", device, handle);
+
+    create_device.hAdapter = device->adapter->kmt_adapter;
+    if ((status = D3DKMTCreateDevice(&create_device)))
+    {
+        WARN("Failed to create a D3DKMT device, status %#lx.\n", status);
+        return NULL;
+    }
+
+    open.hDevice = create_device.hDevice;
+    open.hNtHandle = handle;
+    open.NumAllocations = 1;
+    open.pOpenAllocationInfo2 = &allocation;
+    open.pPrivateRuntimeData = &runtime_data;
+    open.PrivateRuntimeDataSize = sizeof(runtime_data);
+    open.pTotalPrivateDriverDataBuffer = driver_data;
+    open.TotalPrivateDriverDataBufferSize = sizeof(driver_data);
+    if ((status = D3DKMTOpenResourceFromNtHandle(&open)))
+    {
+        WARN("Failed to open NT handle %p, status %#lx.\n", handle, status);
+    }
+    else
+    {
+        destroy.hDevice = create_device.hDevice;
+        destroy.hResource = open.hResource;
+        D3DKMTDestroyAllocation2(&destroy);
+
+        if (open.PrivateRuntimeDataSize != sizeof(runtime_data)
+                || runtime_data.magic != WINED3D_SHARED_RUNTIME_MAGIC)
+            WARN("Handle %p is not a wined3d resource.\n", handle);
+        else if (runtime_data.pid != GetCurrentProcessId())
+            FIXME("Handle %p is a resource of process %#lx, which cannot be shared yet.\n",
+                    handle, runtime_data.pid);
+        else
+        {
+            EnterCriticalSection(&wined3d_shared_resources_cs);
+            LIST_FOR_EACH_ENTRY(shared, &wined3d_shared_resources, struct wined3d_shared_resource, entry)
+            {
+                if (shared->serial == runtime_data.serial)
+                {
+                    resource = shared->resource;
+                    break;
+                }
+            }
+            LeaveCriticalSection(&wined3d_shared_resources_cs);
+        }
+    }
+
+    destroy_device.hDevice = create_device.hDevice;
+    D3DKMTDestroyDevice(&destroy_device);
+
+    return resource;
+}
