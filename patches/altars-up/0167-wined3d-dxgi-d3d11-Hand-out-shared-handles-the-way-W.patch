+struct wined3d_resource * CDECL wined3d_resource_from_shared_name(struct wined3d_device *device,
+        const WCHAR *name, DWORD access)
+{
+    D3DKMT_OPENNTHANDLEFROMNAME open = {0};
+    struct wined3d_resource *resource;
