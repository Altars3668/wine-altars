+/* test_shared_resource stops at GetSharedHandle for a texture shared through NT handles; these go on. */
+static void test_shared_resource_nt_handle(void)
+{
+    static const WCHAR name[] = L"wine_d3d11_test_shared_resource";
+    char buffer[1024];
+    OBJECT_TYPE_INFORMATION *type = (OBJECT_TYPE_INFORMATION *)buffer;
+    D3D11_TEXTURE2D_DESC desc, desc2;
+    ID3D11Texture2D *tex, *tex2;
+    ID3D11Device1 *device1;
+    ID3D11Device *device;
+    IDXGIResource1 *res1;
+    NTSTATUS status;
+    HANDLE h, h2;
+    ULONG len;
+    HRESULT hr;
+    BOOL bret;
+
+    if (!(device = create_device(NULL)))
+    {
+        skip("Failed to create device.\n");
+        return;
+    }
+    if (FAILED(hr = ID3D11Device_QueryInterface(device, &IID_ID3D11Device1, (void **)&device1)))
+    {
+        win_skip("ID3D11Device1 is not supported.\n");
+        ID3D11Device_Release(device);
+        return;
+    }
+
+    memset(&desc, 0, sizeof(desc));
+    desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    desc.Width = 64;
+    desc.Height = 64;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.SampleDesc.Count = 1;
+    desc.BindFlags = D3D11_BIND_SHADER_RESOURCE;
+    desc.MiscFlags = D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX | D3D11_RESOURCE_MISC_SHARED_NTHANDLE;
+    hr = ID3D11Device_CreateTexture2D(device, &desc, NULL, &tex);
+    ok(hr == S_OK || broken(hr == E_INVALIDARG) /* before Windows 8 */, "Got hr %#lx.\n", hr);
+    if (FAILED(hr))
+    {
+        ID3D11Device1_Release(device1);
+        ID3D11Device_Release(device);
+        return;
+    }
+    hr = ID3D11Texture2D_QueryInterface(tex, &IID_IDXGIResource1, (void **)&res1);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+
+    hr = IDXGIResource1_CreateSharedHandle(res1, NULL, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+            name, &h);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    status = NtQueryObject(h, ObjectTypeInformation, buffer, sizeof(buffer), &len);
+    ok(!status, "Got status %#lx.\n", status);
+    ok(!wcscmp(type->TypeName.Buffer, L"DxgkSharedResource"), "Got type %s.\n",
+            debugstr_w(type->TypeName.Buffer));
+
+    /* Each call gives another handle to the same resource. */
+    hr = IDXGIResource1_CreateSharedHandle(res1, NULL, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+            NULL, &h2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ok(h2 != h, "Got the same handle %p.\n", h);
+    bret = CloseHandle(h2);
+    ok(bret, "Failed to close the handle, error %lu.\n", GetLastError());
+
+    hr = ID3D11Device1_OpenSharedResource1(device1, h, &IID_ID3D11Texture2D, (void **)&tex2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    ID3D11Texture2D_GetDesc(tex2, &desc2);
+    ok(desc2.Width == desc.Width && desc2.Height == desc.Height, "Got size %ux%u.\n", desc2.Width, desc2.Height);
+    ok(desc2.MiscFlags == desc.MiscFlags, "Got flags %#x.\n", desc2.MiscFlags);
+    ID3D11Texture2D_Release(tex2);
+
+    hr = ID3D11Device1_OpenSharedResourceByName(device1, name, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE,
+            &IID_ID3D11Texture2D, (void **)&tex2);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+        ID3D11Texture2D_Release(tex2);
+
+    /* An NT handle is not a global one. */
+    hr = ID3D11Device_OpenSharedResource(device, h, &IID_ID3D11Texture2D, (void **)&tex2);
+    ok(hr == E_INVALIDARG, "Got hr %#lx.\n", hr);
+
+    bret = CloseHandle(h);
+    ok(bret, "Failed to close the handle, error %lu.\n", GetLastError());
+
+    IDXGIResource1_Release(res1);
+    ID3D11Texture2D_Release(tex);
+    ID3D11Device1_Release(device1);
+    ID3D11Device_Release(device);
+}
+
 static void test_keyed_mutex(void)
 {
     IDXGIKeyedMutex *keyed_mutex, *keyed_mutex2;
@@ -35715,7 +35806,7 @@ static void test_keyed_mutex(void)
     }
 
     hr = ID3D11Texture2D_QueryInterface(tex, &IID_IDXGIKeyedMutex, (void **)&keyed_mutex);
-    todo_wine ok(hr == S_OK, "got %#lx.\n", hr);
+    ok(hr == S_OK, "got %#lx.\n", hr);
     if (FAILED(hr))
     {
         ID3D11Texture2D_Release(tex);
@@ -38150,6 +38241,7 @@ START_TEST(d3d11)
     queue_test(test_vertex_formats);
     queue_test(test_dxgi_resources);
     queue_for_each_feature_level(test_shared_resource);
+    queue_test(test_shared_resource_nt_handle);
     queue_test(test_keyed_mutex);
     queue_test(test_clear_during_render);
     queue_test(test_stencil_export);
diff --git a/dlls/d3d11/texture.c b/dlls/d3d11/texture.c
index 1452ee8babc..5639f264254 100644
--- a/dlls/d3d11/texture.c
+++ b/dlls/d3d11/texture.c
@@ -969,6 +969,22 @@ static BOOL validate_texture2d_desc(const D3D11_TEXTURE2D_DESC *desc, D3D_FEATUR
         return FALSE;
     }
 
+    /* A texture is shared one way, plainly or through a keyed mutex; NT
+     * handles are a way of handing out either. */
+    if (desc->MiscFlags & (D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX
+            | D3D11_RESOURCE_MISC_SHARED_NTHANDLE))
+    {
+        unsigned int sharing = desc->MiscFlags
+                & (D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX);
+
+        if (feature_level < D3D_FEATURE_LEVEL_10_0 || (sharing != D3D11_RESOURCE_MISC_SHARED
+                && sharing != D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX))
+        {
+            WARN("Invalid sharing flags in %#x, feature level %#x.\n", desc->MiscFlags, feature_level);
+            return FALSE;
+        }
+    }
+
     return TRUE;
 }
 
@@ -1057,6 +1073,10 @@ HRESULT d3d_texture2d_create(struct d3d_device *device, const D3D11_TEXTURE2D_DE
         wined3d_mutex_unlock();
         return hr;
     }
+    if (!wined3d_texture && (desc->MiscFlags & (D3D11_RESOURCE_MISC_SHARED | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX))
+            && FAILED(hr = wined3d_resource_set_shared(wined3d_texture_get_resource(texture->wined3d_texture),
+            !!(desc->MiscFlags & D3D11_RESOURCE_MISC_SHARED_NTHANDLE))))
+        WARN("Failed to share texture %p, hr %#lx.\n", texture, hr);
     wined3d_mutex_unlock();
 
     ID3D11Device5_AddRef(texture->device = &device->ID3D11Device5_iface);
