+    OBJECT_ATTRIBUTES attr;
+    HANDLE directory;
+    NTSTATUS status;
+
+    TRACE("device %p, name %s, access %#lx.\n", device, debugstr_w(name), access);
+
+    if (BaseGetNamedObjectDirectory(&directory))
+        return NULL;
+    name_str.Buffer = (WCHAR *)name;
+    name_str.Length = wcslen(name) * sizeof(WCHAR);
+    name_str.MaximumLength = name_str.Length + sizeof(WCHAR);
+    InitializeObjectAttributes(&attr, &name_str, 0, directory, NULL);
+    open.dwDesiredAccess = access;
+    open.pObjAttrib = &attr;
+    if ((status = D3DKMTOpenNtHandleFromName(&open)))
+    {
+        WARN("Failed to open %s, status %#lx.\n", debugstr_w(name), status);
+        return NULL;
+    }
+
+    resource = wined3d_resource_from_nt_shared_handle(device, open.hNtHandle);
+    CloseHandle(open.hNtHandle);
+    return resource;
