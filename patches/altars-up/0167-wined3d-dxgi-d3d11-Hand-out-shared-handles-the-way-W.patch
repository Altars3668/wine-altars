diff --git a/dlls/wined3d/resource.c b/dlls/wined3d/resource.c
index f8a3acafd17..891e9bef17e 100644
--- a/dlls/wined3d/resource.c
+++ b/dlls/wined3d/resource.c
@@ -232,10 +232,39 @@ static void wined3d_resource_destroy_object(void *object)
  * A resource created with D3D11_RESOURCE_MISC_SHARED* is handed to another
  * device by handle.  Wine cannot yet share the storage across two
  * wined3d_devices, but the handle has to exist and resolve back to the
- * originating resource before any of that can be built on top, and returning
- * a failure from GetSharedHandle is what stops applications one step earlier
- * than they need to be stopped.  This is the registry, and nothing more: what
- * the opening device does with the resource is its own business. */
+ * originating resource before any of that can be built on top.  This is the
+ * registry, and nothing more: what the opening device does with the resource
+ * is its own business.
+ *
+ * The handles are the ones Windows gives: each shared resource is a D3DKMT
+ * resource, and a resource shared the older way has a global handle that is
+ * not a handle of the process -- CloseHandle() and DuplicateHandle() refuse
+ * it -- while one shared through NT handles gives a new NT handle each time
+ * it is asked, of type DxgkSharedResource.  What the D3DKMT resource carries
+ * is enough to tell it again among this process's resources. */
+
+NTSTATUS WINAPI BaseGetNamedObjectDirectory(HANDLE *dir);
+
+struct wined3d_shared_runtime_data
+{
+    DWORD magic;
+    DWORD pid;
+    UINT64 serial;
+};
+
+#define WINED3D_SHARED_RUNTIME_MAGIC 0x52533357 /* "W3SR" */
+
+struct wined3d_shared_resource
+{
+    struct list entry;
+    struct wined3d_resource *resource;
+    UINT64 serial;
+    BOOL nt_handle;
+    HANDLE handle;
+    D3DKMT_HANDLE kmt_device;
+    D3DKMT_HANDLE kmt_resource;
+    void *memory;
+};
 
 static struct list wined3d_shared_resources = LIST_INIT(wined3d_shared_resources);
 
@@ -251,59 +280,183 @@ static CRITICAL_SECTION_DEBUG wined3d_shared_resources_cs_debug =
 };
 static CRITICAL_SECTION wined3d_shared_resources_cs = {&wined3d_shared_resources_cs_debug, -1, 0, 0, 0, 0};
 
-struct wined3d_shared_resource
+static void wined3d_shared_resource_destroy(struct wined3d_shared_resource *shared)
 {
-    struct list entry;
-    HANDLE handle;
-    struct wined3d_resource *resource;
-};
+    D3DKMT_DESTROYALLOCATION2 destroy_allocation = {0};
+    D3DKMT_DESTROYDEVICE destroy_device = {0};
+
+    if (shared->kmt_resource)
+    {
+        destroy_allocation.hDevice = shared->kmt_device;
+        destroy_allocation.hResource = shared->kmt_resource;
+        D3DKMTDestroyAllocation2(&destroy_allocation);
+    }
+    if (shared->kmt_device)
+    {
+        destroy_device.hDevice = shared->kmt_device;
+        D3DKMTDestroyDevice(&destroy_device);
+    }
+    if (shared->memory)
+        VirtualFree(shared->memory, 0, MEM_RELEASE);
+    free(shared);
+}
+
+HRESULT CDECL wined3d_resource_set_shared(struct wined3d_resource *resource, BOOL nt_handle)
+{
+    D3DKMT_CREATESTANDARDALLOCATION standard = {0};
+    struct wined3d_shared_runtime_data runtime_data;
+    D3DKMT_CREATEALLOCATION create = {0};
+    D3DKMT_CREATEDEVICE create_device = {0};
+    D3DDDI_ALLOCATIONINFO allocation = {0};
+    struct wined3d_shared_resource *shared;
+    static LONG64 serial;
+    NTSTATUS status;
+
+    TRACE("resource %p, nt_handle %#x.\n", resource, nt_handle);
+
+    if (!(shared = calloc(1, sizeof(*shared))))
+        return E_OUTOFMEMORY;
+    shared->resource = resource;
+    shared->serial = InterlockedIncrement64(&serial);
+    shared->nt_handle = nt_handle;
+
+    create_device.hAdapter = resource->device->adapter->kmt_adapter;
+    if ((status = D3DKMTCreateDevice(&create_device)))
+    {
+        WARN("Failed to create a D3DKMT device, status %#lx.\n", status);
+        free(shared);
+        return E_FAIL;
+    }
+    shared->kmt_device = create_device.hDevice;
+
+    /* The D3DKMT resource stands on a page of its own; the pixels are
+     * wined3d's, and are not in it. */
+    if (!(shared->memory = VirtualAlloc(NULL, 0x1000, MEM_COMMIT, PAGE_READWRITE)))
+    {
+        wined3d_shared_resource_destroy(shared);
+        return E_OUTOFMEMORY;
+    }
+    standard.Type = D3DKMT_STANDARDALLOCATIONTYPE_EXISTINGHEAP;
+    standard.ExistingHeapData.Size = 0x1000;
+    allocation.pSystemMem = shared->memory;
+
+    runtime_data.magic = WINED3D_SHARED_RUNTIME_MAGIC;
+    runtime_data.pid = GetCurrentProcessId();
+    runtime_data.serial = shared->serial;
+
+    create.hDevice = shared->kmt_device;
+    create.pPrivateRuntimeData = &runtime_data;
+    create.PrivateRuntimeDataSize = sizeof(runtime_data);
+    create.pStandardAllocation = &standard;
+    create.NumAllocations = 1;
+    create.pAllocationInfo = &allocation;
+    create.Flags.CreateResource = 1;
+    create.Flags.CreateShared = 1;
+    create.Flags.NtSecuritySharing = !!nt_handle;
+    create.Flags.StandardAllocation = 1;
+    create.Flags.ExistingSysMem = 1;
+    if ((status = D3DKMTCreateAllocation2(&create)))
+    {
+        WARN("Failed to create a shared D3DKMT resource, status %#lx.\n", status);
+        wined3d_shared_resource_destroy(shared);
