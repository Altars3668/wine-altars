@@ -4791,13 +4781,17 @@ HRESULT d3d_device_open_shared_resource(struct d3d_device *device, HANDLE handle
      * the keyed mutex handoff. */
     desc = owner->desc;
     /* The opener's copy is never the one GDI draws into, and asking for a
-     * GDI-compatible texture here wedges Word before its main window appears. */
-    desc.MiscFlags &= ~D3D11_RESOURCE_MISC_GDI_COMPATIBLE;
+     * GDI-compatible texture here wedges Word before its main window appears.
+     * Nor is it shared a second time: it is the owner's resource, as far as
+     * the application can tell, and it says it is shared the way that is. */
+    desc.MiscFlags &= ~(D3D11_RESOURCE_MISC_GDI_COMPATIBLE | D3D11_RESOURCE_MISC_SHARED
+            | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX | D3D11_RESOURCE_MISC_SHARED_NTHANDLE);
     if (FAILED(hr = d3d_texture2d_create(device, &desc, NULL, NULL, &texture)))
     {
         WARN("Failed to create a texture for shared handle %p, hr %#lx.\n", handle, hr);
         return hr;
     }
+    texture->desc.MiscFlags = owner->desc.MiscFlags & ~D3D11_RESOURCE_MISC_GDI_COMPATIBLE;
 
     if (FAILED(hr = d3d_shared_surface_attach(owner, texture)))
     {
@@ -4814,6 +4808,42 @@ HRESULT d3d_device_open_shared_resource(struct d3d_device *device, HANDLE handle
     return hr;
 }
 
+/* A global handle, as GetSharedHandle gives; not an NT handle. */
+HRESULT d3d_device_open_shared_resource(struct d3d_device *device, HANDLE handle, REFIID iid, void **out)
+{
+    struct wined3d_resource *wined3d_resource;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!(wined3d_resource = wined3d_resource_from_shared_handle(handle)))
+    {
+        WARN("Unknown shared handle %p.\n", handle);
+        return E_INVALIDARG;
+    }
+
+    return d3d_device_open_wined3d_resource(device, wined3d_resource, handle, iid, out);
+}
+
+/* An NT handle, as CreateSharedHandle gives; not a global one. */
+static HRESULT d3d_device_open_shared_resource_nt(struct d3d_device *device, HANDLE handle, REFIID iid, void **out)
+{
+    struct wined3d_resource *wined3d_resource;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!(wined3d_resource = wined3d_resource_from_nt_shared_handle(device->wined3d_device, handle)))
+    {
+        WARN("Unknown shared NT handle %p.\n", handle);
+        return E_INVALIDARG;
+    }
+
+    return d3d_device_open_wined3d_resource(device, wined3d_resource, handle, iid, out);
+}
+
 static HRESULT STDMETHODCALLTYPE d3d11_device_OpenSharedResource(ID3D11Device5 *iface, HANDLE resource, REFIID iid,
         void **out)
 {
@@ -5464,18 +5494,33 @@ fail:
 static HRESULT STDMETHODCALLTYPE d3d11_device_OpenSharedResource1(ID3D11Device5 *iface, HANDLE handle,
         REFIID iid, void **resource)
 {
-    FIXME("iface %p, handle %p, iid %s, resource %p stub!\n", iface, handle, debugstr_guid(iid), resource);
+    struct d3d_device *device = impl_from_ID3D11Device5(iface);
 
-    return E_NOTIMPL;
+    TRACE("iface %p, handle %p, iid %s, resource %p.\n", iface, handle, debugstr_guid(iid), resource);
+
+    return d3d_device_open_shared_resource_nt(device, handle, iid, resource);
 }
 
 static HRESULT STDMETHODCALLTYPE d3d11_device_OpenSharedResourceByName(ID3D11Device5 *iface, const WCHAR *name,
         DWORD access, REFIID iid, void **resource)
 {
-    FIXME("iface %p, name %s, access %#lx, iid %s, resource %p stub!\n", iface, debugstr_w(name), access,
+    struct d3d_device *device = impl_from_ID3D11Device5(iface);
+    struct wined3d_resource *wined3d_resource;
+
+    TRACE("iface %p, name %s, access %#lx, iid %s, resource %p.\n", iface, debugstr_w(name), access,
             debugstr_guid(iid), resource);
 
-    return E_NOTIMPL;
+    if (!resource)
+        return E_INVALIDARG;
+    *resource = NULL;
+
+    if (!name || !(wined3d_resource = wined3d_resource_from_shared_name(device->wined3d_device, name, access)))
+    {
+        WARN("Unknown shared resource name %s.\n", debugstr_w(name));
+        return E_INVALIDARG;
+    }
+
+    return d3d_device_open_wined3d_resource(device, wined3d_resource, NULL, iid, resource);
 }
 
