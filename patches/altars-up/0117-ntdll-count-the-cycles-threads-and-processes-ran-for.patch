+/* the time the threads of a process ran for, kernel and user; of this one to the microsecond, of others as
+ * finely as the system says, of one that is gone not at all */
+static void get_process_cpu_times( int unix_pid, LARGE_INTEGER *kernel, LARGE_INTEGER *user )
+{
+#ifdef HAVE_SYS_RESOURCE_H
+    struct rusage usage;
+#endif
+
+    kernel->QuadPart = user->QuadPart = 0;
+    if (unix_pid == -1) return;
+#ifdef HAVE_SYS_RESOURCE_H
+    if (unix_pid == getpid() && !getrusage( RUSAGE_SELF, &usage ))
+    {
+        kernel->QuadPart = (ULONGLONG)usage.ru_stime.tv_sec * 10000000 + usage.ru_stime.tv_usec * 10;
+        user->QuadPart = (ULONGLONG)usage.ru_utime.tv_sec * 10000000 + usage.ru_utime.tv_usec * 10;
+        return;
+    }
+#endif
+    get_thread_times( unix_pid, -1, kernel, user );
+}
+
+/* the time the threads of a process ran for, in nanoseconds, as finely as the system counts it */
+static NTSTATUS get_process_cpu_time( HANDLE handle, ULONGLONG *ns )
+{
+    LARGE_INTEGER kernel, user;
+    struct timespec ts;
+    int unix_pid = -1;
+    NTSTATUS status;
+    clockid_t clock;
+
+    if (handle == NtCurrentProcess() && !clock_gettime( CLOCK_PROCESS_CPUTIME_ID, &ts ))
+    {
+        *ns = ts.tv_sec * 1000000000ull + ts.tv_nsec;
+        return STATUS_SUCCESS;
+    }
+
+    SERVER_START_REQ( get_process_times )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        if (!(status = wine_server_call( req ))) unix_pid = reply->unix_pid;
+    }
+    SERVER_END_REQ;
+    if (status) return status;
+
+    *ns = 0;
+    if (unix_pid == -1) return STATUS_SUCCESS;
+    if (unix_pid == getpid()) clock = CLOCK_PROCESS_CPUTIME_ID;
+#ifdef linux
+    else if (clock_getcpuclockid( unix_pid, &clock )) clock = -1;
+#else
+    else clock = -1;
+#endif
+    if (clock != -1 && !clock_gettime( clock, &ts )) *ns = ts.tv_sec * 1000000000ull + ts.tv_nsec;
+    else
+    {
+        get_process_cpu_times( unix_pid, &kernel, &user );
+        *ns = (kernel.QuadPart + user.QuadPart) * 100;
+    }
+    return STATUS_SUCCESS;
+}
