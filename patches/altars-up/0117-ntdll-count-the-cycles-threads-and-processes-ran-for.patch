diff --git a/dlls/ntdll/unix/thread.c b/dlls/ntdll/unix/thread.c
index d5a5f57c8aa..d2cdb127ada 100644
--- a/dlls/ntdll/unix/thread.c
+++ b/dlls/ntdll/unix/thread.c
@@ -2054,6 +2054,58 @@ BOOL get_thread_times(int unix_pid, int unix_tid, LARGE_INTEGER *kernel_time, LA
 #endif
 }
 
+/* the time a thread ran for, in nanoseconds, as finely as the system counts it */
+static NTSTATUS get_thread_cpu_time( HANDLE handle, ULONGLONG *ns )
+{
+    LARGE_INTEGER kernel, user;
+    int unix_pid = -1, unix_tid = -1;
+    struct timespec ts;
+    NTSTATUS status;
+#ifdef linux
+    unsigned long long run;
+    char path[64];
+    FILE *f;
+#endif
+
+    if (handle == GetCurrentThread() && !clock_gettime( CLOCK_THREAD_CPUTIME_ID, &ts ))
+    {
+        *ns = ts.tv_sec * 1000000000ull + ts.tv_nsec;
+        return STATUS_SUCCESS;
+    }
+
+    SERVER_START_REQ( get_thread_times )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        if (!(status = wine_server_call( req )))
+        {
+            unix_pid = reply->unix_pid;
+            unix_tid = reply->unix_tid;
+        }
+    }
+    SERVER_END_REQ;
+    if (status) return status;
+
+    *ns = 0;
+    if (unix_pid == -1 || unix_tid == -1) return STATUS_SUCCESS;
+#ifdef linux
+    /* the scheduler counts it in nanoseconds */
+    snprintf( path, sizeof(path), "/proc/%u/task/%u/schedstat", unix_pid, unix_tid );
+    if ((f = fopen( path, "r" )))
+    {
+        BOOL found = fscanf( f, "%llu", &run ) == 1;
+
+        fclose( f );
+        if (found)
+        {
+            *ns = run;
+            return STATUS_SUCCESS;
+        }
+    }
+#endif
+    if (get_thread_times( unix_pid, unix_tid, &kernel, &user )) *ns = (kernel.QuadPart + user.QuadPart) * 100;
+    return STATUS_SUCCESS;
+}
