diff --git a/dlls/ntdll/unix/system.c b/dlls/ntdll/unix/system.c
index aaae9a2fd8e..3eee65e6036 100644
--- a/dlls/ntdll/unix/system.c
+++ b/dlls/ntdll/unix/system.c
@@ -4371,6 +4371,64 @@ static ULONG mhz_from_cpuinfo(void)
     return cmz;
 }
 
+/* the time stamp counter, which Windows counts the cycles a thread runs for in */
+ULONGLONG current_cycle_count(void)
+{
+#if defined(__i386__) || defined(__x86_64__)
+    return __builtin_ia32_rdtsc();
+#else
+    return 0;
+#endif
+}
+
+/* the rate the time stamp counter runs at: timed against the clock where there is one to read, else what the
+ * processor is rated for, else 1GHz */
+static ULONGLONG cycle_rate(void)
+{
+    static ULONGLONG hz;
+
+    if (!hz)
+    {
+        ULONGLONG rate = 0;
+#if defined(__i386__) || defined(__x86_64__)
+        struct timespec start, now;
+        ULONGLONG begin, ns = 0;
+
+        clock_gettime( CLOCK_MONOTONIC, &start );
+        begin = current_cycle_count();
+        while (ns < 2000000)
+        {
+            clock_gettime( CLOCK_MONOTONIC, &now );
+            ns = (now.tv_sec - start.tv_sec) * 1000000000ull + now.tv_nsec - start.tv_nsec;
+        }
+        rate = (current_cycle_count() - begin) * 1000000000 / ns;
+#elif defined(linux)
+        unsigned long long khz = 0;
+        FILE *f;
+
+        if ((f = fopen( "/sys/devices/system/cpu/cpu0/cpufreq/cpuinfo_max_freq", "r" )))
+        {
+            if (fscanf( f, "%llu", &khz ) != 1) khz = 0;
+            fclose( f );
+        }
+        if (!khz) khz = (ULONGLONG)mhz_from_cpuinfo() * 1000;
+        rate = khz * 1000;
+#endif
+        hz = rate ? rate : 1000000000;
+        TRACE( "%s cycles a second\n", wine_dbgstr_longlong( hz ));
+    }
+    return hz;
+}
+
+/* the cycles the time stamp counter runs through in a stretch of time given in nanoseconds; the cycle times
+ * Windows keeps are the cycles a thread or a process ran for */
+ULONGLONG cycles_from_ns( ULONGLONG ns )
+{
+    ULONGLONG hz = cycle_rate();
+
+    return ns / 1000000000 * hz + ns % 1000000000 * hz / 1000000000;
+}
