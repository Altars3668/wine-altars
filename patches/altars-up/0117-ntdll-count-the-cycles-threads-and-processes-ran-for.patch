+static volatile LONG cycle_spin_stop;
+
+static DWORD WINAPI cycle_spin_thread( void *arg )
+{
+    while (!cycle_spin_stop) YieldProcessor();
+    return 0;
+}
+
+static DWORD WINAPI cycle_sleep_thread( void *arg )
+{
+    WaitForSingleObject( arg, INFINITE );
+    return 0;
+}
+
+static void test_cycle_time( char **argv )
+{
+    THREAD_CYCLE_TIME_INFORMATION spinning, sleeping, thread1, thread2;
+    PROCESS_CYCLE_TIME_INFORMATION process, other;
+    STARTUPINFOA si = { sizeof(si) };
+    KERNEL_USER_TIMES self, child;
+    char cmdline[MAX_PATH + 32];
+    HANDLE spinner, sleeper, event;
+    PROCESS_INFORMATION pi;
+    NTSTATUS status;
+    DWORD start;
+    ULONG len;
+    BOOL ret;
+
+    /* counted as finely as the time stamp counter, so that no two queries give the same count */
+    status = pNtQueryInformationThread( GetCurrentThread(), ThreadCycleTime, &thread1, sizeof(thread1), &len );
+    ok( !status, "got %#lx\n", status );
+    ok( len == sizeof(thread1), "got %lu\n", len );
+    status = pNtQueryInformationThread( GetCurrentThread(), ThreadCycleTime, &thread2, sizeof(thread2), NULL );
+    ok( !status, "got %#lx\n", status );
+    ok( thread2.AccumulatedCycles > thread1.AccumulatedCycles, "the cycles did not grow\n" );
+    ok( thread1.CurrentCycleCount, "got no current count\n" );
+    status = pNtQueryInformationThread( GetCurrentThread(), ThreadCycleTime, &thread1, sizeof(ULONGLONG), NULL );
+    ok( status == STATUS_INFO_LENGTH_MISMATCH, "got %#lx\n", status );
+
+    status = pNtQueryInformationProcess( GetCurrentProcess(), ProcessCycleTime, &process, sizeof(process), &len );
+    ok( !status, "got %#lx\n", status );
+    ok( len == sizeof(process), "got %lu\n", len );
+    ok( process.AccumulatedCycles >= thread2.AccumulatedCycles, "the process ran for fewer cycles than a thread\n" );
+
+    /* a thread that runs runs for more cycles than one that waits */
+    event = CreateEventA( NULL, TRUE, FALSE, NULL );
+    cycle_spin_stop = 0;
+    spinner = CreateThread( NULL, 0, cycle_spin_thread, NULL, 0, NULL );
+    sleeper = CreateThread( NULL, 0, cycle_sleep_thread, event, 0, NULL );
+    Sleep( 300 );
+    status = pNtQueryInformationThread( spinner, ThreadCycleTime, &spinning, sizeof(spinning), NULL );
+    ok( !status, "got %#lx\n", status );
+    status = pNtQueryInformationThread( sleeper, ThreadCycleTime, &sleeping, sizeof(sleeping), NULL );
+    ok( !status, "got %#lx\n", status );
+    ok( spinning.AccumulatedCycles > sleeping.AccumulatedCycles * 10, "spinning %s, sleeping %s\n",
+        wine_dbgstr_longlong( spinning.AccumulatedCycles ), wine_dbgstr_longlong( sleeping.AccumulatedCycles ));
+    cycle_spin_stop = 1;
+    SetEvent( event );
+    WaitForSingleObject( spinner, INFINITE );
+    WaitForSingleObject( sleeper, INFINITE );
+    CloseHandle( spinner );
+    CloseHandle( sleeper );
+    CloseHandle( event );
+
+    /* another process's time is its own */
+    sprintf( cmdline, "\"%s\" info sleep", argv[0] );
+    ret = CreateProcessA( NULL, cmdline, NULL, NULL, FALSE, 0, NULL, NULL, &si, &pi );
+    ok( ret, "CreateProcess failed, error %lu\n", GetLastError() );
+    Sleep( 500 );
+    start = GetTickCount();
+    while (GetTickCount() - start < 500) YieldProcessor();
+    status = pNtQueryInformationProcess( pi.hProcess, ProcessTimes, &child, sizeof(child), NULL );
+    ok( !status, "got %#lx\n", status );
+    status = pNtQueryInformationProcess( GetCurrentProcess(), ProcessTimes, &self, sizeof(self), NULL );
+    ok( !status, "got %#lx\n", status );
+    ok( child.UserTime.QuadPart < self.UserTime.QuadPart, "child %s, this one %s\n",
+        wine_dbgstr_longlong( child.UserTime.QuadPart ), wine_dbgstr_longlong( self.UserTime.QuadPart ));
+    ok( child.CreateTime.QuadPart > self.CreateTime.QuadPart, "the child was made first\n" );
+    status = pNtQueryInformationProcess( pi.hProcess, ProcessCycleTime, &other, sizeof(other), NULL );
+    ok( !status, "got %#lx\n", status );
+    status = pNtQueryInformationProcess( GetCurrentProcess(), ProcessCycleTime, &process, sizeof(process), NULL );
+    ok( !status, "got %#lx\n", status );
+    ok( other.AccumulatedCycles < process.AccumulatedCycles, "child %s, this one %s\n",
+        wine_dbgstr_longlong( other.AccumulatedCycles ), wine_dbgstr_longlong( process.AccumulatedCycles ));
+    TerminateProcess( pi.hProcess, 0 );
+    WaitForSingleObject( pi.hProcess, INFINITE );
+    CloseHandle( pi.hProcess );
+    CloseHandle( pi.hThread );
+}
