+static BOOL json_object_changed_since( struct json_object *object, LONG version )
+{
+    return ReadNoFence( &object->version ) != version;
+}
+
+static void json_object_hold( struct json_object *object )
+{
+    IJsonObject_AddRef( &object->IJsonObject_iface );
+}
+
+static void json_object_unhold( struct json_object *object )
+{
+    IJsonObject_Release( &object->IJsonObject_iface );
+}
+
+/* where in impl->sorted the member of that name is, or would go; TRUE when it is there */
+static BOOL json_object_find( struct json_object *impl, HSTRING name, UINT32 *pos )
+{
+    UINT32 low = 0, high = impl->count;
+
+    while (low < high)
+    {
+        UINT32 mid = low + (high - low) / 2;
+        INT32 order;
+
+        WindowsCompareStringOrdinal( impl->members[impl->sorted[mid]].name, name, &order );
+        if (!order)
+        {
+            *pos = mid;
+            return TRUE;
+        }
+        if (order < 0) low = mid + 1;
+        else high = mid;
+    }
+    *pos = low;
+    return FALSE;
+}
+
+static void json_object_changed( struct json_object *impl )
+{
+    WriteNoFence( &impl->version, impl->version + 1 );
+}
+
 /* the value of that name, with a reference */
 static BOOL json_object_lookup( struct json_object *impl, HSTRING name, IJsonValue **value )
 {
-    UINT32 index;
+    UINT32 pos;
     BOOL found;
 
     AcquireSRWLockShared( &impl->lock );
-    if ((found = json_members_find( impl->members, impl->count, name, &index )))
-        IJsonValue_AddRef( (*value = impl->members[index].value) );
+    if ((found = json_object_find( impl, name, &pos )))
+        IJsonValue_AddRef( (*value = impl->members[impl->sorted[pos]].value) );
     ReleaseSRWLockShared( &impl->lock );
     return found;
 }
 
+static BOOL json_object_grow( struct json_object *impl )
+{
+    UINT32 capacity = max( 8, impl->capacity * 2 ), *sorted;
+    struct json_member *members;
+
+    if (!(members = realloc( impl->members, capacity * sizeof(*members) ))) return FALSE;
+    impl->members = members;
+    if (!(sorted = realloc( impl->sorted, capacity * sizeof(*sorted) ))) return FALSE;
+    impl->sorted = sorted;
+    impl->capacity = capacity;
+    return TRUE;
+}
