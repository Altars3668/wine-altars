From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Thu, 1 Oct 2026 09:08:04 -0400
Subject: [PATCH] win32u: Treat the processes of session 0 as services.

Since Windows Vista session 0 runs services only and is never shown.  Its WinSta0 is not the one on
the screen, which the server takes the first visible window station for, and its processes get the
virtual monitor of a service and no desktop process of their own rather than reading the display
configuration through a driver they do not have and writing it back.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/win32u/sysparams.c b/dlls/win32u/sysparams.c
index 22283a2cc57..c0708487350 100644
--- a/dlls/win32u/sysparams.c
+++ b/dlls/win32u/sysparams.c
@@ -3226,8 +3226,6 @@ static BOOL request_display_update(void)
 
 static BOOL lock_display_devices( BOOL force )
 {
-    static const WCHAR wine_service_station_name[] =
-        {'_','_','w','i','n','e','s','e','r','v','i','c','e','_','w','i','n','s','t','a','t','i','o','n',0};
     struct device_manager_ctx ctx =
     {
         .opengl_gpus = LIST_INIT(ctx.opengl_gpus),
@@ -3235,7 +3233,6 @@ static BOOL lock_display_devices( BOOL force )
     };
     UINT64 serial;
     UINT status;
-    WCHAR name[MAX_PATH];
     BOOL ret = TRUE;
 
     init_display_driver(); /* make sure to load the driver before anything else */
@@ -3246,8 +3243,7 @@ static BOOL lock_display_devices( BOOL force )
     if (!force && monitor_update_serial >= serial) return TRUE;
 
     /* services do not have any adapters, only a virtual monitor */
-    if (NtUserGetObjectInformation( NtUserGetProcessWindowStation(), UOI_NAME, name, sizeof(name), NULL )
-        && !wcscmp( name, wine_service_station_name ))
+    if (is_service_process())
     {
         clear_display_devices();
         list_add_tail( &monitors, &virtual_monitor.entry );
diff --git a/dlls/win32u/winstation.c b/dlls/win32u/winstation.c
index 3c55a80c5e1..4ef0049a272 100644
--- a/dlls/win32u/winstation.c
+++ b/dlls/win32u/winstation.c
@@ -348,11 +348,14 @@ BOOL is_virtual_desktop(void)
     return ret;
 }
 
+/* a process with no display: a service on its window station, or any process of session 0, which since
+ * Windows Vista runs services only and is never shown */
 BOOL is_service_process(void)
 {
     static const WCHAR wine_service_station_name[] = {'_','_','w','i','n','e','s','e','r','v','i','c','e','_','w','i','n','s','t','a','t','i','o','n',0};
     WCHAR name[MAX_PATH];
 
+    if (!RtlGetCurrentPeb()->SessionId) return TRUE;
     return NtUserGetObjectInformation( NtUserGetProcessWindowStation(), UOI_NAME, name, sizeof(name), NULL ) &&
            !wcscmp( name, wine_service_station_name );
 }
@@ -1023,8 +1026,8 @@ void winstation_init(void)
         if (handle)
         {
             NtUserSetProcessWindowStation( handle );
-            /* only WinSta0 is visible */
-            if (!winstation || !wcsicmp( winstation, winsta0 ))
+            /* only WinSta0 is visible, and not that of session 0, the services' session */
+            if ((!winstation || !wcsicmp( winstation, winsta0 )) && RtlGetCurrentPeb()->SessionId)
             {
                 USEROBJECTFLAGS flags;
                 flags.fInherit  = FALSE;
