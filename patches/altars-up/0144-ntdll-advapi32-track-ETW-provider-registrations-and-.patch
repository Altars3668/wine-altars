+static ULONG WINAPI trace_control_callback(WMIDPREQUESTCODE code, void *context, ULONG *size, void *buffer)
+{
+    ok(0, "unexpected control callback %d\n", code);
+    return 0;
+}
+
+static void WINAPI enable_callback(const GUID *source, ULONG code, UCHAR level, ULONGLONG any, ULONGLONG all,
+                                   EVENT_FILTER_DESCRIPTOR *filter, void *context)
+{
+    ok(0, "unexpected enable callback %lu\n", code);
+}
+
+static void test_event_provider(void)
+{
+    static const GUID provider = {0x1d6b6bd2, 0x1e7c, 0x4e46, {0x8a, 0x1d, 0x6f, 0x3e, 0x57, 0x81, 0x9c, 0x31}};
+    static const GUID class1 = {0x3d6b6bd2, 0x1e7c, 0x4e46, {0x8a, 0x1d, 0x6f, 0x3e, 0x57, 0x81, 0x9c, 0x31}};
+    static const GUID class2 = {0x4d6b6bd2, 0x1e7c, 0x4e46, {0x8a, 0x1d, 0x6f, 0x3e, 0x57, 0x81, 0x9c, 0x31}};
+    TRACE_GUID_REGISTRATION classes[2] = {{&class1, NULL}, {&class2, NULL}};
+    EVENT_DESCRIPTOR descriptor = {0};
+    REGHANDLE handle, handle2;
+    TRACEHANDLE trace_handle;
+    BYTE traits[64];
+    BOOLEAN value;
+    ULONG ret;
+
+    /* no session listens here: registrations, and events that go nowhere */
+    ret = EventRegister(&provider, enable_callback, NULL, &handle);
+    ok(!ret, "got %lu\n", ret);
+    ret = EventRegister(&provider, NULL, NULL, &handle2);
+    ok(!ret && handle2 != handle, "got %lu\n", ret);
+    ok(!EventEnabled(handle, &descriptor), "enabled\n");
+    ok(!EventProviderEnabled(handle, 5, ~(ULONGLONG)0), "enabled\n");
+    ret = EventWrite(handle, &descriptor, 0, NULL);
+    ok(!ret, "got %lu\n", ret);
+
+    ret = EventSetInformation(handle, EventProviderBinaryTrackInfo, NULL, 0);
+    ok(!ret, "got %lu\n", ret);
+    ret = EventSetInformation(handle, EventProviderBinaryTrackInfo, traits, 4);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = EventSetInformation(handle, EventProviderSetReserved1, NULL, 0);
+    ok(ret == ERROR_NOT_SUPPORTED, "got %lu\n", ret);
+    value = TRUE;
+    ret = EventSetInformation(handle, EventProviderUseDescriptorType, &value, sizeof(value));
+    ok(!ret, "got %lu\n", ret);
+    ret = EventSetInformation(handle, EventProviderUseDescriptorType, &value, sizeof(ULONG));
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = EventSetInformation(handle, 99, traits, 4);
+    ok(ret == ERROR_NOT_SUPPORTED, "got %lu\n", ret);
+
+    /* traits: their size, the name, and traits of a size, a type and data; set once */
+    memset(traits, 0, sizeof(traits));
+    *(USHORT *)traits = 2 + 9 + 2;
+    memcpy(traits + 2, "Provider", 9);
+    *(USHORT *)(traits + 11) = 2;
+    ret = EventSetInformation(handle, EventProviderSetTraits, traits, 13);
+    ok(ret == ERROR_FILE_CORRUPT, "got %lu\n", ret);
+    ret = EventSetInformation(handle, EventProviderSetTraits, traits, 12);
+    ok(ret == ERROR_FILE_CORRUPT, "got %lu\n", ret);
+    ret = EventSetInformation(handle, EventProviderSetTraits, NULL, 13);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = EventSetInformation(handle, EventProviderSetTraits, traits, 2);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    *(USHORT *)traits = 2 + 9 + 19;
+    *(USHORT *)(traits + 11) = 19;
+    traits[13] = 1;
+    ret = EventSetInformation(handle, EventProviderSetTraits, traits, 30);
+    ok(!ret, "got %lu\n", ret);
+    ret = EventSetInformation(handle, EventProviderSetTraits, traits, 30);
+    ok(ret == ERROR_GEN_FAILURE, "got %lu\n", ret);
+    *(USHORT *)traits = 2 + 9;
+    ret = EventSetInformation(handle2, EventProviderSetTraits, traits, 11);
+    ok(!ret, "got %lu\n", ret);
+
+    ret = EventUnregister(handle2);
+    ok(!ret, "got %lu\n", ret);
+    ret = EventUnregister(handle);
+    ok(!ret, "got %lu\n", ret);
+    ret = EventUnregister(handle);
+    ok(ret == ERROR_INVALID_HANDLE, "got %lu\n", ret);
+    ret = EventWrite(handle, &descriptor, 0, NULL);
+    ok(ret == ERROR_INVALID_HANDLE, "got %lu\n", ret);
+    ret = EventSetInformation(handle, EventProviderSetTraits, traits, 11);
+    ok(ret == ERROR_INVALID_HANDLE, "got %lu\n", ret);
+
+    /* and classic providers */
+    ret = RegisterTraceGuidsW(trace_control_callback, NULL, &provider, 2, classes, NULL, NULL, &trace_handle);
+    ok(!ret, "got %lu\n", ret);
+    ok(classes[0].RegHandle && classes[1].RegHandle, "got %p %p\n", classes[0].RegHandle, classes[1].RegHandle);
+    /* GetTraceEnableFlags takes a logger handle from the control callback, not this registration handle. */
+    ret = UnregisterTraceGuids(trace_handle);
+    ok(!ret, "got %lu\n", ret);
+    ret = UnregisterTraceGuids(trace_handle);
+    ok(ret == ERROR_INVALID_HANDLE, "got %lu\n", ret);
+    ret = RegisterTraceGuidsW(NULL, NULL, &provider, 2, classes, NULL, NULL, &trace_handle);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = RegisterTraceGuidsW(trace_control_callback, NULL, NULL, 2, classes, NULL, NULL, &trace_handle);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = RegisterTraceGuidsW(trace_control_callback, NULL, &provider, 2, classes, NULL, NULL, NULL);
+    ok(ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret);
+    ret = RegisterTraceGuidsW(trace_control_callback, NULL, &provider, 0, NULL, NULL, NULL, &trace_handle);
+    ok(!ret, "got %lu\n", ret);
+    ret = UnregisterTraceGuids(trace_handle);
+    ok(!ret, "got %lu\n", ret);
+}
