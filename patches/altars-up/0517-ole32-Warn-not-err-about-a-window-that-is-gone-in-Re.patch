From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 3 Oct 2026 00:31:35 -0400
Subject: [PATCH] ole32: Warn, not err, about a window that is gone in
 RegisterDragDrop and RevokeDragDrop.

PowerPoint revokes its drop targets after their windows are destroyed.
Windows 11 answers DRAGDROP_E_INVALIDHWND as Wine does, and keeps the
target's reference as Wine does (tools/startupgapsprobe oledead); it is
not an error of ours.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ole32/ole2.c b/dlls/ole32/ole2.c
index 432b6c990dd..bb137033e9f 100644
--- a/dlls/ole32/ole2.c
+++ b/dlls/ole32/ole2.c
@@ -559,7 +559,7 @@ HRESULT WINAPI RegisterDragDrop(HWND hwnd, LPDROPTARGET pDropTarget)
 
   if (!IsWindow(hwnd))
   {
-    ERR("invalid hwnd %p\n", hwnd);
+    WARN("invalid hwnd %p\n", hwnd);
     return DRAGDROP_E_INVALIDHWND;
   }
 
@@ -637,7 +637,7 @@ HRESULT WINAPI RevokeDragDrop(HWND hwnd)
 
   if (!IsWindow(hwnd))
   {
-    ERR("invalid hwnd %p\n", hwnd);
+    WARN("invalid hwnd %p\n", hwnd);
     return DRAGDROP_E_INVALIDHWND;
   }
 
