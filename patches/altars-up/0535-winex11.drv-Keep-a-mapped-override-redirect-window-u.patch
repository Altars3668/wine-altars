From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 01:24:00 -0400
Subject: [PATCH] winex11.drv: Keep a mapped override-redirect window unmanaged
 when it is only activated.

A popup shown with SWP_NOACTIVATE is mapped override-redirect. When the
application activates it afterwards, ActivateWindow gives it the X input
focus, but the next SetWindowPos found it active and made it managed,
which unmaps and remaps it. The window manager moves the focus to one of
its own windows in between, focus_out sets the foreground to the desktop,
and the window loses the activation it was just given.

Office shows its title bar status flyout and its dropdowns this way and
closes them as soon as they are deactivated, so under mutter about half of
them closed again within 30 ms of appearing. Keep such a window unmanaged
until it is hidden, unless its style requires a managed window anyway.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/winex11.drv/window.c b/dlls/winex11.drv/window.c
index 0f32c381098..3beb66768d6 100644
--- a/dlls/winex11.drv/window.c
+++ b/dlls/winex11.drv/window.c
@@ -430,23 +430,11 @@ static struct x11drv_win_data *alloc_win_data( Display *display, HWND hwnd )
 }
 
 
-/***********************************************************************
- *		is_window_managed
- *
- * Check if a given window should be managed
- */
-static BOOL is_window_managed( HWND hwnd, UINT swp_flags, BOOL fullscreen )
+/* check if a window should be managed for another reason than being activated */
+static BOOL is_window_managed_inactive( HWND hwnd, DWORD style, BOOL fullscreen )
 {
-    DWORD style, ex_style;
-
-    if (!managed_mode) return FALSE;
+    DWORD ex_style;
 
-    /* child windows are not managed */
-    style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
-    if ((style & (WS_CHILD|WS_POPUP)) == WS_CHILD) return FALSE;
-    /* activated windows are managed */
-    if (!(swp_flags & (SWP_NOACTIVATE|SWP_HIDEWINDOW))) return TRUE;
-    if (hwnd == get_active_window()) return TRUE;
     /* windows with caption are managed */
     if ((style & WS_CAPTION) == WS_CAPTION) return TRUE;
     /* windows with thick frame are managed */
@@ -467,6 +455,26 @@ static BOOL is_window_managed( HWND hwnd, UINT swp_flags, BOOL fullscreen )
     return FALSE;
 }
 
+/***********************************************************************
+ *		is_window_managed
+ *
+ * Check if a given window should be managed
+ */
+static BOOL is_window_managed( HWND hwnd, UINT swp_flags, BOOL fullscreen )
+{
+    DWORD style;
+
+    if (!managed_mode) return FALSE;
+
+    /* child windows are not managed */
+    style = NtUserGetWindowLongW( hwnd, GWL_STYLE );
+    if ((style & (WS_CHILD|WS_POPUP)) == WS_CHILD) return FALSE;
+    /* activated windows are managed */
+    if (!(swp_flags & (SWP_NOACTIVATE|SWP_HIDEWINDOW))) return TRUE;
+    if (hwnd == get_active_window()) return TRUE;
+    return is_window_managed_inactive( hwnd, style, fullscreen );
+}
+
 
 /***********************************************************************
  *              get_satellite_anchor
@@ -3396,6 +3404,21 @@ static BOOL get_desired_wm_state( DWORD style, const struct window_rects *rects
 }
 
 
+/* check if a window is mapped, or about to be, as an override-redirect window */
+static BOOL is_mapped_unmanaged( HWND hwnd )
+{
+    struct x11drv_win_data *data;
+    BOOL ret = FALSE;
+
+    if ((data = get_win_data( hwnd )))
+    {
+        ret = data->whole_window && !data->managed && !data->embedded &&
+              data->desired_state.wm_state != WithdrawnState;
+        release_win_data( data );
+    }
+    return ret;
+}
+
 /***********************************************************************
  *		WindowPosChanged   (X11DRV.@)
  */
@@ -3409,7 +3432,16 @@ void X11DRV_WindowPosChanged( HWND hwnd, HWND insert_after, HWND owner_hint, UIN
     HWND anchor = get_satellite_anchor( hwnd, insert_after, swp_flags, new_style, ex_style );
     UINT wm_state;
 
-    if ((is_managed = anchor || is_window_managed( hwnd, swp_flags, fullscreen ))) make_owner_managed( hwnd );
+    is_managed = anchor || is_window_managed( hwnd, swp_flags, fullscreen );
+    /* A popup shown without being activated is mapped override-redirect.  Making it managed
+     * because it was activated afterwards would unmap and remap it: the window manager moves the
+     * focus elsewhere in between, the window loses the activation it was just given, and Office
+     * closes its flyouts and dropdowns on that.  ActivateWindow has given such a window the X
+     * focus already, so it stays unmanaged until it is hidden. */
+    if (is_managed && !anchor && is_mapped_unmanaged( hwnd ) &&
+        !is_window_managed_inactive( hwnd, new_style, fullscreen ))
+        is_managed = FALSE;
+    if (is_managed) make_owner_managed( hwnd );
 
     if (!(data = get_win_data( hwnd ))) return;
     if (anchor && data->anchor != anchor)
