From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 10:34:06 -0400
Subject: [PATCH] include: add the file information structures of Windows 8 and
 10.

FILE_STORAGE_INFO, FILE_ALIGNMENT_INFO, FILE_ID_INFO and
FILE_CASE_SENSITIVE_INFO to winbase.h, FILE_FS_SECTOR_SIZE_INFORMATION and
the SSINFO flags to winioctl.h, FILE_CASE_SENSITIVE_INFORMATION to
winternl.h, and FILE_CS_FLAG_CASE_SENSITIVE_DIR to winnt.h.  FILE_ID_128
moves to winnt.h, where the SDK has it, for FILE_ID_INFO to use.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 2cacc7037b36bed5825fc34db29658720726d8d4)

diff --git a/include/winbase.h b/include/winbase.h
index 72c78bba9cd..b6b908ed372 100644
--- a/include/winbase.h
+++ b/include/winbase.h
@@ -573,6 +573,33 @@ typedef struct _FILE_REMOTE_PROTOCOL_INFO {
     } ProtocolSpecificReserved;
 } FILE_REMOTE_PROTOCOL_INFO, *PFILE_REMOTE_PROTOCOL_INFO;
 
+typedef struct _FILE_STORAGE_INFO {
+    ULONG LogicalBytesPerSector;
+    ULONG PhysicalBytesPerSectorForAtomicity;
+    ULONG PhysicalBytesPerSectorForPerformance;
+    ULONG FileSystemEffectivePhysicalBytesPerSectorForAtomicity;
+    ULONG Flags;
+    ULONG ByteOffsetForSectorAlignment;
+    ULONG ByteOffsetForPartitionAlignment;
+} FILE_STORAGE_INFO, *PFILE_STORAGE_INFO;
+
+#define STORAGE_INFO_FLAGS_ALIGNED_DEVICE              0x00000001
+#define STORAGE_INFO_FLAGS_PARTITION_ALIGNED_ON_DEVICE 0x00000002
+#define STORAGE_INFO_OFFSET_UNKNOWN                    0xffffffff
+
+typedef struct _FILE_ALIGNMENT_INFO {
+    ULONG AlignmentRequirement;
+} FILE_ALIGNMENT_INFO, *PFILE_ALIGNMENT_INFO;
+
+typedef struct _FILE_ID_INFO {
+    ULONGLONG VolumeSerialNumber;
+    FILE_ID_128 FileId;
+} FILE_ID_INFO, *PFILE_ID_INFO;
+
+typedef struct _FILE_CASE_SENSITIVE_INFO {
+    ULONG Flags;
+} FILE_CASE_SENSITIVE_INFO, *PFILE_CASE_SENSITIVE_INFO;
+
 #define PIPE_ACCESS_INBOUND  1
 #define PIPE_ACCESS_OUTBOUND 2
 #define PIPE_ACCESS_DUPLEX   3
diff --git a/include/winioctl.h b/include/winioctl.h
index a895598eab9..5eb3a39a212 100644
--- a/include/winioctl.h
+++ b/include/winioctl.h
@@ -670,6 +670,24 @@ typedef struct _FILE_FS_FULL_SIZE_INFORMATION_EX {
     ULONG     BytesPerSector;
 } FILE_FS_FULL_SIZE_INFORMATION_EX, *PFILE_FS_FULL_SIZE_INFORMATION_EX;
 
+/* FileFsSectorSizeInformation = 11 */
+typedef struct _FILE_FS_SECTOR_SIZE_INFORMATION {
+    ULONG LogicalBytesPerSector;
+    ULONG PhysicalBytesPerSectorForAtomicity;
+    ULONG PhysicalBytesPerSectorForPerformance;
+    ULONG FileSystemEffectivePhysicalBytesPerSectorForAtomicity;
+    ULONG Flags;
+    ULONG ByteOffsetForSectorAlignment;
+    ULONG ByteOffsetForPartitionAlignment;
+} FILE_FS_SECTOR_SIZE_INFORMATION, *PFILE_FS_SECTOR_SIZE_INFORMATION;
+
+#define SSINFO_FLAGS_ALIGNED_DEVICE              0x00000001
+#define SSINFO_FLAGS_PARTITION_ALIGNED_ON_DEVICE 0x00000002
+#define SSINFO_FLAGS_NO_SEEK_PENALTY             0x00000004
+#define SSINFO_FLAGS_TRIM_ENABLED                0x00000008
+#define SSINFO_FLAGS_BYTE_ADDRESSABLE            0x00000010
+#define SSINFO_OFFSET_UNKNOWN                    0xffffffff
+
 typedef struct _FILE_PIPE_WAIT_FOR_BUFFER {
     LARGE_INTEGER   Timeout;
     ULONG           NameLength;
diff --git a/include/winnt.h b/include/winnt.h
index 0cde7ab175e..ca876b34090 100644
--- a/include/winnt.h
+++ b/include/winnt.h
@@ -5674,6 +5674,12 @@ typedef struct _QUOTA_LIMITS_EX {
 #define FILE_DAX_VOLUME                      0x20000000
 #define FILE_SUPPORTS_GHOSTING               0x40000000
 
+#define FILE_CS_FLAG_CASE_SENSITIVE_DIR      0x00000001
+
+typedef struct _FILE_ID_128 {
+    BYTE Identifier[16];
+} FILE_ID_128, *PFILE_ID_128;
+
 /* File alignments (NT) */
 #define	FILE_BYTE_ALIGNMENT		0x00000000
 #define	FILE_WORD_ALIGNMENT		0x00000001
diff --git a/include/winternl.h b/include/winternl.h
index 8b51f023c96..fb6217a7b81 100644
--- a/include/winternl.h
+++ b/include/winternl.h
@@ -1536,15 +1536,15 @@ typedef struct _FILE_INTERNAL_INFORMATION {
     LARGE_INTEGER IndexNumber;
 } FILE_INTERNAL_INFORMATION, *PFILE_INTERNAL_INFORMATION;
 
-typedef struct _FILE_ID_128 {
-    UCHAR Identifier[16];
-} FILE_ID_128, *PFILE_ID_128;
-
 typedef struct _FILE_ID_INFORMATION {
     ULONGLONG VolumeSerialNumber;
     FILE_ID_128 FileId;
 } FILE_ID_INFORMATION, *PFILE_ID_INFORMATION;
 
+typedef struct _FILE_CASE_SENSITIVE_INFORMATION {
+    ULONG Flags;
+} FILE_CASE_SENSITIVE_INFORMATION, *PFILE_CASE_SENSITIVE_INFORMATION;
+
 typedef struct _FILE_EA_INFORMATION {
     ULONG EaSize;
 } FILE_EA_INFORMATION, *PFILE_EA_INFORMATION;
