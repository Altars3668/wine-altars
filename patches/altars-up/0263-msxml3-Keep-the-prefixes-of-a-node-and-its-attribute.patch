From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 08:35:31 -0400
Subject: [PATCH] msxml3: Keep the prefixes of a node and its attributes in a
 clone.

cloneNode() made the new node from its local name, so a clone of
<p:f p:a="2"> came out as <f xmlns="urn:p" a="2">: the element lost its
prefix and the attribute its namespace.  It now takes the qualified
name, and a clone serializes as it does on Windows,
<p:f xmlns:p="urn:p" p:a="2">.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/node.c b/dlls/msxml3/node.c
index cfa44500a14..0abb760ad5a 100644
--- a/dlls/msxml3/node.c
+++ b/dlls/msxml3/node.c
@@ -1476,7 +1476,7 @@ HRESULT node_clone_domnode(struct domnode *node, bool deep, struct domnode **clo
 
     *cloned = NULL;
 
-    if (FAILED(hr = domnode_create(node->type, node->name, SysStringLen(node->name), node->uri, SysStringLen(node->uri),
+    if (FAILED(hr = domnode_create(node->type, node->qname, SysStringLen(node->qname), node->uri, SysStringLen(node->uri),
             node->owner, &object)))
     {
         return hr;
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index d61d0e3a404..b62c5c67635 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -6589,6 +6589,61 @@ static void test_cloneNode(void )
     free_bstrs();
 }
 
+static void test_cloneNode_prefix(void)
+{
+    IXMLDOMNode *node, *clone, *attr;
+    IXMLDOMNamedNodeMap *map;
+    IXMLDOMElement *root;
+    IXMLDOMDocument *doc;
+    VARIANT_BOOL b;
+    HRESULT hr;
+    BSTR str;
+
+    doc = create_document(&IID_IXMLDOMDocument);
+    hr = IXMLDOMDocument_loadXML(doc, _bstr_("<r xmlns:p=\"urn:p\"><p:f p:a=\"2\"><p:g/></p:f></r>"), &b);
+    ok(hr == S_OK && b == VARIANT_TRUE, "Unexpected load %#lx, %d.\n", hr, b);
+    hr = IXMLDOMDocument_get_documentElement(doc, &root);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMElement_get_firstChild(root, &node);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    /* a clone keeps the prefixes of the element and its attributes */
+    hr = IXMLDOMNode_cloneNode(node, VARIANT_TRUE, &clone);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMNode_get_nodeName(clone, &str);
+    ok(hr == S_OK && !wcscmp(str, L"p:f"), "Unexpected name %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    hr = IXMLDOMNode_get_namespaceURI(clone, &str);
+    ok(hr == S_OK && !wcscmp(str, L"urn:p"), "Unexpected namespace %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    hr = IXMLDOMNode_get_attributes(clone, &map);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMNamedNodeMap_get_item(map, 0, &attr);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMNode_get_nodeName(attr, &str);
+    ok(hr == S_OK && !wcscmp(str, L"p:a"), "Unexpected name %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    IXMLDOMNode_Release(attr);
+    IXMLDOMNamedNodeMap_Release(map);
+    hr = IXMLDOMNode_get_xml(clone, &str);
+    ok(hr == S_OK && !wcscmp(str, L"<p:f xmlns:p=\"urn:p\" p:a=\"2\"><p:g/></p:f>"), "Unexpected xml %s.\n",
+            debugstr_w(str));
+    SysFreeString(str);
+    IXMLDOMNode_Release(clone);
+
+    hr = IXMLDOMNode_cloneNode(node, VARIANT_FALSE, &clone);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMNode_get_xml(clone, &str);
+    ok(hr == S_OK && !wcscmp(str, L"<p:f xmlns:p=\"urn:p\" p:a=\"2\"/>"), "Unexpected xml %s.\n", debugstr_w(str));
+    SysFreeString(str);
+    IXMLDOMNode_Release(clone);
+
+    IXMLDOMNode_Release(node);
+    IXMLDOMElement_Release(root);
+    IXMLDOMDocument_Release(doc);
+    free_bstrs();
+}
+
 static void test_xmlTypes(void)
 {
     IXMLDOMDocument *doc;
@@ -19570,6 +19625,7 @@ START_TEST(domdoc)
     test_ms_extension_values();
     test_XSLPattern();
     test_cloneNode();
+    test_cloneNode_prefix();
     test_xmlTypes();
     test_save();
     test_testTransforms();
