From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 06:50:17 -0400
Subject: [PATCH] rtworkq: Have work queue threads join an apartment, as
 Windows's do.

A callback on a work queue runs on a thread that has entered the
multithreaded apartment itself, or a single-threaded one of its own for
long functions, as test_queue_com_state has always expected.  Wine's
threads were only in the implicit MTA that startup creates, which a
callback asking CoGetApartmentType, or entering a single-threaded apartment,
could tell apart: the sensor activity monitor's reports come on such a
thread on Windows 11.  A thread stays in its apartment until it exits.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/mfplat/tests/mfplat.c b/dlls/mfplat/tests/mfplat.c
index 3d25dce9925..48be98908c5 100644
--- a/dlls/mfplat/tests/mfplat.c
+++ b/dlls/mfplat/tests/mfplat.c
@@ -7620,7 +7620,6 @@ static HRESULT WINAPI test_queue_com_state_callback_Invoke(IMFAsyncCallback *ifa
     ok(SUCCEEDED(hr), "Failed to get apartment type, hr %#lx.\n", hr);
     if (SUCCEEDED(hr))
     {
-    todo_wine {
         if (callback->param == MFASYNC_CALLBACK_QUEUE_LONG_FUNCTION)
             ok(com_type == APTTYPE_MAINSTA && qualifier == APTTYPEQUALIFIER_NONE,
                 "%#lx: unexpected type %u, qualifier %u.\n", callback->param, com_type, qualifier);
@@ -7628,7 +7627,6 @@ static HRESULT WINAPI test_queue_com_state_callback_Invoke(IMFAsyncCallback *ifa
             ok(com_type == APTTYPE_MTA && qualifier == APTTYPEQUALIFIER_NONE,
                 "%#lx: unexpected type %u, qualifier %u.\n", callback->param, com_type, qualifier);
     }
-    }
 
     SetEvent(callback->event);
     return S_OK;
diff --git a/dlls/rtworkq/queue.c b/dlls/rtworkq/queue.c
index 144feb98c55..647ed876e97 100644
--- a/dlls/rtworkq/queue.c
+++ b/dlls/rtworkq/queue.c
@@ -377,9 +377,20 @@ static BOOL pool_queue_shutdown(struct queue *queue)
     return TRUE;
 }
 
-static void CALLBACK standard_queue_worker(TP_CALLBACK_INSTANCE *instance, void *context, TP_WORK *work)
+/* Windows's work queue threads join an apartment of their own accord, and stay in it: the multithreaded
+ * one, and for long functions a single-threaded one.  A thread pool thread leaves it when it exits. */
+static void join_apartment(DWORD model)
+{
+    HRESULT hr = CoInitializeEx(NULL, model);
+
+    if (hr == S_FALSE)
+        CoUninitialize();
+    else if (FAILED(hr))
+        WARN("Failed to enter the apartment, hr %#lx.\n", hr);
+}
+
+static void invoke_work_item(struct work_item *item)
 {
-    struct work_item *item = context;
     RTWQASYNCRESULT *result = (RTWQASYNCRESULT *)item->result;
 
     TRACE("result object %p.\n", result);
@@ -393,6 +404,18 @@ static void CALLBACK standard_queue_worker(TP_CALLBACK_INSTANCE *instance, void
     IUnknown_Release(&item->IUnknown_iface);
 }
 
+static void CALLBACK standard_queue_worker(TP_CALLBACK_INSTANCE *instance, void *context, TP_WORK *work)
+{
+    join_apartment(COINIT_MULTITHREADED);
+    invoke_work_item(context);
+}
+
+static void CALLBACK long_function_queue_worker(TP_CALLBACK_INSTANCE *instance, void *context, TP_WORK *work)
+{
+    join_apartment(COINIT_APARTMENTTHREADED);
+    invoke_work_item(context);
+}
+
 static void pool_queue_submit(struct queue *queue, struct work_item *item)
 {
     TP_CALLBACK_PRIORITY callback_priority;
@@ -411,7 +434,8 @@ static void pool_queue_submit(struct queue *queue, struct work_item *item)
        we need finalization callback. */
     if (item->finalization_callback)
         IUnknown_AddRef(&item->IUnknown_iface);
-    item->u.work_object = CreateThreadpoolWork(standard_queue_worker, item, (TP_CALLBACK_ENVIRON *)&env);
+    item->u.work_object = CreateThreadpoolWork(queue == &system_queues[SYS_QUEUE_LONG_FUNCTION] ?
+            long_function_queue_worker : standard_queue_worker, item, (TP_CALLBACK_ENVIRON *)&env);
     item->type = WORK_ITEM_WORK;
     SubmitThreadpoolWork(item->u.work_object);
 
