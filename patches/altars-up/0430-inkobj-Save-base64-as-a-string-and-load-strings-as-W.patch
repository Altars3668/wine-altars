From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 07:54:04 -0400
Subject: [PATCH] inkobj: Save base64 as a string, and load strings, as Windows
 11 does.

On build 29671 the base64 formats come back from Save as a string,
"base64:" and the encoded stream, whose length counts a terminating null
as well; the stream records first, in a persistence format tag, that it was
saved as base64 (0x10000).  Load takes that string as it is.  Loading into
ink that has strokes is E_INVALIDARG.  Two samples Windows saved, with
drawing attributes and extended properties of four types on the ink, a
stroke and its attributes, decode to what Windows reported of them.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/inkobj/ink.c b/dlls/inkobj/ink.c
index b4d3b4c0793..f7833ff0fc2 100644
--- a/dlls/inkobj/ink.c
+++ b/dlls/inkobj/ink.c
@@ -3147,22 +3147,45 @@ static HRESULT WINAPI ink_Save(IInkDisp *iface, InkPersistenceFormat format, Ink
     }
     if (FAILED(hr = ink_get_data(ink, &strokes, &count)))
         return hr;
-    hr = isf_encode(strokes, count, ink->properties, compression, &bytes, &size);
+    hr = isf_encode(strokes, count, ink->properties, compression,
+            format == IPF_Base64InkSerializedFormat ? 0x10000 : 0, &bytes, &size);
     strokes_free_data(strokes, count);
     if (FAILED(hr))
         return hr;
+    /* Base64 is a string on Windows 11: "base64:", the encoded stream, and a null its length counts too */
     if (format == IPF_Base64InkSerializedFormat)
     {
-        if (size > (SIZE_MAX - 8) / 4 * 3)
+        BSTR text;
+
+        if (size > (UINT_MAX - 8) / 4 * 3)
         {
             free(bytes);
             return E_OUTOFMEMORY;
         }
         encoded_size = 7 + 4 * ((size + 2) / 3) + 1;
+        if (!(text = SysAllocStringLen(NULL, encoded_size)))
+        {
+            free(bytes);
+            return E_OUTOFMEMORY;
+        }
+        memcpy(text, L"base64:", 7 * sizeof(WCHAR));
+        j = 7;
+        for (i = 0; i < size; i += 3)
+        {
+            unsigned int value = bytes[i] << 16 | (i + 1 < size ? bytes[i + 1] << 8 : 0) |
+                    (i + 2 < size ? bytes[i + 2] : 0);
+            text[j++] = alphabet[(value >> 18) & 63];
+            text[j++] = alphabet[(value >> 12) & 63];
+            text[j++] = i + 1 < size ? alphabet[(value >> 6) & 63] : '=';
+            text[j++] = i + 2 < size ? alphabet[value & 63] : '=';
+        }
+        text[j] = 0;
+        free(bytes);
+        V_VT(data) = VT_BSTR;
+        V_BSTR(data) = text;
+        return S_OK;
     }
-    else
-        encoded_size = size;
-    if (encoded_size > UINT_MAX || !(array = SafeArrayCreateVector(VT_UI1, 0, encoded_size)))
+    if (size > UINT_MAX || !(array = SafeArrayCreateVector(VT_UI1, 0, size)))
     {
         free(bytes);
         return E_OUTOFMEMORY;
@@ -3173,23 +3196,7 @@ static HRESULT WINAPI ink_Save(IInkDisp *iface, InkPersistenceFormat format, Ink
         free(bytes);
         return hr;
     }
-    if (format == IPF_Base64InkSerializedFormat)
-    {
-        memcpy(dest, "base64:", 7);
-        j = 7;
-        for (i = 0; i < size; i += 3)
-        {
-            unsigned int value = bytes[i] << 16 | (i + 1 < size ? bytes[i + 1] << 8 : 0) |
-                    (i + 2 < size ? bytes[i + 2] : 0);
-            dest[j++] = alphabet[(value >> 18) & 63];
-            dest[j++] = alphabet[(value >> 12) & 63];
-            dest[j++] = i + 1 < size ? alphabet[(value >> 6) & 63] : '=';
-            dest[j++] = i + 2 < size ? alphabet[value & 63] : '=';
-        }
-        dest[j] = 0;
-    }
-    else
-        memcpy(dest, bytes, size);
+    memcpy(dest, bytes, size);
     SafeArrayUnaccessData(array);
     free(bytes);
     V_VT(data) = VT_ARRAY | VT_UI1;
@@ -3203,9 +3210,10 @@ static HRESULT WINAPI ink_Load(IInkDisp *iface, VARIANT data)
     struct ink *ink = impl_from_IInkDisp(iface);
     struct stroke_data **strokes = NULL;
     IInkExtendedProperties *properties = NULL;
-    SAFEARRAY *array;
+    SAFEARRAY *array = NULL;
     const BYTE *raw, *input;
-    BYTE *allocated = NULL;
+    BYTE *allocated = NULL, *text = NULL;
+    BSTR string = NULL;
     SIZE_T size;
     unsigned int count = 0;
     unsigned int i;
@@ -3214,24 +3222,51 @@ static HRESULT WINAPI ink_Load(IInkDisp *iface, VARIANT data)
 
     TRACE("iface %p, data %s.\n", iface, debugstr_variant(&data));
 
-    if (V_VT(&data) == (VT_ARRAY | VT_UI1))
+    /* what Save gives back in the base64 formats is a string, which Windows 11 loads as it is */
+    if (V_VT(&data) == VT_BSTR)
+        string = V_BSTR(&data);
+    else if (V_VT(&data) == (VT_BYREF | VT_BSTR) && V_BSTRREF(&data))
+        string = *V_BSTRREF(&data);
+    else if (V_VT(&data) == (VT_ARRAY | VT_UI1))
         array = V_ARRAY(&data);
     else if (V_VT(&data) == (VT_BYREF | VT_ARRAY | VT_UI1) && V_ARRAYREF(&data))
         array = *V_ARRAYREF(&data);
     else
         return E_INVALIDARG;
-    if (!array || SafeArrayGetDim(array) != 1 || FAILED(SafeArrayGetLBound(array, 1, &lower)) ||
-            FAILED(SafeArrayGetUBound(array, 1, &upper))) return E_INVALIDARG;
+    if (V_VT(&data) == VT_BSTR || V_VT(&data) == (VT_BYREF | VT_BSTR))
+    {
+        size = SysStringLen(string);
+    }
+    else
+    {
+        if (!array || SafeArrayGetDim(array) != 1 || FAILED(SafeArrayGetLBound(array, 1, &lower)) ||
+                FAILED(SafeArrayGetUBound(array, 1, &upper))) return E_INVALIDARG;
+        size = upper < lower ? 0 : (SIZE_T)((INT64)upper - lower + 1);
+    }
     /* nothing to load is not an error on Windows 11 */
-    if (upper < lower) return S_OK;
-    /* UNMEASURED: WPF refuses to load into ink that has strokes */
+    if (!size) return S_OK;
+    /* nor can more be loaded into ink that has strokes */
     EnterCriticalSection(&ink->cs);
-    hr = list_empty(&ink->strokes) ? S_OK : E_UNEXPECTED;
+    hr = list_empty(&ink->strokes) ? S_OK : E_INVALIDARG;
     LeaveCriticalSection(&ink->cs);
     if (FAILED(hr))
         return hr;
-    size = (SIZE_T)((INT64)upper - lower + 1);
-    if (FAILED(hr = SafeArrayAccessData(array, (void **)&raw)))
+    if (string)
+    {
+        if (!(text = malloc(size)))
+            return E_OUTOFMEMORY;
+        for (i = 0; i < size; i++)
+        {
+            if (string[i] > 0xff)
+            {
+                free(text);
+                return E_INVALIDARG;
+            }
+            text[i] = string[i];
+        }
+        raw = text;
+    }
+    else if (FAILED(hr = SafeArrayAccessData(array, (void **)&raw)))
         return hr;
     input = raw;
     if (size >= 7 && !memcmp(raw, "base64:", 7))
@@ -3257,13 +3292,14 @@ static HRESULT WINAPI ink_Load(IInkDisp *iface, VARIANT data)
         if (SUCCEEDED(hr = extended_properties_create(&properties)))
             hr = isf_decode(input, size, properties, &strokes, &count);
     }
-    SafeArrayUnaccessData(array);
+    if (array) SafeArrayUnaccessData(array);
+    free(text);
     free(allocated);
     if (SUCCEEDED(hr))
     {
         EnterCriticalSection(&ink->cs);
         if (!list_empty(&ink->strokes))
-            hr = E_UNEXPECTED;
+            hr = E_INVALIDARG;
         /* the ink keeps its properties object, so one taken before Load sees the loaded properties */
         else if (SUCCEEDED(hr = IInkExtendedProperties_Clear(ink->properties))
                 && SUCCEEDED(hr = extended_properties_copy(ink->properties, properties)))
diff --git a/dlls/inkobj/inkobj_private.h b/dlls/inkobj/inkobj_private.h
index 4e5f2cc8f5f..99e0c8b67b3 100644
--- a/dlls/inkobj/inkobj_private.h
+++ b/dlls/inkobj/inkobj_private.h
@@ -158,7 +158,7 @@ HRESULT stroke_data_create(unsigned int packet_size, const GUID *description, un
 HRESULT isf_decode(const BYTE *data, SIZE_T size, IInkExtendedProperties *ink_properties,
         struct stroke_data ***strokes, unsigned int *count);
 HRESULT isf_encode(struct stroke_data **strokes, unsigned int count, IInkExtendedProperties *ink_properties,
-        InkPersistenceCompressionMode compression, BYTE **data, SIZE_T *size);
+        InkPersistenceCompressionMode compression, UINT64 persistence, BYTE **data, SIZE_T *size);
 struct stroke_data *stroke_data_from_IInkStrokeDisp(IInkStrokeDisp *iface);
 HRESULT strokes_get_data(IInkStrokes *iface, struct stroke_data ***data, unsigned int *count);
 void strokes_free_data(struct stroke_data **data, unsigned int count);
diff --git a/dlls/inkobj/isf.c b/dlls/inkobj/isf.c
index ae2d365d667..95a76edcb6b 100644
--- a/dlls/inkobj/isf.c
+++ b/dlls/inkobj/isf.c
@@ -1993,8 +1993,10 @@ static void isf_encode_desc(struct isf_writer *w, struct isf_state *s, struct st
 }
 
 /* 将笔画保存为 ISF 字节流。 */
+/* Persistence is what the stream is saved as, which Windows 11 records first: 0x10000 for base64; none for plain
+ * ink serialized format. */
 HRESULT isf_encode(struct stroke_data **strokes, unsigned int count, IInkExtendedProperties *ink_properties,
-        InkPersistenceCompressionMode compression, BYTE **data, SIZE_T *size)
+        InkPersistenceCompressionMode compression, UINT64 persistence, BYTE **data, SIZE_T *size)
 {
     struct isf_state s = {0};
     struct isf_writer content = {0};
@@ -2021,6 +2023,13 @@ HRESULT isf_encode(struct stroke_data **strokes, unsigned int count, IInkExtende
         if (FAILED(hr))
             goto done;
     }
+    if (persistence)
+    {
+        block = (struct isf_writer){0};
+        isf_number(&block, persistence);
+        isf_section(&content, TAG_PERSISTENCE, &block);
+        isf_drop(&block);
+    }
     if (s.guid_count)
     {
         isf_number(&content, TAG_GUID_TABLE);
diff --git a/dlls/inkobj/tests/inkobj.c b/dlls/inkobj/tests/inkobj.c
