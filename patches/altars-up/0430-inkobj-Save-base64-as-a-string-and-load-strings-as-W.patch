+/* ink Windows 11 saved itself: one stroke, its drawing attributes, and extended properties on all three */
+static void test_windows_isf(void)
+{
+    static const BYTE windows_isf[] = {
+        0x00,0x9d,0x01,0x1d,0x03,0xae,0x01,0x1e,0x01,0x30,0x27,0x7e,0x1b,0x1d,0x3f,0x6b,
+        0x21,0x4e,0x9f,0x4a,0x2a,0x7c,0x0e,0x5e,0x6f,0x01,0x27,0x7e,0x1b,0x1d,0x3f,0x6b,
+        0x21,0x4e,0x9f,0x4a,0x2a,0x7c,0x0e,0x5e,0x6f,0x02,0x27,0x7e,0x1b,0x1d,0x3f,0x6b,
+        0x21,0x4e,0x9f,0x4a,0x2a,0x7c,0x0e,0x5e,0x6f,0x03,0x03,0x27,0x48,0x05,0x64,0x06,
+        0x16,0x06,0x03,0xc5,0x66,0x84,0x80,0x44,0x92,0xe8,0xd8,0x02,0x45,0x6b,0x1b,0x02,
+        0x00,0x0c,0xfe,0x47,0x01,0x46,0x1e,0x1b,0x01,0x38,0xfa,0x57,0x09,0x00,0x00,0x00,
+        0x50,0x80,0x01,0x05,0x03,0x0b,0x65,0x66,0x64,0x09,0x16,0x0a,0x00,0x00,0x00,0x00,
+        0x00,0x00,0x09,0x00,0x0a,0x2a,0x05,0x87,0xe6,0x4e,0xe2,0x67,0xc8,0xd9,0x1f,0x23,
+        0x00,0x87,0xe6,0x4e,0xe4,0xbf,0xc8,0xf6,0x3a,0x78,0x08,0x36,0x11,0xa7,0x76,0xb4,
+        0x1b,0xb7,0xf4,0xca,0x0a,0x00,0x11,0x20,0x01,0x02,0x03,0x04,0x05,0xfa,0xfb,0xfc
+    };
+    static const BYTE windows_isf_uncompressed[] = {
+        0x00,0xa9,0x01,0x1d,0x03,0xae,0x01,0x1e,0x01,0x30,0x27,0x7e,0x1b,0x1d,0x3f,0x6b,
+        0x21,0x4e,0x9f,0x4a,0x2a,0x7c,0x0e,0x5e,0x6f,0x01,0x27,0x7e,0x1b,0x1d,0x3f,0x6b,
+        0x21,0x4e,0x9f,0x4a,0x2a,0x7c,0x0e,0x5e,0x6f,0x02,0x27,0x7e,0x1b,0x1d,0x3f,0x6b,
+        0x21,0x4e,0x9f,0x4a,0x2a,0x7c,0x0e,0x5e,0x6f,0x03,0x03,0x28,0x48,0x05,0x64,0x06,
+        0x00,0x03,0x00,0x78,0x56,0x34,0x12,0x44,0x92,0xe8,0xd8,0x02,0x45,0x6b,0x1b,0x02,
+        0x00,0x0c,0xfe,0x47,0x01,0x46,0x1e,0x1b,0x02,0x00,0xfa,0x00,0x57,0x09,0x00,0x00,
+        0x00,0x50,0x80,0x01,0x05,0x03,0x0b,0x65,0x66,0x64,0x0a,0x00,0x05,0x00,0x00,0x00,
+        0x00,0x00,0x00,0x00,0x04,0x40,0x0a,0x34,0x05,0x0d,0x1f,0x41,0x77,0x10,0x68,0xa2,
+        0x86,0x40,0x00,0x0c,0x3e,0x84,0xb0,0x51,0x45,0x46,0x55,0x00,0x12,0x00,0x08,0x00,
+        0x69,0x00,0x6e,0x00,0x6b,0x00,0x20,0x00,0x6e,0x00,0x6f,0x00,0x74,0x00,0x65,0x00,
+        0x0a,0x00,0x11,0x20,0x01,0x02,0x03,0x04,0x05,0xfa,0xfb,0xfc
+    };
+    static const LONG points[] = {1000, 1000, 1500, 1200, 2100, 1300, 2600, 1350, 3200, 1360};
+    static const BYTE property_bytes[] = {1, 2, 3, 4, 5, 250, 251, 252};
+    static const struct
+    {
+        const BYTE *data;
+        unsigned int size;
+    }
+    samples[] =
+    {
+        {windows_isf, sizeof(windows_isf)},
+        {windows_isf_uncompressed, sizeof(windows_isf_uncompressed)},
+    };
+    IInkExtendedProperties *properties;
+    IInkExtendedProperty *property;
+    IInkDrawingAttributes *attrs;
+    IInkStrokeDisp *stroke;
+    IInkStrokes *strokes;
+    VARIANT v, id, value;
+    VARIANT_BOOL flag;
+    LONG values[16], count, color;
+    InkRasterOperation rop;
+    InkPenTip tip;
+    float width;
+    IInkDisp *ink;
+    unsigned int i, n;
+    BYTE *bytes;
+    HRESULT hr;
+
+    for (i = 0; i < ARRAY_SIZE(samples); i++)
+    {
+        winetest_push_context("sample %u", i);
+        if (!(ink = create(&CLSID_InkDisp, &IID_IInkDisp))) break;
+        v = byte_array(samples[i].data, samples[i].size);
+        hr = IInkDisp_Load(ink, v);
+        ok(hr == S_OK, "Load: %#lx.\n", hr);
+        VariantClear(&v);
+
+        /* no more is loaded into ink that has strokes */
+        v = byte_array(samples[i].data, samples[i].size);
+        hr = IInkDisp_Load(ink, v);
+        ok(hr == E_INVALIDARG, "Load again: %#lx.\n", hr);
+        VariantClear(&v);
+
+        /* base64 is a string, whose length counts a null, and loads as it is */
+        hr = IInkDisp_Save(ink, IPF_Base64InkSerializedFormat, IPCM_Default, &v);
+        ok(hr == S_OK && V_VT(&v) == VT_BSTR, "Base64 Save: %#lx, vt %#x.\n", hr, V_VT(&v));
+        if (SUCCEEDED(hr) && V_VT(&v) == VT_BSTR)
+        {
+            UINT length = SysStringLen(V_BSTR(&v));
+            IInkDisp *other;
+
+            ok(length > 8 && !wcsncmp(V_BSTR(&v), L"base64:", 7) && !V_BSTR(&v)[length - 1],
+                    "Got %s.\n", wine_dbgstr_wn(V_BSTR(&v), min(length, 16)));
+            if ((other = create(&CLSID_InkDisp, &IID_IInkDisp)))
+            {
+                hr = IInkDisp_Load(other, v);
+                ok(hr == S_OK, "Base64 Load: %#lx.\n", hr);
+                IInkDisp_get_Strokes(other, &strokes);
+                count = 0;
+                IInkStrokes_get_Count(strokes, &count);
+                ok(count == 1, "Got %ld strokes.\n", count);
+                IInkStrokes_Release(strokes);
+                IInkDisp_Release(other);
+            }
+        }
+        VariantClear(&v);
+
+        IInkDisp_get_Strokes(ink, &strokes);
+        count = 0;
+        IInkStrokes_get_Count(strokes, &count);
+        ok(count == 1, "Got %ld strokes.\n", count);
+        if (count != 1) goto next;
+        IInkStrokes_Item(strokes, 0, &stroke);
+        hr = IInkStrokeDisp_GetPoints(stroke, 0, -1, &v);
+        ok(hr == S_OK, "GetPoints: %#lx.\n", hr);
+        n = read_longs(&v, values, ARRAY_SIZE(values));
+        ok(n == ARRAY_SIZE(points) && !memcmp(values, points, sizeof(points)), "Got %u values, %ld %ld.\n",
+                n, values[0], values[1]);
+
+        IInkStrokeDisp_get_DrawingAttributes(stroke, &attrs);
+        IInkDrawingAttributes_get_Color(attrs, &color);
+        ok(color == 0x563412, "Got color %#lx.\n", color);
+        IInkDrawingAttributes_get_Width(attrs, &width);
+        ok(width == 106.5f, "Got width %f.\n", width);
+        IInkDrawingAttributes_get_Height(attrs, &width);
+        ok(width == 30.25f, "Got height %f.\n", width);
+        IInkDrawingAttributes_get_PenTip(attrs, &tip);
+        ok(tip == IPT_Rectangle, "Got tip %d.\n", tip);
+        IInkDrawingAttributes_get_FitToCurve(attrs, &flag);
+        ok(flag == VARIANT_TRUE, "Got fit %d.\n", flag);
+        IInkDrawingAttributes_get_IgnorePressure(attrs, &flag);
+        ok(flag == VARIANT_TRUE, "Got ignore pressure %d.\n", flag);
+        IInkDrawingAttributes_get_AntiAliased(attrs, &flag);
+        ok(flag == VARIANT_FALSE, "Got anti-aliased %d.\n", flag);
+        IInkDrawingAttributes_get_Transparency(attrs, &color);
+        ok(color == 128, "Got transparency %ld.\n", color);
+        IInkDrawingAttributes_get_RasterOperation(attrs, &rop);
+        ok(rop == IRO_MaskPen, "Got raster operation %d.\n", rop);
+        IInkDrawingAttributes_get_ExtendedProperties(attrs, &properties);
+        V_VT(&id) = VT_BSTR;
+        V_BSTR(&id) = SysAllocString(L"{1D1B7E27-6B3F-4E21-9F4A-2A7C0E5E6F01}");
+        hr = IInkExtendedProperties_Item(properties, id, &property);
+        ok(hr == S_OK, "Attributes' property: %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            IInkExtendedProperty_get_Data(property, &value);
+            ok(V_VT(&value) == VT_I4 && V_I4(&value) == 0x12345678, "Got vt %#x.\n", V_VT(&value));
+            VariantClear(&value);
+            IInkExtendedProperty_Release(property);
+        }
+        VariantClear(&id);
+        IInkExtendedProperties_Release(properties);
+        IInkDrawingAttributes_Release(attrs);
+
+        IInkStrokeDisp_get_ExtendedProperties(stroke, &properties);
+        V_VT(&id) = VT_BSTR;
+        V_BSTR(&id) = SysAllocString(L"{1D1B7E27-6B3F-4E21-9F4A-2A7C0E5E6F02}");
+        hr = IInkExtendedProperties_Item(properties, id, &property);
+        ok(hr == S_OK, "Stroke's string property: %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            IInkExtendedProperty_get_Data(property, &value);
+            ok(V_VT(&value) == VT_BSTR && !wcscmp(V_BSTR(&value), L"ink note"), "Got vt %#x.\n", V_VT(&value));
+            VariantClear(&value);
+            IInkExtendedProperty_Release(property);
+        }
+        VariantClear(&id);
+        V_VT(&id) = VT_BSTR;
+        V_BSTR(&id) = SysAllocString(L"{1D1B7E27-6B3F-4E21-9F4A-2A7C0E5E6F03}");
+        hr = IInkExtendedProperties_Item(properties, id, &property);
+        ok(hr == S_OK, "Stroke's byte property: %#lx.\n", hr);
+        if (SUCCEEDED(hr))
+        {
+            IInkExtendedProperty_get_Data(property, &value);
+            ok(V_VT(&value) == (VT_ARRAY | VT_UI1), "Got vt %#x.\n", V_VT(&value));
+            if (V_VT(&value) == (VT_ARRAY | VT_UI1))
+            {
+                LONG upper = -1;
+                SafeArrayGetUBound(V_ARRAY(&value), 1, &upper);
+                SafeArrayAccessData(V_ARRAY(&value), (void **)&bytes);
+                ok(upper + 1 == sizeof(property_bytes) && !memcmp(bytes, property_bytes, sizeof(property_bytes)),
+                        "Got %ld bytes.\n", upper + 1);
+                SafeArrayUnaccessData(V_ARRAY(&value));
+            }
