From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 13:38:13 -0400
Subject: [PATCH] ntdll, win32u, setupapi: print trace arguments with formats
 that match their types.

The build warned about five: a ULONG printed with %u and a
REGDISPOSITION with %d in PE code, where they are unsigned long, and
two pairs of LONG sizes printed with %ld in win32u, where they are int.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 40ee27af4956f4e41fba83406f5d9818ea2b74a0)

diff --git a/dlls/ntdll/misc.c b/dlls/ntdll/misc.c
index 5aaec887933..5ec5f406a25 100644
--- a/dlls/ntdll/misc.c
+++ b/dlls/ntdll/misc.c
@@ -438,7 +438,7 @@ static void tracelog_print_value( UCHAR in_type, const BYTE **payload, const BYT
     case TLG_IN_UINT16: if (p + 2 > end) break; TRACE_(tracelog)( "%u", *(const USHORT *)p ); p += 2; break;
     case TLG_IN_INT32:  if (p + 4 > end) break; TRACE_(tracelog)( "%d", *(const int *)p ); p += 4; break;
     case TLG_IN_BOOL32: if (p + 4 > end) break; TRACE_(tracelog)( "%s", *(const int *)p ? "true" : "false" ); p += 4; break;
-    case TLG_IN_UINT32: if (p + 4 > end) break; TRACE_(tracelog)( "%u", *(const ULONG *)p ); p += 4; break;
+    case TLG_IN_UINT32: if (p + 4 > end) break; TRACE_(tracelog)( "%lu", *(const ULONG *)p ); p += 4; break;
     case TLG_IN_HEXINT32: if (p + 4 > end) break; TRACE_(tracelog)( "%#lx", *(const ULONG *)p ); p += 4; break;
     case TLG_IN_INT64:  if (p + 8 > end) break; TRACE_(tracelog)( "%s", wine_dbgstr_longlong( *(const LONG64 *)p )); p += 8; break;
     case TLG_IN_UINT64:
diff --git a/dlls/win32u/font.c b/dlls/win32u/font.c
index 138a97dc015..2a22852b5c4 100644
--- a/dlls/win32u/font.c
+++ b/dlls/win32u/font.c
@@ -5843,7 +5843,7 @@ BOOL WINAPI NtGdiExtTextOutW( HDC hdc, INT x, INT y, UINT flags, const RECT *lpr
     {
         BITMAP bitmap = {0};
         int got = dc->hBitmap ? NtGdiExtGetObjectW( dc->hBitmap, sizeof(bitmap), &bitmap ) : 0;
-        TRACE("draw target: display=%u bitmap=%p got=%d %ldx%ld planes=%u bpp=%u bits=%p device=%s\n",
+        TRACE("draw target: display=%u bitmap=%p got=%d %dx%d planes=%u bpp=%u bits=%p device=%s\n",
               dc->is_display, dc->hBitmap, got, bitmap.bmWidth, bitmap.bmHeight,
               bitmap.bmPlanes, bitmap.bmBitsPixel, bitmap.bmBits, wine_dbgstr_rect(&dc->device_rect));
     }
diff --git a/dlls/win32u/menu.c b/dlls/win32u/menu.c
index 8fe8e12b705..a8227d22707 100644
--- a/dlls/win32u/menu.c
+++ b/dlls/win32u/menu.c
@@ -3150,7 +3150,7 @@ BOOL WINAPI NtUserCalculatePopupWindowPosition( const POINT *anchor_point, const
     MONITORINFO info;
     LONG x, y;
 
-    TRACE( "anchor %s size %ldx%ld flags %#x exclude %s\n", wine_dbgstr_point( anchor_point ),
+    TRACE( "anchor %s size %dx%d flags %#x exclude %s\n", wine_dbgstr_point( anchor_point ),
            window_size ? window_size->cx : 0, window_size ? window_size->cy : 0, flags,
            wine_dbgstr_rect( exclude_rect ) );
 
