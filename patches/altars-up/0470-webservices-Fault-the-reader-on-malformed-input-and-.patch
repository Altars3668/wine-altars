+static void check_error_string( WS_ERROR *error, ULONG index, const WCHAR *expected, unsigned int line )
+{
+    WS_STRING str;
+    HRESULT hr;
+
+    memset( &str, 0, sizeof(str) );
+    hr = WsGetErrorString( error, index, &str );
+    ok_(__FILE__, line)( hr == S_OK, "got %#lx\n", hr );
+    ok_(__FILE__, line)( str.length == wcslen( expected ) && !memcmp( str.chars, expected, str.length * sizeof(WCHAR) ),
+                         "got %s\n", debugstr_wn( str.chars, str.length ) );
+}
+
+static void test_reader_fault(void)
+{
+    static const LANGID langid = MAKELANGID( LANG_ENGLISH, SUBLANG_ENGLISH_US );
+    WS_XML_READER_TEXT_ENCODING bad_encoding = {{0xdead}, WS_CHARSET_UTF8};
+    WS_XML_READER_BUFFER_INPUT buf = {{WS_XML_READER_INPUT_TYPE_BUFFER}, (void *)"<a/>", 4};
+    WS_XML_STRING str_a = {1, (BYTE *)"a"}, str_A = {1, (BYTE *)"A"}, str_ns = {5, (BYTE *)"urn:x"};
+    WS_XML_STRING str_empty = {0, (BYTE *)""};
+    const WS_XML_NODE *node;
+    WS_ERROR_PROPERTY prop;
+    WS_XML_READER *reader;
+    WS_ERROR *error;
+    ULONG count;
+    BOOL found;
+    HRESULT hr;
+
+    prop.id = WS_ERROR_PROPERTY_LANGID;
+    prop.value = (void *)&langid;
+    prop.valueSize = sizeof(langid);
+    hr = WsCreateError( &prop, 1, &error );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsCreateReader( NULL, 0, &reader, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+
+    /* an end tag that is not the innermost element's is found reading on from its start, and faults the reader */
+    hr = set_input( reader, "<a><b></a>", sizeof("<a><b></a>") - 1 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadToStartElement( reader, NULL, NULL, NULL, error );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadStartElement( reader, error );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadToStartElement( reader, NULL, NULL, NULL, error );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadStartElement( reader, error );
+    ok( hr == WS_E_INVALID_FORMAT, "got %#lx\n", hr );
+    count = 0xdeadbeef;
+    hr = WsGetErrorProperty( error, WS_ERROR_PROPERTY_STRING_COUNT, &count, sizeof(count) );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( count == 2, "got %lu\n", count );
+    check_error_string( error, 0, L"An error occurred at row 1, column 9 when the XML reader is processing the input "
+                        L"source.", __LINE__ );
+    check_error_string( error, 1, L"The end element 'b' was expected but not found.", __LINE__ );
+    WsResetError( error );
+
+    /* the node stays the element, and nothing more is read */
+    hr = WsGetReaderNode( reader, &node, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( node->nodeType == WS_XML_NODE_TYPE_ELEMENT, "got %u\n", node->nodeType );
+    hr = WsReadEndElement( reader, error );
+    ok( hr == WS_E_OBJECT_FAULTED, "got %#lx\n", hr );
+    check_error_string( error, 0, L"The operation could not be completed because the reader is in a faulted state.",
+                        __LINE__ );
+    WsResetError( error );
+    hr = WsReadNode( reader, NULL );
+    ok( hr == WS_E_OBJECT_FAULTED, "got %#lx\n", hr );
+    hr = WsFillReader( reader, 1, NULL, NULL );
+    ok( hr == WS_E_OBJECT_FAULTED, "got %#lx\n", hr );
+    hr = WsGetReaderProperty( reader, WS_XML_READER_PROPERTY_MAX_DEPTH, &count, sizeof(count), NULL );
+    ok( hr == WS_E_OBJECT_FAULTED, "got %#lx\n", hr );
+
+    /* until there is new input */
+    hr = set_input( reader, "<a></A>", sizeof("<a></A>") - 1 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadToStartElement( reader, NULL, NULL, NULL, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    /* and names match by case */
+    hr = WsReadStartElement( reader, NULL );
+    ok( hr == WS_E_INVALID_FORMAT, "got %#lx\n", hr );
+
+    /* characters XML does not have */
+    hr = set_input( reader, "<a>\x01</a>", sizeof("<a>\x01</a>") - 1 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadToStartElement( reader, NULL, NULL, NULL, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadStartElement( reader, error );
+    ok( hr == WS_E_INVALID_FORMAT, "got %#lx\n", hr );
+    check_error_string( error, 0, L"An error occurred at row 1, column 4 when the XML reader is processing the input "
+                        L"source.", __LINE__ );
+    check_error_string( error, 1, L"The characters '\x01' are not valid as element content.", __LINE__ );
+    WsResetError( error );
+
+    hr = set_input( reader, "<a b='\x01'/>", sizeof("<a b='\x01'/>") - 1 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadToStartElement( reader, NULL, NULL, NULL, error );
+    ok( hr == WS_E_INVALID_FORMAT, "got %#lx\n", hr );
+    check_error_string( error, 1, L"The characters '\x01' are not valid as attribute content.", __LINE__ );
+    WsResetError( error );
+
+    /* text where a start element is expected; from 10 on a number has its hexadecimal value after it */
+    hr = set_input( reader, "text only", sizeof("text only") - 1 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = WsReadStartElement( reader, error );
+    ok( hr == WS_E_INVALID_FORMAT, "got %#lx\n", hr );
+    check_error_string( error, 0, L"An error occurred at row 1, column 10 (0xA) when the XML reader is processing the "
+                        L"input source.", __LINE__ );
+    check_error_string( error, 1, L"There is non-whitespace text 'text only' at the top-level of the document.",
+                        __LINE__ );
+    WsResetError( error );
+
+    /* reading to a start element tells whether it has the name and namespace asked for */
+    hr = set_input( reader, "<a/>", sizeof("<a/>") - 1 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    found = -1;
+    hr = WsReadToStartElement( reader, &str_A, NULL, &found, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !found, "got %d\n", found );
+    found = -1;
+    hr = WsReadToStartElement( reader, &str_a, &str_empty, &found, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( found == TRUE, "got %d\n", found );
+    found = -1;
+    hr = WsReadToStartElement( reader, &str_a, &str_ns, &found, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !found, "got %d\n", found );
+    hr = set_input( reader, "<p:a xmlns:p='urn:x'/>", sizeof("<p:a xmlns:p='urn:x'/>") - 1 );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    found = -1;
+    hr = WsReadToStartElement( reader, NULL, &str_ns, &found, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( found == TRUE, "got %d\n", found );
+    found = -1;
+    hr = WsReadToStartElement( reader, &str_a, &str_empty, &found, NULL );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !found, "got %d\n", found );
+
+    /* an encoding that is none */
+    hr = WsSetInput( reader, &bad_encoding.encoding, &buf.input, NULL, 0, error );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    check_error_string( error, 0, L"The encoding type (57005 (0xDEAD)) is not valid.", __LINE__ );
+
+    WsFreeReader( reader );
+    WsFreeError( error );
+}
+
 START_TEST(reader)
 {
     test_WsCreateError();
@@ -7695,6 +7840,7 @@ START_TEST(reader)
     test_stream_input();
     test_description_type();
     test_WsAddErrorString();
+    test_reader_fault();
     test_WsSetFaultErrorProperty();
     test_WsGetFaultErrorDetail();
     test_struct_array_duplicate_name();
