index bb461afb3e0..084b6887526 100644
--- a/dlls/webservices/error.c
+++ b/dlls/webservices/error.c
@@ -18,15 +18,18 @@
 
 #include <stdarg.h>
 #include <stdlib.h>
+#include <stdio.h>
 
 #include "windef.h"
 #include "winbase.h"
 #include "winnls.h"
+#include "winuser.h"
 #include "webservices.h"
 
 #include "wine/debug.h"
 #include "wine/list.h"
 #include "webservices_private.h"
+#include "resource.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(webservices);
 
@@ -553,6 +556,75 @@ done:
     return hr;
 }
 
+/* A message in the error's language, as Windows words it, or else in English; NULL if there is none. */
+static WCHAR *load_message( LANGID langid, UINT id )
+{
+    const LANGID langids[] = { langid, MAKELANGID( PRIMARYLANGID( langid ), SUBLANG_NEUTRAL ),
+                               MAKELANGID( LANG_ENGLISH, SUBLANG_DEFAULT ), MAKELANGID( LANG_NEUTRAL, SUBLANG_NEUTRAL ) };
+    const WCHAR *str = NULL;
+    unsigned int i;
+    HRSRC rsrc;
+    WCHAR *ret;
+
+    for (i = 0; i < ARRAY_SIZE(langids); i++)
+    {
+        if ((rsrc = FindResourceExW( webservices_instance, (const WCHAR *)RT_STRING,
+                                     MAKEINTRESOURCEW( (id >> 4) + 1 ), langids[i] )))
+        {
+            str = LockResource( LoadResource( webservices_instance, rsrc ) );
+            break;
+        }
+    }
+    if (!str) return NULL;
+    for (i = 0; i < (id & 15); i++) str += *str + 1;
+    if (!*str || !(ret = malloc( (*str + 1) * sizeof(WCHAR) ))) return NULL;
+    memcpy( ret, str + 1, *str * sizeof(WCHAR) );
+    ret[*str] = 0;
+    return ret;
+}
+
+/* Give an error the message Windows gives it, inserts in their places; it goes first, as the latest. */
+void add_error_string( WS_ERROR *handle, UINT id, const WCHAR *arg1, const WCHAR *arg2, const WCHAR *arg3 )
+{
+    struct error *error = (struct error *)handle;
+    DWORD_PTR args[3] = { (DWORD_PTR)arg1, (DWORD_PTR)arg2, (DWORD_PTR)arg3 };
+    WCHAR *template, *message = NULL;
+    WS_STRING str;
+    LANGID langid;
+    DWORD len;
+
+    if (!error) return;
+
+    EnterCriticalSection( &error->cs );
+    if (error->magic != ERROR_MAGIC)
+    {
+        LeaveCriticalSection( &error->cs );
+        return;
+    }
+    if (prop_get( error->prop, error->prop_count, WS_ERROR_PROPERTY_LANGID, &langid, sizeof(langid) ) != S_OK)
+        langid = GetUserDefaultUILanguage();
+    LeaveCriticalSection( &error->cs );
+
+    if (!(template = load_message( langid, id ))) return;
+    len = FormatMessageW( FORMAT_MESSAGE_FROM_STRING | FORMAT_MESSAGE_ARGUMENT_ARRAY | FORMAT_MESSAGE_ALLOCATE_BUFFER,
+                          template, 0, 0, (WCHAR *)&message, 0, (va_list *)args );
+    free( template );
+    if (!len) return;
+
+    str.chars = message;
+    str.length = len;
+    WsAddErrorString( handle, &str );
+    LocalFree( message );
+}
+
+/* a number as Windows puts it into a message: from 10 on, its hexadecimal value follows */
+const WCHAR *format_error_number( ULONG value, WCHAR *buf, ULONG size )
+{
+    if (value < 10) swprintf( buf, size, L"%lu", value );
+    else swprintf( buf, size, L"%lu (0x%lX)", value, value );
+    return buf;
+}
+
