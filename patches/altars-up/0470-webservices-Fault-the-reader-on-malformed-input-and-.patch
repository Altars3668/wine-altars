@@ -164,13 +166,30 @@ void ws_free( WS_HEAP *handle, void *ptr, SIZE_T size )
  */
 HRESULT WINAPI WsAlloc( WS_HEAP *handle, SIZE_T size, void **ptr, WS_ERROR *error )
 {
+    struct heap *heap = (struct heap *)handle;
     void *mem;
 
     TRACE( "%p %Iu %p %p\n", handle, size, ptr, error );
-    if (error) FIXME( "ignoring error parameter\n" );
 
     if (!handle || !ptr) return E_INVALIDARG;
-    if (!(mem = ws_alloc( handle, size ))) return WS_E_QUOTA_EXCEEDED;
+    if (!(mem = ws_alloc( handle, size )))
+    {
+        WCHAR excess[24], limit[24];
+        SIZE_T available;
+
+        /* how much more it would take than there is */
+        EnterCriticalSection( &heap->cs );
+        if (heap->magic == HEAP_MAGIC && ensure_heap( heap ) && size > heap->max_size - heap->allocated)
+        {
+            available = heap->max_size - heap->allocated;
+            swprintf( excess, ARRAY_SIZE(excess), L"%Iu", size - available );
+            swprintf( limit, ARRAY_SIZE(limit), L"%Iu", heap->max_size );
+            LeaveCriticalSection( &heap->cs );
+            add_error_string( error, IDS_HEAP_LIMIT, excess, limit, NULL );
+        }
+        else LeaveCriticalSection( &heap->cs );
+        return WS_E_QUOTA_EXCEEDED;
+    }
     *ptr = mem;
     return S_OK;
 }
