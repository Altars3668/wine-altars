             else
             {
-                todo_wine
-                {
                 ok(!ret, "%ld: SetFileTime should fail\n", i);
                 ok(GetLastError() == ERROR_ACCESS_DENIED, "%ld: expected ERROR_ACCESS_DENIED, got %ld\n", i, GetLastError());
-                }
             }
             CloseHandle(hfile);
         }
diff --git a/dlls/kernelbase/file.c b/dlls/kernelbase/file.c
