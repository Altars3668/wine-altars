new file mode 100644
index 00000000000..1a6bfcb917b
--- /dev/null
+++ b/libs/webp/src/dsp/alpha_processing_sse2.c
@@ -0,0 +1,418 @@
+// Copyright 2014 Google Inc. All Rights Reserved.
+//
+// Use of this source code is governed by a BSD-style license
