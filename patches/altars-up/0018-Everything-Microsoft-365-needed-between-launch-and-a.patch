+    struct d2d_svg_element *old;
+
+    TRACE("iface %p, old_child %p.\n", iface, old_child);
+
+    if (!(old = unsafe_impl_from_ID2D1SvgElement(old_child)) || old->parent != element)
+        return E_INVALIDARG;
+
+    d2d_svg_element_remove_child(old);
+
+    return S_OK;
+}
