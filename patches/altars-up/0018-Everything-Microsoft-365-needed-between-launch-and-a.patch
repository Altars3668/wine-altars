+/* Office asks for an MSA *device* ticket: a ticket the machine itself holds,
+ * used for the licensing endpoint before any user has signed in.  This machine
+ * has no MSA device credential, so there is no ticket to hand back and none is
+ * invented here.  What matters is the shape of the answer.  Returning E_NOTIMPL
+ * says the provider does not exist, and the account stack then reports
+ * "MsaDeviceOperationProvider is not available" and gives up.  Completing the
+ * operation with OnlineIdSystemTicketStatus_Error says the provider works and
+ * this device simply has no credential -- the same thing a Windows machine that
+ * was never linked to an MSA reports, and a state callers are expected to
+ * handle.
+ */
+struct ticket_result
+{
+    IOnlineIdSystemTicketResult IOnlineIdSystemTicketResult_iface;
+    LONG ref;
+    OnlineIdSystemTicketStatus status;
+    HRESULT extended_error;
+};
+
+static inline struct ticket_result *impl_from_IOnlineIdSystemTicketResult( IOnlineIdSystemTicketResult *iface )
+{
+    return CONTAINING_RECORD( iface, struct ticket_result, IOnlineIdSystemTicketResult_iface );
+}
+
+static HRESULT WINAPI ticket_result_QueryInterface( IOnlineIdSystemTicketResult *iface, REFIID iid, void **out )
+{
+    struct ticket_result *impl = impl_from_IOnlineIdSystemTicketResult( iface );
+
+    TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
+
+    if (IsEqualGUID( iid, &IID_IUnknown ) ||
+        IsEqualGUID( iid, &IID_IInspectable ) ||
+        IsEqualGUID( iid, &IID_IAgileObject ) ||
+        IsEqualGUID( iid, &IID_IOnlineIdSystemTicketResult ))
+    {
+        *out = &impl->IOnlineIdSystemTicketResult_iface;
+        IInspectable_AddRef( *out );
+        return S_OK;
+    }
+
+    FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI ticket_result_AddRef( IOnlineIdSystemTicketResult *iface )
+{
+    struct ticket_result *impl = impl_from_IOnlineIdSystemTicketResult( iface );
