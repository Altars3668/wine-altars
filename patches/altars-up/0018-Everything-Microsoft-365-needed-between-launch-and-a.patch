+static HRESULT WINAPI statics_GetTokenSilentlyWithWebAccountAsync(struct webauth_statics *iface,void *request,void *account,void **result)
+{
+    TRACE("GetTokenSilentlyWithWebAccountAsync iface %p, request %p, account %p, result %p.\n",iface,request,account,result);
+    /* The account argument names which of the broker's accounts to use. This
+     * broker has exactly one, so the answer cannot differ from the silent call
+     * next to it -- and failing here while that one succeeds would be a
+     * difference Office has no way to explain. */
+    return token_result_for_request(request,WEB_TOKEN_USER_INTERACTION_REQUIRED,result);
+}
+/* The interactive pair. A real broker puts a sign-in window on the screen
+ * here; this one cannot, so when it has no token the honest answer is the one
+ * Windows gives for a prompt that produced no credential -- UserCancel, a
+ * terminal state Office handles -- and not UserInteractionRequired, which
+ * asks the caller to do the very thing it just asked us to do. */
+static HRESULT WINAPI statics_RequestTokenAsync(struct webauth_statics *iface,void *request,void **result)
+{
+    TRACE("RequestTokenAsync iface %p, request %p, result %p.\n",iface,request,result);
