+ * function is hand-written assembly (`__ASM_GLOBAL_FUNC`, because "some DRMs
+ * depend on RaiseException not altering non-volatile registers"), so a C hook
+ * added to the portable version next to it compiles into a build that never
+ * runs it -- which is exactly the mistake this replaces. Here the stack is
+ * still the thrower's, untouched by any unwinding.
+ *
+ * Its own channel because Office raises and catches C++ exceptions as ordinary
+ * control flow, dozens per second; this is for one question at a time.
+ */
+static void trace_cxx_throw_stack( const EXCEPTION_RECORD *rec, const CONTEXT *context )
+{
+#ifdef __x86_64__
+    CONTEXT ctx = *context;
+    int frame;
+
+    if (rec->ExceptionCode != 0xe06d7363 || rec->NumberParameters < 4) return;
+    if (!TRACE_ON(cxxthrow)) return;
+
+    TRACE_(cxxthrow)( "C++ throw: ThrowInfo %p, module base %p, rva %#Ix\n",
+                      (void *)rec->ExceptionInformation[2],
+                      (void *)rec->ExceptionInformation[3],
+                      rec->ExceptionInformation[2] > rec->ExceptionInformation[3] ?
+                          rec->ExceptionInformation[2] - rec->ExceptionInformation[3] : 0 );
