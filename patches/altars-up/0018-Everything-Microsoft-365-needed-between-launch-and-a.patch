+struct token_result { struct token_result_iface iface; LONG ref; INT status; struct empty_vector *responses; struct provider_error *error; };
+static struct token_result *token_result_from_iface(struct token_result_iface *iface)
+{ return CONTAINING_RECORD(iface,struct token_result,iface); }
+static HRESULT WINAPI token_result_QueryInterface(struct token_result_iface *iface,REFIID iid,void **out)
+{
+    struct token_result *obj=token_result_from_iface(iface);TRACE("token result %p QI %s.\n",obj,debugstr_guid(iid));
+    if(!out)return E_POINTER;if(!IsEqualGUID(iid,&IID_IUnknown)&&!IsEqualGUID(iid,&IID_IInspectable)&&
+       !IsEqualGUID(iid,&IID_IAgileObject)&&!IsEqualGUID(iid,&IID_IWebTokenRequestResult)){*out=NULL;return E_NOINTERFACE;}
