+static HRESULT create_token_result_operation(INT status,IUnknown *item,void **result)
+{
+    struct token_result *payload;struct empty_vector *vector;HRESULT hr;
+    if(!(vector=calloc(1,sizeof(*vector))))return E_OUTOFMEMORY;vector->lpVtbl=&empty_vector_vtbl;vector->ref=1;vector->item=item;if(item)IUnknown_AddRef(item);
+    if(!(payload=calloc(1,sizeof(*payload)))){vector_Release(vector);return E_OUTOFMEMORY;}
+    payload->iface.lpVtbl=&token_result_vtbl;payload->ref=1;payload->status=status;payload->responses=vector;
+    if(FAILED(hr=create_provider_error(0,&payload->error))){token_result_Release(&payload->iface);return hr;}
+    hr=create_object_operation((IUnknown *)&payload->iface,result);token_result_Release(&payload->iface);return hr;
