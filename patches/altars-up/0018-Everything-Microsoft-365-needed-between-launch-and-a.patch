+/* Office asked for the accounts under its client id thirty-five times in one
+ * start-up and was told there were none -- while the same run took sixteen
+ * tokens from us for the account it had just been told did not exist. Report
+ * the one account this prefix holds so the two answers agree. */
+static HRESULT findall_for_provider(void *provider, void **result)
+{
+    struct web_account *account;
+    HRESULT hr;
+
+    if ((hr = create_prefix_account(provider, &account)) != S_OK)
+        return SUCCEEDED(hr) ? create_findall_operation(NULL, result) : hr;
+    hr = create_findall_operation((IUnknown *)&account->iface, result);
+    account_Release(&account->iface);
+    return hr;
+}
+
+static HRESULT WINAPI statics4_FindAllAccountsAsync(struct webauth_statics4 *iface,
+        void *provider, void **result)
+{
+    TRACE("FindAllAccountsAsync iface %p, provider %p, result %p.\n", iface, provider, result);
+    return findall_for_provider(provider, result);
+}
+static HRESULT WINAPI statics4_FindAllAccountsWithClientIdAsync(struct webauth_statics4 *iface,
+        void *provider, HSTRING client_id, void **result)
+{
+    TRACE("FindAllAccountsWithClientIdAsync iface %p, provider %p, client_id %s, result %p.\n",
+          iface, provider, debugstr_hstring(client_id), result);
+    return findall_for_provider(provider, result);
+}
+/* The system-provider trio. The non-system siblings on the statics interface
+ * above already hand back a provider for these same ids, and the object they
+ * return reports IsSystemProvider TRUE -- so refusing here would be two
+ * different answers about one object rather than a missing feature. */
+static HRESULT WINAPI statics4_FindSystemAccountProviderAsync(struct webauth_statics4 *iface,
+        HSTRING provider_id, void **result)
+{
+    TRACE("FindSystemAccountProviderAsync iface %p, provider_id %s, result %p.\n",
+          iface, debugstr_hstring(provider_id), result);
+    return create_provider_operation(provider_id, NULL, result);
+}
+static HRESULT WINAPI statics4_FindSystemAccountProviderWithAuthorityAsync(struct webauth_statics4 *iface,
+        HSTRING provider_id, HSTRING authority, void **result)
+{
+    TRACE("FindSystemAccountProviderWithAuthorityAsync iface %p, provider_id %s, authority %s, result %p.\n",
+          iface, debugstr_hstring(provider_id), debugstr_hstring(authority), result);
+    return create_provider_operation(provider_id, authority, result);
+}
+static HRESULT WINAPI statics4_FindSystemAccountProviderWithAuthorityForUserAsync(struct webauth_statics4 *iface,
+        HSTRING provider_id, HSTRING authority, void *user, void **result)
+{
+    TRACE("FindSystemAccountProviderWithAuthorityForUserAsync iface %p, provider_id %s, authority %s, user %p, result %p.\n",
+          iface, debugstr_hstring(provider_id), debugstr_hstring(authority), user, result);
+    return create_provider_operation(provider_id, authority, result);
+}
+
+static const struct webauth_statics4_vtbl statics4_vtbl =
+{
+    statics4_QueryInterface, statics4_AddRef, statics4_Release,
+    statics4_GetIids, statics4_GetRuntimeClassName, statics4_GetTrustLevel,
+    statics4_FindAllAccountsAsync, statics4_FindAllAccountsWithClientIdAsync,
+    statics4_FindSystemAccountProviderAsync,
+    statics4_FindSystemAccountProviderWithAuthorityAsync,
+    statics4_FindSystemAccountProviderWithAuthorityForUserAsync,
+};
+
+static struct webauth_factory_impl impl =
+{
+    {&factory_vtbl}, {&statics_vtbl}, {&statics4_vtbl}, {&interop_vtbl}, 1,
+};
+
+IActivationFactory *webauth_factory = &impl.IActivationFactory_iface;
