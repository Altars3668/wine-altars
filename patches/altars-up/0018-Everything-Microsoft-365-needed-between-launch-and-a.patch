+static const GUID IID_IWebTokenRequestResult =
+    {0xc12a8305,0xd1f8,0x4483,{0x8d,0x54,0x38,0xfe,0x29,0x27,0x84,0xff}};
+struct token_result_iface;
+struct token_result_vtbl
+{
+    INSPECTABLE_VTBL(struct token_result_iface);
+    HRESULT (WINAPI *get_ResponseData)(struct token_result_iface *, struct empty_vector **);
+    HRESULT (WINAPI *get_ResponseStatus)(struct token_result_iface *, INT *);
+    HRESULT (WINAPI *get_ResponseError)(struct token_result_iface *, void **);
+    HRESULT (WINAPI *InvalidateCacheAsync)(struct token_result_iface *, void **);
+};
