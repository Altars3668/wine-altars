+static HRESULT load_authorized_token(HSTRING scope,HSTRING *token)
+{
+    static const WCHAR dir[]=L"Z:\\tmp\\office-wam-tokens";
+    static const WCHAR legacy[]=L"Z:\\tmp\\office-wam-token.txt";
+    WCHAR path[MAX_PATH],name[512];
+    DWORD attr;
+
+    *token=NULL;
+    attr=GetFileAttributesW(dir);
+    if(attr==INVALID_FILE_ATTRIBUTES||!(attr&FILE_ATTRIBUTE_DIRECTORY))
+    {
+        TRACE("no per-scope token store; falling back to the single-token file.\n");
+        return read_token_file(legacy,token);
+    }
+    scope_file_name(scope,name,ARRAY_SIZE(name));
+    wcscpy(path,dir);wcscat(path,L"\\");wcsncat(path,name,ARRAY_SIZE(path)-ARRAY_SIZE(dir)-8);wcscat(path,L".txt");
+    TRACE("token for scope %s -> %s.\n",debugstr_hstring(scope),debugstr_w(path));
+    return read_token_file(path,token);
+}
+/* 诊断模式直接读取获准采集的原始目录，不再复制一份凭据。
+ * 固定文件名来自 wamprobe 的导出协议，不由请求中的字符串构造。 */
+static HRESULT capture_file_path(const WCHAR *name,WCHAR *path,UINT capacity)
+{
+    DWORD length=GetEnvironmentVariableW(L"WINE_WAM_CAPTURE_DIR",path,capacity);
+
+    if(!length)return S_FALSE;
+    if(length>=capacity || length+1+wcslen(name)>=capacity)
+        return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    if(path[length-1]!='\\')path[length++]='\\';
+    wcscpy(path+length,name);
+    return S_OK;
+}
+
+static BOOL hstring_matches(HSTRING value,const WCHAR *expected)
+{
+    UINT32 len;
+    const WCHAR *text=WindowsGetStringRawBuffer(value,&len);
+    return len==wcslen(expected) && !memcmp(text,expected,len*sizeof(*text));
+}
+
+static BOOL request_property_matches(IMap_HSTRING_HSTRING *properties,
+                                     const WCHAR *name,const WCHAR *expected)
+{
+    HSTRING key=NULL,value=NULL;
+    BOOL match=FALSE;
+
+    if(SUCCEEDED(WindowsCreateString(name,wcslen(name),&key)) &&
+       SUCCEEDED(IMap_HSTRING_HSTRING_Lookup(properties,key,&value)))
+        match=hstring_matches(value,expected);
+    WindowsDeleteString(value);
+    WindowsDeleteString(key);
+    return match;
+}
+
+static HRESULT read_scoped_capture(HSTRING scope,const WCHAR *name,HSTRING *value)
+{
+    WCHAR path[MAX_PATH],folder[128];
+    DWORD len=GetEnvironmentVariableW(L"WINE_WAM_CAPTURE_ROOT",path,ARRAY_SIZE(path));
+
+    *value=NULL;
+    if(!len)return S_FALSE;
+    if(len>=ARRAY_SIZE(path) || WindowsGetStringLen(scope)>=ARRAY_SIZE(folder))
+        return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    scope_file_name(scope,folder,ARRAY_SIZE(folder));
+    if(len+2+wcslen(folder)+wcslen(name)>=ARRAY_SIZE(path))
+        return HRESULT_FROM_WIN32(ERROR_FILENAME_EXCED_RANGE);
+    if(path[len-1]!='\\')path[len++]='\\';
+    wcscpy(path+len,folder);
+    wcscat(path,L"\\");
+    wcscat(path,name);
+    return read_token_file(path,value);
+}
