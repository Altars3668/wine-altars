+    return token_result_for_request(request,WEB_TOKEN_USER_CANCEL,result);
+}
+static HRESULT WINAPI statics_FindAccountAsync(struct webauth_statics *iface, void *provider,
+                                               HSTRING account_id, void **result)
+{
+    struct web_account *account;
+    INT32 order=1;
+    HRESULT hr;
+
+    TRACE("FindAccountAsync iface %p, provider %p, account_id %s, result %p.\n",
+          iface, provider, debugstr_hstring(account_id), result);
+    /* "there is no account with that id" and "this API does not exist" are not
+     * the same answer. More importantly, every broker entry point has to use
+     * WebAccount.Id here; comparing the caller's id to Office's unrelated
+     * licensing CID made token responses and account lookup disagree. */
+    hr=create_prefix_account(provider,&account);
+    if(hr==S_FALSE)return create_object_operation(NULL,result);
+    if(FAILED(hr))return hr;
+    if(account_id)
+        WindowsCompareStringOrdinal(account_id,account->id,&order);
+    if(!order)
+        hr=create_object_operation((IUnknown *)&account->iface,result);
+    else
+        hr=create_object_operation(NULL,result);
+    account_Release(&account->iface);
+    return hr;
+}
+/* Answering FindAccountProvider for every id, including ones this broker has
+ * no business claiming, was tried and reverted -- the note is worth more than
+ * the change was.
+ *
+ * Office asks this for "https://login.windows.local", which on Windows is the
+ * *local or domain* identity the OS itself holds and which nothing here backs.
+ * Returning a WebAccountProvider for it anyway means handing back one whose
+ * Authority is empty, and on the face of it that is the same mistake as
+ * returning S_OK with a null interface (see the WebProviderError comment
+ * above): the caller believes the answer and proceeds.
+ *
+ * So a version of this function that answered null for any id outside
+ * {login.microsoft.com, login.windows.net, login.microsoftonline.com} was
+ * built and measured. It worked -- "not a provider this broker has; answering
+ * null" is the last line in the log -- and Excel then faulted at *exactly* the
+ * same instruction as before, mso30win32client.dll +0x18d410 (`jmp rax`, this
+ * binary's CFG dispatch thunk), with the same access violation. Two different
+ * answers to this call, byte for byte the same crash.
+ *
+ * That is the useful measurement: whatever Excel dies on here does not depend
+ * on what this function returns, so the fault is not on this side of the
+ * boundary and changing this behaviour cannot reach it. Reverted rather than
+ * kept, because it changes what Word's sign-in path is told for no measured
+ * benefit, and an unverified behaviour change in a broker two applications
+ * share is a regression risk with nothing on the other side of the scale. */
+static HRESULT WINAPI statics_FindAccountProviderAsync(struct webauth_statics *iface,HSTRING provider_id,void **result)
+{
+    TRACE("FindAccountProviderAsync iface %p, provider_id %s, result %p.\n",iface,debugstr_hstring(provider_id),result);
+    return create_provider_operation(provider_id,NULL,result);
+}
+static HRESULT WINAPI statics_FindAccountProviderWithAuthorityAsync(struct webauth_statics *iface,
+        HSTRING provider_id, HSTRING authority, void **result)
+{
+    TRACE("FindAccountProviderWithAuthorityAsync iface %p, provider_id %s, authority %s, result %p.\n",
+          iface, debugstr_hstring(provider_id), debugstr_hstring(authority), result);
+    return create_provider_operation(provider_id, authority, result);
+}
+
+static const struct webauth_statics_vtbl statics_vtbl =
+{
+    statics_QueryInterface, statics_AddRef, statics_Release,
+    statics_GetIids, statics_GetRuntimeClassName, statics_GetTrustLevel,
+    statics_GetTokenSilentlyAsync, statics_GetTokenSilentlyWithWebAccountAsync,
+    statics_RequestTokenAsync, statics_RequestTokenWithWebAccountAsync,
+    statics_FindAccountAsync, statics_FindAccountProviderAsync,
+    statics_FindAccountProviderWithAuthorityAsync,
+};
