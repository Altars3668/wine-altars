+static HRESULT create_object_operation(IUnknown *payload, void **result)
+{
+    struct provider_operation *op;
+    if (!result) return E_POINTER;
+    *result = NULL;
+    if (!(op = calloc(1, sizeof(*op)))) return E_OUTOFMEMORY;
+    op->operation_iface.lpVtbl = &async_operation_vtbl;
+    op->info_iface.lpVtbl = &async_info_vtbl;
+    op->ref = 1;
+    op->payload = payload;
+    if (payload) IUnknown_AddRef(payload);
+    *result = &op->operation_iface;
+    TRACE("created completed object operation %p for payload %p.\n", op, payload);
+    return S_OK;
+}
