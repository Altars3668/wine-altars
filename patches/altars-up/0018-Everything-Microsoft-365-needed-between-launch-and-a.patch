+HRESULT d2d_svg_document_create(ID2D1Factory *factory, const D2D1_SIZE_F *viewport_size,
+        ID2D1SvgDocument **document)
+{
+    struct d2d_svg_document *object;
+    struct d2d_svg_element *root;
+    HRESULT hr;
+
+    *document = NULL;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    object->ID2D1SvgDocument_iface.lpVtbl = &d2d_svg_document_vtbl;
+    object->refcount = 1;
+    ID2D1Factory_AddRef(object->factory = factory);
+    list_init(&object->elements);
+    if (viewport_size)
+        object->viewport_size = *viewport_size;
+
+    /* An SVG document always has a root element, and the caller is entitled to
+     * use it right away: GetRoot() cannot report a failure. */
+    if (FAILED(hr = d2d_svg_element_create(object, L"svg", &root)))
+    {
+        ID2D1SvgDocument_Release(&object->ID2D1SvgDocument_iface);
+        return hr;
+    }
+    /* Takes over the initial reference. */
+    object->root = &root->ID2D1SvgElement_iface;
+
+    TRACE("Created SVG document %p.\n", object);
+
+    *document = &object->ID2D1SvgDocument_iface;
+
+    return S_OK;
+}
