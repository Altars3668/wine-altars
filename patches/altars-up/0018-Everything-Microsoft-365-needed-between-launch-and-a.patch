+static HRESULT create_web_account(IUnknown *provider,struct web_account **out)
+{
+    struct web_account *account;
+    HRESULT hr;
+
+    if(!out)return E_POINTER;
+    *out=NULL;
+    if(!(account=calloc(1,sizeof(*account))))return E_OUTOFMEMORY;
+    account->iface.lpVtbl=&account_vtbl;
+    account->iface2.lpVtbl=&account2_vtbl;
+    account->ref=1;
+    account->provider=provider;
+    if(provider)IUnknown_AddRef(provider);
+    if(FAILED(hr=load_account_identity(&account->id,&account->user_name)))
+    {
+        account_Release(&account->iface);
+        return hr;
+    }
+    *out=account;
+    return S_OK;
+}
+
+/* The one account this broker holds. A token response, account enumeration and
+ * FindAccountAsync must all name it with the same broker id. */
+static HRESULT create_prefix_account(void *provider,struct web_account **out)
+{
+    struct web_account *account;
+    HRESULT hr;
+
+    *out=NULL;
+    if(FAILED(hr=create_web_account((IUnknown *)provider,&account)))return hr;
+    if(!WindowsGetStringLen(account->id))
+    {
+        TRACE("no broker account metadata in this prefix.\n");
+        account_Release(&account->iface);
+        return S_FALSE;
+    }
+    *out=account;
+    return S_OK;
+}
+
+static HRESULT create_token_response(void *request,HSTRING token,struct token_response **out)
+{
+    struct token_response *r;struct web_account *a;void *provider=NULL;HRESULT hr;
+    if(!out)return E_POINTER;*out=NULL;if(request)((struct request_probe*)request)->lpVtbl->get_WebAccountProvider((struct request_probe*)request,&provider);
+    hr=create_web_account((IUnknown *)provider,&a);
+    if(provider)IUnknown_Release((IUnknown*)provider);
+    if(FAILED(hr))return hr;
+    if(!(r=calloc(1,sizeof(*r)))){account_Release(&a->iface);return E_OUTOFMEMORY;}r->iface.lpVtbl=&response_vtbl;r->ref=1;r->account=a;
+    if(FAILED(WindowsDuplicateString(token,&r->token))){response_Release(&r->iface);return E_OUTOFMEMORY;}*out=r;return S_OK;
+}
