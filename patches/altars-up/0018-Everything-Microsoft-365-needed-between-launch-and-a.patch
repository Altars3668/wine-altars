+/* 这是固定样本的 A/B 仪器，不是在线 broker。仅允许与该次原生采集
+ * 相同的 provider/client/scope/API 契约，不能把完整封装当作裸 ticket
+ * 返回给旧式调用者；也不生成或改写 token 内的任何字段。 */
+static HRESULT load_captured_token(struct request_probe *request,HSTRING scope,HSTRING *token)
+{
+    struct provider_iface *provider=NULL;
+    struct provider_iface2 *provider2=NULL;
+    IMap_HSTRING_HSTRING *properties=NULL;
+    HSTRING client=NULL,id=NULL,authority=NULL,captured=NULL,primary=NULL;
+    WCHAR path[MAX_PATH];
+    INT32 order;
+    HRESULT hr;
+
+    *token=NULL;
+    /* S_FALSE 只表示未启用采集模式。显式模式中的拒绝不得回退旧存储，
+     * 否则旧存储非空时，不匹配的请求也会被错误地报告为成功。 */
+    if(!GetEnvironmentVariableW(L"WINE_WAM_CAPTURE_DIR",NULL,0) &&
+       !GetEnvironmentVariableW(L"WINE_WAM_CAPTURE_ROOT",NULL,0))return S_FALSE;
+    if((hr=capture_file_path(L"response-0-account-id",path,ARRAY_SIZE(path)))!=S_OK)
+        return hr==S_FALSE ? E_INVALIDARG : hr;
+    if(!request)return E_INVALIDARG;
+    if(FAILED(hr=request->lpVtbl->get_ClientId(request,&client)))goto done;
+    if(!hstring_matches(client,L"00000000480728C5")){hr=E_INVALIDARG;goto done;}
+    if(FAILED(hr=request->lpVtbl->get_WebAccountProvider(request,(void **)&provider)))goto done;
+    if(!provider){hr=E_UNEXPECTED;goto done;}
+    if(FAILED(hr=provider->lpVtbl->get_Id(provider,&id)))goto done;
+    if(!hstring_matches(id,L"https://login.microsoft.com")){hr=E_INVALIDARG;goto done;}
+    if(FAILED(hr=provider->lpVtbl->QueryInterface(provider,&IID_IWebAccountProvider2,(void **)&provider2)))goto done;
+    if(FAILED(hr=provider2->lpVtbl->get_Authority(provider2,&authority)))goto done;
+    if(!hstring_matches(authority,L"consumers")){hr=E_INVALIDARG;goto done;}
+    if(FAILED(hr=request->lpVtbl->get_Properties(request,&properties)))goto done;
+    if(!properties){hr=E_UNEXPECTED;goto done;}
+    if(!request_property_matches(properties,L"api-version",L"2.0") ||
+       !request_property_matches(properties,L"oauth2_batch",L"1") ||
+       !request_property_matches(properties,L"x-client-info",L"1"))
+    {hr=E_INVALIDARG;goto done;}
+    hr=read_scoped_capture(scope,L"request-scope",&captured);
+    if(hr==S_FALSE)
+    {
+        if(!hstring_matches(scope,L"service::ssl.live.com::MBI_SSL_SHORT openid profile"))
+        {hr=E_INVALIDARG;goto done;}
+        if((hr=capture_file_path(L"response-0-token",path,ARRAY_SIZE(path)))!=S_OK)goto done;
+        hr=read_token_file(path,token);
+    }
+    else
+    {
+        if(hr!=S_OK)goto done;
+        if(FAILED(hr=WindowsCompareStringOrdinal(scope,captured,&order)))goto done;
+        if(order){hr=E_INVALIDARG;goto done;}
+        WindowsDeleteString(captured);captured=NULL;
+        if((hr=read_scoped_capture(scope,L"request-client-id",&captured))!=S_OK)goto done;
+        if(FAILED(hr=WindowsCompareStringOrdinal(client,captured,&order)))goto done;
+        if(order){hr=E_INVALIDARG;goto done;}
+        WindowsDeleteString(captured);captured=NULL;
+        if((hr=read_scoped_capture(scope,L"request-profile",&captured))!=S_OK)goto done;
+        if(!hstring_matches(captured,L"office-silent")){hr=E_INVALIDARG;goto done;}
+        WindowsDeleteString(captured);captured=NULL;
+        /* 目录名可能碰撞；还要检查原始 scope、client 和账户，不能错配。 */
+        if((hr=read_scoped_capture(scope,L"response-0-account-id",&captured))!=S_OK)goto done;
+        if((hr=capture_file_path(L"response-0-account-id",path,ARRAY_SIZE(path)))!=S_OK)goto done;
+        if(FAILED(hr=read_token_file(path,&primary)))goto done;
+        if(FAILED(hr=WindowsCompareStringOrdinal(primary,captured,&order)))goto done;
+        if(order){hr=E_INVALIDARG;goto done;}
+        hr=read_scoped_capture(scope,L"response-0-token",token);
+    }
+    TRACE("matched native capture request, hr %#lx, token length %u.\n",hr,WindowsGetStringLen(*token));
+
+done:
+    WindowsDeleteString(captured);
+    WindowsDeleteString(primary);
+    if(properties)IMap_HSTRING_HSTRING_Release(properties);
+    if(provider2)provider2->lpVtbl->Release(provider2);
+    if(provider)provider->lpVtbl->Release(provider);
+    WindowsDeleteString(client);
+    WindowsDeleteString(id);
+    WindowsDeleteString(authority);
+    return hr;
+}
