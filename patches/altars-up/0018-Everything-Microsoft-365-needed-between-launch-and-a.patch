+        LDR_DATA_TABLE_ENTRY *mod = NULL;
+        ULONG64 base = 0, frame_base = 0;
+        void *handler_data;
+
+        if (LdrFindEntryForAddress( (void *)ctx.Rip, &mod ))
+            TRACE_(cxxthrow)( "  #%-2d %p\n", frame, (void *)ctx.Rip );
+        else
+            TRACE_(cxxthrow)( "  #%-2d %p  %s +%#Ix\n", frame, (void *)ctx.Rip,
+                              debugstr_w(mod->BaseDllName.Buffer),
+                              (ULONG_PTR)ctx.Rip - (ULONG_PTR)mod->DllBase );
