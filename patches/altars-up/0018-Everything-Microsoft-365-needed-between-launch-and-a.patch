+HRESULT d3d_device_open_shared_resource(struct d3d_device *device, HANDLE handle, REFIID iid, void **out)
+{
+    struct wined3d_resource_desc wined3d_desc;
+    struct wined3d_resource *wined3d_resource;
+    struct d3d_texture2d *owner, *texture;
+    D3D11_TEXTURE2D_DESC desc;
+    HRESULT hr;
+
+    if (!out)
+        return E_INVALIDARG;
+    *out = NULL;
+
+    if (!(wined3d_resource = wined3d_resource_from_shared_handle(handle)))
+    {
+        WARN("Unknown shared handle %p.\n", handle);
+        return E_INVALIDARG;
+    }
+
+    wined3d_mutex_lock();
+    wined3d_resource_get_desc(wined3d_resource, &wined3d_desc);
+    wined3d_mutex_unlock();
+
+    if (wined3d_desc.resource_type != WINED3D_RTYPE_TEXTURE_2D)
+    {
+        FIXME("Unhandled resource type %#x.\n", wined3d_desc.resource_type);
+        return E_NOTIMPL;
+    }
+
+    if (!(owner = wined3d_resource_get_parent(wined3d_resource)))
+    {
+        WARN("Shared resource %p has no parent.\n", wined3d_resource);
+        return E_FAIL;
+    }
+
+    /* The opening device is a different wined3d device, and wined3d cannot give
+     * two of those one piece of storage: handing over the originating texture
+     * makes every call succeed while the pixels quietly do not cross.  So the
+     * opener gets a texture of its own, and the content moves between them at
+     * the keyed mutex handoff. */
+    desc = owner->desc;
+    /* The opener's copy is never the one GDI draws into, and asking for a
+     * GDI-compatible texture here wedges Word before its main window appears. */
+    desc.MiscFlags &= ~D3D11_RESOURCE_MISC_GDI_COMPATIBLE;
+    if (FAILED(hr = d3d_texture2d_create(device, &desc, NULL, NULL, &texture)))
+    {
+        WARN("Failed to create a texture for shared handle %p, hr %#lx.\n", handle, hr);
+        return hr;
+    }
+
+    if (FAILED(hr = d3d_shared_surface_attach(owner, texture)))
+    {
+        ID3D11Texture2D_Release(&texture->ID3D11Texture2D_iface);
+        return hr;
+    }
+
+    TRACE("Opened handle %p: owner %p on device %p, opened %p on device %p.\n",
+            handle, owner, owner->device, texture, device);
+
+    hr = ID3D11Texture2D_QueryInterface(&texture->ID3D11Texture2D_iface, iid, out);
+    ID3D11Texture2D_Release(&texture->ID3D11Texture2D_iface);
+
+    return hr;
+}
