diff --git a/dlls/d3d11/shared.c b/dlls/d3d11/shared.c
new file mode 100644
index 00000000000..1151c85a923
--- /dev/null
+++ b/dlls/d3d11/shared.c
@@ -0,0 +1,681 @@
+/*
+ * Surfaces shared between D3D devices.
+ *
+ * A texture created with D3D11_RESOURCE_MISC_SHARED* is handed to a second
+ * device by handle, and the two devices hand it back and forth through an
+ * IDXGIKeyedMutex.  Office's UI compositor is built on exactly this: it renders
+ * its text and icons on one device and composites them on another.
+ *
+ * Wine cannot give two wined3d devices one piece of storage -- a wined3d
+ * texture's GL object belongs to the context that created it, and handing the
+ * same texture to a second device makes every call succeed while the pixels
+ * quietly do not cross (tools/d3dshare in the wine-altars tree measures this).
+ * So each participant gets a texture of its own and the content is moved
+ * between them at the point the keyed mutex already defines: whoever acquires
+ * the surface gets the pixels of whoever released it last.
+ *
+ * That costs a round trip through system memory per handoff.  It is the honest
+ * price of not having shared storage, and it is paid only by surfaces an
+ * application actually shares.
+ *
+ * The half of that round trip that reads a texture is done in ReleaseSync and
+ * the half that writes one in AcquireSync, so that each of them runs on the
+ * thread that owns the device it touches.  The first version of this file did
+ * both halves at AcquireSync, which meant the acquiring thread issued
+ * CopyResource and Map against the *releasing* device's immediate context --
+ * a context that belongs to another thread.  D3D11 immediate contexts are
+ * single-threaded by contract; Wine's global lock stops that from corrupting
+ * anything, and it does not order the copy against the work the owning thread
+ * has already queued, so the copy could read a texture the owner had not
+ * finished drawing.  Measured under Word: three 2048x1280 atlases, 55 handoffs
+ * per start-up, every one of them crossing threads that way, and about one
+ * start-up in three came up with a whole group of UI elements -- the title bar,
+ * the Backstage navigation rail -- composited solid black.  Hardware GL only:
+ * under llvmpipe, and under +d3d11 tracing, it never reproduced.
+ */
+
+#include <stdio.h>
+
+#include "d3d11_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d3d11);
+
+struct d3d_shared_surface
+{
+    LONG refcount;
+
+    CRITICAL_SECTION cs;
+    CONDITION_VARIABLE cv;
+    UINT64 key;
+    BOOL acquired;
+
+    /* The current pixels.  A texture cannot be the carrier: it belongs to one
+     * device, and reading it from another device's thread is the bug this
+     * file's header describes.  System memory belongs to nobody, so both
+     * halves of the handoff can run on the right thread. */
+    void *bits;
+    UINT pitch, rows, generation;
+    struct d3d_texture2d *owner;
+
+    struct list textures;
+};
+
+static struct d3d_shared_surface *shared_surface_create(void)
+{
+    struct d3d_shared_surface *shared;
+
+    if (!(shared = calloc(1, sizeof(*shared))))
+        return NULL;
+
+    shared->refcount = 1;
+    InitializeCriticalSection(&shared->cs);
+    InitializeConditionVariable(&shared->cv);
+    list_init(&shared->textures);
+
+    return shared;
+}
+
+static void shared_surface_decref(struct d3d_shared_surface *shared)
+{
+    if (InterlockedDecrement(&shared->refcount))
+        return;
+    DeleteCriticalSection(&shared->cs);
+    free(shared->bits);
+    free(shared);
+}
+
+/* The texture's own device's immediate context.  Released by the caller. */
+static ID3D11DeviceContext *texture_context(struct d3d_texture2d *texture)
+{
+    ID3D11DeviceContext *context = NULL;
+    ID3D11Device5_GetImmediateContext(texture->device, &context);
+    return context;
+}
+
+static HRESULT texture_get_staging(struct d3d_texture2d *texture, UINT cpu_access,
+        ID3D11Texture2D **staging)
+{
+    ID3D11Texture2D **cache = cpu_access == D3D11_CPU_ACCESS_READ
+            ? &texture->staging_read : &texture->staging_write;
+    D3D11_TEXTURE2D_DESC desc;
+    HRESULT hr;
+
+    if (*cache)
+    {
+        *staging = *cache;
+        return S_OK;
+    }
+
+    desc = texture->desc;
+    desc.MipLevels = 1;
+    desc.ArraySize = 1;
+    desc.Usage = D3D11_USAGE_STAGING;
+    desc.BindFlags = 0;
+    desc.CPUAccessFlags = cpu_access;
+    desc.MiscFlags = 0;
+
+    if (FAILED(hr = ID3D11Device5_CreateTexture2D(texture->device, &desc, NULL, cache)))
+    {
+        WARN("Failed to create a staging texture, hr %#lx.\n", hr);
+        return hr;
+    }
+
+    *staging = *cache;
+    return S_OK;
+}
+
+/* Copy this texture's pixels into the shared buffer.  Called from ReleaseSync,
+ * which is to say: on the thread that owns this texture's device, after
+ * everything that thread drew into it, and while this participant still holds
+ * the surface so nobody can read the buffer half-written. */
+static HRESULT shared_surface_readback(struct d3d_shared_surface *shared, struct d3d_texture2d *texture)
+{
+    ID3D11DeviceContext *context;
+    D3D11_MAPPED_SUBRESOURCE map;
+    ID3D11Texture2D *staging;
+    unsigned int y, rows, row;
+    HRESULT hr;
+
+    if (FAILED(hr = texture_get_staging(texture, D3D11_CPU_ACCESS_READ, &staging)))
+        return hr;
+    if (!(context = texture_context(texture)))
+        return E_FAIL;
+
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)staging,
+            (ID3D11Resource *)&texture->ID3D11Texture2D_iface);
+    if (FAILED(hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging,
+            0, D3D11_MAP_READ, 0, &map)))
+    {
+        WARN("Failed to map the staging texture for reading, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(context);
+        return hr;
+    }
+
+    rows = texture->desc.Height;
+    if (!shared->bits)
+    {
+        if (!(shared->bits = malloc((size_t)map.RowPitch * rows)))
+        {
+            ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+            ID3D11DeviceContext_Release(context);
+            return E_OUTOFMEMORY;
+        }
+        shared->pitch = map.RowPitch;
+        shared->rows = rows;
+    }
+
+    row = min(map.RowPitch, shared->pitch);
+    rows = min(rows, shared->rows);
+    for (y = 0; y < rows; ++y)
+        memcpy((char *)shared->bits + (size_t)y * shared->pitch,
+                (const char *)map.pData + (size_t)y * map.RowPitch, row);
+
+    ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+    ID3D11DeviceContext_Release(context);
+
+    /* altars diagnostic: with WINE_ALTARS_DUMP_ATLAS set, write each snapshot
+     * out as a PPM.  Office composites its UI from these atlases, so "is the
+     * label in the atlas and not on the screen, or never in the atlas at all"
+     * is the question that splits a compositing bug from a rasterising one,
+     * and this is the only place the whole atlas is already in system memory
+     * on the CPU.  Off unless asked for: it writes ~8MB a frame. */
+    if (getenv("WINE_ALTARS_DUMP_ATLAS"))
+    {
+        static LONG dumped;
+        LONG n = InterlockedIncrement(&dumped);
+
+        if (n <= 24)
+        {
+            char path[256];
+            FILE *f;
+
+            sprintf(path, "/tmp/altars-atlas-%p-%02ld.ppm", texture, (long)n);
+            if ((f = fopen(path, "wb")))
+            {
+                unsigned int px;
+
+                fprintf(f, "P6\n%u %u\n255\n", texture->desc.Width, rows);
+                for (y = 0; y < rows; ++y)
+                {
+                    const unsigned char *line = (const unsigned char *)shared->bits
+                            + (size_t)y * shared->pitch;
+                    for (px = 0; px < texture->desc.Width; ++px)
+                        fwrite((const char[]){ line[px * 4 + 2], line[px * 4 + 1],
+                                line[px * 4] }, 1, 3, f);
+                }
+                fclose(f);
+                TRACE("altars-atlas dumped %s.\n", path);
+            }
+
+            /* And the alpha plane on its own.  These atlases are premultiplied
+             * BGRA: black text at full coverage is (0,0,0,255), which is
+             * indistinguishable from "nothing here" in the colour dump above
+             * and perfectly visible here.  Reading only the colour channels
+             * once produced a confident and wrong "the label never reaches the
+             * atlas". */
+            sprintf(path, "/tmp/altars-atlas-%p-%02ld.pgm", texture, (long)n);
+            if ((f = fopen(path, "wb")))
+            {
+                fprintf(f, "P5\n%u %u\n255\n", texture->desc.Width, rows);
+                for (y = 0; y < rows; ++y)
+                {
+                    const unsigned char *line = (const unsigned char *)shared->bits
+                            + (size_t)y * shared->pitch;
+                    unsigned int px;
+
+                    for (px = 0; px < texture->desc.Width; ++px)
+                        fputc(line[px * 4 + 3], f);
+                }
+                fclose(f);
+            }
+        }
+    }
+
+    TRACE("Read %ux%u out of texture %p into shared state %p.\n",
+            texture->desc.Width, rows, texture, shared);
+    return S_OK;
+}
+
+/* The other half: the shared buffer into this texture, from AcquireSync, on
+ * the thread that owns this texture's device. */
+static HRESULT shared_surface_upload(struct d3d_shared_surface *shared, struct d3d_texture2d *texture)
+{
+    ID3D11DeviceContext *context;
+    D3D11_MAPPED_SUBRESOURCE map;
+    ID3D11Texture2D *staging;
+    unsigned int y, rows, row;
+    HRESULT hr;
+
+    if (texture->desc.Height != shared->rows)
+    {
+        WARN("Texture %p is %u rows, the shared buffer is %u.\n", texture,
+                texture->desc.Height, shared->rows);
+        return E_INVALIDARG;
+    }
+
+    if (FAILED(hr = texture_get_staging(texture, D3D11_CPU_ACCESS_WRITE, &staging)))
+        return hr;
+    if (!(context = texture_context(texture)))
+        return E_FAIL;
+
+    if (FAILED(hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging,
+            0, D3D11_MAP_WRITE, 0, &map)))
+    {
+        WARN("Failed to map the staging texture for writing, hr %#lx.\n", hr);
+        ID3D11DeviceContext_Release(context);
+        return hr;
+    }
+
+    row = min(map.RowPitch, shared->pitch);
+    rows = min(texture->desc.Height, shared->rows);
+    for (y = 0; y < rows; ++y)
+        memcpy((char *)map.pData + (size_t)y * map.RowPitch,
+                (const char *)shared->bits + (size_t)y * shared->pitch, row);
+
+    ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)&texture->ID3D11Texture2D_iface,
+            (ID3D11Resource *)staging);
+    ID3D11DeviceContext_Release(context);
+
+    TRACE("Wrote %ux%u into texture %p from shared state %p.\n",
+            texture->desc.Width, rows, texture, shared);
+    return S_OK;
+}
+
+/* altars diagnostic: write any texture out, through a staging copy on its own
+ * device's context.  0016 can only dump a surface that is shared, because that
+ * is the only one whose pixels this file already has in system memory; Office's
+ * composite samples a 2048x2048 cache texture that is not shared with anybody
+ * and never has a render target view, so it needed its own way out. */
+void d3d_texture2d_dump(struct d3d_texture2d *texture, const char *tag, unsigned int seq)
+{
+    ID3D11DeviceContext *context;
+    D3D11_MAPPED_SUBRESOURCE map;
+    ID3D11Texture2D *staging;
+    unsigned int y, px;
+    char path[256];
+    FILE *f;
+
+    if (FAILED(texture_get_staging(texture, D3D11_CPU_ACCESS_READ, &staging)))
+        return;
+    if (!(context = texture_context(texture)))
+        return;
+
+    ID3D11DeviceContext_CopyResource(context, (ID3D11Resource *)staging,
+            (ID3D11Resource *)&texture->ID3D11Texture2D_iface);
+    if (FAILED(ID3D11DeviceContext_Map(context, (ID3D11Resource *)staging, 0, D3D11_MAP_READ, 0, &map)))
+    {
+        ID3D11DeviceContext_Release(context);
+        return;
+    }
+
+    sprintf(path, "/tmp/altars-%s-%p-%03u.ppm", tag, texture, seq);
+    if ((f = fopen(path, "wb")))
+    {
+        fprintf(f, "P6\n%u %u\n255\n", texture->desc.Width, texture->desc.Height);
+        for (y = 0; y < texture->desc.Height; ++y)
+        {
+            const unsigned char *line = (const unsigned char *)map.pData + (size_t)y * map.RowPitch;
+            for (px = 0; px < texture->desc.Width; ++px)
+                fwrite((const char[]){ line[px * 4 + 2], line[px * 4 + 1], line[px * 4] }, 1, 3, f);
+        }
+        fclose(f);
+    }
+    sprintf(path, "/tmp/altars-%s-%p-%03u.pgm", tag, texture, seq);
+    if ((f = fopen(path, "wb")))
+    {
+        fprintf(f, "P5\n%u %u\n255\n", texture->desc.Width, texture->desc.Height);
+        for (y = 0; y < texture->desc.Height; ++y)
+        {
+            const unsigned char *line = (const unsigned char *)map.pData + (size_t)y * map.RowPitch;
+            for (px = 0; px < texture->desc.Width; ++px)
+                fputc(line[px * 4 + 3], f);
+        }
+        fclose(f);
+    }
+    TRACE("altars-dump wrote %s.\n", path);
+
+    ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)staging, 0);
+    ID3D11DeviceContext_Release(context);
+}
+
+/* A participant that only reads a shared surface must not make the other side's
+ * copy look stale: if it did, the next acquire on that side would upload this
+ * one's copy over whatever it had drawn in the meantime and destroy it.  So the
+ * carry is driven by "was this texture written to", which is what this marks.
+ * Over-marking is harmless -- it costs one readback -- so binding as a render
+ * target counts, without waiting to see whether a draw followed. */
+void d3d_shared_resource_mark_dirty(ID3D11Resource *resource)
+{
+    struct d3d_texture2d *texture;
+    ID3D11Texture2D *tex2d;
+
+    if (!resource)
+        return;
+    if (FAILED(ID3D11Resource_QueryInterface(resource, &IID_ID3D11Texture2D, (void **)&tex2d)))
+        return;
+    if ((texture = unsafe_impl_from_ID3D11Texture2D(tex2d)) && texture->shared)
+        texture->shared_dirty = TRUE;
+    ID3D11Texture2D_Release(tex2d);
+}
+
+/* IDXGIKeyedMutex, one per participating texture, all over the same state. */
+
+static inline struct d3d_texture2d *impl_from_IDXGIKeyedMutex(IDXGIKeyedMutex *iface)
+{
+    return CONTAINING_RECORD(iface, struct d3d_texture2d, IDXGIKeyedMutex_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_QueryInterface(IDXGIKeyedMutex *iface,
+        REFIID riid, void **out)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_QueryInterface(&texture->ID3D11Texture2D_iface, riid, out);
+}
+
+static ULONG STDMETHODCALLTYPE d3d_keyed_mutex_AddRef(IDXGIKeyedMutex *iface)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_AddRef(&texture->ID3D11Texture2D_iface);
+}
+
+static ULONG STDMETHODCALLTYPE d3d_keyed_mutex_Release(IDXGIKeyedMutex *iface)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_Release(&texture->ID3D11Texture2D_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_SetPrivateData(IDXGIKeyedMutex *iface,
+        REFGUID guid, UINT size, const void *data)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_SetPrivateData(&texture->ID3D11Texture2D_iface, guid, size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_SetPrivateDataInterface(IDXGIKeyedMutex *iface,
+        REFGUID guid, const IUnknown *object)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_SetPrivateDataInterface(&texture->ID3D11Texture2D_iface, guid, object);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_GetPrivateData(IDXGIKeyedMutex *iface,
+        REFGUID guid, UINT *size, void *data)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Texture2D_GetPrivateData(&texture->ID3D11Texture2D_iface, guid, size, data);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_GetParent(IDXGIKeyedMutex *iface,
+        REFIID riid, void **parent)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Device5_QueryInterface(texture->device, riid, parent);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_GetDevice(IDXGIKeyedMutex *iface,
+        REFIID riid, void **device)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    return ID3D11Device5_QueryInterface(texture->device, riid, device);
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_AcquireSync(IDXGIKeyedMutex *iface,
+        UINT64 key, DWORD timeout)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    struct d3d_shared_surface *shared = texture->shared;
+    DWORD start = GetTickCount(), remaining = timeout, content_deadline;
+    BOOL waited_for_content = FALSE;
+    UINT generation = 0;
+    BOOL stale = FALSE;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, key %s, timeout %lu, texture %p %ux%u.\n", iface, wine_dbgstr_longlong(key), timeout,
+            texture, texture->desc.Width, texture->desc.Height);
+
+    if (!shared)
+        return E_FAIL;
+
+    EnterCriticalSection(&shared->cs);
+    /* A participant that did not create this surface, taking it before anything
+     * has ever been carried into it, composites from a texture that has never
+     * held pixels -- on Windows it would have seen the creator's live pixels,
+     * because there the storage really is shared and there is nothing to carry.
+     * So give the creator a short chance to get there first.
+     *
+     * Bounded on purpose, and it never extends the caller's own timeout.  The
+     * creator may itself be waiting for a key only this participant can
+     * release, and waiting for content in that position is a deadlock; waiting
+     * for a quarter of a second is a late frame.  The surface is deliberately
+     * not taken while this waits, so the creator can acquire it. */
+    content_deadline = GetTickCount() + (timeout ? 250 : 0);
+    for (;;)
+    {
+        BOOL blocked = shared->acquired || shared->key != key;
+        BOOL want_content = !shared->bits && texture != shared->owner
+                && (int)(content_deadline - GetTickCount()) > 0;
+        DWORD slice;
+
+        if (!blocked && !want_content)
+            break;
+
+        if (want_content && !waited_for_content)
+        {
+            waited_for_content = TRUE;
+            WARN("altars-content-wait texture %p waiting for surface %p to be written by its owner %p.\n",
+                    texture, shared, shared->owner);
+        }
+
+        if (timeout != INFINITE)
+        {
+            DWORD elapsed = GetTickCount() - start;
+
+            remaining = elapsed >= timeout ? 0 : timeout - elapsed;
+        }
+        slice = remaining;
+        if (want_content)
+        {
+            DWORD content_left = content_deadline - GetTickCount();
+
+            if (slice == INFINITE || content_left < slice)
+                slice = content_left;
+        }
+
+        if (!SleepConditionVariableCS(&shared->cv, &shared->cs, slice))
+        {
+            /* Only the caller's own timeout ends this; a content slice running
+             * out just means we stop waiting for content and take the surface. */
+            if (timeout != INFINITE && GetTickCount() - start >= timeout)
+            {
+                LeaveCriticalSection(&shared->cs);
+                return WAIT_TIMEOUT;
+            }
+        }
+    }
+    shared->acquired = TRUE;
+    if (waited_for_content && shared->bits)
+        WARN("altars-content-wait texture %p got surface %p after waiting.\n", texture, shared);
+    if (!shared->bits && texture != shared->owner)
+        WARN("altars-empty-acquire texture %p took surface %p with nothing in it after waiting; "
+                "its owner %p never released.\n", texture, shared, shared->owner);
+    generation = shared->generation;
+    /* Not if this texture has been drawn into since: uploading over it would
+     * throw that away, and there is no way to merge the two. */
+    stale = shared->bits && texture->shared_generation != generation && !texture->shared_dirty;
+    LeaveCriticalSection(&shared->cs);
+
+    /* Outside the lock: this touches only our own device's context, and no
+     * other participant can acquire the surface while we hold it. */
+    if (stale && SUCCEEDED(hr = shared_surface_upload(shared, texture)))
+    {
+        texture->shared_generation = generation;
+        texture->shared_dirty = FALSE;
+    }
+
+    return hr;
+}
+
+static HRESULT STDMETHODCALLTYPE d3d_keyed_mutex_ReleaseSync(IDXGIKeyedMutex *iface, UINT64 key)
+{
+    struct d3d_texture2d *texture = impl_from_IDXGIKeyedMutex(iface);
+    struct d3d_shared_surface *shared = texture->shared;
+    BOOL others;
+    HRESULT hr = S_OK;
+
+    TRACE("iface %p, key %s, texture %p %ux%u.\n", iface, wine_dbgstr_longlong(key),
+            texture, texture->desc.Width, texture->desc.Height);
+
+    if (!shared)
+        return E_FAIL;
+
+    EnterCriticalSection(&shared->cs);
+    if (!shared->acquired)
+    {
+        LeaveCriticalSection(&shared->cs);
+        WARN("Released without being acquired.\n");
+        return E_FAIL;
+    }
+    /* Carry whenever this participant actually wrote.  It is tempting to skip
+     * that while the surface has only one participant -- nobody to carry to
+     * yet -- and that is wrong: the second participant opens the surface after
+     * the first has already drawn into it, and with the content dropped it
+     * acquires an empty texture and composites from it.  Measured under Word:
+     * the glyph tiles for the Backstage rail are copied out of the shared
+     * atlas by the compositing device on a texture with generation 0, i.e.
+     * one that had never been given anything, while the renderer had drawn
+     * and released before the opener existed.  A participant that only read
+     * the surface is still skipped -- that is what shared_dirty is for. */
+    others = texture->shared_dirty;
+    LeaveCriticalSection(&shared->cs);
+
+    /* Whoever held it may have drawn, so its pixels are the ones that matter
+     * from here on.  Copy them out now, before the flag below lets anyone else
+     * in: we are still the holder, and -- the point of doing it here -- we are
+     * the thread that owns this texture's device. */
+    if (others)
+        hr = shared_surface_readback(shared, texture);
+
+    EnterCriticalSection(&shared->cs);
+    {
+        if (SUCCEEDED(hr) && others)
+        {
+            texture->shared_generation = ++shared->generation;
+            texture->shared_dirty = FALSE;
+        }
+        shared->acquired = FALSE;
+        shared->key = key;
+        WakeAllConditionVariable(&shared->cv);
+    }
+    LeaveCriticalSection(&shared->cs);
+
+    return hr;
+}
+
+static const struct IDXGIKeyedMutexVtbl d3d_keyed_mutex_vtbl =
+{
+    d3d_keyed_mutex_QueryInterface,
+    d3d_keyed_mutex_AddRef,
+    d3d_keyed_mutex_Release,
+    d3d_keyed_mutex_SetPrivateData,
+    d3d_keyed_mutex_SetPrivateDataInterface,
+    d3d_keyed_mutex_GetPrivateData,
+    d3d_keyed_mutex_GetParent,
+    d3d_keyed_mutex_GetDevice,
+    d3d_keyed_mutex_AcquireSync,
+    d3d_keyed_mutex_ReleaseSync,
+};
+
+static BOOL texture_is_shared(const struct d3d_texture2d *texture)
+{
+    return !!(texture->desc.MiscFlags & (D3D11_RESOURCE_MISC_SHARED
+            | D3D11_RESOURCE_MISC_SHARED_KEYEDMUTEX | D3D11_RESOURCE_MISC_SHARED_NTHANDLE));
+}
+
+/* Give this texture shared state, creating it if this is the first participant. */
+static struct d3d_shared_surface *texture_get_shared(struct d3d_texture2d *texture)
+{
+    struct d3d_shared_surface *shared;
+
+    if (texture->shared)
+        return texture->shared;
+
+    if (!(shared = shared_surface_create()))
+        return NULL;
+
+    texture->shared = shared;
+    texture->IDXGIKeyedMutex_iface.lpVtbl = &d3d_keyed_mutex_vtbl;
+    shared->owner = texture;
+    list_add_tail(&shared->textures, &texture->shared_entry);
+
+    /* No pixels yet.  They arrive at the first ReleaseSync, which is also the
+     * first moment they can be read on the right thread -- and the keyed-mutex
+     * protocol puts that release before any other participant's acquire, since
+     * the surface starts on key 0 and only the owner asks for that. */
+
+    TRACE("Created shared state %p for texture %p %ux%u.\n", shared, texture,
+            texture->desc.Width, texture->desc.Height);
+
+    return shared;
+}
+
+HRESULT d3d_shared_surface_attach(struct d3d_texture2d *owner, struct d3d_texture2d *texture)
+{
+    struct d3d_shared_surface *shared;
+
+    if (!(shared = texture_get_shared(owner)))
+        return E_OUTOFMEMORY;
+
+    InterlockedIncrement(&shared->refcount);
+    texture->shared = shared;
+    texture->IDXGIKeyedMutex_iface.lpVtbl = &d3d_keyed_mutex_vtbl;
+
+    EnterCriticalSection(&shared->cs);
+    list_add_tail(&shared->textures, &texture->shared_entry);
+    LeaveCriticalSection(&shared->cs);
+
+    TRACE("Attached texture %p %ux%u to shared state %p (owner %p).\n", texture,
+            texture->desc.Width, texture->desc.Height, shared, owner);
+
+    return S_OK;
+}
+
+HRESULT d3d_texture2d_get_keyed_mutex(struct d3d_texture2d *texture, void **out)
+{
+    if (!texture_is_shared(texture))
+        return E_NOINTERFACE;
+
+    if (!texture_get_shared(texture))
+        return E_OUTOFMEMORY;
+
+    ID3D11Texture2D_AddRef(&texture->ID3D11Texture2D_iface);
+    *out = &texture->IDXGIKeyedMutex_iface;
+
+    return S_OK;
+}
+
+void d3d_texture2d_cleanup_shared(struct d3d_texture2d *texture)
+{
+    struct d3d_shared_surface *shared = texture->shared;
+
+    if (texture->staging_read)
+    {
+        ID3D11Texture2D_Release(texture->staging_read);
