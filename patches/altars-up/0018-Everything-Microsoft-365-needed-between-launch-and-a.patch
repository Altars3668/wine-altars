+/******************************************************************
+ *		dump_stack_scan
+ *
+ * Diagnostic only. Print the qwords near RSP that point into a loaded
+ * module's code, with the module they belong to and their offset in it.
+ *
+ * Written because winedbg's own backtrace does not appear for these faults
+ * (it starts, prints two dbghelp fixmes, and stops), and because the faults
+ * this is aimed at land inside a *CFG dispatch thunk* -- three bytes,
+ * `jmp rax` -- which has no useful unwind info, so a proper RtlVirtualUnwind
+ * from there cannot walk out either. A raw scan needs neither: the `call`
+ * that entered the thunk pushed its return address and it is still sitting
+ * at the top of the stack, and the frames above it are still there too.
+ *
+ * It is a scan, so it prints stale addresses as well as live ones. Read it
+ * as "these functions are somewhere in this thread's recent history", not as
+ * an exact call chain -- the first one or two entries are the ones that
+ * matter, and they are the ones a thunk-shaped fault otherwise hides.
+ */
+static void stack_scan_from( const ULONG_PTR *sp, const char *what )
+{
+#ifdef __x86_64__
+    const NT_TIB *tib = (const NT_TIB *)NtCurrentTeb();
+    const ULONG_PTR *limit;
+    int shown = 0, i;
+
+    limit = (const ULONG_PTR *)tib->StackBase;
+    if (sp < (const ULONG_PTR *)tib->StackLimit || sp >= limit) return;
+
+    MESSAGE( "wine: stack scan for %s from %p:\n", what, sp );
+    for (i = 0; sp + i < limit && i < 256 && shown < 20; i++)
+    {
+        ULONG_PTR v = sp[i];
+        void *base = NULL;
+        WCHAR path[MAX_PATH];
+        const WCHAR *name;
+
+        if (v < 0x10000) continue;
+        if (!RtlPcToFileHeader( (void *)v, &base ) || !base) continue;
+        if (!GetModuleFileNameW( base, path, ARRAY_SIZE(path) )) continue;
+        name = wcsrchr( path, '\\' );
+        name = name ? name + 1 : path;
+        MESSAGE( "wine:   %p  %s +0x%Ix\n", (void *)v,
+                 debugstr_w(name), (ULONG_PTR)v - (ULONG_PTR)base );
+        shown++;
+    }
+#endif
+}
+
+static void dump_stack_scan( const EXCEPTION_POINTERS *ptr )
+{
+#ifdef __x86_64__
+    if (!ptr->ContextRecord) return;
+    stack_scan_from( (const ULONG_PTR *)ptr->ContextRecord->Rsp, "the fault" );
+#endif
+}
