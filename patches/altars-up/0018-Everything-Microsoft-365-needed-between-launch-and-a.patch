+static HRESULT STDMETHODCALLTYPE d2d_svg_document_SetRoot(ID2D1SvgDocument *iface, ID2D1SvgElement *root)
+{
+    struct d2d_svg_document *document = impl_from_ID2D1SvgDocument(iface);
+    struct d2d_svg_element *element = NULL;
+
+    TRACE("iface %p, root %p.\n", iface, root);
+
+    if (root)
+    {
+        if (!(element = unsafe_impl_from_ID2D1SvgElement(root)) || element->document != document
+                || element->parent)
+            return E_INVALIDARG;
+    }
+
+    if (root)
+        ID2D1SvgElement_AddRef(root);
+    if (document->root)
+        ID2D1SvgElement_Release(document->root);
+    document->root = root;
+
+    return S_OK;
+}
