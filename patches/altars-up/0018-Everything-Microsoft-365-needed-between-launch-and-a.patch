+/* Office does not ask for "a token", it asks for a token for a scope: sixteen
+ * requests in one start-up, ten of them for
+ * service::officeapps.live.com::MBI_SSL_SHORT and the rest for graph, the
+ * consent service, ads and ssl.live.com. Handing the same string back for
+ * every one of them is not a broker, it is a fixed answer shaped like a token,
+ * and a service is entitled to reject a ticket minted for someone else's
+ * audience -- which from here would be indistinguishable from a bad token.
+ *
+ * So: one file per scope under Z:\tmp\office-wam-tokens. When that directory
+ * exists it is the whole truth, and a scope with no file has no token. The
+ * single-file form is still read when the directory is absent, so a prefix set
+ * up the old way keeps working. */
+static void scope_file_name(HSTRING scope,WCHAR *out,UINT32 max)
+{
+    const WCHAR *s;UINT32 len=0,i,n=0;
+    s=WindowsGetStringRawBuffer(scope,&len);
+    for(i=0;i<len&&n+1<max;i++)
+    {
+        WCHAR c=s[i];
+        out[n++]=(c=='.'||c=='-'||c=='_'||(c>='0'&&c<='9')||(c>='A'&&c<='Z')||(c>='a'&&c<='z'))?c:'_';
+    }
+    out[n]=0;
+}
