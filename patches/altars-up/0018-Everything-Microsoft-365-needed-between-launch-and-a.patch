+            ctx.Rip = *(ULONG64 *)ctx.Rsp;
+            ctx.Rsp += sizeof(ULONG64);
+            continue;
+        }
+        RtlVirtualUnwind( UNW_FLAG_NHANDLER, base, ctx.Rip, func,
+                          &ctx, &handler_data, &frame_base, NULL );
+    }
+#endif
+}
