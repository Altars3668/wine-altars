+static ULONG WINAPI token_result_AddRef(struct token_result_iface *iface)
+{return InterlockedIncrement(&token_result_from_iface(iface)->ref);}
+static ULONG WINAPI token_result_Release(struct token_result_iface *iface)
+{struct token_result *obj=token_result_from_iface(iface);ULONG ref=InterlockedDecrement(&obj->ref);if(!ref){vector_Release(obj->responses);if(obj->error)provider_error_Release(&obj->error->iface);free(obj);}return ref;}
+static HRESULT WINAPI token_result_GetIids(struct token_result_iface *iface,ULONG *c,IID **i){return E_NOTIMPL;}
+static HRESULT WINAPI token_result_GetRuntimeClassName(struct token_result_iface *iface,HSTRING *name)
+{static const WCHAR n[]=L"Windows.Security.Authentication.Web.Core.WebTokenRequestResult";return WindowsCreateString(n,ARRAY_SIZE(n)-1,name);}
+static HRESULT WINAPI token_result_GetTrustLevel(struct token_result_iface *iface,TrustLevel *level){*level=BaseTrust;return S_OK;}
+static HRESULT WINAPI token_result_get_ResponseData(struct token_result_iface *iface,struct empty_vector **responses)
+{struct token_result *obj=token_result_from_iface(iface);TRACE("token result %p get responses %p.\n",obj,responses);if(!responses)return E_POINTER;*responses=obj->responses;vector_AddRef(*responses);return S_OK;}
+static HRESULT WINAPI token_result_get_ResponseStatus(struct token_result_iface *iface,INT *status)
+{struct token_result *obj=token_result_from_iface(iface);TRACE("token result %p status %d.\n",obj,obj->status);if(!status)return E_POINTER;*status=obj->status;return S_OK;}
