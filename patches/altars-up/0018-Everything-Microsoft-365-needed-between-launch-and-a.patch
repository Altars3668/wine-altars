+
+#include "d2d1_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(d2d);
+
+static const struct ID2D1SvgElementVtbl d2d_svg_element_vtbl;
+static const struct ID2D1SvgDocumentVtbl d2d_svg_document_vtbl;
+
+static inline struct d2d_svg_element *impl_from_ID2D1SvgElement(ID2D1SvgElement *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_svg_element, ID2D1SvgElement_iface);
+}
+
+static inline struct d2d_svg_document *impl_from_ID2D1SvgDocument(ID2D1SvgDocument *iface)
+{
+    return CONTAINING_RECORD(iface, struct d2d_svg_document, ID2D1SvgDocument_iface);
+}
+
+/* Returns NULL for foreign implementations instead of asserting: the SVG DOM
+ * methods take element pointers straight from the application. */
+static struct d2d_svg_element *unsafe_impl_from_ID2D1SvgElement(ID2D1SvgElement *iface)
+{
+    if (!iface || (const struct ID2D1SvgElementVtbl *)iface->lpVtbl != &d2d_svg_element_vtbl)
+        return NULL;
+    return impl_from_ID2D1SvgElement(iface);
+}
+
+static BOOL d2d_svg_element_has_ancestor(const struct d2d_svg_element *element,
+        const struct d2d_svg_element *candidate)
+{
+    const struct d2d_svg_element *e;
+
+    for (e = element; e; e = e->parent)
+    {
+        if (e == candidate)
+            return TRUE;
+    }
+
+    return FALSE;
+}
+
+static HRESULT d2d_svg_element_create(struct d2d_svg_document *document, const WCHAR *tag_name,
+        struct d2d_svg_element **element);
+
+/* -------------------------------------------------------------------------
+ * ID2D1SvgElement
+ * ------------------------------------------------------------------------- */
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_QueryInterface(ID2D1SvgElement *iface, REFIID iid, void **out)
+{
+    TRACE("iface %p, iid %s, out %p.\n", iface, debugstr_guid(iid), out);
+
+    if (IsEqualGUID(iid, &IID_ID2D1SvgElement)
+            || IsEqualGUID(iid, &IID_ID2D1Resource)
+            || IsEqualGUID(iid, &IID_IUnknown))
+    {
+        ID2D1SvgElement_AddRef(iface);
+        *out = iface;
+        return S_OK;
+    }
+
+    WARN("%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid(iid));
+
+    *out = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_svg_element_AddRef(ID2D1SvgElement *iface)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    ULONG refcount = InterlockedIncrement(&element->refcount);
+
+    TRACE("%p increasing refcount to %lu.\n", iface, refcount);
+
+    return refcount;
+}
+
+static ULONG STDMETHODCALLTYPE d2d_svg_element_Release(ID2D1SvgElement *iface)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    ULONG refcount = InterlockedDecrement(&element->refcount);
+    struct d2d_svg_element *child, *next;
+
+    TRACE("%p decreasing refcount to %lu.\n", iface, refcount);
+
+    if (!refcount)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE(child, next, &element->children, struct d2d_svg_element, entry)
+        {
+            list_remove(&child->entry);
+            list_init(&child->entry);
+            child->parent = NULL;
+            ID2D1SvgElement_Release(&child->ID2D1SvgElement_iface);
+        }
+
+        if (element->document)
+            list_remove(&element->document_entry);
+        ID2D1Factory_Release(element->factory);
+        free(element->tag_name);
+        free(element);
+    }
+
+    return refcount;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetFactory(ID2D1SvgElement *iface, ID2D1Factory **factory)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, factory %p.\n", iface, factory);
+
+    ID2D1Factory_AddRef(*factory = element->factory);
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetDocument(ID2D1SvgElement *iface, ID2D1SvgDocument **document)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, document %p.\n", iface, document);
+
+    *document = NULL;
+    if (element->document)
+        ID2D1SvgDocument_AddRef(*document = &element->document->ID2D1SvgDocument_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetTagName(ID2D1SvgElement *iface, WCHAR *name, UINT32 name_count)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    UINT32 length;
+
+    TRACE("iface %p, name %p, name_count %u.\n", iface, name, name_count);
+
+    if (!name)
+        return E_INVALIDARG;
+
+    length = wcslen(element->tag_name);
+    if (name_count <= length)
+    {
+        if (name_count)
+            *name = 0;
+        return E_NOT_SUFFICIENT_BUFFER;
+    }
+
+    memcpy(name, element->tag_name, (length + 1) * sizeof(*name));
+
+    return S_OK;
+}
+
+static UINT32 STDMETHODCALLTYPE d2d_svg_element_GetTagNameLength(ID2D1SvgElement *iface)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    return wcslen(element->tag_name);
+}
+
+static BOOL STDMETHODCALLTYPE d2d_svg_element_IsTextContent(ID2D1SvgElement *iface)
+{
+    TRACE("iface %p.\n", iface);
+
+    /* Text content nodes are only produced by the XML parser and by
+     * SetTextValue(), neither of which is implemented. */
+    return FALSE;
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetParent(ID2D1SvgElement *iface, ID2D1SvgElement **parent)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p, parent %p.\n", iface, parent);
+
+    *parent = NULL;
+    if (element->parent)
+        ID2D1SvgElement_AddRef(*parent = &element->parent->ID2D1SvgElement_iface);
+}
+
+static BOOL STDMETHODCALLTYPE d2d_svg_element_HasChildren(ID2D1SvgElement *iface)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+
+    TRACE("iface %p.\n", iface);
+
+    return !list_empty(&element->children);
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetFirstChild(ID2D1SvgElement *iface, ID2D1SvgElement **child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct list *entry;
+
+    TRACE("iface %p, child %p.\n", iface, child);
+
+    *child = NULL;
+    if ((entry = list_head(&element->children)))
+    {
+        *child = &LIST_ENTRY(entry, struct d2d_svg_element, entry)->ID2D1SvgElement_iface;
+        ID2D1SvgElement_AddRef(*child);
+    }
+}
+
+static void STDMETHODCALLTYPE d2d_svg_element_GetLastChild(ID2D1SvgElement *iface, ID2D1SvgElement **child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct list *entry;
+
+    TRACE("iface %p, child %p.\n", iface, child);
+
+    *child = NULL;
+    if ((entry = list_tail(&element->children)))
+    {
+        *child = &LIST_ENTRY(entry, struct d2d_svg_element, entry)->ID2D1SvgElement_iface;
+        ID2D1SvgElement_AddRef(*child);
+    }
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetPreviousChild(ID2D1SvgElement *iface,
+        ID2D1SvgElement *reference_child, ID2D1SvgElement **previous_child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct d2d_svg_element *reference;
+    struct list *entry;
+
+    TRACE("iface %p, reference_child %p, previous_child %p.\n", iface, reference_child, previous_child);
+
+    *previous_child = NULL;
+
+    if (!(reference = unsafe_impl_from_ID2D1SvgElement(reference_child)) || reference->parent != element)
+        return E_INVALIDARG;
+
+    if (!(entry = list_prev(&element->children, &reference->entry)))
+        return S_FALSE;
+
+    *previous_child = &LIST_ENTRY(entry, struct d2d_svg_element, entry)->ID2D1SvgElement_iface;
+    ID2D1SvgElement_AddRef(*previous_child);
+
+    return S_OK;
+}
+
+static HRESULT STDMETHODCALLTYPE d2d_svg_element_GetNextChild(ID2D1SvgElement *iface,
+        ID2D1SvgElement *reference_child, ID2D1SvgElement **next_child)
+{
+    struct d2d_svg_element *element = impl_from_ID2D1SvgElement(iface);
+    struct d2d_svg_element *reference;
+    struct list *entry;
+
+    TRACE("iface %p, reference_child %p, next_child %p.\n", iface, reference_child, next_child);
+
+    *next_child = NULL;
+
+    if (!(reference = unsafe_impl_from_ID2D1SvgElement(reference_child)) || reference->parent != element)
+        return E_INVALIDARG;
+
+    if (!(entry = list_next(&element->children, &reference->entry)))
+        return S_FALSE;
+
+    *next_child = &LIST_ENTRY(entry, struct d2d_svg_element, entry)->ID2D1SvgElement_iface;
+    ID2D1SvgElement_AddRef(*next_child);
+
+    return S_OK;
+}
+
+static HRESULT d2d_svg_element_insert_child(struct d2d_svg_element *element,
+        struct d2d_svg_element *child, struct d2d_svg_element *reference)
+{
+    if (!child || child->document != element->document || child->parent
+            || d2d_svg_element_has_ancestor(element, child))
+        return E_INVALIDARG;
+
+    /* The document holds the root element the same way a parent holds a child,
+     * so the root cannot be moved into the tree without SetRoot(). */
+    if (element->document && element->document->root == &child->ID2D1SvgElement_iface)
+        return E_INVALIDARG;
+
+    if (reference)
+    {
+        if (reference->parent != element)
+            return E_INVALIDARG;
+        list_add_before(&reference->entry, &child->entry);
+    }
+    else
+    {
+        list_add_tail(&element->children, &child->entry);
+    }
+
+    child->parent = element;
+    ID2D1SvgElement_AddRef(&child->ID2D1SvgElement_iface);
+
+    return S_OK;
+}
