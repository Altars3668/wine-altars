+static HRESULT d2d_svg_element_create(struct d2d_svg_document *document, const WCHAR *tag_name,
+        struct d2d_svg_element **element)
+{
+    struct d2d_svg_element *object;
+
+    *element = NULL;
+
+    if (!(object = calloc(1, sizeof(*object))))
+        return E_OUTOFMEMORY;
+
+    if (!(object->tag_name = wcsdup(tag_name)))
+    {
+        free(object);
+        return E_OUTOFMEMORY;
+    }
+
+    object->ID2D1SvgElement_iface.lpVtbl = &d2d_svg_element_vtbl;
+    object->refcount = 1;
+    ID2D1Factory_AddRef(object->factory = document->factory);
+    object->document = document;
+    list_init(&object->entry);
+    list_init(&object->children);
+    list_add_tail(&document->elements, &object->document_entry);
+
+    TRACE("Created SVG element %p.\n", object);
+
+    *element = object;
+
+    return S_OK;
+}
