diff --git a/dlls/sppc/catalog.c b/dlls/sppc/catalog.c
new file mode 100644
index 00000000000..c944ab04517
--- /dev/null
+++ b/dlls/sppc/catalog.c
@@ -0,0 +1,191 @@
+/* 显式注册的产品元数据；不扫描许可证、密钥、账户或硬件绑定。 */
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+#include <wchar.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winreg.h"
+#include "winternl.h"
+#include "slerror.h"
+#include "sppc_private.h"
+
+static const WCHAR catalog_root[] = L"Software\\Wine\\SPPC\\Applications";
+
+HRESULT sppc_catalog_status(const SLID *app, const SLID *sku, UINT *count, SL_LICENSING_STATUS **status)
+{
+    SL_LICENSING_STATUS *entries = NULL;
+    static const GUID empty_guid;
+    WCHAR app_name[39], sku_name[39];
+    HKEY root = NULL, application = NULL, products = NULL, product = NULL;
+    DWORD version, size, index, length, total, type;
+    UNICODE_STRING string;
+    GUID id;
+    LONG result;
+    UINT used = 0;
+    HRESULT hr = SL_E_PRODUCT_SKU_NOT_INSTALLED;
+
+    *count = 0;
+    *status = NULL;
+    swprintf(app_name, ARRAY_SIZE(app_name), L"{%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}",
+            app->Data1, app->Data2, app->Data3, app->Data4[0], app->Data4[1], app->Data4[2],
+            app->Data4[3], app->Data4[4], app->Data4[5], app->Data4[6], app->Data4[7]);
+    if ((result = RegOpenKeyExW(HKEY_LOCAL_MACHINE, catalog_root, 0, KEY_READ | KEY_WOW64_64KEY, &root))) goto error;
+    if ((result = RegOpenKeyExW(root, app_name, 0, KEY_READ | KEY_WOW64_64KEY, &application))) goto error;
+    size = sizeof(version);
+    if ((result = RegQueryValueExW(application, L"CatalogVersion", NULL, &type, (BYTE *)&version, &size))) goto error;
+    if (type != REG_DWORD || size != sizeof(version) || version != 1)
+    {
+        hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+        goto done;
+    }
+    if ((result = RegOpenKeyExW(application, L"Skus", 0, KEY_READ | KEY_WOW64_64KEY, &products))) goto error;
+    if ((result = RegQueryInfoKeyW(products, NULL, NULL, NULL, &total, NULL, NULL, NULL, NULL, NULL, NULL, NULL))) goto error;
+    if (total > 4096)
+    {
+        hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+        goto done;
+    }
+    if (total && !(entries = calloc(total, sizeof(*entries))))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    for (index = 0; index < total; index++)
+    {
+        length = ARRAY_SIZE(sku_name);
+        result = RegEnumKeyExW(products, index, sku_name, &length, NULL, NULL, NULL, NULL);
+        if (result) goto error;
+        RtlInitUnicodeString(&string, sku_name);
+        if (RtlGUIDFromString(&string, &id) || IsEqualGUID(&id, &empty_guid))
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+            goto done;
+        }
+        if (sku && !IsEqualGUID(sku, &id)) continue;
+        if ((result = RegOpenKeyExW(products, sku_name, 0, KEY_READ | KEY_WOW64_64KEY, &product))) goto error;
+        size = 0;
+        result = RegQueryValueExW(product, L"Name", NULL, &type, NULL, &size);
+        RegCloseKey(product);
+        product = NULL;
+        if (result) goto error;
+        if (type != REG_SZ || size < 2 * sizeof(WCHAR) || size > 4096)
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+            goto done;
+        }
+        entries[used].SkuId = id;
+        entries[used].eStatus = SL_LICENSING_STATUS_UNLICENSED;
+        entries[used].hrReason = SL_E_PKEY_NOT_INSTALLED;
+        /* 没有本机许可/密钥后端的授权证据；时间字段保持零，不借用外机宽限。 */
+        used++;
+    }
+    if (!used) goto done;
+    *count = used;
+    *status = entries;
+    entries = NULL;
+    hr = S_OK;
+    goto done;
+
+error:
+    hr = result == ERROR_FILE_NOT_FOUND || result == ERROR_PATH_NOT_FOUND ?
+            SL_E_PRODUCT_SKU_NOT_INSTALLED : HRESULT_FROM_WIN32(result);
+done:
+    free(entries);
+    if (product) RegCloseKey(product);
+    if (products) RegCloseKey(products);
+    if (application) RegCloseKey(application);
+    if (root) RegCloseKey(root);
+    return hr;
+}
+
+/* 读取某个已注册 SKU 的字符串属性。取值来自安装注册目录，描述的是产品定义，
+ * 不是许可状态、密钥或设备绑定；读到值不表示该产品已授权。
+ *
+ * 原生 API 只按 SKU 查询，所以这里自己找出它注册在哪个应用下，而不是硬编码
+ * Office 的应用 ID。找不到应用、SKU 或该属性时一律按未找到处理，绝不退回其他
+ * SKU 的取值。成功时输出 LocalAlloc 的 UTF-16 字符串，长度以字节计并包含结尾
+ * NUL，由调用方 LocalFree。
+ */
+HRESULT sppc_catalog_sku_string(const SLID *sku, const WCHAR *name, UINT *size, BYTE **value)
+{
+    static const GUID empty_guid;
+    WCHAR app_name[39], sku_name[39];
+    HKEY root = NULL, application = NULL, products = NULL, product = NULL;
+    DWORD version, bytes, type, index, length;
+    BYTE *buffer = NULL;
+    HRESULT hr = SL_E_VALUE_NOT_FOUND;
+    LONG result;
+
+    if (IsEqualGUID(sku, &empty_guid)) return SL_E_VALUE_NOT_FOUND;
+    swprintf(sku_name, ARRAY_SIZE(sku_name), L"{%08lx-%04x-%04x-%02x%02x-%02x%02x%02x%02x%02x%02x}",
+            sku->Data1, sku->Data2, sku->Data3, sku->Data4[0], sku->Data4[1], sku->Data4[2],
+            sku->Data4[3], sku->Data4[4], sku->Data4[5], sku->Data4[6], sku->Data4[7]);
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, catalog_root, 0, KEY_READ | KEY_WOW64_64KEY, &root))
+        return SL_E_VALUE_NOT_FOUND;
+
+    for (index = 0; !product; index++)
+    {
+        length = ARRAY_SIZE(app_name);
+        if (RegEnumKeyExW(root, index, app_name, &length, NULL, NULL, NULL, NULL)) goto done;
+        if (RegOpenKeyExW(root, app_name, 0, KEY_READ | KEY_WOW64_64KEY, &application)) continue;
+        bytes = sizeof(version);
+        result = RegQueryValueExW(application, L"CatalogVersion", NULL, &type, (BYTE *)&version, &bytes);
+        /* 目录存在但版本不对时停下来报错，不把它当成"没有这个 SKU"。 */
+        if (!result && (type != REG_DWORD || bytes != sizeof(version) || version != 1))
+        {
+            hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+            goto done;
+        }
+        if (!result && !RegOpenKeyExW(application, L"Skus", 0, KEY_READ | KEY_WOW64_64KEY, &products))
+            RegOpenKeyExW(products, sku_name, 0, KEY_READ | KEY_WOW64_64KEY, &product);
+        if (products) RegCloseKey(products);
+        products = NULL;
+        RegCloseKey(application);
+        application = NULL;
+    }
+
+    bytes = 0;
+    if ((result = RegQueryValueExW(product, name, NULL, &type, NULL, &bytes)))
+    {
+        hr = result == ERROR_FILE_NOT_FOUND ? SL_E_VALUE_NOT_FOUND : HRESULT_FROM_WIN32(result);
+        goto done;
+    }
+    if (type != REG_SZ || bytes < 2 * sizeof(WCHAR) || bytes > 4096 || bytes % sizeof(WCHAR))
+    {
+        hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+        goto done;
+    }
+    if (!(buffer = LocalAlloc(LMEM_FIXED, bytes)))
+    {
+        hr = E_OUTOFMEMORY;
+        goto done;
+    }
+    if ((result = RegQueryValueExW(product, name, NULL, &type, buffer, &bytes)))
+    {
+        hr = HRESULT_FROM_WIN32(result);
+        goto done;
+    }
+    /* 注册表不保证字符串带结尾 NUL，而调用方按字节长度读取，所以这里必须确认。 */
+    if (type != REG_SZ || bytes < 2 * sizeof(WCHAR) || bytes % sizeof(WCHAR) ||
+            ((const WCHAR *)buffer)[bytes / sizeof(WCHAR) - 1])
+    {
+        hr = HRESULT_FROM_WIN32(ERROR_INVALID_DATA);
+        goto done;
+    }
+    *size = bytes;
+    *value = buffer;
+    buffer = NULL;
+    hr = S_OK;
+
+done:
+    if (buffer) LocalFree(buffer);
+    if (product) RegCloseKey(product);
+    if (products) RegCloseKey(products);
+    if (application) RegCloseKey(application);
+    RegCloseKey(root);
+    return hr;
+}
diff --git a/dlls/sppc/context.c b/dlls/sppc/context.c
new file mode 100644
index 00000000000..c1d7cdb1e3c
--- /dev/null
+++ b/dlls/sppc/context.c
@@ -0,0 +1,170 @@
+/* SLC 上下文与本机未授权评估结果。
+ * API 成功、评估结果存在和权利授予是不同状态，不能用占位记录混淆。
+ */
+#include <stdarg.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "ntstatus.h"
+#define WIN32_NO_STATUS
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "wine/debug.h"
+#include "slerror.h"
+#include "sppc_private.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(slc);
+
+struct slc_context
+{
+    struct slc_context *next;
+    HSLC handle;
+    UINT count;
+    SL_LICENSING_STATUS *last_status;
+    BOOL evaluated;
+};
+
+static SRWLOCK context_lock = SRWLOCK_INIT;
+static struct slc_context *contexts;
+static ULONG_PTR next_handle;
+
+/* 先查表，再读上下文；任意外部 handle 不作为内存指针解引用。 */
+static struct slc_context *find_context(HSLC handle)
+{
+    struct slc_context *context;
+    for (context = contexts; context; context = context->next)
+        if (context->handle == handle) return context;
+    return NULL;
+}
+
+static HRESULT copy_status(const SL_LICENSING_STATUS *source, UINT source_count,
+        UINT *count, SL_LICENSING_STATUS **status)
+{
+    SL_LICENSING_STATUS *copy = NULL;
+
+    if (source_count)
+    {
+        if (!(copy = LocalAlloc(LMEM_FIXED, source_count * sizeof(*copy)))) return E_OUTOFMEMORY;
+        memcpy(copy, source, source_count * sizeof(*copy));
+    }
+    /* 只有成功后才提交输出，原生错误路径保留调用方的初值。 */
+    *count = source_count;
+    *status = copy;
+    return S_OK;
+}
+
+HRESULT WINAPI SLOpen(HSLC *handle)
+{
+    struct slc_context *context;
+
+    TRACE("handle output %p.\n", handle);
+    if (!handle) return E_INVALIDARG;
+    if (!(context = calloc(1, sizeof(*context)))) return E_OUTOFMEMORY;
+    AcquireSRWLockExclusive(&context_lock);
+    do
+    {
+        next_handle++;
+        context->handle = (HSLC)next_handle;
+    } while (!next_handle || context->handle == INVALID_HANDLE_VALUE || find_context(context->handle));
+    context->next = contexts;
+    contexts = context;
+    *handle = context->handle;
+    ReleaseSRWLockExclusive(&context_lock);
+    return S_OK;
+}
+
+HRESULT WINAPI SLClose(HSLC handle)
+{
+    struct slc_context **entry, *context;
+
+    TRACE("handle %p.\n", handle);
+    if (!handle) return E_INVALIDARG;
+    AcquireSRWLockExclusive(&context_lock);
+    for (entry = &contexts; *entry && (*entry)->handle != handle; entry = &(*entry)->next) {}
+    if (!(context = *entry))
+    {
+        ReleaseSRWLockExclusive(&context_lock);
+        return RPC_NT_SS_CONTEXT_MISMATCH;
+    }
+    *entry = context->next;
+    ReleaseSRWLockExclusive(&context_lock);
+    free(context->last_status);
+    free(context);
+    return S_OK;
+}
+
+/* 服务信息查询只需要知道句柄是否还在，不碰它的评估历史，所以共享锁即可。 */
+HRESULT sppc_context_validate(HSLC handle)
+{
+    HRESULT hr;
+
+    AcquireSRWLockShared(&context_lock);
+    hr = find_context(handle) ? S_OK : RPC_NT_SS_CONTEXT_MISMATCH;
+    ReleaseSRWLockShared(&context_lock);
+    return hr;
+}
+
+HRESULT WINAPI SLGetLicensingStatusInformation(HSLC handle, const SLID *app, const SLID *product,
+        LPCWSTR right, UINT *count, SL_LICENSING_STATUS **status)
+{
+    struct slc_context *context;
+    SL_LICENSING_STATUS *entries = NULL;
+    UINT entry_count = 0;
+    HRESULT hr;
+
+    TRACE("handle %p app %p sku %p count %p status %p.\n", handle, app, product, count, status);
+    if (!handle || !count || !status || (!app && product)) return E_INVALIDARG;
+    AcquireSRWLockExclusive(&context_lock);
+    if (!(context = find_context(handle))) hr = RPC_NT_SS_CONTEXT_MISMATCH;
+    else if (right) hr = SL_E_NOT_SUPPORT;
+    else if (!app)
+    {
+        hr = context->evaluated ? copy_status(context->last_status, context->count, count, status) :
+                SL_E_RIGHT_NOT_CONSUMED;
+    }
+    else
+    {
+        hr = sppc_catalog_status(app, product, &entry_count, &entries);
+        if (SUCCEEDED(hr)) hr = copy_status(entries, entry_count, count, status);
+    }
+    ReleaseSRWLockExclusive(&context_lock);
+    free(entries);
+    return hr;
+}
+
+HRESULT WINAPI SLConsumeRight(HSLC handle, const SLID *app, const SLID *product,
+        LPCWSTR right, void *reserved)
+{
+    struct slc_context *context;
+    SL_LICENSING_STATUS *entries = NULL;
+    UINT count = 0;
+    HRESULT hr;
+
+    TRACE("handle %p app %p sku %p.\n", handle, app, product);
+    if (!handle || !app || reserved) return E_INVALIDARG;
+    AcquireSRWLockExclusive(&context_lock);
+    if (!(context = find_context(handle))) hr = RPC_NT_SS_CONTEXT_MISMATCH;
+    else if (right) hr = SL_E_NOT_SUPPORT;
+    else
+    {
+        /* 参数错误保留旧历史；开始一次有效请求后，未知产品会清除历史。 */
+        free(context->last_status);
+        context->last_status = NULL;
+        context->count = 0;
+        context->evaluated = FALSE;
+        hr = sppc_catalog_status(app, product, &count, &entries);
+        if (SUCCEEDED(hr))
+        {
+            context->last_status = entries;
+            context->count = count;
+            context->evaluated = TRUE;
+            entries = NULL;
+            /* 本阶段没有授权/密钥后端。保留可查询的未授权结果，但不授予权利。 */
+            hr = SL_E_RIGHT_NOT_GRANTED;
+        }
+    }
+    ReleaseSRWLockExclusive(&context_lock);
+    free(entries);
+    return hr;
+}
