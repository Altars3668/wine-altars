From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 19:14:46 -0400
Subject: [PATCH] scrrun: Answer missing files and folders as Windows does.

Measured on Windows 11 (build 29671): GetFile of a file in a folder that
is not there is a file not found (CTL_E_FILENOTFOUND), as is one that
names a folder; GetFile and GetFolder of an empty name are an invalid
argument; DeleteFolder of a folder that is not there is a path not
found (CTL_E_PATHNOTFOUND).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 9beb12904ba1c5f54d4d4d53885f69c19711d965)

diff --git a/dlls/scrrun/filesystem.c b/dlls/scrrun/filesystem.c
index c2bb89586f0..d75876b2e55 100644
--- a/dlls/scrrun/filesystem.c
+++ b/dlls/scrrun/filesystem.c
@@ -3351,9 +3351,14 @@ static HRESULT create_file(BSTR path, IFile **file)
     attrs = GetFileAttributesW(f->path);
     if (attrs == INVALID_FILE_ATTRIBUTES || (attrs & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_DEVICE)))
     {
+        DWORD err = GetLastError();
+
         free(f->path);
         free(f);
-        return create_error(GetLastError());
+        /* whatever of the path is missing, the file is */
+        if (attrs != INVALID_FILE_ATTRIBUTES || err == ERROR_PATH_NOT_FOUND)
+            return CTL_E_FILENOTFOUND;
+        return create_error(err);
     }
 
     init_classinfo(&CLSID_File, (IUnknown *)&f->IFile_iface, &f->classinfo);
@@ -3810,7 +3815,7 @@ static HRESULT WINAPI filesys_GetFile(IFileSystem3 *iface, BSTR FilePath,
 
     if(!ppfile)
         return E_POINTER;
-    if(!FilePath)
+    if(!FilePath || !*FilePath)
         return E_INVALIDARG;
 
     return create_file(FilePath, ppfile);
@@ -3827,7 +3832,7 @@ static HRESULT WINAPI filesys_GetFolder(IFileSystem3 *iface, BSTR FolderPath,
         return E_POINTER;
 
     *folder = NULL;
-    if(!FolderPath)
+    if(!FolderPath || !*FolderPath)
         return E_INVALIDARG;
 
     attrs = GetFileAttributesW(FolderPath);
@@ -4001,12 +4006,16 @@ static HRESULT delete_folder(const WCHAR *folder, DWORD folder_len, VARIANT_BOOL
 static HRESULT WINAPI filesys_DeleteFolder(IFileSystem3 *iface, BSTR FolderSpec,
                                             VARIANT_BOOL Force)
 {
+    HRESULT hr;
+
     TRACE("%p %s %d\n", iface, debugstr_w(FolderSpec), Force);
 
     if(!FolderSpec)
         return E_POINTER;
 
-    return delete_folder(FolderSpec, SysStringLen(FolderSpec), Force);
+    /* a folder that is not there is a path not found */
+    hr = delete_folder(FolderSpec, SysStringLen(FolderSpec), Force);
+    return hr == CTL_E_FILENOTFOUND ? CTL_E_PATHNOTFOUND : hr;
 }
 
 static HRESULT WINAPI filesys_MoveFile(IFileSystem3 *iface, BSTR source, BSTR destination)
diff --git a/dlls/scrrun/tests/filesystem.c b/dlls/scrrun/tests/filesystem.c
index 84cb3aa2145..2a3373b73b5 100644
--- a/dlls/scrrun/tests/filesystem.c
+++ b/dlls/scrrun/tests/filesystem.c
@@ -677,6 +677,27 @@ static void test_GetFile(void)
     ok(!file, "file != NULL\n");
     ok(hr == CTL_E_FILENOTFOUND, "Unexpected hr %#lx.\n", hr);
 
+    /* a file in a folder that is not there is not there either, and no name is an invalid argument */
+    {
+        BSTR missing = SysAllocString(L"C:\\wine-no-such-dir\\file.txt"), empty = SysAllocString(L"");
+        IFolder *folder;
+
+        file = (IFile*)0xdeadbeef;
+        hr = IFileSystem3_GetFile(fs3, missing, &file);
+        ok(hr == CTL_E_FILENOTFOUND, "Unexpected hr %#lx.\n", hr);
+        ok(!file, "file != NULL\n");
+        hr = IFileSystem3_GetFile(fs3, empty, &file);
+        ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+        hr = IFileSystem3_GetFolder(fs3, empty, &folder);
+        ok(hr == E_INVALIDARG, "Unexpected hr %#lx.\n", hr);
+        SysFreeString(missing);
+        missing = SysAllocString(L"C:\\wine-no-such-dir");
+        hr = IFileSystem3_DeleteFolder(fs3, missing, VARIANT_FALSE);
+        ok(hr == CTL_E_PATHNOTFOUND, "Unexpected hr %#lx.\n", hr);
+        SysFreeString(missing);
+        SysFreeString(empty);
+    }
+
     hf = CreateFileW(pathW, GENERIC_WRITE, 0, NULL, CREATE_NEW, FILE_ATTRIBUTE_READONLY, NULL);
     if(hf == INVALID_HANDLE_VALUE) {
         skip("Can't create temporary file\n");
