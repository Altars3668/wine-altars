+    uuid(1ade314d-0e0a-40d9-824c-9a088a50059f),
+]
+interface IUserActivityInterop : IInspectable
+{
+    HRESULT CreateSessionForWindow([in] HWND window, [in] REFIID iid, [out, retval, iid_is(iid)] void **value);
+}
+
