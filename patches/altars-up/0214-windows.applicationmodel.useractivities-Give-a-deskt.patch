+    uuid(dd69f876-9699-4715-9095-e37ea30dfa1b),
+]
+interface IUserActivityRequestManagerInterop : IInspectable
+{
+    HRESULT GetForWindow([in] HWND window, [in] REFIID iid, [out, retval, iid_is(iid)] void **value);
+}
