+#define WIDL_using_Windows_Foundation
+#include "windows.foundation.h"
+#define WIDL_using_Windows_ApplicationModel_UserActivities
+#include "windows.applicationmodel.useractivities.h"
+#include "useractivityinterop.h"
+
+#include "wine/test.h"
+
+/* a handler that is nothing but an IUnknown: all the manager keeps of it is its address */
+static HRESULT WINAPI handler_QueryInterface( IUnknown *iface, REFIID iid, void **out )
+{
+    *out = iface;
+    return S_OK;
+}
+static ULONG WINAPI handler_AddRef( IUnknown *iface ) { return 2; }
+static ULONG WINAPI handler_Release( IUnknown *iface ) { return 1; }
+static const IUnknownVtbl handler_vtbl = { handler_QueryInterface, handler_AddRef, handler_Release };
+static IUnknown handler = { &handler_vtbl };
+
+static void test_manager( IUserActivityRequestManager *manager )
+{
+    EventRegistrationToken token;
+    IUnknown *unknown;
+    HSTRING name;
+    HRESULT hr;
+
+    hr = IUserActivityRequestManager_QueryInterface( manager, &IID_IAgileObject, (void **)&unknown );
+    ok( hr == E_NOINTERFACE, "got %#lx\n", hr );
+    hr = IUserActivityRequestManager_GetRuntimeClassName( manager, &name );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( !wcscmp( WindowsGetStringRawBuffer( name, NULL ), L"Windows.ApplicationModel.UserActivities.UserActivityRequestManager" ),
+        "got %s\n", debugstr_hstring( name ));
+    WindowsDeleteString( name );
+
+    hr = IUserActivityRequestManager_add_UserActivityRequested( manager, (IInspectable *)&handler, &token );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( token.value == (ULONG_PTR)&handler, "got token %#I64x, the handler is at %p\n", token.value, &handler );
+    hr = IUserActivityRequestManager_add_UserActivityRequested( manager, NULL, &token );
+    ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    hr = IUserActivityRequestManager_remove_UserActivityRequested( manager, token );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUserActivityRequestManager_remove_UserActivityRequested( manager, token );
+    ok( hr == S_OK, "got %#lx\n", hr );
+}
+
+static void test_request_manager(void)
+{
+    static const WCHAR *class_name = RuntimeClass_Windows_ApplicationModel_UserActivities_UserActivityRequestManager;
+    IUserActivityRequestManager *manager, *again, *second_manager, *child_manager;
+    IUserActivityRequestManagerStatics *statics;
+    IUserActivityRequestManagerInterop *interop;
+    IActivationFactory *factory;
+    HWND window, second, child, gone;
+    HSTRING str;
+    HRESULT hr;
+
+    WindowsCreateString( class_name, wcslen( class_name ), &str );
+    hr = RoGetActivationFactory( str, &IID_IActivationFactory, (void **)&factory );
+    WindowsDeleteString( str );
+    ok( hr == S_OK || broken( hr == REGDB_E_CLASSNOTREG ), "got %#lx\n", hr );
+    if (hr != S_OK)
+    {
+        win_skip( "no %s\n", wine_dbgstr_w( class_name ));
+        return;
+    }
+
+    /* a desktop application has no view */
+    hr = IActivationFactory_QueryInterface( factory, &IID_IUserActivityRequestManagerStatics, (void **)&statics );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    manager = (void *)0xdeadbeef;
+    hr = IUserActivityRequestManagerStatics_GetForCurrentView( statics, &manager );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_NOT_FOUND ), "got %#lx\n", hr );
+    ok( !manager, "got %p\n", manager );
+    IUserActivityRequestManagerStatics_Release( statics );
+
+    /* but one for each of its windows */
+    hr = IActivationFactory_QueryInterface( factory, &IID_IUserActivityRequestManagerInterop, (void **)&interop );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    window = CreateWindowW( L"static", L"useractivities", WS_OVERLAPPEDWINDOW, 0, 0, 200, 100, NULL, NULL, NULL, NULL );
+    second = CreateWindowW( L"static", L"useractivities 2", WS_OVERLAPPEDWINDOW, 0, 0, 200, 100, NULL, NULL, NULL, NULL );
+    child = CreateWindowW( L"static", L"child", WS_CHILD, 0, 0, 10, 10, window, NULL, NULL, NULL );
+    gone = CreateWindowW( L"static", L"gone", WS_OVERLAPPEDWINDOW, 0, 0, 200, 100, NULL, NULL, NULL, NULL );
+    DestroyWindow( gone );
+
+    hr = IUserActivityRequestManagerInterop_GetForWindow( interop, window, &IID_IUserActivityRequestManager, (void **)&manager );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    hr = IUserActivityRequestManagerInterop_GetForWindow( interop, window, &IID_IUserActivityRequestManager, (void **)&again );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( again == manager, "got another manager\n" );
+    IUserActivityRequestManager_Release( again );
+    hr = IUserActivityRequestManagerInterop_GetForWindow( interop, second, &IID_IUserActivityRequestManager, (void **)&second_manager );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    ok( second_manager != manager, "got the first window's manager\n" );
+    hr = IUserActivityRequestManagerInterop_GetForWindow( interop, child, &IID_IUserActivityRequestManager, (void **)&child_manager );
+    ok( hr == S_OK, "got %#lx\n", hr );
+    test_manager( manager );
+    test_manager( child_manager );
+    IUserActivityRequestManager_Release( child_manager );
+    IUserActivityRequestManager_Release( second_manager );
+    IUserActivityRequestManager_Release( manager );
+
+    again = (void *)0xdeadbeef;
+    hr = IUserActivityRequestManagerInterop_GetForWindow( interop, NULL, &IID_IUserActivityRequestManager, (void **)&again );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_INVALID_WINDOW_HANDLE ), "got %#lx\n", hr );
+    ok( !again, "got %p\n", again );
+    hr = IUserActivityRequestManagerInterop_GetForWindow( interop, gone, &IID_IUserActivityRequestManager, (void **)&again );
+    ok( hr == HRESULT_FROM_WIN32( ERROR_INVALID_WINDOW_HANDLE ), "got %#lx\n", hr );
+    /* nor for a window of another process */
+    hr = IUserActivityRequestManagerInterop_GetForWindow( interop, GetDesktopWindow(), &IID_IUserActivityRequestManager, (void **)&again );
+    ok( hr == E_ACCESSDENIED, "got %#lx\n", hr );
+
+    DestroyWindow( child );
+    DestroyWindow( second );
+    DestroyWindow( window );
+    IUserActivityRequestManagerInterop_Release( interop );
+    IActivationFactory_Release( factory );
+}
+
+START_TEST(useractivities)
+{
+    HRESULT hr;
+
+    hr = RoInitialize( RO_INIT_SINGLETHREADED );
+    ok( hr == S_OK, "RoInitialize failed, hr %#lx\n", hr );
+
+    test_request_manager();
+
+    RoUninitialize();
+}
diff --git a/dlls/windows.applicationmodel.useractivities/useractivities.c b/dlls/windows.applicationmodel.useractivities/useractivities.c
index 1cb5f3b7707..b948f622332 100644
--- a/dlls/windows.applicationmodel.useractivities/useractivities.c
+++ b/dlls/windows.applicationmodel.useractivities/useractivities.c
@@ -18,6 +18,8 @@
  */
 
 #include "private.h"
+#include "winuser.h"
+#include "wine/list.h"
 #include "wine/debug.h"
 
 WINE_DEFAULT_DEBUG_CHANNEL(useractivities);
@@ -33,14 +35,29 @@ WINE_DEFAULT_DEBUG_CHANNEL(useractivities);
  * Existing matters on its own here.  An application asks for this class to
  * find out whether the feature is available at all, and the answer to that
  * question is not an activation failure.
+ *
+ * A desktop application gets its manager for a window through
+ * IUserActivityRequestManagerInterop, one for each window as long as it holds
+ * it, as tools/useractivityprobe measured on Windows; it has no current view.
  */
 
 struct request_manager
 {
     IUserActivityRequestManager IUserActivityRequestManager_iface;
     LONG ref;
-    LONG64 next_token;
+    HWND window;
+    struct list entry;
+};
+
+static struct list window_managers = LIST_INIT( window_managers );
+static CRITICAL_SECTION managers_cs;
+static CRITICAL_SECTION_DEBUG managers_cs_debug =
+{
+    0, 0, &managers_cs,
+    { &managers_cs_debug.ProcessLocksList, &managers_cs_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": managers_cs") }
 };
+static CRITICAL_SECTION managers_cs = { &managers_cs_debug, -1, 0, 0, 0, 0 };
 
 static inline struct request_manager *impl_from_IUserActivityRequestManager(
         IUserActivityRequestManager *iface )
@@ -54,9 +71,9 @@ static HRESULT WINAPI manager_QueryInterface( IUserActivityRequestManager *iface
 
     TRACE( "iface %p, iid %s, out %p.\n", iface, debugstr_guid( iid ), out );
 
+    /* not agile: it belongs to its window */
     if (IsEqualGUID( iid, &IID_IUnknown ) ||
         IsEqualGUID( iid, &IID_IInspectable ) ||
-        IsEqualGUID( iid, &IID_IAgileObject ) ||
         IsEqualGUID( iid, &IID_IUserActivityRequestManager ))
     {
         *out = &impl->IUserActivityRequestManager_iface;
@@ -77,9 +94,15 @@ static ULONG WINAPI manager_AddRef( IUserActivityRequestManager *iface )
 static ULONG WINAPI manager_Release( IUserActivityRequestManager *iface )
 {
     struct request_manager *impl = impl_from_IUserActivityRequestManager( iface );
-    ULONG ref = InterlockedDecrement( &impl->ref );
+    ULONG ref;
 
-    if (!ref) free( impl );
+    EnterCriticalSection( &managers_cs );
+    if (!(ref = InterlockedDecrement( &impl->ref )))
+    {
+        list_remove( &impl->entry );
+        free( impl );
+    }
+    LeaveCriticalSection( &managers_cs );
     return ref;
 }
 
@@ -106,15 +129,14 @@ static HRESULT WINAPI manager_GetTrustLevel( IUserActivityRequestManager *iface,
 static HRESULT WINAPI manager_add_UserActivityRequested( IUserActivityRequestManager *iface,
         IInspectable *handler, EventRegistrationToken *token )
 {
-    struct request_manager *impl = impl_from_IUserActivityRequestManager( iface );
-
     TRACE( "iface %p, handler %p, token %p.\n", iface, handler, token );
 
     if (!token) return E_POINTER;
     if (!handler) return E_INVALIDARG;
     /* Nothing on this system raises the request, so the handler is remembered
-     * only far enough to give back a token it can unregister with. */
-    token->value = InterlockedIncrement64( &impl->next_token );
+     * only far enough to give back a token it can unregister with: its address,
+     * as on Windows. */
+    token->value = (ULONG_PTR)handler;
     return S_OK;
 }
 
@@ -143,6 +165,7 @@ struct manager_statics
 {
     IActivationFactory IActivationFactory_iface;
     IUserActivityRequestManagerStatics IUserActivityRequestManagerStatics_iface;
+    IUserActivityRequestManagerInterop IUserActivityRequestManagerInterop_iface;
     LONG ref;
 };
 
@@ -174,6 +197,13 @@ static HRESULT WINAPI factory_QueryInterface( IActivationFactory *iface, REFIID
         return S_OK;
     }
 
+    if (IsEqualGUID( iid, &IID_IUserActivityRequestManagerInterop ))
+    {
+        *out = &impl->IUserActivityRequestManagerInterop_iface;
+        IInspectable_AddRef( (*out) );
+        return S_OK;
+    }
+
     FIXME( "%s not implemented, returning E_NOINTERFACE.\n", debugstr_guid( iid ) );
     *out = NULL;
     return E_NOINTERFACE;
@@ -235,18 +265,12 @@ DEFINE_IINSPECTABLE_( statics, IUserActivityRequestManagerStatics, struct manage
 static HRESULT WINAPI statics_GetForCurrentView( IUserActivityRequestManagerStatics *iface,
                                                  IUserActivityRequestManager **value )
 {
-    struct request_manager *impl;
-
     TRACE( "iface %p, value %p.\n", iface, value );
 
     if (!value) return E_POINTER;
-    if (!(impl = calloc( 1, sizeof(*impl) ))) return E_OUTOFMEMORY;
-
-    impl->IUserActivityRequestManager_iface.lpVtbl = &manager_vtbl;
-    impl->ref = 1;
-
-    *value = &impl->IUserActivityRequestManager_iface;
-    return S_OK;
+    /* there is no core window, as for a desktop application on Windows */
+    *value = NULL;
+    return HRESULT_FROM_WIN32( ERROR_NOT_FOUND );
 }
 
 static const struct IUserActivityRequestManagerStaticsVtbl statics_vtbl =
@@ -262,10 +286,66 @@ static const struct IUserActivityRequestManagerStaticsVtbl statics_vtbl =
     statics_GetForCurrentView,
 };
 
+DEFINE_IINSPECTABLE_( interop, IUserActivityRequestManagerInterop, struct manager_statics,
+                      statics_from_IUserActivityRequestManagerInterop,
+                      IUserActivityRequestManagerInterop_iface, &impl->IActivationFactory_iface )
+
+static HRESULT WINAPI interop_GetForWindow( IUserActivityRequestManagerInterop *iface, HWND window, REFIID iid,
+                                            void **value )
+{
+    struct request_manager *impl;
+    DWORD process;
+    HRESULT hr;
+
+    TRACE( "iface %p, window %p, iid %s, value %p.\n", iface, window, debugstr_guid( iid ), value );
+
+    if (!value) return E_POINTER;
+    *value = NULL;
+    if (!window || !GetWindowThreadProcessId( window, &process )) return HRESULT_FROM_WIN32( ERROR_INVALID_WINDOW_HANDLE );
+    if (process != GetCurrentProcessId()) return E_ACCESSDENIED;
+
+    EnterCriticalSection( &managers_cs );
+    LIST_FOR_EACH_ENTRY( impl, &window_managers, struct request_manager, entry )
+    {
+        if (impl->window != window) continue;
+        hr = IUserActivityRequestManager_QueryInterface( &impl->IUserActivityRequestManager_iface, iid, value );
+        LeaveCriticalSection( &managers_cs );
+        return hr;
+    }
+    if (!(impl = calloc( 1, sizeof(*impl) )))
+    {
+        LeaveCriticalSection( &managers_cs );
+        return E_OUTOFMEMORY;
+    }
+    impl->IUserActivityRequestManager_iface.lpVtbl = &manager_vtbl;
+    impl->ref = 1;
+    impl->window = window;
+    list_add_tail( &window_managers, &impl->entry );
+    LeaveCriticalSection( &managers_cs );
+
+    hr = IUserActivityRequestManager_QueryInterface( &impl->IUserActivityRequestManager_iface, iid, value );
+    IUserActivityRequestManager_Release( &impl->IUserActivityRequestManager_iface );
+    return hr;
+}
+
+static const struct IUserActivityRequestManagerInteropVtbl interop_vtbl =
+{
+    interop_QueryInterface,
+    interop_AddRef,
+    interop_Release,
+    /* IInspectable methods */
+    interop_GetIids,
+    interop_GetRuntimeClassName,
+    interop_GetTrustLevel,
+    /* IUserActivityRequestManagerInterop methods */
+    interop_GetForWindow,
+};
+
 static struct manager_statics manager_statics =
 {
     {&factory_vtbl},
     {&statics_vtbl},
+    {&interop_vtbl},
     1,
 };
 
