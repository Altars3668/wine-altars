+    struct language_factory *factory = impl_from_ILanguageStatics2(iface);
+    return IActivationFactory_Release(&factory->IActivationFactory_iface);
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics2_GetIids(ILanguageStatics2 *iface, ULONG *iid_count, IID **iids)
