+    FIXME("iface %p, trust_level %p stub!\n", iface, trust_level);
+    return E_NOTIMPL;
+}
+
+/* switch the thread to a keyboard layout of the language, if one is installed */
+static HRESULT STDMETHODCALLTYPE language_statics2_TrySetInputMethodLanguageTag(ILanguageStatics2 *iface,
+        HSTRING tag, BOOLEAN *result)
+{
+    WCHAR name[LOCALE_NAME_MAX_LENGTH];
+    HKL layouts[64];
+    unsigned int i;
+    LCID lcid;
+    int count;
+
+    TRACE("iface %p, tag %s, result %p.\n", iface, debugstr_hstring(tag), result);
+
+    if (!result) return E_POINTER;
+    *result = FALSE;
+    if (!(lcid = LocaleNameToLCID(WindowsGetStringRawBuffer(tag, NULL), 0)))
+    {
+        if (!ResolveLocaleName(WindowsGetStringRawBuffer(tag, NULL), name, ARRAY_SIZE(name))) return S_OK;
+        if (!(lcid = LocaleNameToLCID(name, 0))) return S_OK;
+    }
+    count = GetKeyboardLayoutList(ARRAY_SIZE(layouts), layouts);
+    for (i = 0; i < count; i++)
+    {
+        if (LOWORD(layouts[i]) != LANGIDFROMLCID(lcid)) continue;
+        *result = !!ActivateKeyboardLayout(layouts[i], 0);
+        break;
+    }
+    return S_OK;
+}
+
+static const struct ILanguageStatics2Vtbl language_statics2_vtbl =
+{
+    language_statics2_QueryInterface,
+    language_statics2_AddRef,
+    language_statics2_Release,
+    /* IInspectable methods */
+    language_statics2_GetIids,
+    language_statics2_GetRuntimeClassName,
+    language_statics2_GetTrustLevel,
+    /* ILanguageStatics2 methods */
+    language_statics2_TrySetInputMethodLanguageTag,
+};
+
 static struct language_factory language_factory =
 {
     {&activation_factory_language_vtbl},
     {&language_factory_vtbl},
+    {&language_statics_vtbl},
+    {&language_statics2_vtbl},
     0
 };
 
diff --git a/dlls/windows.globalization/tests/globalization.c b/dlls/windows.globalization/tests/globalization.c
index dd9b7027f7c..c54cfa43f9a 100644
--- a/dlls/windows.globalization/tests/globalization.c
+++ b/dlls/windows.globalization/tests/globalization.c
@@ -353,6 +353,94 @@ static void test_Language(void)
     IActivationFactory_Release(factory);
 }
 
+static void test_LanguageStatics(void)
+{
+    static const WCHAR *class_name = L"Windows.Globalization.Language";
+    static const struct
+    {
+        const WCHAR *tag;
+        BOOLEAN well_formed;
+    }
+    tags[] =
+    {
+        {L"en-US", TRUE}, {L"EN-us", TRUE}, {L"zh-Hans-CN", TRUE}, {L"de-DE-1996", TRUE},
+        {L"en-US-u-ca-gregory", TRUE}, {L"en-US-x-private", TRUE}, {L"x-private", TRUE}, {L"i-klingon", TRUE},
+        {L"zh-min-nan", TRUE}, {L"en-USA", TRUE}, {L"en-419", TRUE}, {L"art-lojban", TRUE},
+        {L"de-DE-1901-1901", TRUE},
+        {L"en_US", FALSE}, {L"", FALSE}, {L"e", FALSE}, {L"abcdefghi", FALSE}, {L"abcd", FALSE}, {L"abcde", FALSE},
+        {L"123", FALSE}, {L"en--US", FALSE}, {L"en-", FALSE}, {L"-en", FALSE}, {L"en-US-", FALSE},
+        {L"en-Latn-Latn", FALSE}, {L"en-a-bbb-a-ccc", FALSE}, {L"en-US-US", FALSE},
+    };
+    ILanguageStatics2 *statics2;
+    ILanguageStatics *statics;
+    IActivationFactory *factory;
+    HSTRING str, tag;
+    unsigned int i;
+    BOOLEAN ret;
+    HRESULT hr;
+
+    hr = WindowsCreateString(class_name, wcslen(class_name), &str);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = RoGetActivationFactory(str, &IID_IActivationFactory, (void **)&factory);
+    ok(hr == S_OK || broken(hr == REGDB_E_CLASSNOTREG), "Unexpected hr %#lx.\n", hr);
+    WindowsDeleteString(str);
+    if (hr == REGDB_E_CLASSNOTREG)
+    {
+        win_skip("%s runtimeclass not registered, skipping tests.\n", wine_dbgstr_w(class_name));
+        return;
+    }
+
+    hr = IActivationFactory_QueryInterface(factory, &IID_ILanguageStatics, (void **)&statics);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(tags); i++)
+    {
+        winetest_push_context("%s", wine_dbgstr_w(tags[i].tag));
+        hr = WindowsCreateString(tags[i].tag, wcslen(tags[i].tag), &tag);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ret = 2;
+        hr = ILanguageStatics_IsWellFormed(statics, tag, &ret);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        ok(ret == tags[i].well_formed, "Got %d.\n", ret);
+        WindowsDeleteString(tag);
+        winetest_pop_context();
+    }
+    ret = 2;
+    hr = ILanguageStatics_IsWellFormed(statics, NULL, &ret);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!ret, "Got %d.\n", ret);
+
+    /* the language of the thread's keyboard layout */
+    str = NULL;
+    hr = ILanguageStatics_get_CurrentInputMethodLanguageTag(statics, &str);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(WindowsGetStringLen(str) >= 2, "Got %s.\n", wine_dbgstr_hstring(str));
+    ret = 2;
+    hr = ILanguageStatics_IsWellFormed(statics, str, &ret);
+    ok(hr == S_OK && ret, "Got %#lx, %d for %s.\n", hr, ret, wine_dbgstr_hstring(str));
+
+    hr = IActivationFactory_QueryInterface(factory, &IID_ILanguageStatics2, (void **)&statics2);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    /* a language no keyboard layout is installed for */
+    hr = WindowsCreateString(L"xx-YY", 5, &tag);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ret = 2;
+    hr = ILanguageStatics2_TrySetInputMethodLanguageTag(statics2, tag, &ret);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!ret, "Got %d.\n", ret);
+    WindowsDeleteString(tag);
+    /* the one the thread types with already; Windows may say no, with no window in front */
+    ret = 2;
+    hr = ILanguageStatics2_TrySetInputMethodLanguageTag(statics2, str, &ret);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(ret == TRUE || ret == FALSE, "Got %d for %s.\n", ret, wine_dbgstr_hstring(str));
+    WindowsDeleteString(str);
+
+    ILanguageStatics2_Release(statics2);
+    ILanguageStatics_Release(statics);
+    IActivationFactory_Release(factory);
+}
+
 static void test_GeographicRegion(void)
 {
     static const WCHAR *class_name = RuntimeClass_Windows_Globalization_GeographicRegion;
@@ -506,6 +594,7 @@ START_TEST(globalization)
 
     test_GlobalizationPreferences();
     test_Language();
+    test_LanguageStatics();
     test_GeographicRegion();
     test_ApplicationLanguages();
 
