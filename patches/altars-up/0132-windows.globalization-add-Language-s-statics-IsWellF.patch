+
+static BOOL is_alpha(WCHAR c) { return (c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z'); }
+static BOOL is_digit(WCHAR c) { return c >= '0' && c <= '9'; }
+static BOOL is_alnum(WCHAR c) { return is_alpha(c) || is_digit(c); }
+
+static BOOL all_alpha(const WCHAR *s, size_t len)
+{
+    while (len--) if (!is_alpha(*s++)) return FALSE;
+    return TRUE;
+}
+
+static BOOL all_digit(const WCHAR *s, size_t len)
+{
+    while (len--) if (!is_digit(*s++)) return FALSE;
+    return TRUE;
+}
+
+/* A tag well formed as BCP 47 has it, but that a language of four to eight letters is turned away, as Windows
+ * turns it away; the grandfathered tags are taken whole, and a singleton that begins an extension twice is not
+ * well formed, a variant twice is. */
+static BOOL is_well_formed_tag(const WCHAR *tag)
+{
+    static const WCHAR *grandfathered[] =
+    {
+        L"en-GB-oed", L"i-ami", L"i-bnn", L"i-default", L"i-enochian", L"i-hak", L"i-klingon", L"i-lux", L"i-mingo",
+        L"i-navajo", L"i-pwn", L"i-tao", L"i-tay", L"i-tsu", L"sgn-BE-FR", L"sgn-BE-NL", L"sgn-CH-DE",
+        L"art-lojban", L"cel-gaulish", L"no-bok", L"no-nyn", L"zh-guoyu", L"zh-hakka", L"zh-min", L"zh-min-nan",
+        L"zh-xiang",
+    };
+    enum { LANGUAGE, EXTLANG, SCRIPT, REGION, VARIANT, EXTENSION, EXTENSION_SUBTAG, PRIVATE, PRIVATE_SUBTAG } state;
+    WCHAR singletons[36];
+    unsigned int i, extlangs = 0, singleton_count = 0;
+    const WCHAR *p = tag, *end;
+    size_t len;
+
+    for (i = 0; i < ARRAY_SIZE(grandfathered); i++)
+        if (!wcsicmp(tag, grandfathered[i])) return TRUE;
+
+    state = LANGUAGE;
+    for (;;)
+    {
+        for (end = p; *end && *end != '-'; end++)
+            if (!is_alnum(*end)) return FALSE;
+        len = end - p;
+        if (!len || len > 8) return FALSE;
+
+        switch (state)
+        {
+        case LANGUAGE:
+            if (len == 1 && (*p == 'x' || *p == 'X')) state = PRIVATE;
+            else if ((len == 2 || len == 3) && all_alpha(p, len)) state = EXTLANG;
+            else return FALSE;
+            break;
+
+        case EXTLANG:
+        case SCRIPT:
+        case REGION:
+        case VARIANT:
+        case EXTENSION_SUBTAG:
+            if (state == EXTENSION_SUBTAG && len >= 2)
+                break;
+            if (state == EXTLANG && len == 3 && all_alpha(p, len) && extlangs < 3)
+            {
+                extlangs++;
+                break;
+            }
+            if (state <= SCRIPT && len == 4 && all_alpha(p, len))
+            {
+                state = REGION;
+                break;
+            }
+            if (state <= REGION && ((len == 2 && all_alpha(p, len)) || (len == 3 && all_digit(p, len))))
+            {
+                state = VARIANT;
+                break;
+            }
+            if (state <= VARIANT && (len >= 5 || (len == 4 && is_digit(*p))))
+            {
+                state = VARIANT;
+                break;
+            }
+            if (len == 1 && (*p == 'x' || *p == 'X'))
+            {
+                state = PRIVATE;
+                break;
+            }
+            if (len == 1 && state != EXTENSION)
+            {
+                for (i = 0; i < singleton_count; i++)
+                    if (towlower(singletons[i]) == towlower(*p)) return FALSE;
+                singletons[singleton_count++] = *p;
+                state = EXTENSION;
+                break;
+            }
+            return FALSE;
+
+        case EXTENSION:
+            if (len < 2) return FALSE;
+            state = EXTENSION_SUBTAG;
+            break;
+
+        case PRIVATE:
+        case PRIVATE_SUBTAG:
+            state = PRIVATE_SUBTAG;
+            break;
+        }
+
+        if (!*end) break;
+        p = end + 1;
+    }
+    return state != EXTENSION && state != PRIVATE;
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics_IsWellFormed(ILanguageStatics *iface, HSTRING tag, BOOLEAN *result)
+{
+    TRACE("iface %p, tag %s, result %p.\n", iface, debugstr_hstring(tag), result);
+
+    if (!result) return E_POINTER;
+    *result = is_well_formed_tag(WindowsGetStringRawBuffer(tag, NULL));
+    return S_OK;
+}
+
+/* the language tag of a locale's name: as Windows writes them, Chinese names have no script and tags do */
+static void language_tag_from_locale_name(const WCHAR *name, WCHAR *tag, size_t size)
+{
+    static const struct { const WCHAR *name, *tag; } chinese[] =
+    {
+        { L"zh-CN", L"zh-Hans-CN" }, { L"zh-SG", L"zh-Hans-SG" },
+        { L"zh-TW", L"zh-Hant-TW" }, { L"zh-HK", L"zh-Hant-HK" }, { L"zh-MO", L"zh-Hant-MO" },
+    };
+    unsigned int i;
+
+    for (i = 0; i < ARRAY_SIZE(chinese); i++)
+    {
+        if (wcsicmp(name, chinese[i].name)) continue;
+        lstrcpynW(tag, chinese[i].tag, size);
+        return;
+    }
+    lstrcpynW(tag, name, size);
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics_get_CurrentInputMethodLanguageTag(ILanguageStatics *iface,
+        HSTRING *value)
+{
+    WCHAR name[LOCALE_NAME_MAX_LENGTH], tag[LOCALE_NAME_MAX_LENGTH];
+    HKL layout = GetKeyboardLayout(0);
+
+    TRACE("iface %p, value %p.\n", iface, value);
+
+    if (!value) return E_POINTER;
+    /* the language of the keyboard layout the thread types with */
+    if (!LCIDToLocaleName(MAKELCID(LOWORD(layout), SORT_DEFAULT), name, ARRAY_SIZE(name), 0))
+        return HRESULT_FROM_WIN32(GetLastError());
+    language_tag_from_locale_name(name, tag, ARRAY_SIZE(tag));
+    return WindowsCreateString(tag, wcslen(tag), value);
+}
+
+static const struct ILanguageStaticsVtbl language_statics_vtbl =
+{
+    language_statics_QueryInterface,
+    language_statics_AddRef,
+    language_statics_Release,
+    /* IInspectable methods */
+    language_statics_GetIids,
+    language_statics_GetRuntimeClassName,
+    language_statics_GetTrustLevel,
+    /* ILanguageStatics methods */
+    language_statics_IsWellFormed,
+    language_statics_get_CurrentInputMethodLanguageTag,
+};
+
