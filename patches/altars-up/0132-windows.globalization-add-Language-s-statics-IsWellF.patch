+    FIXME("iface %p, iid_count %p, iids %p stub!\n", iface, iid_count, iids);
+    return E_NOTIMPL;
+}
+
+static HRESULT STDMETHODCALLTYPE language_statics2_GetRuntimeClassName(ILanguageStatics2 *iface, HSTRING *class_name)
