+/* a stream that gives some data, then answers Read with a result of its choosing */
+struct read_stream
+{
+    IStream IStream_iface;
+    const char *data;
+    HRESULT result;
+    BOOL given;
+};
+
+static HRESULT WINAPI read_stream_QueryInterface(IStream *iface, REFIID riid, void **obj)
+{
+    if (IsEqualGUID(riid, &IID_IUnknown) || IsEqualGUID(riid, &IID_ISequentialStream) ||
+            IsEqualGUID(riid, &IID_IStream))
+    {
+        *obj = iface;
+        return S_OK;
+    }
+    *obj = NULL;
+    return E_NOINTERFACE;
+}
+
+static ULONG WINAPI read_stream_AddRef(IStream *iface)
+{
+    return 2;
+}
+
+static ULONG WINAPI read_stream_Release(IStream *iface)
+{
+    return 1;
+}
+
+static HRESULT WINAPI read_stream_Read(IStream *iface, void *buffer, ULONG size, ULONG *read)
+{
+    struct read_stream *stream = CONTAINING_RECORD(iface, struct read_stream, IStream_iface);
+    ULONG len = stream->data && !stream->given ? strlen(stream->data) : 0;
+
+    if (len && len <= size)
+    {
+        memcpy(buffer, stream->data, len);
+        if (read) *read = len;
+        stream->given = TRUE;
+        return S_OK;
+    }
+    /* a failure leaves the count as it was */
+    if (SUCCEEDED(stream->result) && read) *read = 0;
+    return stream->result;
+}
+
+static HRESULT WINAPI read_stream_Write(IStream *iface, const void *data, ULONG size, ULONG *written)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_Seek(IStream *iface, LARGE_INTEGER move, DWORD origin, ULARGE_INTEGER *pos)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_SetSize(IStream *iface, ULARGE_INTEGER size)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_CopyTo(IStream *iface, IStream *stream, ULARGE_INTEGER len,
+        ULARGE_INTEGER *read, ULARGE_INTEGER *written)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_Commit(IStream *iface, DWORD flags)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_Revert(IStream *iface)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_LockRegion(IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER len, DWORD type)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_UnlockRegion(IStream *iface, ULARGE_INTEGER offset, ULARGE_INTEGER len, DWORD type)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_Stat(IStream *iface, STATSTG *stat, DWORD flags)
+{
+    return E_NOTIMPL;
+}
+
+static HRESULT WINAPI read_stream_Clone(IStream *iface, IStream **stream)
+{
+    return E_NOTIMPL;
+}
+
+static const IStreamVtbl read_stream_vtbl =
+{
+    read_stream_QueryInterface,
+    read_stream_AddRef,
+    read_stream_Release,
+    read_stream_Read,
+    read_stream_Write,
+    read_stream_Seek,
+    read_stream_SetSize,
+    read_stream_CopyTo,
+    read_stream_Commit,
+    read_stream_Revert,
+    read_stream_LockRegion,
+    read_stream_UnlockRegion,
+    read_stream_Stat,
+    read_stream_Clone,
+};
+
+#define check_parse_error_code(doc, expect) check_parse_error_code_(__LINE__, doc, expect)
+static void check_parse_error_code_(unsigned int line, IXMLDOMDocument *doc, HRESULT expect)
+{
+    IXMLDOMParseError *error;
+    LONG code = 0;
+    HRESULT hr;
+
+    hr = IXMLDOMDocument_get_parseError(doc, &error);
+    ok_(__FILE__, line)(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMParseError_get_errorCode(error, &code);
+    ok_(__FILE__, line)(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok_(__FILE__, line)(code == expect, "Unexpected error code %#lx.\n", code);
+    IXMLDOMParseError_Release(error);
+}
+
 /* Loading a document from another document goes through that document's stream.  Its Read fails
  * without setting the count while the stream is written to (see test_document_stream), and Word
  * loads documents from empty ones: none of this may read the count. */
 static void test_load_from_document_stream(void)
 {
+    static const struct
+    {
+        const char *data;
+        HRESULT result;
+        HRESULT error;
+    }
+    streams[] =
+    {
+        { NULL, E_FAIL, E_FAIL },
+        { "<a>", E_FAIL, E_FAIL },
+        { NULL, S_FALSE, 0xc00ce558 /* XML_E_MISSINGROOT */ },
+        { NULL, S_OK, 0xc00ce558 },
+    };
+    struct read_stream read_stream = { { &read_stream_vtbl } };
+    IPersistStreamInit *persist;
+    char buffer[16];
+    unsigned int i;
     IXMLDOMDocument *src, *doc;
     IXMLDOMElement *root;
     VARIANT_BOOL loaded;
@@ -19875,18 +20024,73 @@ static void test_load_from_document_stream(void)
     IStream_Release(stream);
     IXMLDOMDocument_Release(src);
 
-    /* from an empty document */
+    /* an empty document reads as an empty stream */
     src = create_document(&IID_IXMLDOMDocument);
+    hr = IXMLDOMDocument_QueryInterface(src, &IID_IStream, (void **)&stream);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    length = 0xdeadbeef;
+    hr = IStream_Read(stream, buffer, sizeof(buffer), &length);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!length, "Unexpected length %lu.\n", length);
+    IStream_Release(stream);
+
+    /* so loading from one finds no root */
     doc = create_document(&IID_IXMLDOMDocument);
     V_VT(&v) = VT_UNKNOWN;
     V_UNKNOWN(&v) = (IUnknown *)src;
     loaded = VARIANT_TRUE;
     hr = IXMLDOMDocument_load(doc, v, &loaded);
-    trace("load from an empty document: hr %#lx, loaded %d.\n", hr, loaded);
+    ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+    ok(loaded == VARIANT_FALSE, "Unexpected result %d.\n", loaded);
+    check_parse_error_code(doc, 0xc00ce558);
     hr = IXMLDOMDocument_get_documentElement(doc, &root);
     ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
     IXMLDOMDocument_Release(doc);
     IXMLDOMDocument_Release(src);
+
+    /* a document is a source as an IDispatch too */
+    src = create_document(&IID_IXMLDOMDocument);
+    hr = IXMLDOMDocument_loadXML(src, _bstr_("<root/>"), &loaded);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    doc = create_document(&IID_IXMLDOMDocument);
+    V_VT(&v) = VT_DISPATCH;
+    V_DISPATCH(&v) = (IDispatch *)src;
+    loaded = VARIANT_FALSE;
+    hr = IXMLDOMDocument_load(doc, v, &loaded);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(loaded == VARIANT_TRUE, "Unexpected result %d.\n", loaded);
+    hr = IXMLDOMDocument_get_documentElement(doc, &root);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    if (hr == S_OK) IXMLDOMElement_Release(root);
+    IXMLDOMDocument_Release(doc);
+    IXMLDOMDocument_Release(src);
+
+    /* what a stream that fails or gives nothing leaves: load answers S_FALSE, and the error is the
+     * stream's or the parser's */
+    for (i = 0; i < ARRAY_SIZE(streams); i++)
+    {
+        winetest_push_context("%u", i);
+        doc = create_document(&IID_IXMLDOMDocument);
+        read_stream.data = streams[i].data;
+        read_stream.result = streams[i].result;
+        read_stream.given = FALSE;
+        V_VT(&v) = VT_UNKNOWN;
+        V_UNKNOWN(&v) = (IUnknown *)&read_stream.IStream_iface;
+        loaded = VARIANT_TRUE;
+        hr = IXMLDOMDocument_load(doc, v, &loaded);
+        ok(hr == S_FALSE, "Unexpected hr %#lx.\n", hr);
+        ok(loaded == VARIANT_FALSE, "Unexpected result %d.\n", loaded);
+        check_parse_error_code(doc, streams[i].error);
+
+        read_stream.given = FALSE;
+        hr = IXMLDOMDocument_QueryInterface(doc, &IID_IPersistStreamInit, (void **)&persist);
+        ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+        hr = IPersistStreamInit_Load(persist, &read_stream.IStream_iface);
+        ok(hr == streams[i].error, "Unexpected hr %#lx.\n", hr);
+        IPersistStreamInit_Release(persist);
+        IXMLDOMDocument_Release(doc);
+        winetest_pop_context();
+    }
 }
 
 START_TEST(domdoc)
