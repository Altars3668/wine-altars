From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 07:00:12 -0400
Subject: [PATCH] msxml3: Load from streams and documents as Windows does.

Measured against MSXML 3 and 6 on Windows 11 (build 29671):

- An empty document's stream reads as an empty stream, S_OK and no
  bytes; it failed Read without setting the count, the path on which
  Word's References tab used to crash.
- A document is a source as an IDispatch as well as an IUnknown.
- load() answers S_FALSE when the stream fails or does not parse, leaves
  an empty document, and parseError says why; it returned the error.
- That error is the stream's own, or the parser's: XML_E_MISSINGROOT for
  a stream with nothing in it, where E_FAIL replaced it.  IPersistStreamInit
  Load returns the same.  Two todo_wine tests pass now.

Not done: a stream answering E_PENDING, which Windows keeps reading later.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/msxml3/domdoc.c b/dlls/msxml3/domdoc.c
index 872d0389e8a..e73cd336ce6 100644
--- a/dlls/msxml3/domdoc.c
+++ b/dlls/msxml3/domdoc.c
@@ -313,10 +313,11 @@ static HRESULT domdoc_load_from_stream(domdoc *doc, ISequentialStream *stream)
     domdoc_set_parse_error(doc, &error);
     IStream_Release(hstream);
 
+    /* the parser's own error, XML_E_MISSINGROOT for nothing at all, as on Windows */
     if (!node)
     {
-        ERR("Failed to parse xml\n");
-        return E_FAIL;
+        WARN("failed to parse, hr %#lx.\n", hr);
+        return FAILED(hr) ? hr : E_FAIL;
     }
 
     attach_doc_node(doc, node);
@@ -1291,7 +1292,7 @@ static HRESULT WINAPI domdoc_load(IXMLDOMDocument3 *iface, VARIANT source, VARIA
                 }
                 else
                 {
-                    doc->error = E_FAIL;
+                    doc->error = FAILED(hr) ? hr : E_FAIL;
                     TRACE("failed to parse document\n");
                 }
 
@@ -1302,6 +1303,8 @@ static HRESULT WINAPI domdoc_load(IXMLDOMDocument3 *iface, VARIANT source, VARIA
             }
         }
         break;
+    /* another document comes as either */
+    case VT_DISPATCH:
     case VT_UNKNOWN:
 
         if (!V_UNKNOWN(&source)) return E_INVALIDARG;
@@ -1310,10 +1313,14 @@ static HRESULT WINAPI domdoc_load(IXMLDOMDocument3 *iface, VARIANT source, VARIA
             || IUnknown_QueryInterface(V_UNKNOWN(&source), &IID_ISequentialStream, (void **)&stream) == S_OK)
         {
             hr = doc->error = domdoc_load_from_stream(doc, stream);
+            ISequentialStream_Release(stream);
             if (SUCCEEDED(hr))
+            {
                 *result = VARIANT_TRUE;
-            ISequentialStream_Release(stream);
-            return hr;
+                return hr;
+            }
+            /* what failed leaves an empty document, and the error to parseError */
+            break;
         }
         else if (IUnknown_QueryInterface(V_UNKNOWN(&source), &IID_IPersistStream, (void **)&unk) == S_OK)
         {
@@ -2658,6 +2665,12 @@ static HRESULT WINAPI docstream_Read(IStream *iface, void *buffer, ULONG size, U
     hr = docstream_save(stream);
     if (hr == S_OK && stream->state == DOCSTREAM_STATE_READING)
         return IStream_Read(stream->stream, buffer, size, read_size);
+    /* an empty document reads as an empty stream, and can still be written to */
+    if (hr == S_OK && stream->state == DOCSTREAM_STATE_INITIAL)
+    {
+        if (read_size) *read_size = 0;
+        return S_OK;
+    }
 
     return E_FAIL;
 }
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index 6796eec05a9..289a5ae0676 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -2198,10 +2198,10 @@ static void test_persiststream(void)
 
     istream = SHCreateMemStream((const BYTE*)"", 0);
     hr = IPersistStreamInit_Load(streaminit, istream);
-    todo_wine ok(hr == XML_E_MISSINGROOT, "Unexpected hr %#lx.\n", hr);
