From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 01:26:34 -0400
Subject: [PATCH] server: Refuse to rename a directory with anything open
 beneath it.

[MS-FSA] 2.1.5.15.12 fails the rename of a directory holding an open file,
at any depth, with STATUS_ACCESS_DENIED (2.1.4.2), which is what the
rename test expects of a directory whose file is open for delete on
close.  Wine renamed it, leaving every open beneath it on a path that no
longer existed.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 567aeceaf8f..0afc10b19f2 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -2119,23 +2119,17 @@ static void test_file_rename_information(FILE_INFORMATION_CLASS class)
 
     io.Status = 0xdeadbeef;
     res = pNtSetInformationFile( handle, &io, fri, sizeof(FILE_RENAME_INFORMATION) + fri->FileNameLength, class );
-    todo_wine ok( io.Status == 0xdeadbeef || io.Status == STATUS_ACCESS_DENIED, "io.Status got %lx\n", io.Status );
-    todo_wine ok( res == STATUS_ACCESS_DENIED, "res expected STATUS_ACCESS_DENIED, got %lx\n", res );
+    ok( io.Status == 0xdeadbeef || io.Status == STATUS_ACCESS_DENIED, "io.Status got %lx\n", io.Status );
+    ok( res == STATUS_ACCESS_DENIED, "res expected STATUS_ACCESS_DENIED, got %lx\n", res );
     fileDeleted = GetFileAttributesW( oldpath ) == INVALID_FILE_ATTRIBUTES && GetLastError() == ERROR_FILE_NOT_FOUND;
-    todo_wine ok( !fileDeleted, "file should exist\n" );
+    ok( !fileDeleted, "file should exist\n" );
     fileDeleted = GetFileAttributesW( newpath ) == INVALID_FILE_ATTRIBUTES && GetLastError() == ERROR_FILE_NOT_FOUND;
-    todo_wine ok( fileDeleted, "file should not exist\n" );
+    ok( fileDeleted, "file should not exist\n" );
 
     CloseHandle( handle );
     CloseHandle( handle2 );
     HeapFree( GetProcessHeap(), 0, fri );
     delete_object( oldpath );
-    if (res == STATUS_SUCCESS) /* remove when Wine is fixed */
-    {
-        lstrcpyW( oldpath, newpath );
-        lstrcatW( oldpath, foo_txtW );
-        delete_object( oldpath );
-    }
     delete_object( newpath );
 
     /* oldpath is a directory, newpath is a file, Replace = FALSE */
diff --git a/server/fd.c b/server/fd.c
index cc166b9acf7..ac24a3e4547 100644
--- a/server/fd.c
+++ b/server/fd.c
@@ -2885,6 +2885,28 @@ static void set_fd_disposition( struct fd *fd, unsigned int flags )
         ((fd->options & FILE_DELETE_ON_CLOSE) ? FILE_DISPOSITION_DELETE : 0);
 }
 
+/* whether anything beneath a directory is open, which keeps it from being renamed */
+static int is_dir_in_use( const char *dir )
+{
+    size_t len = strlen( dir );
+    struct device *device;
+    struct inode *inode;
+    unsigned int i, j;
+    struct fd *fd;
+
+    for (i = 0; i < DEVICE_HASH_SIZE; i++)
+    {
+        if (!device_hash[i].next) continue;  /* not used yet */
+        LIST_FOR_EACH_ENTRY( device, &device_hash[i], struct device, entry )
+            for (j = 0; j < INODE_HASH_SIZE; j++)
+                LIST_FOR_EACH_ENTRY( inode, &device->inode_hash[j], struct inode, entry )
+                    LIST_FOR_EACH_ENTRY( fd, &inode->open, struct fd, inode_entry )
+                        if (fd->unix_name && !strncmp( fd->unix_name, dir, len ) && fd->unix_name[len] == '/')
+                            return 1;
+    }
+    return 0;
+}
+
 /* the other opens of a renamed file by the name it had, and the deletes pending on that name, follow it */
 static void rename_other_opens( struct fd *fd, const char *old_name )
 {
@@ -2962,6 +2984,13 @@ static void set_fd_name( struct fd *fd, struct fd *root, const char *nameptr, da
         goto failed;
     }
 
+    /* a directory with anything open beneath it stays where it is */
+    if (!create_link && !fstat( fd->unix_fd, &st ) && S_ISDIR( st.st_mode ) && is_dir_in_use( fd->unix_name ))
+    {
+        set_error( STATUS_ACCESS_DENIED );
+        goto failed;
+    }
+
     if (!stat( name, &st ))
     {
         if (!fstat( fd->unix_fd, &st2 ) && st.st_ino == st2.st_ino && st.st_dev == st2.st_dev)
