From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 12:38:52 -0400
Subject: [PATCH] msspellcheckingfacility: A word repeating a wrong one is no
 repetition, and IsSupported clears its answer.

As Windows 11 has it (tools/spellprobe): "helo helo" is two misspelt
words, and after a corrected word the same word in capitals is checked
as any other; only a word that repeats a right one is to be deleted.
IsSupported clears the answer before refusing an empty tag.  The tests
have no failures on Windows (364).

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msspellcheckingfacility/checker.c b/dlls/msspellcheckingfacility/checker.c
index 17ab0534666..917b600a867 100644
--- a/dlls/msspellcheckingfacility/checker.c
+++ b/dlls/msspellcheckingfacility/checker.c
@@ -515,20 +515,22 @@ static BOOL add_misspelling( struct checker *checker, struct error_enum *errors,
     return ret;
 }
 
+/* check a word, telling whether it is right */
 static BOOL check_word( struct checker *checker, struct error_enum *errors, const WCHAR *text, ULONG start,
-                        ULONG len, BOOL comprehensive )
+                        ULONG len, BOOL comprehensive, BOOL *right )
 {
     WCHAR *correction;
     ULONG part, end;
     BOOL ret = TRUE;
 
+    *right = FALSE;
     if ((correction = find_autocorrect( checker->language, text + start, len )))
     {
         ret = add_error( errors, start, len, CORRECTIVE_ACTION_REPLACE, correction );
         free( correction );
         return ret;
     }
-    if (is_word_right( checker, text + start, len )) return TRUE;
+    if ((*right = is_word_right( checker, text + start, len ))) return TRUE;
     /* in a compound, the parts that are wrong */
     for (part = start; part < start + len && !is_hyphen( text[part] ); part++) ;
     if (part == start + len) return add_misspelling( checker, errors, text, start, len, comprehensive );
@@ -545,7 +547,7 @@ static HRESULT check_text( struct checker *checker, const WCHAR *text, BOOL comp
 {
     ULONG len = wcslen( text ), pos = 0, end, prev_start = 0, prev_len = 0;
     struct error_enum *errors;
-    BOOL repeatable = FALSE, ok = TRUE;
+    BOOL repeatable = FALSE, ok = TRUE, right;
 
     if (!(errors = calloc( 1, sizeof(*errors) ))) return E_OUTOFMEMORY;
     errors->IEnumSpellingError_iface.lpVtbl = &error_enum_vtbl;
@@ -598,8 +600,9 @@ static HRESULT check_text( struct checker *checker, const WCHAR *text, BOOL comp
             ok = add_error( errors, pos, end - pos, CORRECTIVE_ACTION_DELETE, NULL );
         else
         {
-            ok = check_word( checker, errors, text, pos, end - pos, comprehensive );
-            repeatable = TRUE;
+            /* a word repeating one that is wrong is an error of its own, not a repetition */
+            ok = check_word( checker, errors, text, pos, end - pos, comprehensive, &right );
+            repeatable = right;
         }
         prev_start = pos;
         prev_len = end - pos;
diff --git a/dlls/msspellcheckingfacility/main.c b/dlls/msspellcheckingfacility/main.c
index 35b9d27d628..55dd4163c01 100644
--- a/dlls/msspellcheckingfacility/main.c
+++ b/dlls/msspellcheckingfacility/main.c
@@ -460,6 +460,7 @@ static HRESULT WINAPI spell_factory_IsSupported( ISpellCheckerFactory *iface, co
     TRACE( "%p, %s, %p\n", iface, debugstr_w(tag), value );
 
     if (!tag || !value) return E_POINTER;
+    *value = FALSE;
     if (!*tag) return E_INVALIDARG;
     *value = find_language( tag ) != NULL;
     return S_OK;
diff --git a/dlls/msspellcheckingfacility/tests/spellcheck.c b/dlls/msspellcheckingfacility/tests/spellcheck.c
index d831be187d7..bf4cef18223 100644
--- a/dlls/msspellcheckingfacility/tests/spellcheck.c
+++ b/dlls/msspellcheckingfacility/tests/spellcheck.c
@@ -230,8 +230,10 @@ static void test_factory( ISpellCheckerFactory *factory )
 
     hr = ISpellCheckerFactory_IsSupported( factory, NULL, &supported );
     ok( hr == E_POINTER, "got %#lx\n", hr );
+    supported = 0xdead;
     hr = ISpellCheckerFactory_IsSupported( factory, L"", &supported );
     ok( hr == E_INVALIDARG, "got %#lx\n", hr );
+    ok( !supported, "got %d\n", supported );
     for (i = 0; i < ARRAY_SIZE(tags); i++)
     {
         supported = 0xdead;
@@ -280,6 +282,9 @@ static void test_checker( ISpellChecker *checker )
     static const struct expected_error in_brackets[] = { { 1, 5, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
     static const struct expected_error chinese[] = { { 0, 2, CORRECTIVE_ACTION_GET_SUGGESTIONS },
                                                      { 3, 5, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    /* a word repeating a wrong one is wrong itself, and no repetition */
+    static const struct expected_error helo_helo[] = { { 0, 4, CORRECTIVE_ACTION_GET_SUGGESTIONS },
+                                                       { 5, 4, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
     static const struct
     {
         const WCHAR *text;
@@ -312,6 +317,7 @@ static void test_checker( ISpellChecker *checker )
         { L"helo-world", helo_world },
         { L"(wrold)", in_brackets },
         { L"\x4f60\x597d wrold", chinese },
+        { L"helo helo", helo_helo },
     };
     IOptionDescription *description;
     IEnumSpellingError *errors;
@@ -372,6 +378,9 @@ static void test_word_lists( ISpellCheckerFactory *factory, ISpellChecker *check
     static const struct expected_error corrected[] =
         { { 0, 11, CORRECTIVE_ACTION_REPLACE, L"wineprobereplacement" }, { 0 } };
     static const struct expected_error corrected_capital[] = { { 0, 11, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
+    static const struct expected_error corrected_twice[] =
+        { { 0, 11, CORRECTIVE_ACTION_REPLACE, L"wineprobereplacement" },
+          { 12, 11, CORRECTIVE_ACTION_GET_SUGGESTIONS }, { 0 } };
     WCHAR path[MAX_PATH], *text;
     ISpellChecker *other;
     ISpellChecker2 *checker2;
@@ -434,6 +443,7 @@ static void test_word_lists( ISpellCheckerFactory *factory, ISpellChecker *check
     ok( hr == S_OK, "got %#lx\n", hr );
     ok( wait_events( seen + 2 ), "%ld events\n", events - seen );
     check_errors( checker, L"wineprobeac", FALSE, corrected );
+    check_errors( checker, L"wineprobeac Wineprobeac", FALSE, corrected_twice );
     check_errors( checker, L"wineprobeac", TRUE, corrected );
     check_errors( other, L"wineprobeac", FALSE, corrected );
     /* the correction is for the word as written */
