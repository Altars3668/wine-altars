Date: Sun, 27 Sep 2026 21:41:26 -0400
Subject: [PATCH] =?UTF-8?q?d2d1:=20Draw=20each=20cubic=20B=C3=A9zier=20as?=
 =?UTF-8?q?=20enough=20quadratic=20ones=20to=20follow=20it.?=
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

Each cubic Bézier of a path was drawn, filled and stroked, as one quadratic
Bézier, the one that matches it best in the middle.  That is off it by up
to √3/36 of its third difference, which for a strongly bent cubic is
several pixels: of the curve from {4, 20} through {30, 0} and {60, 30} to
{40, 60}, the part eight pixels wide at y = 16 was missing, where Windows
fills it; a circle of radius 500 drawn with cubics is off by 4 pixels.

The cubic is now split into equal parts in t until the quadratic for each
is within a ten thousandth of the curve's size, at most 32 of them, the
first starting at a BEZIER vertex and the others at SPLIT_BEZIER ones, which
the code going back to the cubics -- bounds, Simplify -- already passes
over.  A cubic that is a quadratic raised is still one part.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 44fc0e8dd0bbc851cf07a2d52e84f33548c406bf)

diff --git a/dlls/d2d1/geometry.c b/dlls/d2d1/geometry.c
index 8f644bd44c4..2f336ed9eb1 100644
--- a/dlls/d2d1/geometry.c
+++ b/dlls/d2d1/geometry.c
@@ -1126,37 +1126,77 @@ static BOOL d2d_figure_add_original_bezier_controls(struct d2d_figure *figure, s
     return TRUE;
 }
 
+/* A cubic Bézier's point, and its derivative over three, at "t". */
+static void d2d_cubic_bezier_evaluate(const D2D1_POINT_2F *p0, const D2D1_BEZIER_SEGMENT *b, float t,
+        D2D1_POINT_2F *p, D2D1_POINT_2F *d)
+{
+    float s = 1.0f - t;
+
+    p->x = s * s * s * p0->x + 3.0f * s * s * t * b->point1.x + 3.0f * s * t * t * b->point2.x + t * t * t * b->point3.x;
+    p->y = s * s * s * p0->y + 3.0f * s * s * t * b->point1.y + 3.0f * s * t * t * b->point2.y + t * t * t * b->point3.y;
+    d->x = s * s * (b->point1.x - p0->x) + 2.0f * s * t * (b->point2.x - b->point1.x) + t * t * (b->point3.x - b->point2.x);
+    d->y = s * s * (b->point1.y - p0->y) + 2.0f * s * t * (b->point2.y - b->point1.y) + t * t * (b->point3.y - b->point2.y);
+}
+
+/* A cubic Bézier is drawn as quadratic ones, the first starting at a BEZIER vertex and the others at
+ * SPLIT_BEZIER ones, which what goes back to the cubics (bounds, Simplify) passes over. Each quadratic has for
+ * its control point the one that best matches the cubic over that part of it, off it by at most √3/36 of the
+ * part's third difference, which falls with the cube of the number of parts; there are as many as bring that
+ * within a ten thousandth of the curve's size. */
 static bool d2d_figure_add_beziers(struct d2d_figure *figure, const D2D1_BEZIER_SEGMENT *beziers,
         UINT32 count)
 {
-    D2D1_POINT_2F p;
-    unsigned int i;
+    D2D1_POINT_2F p0, s0, s3, d0, d3, q;
+    float third, size, error, h;
+    unsigned int i, j, n;
 
     for (i = 0; i < count; ++i)
     {
+        const D2D1_BEZIER_SEGMENT *b = &beziers[i];
         D2D1_RECT_F bezier_bounds;
 
-        if (!d2d_figure_add_original_bezier_controls(figure, 1, &beziers[i].point1)
-                || !d2d_figure_add_original_bezier_controls(figure, 1, &beziers[i].point2))
+        if (!d2d_figure_add_original_bezier_controls(figure, 1, &b->point1)
+                || !d2d_figure_add_original_bezier_controls(figure, 1, &b->point2))
         {
             return false;
         }
 
-        /* FIXME: This tries to approximate a cubic Bézier with a quadratic one. */
-        p.x = (beziers[i].point1.x + beziers[i].point2.x) * 0.75f;
-        p.y = (beziers[i].point1.y + beziers[i].point2.y) * 0.75f;
-        p.x -= (figure->vertices[figure->vertex_count - 1].x + beziers[i].point3.x) * 0.25f;
-        p.y -= (figure->vertices[figure->vertex_count - 1].y + beziers[i].point3.y) * 0.25f;
+        p0 = figure->vertices[figure->vertex_count - 1];
         figure->vertex_types[figure->vertex_count - 1] = D2D_VERTEX_TYPE_BEZIER;
 
-        d2d_rect_get_cubic_bezier_bounds(&bezier_bounds, &figure->vertices[figure->vertex_count - 1],
-                &beziers[i].point1, &beziers[i].point2, &beziers[i].point3);
+        d2d_rect_get_cubic_bezier_bounds(&bezier_bounds, &p0, &b->point1, &b->point2, &b->point3);
 
-        if (!d2d_figure_add_bezier_controls(figure, 1, &p))
-            return false;
+        third = hypotf(b->point3.x - 3.0f * b->point2.x + 3.0f * b->point1.x - p0.x,
+                b->point3.y - 3.0f * b->point2.y + 3.0f * b->point1.y - p0.y);
+        size = max(bezier_bounds.right - bezier_bounds.left, bezier_bounds.bottom - bezier_bounds.top);
+        error = third * sqrtf(3.0f) / 36.0f;
+        n = 1;
+        if (size > 0.0f && error > size * 1.0e-4f)
+            n = min(ceilf(cbrtf(error / (size * 1.0e-4f))), 32.0f);
 
-        if (!d2d_figure_add_vertex(figure, beziers[i].point3))
-            return false;
+        d2d_cubic_bezier_evaluate(&p0, b, 0.0f, &s0, &d0);
+        s0 = p0;
+        h = 1.0f / n;
+        for (j = 1; j <= n; ++j)
+        {
+            d2d_cubic_bezier_evaluate(&p0, b, j * h, &s3, &d3);
+            if (j == n)
+                s3 = b->point3;
+
+            /* The part's own control points are s0 + h·d0 and s3 - h·d3; the quadratic's is ¾ of their sum
+             * less ¼ of its ends'. */
+            q.x = 0.75f * (s0.x + h * d0.x + s3.x - h * d3.x) - 0.25f * (s0.x + s3.x);
+            q.y = 0.75f * (s0.y + h * d0.y + s3.y - h * d3.y) - 0.25f * (s0.y + s3.y);
+            if (!d2d_figure_add_bezier_controls(figure, 1, &q))
+                return false;
+            if (!d2d_figure_add_vertex(figure, s3))
+                return false;
+            if (j < n)
+                figure->vertex_types[figure->vertex_count - 1] = D2D_VERTEX_TYPE_SPLIT_BEZIER;
+
+            s0 = s3;
+            d0 = d3;
+        }
 
         d2d_rect_union(&figure->bounds, &bezier_bounds);
     }
