+static const GUID control_guid = {0x5a1e3c41, 0x7c11, 0x4b2a, {0x9e, 0x51, 0x30, 0x6b, 0x2f, 0x41, 0x8a, 0x77}};
+static const GUID control2_guid = {0x5a1e3c42, 0x7c11, 0x4b2a, {0x9e, 0x51, 0x30, 0x6b, 0x2f, 0x41, 0x8a, 0x77}};
+static const GUID classic_guid = {0x5a1e3c43, 0x7c11, 0x4b2a, {0x9e, 0x51, 0x30, 0x6b, 0x2f, 0x41, 0x8a, 0x77}};
+static const GUID class_guid = {0x5a1e3c44, 0x7c11, 0x4b2a, {0x9e, 0x51, 0x30, 0x6b, 0x2f, 0x41, 0x8a, 0x77}};
+static const GUID message_guid = {0x5a1e3c45, 0x7c11, 0x4b2a, {0x9e, 0x51, 0x30, 0x6b, 0x2f, 0x41, 0x8a, 0x77}};
+static const GUID activity_guid = {0x5a1e3c46, 0x7c11, 0x4b2a, {0x9e, 0x51, 0x30, 0x6b, 0x2f, 0x41, 0x8a, 0x77}};
+static const GUID related_guid = {0x5a1e3c47, 0x7c11, 0x4b2a, {0x9e, 0x51, 0x30, 0x6b, 0x2f, 0x41, 0x8a, 0x77}};
+static const GUID event_trace_guid = {0x68fdd900, 0x4a3e, 0x11d1, {0x84, 0xf4, 0x00, 0x00, 0xf8, 0x04, 0x64, 0xe3}};
+static const GUID null_guid;
+
+#define PRIVATE_MODE (EVENT_TRACE_PRIVATE_LOGGER_MODE | EVENT_TRACE_PRIVATE_IN_PROC)
+#define PROPS_SIZE (sizeof(EVENT_TRACE_PROPERTIES) + 2048 * sizeof(WCHAR))
+
+static EVENT_TRACE_PROPERTIES *new_props( ULONG mode, const GUID *guid, const WCHAR *file )
+{
+    EVENT_TRACE_PROPERTIES *props = calloc( 1, PROPS_SIZE );
+
+    props->Wnode.BufferSize = PROPS_SIZE;
+    props->Wnode.Flags = WNODE_FLAG_TRACED_GUID;
+    props->Wnode.ClientContext = 2;
+    if (guid) props->Wnode.Guid = *guid;
+    props->LogFileMode = mode;
+    props->LoggerNameOffset = sizeof(EVENT_TRACE_PROPERTIES);
+    if (file)
+    {
+        props->LogFileNameOffset = sizeof(EVENT_TRACE_PROPERTIES) + 1024 * sizeof(WCHAR);
+        wcscpy( (WCHAR *)((BYTE *)props + props->LogFileNameOffset), file );
+    }
+    return props;
+}
+
+static void session_name( WCHAR *name, const char *tag )
+{
+    swprintf( name, 64, L"WineTestTrace-%hs-%lu", tag, GetCurrentProcessId() );
+}
+
+static ULONG stop_session( TRACEHANDLE handle )
+{
+    EVENT_TRACE_PROPERTIES *props = new_props( 0, NULL, NULL );
+    ULONG ret = ControlTraceW( handle, NULL, props, EVENT_TRACE_CONTROL_STOP );
+
+    free( props );
+    return ret;
+}
+
+/* the enable callbacks, with whose they were */
+static struct
+{
+    const char *who;
+    ULONG code;
+    UCHAR level;
+    ULONGLONG any, all;
+    BOOL filter;
+    DWORD thread;
+} calls[32];
+static LONG call_count;
+
+static void WINAPI enable_callback( const GUID *source, ULONG code, UCHAR level, ULONGLONG any, ULONGLONG all,
+                                    EVENT_FILTER_DESCRIPTOR *filter, void *context )
+{
+    LONG i = InterlockedIncrement( &call_count ) - 1;
+
+    if (i >= ARRAY_SIZE(calls)) return;
+    calls[i].who = context;
+    calls[i].code = code;
+    calls[i].level = level;
+    calls[i].any = any;
+    calls[i].all = all;
+    calls[i].filter = !!filter;
+    calls[i].thread = GetCurrentThreadId();
+}
+
+#define check_call(a, b, c, d, e, f) check_call_(__LINE__, a, b, c, d, e, f)
+static void check_call_( unsigned int line, LONG i, const char *who, ULONG code, UCHAR level, ULONGLONG any,
+                         ULONGLONG all )
+{
+    ok_(__FILE__, line)( i < call_count, "call %ld did not happen\n", i );
+    if (i >= call_count) return;
+    ok_(__FILE__, line)( !strcmp( calls[i].who, who ), "call %ld: got %s\n", i, calls[i].who );
+    ok_(__FILE__, line)( calls[i].code == code, "call %ld: got code %lu\n", i, calls[i].code );
+    ok_(__FILE__, line)( calls[i].level == level, "call %ld: got level %u\n", i, calls[i].level );
+    ok_(__FILE__, line)( calls[i].any == any, "call %ld: got any %#I64x\n", i, calls[i].any );
+    ok_(__FILE__, line)( calls[i].all == all, "call %ld: got all %#I64x\n", i, calls[i].all );
+    ok_(__FILE__, line)( !calls[i].filter, "call %ld: got a filter\n", i );
+}
+
+static void test_private_start(void)
+{
+    EVENT_TRACE_PROPERTIES *props;
+    WCHAR name[64], file[MAX_PATH], temp[MAX_PATH];
+    TRACEHANDLE handle, handle2;
+    ULONG ret;
+
+    session_name( name, "start" );
+    GetTempPathW( ARRAY_SIZE(temp), temp );
+    swprintf( file, ARRAY_SIZE(file), L"%lsWineTestTrace-%lu.etl", temp, GetCurrentProcessId() );
+
+    /* a private logger is flushed when its buffers fill, is not read in real time, and is the process's own */
+    props = new_props( PRIVATE_MODE | EVENT_TRACE_BUFFERING_MODE, &control_guid, NULL );
+    props->FlushTimer = 1;
+    ret = StartTraceW( &handle, name, props );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    free( props );
+    props = new_props( PRIVATE_MODE | EVENT_TRACE_REAL_TIME_MODE, &control_guid, NULL );
+    ret = StartTraceW( &handle, name, props );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    free( props );
+    /* one not in-process would be started by the provider's process: Windows waits for that for a minute */
+
+    /* Office's own: circular, to a log file, added to triage dumps */
+    props = new_props( 0x80000000 | PRIVATE_MODE | EVENT_TRACE_FILE_MODE_CIRCULAR, &control_guid, NULL );
+    ret = StartTraceW( &handle, name, props );
+    ok( ret == ERROR_BAD_PATHNAME, "got %lu\n", ret );
+    free( props );
+    props = new_props( 0x80000000 | PRIVATE_MODE | EVENT_TRACE_FILE_MODE_CIRCULAR, &control_guid, file );
+    ret = StartTraceW( &handle, name, props );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    props->MaximumFileSize = 10;
+    handle = 0;
+    ret = StartTraceW( &handle, name, props );
+    ok( !ret, "got %lu\n", ret );
+    ok( !!handle, "got no handle\n" );
+    ok( props->LogFileMode == (PRIVATE_MODE | EVENT_TRACE_FILE_MODE_CIRCULAR), "got mode %#lx\n", props->LogFileMode );
+    ok( props->BufferSize == 4, "got %lu\n", props->BufferSize );
+    ok( props->MinimumBuffers == 16, "got %lu\n", props->MinimumBuffers );
+    ok( props->MaximumBuffers == 38, "got %lu\n", props->MaximumBuffers );
+    ok( !wcscmp( (WCHAR *)((BYTE *)props + props->LoggerNameOffset), name ), "got %s\n",
+        debugstr_w((WCHAR *)((BYTE *)props + props->LoggerNameOffset)) );
+    free( props );
+
+    props = new_props( PRIVATE_MODE | EVENT_TRACE_BUFFERING_MODE, &control2_guid, NULL );
+    ret = StartTraceW( &handle2, name, props );
+    ok( ret == ERROR_ALREADY_EXISTS, "got %lu\n", ret );
+    free( props );
+    ret = stop_session( handle );
+    ok( !ret, "got %lu\n", ret );
+    ret = stop_session( handle );
+    ok( ret == ERROR_WMI_INSTANCE_NOT_FOUND, "got %lu\n", ret );
+    ok( GetFileAttributesW( file ) != INVALID_FILE_ATTRIBUTES, "no log file\n" );
+    DeleteFileW( file );
+
+    /* kept in memory, its buffers are its own to choose; clock 0 is the performance counter */
+    props = new_props( PRIVATE_MODE | EVENT_TRACE_BUFFERING_MODE, &control_guid, NULL );
+    props->BufferSize = 64;
+    props->MinimumBuffers = 2;
+    props->MaximumBuffers = 4;
+    props->Wnode.ClientContext = 0;
+    ret = StartTraceW( &handle, name, props );
+    ok( !ret, "got %lu\n", ret );
+    ok( props->BufferSize == 64, "got %lu\n", props->BufferSize );
+    ok( props->MinimumBuffers == 16, "got %lu\n", props->MinimumBuffers );
+    ok( props->MaximumBuffers == 16, "got %lu\n", props->MaximumBuffers );
+    ok( props->Wnode.ClientContext == 1, "got clock %lu\n", props->Wnode.ClientContext );
+    ret = stop_session( handle );
+    ok( !ret, "got %lu\n", ret );
+    free( props );
+}
