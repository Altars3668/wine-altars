+    ok( query->Wnode.ClientContext == 2, "got %lu\n", query->Wnode.ClientContext );
+    ok( query->BufferSize == 4, "got %lu\n", query->BufferSize );
+    ok( query->NumberOfBuffers == 16, "got %lu\n", query->NumberOfBuffers );
+    ok( !query->BuffersWritten, "got %lu\n", query->BuffersWritten );
+    ok( !query->LoggerThreadId, "got %p\n", query->LoggerThreadId );
+    memset( query, 0, PROPS_SIZE );
+    query->Wnode.BufferSize = sizeof(EVENT_TRACE_PROPERTIES) + 10;
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_QUERY );
+    ok( ret == ERROR_MORE_DATA, "got %lu\n", ret );
+    ok( !query->LoggerNameOffset, "got %lu\n", query->LoggerNameOffset );
+
+    memset( query, 0, PROPS_SIZE );
+    query->Wnode.BufferSize = PROPS_SIZE;
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_FLUSH );
+    ok( ret == ERROR_FILE_NOT_FOUND, "got %lu\n", ret );
+    ret = ControlTraceW( handle, NULL, query, 9 );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    query->FlushTimer = 3;
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_UPDATE );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
