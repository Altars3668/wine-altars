+static void test_private_enable(void)
+{
+    EVENT_TRACE_PROPERTIES *props, *props2, *query;
+    ENABLE_TRACE_PARAMETERS params = { ENABLE_TRACE_PARAMETERS_VERSION_2 };
+    TRACEHANDLE handle, handle2;
+    REGHANDLE first, second;
+    WCHAR name[64], name2[64];
+    LONG from;
+    ULONG ret;
+
+    session_name( name, "enable" );
+    session_name( name2, "enable2" );
+    props = new_props( PRIVATE_MODE | EVENT_TRACE_BUFFERING_MODE, &control_guid, NULL );
+    ret = StartTraceW( &handle, name, props );
+    ok( !ret, "got %lu\n", ret );
+    if (ret)
+    {
+        free( props );
+        return;
+    }
+    EventRegister( &provider_guid, enable_callback, (void *)"first", &first );
+    EventRegister( &provider_guid, enable_callback, (void *)"second", &second );
+
+    /* a private session tells the providers on the spot, the newest registration first; keywords 0 are any */
+    call_count = 0;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 4, 0, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ok( call_count == 2, "got %ld calls\n", call_count );
+    check_call( 0, "second", EVENT_CONTROL_CODE_ENABLE_PROVIDER, 4, ~(ULONGLONG)0, 0 );
+    check_call( 1, "first", EVENT_CONTROL_CODE_ENABLE_PROVIDER, 4, ~(ULONGLONG)0, 0 );
+    ok( calls[0].thread == GetCurrentThreadId(), "called on another thread\n" );
+    ok( EventProviderEnabled( first, 4, 0x80 ), "not enabled\n" );
+    ok( !EventProviderEnabled( first, 5, 0 ), "enabled\n" );
+    ok( EventProviderEnabled( first, 0, 1 ), "not enabled\n" );
+
+    /* level 0 is any level */
+    from = call_count;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 0, 0x10, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    check_call( from, "second", EVENT_CONTROL_CODE_ENABLE_PROVIDER, 255, 0x10, 0 );
+    ok( EventProviderEnabled( first, 255, 0x10 ), "not enabled\n" );
+    ok( !EventProviderEnabled( first, 1, 0x20 ), "enabled\n" );
+    ok( EventProviderEnabled( first, 1, 0 ), "not enabled\n" );
+
+    from = call_count;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 3, 0x30, 0x10, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    check_call( from, "second", EVENT_CONTROL_CODE_ENABLE_PROVIDER, 3, 0x30, 0x10 );
+    ok( !EventProviderEnabled( first, 3, 0x20 ), "enabled\n" );
+    ok( EventProviderEnabled( first, 3, 0x10 ), "not enabled\n" );
+    ok( EventEnabled( first, &(EVENT_DESCRIPTOR){ 1, 0, 0, 3, 0, 0, 0x30 } ), "not enabled\n" );
+
+    /* capturing state tells them what is asked and changes nothing */
+    from = call_count;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_CAPTURE_STATE, 2, 0x40, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ok( call_count == from + 2, "got %ld calls\n", call_count - from );
+    check_call( from, "second", EVENT_CONTROL_CODE_CAPTURE_STATE, 2, 0x40, 0 );
+    ok( !EventProviderEnabled( first, 2, 0x40 ), "enabled\n" );
+
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 5, 0, 0, 0, &params );
+    ok( !ret, "got %lu\n", ret );
+    params.Version = 0;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 5, 0, 0, 0, &params );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    params.Version = 3;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 5, 0, 0, 0, &params );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+
+    /* with a second session, what they are told is both together */
+    props2 = new_props( PRIVATE_MODE | EVENT_TRACE_BUFFERING_MODE, &control2_guid, NULL );
+    ret = StartTraceW( &handle2, name2, props2 );
+    ok( !ret, "got %lu\n", ret );
+    from = call_count;
+    ret = EnableTraceEx2( handle2, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 2, 0x1, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    check_call( from, "second", EVENT_CONTROL_CODE_ENABLE_PROVIDER, 5, ~(ULONGLONG)0, 0 );
+    ok( EventProviderEnabled( first, 5, 0x2 ), "not enabled\n" );
+    from = call_count;
+    ret = stop_session( handle2 );
+    ok( !ret, "got %lu\n", ret );
+    check_call( from, "second", EVENT_CONTROL_CODE_ENABLE_PROVIDER, 5, ~(ULONGLONG)0, 0 );
+    free( props2 );
+
+    from = call_count;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_DISABLE_PROVIDER, 0, 0, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    check_call( from, "second", EVENT_CONTROL_CODE_DISABLE_PROVIDER, 0, 0, 0 );
+    check_call( from + 1, "first", EVENT_CONTROL_CODE_DISABLE_PROVIDER, 0, 0, 0 );
+    ok( !EventProviderEnabled( first, 5, 0x2 ), "enabled\n" );
+    from = call_count;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_DISABLE_PROVIDER, 0, 0, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ok( call_count == from, "got %ld calls\n", call_count - from );
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_CAPTURE_STATE, 4, 1, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    check_call( from, "second", EVENT_CONTROL_CODE_CAPTURE_STATE, 4, 1, 0 );
+
+    ret = EnableTraceEx2( handle, NULL, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 4, 1, 0, 0, NULL );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    ret = EnableTraceEx2( handle, &null_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 4, 1, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ret = EnableTraceEx2( 0, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 4, 1, 0, 0, NULL );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    ret = EnableTraceEx2( handle, &provider_guid, 99, 4, 1, 0, 0, NULL );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+
+    /* a provider registering is told what is enabled already */
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 2, 0x10c38, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    EventUnregister( second );
+    from = call_count;
+    EventRegister( &provider_guid, enable_callback, (void *)"third", &second );
+    ok( call_count == from + 1, "got %ld calls\n", call_count - from );
+    check_call( from, "third", EVENT_CONTROL_CODE_ENABLE_PROVIDER, 2, 0x10c38, 0 );
+
+    /* and stopping the session tells them it is over; unregistering tells nothing */
+    from = call_count;
+    query = new_props( 0, NULL, NULL );
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_STOP );
+    ok( !ret, "got %lu\n", ret );
+    check_call( from, "third", EVENT_CONTROL_CODE_DISABLE_PROVIDER, 0, 0, 0 );
+    check_call( from + 1, "first", EVENT_CONTROL_CODE_DISABLE_PROVIDER, 0, 0, 0 );
+    from = call_count;
+    EventUnregister( first );
+    EventUnregister( second );
+    ok( call_count == from, "got %ld calls\n", call_count - from );
