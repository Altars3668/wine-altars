+
+    session_name( name, "classic" );
+    props = new_props( PRIVATE_MODE | EVENT_TRACE_BUFFERING_MODE, &control_guid, NULL );
+    ret = StartTraceW( &handle, name, props );
+    ok( !ret, "got %lu\n", ret );
+    if (ret)
+    {
+        free( props );
+        return;
+    }
+    ret = RegisterTraceGuidsW( request_callback, NULL, &classic_guid, 1, classes, NULL, NULL, &classic );
+    ok( !ret, "got %lu\n", ret );
+
+    request_count = 0;
+    ret = EnableTraceEx2( handle, &classic_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 3,
+                          0xabcd1234 | (5ull << 32), 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ok( request_count == 1, "got %ld requests\n", request_count );
+    ok( requests[0].code == WMI_ENABLE_EVENTS, "got %u\n", requests[0].code );
+    ok( requests[0].size == sizeof(WNODE_HEADER), "got %lu\n", requests[0].size );
+    ok( requests[0].wnode.BufferSize == sizeof(WNODE_HEADER), "got %lu\n", requests[0].wnode.BufferSize );
+    ok( IsEqualGUID( &requests[0].wnode.Guid, &classic_guid ), "got %s\n", debugstr_guid(&requests[0].wnode.Guid) );
+    /* the logger, the level, a private one's flag, then the flags */
+    ok( requests[0].wnode.HistoricalContext == (0xabcd123401030000ull | (handle & 0xffff)), "got %#I64x\n",
+        requests[0].wnode.HistoricalContext );
+    ok( requests[0].logger == requests[0].wnode.HistoricalContext, "got %#I64x\n", requests[0].logger );
+    ok( requests[0].level == 3, "got %u\n", requests[0].level );
+    ok( requests[0].flags == 0xabcd1234, "got %#lx\n", requests[0].flags );
+    SetLastError( 0xdeadbeef );
+    ret = GetTraceEnableFlags( 0x12345 );
+    ok( !ret, "got %#lx\n", ret );
+    ok( GetLastError() == ERROR_INVALID_HANDLE, "got error %lu\n", GetLastError() );
+
+    ret = EnableTraceEx2( handle, &classic_guid, EVENT_CONTROL_CODE_DISABLE_PROVIDER, 0, 0, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ok( request_count == 2, "got %ld requests\n", request_count );
+    ok( requests[1].code == WMI_DISABLE_EVENTS, "got %u\n", requests[1].code );
+    ok( requests[1].wnode.HistoricalContext == handle, "got %#I64x\n", requests[1].wnode.HistoricalContext );
+
+    ret = EnableTrace( TRUE, 0x77, 4, &classic_guid, handle );
+    ok( !ret, "got %lu\n", ret );
+    ok( request_count == 3, "got %ld requests\n", request_count );
+    ok( requests[2].level == 4 && requests[2].flags == 0x77, "got %u %#lx\n", requests[2].level, requests[2].flags );
+    ret = EnableTraceEx( &classic_guid, NULL, handle, TRUE, 5, 0x88, 0, 0, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ok( request_count == 4, "got %ld requests\n", request_count );
+    ok( requests[3].level == 5 && requests[3].flags == 0x88, "got %u %#lx\n", requests[3].level, requests[3].flags );
+
+    /* stopping, the provider is told with no logger */
+    ret = stop_session( handle );
+    ok( !ret, "got %lu\n", ret );
+    ok( request_count == 5, "got %ld requests\n", request_count );
+    ok( requests[4].code == WMI_DISABLE_EVENTS, "got %u\n", requests[4].code );
+    ok( !requests[4].wnode.HistoricalContext, "got %#I64x\n", requests[4].wnode.HistoricalContext );
+    UnregisterTraceGuids( classic );
+    free( props );
+}
+
+/* a real-time session read by a consumer in the process */
+static TRACEHANDLE rt_consumer;
+static ULONG rt_status;
+
+static DWORD WINAPI process_thread( void *arg )
+{
+    rt_status = ProcessTrace( &rt_consumer, 1, NULL, NULL );
+    return 0;
+}
+
+static void test_real_time(void)
+{
+    EVENT_TRACE_PROPERTIES *props, *query;
+    EVENT_TRACE_LOGFILEW logfile;
+    EVENT_DATA_DESCRIPTOR data;
+    char text[] = "rt event";
+    TRACEHANDLE handle, bad = 0x12345;
+    REGHANDLE reg;
+    WCHAR name[64];
+    HANDLE thread;
+    LONG from, i;
+    ULONG ret;
+
+    session_name( name, "rt" );
+    props = new_props( EVENT_TRACE_REAL_TIME_MODE, NULL, NULL );
+    props->Wnode.ClientContext = 0;
+    ret = StartTraceW( &handle, name, props );
+    if (ret == ERROR_ACCESS_DENIED)
+    {
+        skip( "need admin rights\n" );
+        free( props );
+        return;
+    }
+    ok( !ret, "got %lu\n", ret );
+    if (ret)
+    {
+        free( props );
+        return;
+    }
+    ok( props->LogFileMode == (EVENT_TRACE_REAL_TIME_MODE | EVENT_TRACE_PERSIST_ON_HYBRID_SHUTDOWN), "got %#lx\n",
+        props->LogFileMode );
+    ok( props->Wnode.ClientContext == 1, "got %lu\n", props->Wnode.ClientContext );
+    ok( props->BufferSize == 64, "got %lu\n", props->BufferSize );
+
+    memset( &logfile, 0, sizeof(logfile) );
+    logfile.LoggerName = name;
+    logfile.ProcessTraceMode = PROCESS_TRACE_MODE_REAL_TIME | PROCESS_TRACE_MODE_EVENT_RECORD;
+    logfile.EventRecordCallback = record_callback;
+    logfile.Context = (void *)0x1234;
+    SetLastError( 0xdeadbeef );
+    rt_consumer = OpenTraceW( &logfile );
+    ok( rt_consumer != INVALID_PROCESSTRACE_HANDLE, "got error %lu\n", GetLastError() );
+    ok( !GetLastError(), "got error %lu\n", GetLastError() );
+    ok( logfile.LogFileMode == (PROCESS_TRACE_MODE_REAL_TIME | PROCESS_TRACE_MODE_EVENT_RECORD), "got %#lx\n",
+        logfile.LogFileMode );
+    ok( logfile.LogfileHeader.BufferSize == 65536, "got %lu\n", logfile.LogfileHeader.BufferSize );
+    ok( !logfile.LogfileHeader.StartTime.QuadPart, "got a start time\n" );
+    record_count = 0;
+    thread = CreateThread( NULL, 0, process_thread, NULL, 0, NULL );
+
+    /* another session than a private one tells the providers afterwards, on a thread of its own */
+    EventRegister( &provider_guid, enable_callback, (void *)"rt", &reg );
+    call_count = 0;
+    ret = EnableTraceEx2( handle, &provider_guid, EVENT_CONTROL_CODE_ENABLE_PROVIDER, 4, 0x1, 0, 5000, NULL );
+    ok( !ret, "got %lu\n", ret );
+    ok( call_count == 1, "got %ld calls\n", call_count );
+    check_call( 0, "rt", EVENT_CONTROL_CODE_ENABLE_PROVIDER, 4, 1, 0 );
+    ok( calls[0].thread != GetCurrentThreadId(), "called on this thread\n" );
+    ok( EventProviderEnabled( reg, 4, 1 ), "not enabled\n" );
+
+    EventDataDescCreate( &data, text, sizeof(text) );
+    ret = EventWrite( reg, &(EVENT_DESCRIPTOR){ 1, 2, 3, 4, 5, 6, 0x1 }, 1, &data );
+    ok( !ret, "got %lu\n", ret );
+    ret = EventWrite( reg, &(EVENT_DESCRIPTOR){ 2, 0, 0, 5, 0, 0, 0x1 }, 1, &data );
+    ok( !ret, "got %lu\n", ret );
+    ret = EventWriteString( reg, 4, 1, L"rt string" );
+    ok( !ret, "got %lu\n", ret );
+    query = new_props( 0, NULL, NULL );
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_FLUSH );
+    ok( !ret, "got %lu\n", ret );
+    for (i = 0; i < 50 && record_count < 2; i++) Sleep( 100 );
+    ok( record_count == 2, "got %ld records\n", record_count );
+    if (record_count == 2)
+    {
+        ok( records[0].header.Size == 80 + sizeof(text), "got %u\n", records[0].header.Size );
+        ok( (records[0].header.Flags & ~EVENT_HEADER_FLAG_32_BIT_HEADER & ~EVENT_HEADER_FLAG_64_BIT_HEADER) ==
+            EVENT_HEADER_FLAG_PROCESSOR_INDEX, "got %#x\n", records[0].header.Flags );
+        ok( records[0].header.EventDescriptor.Id == 1, "got %u\n", records[0].header.EventDescriptor.Id );
+        ok( records[0].user_len == sizeof(text), "got %lu\n", records[0].user_len );
+        ok( records[0].user_context == (void *)0x1234, "got %p\n", records[0].user_context );
+        ok( !!records[0].context.LoggerId, "no logger\n" );
+        ok( records[1].header.Flags & EVENT_HEADER_FLAG_STRING_ONLY, "got %#x\n", records[1].header.Flags );
+    }
+
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_QUERY );
+    ok( !ret, "got %lu\n", ret );
+    ok( query->LogFileMode == (EVENT_TRACE_REAL_TIME_MODE | EVENT_TRACE_PERSIST_ON_HYBRID_SHUTDOWN), "got %#lx\n",
+        query->LogFileMode );
+    ok( !!query->LoggerThreadId, "no logger thread\n" );
+    {
+        EVENT_TRACE_PROPERTIES *by_name = new_props( 0, NULL, NULL );
+        ret = ControlTraceW( 0, name, by_name, EVENT_TRACE_CONTROL_QUERY );
+        ok( !ret, "got %lu\n", ret );
+        free( by_name );
+    }
+
+    from = call_count;
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_STOP );
+    ok( !ret, "got %lu\n", ret );
+    ret = WaitForSingleObject( thread, 5000 );
+    ok( !ret, "ProcessTrace did not return\n" );
+    ok( !rt_status, "got %lu\n", rt_status );
+    CloseHandle( thread );
+    for (i = 0; i < 50 && call_count == from; i++) Sleep( 100 );
+    check_call( from, "rt", EVENT_CONTROL_CODE_DISABLE_PROVIDER, 0, 0, 0 );
+    ret = CloseTrace( rt_consumer );
+    ok( !ret, "got %lu\n", ret );
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_STOP );
+    ok( ret == ERROR_WMI_INSTANCE_NOT_FOUND, "got %lu\n", ret );
+    EventUnregister( reg );
+
+    /* a consumer of a session nobody started finds out when it reads */
+    memset( &logfile, 0, sizeof(logfile) );
+    logfile.LoggerName = (WCHAR *)L"WineTestTraceNoSuchSession";
+    logfile.ProcessTraceMode = PROCESS_TRACE_MODE_REAL_TIME | PROCESS_TRACE_MODE_EVENT_RECORD;
+    logfile.EventRecordCallback = record_callback;
+    rt_consumer = OpenTraceW( &logfile );
+    ok( rt_consumer != INVALID_PROCESSTRACE_HANDLE, "got error %lu\n", GetLastError() );
+    ret = ProcessTrace( &rt_consumer, 1, NULL, NULL );
+    ok( ret == ERROR_WMI_INSTANCE_NOT_FOUND, "got %lu\n", ret );
+    ret = CloseTrace( rt_consumer );
+    ok( !ret, "got %lu\n", ret );
+    ret = ProcessTrace( &bad, 1, NULL, NULL );
+    ok( ret == ERROR_INVALID_HANDLE, "got %lu\n", ret );
+    ret = ProcessTrace( &bad, 0, NULL, NULL );
+    ok( ret == ERROR_BAD_LENGTH, "got %lu\n", ret );
+    ret = CloseTrace( bad );
+    ok( ret == ERROR_INVALID_HANDLE, "got %lu\n", ret );
+    free( query );
+    free( props );
+}
+
+static void test_activity_ids(void)
+{
+    GUID guid, old, first, second;
+    ULONG ret;
+
+    memset( &guid, 0, sizeof(guid) );
+    EventActivityIdControl( EVENT_ACTIVITY_CTRL_SET_ID, &guid );
+    memset( &guid, 0xcc, sizeof(guid) );
+    ret = EventActivityIdControl( EVENT_ACTIVITY_CTRL_GET_ID, &guid );
+    ok( !ret, "got %lu\n", ret );
+    ok( IsEqualGUID( &guid, &null_guid ), "got %s\n", debugstr_guid(&guid) );
+
+    /* made ones share a time of the system's, and do not become the thread's */
+    ret = EventActivityIdControl( EVENT_ACTIVITY_CTRL_CREATE_ID, &first );
+    ok( !ret, "got %lu\n", ret );
+    ret = EventActivityIdControl( EVENT_ACTIVITY_CTRL_CREATE_ID, &second );
+    ok( !ret, "got %lu\n", ret );
+    ok( !IsEqualGUID( &first, &second ), "got the same\n" );
+    ok( first.Data1 == second.Data1 && first.Data2 == second.Data2, "got %s %s\n", debugstr_guid(&first),
+        debugstr_guid(&second) );
+    EventActivityIdControl( EVENT_ACTIVITY_CTRL_GET_ID, &guid );
+    ok( IsEqualGUID( &guid, &null_guid ), "got %s\n", debugstr_guid(&guid) );
+
+    guid = activity_guid;
+    ret = EventActivityIdControl( EVENT_ACTIVITY_CTRL_SET_ID, &guid );
+    ok( !ret, "got %lu\n", ret );
+    guid = related_guid;
+    ret = EventActivityIdControl( EVENT_ACTIVITY_CTRL_GET_SET_ID, &guid );
+    ok( !ret, "got %lu\n", ret );
+    ok( IsEqualGUID( &guid, &activity_guid ), "got %s\n", debugstr_guid(&guid) );
+    EventActivityIdControl( EVENT_ACTIVITY_CTRL_GET_ID, &guid );
+    ok( IsEqualGUID( &guid, &related_guid ), "got %s\n", debugstr_guid(&guid) );
+    ret = EventActivityIdControl( EVENT_ACTIVITY_CTRL_CREATE_SET_ID, &old );
+    ok( !ret, "got %lu\n", ret );
+    ok( IsEqualGUID( &old, &related_guid ), "got %s\n", debugstr_guid(&old) );
+    EventActivityIdControl( EVENT_ACTIVITY_CTRL_GET_ID, &guid );
+    ok( guid.Data1 == first.Data1 && guid.Data2 == first.Data2, "got %s\n", debugstr_guid(&guid) );
+
+    ret = EventActivityIdControl( 0, &guid );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    ret = EventActivityIdControl( 6, &guid );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    ret = EventActivityIdControl( EVENT_ACTIVITY_CTRL_GET_ID, NULL );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    memset( &guid, 0, sizeof(guid) );
+    EventActivityIdControl( EVENT_ACTIVITY_CTRL_SET_ID, &guid );
+}
+
+START_TEST(trace)
+{
+    test_private_start();
+    test_private_enable();
+    test_control();
+    test_log_file();
+    test_classic();
+    test_real_time();
+    test_activity_ids();
+}
