+/* reading back what a log file holds */
+static struct
+{
+    EVENT_HEADER header;
+    ETW_BUFFER_CONTEXT context;
+    USHORT ext_count, ext_type;
+    ULONG user_len;
+    BYTE user[32];
+    void *user_context;
+} records[16];
+static LONG record_count, buffer_count;
+
+static void WINAPI record_callback( EVENT_RECORD *record )
+{
+    LONG i = record_count++;
+
+    if (i >= ARRAY_SIZE(records)) return;
+    records[i].header = record->EventHeader;
+    records[i].context = record->BufferContext;
+    records[i].ext_count = record->ExtendedDataCount;
+    records[i].ext_type = record->ExtendedDataCount ? record->ExtendedData[0].ExtType : 0;
+    records[i].user_len = record->UserDataLength;
+    memcpy( records[i].user, record->UserData, min( record->UserDataLength, sizeof(records[i].user) ) );
+    records[i].user_context = record->UserContext;
+}
+
+static struct
+{
+    EVENT_TRACE_HEADER header;
+    ULONG mof_len;
+} traces[16];
+static LONG trace_count;
+
+static void WINAPI trace_callback( EVENT_TRACE *event )
+{
+    LONG i = trace_count++;
+
+    if (i >= ARRAY_SIZE(traces)) return;
+    traces[i].header = event->Header;
+    traces[i].mof_len = event->MofLength;
+}
+
+static ULONG WINAPI buffer_callback( EVENT_TRACE_LOGFILEW *logfile )
+{
+    InterlockedIncrement( &buffer_count );
+    return TRUE;
+}
