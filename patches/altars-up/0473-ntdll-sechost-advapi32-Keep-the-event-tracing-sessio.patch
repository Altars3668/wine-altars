+     * both, as a query of it leaves them */
+    ret = ControlTraceW( 0, name, query, EVENT_TRACE_CONTROL_QUERY );
+    ok( ret == ERROR_WMI_INSTANCE_NOT_FOUND, "got %lu\n", ret );
+    ret = ControlTraceW( 0, NULL, query, EVENT_TRACE_CONTROL_QUERY );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    query->Wnode.Guid = control_guid;
+    ret = ControlTraceW( 0, name, query, EVENT_TRACE_CONTROL_QUERY );
+    ok( ret == ERROR_WMI_INSTANCE_NOT_FOUND, "got %lu\n", ret );
+    memset( &query->Wnode.Guid, 0, sizeof(query->Wnode.Guid) );
+    query->Wnode.HistoricalContext = handle;
+    ret = ControlTraceW( 0, name, query, EVENT_TRACE_CONTROL_QUERY );
+    ok( ret == ERROR_WMI_INSTANCE_NOT_FOUND, "got %lu\n", ret );
+    ret = ControlTraceW( 0, NULL, query, EVENT_TRACE_CONTROL_QUERY );
+    ok( ret == ERROR_INVALID_PARAMETER, "got %lu\n", ret );
+    query->Wnode.HistoricalContext = handle + 1;
+    ret = ControlTraceW( handle, NULL, query, EVENT_TRACE_CONTROL_QUERY );
+    ok( !ret, "got %lu\n", ret );
+    ok( query->Wnode.HistoricalContext == handle, "got %#I64x\n", query->Wnode.HistoricalContext );
+    ok( IsEqualGUID( &query->Wnode.Guid, &control_guid ), "got %s\n", debugstr_guid(&query->Wnode.Guid) );
+    ret = ControlTraceW( 0, name, query, EVENT_TRACE_CONTROL_QUERY );
