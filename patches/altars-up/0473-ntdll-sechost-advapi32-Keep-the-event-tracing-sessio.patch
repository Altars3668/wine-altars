+
+WINE_DEFAULT_DEBUG_CHANNEL(ntdll);
+WINE_DECLARE_DEBUG_CHANNEL(tracelog);
+WINE_DECLARE_DEBUG_CHANNEL(eventlog);
+
+/*
+ * A provider registers with EventRegister() or RegisterTraceGuids(), and a session of the process enables it with
+ * EnableTraceEx2(); the provider is told, by its callback, and what it writes then goes into each session that takes
+ * it -- into a log file, buffers kept in memory, or to consumers in the process reading it in real time.  The
+ * sessions are the process's own, as a private in-process logger is on Windows (Office starts one for its own
+ * logging); one of the system's, or a consumer in another process, is not here.
+ */
+
+static inline DWORD current_tid(void)
+{
+    return HandleToULong( NtCurrentTeb()->ClientId.UniqueThread );
+}
+
+static inline DWORD current_pid(void)
+{
+    return HandleToULong( NtCurrentTeb()->ClientId.UniqueProcess );
+}
+
+static RTL_SRWLOCK etw_lock = RTL_SRWLOCK_INIT;
+static RTL_CONDITION_VARIABLE etw_cv = RTL_CONDITION_VARIABLE_INIT;
+
+/******************************************************************************
+ * Registrations
+ */
+
+/* what a session enables of a provider, as the provider's registration was told of it */
+struct etw_reg_enable
+{
+    struct list entry;
+    USHORT      logger_id;
+    UCHAR       level;      /* 255 for any */
+    ULONGLONG   any;        /* ~0 for any */
+    ULONGLONG   all;
+};
+
+struct etw_registration
+{
+    struct list     entry;
+    ULONG64         handle;
+    GUID            guid;
+    BOOL            classic;
+    BYTE           *traits;         /* set once, by EventSetInformation() */
+    PENABLECALLBACK callback;
+    WMIDPREQUEST    request;        /* a classic provider's */
+    void           *context;
+    LONG            refs;           /* the list's, and those of the notifications on their way to it */
+    BOOL            gone;           /* unregistered */
+    LONG            calling;        /* its callback is running */
+    DWORD           calling_thread;
+    struct list     enables;
+};
+
+static struct list etw_registrations = LIST_INIT( etw_registrations );
+static ULONG64 etw_next_handle = 0x10000;
+
+static struct etw_registration *add_registration( const GUID *guid, BOOL classic, PENABLECALLBACK callback,
+                                                  WMIDPREQUEST request, void *context )
+{
+    struct etw_registration *reg;
+
+    if (!(reg = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*reg) ))) return NULL;
+    reg->guid = *guid;
+    reg->classic = classic;
+    reg->callback = callback;
+    reg->request = request;
+    reg->context = context;
+    reg->refs = 1;
+    list_init( &reg->enables );
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    reg->handle = etw_next_handle += 0x10;
+    /* the newest first: their callbacks are called in that order */
+    list_add_head( &etw_registrations, &reg->entry );
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    return reg;
+}
+
+/* the lock is held */
+static struct etw_registration *find_registration( ULONG64 handle, BOOL classic )
+{
+    struct etw_registration *reg;
+
+    LIST_FOR_EACH_ENTRY( reg, &etw_registrations, struct etw_registration, entry )
+        if (reg->handle == handle && reg->classic == classic) return reg;
+    return NULL;
+}
+
+/* the lock is held exclusively */
+static void release_registration( struct etw_registration *reg )
+{
+    struct etw_reg_enable *enable, *next;
+
+    if (--reg->refs) return;
+    LIST_FOR_EACH_ENTRY_SAFE( enable, next, &reg->enables, struct etw_reg_enable, entry )
+        RtlFreeHeap( GetProcessHeap(), 0, enable );
+    RtlFreeHeap( GetProcessHeap(), 0, reg->traits );
+    RtlFreeHeap( GetProcessHeap(), 0, reg );
+}
+
+static ULONG remove_registration( ULONG64 handle, BOOL classic )
+{
+    struct etw_registration *reg;
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if (!(reg = find_registration( handle, classic )))
+    {
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        return ERROR_INVALID_HANDLE;
+    }
+    list_remove( &reg->entry );
+    reg->gone = TRUE;
+    /* its callback running on another thread is waited for; it is not called again */
+    while (reg->calling && reg->calling_thread != current_tid())
+        RtlSleepConditionVariableSRW( &etw_cv, &etw_lock, NULL, 0 );
+    release_registration( reg );
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    return ERROR_SUCCESS;
+}
+
+/* whether an enabling takes an event: level 0 and keywords 0 are taken by any, and the keywords have to have any of
+ * one mask and all of the other */
+static BOOL enable_takes( UCHAR enabled_level, ULONGLONG any, ULONGLONG all, UCHAR level, ULONGLONG keyword )
+{
+    if (level > enabled_level) return FALSE;
+    if (!keyword) return TRUE;
+    return (keyword & any) && (keyword & all) == all;
+}
+
+/* the lock is held */
+static BOOL registration_takes( const struct etw_registration *reg, UCHAR level, ULONGLONG keyword )
+{
+    const struct etw_reg_enable *enable;
+
+    LIST_FOR_EACH_ENTRY( enable, &reg->enables, const struct etw_reg_enable, entry )
+        if (enable_takes( enable->level, enable->any, enable->all, level, keyword )) return TRUE;
+    return FALSE;
+}
+
+/* a provider's traits: their size, the provider's name, and traits of a size, a type and data each; only the layout
+ * is checked, and they are set once */
+static BOOL check_provider_traits( const BYTE *traits, ULONG length )
+{
+    ULONG pos, size;
+
+    if (*(const USHORT *)traits != length) return FALSE;
+    for (pos = 2; pos < length && traits[pos]; pos++);
+    if (pos++ == length) return FALSE;
+    while (pos < length)
+    {
+        if (length - pos < 2) return FALSE;
+        size = *(const USHORT *)(traits + pos);
+        if (size < 3 || size > length - pos) return FALSE;
+        pos += size;
+    }
+    return TRUE;
+}
+
+static ULONG set_provider_traits( ULONG64 handle, const BYTE *traits, ULONG length )
+{
+    struct etw_registration *reg;
+    ULONG ret = ERROR_INVALID_HANDLE;
+    BYTE *copy;
+
+    if (!traits || length < 3) return ERROR_INVALID_PARAMETER;
+    if (!(copy = RtlAllocateHeap( GetProcessHeap(), 0, length ))) return ERROR_NOT_ENOUGH_MEMORY;
+    memcpy( copy, traits, length );
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if ((reg = find_registration( handle, FALSE )))
+    {
+        if (reg->traits) ret = ERROR_GEN_FAILURE;
+        else if (!check_provider_traits( copy, length )) ret = ERROR_FILE_CORRUPT;
+        else
+        {
+            reg->traits = copy;
+            copy = NULL;
+            ret = ERROR_SUCCESS;
+        }
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    RtlFreeHeap( GetProcessHeap(), 0, copy );
+    return ret;
+}
+
+/******************************************************************************
+ * Sessions
+ */
+
+static const GUID system_trace_control_guid =
+    { 0x9e814aad, 0x3204, 0x11d2, { 0x9a, 0x82, 0x00, 0x60, 0x08, 0xa8, 0x69, 0x39 } };
+
+#define ETW_BUFFER_HEADER_SIZE  0x48
+#define ETW_HEADER_SYSTEM       0x02    /* TRACE_HEADER_TYPE_SYSTEM64: the header buffer's records */
+#define ETW_SYSTEM_HEADER_SIZE  0x20
+#define ETW_CLASSIC_HEADER_SIZE 0x30
+#define ETW_MAX_LOGGERS         64
+#define ETW_PRIVATE_HANDLE      0x1000000
+
+/* what a session enables of a provider */
+struct etw_enable
+{
+    struct list entry;
+    GUID        provider;
+    UCHAR       level;
+    ULONGLONG   any;
+    ULONGLONG   all;
+};
+
+/* an event on its way to real-time consumers: its record, as a buffer holds it */
+struct etw_event
+{
+    struct list   entry;
+    LARGE_INTEGER system_time;
+    UCHAR         processor;
+    USHORT        logger_id;
+    ULONG         size;
+    BYTE          record[1];
+};
+
+/* the events of one buffer, for one consumer */
+struct etw_batch
+{
+    struct list entry;
+    struct list events;
+};
+
+struct etw_session
+{
+    struct list   entry;
+    USHORT        logger_id;
+    TRACEHANDLE   handle;
+    WCHAR        *name;
+    WCHAR        *file_name;
+    HANDLE        file;
+    HANDLE        timer;
+    GUID          guid;
+    ULONG         mode;
+    ULONG         clock;
+    ULONG         buffer_size;       /* in KiB */
+    ULONG         min_buffers;
+    ULONG         max_buffers;
+    ULONG         max_file_size;
+    ULONG         flush_timer;
+    ULONG         enable_flags;
+    LONG          age_limit;
+    ULONG         buffers_written;
+    ULONG         events_lost;
+    ULONG         log_buffers_lost;
+    ULONG         realtime_lost;
+    DWORD         thread;            /* the one that started it */
+    LARGE_INTEGER start_time;
+    LONGLONG      start_counter;     /* by its clock */
+    BYTE         *buffer;            /* the one events go into, for a log file or kept in memory */
+    ULONG         buffer_pos;        /* how much of it they take, also when there is none */
+    LONGLONG      next_buffer;       /* where in the log file the next one goes */
+    ULONG64       sequence;
+    ULONG         message_sequence;
+    struct list   enables;
+    struct list   pending;           /* the events of a real-time session not flushed yet */
+    struct list   consumers;
+};
+
+struct etw_consumer
+{
+    struct list           entry;
+    struct list           session_entry;
+    TRACEHANDLE           handle;
+    WCHAR                *name;
+    EVENT_TRACE_LOGFILEW *logfile;
+    ULONG                 mode;      /* how it reads, PROCESS_TRACE_MODE_* */
+    struct etw_session   *session;   /* the real-time one it reads, while it runs */
+    struct list           batches;
+    HANDLE                file;      /* or the log file it reads */
+    BYTE                 *header;    /* the log file's header buffer */
+    LONGLONG              file_start;  /* when the session started, by its clock */
+    BOOL                  ended;     /* its session stopped */
+    BOOL                  busy;      /* ProcessTrace() reads it */
+    BOOL                  closed;
+};
+
+static struct list etw_sessions = LIST_INIT( etw_sessions );
+static struct list etw_consumers = LIST_INIT( etw_consumers );
+static ULONG64 etw_logger_ids;
+static USHORT etw_last_logger_id;
+static TRACEHANDLE etw_next_consumer = 0x100000;
+
+static BOOL is_private( const struct etw_session *session )
+{
+    return !!(session->mode & EVENT_TRACE_PRIVATE_LOGGER_MODE);
+}
+
+/* the logger IDs go round, so that one is not taken again while what was told of the last is on its way */
+static USHORT alloc_logger_id(void)
+{
+    USHORT i, id;
+
+    for (i = 1; i <= ETW_MAX_LOGGERS; i++)
+    {
+        id = (etw_last_logger_id + i - 1) % ETW_MAX_LOGGERS + 1;
+        if (etw_logger_ids & ((ULONG64)1 << (id - 1))) continue;
+        etw_logger_ids |= (ULONG64)1 << (id - 1);
+        return etw_last_logger_id = id;
+    }
+    return 0;
+}
+
+/* the lock is held */
+static struct etw_session *find_session( TRACEHANDLE handle, const WCHAR *name )
+{
+    struct etw_session *session;
+
+    LIST_FOR_EACH_ENTRY( session, &etw_sessions, struct etw_session, entry )
+    {
+        if (handle && session->handle == handle) return session;
+        if (!handle && name && !wcsicmp( session->name, name )) return session;
+    }
+    return NULL;
+}
+
+/* the lock is held */
+static struct etw_session *find_logger( USHORT logger_id )
+{
+    struct etw_session *session;
+
+    LIST_FOR_EACH_ENTRY( session, &etw_sessions, struct etw_session, entry )
+        if (session->logger_id == logger_id) return session;
+    return NULL;
+}
+
+static ULONG64 cycle_count(void)
+{
+#if defined(__i386__) || defined(__x86_64__)
+    return __builtin_ia32_rdtsc();
+#else
+    LARGE_INTEGER counter;
+
+    NtQueryPerformanceCounter( &counter, NULL );
+    return counter.QuadPart;
+#endif
+}
+
+/* a time stamp by the session's clock */
+static LONGLONG session_time( const struct etw_session *session, LARGE_INTEGER now )
+{
+    LARGE_INTEGER counter;
+
+    switch (session->clock)
+    {
+    case 2:
+        return now.QuadPart;
+    case 3:
+        return cycle_count();
+    default:
+        NtQueryPerformanceCounter( &counter, NULL );
+        return counter.QuadPart;
+    }
+}
+
+/* the thread's kernel and user time, in clock ticks */
+static ULONG64 thread_ticks(void)
+{
+    KERNEL_USER_TIMES times;
+
+    if (NtQueryInformationThread( NtCurrentThread(), ThreadTimes, &times, sizeof(times), NULL )) return 0;
+    return (ULONG)(times.KernelTime.QuadPart / 156250) | (ULONG64)(ULONG)(times.UserTime.QuadPart / 156250) << 32;
+}
+
+/* What goes with an event for the time its thread took: a private session counts processor cycles, another the
+ * thread's ticks. */
+static ULONG64 session_cpu_time( const struct etw_session *session )
+{
+    return is_private( session ) ? cycle_count() : thread_ticks();
+}
+
+static LONGLONG max_file_bytes( const struct etw_session *session )
+{
+    if (!session->max_file_size) return 0;
+    if (session->mode & EVENT_TRACE_USE_KBYTES_FOR_SIZE) return (LONGLONG)session->max_file_size << 10;
+    return (LONGLONG)session->max_file_size << 20;
+}
+
+static void write_file( HANDLE file, LONGLONG offset, const void *data, ULONG size )
+{
+    IO_STATUS_BLOCK io;
+    LARGE_INTEGER pos;
+
+    pos.QuadPart = offset;
+    NtWriteFile( file, NULL, NULL, NULL, &io, data, size, &pos, NULL );
+}
+
+static ULONG cpu_speed( ULONG processors )
+{
+    PROCESSOR_POWER_INFORMATION *info;
+    ULONG ret = 0;
+
+    if (!processors || !(info = RtlAllocateHeap( GetProcessHeap(), 0, processors * sizeof(*info) ))) return 0;
+    if (!NtPowerInformation( ProcessorInformation, NULL, 0, info, processors * sizeof(*info) )) ret = info->MaxMhz;
+    RtlFreeHeap( GetProcessHeap(), 0, info );
+    return ret;
+}
+
+/* TRACE_LOGFILE_HEADER as a log file holds it: laid out as a 64-bit process has it, whatever this one is */
+struct logfile_header
+{
+    ULONG                 BufferSize;
+    ULONG                 Version;
+    ULONG                 ProviderVersion;
+    ULONG                 NumberOfProcessors;
+    LARGE_INTEGER         EndTime;
+    ULONG                 TimerResolution;
+    ULONG                 MaximumFileSize;
+    ULONG                 LogFileMode;
+    ULONG                 BuffersWritten;
+    ULONG                 StartBuffers;
+    ULONG                 PointerSize;
+    ULONG                 EventsLost;
+    ULONG                 CpuSpeedInMHz;
+    ULONG64               LoggerName;
+    ULONG64               LogFileName;
+    TIME_ZONE_INFORMATION TimeZone;
+    LARGE_INTEGER         BootTime;
+    LARGE_INTEGER         PerfFreq;
+    LARGE_INTEGER         StartTime;
+    ULONG                 ReservedFlags;    /* the clock */
+    ULONG                 BuffersLost;
+};
+C_ASSERT( sizeof(struct logfile_header) == 0x118 );
+
+/* what a log file's header says of the session, and a real-time consumer is told */
+static void fill_logfile_header( const struct etw_session *session, struct logfile_header *log, BOOL final )
+{
+    SYSTEM_BASIC_INFORMATION sbi;
+    SYSTEM_TIMEOFDAY_INFORMATION tod;
+    LARGE_INTEGER counter, freq;
+
+    memset( log, 0, sizeof(*log) );
+    NtQuerySystemInformation( SystemBasicInformation, &sbi, sizeof(sbi), NULL );
+    NtQuerySystemInformation( SystemTimeOfDayInformation, &tod, sizeof(tod), NULL );
+    NtQueryPerformanceCounter( &counter, &freq );
+    log->BufferSize = session->buffer_size * 1024;
+    log->Version = 0x0501000a;   /* 10.0.1.5 */
+    log->ProviderVersion = NtCurrentTeb()->Peb->OSBuildNumber;
+    log->NumberOfProcessors = sbi.NumberOfProcessors;
+    if (final) NtQuerySystemTime( &log->EndTime );
+    log->TimerResolution = 156250;
+    log->MaximumFileSize = session->max_file_size;
+    log->LogFileMode = session->mode;
+    log->BuffersWritten = session->file ? session->buffers_written : 0;
+    log->StartBuffers = 1;
+    log->PointerSize = sizeof(void *);
+    log->EventsLost = session->events_lost;
+    log->CpuSpeedInMHz = cpu_speed( sbi.NumberOfProcessors );
+    RtlQueryTimeZoneInformation( (RTL_TIME_ZONE_INFORMATION *)&log->TimeZone );
+    log->BootTime = tod.BootTime;
+    log->PerfFreq = freq;
+    if (session->file) log->StartTime = session->start_time;
+    log->ReservedFlags = session->clock;
+    log->BuffersLost = session->log_buffers_lost;
+}
+
+static void to_native_header( const struct logfile_header *src, TRACE_LOGFILE_HEADER *dst )
+{
+    memset( dst, 0, sizeof(*dst) );
+    dst->BufferSize = src->BufferSize;
+    dst->Version = src->Version;
+    dst->ProviderVersion = src->ProviderVersion;
+    dst->NumberOfProcessors = src->NumberOfProcessors;
+    dst->EndTime = src->EndTime;
+    dst->TimerResolution = src->TimerResolution;
+    dst->MaximumFileSize = src->MaximumFileSize;
+    dst->LogFileMode = src->LogFileMode;
+    dst->BuffersWritten = src->BuffersWritten;
+    dst->StartBuffers = src->StartBuffers;
+    dst->PointerSize = src->PointerSize;
+    dst->EventsLost = src->EventsLost;
+    dst->CpuSpeedInMHZ = src->CpuSpeedInMHz;
+    dst->TimeZone = src->TimeZone;
+    dst->BootTime = src->BootTime;
+    dst->PerfFreq = src->PerfFreq;
+    dst->StartTime = src->StartTime;
+    dst->ReservedTime = src->ReservedFlags;
+    dst->BuffersLost = src->BuffersLost;
+}
+
+/* A log file begins with a buffer of its own: the session's record -- a system header, the log file header and the
+ * two names -- and one that closes it; the buffers of events follow, each with a header and the rest of it 0xff. */
+static void write_header_buffer( struct etw_session *session, BOOL final )
+{
+    ULONG size = session->buffer_size * 1024, name_len, file_len, pos, record;
+    struct logfile_header *log;
+    ULONG64 ticks = thread_ticks();
+    BYTE *buf;
+
+    if (!(buf = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return;
+    memset( buf, 0xff, size );
+    memset( buf, 0, ETW_BUFFER_HEADER_SIZE );
+    name_len = (wcslen( session->name ) + 1) * sizeof(WCHAR);
+    file_len = (wcslen( session->file_name ) + 1) * sizeof(WCHAR);
+
+    pos = ETW_BUFFER_HEADER_SIZE;
+    record = ETW_SYSTEM_HEADER_SIZE + sizeof(*log) + name_len + file_len;
+    memset( buf + pos, 0, (record + 7) & ~7 );
+    *(ULONG *)(buf + pos) = 0xc0000000 | ETW_HEADER_SYSTEM << 16;
+    *(USHORT *)(buf + pos + 4) = record;
+    *(ULONG *)(buf + pos + 8) = session->thread;
+    *(ULONG *)(buf + pos + 12) = current_pid();
+    *(LONGLONG *)(buf + pos + 16) = session->start_counter;
+    *(ULONG64 *)(buf + pos + 24) = ticks;
+    log = (struct logfile_header *)(buf + pos + ETW_SYSTEM_HEADER_SIZE);
+    fill_logfile_header( session, log, final );
+    memcpy( log + 1, session->name, name_len );
+    memcpy( (BYTE *)(log + 1) + name_len, session->file_name, file_len );
+    pos += (record + 7) & ~7;
+
+    memset( buf + pos, 0, 0x50 );
+    *(ULONG *)(buf + pos) = 0xc0000002 | ETW_HEADER_SYSTEM << 16;
+    *(USHORT *)(buf + pos + 4) = 0x50;
+    *(USHORT *)(buf + pos + 6) = 0x50;
+    *(ULONG *)(buf + pos + 8) = session->thread;
+    *(ULONG *)(buf + pos + 12) = current_pid();
+    *(LONGLONG *)(buf + pos + 16) = session->start_counter;
+    *(ULONG64 *)(buf + pos + 24) = ticks;
+    pos += 0x50;
+
+    *(ULONG *)(buf + 0x00) = size;
+    *(ULONG *)(buf + 0x04) = pos;
+    *(ULONG *)(buf + 0x30) = pos;
+    *(USHORT *)(buf + 0x34) = 1;    /* the buffer's flag */
+    *(USHORT *)(buf + 0x36) = 4;    /* a header */
+    write_file( session->file, 0, buf, size );
+    RtlFreeHeap( GetProcessHeap(), 0, buf );
+}
+
+/* the buffer events went into, to the log file; a circular one starts again after its header, a sequential one
+ * that has its size loses the buffer */
+static void write_buffer( struct etw_session *session )
+{
+    ULONG size = session->buffer_size * 1024;
+    LONGLONG max = max_file_bytes( session );
+    BYTE *buf = session->buffer;
+    LARGE_INTEGER now;
+
+    if (max && session->next_buffer + size > max)
+    {
+        if (!(session->mode & EVENT_TRACE_FILE_MODE_CIRCULAR))
+        {
+            session->log_buffers_lost++;
+            return;
+        }
+        session->next_buffer = size;
+    }
+    NtQuerySystemTime( &now );
+    memset( buf, 0, ETW_BUFFER_HEADER_SIZE );
+    memset( buf + session->buffer_pos, 0xff, size - session->buffer_pos );
+    *(ULONG *)(buf + 0x00) = size;
+    *(ULONG *)(buf + 0x04) = session->buffer_pos;
+    *(ULONG *)(buf + 0x08) = session->next_buffer + session->buffer_pos;
+    *(LONGLONG *)(buf + 0x10) = session_time( session, now );
+    *(ULONG64 *)(buf + 0x18) = ++session->sequence;
+    *(UCHAR *)(buf + 0x28) = NtGetCurrentProcessorNumber();
+    *(ULONG *)(buf + 0x2c) = 3;     /* written */
+    *(ULONG *)(buf + 0x30) = session->buffer_pos;
+    *(USHORT *)(buf + 0x34) = 0x21;
+    write_file( session->file, session->next_buffer, buf, size );
+    session->next_buffer += size;
+    session->buffers_written++;
+}
+
+static void free_events( struct list *events )
+{
+    struct etw_event *event, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( event, next, events, struct etw_event, entry )
+    {
+        list_remove( &event->entry );
+        RtlFreeHeap( GetProcessHeap(), 0, event );
+    }
+}
+
+/* the events of a real-time session's buffer, to its consumers: each gets them as a batch of its own */
+static void deliver_pending( struct etw_session *session )
+{
+    struct etw_consumer *consumer, *last = NULL;
+    struct etw_event *event, *copy;
+    struct etw_batch *batch;
+
+    if (list_empty( &session->pending )) return;
+    if (list_empty( &session->consumers )) session->realtime_lost++;
+    else last = LIST_ENTRY( list_tail( &session->consumers ), struct etw_consumer, session_entry );
+
+    LIST_FOR_EACH_ENTRY( consumer, &session->consumers, struct etw_consumer, session_entry )
+    {
+        if (!(batch = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*batch) ))) continue;
+        list_init( &batch->events );
+        if (consumer == last) list_move_tail( &batch->events, &session->pending );
+        else
+        {
+            LIST_FOR_EACH_ENTRY( event, &session->pending, struct etw_event, entry )
+            {
+                SIZE_T size = offsetof( struct etw_event, record[event->size] );
+
+                if (!(copy = RtlAllocateHeap( GetProcessHeap(), 0, size ))) continue;
+                memcpy( copy, event, size );
+                list_add_tail( &batch->events, &copy->entry );
+            }
+        }
+        list_add_tail( &consumer->batches, &batch->entry );
+    }
+    free_events( &session->pending );
+    RtlWakeAllConditionVariable( &etw_cv );
+}
+
+static void flush_session( struct etw_session *session )
+{
+    if (session->buffer_pos == ETW_BUFFER_HEADER_SIZE) return;
+    if (session->file) write_buffer( session );
+    else if (session->mode & EVENT_TRACE_REAL_TIME_MODE) session->buffers_written++;
+    if (session->mode & EVENT_TRACE_REAL_TIME_MODE) deliver_pending( session );
+    session->buffer_pos = ETW_BUFFER_HEADER_SIZE;
+}
+
+static void WINAPI flush_timer_proc( void *arg, BOOLEAN fired )
+{
+    struct etw_session *session;
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if ((session = find_logger( PtrToUlong( arg ) ))) flush_session( session );
+    RtlReleaseSRWLockExclusive( &etw_lock );
+}
+
+/* A record into a session: into its buffer, the buffer being written when it is full, and on its way to the
+ * session's real-time consumers.  One too big for a buffer is lost. */
+static ULONG session_add( struct etw_session *session, const BYTE *record, ULONG size, LARGE_INTEGER now )
+{
+    ULONG buffer_size = session->buffer_size * 1024, aligned = (size + 7) & ~7;
+    struct etw_event *event;
+
+    if (size > buffer_size - ETW_BUFFER_HEADER_SIZE)
+    {
+        session->events_lost++;
+        return ERROR_MORE_DATA;
+    }
+    if (session->buffer_pos + aligned > buffer_size) flush_session( session );
+    if (session->buffer)
+    {
+        memcpy( session->buffer + session->buffer_pos, record, size );
+        memset( session->buffer + session->buffer_pos + size, 0, aligned - size );
+    }
+    session->buffer_pos += aligned;
+
+    if (session->mode & EVENT_TRACE_REAL_TIME_MODE)
+    {
+        if (!(event = RtlAllocateHeap( GetProcessHeap(), 0, offsetof( struct etw_event, record[size] ) )))
+        {
+            session->events_lost++;
+            return ERROR_NOT_ENOUGH_MEMORY;
+        }
+        event->system_time = now;
+        event->processor = NtGetCurrentProcessorNumber();
+        event->logger_id = session->logger_id;
+        event->size = size;
+        memcpy( event->record, record, size );
+        list_add_tail( &session->pending, &event->entry );
+    }
+    return ERROR_SUCCESS;
+}
+
+/* the time stamps of a record, by a session's clock */
+static void stamp_record( const struct etw_session *session, BYTE *record, ULONG time_offset, ULONG cpu_offset,
+                          LARGE_INTEGER now )
+{
+    *(LONGLONG *)(record + time_offset) = session_time( session, now );
+    if (cpu_offset) *(ULONG64 *)(record + cpu_offset) = session_cpu_time( session );
+}
+
+/******************************************************************************
+ * Records
+ *
+ * An event of a manifest or TraceLogging provider is an EVENT_HEADER, its extended items, then its payload; an item
+ * is its size, type, whether another follows and the size of its data, then the data, rounded up to 8 bytes.  A
+ * classic provider's TraceEvent() is its EVENT_TRACE_HEADER and data, its TraceMessage() a message header and the
+ * fields it asked for.
+ */
+
+/* the record's type, and the pointer size of the process that wrote it */
+#ifdef _WIN64
+#define ETW_HEADER_EVENT   0x13    /* TRACE_HEADER_TYPE_EVENT_HEADER64 */
+#define ETW_HEADER_CLASSIC 0x14    /* TRACE_HEADER_TYPE_FULL_HEADER64 */
+#else
+#define ETW_HEADER_EVENT   0x12    /* TRACE_HEADER_TYPE_EVENT_HEADER32 */
+#define ETW_HEADER_CLASSIC 0x0a    /* TRACE_HEADER_TYPE_FULL_HEADER32 */
+#endif
+#define ETW_HEADER_FLAGS   0xc0
+#define ETW_HEADER_MESSAGE 0x90
+
+static ULONG ext_item_size( ULONG data_size )
+{
+    return (8 + data_size + 7) & ~7;
+}
+
+static BYTE *add_ext_item( BYTE *pos, USHORT type, const void *data, USHORT data_size, BOOL more )
+{
+    ULONG size = ext_item_size( data_size );
+
+    memset( pos, 0, size );
+    *(USHORT *)pos = size;
+    *(USHORT *)(pos + 2) = type;
+    *(USHORT *)(pos + 4) = more;
+    *(USHORT *)(pos + 6) = data_size;
+    memcpy( pos + 8, data, data_size );
+    return pos + size;
+}
+
+static BYTE *build_event( const GUID *provider, const EVENT_DESCRIPTOR *descriptor, const GUID *activity,
+                          const GUID *related, const BYTE *traits, USHORT flags, ULONG count,
+                          const EVENT_DATA_DESCRIPTOR *data, const WCHAR *string, ULONG *ret_size, ULONG *error )
+{
+    const BYTE *event_meta = NULL, *provider_meta = traits;
+    ULONG event_meta_size = 0, provider_meta_size = traits ? *(const USHORT *)traits : 0;
+    ULONG payload = 0, ext = 0, size, i, items = 0;
+    EVENT_HEADER *header;
+    BYTE *record, *pos;
+
+    if (string) payload = (wcslen( string ) + 1) * sizeof(WCHAR);
+    for (i = 0; i < count; i++)
+    {
+        switch (data[i].Type)
+        {
+        case EVENT_DATA_DESCRIPTOR_TYPE_NONE:
+            payload += data[i].Size;
+            break;
+        case EVENT_DATA_DESCRIPTOR_TYPE_EVENT_METADATA:
+            event_meta = (const BYTE *)(ULONG_PTR)data[i].Ptr;
+            event_meta_size = data[i].Size;
+            break;
+        case EVENT_DATA_DESCRIPTOR_TYPE_PROVIDER_METADATA:
+            provider_meta = (const BYTE *)(ULONG_PTR)data[i].Ptr;
+            provider_meta_size = data[i].Size;
+            break;
+        }
+    }
+    if (related) ext += ext_item_size( sizeof(GUID) ), items++;
+    if (provider_meta && provider_meta_size) ext += ext_item_size( provider_meta_size ), items++;
+    if (event_meta && event_meta_size) ext += ext_item_size( event_meta_size ), items++;
+
+    size = sizeof(*header) + ext + payload;
+    if (size > 0xffff)
+    {
+        *error = ERROR_MORE_DATA;
+        return NULL;
+    }
+    if (!(record = RtlAllocateHeap( GetProcessHeap(), 0, size )))
+    {
+        *error = ERROR_NOT_ENOUGH_MEMORY;
+        return NULL;
+    }
+
+    header = (EVENT_HEADER *)record;
+    memset( header, 0, sizeof(*header) );
+    header->Size = size;
+    header->HeaderType = ETW_HEADER_FLAGS << 8 | ETW_HEADER_EVENT;
+    header->Flags = flags | (items ? EVENT_HEADER_FLAG_EXTENDED_INFO : 0);
+    header->ThreadId = current_tid();
+    header->ProcessId = current_pid();
+    header->ProviderId = *provider;
+    header->EventDescriptor = *descriptor;
+    header->ActivityId = activity ? *activity : NtCurrentTeb()->ActivityId;
+
+    pos = record + sizeof(*header);
+    if (related) pos = add_ext_item( pos, EVENT_HEADER_EXT_TYPE_RELATED_ACTIVITYID, related, sizeof(GUID), --items );
+    if (provider_meta && provider_meta_size)
+        pos = add_ext_item( pos, EVENT_HEADER_EXT_TYPE_PROV_TRAITS, provider_meta, provider_meta_size, --items );
+    if (event_meta && event_meta_size)
+        pos = add_ext_item( pos, EVENT_HEADER_EXT_TYPE_EVENT_SCHEMA_TL, event_meta, event_meta_size, --items );
+
+    if (string)
+    {
+        memcpy( pos, string, payload );
+        pos += payload;
+    }
+    for (i = 0; i < count; i++)
+    {
+        if (data[i].Type != EVENT_DATA_DESCRIPTOR_TYPE_NONE || !data[i].Size) continue;
+        memcpy( pos, (const void *)(ULONG_PTR)data[i].Ptr, data[i].Size );
+        pos += data[i].Size;
+    }
+    *ret_size = size;
+    return record;
+}
+
+/* What a provider writes, to every session that takes it, as far as the provider was told. */
+static ULONG write_event( REGHANDLE handle, const EVENT_DESCRIPTOR *descriptor, const GUID *activity,
+                          const GUID *related, ULONG count, const EVENT_DATA_DESCRIPTOR *data, const WCHAR *string,
+                          USHORT flags )
+{
+    struct etw_registration *reg;
+    struct etw_reg_enable *enable;
+    struct etw_session *session;
+    BYTE *record, *traits = NULL;
+    ULONG size, ret = ERROR_SUCCESS;
+    LARGE_INTEGER now;
+    GUID provider;
+    BOOL taken;
+
+    RtlAcquireSRWLockShared( &etw_lock );
+    if (!(reg = find_registration( handle, FALSE )))
+    {
+        RtlReleaseSRWLockShared( &etw_lock );
+        return ERROR_INVALID_HANDLE;
+    }
+    if (!descriptor)
+    {
+        RtlReleaseSRWLockShared( &etw_lock );
+        return ERROR_INVALID_PARAMETER;
+    }
+    if ((taken = registration_takes( reg, descriptor->Level, descriptor->Keyword )))
+    {
+        provider = reg->guid;
+        if (reg->traits && (traits = RtlAllocateHeap( GetProcessHeap(), 0, *(USHORT *)reg->traits )))
+            memcpy( traits, reg->traits, *(USHORT *)reg->traits );
+    }
+    RtlReleaseSRWLockShared( &etw_lock );
+    if (!taken) return ERROR_SUCCESS;
+
+    record = build_event( &provider, descriptor, activity, related, traits, flags, count, data, string, &size, &ret );
+    RtlFreeHeap( GetProcessHeap(), 0, traits );
+    if (!record) return ret;
+
+    NtQuerySystemTime( &now );
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if ((reg = find_registration( handle, FALSE )))
+    {
+        LIST_FOR_EACH_ENTRY( enable, &reg->enables, struct etw_reg_enable, entry )
+        {
+            if (!enable_takes( enable->level, enable->any, enable->all, descriptor->Level, descriptor->Keyword ))
+                continue;
+            if (!(session = find_logger( enable->logger_id ))) continue;
+            stamp_record( session, record, offsetof( EVENT_HEADER, TimeStamp ),
+                          offsetof( EVENT_HEADER, ProcessorTime ), now );
+            if (session_add( session, record, size, now )) ret = ERROR_MORE_DATA;
+        }
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    RtlFreeHeap( GetProcessHeap(), 0, record );
+    return ret;
+}
+
+/******************************************************************************
+ * Telling providers
+ *
+ * A private session tells them on the spot, on the thread that enables them; another does it from a thread of its
+ * own, after the call returns, unless the call waits.  What a provider's callback is told is all the sessions that
+ * enable it together: the highest level, the keywords any of them wants, the keywords all of them want.
+ */
+
+struct etw_waiter
+{
+    LONG   refs;
+    HANDLE event;
+};
+
+struct etw_notification
+{
+    struct list              entry;
+    struct etw_registration *reg;
+    USHORT                   logger_id;
+    TRACEHANDLE              session;     /* a classic provider is told it, when it is disabled */
+    BOOL                     private;
+    BOOL                     stopping;
+    ULONG                    control;
+    UCHAR                    level;
+    ULONGLONG                any;
+    ULONGLONG                all;
+    struct etw_waiter       *waiter;
+};
+
+static struct list etw_notifications = LIST_INIT( etw_notifications );
+static BOOL etw_notifying;
+
+static void release_waiter( struct etw_waiter *waiter )
+{
+    if (InterlockedDecrement( &waiter->refs )) return;
+    NtClose( waiter->event );
+    RtlFreeHeap( GetProcessHeap(), 0, waiter );
+}
+
+static TRACEHANDLE logger_context( USHORT logger_id, BOOL private, UCHAR level, ULONG flags )
+{
+    return logger_id | (ULONG64)level << 16 | (ULONG64)(private ? 1 : 0) << 24 | (ULONG64)flags << 32;
+}
+
+/* the lock is held exclusively */
+static void set_reg_enable( struct etw_registration *reg, USHORT logger_id, UCHAR level, ULONGLONG any,
+                            ULONGLONG all )
+{
+    struct etw_reg_enable *enable;
+
+    LIST_FOR_EACH_ENTRY( enable, &reg->enables, struct etw_reg_enable, entry )
+        if (enable->logger_id == logger_id) break;
+    if (&enable->entry == &reg->enables)
+    {
+        if (!(enable = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*enable) ))) return;
+        enable->logger_id = logger_id;
+        list_add_tail( &reg->enables, &enable->entry );
+    }
+    enable->level = level;
+    enable->any = any;
+    enable->all = all;
+}
+
+/* the lock is held exclusively */
+static void remove_reg_enable( struct etw_registration *reg, USHORT logger_id )
+{
+    struct etw_reg_enable *enable;
+
+    LIST_FOR_EACH_ENTRY( enable, &reg->enables, struct etw_reg_enable, entry )
+    {
+        if (enable->logger_id != logger_id) continue;
+        list_remove( &enable->entry );
+        RtlFreeHeap( GetProcessHeap(), 0, enable );
+        return;
+    }
+}
+
+struct etw_call
+{
+    BOOL             call;
+    ULONG            control;
+    UCHAR            level;
+    ULONGLONG        any;
+    ULONGLONG        all;
+    WMIDPREQUESTCODE code;
+    WNODE_HEADER     wnode;
+};
+
+/* what a provider's callback is told now: the lock is held exclusively */
+static void prepare_call( struct etw_registration *reg, const struct etw_notification *n, struct etw_call *call )
+{
+    struct etw_reg_enable *enable;
+
+    memset( call, 0, sizeof(*call) );
+    if (!reg->classic)
+    {
+        if (!reg->callback) return;
+        if (n->control == EVENT_CONTROL_CODE_CAPTURE_STATE)
+        {
+            call->control = EVENT_CONTROL_CODE_CAPTURE_STATE;
+            call->level = n->level;
+            call->any = n->any;
+            call->all = n->all;
+        }
+        else if (!list_empty( &reg->enables ))
+        {
+            call->control = EVENT_CONTROL_CODE_ENABLE_PROVIDER;
+            call->all = ~(ULONGLONG)0;
+            LIST_FOR_EACH_ENTRY( enable, &reg->enables, struct etw_reg_enable, entry )
+            {
+                call->level = max( call->level, enable->level );
+                call->any |= enable->any;
+                call->all &= enable->all;
+            }
+        }
+        else call->control = EVENT_CONTROL_CODE_DISABLE_PROVIDER;
+    }
+    else
+    {
+        if (!reg->request || n->control == EVENT_CONTROL_CODE_CAPTURE_STATE) return;
+        call->wnode.BufferSize = sizeof(call->wnode);
+        call->wnode.Guid = reg->guid;
+        if (n->control == EVENT_CONTROL_CODE_ENABLE_PROVIDER)
+        {
+            call->code = WMI_ENABLE_EVENTS;
+            call->wnode.HistoricalContext = logger_context( n->logger_id, n->private, n->level, n->any );
+        }
+        else
+        {
+            call->code = WMI_DISABLE_EVENTS;
+            call->wnode.HistoricalContext = n->stopping ? 0 : n->session;
+        }
+    }
+    call->call = TRUE;
+    reg->calling++;
+    reg->calling_thread = current_tid();
+}
+
+static void make_call( struct etw_registration *reg, struct etw_call *call )
+{
+    ULONG size = sizeof(call->wnode);
+
+    if (!call->call) return;
+    if (!reg->classic)
+    {
+        TRACE_(eventlog)( "provider %s: %lu level %u any %s all %s\n", debugstr_guid(&reg->guid), call->control,
+                          call->level, wine_dbgstr_longlong(call->any), wine_dbgstr_longlong(call->all) );
+        reg->callback( &reg->guid, call->control, call->level, call->any, call->all, NULL, reg->context );
+    }
+    else
+    {
+        TRACE_(eventlog)( "classic provider %s: %u context %s\n", debugstr_guid(&reg->guid), call->code,
+                          wine_dbgstr_longlong(call->wnode.HistoricalContext) );
+        reg->request( call->code, reg->context, &size, &call->wnode );
+    }
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    reg->calling--;
+    RtlWakeAllConditionVariable( &etw_cv );
+    RtlReleaseSRWLockExclusive( &etw_lock );
+}
+
+static void deliver_notification( struct etw_notification *n )
+{
+    struct etw_registration *reg = n->reg;
+    struct etw_call call = { 0 };
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if (!reg->gone)
+    {
+        if (n->control == EVENT_CONTROL_CODE_ENABLE_PROVIDER)
+            set_reg_enable( reg, n->logger_id, n->level, n->any, n->all );
+        else if (n->control == EVENT_CONTROL_CODE_DISABLE_PROVIDER)
+            remove_reg_enable( reg, n->logger_id );
+        prepare_call( reg, n, &call );
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+
+    make_call( reg, &call );
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    release_registration( reg );
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    if (n->waiter)
+    {
+        NtSetEvent( n->waiter->event, NULL );
+        release_waiter( n->waiter );
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, n );
+}
+
+/* what is to be told of a provider, to each of its registrations: the lock is held exclusively */
+static void collect_notifications( struct list *list, const struct etw_session *session, const GUID *provider,
+                                   ULONG control, UCHAR level, ULONGLONG any, ULONGLONG all, BOOL stopping )
+{
+    struct etw_registration *reg;
+    struct etw_notification *n;
+
+    LIST_FOR_EACH_ENTRY( reg, &etw_registrations, struct etw_registration, entry )
+    {
+        if (!IsEqualGUID( &reg->guid, provider )) continue;
+        if (!(n = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*n) ))) continue;
+        n->reg = reg;
+        reg->refs++;
+        n->logger_id = session->logger_id;
+        n->session = session->handle;
+        n->private = is_private( session );
+        n->stopping = stopping;
+        n->control = control;
+        n->level = level;
+        n->any = any;
+        n->all = all;
+        list_add_tail( list, &n->entry );
+    }
+}
+
+static DWORD WINAPI notify_proc( void *arg )
+{
+    struct etw_notification *n;
+
+    for (;;)
+    {
+        RtlAcquireSRWLockExclusive( &etw_lock );
+        if (list_empty( &etw_notifications ))
+        {
+            etw_notifying = FALSE;
+            RtlReleaseSRWLockExclusive( &etw_lock );
+            return 0;
+        }
+        n = LIST_ENTRY( list_head( &etw_notifications ), struct etw_notification, entry );
+        list_remove( &n->entry );
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        deliver_notification( n );
+    }
+}
+
+/* tell them now, or queue them for the thread that does, waiting until that is done when asked to */
+static ULONG send_notifications( struct list *list, BOOL now, ULONG timeout )
+{
+    struct etw_notification *n, *next;
+    struct etw_waiter *waiter = NULL;
+    LARGE_INTEGER wait;
+    BOOL start = FALSE;
+    NTSTATUS status;
+
+    if (list_empty( list )) return ERROR_SUCCESS;
+    if (now)
+    {
+        LIST_FOR_EACH_ENTRY_SAFE( n, next, list, struct etw_notification, entry )
+        {
+            list_remove( &n->entry );
+            deliver_notification( n );
+        }
+        return ERROR_SUCCESS;
+    }
+
+    if (timeout && (waiter = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*waiter) )))
+    {
+        if (NtCreateEvent( &waiter->event, EVENT_ALL_ACCESS, NULL, NotificationEvent, FALSE ))
+        {
+            RtlFreeHeap( GetProcessHeap(), 0, waiter );
+            waiter = NULL;
+        }
+        else
+        {
+            waiter->refs = 2;
+            n = LIST_ENTRY( list_tail( list ), struct etw_notification, entry );
+            n->waiter = waiter;
+        }
+    }
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    list_move_tail( &etw_notifications, list );
+    if (!etw_notifying) start = etw_notifying = TRUE;
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    if (start && RtlQueueWorkItem( notify_proc, NULL, WT_EXECUTEDEFAULT )) notify_proc( NULL );
+
+    if (!waiter) return ERROR_SUCCESS;
+    wait.QuadPart = (LONGLONG)timeout * -10000;
+    status = NtWaitForSingleObject( waiter->event, FALSE, timeout == INFINITE ? NULL : &wait );
+    release_waiter( waiter );
+    return status == STATUS_TIMEOUT ? ERROR_TIMEOUT : ERROR_SUCCESS;
+}
+
+/* a provider registering is told, then and there, what the sessions already enable of it */
+static void notify_registration( struct etw_registration *reg )
+{
+    struct etw_notification n = { 0 };
+    struct etw_session *session;
+    struct etw_enable *enable;
+    struct etw_call call = { 0 };
+    BOOL found = FALSE;
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    LIST_FOR_EACH_ENTRY( session, &etw_sessions, struct etw_session, entry )
+    {
+        LIST_FOR_EACH_ENTRY( enable, &session->enables, struct etw_enable, entry )
+        {
+            if (!IsEqualGUID( &enable->provider, &reg->guid )) continue;
+            set_reg_enable( reg, session->logger_id, enable->level, enable->any, enable->all );
+            n.logger_id = session->logger_id;
+            n.session = session->handle;
+            n.private = is_private( session );
+            n.level = enable->level;
+            n.any = enable->any;
+            n.all = enable->all;
+            found = TRUE;
+        }
+    }
+    if (found)
+    {
+        n.control = EVENT_CONTROL_CODE_ENABLE_PROVIDER;
+        prepare_call( reg, &n, &call );
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    make_call( reg, &call );
+}
+
+/******************************************************************************
+ * Consumers
+ */
+
+/* the lock is held */
+static struct etw_consumer *find_consumer( TRACEHANDLE handle )
+{
+    struct etw_consumer *consumer;
+
+    LIST_FOR_EACH_ENTRY( consumer, &etw_consumers, struct etw_consumer, entry )
+        if (consumer->handle == handle && !consumer->closed) return consumer;
+    return NULL;
+}
+
+/* the lock is held */
+static void attach_consumer( struct etw_consumer *consumer, struct etw_session *session )
+{
+    consumer->session = session;
+    list_add_tail( &session->consumers, &consumer->session_entry );
+}
+
+/* the lock is held */
+static void detach_consumer( struct etw_consumer *consumer )
+{
+    if (!consumer->session) return;
+    list_remove( &consumer->session_entry );
+    consumer->session = NULL;
+}
+
+static void free_consumer( struct etw_consumer *consumer )
+{
+    struct etw_batch *batch, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( batch, next, &consumer->batches, struct etw_batch, entry )
+    {
+        free_events( &batch->events );
+        RtlFreeHeap( GetProcessHeap(), 0, batch );
+    }
+    if (consumer->file) NtClose( consumer->file );
+    RtlFreeHeap( GetProcessHeap(), 0, consumer->header );
+    RtlFreeHeap( GetProcessHeap(), 0, consumer->name );
+    RtlFreeHeap( GetProcessHeap(), 0, consumer );
+}
+
+static const GUID null_guid;
+static const GUID event_trace_guid =
+    { 0x68fdd900, 0x4a3e, 0x11d1, { 0x84, 0xf4, 0x00, 0x00, 0xf8, 0x04, 0x64, 0xe3 } };
+
+/* where a record comes from, for what a consumer is told of it */
+struct record_source
+{
+    const struct etw_consumer *consumer;
+    UCHAR                      processor;
+    USHORT                     logger_id;
+    LARGE_INTEGER              system_time;    /* a real-time event's */
+    const FILETIME            *start;          /* what is to be delivered */
+    const FILETIME            *end;
+};
+
+static const struct logfile_header *consumer_header( const struct etw_consumer *consumer )
+{
+    if (!consumer->header) return NULL;
+    return (const struct logfile_header *)(consumer->header + ETW_BUFFER_HEADER_SIZE + ETW_SYSTEM_HEADER_SIZE);
+}
+
+/* a time stamp of a record, as the consumer is to have it: the system's time unless it asked for the raw one */
+static LARGE_INTEGER record_time( const struct record_source *src, LONGLONG raw )
+{
+    const struct logfile_header *header = consumer_header( src->consumer );
+    LARGE_INTEGER ret;
+    LONGLONG freq, delta;
+
+    ret.QuadPart = raw;
+    if (src->consumer->mode & PROCESS_TRACE_MODE_RAW_TIMESTAMP) return ret;
+    if (!header) return src->system_time;
+    switch (header->ReservedFlags)
+    {
+    case 2: return ret;
+    case 3: freq = (LONGLONG)header->CpuSpeedInMHz * 1000000; break;
+    default: freq = header->PerfFreq.QuadPart; break;
+    }
+    if (freq <= 0) return ret;
+    delta = raw - src->consumer->file_start;
+    ret.QuadPart = header->StartTime.QuadPart + delta / freq * 10000000 + delta % freq * 10000000 / freq;
+    return ret;
+}
+
+/* A record to a consumer's callback, as an EVENT_RECORD or an EVENT_TRACE: an event of a manifest or TraceLogging
+ * provider, a classic provider's event or message, or one of the records of a log file's header buffer. */
+static void deliver_record( const BYTE *raw, ULONG size, const struct record_source *src )
+{
+    const struct etw_consumer *consumer = src->consumer;
+    const struct logfile_header *header = consumer_header( consumer );
+    EVENT_TRACE_LOGFILEW *logfile = consumer->logfile;
+    BOOL from_file = !!consumer->file, record_mode = !!(consumer->mode & PROCESS_TRACE_MODE_EVENT_RECORD);
+    USHORT flags = EVENT_HEADER_FLAG_PROCESSOR_INDEX;
+    EVENT_HEADER_EXTENDED_DATA_ITEM items[8];
+    EVENT_RECORD record;
+    EVENT_TRACE trace;
+    UCHAR type = raw[2];
+    ULONG pos;
+
+    if (size < 8) return;
+    if (header && (header->LogFileMode & EVENT_TRACE_PRIVATE_LOGGER_MODE)) flags |= EVENT_HEADER_FLAG_PRIVATE_SESSION;
+    if (raw[3] == ETW_HEADER_MESSAGE) type = 0;
+    flags |= (type == 0x12 || type == 0x0a || type == 0x01) ? EVENT_HEADER_FLAG_32_BIT_HEADER :
+                                                              EVENT_HEADER_FLAG_64_BIT_HEADER;
+
+    memset( &record, 0, sizeof(record) );
+    memset( &trace, 0, sizeof(trace) );
+    record.BufferContext.ProcessorNumber = src->processor;
+    record.BufferContext.LoggerId = src->logger_id;
+    record.UserContext = logfile->Context;
+    trace.ClientContext = src->processor | (ULONG)src->logger_id << 16;
+
+    if (raw[3] == ETW_HEADER_MESSAGE)
+    {
+        /* a message: its header, then the fields it has */
+        USHORT options = *(const USHORT *)(raw + 6);
+        LONGLONG time = 0;
+
+        pos = 8;
+        record.EventHeader.Size = size;
+        record.EventHeader.Flags = flags | EVENT_HEADER_FLAG_CLASSIC_HEADER | EVENT_HEADER_FLAG_TRACE_MESSAGE;
+        record.EventHeader.EventProperty = options;
+        record.EventHeader.EventDescriptor.Id = *(const USHORT *)(raw + 4);
+        if (options & TRACE_MESSAGE_SEQUENCE) pos += 4;
+        if (options & TRACE_MESSAGE_COMPONENTID) pos += 4;
+        else if (options & TRACE_MESSAGE_GUID)
+        {
+            if (pos + sizeof(GUID) <= size) memcpy( &record.EventHeader.ProviderId, raw + pos, sizeof(GUID) );
+            pos += sizeof(GUID);
+        }
+        if (options & (TRACE_MESSAGE_TIMESTAMP | TRACE_MESSAGE_PERFORMANCE_TIMESTAMP))
+        {
+            if (pos + sizeof(time) <= size) memcpy( &time, raw + pos, sizeof(time) );
+            pos += sizeof(LARGE_INTEGER);
+        }
+        record.EventHeader.TimeStamp = record_time( src, time );
+        if (options & TRACE_MESSAGE_SYSTEMINFO)
+        {
+            if (pos + 8 <= size)
+            {
+                record.EventHeader.ThreadId = *(const ULONG *)(raw + pos);
+                record.EventHeader.ProcessId = *(const ULONG *)(raw + pos + 4);
+            }
+            pos += 8;
+        }
+        if (pos > size) pos = size;
+        record.UserDataLength = size - pos;
+        record.UserData = (void *)(raw + pos);
+
+        trace.Header.Size = size;
+        trace.Header.MarkerFlags = ETW_HEADER_MESSAGE;
+        trace.Header.Class.Type = record.EventHeader.EventDescriptor.Id;
+        trace.Header.Class.Version = options;
+        trace.MofData = (void *)(raw + 8);
+        trace.MofLength = size - 8;
+    }
+    else if (type == 0x13 || type == 0x12)
+    {
+        const EVENT_HEADER *event = (const EVENT_HEADER *)raw;
+
+        if (size < sizeof(*event)) return;
+        record.EventHeader = *event;
+        record.EventHeader.HeaderType = 0;
+        record.EventHeader.Flags |= flags;
+        record.EventHeader.TimeStamp = record_time( src, event->TimeStamp.QuadPart );
+        pos = sizeof(*event);
+        if (event->Flags & EVENT_HEADER_FLAG_EXTENDED_INFO)
+        {
+            while (pos + 8 <= size && record.ExtendedDataCount < ARRAY_SIZE(items))
+            {
+                EVENT_HEADER_EXTENDED_DATA_ITEM *item = &items[record.ExtendedDataCount++];
+                USHORT item_size = *(const USHORT *)(raw + pos), more = *(const USHORT *)(raw + pos + 4);
+
+                memset( item, 0, sizeof(*item) );
+                item->ExtType = *(const USHORT *)(raw + pos + 2);
+                item->Linkage = !!more;
+                item->DataSize = *(const USHORT *)(raw + pos + 6);
+                item->DataPtr = (ULONG_PTR)(raw + pos + 8);
+                if (!item_size) break;
+                pos += item_size;
+                if (!more) break;
+            }
+            record.ExtendedData = items;
+        }
+        if (pos > size) pos = size;
+        record.UserDataLength = size - pos;
+        record.UserData = (void *)(raw + pos);
+
+        trace.Header.Size = event->Size;
+        trace.Header.HeaderType = from_file ? 1 : 0;
+        trace.Header.Class.Type = event->EventDescriptor.Opcode;
+        trace.Header.Class.Level = event->EventDescriptor.Level;
+        trace.Header.Class.Version = event->EventDescriptor.Version;
+        trace.Header.ThreadId = event->ThreadId;
+        trace.Header.ProcessId = event->ProcessId;
+        trace.Header.Guid = event->ProviderId;
+        trace.Header.ProcessorTime = event->ProcessorTime;
+        trace.MofData = (void *)(raw + sizeof(*event));
+        trace.MofLength = size - sizeof(*event);
+    }
+    else if (type == 0x14 || type == 0x0a)
+    {
+        const EVENT_TRACE_HEADER *classic = (const EVENT_TRACE_HEADER *)raw;
+
+        if (size < sizeof(*classic)) return;
+        record.EventHeader.Size = classic->Size;
+        record.EventHeader.Flags = flags | EVENT_HEADER_FLAG_CLASSIC_HEADER;
+        record.EventHeader.ThreadId = classic->ThreadId;
+        record.EventHeader.ProcessId = classic->ProcessId;
+        record.EventHeader.ProviderId = classic->Guid;
+        record.EventHeader.EventDescriptor.Opcode = classic->Class.Type;
+        record.EventHeader.EventDescriptor.Level = classic->Class.Level;
+        record.EventHeader.EventDescriptor.Version = classic->Class.Version;
+        record.EventHeader.ProcessorTime = classic->ProcessorTime;
+        record.EventHeader.TimeStamp = record_time( src, classic->TimeStamp.QuadPart );
+        /* a real-time consumer has it from processor 0 */
+        if (!from_file) record.BufferContext.ProcessorNumber = 0;
+        record.UserDataLength = size - sizeof(*classic);
+        record.UserData = (void *)(raw + sizeof(*classic));
+
+        trace.Header = *classic;
+        trace.Header.HeaderType = from_file ? 1 : 0;
+        trace.Header.MarkerFlags = 0;
+        if (!from_file) trace.ClientContext = (ULONG)src->logger_id << 16;
+        trace.MofData = record.UserData;
+        trace.MofLength = record.UserDataLength;
+    }
+    else if ((type == ETW_HEADER_SYSTEM || type == 0x01) && from_file)
+    {
+        /* the header buffer's records: the log file's header, and the one that closes it */
+        size = *(const USHORT *)(raw + 4);
+        if (size < ETW_SYSTEM_HEADER_SIZE) return;
+        record.EventHeader.Size = size;
+        record.EventHeader.Flags = flags | EVENT_HEADER_FLAG_CLASSIC_HEADER;
+        record.EventHeader.ThreadId = *(const ULONG *)(raw + 8);
+        record.EventHeader.ProcessId = *(const ULONG *)(raw + 12);
+        record.EventHeader.TimeStamp = record_time( src, *(const LONGLONG *)(raw + 16) );
+        record.EventHeader.ProviderId = event_trace_guid;
+        record.EventHeader.EventDescriptor.Version = raw[0];
+        record.EventHeader.EventDescriptor.Opcode = raw[6];
+        record.EventHeader.ProcessorTime = *(const ULONG64 *)(raw + 24);
+        record.UserDataLength = size - ETW_SYSTEM_HEADER_SIZE;
+        record.UserData = (void *)(raw + ETW_SYSTEM_HEADER_SIZE);
+
+        trace.Header.Size = size;
+        trace.Header.Class.Type = raw[6];
+        trace.Header.Class.Version = *(const USHORT *)raw;
+        trace.Header.ThreadId = record.EventHeader.ThreadId;
+        trace.Header.ProcessId = record.EventHeader.ProcessId;
+        trace.Header.Guid = event_trace_guid;
+        trace.Header.ProcessorTime = record.EventHeader.ProcessorTime;
+        trace.MofData = record.UserData;
+        trace.MofLength = record.UserDataLength;
+    }
+    else return;
+
+    trace.Header.TimeStamp = record.EventHeader.TimeStamp;
+    if (!trace.Header.ThreadId) trace.Header.ThreadId = record.EventHeader.ThreadId;
+    if (!trace.Header.ProcessId) trace.Header.ProcessId = record.EventHeader.ProcessId;
+    if (IsEqualGUID( &trace.Header.Guid, &null_guid )) trace.Header.Guid = record.EventHeader.ProviderId;
+    if (src->start && record.EventHeader.TimeStamp.QuadPart < *(const LONGLONG *)src->start) return;
+    if (src->end && record.EventHeader.TimeStamp.QuadPart > *(const LONGLONG *)src->end) return;
+
+    if (record_mode)
+    {
+        if (logfile->EventRecordCallback) logfile->EventRecordCallback( &record );
+    }
+    else if (logfile->EventCallback) logfile->EventCallback( &trace );
+}
+
+/* the size a record takes in a buffer */
+static ULONG record_size( const BYTE *raw, ULONG avail )
+{
+    ULONG size;
+
+    if (avail < 8) return 0;
+    if (raw[3] != ETW_HEADER_MESSAGE && (raw[2] == ETW_HEADER_SYSTEM || raw[2] == 0x01))
+        size = *(const USHORT *)(raw + 4);
+    else
+        size = *(const USHORT *)raw;
+    if (size < 8 || size > avail) return 0;
+    return size;
+}
+
+static NTSTATUS read_file( HANDLE file, LONGLONG offset, void *data, ULONG size, ULONG *read )
+{
+    IO_STATUS_BLOCK io;
+    LARGE_INTEGER pos;
+    NTSTATUS status;
+
+    pos.QuadPart = offset;
+    status = NtReadFile( file, NULL, NULL, NULL, &io, data, size, &pos, NULL );
+    *read = status ? 0 : io.Information;
+    return status;
+}
+
+/* the log file of a consumer, a buffer at a time: the header first, then the others in the order they were
+ * written; after each, the consumer's buffer callback, which may stop it */
+static ULONG process_file( struct etw_consumer *consumer, FILETIME *start, FILETIME *end )
+{
+    const struct logfile_header *header = consumer_header( consumer );
+    ULONG buffer_size = header->BufferSize, count = 0, i, j, read;
+    FILE_STANDARD_INFORMATION info;
+    struct { ULONG64 sequence; LONGLONG offset; } *order = NULL;
+    struct record_source src;
+    IO_STATUS_BLOCK io;
+    BYTE *buf;
+
+    if (NtQueryInformationFile( consumer->file, &io, &info, sizeof(info), FileStandardInformation ))
+        return ERROR_BAD_FORMAT;
+    if (!(buf = RtlAllocateHeap( GetProcessHeap(), 0, buffer_size ))) return ERROR_NOT_ENOUGH_MEMORY;
+    count = info.EndOfFile.QuadPart / buffer_size;
+    if (count > 1 && !(order = RtlAllocateHeap( GetProcessHeap(), 0, (count - 1) * sizeof(*order) )))
+    {
+        RtlFreeHeap( GetProcessHeap(), 0, buf );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+    for (i = 1, j = 0; i < count; i++)
+    {
+        if (read_file( consumer->file, (LONGLONG)i * buffer_size, buf, ETW_BUFFER_HEADER_SIZE, &read ) ||
+            read < ETW_BUFFER_HEADER_SIZE)
+            break;
+        if (*(const USHORT *)(buf + 0x36)) continue;   /* not one of events */
+        order[j].sequence = *(const ULONG64 *)(buf + 0x18);
+        order[j].offset = (LONGLONG)i * buffer_size;
+        j++;
+    }
+    count = j;
+    /* by the order they were written, which a circular log file does not keep */
+    for (i = 1; i < count; i++)
+        for (j = i; j > 0 && order[j - 1].sequence > order[j].sequence; j--)
+        {
+            ULONG64 sequence = order[j].sequence;
+            LONGLONG offset = order[j].offset;
+            order[j] = order[j - 1];
+            order[j - 1].sequence = sequence;
+            order[j - 1].offset = offset;
+        }
+
+    memset( &src, 0, sizeof(src) );
+    src.consumer = consumer;
+    src.start = start;
+    src.end = end;
+    for (i = 0; i <= count; i++)
+    {
+        ULONG used, pos, size;
+        const BYTE *data = buf;
+
+        if (!i) data = consumer->header;
+        else if (read_file( consumer->file, order[i - 1].offset, buf, buffer_size, &read ) || read < buffer_size)
+            break;
+        used = min( *(const ULONG *)(data + 4), buffer_size );
+        src.processor = data[0x28];
+        src.logger_id = *(const USHORT *)(data + 0x2a);
+        for (pos = ETW_BUFFER_HEADER_SIZE; (size = record_size( data + pos, used - min( pos, used ) )); )
+        {
+            deliver_record( data + pos, size, &src );
+            pos += (size + 7) & ~7;
+        }
+        if (consumer->logfile->BufferCallback && !consumer->logfile->BufferCallback( consumer->logfile )) break;
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, order );
+    RtlFreeHeap( GetProcessHeap(), 0, buf );
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ * Strings of the properties and log file structures, in the caller's character set
+ */
+
+static WCHAR *dup_wstr( const WCHAR *str )
+{
+    ULONG size = (wcslen( str ) + 1) * sizeof(WCHAR);
+    WCHAR *ret = RtlAllocateHeap( GetProcessHeap(), 0, size );
+
+    if (ret) memcpy( ret, str, size );
+    return ret;
+}
+
+static WCHAR *dup_string( const void *str, BOOL ansi )
+{
+    UNICODE_STRING string;
+
+    if (!str) return NULL;
+    if (!ansi) return dup_wstr( str );
+    if (!RtlCreateUnicodeStringFromAsciiz( &string, str )) return NULL;
+    return string.Buffer;
+}
+
+/* how much a string takes in the caller's character set */
+static ULONG string_size( const WCHAR *str, BOOL ansi )
+{
+    ULONG len = wcslen( str ) + 1, size;
+
+    if (!ansi) return len * sizeof(WCHAR);
+    RtlUnicodeToMultiByteSize( &size, str, len * sizeof(WCHAR) );
+    return size;
+}
+
+static void put_string( void *dst, const WCHAR *str, BOOL ansi )
+{
+    ULONG len = wcslen( str ) + 1, size;
+
+    if (!ansi) memcpy( dst, str, len * sizeof(WCHAR) );
+    else
+    {
+        RtlUnicodeToMultiByteSize( &size, str, len * sizeof(WCHAR) );
+        RtlUnicodeToMultiByteN( dst, size, NULL, str, len * sizeof(WCHAR) );
+    }
+}
+
+/* the session's names into the properties: where they say, or the logger's after the structure and the log file's
+ * after that; they have to fit, apart */
+static ULONG fill_names( const struct etw_session *session, EVENT_TRACE_PROPERTIES *props, BOOL ansi )
+{
+    ULONG name_off = props->LoggerNameOffset, file_off = props->LogFileNameOffset, size = props->Wnode.BufferSize;
+    ULONG name_size = string_size( session->name, ansi );
+    ULONG file_size = session->file_name ? string_size( session->file_name, ansi ) : 0;
+
+    if (!name_off) name_off = sizeof(*props);
+    if (!file_off) file_off = name_off + name_size;
+    if (name_off < sizeof(*props) || name_off > size || name_size > size - name_off) return ERROR_MORE_DATA;
+    if (file_size)
+    {
+        if (file_off < sizeof(*props) || file_off > size || file_size > size - file_off) return ERROR_MORE_DATA;
+        if (file_off < name_off + name_size && name_off < file_off + file_size) return ERROR_MORE_DATA;
+    }
+    put_string( (BYTE *)props + name_off, session->name, ansi );
+    props->LoggerNameOffset = name_off;
+    if (file_size)
+    {
+        put_string( (BYTE *)props + file_off, session->file_name, ansi );
+        props->LogFileNameOffset = file_off;
+    }
+    return ERROR_SUCCESS;
+}
+
+/* the session as a query tells it */
+static ULONG fill_props( const struct etw_session *session, EVENT_TRACE_PROPERTIES *props, BOOL ansi )
+{
+    ULONG ret;
+
+    if ((ret = fill_names( session, props, ansi ))) return ret;
+    props->Wnode.Guid = session->guid;
+    props->Wnode.ClientContext = session->clock;
+    props->Wnode.HistoricalContext = session->handle;
+    props->BufferSize = session->buffer_size;
+    props->MinimumBuffers = session->min_buffers;
+    props->MaximumBuffers = session->max_buffers;
+    props->MaximumFileSize = session->max_file_size;
+    props->LogFileMode = session->mode;
+    props->FlushTimer = session->flush_timer;
+    props->EnableFlags = session->enable_flags;
+    props->AgeLimit = session->age_limit;
+    props->NumberOfBuffers = session->min_buffers;
+    props->FreeBuffers = session->min_buffers - (session->buffer_pos > ETW_BUFFER_HEADER_SIZE ? 1 : 0);
+    props->EventsLost = session->events_lost;
+    props->BuffersWritten = session->buffers_written;
+    props->LogBuffersLost = session->log_buffers_lost;
+    props->RealTimeBuffersLost = session->realtime_lost;
+    /* a logger thread writes a log file or delivers to consumers; one in memory has none */
+    props->LoggerThreadId = (session->file || (session->mode & EVENT_TRACE_REAL_TIME_MODE)) ?
+                            ULongToHandle( session->thread ) : 0;
+    return ERROR_SUCCESS;
+}
+
+static void free_session( struct etw_session *session )
+{
+    struct etw_enable *enable, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( enable, next, &session->enables, struct etw_enable, entry )
+        RtlFreeHeap( GetProcessHeap(), 0, enable );
+    free_events( &session->pending );
+    RtlFreeHeap( GetProcessHeap(), 0, session->buffer );
+    RtlFreeHeap( GetProcessHeap(), 0, session->name );
+    RtlFreeHeap( GetProcessHeap(), 0, session->file_name );
+    RtlFreeHeap( GetProcessHeap(), 0, session );
+}
+
+/* whether the caller may start a session of the system's kind: an administrator or a performance log user may */
+static BOOL may_start_session(void)
+{
+    static const struct
+    {
+        BYTE Revision;
+        BYTE SubAuthorityCount;
+        SID_IDENTIFIER_AUTHORITY IdentifierAuthority;
+        DWORD SubAuthority[2];
+    }
+    admins = { SID_REVISION, 2, { SECURITY_NT_AUTHORITY }, { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_ADMINS } },
+    log_users = { SID_REVISION, 2, { SECURITY_NT_AUTHORITY },
+                  { SECURITY_BUILTIN_DOMAIN_RID, DOMAIN_ALIAS_RID_LOGGING_USERS } };
+    TOKEN_GROUPS *groups = NULL;
+    HANDLE token;
+    ULONG size = 0, i;
+    BOOL ret = TRUE;
+
+    if (NtOpenThreadToken( NtCurrentThread(), TOKEN_QUERY, TRUE, &token ) &&
+        NtOpenProcessToken( NtCurrentProcess(), TOKEN_QUERY, &token ))
+        return TRUE;
+    NtQueryInformationToken( token, TokenGroups, NULL, 0, &size );
+    if (size && (groups = RtlAllocateHeap( GetProcessHeap(), 0, size )) &&
+        !NtQueryInformationToken( token, TokenGroups, groups, size, &size ))
+    {
+        ret = FALSE;
+        for (i = 0; i < groups->GroupCount; i++)
+        {
+            if (!(groups->Groups[i].Attributes & SE_GROUP_ENABLED)) continue;
+            if (groups->Groups[i].Attributes & SE_GROUP_USE_FOR_DENY_ONLY) continue;
+            if (RtlEqualSid( groups->Groups[i].Sid, (PSID)&admins ) ||
+                RtlEqualSid( groups->Groups[i].Sid, (PSID)&log_users ))
+                ret = TRUE;
+        }
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, groups );
+    NtClose( token );
+    return ret;
+}
+
+/* the names of private loggers that never started, which stay taken */
+struct etw_reserved
+{
+    struct list entry;
+    WCHAR       name[1];
+};
+
+static struct list etw_reserved_names = LIST_INIT( etw_reserved_names );
+
+/* the lock is held */
+static BOOL is_reserved( const WCHAR *name )
+{
+    struct etw_reserved *reserved;
+
+    LIST_FOR_EACH_ENTRY( reserved, &etw_reserved_names, struct etw_reserved, entry )
+        if (!wcsicmp( reserved->name, name )) return TRUE;
+    return FALSE;
+}
+
+static ULONG reserve_name( const void *name, BOOL ansi )
+{
+    struct etw_reserved *reserved;
+    WCHAR *nameW;
+    ULONG ret = ERROR_TIMEOUT;
+
+    if (!(nameW = dup_string( name, ansi ))) return ERROR_NOT_ENOUGH_MEMORY;
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if (find_session( 0, nameW ) || is_reserved( nameW )) ret = ERROR_ALREADY_EXISTS;
+    else if ((reserved = RtlAllocateHeap( GetProcessHeap(), 0,
+                                          offsetof( struct etw_reserved, name[wcslen( nameW ) + 1] ) )))
+    {
+        wcscpy( reserved->name, nameW );
+        list_add_tail( &etw_reserved_names, &reserved->entry );
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    RtlFreeHeap( GetProcessHeap(), 0, nameW );
+    return ret;
+}
+
+/* where a string at an offset into the properties lies, if it does */
+static const void *props_string( const EVENT_TRACE_PROPERTIES *props, ULONG offset )
+{
+    if (!offset) return NULL;
+    if (offset < sizeof(*props) || offset >= props->Wnode.BufferSize) return (const void *)-1;
+    return (const BYTE *)props + offset;
+}
+
+/******************************************************************************
+ *                  __wine_etw_start_trace (NTDLL.@)
+ *
+ * StartTrace() of a session of the process, checked as Windows 11 checks it.
+ */
+ULONG CDECL __wine_etw_start_trace( TRACEHANDLE *handle, const void *name, EVENT_TRACE_PROPERTIES *props, BOOL ansi )
+{
+    ULONG mode, file_modes, name_off, name_size, ret = ERROR_SUCCESS;
+    struct etw_session *session;
+    const void *file;
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING nt_name;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+
+    TRACE_(eventlog)( "%p %s %p\n", handle, ansi ? debugstr_a(name) : debugstr_w(name), props );
+
+    if (!handle || !name || !props) return ERROR_INVALID_PARAMETER;
+    if (props->Wnode.BufferSize < sizeof(*props)) return ERROR_BAD_LENGTH;
+    name_off = props->LoggerNameOffset ? props->LoggerNameOffset : sizeof(*props);
+    if (name_off < sizeof(*props)) return ERROR_INVALID_PARAMETER;
+    name_size = ansi ? strlen( name ) + 1 : (wcslen( name ) + 1) * sizeof(WCHAR);
+    if (name_size <= (ansi ? 1 : sizeof(WCHAR))) return ERROR_INVALID_PARAMETER;
+    if (name_off > props->Wnode.BufferSize || name_size > props->Wnode.BufferSize - name_off) return ERROR_BAD_LENGTH;
+    if ((file = props_string( props, props->LogFileNameOffset )) == (const void *)-1) return ERROR_INVALID_PARAMETER;
+    if (file && !(ansi ? *(const char *)file : *(const WCHAR *)file)) file = NULL;
+
+    mode = props->LogFileMode;
+    file_modes = mode & (EVENT_TRACE_FILE_MODE_SEQUENTIAL | EVENT_TRACE_FILE_MODE_CIRCULAR |
+                         EVENT_TRACE_FILE_MODE_NEWFILE);
+    if (file_modes & (file_modes - 1)) return ERROR_INVALID_PARAMETER;
+    if (IsEqualGUID( &props->Wnode.Guid, &system_trace_control_guid )) return ERROR_INVALID_PARAMETER;
+    /* a private logger is not real-time, and is flushed when its buffers are full */
+    if (mode & EVENT_TRACE_PRIVATE_LOGGER_MODE)
+    {
+        if (mode & EVENT_TRACE_REAL_TIME_MODE) return ERROR_INVALID_PARAMETER;
+        if (props->FlushTimer) return ERROR_INVALID_PARAMETER;
+    }
+    /* what is not kept in memory or read as it comes goes to a log file, and has to have one */
+    if (!(mode & (EVENT_TRACE_BUFFERING_MODE | EVENT_TRACE_REAL_TIME_MODE)) && !file) return ERROR_BAD_PATHNAME;
+    if ((mode & EVENT_TRACE_FILE_MODE_CIRCULAR) && !props->MaximumFileSize) return ERROR_INVALID_PARAMETER;
+    if (!(mode & EVENT_TRACE_PRIVATE_LOGGER_MODE) && !may_start_session()) return ERROR_ACCESS_DENIED;
+    /* One not in this process is to be started by the process of the provider with its GUID, which Windows waits
+     * for a minute and gives up on, whoever registered the GUID; the name stays taken.  This does not wait. */
+    if ((mode & EVENT_TRACE_PRIVATE_LOGGER_MODE) && !(mode & EVENT_TRACE_PRIVATE_IN_PROC))
+        return reserve_name( name, ansi );
+    if (mode & EVENT_TRACE_BUFFERING_MODE) file = NULL;
+
+    if (!(session = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*session) )))
+        return ERROR_NOT_ENOUGH_MEMORY;
+    list_init( &session->enables );
+    list_init( &session->pending );
+    list_init( &session->consumers );
+    session->guid = props->Wnode.Guid;
+    session->clock = props->Wnode.ClientContext ? props->Wnode.ClientContext : 1;
+    session->mode = mode & ~EVENT_TRACE_ADDTO_TRIAGE_DUMP;
+    if (!(mode & (EVENT_TRACE_PRIVATE_LOGGER_MODE | EVENT_TRACE_STOP_ON_HYBRID_SHUTDOWN)))
+        session->mode |= EVENT_TRACE_PERSIST_ON_HYBRID_SHUTDOWN;
+    session->max_file_size = props->MaximumFileSize;
+    session->flush_timer = props->FlushTimer;
+    session->enable_flags = props->EnableFlags;
+    session->age_limit = props->AgeLimit;
+    session->thread = current_tid();
+    if (mode & EVENT_TRACE_PRIVATE_LOGGER_MODE)
+    {
+        /* its buffers are its own to choose */
+        session->buffer_size = props->BufferSize ? props->BufferSize : 4;
+        session->min_buffers = 16;
+        session->max_buffers = file ? 38 : 16;
+    }
+    else
+    {
+        session->buffer_size = props->BufferSize ? props->BufferSize : 64;
+        session->min_buffers = props->MinimumBuffers ? props->MinimumBuffers : 16;
+        session->max_buffers = props->MaximumBuffers ? props->MaximumBuffers : session->min_buffers + 22;
+    }
+    NtQuerySystemTime( &session->start_time );
+    session->start_counter = session_time( session, session->start_time );
+    session->buffer_pos = ETW_BUFFER_HEADER_SIZE;
+
+    if (!(session->name = dup_string( name, ansi )) || (file && !(session->file_name = dup_string( file, ansi ))) ||
+        ((file || (mode & EVENT_TRACE_BUFFERING_MODE)) &&
+         !(session->buffer = RtlAllocateHeap( GetProcessHeap(), 0, session->buffer_size * 1024 ))))
+    {
+        free_session( session );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+
+    /* the name first: a session that has it may have the log file open too */
+    RtlAcquireSRWLockShared( &etw_lock );
+    if (find_session( 0, session->name ) || is_reserved( session->name )) ret = ERROR_ALREADY_EXISTS;
+    RtlReleaseSRWLockShared( &etw_lock );
+    if (ret)
+    {
+        free_session( session );
+        return ret;
+    }
+
+    if (session->file_name)
+    {
+        if (!RtlDosPathNameToNtPathName_U( session->file_name, &nt_name, NULL, NULL ))
+            status = STATUS_OBJECT_PATH_INVALID;
+        else
+        {
+            InitializeObjectAttributes( &attr, &nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+            status = NtCreateFile( &session->file, GENERIC_WRITE | SYNCHRONIZE, &attr, &io, NULL,
+                                   FILE_ATTRIBUTE_NORMAL, FILE_SHARE_READ | FILE_SHARE_DELETE, FILE_OVERWRITE_IF,
+                                   FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE, NULL, 0 );
+            RtlFreeUnicodeString( &nt_name );
+        }
+        if (status)
+        {
+            free_session( session );
+            return RtlNtStatusToDosError( status );
+        }
+    }
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if (find_session( 0, session->name ) || is_reserved( session->name )) ret = ERROR_ALREADY_EXISTS;
+    else if (!(session->logger_id = alloc_logger_id())) ret = ERROR_NO_SYSTEM_RESOURCES;
+    else
+    {
+        session->handle = session->logger_id | (is_private( session ) ? ETW_PRIVATE_HANDLE : 0);
+        if (session->file)
+        {
+            session->buffers_written = 1;
+            session->next_buffer = session->buffer_size * 1024;
+            write_header_buffer( session, FALSE );
+        }
+        list_add_tail( &etw_sessions, &session->entry );
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    if (ret)
+    {
+        if (session->file)
+        {
+            FILE_DISPOSITION_INFORMATION info = { TRUE };
+            NtSetInformationFile( session->file, &io, &info, sizeof(info), FileDispositionInformation );
+            NtClose( session->file );
+        }
+        free_session( session );
+        return ret;
+    }
+
+    /* a real-time session delivers at least every second */
+    if (!is_private( session ) && (session->flush_timer || (session->mode & EVENT_TRACE_REAL_TIME_MODE)))
+    {
+        ULONG ms = session->flush_timer ? session->flush_timer * 1000 : 1000;
+        RtlCreateTimer( NULL, &session->timer, flush_timer_proc, ULongToPtr( session->logger_id ), ms, ms,
+                        WT_EXECUTEDEFAULT );
+    }
+
+    *handle = session->handle;
+    props->Wnode.HistoricalContext = session->handle;
+    props->Wnode.ClientContext = session->clock;
+    props->LogFileMode = session->mode;
+    props->BufferSize = session->buffer_size;
+    props->MinimumBuffers = session->min_buffers;
+    props->MaximumBuffers = session->max_buffers;
+    props->LoggerNameOffset = name_off;
+    memcpy( (BYTE *)props + name_off, name, name_size );
+    TRACE_(eventlog)( "started %s, handle %s, mode %#lx\n", debugstr_w(session->name),
+                      wine_dbgstr_longlong(*handle), session->mode );
+    return ERROR_SUCCESS;
+}
+
+/* Stop a session: the providers it enabled are told, its last buffer and its log file's header are written, and its
+ * real-time consumers end once they have read what it flushed.  The lock is held exclusively. */
+static void stop_session( struct etw_session *session, struct list *notifications )
+{
+    struct etw_consumer *consumer, *next_consumer;
+    struct etw_enable *enable, *next;
+
+    LIST_FOR_EACH_ENTRY_SAFE( enable, next, &session->enables, struct etw_enable, entry )
+    {
+        collect_notifications( notifications, session, &enable->provider, EVENT_CONTROL_CODE_DISABLE_PROVIDER,
+                               0, 0, 0, TRUE );
+        list_remove( &enable->entry );
+        RtlFreeHeap( GetProcessHeap(), 0, enable );
+    }
+    if (session->timer)
+    {
+        RtlDeleteTimer( NULL, session->timer, NULL );
+        session->timer = 0;
+    }
+    flush_session( session );
+    if (session->file)
+    {
+        write_header_buffer( session, TRUE );
+        NtClose( session->file );
+        session->file = 0;
+    }
+    LIST_FOR_EACH_ENTRY_SAFE( consumer, next_consumer, &session->consumers, struct etw_consumer, session_entry )
+    {
+        consumer->ended = TRUE;
+        detach_consumer( consumer );
+    }
+    RtlWakeAllConditionVariable( &etw_cv );
+    list_remove( &session->entry );
+    etw_logger_ids &= ~((ULONG64)1 << (session->logger_id - 1));
+}
+
+/******************************************************************************
+ *                  __wine_etw_control_trace (NTDLL.@)
+ *
+ * ControlTrace() of a session of the process.
+ */
+ULONG CDECL __wine_etw_control_trace( TRACEHANDLE handle, const void *name, EVENT_TRACE_PROPERTIES *props,
+                                      ULONG control, BOOL ansi )
+{
+    struct list notifications = LIST_INIT( notifications );
+    struct etw_session *session;
+    WCHAR *nameW = NULL;
+    ULONG ret = ERROR_SUCCESS;
+    BOOL now = FALSE;
+
+    TRACE_(eventlog)( "%s %s %p %lu\n", wine_dbgstr_longlong(handle),
+                      ansi ? debugstr_a(name) : debugstr_w(name), props, control );
+
+    if (!props) return ERROR_INVALID_PARAMETER;
+    if (props->Wnode.BufferSize < sizeof(*props)) return ERROR_BAD_LENGTH;
+    if (!handle)
+    {
+        if (!name) return ERROR_INVALID_PARAMETER;
+        if (!(nameW = dup_string( name, ansi ))) return ERROR_NOT_ENOUGH_MEMORY;
+    }
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    /* a private session is the process's own: its name alone does not find it, the properties a query of it filled
+     * have to come with it, its GUID and its handle */
+    if (!(session = find_session( handle, nameW )) ||
+        (!handle && is_private( session ) && (!IsEqualGUID( &props->Wnode.Guid, &session->guid ) ||
+                                               props->Wnode.HistoricalContext != session->handle)))
+    {
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        RtlFreeHeap( GetProcessHeap(), 0, nameW );
+        return ERROR_WMI_INSTANCE_NOT_FOUND;
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, nameW );
+
+    switch (control)
+    {
+    case EVENT_TRACE_CONTROL_QUERY:
+        ret = fill_props( session, props, ansi );
+        break;
+
+    case EVENT_TRACE_CONTROL_UPDATE:
+        if (props->FlushTimer && is_private( session ))
+        {
+            ret = ERROR_INVALID_PARAMETER;
+            break;
+        }
+        if (props->FlushTimer && props->FlushTimer != session->flush_timer)
+        {
+            ULONG ms = props->FlushTimer * 1000;
+
+            session->flush_timer = props->FlushTimer;
+            if (session->timer) RtlUpdateTimer( NULL, session->timer, ms, ms );
+            else RtlCreateTimer( NULL, &session->timer, flush_timer_proc, ULongToPtr( session->logger_id ), ms, ms,
+                                 WT_EXECUTEDEFAULT );
+        }
+        if (props->EnableFlags) session->enable_flags = props->EnableFlags;
+        if (props->MaximumBuffers > session->max_buffers) session->max_buffers = props->MaximumBuffers;
+        ret = fill_props( session, props, ansi );
+        break;
+
+    case EVENT_TRACE_CONTROL_FLUSH:
+        /* buffers kept in memory have nowhere to go */
+        if (!session->file && !(session->mode & EVENT_TRACE_REAL_TIME_MODE))
+        {
+            ret = ERROR_FILE_NOT_FOUND;
+            break;
+        }
+        flush_session( session );
+        ret = fill_props( session, props, ansi );
+        break;
+
+    case EVENT_TRACE_CONTROL_STOP:
+        now = is_private( session );
+        stop_session( session, &notifications );
+        fill_props( session, props, ansi );
+        free_session( session );
+        break;
+
+    default:
+        ret = ERROR_INVALID_PARAMETER;
+        break;
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    send_notifications( &notifications, now, 0 );
+    return ret;
+}
+
+/******************************************************************************
+ *                  __wine_etw_enable_trace (NTDLL.@)
+ *
+ * EnableTraceEx2() for a session of the process.
+ */
+ULONG CDECL __wine_etw_enable_trace( TRACEHANDLE handle, const GUID *provider, ULONG control, UCHAR level,
+                                     ULONGLONG any, ULONGLONG all, ULONG timeout, ENABLE_TRACE_PARAMETERS *params )
+{
+    struct list notifications = LIST_INIT( notifications );
+    struct etw_session *session;
+    struct etw_enable *enable;
+    BOOL now;
+
+    TRACE_(eventlog)( "%s %s %lu %u %s %s %lu %p\n", wine_dbgstr_longlong(handle), debugstr_guid(provider), control,
+                      level, wine_dbgstr_longlong(any), wine_dbgstr_longlong(all), timeout, params );
+
+    if (!provider || control > EVENT_CONTROL_CODE_CAPTURE_STATE) return ERROR_INVALID_PARAMETER;
+    if (params && params->Version != ENABLE_TRACE_PARAMETERS_VERSION &&
+        params->Version != ENABLE_TRACE_PARAMETERS_VERSION_2)
+        return ERROR_INVALID_PARAMETER;
+    /* level 0 is every level, keywords 0 any keyword */
+    if (!level) level = 255;
+    if (!any) any = ~(ULONGLONG)0;
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if (!handle || !(session = find_session( handle, NULL )))
+    {
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        return ERROR_INVALID_PARAMETER;
+    }
+    now = is_private( session );
+    LIST_FOR_EACH_ENTRY( enable, &session->enables, struct etw_enable, entry )
+        if (IsEqualGUID( &enable->provider, provider )) break;
+    if (&enable->entry == &session->enables) enable = NULL;
+
+    switch (control)
+    {
+    case EVENT_CONTROL_CODE_ENABLE_PROVIDER:
+        if (!enable)
+        {
+            if (!(enable = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*enable) )))
+            {
+                RtlReleaseSRWLockExclusive( &etw_lock );
+                return ERROR_NOT_ENOUGH_MEMORY;
+            }
+            enable->provider = *provider;
+            list_add_tail( &session->enables, &enable->entry );
+        }
+        enable->level = level;
+        enable->any = any;
+        enable->all = all;
+        collect_notifications( &notifications, session, provider, control, level, any, all, FALSE );
+        break;
+
+    case EVENT_CONTROL_CODE_DISABLE_PROVIDER:
+        /* what it does not enable, it has nothing to tell of */
+        if (enable)
+        {
+            list_remove( &enable->entry );
+            RtlFreeHeap( GetProcessHeap(), 0, enable );
+            collect_notifications( &notifications, session, provider, control, 0, 0, 0, FALSE );
+        }
+        break;
+
+    case EVENT_CONTROL_CODE_CAPTURE_STATE:
+        collect_notifications( &notifications, session, provider, control, level, any, all, FALSE );
+        break;
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    return send_notifications( &notifications, now, timeout );
+}
+
+/******************************************************************************
+ *                  __wine_etw_query_all_traces (NTDLL.@)
+ */
+ULONG CDECL __wine_etw_query_all_traces( EVENT_TRACE_PROPERTIES **props, ULONG count, ULONG *ret_count, BOOL ansi )
+{
+    struct etw_session *session;
+    ULONG i = 0;
+
+    if (!props || !count || !ret_count) return ERROR_INVALID_PARAMETER;
+
+    RtlAcquireSRWLockShared( &etw_lock );
+    LIST_FOR_EACH_ENTRY( session, &etw_sessions, struct etw_session, entry )
+    {
+        if (i < count && props[i] && props[i]->Wnode.BufferSize >= sizeof(*props[i]))
+            fill_props( session, props[i], ansi );
+        i++;
+    }
+    RtlReleaseSRWLockShared( &etw_lock );
+    *ret_count = i;
+    return i > count ? ERROR_MORE_DATA : ERROR_SUCCESS;
+}
+
+/* a log file to read: its header buffer, which says what the session was */
+static ULONG open_log_file( struct etw_consumer *consumer, const void *name, BOOL ansi )
+{
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING nt_name;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+    ULONG size, read;
+    BYTE head[ETW_BUFFER_HEADER_SIZE];
+    WCHAR *file;
+
+    if (!(file = dup_string( name, ansi ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if (!RtlDosPathNameToNtPathName_U( file, &nt_name, NULL, NULL )) status = STATUS_OBJECT_PATH_INVALID;
+    else
+    {
+        InitializeObjectAttributes( &attr, &nt_name, OBJ_CASE_INSENSITIVE, 0, NULL );
+        status = NtCreateFile( &consumer->file, GENERIC_READ | SYNCHRONIZE, &attr, &io, NULL, 0,
+                               FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, FILE_OPEN,
+                               FILE_SYNCHRONOUS_IO_NONALERT | FILE_NON_DIRECTORY_FILE, NULL, 0 );
+        RtlFreeUnicodeString( &nt_name );
+    }
+    RtlFreeHeap( GetProcessHeap(), 0, file );
+    if (status) return RtlNtStatusToDosError( status );
+
+    if (read_file( consumer->file, 0, head, sizeof(head), &read ) || read < sizeof(head)) return ERROR_BAD_FORMAT;
+    size = *(const ULONG *)head;
+    if (size < ETW_BUFFER_HEADER_SIZE + ETW_SYSTEM_HEADER_SIZE + sizeof(struct logfile_header) ||
+        size > 0x1000000 || *(const USHORT *)(head + 0x36) != 4)
+        return ERROR_BAD_FORMAT;
+    if (!(consumer->header = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return ERROR_NOT_ENOUGH_MEMORY;
+    if (read_file( consumer->file, 0, consumer->header, size, &read ) || read < size) return ERROR_BAD_FORMAT;
+    if (consumer->header[ETW_BUFFER_HEADER_SIZE + 2] != ETW_HEADER_SYSTEM &&
+        consumer->header[ETW_BUFFER_HEADER_SIZE + 2] != 0x01)
+        return ERROR_BAD_FORMAT;
+    consumer->file_start = *(const LONGLONG *)(consumer->header + ETW_BUFFER_HEADER_SIZE + 16);
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ *                  __wine_etw_open_trace (NTDLL.@)
+ *
+ * OpenTrace() of a real-time session of the process, whether it is there being found out when it is read, or of a
+ * log file, which is read then.
+ */
+TRACEHANDLE CDECL __wine_etw_open_trace( EVENT_TRACE_LOGFILEW *logfile, BOOL ansi )
+{
+    struct etw_consumer *consumer;
+    struct etw_session *session;
+    struct logfile_header header;
+    TRACEHANDLE ret;
+    ULONG error;
+
+    if (!logfile)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return INVALID_PROCESSTRACE_HANDLE;
+    }
+    TRACE_(eventlog)( "%s %s %#lx\n", ansi ? debugstr_a((char *)logfile->LogFileName) : debugstr_w(logfile->LogFileName),
+                      ansi ? debugstr_a((char *)logfile->LoggerName) : debugstr_w(logfile->LoggerName),
+                      logfile->ProcessTraceMode );
+
+    if (!(consumer = RtlAllocateHeap( GetProcessHeap(), HEAP_ZERO_MEMORY, sizeof(*consumer) )))
+    {
+        RtlSetLastWin32Error( ERROR_NOT_ENOUGH_MEMORY );
+        return INVALID_PROCESSTRACE_HANDLE;
+    }
+    consumer->logfile = logfile;
+    consumer->mode = logfile->ProcessTraceMode;
+    list_init( &consumer->batches );
+
+    if (!(consumer->mode & PROCESS_TRACE_MODE_REAL_TIME))
+    {
+        if (!logfile->LogFileName) error = ERROR_INVALID_PARAMETER;
+        else error = open_log_file( consumer, logfile->LogFileName, ansi );
+        if (error)
+        {
+            free_consumer( consumer );
+            RtlSetLastWin32Error( error );
+            return INVALID_PROCESSTRACE_HANDLE;
+        }
+        /* what the log file says of its session, the mode too */
+        to_native_header( consumer_header( consumer ), &logfile->LogfileHeader );
+        logfile->LogFileMode = consumer_header( consumer )->LogFileMode;
+    }
+    else if (!logfile->LoggerName || !(consumer->name = dup_string( logfile->LoggerName, ansi )))
+    {
+        free_consumer( consumer );
+        RtlSetLastWin32Error( logfile->LoggerName ? ERROR_NOT_ENOUGH_MEMORY : ERROR_INVALID_PARAMETER );
+        return INVALID_PROCESSTRACE_HANDLE;
+    }
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    ret = consumer->handle = etw_next_consumer++;
+    list_add_tail( &etw_consumers, &consumer->entry );
+    if (consumer->name)
+    {
+        memset( &logfile->LogfileHeader, 0, sizeof(logfile->LogfileHeader) );
+        if ((session = find_session( 0, consumer->name )) && (session->mode & EVENT_TRACE_REAL_TIME_MODE))
+        {
+            attach_consumer( consumer, session );
+            fill_logfile_header( session, &header, FALSE );
+            to_native_header( &header, &logfile->LogfileHeader );
+        }
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    RtlSetLastWin32Error( ERROR_SUCCESS );
+    return ret;
+}
+
+/******************************************************************************
+ *                  __wine_etw_process_trace (NTDLL.@)
+ *
+ * ProcessTrace() of log files, and of real-time sessions of the process: their events go to the callbacks a buffer
+ * at a time, until the files end, the sessions stop or the consumers are closed.
+ */
+ULONG CDECL __wine_etw_process_trace( TRACEHANDLE *handles, ULONG count, FILETIME *start, FILETIME *end )
+{
+    struct etw_consumer *consumers[ETW_MAX_LOGGERS], *consumer;
+    struct etw_session *session;
+    struct record_source src;
+    struct etw_batch *batch;
+    struct etw_event *event;
+    ULONG i, ret = ERROR_SUCCESS;
+
+    if (!handles) return ERROR_INVALID_PARAMETER;
+    if (!count) return ERROR_BAD_LENGTH;
+    if (count > ETW_MAX_LOGGERS) return ERROR_INVALID_PARAMETER;
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    for (i = 0; i < count; i++)
+    {
+        if (!(consumers[i] = find_consumer( handles[i] )) || consumers[i]->busy)
+        {
+            RtlReleaseSRWLockExclusive( &etw_lock );
+            return ERROR_INVALID_HANDLE;
+        }
+    }
+    for (i = 0; i < count; i++)
+    {
+        consumer = consumers[i];
+        if (consumer->file || consumer->session || consumer->ended) continue;
+        if (!(session = find_session( 0, consumer->name )) || !(session->mode & EVENT_TRACE_REAL_TIME_MODE))
+        {
+            RtlReleaseSRWLockExclusive( &etw_lock );
+            return ERROR_WMI_INSTANCE_NOT_FOUND;
+        }
+        attach_consumer( consumer, session );
+    }
+    for (i = 0; i < count; i++) consumers[i]->busy = TRUE;
+
+    /* the log files first, one after another */
+    for (i = 0; i < count; i++)
+    {
+        if (!consumers[i]->file) continue;
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        ret = process_file( consumers[i], start, end );
+        RtlAcquireSRWLockExclusive( &etw_lock );
+        consumers[i]->ended = TRUE;
+        if (ret) break;
+    }
+
+    while (!ret)
+    {
+        BOOL done = TRUE, stop = FALSE;
+
+        batch = NULL;
+        for (i = 0; i < count && !batch; i++)
+        {
+            consumer = consumers[i];
+            if (consumer->closed) continue;
+            if (!list_empty( &consumer->batches ))
+            {
+                batch = LIST_ENTRY( list_head( &consumer->batches ), struct etw_batch, entry );
+                list_remove( &batch->entry );
+            }
+            else if (!consumer->ended) done = FALSE;
+        }
+        if (batch)
+        {
+            EVENT_TRACE_LOGFILEW *logfile = consumer->logfile;
+
+            RtlReleaseSRWLockExclusive( &etw_lock );
+            memset( &src, 0, sizeof(src) );
+            src.consumer = consumer;
+            src.start = start;
+            src.end = end;
+            LIST_FOR_EACH_ENTRY( event, &batch->events, struct etw_event, entry )
+            {
+                src.processor = event->processor;
+                src.logger_id = event->logger_id;
+                src.system_time = event->system_time;
+                deliver_record( event->record, event->size, &src );
+            }
+            if (logfile->BufferCallback && !logfile->BufferCallback( logfile )) stop = TRUE;
+            free_events( &batch->events );
+            RtlFreeHeap( GetProcessHeap(), 0, batch );
+            RtlAcquireSRWLockExclusive( &etw_lock );
+            if (stop) break;
+            continue;
+        }
+        if (done) break;
+        RtlSleepConditionVariableSRW( &etw_cv, &etw_lock, NULL, 0 );
+    }
+
+    for (i = 0; i < count; i++)
+    {
+        consumers[i]->busy = FALSE;
+        if (consumers[i]->closed)
+        {
+            list_remove( &consumers[i]->entry );
+            detach_consumer( consumers[i] );
+            free_consumer( consumers[i] );
+        }
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    return ret;
+}
+
+/******************************************************************************
+ *                  __wine_etw_close_trace (NTDLL.@)
+ */
+ULONG CDECL __wine_etw_close_trace( TRACEHANDLE handle )
+{
+    struct etw_consumer *consumer;
+
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if (!(consumer = find_consumer( handle )))
+    {
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        return ERROR_INVALID_HANDLE;
+    }
+    if (consumer->busy)
+    {
+        /* ProcessTrace() is reading it: it returns after the buffer it is at, and frees it */
+        consumer->closed = TRUE;
+        RtlWakeAllConditionVariable( &etw_cv );
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        return ERROR_CTX_CLOSE_PENDING;
+    }
+    list_remove( &consumer->entry );
+    detach_consumer( consumer );
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    free_consumer( consumer );
+    return ERROR_SUCCESS;
+}
+
+/* The process exits: what its sessions hold goes to their log files.  Other threads are gone by now, one of them
+ * perhaps holding the lock; nothing is told to anyone. */
+void etw_process_detach(void)
+{
+    struct etw_session *session;
+
+    if (!RtlTryAcquireSRWLockExclusive( &etw_lock )) return;
+    LIST_FOR_EACH_ENTRY( session, &etw_sessions, struct etw_session, entry )
+    {
+        if (!session->file) continue;
+        flush_session( session );
+        write_header_buffer( session, TRUE );
+        NtClose( session->file );
+        session->file = 0;
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+}
+
+/******************************************************************************
+ * Activity IDs
+ *
+ * A thread's is in its TEB.  Those ETW makes are not GUIDs of any version: their first six bytes are those of a time
+ * the system took at boot, the next two the processor the thread runs on, and the last eight a count of its own that
+ * goes up by one each time, from a time too.  A process keeps the count here.
+ */
+
+static void create_activity_id( GUID *guid )
+{
+    static LONG64 counter;
+    SYSTEM_TIMEOFDAY_INFORMATION tod;
+    LONG64 n;
+
+    if (!counter)
+    {
+        LARGE_INTEGER now;
+
+        NtQuerySystemTime( &now );
+        InterlockedCompareExchange64( &counter, now.QuadPart, 0 );
+    }
+    n = InterlockedIncrement64( &counter );
+    NtQuerySystemInformation( SystemTimeOfDayInformation, &tod, sizeof(tod), NULL );
+    guid->Data1 = tod.BootTime.LowPart;
+    guid->Data2 = tod.BootTime.HighPart;
+    guid->Data3 = NtGetCurrentProcessorNumber();
+    memcpy( guid->Data4, &n, sizeof(n) );
+}
+
+/******************************************************************************
+ *                  EtwEventActivityIdControl (NTDLL.@)
+ */
+ULONG WINAPI EtwEventActivityIdControl( ULONG code, GUID *guid )
+{
+    GUID *current = &NtCurrentTeb()->ActivityId, old;
+
+    TRACE( "%lu, %p\n", code, guid );
+
+    if (!guid) return ERROR_INVALID_PARAMETER;
+    switch (code)
+    {
+    case EVENT_ACTIVITY_CTRL_GET_ID:
+        *guid = *current;
+        return ERROR_SUCCESS;
+    case EVENT_ACTIVITY_CTRL_SET_ID:
+        *current = *guid;
+        return ERROR_SUCCESS;
+    case EVENT_ACTIVITY_CTRL_CREATE_ID:
+        create_activity_id( guid );
+        return ERROR_SUCCESS;
+    case EVENT_ACTIVITY_CTRL_GET_SET_ID:
+        old = *current;
+        *current = *guid;
+        *guid = old;
+        return ERROR_SUCCESS;
+    case EVENT_ACTIVITY_CTRL_CREATE_SET_ID:
+        old = *current;
+        create_activity_id( current );
+        *guid = old;
+        return ERROR_SUCCESS;
+    default:
+        return ERROR_INVALID_PARAMETER;
+    }
+}
+
+/******************************************************************************
+ *                  EtwEventProviderEnabled (NTDLL.@)
+ */
+BOOLEAN WINAPI EtwEventProviderEnabled( REGHANDLE handle, UCHAR level, ULONGLONG keyword )
+{
+    struct etw_registration *reg;
+    BOOLEAN ret = FALSE;
+
+    TRACE( "%s, %u, %s\n", wine_dbgstr_longlong(handle), level, wine_dbgstr_longlong(keyword) );
+
+    if (TRACE_ON(tracelog)) return TRUE;
+    RtlAcquireSRWLockShared( &etw_lock );
+    if ((reg = find_registration( handle, FALSE ))) ret = registration_takes( reg, level, keyword );
+    RtlReleaseSRWLockShared( &etw_lock );
+    return ret;
+}
+
+/******************************************************************************
+ *                  EtwEventEnabled (NTDLL.@)
+ */
+BOOLEAN WINAPI EtwEventEnabled( REGHANDLE handle, const EVENT_DESCRIPTOR *descriptor )
+{
+    TRACE( "(%s, %p)\n", wine_dbgstr_longlong(handle), descriptor );
+
+    if (!descriptor) return FALSE;
+    return EtwEventProviderEnabled( handle, descriptor->Level, descriptor->Keyword );
+}
+
+/******************************************************************************
+ *                  EtwEventRegister (NTDLL.@)
+ */
+ULONG WINAPI EtwEventRegister( LPCGUID provider, PENABLECALLBACK callback, PVOID context, PREGHANDLE handle )
+{
+    struct etw_registration *reg;
+
+    TRACE( "(%s, %p, %p, %p)\n", debugstr_guid(provider), callback, context, handle );
+
+    if (!provider || !handle) return ERROR_INVALID_PARAMETER;
+    if (!(reg = add_registration( provider, FALSE, callback, NULL, context ))) return ERROR_NOT_ENOUGH_MEMORY;
+    *handle = reg->handle;
+
+    /*
+     * A TraceLogging provider does not test anything per event: it keeps a flag that this callback sets, and skips
+     * the call to EventWriteTransfer entirely while the flag is clear.  With +tracelog, every provider is enabled
+     * for it as it registers, and what it writes is printed.
+     */
+    if (TRACE_ON(tracelog) && callback)
+    {
+        TRACE_(tracelog)( "enabling provider %s\n", debugstr_guid(provider) );
+        callback( provider, EVENT_CONTROL_CODE_ENABLE_PROVIDER, TRACE_LEVEL_VERBOSE, ~(ULONGLONG)0, ~(ULONGLONG)0,
+                  NULL, context );
+    }
+    notify_registration( reg );
+    return ERROR_SUCCESS;
+}
+
+/******************************************************************************
+ *                  EtwEventUnregister (NTDLL.@)
+ */
+ULONG WINAPI EtwEventUnregister( REGHANDLE handle )
+{
+    TRACE( "(%s)\n", wine_dbgstr_longlong(handle) );
+    return remove_registration( handle, FALSE );
+}
+
+/*********************************************************************
+ *                  EtwEventSetInformation   (NTDLL.@)
+ */
+ULONG WINAPI EtwEventSetInformation( REGHANDLE handle, EVENT_INFO_CLASS class, void *info, ULONG length )
+{
+    struct etw_registration *reg;
+
+    TRACE( "(%s, %u, %p, %lu)\n", wine_dbgstr_longlong(handle), class, info, length );
+
+    RtlAcquireSRWLockShared( &etw_lock );
+    reg = find_registration( handle, FALSE );
+    RtlReleaseSRWLockShared( &etw_lock );
+    if (!reg) return ERROR_INVALID_HANDLE;
+
+    switch (class)
+    {
+    case EventProviderBinaryTrackInfo:
+        /* the binary is in the trace only for a session to see */
+        return length ? ERROR_INVALID_PARAMETER : ERROR_SUCCESS;
+    case EventProviderSetTraits:
+        return set_provider_traits( handle, info, length );
+    case EventProviderUseDescriptorType:
+        return length == sizeof(BOOLEAN) && info ? ERROR_SUCCESS : ERROR_INVALID_PARAMETER;
+    case EventProviderSetReserved1:
+        return ERROR_NOT_SUPPORTED;
+    case MaxEventInfo:
+        return ERROR_INVALID_PARAMETER;
+    default:
+        return ERROR_NOT_SUPPORTED;
+    }
+}
