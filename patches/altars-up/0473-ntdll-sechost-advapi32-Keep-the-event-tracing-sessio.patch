-/******************************************************************************
- *                  EtwEventRegister (NTDLL.@)
- */
-ULONG WINAPI EtwEventRegister( LPCGUID provider, PENABLECALLBACK callback, PVOID context,
-                PREGHANDLE handle )
-{
-    TRACE( "(%s, %p, %p, %p)\n", debugstr_guid(provider), callback, context, handle );
-
-    if (!provider || !handle) return ERROR_INVALID_PARAMETER;
-    if (!(*handle = add_etw_registration( provider, FALSE ))) return ERROR_NOT_ENOUGH_MEMORY;
-
-    /*
-     * A TraceLogging provider does not test anything per event: it keeps a flag
-     * that this callback sets, and skips the call to EventWriteTransfer
-     * entirely while the flag is clear. Reporting the provider as enabled
-     * afterwards is therefore too late -- without this, nothing is ever
-     * written and the decoder never sees an event.
-     */
-    if (TRACE_ON(tracelog) && callback)
-    {
-        TRACE_(tracelog)( "enabling provider %s\n", debugstr_guid(provider) );
-        callback( provider, 1 /* EVENT_CONTROL_CODE_ENABLE_PROVIDER */, TRACE_LEVEL_VERBOSE,
-                  ~(ULONGLONG)0, ~(ULONGLONG)0, NULL, context );
-    }
-    return ERROR_SUCCESS;
