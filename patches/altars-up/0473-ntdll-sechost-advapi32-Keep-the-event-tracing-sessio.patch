+/******************************************************************************
+ *                  EtwLogTraceEvent (NTDLL.@)
+ *
+ * TraceEvent(): a classic provider's event, its header and the data after it or that its MOF fields point to.
+ */
+ULONG WINAPI EtwLogTraceEvent( TRACEHANDLE SessionHandle, PEVENT_TRACE_HEADER EventTrace )
+{
+    struct etw_session *session;
+    EVENT_TRACE_HEADER *header;
+    const MOF_FIELD *mof = NULL;
+    ULONG size, data_size, count = 0, i, ret;
+    LARGE_INTEGER now;
+    BYTE *record, *pos;
+
+    TRACE( "%s %p\n", wine_dbgstr_longlong(SessionHandle), EventTrace );
+
+    if (!EventTrace || EventTrace->Size < sizeof(*EventTrace)) return ERROR_INVALID_PARAMETER;
+    data_size = EventTrace->Size - sizeof(*EventTrace);
+    if (EventTrace->Flags & WNODE_FLAG_USE_MOF_PTR)
+    {
+        mof = (const MOF_FIELD *)(EventTrace + 1);
+        count = data_size / sizeof(*mof);
+        for (i = 0, data_size = 0; i < count; i++) data_size += mof[i].Length;
+    }
+    size = sizeof(*EventTrace) + data_size;
+    if (size > 0xffff) return ERROR_MORE_DATA;
+    if (!(record = RtlAllocateHeap( GetProcessHeap(), 0, size ))) return ERROR_NOT_ENOUGH_MEMORY;
+
+    header = (EVENT_TRACE_HEADER *)record;
+    *header = *EventTrace;
+    header->Size = size;
+    header->HeaderType = ETW_HEADER_CLASSIC;
+    header->MarkerFlags = ETW_HEADER_FLAGS;
+    header->ThreadId = current_tid();
+    header->ProcessId = current_pid();
+    if (EventTrace->Flags & WNODE_FLAG_USE_GUID_PTR) header->Guid = *(const GUID *)(ULONG_PTR)EventTrace->GuidPtr;
+    pos = record + sizeof(*header);
+    if (mof)
+    {
+        for (i = 0; i < count; i++)
+        {
+            memcpy( pos, (const void *)(ULONG_PTR)mof[i].DataPtr, mof[i].Length );
+            pos += mof[i].Length;
+        }
+    }
+    else memcpy( pos, EventTrace + 1, data_size );
+
+    NtQuerySystemTime( &now );
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if (!(session = find_logger_handle( SessionHandle ))) ret = ERROR_INVALID_HANDLE;
+    else
+    {
+        stamp_record( session, record, offsetof( EVENT_TRACE_HEADER, TimeStamp ),
+                      offsetof( EVENT_TRACE_HEADER, ProcessorTime ), now );
+        ret = session_add( session, record, size, now );
+    }
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    RtlFreeHeap( GetProcessHeap(), 0, record );
+    return ret;
+}
+
+/******************************************************************************
+ *                  EtwTraceMessageVa (NTDLL.@)
+ *
+ * TraceMessage(): a message header, the fields asked for -- a sequence number where the session keeps one, a
+ * component ID or a GUID, a time stamp, the thread and process -- then the arguments, pairs of a pointer and a
+ * size up to a NULL one.
+ */
+ULONG WINAPI EtwTraceMessageVa( TRACEHANDLE handle, ULONG flags, LPGUID guid, USHORT number, va_list args )
+{
+    struct etw_session *session;
+    ULONG size = 8, data_size = 0, ret;
+    USHORT stored;
+    LARGE_INTEGER now;
+    va_list copy;
+    BYTE *record, *pos;
+    void *ptr;
+
+    TRACE( "(%s %lx %s %d)\n", wine_dbgstr_longlong(handle), flags, debugstr_guid(guid), number );
+
+    if ((flags & (TRACE_MESSAGE_GUID | TRACE_MESSAGE_COMPONENTID)) && !guid) return ERROR_INVALID_PARAMETER;
+    va_copy( copy, args );
+    while ((ptr = va_arg( copy, void * ))) data_size += va_arg( copy, SIZE_T );
+    va_end( copy );
+
+    stored = (flags & TRACE_MESSAGE_FLAG_MASK & ~(TRACE_MESSAGE_POINTER32 | TRACE_MESSAGE_POINTER64)) |
+             (sizeof(void *) == 8 ? TRACE_MESSAGE_POINTER64 : TRACE_MESSAGE_POINTER32);
+
+    NtQuerySystemTime( &now );
+    RtlAcquireSRWLockExclusive( &etw_lock );
+    if (!(session = find_logger_handle( handle )))
+    {
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        return ERROR_INVALID_HANDLE;
+    }
+    if (!(session->mode & (EVENT_TRACE_USE_GLOBAL_SEQUENCE | EVENT_TRACE_USE_LOCAL_SEQUENCE)))
+        stored &= ~TRACE_MESSAGE_SEQUENCE;
+    if (stored & TRACE_MESSAGE_SEQUENCE) size += 4;
+    if (stored & TRACE_MESSAGE_COMPONENTID) size += 4;
+    else if (stored & TRACE_MESSAGE_GUID) size += sizeof(GUID);
+    if (stored & (TRACE_MESSAGE_TIMESTAMP | TRACE_MESSAGE_PERFORMANCE_TIMESTAMP)) size += sizeof(LARGE_INTEGER);
+    if (stored & TRACE_MESSAGE_SYSTEMINFO) size += 8;
+    size += data_size;
+    if (size > TRACE_MESSAGE_MAXIMUM_SIZE || size > 0xffff)
+    {
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        return ERROR_INVALID_PARAMETER;
+    }
+    if (!(record = RtlAllocateHeap( GetProcessHeap(), 0, size )))
+    {
+        RtlReleaseSRWLockExclusive( &etw_lock );
+        return ERROR_NOT_ENOUGH_MEMORY;
+    }
+
+    *(USHORT *)record = size;
+    record[2] = 0;
+    record[3] = ETW_HEADER_MESSAGE;
+    *(USHORT *)(record + 4) = number;
+    *(USHORT *)(record + 6) = stored;
+    pos = record + 8;
+    if (stored & TRACE_MESSAGE_SEQUENCE)
+    {
+        *(ULONG *)pos = ++session->message_sequence;
+        pos += 4;
+    }
+    if (stored & TRACE_MESSAGE_COMPONENTID)
+    {
+        *(ULONG *)pos = *(const ULONG *)guid;
+        pos += 4;
+    }
+    else if (stored & TRACE_MESSAGE_GUID)
+    {
+        memcpy( pos, guid, sizeof(GUID) );
+        pos += sizeof(GUID);
+    }
+    if (stored & (TRACE_MESSAGE_TIMESTAMP | TRACE_MESSAGE_PERFORMANCE_TIMESTAMP))
+    {
+        LARGE_INTEGER counter;
+
+        if (stored & TRACE_MESSAGE_PERFORMANCE_TIMESTAMP) NtQueryPerformanceCounter( &counter, NULL );
+        else counter.QuadPart = session_time( session, now );
+        memcpy( pos, &counter, sizeof(counter) );
+        pos += sizeof(counter);
+    }
+    if (stored & TRACE_MESSAGE_SYSTEMINFO)
+    {
+        *(ULONG *)pos = current_tid();
+        *(ULONG *)(pos + 4) = current_pid();
+        pos += 8;
+    }
+    va_copy( copy, args );
+    while ((ptr = va_arg( copy, void * )))
+    {
+        SIZE_T len = va_arg( copy, SIZE_T );
+        memcpy( pos, ptr, len );
+        pos += len;
+    }
+    va_end( copy );
+
+    ret = session_add( session, record, size, now );
+    RtlReleaseSRWLockExclusive( &etw_lock );
+    RtlFreeHeap( GetProcessHeap(), 0, record );
+    return ret;
+}
+
+/******************************************************************************
+ *                  EtwTraceMessage (NTDLL.@)
+ */
+ULONG WINAPIV EtwTraceMessage( TRACEHANDLE handle, ULONG flags, LPGUID guid, /*USHORT*/ ULONG number, ... )
+{
+    va_list valist;
+    ULONG ret;
+
+    va_start( valist, number );
+    ret = EtwTraceMessageVa( handle, flags, guid, number, valist );
+    va_end( valist );
+    return ret;
+}
