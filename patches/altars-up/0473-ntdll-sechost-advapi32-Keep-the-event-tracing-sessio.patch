+/* whether a classic provider's logger handle names a session there is: the lock is held */
+static struct etw_session *find_logger_handle( TRACEHANDLE handle )
+{
+    USHORT logger_id = handle & 0xffff;
+
+    if (!logger_id || logger_id > ETW_MAX_LOGGERS) return NULL;
+    return find_logger( logger_id );
+}
+
+/******************************************************************************
+ *                  EtwGetTraceEnableFlags (NTDLL.@)
+ *
+ * The logger handle a classic provider is given is TRACE_ENABLE_CONTEXT: the logger, the level and the flags.
+ */
+ULONG WINAPI EtwGetTraceEnableFlags( TRACEHANDLE handle )
+{
+    BOOL found;
+
+    TRACE("(%s)\n", wine_dbgstr_longlong(handle));
+
+    RtlAcquireSRWLockShared( &etw_lock );
+    found = !!find_logger_handle( handle );
+    RtlReleaseSRWLockShared( &etw_lock );
+    if (found) return handle >> 32;
+    RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    return 0;
+}
+
+/******************************************************************************
+ *                  EtwGetTraceEnableLevel (NTDLL.@)
+ */
+UCHAR WINAPI EtwGetTraceEnableLevel( TRACEHANDLE handle )
+{
+    BOOL found;
+
+    TRACE("(%s)\n", wine_dbgstr_longlong(handle));
+
+    RtlAcquireSRWLockShared( &etw_lock );
+    found = !!find_logger_handle( handle );
+    RtlReleaseSRWLockShared( &etw_lock );
+    if (found) return handle >> 16;
+    RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    return 0;
+}
+
+/******************************************************************************
+ *                  EtwGetTraceLoggerHandle (NTDLL.@)
+ */
+TRACEHANDLE WINAPI EtwGetTraceLoggerHandle( PVOID buf )
+{
+    const WNODE_HEADER *wnode = buf;
+    BOOL found;
+
+    TRACE("(%p)\n", buf);
+
+    if (!wnode)
+    {
+        RtlSetLastWin32Error( ERROR_INVALID_PARAMETER );
+        return INVALID_PROCESSTRACE_HANDLE;
+    }
+    RtlAcquireSRWLockShared( &etw_lock );
+    found = !!find_logger_handle( wnode->HistoricalContext );
+    RtlReleaseSRWLockShared( &etw_lock );
+    if (found) return wnode->HistoricalContext;
+    RtlSetLastWin32Error( ERROR_INVALID_HANDLE );
+    return INVALID_PROCESSTRACE_HANDLE;
+}
