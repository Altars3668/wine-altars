+/* a classic provider is given a logger handle that holds the logger, the level and the flags */
+static struct
+{
+    WMIDPREQUESTCODE code;
+    ULONG size;
+    WNODE_HEADER wnode;
+    TRACEHANDLE logger;
+    UCHAR level;
+    ULONG flags;
+} requests[8];
+static LONG request_count;
+
+static ULONG WINAPI request_callback( WMIDPREQUESTCODE code, void *context, ULONG *size, void *buffer )
+{
+    LONG i = request_count++;
+
+    if (i >= ARRAY_SIZE(requests)) return ERROR_SUCCESS;
+    requests[i].code = code;
+    requests[i].size = *size;
+    requests[i].wnode = *(WNODE_HEADER *)buffer;
+    if (code == WMI_ENABLE_EVENTS)
+    {
+        requests[i].logger = GetTraceLoggerHandle( buffer );
+        requests[i].level = GetTraceEnableLevel( requests[i].logger );
+        requests[i].flags = GetTraceEnableFlags( requests[i].logger );
+    }
+    return ERROR_SUCCESS;
+}
