-/* A provider's registration, by EventRegister() or RegisterTraceGuids().  No session here
- * enables a provider, so this is all there is of one: what it writes goes nowhere, as it
- * does on Windows when nothing listens. */
-struct etw_registration
-{
-    struct list entry;
-    ULONG64 handle;
-    GUID guid;
-    BOOL classic;
-    BOOL traits;    /* its traits are set, once and for all */
-};
-
-static struct list etw_registrations = LIST_INIT( etw_registrations );
-static RTL_SRWLOCK etw_lock = RTL_SRWLOCK_INIT;
-static ULONG64 etw_next_handle = 0x10000;
-
-static ULONG64 add_etw_registration( const GUID *guid, BOOL classic )
-{
-    struct etw_registration *reg;
-    ULONG64 handle;
-
-    if (!(reg = RtlAllocateHeap( GetProcessHeap(), 0, sizeof(*reg) ))) return 0;
-    reg->guid = *guid;
-    reg->classic = classic;
-    reg->traits = FALSE;
-    RtlAcquireSRWLockExclusive( &etw_lock );
-    handle = reg->handle = etw_next_handle += 0x10;
-    list_add_tail( &etw_registrations, &reg->entry );
-    RtlReleaseSRWLockExclusive( &etw_lock );
-    return handle;
-}
-
-static BOOL is_etw_registration( ULONG64 handle, BOOL classic )
-{
-    struct etw_registration *reg;
-    BOOL ret = FALSE;
-
-    RtlAcquireSRWLockShared( &etw_lock );
-    LIST_FOR_EACH_ENTRY( reg, &etw_registrations, struct etw_registration, entry )
-        if (reg->handle == handle && reg->classic == classic) ret = TRUE;
-    RtlReleaseSRWLockShared( &etw_lock );
-    return ret;
-}
-
-static ULONG remove_etw_registration( ULONG64 handle, BOOL classic )
-{
-    struct etw_registration *reg, *found = NULL;
-
-    RtlAcquireSRWLockExclusive( &etw_lock );
-    LIST_FOR_EACH_ENTRY( reg, &etw_registrations, struct etw_registration, entry )
-    {
-        if (reg->handle != handle || reg->classic != classic) continue;
-        list_remove( &reg->entry );
-        found = reg;
-        break;
-    }
-    RtlReleaseSRWLockExclusive( &etw_lock );
-    if (!found) return ERROR_INVALID_HANDLE;
-    RtlFreeHeap( GetProcessHeap(), 0, found );
-    return ERROR_SUCCESS;
-}
-
-/* a provider's traits: their size, the provider's name, and traits of a size, a type and data
- * each; only the layout is checked, and they are set once */
-static BOOL check_provider_traits( const BYTE *traits, ULONG length )
-{
-    ULONG pos, size;
-
-    if (*(const USHORT *)traits != length) return FALSE;
-    for (pos = 2; pos < length && traits[pos]; pos++);
-    if (pos++ == length) return FALSE;
-    while (pos < length)
-    {
-        if (length - pos < 2) return FALSE;
-        size = *(const USHORT *)(traits + pos);
-        if (size < 3 || size > length - pos) return FALSE;
-        pos += size;
-    }
-    return TRUE;
-}
-
-static ULONG set_provider_traits( ULONG64 handle, const BYTE *traits, ULONG length )
-{
-    struct etw_registration *reg;
-    ULONG ret = ERROR_INVALID_HANDLE;
-
-    if (!traits || length < 3) return ERROR_INVALID_PARAMETER;
-
-    RtlAcquireSRWLockExclusive( &etw_lock );
-    LIST_FOR_EACH_ENTRY( reg, &etw_registrations, struct etw_registration, entry )
-    {
-        if (reg->handle != handle || reg->classic) continue;
-        if (reg->traits) ret = ERROR_GEN_FAILURE;
-        else if (!check_provider_traits( traits, length )) ret = ERROR_FILE_CORRUPT;
-        else
-        {
-            reg->traits = TRUE;
-            ret = ERROR_SUCCESS;
-        }
-        break;
-    }
-    RtlReleaseSRWLockExclusive( &etw_lock );
-    return ret;
-}
