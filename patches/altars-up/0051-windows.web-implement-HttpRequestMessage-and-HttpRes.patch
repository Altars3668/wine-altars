diff --git a/dlls/windows.web/main.c b/dlls/windows.web/main.c
index 04ace4b1e8d..2d83aa7880a 100644
--- a/dlls/windows.web/main.c
+++ b/dlls/windows.web/main.c
@@ -50,6 +50,10 @@ HRESULT WINAPI DllGetActivationFactory( HSTRING classid, IActivationFactory **fa
         IActivationFactory_QueryInterface( http_client_factory, &IID_IActivationFactory, (void **)factory );
     if (!wcscmp( buffer, RuntimeClass_Windows_Web_Http_HttpMethod ))
         IActivationFactory_QueryInterface( http_method_factory, &IID_IActivationFactory, (void **)factory );
+    if (!wcscmp( buffer, RuntimeClass_Windows_Web_Http_HttpRequestMessage ))
+        IActivationFactory_QueryInterface( http_request_message_factory, &IID_IActivationFactory, (void **)factory );
+    if (!wcscmp( buffer, RuntimeClass_Windows_Web_Http_HttpResponseMessage ))
+        IActivationFactory_QueryInterface( http_response_message_factory, &IID_IActivationFactory, (void **)factory );
 
     if (*factory) return S_OK;
     return CLASS_E_CLASSNOTAVAILABLE;
