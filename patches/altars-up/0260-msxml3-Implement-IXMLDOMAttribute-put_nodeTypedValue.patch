From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 08:20:43 -0400
Subject: [PATCH] msxml3: Implement IXMLDOMAttribute::put_nodeTypedValue().

It was a FIXME returning E_NOTIMPL.  An attribute with no schema data
type has no typed value apart from its text, so this stores the value as
put_value() does, and reading it back gives the same text.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/msxml3/attribute.c b/dlls/msxml3/attribute.c
index 865c0207f18..8eda004d7e1 100644
--- a/dlls/msxml3/attribute.c
+++ b/dlls/msxml3/attribute.c
@@ -377,9 +377,11 @@ static HRESULT WINAPI domattr_get_nodeTypedValue(IXMLDOMAttribute *iface, VARIAN
 
 static HRESULT WINAPI domattr_put_nodeTypedValue(IXMLDOMAttribute *iface, VARIANT v)
 {
-    FIXME("%p, %s\n", iface, debugstr_variant(&v));
+    domattr *attr = impl_from_IXMLDOMAttribute(iface);
 
-    return E_NOTIMPL;
+    TRACE("%p, %s.\n", iface, debugstr_variant(&v));
+
+    return node_put_value(attr->node, &v);
 }
 
 static HRESULT WINAPI domattr_get_dataType(IXMLDOMAttribute *iface, VARIANT *v)
diff --git a/dlls/msxml3/tests/domdoc.c b/dlls/msxml3/tests/domdoc.c
index a1576e92d43..c4535a306f0 100644
--- a/dlls/msxml3/tests/domdoc.c
+++ b/dlls/msxml3/tests/domdoc.c
@@ -14806,6 +14806,45 @@ static void test_transformNodeToObject(void)
     free_bstrs();
 }
 
+static void test_attribute_put_nodeTypedValue(void)
+{
+    IXMLDOMDocument *doc;
+    IXMLDOMAttribute *attr;
+    IXMLDOMElement *element;
+    VARIANT value;
+    BSTR text;
+    HRESULT hr;
+
+    doc = create_document(&IID_IXMLDOMDocument);
+    hr = IXMLDOMDocument_createElement(doc, _bstr_("e"), &element);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMDocument_createAttribute(doc, _bstr_("a"), &attr);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMElement_setAttributeNode(element, attr, NULL);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    V_VT(&value) = VT_I4;
+    V_I4(&value) = 42;
+    hr = IXMLDOMAttribute_put_nodeTypedValue(attr, value);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    hr = IXMLDOMAttribute_get_text(attr, &text);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(!wcscmp(text, L"42"), "Unexpected text %s.\n", debugstr_w(text));
+    SysFreeString(text);
+
+    VariantInit(&value);
+    hr = IXMLDOMAttribute_get_nodeTypedValue(attr, &value);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+    ok(V_VT(&value) == VT_BSTR && !wcscmp(V_BSTR(&value), L"42"),
+            "Unexpected typed value %s.\n", debugstr_variant(&value));
+    VariantClear(&value);
+
+    IXMLDOMAttribute_Release(attr);
+    IXMLDOMElement_Release(element);
+    IXMLDOMDocument_Release(doc);
+    free_bstrs();
+}
+
 static void test_max_element_depth_values(void)
 {
     static const CLSID *classes[] = { &CLSID_DOMDocument, &CLSID_DOMDocument2, &CLSID_DOMDocument30 };
@@ -19500,6 +19539,7 @@ START_TEST(domdoc)
     test_selectSingleNode();
     test_events();
     test_put_nodeTypedValue();
+    test_attribute_put_nodeTypedValue();
     test_get_xml();
     test_insertBefore();
     test_appendChild();
