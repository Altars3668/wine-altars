 #include "process.h"
 #include "thread.h"
 #include "security.h"
@@ -913,6 +914,78 @@ void enum_handles_of_type( const struct object_ops *ops,
     enum_processes( enum_process_handles_cb, &info );
 }
 
+struct file_users_info
+{
+    struct fd     *fd;          /* the file asked about */
+    struct object *queried;     /* the object asked through, not counted */
+    unsigned int  *pids;
+    unsigned int   count;
+    unsigned int   max;         /* the size of pids */
+};
+
+/* whether a process has the file open, through a handle or a view of it */
+static int find_file_user( struct process *process, void *user )
+{
+    struct file_users_info *info = user;
+    struct handle_table *table = process->handles;
+    struct handle_entry *entry;
+    int i, used = 0;
+
+    for (i = 0, entry = table ? table->entries : NULL; table && !used && i <= table->last; i++, entry++)
+    {
+        struct fd *fd;
+
+        if (!entry->ptr || entry->ptr == info->queried) continue;
+        if (!(fd = get_obj_fd( entry->ptr )))
+        {
+            clear_error();
+            continue;
+        }
+        used = is_same_inode_fd( fd, info->fd );
+        release_object( fd );
+    }
+    if (!used) used = is_file_mapped( process, info->fd );
+    if (used)
+    {
+        if (info->pids && info->count < info->max) info->pids[info->count] = process->id;
+        info->count++;
+    }
+    return 0;
+}
+
+DECL_HANDLER(get_file_users)
+{
+    struct file_users_info info;
+    unsigned int max = get_reply_max_size() / sizeof(unsigned int);
+    struct object *obj;
+
+    if (!(obj = get_handle_obj( current->process, req->handle, 0, NULL ))) return;
+    if ((info.fd = get_obj_fd( obj )))
+    {
+        unsigned int total;
+
+        info.queried = obj;
+        info.pids = NULL;
+        info.count = 0;
+        enum_processes( find_file_user, &info );
+        total = info.count;
+        reply->total = total;
+        if (total && total <= max && (info.pids = mem_alloc( total * sizeof(unsigned int) )))
+        {
+            info.max = total;
+            info.count = 0;
+            enum_processes( find_file_user, &info );
+            /* nothing runs in between in the server, but keep to what was counted */
+            if (info.count > total) info.count = total;
+            set_reply_data( info.pids, info.count * sizeof(unsigned int) );
+            reply->total = info.count;
+            free( info.pids );
+        }
+        release_object( info.fd );
+    }
+    release_object( obj );
+}
+
 DECL_HANDLER(set_object_permanence)
 {
     const unsigned int access = req->permanent ? 0 : DELETE;
