+/* whether a process has a view of the file */
+int is_file_mapped( struct process *process, struct fd *fd )
+{
+    struct memory_view *view;
+
+    LIST_FOR_EACH_ENTRY( view, &process->views, struct memory_view, entry )
+        if (view->fd && is_same_inode_fd( view->fd, fd )) return 1;
+    return 0;
+}
