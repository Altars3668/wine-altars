diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index f204b0b7305..497dbb72d86 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -2519,6 +2519,38 @@ static unsigned int server_open_file_object( HANDLE *ret_handle, ACCESS_MASK acc
                                              ULONG sharing, ULONG options );
 
 
+/* The processes that have the file open, through a handle or a view, but for the file object asked through.  A
+ * buffer too small for all of them gets none, and the size it takes. */
+static NTSTATUS get_file_users( HANDLE handle, IO_STATUS_BLOCK *io, FILE_PROCESS_IDS_USING_FILE_INFORMATION *info,
+                                ULONG len )
+{
+    ULONG max = (len - offsetof( FILE_PROCESS_IDS_USING_FILE_INFORMATION, ProcessIdList )) / sizeof(ULONG_PTR);
+    unsigned int *pids, total = 0, i;
+    NTSTATUS status;
+
+    if (!(pids = malloc( (max + 1) * sizeof(*pids) ))) return STATUS_NO_MEMORY;
+    SERVER_START_REQ( get_file_users )
+    {
+        req->handle = wine_server_obj_handle( handle );
+        wine_server_set_reply( req, pids, max * sizeof(*pids) );
+        if (!(status = wine_server_call( req ))) total = reply->total;
+    }
+    SERVER_END_REQ;
+    if (!status)
+    {
+        io->Information = offsetof( FILE_PROCESS_IDS_USING_FILE_INFORMATION, ProcessIdList[total] );
+        if (total > max) status = STATUS_INFO_LENGTH_MISMATCH;
+        else
+        {
+            info->NumberOfProcessIdsInList = total;
+            for (i = 0; i < total; i++) info->ProcessIdList[i] = pids[i];
+        }
+    }
+    free( pids );
+    return status;
+}
+
+
 /* retrieve device/inode number for all the drives */
 static unsigned int get_drives_info( struct file_identity info[MAX_DOS_DRIVES] )
 {
@@ -5356,7 +5388,7 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         0,                                             /* FileSfioReserveInformation */
         0,                                             /* FileSfioVolumeInformation */
         0,                                             /* FileHardLinkInformation */
-        0,                                             /* FileProcessIdsUsingFileInformation */
+        sizeof(FILE_PROCESS_IDS_USING_FILE_INFORMATION), /* FileProcessIdsUsingFileInformation */
         sizeof(FILE_NAME_INFORMATION),                 /* FileNormalizedNameInformation */
         0,                                             /* FileNetworkPhysicalNameInformation */
         0,                                             /* FileIdGlobalTxDirectoryInformation */
@@ -5410,6 +5442,8 @@ NTSTATUS WINAPI NtQueryInformationFile( HANDLE handle, IO_STATUS_BLOCK *io,
         return server_get_file_info( handle, io, ptr, len, class );
     if (len < info_sizes[class])
         return io->Status = STATUS_INFO_LENGTH_MISMATCH;
+    if (class == FileProcessIdsUsingFileInformation)
+        return io->Status = get_file_users( handle, io, ptr, len );
 
     if ((status = server_get_unix_fd( handle, 0, &fd, &needs_close, NULL, &options )))
     {
diff --git a/dlls/wow64/file.c b/dlls/wow64/file.c
index 4ad490cbfc4..e66252b407d 100644
--- a/dlls/wow64/file.c
+++ b/dlls/wow64/file.c
@@ -633,6 +633,32 @@ NTSTATUS WINAPI wow64_NtQueryInformationFile( UINT *args )
     IO_STATUS_BLOCK io;
     NTSTATUS status;
 
+    if (class == FileProcessIdsUsingFileInformation)
+    {
+        /* ULONG count, then a ULONG_PTR per process */
+        ULONG max, *info32 = info, i;
+        FILE_PROCESS_IDS_USING_FILE_INFORMATION *info64;
+
+        if (len < 2 * sizeof(ULONG)) return STATUS_INFO_LENGTH_MISMATCH;
+        max = len / sizeof(ULONG) - 1;
+        if (!(info64 = Wow64AllocateTemp( offsetof( FILE_PROCESS_IDS_USING_FILE_INFORMATION, ProcessIdList[max] ))))
+            return STATUS_NO_MEMORY;
+        status = NtQueryInformationFile( handle, iosb_32to64( &io, io32 ), info64,
+                                         offsetof( FILE_PROCESS_IDS_USING_FILE_INFORMATION, ProcessIdList[max] ),
+                                         class );
+        if (!status || status == STATUS_INFO_LENGTH_MISMATCH)
+            io.Information = sizeof(ULONG) + (io.Information -
+                             offsetof( FILE_PROCESS_IDS_USING_FILE_INFORMATION, ProcessIdList )) / sizeof(ULONG_PTR) *
+                             sizeof(ULONG);
+        if (!status)
+        {
+            info32[0] = info64->NumberOfProcessIdsInList;
+            for (i = 0; i < info64->NumberOfProcessIdsInList; i++) info32[i + 1] = info64->ProcessIdList[i];
+        }
+        put_iosb( io32, &io );
+        return status;
+    }
+
     status = NtQueryInformationFile( handle, iosb_32to64( &io, io32 ), info, len, class );
     put_iosb( io32, &io );
     return status;
