From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 2 Oct 2026 15:34:04 -0400
Subject: [PATCH] ntdll: Implement FileProcessIdsUsingFileInformation.

The server walks every process's handles and views for the same inode, leaving out the file object the query goes
through.  As on Windows 11, the buffer has to hold the header and one id, a buffer too small for all of them gets
STATUS_INFO_LENGTH_MISMATCH with the size it takes in Information, and image mappings count.  Wow64 gives 32-bit
callers their ULONG list.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 4f3414ba9e1..bdc82d5be23 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -4357,6 +4357,63 @@ static void test_file_name_information(void)
 }
 
 /* a file's name comes back in the case it has on disk, whatever case it was opened by */
+/* the processes that use a file, but for the file object asked through */
+static void test_file_process_ids(void)
+{
+    char buffer[sizeof(FILE_PROCESS_IDS_USING_FILE_INFORMATION) + 16 * sizeof(ULONG_PTR)];
+    FILE_PROCESS_IDS_USING_FILE_INFORMATION *info = (void *)buffer;
+    WCHAR path[MAX_PATH], temp[MAX_PATH];
+    HANDLE file, file2, image;
+    IO_STATUS_BLOCK io;
+    NTSTATUS status;
+
+    GetTempPathW( ARRAY_SIZE(temp), temp );
+    GetTempFileNameW( temp, L"pid", 0, path );
+    file = CreateFileW( path, GENERIC_READ | GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+                        NULL, CREATE_ALWAYS, 0, NULL );
+    ok( file != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError() );
+
+    memset( buffer, 0xcc, sizeof(buffer) );
+    status = pNtQueryInformationFile( file, &io, buffer, sizeof(buffer), FileProcessIdsUsingFileInformation );
+    ok( !status, "got %#lx\n", status );
+    ok( !info->NumberOfProcessIdsInList, "got %lu\n", info->NumberOfProcessIdsInList );
+    ok( io.Information == offsetof( FILE_PROCESS_IDS_USING_FILE_INFORMATION, ProcessIdList ),
+        "got %Iu\n", io.Information );
+
+    status = pNtQueryInformationFile( file, &io, buffer, sizeof(FILE_PROCESS_IDS_USING_FILE_INFORMATION) - 1,
+                                      FileProcessIdsUsingFileInformation );
+    ok( status == STATUS_INFO_LENGTH_MISMATCH, "got %#lx\n", status );
+
+    /* the first handle is ours */
+    file2 = CreateFileW( path, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                         OPEN_EXISTING, 0, NULL );
+    ok( file2 != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError() );
+    memset( buffer, 0xcc, sizeof(buffer) );
+    status = pNtQueryInformationFile( file2, &io, buffer, sizeof(buffer), FileProcessIdsUsingFileInformation );
+    ok( !status, "got %#lx\n", status );
+    ok( info->NumberOfProcessIdsInList == 1, "got %lu\n", info->NumberOfProcessIdsInList );
+    ok( info->ProcessIdList[0] == GetCurrentProcessId(), "got %Iu\n", info->ProcessIdList[0] );
+    CloseHandle( file2 );
+    CloseHandle( file );
+    DeleteFileW( path );
+
+    /* an image is used where it is mapped */
+    GetModuleFileNameW( NULL, path, ARRAY_SIZE(path) );
+    image = CreateFileW( path, FILE_READ_ATTRIBUTES, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE, NULL,
+                         OPEN_EXISTING, 0, NULL );
+    ok( image != INVALID_HANDLE_VALUE, "got error %lu\n", GetLastError() );
+    memset( buffer, 0xcc, sizeof(buffer) );
+    status = pNtQueryInformationFile( image, &io, buffer, sizeof(buffer), FileProcessIdsUsingFileInformation );
+    ok( !status, "got %#lx\n", status );
+    ok( info->NumberOfProcessIdsInList >= 1, "got %lu\n", info->NumberOfProcessIdsInList );
+    /* a buffer too small for all of them gets none, and the size it takes */
+    status = pNtQueryInformationFile( image, &io, buffer, sizeof(FILE_PROCESS_IDS_USING_FILE_INFORMATION),
+                                      FileProcessIdsUsingFileInformation );
+    if (info->NumberOfProcessIdsInList > 1)
+        ok( status == STATUS_INFO_LENGTH_MISMATCH, "got %#lx\n", status );
+    CloseHandle( image );
+}
+
 static void test_file_name_case(void)
 {
     static const WCHAR name[] = L"MixedCase.Tmp";
@@ -8889,6 +8946,7 @@ START_TEST(file)
     test_file_both_information();
     test_file_name_information();
