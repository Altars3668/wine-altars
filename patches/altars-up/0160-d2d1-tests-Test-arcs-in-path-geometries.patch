From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sun, 27 Sep 2026 14:59:18 -0400
Subject: [PATCH] d2d1/tests: Test arcs in path geometries.
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

A half circle over its chord and a three-quarter circle, drawn from arcs, and
the bounds and pixels they come to as they follow from the geometry.  Upstream
has since implemented AddArc with Bézier segments; these check it.  They were
not run on Windows.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/d2d1/tests/d2d1.c b/dlls/d2d1/tests/d2d1.c
index f2770b5d92d..25997c761bb 100644
--- a/dlls/d2d1/tests/d2d1.c
+++ b/dlls/d2d1/tests/d2d1.c
@@ -16937,6 +16937,88 @@ static void test_effect_custom_pixel_shader(BOOL d3d11)
     release_test_context(&ctx);
 }
 
+/* The values follow from the geometry of the arcs. */
+static void test_path_geometry_arcs(BOOL d3d11)
+{
+    static const struct
+    {
+        D2D1_POINT_2F start;
+        D2D1_ARC_SEGMENT arc;
+        D2D1_RECT_F bounds;
+        struct { unsigned int x, y; DWORD colour; } pixels[4];
+    }
+    tests[] =
+    {
+        /* half a circle over its chord: with y down, clockwise goes over the top */
+        {{100.0f, 100.0f}, {{200.0f, 100.0f}, {50.0f, 50.0f}, 0.0f, D2D1_SWEEP_DIRECTION_CLOCKWISE, D2D1_ARC_SIZE_SMALL},
+         {100.0f, 50.0f, 200.0f, 100.0f},
+         {{150, 75, 0xffff0000}, {150, 56, 0xffff0000}, {105, 55, 0x00000000}, {150, 105, 0x00000000}}},
+        /* three quarters of a circle about (150, 300) */
+        {{100.0f, 300.0f}, {{150.0f, 350.0f}, {50.0f, 50.0f}, 0.0f, D2D1_SWEEP_DIRECTION_CLOCKWISE, D2D1_ARC_SIZE_LARGE},
+         {100.0f, 250.0f, 200.0f, 350.0f},
+         {{150, 260, 0xffff0000}, {190, 300, 0xffff0000}, {105, 255, 0x00000000}, {195, 345, 0x00000000}}},
+    };
+    struct d2d1_test_context ctx;
+    struct resource_readback rb;
+    ID2D1SolidColorBrush *brush;
+    ID2D1PathGeometry *geometry;
+    ID2D1GeometrySink *sink;
+    D2D1_RECT_F bounds;
+    D2D1_COLOR_F color;
+    unsigned int i, j;
+    DWORD colour;
+    HRESULT hr;
+
+    if (!init_test_context(&ctx, d3d11))
+        return;
+
+    set_color(&color, 1.0f, 0.0f, 0.0f, 1.0f);
+    hr = ID2D1DeviceContext_CreateSolidColorBrush(ctx.context, &color, NULL, &brush);
+    ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(tests); ++i)
+    {
+        winetest_push_context("Test %u", i);
+
+        hr = ID2D1Factory_CreatePathGeometry(ctx.factory, &geometry);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        hr = ID2D1PathGeometry_Open(geometry, &sink);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ID2D1GeometrySink_BeginFigure(sink, tests[i].start, D2D1_FIGURE_BEGIN_FILLED);
+        ID2D1GeometrySink_AddArc(sink, &tests[i].arc);
+        ID2D1GeometrySink_EndFigure(sink, D2D1_FIGURE_END_CLOSED);
+        hr = ID2D1GeometrySink_Close(sink);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ID2D1GeometrySink_Release(sink);
+
+        hr = ID2D1PathGeometry_GetBounds(geometry, NULL, &bounds);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        ok(compare_rect(&bounds, tests[i].bounds.left, tests[i].bounds.top, tests[i].bounds.right,
+                tests[i].bounds.bottom, 16), "Got unexpected bounds {%.8e, %.8e, %.8e, %.8e}.\n",
+                bounds.left, bounds.top, bounds.right, bounds.bottom);
+
+        ID2D1DeviceContext_BeginDraw(ctx.context);
+        ID2D1DeviceContext_Clear(ctx.context, NULL);
+        ID2D1DeviceContext_FillGeometry(ctx.context, (ID2D1Geometry *)geometry, (ID2D1Brush *)brush, NULL);
+        hr = ID2D1DeviceContext_EndDraw(ctx.context, NULL, NULL);
+        ok(hr == S_OK, "Got unexpected hr %#lx.\n", hr);
+        get_surface_readback(&ctx, &rb);
+        for (j = 0; j < ARRAY_SIZE(tests[i].pixels); ++j)
+        {
+            colour = get_readback_colour(&rb, tests[i].pixels[j].x, tests[i].pixels[j].y);
+            ok(colour == tests[i].pixels[j].colour, "Got unexpected colour %#lx at (%u, %u).\n",
+                    colour, tests[i].pixels[j].x, tests[i].pixels[j].y);
+        }
+        release_resource_readback(&rb);
+
+        ID2D1PathGeometry_Release(geometry);
+        winetest_pop_context();
+    }
+
+    ID2D1SolidColorBrush_Release(brush);
+    release_test_context(&ctx);
+}
+
 static ID2D1Bitmap1 *create_effect_input(ID2D1DeviceContext *context, unsigned int width, unsigned int height,
         DWORD colour)
 {
@@ -18924,6 +19006,7 @@ START_TEST(d2d1)
         queue_test(test_bounds_adjustment_transform);
         queue_test(test_effect_custom_pixel_shader);
     queue_test(test_effect_rendering);
+    queue_test(test_path_geometry_arcs);
         queue_d3d10_test(test_get_effect_properties);
         queue_test(test_effect_vertex_buffer);
         queue_d3d10_test(test_effect_blob_property);
@@ -19021,6 +19104,7 @@ START_TEST(d2d1)
     queue_test(test_bitmap_create);
     queue_test(test_effect_custom_pixel_shader);
     queue_test(test_effect_rendering);
+    queue_test(test_path_geometry_arcs);
     queue_d3d10_test(test_get_effect_properties);
     queue_test(test_effect_vertex_buffer);
     queue_d3d10_test(test_compute_geometry_area);
