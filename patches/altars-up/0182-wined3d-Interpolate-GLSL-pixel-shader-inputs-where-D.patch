diff --git a/dlls/wined3d/glsl_shader.c b/dlls/wined3d/glsl_shader.c
index b84fb3958c5..296f5781508 100644
--- a/dlls/wined3d/glsl_shader.c
+++ b/dlls/wined3d/glsl_shader.c
@@ -2162,6 +2162,8 @@ static const char *shader_glsl_shader_output_name(const struct wined3d_gl_info *
     return shader_glsl_use_interface_blocks(gl_info) ? "shader_out.reg" : "ps_link";
 }
 
+/* Where an input is interpolated, at the centroid or the sample, is not declared, as the declarations in the
+ * stages before would have to say the same; the pixel shader takes it there itself (shader_glsl_input_pack()). */
 static const char *shader_glsl_interpolation_qualifiers(enum wined3d_shader_interpolation_mode mode)
 {
     switch (mode)
@@ -2169,11 +2171,15 @@ static const char *shader_glsl_interpolation_qualifiers(enum wined3d_shader_inte
         case WINED3DSIM_CONSTANT:
             return "flat ";
         case WINED3DSIM_LINEAR_NOPERSPECTIVE:
+        case WINED3DSIM_LINEAR_NOPERSPECTIVE_CENTROID:
+        case WINED3DSIM_LINEAR_NOPERSPECTIVE_SAMPLE:
             return "noperspective ";
         default:
             FIXME("Unhandled interpolation mode %#x.\n", mode);
         case WINED3DSIM_NONE:
         case WINED3DSIM_LINEAR:
+        case WINED3DSIM_LINEAR_CENTROID:
+        case WINED3DSIM_LINEAR_SAMPLE:
             return "";
     }
 }
@@ -6953,12 +6959,34 @@ static void shader_glsl_input_pack(const struct wined3d_shader *shader, struct w
         const struct wined3d_shader_reg_maps *reg_maps,
         const struct ps_compile_args *args, const struct wined3d_gl_info *gl_info, BOOL unroll)
 {
+    enum wined3d_shader_interpolation_mode mode;
+    BOOL per_sample = FALSE, interpolate_at;
+    const char *input_name;
     unsigned int i;
 
+    /* A shader that reads the sample index, or has an input interpolated at the sample, runs for each sample;
+     * its other inputs are still interpolated at the pixel's centre, where GL would take them at the sample. */
+    for (i = 0; i < input_signature->element_count; ++i)
+    {
+        const struct wined3d_shader_signature_element *input = &input_signature->elements[i];
+
+        if (!(reg_maps->input_registers & (1u << input->register_idx)))
+            continue;
+        mode = wined3d_extract_interpolation_mode(shader->u.ps.interpolation_mode,
+                shader->u.ps.input_reg_map[input->register_idx]);
+        if (input->sysval_semantic == WINED3D_SV_SAMPLE_INDEX || mode == WINED3DSIM_LINEAR_SAMPLE
+                || mode == WINED3DSIM_LINEAR_NOPERSPECTIVE_SAMPLE)
+            per_sample = TRUE;
+    }
+    interpolate_at = unroll && (gl_info->supported[ARB_GPU_SHADER5]
+            || gl_info->glsl_version >= MAKEDWORD_VERSION(4, 0));
+    input_name = shader_glsl_shader_input_name(gl_info);
+
     for (i = 0; i < input_signature->element_count; ++i)
     {
         const struct wined3d_shader_signature_element *input = &input_signature->elements[i];
         const char *semantic_name;
+        unsigned int idx;
         UINT semantic_idx;
         char reg_mask[6];
 
@@ -7014,10 +7042,25 @@ static void shader_glsl_input_pack(const struct wined3d_shader *shader, struct w
             {
                 if (input->sysval_semantic)
                     FIXME("Unhandled sysval semantic %#x.\n", input->sysval_semantic);
-                shader_addline(buffer, unroll ? "ps_in[%u]%s = %s%u%s;\n" : "ps_in[%u]%s = %s[%u]%s;\n",
-                        shader->u.ps.input_reg_map[input->register_idx], reg_mask,
-                        shader_glsl_shader_input_name(gl_info),
-                        shader->u.ps.input_reg_map[input->register_idx], reg_mask);
+                idx = shader->u.ps.input_reg_map[input->register_idx];
+                mode = wined3d_extract_interpolation_mode(shader->u.ps.interpolation_mode, idx);
+                if (!interpolate_at && mode != WINED3DSIM_NONE && mode != WINED3DSIM_CONSTANT
+                        && mode != WINED3DSIM_LINEAR && mode != WINED3DSIM_LINEAR_NOPERSPECTIVE)
+                    FIXME("Cannot interpolate input %u with mode %#x.\n", idx, mode);
+                if (interpolate_at && (mode == WINED3DSIM_LINEAR_CENTROID
+                        || mode == WINED3DSIM_LINEAR_NOPERSPECTIVE_CENTROID))
+                    shader_addline(buffer, "ps_in[%u]%s = interpolateAtCentroid(%s%u)%s;\n",
+                            idx, reg_mask, input_name, idx, reg_mask);
+                else if (interpolate_at && (mode == WINED3DSIM_LINEAR_SAMPLE
+                        || mode == WINED3DSIM_LINEAR_NOPERSPECTIVE_SAMPLE))
+                    shader_addline(buffer, "ps_in[%u]%s = interpolateAtSample(%s%u, gl_SampleID)%s;\n",
+                            idx, reg_mask, input_name, idx, reg_mask);
+                else if (interpolate_at && per_sample && mode != WINED3DSIM_CONSTANT)
+                    shader_addline(buffer, "ps_in[%u]%s = interpolateAtOffset(%s%u, vec2(0.0))%s;\n",
+                            idx, reg_mask, input_name, idx, reg_mask);
+                else
+                    shader_addline(buffer, unroll ? "ps_in[%u]%s = %s%u%s;\n" : "ps_in[%u]%s = %s[%u]%s;\n",
+                            idx, reg_mask, input_name, idx, reg_mask);
             }
         }
         else if (shader_match_semantic(semantic_name, WINED3D_DECL_USAGE_TEXCOORD))
