From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 31 Aug 2026 13:32:41 -0400
Subject: [PATCH] sspicli: Implement SspiPrepareForCredRead().

It was a stub, and calling a stub raises an exception rather than returning
a failure code, so a caller merely asking whether it has saved credentials
for a target dies instead.

It is the read counterpart of SspiPrepareForCredWrite, which is implemented
a few lines above it, and this follows the same conventions.

Signed-off-by: AltarsCN <337293323+Altars3668@users.noreply.github.com>
(cherry picked from commit ba9799809b29411efd1443e7be189750dc0f981b)

diff --git a/dlls/sspicli/main.c b/dlls/sspicli/main.c
index 799629de93f..703eeffac20 100644
--- a/dlls/sspicli/main.c
+++ b/dlls/sspicli/main.c
@@ -238,6 +238,61 @@ void SEC_ENTRY SspiLocalFree( void *ptr )
     LocalFree( ptr );
 }
 
+/***********************************************************************
+ *		SspiPrepareForCredRead (SECUR32.0)
+ *
+ * The read counterpart of SspiPrepareForCredWrite: it says which Credential
+ * Manager entry an identity corresponds to, so the caller can look it up.
+ * Callers reach it while deciding whether they already hold credentials for a
+ * target, and a stub takes the whole process down rather than letting them
+ * conclude that they do not.
+ */
+SECURITY_STATUS SEC_ENTRY SspiPrepareForCredRead( PSEC_WINNT_AUTH_IDENTITY_OPAQUE opaque_id,
+    PCWSTR target, PULONG type, PCWSTR *targetname )
+{
+    const WCHAR *user, *domain, *password;
+    SECURITY_STATUS status;
+    WCHAR *str;
+
+    TRACE( "%p %s %p %p\n", opaque_id, debugstr_w(target), type, targetname );
+
+    if (!opaque_id || !type || !targetname) return SEC_E_INVALID_HANDLE;
+
+    if (target)
+    {
+        if (!(str = LocalAlloc( LMEM_FIXED, (wcslen( target ) + 1) * sizeof(WCHAR) )))
+            return SEC_E_INSUFFICIENT_MEMORY;
+        wcscpy( str, target );
+    }
+    else
+    {
+        /* Without a target, the entry is named for the identity itself, in the
+         * domain\\user form the write side produces. */
+        status = SspiEncodeAuthIdentityAsStrings( opaque_id, &user, &domain, &password );
+        if (status) return status;
+
+        if ((str = LocalAlloc( LMEM_FIXED, (wcslen( user ) + (domain ? wcslen( domain ) + 1 : 0) + 1) * sizeof(WCHAR) )))
+        {
+            str[0] = 0;
+            if (domain)
+            {
+                wcscpy( str, domain );
+                wcscat( str, L"\\" );
+            }
+            wcscat( str, user );
+        }
+        SspiLocalFree( (void *)user );
+        SspiLocalFree( (void *)domain );
+        if (password) SecureZeroMemory( (void *)password, wcslen( password ) * sizeof(WCHAR) );
+        SspiLocalFree( (void *)password );
+        if (!str) return SEC_E_INSUFFICIENT_MEMORY;
+    }
+
+    *type = CRED_TYPE_DOMAIN_PASSWORD;
+    *targetname = str;
+    return SEC_E_OK;
+}
+
 /***********************************************************************
  *		SspiPrepareForCredWrite (SECUR32.0)
  */
diff --git a/dlls/sspicli/sspicli.spec b/dlls/sspicli/sspicli.spec
index 315bc468187..3f58e27b680 100644
--- a/dlls/sspicli/sspicli.spec
+++ b/dlls/sspicli/sspicli.spec
@@ -94,7 +94,7 @@
 @ stub SspiIsAuthIdentityEncrypted
 @ stdcall SspiLocalFree(ptr)
 @ stdcall SspiMarshalAuthIdentity(ptr ptr ptr)
-@ stub SspiPrepareForCredRead
+@ stdcall SspiPrepareForCredRead(ptr wstr ptr ptr)
 @ stdcall SspiPrepareForCredWrite(ptr wstr ptr ptr ptr ptr ptr)
 @ stdcall SspiUnmarshalAuthIdentity(long ptr ptr)
 @ stub SspiUnmarshalAuthIdentityInternal
