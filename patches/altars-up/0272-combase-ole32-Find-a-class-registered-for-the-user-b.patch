From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 11:17:50 -0400
Subject: [PATCH] combase, ole32: Find a class registered for the user before
 the machine's.

COM looks classes up through its own handle to HKLM\Software\Classes,
so that an override of HKEY_CLASSES_ROOT does not change what it finds,
and so it never saw a class registered in HKCU\Software\Classes.  On
Windows such a class is found, and before the machine's: with
tools/olecreateprobe registering its class for the user, OleCreate()
and CoCreateInstance() answer on Windows 11 as Wine now does, where
they failed with REGDB_E_CLASSNOTREG.  The user's Classes key is opened
once, and a 64-bit caller asking for the 32-bit view looks under its
Wow6432Node.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/combase/combase.c b/dlls/combase/combase.c
index 5f0a36a37f6..7acd1b0601b 100644
--- a/dlls/combase/combase.c
+++ b/dlls/combase/combase.c
@@ -284,11 +284,56 @@ static HKEY get_classes_root_hkey(HKEY hkey, REGSAM access)
     return ret;
 }
 
+static HKEY user_classes_root_hkey;
+
+/* HKEY_CURRENT_USER\\Software\\Classes, kept open once found */
+static HKEY get_user_classes_root_hkey(void)
+{
+    UNICODE_STRING name = RTL_CONSTANT_STRING(L"Software\\Classes");
+    OBJECT_ATTRIBUTES attr;
+    HANDLE user;
+    HKEY hkey;
+
+    if (user_classes_root_hkey) return user_classes_root_hkey;
+    if (RtlOpenCurrentUser(MAXIMUM_ALLOWED, &user)) return 0;
+    InitializeObjectAttributes(&attr, &name, 0, user, NULL);
+    if (NtOpenKey((HANDLE *)&hkey, MAXIMUM_ALLOWED, &attr)) hkey = 0;
+    NtClose(user);
+    if (hkey && InterlockedCompareExchangePointer((void **)&user_classes_root_hkey, hkey, 0))
+        NtClose(hkey);  /* somebody beat us to it */
+    return user_classes_root_hkey;
+}
+
+/* as through HKEY_CLASSES_ROOT, a class the user registered comes before the machine's */
+static LSTATUS open_user_classes_key(const WCHAR *name, REGSAM access, HKEY *retkey)
+{
+    const BOOL is_win64 = sizeof(void*) > sizeof(int);
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING nameW;
+    WCHAR *path;
+    HKEY root;
+    NTSTATUS status;
+
+    if (!(root = get_user_classes_root_hkey())) return ERROR_FILE_NOT_FOUND;
+    if (!(path = malloc((wcslen(name) + 13) * sizeof(WCHAR)))) return ERROR_OUTOFMEMORY;
+    path[0] = 0;
+    if (is_win64 && (access & KEY_WOW64_32KEY)) lstrcpyW(path, L"Wow6432Node\\");
+    lstrcatW(path, name);
+    InitializeObjectAttributes(&attr, &nameW, 0, root, NULL);
+    RtlInitUnicodeString(&nameW, path);
+    status = NtOpenKey((HANDLE *)retkey, access & ~(KEY_WOW64_32KEY | KEY_WOW64_64KEY), &attr);
+    free(path);
+    return RtlNtStatusToDosError(status);
+}
+
 static LSTATUS open_classes_key(HKEY hkey, const WCHAR *name, REGSAM access, HKEY *retkey)
 {
     OBJECT_ATTRIBUTES attr;
     UNICODE_STRING nameW;
 
+    if (hkey == HKEY_CLASSES_ROOT && !open_user_classes_key(name, access, retkey))
+        return ERROR_SUCCESS;
+
     if (!(hkey = get_classes_root_hkey(hkey, access)))
         return ERROR_INVALID_HANDLE;
 
diff --git a/dlls/ole32/compobj.c b/dlls/ole32/compobj.c
index fd974e205d1..6cc2ea32e42 100644
--- a/dlls/ole32/compobj.c
+++ b/dlls/ole32/compobj.c
@@ -310,11 +310,56 @@ LSTATUS create_classes_key( HKEY hkey, const WCHAR *name, REGSAM access, HKEY *r
     return RtlNtStatusToDosError( create_key( retkey, access, &attr ) );
 }
 
+static HKEY user_classes_root_hkey;
+
+/* HKEY_CURRENT_USER\\Software\\Classes, kept open once found */
+static HKEY get_user_classes_root_hkey( void )
+{
+    UNICODE_STRING name = RTL_CONSTANT_STRING(L"Software\\Classes");
+    OBJECT_ATTRIBUTES attr;
+    HANDLE user;
+    HKEY hkey;
+
+    if (user_classes_root_hkey) return user_classes_root_hkey;
+    if (RtlOpenCurrentUser(MAXIMUM_ALLOWED, &user)) return 0;
+    InitializeObjectAttributes(&attr, &name, 0, user, NULL);
+    if (NtOpenKey((HANDLE *)&hkey, MAXIMUM_ALLOWED, &attr)) hkey = 0;
+    NtClose(user);
+    if (hkey && InterlockedCompareExchangePointer((void **)&user_classes_root_hkey, hkey, 0))
+        NtClose(hkey);  /* somebody beat us to it */
+    return user_classes_root_hkey;
+}
+
+/* as through HKEY_CLASSES_ROOT, a class the user registered comes before the machine's */
+static LSTATUS open_user_classes_key(const WCHAR *name, REGSAM access, HKEY *retkey)
+{
+    const BOOL is_win64 = sizeof(void*) > sizeof(int);
+    OBJECT_ATTRIBUTES attr;
+    UNICODE_STRING nameW;
+    WCHAR *path;
+    HKEY root;
+    NTSTATUS status;
+
+    if (!(root = get_user_classes_root_hkey())) return ERROR_FILE_NOT_FOUND;
+    if (!(path = malloc((wcslen(name) + 13) * sizeof(WCHAR)))) return ERROR_OUTOFMEMORY;
+    path[0] = 0;
+    if (is_win64 && (access & KEY_WOW64_32KEY)) lstrcpyW(path, L"Wow6432Node\\");
+    lstrcatW(path, name);
+    InitializeObjectAttributes(&attr, &nameW, 0, root, NULL);
+    RtlInitUnicodeString(&nameW, path);
+    status = NtOpenKey((HANDLE *)retkey, access & ~(KEY_WOW64_32KEY | KEY_WOW64_64KEY), &attr);
+    free(path);
+    return RtlNtStatusToDosError(status);
+}
+
 LSTATUS open_classes_key( HKEY hkey, const WCHAR *name, REGSAM access, HKEY *retkey )
 {
     OBJECT_ATTRIBUTES attr;
     UNICODE_STRING nameW;
 
+    if (hkey == HKEY_CLASSES_ROOT && !open_user_classes_key( name, access, retkey ))
+        return ERROR_SUCCESS;
+
     if (!(hkey = get_classes_root_hkey( hkey, access ))) return ERROR_INVALID_HANDLE;
 
     attr.Length = sizeof(attr);
