 }
diff --git a/dlls/ntdll/locale.c b/dlls/ntdll/locale.c
index a100a936531..86cf08071b7 100644
--- a/dlls/ntdll/locale.c
+++ b/dlls/ntdll/locale.c
@@ -46,6 +46,13 @@ static const WCHAR *locale_strings;
 #define MAX_UI_LANGS_MERGED (MAX_UI_LANGS * 16)  /* enough room for thread/process/user/system + neutrals */
 #define UI_LANG_END  0xffff  /* end marker in UI language array */
 
+/* the languages a thread asked for, and the filters it asked them to go through */
+struct thread_ui_languages
+{
+    DWORD  filters;                  /* MUI_CONSOLE_FILTER and MUI_COMPLEX_SCRIPT_FILTER */
+    USHORT langs[MAX_UI_LANGS + 1];  /* terminated by UI_LANG_END */
+};
+
 static USHORT *process_ui_languages;
 static USHORT *system_ui_languages;
 static USHORT *user_ui_languages;
@@ -163,31 +170,59 @@ static USHORT *dup_ui_languages( const USHORT *langs, ULONG len )
     return ret;
 }
 
-static NTSTATUS parse_ui_languages( USHORT *langs, DWORD flags, PCZZWSTR buffer, ULONG *len )
+/* the language a name or an id stands for, by the name of its language id: de-DE_phoneb is de-DE,
+ * zh-Hans-CN is zh-CN; an id is as many hex digits as there are, and nothing is made of what follows */
+static BOOL get_ui_language_index( const WCHAR *str, DWORD flags, USHORT *idx )
 {
-    *len = 0;
-    if (!buffer || !*buffer) return STATUS_SUCCESS;
+    const NLS_LOCALE_LCNAME_INDEX *name_entry;
+    const NLS_LOCALE_LCID_INDEX *id_entry;
+    LCID lcid = 0;
+    UINT i;
 
     if (flags & MUI_LANGUAGE_ID)
     {
-        for (const WCHAR *p = buffer; *p && *len < MAX_UI_LANGS; p += wcslen(p) + 1)
+        for (i = 0; i < 8; i++, str++)
         {
-            WCHAR *end;
-            LCID lcid = wcstoul( p, &end, 16 );
-
-            if (!*end) append_ui_lang_lcid( langs, len, lcid );
+            if (*str >= '0' && *str <= '9') lcid = lcid * 16 + *str - '0';
+            else if (*str >= 'a' && *str <= 'f') lcid = lcid * 16 + *str - 'a' + 10;
+            else if (*str >= 'A' && *str <= 'F') lcid = lcid * 16 + *str - 'A' + 10;
+            else break;
         }
     }
     else
     {
-        for (const WCHAR *p = buffer; *p && *len < MAX_UI_LANGS; p += wcslen(p) + 1)
-            append_ui_lang_lcname( langs, len, p );
+        if (!(name_entry = find_lcname_entry( locale_table, str ))) return FALSE;
+        if ((lcid = name_entry->id) == LOCALE_CUSTOM_UNSPECIFIED)
+        {
+            *idx = name_entry->idx;
+            return TRUE;
+        }
     }
+    if (!LANGIDFROMLCID( lcid ) || !(id_entry = find_lcid_entry( locale_table, LANGIDFROMLCID( lcid ))))
+        return FALSE;
+    *idx = id_entry->idx;
+    return TRUE;
+}
+
