+/* the script a language is written in, as a complex script filter sees it */
+static BOOL is_complex_ui_language( USHORT idx )
+{
+    static const WCHAR complex_scripts[] = L"Arab;Beng;Cans;Cher;Deva;Ethi;Gujr;Guru;Hebr;Khmr;Knda;Laoo;Mlym;"
+                                           L"Mymr;Orya;Sinh;Syrc;Taml;Telu;Thaa;Thai;Tibt;Tfng;Yiii;";
+    const NLS_LOCALE_DATA *data = get_locale_data( locale_table, idx );
+    const WCHAR *name = locale_strings + data->sname + 1, *p, *scripts;
+    WCHAR script[5];
+
+    /* a script in the name is the one */
+    if ((p = wcschr( name, '-' )) && wcslen( p + 1 ) >= 4 && (!p[5] || p[5] == '-') && !(p[1] >= '0' && p[1] <= '9'))
+    {
+        memcpy( script, p + 1, 4 * sizeof(WCHAR) );
+        script[4] = 0;
+        return wcsstr( complex_scripts, script ) != NULL;
+    }
+    /* then the code page of those with one: Arabic, Hebrew, Thai and Vietnamese are complex */
+    switch (data->idefaultansicodepage)
+    {
+    case 874: case 1255: case 1256: case 1258:
+        return TRUE;
+    case 0: case CP_UTF8:
+        break;
+    default:
+        return FALSE;
+    }
+    /* and a language written only in Unicode is complex if all its scripts are */
+    scripts = locale_strings + data->sscripts + 1;
+    if (!*scripts) return FALSE;
+    for (p = scripts; *p; p += 5)
+    {
+        memcpy( script, p, 4 * sizeof(WCHAR) );
+        script[4] = 0;
+        if (!wcsstr( complex_scripts, script )) return FALSE;
+        if (p[4] != ';') break;
+    }
+    return TRUE;
+}
