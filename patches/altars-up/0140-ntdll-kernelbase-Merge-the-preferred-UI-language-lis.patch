From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 14:14:02 -0400
Subject: [PATCH] ntdll, kernelbase: Merge the preferred UI language lists as
 Windows 11 does.

Word asks GetUserPreferredUILanguages and GetSystemPreferredUILanguages
for names, in pairs, as it picks the language of its resources.
Upstream keeps the thread's, the process's, the user's and the
system's lists, loads the last two from the registry, and looks for
resources through them.  tools/uilangprobe measured Windows 11 (a
zh-CN system with the en-US UI installed, and no PreferredUILanguages
value in the registry), and where upstream's lists differ from what it
answers, they now answer the same:

- The user's list is the user's languages and en-US, which every UI
  language falls back to; the system's, the system's languages and
  en-US.  Upstream left en-US out.
- The thread's list is the thread's own languages, then the process's,
  then the user's with their parents (LOCALE_SPARENT: zh-CN, zh-Hans,
  zh), then, with the user fallback, which is the default, en-US and
  the system's languages.  MUI_MERGE_SYSTEM_FALLBACK follows every
  language with its parents (sr-Latn-RS, sr-Latn, sr) and keeps the
  user's languages, which upstream's left out; MUI_THREAD_LANGUAGES
  gives the thread's own only.
- A thread or a process keeps at most five languages, by the name of
  their language id (de-DE_phoneb is de-DE, zh-Hans-CN is zh-CN).
  Names that are not languages are passed over, and a list with none
  fails with ERROR_GEN_FAILURE, as does one that begins with an empty
  name; an empty or no list takes them away.  An id is as many hex
  digits as there are, so 0x0409 is not one.
- The console and complex script filters stay with the thread and
  leave its languages alone, where upstream's took them away.  Its own
  list then leaves out what they do not pass and puts en-US in instead,
  or the language's console fallback when the console has its code
  page; the merged lists, and the languages resources are looked for
  in, keep those after the user's languages.  Which languages pass was
  measured for 85 of them.
- Counts, sizes and buffers on success and failure are as measured: a
  thread's list has its count even when the buffer is short, a
  process's empty list has none.

SetThreadUILanguage with a neutral language makes the thread's list the
language it defaults to (zh-Hans: zh-CN) and returns the one given, and
a thread's languages are freed as it exits.

Wine's locale data puts sa-IN in the Latin script and has no
tzm-Tfng-MA, so the complex script filter keeps the first and cannot be
given the second.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/kernel32/tests/locale.c b/dlls/kernel32/tests/locale.c
index aa21d3a7449..a30fae46683 100644
--- a/dlls/kernel32/tests/locale.c
+++ b/dlls/kernel32/tests/locale.c
@@ -87,6 +87,9 @@ static BOOL (WINAPI *pGetSystemPreferredUILanguages)(DWORD, ULONG*, WCHAR*, ULON
 static BOOL (WINAPI *pGetThreadPreferredUILanguages)(DWORD, ULONG*, WCHAR*, ULONG*);
 static BOOL (WINAPI *pSetThreadPreferredUILanguages)(DWORD, const WCHAR*, ULONG*);
 static BOOL (WINAPI *pGetUserPreferredUILanguages)(DWORD, ULONG*, WCHAR*, ULONG*);
+static BOOL (WINAPI *pGetProcessPreferredUILanguages)(DWORD, ULONG*, WCHAR*, ULONG*);
+static BOOL (WINAPI *pSetProcessPreferredUILanguages)(DWORD, const WCHAR*, ULONG*);
+static BOOL (WINAPI *pSetThreadPreferredUILanguages)(DWORD, const WCHAR*, ULONG*);
 static WCHAR (WINAPI *pRtlUpcaseUnicodeChar)(WCHAR);
 static INT (WINAPI *pGetNumberFormatEx)(LPCWSTR, DWORD, LPCWSTR, const NUMBERFMTW *, LPWSTR, int);
 static INT (WINAPI *pFindNLSStringEx)(LPCWSTR, DWORD, LPCWSTR, INT, LPCWSTR, INT, LPINT, LPNLSVERSIONINFO, LPVOID, LPARAM);
@@ -143,6 +146,9 @@ static void InitFunctionPointers(void)
   X(GetSystemPreferredUILanguages);
   X(GetThreadPreferredUILanguages);
   X(GetUserPreferredUILanguages);
+  X(GetProcessPreferredUILanguages);
+  X(SetProcessPreferredUILanguages);
+  X(SetThreadPreferredUILanguages);
   X(GetNumberFormatEx);
   X(FindNLSStringEx);
   X(SetThreadPreferredUILanguages);
@@ -7110,6 +7116,212 @@ static void test_GetUserPreferredUILanguages(void)
     HeapFree(GetProcessHeap(), 0, buffer);
 }
 
+/* a list of preferred UI languages as a string with its languages separated by '|' */
+static const char *debugstr_langs( const WCHAR *list )
+{
+    char buffer[512], *p = buffer;
+
+    if (!*list) return "\"\"";
+    while (*list && p < buffer + sizeof(buffer) - 64)
+    {
+        if (p != buffer) *p++ = '|';
+        p += sprintf( p, "%ls", list );
+        list += wcslen( list ) + 1;
+    }
+    return wine_dbg_sprintf( "\"%s\"", buffer );
+}
+
+static BOOL thread_languages( DWORD flags, WCHAR *buffer, ULONG *count )
+{
+    ULONG size = 256;
+
+    *count = 0xdead;
+    memset( buffer, 0xcc, size * sizeof(WCHAR) );
+    return pGetThreadPreferredUILanguages( flags, count, buffer, &size );
+}
+
+static void test_PreferredUILanguagesLists(void)
+{
+    static const WCHAR six[] = L"en-US\0fr-FR\0de-DE\0es-ES\0it-IT\0ja-JP\0";
+    WCHAR buffer[256], parent[LOCALE_NAME_MAX_LENGTH], user[LOCALE_NAME_MAX_LENGTH];
+    ULONG count, size;
+    LANGID lang;
+    DWORD err;
+    BOOL ret;
+
+    if (!pSetThreadPreferredUILanguages || !pGetProcessPreferredUILanguages)
+    {
+        win_skip( "SetThreadPreferredUILanguages is not available.\n" );
+        return;
+    }
+    pSetThreadPreferredUILanguages( MUI_RESET_FILTERS, NULL, NULL );
+    pSetThreadPreferredUILanguages( 0, NULL, NULL );
+    pSetProcessPreferredUILanguages( 0, NULL, NULL );
+
+    /* with nothing set, the thread list starts with the user's language and its parents */
+    LCIDToLocaleName( GetUserDefaultUILanguage(), user, ARRAY_SIZE(user), LOCALE_ALLOW_NEUTRAL_NAMES );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_MERGE_SYSTEM_FALLBACK, buffer, &count );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ok( !wcscmp( buffer, user ), "got %s, user language %s\n", debugstr_langs( buffer ), debugstr_w(user) );
+    if (GetLocaleInfoEx( user, LOCALE_SPARENT, parent, ARRAY_SIZE(parent) ) && parent[0])
+        ok( !wcscmp( buffer + wcslen( buffer ) + 1, parent ), "got %s, parent %s\n",
+            debugstr_langs( buffer ), debugstr_w(parent) );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES, buffer, &count );
+    ok( ret && !count && !buffer[0] && !buffer[1], "got %d, count %lu, %s\n", ret, count, debugstr_langs( buffer ) );
+    ok( GetThreadUILanguage() == GetUserDefaultUILanguage(), "got %04x\n", GetThreadUILanguage() );
+
+    size = ARRAY_SIZE(buffer);
+    ret = pGetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, buffer, &size );
+    ok( ret && !wcscmp( buffer, user ), "got %d, %s\n", ret, debugstr_langs( buffer ) );
+
+    /* the thread's own languages, as they are named */
+    count = 0xdead;
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, L"en-us\0FR-fr\0en-US\0", &count );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ok( count == 2, "got count %lu\n", count );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES, buffer, &count );
+    ok( ret && count == 2 && !memcmp( buffer, L"en-US\0fr-FR\0", 13 * sizeof(WCHAR) ),
+        "got %d, count %lu, %s\n", ret, count, debugstr_langs( buffer ) );
+    ret = thread_languages( MUI_LANGUAGE_ID | MUI_THREAD_LANGUAGES, buffer, &count );
+    ok( ret && !memcmp( buffer, L"0409\0" L"040C\0", 11 * sizeof(WCHAR) ), "got %s\n", debugstr_langs( buffer ) );
+    ret = thread_languages( MUI_LANGUAGE_NAME, buffer, &count );
+    ok( ret && !memcmp( buffer, L"en-US\0fr-FR\0", 12 * sizeof(WCHAR) ), "got %s\n", debugstr_langs( buffer ) );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_MERGE_SYSTEM_FALLBACK, buffer, &count );
+    ok( ret && !memcmp( buffer, L"en-US\0en\0fr-FR\0fr\0", 18 * sizeof(WCHAR) ), "got %s\n", debugstr_langs( buffer ) );
+    ok( GetThreadUILanguage() == MAKELANGID( LANG_ENGLISH, SUBLANG_ENGLISH_US ), "got %04x\n", GetThreadUILanguage() );
+
+    /* a short buffer: the size, and the count for a thread */
+    count = 0xdead;
+    size = 2;
+    SetLastError( 0xdeadbeef );
+    ret = pGetThreadPreferredUILanguages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES, &count, buffer, &size );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INSUFFICIENT_BUFFER, "got %d, error %lu\n", ret, err );
+    ok( size == 13 && count == 2, "got size %lu, count %lu\n", size, count );
+
+    /* at most five, names that are not languages passed over, and an empty one to begin with fails */
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, six, &count );
+    ok( ret && count == 5, "got %d, count %lu\n", ret, count );
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, L"de-DE_phoneb\0xx-XX\0fr-FR\0", &count );
+    ok( ret && count == 2, "got %d, count %lu\n", ret, count );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES, buffer, &count );
+    ok( ret && !memcmp( buffer, L"de-DE\0fr-FR\0", 13 * sizeof(WCHAR) ), "got %s\n", debugstr_langs( buffer ) );
+    SetLastError( 0xdeadbeef );
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, L"xx-XX\0", &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_GEN_FAILURE, "got %d, error %lu\n", ret, err );
+    SetLastError( 0xdeadbeef );
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, L"\0en-US\0", &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_GEN_FAILURE, "got %d, error %lu\n", ret, err );
+
+    /* ids are hex digits, as many as there are */
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_ID, L"407\0", &count );
+    ok( ret && count == 1, "got %d, count %lu\n", ret, count );
+    ok( GetThreadUILanguage() == MAKELANGID( LANG_GERMAN, SUBLANG_GERMAN ), "got %04x\n", GetThreadUILanguage() );
+    SetLastError( 0xdeadbeef );
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_ID, L"0x0409\0", &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_GEN_FAILURE, "got %d, error %lu\n", ret, err );
+
+    SetLastError( 0xdeadbeef );
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME | MUI_LANGUAGE_ID, L"en-US\0", &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, err );
+    SetLastError( 0xdeadbeef );
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME | MUI_CONSOLE_FILTER, L"en-US\0", &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, err );
+    SetLastError( 0xdeadbeef );
+    ret = pSetThreadPreferredUILanguages( 0x80, NULL, &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, err );
+
+    SetLastError( 0xdeadbeef );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES | MUI_MERGE_USER_FALLBACK, buffer, &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, err );
+    SetLastError( 0xdeadbeef );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES | MUI_MERGE_SYSTEM_FALLBACK, buffer, &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, err );
+    SetLastError( 0xdeadbeef );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_RESET_FILTERS, buffer, &count );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, err );
+
+    /* a filter keeps the languages, and leaves out of the lists what it does not pass */
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, L"ar-SA\0de-DE\0", &count );
+    ok( ret && count == 2, "got %d, count %lu\n", ret, count );
+    ret = pSetThreadPreferredUILanguages( MUI_COMPLEX_SCRIPT_FILTER, NULL, &count );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES, buffer, &count );
+    ok( ret && count == 2 && !wcscmp( buffer, L"de-DE" ), "got %d, count %lu, %s\n", ret, count, debugstr_langs( buffer ) );
+    ret = thread_languages( MUI_LANGUAGE_NAME, buffer, &count );
+    ok( ret && !wcscmp( buffer, L"de-DE" ) && !wcscmp( buffer + 6, user ), "got %s\n", debugstr_langs( buffer ) );
+    ok( GetThreadUILanguage() == MAKELANGID( LANG_GERMAN, SUBLANG_GERMAN ), "got %04x\n", GetThreadUILanguage() );
+    ret = pSetThreadPreferredUILanguages( MUI_RESET_FILTERS, NULL, &count );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES, buffer, &count );
+    ok( ret && count == 2 && !memcmp( buffer, L"ar-SA\0de-DE\0", 13 * sizeof(WCHAR) ), "got %s\n", debugstr_langs( buffer ) );
+
+    /* an empty list takes the thread's languages away */
+    ret = pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, L"\0", &count );
+    ok( ret, "got error %lu\n", GetLastError() );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES, buffer, &count );
+    ok( ret && !count, "got %d, count %lu\n", ret, count );
+
+    /* SetThreadUILanguage sets the thread's list, a neutral language as the one it defaults to */
+    lang = SetThreadUILanguage( MAKELANGID( LANG_FRENCH, SUBLANG_FRENCH ) );
+    ok( lang == MAKELANGID( LANG_FRENCH, SUBLANG_FRENCH ), "got %04x\n", lang );
+    ret = thread_languages( MUI_LANGUAGE_NAME | MUI_THREAD_LANGUAGES, buffer, &count );
+    ok( ret && count == 1 && !wcscmp( buffer, L"fr-FR" ), "got %s\n", debugstr_langs( buffer ) );
+    lang = SetThreadUILanguage( 0 );
+    ok( lang == MAKELANGID( LANG_FRENCH, SUBLANG_FRENCH ), "got %04x\n", lang );
+    lang = SetThreadUILanguage( 0x7804 );
+    ok( lang == 0x7804, "got %04x\n", lang );
+    ok( GetThreadUILanguage() == MAKELANGID( LANG_CHINESE, SUBLANG_CHINESE_SIMPLIFIED ), "got %04x\n", GetThreadUILanguage() );
+    pSetThreadPreferredUILanguages( 0, NULL, NULL );
+
+    /* the process's, which come after the thread's */
+    count = 0xdead;
+    ret = pSetProcessPreferredUILanguages( MUI_LANGUAGE_NAME, L"it-IT\0", &count );
+    ok( ret && count == 1, "got %d, count %lu\n", ret, count );
+    count = 0xdead;
+    size = ARRAY_SIZE(buffer);
+    ret = pGetProcessPreferredUILanguages( MUI_LANGUAGE_ID, &count, buffer, &size );
+    ok( ret && count == 1 && size == 6 && !wcscmp( buffer, L"0410" ), "got %d, count %lu, size %lu, %s\n",
+        ret, count, size, debugstr_langs( buffer ) );
+    ok( GetThreadUILanguage() == MAKELANGID( LANG_ITALIAN, SUBLANG_ITALIAN ), "got %04x\n", GetThreadUILanguage() );
+    pSetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, L"fr-FR\0", NULL );
+    ret = thread_languages( MUI_LANGUAGE_NAME, buffer, &count );
+    ok( ret && !memcmp( buffer, L"fr-FR\0it-IT\0", 12 * sizeof(WCHAR) ), "got %s\n", debugstr_langs( buffer ) );
+    pSetThreadPreferredUILanguages( 0, NULL, NULL );
+
+    count = 0xdead;
+    size = 2;
+    memset( buffer, 0xcc, sizeof(buffer) );
+    SetLastError( 0xdeadbeef );
+    ret = pGetProcessPreferredUILanguages( MUI_LANGUAGE_NAME, &count, buffer, &size );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INSUFFICIENT_BUFFER, "got %d, error %lu\n", ret, err );
+    ok( count == 1 && size == 7 && buffer[0] == 0xcccc, "got count %lu, size %lu, %#x\n", count, size, buffer[0] );
+
+    SetLastError( 0xdeadbeef );
+    ret = pSetProcessPreferredUILanguages( MUI_CONSOLE_FILTER, NULL, NULL );
+    err = GetLastError();
+    ok( !ret && err == ERROR_INVALID_PARAMETER, "got %d, error %lu\n", ret, err );
+
+    /* an empty list has no count */
+    ret = pSetProcessPreferredUILanguages( MUI_LANGUAGE_NAME, NULL, NULL );
+    ok( ret, "got error %lu\n", GetLastError() );
+    count = 0xdead;
+    size = ARRAY_SIZE(buffer);
+    memset( buffer, 0xcc, sizeof(buffer) );
+    ret = pGetProcessPreferredUILanguages( MUI_LANGUAGE_NAME, &count, buffer, &size );
+    ok( ret && count == 0xdead && size == 2 && !buffer[0] && !buffer[1], "got %d, count %#lx, size %lu\n", ret, count, size );
+}
+
 static void test_FindNLSStringEx(void)
 {
     INT res;
@@ -7284,6 +7496,8 @@ static void test_SetThreadUILanguage(void)
     res = pSetThreadUILanguage(0);
     ok(res == MAKELANGID(LANG_DUTCH, SUBLANG_DUTCH_BELGIAN),
     "expected %d got %d\n", MAKELANGID(LANG_DUTCH, SUBLANG_DUTCH_BELGIAN), res);
+
+    if (pSetThreadPreferredUILanguages) pSetThreadPreferredUILanguages(0, NULL, NULL);
 }
 
 /* read a Unicode string from NormalizationTest.txt format; helper for test_NormalizeString */
@@ -8838,6 +9052,7 @@ START_TEST(locale)
   test_GetSystemPreferredUILanguages();
   test_GetThreadPreferredUILanguages();
   test_GetUserPreferredUILanguages();
+  test_PreferredUILanguagesLists();
   test_FindNLSStringEx();
   test_FindStringOrdinal();
   test_SetThreadUILanguage();
diff --git a/dlls/kernelbase/locale.c b/dlls/kernelbase/locale.c
index dc3e33bf839..ab00d3eff54 100644
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -6417,6 +6417,8 @@ LANGID WINAPI DECLSPEC_HOTPATCH SetThreadUILanguage( LANGID langid )
 
     if (!langid) return GetThreadUILanguage(); /* FIXME: set MUI_CONSOLE_FILTER */
 
+    /* a neutral language sets the language it defaults to (zh-Hans: zh-CN), and is what is returned */
+    if (PRIMARYLANGID( langid ) != LANG_NEUTRAL) lcid = ConvertDefaultLocale( langid );
     if (!(locale = NlsValidateLocale( &lcid, 0 )))
     {
         SetLastError( ERROR_INVALID_PARAMETER );
@@ -6425,7 +6427,7 @@ LANGID WINAPI DECLSPEC_HOTPATCH SetThreadUILanguage( LANGID langid )
     wcscpy( buffer, locale_strings + locale->sname + 1 );
     buffer[wcslen(buffer) + 1] = 0;
     if (!SetThreadPreferredUILanguages( MUI_LANGUAGE_NAME, buffer, NULL )) return 0;
-    return LANGIDFROMLCID( lcid );
+    return PRIMARYLANGID( langid ) != LANG_NEUTRAL ? langid : LANGIDFROMLCID( lcid );
 }
 
 
diff --git a/dlls/ntdll/loader.c b/dlls/ntdll/loader.c
index b0b2392c504..123eae25aeb 100644
--- a/dlls/ntdll/loader.c
+++ b/dlls/ntdll/loader.c
@@ -4010,6 +4010,7 @@ void WINAPI LdrShutdownThread(void)
