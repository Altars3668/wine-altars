+}
+
+static ULONG WINAPI domdoc_OleCommandTarget_Release(IOleCommandTarget *iface)
+{
+    domdoc *doc = impl_from_IOleCommandTarget(iface);
+    return IXMLDOMDocument3_Release(&doc->IXMLDOMDocument3_iface);
+}
+
+static HRESULT WINAPI domdoc_OleCommandTarget_QueryStatus(IOleCommandTarget *iface, const GUID *group,
+        ULONG count, OLECMD *commands, OLECMDTEXT *text)
+{
+    ULONG i;
+
+    TRACE("%p, %s, %lu, %p, %p.\n", iface, debugstr_guid(group), count, commands, text);
+
+    if (group) return OLECMDERR_E_UNKNOWNGROUP;
+    for (i = 0; i < count; i++) commands[i].cmdf = 0;
+    return S_OK;
+}
+
+static HRESULT WINAPI domdoc_OleCommandTarget_Exec(IOleCommandTarget *iface, const GUID *group, DWORD id,
+        DWORD option, VARIANT *in, VARIANT *out)
+{
+    TRACE("%p, %s, %lu, %#lx, %p, %p.\n", iface, debugstr_guid(group), id, option, in, out);
+
+    if (group) return OLECMDERR_E_UNKNOWNGROUP;
+    /* a document loads at once here, so there is nothing to stop */
+    if (id == OLECMDID_STOP) return S_OK;
+    return OLECMDERR_E_NOTSUPPORTED;
+}
+
+static const IOleCommandTargetVtbl domdoc_OleCommandTargetVtbl =
+{
+    domdoc_OleCommandTarget_QueryInterface,
+    domdoc_OleCommandTarget_AddRef,
+    domdoc_OleCommandTarget_Release,
+    domdoc_OleCommandTarget_QueryStatus,
+    domdoc_OleCommandTarget_Exec,
+};
+
+/* IServiceProvider: the services of the site, and none without one */
+static HRESULT WINAPI domdoc_ServiceProvider_QueryInterface(IServiceProvider *iface, REFIID riid, void **obj)
+{
+    domdoc *doc = impl_from_IServiceProvider(iface);
+    return IXMLDOMDocument3_QueryInterface(&doc->IXMLDOMDocument3_iface, riid, obj);
+}
+
+static ULONG WINAPI domdoc_ServiceProvider_AddRef(IServiceProvider *iface)
+{
+    domdoc *doc = impl_from_IServiceProvider(iface);
+    return IXMLDOMDocument3_AddRef(&doc->IXMLDOMDocument3_iface);
+}
+
+static ULONG WINAPI domdoc_ServiceProvider_Release(IServiceProvider *iface)
+{
+    domdoc *doc = impl_from_IServiceProvider(iface);
+    return IXMLDOMDocument3_Release(&doc->IXMLDOMDocument3_iface);
+}
+
+static HRESULT WINAPI domdoc_ServiceProvider_QueryService(IServiceProvider *iface, REFGUID service, REFIID riid,
+        void **obj)
+{
+    domdoc *doc = impl_from_IServiceProvider(iface);
+    IServiceProvider *provider;
+    HRESULT hr;
+
+    TRACE("%p, %s, %s, %p.\n", iface, debugstr_guid(service), debugstr_guid(riid), obj);
+
+    /* without a site, MSXML 6.0 clears the output, 3.0 leaves it alone */
+    if (!doc->site || FAILED(IUnknown_QueryInterface(doc->site, &IID_IServiceProvider, (void **)&provider)))
+    {
+        if (doc->node->properties->version >= MSXML6) *obj = NULL;
+        return E_NOINTERFACE;
+    }
+    hr = IServiceProvider_QueryService(provider, service, riid, obj);
+    IServiceProvider_Release(provider);
+    return hr;
+}
+
+static const IServiceProviderVtbl domdoc_ServiceProviderVtbl =
+{
+    domdoc_ServiceProvider_QueryInterface,
+    domdoc_ServiceProvider_AddRef,
+    domdoc_ServiceProvider_Release,
+    domdoc_ServiceProvider_QueryService,
+};
