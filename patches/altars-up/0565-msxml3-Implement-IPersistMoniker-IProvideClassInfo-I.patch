+/* the class a document says it is: MSXML 3.0's documents all name the version-independent one */
 const CLSID* DOMDocument_version(MSXML_VERSION v)
 {
     switch (v)
     {
     default:
-    case MSXML_DEFAULT: return &CLSID_DOMDocument;
-    case MSXML3: return &CLSID_DOMDocument30;
+    case MSXML_DEFAULT:
+    case MSXML3: return &CLSID_DOMDocument;
     case MSXML4: return &CLSID_DOMDocument40;
     case MSXML6: return &CLSID_DOMDocument60;
     }
 }
 
+const CLSID *FreeThreadedDOMDocument_version(MSXML_VERSION v)
+{
+    switch (v)
+    {
+    default: return &CLSID_FreeThreadedDOMDocument;
+    case MSXML4: return &CLSID_FreeThreadedDOMDocument40;
+    case MSXML6: return &CLSID_FreeThreadedDOMDocument60;
