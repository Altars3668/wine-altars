+/* What the less common interfaces of a document answer: the class it says it is, the coclass of its
+ * version, no commands, no services without a site, and a moniker it keeps even when it cannot load
+ * from it, and hands back without a reference of its own. */
+static void test_document_class_interfaces(void)
+{
+    static const struct
+    {
+        const GUID *clsid;
+        const char *name;
+        const GUID *class_id;   /* what it says it is */
+        const GUID *coclass;    /* its class information */
+    }
+    classes[] =
+    {
+        { &_create(CLSID_DOMDocument2), &CLSID_DOMDocument2, &CLSID_DOMDocument2 },
+        { &_create(CLSID_DOMDocument30), &CLSID_DOMDocument2, &CLSID_DOMDocument2 },
+        { &_create(CLSID_FreeThreadedDOMDocument), &CLSID_FreeThreadedDOMDocument, &CLSID_DOMDocument2 },
+        { &_create(CLSID_DOMDocument60), &CLSID_DOMDocument60, &CLSID_DOMDocument60 },
+    };
+    static const GUID group = {0x12345678, 0x1234, 0x1234, {0x12, 0x34, 0x12, 0x34, 0x12, 0x34, 0x12, 0x34}};
+    IPersistStreamInit *persist_stream;
+    IOleCommandTarget *command_target;
+    IServiceProvider *provider;
+    IProvideClassInfo *info;
+    IPersistMoniker *persist;
+    IMoniker *moniker, *current;
+    WCHAR path[MAX_PATH];
+    IXMLDOMDocument *doc;
+    unsigned int i, id;
+    IBindCtx *bind_ctx;
+    TYPEATTR *attr;
+    ITypeInfo *ti;
+    IUnknown *out;
+    ULONG refs;
+    OLECMD cmd;
+    HRESULT hr;
+    CLSID clsid;
+    HANDLE file;
+    DWORD written;
+    BSTR name;
+
+    GetTempPathW(ARRAY_SIZE(path), path);
+    wcscat(path, L"msxml_moniker.xml");
+    file = CreateFileW(path, GENERIC_WRITE, 0, NULL, CREATE_ALWAYS, 0, NULL);
+    ok(file != INVALID_HANDLE_VALUE, "Failed to create the file.\n");
+    WriteFile(file, "<r/>", 4, &written, NULL);
+    CloseHandle(file);
+    hr = CreateFileMoniker(path, &moniker);
+    ok(hr == S_OK, "Unexpected hr %#lx.\n", hr);
+
+    for (i = 0; i < ARRAY_SIZE(classes); i++)
+    {
