+/* the type information of one of the coclasses of msxml's type library */
+HRESULT get_class_typeinfo(REFCLSID clsid, ITypeInfo **typeinfo)
+{
+    ITypeLib *typelib;
+    HRESULT hr;
+
+    if (FAILED(hr = get_typelib(LibXml2, &typelib))) return hr;
+    return ITypeLib_GetTypeInfoOfGuid(typelib, clsid, typeinfo);
+}
+
