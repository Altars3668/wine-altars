From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 6 Oct 2026 14:03:17 -0400
Subject: [PATCH] win32u: Leave the corner pixels partly outside a round window
 with a border colour to the driver.

They are on the border's arc, so the driver can draw them in its colour
over what is behind, as much as they are covered; the window drew them
blended with what is inside it.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>

diff --git a/dlls/win32u/dce.c b/dlls/win32u/dce.c
index 7777d14c497..1168bcfe97e 100644
--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -556,9 +556,11 @@ static BOOL frame_pixel_cut( UINT inside )
 /***********************************************************************
  *           create_frame_region
  *
- * The shape of a window of the given size whose corners the window manager rounds.
+ * The shape of a window of the given size whose corners the window manager rounds: without the
+ * pixels of the corners less than half inside, or with whole, without all those partly outside,
+ * which the driver may then draw as much as they are covered.
  */
-HRGN create_frame_region( int width, int height, UINT radius )
+HRGN create_frame_region( int width, int height, UINT radius, BOOL whole )
 {
     UINT x, y, inside, covered;
     HRGN region, cut;
@@ -571,7 +573,7 @@ HRGN create_frame_region( int width, int height, UINT radius )
         for (x = 0; x < radius; x++)
         {
             frame_corner_coverage( radius, 1, x, y, &inside, &covered );
-            if (!frame_pixel_cut( inside )) break;
+            if (whole ? inside == FRAME_SAMPLES * FRAME_SAMPLES : !frame_pixel_cut( inside )) break;
         }
         if (!x) break; /* the corners are cut less further from the edge */
         NtGdiSetRectRgn( cut, 0, y, x, y + 1 );
diff --git a/dlls/win32u/win32u_private.h b/dlls/win32u/win32u_private.h
index 6d6d7d4eb07..074681d3e9e 100644
--- a/dlls/win32u/win32u_private.h
+++ b/dlls/win32u/win32u_private.h
@@ -63,7 +63,7 @@ extern void window_surface_set_clip( struct window_surface *surface, HRGN clip_r
 extern void window_surface_set_layered( struct window_surface *surface, COLORREF color_key, UINT alpha_bits, UINT alpha_mask );
 extern void window_surface_set_frame( struct window_surface *surface, const SIZE *size, UINT radius, UINT border,
                                       COLORREF color );
-extern HRGN create_frame_region( int width, int height, UINT radius );
+extern HRGN create_frame_region( int width, int height, UINT radius, BOOL whole );
 
 /* defwnd.c */
 extern BOOL adjust_window_rect( RECT *rect, DWORD style, BOOL menu, DWORD ex_style, UINT dpi );
diff --git a/dlls/win32u/window.c b/dlls/win32u/window.c
index 74c428f996f..7e85be8d86a 100644
--- a/dlls/win32u/window.c
+++ b/dlls/win32u/window.c
@@ -2190,8 +2190,10 @@ static void update_surface_region( HWND hwnd )
         NtGdiDeleteObjectApp( region );
     }
     /* what the window manager rounds off comes on top of the window region; GetWindowRgn
-     * still returns the region the application set */
-    if (radius && (corners = create_frame_region( size.cx - 2 * inset, size.cy - 2 * inset, radius - inset )))
+     * still returns the region the application set.  With a border colour, the pixels its arc
+     * leaves partly outside show the colour over what is behind: the driver draws them there */
+    if (radius && (corners = create_frame_region( size.cx - 2 * inset, size.cy - 2 * inset, radius - inset,
+                                                  border && border_color != CLR_INVALID )))
     {
         NtGdiOffsetRgn( corners, inset, inset );
         if (!shape) shape = corners;
