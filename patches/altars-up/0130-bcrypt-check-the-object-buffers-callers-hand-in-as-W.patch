From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Fri, 25 Sep 2026 12:19:14 -0400
Subject: [PATCH] bcrypt: check the object buffers callers hand in, as Windows
 does, instead of printing that they are ignored.

Office hands an object buffer to every hash and key it makes, and Word's
start printed "ignoring object buffer" 270 times.  Windows keeps the
object in the buffer and gives a handle that points into it
(tools/bcryptobjectprobe); here objects are kept apart, which nothing
can tell but where the handle points, and what Windows checks is now
checked the same way for BCryptCreateHash, BCryptDuplicateHash,
BCryptGenerateSymmetricKey, BCryptImportKey and BCryptDuplicateKey:

- a buffer of no length is STATUS_BUFFER_TOO_SMALL;
- a length with no buffer is STATUS_INVALID_PARAMETER.

A buffer shorter than BCRYPT_OBJECT_LENGTH is still taken; Windows
takes one up to 22 bytes short for a hash and 30 for an AES key, which
is the alignment it allows for, and refuses shorter ones.  Also as on
Windows, BCryptCreateHash refuses a secret, even of no length, for an
algorithm that was not opened for HMAC.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 0fa94812655c080e7f53f828193b501a1bd0c6dd)

diff --git a/dlls/bcrypt/bcrypt_main.c b/dlls/bcrypt/bcrypt_main.c
index b812068e429..5e2c631216a 100644
--- a/dlls/bcrypt/bcrypt_main.c
+++ b/dlls/bcrypt/bcrypt_main.c
@@ -1410,6 +1410,16 @@ static NTSTATUS create_hash( const struct algorithm *alg, UCHAR *secret, ULONG s
     return STATUS_SUCCESS;
 }
 
+/* Windows keeps an object in the buffer a caller hands it, and the handle points into it; the objects here are
+ * kept apart, and the buffer is only checked as Windows checks it: one of no length is too small, and a length
+ * with no buffer is wrong. */
+static NTSTATUS check_object_buffer( const UCHAR *object, ULONG object_len )
+{
+    if (object && !object_len) return STATUS_BUFFER_TOO_SMALL;
+    if (!object && object_len) return STATUS_INVALID_PARAMETER;
+    return STATUS_SUCCESS;
+}
+
 NTSTATUS WINAPI BCryptCreateHash( BCRYPT_ALG_HANDLE handle, BCRYPT_HASH_HANDLE *ret_handle, UCHAR *object,
                                   ULONG object_len, UCHAR *secret, ULONG secret_len, ULONG flags )
 {
@@ -1423,10 +1433,9 @@ NTSTATUS WINAPI BCryptCreateHash( BCRYPT_ALG_HANDLE handle, BCRYPT_HASH_HANDLE *
         FIXME( "unimplemented flags %#lx\n", flags );
         return STATUS_NOT_IMPLEMENTED;
     }
-    if (object) FIXME( "ignoring object buffer\n" );
-
     if (!alg) return STATUS_INVALID_HANDLE;
     if (!ret_handle) return STATUS_INVALID_PARAMETER;
+    if ((status = check_object_buffer( object, object_len ))) return status;
 
     if ((status = create_hash( alg, secret, secret_len, flags, &hash ))) return status;
     *ret_handle = hash;
@@ -1440,12 +1449,13 @@ NTSTATUS WINAPI BCryptDuplicateHash( BCRYPT_HASH_HANDLE handle, BCRYPT_HASH_HAND
 {
     const struct hash *hash_orig = get_hash_object( handle );
     struct hash *hash_copy;
+    NTSTATUS status;
 
     TRACE( "%p, %p, %p, %lu, %#lx\n", handle, handle_copy, object, object_len, flags );
 
     if (!hash_orig) return STATUS_INVALID_HANDLE;
     if (!handle_copy) return STATUS_INVALID_PARAMETER;
-    if (object) FIXME( "ignoring object buffer\n" );
+    if ((status = check_object_buffer( object, object_len ))) return status;
 
     if (!(hash_copy = malloc( sizeof(*hash_copy) ))) return STATUS_NO_MEMORY;
 
@@ -1739,9 +1749,9 @@ NTSTATUS WINAPI BCryptGenerateSymmetricKey( BCRYPT_ALG_HANDLE handle, BCRYPT_KEY
     NTSTATUS status;
 
     TRACE( "%p, %p, %p, %lu, %p, %lu, %#lx\n", handle, ret_handle, object, object_len, secret, secret_len, flags );
-    if (object) FIXME( "ignoring object buffer\n" );
 
     if (!alg) return STATUS_INVALID_HANDLE;
+    if ((status = check_object_buffer( object, object_len ))) return status;
 
     if ((status = generate_symmetric_key( alg, secret, secret_len, &key ))) return status;
     *ret_handle = key;
@@ -2110,6 +2120,7 @@ NTSTATUS WINAPI BCryptImportKey( BCRYPT_ALG_HANDLE handle, BCRYPT_KEY_HANDLE dec
     if (!alg || !is_symmetric_alg( alg )) return STATUS_INVALID_HANDLE;
     if (!ret_handle || !type || !input) return STATUS_INVALID_PARAMETER;
     if (decrypt_key_handle && !(decrypt_key = get_key_object( decrypt_key_handle ))) return STATUS_INVALID_HANDLE;
+    if ((status = check_object_buffer( object, object_len ))) return status;
 
     if ((status = import_key( alg, decrypt_key, type, input, input_len, &key ))) return status;
     *ret_handle = key;
@@ -3701,10 +3712,10 @@ NTSTATUS WINAPI BCryptDuplicateKey( BCRYPT_KEY_HANDLE handle, BCRYPT_KEY_HANDLE
     NTSTATUS status;
 
     TRACE( "%p, %p, %p, %lu, %#lx\n", handle, handle_copy, object, object_len, flags );
-    if (object) FIXME( "ignoring object buffer\n" );
 
     if (!key_orig) return STATUS_INVALID_HANDLE;
     if (!handle_copy) return STATUS_INVALID_PARAMETER;
+    if ((status = check_object_buffer( object, object_len ))) return status;
 
     if ((status = duplicate_key( key_orig, &key_copy ))) return status;
     *handle_copy = key_copy;
diff --git a/dlls/bcrypt/tests/bcrypt.c b/dlls/bcrypt/tests/bcrypt.c
index fb7760a4d35..1b0e2ecc933 100644
--- a/dlls/bcrypt/tests/bcrypt.c
+++ b/dlls/bcrypt/tests/bcrypt.c
@@ -5578,6 +5578,85 @@ static void test_CHACHA20_POLY1305(void)
     ok(status == STATUS_SUCCESS, "got %#lx\n", status);
 }
 
+static void test_object_buffer(void)
+{
+    struct { BCRYPT_KEY_DATA_BLOB_HEADER hdr; UCHAR key[16]; } blob;
+    static UCHAR secret[16] = {1, 2, 3};
+    BCRYPT_ALG_HANDLE alg, hmac, aes;
+    BCRYPT_HASH_HANDLE hash, copy;
+    BCRYPT_KEY_HANDLE key, key_copy;
+    UCHAR object[2048];
+    ULONG length, size;
+    NTSTATUS status;
+
+    status = BCryptOpenAlgorithmProvider(&alg, BCRYPT_SHA256_ALGORITHM, NULL, 0);
+    ok(!status, "got %#lx\n", status);
+    status = BCryptOpenAlgorithmProvider(&hmac, BCRYPT_SHA256_ALGORITHM, NULL, BCRYPT_ALG_HANDLE_HMAC_FLAG);
+    ok(!status, "got %#lx\n", status);
+    status = BCryptGetProperty(alg, BCRYPT_OBJECT_LENGTH, (UCHAR *)&length, sizeof(length), &size, 0);
+    ok(!status, "got %#lx\n", status);
+
+    /* a buffer of no length is too small, and a length needs a buffer */
+    status = BCryptCreateHash(alg, &hash, object, 0, NULL, 0, 0);
+    ok(status == STATUS_BUFFER_TOO_SMALL, "got %#lx\n", status);
+    status = BCryptCreateHash(alg, &hash, NULL, length, NULL, 0, 0);
+    ok(status == STATUS_INVALID_PARAMETER, "got %#lx\n", status);
+    /* a secret is for an HMAC only, even one of no length */
+    status = BCryptCreateHash(alg, &hash, NULL, 0, secret, sizeof(secret), 0);
+    ok(status == STATUS_INVALID_PARAMETER, "got %#lx\n", status);
+    status = BCryptCreateHash(alg, &hash, NULL, 0, secret, 0, 0);
+    ok(status == STATUS_INVALID_PARAMETER, "got %#lx\n", status);
+    status = BCryptCreateHash(hmac, &hash, NULL, 0, secret, sizeof(secret), 0);
+    ok(!status, "got %#lx\n", status);
+    BCryptDestroyHash(hash);
+
+    status = BCryptCreateHash(alg, &hash, object, length, NULL, 0, 0);
+    ok(!status, "got %#lx\n", status);
+    status = BCryptDuplicateHash(hash, &copy, object + length, 0, 0);
+    ok(status == STATUS_BUFFER_TOO_SMALL, "got %#lx\n", status);
+    status = BCryptDuplicateHash(hash, &copy, NULL, length, 0);
+    ok(status == STATUS_INVALID_PARAMETER, "got %#lx\n", status);
+    status = BCryptDuplicateHash(hash, &copy, object + length, length, 0);
+    ok(!status, "got %#lx\n", status);
+    BCryptDestroyHash(copy);
+    BCryptDestroyHash(hash);
+    BCryptCloseAlgorithmProvider(hmac, 0);
+    BCryptCloseAlgorithmProvider(alg, 0);
+
+    status = BCryptOpenAlgorithmProvider(&aes, BCRYPT_AES_ALGORITHM, NULL, 0);
+    ok(!status, "got %#lx\n", status);
+    status = BCryptGetProperty(aes, BCRYPT_OBJECT_LENGTH, (UCHAR *)&length, sizeof(length), &size, 0);
+    ok(!status, "got %#lx\n", status);
+    status = BCryptGenerateSymmetricKey(aes, &key, object, 0, secret, sizeof(secret), 0);
+    ok(status == STATUS_BUFFER_TOO_SMALL, "got %#lx\n", status);
+    status = BCryptGenerateSymmetricKey(aes, &key, NULL, length, secret, sizeof(secret), 0);
+    ok(status == STATUS_INVALID_PARAMETER, "got %#lx\n", status);
+    status = BCryptGenerateSymmetricKey(aes, &key, object, length, secret, sizeof(secret), 0);
+    ok(!status, "got %#lx\n", status);
+
+    status = BCryptDuplicateKey(key, &key_copy, object + length, 0, 0);
+    ok(status == STATUS_BUFFER_TOO_SMALL, "got %#lx\n", status);
+    status = BCryptDuplicateKey(key, &key_copy, NULL, length, 0);
+    ok(status == STATUS_INVALID_PARAMETER, "got %#lx\n", status);
+    status = BCryptDuplicateKey(key, &key_copy, object + length, length, 0);
+    ok(!status, "got %#lx\n", status);
+    BCryptDestroyKey(key_copy);
+    BCryptDestroyKey(key);
+
+    blob.hdr.dwMagic = BCRYPT_KEY_DATA_BLOB_MAGIC;
+    blob.hdr.dwVersion = BCRYPT_KEY_DATA_BLOB_VERSION1;
+    blob.hdr.cbKeyData = sizeof(blob.key);
+    memcpy(blob.key, secret, sizeof(blob.key));
+    status = BCryptImportKey(aes, NULL, BCRYPT_KEY_DATA_BLOB, &key, object, 0, (UCHAR *)&blob, sizeof(blob), 0);
+    ok(status == STATUS_BUFFER_TOO_SMALL, "got %#lx\n", status);
+    status = BCryptImportKey(aes, NULL, BCRYPT_KEY_DATA_BLOB, &key, NULL, length, (UCHAR *)&blob, sizeof(blob), 0);
+    ok(status == STATUS_INVALID_PARAMETER, "got %#lx\n", status);
+    status = BCryptImportKey(aes, NULL, BCRYPT_KEY_DATA_BLOB, &key, object, length, (UCHAR *)&blob, sizeof(blob), 0);
+    ok(!status, "got %#lx\n", status);
+    BCryptDestroyKey(key);
+    BCryptCloseAlgorithmProvider(aes, 0);
+}
+
 START_TEST(bcrypt)
 {
     HMODULE module;
@@ -5621,6 +5700,7 @@ START_TEST(bcrypt)
     test_TLS_PRF();
     test_HKDF();
     test_CHACHA20_POLY1305();
+    test_object_buffer();
 
     FreeLibrary(module);
 }
