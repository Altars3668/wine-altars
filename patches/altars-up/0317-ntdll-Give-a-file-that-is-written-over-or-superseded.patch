From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 00:22:23 -0400
Subject: [PATCH] ntdll: Give a file that is written over or superseded the
 attributes asked for.

NtCreateFile() set the DOS attributes of a file it created and left an existing one it overwrote or
superseded as it was: FILE_OVERWRITE(_IF) with FILE_ATTRIBUTE_READONLY made no read-only file, and
superseding a read-only file kept it read-only.  The four attribute todos of test_NtCreateFile, and
the two of a read-only file that cannot be deleted, pass; kernel32's file test and the Office save
regression run as before.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/ntdll/tests/file.c b/dlls/ntdll/tests/file.c
index 9fab4e18ec1..53af9b896ef 100644
--- a/dlls/ntdll/tests/file.c
+++ b/dlls/ntdll/tests/file.c
@@ -3537,11 +3537,9 @@ static void test_file_disposition_information(void)
     ok( handle != INVALID_HANDLE_VALUE, "failed to create temp file\n" );
     fdi.DoDeleteFile = TRUE;
     res = pNtSetInformationFile( handle, &io, &fdi, sizeof fdi, FileDispositionInformation );
-    todo_wine
     ok( res == STATUS_CANNOT_DELETE, "unexpected FileDispositionInformation result (expected STATUS_CANNOT_DELETE, got %lx)\n", res );
     CloseHandle( handle );
     fileDeleted = GetFileAttributesA( buffer ) == INVALID_FILE_ATTRIBUTES && GetLastError() == ERROR_FILE_NOT_FOUND;
-    todo_wine
     ok( !fileDeleted, "File shouldn't have been deleted\n" );
     SetFileAttributesA( buffer, FILE_ATTRIBUTE_NORMAL );
     DeleteFileA( buffer );
@@ -5059,15 +5057,7 @@ static void test_NtCreateFile(void)
 
             ret = GetFileAttributesW(path);
             ret &= ~FILE_ATTRIBUTE_NOT_CONTENT_INDEXED;
-            /* FIXME: leave only 'else' case below once Wine is fixed */
-            if (ret != td[i].attrib_out)
-            {
-                todo_wine
-                ok(ret == td[i].attrib_out, "%ld: expected %#lx got %#lx\n", i, td[i].attrib_out, ret);
-                SetFileAttributesW(path, td[i].attrib_out);
-            }
-            else
-                ok(ret == td[i].attrib_out, "%ld: expected %#lx got %#lx\n", i, td[i].attrib_out, ret);
+            ok(ret == td[i].attrib_out, "%ld: expected %#lx got %#lx\n", i, td[i].attrib_out, ret);
 
             CloseHandle(handle);
         }
diff --git a/dlls/ntdll/unix/file.c b/dlls/ntdll/unix/file.c
index f95f59a6c8c..eb894c62dc0 100644
--- a/dlls/ntdll/unix/file.c
+++ b/dlls/ntdll/unix/file.c
@@ -4860,6 +4860,17 @@ NTSTATUS WINAPI NtCreateFile( HANDLE *handle, ACCESS_MASK access, OBJECT_ATTRIBU
                 if (needs_close) close( fd );
             }
         }
+        else if (io->Information == FILE_OVERWRITTEN || io->Information == FILE_SUPERSEDED)
+        {
+            int fd, needs_close;
+
+            /* a file written over takes the attributes given, as a new one does */
+            if (!server_get_unix_fd( *handle, 0, &fd, &needs_close, NULL, NULL ))
+            {
+                fd_set_file_info( fd, attributes, name_hidden );
+                if (needs_close) close( fd );
+            }
+        }
     }
     else if (status == STATUS_TOO_MANY_OPENED_FILES)
     {
