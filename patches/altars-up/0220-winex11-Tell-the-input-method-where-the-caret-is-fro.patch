From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Mon, 28 Sep 2026 14:52:23 -0400
Subject: [PATCH] winex11: Tell the input method where the caret is from the
 start, also on the spot.

Typing Chinese into Word through ibus, which takes the preedit through
callbacks, its candidate window stayed in the top left corner of the
screen: the caret position went to the input method only for the
over-the-spot style, only through an input context that already
existed, and the context is made when the window first gets focus or
a key, after Word has placed its caret.  fcitx, over the spot, drew its
window there too until the caret first moved.

The last caret rect of a window is now kept, given to its input
context when it is made, set again when the context gets the focus
(ibus passes on only the spot of the focused context, fcitx only a
spot that is set rather than given at creation), and for the
callbacks style as well.  As XNSpotLocation is on the baseline of the
line, it is the bottom of the caret rather than its top, so the
windows come below the line being written instead of over it.

NotifyIMEStatus used the input context of whichever window had the
focus, and for Word's document, a child with no X window, made one
with no client window: the preedit state and the reset on closing went
there, and the keyboard code, which takes the last window given an
input context for a top-level one, looked characters up through it.
It now uses the top-level window's, and a window with no X window gets
none.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 149ce1dc2cfde649244badec854d2d9de2645567)

diff --git a/dlls/winex11.drv/x11drv.h b/dlls/winex11.drv/x11drv.h
index 86136b1cb88..7950199dd0e 100644
--- a/dlls/winex11.drv/x11drv.h
+++ b/dlls/winex11.drv/x11drv.h
@@ -683,6 +683,7 @@ struct x11drv_win_data
     struct window_rects rects;  /* window rects in monitor DPI, relative to parent client area */
     struct host_window *parent; /* the host window parent, frame or embedder, NULL if root_window */
     XIC         xic;            /* X input context */
+    RECT        ime_rect;       /* last IME composition rect, in screen coordinates */
     UINT        managed : 1;    /* is window managed? */
     UINT        embedded : 1;   /* is window an XEMBED client? */
     UINT        shaped : 1;     /* is window using a custom region shape? */
@@ -695,6 +696,7 @@ struct x11drv_win_data
     UINT        parent_invalid : 1; /* is the parent host window possibly invalid */
     UINT        reparenting : 1; /* window is being reparented, likely from a decoration change */
     UINT        is_resizable : 1; /* window is allowed to be resized by the window manager */
+    UINT        has_ime_rect : 1; /* has an IME composition rect been set */
     HWND        anchor;         /* window this one is kept next to, for shadow and border windows */
     Window      embedder;       /* window id of embedder */
     Pixmap         icon_pixmap;
diff --git a/dlls/winex11.drv/xim.c b/dlls/winex11.drv/xim.c
index e1de83e3077..f03d79c5a59 100644
--- a/dlls/winex11.drv/xim.c
+++ b/dlls/winex11.drv/xim.c
@@ -364,7 +364,8 @@ void X11DRV_NotifyIMEStatus( HWND hwnd, UINT status )
 
     TRACE( "hwnd %p, status %#x\n", hwnd, status );
 
-    if (!(xic = X11DRV_get_ic( hwnd ))) return;
+    /* the input context is the top-level window's, whichever of its children has the focus */
+    if (!(xic = X11DRV_get_ic( NtUserGetAncestor( hwnd, GA_ROOT ) ))) return;
 
     if ((attr = XVaCreateNestedList( 0, XNPreeditState, state, NULL )))
     {
@@ -506,7 +507,21 @@ static BOOL xic_destroy( XIC xic, XPointer user, XPointer arg )
     return TRUE;
 }
 
-static XIC xic_create( XIM xim, HWND hwnd, Window win )
+/* where the input method is to place what it shows, relative to the window: the position of the next character on
+   the baseline of its line, the bottom left of the caret */
+static XPoint get_spot_location( struct x11drv_win_data *data )
+{
+    XPoint spot = {0};
+
+    if (data->has_ime_rect)
+    {
+        spot.x = data->ime_rect.left - data->rects.visible.left;
+        spot.y = data->ime_rect.bottom - data->rects.visible.top;
+    }
+    return spot;
+}
+
+static XIC xic_create( XIM xim, HWND hwnd, Window win, XPoint spot )
 {
     XICCallback destroy = {.callback = xic_destroy, .client_data = (XPointer)hwnd};
     XICCallback preedit_caret = {.callback = xic_preedit_caret, .client_data = (XPointer)hwnd};
@@ -517,12 +532,11 @@ static XIC xic_create( XIM xim, HWND hwnd, Window win )
     XICCallback status_done = {.callback = xic_status_done, .client_data = (XPointer)hwnd};
     XICCallback status_draw = {.callback = xic_status_draw, .client_data = (XPointer)hwnd};
     XICCallback status_start = {.callback = xic_status_start, .client_data = (XPointer)hwnd};
-    XPoint spot = {0};
     XVaNestedList preedit, status;
     XIC xic;
     XFontSet fontSet = x11drv_thread_data()->font_set;
 
-    TRACE( "xim %p, hwnd %p/%lx\n", xim, hwnd, win );
+    TRACE( "xim %p, hwnd %p/%lx, spot %d,%d\n", xim, hwnd, win, spot.x, spot.y );
 
     preedit = XVaCreateNestedList( 0, XNFontSet, fontSet,
                                    XNPreeditCaretCallback, &preedit_caret,
@@ -543,6 +557,14 @@ static XIC xic_create( XIM xim, HWND hwnd, Window win )
     XFree( preedit );
     XFree( status );
 
+    /* fcitx takes the spot only when it is set, not with the rest of the context */
+    if (xic && (spot.x || spot.y) && (input_style & (XIMPreeditPosition | XIMPreeditCallbacks)) &&
+        (preedit = XVaCreateNestedList( 0, XNSpotLocation, &spot, NULL )))
+    {
+        XSetICValues( xic, XNPreeditAttributes, preedit, NULL );
+        XFree( preedit );
+    }
+
     return xic;
 }
 
@@ -553,9 +575,15 @@ XIC X11DRV_get_ic( HWND hwnd )
     XIC ret;
 
     if (!(data = get_win_data( hwnd ))) return 0;
+    if (!data->whole_window)
+    {
+        /* a window with no X window of its own, a child, gets no input context of its own */
+        release_win_data( data );
+        return 0;
+    }
     x11drv_thread_data()->last_xic_hwnd = hwnd;
     if (!(ret = data->xic) && (xim = x11drv_thread_data()->xim))
-        ret = data->xic = xic_create( xim, hwnd, data->whole_window );
+        ret = data->xic = xic_create( xim, hwnd, data->whole_window, get_spot_location( data ) );
     release_win_data( data );
 
     return ret;
@@ -563,10 +591,29 @@ XIC X11DRV_get_ic( HWND hwnd )
 
 void xim_set_focus( HWND hwnd, BOOL focus )
 {
+    struct x11drv_win_data *data;
+    XVaNestedList attr;
+    XPoint spot;
     XIC xic;
+
     if (!(xic = X11DRV_get_ic( hwnd ))) return;
-    if (focus) XSetICFocus( xic );
-    else XUnsetICFocus( xic );
+    if (!focus)
+    {
+        XUnsetICFocus( xic );
+        return;
+    }
+    XSetICFocus( xic );
+
+    /* ibus passes on only the spot of the focused context */
+    if (!(input_style & (XIMPreeditPosition | XIMPreeditCallbacks))) return;
+    if (!(data = get_win_data( hwnd ))) return;
+    spot = get_spot_location( data );
+    if (data->has_ime_rect && (attr = XVaCreateNestedList( 0, XNSpotLocation, &spot, NULL )))
+    {
+        XSetICValues( xic, XNPreeditAttributes, attr, NULL );
+        XFree( attr );
+    }
+    release_win_data( data );
 }
 
 /***********************************************************************
@@ -578,17 +625,24 @@ BOOL X11DRV_SetIMECompositionRect( HWND hwnd, RECT rect )
     XVaNestedList attr;
     XPoint xpoint;
 
-    if (!(input_style & XIMPreeditPosition))
+    /* an input method drawing the preedit through callbacks still places its candidate window at the spot */
+    if (!(input_style & (XIMPreeditPosition | XIMPreeditCallbacks)))
         return FALSE;
 
-    if (!(data = get_win_data( hwnd )) || !data->xic)
+    TRACE( "hwnd %p, rect %s\n", hwnd, wine_dbgstr_rect( &rect ) );
+
+    if (!(data = get_win_data( hwnd ))) return FALSE;
+
+    /* kept for the input context, which is only made when the window first gets focus or a key */
+    data->ime_rect = rect;
+    data->has_ime_rect = TRUE;
+    if (!data->xic)
     {
-        if (data) release_win_data( data );
+        release_win_data( data );
         return FALSE;
     }
 
-    xpoint.x = rect.left - data->rects.visible.left;
-    xpoint.y = rect.top - data->rects.visible.top;
+    xpoint = get_spot_location( data );
     attr = XVaCreateNestedList( 0, XNSpotLocation, &xpoint, NULL );
     if (attr)
     {
