From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Wed, 30 Sep 2026 04:02:21 -0400
Subject: [PATCH] win32u: Answer for input already waiting before an alertable
 wait in MsgWaitForMultipleObjectsEx().

With a message waiting and a user APC queued, Windows returns for the
queue and leaves the APC queued, as user32's msg test shows: it checks
the queue before it waits.  Wine counted on the wait looking at its
objects before the APC.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>

diff --git a/dlls/win32u/message.c b/dlls/win32u/message.c
index d0102616498..32d3921cebb 100644
--- a/dlls/win32u/message.c
+++ b/dlls/win32u/message.c
@@ -3452,6 +3452,7 @@ static DWORD wait_message( DWORD count, const HANDLE *handles, DWORD timeout, DW
     void *ret_ptr;
     ULONG ret_len;
     HANDLE event;
+    BOOL signaled;
     DWORD ret;
 
     if ((abs = get_nt_timeout( &time, timeout )))
@@ -3467,11 +3468,16 @@ static DWORD wait_message( DWORD count, const HANDLE *handles, DWORD timeout, DW
         params.restore = TRUE;
     }
 
-    process_driver_events( QS_ALLINPUT, wake_mask, changed_mask );
+    signaled = process_driver_events( QS_ALLINPUT, wake_mask, changed_mask );
     if (!(changed_mask & QS_SMRESULT) && (event = get_user_thread_info()->idle_event)) NtSetEvent( event, NULL );
 
-    do ret = NtWaitForMultipleObjects( count, handles, type, !!(flags & MWMO_ALERTABLE), abs );
-    while (ret == count - 1 && !process_driver_events( QS_ALLINPUT, wake_mask, changed_mask ));
+    /* input already waiting is seen before the wait, which in an alertable one would run a queued APC first */
+    if (signaled && (flags & MWMO_ALERTABLE) && type == WaitAny) ret = count - 1;
+    else
+    {
+        do ret = NtWaitForMultipleObjects( count, handles, type, !!(flags & MWMO_ALERTABLE), abs );
+        while (ret == count - 1 && !process_driver_events( QS_ALLINPUT, wake_mask, changed_mask ));
+    }
 
     if (HIWORD(ret)) /* is it an error code? */
     {
