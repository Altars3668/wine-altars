+    if (upper < lower) return S_OK;
+    /* UNMEASURED: WPF refuses to load into ink that has strokes */
+    EnterCriticalSection(&ink->cs);
+    hr = list_empty(&ink->strokes) ? S_OK : E_UNEXPECTED;
+    LeaveCriticalSection(&ink->cs);
+    if (FAILED(hr))
+        return hr;
     size = (SIZE_T)((INT64)upper - lower + 1);
     if (FAILED(hr = SafeArrayAccessData(array, (void **)&raw)))
         return hr;
