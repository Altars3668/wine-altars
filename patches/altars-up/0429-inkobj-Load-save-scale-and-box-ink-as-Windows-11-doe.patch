-            format < IPF_InkSerializeFormat || format > IPF_Base64GIF) return E_INVALIDARG;
+    /* a format Windows 11 does not know is saved as ink serialized format, one compression mode it does not
+     * know is refused */
+    if (compression < IPCM_Default || compression > IPCM_NoCompression) return E_INVALIDARG;
     if (format == IPF_GIF || format == IPF_Base64GIF)
     {
+        BOOL empty;
+
+        /* there is no picture of no strokes on Windows 11 */
+        EnterCriticalSection(&ink->cs);
+        empty = list_empty(&ink->strokes);
+        LeaveCriticalSection(&ink->cs);
+        if (empty) return E_UNEXPECTED;
         FIXME("GIF persistence is not implemented.\n");
         return E_NOTIMPL;
     }
