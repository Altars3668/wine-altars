@@ -1262,18 +1263,42 @@ static HRESULT WINAPI stroke_Transform(IInkStrokeDisp *iface, IInkTransform *tra
 }
 
 /* the points' bounds are scaled onto the rectangle */
-static HRESULT scale_to_rectangle(const RECT *bounds, const RECT *target, XFORM *xform)
+/* the transform that maps the bounds onto the target, the target taken in by margins on each side */
+static HRESULT scale_to_rectangle_inset(const RECT *bounds, const RECT *target, float margin_x, float margin_y,
+        XFORM *xform)
 {
-    float sx = bounds->right > bounds->left ? (float)(target->right - target->left) / (bounds->right - bounds->left) : 1.0f;
-    float sy = bounds->bottom > bounds->top ? (float)(target->bottom - target->top) / (bounds->bottom - bounds->top) : 1.0f;
+    float left = target->left + margin_x, top = target->top + margin_y;
+    float width = target->right - target->left - 2 * margin_x, height = target->bottom - target->top - 2 * margin_y;
+    float sx = bounds->right > bounds->left ? width / (bounds->right - bounds->left) : 1.0f;
+    float sy = bounds->bottom > bounds->top ? height / (bounds->bottom - bounds->top) : 1.0f;
 
     xform_identity(xform);
     xform_translate(xform, -bounds->left, -bounds->top);
     xform_scale_by(xform, sx, sy);
-    xform_translate(xform, target->left, target->top);
+    xform_translate(xform, left, top);
     return S_OK;
 }
 
+static HRESULT scale_to_rectangle(const RECT *bounds, const RECT *target, XFORM *xform)
+{
+    return scale_to_rectangle_inset(bounds, target, 0.0f, 0.0f, xform);
+}
+
+/* A stroke scaled to a rectangle keeps its pen, so its points go where the pen's trace fits inside: Windows 11
+ * maps points from 1000 to 3000 onto a rectangle from 0 to 1000 as 26 to 974 with its pen 53 wide. */
+static HRESULT stroke_scale_to_rectangle(const struct stroke_data *data, const RECT *bounds, const RECT *target,
+        XFORM *xform)
+{
+    float width = 0.0f, height = 0.0f;
+    InkPenTip tip = IPT_Ball;
+
+    IInkDrawingAttributes_get_Width(data->attributes, &width);
+    IInkDrawingAttributes_get_PenTip(data->attributes, &tip);
+    if (tip == IPT_Rectangle) IInkDrawingAttributes_get_Height(data->attributes, &height);
+    else height = width;
+    return scale_to_rectangle_inset(bounds, target, width / 2.0f, height / 2.0f, xform);
+}
+
 static HRESULT WINAPI stroke_ScaleToRectangle(IInkStrokeDisp *iface, IInkRectangle *rectangle)
 {
     struct stroke *stroke = impl_from_IInkStrokeDisp(iface);
@@ -1286,7 +1311,7 @@ static HRESULT WINAPI stroke_ScaleToRectangle(IInkStrokeDisp *iface, IInkRectang
