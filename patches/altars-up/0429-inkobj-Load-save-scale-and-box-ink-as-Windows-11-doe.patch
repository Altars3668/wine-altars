     TRACE("iface %p, data %s.\n", iface, debugstr_variant(&data));
 
-    /* UNMEASURED: WPF refuses to load into ink that has strokes */
-    EnterCriticalSection(&ink->cs);
-    hr = list_empty(&ink->strokes) ? S_OK : E_UNEXPECTED;
-    LeaveCriticalSection(&ink->cs);
-    if (FAILED(hr))
-        return hr;
     if (V_VT(&data) == (VT_ARRAY | VT_UI1))
         array = V_ARRAY(&data);
     else if (V_VT(&data) == (VT_BYREF | VT_ARRAY | VT_UI1) && V_ARRAYREF(&data))
@@ -3194,7 +3221,15 @@ static HRESULT WINAPI ink_Load(IInkDisp *iface, VARIANT data)
     else
         return E_INVALIDARG;
     if (!array || SafeArrayGetDim(array) != 1 || FAILED(SafeArrayGetLBound(array, 1, &lower)) ||
-            FAILED(SafeArrayGetUBound(array, 1, &upper)) || upper < lower) return E_INVALIDARG;
+            FAILED(SafeArrayGetUBound(array, 1, &upper))) return E_INVALIDARG;
