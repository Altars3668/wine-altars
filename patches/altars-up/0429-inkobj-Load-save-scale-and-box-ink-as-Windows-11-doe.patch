-    scale_to_rectangle(&bounds, &target, &xform);
+    stroke_scale_to_rectangle(stroke->data, &bounds, &target, &xform);
     stroke_data_transform(stroke->data, &xform, FALSE);
     stroke_unlock(stroke, TRUE);
     return S_OK;
