From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Sat, 26 Sep 2026 20:33:16 -0400
Subject: [PATCH] d3d11, wined3d: reject invalid map flags and avoid waiting on
 queued work

Co-Authored-By: Claude Code <noreply@anthropic.com>
(cherry picked from commit ba6a991173454755fc279474ad51b16f8808f509)

diff --git a/dlls/d3d11/device.c b/dlls/d3d11/device.c
index 5cd58feb318..cdea3b57af7 100644
--- a/dlls/d3d11/device.c
+++ b/dlls/d3d11/device.c
@@ -814,14 +814,16 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_context_Map(ID3D11DeviceContext4 *
 
     TRACE("iface %p, resource %p, subresource_idx %u, map_type %u, map_flags %#x, mapped_subresource %p.\n",
             iface, resource, subresource_idx, map_type, map_flags, mapped_subresource);
+    mapped_subresource->pData = NULL;
+    if (map_flags & ~D3D11_MAP_FLAG_DO_NOT_WAIT)
+        return E_INVALIDARG;
+    if (map_flags & D3D11_MAP_FLAG_DO_NOT_WAIT &&
+        (map_type == D3D11_MAP_WRITE_DISCARD || map_type == D3D11_MAP_WRITE_NO_OVERWRITE))
+        return E_INVALIDARG;
+
     if (map_type != D3D11_MAP_READ)
         d3d_shared_resource_mark_dirty(resource);
 
-    if (map_flags)
-        FIXME("Ignoring map_flags %#x.\n", map_flags);
-
-    mapped_subresource->pData = NULL;
-
     if (context->type != D3D11_DEVICE_CONTEXT_IMMEDIATE
             && map_type != D3D11_MAP_WRITE_DISCARD && map_type != D3D11_MAP_WRITE_NO_OVERWRITE)
         return E_INVALIDARG;
@@ -829,7 +831,8 @@ static HRESULT STDMETHODCALLTYPE d3d11_device_context_Map(ID3D11DeviceContext4 *
     wined3d_resource = wined3d_resource_from_d3d11_resource(resource);
 
     if (SUCCEEDED(hr = wined3d_device_context_map(context->wined3d_context, wined3d_resource, subresource_idx,
-            &map_desc, NULL, wined3d_map_flags_from_d3d11_map_type(map_type))))
+            &map_desc, NULL, wined3d_map_flags_from_d3d11_map_type(map_type)
+            | (map_flags & D3D11_MAP_FLAG_DO_NOT_WAIT ? WINED3D_MAP_DONOTWAIT : 0))))
     {
         mapped_subresource->pData = map_desc.data;
         mapped_subresource->RowPitch = map_desc.row_pitch;
diff --git a/dlls/d3d11/tests/d3d11.c b/dlls/d3d11/tests/d3d11.c
index fc7acca2286..67406b6ee23 100644
--- a/dlls/d3d11/tests/d3d11.c
+++ b/dlls/d3d11/tests/d3d11.c
@@ -15591,6 +15591,72 @@ static void test_resource_map(void)
     ok(!refcount, "Device has %lu references left.\n", refcount);
 }
 
+static void test_map_do_not_wait(void)
+{
+    D3D11_TEXTURE2D_DESC texture_desc = {0};
+    D3D11_BUFFER_DESC buffer_desc = {0};
+    D3D11_MAPPED_SUBRESOURCE mapped;
+    ID3D11DeviceContext *context;
+    ID3D11Texture2D *texture;
+    ID3D11Buffer *buffer;
+    ID3D11Device *device;
+    HRESULT hr;
+
+    if (!(device = create_device(NULL)))
+    {
+        skip("Failed to create device.\n");
+        return;
+    }
+    ID3D11Device_GetImmediateContext(device, &context);
+
+    buffer_desc.ByteWidth = 4096;
+    buffer_desc.Usage = D3D11_USAGE_DYNAMIC;
+    buffer_desc.BindFlags = D3D11_BIND_VERTEX_BUFFER;
+    buffer_desc.CPUAccessFlags = D3D11_CPU_ACCESS_WRITE;
+    hr = ID3D11Device_CreateBuffer(device, &buffer_desc, NULL, &buffer);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        mapped.pData = (void *)0xdeadbeef;
+        hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)buffer, 0, D3D11_MAP_WRITE_DISCARD,
+                                    D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+        ok(hr == E_INVALIDARG && !mapped.pData, "Got hr %#lx, data %p.\n", hr, mapped.pData);
+        if (SUCCEEDED(hr)) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)buffer, 0);
+        mapped.pData = (void *)0xdeadbeef;
+        hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)buffer, 0, D3D11_MAP_WRITE_NO_OVERWRITE,
+                                    D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+        ok(hr == E_INVALIDARG && !mapped.pData, "Got hr %#lx, data %p.\n", hr, mapped.pData);
+        if (SUCCEEDED(hr)) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)buffer, 0);
+        ID3D11Buffer_Release(buffer);
+    }
+
+    texture_desc.Width = 64;
+    texture_desc.Height = 64;
+    texture_desc.MipLevels = 1;
+    texture_desc.ArraySize = 1;
+    texture_desc.Format = DXGI_FORMAT_R8G8B8A8_UNORM;
+    texture_desc.SampleDesc.Count = 1;
+    texture_desc.Usage = D3D11_USAGE_STAGING;
+    texture_desc.CPUAccessFlags = D3D11_CPU_ACCESS_READ | D3D11_CPU_ACCESS_WRITE;
+    hr = ID3D11Device_CreateTexture2D(device, &texture_desc, NULL, &texture);
+    ok(hr == S_OK, "Got hr %#lx.\n", hr);
+    if (SUCCEEDED(hr))
+    {
+        mapped.pData = (void *)0xdeadbeef;
+        hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)texture, 0, D3D11_MAP_READ, 2, &mapped);
+        ok(hr == E_INVALIDARG && !mapped.pData, "Got hr %#lx, data %p.\n", hr, mapped.pData);
+        if (SUCCEEDED(hr)) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)texture, 0);
+        mapped.pData = NULL;
+        hr = ID3D11DeviceContext_Map(context, (ID3D11Resource *)texture, 0, D3D11_MAP_READ_WRITE,
+                                    D3D11_MAP_FLAG_DO_NOT_WAIT, &mapped);
+        ok(hr == S_OK && !!mapped.pData, "Got hr %#lx, data %p.\n", hr, mapped.pData);
+        if (SUCCEEDED(hr)) ID3D11DeviceContext_Unmap(context, (ID3D11Resource *)texture, 0);
+        ID3D11Texture2D_Release(texture);
+    }
+    ID3D11DeviceContext_Release(context);
+    ID3D11Device_Release(device);
+}
+
 #define check_resource_cpu_access(a, b, c, d, e) check_resource_cpu_access_(__LINE__, a, b, c, d, e)
 static void check_resource_cpu_access_(unsigned int line, ID3D11DeviceContext *context,
         ID3D11Resource *resource, D3D11_USAGE usage, UINT bind_flags, UINT cpu_access)
@@ -37752,6 +37818,12 @@ START_TEST(d3d11)
         test_create_device_child();
         return;
     }
+    if (argc == 3 && !strcmp(argv[2], "--map-do-not-wait"))
+    {
+        use_warp_adapter = TRUE;
+        test_map_do_not_wait();
+        return;
+    }
 
     if ((wined3d = GetModuleHandleA("wined3d.dll")))
     {
@@ -37833,6 +37905,7 @@ START_TEST(d3d11)
     queue_test(test_copy_subresource_region_1d);
     queue_test(test_copy_subresource_region_3d);
     queue_test(test_resource_map);
+    queue_test(test_map_do_not_wait);
     queue_for_each_feature_level(test_resource_access);
     queue_test(test_check_multisample_quality_levels);
     queue_for_each_feature_level(test_swapchain_formats);
diff --git a/dlls/wined3d/cs.c b/dlls/wined3d/cs.c
index 050da34e3b0..a15b9701698 100644
--- a/dlls/wined3d/cs.c
+++ b/dlls/wined3d/cs.c
@@ -2583,6 +2583,8 @@ HRESULT wined3d_device_context_emit_map(struct wined3d_device_context *context,
 
     TRACE_(d3d_perf)("Mapping resource %p (type %u), flags %#x through the CS.\n", resource, resource->type, flags);
 
+    if (flags & WINED3D_MAP_DONOTWAIT && wined3d_resource_is_busy(resource))
+        return DXGI_ERROR_WAS_STILL_DRAWING;
     wined3d_resource_wait_idle(resource);
 
     /* We might end up invalidating the resource on the CS thread. */
diff --git a/dlls/wined3d/wined3d_private.h b/dlls/wined3d/wined3d_private.h
index 42d41368751..e6652192c70 100644
--- a/dlls/wined3d/wined3d_private.h
+++ b/dlls/wined3d/wined3d_private.h
@@ -3864,6 +3864,20 @@ static inline BOOL wined3d_ge_wrap(ULONG x, ULONG y)
 }
 C_ASSERT(WINED3D_CS_QUEUE_SIZE < UINT_MAX / 4);
 
+/* This detects queued CS work; a backend GPU fence may outlive the queue entry. */
+static inline BOOL wined3d_resource_is_busy(const struct wined3d_resource *resource)
+{
+    const struct wined3d_cs *cs = resource->device->cs;
+    ULONG access_time, tail, head;
+
+    if (!cs->thread || cs->thread_id == GetCurrentThreadId()) return FALSE;
+    access_time = resource->access_time;
+    head = cs->queue[WINED3D_CS_QUEUE_DEFAULT].head;
+    if (!wined3d_ge_wrap(head, access_time)) return FALSE;
+    tail = *(volatile ULONG *)&cs->queue[WINED3D_CS_QUEUE_DEFAULT].tail;
+    return head != tail && (wined3d_ge_wrap(access_time, tail) || access_time == tail);
+}
+
 static inline void wined3d_resource_wait_idle(const struct wined3d_resource *resource)
 {
     const struct wined3d_cs *cs = resource->device->cs;
