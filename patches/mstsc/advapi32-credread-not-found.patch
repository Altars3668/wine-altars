--- a/include/wincred.h
+++ b/include/wincred.h
@@ -216,7 +216,8 @@
 #define CRED_TYPE_DOMAIN_CERTIFICATE                3
 #define CRED_TYPE_DOMAIN_VISIBLE_PASSWORD           4
 #define CRED_TYPE_GENERIC_CERTIFICATE               5
-#define CRED_TYPE_MAXIMUM                           6
+#define CRED_TYPE_DOMAIN_EXTENDED                   6
+#define CRED_TYPE_MAXIMUM                           7
 #define CRED_TYPE_MAXIMUM_EX                        (CRED_TYPE_MAXIMUM+1000)
 
 /* values for CREDENTIAL::Persist */
--- a/dlls/advapi32/cred.c
+++ b/dlls/advapi32/cred.c
@@ -1259,8 +1259,23 @@
 
     if (Type != CRED_TYPE_GENERIC && Type != CRED_TYPE_DOMAIN_PASSWORD)
     {
-        FIXME("unhandled type %ld\n", Type);
-        SetLastError(ERROR_INVALID_PARAMETER);
+        /*
+         * Only these two types are stored here. For the others -- certificates,
+         * and the extended domain credential a Network Level Authentication
+         * client looks up before it opens a connection -- the truthful answer
+         * is that this machine has none saved, which is ERROR_NOT_FOUND.
+         * Callers act on the difference: not-found sends them on to whatever
+         * credentials they were given, while invalid-parameter says the call
+         * itself was wrong and they abandon what they were doing.
+         */
+        if (!Type || Type >= CRED_TYPE_MAXIMUM)
+        {
+            WARN("type %ld is not a credential type\n", Type);
+            SetLastError(ERROR_INVALID_PARAMETER);
+            return FALSE;
+        }
+        TRACE("no credentials of type %ld are stored here\n", Type);
+        SetLastError(ERROR_NOT_FOUND);
         return FALSE;
     }
 
