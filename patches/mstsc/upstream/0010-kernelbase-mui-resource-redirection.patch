+BOOL WINAPI DECLSPEC_HOTPATCH EnumResourceTypesExW( HMODULE module, ENUMRESTYPEPROCW func, LONG_PTR param,
+                                                    DWORD flags, LANGID lang )
+{
+    const IMAGE_RESOURCE_DIRECTORY *resdir;
+    BOOL ret = FALSE;
+
+    TRACE( "%p %p %Ix\n", module, func, param );
+
+    if (!flags) flags = RESOURCE_ENUM_LN | RESOURCE_ENUM_MUI;
+
+    if (!module) module = GetModuleHandleW( 0 );
+
+    /* A module whose resources were split into a .mui has none of its own, so
+     * enumerating only the module reports nothing while FindResource finds
+     * everything -- the two have to agree about what a module contains. The
+     * callback is handed the module that was asked about rather than the .mui,
+     * since that is the handle it will pass back to FindResource. */
+    if (flags & RESOURCE_ENUM_MUI)
+    {
+        HMODULE mui = get_module_mui( module );
+
+        if (mui && mui != module &&
+            set_ntstatus( LdrFindResourceDirectory_U( mui, NULL, 0, &resdir )))
+            ret = enum_resource_types_dir( module, resdir, func, param );
+    }
+
+    if (!(flags & RESOURCE_ENUM_LN)) return ret;
+
+    if (!set_ntstatus( LdrFindResourceDirectory_U( module, NULL, 0, &resdir ))) return ret;
+
+    return enum_resource_types_dir( module, resdir, func, param );
+}
+
+
+/***********************************************************************
+ * MUI resource redirection
+ *
+ * Windows keeps a module's localisable resources -- dialogs, strings, menus --
+ * in a separate <dir>\<language>\<module>.mui file, and its loader redirects
+ * resource lookups there when the module itself has none. A module built that
+ * way carries no RT_DIALOG and no RT_STRING at all, so without the redirection
+ * every dialog it opens and every string it loads fails, and code that reads a
+ * failed dialog as a refusal takes decisions nobody made.
+ *
+ * The .mui is mapped as a data file, which LdrFindResource_U and
+ * LdrAccessResource already handle. What they cannot do is tell that an HRSRC
+ * belongs to a different module than the caller passed, so LoadResource checks
+ * which of the two the pointer actually lies in.
+ ***********************************************************************/
+
+struct mui_module
+{
+    struct list entry;
+    HMODULE     module;
+    HMODULE     mui;      /* NULL once looked for and not found */
+};
+
+static struct list mui_list = LIST_INIT( mui_list );
+
+static CRITICAL_SECTION mui_section;
+static CRITICAL_SECTION_DEBUG mui_critsect_debug =
+{
+    0, 0, &mui_section,
+    { &mui_critsect_debug.ProcessLocksList, &mui_critsect_debug.ProcessLocksList },
+      0, 0, { (DWORD_PTR)(__FILE__ ": mui_section") }
+};
+static CRITICAL_SECTION mui_section = { &mui_critsect_debug, -1, 0, 0, 0, 0 };
+
+/* Where a module's .mui would be, for one language. */
+static HMODULE load_mui_for_language( const WCHAR *path, const WCHAR *lang )
+{
+    WCHAR *full, *file;
+    HMODULE ret;
+    SIZE_T len;
+
+    if (!(file = wcsrchr( path, '\\' ))) return NULL;
+
+    len = wcslen( path ) + wcslen( lang ) + ARRAY_SIZE(L"\\.mui") + 1;
+    if (!(full = HeapAlloc( GetProcessHeap(), 0, len * sizeof(WCHAR) ))) return NULL;
+
+    memcpy( full, path, (file - path + 1) * sizeof(WCHAR) );
+    full[file - path + 1] = 0;
+    wcscat( full, lang );
+    wcscat( full, L"\\" );
+    wcscat( full, file + 1 );
+    wcscat( full, L".mui" );
+
+    ret = LoadLibraryExW( full, 0, LOAD_LIBRARY_AS_DATAFILE );
+    TRACE( "%s -> %p\n", debugstr_w(full), ret );
+    HeapFree( GetProcessHeap(), 0, full );
+    return ret;
+}
+
+/* The languages to try, in the order Windows would: the user's preferences,
+ * then the system's, then the language the module was built in. */
+static HMODULE find_module_mui( HMODULE module )
+{
+    WCHAR path[MAX_PATH], langs[256];
+    ULONG count = 0, size = ARRAY_SIZE(langs);
+    const WCHAR *lang;
+    HMODULE ret = NULL;
+
+    if (!GetModuleFileNameW( module, path, ARRAY_SIZE(path) )) return NULL;
+
+    if (GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, langs, &size ))
+    {
+        for (lang = langs; *lang; lang += wcslen( lang ) + 1)
+            if ((ret = load_mui_for_language( path, lang ))) return ret;
+    }
+
+    count = 0;
+    size = ARRAY_SIZE(langs);
+    if (GetSystemPreferredUILanguages( MUI_LANGUAGE_NAME, &count, langs, &size ))
+    {
+        for (lang = langs; *lang; lang += wcslen( lang ) + 1)
+            if ((ret = load_mui_for_language( path, lang ))) return ret;
+    }
+
+    /* Almost everything ships en-US whatever else it ships. */
+    return load_mui_for_language( path, L"en-US" );
+}
+
+static HMODULE get_module_mui( HMODULE module )
+{
+    struct mui_module *entry;
+    HMODULE ret;
+
+    if (!module) return NULL;
+
+    RtlEnterCriticalSection( &mui_section );
+    LIST_FOR_EACH_ENTRY( entry, &mui_list, struct mui_module, entry )
+    {
+        if (entry->module == module)
+        {
+            ret = entry->mui;
+            RtlLeaveCriticalSection( &mui_section );
+            return ret;
+        }
+    }
+    RtlLeaveCriticalSection( &mui_section );
+
+    ret = find_module_mui( module );
+
+    RtlEnterCriticalSection( &mui_section );
+    /* Another thread may have got there first; one extra mapping is harmless
+     * and the list must not gain two entries for the same module. */
+    LIST_FOR_EACH_ENTRY( entry, &mui_list, struct mui_module, entry )
+    {
+        if (entry->module == module)
+        {
+            HMODULE other = entry->mui;
+            RtlLeaveCriticalSection( &mui_section );
+            if (ret && ret != other) FreeLibrary( ret );
+            return other;
+        }
+    }
+    if ((entry = HeapAlloc( GetProcessHeap(), 0, sizeof(*entry) )))
+    {
+        entry->module = module;
+        entry->mui = ret;
+        list_add_tail( &mui_list, &entry->entry );
+    }
+    RtlLeaveCriticalSection( &mui_section );
+    return ret;
+}
+
+/* An HRSRC points into its module's resource directory, which is how the
+ * owning module can be identified after the fact. */
+static BOOL rsrc_belongs_to( HMODULE module, HRSRC rsrc )
+{
+    const char *base;
+    ULONG size = 0;
+
+    if (!module) return FALSE;
+    if (!(base = RtlImageDirectoryEntryToData( module, TRUE, IMAGE_DIRECTORY_ENTRY_RESOURCE, &size )))
+        return FALSE;
+    return (const char *)rsrc >= base && (const char *)rsrc < base + size;
+}
+
 
 /**********************************************************************
  *	    FindResourceExW  (kernelbase.@)
@@ -1075,7 +1267,14 @@
         info.Type = (ULONG_PTR)typeW.Buffer;
         info.Name = (ULONG_PTR)nameW.Buffer;
         info.Language = lang;
-        status = LdrFindResource_U( module, &info, 3, &entry );
+        if ((status = LdrFindResource_U( module, &info, 3, &entry )))
+        {
+            HMODULE mui = get_module_mui( module );
+
+            /* A module whose resources live in a .mui has none of its own to
+             * find, so this is the normal path for it rather than a fallback. */
+            if (mui) status = LdrFindResource_U( mui, &info, 3, &entry );
+        }
     done:
         if (status != STATUS_SUCCESS) SetLastError( RtlNtStatusToDosError(status) );
     }
@@ -1120,6 +1319,16 @@
 
     if (!rsrc) return 0;
     if (!module) module = GetModuleHandleW( 0 );
+
+    if (!rsrc_belongs_to( module, rsrc ))
+    {
+        HMODULE mui = get_module_mui( module );
+
+        /* FindResourceEx answered out of the .mui, so the offset in the entry
+         * is relative to that file and not to the module asked about here. */
+        if (rsrc_belongs_to( mui, rsrc )) module = mui;
+    }
+
     if (!set_ntstatus( LdrAccessResource( module, (IMAGE_RESOURCE_DATA_ENTRY *)rsrc, &ret, NULL )))
         return 0;
     return ret;
--- a/dlls/kernelbase/locale.c
+++ b/dlls/kernelbase/locale.c
@@ -5957,9 +5957,72 @@
                                                     WCHAR *muipath, ULONG *muipathlen,
                                                     ULONGLONG *enumerator )
 {
-    FIXME( "stub: 0x%lx, %s, %s, %p, %p, %p, %p\n", flags, debugstr_w(filepath),
+    WCHAR langs[256], path[MAX_PATH], *file;
+    ULONG count = 0, size = ARRAY_SIZE(langs), len;
+    const WCHAR *lang;
+
+    TRACE( "0x%lx, %s, %s, %p, %p, %p, %p\n", flags, debugstr_w(filepath),
            debugstr_w(language), languagelen, muipath, muipathlen, enumerator );
-    SetLastError( ERROR_CALL_NOT_IMPLEMENTED );
+
+    if (!filepath || !muipathlen)
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    /* Only the first match is reported; enumerating the rest would need state
+     * to carry between calls, and nothing has asked for it. */
+    if (enumerator && *enumerator)
+    {
+        SetLastError( ERROR_NO_MORE_FILES );
+        return FALSE;
+    }
+
+    if (!(file = wcsrchr( filepath, '\\' )))
+    {
+        SetLastError( ERROR_INVALID_PARAMETER );
+        return FALSE;
+    }
+
+    if (language && languagelen && *languagelen)
+    {
+        /* A caller that names a language wants that one or nothing. */
+        lstrcpynW( langs, language, min( *languagelen, ARRAY_SIZE(langs) - 1 ));
+        langs[min( *languagelen, ARRAY_SIZE(langs) - 1 )] = 0;
+        langs[wcslen( langs ) + 1] = 0;
+    }
+    else if (!GetUserPreferredUILanguages( MUI_LANGUAGE_NAME, &count, langs, &size ))
+    {
+        wcscpy( langs, L"en-US" );
+        langs[wcslen( langs ) + 1] = 0;
+    }
+
+    for (lang = langs; *lang; lang += wcslen( lang ) + 1)
+    {
+        len = swprintf( path, ARRAY_SIZE(path), L"%.*s%s\\%s.mui",
+                        (int)(file - filepath + 1), filepath, lang, file + 1 );
+        if (GetFileAttributesW( path ) == INVALID_FILE_ATTRIBUTES) continue;
+
+        if (!muipath || *muipathlen <= len)
+        {
+            *muipathlen = len + 1;
+            SetLastError( ERROR_INSUFFICIENT_BUFFER );
+            return FALSE;
+        }
+        wcscpy( muipath, path );
+        *muipathlen = len + 1;
+
+        if (language && languagelen)
+        {
+            len = wcslen( lang );
+            if (*languagelen > len) wcscpy( language, lang );
+            *languagelen = len + 1;
+        }
+        if (enumerator) *enumerator = 1;
+        return TRUE;
+    }
+
+    SetLastError( ERROR_FILE_NOT_FOUND );
     return FALSE;
 }
 
