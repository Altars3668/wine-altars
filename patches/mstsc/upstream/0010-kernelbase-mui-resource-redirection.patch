+BOOL WINAPI DECLSPEC_HOTPATCH EnumResourceNamesExW( HMODULE module, LPCWSTR type, ENUMRESNAMEPROCW func,
+                                                    LONG_PTR param, DWORD flags, LANGID lang )
+{
+    BOOL ret = FALSE;
+
+    TRACE( "%p %s %p %Ix\n", module, debugstr_w(type), func, param );
+
+    if (flags & (RESOURCE_ENUM_MUI_SYSTEM | RESOURCE_ENUM_VALIDATE))
+        FIXME( "unimplemented flags: %lx\n", flags );
+
+    if (!flags) flags = RESOURCE_ENUM_LN | RESOURCE_ENUM_MUI;
+
+    if (!module) module = GetModuleHandleW( 0 );
+
+    /* As in EnumResourceTypesExW: a split module's names are in its .mui, and
+     * the callback is told about the module rather than the file. */
+    if (flags & RESOURCE_ENUM_MUI)
+    {
+        HMODULE mui = get_module_mui( module );
+
+        if (mui && mui != module) ret = enum_resource_names_in( mui, module, type, func, param );
+    }
+
+    if (!(flags & RESOURCE_ENUM_LN)) return ret;
+
+    return enum_resource_names_in( module, module, type, func, param );
+}
 
 
