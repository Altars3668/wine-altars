From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Subject: [PATCH] ole32: Implement OleGetClipboardWithEnterpriseInfo().

OleGetClipboard plus what Windows Information Protection knows about the
data on the clipboard. Wine enforces no such policy, so all four out-strings
are NULL and callers read the data as unmanaged.

Signed-off-by: AltarsCN <337293323+Altars3668@users.noreply.github.com>
---
--- a/dlls/ole32/clipboard.c
+++ b/dlls/ole32/clipboard.c
@@ -2262,6 +2262,34 @@
     return S_OK;
 }
 
+/***********************************************************************
+ *           OleGetClipboardWithEnterpriseInfo [OLE32.@]
+ *
+ * OleGetClipboard, plus what Windows Information Protection knows about the
+ * data on the clipboard: which enterprise owns it, and how to describe the
+ * parties if policy blocks a paste.
+ *
+ * Wine enforces no such policy, so the data belongs to no enterprise and there
+ * is nothing to describe. Returning NULL for all four is the accurate answer,
+ * and callers read it as "unmanaged", which is correct.
+ */
+HRESULT WINAPI OleGetClipboardWithEnterpriseInfo(IDataObject **obj, WCHAR **data_enterprise_id,
+                                                 WCHAR **source_description,
+                                                 WCHAR **target_description,
+                                                 WCHAR **data_description)
+{
+    TRACE("(%p, %p, %p, %p, %p)\n", obj, data_enterprise_id, source_description,
+          target_description, data_description);
+
+    if (data_enterprise_id) *data_enterprise_id = NULL;
+    if (source_description) *source_description = NULL;
+    if (target_description) *target_description = NULL;
+    if (data_description) *data_description = NULL;
+
+    return OleGetClipboard(obj);
+}
+
+
 /******************************************************************************
  *              OleFlushClipboard        [OLE32.@]
  *  Renders the data from the source IDataObject into the windows clipboard
--- a/dlls/ole32/ole32.spec
+++ b/dlls/ole32/ole32.spec
@@ -213,6 +213,7 @@
 @ stdcall OleFlushClipboard()
 @ stdcall OleGetAutoConvert(ptr ptr)
 @ stdcall OleGetClipboard(ptr)
+@ stdcall OleGetClipboardWithEnterpriseInfo(ptr ptr ptr ptr ptr)
 @ stdcall OleGetIconOfClass(ptr ptr long)
 @ stdcall OleGetIconOfFile(wstr long)
 @ stdcall OleInitialize(ptr)
