 /***********************************************************************
+ *              CM_Open_DevNode_Key  (SETUPAPI.@)
+ *
+ * The registry key holding a device's parameters: either its own, under Enum,
+ * or its driver's, under Control\Class. Returning CR_SUCCESS without opening
+ * anything -- as this did while it was a stub -- hands the caller an
+ * uninitialised handle, so a device that cannot be resolved has to fail.
+ */
+CONFIGRET WINAPI CM_Open_DevNode_Key(DEVINST devnode, REGSAM access, ULONG profile,
+                                     REGDISPOSITION disposition, HKEY *key, ULONG flags)
+{
+    WCHAR path[MAX_PATH], driver[MAX_PATH];
+    HKEY enum_key = NULL, device = NULL;
+    DWORD size, type;
+    LSTATUS status;
+
+    TRACE("%lu, %#lx, %lu, %d, %p, %#lx\n", devnode, access, profile, disposition, key, flags);
+
+    if (!key) return CR_INVALID_POINTER;
+    if (flags & ~(CM_REGISTRY_HARDWARE | CM_REGISTRY_SOFTWARE | CM_REGISTRY_USER | CM_REGISTRY_CONFIG))
+        return CR_INVALID_FLAG;
+    if (disposition != RegDisposition_OpenAlways && disposition != RegDisposition_OpenExisting)
+        return CR_INVALID_FLAG;
+
+    if (devnode >= devinst_table_size || !devinst_table[devnode])
+        return CR_NO_SUCH_DEVINST;
+
+    if (RegOpenKeyExW(HKEY_LOCAL_MACHINE, Enum, 0, KEY_READ, &enum_key))
+        return CR_REGISTRY_ERROR;
+    status = RegOpenKeyExW(enum_key, devinst_table[devnode], 0, KEY_READ, &device);
+    RegCloseKey(enum_key);
+    if (status)
+        return CR_NO_SUCH_DEVNODE;
+
+    switch (flags & (CM_REGISTRY_SOFTWARE | CM_REGISTRY_USER | CM_REGISTRY_CONFIG))
+    {
+    case CM_REGISTRY_HARDWARE:
+        status = (disposition == RegDisposition_OpenExisting)
+            ? RegOpenKeyExW(device, L"Device Parameters", 0, access, key)
+            : RegCreateKeyExW(device, L"Device Parameters", 0, NULL, 0, access, NULL, key, NULL);
+        break;
+
+    case CM_REGISTRY_SOFTWARE:
+        /* The software key is named by the device's Driver value: a class GUID
+         * and an index below Control\Class. */
+        size = sizeof(driver);
+        if (RegQueryValueExW(device, L"Driver", NULL, &type, (BYTE *)driver, &size) || type != REG_SZ)
+        {
+            RegCloseKey(device);
+            return CR_NO_SUCH_VALUE;
+        }
+        driver[ARRAY_SIZE(driver) - 1] = 0;
+        swprintf(path, ARRAY_SIZE(path), L"%s\\%s", ControlClass, driver);
+        status = (disposition == RegDisposition_OpenExisting)
+            ? RegOpenKeyExW(HKEY_LOCAL_MACHINE, path, 0, access, key)
+            : RegCreateKeyExW(HKEY_LOCAL_MACHINE, path, 0, NULL, 0, access, NULL, key, NULL);
+        break;
+
+    default:
+        /* Per-user and per-hardware-profile keys; nothing here keeps them. */
+        FIXME("unsupported registry branch %#lx\n", flags);
+        RegCloseKey(device);
+        return CR_CALL_NOT_IMPLEMENTED;
+    }
+
+    RegCloseKey(device);
+    if (status)
+        return status == ERROR_FILE_NOT_FOUND ? CR_NO_SUCH_VALUE : CR_REGISTRY_ERROR;
+
+    return CR_SUCCESS;
+}
+
+/***********************************************************************
+ *              CM_Open_DevNode_Key_Ex  (SETUPAPI.@)
+ */
+CONFIGRET WINAPI CM_Open_DevNode_Key_Ex(DEVINST devnode, REGSAM access, ULONG profile,
+                                        REGDISPOSITION disposition, HKEY *key, ULONG flags,
+                                        HMACHINE machine)
+{
+    TRACE("%lu, %#lx, %lu, %d, %p, %#lx, %p\n", devnode, access, profile, disposition,
+          key, flags, machine);
+
+    /* CM_Connect_Machine fails here, so no caller can hold a valid handle. */
+    if (machine) return CR_INVALID_MACHINENAME;
+
+    return CM_Open_DevNode_Key(devnode, access, profile, disposition, key, flags);
+}
+
