--- a/dlls/msmpeg2vdec/msmpeg2vdec.c
+++ b/dlls/msmpeg2vdec/msmpeg2vdec.c
@@ -67,6 +67,29 @@
             ARRAY_SIZE(h264_decoder_mft_outputs), h264_decoder_mft_outputs, NULL)))
         return hr;
 
+    /*
+     * The HEVC decoder lives in winegstreamer and is registered from here
+     * rather than from there: winegstreamer delay-imports mfplat, and calling
+     * into it from that DLL's DllRegisterServer hangs regsvr32. Callers look
+     * for a decoder by media type, so without this registration the transform
+     * exists and nobody can reach it.
+     */
+    {
+        static const GUID CLSID_wg_hevc_decoder = {0x9dfcdf2e,0xf605,0x4f1d,
+                {0xb6,0xa7,0x9e,0xd7,0x72,0xbb,0x42,0x52}};
+        MFT_REGISTER_TYPE_INFO hevc_inputs[] =
+        {
+            {MFMediaType_Video, MFVideoFormat_HEVC},
+            {MFMediaType_Video, MFVideoFormat_HEVC_ES},
+        };
+
+        if (FAILED(hr = MFTRegister((GUID)CLSID_wg_hevc_decoder, MFT_CATEGORY_VIDEO_DECODER,
+                (WCHAR *)L"GStreamer HEVC Video Decoder MFT", MFT_ENUM_FLAG_SYNCMFT,
+                ARRAY_SIZE(hevc_inputs), hevc_inputs,
+                ARRAY_SIZE(h264_decoder_mft_outputs), h264_decoder_mft_outputs, NULL)))
+            return hr;
+    }
+
     return S_OK;
 }
 
