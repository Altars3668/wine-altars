+#ifndef __WINE_SRPAPI_H
+#define __WINE_SRPAPI_H
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef enum _ENTERPRISE_DATA_POLICIES
+{
+    ENTERPRISE_POLICY_NONE       = 0x00,
+    ENTERPRISE_POLICY_ENLIGHTENED = 0x01,
+    ENTERPRISE_POLICY_ALLOWED    = 0x02,
+    ENTERPRISE_POLICY_EXEMPT     = 0x04,
+} ENTERPRISE_DATA_POLICIES;
+
+typedef enum _SRPHOSTING_TYPE
+{
+    SRPHOSTING_TYPE_INVALID  = 0,
+    SRPHOSTING_TYPE_OLE32    = 1,
+    SRPHOSTING_TYPE_RPCSS    = 2,
+    SRPHOSTING_TYPE_MAX      = 3,
+} SRPHOSTING_TYPE;
+
+typedef struct _HTHREAD_NETWORK_CONTEXT
+{
+    DWORD  threadId;
+    HANDLE threadContext;
+} HTHREAD_NETWORK_CONTEXT, *PHTHREAD_NETWORK_CONTEXT;
+
+HRESULT WINAPI SrpCloseThreadNetworkContext(HTHREAD_NETWORK_CONTEXT*);
+HRESULT WINAPI SrpCreateThreadNetworkContext(const WCHAR*,HTHREAD_NETWORK_CONTEXT*);
+HRESULT WINAPI SrpDisablePermissiveModeFileEncryption(void);
+HRESULT WINAPI SrpDoesPolicyAllowAppExecution(const void*,BOOL*);
+HRESULT WINAPI SrpEnablePermissiveModeFileEncryption(const WCHAR*);
+HRESULT WINAPI SrpGetAllowedEnterprises(HANDLE,DWORD*,WCHAR**,DWORD*);
+HRESULT WINAPI SrpGetEnterpriseIds(HANDLE,DWORD*,WCHAR**,DWORD*);
+HRESULT WINAPI SrpGetEnterprisePolicy(HANDLE,ENTERPRISE_DATA_POLICIES*);
+HRESULT WINAPI SrpHostingInitialize(SRPHOSTING_TYPE);
+void    WINAPI SrpHostingTerminate(SRPHOSTING_TYPE);
+HRESULT WINAPI SrpIsTokenService(HANDLE,BOOL*);
+HRESULT WINAPI SrpSetTokenEnterpriseId(HANDLE,const WCHAR*);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* __WINE_SRPAPI_H */
