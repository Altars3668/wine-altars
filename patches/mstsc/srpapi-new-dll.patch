+ * License along with this library; if not, write to the Free Software
+ * Foundation, Inc., 51 Franklin St, Fifth Floor, Boston, MA 02110-1301, USA
+ */
+
+/*
+ * These answer "is this process governed by an enterprise data policy, and
+ * what does that policy allow". A Wine host is governed by no such policy, so
+ * the answers here are not placeholders: no policy, no enterprise identities,
+ * nothing withheld. Applications that ask -- the Remote Desktop client asks
+ * while it starts a connection -- read that as unmanaged and carry on.
+ *
+ * Callers reach these through GetProcAddress after loading the DLL by name, so
+ * the module having to exist at all is the point: without it they get
+ * ERROR_MOD_NOT_FOUND and give up before asking anything.
+ */
+
+#include <stdarg.h>
+
+#include "windef.h"
+#include "winbase.h"
+#include "winternl.h"
+#include "srpapi.h"
+
+#include "wine/debug.h"
+
+WINE_DEFAULT_DEBUG_CHANNEL(srpapi);
+
+/***********************************************************************
+ *           SrpGetEnterprisePolicy   (srpapi.@)
+ */
+HRESULT WINAPI SrpGetEnterprisePolicy(HANDLE token, ENTERPRISE_DATA_POLICIES *policy)
+{
+    TRACE("(%p, %p)\n", token, policy);
+
+    if (!policy) return E_INVALIDARG;
+
+    *policy = ENTERPRISE_POLICY_NONE;
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpGetEnterpriseIds   (srpapi.@)
+ */
+HRESULT WINAPI SrpGetEnterpriseIds(HANDLE token, DWORD *size, WCHAR **ids, DWORD *count)
+{
+    TRACE("(%p, %p, %p, %p)\n", token, size, ids, count);
+
+    if (!count) return E_INVALIDARG;
+
+    if (size) *size = 0;
+    if (ids) *ids = NULL;
+    *count = 0;
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpGetAllowedEnterprises   (srpapi.@)
+ */
+HRESULT WINAPI SrpGetAllowedEnterprises(HANDLE token, DWORD *size, WCHAR **ids, DWORD *count)
+{
+    TRACE("(%p, %p, %p, %p)\n", token, size, ids, count);
+
+    return SrpGetEnterpriseIds(token, size, ids, count);
+}
+
+/***********************************************************************
+ *           SrpDoesPolicyAllowAppExecution   (srpapi.@)
+ */
+HRESULT WINAPI SrpDoesPolicyAllowAppExecution(const void *package_id, BOOL *allowed)
+{
+    TRACE("(%p, %p)\n", package_id, allowed);
+
+    if (!allowed) return E_INVALIDARG;
+
+    /* No policy restricts anything. */
+    *allowed = TRUE;
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpIsTokenService   (srpapi.@)
+ */
+HRESULT WINAPI SrpIsTokenService(HANDLE token, BOOL *is_service)
+{
+    TRACE("(%p, %p)\n", token, is_service);
+
+    if (!is_service) return E_INVALIDARG;
+
+    *is_service = FALSE;
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpCreateThreadNetworkContext   (srpapi.@)
+ */
+HRESULT WINAPI SrpCreateThreadNetworkContext(const WCHAR *enterprise_id,
+                                             HTHREAD_NETWORK_CONTEXT *context)
+{
+    TRACE("(%s, %p)\n", debugstr_w(enterprise_id), context);
+
+    if (!context) return E_INVALIDARG;
+
+    /* Nothing to enter and nothing to leave, but the caller will close this. */
+    memset(context, 0, sizeof(*context));
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpCloseThreadNetworkContext   (srpapi.@)
+ */
+HRESULT WINAPI SrpCloseThreadNetworkContext(HTHREAD_NETWORK_CONTEXT *context)
+{
+    TRACE("(%p)\n", context);
+
+    return context ? S_OK : E_INVALIDARG;
+}
+
+/***********************************************************************
+ *           SrpSetTokenEnterpriseId   (srpapi.@)
+ */
+HRESULT WINAPI SrpSetTokenEnterpriseId(HANDLE token, const WCHAR *enterprise_id)
+{
+    TRACE("(%p, %s)\n", token, debugstr_w(enterprise_id));
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpEnablePermissiveModeFileEncryption   (srpapi.@)
+ */
+HRESULT WINAPI SrpEnablePermissiveModeFileEncryption(const WCHAR *enterprise_id)
+{
+    TRACE("(%s)\n", debugstr_w(enterprise_id));
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpDisablePermissiveModeFileEncryption   (srpapi.@)
+ */
+HRESULT WINAPI SrpDisablePermissiveModeFileEncryption(void)
+{
+    TRACE("()\n");
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpHostingInitialize   (srpapi.@)
+ */
+HRESULT WINAPI SrpHostingInitialize(SRPHOSTING_TYPE type)
+{
+    TRACE("(%u)\n", type);
+
+    return S_OK;
+}
+
+/***********************************************************************
+ *           SrpHostingTerminate   (srpapi.@)
+ */
+void WINAPI SrpHostingTerminate(SRPHOSTING_TYPE type)
+{
+    TRACE("(%u)\n", type);
+}
