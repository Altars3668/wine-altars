+/******************************************************************
+ *    NotifyNetworkConnectivityHintChange (IPHLPAPI.@)
+ */
+DWORD WINAPI NotifyNetworkConnectivityHintChange( PNETWORK_CONNECTIVITY_HINT_CHANGE_CALLBACK callback,
+                                                  void *context, BOOLEAN init_notify, HANDLE *handle )
+{
+    FIXME( "(callback %p, context %p, init_notify %d, handle %p): stub\n",
+           callback, context, init_notify, handle );
+
+    if (!handle) return ERROR_INVALID_PARAMETER;
+    *handle = NULL;
+
+    /* Route changes are not reported either, so there is nothing to hang a
+     * subscription on. Delivering the current state once is still worth doing:
+     * a caller that only wants to know where it stands gets an answer. */
+    if (init_notify && callback)
+    {
+        NL_NETWORK_CONNECTIVITY_HINT hint;
+
+        if (!GetNetworkConnectivityHint( &hint )) callback( context, hint );
+    }
+    return NO_ERROR;
+}
