 /******************************************************************
+ *    GetNetworkConnectivityHint (IPHLPAPI.@)
+ *
+ * What the host can currently reach, as a hint rather than a measurement:
+ * callers use it to decide how hard to try, not to decide what is true.
+ */
+DWORD WINAPI GetNetworkConnectivityHint( NL_NETWORK_CONNECTIVITY_HINT *hint )
+{
+    MIB_IPFORWARD_TABLE2 *table;
+    DWORD err;
+    ULONG i;
+
+    TRACE( "hint %p\n", hint );
+
+    if (!hint) return ERROR_INVALID_PARAMETER;
+
+    hint->ConnectivityLevel = NetworkConnectivityLevelHintNone;
+    /* Nothing here tracks data plans, and a host on one would have to be told
+     * from outside; unrestricted is the truth rather than a placeholder. */
+    hint->ConnectivityCost = NetworkConnectivityCostHintUnrestricted;
+    hint->ApproachingDataLimit = FALSE;
+    hint->OverDataLimit = FALSE;
+    hint->Roaming = FALSE;
+
+    if ((err = GetIpForwardTable2( AF_UNSPEC, &table ))) return err;
+
+    for (i = 0; i < table->NumEntries; i++)
+    {
+        /* A default route is what separates a host that can reach the internet
+         * from one that can only reach its own network. */
+        if (!table->Table[i].DestinationPrefix.PrefixLength)
+        {
+            hint->ConnectivityLevel = NetworkConnectivityLevelHintInternetAccess;
+            break;
+        }
+        hint->ConnectivityLevel = NetworkConnectivityLevelHintLocalAccess;
+    }
+
+    FreeMibTable( table );
+    return NO_ERROR;
+}
+
