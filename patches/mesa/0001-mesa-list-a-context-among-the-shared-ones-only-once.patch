From 7d631fa1d21528078e02333cbca28f491f7a5f8d Mon Sep 17 00:00:00 2001
From: AltarsCN <337293323+Altars3668@users.noreply.github.com>
Date: Tue, 29 Sep 2026 06:24:22 -0400
Subject: [PATCH] mesa: list a context among the shared ones only once its
 st_context exists

_mesa_initialize_context() put the new context on ctx->Shared->Contexts,
but ctx->st and st->pipe are only set afterwards by
st_create_context_priv().  Meanwhile another thread releasing a buffer
with the threaded context takes Shared->Mutex in
_mesa_release_pending_resource() and walks that list, and
_mesa_check_shared_resource_usage() reads shared_ctx->st->pipe of the
context still being created: a NULL dereference with Shared->Mutex held.

Under Wine, which shares every GL context with a root one, this is hit
when one thread creates a D3D device while another draws: the fault
leaves Shared->Mutex locked, and every later context creation or buffer
release in the process blocks for ever.

Add the context to the list in st_create_context() once
st_create_context_priv() has succeeded, and only initialize the link in
_mesa_initialize_context(), so that _mesa_free_context_data() can still
unlink it.

Cc: mesa-stable
Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
---
 src/mesa/main/context.c             | 7 ++++---
 src/mesa/state_tracker/st_context.c | 9 +++++++++
 2 files changed, 13 insertions(+), 3 deletions(-)

diff --git a/src/mesa/main/context.c b/src/mesa/main/context.c
index 5b6c691..6e68df3 100644
--- a/src/mesa/main/context.c
+++ b/src/mesa/main/context.c
@@ -1062,9 +1062,10 @@ _mesa_initialize_context(struct gl_context *ctx,
 
    ctx->FirstTimeCurrent = GL_TRUE;
 
-   simple_mtx_lock(&ctx->Shared->Mutex);
-   list_addtail(&ctx->SharedLink, &ctx->Shared->Contexts);
-   simple_mtx_unlock(&ctx->Shared->Mutex);
+   /* The context joins Shared->Contexts in st_create_context, once ctx->st
+    * exists: a thread releasing a buffer walks that list and uses ctx->st.
+    */
+   list_inithead(&ctx->SharedLink);
    ctx->ReleaseResources = UTIL_DYNARRAY_INIT;
 
    return GL_TRUE;
diff --git a/src/mesa/state_tracker/st_context.c b/src/mesa/state_tracker/st_context.c
index 6ae3ea4..809a59f 100644
--- a/src/mesa/state_tracker/st_context.c
+++ b/src/mesa/state_tracker/st_context.c
@@ -835,8 +835,17 @@ st_create_context(gl_api api, struct pipe_context *pipe,
    if (!st) {
       _mesa_free_context_data(ctx, true);
       align_free(ctx);
+      return NULL;
    }
 
+   /* Only now may other threads find the context among the shared ones:
+    * _mesa_check_shared_resource_usage() dereferences ctx->st->pipe, which
+    * st_create_context_priv() has just set.
+    */
+   simple_mtx_lock(&ctx->Shared->Mutex);
+   list_addtail(&ctx->SharedLink, &ctx->Shared->Contexts);
+   simple_mtx_unlock(&ctx->Shared->Mutex);
+
    return st;
 }
 
